#!/usr/bin/env sh

commit_msg_file="$1"
subject="$(sed -n '1p' "$commit_msg_file")"

case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *)
    exit 0
    ;;
esac

if printf '%s\n' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|test|chore)\([a-z0-9-]+\): .+'; then
  exit 0
fi

cat >&2 <<'EOF'
Invalid commit message subject.

Use the repo format:
  type(scope): summary

Allowed types:
  feat, fix, docs, style, refactor, test, chore

Examples:
  feat(revelio): add developing RTH profile styling
  fix(pulse): never draw in-progress sessions as breakable levels
EOF

exit 1
