#!/usr/bin/env sh

commit_msg_file="$1"
subject="$(sed -n '1p' "$commit_msg_file")"

ai_attribution="$(
  sed '/^[[:space:]]*#/d' "$commit_msg_file" |
    grep -Ein '^[[:space:]]*(co-authored-by:.*(claude|anthropic)|claude-session:)|^[^[:alnum:]]*generated with \[?claude code' ||
    true
)"

validation_lines="$(
  sed '1d' "$commit_msg_file" |
    sed '/^[[:space:]]*#/d' |
    grep -Ein '^[^[:alnum:]]*(validat|tests? (pass|run)|checks? pass)' ||
    true
)"

if [ -n "$validation_lines" ]; then
  cat >&2 <<EOF
Invalid commit message: validation details are not allowed in the body.

Report validation in chat instead. Remove these lines:
$validation_lines
EOF

  exit 1
fi

if [ -n "$ai_attribution" ]; then
  cat >&2 <<EOF
Invalid commit message: AI attribution is not allowed.

Remove these lines:
$ai_attribution
EOF

  exit 1
fi

case "$subject" in
  fixup!\ *|squash!\ *)
    exit 0
    ;;
esac

case "$subject" in
  Merge\ *|Revert\ *)
    ;;
  *)
    if ! printf '%s\n' "$subject" | grep -Eq '^(feat|fix|perf|docs|style|refactor|test|chore)\([a-z0-9-]+\): .+'; then
      cat >&2 <<'EOF'
Invalid commit message subject.

Use the repo format:
  type(scope): summary

Allowed types:
  feat, fix, perf, docs, style, refactor, test, chore

Examples:
  feat(revelio): add developing RTH profile styling
  fix(pulse): never draw in-progress sessions as breakable levels
EOF

      exit 1
    fi
    ;;
esac

second_line="$(sed -n '2p' "$commit_msg_file")"
body_text="$(
  sed '1d' "$commit_msg_file" |
    sed '/^[[:space:]]*#/d' |
    tr '\n' ' ' |
    sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
)"
body_compact="$(printf '%s' "$body_text" | tr -d '[:space:]')"

if [ -n "$(printf '%s' "$second_line" | tr -d '[:space:]')" ] || [ "${#body_compact}" -lt 20 ]; then
  cat >&2 <<'EOF'
Invalid commit message body.

Every final or merge commit must include:
  subject

  A few short lines describing the user-visible change.

The subject and body must be separated by a blank line. The body must contain
at least 20 non-whitespace characters.
EOF

  exit 1
fi
