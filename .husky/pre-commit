#!/usr/bin/env sh

staged_pine_files="$(git diff --cached --name-only --diff-filter=ACMR -- '*.pine')"

if [ -z "$staged_pine_files" ]; then
  exit 0
fi

invalid_titles=""

is_pure_archive_rename() {
  git diff --cached --name-status --find-renames=100% |
    awk -F '\t' -v target="$1" '
      $1 == "R100" && $2 !~ /^indicators\/deprecated\// && $3 == target && $3 ~ /^indicators\/deprecated\// { found = 1 }
      END { exit !found }
    '
}

while IFS= read -r pine_file; do
  [ -n "$pine_file" ] || continue

  # Preserve historical titles when an unchanged source is moved into the archive.
  if is_pure_archive_rename "$pine_file"; then
    continue
  fi

  title_lines="$(
    git show ":$pine_file" 2>/dev/null |
      grep -Ein '^[[:space:]]*([[:alnum:]_]*TITLE[[:space:]]*=|indicator[[:space:]]*\().*(development|\(dev\)|-dev)' ||
      true
  )"

  if [ -n "$title_lines" ]; then
    invalid_titles="${invalid_titles}
$pine_file
$title_lines"
  fi
done <<EOF
$staged_pine_files
EOF

if [ -n "$invalid_titles" ]; then
  cat >&2 <<EOF
Invalid Pine production title.

Remove development markers from staged indicator titles before committing:
$invalid_titles

Development markers are allowed while editing but never in a final commit.
EOF

  exit 1
fi
