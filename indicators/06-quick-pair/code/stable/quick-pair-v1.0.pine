//@version=6
indicator("Quick Pair° [Pro+]", overlay=true)

// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

IDEAL = "Ideal"
EDGE = "Edge"

GROUP_SHARED = "⚙️ Shared"
GROUP_QUICKPAIR = "📊 QuickPair"
GROUP_COUNTDOWN = "⏱️ Countdown"
GROUP_COLOR_REF = "🎨 Color Reference"

INPUT_COLOR_CURRENT = "Current TF"
INPUT_TABLE_BG_COLOR = "Background"
INPUT_TABLE_FRAME_COLOR = "Frame"

POS_LEFT = "Left"
POS_CENTER = "Center"
POS_RIGHT = "Right"
POS_TOP = "Top"
POS_MIDDLE = "Middle"
POS_BOTTOM = "Bottom"

STR_EMPTY = ""
STR_SPACE = " "

CHECK_MARK = "✓"

SIZE_TINY = "Tiny"
SIZE_SMALL = "Small"
SIZE_NORMAL = "Normal"
SIZE_LARGE = "Large"
SIZE_HUGE = "Huge"

SUFFIX_S_DETECT = "S"
SUFFIX_S = "s"
SUFFIX_M = "m"
SUFFIX_H = "H"
SUFFIX_D = "D"
SUFFIX_W = "W"
SUFFIX_MON = "M"

MINUTES_PER_HOUR = 60
MINUTES_PER_DAY = 1440
MINUTES_PER_WEEK = 10080
MINUTES_PER_MONTH = 43200

IDEAL_MIN_RATIO = 8
IDEAL_MAX_RATIO = 16
EDGE_LOW_MIN_RATIO = 5
EDGE_LOW_MAX_RATIO = 7
EDGE_HIGH_MIN_RATIO = 17
EDGE_HIGH_MAX_RATIO = 20
NATURAL_TARGET_RATIO = 12
HUGE_DISTANCE = 1e10

MAX_RECOMMENDATIONS = 5

// ═══════════════════════════════════════════════════════════════════════════════
// COLOR CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

const color DEFAULT_CURRENT_TF_COLOR = color.rgb(41, 98, 255)
const color DEFAULT_TEXT_COLOR = color.rgb(74, 74, 74)
const color DEFAULT_TABLE_BG_COLOR = color.new(color.rgb(144, 191, 249), 95)
const color DEFAULT_TABLE_FRAME_COLOR = color.new(color.rgb(91, 156, 246), 50)
const color DEFAULT_TABLE_BORDER_COLOR = color.rgb(120, 123, 134)

const color DEFAULT_COUNTDOWN_BG_COLOR = color.new(color.rgb(210, 210, 210), 85)
const color DEFAULT_COUNTDOWN_FRAME_COLOR = color.rgb(66, 66, 66)

// ═══════════════════════════════════════════════════════════════════════════════
// TIMEFRAME LIST (MINUTES)
// ═══════════════════════════════════════════════════════════════════════════════

var TF_LIST_MINUTES = array.from(0.25, 0.5, 1.0, 2.0, 3.0, 5.0, 7.0, 10.0, 15.0, 20.0, 30.0, 45.0, MINUTES_PER_HOUR * 1.0, 90.0, MINUTES_PER_HOUR * 2.0, MINUTES_PER_HOUR * 3.0, MINUTES_PER_HOUR * 4.0, MINUTES_PER_HOUR * 6.0, MINUTES_PER_HOUR * 8.0, MINUTES_PER_HOUR * 12.0, MINUTES_PER_DAY * 1.0, MINUTES_PER_DAY * 2.0, MINUTES_PER_DAY * 3.0, MINUTES_PER_DAY * 5.0, MINUTES_PER_WEEK * 1.0, MINUTES_PER_WEEK * 2.0, MINUTES_PER_WEEK * 3.0, MINUTES_PER_WEEK * 4.0, MINUTES_PER_WEEK * 5.0, MINUTES_PER_WEEK * 6.0, MINUTES_PER_WEEK * 7.0, MINUTES_PER_WEEK * 8.0, MINUTES_PER_WEEK * 9.0, MINUTES_PER_WEEK * 10.0, MINUTES_PER_WEEK * 11.0, MINUTES_PER_WEEK * 12.0, MINUTES_PER_WEEK * 13.0, MINUTES_PER_WEEK * 14.0, MINUTES_PER_WEEK * 15.0, MINUTES_PER_WEEK * 16.0, MINUTES_PER_WEEK * 17.0, MINUTES_PER_WEEK * 18.0, MINUTES_PER_WEEK * 19.0, MINUTES_PER_WEEK * 20.0, MINUTES_PER_DAY * 15.0, MINUTES_PER_MONTH * 1.0, MINUTES_PER_MONTH * 3.0)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUT SETTINGS
// ═══════════════════════════════════════════════════════════════════════════════

color_text = input.color(DEFAULT_TEXT_COLOR, "Text", group=GROUP_SHARED, inline='shared')
border_color = input.color(DEFAULT_TABLE_BORDER_COLOR, "Border", group=GROUP_SHARED, inline='shared')

table_position_h = input.string(POS_RIGHT, STR_EMPTY, options=[POS_RIGHT, POS_LEFT, POS_CENTER], group=GROUP_QUICKPAIR, inline='pos')
table_position_v = input.string(POS_MIDDLE, STR_EMPTY, options=[POS_MIDDLE, POS_TOP, POS_BOTTOM], group=GROUP_QUICKPAIR, inline='pos')

color_current = input.color(DEFAULT_CURRENT_TF_COLOR, INPUT_COLOR_CURRENT, group=GROUP_QUICKPAIR, inline='c1')
table_bg_color = input.color(DEFAULT_TABLE_BG_COLOR, INPUT_TABLE_BG_COLOR, group=GROUP_QUICKPAIR, inline='c1')

table_frame_color = input.color(DEFAULT_TABLE_FRAME_COLOR, INPUT_TABLE_FRAME_COLOR, group=GROUP_QUICKPAIR)

show_countdown_3m = input.bool(true, "3m", group=GROUP_COUNTDOWN, inline='cd1')
show_countdown_5m = input.bool(true, "5m", group=GROUP_COUNTDOWN, inline='cd1')
show_countdown_15m = input.bool(true, "15m", group=GROUP_COUNTDOWN, inline='cd1')

show_countdown_1h = input.bool(false, "1h", group=GROUP_COUNTDOWN, inline='cd2')
show_countdown_4h = input.bool(false, "4h", group=GROUP_COUNTDOWN, inline='cd2')
show_countdown_7h = input.bool(false, "7h", group=GROUP_COUNTDOWN, inline='cd2')
show_countdown_1d = input.bool(false, "1D", group=GROUP_COUNTDOWN, inline='cd3')

countdown_position_h = input.string(POS_RIGHT, STR_EMPTY, options=[POS_RIGHT, POS_LEFT, POS_CENTER], group=GROUP_COUNTDOWN, inline='cdpos')
countdown_position_v = input.string(POS_BOTTOM, STR_EMPTY, options=[POS_TOP, POS_MIDDLE, POS_BOTTOM], group=GROUP_COUNTDOWN, inline='cdpos')

countdown_bg_color = input.color(DEFAULT_COUNTDOWN_BG_COLOR, "Background", group=GROUP_COUNTDOWN, inline='cdc1')
countdown_frame_color = input.color(DEFAULT_COUNTDOWN_FRAME_COLOR, "Frame", group=GROUP_COUNTDOWN, inline='cdc1')

countdown_text_size = input.string(SIZE_NORMAL, "Text Size", options=[SIZE_TINY, SIZE_SMALL, SIZE_NORMAL, SIZE_LARGE, SIZE_HUGE], group=GROUP_COUNTDOWN)

show_color_table = input.bool(false, "Show Table", group=GROUP_COLOR_REF)

// ═══════════════════════════════════════════════════════════════════════════════
// FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

get_text_size(size_str) =>
    size_str == SIZE_TINY ? size.tiny : size_str == SIZE_SMALL ? size.small : size_str == SIZE_NORMAL ? size.normal : size_str == SIZE_LARGE ? size.large : size.huge

tf_to_minutes(tf_string) =>
    var result = 0.0
    if str.contains(tf_string, SUFFIX_S_DETECT)
        seconds = str.tonumber(str.replace(tf_string, SUFFIX_S_DETECT, STR_EMPTY))
        result := seconds / 60.0
    else if str.contains(tf_string, SUFFIX_H)
        hours = str.tonumber(str.replace(tf_string, SUFFIX_H, STR_EMPTY))
        result := hours * MINUTES_PER_HOUR
    else if str.contains(tf_string, SUFFIX_D)
        days = str.tonumber(str.replace(tf_string, SUFFIX_D, STR_EMPTY))
        result := days * MINUTES_PER_DAY
    else if str.contains(tf_string, SUFFIX_W)
        weeks = str.tonumber(str.replace(tf_string, SUFFIX_W, STR_EMPTY))
        result := weeks * MINUTES_PER_WEEK
    else if str.contains(tf_string, SUFFIX_MON)
        months = str.tonumber(str.replace(tf_string, SUFFIX_MON, STR_EMPTY))
        result := months * MINUTES_PER_MONTH
    else
        result := str.tonumber(tf_string)
    result

get_classification(tf_ratio) =>
    var result = STR_EMPTY
    if tf_ratio >= IDEAL_MIN_RATIO and tf_ratio <= IDEAL_MAX_RATIO
        result := IDEAL
    else if (tf_ratio >= EDGE_LOW_MIN_RATIO and tf_ratio <= EDGE_LOW_MAX_RATIO) or (tf_ratio >= EDGE_HIGH_MIN_RATIO and tf_ratio <= EDGE_HIGH_MAX_RATIO)
        result := EDGE
    result

format_tf(minutes_value) =>
    var result = STR_EMPTY
    if minutes_value >= MINUTES_PER_MONTH
        result := str.tostring(math.round(minutes_value / MINUTES_PER_MONTH)) + SUFFIX_MON
    else if minutes_value >= MINUTES_PER_WEEK
        result := str.tostring(math.round(minutes_value / MINUTES_PER_WEEK)) + SUFFIX_W
    else if minutes_value >= MINUTES_PER_DAY
        result := str.tostring(math.round(minutes_value / MINUTES_PER_DAY)) + SUFFIX_D
    else if minutes_value >= MINUTES_PER_HOUR
        result := str.tostring(math.round(minutes_value / MINUTES_PER_HOUR)) + SUFFIX_H
    else if minutes_value >= 1
        result := str.tostring(math.round(minutes_value)) + SUFFIX_M
    else
        result := str.tostring(math.round(minutes_value * 60)) + SUFFIX_S
    result

get_position() =>
    var result = position.top_right
    if table_position_v == POS_TOP
        if table_position_h == POS_LEFT
            result := position.top_left
        else if table_position_h == POS_CENTER
            result := position.top_center
        else
            result := position.top_right
    else if table_position_v == POS_MIDDLE
        if table_position_h == POS_LEFT
            result := position.middle_left
        else if table_position_h == POS_CENTER
            result := position.middle_center
        else
            result := position.middle_right
    else
        if table_position_h == POS_LEFT
            result := position.bottom_left
        else if table_position_h == POS_CENTER
            result := position.bottom_center
        else
            result := position.bottom_right
    result

is_bridge_pair(curr_minutes, cand_minutes) =>
    curr_minutes == MINUTES_PER_WEEK and cand_minutes == MINUTES_PER_MONTH

array_contains_string(arr, value) =>
    sz = array.size(arr)
    found = false
    if sz > 0
        for i_check = 0 to sz - 1
            if array.get(arr, i_check) == value
                found := true
    found

push_unique(label_arr, ratio_arr, label, ratio_value) =>
    if not array_contains_string(label_arr, label)
        array.push(label_arr, label)
        array.push(ratio_arr, ratio_value)
        true
    else
        false

sort_pairs_by_ratio_desc(labels, ratios) =>
    count_labels = array.size(labels)
    count_ratios = array.size(ratios)
    count = math.min(count_labels, count_ratios)
    if count <= 1
        na
    else
        for i_sort = 0 to count - 2
            for j_sort = i_sort + 1 to count - 1
                if array.get(ratios, i_sort) < array.get(ratios, j_sort)
                    r_i = array.get(ratios, i_sort)
                    r_j = array.get(ratios, j_sort)
                    array.set(ratios, i_sort, r_j)
                    array.set(ratios, j_sort, r_i)
                    s_i = array.get(labels, i_sort)
                    s_j = array.get(labels, j_sort)
                    array.set(labels, i_sort, s_j)
                    array.set(labels, j_sort, s_i)
select_natural_and_backup(timeframe_labels, timeframe_ratios) =>
    count_timeframes = array.size(timeframe_labels)
    count_ratios = array.size(timeframe_ratios)
    if count_timeframes == 0 or count_ratios == 0
        [array.new<string>(), array.new<float>(), -1]
    else
        natural_source_index = 0
        natural_distance = HUGE_DISTANCE
        paired_count = math.min(count_timeframes, count_ratios)
        for idx = 0 to paired_count - 1
            ratio_value = array.get(timeframe_ratios, idx)
            distance_from_12 = math.abs(ratio_value - NATURAL_TARGET_RATIO)
            if distance_from_12 < natural_distance
                natural_distance := distance_from_12
                natural_source_index := idx
        backup_index = -1
        backup_distance = HUGE_DISTANCE
        for idx = 0 to paired_count - 1
            if idx != natural_source_index
                ratio_value = array.get(timeframe_ratios, idx)
                distance_from_12 = math.abs(ratio_value - NATURAL_TARGET_RATIO)
                if distance_from_12 < backup_distance
                    backup_distance := distance_from_12
                    backup_index := idx
        picked_timeframes = array.new<string>()
        picked_ratios = array.new<float>()
        new_natural_index = -1
        for idx_order = 0 to paired_count - 1
            is_pick = (idx_order == natural_source_index) or (idx_order == backup_index)
            if is_pick
                array.push(picked_timeframes, array.get(timeframe_labels, idx_order))
                array.push(picked_ratios, array.get(timeframe_ratios, idx_order))
                if idx_order == natural_source_index
                    new_natural_index := array.size(picked_timeframes) - 1
        new_natural_index := (new_natural_index == -1) ? 0 : new_natural_index
        if array.size(picked_ratios) == 2
            r0 = array.get(picked_ratios, 0)
            r1 = array.get(picked_ratios, 1)
            if r0 < r1
                t0 = array.get(picked_timeframes, 0)
                t1 = array.get(picked_timeframes, 1)
                array.set(picked_timeframes, 0, t1)
                array.set(picked_timeframes, 1, t0)
                array.set(picked_ratios, 0, r1)
                array.set(picked_ratios, 1, r0)
                new_natural_index := (new_natural_index == 0) ? 1 : (new_natural_index == 1 ? 0 : new_natural_index)
        [picked_timeframes, picked_ratios, new_natural_index]
format_ultra_compact(timeframe_labels, timeframe_ratios, natural_index) =>
    count_timeframes = array.size(timeframe_labels)
    if count_timeframes == 0
        STR_EMPTY
    else
        formatted_output = STR_EMPTY
        for idx_label = 0 to count_timeframes - 1
            if idx_label > 0
                formatted_output += STR_SPACE
            tf_label = array.get(timeframe_labels, idx_label)
            entry_text = tf_label
            if idx_label == natural_index
                entry_text += CHECK_MARK
            formatted_output += entry_text
        formatted_output

get_countdown_position() =>
    var result = position.top_right
    if countdown_position_v == POS_TOP
        if countdown_position_h == POS_LEFT
            result := position.top_left
        else if countdown_position_h == POS_CENTER
            result := position.top_center
        else
            result := position.top_right
    else if countdown_position_v == POS_MIDDLE
        if countdown_position_h == POS_LEFT
            result := position.middle_left
        else if countdown_position_h == POS_CENTER
            result := position.middle_center
        else
            result := position.middle_right
    else
        if countdown_position_h == POS_LEFT
            result := position.bottom_left
        else if countdown_position_h == POS_CENTER
            result := position.bottom_center
        else
            result := position.bottom_right
    result

get_countdown(tf_string) =>
    bar_close_time = request.security(syminfo.tickerid, tf_string, time_close, lookahead=barmerge.lookahead_on)
    time_remaining = bar_close_time - timenow
    time_remaining_clamped = math.max(0, time_remaining)

    total_seconds = math.floor(time_remaining_clamped / 1000)
    hours = math.floor(total_seconds / 3600)
    remaining_after_hours = total_seconds % 3600
    minutes = math.floor(remaining_after_hours / 60)
    seconds = remaining_after_hours % 60

    hours_str = hours < 10 ? "0" + str.tostring(hours) : str.tostring(hours)
    minutes_str = minutes < 10 ? "0" + str.tostring(minutes) : str.tostring(minutes)
    seconds_str = seconds < 10 ? "0" + str.tostring(seconds) : str.tostring(seconds)

    hours_str + "∶" + minutes_str + "∶" + seconds_str

// ═══════════════════════════════════════════════════════════════════════════════
// MAIN LOGIC
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.islast
    current_tf_minutes = tf_to_minutes(timeframe.period)
    current_tf_display = format_tf(current_tf_minutes)

    tf_list = TF_LIST_MINUTES

    htf_ideal = array.new<string>()
    htf_edge = array.new<string>()
    htf_ideal_r = array.new<float>()
    htf_edge_r = array.new<float>()

    ltf_ideal = array.new<string>()
    ltf_edge = array.new<string>()
    ltf_ideal_r = array.new<float>()
    ltf_edge_r = array.new<float>()

    tf_list_count = array.size(tf_list)

    for i_ord = 0 to tf_list_count - 1
        idx_tf = tf_list_count - 1 - i_ord
        tf_minutes = array.get(tf_list, idx_tf)
        if tf_minutes > current_tf_minutes
            tf_ratio = tf_minutes / current_tf_minutes
            accept_pair = tf_ratio == math.floor(tf_ratio) or is_bridge_pair(current_tf_minutes, tf_minutes)
            if accept_pair
                classification = (tf_ratio == math.floor(tf_ratio)) ? get_classification(tf_ratio) : EDGE
                tf_label = format_tf(tf_minutes)
                if classification == IDEAL and array.size(htf_ideal) < MAX_RECOMMENDATIONS
                    push_unique(htf_ideal, htf_ideal_r, tf_label, tf_ratio)
                else if classification == EDGE and array.size(htf_edge) < MAX_RECOMMENDATIONS
                    push_unique(htf_edge, htf_edge_r, tf_label, tf_ratio)

    for i_ord = 0 to tf_list_count - 1
        idx_tf = i_ord
        tf_minutes = array.get(tf_list, idx_tf)
        if tf_minutes < current_tf_minutes
            tf_ratio = current_tf_minutes / tf_minutes
            accept_pair = tf_ratio == math.floor(tf_ratio) or is_bridge_pair(tf_minutes, current_tf_minutes)
            if accept_pair
                classification = (tf_ratio == math.floor(tf_ratio)) ? get_classification(tf_ratio) : EDGE
                tf_label = format_tf(tf_minutes)
                if classification == IDEAL and array.size(ltf_ideal) < MAX_RECOMMENDATIONS
                    push_unique(ltf_ideal, ltf_ideal_r, tf_label, tf_ratio)
                else if classification == EDGE and array.size(ltf_edge) < MAX_RECOMMENDATIONS
                    push_unique(ltf_edge, ltf_edge_r, tf_label, tf_ratio)

    if array.size(htf_ideal) > 0 or array.size(htf_edge) > 0 or array.size(ltf_ideal) > 0 or array.size(ltf_edge) > 0
        htf_candidate_timeframes = array.copy(htf_ideal)
        htf_candidate_ratios = array.copy(htf_ideal_r)
        htf_edge_count = array.size(htf_edge)
        if htf_edge_count > 0
            for idx_htf_edge = 0 to htf_edge_count - 1
                array.push(htf_candidate_timeframes, array.get(htf_edge, idx_htf_edge))
                array.push(htf_candidate_ratios, array.get(htf_edge_r, idx_htf_edge))
        ltf_candidate_timeframes = array.copy(ltf_ideal)
        ltf_candidate_ratios = array.copy(ltf_ideal_r)
        ltf_edge_count = array.size(ltf_edge)
        if ltf_edge_count > 0
            for idx_ltf_edge = 0 to ltf_edge_count - 1
                array.push(ltf_candidate_timeframes, array.get(ltf_edge, idx_ltf_edge))
                array.push(ltf_candidate_ratios, array.get(ltf_edge_r, idx_ltf_edge))

        [htf_picked_tfs, htf_picked_ratios, htf_natural_index] = select_natural_and_backup(htf_candidate_timeframes, htf_candidate_ratios)
        [ltf_picked_tfs, ltf_picked_ratios, ltf_natural_index] = select_natural_and_backup(ltf_candidate_timeframes, ltf_candidate_ratios)

        left_text = format_ultra_compact(htf_picked_tfs, htf_picked_ratios, htf_natural_index)
        right_text = format_ultra_compact(ltf_picked_tfs, ltf_picked_ratios, ltf_natural_index)

        var table ultra_table = na
        var string ultra_pos_key = ""
        pos_key_u = str.tostring(get_position())
        if na(ultra_table) or ultra_pos_key != pos_key_u
            ultra_table := table.new(get_position(), 3, 1, bgcolor=table_bg_color, frame_color=table_frame_color, frame_width=1, border_color=border_color, border_width=1)
            ultra_pos_key := pos_key_u
        table.cell(ultra_table, 0, 0, left_text, text_color=color_text, text_size=size.tiny)
        table.cell(ultra_table, 1, 0, current_tf_display, text_color=color_current, text_size=size.tiny)
        table.cell(ultra_table, 2, 0, right_text, text_color=color_text, text_size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE
// ═══════════════════════════════════════════════════════════════════════════════

if show_color_table and barstate.islast
    var table colorTable = table.new(position.top_right, 3, 8, bgcolor=color.new(color.black, 0), frame_color=color.gray, frame_width=1, border_color=color.gray, border_width=1)

    if barstate.islast
        table.cell(colorTable, 0, 0, "Setting", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.gray, 50))
        table.cell(colorTable, 1, 0, "RGB", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.gray, 50))
        table.cell(colorTable, 2, 0, "Opacity", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.gray, 50))

        table.cell(colorTable, 0, 1, "Current TF", text_color=color.white, text_size=size.tiny)
        table.cell(colorTable, 1, 1, str.format("({0},{1},{2})", color.r(color_current), color.g(color_current), color.b(color_current)), text_color=color.white, text_size=size.tiny)
        table.cell(colorTable, 2, 1, str.tostring(color.t(color_current)), text_color=color.white, text_size=size.tiny)

        table.cell(colorTable, 0, 2, "Text", text_color=color.white, text_size=size.tiny)
        table.cell(colorTable, 1, 2, str.format("({0},{1},{2})", color.r(color_text), color.g(color_text), color.b(color_text)), text_color=color.white, text_size=size.tiny)
        table.cell(colorTable, 2, 2, str.tostring(color.t(color_text)), text_color=color.white, text_size=size.tiny)

        table.cell(colorTable, 0, 3, "QuickPair BG", text_color=color.white, text_size=size.tiny)
        table.cell(colorTable, 1, 3, str.format("({0},{1},{2})", color.r(table_bg_color), color.g(table_bg_color), color.b(table_bg_color)), text_color=color.white, text_size=size.tiny)
        table.cell(colorTable, 2, 3, str.tostring(color.t(table_bg_color)), text_color=color.white, text_size=size.tiny)

        table.cell(colorTable, 0, 4, "QuickPair Frame", text_color=color.white, text_size=size.tiny)
        table.cell(colorTable, 1, 4, str.format("({0},{1},{2})", color.r(table_frame_color), color.g(table_frame_color), color.b(table_frame_color)), text_color=color.white, text_size=size.tiny)
        table.cell(colorTable, 2, 4, str.tostring(color.t(table_frame_color)), text_color=color.white, text_size=size.tiny)

        table.cell(colorTable, 0, 5, "Countdown BG", text_color=color.white, text_size=size.tiny)
        table.cell(colorTable, 1, 5, str.format("({0},{1},{2})", color.r(countdown_bg_color), color.g(countdown_bg_color), color.b(countdown_bg_color)), text_color=color.white, text_size=size.tiny)
        table.cell(colorTable, 2, 5, str.tostring(color.t(countdown_bg_color)), text_color=color.white, text_size=size.tiny)

        table.cell(colorTable, 0, 6, "Countdown Frame", text_color=color.white, text_size=size.tiny)
        table.cell(colorTable, 1, 6, str.format("({0},{1},{2})", color.r(countdown_frame_color), color.g(countdown_frame_color), color.b(countdown_frame_color)), text_color=color.white, text_size=size.tiny)
        table.cell(colorTable, 2, 6, str.tostring(color.t(countdown_frame_color)), text_color=color.white, text_size=size.tiny)

        table.cell(colorTable, 0, 7, "Border", text_color=color.white, text_size=size.tiny)
        table.cell(colorTable, 1, 7, str.format("({0},{1},{2})", color.r(border_color), color.g(border_color), color.b(border_color)), text_color=color.white, text_size=size.tiny)
        table.cell(colorTable, 2, 7, str.tostring(color.t(border_color)), text_color=color.white, text_size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// COUNTDOWN TABLE
// ═══════════════════════════════════════════════════════════════════════════════

chart_tf_minutes = tf_to_minutes(timeframe.period)

enabled_countdown_count = 0
if show_countdown_3m and 3 >= chart_tf_minutes
    enabled_countdown_count += 1
if show_countdown_5m and 5 >= chart_tf_minutes
    enabled_countdown_count += 1
if show_countdown_15m and 15 >= chart_tf_minutes
    enabled_countdown_count += 1
if show_countdown_1h and 60 >= chart_tf_minutes
    enabled_countdown_count += 1
if show_countdown_4h and 240 >= chart_tf_minutes
    enabled_countdown_count += 1
if show_countdown_7h and 420 >= chart_tf_minutes
    enabled_countdown_count += 1
if show_countdown_1d and 1440 >= chart_tf_minutes
    enabled_countdown_count += 1

if enabled_countdown_count > 0
    var table countdown_table = table.new(get_countdown_position(), 2, enabled_countdown_count, bgcolor=countdown_bg_color, frame_color=countdown_frame_color, frame_width=1, border_color=border_color, border_width=1)

    row_index = 0

    countdown_size = get_text_size(countdown_text_size)

    if show_countdown_3m and 3 >= chart_tf_minutes
        countdown_3m = get_countdown("3")
        table.cell(countdown_table, 0, row_index, "3m", text_color=color_text, text_size=countdown_size)
        table.cell(countdown_table, 1, row_index, countdown_3m, text_color=color_text, text_size=countdown_size)
        row_index += 1

    if show_countdown_5m and 5 >= chart_tf_minutes
        countdown_5m = get_countdown("5")
        table.cell(countdown_table, 0, row_index, "5m", text_color=color_text, text_size=countdown_size)
        table.cell(countdown_table, 1, row_index, countdown_5m, text_color=color_text, text_size=countdown_size)
        row_index += 1

    if show_countdown_15m and 15 >= chart_tf_minutes
        countdown_15m = get_countdown("15")
        table.cell(countdown_table, 0, row_index, "15m", text_color=color_text, text_size=countdown_size)
        table.cell(countdown_table, 1, row_index, countdown_15m, text_color=color_text, text_size=countdown_size)
        row_index += 1

    if show_countdown_1h and 60 >= chart_tf_minutes
        countdown_1h = get_countdown("60")
        table.cell(countdown_table, 0, row_index, "1h", text_color=color_text, text_size=countdown_size)
        table.cell(countdown_table, 1, row_index, countdown_1h, text_color=color_text, text_size=countdown_size)
        row_index += 1

    if show_countdown_4h and 240 >= chart_tf_minutes
        countdown_4h = get_countdown("240")
        table.cell(countdown_table, 0, row_index, "4h", text_color=color_text, text_size=countdown_size)
        table.cell(countdown_table, 1, row_index, countdown_4h, text_color=color_text, text_size=countdown_size)
        row_index += 1

    if show_countdown_7h and 420 >= chart_tf_minutes
        countdown_7h = get_countdown("420")
        table.cell(countdown_table, 0, row_index, "7h", text_color=color_text, text_size=countdown_size)
        table.cell(countdown_table, 1, row_index, countdown_7h, text_color=color_text, text_size=countdown_size)
        row_index += 1

    if show_countdown_1d and 1440 >= chart_tf_minutes
        countdown_1d = get_countdown("D")
        table.cell(countdown_table, 0, row_index, "1D", text_color=color_text, text_size=countdown_size)
        table.cell(countdown_table, 1, row_index, countdown_1d, text_color=color_text, text_size=countdown_size)
        row_index += 1
