//@version=6
indicator("Quick Pair° [Pro+]", overlay=true)

// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

// Quality labels
IDEAL = "Ideal"
EDGE = "Edge"
POOR = "Poor"

// Style names
STYLE_ULTRA_COMPACT = "Ultra Compact"
STYLE_COMPACT = "Compact"

// Group labels
GROUP_DISPLAY = "📊 Display"
GROUP_POSITION = "🎯 Position"
GROUP_COLORS = "🎨 Colors"
GROUP_TABLE_STYLE = "🧱 Table Style"

// Input labels
INPUT_DISPLAY_STYLE = "Display Style"
INPUT_SHOW_RATIOS = "Show Ratios"
INPUT_SHOW_POOR = "Show Poor Quality (Educational)"
INPUT_MAX_RECS = "Max Recommendations"
INPUT_POSITION = "Position"
INPUT_TEXT_SIZE = "Text Size"
INPUT_COLOR_CURRENT = "Current TF Color"
INPUT_TABLE_BG_COLOR = "Background"
INPUT_TABLE_BG_OPACITY = "Background Opacity"
INPUT_TABLE_FRAME_COLOR = "Frame Color"
INPUT_TABLE_FRAME_WIDTH = "Frame Width"
INPUT_TABLE_BORDER_COLOR = "Cell Border Color"
INPUT_TABLE_BORDER_WIDTH = "Cell Border Width"
INPUT_BEST_LABEL = "Best Label"
INPUT_EDGE_LABEL = "Edge Label"

// Position options
POS_LEFT = "Left"
POS_CENTER = "Center"
POS_RIGHT = "Right"
POS_TOP = "Top"
POS_MIDDLE = "Middle"
POS_BOTTOM = "Bottom"

// Size options
SIZE_TINY = "Tiny"
SIZE_SMALL = "Small"
SIZE_NORMAL = "Normal"
SIZE_LARGE = "Large"

// Formatting strings
STR_EMPTY = ""
STR_SPACE = " "
STR_COMMA_SPACE = ", "
STR_PIPE = " | "
STR_NEWLINE = "\n"
STR_COLON_SPACE = ": "
// (no bracket or arrow constants needed in compact modes)
STR_POOR = "Poor"
STR_RATIO_PREFIX = "×"
STR_RATIO_BULLET = "•"
STR_RATIO_OPEN = " ("
STR_RATIO_CLOSE = ")"
STR_RATIO_X = "x"
// (no multi-line header in compact modes)
STR_BEST = "Best"
STR_EDGE = "Edge"

// Symbols
CHECK_MARK = "✓"
CHECK_MARK_GREEN = "✅"

// Tooltips (compact modes)
TIP_HTF_CONTEXT = "Higher Timeframes for trend direction and major structure"
TIP_LTF_PRECISION = "Lower Timeframes for precise entries and exits"
// (no divisors tooltip needed here)

// (no separate column labels or object keys in compact modes)

// Timeframe suffixes
// Detect vs Display: TradingView uses uppercase 'S' in timeframe strings,
// but we display seconds with lowercase 's'.
SUFFIX_S_DETECT = "S"
SUFFIX_S = "s" // display
SUFFIX_M = "m"
SUFFIX_H = "H"
SUFFIX_D = "D"
SUFFIX_W = "W"
SUFFIX_MON = "M"

// Minute conversion constants
MINUTES_PER_HOUR = 60
MINUTES_PER_DAY = 1440
MINUTES_PER_WEEK = 10080
MINUTES_PER_MONTH = 43200

// Classification thresholds
IDEAL_MIN_RATIO = 8
IDEAL_MAX_RATIO = 16
EDGE_LOW_MIN_RATIO = 5
EDGE_LOW_MAX_RATIO = 7
EDGE_HIGH_MIN_RATIO = 17
EDGE_HIGH_MAX_RATIO = 20
NATURAL_TARGET_RATIO = 12
HUGE_DISTANCE = 1e10

// ═══════════════════════════════════════════════════════════════════════════════
// TIMEFRAME LIST (MINUTES)
// ═══════════════════════════════════════════════════════════════════════════════
// This is the canonical list of timeframes expressed in minutes.
// It includes:
// - Second-based frames: 15s (0.25m), 30s (0.5m)
// - Minute frames: 1, 2, 3, 5, 7, 10, 15, 20, 30, 45
// - Hour frames: 1h, 1h30 (90m), 2h, 3h, 4h, 6h, 8h, 12h
// - Day frames: 1d, 2d, 3d, 5d (intermediate structure level)
// - Week: 1w (7d = 10080m)
// - Month multiples: 15d (half-month), 1M (30d), 3M (90d)
// Notes:
// - Month is modeled as 30 days (MINUTES_PER_MONTH), consistent across the script.
// - Weeks use 7 calendar days (MINUTES_PER_WEEK = 10080), not 5 trading days.
// - 5d and 15d are included to provide clean integer ratios around d→w and d→M bridges.
// One-line to avoid Pine parser line-continuation issues inside array.from()
// Added weekly multiples (2W..20W) to support weekly HTF “Best”
var TF_LIST_MINUTES = array.from(0.25, 0.5, 1.0, 2.0, 3.0, 5.0, 7.0, 10.0, 15.0, 20.0, 30.0, 45.0, MINUTES_PER_HOUR * 1.0, 90.0, MINUTES_PER_HOUR * 2.0, MINUTES_PER_HOUR * 3.0, MINUTES_PER_HOUR * 4.0, MINUTES_PER_HOUR * 6.0, MINUTES_PER_HOUR * 8.0, MINUTES_PER_HOUR * 12.0, MINUTES_PER_DAY * 1.0, MINUTES_PER_DAY * 2.0, MINUTES_PER_DAY * 3.0, MINUTES_PER_DAY * 5.0, MINUTES_PER_WEEK * 1.0, MINUTES_PER_WEEK * 2.0, MINUTES_PER_WEEK * 3.0, MINUTES_PER_WEEK * 4.0, MINUTES_PER_WEEK * 5.0, MINUTES_PER_WEEK * 6.0, MINUTES_PER_WEEK * 7.0, MINUTES_PER_WEEK * 8.0, MINUTES_PER_WEEK * 9.0, MINUTES_PER_WEEK * 10.0, MINUTES_PER_WEEK * 11.0, MINUTES_PER_WEEK * 12.0, MINUTES_PER_WEEK * 13.0, MINUTES_PER_WEEK * 14.0, MINUTES_PER_WEEK * 15.0, MINUTES_PER_WEEK * 16.0, MINUTES_PER_WEEK * 17.0, MINUTES_PER_WEEK * 18.0, MINUTES_PER_WEEK * 19.0, MINUTES_PER_WEEK * 20.0, MINUTES_PER_DAY * 15.0, MINUTES_PER_MONTH * 1.0, MINUTES_PER_MONTH * 3.0)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUT SETTINGS
// ═══════════════════════════════════════════════════════════════════════════════

display_style = input.string(STYLE_ULTRA_COMPACT, INPUT_DISPLAY_STYLE, options=[STYLE_COMPACT, STYLE_ULTRA_COMPACT], group=GROUP_DISPLAY)
show_ratios = input.bool(true, INPUT_SHOW_RATIOS, group=GROUP_DISPLAY)
show_poor_quality = input.bool(false, INPUT_SHOW_POOR, group=GROUP_DISPLAY)
max_recommendations = input.int(5, INPUT_MAX_RECS, minval=1, maxval=8, group=GROUP_DISPLAY)
best_label = input.string(STR_BEST, INPUT_BEST_LABEL, group=GROUP_DISPLAY, inline='lbl')
edge_label = input.string(STR_EDGE, INPUT_EDGE_LABEL, group=GROUP_DISPLAY, inline='lbl')
show_green_check_mark = input.bool(true, "Green Checkmark", group=GROUP_DISPLAY)
allow_week_month_bridge = input.bool(true, "Bridge 1W ↔ 1M (Edge)", group=GROUP_DISPLAY)

table_position_h = input.string(POS_RIGHT, INPUT_POSITION, options=[POS_LEFT, POS_CENTER, POS_RIGHT], group=GROUP_POSITION)
table_position_v = input.string(POS_TOP, STR_EMPTY, options=[POS_TOP, POS_MIDDLE, POS_BOTTOM], group=GROUP_POSITION)
table_size = input.string(SIZE_SMALL, INPUT_TEXT_SIZE, options=[SIZE_TINY, SIZE_SMALL, SIZE_NORMAL, SIZE_LARGE], group=GROUP_POSITION)

color_current = input.color(color.blue, INPUT_COLOR_CURRENT, group=GROUP_COLORS, inline='c2')
INPUT_TEXT_COLOR = "Text Color"
color_text = input.color(color.white, INPUT_TEXT_COLOR, group=GROUP_COLORS, inline='c2')

// Table style controls (compact layout)
table_bg_color_base = input.color(color.black, INPUT_TABLE_BG_COLOR, group=GROUP_TABLE_STYLE, inline='bg')
table_bg_opacity = input.int(70, INPUT_TABLE_BG_OPACITY, minval=0, maxval=100, group=GROUP_TABLE_STYLE, inline='bg')
table_frame_color = input.color(color.gray, INPUT_TABLE_FRAME_COLOR, group=GROUP_TABLE_STYLE, inline='frm')
table_frame_width = input.int(1, INPUT_TABLE_FRAME_WIDTH, minval=0, maxval=5, group=GROUP_TABLE_STYLE, inline='frm')
table_border_color = input.color(color.gray, INPUT_TABLE_BORDER_COLOR, group=GROUP_TABLE_STYLE, inline='brd')
table_border_width = input.int(1, INPUT_TABLE_BORDER_WIDTH, minval=0, maxval=5, group=GROUP_TABLE_STYLE, inline='brd')
// (no standalone header row in compact modes)

// ═══════════════════════════════════════════════════════════════════════════════
// FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

tf_to_minutes(tf_string) =>
    var result = 0.0
    if str.contains(tf_string, SUFFIX_S_DETECT)
        seconds = str.tonumber(str.replace(tf_string, SUFFIX_S_DETECT, STR_EMPTY))
        result := seconds / 60.0
    else if str.contains(tf_string, SUFFIX_H)
        hours = str.tonumber(str.replace(tf_string, SUFFIX_H, STR_EMPTY))
        result := hours * MINUTES_PER_HOUR
    else if str.contains(tf_string, SUFFIX_D)
        days = str.tonumber(str.replace(tf_string, SUFFIX_D, STR_EMPTY))
        result := days * MINUTES_PER_DAY
    else if str.contains(tf_string, SUFFIX_W)
        weeks = str.tonumber(str.replace(tf_string, SUFFIX_W, STR_EMPTY))
        result := weeks * MINUTES_PER_WEEK
    else if str.contains(tf_string, SUFFIX_MON)
        months = str.tonumber(str.replace(tf_string, SUFFIX_MON, STR_EMPTY))
        result := months * MINUTES_PER_MONTH
    else
        result := str.tonumber(tf_string)
    result

get_classification(tf_ratio) =>
    var result = STR_EMPTY
    if tf_ratio >= IDEAL_MIN_RATIO and tf_ratio <= IDEAL_MAX_RATIO
        result := IDEAL
    else if (tf_ratio >= EDGE_LOW_MIN_RATIO and tf_ratio <= EDGE_LOW_MAX_RATIO) or (tf_ratio >= EDGE_HIGH_MIN_RATIO and tf_ratio <= EDGE_HIGH_MAX_RATIO)
        result := EDGE
    else
        result := POOR
    result

// (no per-class colors needed in compact modes)

format_tf(minutes_value) =>
    var result = STR_EMPTY
    if minutes_value >= MINUTES_PER_MONTH
        result := str.tostring(math.round(minutes_value / MINUTES_PER_MONTH)) + SUFFIX_MON
    else if minutes_value >= MINUTES_PER_WEEK
        result := str.tostring(math.round(minutes_value / MINUTES_PER_WEEK)) + SUFFIX_W
    else if minutes_value >= MINUTES_PER_DAY
        result := str.tostring(math.round(minutes_value / MINUTES_PER_DAY)) + SUFFIX_D
    else if minutes_value >= MINUTES_PER_HOUR
        result := str.tostring(math.round(minutes_value / MINUTES_PER_HOUR)) + SUFFIX_H
    else if minutes_value >= 1
        result := str.tostring(math.round(minutes_value)) + SUFFIX_M
    else
        result := str.tostring(math.round(minutes_value * 60)) + SUFFIX_S
    result

get_position() =>
    var result = position.top_right
    if table_position_v == POS_TOP
        if table_position_h == POS_LEFT
            result := position.top_left
        else if table_position_h == POS_CENTER
            result := position.top_center
        else
            result := position.top_right
    else if table_position_v == POS_MIDDLE
        if table_position_h == POS_LEFT
            result := position.middle_left
        else if table_position_h == POS_CENTER
            result := position.middle_center
        else
            result := position.middle_right
    else
        if table_position_h == POS_LEFT
            result := position.bottom_left
        else if table_position_h == POS_CENTER
            result := position.bottom_center
        else
            result := position.bottom_right
    result

get_text_size() =>
    var result = size.small
    switch table_size
        SIZE_TINY => result := size.tiny
        SIZE_SMALL => result := size.small
        SIZE_NORMAL => result := size.normal
        SIZE_LARGE => result := size.large
    result

get_check_symbol() =>
    show_green_check_mark ? CHECK_MARK_GREEN : CHECK_MARK

// Bridge exceptions: allow common calendar pairs even if ratio isn't integer
is_bridge_pair(curr_minutes, cand_minutes) =>
    allow_week_month_bridge and curr_minutes == MINUTES_PER_WEEK and cand_minutes == MINUTES_PER_MONTH

// Helpers: membership and unique push to avoid duplicates
array_contains_string(arr, value) =>
    sz = array.size(arr)
    found = false
    if sz > 0
        for i_check = 0 to sz - 1
            if array.get(arr, i_check) == value
                found := true
    found

push_unique(label_arr, ratio_arr, label, ratio_value) =>
    if not array_contains_string(label_arr, label)
        array.push(label_arr, label)
        array.push(ratio_arr, ratio_value)
        true
    else
        false

// Sort paired (labels, ratios) by ratio descending, keeping arrays in sync
sort_pairs_by_ratio_desc(labels, ratios) =>
    count_labels = array.size(labels)
    count_ratios = array.size(ratios)
    count = math.min(count_labels, count_ratios)
    if count <= 1
        na
    else
        for i_sort = 0 to count - 2
            for j_sort = i_sort + 1 to count - 1
                if array.get(ratios, i_sort) < array.get(ratios, j_sort)
                    // swap ratios
                    r_i = array.get(ratios, i_sort)
                    r_j = array.get(ratios, j_sort)
                    array.set(ratios, i_sort, r_j)
                    array.set(ratios, j_sort, r_i)
                    // swap labels in lockstep
                    s_i = array.get(labels, i_sort)
                    s_j = array.get(labels, j_sort)
                    array.set(labels, i_sort, s_j)
                    array.set(labels, j_sort, s_i)

// (array formatters removed for compact modes)

// Format space-separated list with optional natural checkmark
format_best_list(timeframe_labels, timeframe_ratios, mark_natural) =>
    count_timeframes = array.size(timeframe_labels)
    if count_timeframes == 0
        STR_EMPTY
    else
        // find natural = closest to target ratio
        natural_index = 0
        if mark_natural and array.size(timeframe_ratios) > 0
            best_distance_from_12 = HUGE_DISTANCE
            // Guard against ratios shorter than timeframes
            count_ratios = array.size(timeframe_ratios)
            paired_count = math.min(count_timeframes, count_ratios)
            for idx = 0 to paired_count - 1
                ratio_value = array.get(timeframe_ratios, idx)
                distance_from_12 = math.abs(ratio_value - NATURAL_TARGET_RATIO)
                if distance_from_12 < best_distance_from_12
                    best_distance_from_12 := distance_from_12
                    natural_index := idx
        formatted_output = STR_EMPTY
        for idx = 0 to count_timeframes - 1
            if idx > 0
                formatted_output += STR_SPACE
            tf_label = array.get(timeframe_labels, idx)
            entry_text = tf_label
            if show_ratios and idx < array.size(timeframe_ratios)
                ratio_text = str.tostring(array.get(timeframe_ratios, idx), "#.##")
                entry_text += STR_RATIO_OPEN + STR_RATIO_BULLET + ratio_text + STR_RATIO_X + STR_RATIO_CLOSE
            if mark_natural and idx == natural_index
                entry_text += get_check_symbol()
            formatted_output += entry_text
        formatted_output

// Select natural + first backup (closest to ×12 then next closest)
select_natural_and_backup(timeframe_labels, timeframe_ratios) =>
    count_timeframes = array.size(timeframe_labels)
    count_ratios = array.size(timeframe_ratios)
    // If no candidates or no ratios, return empty safely
    if count_timeframes == 0 or count_ratios == 0
        [array.new<string>(), array.new<float>(), -1]
    else
        // Find natural (closest to target)
        natural_source_index = 0
        natural_distance = HUGE_DISTANCE
        // Only iterate where both timeframes and ratios have values
        paired_count = math.min(count_timeframes, count_ratios)
        for idx = 0 to paired_count - 1
            ratio_value = array.get(timeframe_ratios, idx)
            distance_from_12 = math.abs(ratio_value - NATURAL_TARGET_RATIO)
            if distance_from_12 < natural_distance
                natural_distance := distance_from_12
                natural_source_index := idx
        // Find backup (next closest)
        backup_index = -1
        backup_distance = HUGE_DISTANCE
        for idx = 0 to paired_count - 1
            if idx != natural_source_index
                ratio_value = array.get(timeframe_ratios, idx)
                distance_from_12 = math.abs(ratio_value - NATURAL_TARGET_RATIO)
                if distance_from_12 < backup_distance
                    backup_distance := distance_from_12
                    backup_index := idx
        // Build picks, then order strictly by ratio descending for Ultra Compact display
        picked_timeframes = array.new<string>()
        picked_ratios = array.new<float>()
        new_natural_index = -1
        for idx_order = 0 to paired_count - 1
            is_pick = (idx_order == natural_source_index) or (idx_order == backup_index)
            if is_pick
                array.push(picked_timeframes, array.get(timeframe_labels, idx_order))
                array.push(picked_ratios, array.get(timeframe_ratios, idx_order))
                if idx_order == natural_source_index
                    new_natural_index := array.size(picked_timeframes) - 1
        // Fallback safety: if only natural exists, ensure index is 0
        new_natural_index := (new_natural_index == -1) ? 0 : new_natural_index
        // If we have two picks, enforce ratio-desc ordering and adjust natural index
        if array.size(picked_ratios) == 2
            r0 = array.get(picked_ratios, 0)
            r1 = array.get(picked_ratios, 1)
            if r0 < r1
                // swap entries 0 and 1
                t0 = array.get(picked_timeframes, 0)
                t1 = array.get(picked_timeframes, 1)
                array.set(picked_timeframes, 0, t1)
                array.set(picked_timeframes, 1, t0)
                array.set(picked_ratios, 0, r1)
                array.set(picked_ratios, 1, r0)
                // flip natural index if needed
                new_natural_index := (new_natural_index == 0) ? 1 : (new_natural_index == 1 ? 0 : new_natural_index)
        [picked_timeframes, picked_ratios, new_natural_index]

// Format ultra-compact line from candidates, marking only natural
format_ultra_compact(timeframe_labels, timeframe_ratios, natural_index) =>
    count_timeframes = array.size(timeframe_labels)
    if count_timeframes == 0
        STR_EMPTY
    else
        formatted_output = STR_EMPTY
        for idx_label = 0 to count_timeframes - 1
            if idx_label > 0
                formatted_output += STR_SPACE
            tf_label = array.get(timeframe_labels, idx_label)
            entry_text = tf_label
            if show_ratios and idx_label < array.size(timeframe_ratios)
                ratio_text = str.tostring(array.get(timeframe_ratios, idx_label), "#.##")
                entry_text += STR_RATIO_OPEN + STR_RATIO_BULLET + ratio_text + STR_RATIO_X + STR_RATIO_CLOSE
            if idx_label == natural_index
                entry_text += get_check_symbol()
            formatted_output += entry_text
        formatted_output

// ═══════════════════════════════════════════════════════════════════════════════
// MAIN LOGIC
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.islast
    current_tf_minutes = tf_to_minutes(timeframe.period)
    current_tf_display = format_tf(current_tf_minutes)
    // Compute table background with user opacity
    table_bg = color.new(table_bg_color_base, table_bg_opacity)

    // Timeframe list (reference constant defined above)
    tf_list = TF_LIST_MINUTES

    // Storage arrays (tfs + ratios + classes)
    htf_ideal = array.new<string>()
    htf_edge = array.new<string>()
    htf_poor = array.new<string>()
    htf_ideal_r = array.new<float>()
    htf_edge_r = array.new<float>()
    htf_poor_r = array.new<float>()

    ltf_ideal = array.new<string>()
    ltf_edge = array.new<string>()
    ltf_poor = array.new<string>()
    ltf_ideal_r = array.new<float>()
    ltf_edge_r = array.new<float>()
    ltf_poor_r = array.new<float>()

    tf_list_count = array.size(tf_list)

    // Find HTF pairs (order-by-construction: largest TF first)
    for i_ord = 0 to tf_list_count - 1
        idx_tf = tf_list_count - 1 - i_ord
        tf_minutes = array.get(tf_list, idx_tf)
        if tf_minutes > current_tf_minutes
            tf_ratio = tf_minutes / current_tf_minutes
            accept_pair = tf_ratio == math.floor(tf_ratio) or is_bridge_pair(current_tf_minutes, tf_minutes)
            if accept_pair
                classification = (tf_ratio == math.floor(tf_ratio)) ? get_classification(tf_ratio) : EDGE
                tf_label = format_tf(tf_minutes)
                if classification == IDEAL and array.size(htf_ideal) < max_recommendations
                    push_unique(htf_ideal, htf_ideal_r, tf_label, tf_ratio)
                else if classification == EDGE and array.size(htf_edge) < max_recommendations
                    push_unique(htf_edge, htf_edge_r, tf_label, tf_ratio)
                else if show_poor_quality and array.size(htf_poor) < max_recommendations
                    push_unique(htf_poor, htf_poor_r, tf_label, tf_ratio)

    // Find LTF pairs (order-by-construction: smallest TF first)
    for i_ord = 0 to tf_list_count - 1
        idx_tf = i_ord
        tf_minutes = array.get(tf_list, idx_tf)
        if tf_minutes < current_tf_minutes
            tf_ratio = current_tf_minutes / tf_minutes
            accept_pair = tf_ratio == math.floor(tf_ratio) or is_bridge_pair(tf_minutes, current_tf_minutes)
            if accept_pair
                classification = (tf_ratio == math.floor(tf_ratio)) ? get_classification(tf_ratio) : EDGE
                tf_label = format_tf(tf_minutes)
                if classification == IDEAL and array.size(ltf_ideal) < max_recommendations
                    push_unique(ltf_ideal, ltf_ideal_r, tf_label, tf_ratio)
                else if classification == EDGE and array.size(ltf_edge) < max_recommendations
                    push_unique(ltf_edge, ltf_edge_r, tf_label, tf_ratio)
                else if show_poor_quality and array.size(ltf_poor) < max_recommendations
                    push_unique(ltf_poor, ltf_poor_r, tf_label, tf_ratio)

    // No additional sorting needed — arrays are built in desired order.

    // Create display
    if array.size(htf_ideal) > 0 or array.size(htf_edge) > 0 or (show_poor_quality and array.size(htf_poor) > 0) or array.size(ltf_ideal) > 0 or array.size(ltf_edge) > 0 or (show_poor_quality and array.size(ltf_poor) > 0)
        if display_style == STYLE_COMPACT
            // Compact: 4 columns [Label | HTF | Current | LTF]
            // Build row contents without labels; labels go in their own column
            best_htf_list = format_best_list(htf_ideal, htf_ideal_r, true)
            best_ltf_list = format_best_list(ltf_ideal, ltf_ideal_r, true)
            edge_htf_list = format_best_list(htf_edge, htf_edge_r, false)
            edge_ltf_list = format_best_list(ltf_edge, ltf_edge_r, false)
            rows_base = show_poor_quality ? 3 : 2
            // Reuse compact table if possible
            var table summary_table4 = na
            var int summary_rows = 0
            var string summary_pos_key = ""
            pos_key = str.tostring(get_position())
            if na(summary_table4) or summary_rows != rows_base or summary_pos_key != pos_key
                summary_table4 := table.new(get_position(), 4, rows_base, bgcolor=table_bg, frame_color=table_frame_color, frame_width=table_frame_width, border_color=table_border_color, border_width=table_border_width)
                summary_rows := rows_base
                summary_pos_key := pos_key
            // Row 0: Best
            table.cell(summary_table4, 0, 0, best_label, text_color=color_text, text_size=get_text_size())
            table.cell(summary_table4, 1, 0, best_htf_list, text_color=color_text, text_size=get_text_size(), tooltip=TIP_HTF_CONTEXT)
            table.cell(summary_table4, 2, 0, current_tf_display, text_color=color_current, text_size=get_text_size())
            table.cell(summary_table4, 3, 0, best_ltf_list, text_color=color_text, text_size=get_text_size(), tooltip=TIP_LTF_PRECISION)
            // Row 1: Edge
            table.cell(summary_table4, 0, 1, edge_label, text_color=color_text, text_size=get_text_size())
            table.cell(summary_table4, 1, 1, edge_htf_list, text_color=color_text, text_size=get_text_size(), tooltip=TIP_HTF_CONTEXT)
            table.cell(summary_table4, 2, 1, STR_EMPTY, text_color=color_text, text_size=get_text_size())
            table.cell(summary_table4, 3, 1, edge_ltf_list, text_color=color_text, text_size=get_text_size(), tooltip=TIP_LTF_PRECISION)
            // Row 2: Poor (optional)
            if show_poor_quality
                poor_htf_list = format_best_list(htf_poor, htf_poor_r, false)
                poor_ltf_list = format_best_list(ltf_poor, ltf_poor_r, false)
                table.cell(summary_table4, 0, 2, STR_POOR, text_color=color_text, text_size=get_text_size())
                table.cell(summary_table4, 1, 2, poor_htf_list, text_color=color_text, text_size=get_text_size())
                table.cell(summary_table4, 2, 2, STR_EMPTY)
                table.cell(summary_table4, 3, 2, poor_ltf_list, text_color=color_text, text_size=get_text_size())
        else
            // Ultra Compact: natural + first backup per side in one row
            // Build candidate pools: prefer Ideal, then Edge, then (optional) Poor

            // HTF candidates
            htf_candidate_timeframes = array.copy(htf_ideal)
            htf_candidate_ratios = array.copy(htf_ideal_r)
            htf_edge_count = array.size(htf_edge)
            if htf_edge_count > 0
                for idx_htf_edge = 0 to htf_edge_count - 1
                    array.push(htf_candidate_timeframes, array.get(htf_edge, idx_htf_edge))
                    array.push(htf_candidate_ratios, array.get(htf_edge_r, idx_htf_edge))
            if show_poor_quality
                htf_poor_count = array.size(htf_poor)
                if htf_poor_count > 0
                    for idx_htf_poor = 0 to htf_poor_count - 1
                        array.push(htf_candidate_timeframes, array.get(htf_poor, idx_htf_poor))
                        array.push(htf_candidate_ratios, array.get(htf_poor_r, idx_htf_poor))
            // LTF candidates
            ltf_candidate_timeframes = array.copy(ltf_ideal)
            ltf_candidate_ratios = array.copy(ltf_ideal_r)
            ltf_edge_count = array.size(ltf_edge)
            if ltf_edge_count > 0
                for idx_ltf_edge = 0 to ltf_edge_count - 1
                    array.push(ltf_candidate_timeframes, array.get(ltf_edge, idx_ltf_edge))
                    array.push(ltf_candidate_ratios, array.get(ltf_edge_r, idx_ltf_edge))
            if show_poor_quality
                ltf_poor_count = array.size(ltf_poor)
                if ltf_poor_count > 0
                    for idx_ltf_poor = 0 to ltf_poor_count - 1
                        array.push(ltf_candidate_timeframes, array.get(ltf_poor, idx_ltf_poor))
                        array.push(ltf_candidate_ratios, array.get(ltf_poor_r, idx_ltf_poor))

            [htf_picked_tfs, htf_picked_ratios, htf_natural_index] = select_natural_and_backup(htf_candidate_timeframes, htf_candidate_ratios)
            [ltf_picked_tfs, ltf_picked_ratios, ltf_natural_index] = select_natural_and_backup(ltf_candidate_timeframes, ltf_candidate_ratios)

            left_text = format_ultra_compact(htf_picked_tfs, htf_picked_ratios, htf_natural_index)
            right_text = format_ultra_compact(ltf_picked_tfs, ltf_picked_ratios, ltf_natural_index)

            // Reuse ultra table if possible
            var table ultra_table = na
            var string ultra_pos_key = ""
            pos_key_u = str.tostring(get_position())
            if na(ultra_table) or ultra_pos_key != pos_key_u
                ultra_table := table.new(get_position(), 3, 1, bgcolor=table_bg, frame_color=table_frame_color, frame_width=table_frame_width, border_color=table_border_color, border_width=table_border_width)
                ultra_pos_key := pos_key_u
            table.cell(ultra_table, 0, 0, left_text, text_color=color_text, text_size=get_text_size())
            table.cell(ultra_table, 1, 0, current_tf_display, text_color=color_current, text_size=get_text_size())
            table.cell(ultra_table, 2, 0, right_text, text_color=color_text, text_size=get_text_size())

        // No additional render paths
