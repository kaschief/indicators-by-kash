//@version=6
INDICATOR_MAX_BOXES = 500
INDICATOR_MAX_LABELS = 500
INDICATOR_MAX_LINES = 500
INDICATOR_TITLE='ranges •'
SHORT_TITLE="ranges •"

indicator(title=INDICATOR_TITLE, shorttitle=SHORT_TITLE, overlay=true, max_boxes_count=INDICATOR_MAX_BOXES, max_labels_count=INDICATOR_MAX_LABELS, max_lines_count=INDICATOR_MAX_LINES)

// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

const string TIMEZONE = "America/New_York"

// 30s Range time constants (minutes from midnight)
const int OR30_START_MIN = 570   // 09:30 = 9*60 + 30
const int CR30_START_MIN = 950   // 15:50 = 15*60 + 50

// Day of week constants
const int DOW_SUNDAY = 1
const int DOW_MONDAY = 2

// Session time constants (minutes from midnight)
const int SESSION_START_MIN = 1080  // 18:00 = 18*60

// Extend mode options
const string EXTEND_NEXT_OCCURRENCE = "Next Occurrence"
const string EXTEND_3_DAYS = "3 Days"

// Quick filter options
const string FILTER_ALL = "All"
const string FILTER_30S = "OR + CR"
const string FILTER_MONDAY = "Monday"

// Milliseconds
const int MS_PER_DAY = 24 * 60 * 60 * 1000

// Color defaults
const color DEFAULT_OR30_COLOR = color.new(color.rgb(165, 214, 167), 95)
const color DEFAULT_OR30_BOUNDARY_COLOR = color.rgb(165, 214, 167)
const color DEFAULT_OR30_LABEL_COLOR = color.rgb(77, 208, 225)
const color DEFAULT_CR30_COLOR = color.new(color.rgb(206, 147, 216), 95)
const color DEFAULT_CR30_BOUNDARY_COLOR = color.rgb(206, 147, 216)
const color DEFAULT_CR30_LABEL_COLOR = color.rgb(156, 156, 156)
const color DEFAULT_MONDAY_COLOR = color.new(color.rgb(249, 121, 246), 97)
const color DEFAULT_MONDAY_BOUNDARY_COLOR = color.rgb(41, 98, 255)
const color DEFAULT_MONDAY_LABEL_COLOR = color.rgb(41, 98, 255)

// Input groups
const string GROUP_COLOR_TABLE = "Color Reference Table"
const string GROUP_ALERTS = "Alerts"

// Alert messages
const string ALERT_HIGH_BREACHED = " High Breached"
const string ALERT_LOW_BREACHED = " Low Breached"

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

quickFilter = input.string(FILTER_ALL, "Quick Filter", options=[FILTER_ALL, FILTER_30S, FILTER_MONDAY])

i_showOR30 = input.bool(true, "Opening Range 30s", inline="or30", tooltip="Show the first 30 seconds of RTH (09:30:00-09:30:30)")
or30Limit = input.int(20, "", minval=1, maxval=20, inline="or30")
or30Color = input.color(DEFAULT_OR30_COLOR, "", inline="or30")
or30BoundaryColor = input.color(DEFAULT_OR30_BOUNDARY_COLOR, "Border", inline="or30b")
or30LabelColor = input.color(DEFAULT_OR30_LABEL_COLOR, "Label", inline="or30b")

i_showCR30 = input.bool(true, "Closing Range 30s", inline="cr30", tooltip="Show the 30-second candle at 15:50:00")
cr30Limit = input.int(20, "", minval=1, maxval=20, inline="cr30")
cr30Color = input.color(DEFAULT_CR30_COLOR, "", inline="cr30")
cr30BoundaryColor = input.color(DEFAULT_CR30_BOUNDARY_COLOR, "Border", inline="cr30b")
cr30LabelColor = input.color(DEFAULT_CR30_LABEL_COLOR, "Label", inline="cr30b")

i_showMonday = input.bool(true, "Monday Range", inline="monday", tooltip="Monday session high/low (Sun 18:00 - Mon 18:00 ET)")
mondayLimit = input.int(5, "", minval=1, maxval=20, inline="monday")
mondayColor = input.color(DEFAULT_MONDAY_COLOR, "", inline="monday")
mondayBoundaryColor = input.color(DEFAULT_MONDAY_BOUNDARY_COLOR, "Border", inline="mondayb")
mondayLabelColor = input.color(DEFAULT_MONDAY_LABEL_COLOR, "Label", inline="mondayb")

extendMode = input.string(EXTEND_3_DAYS, "Extend", options=[EXTEND_NEXT_OCCURRENCE, EXTEND_3_DAYS], tooltip="Next Occurrence: extends until next range. 3 Days: extends at least 3 days (or to next occurrence if longer)")

// Color Reference Table
showColorTable = input.bool(false, "Show Color Reference Table", group=GROUP_COLOR_TABLE, tooltip="Display a reference table showing all range colors and their RGB values")

// Alerts
alertOR30 = input.bool(true, "Opening Range 30s", group=GROUP_ALERTS)
alertCR30 = input.bool(true, "Closing Range 30s", group=GROUP_ALERTS)
alertMonday = input.bool(true, "Monday Range", group=GROUP_ALERTS)

// Apply quick filter to show toggles
showOR30 = i_showOR30 and (quickFilter == FILTER_ALL or quickFilter == FILTER_30S)
showCR30 = i_showCR30 and (quickFilter == FILTER_ALL or quickFilter == FILTER_30S)
showMonday = i_showMonday and (quickFilter == FILTER_ALL or quickFilter == FILTER_MONDAY)

// ═══════════════════════════════════════════════════════════════════════════════
// TYPES
// ═══════════════════════════════════════════════════════════════════════════════

type RangeData
    box rangeBox
    line topLine
    line bottomLine
    line eqLine
    label dateLabel
    float high
    float low
    int startTime
    int endTime
    int dayNum
    bool highBreached
    bool lowBreached

// ═══════════════════════════════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════════════════════════════

var array<RangeData> or30Array = array.new<RangeData>()
var array<RangeData> cr30Array = array.new<RangeData>()
var array<RangeData> mondayArray = array.new<RangeData>()

// Monday Range tracking (builds throughout Monday)
var float currentMondayHigh = na
var float currentMondayLow = na
var int currentMondayStart = na
var int currentMondayWeekNum = na
var RangeData liveMondayRange = na

// ═══════════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

getMonthName(int monthNum) =>
    switch monthNum
        1 => "𝙹𝚊𝚗"
        2 => "𝙵𝚎𝚋"
        3 => "𝙼𝚊𝚛"
        4 => "𝙰𝚙𝚛"
        5 => "𝙼𝚊𝚢"
        6 => "𝙹𝚞𝚗"
        7 => "𝙹𝚞𝚕"
        8 => "𝙰𝚞𝚐"
        9 => "𝚂𝚎𝚙"
        10 => "𝙾𝚌𝚝"
        11 => "𝙽𝚘𝚟"
        => "𝙳𝚎𝚌"

getDayName(int dow) =>
    switch dow
        1 => "𝚂𝚞𝚗"
        2 => "𝙼𝚘𝚗"
        3 => "𝚃𝚞𝚎"
        4 => "𝚆𝚎𝚍"
        5 => "𝚃𝚑𝚞"
        6 => "𝙵𝚛𝚒"
        => "𝚂𝚊𝚝"

// Calculate timestamp 3 trading days after startTime (skips weekends)
// Mon/Tue: +3 calendar days, Wed/Thu/Fri: +5 calendar days (skip weekend)
add3TradingDays(int startTime) =>
    dow = dayofweek(startTime, TIMEZONE)
    calendarDays = (dow == 2 or dow == 3) ? 3 : 5  // Mon=2, Tue=3 -> +3 days, else +5
    startTime + (calendarDays * MS_PER_DAY)

deleteRange(RangeData r) =>
    if not na(r.rangeBox)
        box.delete(r.rangeBox)
    if not na(r.topLine)
        line.delete(r.topLine)
    if not na(r.bottomLine)
        line.delete(r.bottomLine)
    if not na(r.eqLine)
        line.delete(r.eqLine)
    if not na(r.dateLabel)
        label.delete(r.dateLabel)

createRange(float highPrice, float lowPrice, int startTime, color boxColor, color borderColor, color lblColor, string labelPrefix, bool includeDayName = true) =>
    // Create box (right edge will be updated later)
    rangeBox = box.new(startTime, highPrice, startTime, lowPrice, xloc=xloc.bar_time, bgcolor=boxColor, border_color=na)

    // Boundary lines
    topLine = line.new(startTime, highPrice, startTime, highPrice, xloc=xloc.bar_time, color=borderColor, style=line.style_solid, width=1)
    bottomLine = line.new(startTime, lowPrice, startTime, lowPrice, xloc=xloc.bar_time, color=borderColor, style=line.style_solid, width=1)

    // EQ line (midpoint, dotted)
    eqPrice = (highPrice + lowPrice) / 2
    eqLine = line.new(startTime, eqPrice, startTime, eqPrice, xloc=xloc.bar_time, color=borderColor, style=line.style_dotted, width=1)

    // Date label
    rangeMonth = month(startTime, TIMEZONE)
    rangeDayNum = dayofmonth(startTime, TIMEZONE)
    monthName = getMonthName(rangeMonth)
    labelStr = includeDayName ? labelPrefix + "\n" + getDayName(dayofweek(startTime, TIMEZONE)) + ", " + monthName + " " + str.tostring(rangeDayNum) : labelPrefix + "\n" + monthName + " " + str.tostring(rangeDayNum)
    dateLabel = label.new(startTime, lowPrice, labelStr, xloc=xloc.bar_time, color=color.new(color.rgb(255, 255, 255), 100), textcolor=lblColor, style=label.style_label_up, size=size.small, textalign=text.align_center)

    RangeData.new(
         rangeBox = rangeBox,
         topLine = topLine,
         bottomLine = bottomLine,
         eqLine = eqLine,
         dateLabel = dateLabel,
         high = highPrice,
         low = lowPrice,
         startTime = startTime,
         endTime = na,
         dayNum = dayofmonth(startTime, TIMEZONE),
         highBreached = false,
         lowBreached = false
     )

// Close a range permanently (when next occurrence is detected)
closeRange(RangeData r, int endTime) =>
    r.endTime := endTime
    box.set_right(r.rangeBox, endTime)
    line.set_x2(r.topLine, endTime)
    line.set_x2(r.bottomLine, endTime)
    line.set_x2(r.eqLine, endTime)
    centerTime = math.round((r.startTime + endTime) / 2)
    label.set_x(r.dateLabel, centerTime)

// Extend range to a specific time (updates visuals only, doesn't set endTime)
extendRangeTo(RangeData r, int targetTime) =>
    box.set_right(r.rangeBox, targetTime)
    line.set_x2(r.topLine, targetTime)
    line.set_x2(r.bottomLine, targetTime)
    line.set_x2(r.eqLine, targetTime)
    centerTime = math.round((r.startTime + targetTime) / 2)
    label.set_x(r.dateLabel, centerTime)

// Update range high/low (for live expanding ranges)
updateRangeHighLow(RangeData r, float newHigh, float newLow, int rightTime) =>
    r.high := newHigh
    r.low := newLow
    eqPrice = (newHigh + newLow) / 2
    box.set_top(r.rangeBox, newHigh)
    box.set_bottom(r.rangeBox, newLow)
    box.set_right(r.rangeBox, rightTime)
    line.set_y1(r.topLine, newHigh)
    line.set_y2(r.topLine, newHigh)
    line.set_x2(r.topLine, rightTime)
    line.set_y1(r.bottomLine, newLow)
    line.set_y2(r.bottomLine, newLow)
    line.set_x2(r.bottomLine, rightTime)
    line.set_y1(r.eqLine, eqPrice)
    line.set_y2(r.eqLine, eqPrice)
    line.set_x2(r.eqLine, rightTime)
    label.set_y(r.dateLabel, newLow)
    centerTime = math.round((r.startTime + rightTime) / 2)
    label.set_x(r.dateLabel, centerTime)

// Capture a range if conditions are met (reusable for any range type)
captureRange(array<RangeData> rangeArray, int targetMin, bool show, int ltfMinutes, int ltfSeconds, int ltfDay, int ltfTime, float ltfHigh, float ltfLow, color boxColor, color borderColor, color lblColor, string labelPrefix, int limit) =>
    if show and ltfMinutes == targetMin and ltfSeconds == 0
        alreadyExists = array.size(rangeArray) > 0 ? array.get(rangeArray, array.size(rangeArray) - 1).dayNum == ltfDay : false
        if not alreadyExists
            // Always close previous range at next occurrence (sets endTime)
            if array.size(rangeArray) > 0
                closeRange(array.get(rangeArray, array.size(rangeArray) - 1), ltfTime)
            array.push(rangeArray, createRange(ltfHigh, ltfLow, ltfTime, boxColor, borderColor, lblColor, labelPrefix))
            if array.size(rangeArray) > limit
                deleteRange(array.shift(rangeArray))

// Update all ranges based on extend mode
updateRangeExtensions(array<RangeData> rangeArray) =>
    if array.size(rangeArray) > 0
        for i = 0 to array.size(rangeArray) - 1
            r = array.get(rangeArray, i)
            if extendMode == EXTEND_NEXT_OCCURRENCE
                // Extend only the most recent (unclosed) to present
                if i == array.size(rangeArray) - 1 and na(r.endTime)
                    extendRangeTo(r, time)
            else
                // 3 Days mode: extend to the LONGER of (next occurrence, start + 3 trading days)
                minEnd = add3TradingDays(r.startTime)
                targetEnd = na(r.endTime) ? minEnd : math.max(minEnd, r.endTime)
                // Cap at present if target is in the future
                extendRangeTo(r, math.min(targetEnd, time))

// ═══════════════════════════════════════════════════════════════════════════════
// 30S DATA CAPTURE
// ═══════════════════════════════════════════════════════════════════════════════

[cached_30s_times, cached_30s_highs, cached_30s_lows] = request.security_lower_tf(syminfo.tickerid, "30S", [time, high, low])

if (showOR30 or showCR30) and not na(cached_30s_times) and array.size(cached_30s_times) > 0
    for i = 0 to array.size(cached_30s_times) - 1
        ltfTime = array.get(cached_30s_times, i)
        ltfMinutes = hour(ltfTime, TIMEZONE) * 60 + minute(ltfTime, TIMEZONE)
        ltfSeconds = second(ltfTime, TIMEZONE)
        ltfDay = dayofmonth(ltfTime, TIMEZONE)
        ltfHigh = array.get(cached_30s_highs, i)
        ltfLow = array.get(cached_30s_lows, i)

        captureRange(or30Array, OR30_START_MIN, showOR30, ltfMinutes, ltfSeconds, ltfDay, ltfTime, ltfHigh, ltfLow, or30Color, or30BoundaryColor, or30LabelColor, "𝙾𝚙𝚎𝚗𝚒𝚗𝚐 𝚁𝚊𝚗𝚐𝚎", or30Limit)
        captureRange(cr30Array, CR30_START_MIN, showCR30, ltfMinutes, ltfSeconds, ltfDay, ltfTime, ltfHigh, ltfLow, cr30Color, cr30BoundaryColor, cr30LabelColor, "𝙲𝚕𝚘𝚜𝚒𝚗𝚐 𝚁𝚊𝚗𝚐𝚎", cr30Limit)

// ═══════════════════════════════════════════════════════════════════════════════
// MONDAY RANGE CAPTURE
// ═══════════════════════════════════════════════════════════════════════════════

// Monday session = Sunday 18:00 to Monday 18:00 ET
if showMonday
    currentDow = dayofweek(time, TIMEZONE)
    currentMinutes = hour(time, TIMEZONE) * 60 + minute(time, TIMEZONE)
    currentWeek = weekofyear(time, TIMEZONE)

    // Check if we're in Monday session (Sunday >= 18:00 or Monday < 18:00)
    inMondaySession = (currentDow == DOW_SUNDAY and currentMinutes >= SESSION_START_MIN) or (currentDow == DOW_MONDAY and currentMinutes < SESSION_START_MIN)

    if inMondaySession
        // In Monday session: track high/low and show live range
        if na(currentMondayWeekNum) or currentWeek != currentMondayWeekNum
            // New Monday session - create live range
            currentMondayHigh := high
            currentMondayLow := low
            currentMondayStart := time
            currentMondayWeekNum := currentWeek
            liveMondayRange := createRange(high, low, time, mondayColor, mondayBoundaryColor, mondayLabelColor, "𝙼𝚘𝚗𝚍𝚊𝚢 𝚁𝚊𝚗𝚐𝚎", false)
        else
            // Continue tracking - expand range if new high/low
            // Note: No breach alerts during session - range is still forming
            currentMondayHigh := math.max(currentMondayHigh, high)
            currentMondayLow := math.min(currentMondayLow, low)
            if not na(liveMondayRange)
                updateRangeHighLow(liveMondayRange, currentMondayHigh, currentMondayLow, time)
    else if not na(liveMondayRange)
        // First bar after Monday session ends: finalize the range
        // Close previous completed Monday range if exists
        if array.size(mondayArray) > 0
            closeRange(array.get(mondayArray, array.size(mondayArray) - 1), currentMondayStart)

        // Move live range to completed array
        array.push(mondayArray, liveMondayRange)

        if array.size(mondayArray) > mondayLimit
            deleteRange(array.shift(mondayArray))

        // Reset tracking vars
        liveMondayRange := na
        currentMondayHigh := na
        currentMondayLow := na
        currentMondayStart := na

// ═══════════════════════════════════════════════════════════════════════════════
// UPDATE RANGE EXTENSIONS
// ═══════════════════════════════════════════════════════════════════════════════

updateRangeExtensions(or30Array)
updateRangeExtensions(cr30Array)

// Monday Range: each extends to the next Monday's start, most recent extends to current time
// PROOF no overlap is possible:
// - For i < last: extends to mondayArray[i+1].startTime (next completed range)
// - For i == last AND liveMondayRange exists: extends to liveMondayRange.startTime (current building range)
// - For i == last AND no liveMondayRange: extends to current time (nothing after it)
// - liveMondayRange: extends to current time (still building)
if array.size(mondayArray) > 0
    for i = 0 to array.size(mondayArray) - 1
        r = array.get(mondayArray, i)
        if i < array.size(mondayArray) - 1
            // Extend to next Monday's start time
            nextRange = array.get(mondayArray, i + 1)
            extendRangeTo(r, nextRange.startTime)
        else if not na(liveMondayRange)
            // Last in array but live range exists - extend to live range's start
            extendRangeTo(r, liveMondayRange.startTime)
        else
            // Most recent and no live range - extend to current time
            extendRangeTo(r, time)

// Live Monday Range extends to current time
if not na(liveMondayRange)
    extendRangeTo(liveMondayRange, time)

// ═══════════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════════

checkRangeAlerts(array<RangeData> rangeArray, bool enableAlert, string rangeName) =>
    if enableAlert and array.size(rangeArray) > 0
        for i = 0 to array.size(rangeArray) - 1
            r = array.get(rangeArray, i)
            // High breached (price crosses above)
            if not r.highBreached and high > r.high
                r.highBreached := true
                alert(rangeName + ALERT_HIGH_BREACHED, alert.freq_once_per_bar)
            // Low breached (price crosses below)
            if not r.lowBreached and low < r.low
                r.lowBreached := true
                alert(rangeName + ALERT_LOW_BREACHED, alert.freq_once_per_bar)

checkRangeAlerts(or30Array, alertOR30, "𝙾𝚙𝚎𝚗𝚒𝚗𝚐 𝚁𝚊𝚗𝚐𝚎")
checkRangeAlerts(cr30Array, alertCR30, "𝙲𝚕𝚘𝚜𝚒𝚗𝚐 𝚁𝚊𝚗𝚐𝚎")
checkRangeAlerts(mondayArray, alertMonday, "𝙼𝚘𝚗𝚍𝚊𝚢 𝚁𝚊𝚗𝚐𝚎")
// Note: Monday Range alerts only fire after session completes (Mon 18:00+) - no alerts during formation

// ═══════════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE
// ═══════════════════════════════════════════════════════════════════════════════

addColorRow(table tbl, int row, string name, string colorType, color clr) =>
    table.cell(tbl, 0, row, name, text_size=size.small, text_color=color.black)
    table.cell(tbl, 1, row, colorType, text_size=size.small, text_color=color.black)
    table.cell(tbl, 2, row, str.format("R:{0} G:{1} B:{2}", int(color.r(clr)), int(color.g(clr)), int(color.b(clr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 3, row, str.tostring(int(color.t(clr))), text_size=size.small, text_color=color.black)

if showColorTable and barstate.islast
    var table colorTable = table.new(position.top_right, 4, 13, bgcolor=color.white, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

    // Header row
    table.cell(colorTable, 0, 0, "Range", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 1, 0, "Type", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 2, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 3, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)

    int currentRow = 1

    if showOR30
        addColorRow(colorTable, currentRow, "Opening Range", "Fill", or30Color)
        currentRow += 1
        addColorRow(colorTable, currentRow, "Opening Range", "Border", or30BoundaryColor)
        currentRow += 1
        addColorRow(colorTable, currentRow, "Opening Range", "Label", or30LabelColor)
        currentRow += 1

    if showCR30
        addColorRow(colorTable, currentRow, "Closing Range", "Fill", cr30Color)
        currentRow += 1
        addColorRow(colorTable, currentRow, "Closing Range", "Border", cr30BoundaryColor)
        currentRow += 1
        addColorRow(colorTable, currentRow, "Closing Range", "Label", cr30LabelColor)
        currentRow += 1

    if showMonday
        addColorRow(colorTable, currentRow, "Monday Range", "Fill", mondayColor)
        currentRow += 1
        addColorRow(colorTable, currentRow, "Monday Range", "Border", mondayBoundaryColor)
        currentRow += 1
        addColorRow(colorTable, currentRow, "Monday Range", "Label", mondayLabelColor)
        currentRow += 1
