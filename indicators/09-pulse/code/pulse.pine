INDICATOR_MAX_LINES = 500
INDICATOR_MAX_LABELS = 500
INDICATOR_MAX_BOXES = 500
INDICATOR_TITLE = 'pulse •'

indicator(INDICATOR_TITLE, overlay=true, max_lines_count=INDICATOR_MAX_LINES, max_labels_count=INDICATOR_MAX_LABELS, max_boxes_count=INDICATOR_MAX_BOXES)

