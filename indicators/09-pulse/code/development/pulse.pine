rangeBoxShowLast = input.int(15, UI_SHOW_LAST, minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX_RANGE, group=GROUP_RANGE_BOX, inline='range_options')
rangeBoxWidth = input.int(LINE_WIDTH_2, UI_WIDTH, options=[LINE_WIDTH_1, LINE_WIDTH_2, LINE_WIDTH_3, LINE_WIDTH_4, LINE_WIDTH_5], group=GROUP_RANGE_BOX, inline='range_options')

