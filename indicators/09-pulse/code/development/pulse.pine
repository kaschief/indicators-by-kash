// ─── Session Boxes (Killzones) ───
showSessionBoxes = input.bool(false, "Show Session Boxes", group=GROUP_SESSION_BOXES, inline='sbtop', tooltip="Draw a high-to-low box for each killzone session (Asia, London, NY AM, NY PM, Premarket). Select the 'Just Sessions' Pulse Mode to show only these boxes.")
sessionBoxShowLast = input.int(3, UI_SHOW_LAST, minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX_INTRADAY, group=GROUP_SESSION_BOXES, inline='sbtop')
