overnightLiqDepthL3Width = input.int(LINE_WIDTH_2, "", options=[LINE_WIDTH_1, LINE_WIDTH_2, LINE_WIDTH_3, LINE_WIDTH_4, LINE_WIDTH_5], group=GROUP_POISZN, inline="overnight_l3")

showPremarket = input.bool(true, UI_PREMARKET_SESSION, group=GROUP_POISZN, inline='premarket')
premarketColor = input.color(DEFAULT_PREMARKET_COLOR, UI_COLOR, group=GROUP_POISZN, inline='premarket')
