// ─── Monthly ───
showMonthly = input.bool(true, GROUP_MONTHLY, group=GROUP_MONTHLY)
monthlyShowLast = input.int(1, UI_SHOW_LAST, minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX_MONTHLY, group=GROUP_MONTHLY, inline='monthly')
monthlyColor = input.color(DEFAULT_MONTHLY_COLOR, UI_COLOR, group=GROUP_MONTHLY, inline='monthly')
monthlyLineWidth = input.int(LINE_WIDTH_4, UI_WIDTH, options=[LINE_WIDTH_1, LINE_WIDTH_2, LINE_WIDTH_3, LINE_WIDTH_4, LINE_WIDTH_5], group=GROUP_MONTHLY, inline='monthly')
enableMonthlyLiquidityDepth = input.bool(false, "Liquidity Depth", group=GROUP_MONTHLY, inline='monthly_liq', tooltip="Projects liquidity depth levels (L1, L2, L3) above highs and below lows.\nValid on 12hr-1W charts.")
monthlyLiqDepthColorPreset = input.string(LIQUIDITY_DEPTH_PRESET_DEFAULT, "", options=[LIQUIDITY_DEPTH_PRESET_DEFAULT, LIQUIDITY_DEPTH_PRESET_POOL_COLORS], group=GROUP_MONTHLY, inline='monthly_liq')
