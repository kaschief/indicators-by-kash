overnightLiqDepthL2Style = input.string(LINE_STYLE_DOTTED, "", options=[LINE_STYLE_SOLID, LINE_STYLE_DASHED, LINE_STYLE_DOTTED], group=GROUP_POISZN, inline="overnight_l2")
