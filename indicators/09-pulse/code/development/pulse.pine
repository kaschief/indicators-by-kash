weeklyLiqDepthL1Width = input.int(LINE_WIDTH_1, "", options=[LINE_WIDTH_1, LINE_WIDTH_2, LINE_WIDTH_3, LINE_WIDTH_4, LINE_WIDTH_5], group=GROUP_WEEKLY, inline="weekly_l1")
weeklyLiqDepthL2Color = input.color(DEFAULT_LIQUIDITY_DEPTH_EXTENSION_COLOR, "  L2", group=GROUP_WEEKLY, inline="weekly_l2")
