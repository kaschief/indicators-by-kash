close1400LineWidth = input.int(LINE_WIDTH_1, UI_WIDTH, options=[LINE_WIDTH_1, LINE_WIDTH_2, LINE_WIDTH_3, LINE_WIDTH_4, LINE_WIDTH_5], group=GROUP_INTRADAY_CLOSE_1400, inline='1400_options')
close1400MitigationWindow = input.string(MITIGATION_WINDOW_ANYTIME, "Mitigation Window", group=GROUP_INTRADAY_CLOSE_1400, inline='1400_options', options=[MITIGATION_WINDOW_ANYTIME, MITIGATION_WINDOW_MARKET_HOURS], tooltip="Anytime: Level can be mitigated any time after 05:00 (includes overnight/Asian session). Levels mitigated more frequently.\nMarket-Hours: Level can ONLY be mitigated during 05:00-16:00 (filters overnight manipulation). Results in MORE levels visible on screen as they persist longer, better for identifying institutional levels.")
close1400UntappedWidth = input.int(LINE_WIDTH_2, "Untapped Width", options=[LINE_WIDTH_1, LINE_WIDTH_2, LINE_WIDTH_3, LINE_WIDTH_4, LINE_WIDTH_5], group=GROUP_INTRADAY_CLOSE_1400, inline='1400_options')

show1600Close = input.bool(false, "16:00 Close", group=GROUP_INTRADAY_CLOSE_1600, tooltip="Track and project the 16:00 1-minute candle close price until mitigated. Automatically captures 18:00 reopen on early-close days (e.g., holidays when market closes at 13:00). Only available on 1m to 1H timeframes.")
close1600ShowLast = input.int(15, UI_SHOW_LAST, minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX_CLOSES, group=GROUP_INTRADAY_CLOSE_1600, inline='1600_options')
close1600Color = input.color(DEFAULT_1600_CLOSE_COLOR, UI_COLOR, group=GROUP_INTRADAY_CLOSE_1600, inline='1600_options')
close1600LineWidth = input.int(LINE_WIDTH_1, UI_WIDTH, options=[LINE_WIDTH_1, LINE_WIDTH_2, LINE_WIDTH_3, LINE_WIDTH_4, LINE_WIDTH_5], group=GROUP_INTRADAY_CLOSE_1600, inline='1600_options')
close1600MitigationWindow = input.string(MITIGATION_WINDOW_ANYTIME, "Mitigation Window", group=GROUP_INTRADAY_CLOSE_1600, inline='1600_options', options=[MITIGATION_WINDOW_ANYTIME, MITIGATION_WINDOW_MARKET_HOURS], tooltip="Anytime: Level can be mitigated any time after 05:00 (includes overnight/Asian session). Levels mitigated more frequently.\nMarket-Hours: Level can ONLY be mitigated during 05:00-16:00 (filters overnight manipulation). Results in MORE levels visible on screen as they persist longer, better for identifying institutional levels.")
close1600UntappedWidth = input.int(LINE_WIDTH_2, "Untapped Width", options=[LINE_WIDTH_1, LINE_WIDTH_2, LINE_WIDTH_3, LINE_WIDTH_4, LINE_WIDTH_5], group=GROUP_INTRADAY_CLOSE_1600, inline='1600_options')

showLabels = input.bool(true, GROUP_LABELS, group=GROUP_LABELS, inline='labels')
labelTextColor = input.color(DEFAULT_LABEL_TEXT_COLOR, UI_TEXT_COLOR, group=GROUP_LABELS, inline='labels')
showSessionOnSweepLabels = input.bool(true, "Show Session Sweep Tags", group=GROUP_LABELS, tooltip="Show session name alongside L1/L2/L3 sweep labels (e.g. 'L1 asia').")
showDepthReminders = input.bool(true, "Depth Reminders", group=GROUP_LABELS, inline="label_reminders", active=showLabels)
showPoolReminders = input.bool(true, "Pool Reminders", group=GROUP_LABELS, inline="label_reminders", active=showLabels, tooltip="Depth Reminders — Repeat L1/L2/L3 tags on long liquidity-depth lines.\n\nPool Reminders — Repeat Daily, Weekly, Monthly, Overnight, Premarket, and intraday high/low names on long pool lines.\n\nBoth stay sparse: short lines keep one label; multi-day lines can earn a second or third.")
mergeOverlappingLabels = input.bool(true, "Merge Overlapping Labels", group=GROUP_LABELS, inline="label_merge", active=showLabels)
labelMergePreset = input.string(LABEL_MERGE_EXTRA_WIDE, "", options=[LABEL_MERGE_STRICT, LABEL_MERGE_BALANCED, LABEL_MERGE_WIDE, LABEL_MERGE_EXTRA_WIDE, LABEL_MERGE_CUSTOM], group=GROUP_LABELS, inline="label_merge", active=showLabels and mergeOverlappingLabels)
customLabelMergeDistancePercent = input.float(LABEL_MERGE_BALANCED_PERCENT, "%", minval=0.0, maxval=0.5, step=0.001, group=GROUP_LABELS, inline="label_merge", active=showLabels and mergeOverlappingLabels and labelMergePreset == LABEL_MERGE_CUSTOM, tooltip="Merge Overlapping Labels\nCombines nearby pool reminders and L1/L2/L3 tags in one label, including different L tiers. Every L identity remains explicit; mixed sides add high/low. Lines keep their own origin, endpoint, color, width, and style.\n\nDistance\n• Strict — 0.005%.\n• Balanced — 0.010%.\n• Wide — 0.025%.\n• Extra Wide — 0.050%.\n• Custom — use %.\n\nMinimum distance is one tick. Off keeps labels separate.")
labelMergeDistancePercent = labelMergePreset == LABEL_MERGE_STRICT ? LABEL_MERGE_STRICT_PERCENT : labelMergePreset == LABEL_MERGE_WIDE ? LABEL_MERGE_WIDE_PERCENT : labelMergePreset == LABEL_MERGE_EXTRA_WIDE ? LABEL_MERGE_EXTRA_WIDE_PERCENT : labelMergePreset == LABEL_MERGE_CUSTOM ? customLabelMergeDistancePercent : LABEL_MERGE_BALANCED_PERCENT

// ─── Asset Levels Table ───
showAssetLevelsTable = input.bool(false, "Show Asset Levels", group=GROUP_LABELS, tooltip="Display a table showing detected asset and its liquidity depth levels")

// ─── Alerts ───
alertDaily = input.bool(true, "Daily", group=GROUP_ALERTS, inline="alert_htf")
alertWeekly = input.bool(true, "Weekly", group=GROUP_ALERTS, inline="alert_htf")
alertMonthly = input.bool(true, "Monthly", group=GROUP_ALERTS, inline="alert_htf")
alertIntraday = input.bool(false, "Intraday", group=GROUP_ALERTS, inline="alert_sessions", tooltip="Asia, London, NY AM, Lunch, NY PM")
alertOvernight = input.bool(true, "Overnight", group=GROUP_ALERTS, inline="alert_sessions")
alertPremarket = input.bool(true, "Premarket", group=GROUP_ALERTS, inline="alert_sessions")
alert1600Close = input.bool(true, "16:00 Mitigation", group=GROUP_ALERTS, tooltip="Alert when 16:00 close level is mitigated")

// ─── Color Reference Table ───
showColorTable = input.bool(false, "Show Color Reference Table", group=GROUP_COLOR_TABLE, tooltip="Display a table showing all color settings with RGB values and transparency levels")

// ═══════════════════════════════════════════════════════════════════════════════
// PULSE MODE FILTER LOGIC
// ═══════════════════════════════════════════════════════════════════════════════

// Apply Pulse Mode filter to determine if a pool type should be shown
// Overrides individual ON/OFF toggles when filter is not "All"
applyPulseModeFilter(poolType, individualToggle) =>
    bool result = individualToggle

    if pulseModeFilter == FILTER_MONTHLY
        result := poolType == POOL_TYPE_MONTHLY
    else if pulseModeFilter == FILTER_WEEKLY
        result := poolType == POOL_TYPE_WEEKLY
    else if pulseModeFilter == FILTER_DAILY
        result := poolType == POOL_TYPE_DAILY
    else if pulseModeFilter == FILTER_HTF
        result := poolType == POOL_TYPE_DAILY or poolType == POOL_TYPE_WEEKLY or poolType == POOL_TYPE_MONTHLY
    else if pulseModeFilter == FILTER_INTRADAY
        result := poolType == POOL_TYPE_ASIA or poolType == POOL_TYPE_LONDON or poolType == POOL_TYPE_NYAM or poolType == POOL_TYPE_LUNCH or poolType == POOL_TYPE_NYPM
    else if pulseModeFilter == FILTER_INTRADAY_PREMARKET_OVERNIGHT
        result := poolType == POOL_TYPE_ASIA or poolType == POOL_TYPE_LONDON or poolType == POOL_TYPE_NYAM or poolType == POOL_TYPE_LUNCH or poolType == POOL_TYPE_NYPM or poolType == POOL_TYPE_PREMARKET or poolType == POOL_TYPE_OVERNIGHT
    else if pulseModeFilter == FILTER_PREMARKET_OVERNIGHT
        result := poolType == POOL_TYPE_PREMARKET or poolType == POOL_TYPE_OVERNIGHT
    else if pulseModeFilter == FILTER_1400_1600
        result := poolType == POOL_TYPE_1400 or poolType == POOL_TYPE_1600
    else if pulseModeFilter == FILTER_KEY_OPENS
        result := poolType == POOL_TYPE_MNO_OPEN or poolType == POOL_TYPE_830_OPEN or poolType == POOL_TYPE_930_OPEN
    else if pulseModeFilter == FILTER_HTF_OPENS
        result := poolType == POOL_TYPE_DAILY_OPEN or poolType == POOL_TYPE_WEEKLY_OPEN or poolType == POOL_TYPE_MONTHLY_OPEN
    else if pulseModeFilter == FILTER_4H_OPEN
        result := poolType == POOL_TYPE_4H_OPEN
    else if pulseModeFilter == FILTER_10AM_4H_OPEN
        result := poolType == POOL_TYPE_4H_OPEN
    else if pulseModeFilter == FILTER_1H_OPEN
        result := poolType == POOL_TYPE_1H_OPEN
    else if pulseModeFilter == FILTER_RANGE_BOX
        result := poolType == POOL_TYPE_RANGE_BOX
    else if pulseModeFilter == FILTER_RANGE_BOX_MNO
        result := poolType == POOL_TYPE_RANGE_BOX or poolType == POOL_TYPE_MNO_OPEN
    else if pulseModeFilter == FILTER_RANGE_BOX_MNO_PRE_ONS
        result := poolType == POOL_TYPE_RANGE_BOX or poolType == POOL_TYPE_MNO_OPEN or poolType == POOL_TYPE_PREMARKET or poolType == POOL_TYPE_OVERNIGHT
    else if pulseModeFilter == FILTER_RANGE_BOX_1600
        result := poolType == POOL_TYPE_RANGE_BOX or poolType == POOL_TYPE_1600
    else if pulseModeFilter == FILTER_1400_1600_RANGE_BOX
        result := poolType == POOL_TYPE_1400 or poolType == POOL_TYPE_1600 or poolType == POOL_TYPE_RANGE_BOX
    else if pulseModeFilter == FILTER_LIQUIDITY_MAP
        result := poolType == POOL_TYPE_RANGE_BOX or poolType == POOL_TYPE_1400 or poolType == POOL_TYPE_1600 or poolType == POOL_TYPE_PREMARKET or poolType == POOL_TYPE_OVERNIGHT
    else if pulseModeFilter == FILTER_TODAY
        result := poolType == POOL_TYPE_RANGE_BOX or poolType == POOL_TYPE_1600 or poolType == POOL_TYPE_PREMARKET or poolType == POOL_TYPE_OVERNIGHT or poolType == POOL_TYPE_DAILY or poolType == POOL_TYPE_WEEKLY or poolType == POOL_TYPE_MONTHLY or poolType == POOL_TYPE_MNO_OPEN or poolType == POOL_TYPE_830_OPEN or poolType == POOL_TYPE_930_OPEN
    else if pulseModeFilter == FILTER_RANGE_KEY_OPENS
        result := poolType == POOL_TYPE_RANGE_BOX or poolType == POOL_TYPE_1400 or poolType == POOL_TYPE_1600 or poolType == POOL_TYPE_MNO_OPEN or poolType == POOL_TYPE_830_OPEN or poolType == POOL_TYPE_930_OPEN
    else if pulseModeFilter == FILTER_WORK_RANGE_KEY_OPENS_HTF
        result := poolType == POOL_TYPE_RANGE_BOX or poolType == POOL_TYPE_1400 or poolType == POOL_TYPE_1600 or poolType == POOL_TYPE_MNO_OPEN or poolType == POOL_TYPE_830_OPEN or poolType == POOL_TYPE_930_OPEN or poolType == POOL_TYPE_DAILY or poolType == POOL_TYPE_WEEKLY or poolType == POOL_TYPE_MONTHLY
    else if pulseModeFilter == FILTER_JUST_SESSIONS
        result := false  // Hide all pools/lines, only show session boxes
    // else FILTER_ALL - use individual toggle

    result

// Apply Pulse Mode filter and timeframe visibility to each pool type
// HTF levels hidden on their native timeframe or higher (e.g., Daily hidden on Daily/Weekly/Monthly)
showDailyFiltered = applyPulseModeFilter(POOL_TYPE_DAILY, showDaily) and timeframe.in_seconds() <= 86400  // Visible up to and including Daily TF
showWeeklyFiltered = applyPulseModeFilter(POOL_TYPE_WEEKLY, showWeekly) and timeframe.in_seconds() <= 604800  // Visible up to and including Weekly TF
showMonthlyFiltered = applyPulseModeFilter(POOL_TYPE_MONTHLY, showMonthly) and timeframe.in_seconds() <= 2592000  // Visible up to and including Monthly TF
// In Today mode, intraday sessions are hidden unless "Add Intraday Depths" is enabled
showIntradayInTodayMode = pulseModeFilter == FILTER_TODAY and showIntradayDepthsInToday
showAsiaFiltered = applyPulseModeFilter(POOL_TYPE_ASIA, showIntraday) or showIntradayInTodayMode
showLondonFiltered = applyPulseModeFilter(POOL_TYPE_LONDON, showIntraday) or showIntradayInTodayMode
showNyamFiltered = applyPulseModeFilter(POOL_TYPE_NYAM, showIntraday) or showIntradayInTodayMode
showLunchFiltered = applyPulseModeFilter(POOL_TYPE_LUNCH, showIntraday) or showIntradayInTodayMode
showNypmFiltered = applyPulseModeFilter(POOL_TYPE_NYPM, showIntraday) or showIntradayInTodayMode
showPremarketFiltered = applyPulseModeFilter(POOL_TYPE_PREMARKET, showPremarket)
showOvernightFiltered = applyPulseModeFilter(POOL_TYPE_OVERNIGHT, showOvernight)
show1400CloseFiltered = applyPulseModeFilter(POOL_TYPE_1400, show1400Close)
keyOpensVisible = pulseModeFilter != FILTER_TODAY or showKeyOpensInToday
show1600CloseFiltered = applyPulseModeFilter(POOL_TYPE_1600, show1600Close) and keyOpensVisible
show4HOpenFiltered = applyPulseModeFilter(POOL_TYPE_4H_OPEN, show4HOpen)
show1HOpenFiltered = applyPulseModeFilter(POOL_TYPE_1H_OPEN, show1HOpen)
showMnoOpenFiltered = applyPulseModeFilter(POOL_TYPE_MNO_OPEN, showMnoOpen) and keyOpensVisible
show830OpenFiltered = applyPulseModeFilter(POOL_TYPE_830_OPEN, show830Open) and keyOpensVisible
show930OpenFiltered = applyPulseModeFilter(POOL_TYPE_930_OPEN, show930Open) and keyOpensVisible
showDailyOpenFiltered = applyPulseModeFilter(POOL_TYPE_DAILY_OPEN, showDailyOpen)
showWeeklyOpenFiltered = applyPulseModeFilter(POOL_TYPE_WEEKLY_OPEN, showWeeklyOpen)
showMonthlyOpenFiltered = applyPulseModeFilter(POOL_TYPE_MONTHLY_OPEN, showMonthlyOpen)
showRangeBoxFiltered = applyPulseModeFilter(POOL_TYPE_RANGE_BOX, showRangeBox) and keyOpensVisible

// "Today" filter: override show last values to `todayShowLast` (default 1) and auto-enable liquidity depth
isTodayFilter = pulseModeFilter == FILTER_TODAY
isJustSessionsFilter = pulseModeFilter == FILTER_JUST_SESSIONS

// Session boxes are active when their toggle is on, or the dedicated Just Sessions mode is selected
sessionBoxesActive = showSessionBoxes or isJustSessionsFilter
effectiveDailyShowLast = isTodayFilter ? todayShowLast : dailyShowLast
effectiveWeeklyShowLast = isTodayFilter ? todayShowLast : weeklyShowLast
effectiveMonthlyShowLast = isTodayFilter ? todayShowLast : monthlyShowLast
effectivePoisznShowLast = isTodayFilter ? todayShowLast : poisznShowLast
effectiveClose1600ShowLast = isTodayFilter ? todayShowLast : close1600ShowLast
effectiveOpenMnoShowLast = isTodayFilter ? todayShowLast : openMnoShowLast
effectiveOpen830ShowLast = isTodayFilter ? todayShowLast : open830ShowLast
effectiveOpen930ShowLast = isTodayFilter ? todayShowLast : open930ShowLast
effectiveRangeBoxShowLast = isTodayFilter ? todayShowLast : rangeBoxShowLast
effectiveIntradayShowLast = showIntradayInTodayMode ? todayShowLast : intradayShowLast
effectiveEnableDailyLiquidityDepth = isTodayFilter ? true : enableDailyLiquidityDepth
effectiveEnableWeeklyLiquidityDepth = isTodayFilter ? true : enableWeeklyLiquidityDepth
effectiveEnableMonthlyLiquidityDepth = isTodayFilter ? true : enableMonthlyLiquidityDepth
effectiveEnableIntradayLiquidityDepth = isTodayFilter ? true : enableIntradayLiquidityDepth
effectiveEnableOvernightLiquidityDepth = isTodayFilter ? true : enableOvernightLiquidityDepth
effectiveEnablePremarketLiquidityDepth = isTodayFilter ? true : enablePremarketLiquidityDepth
// Today filter: bypass timeframe restrictions for HTF liquidity depth
effectiveIsDailyLiquidityDepthTimeframeValid = isTodayFilter ? (currentTimeframeMinutes >= 1 and currentTimeframeMinutes <= 60) : isDailyLiquidityDepthTimeframeValid
effectiveIsWeeklyLiquidityDepthTimeframeValid = isTodayFilter ? (currentTimeframeMinutes >= 1 and currentTimeframeMinutes <= 720) : isWeeklyLiquidityDepthTimeframeValid
effectiveIsMonthlyLiquidityDepthTimeframeValid = isTodayFilter ? (currentTimeframeMinutes >= 1 and currentTimeframeMinutes <= 10080) : isMonthlyLiquidityDepthTimeframeValid
// Today filter: force Pool Colors preset for all Liquidity Depth sections
effectiveDailyLiqDepthColorPreset = isTodayFilter ? LIQUIDITY_DEPTH_PRESET_POOL_COLORS : dailyLiqDepthColorPreset
effectiveWeeklyLiqDepthColorPreset = isTodayFilter ? LIQUIDITY_DEPTH_PRESET_POOL_COLORS : weeklyLiqDepthColorPreset
effectiveMonthlyLiqDepthColorPreset = isTodayFilter ? LIQUIDITY_DEPTH_PRESET_POOL_COLORS : monthlyLiqDepthColorPreset
effectiveIntradayLiqDepthColorPreset = isTodayFilter ? LIQUIDITY_DEPTH_PRESET_POOL_COLORS : intradayLiqDepthColorPreset
effectiveOvernightLiqDepthColorPreset = isTodayFilter ? LIQUIDITY_DEPTH_PRESET_POOL_COLORS : overnightLiqDepthColorPreset
effectivePremarketLiqDepthColorPreset = isTodayFilter ? LIQUIDITY_DEPTH_PRESET_POOL_COLORS : premarketLiqDepthColorPreset

// ═══════════════════════════════════════════════════════════════════════════════
// 24/7 ASSET AUTO-DETECTION & SUNDAY LIQUIDITY HANDLING
// ═══════════════════════════════════════════════════════════════════════════════

// Resolve known market types immediately, then scan weekend bars only for ambiguous types.
// A bar-count-based warmup is not reliable on Range charts because bars do not represent
// fixed durations. syminfo.type keeps futures such as NQ in Exchange Session mode from bar one.
//
// AUTOMATIC SUNDAY EVENING BEHAVIOR:
// • 24/7 assets (crypto): Sunday evening is normal trading → always included
// • Traditional assets (forex/futures): Sunday 18:00-23:59 is thin reopening liquidity → automatically excluded
isKnown247Asset = syminfo.type == "crypto"
isKnownTraditionalAsset = syminfo.type == "futures" or syminfo.type == "forex" or syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "dr" or syminfo.type == "index" or syminfo.type == "option" or syminfo.type == "commodity" or syminfo.type == "bond" or syminfo.type == "spread"
var bool is247Asset = isKnown247Asset
var bool detectionCompleted = isKnown247Asset or isKnownTraditionalAsset

// Only run detection once after we have 7+ days of data
if not detectionCompleted
    barsIn7Days = int(10080 / (timeframe.in_seconds() / 60))

    if bar_index >= barsIn7Days
        // Check current bar first (fast path - if we loaded on Saturday, instant detect)
        currentDay = dayofweek(time, NY_TIMEZONE)
        currentHour = hour(time, NY_TIMEZONE)
        isSaturdayNow = currentDay == dayofweek.saturday
        isEarlySundayNow = currentDay == dayofweek.sunday and currentHour < EXCHANGE_SESSION_START_HOUR

        if isSaturdayNow or isEarlySundayNow
            // Current bar is weekend - definitely 24/7
            is247Asset := true
        else
            // Scan last 7 days for weekend bars
            maxLookback = math.min(9999, barsIn7Days)
            foundWeekendBar = false

            for lookback = 0 to maxLookback by 20
                checkDay = dayofweek(time[lookback], NY_TIMEZONE)
                checkHour = hour(time[lookback], NY_TIMEZONE)

                isSaturday = checkDay == dayofweek.saturday
                isEarlySunday = checkDay == dayofweek.sunday and checkHour < EXCHANGE_SESSION_START_HOUR
                if isSaturday or isEarlySunday
                    foundWeekendBar := true
                    break

            // Set result based on scan
            is247Asset := foundWeekendBar

        detectionCompleted := true

// Resolve effective daily boundary mode (24/7 assets force Calendar Day)
effective_daily_boundary = is247Asset ? DAILY_BOUNDARY_CALENDAR : daily_boundary_mode
use_exchange_session = effective_daily_boundary == DAILY_BOUNDARY_EXCHANGE

// Calculate session strings after detection (apply day codes)
// Traditional assets handle Sunday evening exclusion via should_skip_sunday_liquidity()
actualAsiaSession := is247Asset ? ("2000-0000" + DAY_CODE_ALL_DAYS) : (str.replace_all(DEFAULT_ASIA_SESSION_TIME, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualLondonSession := is247Asset ? ("0200-0500" + DAY_CODE_ALL_DAYS) : (str.replace_all(DEFAULT_LONDON_SESSION_TIME, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualNyamSession := is247Asset ? ("0930-1200" + DAY_CODE_ALL_DAYS) : (str.replace_all(DEFAULT_NYAM_SESSION_TIME, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualLunchSession := is247Asset ? ("1200-1330" + DAY_CODE_ALL_DAYS) : (str.replace_all(DEFAULT_LUNCH_SESSION_TIME, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualNypmSession := is247Asset ? ("1330-1600" + DAY_CODE_ALL_DAYS) : (str.replace_all(DEFAULT_NYPM_SESSION_TIME, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualPremarketSession := is247Asset ? ("0500-0915" + DAY_CODE_ALL_DAYS) : (str.replace_all(DEFAULT_PREMARKET_SESSION_TIME, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualOvernightSession := is247Asset ? ("1600-0500" + DAY_CODE_ALL_DAYS) : (str.replace_all(DEFAULT_OVERNIGHT_SESSION_TIME, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualRangeSession := is247Asset ? ("0200-0215" + DAY_CODE_ALL_DAYS) : (str.replace_all(rangeSessionTime, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)

// ═══════════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

create_pool() =>
    LiquidityPool.new(array.new_float(), array.new_float(), array.new_int(), array.new_int(), array.new_int(), array.new_int(), array.new_bool(), array.new_bool(), array.new_int(), array.new_int(), array.new_int(), array.new_int(), array.new_int(), array.new_int(), array.new<LiquidityDepthLevels>(), array.new<LiquidityDepthLevels>(), array.new<LiquidityDepthLevels>(), array.new<LiquidityDepthLevels>(), na, na, na, na, na, na, na)

create_range_box() =>
    RangeBox.new(array.new_float(), array.new_float(), array.new_int(), array.new_int(), na, na, na)

create_1400_close() =>
    IntradayClosingPriceTracker.new(array.new_float(), array.new_int(), array.new_bool(), array.new_int(), array.new_int(), na, na, false, na, na)

create_1600_close() =>
    IntradayClosingPriceTracker.new(array.new_float(), array.new_int(), array.new_bool(), array.new_int(), array.new_int(), na, na, false, na, na)

create_tf_open() =>
    TimeframeOpenTracker.new(array.new_float(), array.new_int(), array.new_int(), na, na, na)

// Array pruning functions - keep arrays bounded to prevent memory growth
prune_tf_tracker(TimeframeOpenTracker tracker, int maxSize) =>
    while array.size(tracker.opens) > maxSize
        array.shift(tracker.opens)
        array.shift(tracker.times)
        array.shift(tracker.hours)

prune_intraday_tracker(IntradayClosingPriceTracker tracker, int maxSize) =>
    while array.size(tracker.closes) > maxSize
        array.shift(tracker.closes)
        array.shift(tracker.times)
        array.shift(tracker.mitigated)
        array.shift(tracker.mitigation_times)
        array.shift(tracker.capture_hours)

prune_pool(LiquidityPool pool, int maxSize) =>
    while array.size(pool.highs) > maxSize
        array.shift(pool.highs)
        array.shift(pool.lows)
        array.shift(pool.high_times)
        array.shift(pool.low_times)
        array.shift(pool.high_indices)
        array.shift(pool.low_indices)
        array.shift(pool.high_breached)
        array.shift(pool.low_breached)
        array.shift(pool.high_breach_times)
        array.shift(pool.low_breach_times)
        array.shift(pool.high_breach_indices)
        array.shift(pool.low_breach_indices)
        if array.size(pool.session_start_times) > 0
            array.shift(pool.session_start_times)
        if array.size(pool.session_end_times) > 0
            array.shift(pool.session_end_times)
        if array.size(pool.high_liquidity_depths) > 0
            array.shift(pool.high_liquidity_depths)
        if array.size(pool.low_liquidity_depths) > 0
            array.shift(pool.low_liquidity_depths)
        if array.size(pool.intraday_high_liquidity_depths) > 0
            array.shift(pool.intraday_high_liquidity_depths)
        if array.size(pool.intraday_low_liquidity_depths) > 0
            array.shift(pool.intraday_low_liquidity_depths)

prune_range_box(RangeBox box, int maxSize) =>
    while array.size(box.highs) > maxSize
        array.shift(box.highs)
        array.shift(box.lows)
        array.shift(box.start_times)
        array.shift(box.end_times)

// Unified drawing for timeframe opens
// use_hour_format: true for intraday (shows "4H 0600"), false for HTF (shows "D Open")
// Calculate end time for timeframe opens - extends to specific hour if provided
calc_open_end_time(int start_time, int default_end, int extend_to_hour) =>
    if na(extend_to_hour)
        default_end
    else
        target_time = timestamp(NY_TIMEZONE, year(start_time, NY_TIMEZONE), month(start_time, NY_TIMEZONE), dayofmonth(start_time, NY_TIMEZONE), extend_to_hour, 0, 0)
        math.min(target_time, time)

draw_timeframe_opens(TimeframeOpenTracker tracker, int showLast, color lineColor, int lineWidth, string prefix, bool use_hour_format, bool showLabels, color labelTextColor, array<line> all_lines, array<label> all_labels, int extend_to_hour = na, int filter_hour = na) =>
    levels_drawn = 0

    if not na(tracker.current_open) and (na(filter_hour) or tracker.current_hour == filter_hour)
        current_end = calc_open_end_time(tracker.current_time, time, extend_to_hour)
        current_line = line.new(tracker.current_time, tracker.current_open, current_end, tracker.current_open, xloc=xloc.bar_time, color=lineColor, width=lineWidth, style=line.style_solid)
        array.push(all_lines, current_line)

        if showLabels and array.size(all_labels) < INDICATOR_MAX_LABELS
            label_text = use_hour_format ? prefix + " " + (tracker.current_hour < 10 ? "0" : "") + str.tostring(tracker.current_hour) + "00" : prefix + " Open"
            array.push(all_labels, label.new(current_end, tracker.current_open, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100)))

        levels_drawn += 1

    if array.size(tracker.opens) > 0
        for i = array.size(tracker.opens) - 1 to 0
            if levels_drawn >= showLast
                break

            open_hour = array.get(tracker.hours, i)
            if not na(filter_hour) and open_hour != filter_hour
                continue

            open_price = array.get(tracker.opens, i)
            open_time = array.get(tracker.times, i)
            default_end = i < array.size(tracker.opens) - 1 ? array.get(tracker.times, i + 1) : (not na(tracker.current_time) ? tracker.current_time : time)
            end_time = calc_open_end_time(open_time, default_end, extend_to_hour)

            array.push(all_lines, line.new(open_time, open_price, end_time, open_price, xloc=xloc.bar_time, color=lineColor, width=lineWidth, style=line.style_solid))

            if showLabels and array.size(all_labels) < INDICATOR_MAX_LABELS
                label_text = use_hour_format ? prefix + " " + (open_hour < 10 ? "0" : "") + str.tostring(open_hour) + "00" : prefix + " Open"
                array.push(all_labels, label.new(end_time, open_price, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100)))

            levels_drawn += 1

// Unified drawing for intraday closes (14:00/16:00) with mitigation tracking
draw_intraday_closes(IntradayClosingPriceTracker tracker, int showLast, int maxUnmitigated, bool skipHistoricalMitigated, color lineColor, int lineWidth, int untappedWidth, int fallbackHour, bool showLabels, color labelTextColor, array<line> all_lines, array<label> all_labels) =>
    levels_drawn = 0
    unmitigated_drawn = 0
    untapped_width_assigned = false

    if not na(tracker.current_close)
        current_is_mitigated = tracker.current_mitigated
        // Skip if unmitigated only mode and current is mitigated
        if not (showUnmitigatedOnly and current_is_mitigated)
            // Check unmitigated cap
            if current_is_mitigated or unmitigated_drawn < maxUnmitigated
                current_mitigation_time_val = tracker.current_mitigation_time
                current_end_time = (current_is_mitigated and not na(current_mitigation_time_val)) ? current_mitigation_time_val : time
                current_line_width = current_is_mitigated ? lineWidth : untappedWidth
                if not current_is_mitigated
                    untapped_width_assigned := true
                    unmitigated_drawn += 1
                array.push(all_lines, line.new(tracker.current_time, tracker.current_close, current_end_time, tracker.current_close, xloc=xloc.bar_time, color=lineColor, width=current_line_width, style=line.style_solid))
                if showLabels and array.size(all_labels) < INDICATOR_MAX_LABELS
                    label_time = (current_is_mitigated and not na(current_mitigation_time_val)) ? int((tracker.current_time + current_mitigation_time_val) / 2) : current_end_time
                    array.push(all_labels, label.new(label_time, tracker.current_close, str.tostring(tracker.current_capture_hour) + ":00", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100)))
                levels_drawn += 1

    if array.size(tracker.closes) > 0
        for i = array.size(tracker.closes) - 1 to 0
            if levels_drawn >= showLast
                break
            is_mitigated = array.get(tracker.mitigated, i)
            // Skip historical mitigated: unmitigated-only mode OR Today mode (only show today's mitigated)
            if is_mitigated and (showUnmitigatedOnly or skipHistoricalMitigated)
                continue
            // Skip if unmitigated cap reached
            if not is_mitigated and unmitigated_drawn >= maxUnmitigated
                continue
            close_price = array.get(tracker.closes, i)
            close_time = array.get(tracker.times, i)
            mitigation_time = array.get(tracker.mitigation_times, i)
            end_time = (is_mitigated and not na(mitigation_time)) ? mitigation_time : time
            lw = lineWidth
            if not is_mitigated and not untapped_width_assigned
                lw := untappedWidth
                untapped_width_assigned := true
            if not is_mitigated
                unmitigated_drawn += 1
            array.push(all_lines, line.new(close_time, close_price, end_time, close_price, xloc=xloc.bar_time, color=lineColor, width=lw, style=line.style_solid))
            if showLabels and array.size(all_labels) < INDICATOR_MAX_LABELS
                label_time = (is_mitigated and not na(mitigation_time)) ? int((close_time + mitigation_time) / 2) : end_time
                capture_hour = (i < array.size(tracker.capture_hours)) ? array.get(tracker.capture_hours, i) : fallbackHour
                array.push(all_labels, label.new(label_time, close_price, str.tostring(capture_hour) + ":00", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100)))
            levels_drawn += 1

pool_get_high_end_time(pool, index, fallback_time) =>
    high_breached = array.get(pool.high_breached, index)
    high_breach_time = array.get(pool.high_breach_times, index)
    high_breached and not na(high_breach_time) ? high_breach_time : fallback_time

pool_get_low_end_time(pool, index, fallback_time) =>
    low_breached = array.get(pool.low_breached, index)
    low_breach_time = array.get(pool.low_breach_times, index)
    low_breached and not na(low_breach_time) ? low_breach_time : fallback_time

pool_get_high_end_index(pool, index, fallback_index) =>
    high_breached = array.get(pool.high_breached, index)
    high_breach_index = array.get(pool.high_breach_indices, index)
    high_breached and not na(high_breach_index) ? high_breach_index : fallback_index

pool_get_low_end_index(pool, index, fallback_index) =>
    low_breached = array.get(pool.low_breached, index)
    low_breach_index = array.get(pool.low_breach_indices, index)
    low_breached and not na(low_breach_index) ? low_breach_index : fallback_index

pool_store_session(pool) =>
    if not na(pool.current_high)
        array.push(pool.highs, pool.current_high)
        array.push(pool.lows, pool.current_low)
        array.push(pool.high_times, pool.current_high_time)
        array.push(pool.low_times, pool.current_low_time)
        array.push(pool.high_indices, pool.current_high_index)
        array.push(pool.low_indices, pool.current_low_index)
        array.push(pool.high_breached, false)
        array.push(pool.low_breached, false)
        array.push(pool.high_breach_times, na)
        array.push(pool.low_breach_times, na)
        array.push(pool.high_breach_indices, na)
        array.push(pool.low_breach_indices, na)

        // Initialize liquidity depth levels for this pool entry (HTF only)
        high_liquidity_depth = LiquidityDepthLevels.new(array.new_bool(NUM_LIQUIDITY_DEPTH_LEVELS, false), array.new_int(NUM_LIQUIDITY_DEPTH_LEVELS, na), array.new_int(NUM_LIQUIDITY_DEPTH_LEVELS, na))
        low_liquidity_depth = LiquidityDepthLevels.new(array.new_bool(NUM_LIQUIDITY_DEPTH_LEVELS, false), array.new_int(NUM_LIQUIDITY_DEPTH_LEVELS, na), array.new_int(NUM_LIQUIDITY_DEPTH_LEVELS, na))
        array.push(pool.high_liquidity_depths, high_liquidity_depth)
        array.push(pool.low_liquidity_depths, low_liquidity_depth)

pool_detect_breaches(pool, scan_cap, liquidity_depth_distance, alertEnabled, alertHighMsg, alertLowMsg) =>
    if array.size(pool.highs) > 0
        scan_size = math.min(array.size(pool.highs), scan_cap)
        start_index = math.max(0, array.size(pool.highs) - scan_size)

        for i = start_index to array.size(pool.highs) - 1
            // Base level (L0) breach detection
            if not array.get(pool.high_breached, i)
                tracked_high = array.get(pool.highs, i)
                if high >= tracked_high
                    array.set(pool.high_breached, i, true)
                    array.set(pool.high_breach_times, i, time)
                    array.set(pool.high_breach_indices, i, bar_index)
                    if alertEnabled
                        alert(alertHighMsg, alert.freq_once_per_bar)

            if not array.get(pool.low_breached, i)
                tracked_low = array.get(pool.lows, i)
                if low <= tracked_low
                    array.set(pool.low_breached, i, true)
                    array.set(pool.low_breach_times, i, time)
                    array.set(pool.low_breach_indices, i, bar_index)
                    if alertEnabled
                        alert(alertLowMsg, alert.freq_once_per_bar)

            // Liquidity Depth level breach detection (only if distance > 0 for performance)
            if liquidity_depth_distance > 0
                tracked_high = array.get(pool.highs, i)
                tracked_low = array.get(pool.lows, i)
                high_liquidity_depth = array.get(pool.high_liquidity_depths, i)
                low_liquidity_depth = array.get(pool.low_liquidity_depths, i)

                for level_idx = 0 to NUM_LIQUIDITY_DEPTH_LEVELS - 1
                    multiplier = level_idx + 1  // L1=1x, L2=2x, L3=3x

                    // Check high liquidity depth level
                    if not array.get(high_liquidity_depth.breached, level_idx)
                        level_price = tracked_high + (multiplier * liquidity_depth_distance)
                        if high >= level_price
                            array.set(high_liquidity_depth.breached, level_idx, true)
                            array.set(high_liquidity_depth.breach_times, level_idx, time)
                            array.set(high_liquidity_depth.breach_indices, level_idx, bar_index)

                    // Check low liquidity depth level
                    if not array.get(low_liquidity_depth.breached, level_idx)
                        level_price = tracked_low - (multiplier * liquidity_depth_distance)
                        if low <= level_price
                            array.set(low_liquidity_depth.breached, level_idx, true)
                            array.set(low_liquidity_depth.breach_times, level_idx, time)
                            array.set(low_liquidity_depth.breach_indices, level_idx, bar_index)

pool_detect_intraday_breaches(pool, scan_cap, percent1, percent2, percent3, alertEnabled, alertHighMsg, alertLowMsg) =>
    if array.size(pool.highs) > 0
        scan_size = math.min(array.size(pool.highs), scan_cap)
        start_index = math.max(0, array.size(pool.highs) - scan_size)

        for i = start_index to array.size(pool.highs) - 1
            // Base level (L0) breach detection
            if not array.get(pool.high_breached, i)
                tracked_high = array.get(pool.highs, i)
                if high >= tracked_high
                    array.set(pool.high_breached, i, true)
                    array.set(pool.high_breach_times, i, time)
                    array.set(pool.high_breach_indices, i, bar_index)
                    if alertEnabled
                        alert(alertHighMsg, alert.freq_once_per_bar)

            if not array.get(pool.low_breached, i)
                tracked_low = array.get(pool.lows, i)
                if low <= tracked_low
                    array.set(pool.low_breached, i, true)
                    array.set(pool.low_breach_times, i, time)
                    array.set(pool.low_breach_indices, i, bar_index)
                    if alertEnabled
                        alert(alertLowMsg, alert.freq_once_per_bar)

            // Intraday liquidity depth level breach detection (percentage-based)
            if percent1 > 0
                tracked_high = array.get(pool.highs, i)
                tracked_low = array.get(pool.lows, i)
                intraday_high_liquidity_depth = array.get(pool.intraday_high_liquidity_depths, i)
                intraday_low_liquidity_depth = array.get(pool.intraday_low_liquidity_depths, i)
                percents = array.from(percent1, percent2, percent3)

                for level_idx = 0 to NUM_INTRADAY_LIQUIDITY_DEPTH_LEVELS - 1
                    percent = array.get(percents, level_idx)

                    // Check high liquidity depth level
                    if not array.get(intraday_high_liquidity_depth.breached, level_idx)
                        level_price = tracked_high + (tracked_high * (percent / 100.0))
                        if high >= level_price
                            array.set(intraday_high_liquidity_depth.breached, level_idx, true)
                            array.set(intraday_high_liquidity_depth.breach_times, level_idx, time)
                            array.set(intraday_high_liquidity_depth.breach_indices, level_idx, bar_index)

                    // Check low liquidity depth level
                    if not array.get(intraday_low_liquidity_depth.breached, level_idx)
                        level_price = tracked_low - (tracked_low * (percent / 100.0))
                        if low <= level_price
                            array.set(intraday_low_liquidity_depth.breached, level_idx, true)
                            array.set(intraday_low_liquidity_depth.breach_times, level_idx, time)
                            array.set(intraday_low_liquidity_depth.breach_indices, level_idx, bar_index)

build_label(pool_type) =>
    pool_type

// Helper: Get intraday liquidity depth percentage for a given level (0, 1, 2)
get_intraday_percent(level_idx) =>
    level_idx == 0 ? intradayLiquidityDepthPercent1 : (level_idx == 1 ? intradayLiquidityDepthPercent2 : intradayLiquidityDepthPercent3)

// Helper: Get intraday liquidity depth color for a given level (0, 1, 2)
get_intraday_color(level_idx, pool_color) =>
    if effectiveIntradayLiqDepthColorPreset == LIQUIDITY_DEPTH_PRESET_POOL_COLORS
        level_idx == 0 ? intradayLiquidityDepthL1Color : (level_idx == 1 ? intradayLiquidityDepthL2Color : intradayLiquidityDepthL3Color)
    else
        DEFAULT_LIQUIDITY_DEPTH_BLUE

// Helper: Get intraday liquidity depth line width for a given level (0, 1, 2)
get_intraday_width(level_idx) =>
    level_idx == 0 ? intradayLiquidityDepthL1Width : (level_idx == 1 ? intradayLiquidityDepthL2Width : intradayLiquidityDepthL3Width)

// Helper: Convert style string to line style constant
convert_line_style(style_str) =>
    style_str == LINE_STYLE_SOLID ? line.style_solid : (style_str == LINE_STYLE_DOTTED ? line.style_dotted : line.style_dashed)

// Helper: Get intraday liquidity depth line style for a given level (0, 1, 2)
get_intraday_style(level_idx) =>
    style_str = level_idx == 0 ? intradayLiquidityDepthL1Style : (level_idx == 1 ? intradayLiquidityDepthL2Style : intradayLiquidityDepthL3Style)
    convert_line_style(style_str)

// Helper: Get Daily liquidity depth color for a given level (0, 1, 2)
get_daily_liq_depth_color(level_idx) =>
    if effectiveDailyLiqDepthColorPreset == LIQUIDITY_DEPTH_PRESET_POOL_COLORS
        level_idx == 0 ? dailyLiqDepthL1Color : (level_idx == 1 ? dailyLiqDepthL2Color : dailyLiqDepthL3Color)
    else
        DEFAULT_LIQUIDITY_DEPTH_BLUE

// Helper: Get Daily liquidity depth line width for a given level (0, 1, 2)
get_daily_liq_depth_width(level_idx) =>
    level_idx == 0 ? dailyLiqDepthL1Width : (level_idx == 1 ? dailyLiqDepthL2Width : dailyLiqDepthL3Width)

// Helper: Get Daily liquidity depth line style for a given level (0, 1, 2)
get_daily_liq_depth_style(level_idx) =>
    style_str = level_idx == 0 ? dailyLiqDepthL1Style : (level_idx == 1 ? dailyLiqDepthL2Style : dailyLiqDepthL3Style)
    convert_line_style(style_str)

// Helper: Get Weekly liquidity depth color for a given level (0, 1, 2)
get_weekly_liq_depth_color(level_idx) =>
    if effectiveWeeklyLiqDepthColorPreset == LIQUIDITY_DEPTH_PRESET_POOL_COLORS
        level_idx == 0 ? weeklyLiqDepthL1Color : (level_idx == 1 ? weeklyLiqDepthL2Color : weeklyLiqDepthL3Color)
    else
        DEFAULT_LIQUIDITY_DEPTH_BLUE

// Helper: Get Weekly liquidity depth line width for a given level (0, 1, 2)
get_weekly_liq_depth_width(level_idx) =>
    level_idx == 0 ? weeklyLiqDepthL1Width : (level_idx == 1 ? weeklyLiqDepthL2Width : weeklyLiqDepthL3Width)

// Helper: Get Weekly liquidity depth line style for a given level (0, 1, 2)
get_weekly_liq_depth_style(level_idx) =>
    style_str = level_idx == 0 ? weeklyLiqDepthL1Style : (level_idx == 1 ? weeklyLiqDepthL2Style : weeklyLiqDepthL3Style)
    convert_line_style(style_str)

// Helper: Get Monthly liquidity depth color for a given level (0, 1, 2)
get_monthly_liq_depth_color(level_idx) =>
    if effectiveMonthlyLiqDepthColorPreset == LIQUIDITY_DEPTH_PRESET_POOL_COLORS
        level_idx == 0 ? monthlyLiqDepthL1Color : (level_idx == 1 ? monthlyLiqDepthL2Color : monthlyLiqDepthL3Color)
    else
        DEFAULT_LIQUIDITY_DEPTH_BLUE

// Helper: Get Monthly liquidity depth line width for a given level (0, 1, 2)
get_monthly_liq_depth_width(level_idx) =>
    level_idx == 0 ? monthlyLiqDepthL1Width : (level_idx == 1 ? monthlyLiqDepthL2Width : monthlyLiqDepthL3Width)

// Helper: Get Monthly liquidity depth line style for a given level (0, 1, 2)
get_monthly_liq_depth_style(level_idx) =>
    style_str = level_idx == 0 ? monthlyLiqDepthL1Style : (level_idx == 1 ? monthlyLiqDepthL2Style : monthlyLiqDepthL3Style)
    convert_line_style(style_str)

// Helper: Get Overnight liquidity depth color for a given level (0, 1, 2)
get_overnight_liq_depth_color(level_idx) =>
    if effectiveOvernightLiqDepthColorPreset == LIQUIDITY_DEPTH_PRESET_POOL_COLORS
        level_idx == 0 ? overnightLiqDepthL1Color : (level_idx == 1 ? overnightLiqDepthL2Color : overnightLiqDepthL3Color)
    else
        DEFAULT_LIQUIDITY_DEPTH_BLUE

// Helper: Get Overnight liquidity depth line width for a given level (0, 1, 2)
get_overnight_liq_depth_width(level_idx) =>
    level_idx == 0 ? overnightLiqDepthL1Width : (level_idx == 1 ? overnightLiqDepthL2Width : overnightLiqDepthL3Width)

// Helper: Get Overnight liquidity depth line style for a given level (0, 1, 2)
get_overnight_liq_depth_style(level_idx) =>
    style_str = level_idx == 0 ? overnightLiqDepthL1Style : (level_idx == 1 ? overnightLiqDepthL2Style : overnightLiqDepthL3Style)
    convert_line_style(style_str)

// Helper: Get Premarket liquidity depth color for a given level (0, 1, 2)
get_premarket_liq_depth_color(level_idx) =>
    if effectivePremarketLiqDepthColorPreset == LIQUIDITY_DEPTH_PRESET_POOL_COLORS
        level_idx == 0 ? premarketLiqDepthL1Color : (level_idx == 1 ? premarketLiqDepthL2Color : premarketLiqDepthL3Color)
    else
        DEFAULT_LIQUIDITY_DEPTH_BLUE

// Helper: Get Premarket liquidity depth line width for a given level (0, 1, 2)
get_premarket_liq_depth_width(level_idx) =>
    level_idx == 0 ? premarketLiqDepthL1Width : (level_idx == 1 ? premarketLiqDepthL2Width : premarketLiqDepthL3Width)

// Helper: Get Premarket liquidity depth line style for a given level (0, 1, 2)
get_premarket_liq_depth_style(level_idx) =>
    style_str = level_idx == 0 ? premarketLiqDepthL1Style : (level_idx == 1 ? premarketLiqDepthL2Style : premarketLiqDepthL3Style)
    convert_line_style(style_str)

depth_label_text(level_idx, pool_type = "") =>
    level_str = "L" + str.tostring(level_idx + 1)
    showSessionOnSweepLabels and pool_type != "" ? level_str + " " + pool_type : level_str

pool_label_rank(pool_type) =>
    pool_type == POOL_TYPE_MONTHLY ? 9 :
     pool_type == POOL_TYPE_WEEKLY ? 8 :
     pool_type == POOL_TYPE_DAILY ? 7 :
     pool_type == POOL_TYPE_OVERNIGHT ? 6 :
     pool_type == POOL_TYPE_PREMARKET ? 5 :
     pool_type == POOL_TYPE_NYPM ? 4 :
     pool_type == POOL_TYPE_LUNCH ? 3 :
     pool_type == POOL_TYPE_NYAM ? 2 :
     pool_type == POOL_TYPE_LONDON ? 1 : 0

reminder_placements(int run_bars, bool repeat) =>
    // Density follows visual candle span: lower timeframes earn more reminders for
    // the same elapsed duration, while short higher-timeframe lines stay uncluttered.
    int duration_count = math.min(LIQUIDITY_REMINDER_MAX_PER_LINE, math.max(1, int(math.floor(float(run_bars) / LIQUIDITY_REMINDER_SPACING_BARS))))
    int spacing_count = math.max(1, int(math.floor(float(math.max(0, run_bars)) / (DEPTH_LABEL_INDEX_TOLERANCE + 1))))
    repeat ? math.min(duration_count, spacing_count) : 1

// Bar spacing prevents closed futures gaps from collapsing reminders onto the 18:00 reopen.
reminder_indices(start_index, end_index, bool repeat, bool include_end) =>
    array<int> indices = array.new<int>()
    int minimum_index = math.max(0, bar_index - BAR_INDEX_DRAWING_LOOKBACK)
    if not na(start_index) and not na(end_index) and end_index >= minimum_index
        int range_start_index = math.max(start_index, minimum_index)
        int range_run = math.max(0, end_index - range_start_index)
        int count = reminder_placements(range_run, repeat)
        for placement = 1 to count
            float position = include_end ? float(placement) / count : (placement - 0.5) / count
            array.push(indices, range_start_index + int(range_run * position))
    indices

queue_label_event(array<PendingLabelEvent> pending, PendingLabelEvent candidate) =>
    array.push(pending, candidate)
    true

buffer_liq_depth_labels(array<PendingLabelEvent> pending, start_index, end_index, price_val, level_idx, is_high, pool_type = "") =>
    array<int> label_indices = reminder_indices(start_index, end_index, showLabels and showDepthReminders, false)
    if showLabels and array.size(label_indices) > 0
        string identity = depth_label_text(level_idx, pool_type)
        int rank = pool_label_rank(pool_type)
        for placement = 0 to array.size(label_indices) - 1
            queue_label_event(pending, PendingLabelEvent.new(array.get(label_indices, placement), price_val, identity, is_high, rank, false, false))
    true

buffer_pool_label(array<PendingLabelEvent> pending, float price, int start_index, int end_index, string label_text, bool is_high, bool breached, string pool_type) =>
    array<int> label_indices = reminder_indices(start_index, end_index, showLabels and showPoolReminders, not breached)
    if showLabels and array.size(label_indices) > 0
        int rank = pool_label_rank(pool_type)
        int last_placement = array.size(label_indices) - 1
        for placement = 0 to last_placement
            bool endpoint = not breached and placement == last_placement
            queue_label_event(pending, PendingLabelEvent.new(array.get(label_indices, placement), price, label_text, is_high, rank, endpoint, true))
    true

create_pool_label(label_index, price_val, label_str, is_high) =>
    label_style = is_high ? label.style_label_down : label.style_label_up
    safe_label_index = math.max(label_index, bar_index - BAR_INDEX_DRAWING_LOOKBACK)
    label.new(safe_label_index, price_val, label_str, xloc=xloc.bar_index, yloc=yloc.price, style=label_style, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))

pool_label_merge_tolerance(float price) =>
    math.max(syminfo.mintick, math.abs(price) * labelMergeDistancePercent / 100.0)

label_events_overlap(PendingLabelEvent left, PendingLabelEvent right) =>
    float tolerance = math.max(pool_label_merge_tolerance(left.price), pool_label_merge_tolerance(right.price))
    math.abs(left.label_index - right.label_index) <= DEPTH_LABEL_INDEX_TOLERANCE and math.abs(left.price - right.price) <= tolerance

label_event_root(array<int> parents, int event_index) =>
    int root = event_index
    while array.get(parents, root) != root
        root := array.get(parents, root)
    root

label_event_precedes(PendingLabelEvent candidate, int candidate_order, PendingLabelEvent current, int current_order) =>
    candidate.endpoint != current.endpoint ? candidate.endpoint :
     candidate.core != current.core ? candidate.core :
     candidate.rank > current.rank or (candidate.rank == current.rank and candidate_order < current_order)

compose_label_event_cluster(int cluster_index, int fallback_order, array<int> identity_clusters, array<string> identity_texts, array<bool> identity_sides, array<int> identity_ranks, array<int> identity_orders) =>
    string body = ""
    int identity_count = 0
    bool has_high = false
    bool has_low = false
    for identity_index = 0 to array.size(identity_clusters) - 1
        if array.get(identity_clusters, identity_index) == cluster_index
            identity_count += 1
            if array.get(identity_sides, identity_index)
                has_high := true
            else
                has_low := true
    bool mixed_sides = has_high and has_low
    array<bool> identity_used = array.new<bool>(array.size(identity_clusters), false)
    for identity_position = 1 to identity_count
        int best_index = -1
        int best_rank = -1
        int best_order = fallback_order
        for identity_index = 0 to array.size(identity_clusters) - 1
            if array.get(identity_clusters, identity_index) == cluster_index and not array.get(identity_used, identity_index)
                int candidate_rank = array.get(identity_ranks, identity_index)
                int candidate_order = array.get(identity_orders, identity_index)
                if candidate_rank > best_rank or (candidate_rank == best_rank and candidate_order < best_order)
                    best_index := identity_index
                    best_rank := candidate_rank
                    best_order := candidate_order
        if best_index >= 0
            string next_text = array.get(identity_texts, best_index)
            if mixed_sides
                next_text := next_text + (array.get(identity_sides, best_index) ? " high" : " low")
            body := body == "" ? next_text : body + LABEL_NAME_SEPARATOR + next_text
            array.set(identity_used, best_index, true)
    body

// Range charts are spaced by bar order rather than elapsed time. Keep both coordinates
// so a breach endpoint lands on the actual range candle instead of a later candle that
// happens to share or surround the same timestamp.
create_pool_line(start_time, start_index, price_val, end_time, end_index, line_color, line_width, line_style) =>
    range_start_index = math.max(start_index, bar_index - BAR_INDEX_DRAWING_LOOKBACK)
    range_end_index = math.max(end_index, range_start_index)
    chart.is_range ? line.new(range_start_index, price_val, range_end_index, price_val, xloc=xloc.bar_index, color=line_color, width=line_width, style=line_style) : line.new(start_time, price_val, end_time, price_val, xloc=xloc.bar_time, color=line_color, width=line_width, style=line_style)

flush_label_events(array<PendingLabelEvent> pending, array<label> drawn) =>
    int pending_count = array.size(pending)
    if pending_count > 0
        array<int> parents = array.new<int>()
        for pending_index = 0 to pending_count - 1
            array.push(parents, pending_index)
        if mergeOverlappingLabels and pending_count > 1
            for left_index = 0 to pending_count - 2
                PendingLabelEvent left = array.get(pending, left_index)
                for right_index = left_index + 1 to pending_count - 1
                    PendingLabelEvent right = array.get(pending, right_index)
                    if label_events_overlap(left, right)
                        int left_root = label_event_root(parents, left_index)
                        int right_root = label_event_root(parents, right_index)
                        if left_root != right_root
                            int root = math.min(left_root, right_root)
                            int child = math.max(left_root, right_root)
                            array.set(parents, child, root)
        array<int> component_roots = array.new<int>()
        array<int> component_carriers = array.new<int>()
        array<int> identity_clusters = array.new<int>()
        array<string> identity_texts = array.new<string>()
        array<bool> identity_sides = array.new<bool>()
        array<int> identity_ranks = array.new<int>()
        array<int> identity_orders = array.new<int>()
        for pending_index = 0 to pending_count - 1
            PendingLabelEvent candidate = array.get(pending, pending_index)
            int root = label_event_root(parents, pending_index)
            int cluster_index = array.indexof(component_roots, root)
            if cluster_index < 0
                array.push(component_roots, root)
                array.push(component_carriers, pending_index)
                cluster_index := array.size(component_roots) - 1
            else
                int current_carrier_index = array.get(component_carriers, cluster_index)
                PendingLabelEvent current_carrier = array.get(pending, current_carrier_index)
                if label_event_precedes(candidate, pending_index, current_carrier, current_carrier_index)
                    array.set(component_carriers, cluster_index, pending_index)
            bool identity_exists = false
            if array.size(identity_clusters) > 0
                for identity_index = 0 to array.size(identity_clusters) - 1
                    if array.get(identity_clusters, identity_index) == cluster_index and array.get(identity_texts, identity_index) == candidate.identity and array.get(identity_sides, identity_index) == candidate.is_high
                        identity_exists := true
                        break
            if not identity_exists
                array.push(identity_clusters, cluster_index)
                array.push(identity_texts, candidate.identity)
                array.push(identity_sides, candidate.is_high)
                array.push(identity_ranks, candidate.rank)
                array.push(identity_orders, pending_index)
        int cluster_count = array.size(component_roots)
        int available_labels = math.max(0, INDICATOR_MAX_LABELS - array.size(drawn))
        int render_count = math.min(cluster_count, available_labels)
        array<int> render_order = array.new<int>()
        if cluster_count <= available_labels
            for cluster_index = 0 to cluster_count - 1
                array.push(render_order, cluster_index)
        else if render_count > 0
            array<bool> selected_clusters = array.new_bool(cluster_count, false)
            for selection = 0 to render_count - 1
                int best_cluster_index = -1
                int best_carrier_index = -1
                for cluster_index = 0 to cluster_count - 1
                    if not array.get(selected_clusters, cluster_index)
                        int candidate_carrier_index = array.get(component_carriers, cluster_index)
                        PendingLabelEvent candidate_carrier = array.get(pending, candidate_carrier_index)
                        if best_cluster_index < 0
                            best_cluster_index := cluster_index
                            best_carrier_index := candidate_carrier_index
                        else
                            PendingLabelEvent best_carrier = array.get(pending, best_carrier_index)
                            if label_event_precedes(candidate_carrier, candidate_carrier_index, best_carrier, best_carrier_index)
                                best_cluster_index := cluster_index
                                best_carrier_index := candidate_carrier_index
                if best_cluster_index >= 0
                    array.set(selected_clusters, best_cluster_index, true)
                    array.push(render_order, best_cluster_index)
        if array.size(render_order) > 0
            for render_position = 0 to array.size(render_order) - 1
                int cluster_index = array.get(render_order, render_position)
                int carrier_index = array.get(component_carriers, cluster_index)
                PendingLabelEvent carrier = array.get(pending, carrier_index)
                string merged_text = compose_label_event_cluster(cluster_index, pending_count, identity_clusters, identity_texts, identity_sides, identity_ranks, identity_orders)
                label created_label = create_pool_label(carrier.label_index, carrier.price, merged_text, carrier.is_high)
                if not na(created_label)
                    array.push(drawn, created_label)
        array.clear(pending)
    true

// Fixed thin width so the connector never obscures wicks, regardless of depth-line width.
create_liq_depth_connector(x_time, x_index, start_price, end_price, connector_color) =>
    range_x_index = math.max(x_index, bar_index - BAR_INDEX_DRAWING_LOOKBACK)
    chart.is_range ? line.new(range_x_index, start_price, range_x_index, end_price, xloc=xloc.bar_index, color=color.new(connector_color, 80), width=LINE_WIDTH_1, style=line.style_dashed) : line.new(x_time, start_price, x_time, end_price, xloc=xloc.bar_time, color=color.new(connector_color, 80), width=LINE_WIDTH_1, style=line.style_dashed)

// Helper: Get liquidity depth color for any pool type
get_pool_liq_depth_color(poolType, level_idx, lineColor) =>
    poolType == POOL_TYPE_DAILY ? get_daily_liq_depth_color(level_idx) :
     poolType == POOL_TYPE_WEEKLY ? get_weekly_liq_depth_color(level_idx) :
     poolType == POOL_TYPE_MONTHLY ? get_monthly_liq_depth_color(level_idx) :
     poolType == POOL_TYPE_OVERNIGHT ? get_overnight_liq_depth_color(level_idx) :
     poolType == POOL_TYPE_PREMARKET ? get_premarket_liq_depth_color(level_idx) :
     get_intraday_color(level_idx, lineColor)

// Helper: Get liquidity depth width for any pool type. In Today mode, Bold L1 → width 2 and
// Bold L3 → width 3 (L3 already defaults to width 2, so bolding must step it up further).
get_pool_liq_depth_width(poolType, level_idx) =>
    baseWidth = poolType == POOL_TYPE_DAILY ? get_daily_liq_depth_width(level_idx) :
     poolType == POOL_TYPE_WEEKLY ? get_weekly_liq_depth_width(level_idx) :
     poolType == POOL_TYPE_MONTHLY ? get_monthly_liq_depth_width(level_idx) :
     poolType == POOL_TYPE_OVERNIGHT ? get_overnight_liq_depth_width(level_idx) :
     poolType == POOL_TYPE_PREMARKET ? get_premarket_liq_depth_width(level_idx) :
     get_intraday_width(level_idx)
    isTodayFilter and todayL1Bold and level_idx == 0 ? LINE_WIDTH_2 :
     isTodayFilter and todayL3Bold and level_idx == 2 ? LINE_WIDTH_3 :
     baseWidth

// Helper: Get liquidity depth style for any pool type
get_pool_liq_depth_style(poolType, level_idx) =>
    poolType == POOL_TYPE_DAILY ? get_daily_liq_depth_style(level_idx) :
     poolType == POOL_TYPE_WEEKLY ? get_weekly_liq_depth_style(level_idx) :
     poolType == POOL_TYPE_MONTHLY ? get_monthly_liq_depth_style(level_idx) :
     poolType == POOL_TYPE_OVERNIGHT ? get_overnight_liq_depth_style(level_idx) :
     poolType == POOL_TYPE_PREMARKET ? get_premarket_liq_depth_style(level_idx) :
     get_intraday_style(level_idx)

// Helper: Get liquidity depth color preset for any pool type
get_pool_liq_depth_preset(poolType) =>
    poolType == POOL_TYPE_DAILY ? effectiveDailyLiqDepthColorPreset :
     poolType == POOL_TYPE_WEEKLY ? effectiveWeeklyLiqDepthColorPreset :
     poolType == POOL_TYPE_MONTHLY ? effectiveMonthlyLiqDepthColorPreset :
     poolType == POOL_TYPE_OVERNIGHT ? effectiveOvernightLiqDepthColorPreset :
     poolType == POOL_TYPE_PREMARKET ? effectivePremarketLiqDepthColorPreset :
     effectiveIntradayLiqDepthColorPreset

should_skip_sunday_liquidity(time_value) =>
    // Exchange Session mode: Sunday 18:00 starts Monday's session, never skip
    if use_exchange_session
        false
    else
        // Traditional markets: skip Sunday 18:00-23:59 when includeSundayEvening is OFF
        // 24/7 markets: never skip (Sunday is normal trading)
        not is247Asset and not includeSundayEvening and dayofweek(time_value, NY_TIMEZONE) == dayofweek.sunday and hour(time_value, NY_TIMEZONE) >= EXCHANGE_SESSION_START_HOUR

// Exchange session boundary: new daily session starts at 18:00 ET Mon-Fri
// Sunday 18:00 = Monday's session start
// On daily+ timeframes: fall back to calendar day change (each bar = one session)
is_new_exchange_daily_session() =>
    prev_time = time[1]
    if na(prev_time)
        false
    else if timeframe.in_seconds() >= 86400
        dayofmonth(prev_time, NY_TIMEZONE) != dayofmonth(time, NY_TIMEZONE)
    else
        cur_hour = hour(time, NY_TIMEZONE)
        prev_hour = hour(prev_time, NY_TIMEZONE)
        cur_dow = dayofweek(time, NY_TIMEZONE)
        prev_dow = dayofweek(prev_time, NY_TIMEZONE)
        crossed_18 = (cur_hour >= EXCHANGE_SESSION_START_HOUR and prev_hour < EXCHANGE_SESSION_START_HOUR and cur_dow == prev_dow)
        day_changed = cur_dow != prev_dow and cur_hour >= EXCHANGE_SESSION_START_HOUR
        crossed_18 or day_changed

track_intraday_session(pool, sessionString, skipSunday) =>
    inSession = not na(time(timeframe.period, sessionString, NY_TIMEZONE))
    wasInSession = not na(time(timeframe.period, sessionString, NY_TIMEZONE)[1])
    sessionJustStarted = inSession and not wasInSession
    sessionJustEnded = not inSession and wasInSession

    // ALWAYS process session endings (to save Friday data before weekend)
    if sessionJustEnded
        // Store session data including end time
        if not na(pool.current_high)
            array.push(pool.highs, pool.current_high)
            array.push(pool.lows, pool.current_low)
            array.push(pool.high_times, pool.current_high_time)
            array.push(pool.low_times, pool.current_low_time)
            array.push(pool.high_indices, pool.current_high_index)
            array.push(pool.low_indices, pool.current_low_index)
            array.push(pool.high_breached, false)
            array.push(pool.low_breached, false)
            array.push(pool.high_breach_times, na)
            array.push(pool.low_breach_times, na)
            array.push(pool.high_breach_indices, na)
            array.push(pool.low_breach_indices, na)
            array.push(pool.session_start_times, pool.current_session_start_time)
            array.push(pool.session_end_times, time)

            // Initialize intraday liquidity depth levels for this pool entry
            intraday_high_liquidity_depth = LiquidityDepthLevels.new(array.new_bool(NUM_INTRADAY_LIQUIDITY_DEPTH_LEVELS, false), array.new_int(NUM_INTRADAY_LIQUIDITY_DEPTH_LEVELS, na), array.new_int(NUM_INTRADAY_LIQUIDITY_DEPTH_LEVELS, na))
            intraday_low_liquidity_depth = LiquidityDepthLevels.new(array.new_bool(NUM_INTRADAY_LIQUIDITY_DEPTH_LEVELS, false), array.new_int(NUM_INTRADAY_LIQUIDITY_DEPTH_LEVELS, na), array.new_int(NUM_INTRADAY_LIQUIDITY_DEPTH_LEVELS, na))
            array.push(pool.intraday_high_liquidity_depths, intraday_high_liquidity_depth)
            array.push(pool.intraday_low_liquidity_depths, intraday_low_liquidity_depth)

        // CRITICAL: Clear current session tracking after storing (prevents Sunday ghost sessions)
        pool.current_high := na
        pool.current_low := na
        pool.current_high_time := na
        pool.current_low_time := na
        pool.current_high_index := na
        pool.current_low_index := na
        pool.current_session_start_time := na

    // Only process session starts/updates when NOT skipping Sunday
    if not skipSunday
        if sessionJustStarted
            pool.current_high := high
            pool.current_low := low
            pool.current_high_time := time
            pool.current_low_time := time
            pool.current_high_index := bar_index
            pool.current_low_index := bar_index
            pool.current_session_start_time := time

        if inSession
            if high > pool.current_high
                pool.current_high := high
                pool.current_high_time := time
                pool.current_high_index := bar_index
            if low < pool.current_low
                pool.current_low := low
                pool.current_low_time := time
                pool.current_low_index := bar_index

track_range_session(rangeBox, sessionString) =>
    inSession = not na(time(timeframe.period, sessionString, NY_TIMEZONE))
    wasInSession = not na(time(timeframe.period, sessionString, NY_TIMEZONE)[1])
    sessionJustStarted = inSession and not wasInSession
    sessionJustEnded = not inSession and wasInSession

    if sessionJustEnded
        if not na(rangeBox.current_high)
            array.push(rangeBox.highs, rangeBox.current_high)
            array.push(rangeBox.lows, rangeBox.current_low)
            array.push(rangeBox.start_times, rangeBox.current_start_time)
            array.push(rangeBox.end_times, time)

        // Clear current session tracking after storing
        rangeBox.current_high := na
        rangeBox.current_low := na
        rangeBox.current_start_time := na

    if sessionJustStarted
        rangeBox.current_high := high
        rangeBox.current_low := low
        rangeBox.current_start_time := time

    if inSession
        if high > rangeBox.current_high
            rangeBox.current_high := high
        if low < rangeBox.current_low
            rangeBox.current_low := low

// ═══════════════════════════════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════════════════════════════

var LiquidityPool daily_pool = create_pool()
var LiquidityPool weekly_pool = create_pool()
var LiquidityPool monthly_pool = create_pool()
var LiquidityPool asia_pool = create_pool()
var LiquidityPool london_pool = create_pool()
var LiquidityPool nyam_pool = create_pool()
var LiquidityPool lunch_pool = create_pool()
var LiquidityPool nypm_pool = create_pool()
var LiquidityPool premarket_pool = create_pool()
var LiquidityPool overnight_pool = create_pool()
var RangeBox range_box = create_range_box()
var IntradayClosingPriceTracker fourteen_hundred_close = create_1400_close()
var IntradayClosingPriceTracker sixteen_hundred_close = create_1600_close()
var TimeframeOpenTracker four_hour_open = create_tf_open()
var TimeframeOpenTracker one_hour_open = create_tf_open()
var TimeframeOpenTracker midnight_open = create_tf_open()
var TimeframeOpenTracker eight_thirty_open = create_tf_open()
var TimeframeOpenTracker nine_thirty_open = create_tf_open()
var TimeframeOpenTracker daily_open = create_tf_open()
var TimeframeOpenTracker weekly_open = create_tf_open()
var TimeframeOpenTracker monthly_open = create_tf_open()
var array<line> all_lines = array.new<line>()
var array<label> all_labels = array.new<label>()
var array<PendingLabelEvent> pending_label_events = array.new<PendingLabelEvent>()
var array<box> all_boxes = array.new<box>()
var table asset_levels_table = table.new(position.top_right, 3, 6, border_width=LINE_WIDTH_1)

// ═══════════════════════════════════════════════════════════════════════════════
// DATA COLLECTION
// ═══════════════════════════════════════════════════════════════════════════════

is_new_calendar_day = ta.change(dayofmonth(time, NY_TIMEZONE)) != 0
is_new_daily_bar = use_exchange_session ? is_new_exchange_daily_session() : is_new_calendar_day
is_new_weekly_bar = ta.change(weekofyear(time, NY_TIMEZONE)) != 0
is_new_monthly_bar = ta.change(month(time, NY_TIMEZONE)) != 0

// On standard charts ticker.standard() strips the chart's own modifiers and returns prices the
// visible candles never traded, so it is reserved for synthetic charts.
htf_ticker_id = chart.is_standard ? syminfo.tickerid : ticker.standard(syminfo.tickerid)
[sec_daily_high, sec_daily_low] = request.security(htf_ticker_id, "D", [high, low])
[sec_weekly_high, sec_weekly_low] = request.security(htf_ticker_id, "W", [high, low])
[sec_monthly_high, sec_monthly_low] = request.security(htf_ticker_id, "M", [high, low])

// Trading week detection: Triggers when market reopens Sunday 18:00 ET (new trading week)
is_new_trading_week = false
if not is247Asset  // Only for traditional assets
    currentDay = dayofweek(time, NY_TIMEZONE)
    currentHour = hour(time, NY_TIMEZONE)
    prevDay = dayofweek(time[1], NY_TIMEZONE)
    prevHour = hour(time[1], NY_TIMEZONE)

    // New trading week = crossing into Sunday 18:00+ from before
    isSundayReopenNow = currentDay == dayofweek.sunday and currentHour >= EXCHANGE_SESSION_START_HOUR
    wasSundayReopenBefore = prevDay == dayofweek.sunday and prevHour >= EXCHANGE_SESSION_START_HOUR

    is_new_trading_week := isSundayReopenNow and not wasSundayReopenBefore

// Detect toggle change and clear weekly pool to prevent duplicate data
var bool prev_trading_week_mode = includeSundayEvening
if includeSundayEvening != prev_trading_week_mode
    // Clear all weekly pool arrays when switching modes
    array.clear(weekly_pool.highs)
    array.clear(weekly_pool.lows)
    array.clear(weekly_pool.high_times)
    array.clear(weekly_pool.low_times)
    array.clear(weekly_pool.high_indices)
    array.clear(weekly_pool.low_indices)
    array.clear(weekly_pool.high_breached)
    array.clear(weekly_pool.low_breached)
    array.clear(weekly_pool.high_breach_times)
    array.clear(weekly_pool.low_breach_times)
    array.clear(weekly_pool.high_breach_indices)
    array.clear(weekly_pool.low_breach_indices)
    array.clear(weekly_pool.session_start_times)
    array.clear(weekly_pool.session_end_times)
    array.clear(weekly_pool.high_liquidity_depths)
    array.clear(weekly_pool.low_liquidity_depths)
    prev_trading_week_mode := includeSundayEvening

// Calculate Sunday skip once for all liquidity sources (performance optimization)
skip_sunday_liquidity = should_skip_sunday_liquidity(time)
skip_sunday_overnight = false  // Overnight never skips Sunday - session starts at 18:00

if barstate.isfirst
    daily_pool.current_high := high
    daily_pool.current_low := low
    daily_pool.current_high_time := time
    daily_pool.current_low_time := time
    daily_pool.current_high_index := bar_index
    daily_pool.current_low_index := bar_index

    weekly_pool.current_high := high
    weekly_pool.current_low := low
    weekly_pool.current_high_time := time
    weekly_pool.current_low_time := time
    weekly_pool.current_high_index := bar_index
    weekly_pool.current_low_index := bar_index

    monthly_pool.current_high := high
    monthly_pool.current_low := low
    monthly_pool.current_high_time := time
    monthly_pool.current_low_time := time
    monthly_pool.current_high_index := bar_index
    monthly_pool.current_low_index := bar_index
else
    // Daily tracking - runs on all non-first bars
    if is_new_daily_bar
        // Calendar Day mode: guard against duplicate fire at midnight after Sunday evening
        // Exchange Session mode: 18:00 boundary never has this issue
        // On daily+: every bar is a new session, no duplicates possible
        coming_from_sunday_evening = not use_exchange_session and timeframe.in_seconds() < 86400 and not is247Asset and dayofweek(time[1], NY_TIMEZONE) == dayofweek.sunday and hour(time[1], NY_TIMEZONE) >= EXCHANGE_SESSION_START_HOUR
        if not coming_from_sunday_evening
            // Exchange-session futures and 24/7 calendar days align with native Daily candles.
            if (use_exchange_session or is247Asset) and not na(sec_daily_high[1]) and not na(sec_daily_low[1])
                daily_pool.current_high := sec_daily_high[1]
                daily_pool.current_low := sec_daily_low[1]
            pool_store_session(daily_pool)

        // Initialize tracking for the new session
        // On daily+: always initialize (bar covers full session, not just Sunday evening)
        // On sub-daily: skip if current bar is Sunday evening (Calendar Day mode only)
        if timeframe.in_seconds() >= 86400 or not skip_sunday_liquidity
            daily_pool.current_high := high
            daily_pool.current_low := low
            daily_pool.current_high_time := time
            daily_pool.current_low_time := time
            daily_pool.current_high_index := bar_index
            daily_pool.current_low_index := bar_index
    else if not skip_sunday_liquidity
        // Update tracking during the day
        if high > daily_pool.current_high
            daily_pool.current_high := high
            daily_pool.current_high_time := time
            daily_pool.current_high_index := bar_index
        if low < daily_pool.current_low
            daily_pool.current_low := low
            daily_pool.current_low_time := time
            daily_pool.current_low_index := bar_index
    else
        if high > daily_pool.current_high
            daily_pool.current_high := high
            daily_pool.current_high_time := time
            daily_pool.current_high_index := bar_index
        if low < daily_pool.current_low
            daily_pool.current_low := low
            daily_pool.current_low_time := time
            daily_pool.current_low_index := bar_index

    // Weekly (toggle between calendar week and trading week)
    weekly_reset_trigger = includeSundayEvening ? is_new_trading_week : is_new_weekly_bar
    if weekly_reset_trigger
        // Override with authoritative H/L from request.security before storing
        if not na(sec_weekly_high[1]) and not na(sec_weekly_low[1])
            weekly_pool.current_high := sec_weekly_high[1]
            weekly_pool.current_low := sec_weekly_low[1]
        pool_store_session(weekly_pool)
        weekly_pool.current_high := high
        weekly_pool.current_low := low
        weekly_pool.current_high_time := time
        weekly_pool.current_low_time := time
        weekly_pool.current_high_index := bar_index
        weekly_pool.current_low_index := bar_index
    else
        if high > weekly_pool.current_high
            weekly_pool.current_high := high
            weekly_pool.current_high_time := time
            weekly_pool.current_high_index := bar_index
        if low < weekly_pool.current_low
            weekly_pool.current_low := low
            weekly_pool.current_low_time := time
            weekly_pool.current_low_index := bar_index

    // Monthly
    if is_new_monthly_bar
        // Override with authoritative H/L from request.security before storing
        if not na(sec_monthly_high[1]) and not na(sec_monthly_low[1])
            monthly_pool.current_high := sec_monthly_high[1]
            monthly_pool.current_low := sec_monthly_low[1]
        pool_store_session(monthly_pool)
        monthly_pool.current_high := high
        monthly_pool.current_low := low
        monthly_pool.current_high_time := time
        monthly_pool.current_low_time := time
        monthly_pool.current_high_index := bar_index
        monthly_pool.current_low_index := bar_index
    else
        if high > monthly_pool.current_high
            monthly_pool.current_high := high
            monthly_pool.current_high_time := time
            monthly_pool.current_high_index := bar_index
        if low < monthly_pool.current_low
            monthly_pool.current_low := low
            monthly_pool.current_low_time := time
            monthly_pool.current_low_index := bar_index
// When skip_sunday_liquidity is TRUE: HTF pools freeze Friday's data (don't update)
// Intraday/PoiSzn sessions always finalize Friday sessions, but skip starting new ones during Sunday evening

// Intraday session liquidity pool tracking
// ALWAYS call tracking to detect Friday session endings (functions handle Sunday skip internally)
if timeframe.in_seconds() <= INTRADAY_SESSION_MAX_TIMEFRAME
    if showAsiaFiltered or sessionBoxesActive
        track_intraday_session(asia_pool, actualAsiaSession, skip_sunday_liquidity)

    if showLondonFiltered or sessionBoxesActive
        track_intraday_session(london_pool, actualLondonSession, skip_sunday_liquidity)

    if showNyamFiltered or sessionBoxesActive
        track_intraday_session(nyam_pool, actualNyamSession, skip_sunday_liquidity)

    if showLunchFiltered
        track_intraday_session(lunch_pool, actualLunchSession, skip_sunday_liquidity)

    if showNypmFiltered or sessionBoxesActive
        track_intraday_session(nypm_pool, actualNypmSession, skip_sunday_liquidity)

    // PoiSzn session liquidity pool tracking
    if showPremarketFiltered or sessionBoxesActive
        track_intraday_session(premarket_pool, actualPremarketSession, skip_sunday_liquidity)

    if showOvernightFiltered
        track_intraday_session(overnight_pool, actualOvernightSession, skip_sunday_overnight)  // Overnight never skips Sunday - session starts at 18:00

// Sunday 18:00-23:59 Continuation for Traditional Markets (Calendar Day mode only)
// In Exchange Session mode, Sunday 18:00 starts a new session — no continuation needed
// For futures/forex in Calendar Day mode: Sunday evening is part of Friday's trading session
// Update Friday's stored daily pool if new highs/lows occur during Sunday reopen
// Only on sub-daily timeframes (on 1D, the session bar spans the full Monday session)
if not use_exchange_session and not is247Asset and timeframe.in_seconds() < 86400 and dayofweek(time, NY_TIMEZONE) == dayofweek.sunday and hour(time, NY_TIMEZONE) >= EXCHANGE_SESSION_START_HOUR
    // Update DAILY pool only (Friday's stored high/low)
    if showDaily and array.size(daily_pool.highs) > 0
        last_index = array.size(daily_pool.highs) - 1
        last_high = array.get(daily_pool.highs, last_index)
        last_low = array.get(daily_pool.lows, last_index)


        // Update both price AND timestamp when new highs/lows are made
        // Also reset breach status since this is a new level
        if high > last_high
            array.set(daily_pool.highs, last_index, high)
            array.set(daily_pool.high_times, last_index, time)
            array.set(daily_pool.high_indices, last_index, bar_index)
            array.set(daily_pool.high_breached, last_index, false)
            array.set(daily_pool.high_breach_times, last_index, na)
            array.set(daily_pool.high_breach_indices, last_index, na)
            // Also update current tracking
            daily_pool.current_high := high
            daily_pool.current_high_time := time
            daily_pool.current_high_index := bar_index
        if low < last_low
            array.set(daily_pool.lows, last_index, low)
            array.set(daily_pool.low_times, last_index, time)
            array.set(daily_pool.low_indices, last_index, bar_index)
            array.set(daily_pool.low_breached, last_index, false)
            array.set(daily_pool.low_breach_times, last_index, na)
            array.set(daily_pool.low_breach_indices, last_index, na)
            // Also update current tracking
            daily_pool.current_low := low
            daily_pool.current_low_time := time
            daily_pool.current_low_index := bar_index

        // Maintain Friday's levels in current tracking even if no new highs/lows
        // This ensures Monday starts with Friday's levels, not Sunday's gap prices
        // ALWAYS set to Friday's stored values during Sunday evening
        daily_pool.current_high := last_high
        daily_pool.current_high_time := array.get(daily_pool.high_times, last_index)
        daily_pool.current_high_index := array.get(daily_pool.high_indices, last_index)
        daily_pool.current_low := last_low
        daily_pool.current_low_time := array.get(daily_pool.low_times, last_index)
        daily_pool.current_low_index := array.get(daily_pool.low_indices, last_index)

// Range box tracking
if not skip_sunday_liquidity
    if showRangeBoxFiltered
        track_range_session(range_box, actualRangeSession)

// 14:00 Close tracking - detect and store
// Requires intraday timeframe (1m to 1H) to capture 1-minute candle precisely
if show1400CloseFiltered and timeframe.in_seconds() >= INTRADAY_CLOSING_PRICE_MIN_TIMEFRAME and timeframe.in_seconds() <= INTRADAY_CLOSING_PRICE_MAX_TIMEFRAME and not skip_sunday_liquidity
    currentHour_1400 = hour(time, NY_TIMEZONE)
    currentMinute_1400 = minute(time, NY_TIMEZONE)

    is1400Bar = currentHour_1400 == 14 and currentMinute_1400 == 0

    if is1400Bar
        // Push previous day's level to storage if it exists
        if not na(fourteen_hundred_close.current_close)
            array.push(fourteen_hundred_close.closes, fourteen_hundred_close.current_close)
            array.push(fourteen_hundred_close.times, fourteen_hundred_close.current_time)
            array.push(fourteen_hundred_close.mitigated, fourteen_hundred_close.current_mitigated)
            array.push(fourteen_hundred_close.mitigation_times, fourteen_hundred_close.current_mitigation_time)
            array.push(fourteen_hundred_close.capture_hours, fourteen_hundred_close.current_capture_hour)

        // Capture new 14:00 close and reset mitigation status
        fourteen_hundred_close.current_close := close
        fourteen_hundred_close.current_time := time
        fourteen_hundred_close.current_mitigated := false
        fourteen_hundred_close.current_mitigation_time := na
        fourteen_hundred_close.current_capture_hour := 14

// 16:00/18:00 Close tracking - detect and store
// Automatically captures 16:00 on normal days, 18:00 on early-close days (consistent with overnight session behavior)
// NOTE: Not affected by Sunday skip because 16:00 doesn't occur during Sunday evening (market opens at 18:00)
// and mitigation detection must still run to check stored levels
// Requires intraday timeframe (1m to 1H) to capture 1-minute candle precisely
if show1600CloseFiltered and timeframe.in_seconds() >= INTRADAY_CLOSING_PRICE_MIN_TIMEFRAME and timeframe.in_seconds() <= INTRADAY_CLOSING_PRICE_MAX_TIMEFRAME
    currentHour_1600 = hour(time, NY_TIMEZONE)
    currentMinute_1600 = minute(time, NY_TIMEZONE)

    // Try to detect 16:00 first (normal close), then 18:00 (early close reopen)
    is1600Bar = currentHour_1600 == MARKET_CLOSE_HOUR and currentMinute_1600 == 0
    is1800Bar = currentHour_1600 == EXCHANGE_SESSION_START_HOUR and currentMinute_1600 == 0

    // For traditional markets, skip Sunday 16:00 (only 18:00 reopen is valid)
    isSunday = dayofweek(time, NY_TIMEZONE) == dayofweek.sunday
    skipSunday1600 = not is247Asset and isSunday

    if is1600Bar and not skipSunday1600
        // Push previous day's level to storage if it exists
        if not na(sixteen_hundred_close.current_close)
            array.push(sixteen_hundred_close.closes, sixteen_hundred_close.current_close)
            array.push(sixteen_hundred_close.times, sixteen_hundred_close.current_time)
            array.push(sixteen_hundred_close.mitigated, sixteen_hundred_close.current_mitigated)
            array.push(sixteen_hundred_close.mitigation_times, sixteen_hundred_close.current_mitigation_time)
            array.push(sixteen_hundred_close.capture_hours, sixteen_hundred_close.current_capture_hour)

        // Capture new 16:00 close and reset mitigation status
        sixteen_hundred_close.current_close := close
        sixteen_hundred_close.current_time := time
        sixteen_hundred_close.current_mitigated := false
        sixteen_hundred_close.current_mitigation_time := na
        sixteen_hundred_close.current_capture_hour := 16

    else if is1800Bar and not isSunday
        // Only capture 18:00 on WEEKDAYS for early-close holidays (not Sunday reopen)
        // Check if we haven't captured a 16:00 TODAY (early close fallback)
        capturedToday = not na(sixteen_hundred_close.current_close) and dayofmonth(sixteen_hundred_close.current_time, NY_TIMEZONE) == dayofmonth(time, NY_TIMEZONE)

        if not capturedToday
            // Push previous day's level to storage if it exists
            if not na(sixteen_hundred_close.current_close)
                array.push(sixteen_hundred_close.closes, sixteen_hundred_close.current_close)
                array.push(sixteen_hundred_close.times, sixteen_hundred_close.current_time)
                array.push(sixteen_hundred_close.mitigated, sixteen_hundred_close.current_mitigated)
                array.push(sixteen_hundred_close.mitigation_times, sixteen_hundred_close.current_mitigation_time)
                array.push(sixteen_hundred_close.capture_hours, sixteen_hundred_close.current_capture_hour)

            // Capture 18:00 close (early close reopen)
            sixteen_hundred_close.current_close := close
            sixteen_hundred_close.current_time := time
            sixteen_hundred_close.current_mitigated := false
            sixteen_hundred_close.current_mitigation_time := na
            sixteen_hundred_close.current_capture_hour := 18

// 4H Open: 02, 06, 10, 14, 18, 22 NY time (1m-4H charts)
if show4HOpenFiltered and timeframe.in_seconds() >= 60 and timeframe.in_seconds() <= 14400
    currentHour_4h = hour(time, NY_TIMEZONE)
    is_new_4h = (currentHour_4h - 2) % 4 == 0 and minute(time, NY_TIMEZONE) == 0 and ta.change(time) != 0
    if is_new_4h
        if not na(four_hour_open.current_open)
            array.push(four_hour_open.opens, four_hour_open.current_open)
            array.push(four_hour_open.times, four_hour_open.current_time)
            array.push(four_hour_open.hours, four_hour_open.current_hour)
        four_hour_open.current_open := open
        four_hour_open.current_time := time
        four_hour_open.current_hour := currentHour_4h

// 1H Open: every hour on the hour (1m-1H charts)
if show1HOpenFiltered and timeframe.in_seconds() >= 60 and timeframe.in_seconds() <= 3600
    currentHour_1h = hour(time, NY_TIMEZONE)
    is_new_1h = minute(time, NY_TIMEZONE) == 0 and ta.change(time) != 0
    if is_new_1h
        if not na(one_hour_open.current_open)
            array.push(one_hour_open.opens, one_hour_open.current_open)
            array.push(one_hour_open.times, one_hour_open.current_time)
            array.push(one_hour_open.hours, one_hour_open.current_hour)
        one_hour_open.current_open := open
        one_hour_open.current_time := time
        one_hour_open.current_hour := currentHour_1h

// Midnight Open: capture 00:00 NY time (1m-1H charts)
if showMnoOpenFiltered and timeframe.in_seconds() >= 60 and timeframe.in_seconds() <= 3600
    is_mno = hour(time, NY_TIMEZONE) == 0 and minute(time, NY_TIMEZONE) == 0 and ta.change(time) != 0
    if is_mno
        if not na(midnight_open.current_open)
            array.push(midnight_open.opens, midnight_open.current_open)
            array.push(midnight_open.times, midnight_open.current_time)
            array.push(midnight_open.hours, midnight_open.current_hour)
        midnight_open.current_open := open
        midnight_open.current_time := time
        midnight_open.current_hour := 0

// 8:30 Open: capture 8:30 AM NY time (1m-1H charts)
if show830OpenFiltered and timeframe.in_seconds() >= 60 and timeframe.in_seconds() <= 3600
    is_830 = hour(time, NY_TIMEZONE) == 8 and minute(time, NY_TIMEZONE) == 30 and ta.change(time) != 0
    if is_830
        if not na(eight_thirty_open.current_open)
            array.push(eight_thirty_open.opens, eight_thirty_open.current_open)
            array.push(eight_thirty_open.times, eight_thirty_open.current_time)
            array.push(eight_thirty_open.hours, eight_thirty_open.current_hour)
        eight_thirty_open.current_open := open
        eight_thirty_open.current_time := time
        eight_thirty_open.current_hour := 830

// 9:30 Open: capture 9:30 AM NY time - US market open (1m-1H charts)
if show930OpenFiltered and timeframe.in_seconds() >= 60 and timeframe.in_seconds() <= 3600
    is_930 = hour(time, NY_TIMEZONE) == 9 and minute(time, NY_TIMEZONE) == 30 and ta.change(time) != 0
    if is_930
        if not na(nine_thirty_open.current_open)
            array.push(nine_thirty_open.opens, nine_thirty_open.current_open)
            array.push(nine_thirty_open.times, nine_thirty_open.current_time)
            array.push(nine_thirty_open.hours, nine_thirty_open.current_hour)
        nine_thirty_open.current_open := open
        nine_thirty_open.current_time := time
        nine_thirty_open.current_hour := 930

// Daily Open: midnight or 18:00 (digital) based on toggle (1m-12H charts)
if showDailyOpenFiltered and timeframe.in_seconds() >= 60 and timeframe.in_seconds() < 86400
    daily_open_hour = useDailyDigitalOpen ? 18 : 0
    is_new_daily = hour(time, NY_TIMEZONE) == daily_open_hour and minute(time, NY_TIMEZONE) == 0 and ta.change(time) != 0
    if is_new_daily
        if not na(daily_open.current_open)
            array.push(daily_open.opens, daily_open.current_open)
            array.push(daily_open.times, daily_open.current_time)
            array.push(daily_open.hours, daily_open.current_hour)
        daily_open.current_open := open
        daily_open.current_time := time
        daily_open.current_hour := daily_open_hour

// Weekly Open (1m-4D charts)
if showWeeklyOpenFiltered and timeframe.in_seconds() >= 60 and timeframe.in_seconds() < 604800
    if ta.change(time("W")) != 0
        if not na(weekly_open.current_open)
            array.push(weekly_open.opens, weekly_open.current_open)
            array.push(weekly_open.times, weekly_open.current_time)
            array.push(weekly_open.hours, weekly_open.current_hour)
        weekly_open.current_open := open
        weekly_open.current_time := time
        weekly_open.current_hour := 0

// Monthly Open (1m-2W charts)
if showMonthlyOpenFiltered and timeframe.in_seconds() >= 60 and timeframe.in_seconds() < 2592000
    if ta.change(time("M")) != 0
        if not na(monthly_open.current_open)
            array.push(monthly_open.opens, monthly_open.current_open)
            array.push(monthly_open.times, monthly_open.current_time)
            array.push(monthly_open.hours, monthly_open.current_hour)
        monthly_open.current_open := open
        monthly_open.current_time := time
        monthly_open.current_hour := 0

// ═══════════════════════════════════════════════════════════════════════════════
// BREACH DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

// HTF breach detection: Sunday skip only on sub-daily timeframes (daily+ bars span beyond Sunday evening)
htf_skip_sunday = skip_sunday_liquidity and timeframe.in_seconds() < 86400
if showDailyFiltered and not htf_skip_sunday
    // Only track liquidity depth if enabled, asset supported, and timeframe valid
    daily_liquidity_depth_dist = (effectiveEnableDailyLiquidityDepth and isAssetSupported and effectiveIsDailyLiquidityDepthTimeframeValid) ? dailyLiquidityDepthDistance : 0
    pool_detect_breaches(daily_pool, DAILY_SCAN_CAP, daily_liquidity_depth_dist, alertDaily, ALERT_DAILY_HIGH_BREACH, ALERT_DAILY_LOW_BREACH)

if showWeeklyFiltered and not htf_skip_sunday
    // Only track liquidity depth if enabled, asset supported, and timeframe valid
    weekly_liquidity_depth_dist = (effectiveEnableWeeklyLiquidityDepth and isAssetSupported and effectiveIsWeeklyLiquidityDepthTimeframeValid) ? weeklyLiquidityDepthDistance : 0
    pool_detect_breaches(weekly_pool, WEEKLY_SCAN_CAP, weekly_liquidity_depth_dist, alertWeekly, ALERT_WEEKLY_HIGH_BREACH, ALERT_WEEKLY_LOW_BREACH)

if showMonthlyFiltered and not htf_skip_sunday
    // Only track liquidity depth if enabled, asset supported, and timeframe valid
    monthly_liquidity_depth_dist = (effectiveEnableMonthlyLiquidityDepth and isAssetSupported and effectiveIsMonthlyLiquidityDepthTimeframeValid) ? monthlyLiquidityDepthDistance : 0
    pool_detect_breaches(monthly_pool, MONTHLY_SCAN_CAP, monthly_liquidity_depth_dist, alertMonthly, ALERT_MONTHLY_HIGH_BREACH, ALERT_MONTHLY_LOW_BREACH)

if not skip_sunday_liquidity
    // Intraday session breach detection (percentage-based liquidity depth)
    // Use filtered versions to respect Pulse Mode filter
    if timeframe.in_seconds() <= INTRADAY_SESSION_MAX_TIMEFRAME
        // Determine liquidity depth percentages based on toggle for intraday sessions (Asia/London/NYAM/Lunch/NYPM)
        intraday_liquidity_depth_pct1 = effectiveEnableIntradayLiquidityDepth ? intradayLiquidityDepthPercent1 : 0
        intraday_liquidity_depth_pct2 = effectiveEnableIntradayLiquidityDepth ? intradayLiquidityDepthPercent2 : 0
        intraday_liquidity_depth_pct3 = effectiveEnableIntradayLiquidityDepth ? intradayLiquidityDepthPercent3 : 0

        // Determine liquidity depth percentages for Premarket (separate toggle)
        premarket_liquidity_depth_pct1 = effectiveEnablePremarketLiquidityDepth ? intradayLiquidityDepthPercent1 : 0
        premarket_liquidity_depth_pct2 = effectiveEnablePremarketLiquidityDepth ? intradayLiquidityDepthPercent2 : 0
        premarket_liquidity_depth_pct3 = effectiveEnablePremarketLiquidityDepth ? intradayLiquidityDepthPercent3 : 0

        // Determine liquidity depth percentages for Overnight (separate toggle)
        overnight_liquidity_depth_pct1 = effectiveEnableOvernightLiquidityDepth ? intradayLiquidityDepthPercent1 : 0
        overnight_liquidity_depth_pct2 = effectiveEnableOvernightLiquidityDepth ? intradayLiquidityDepthPercent2 : 0
        overnight_liquidity_depth_pct3 = effectiveEnableOvernightLiquidityDepth ? intradayLiquidityDepthPercent3 : 0

        if showAsiaFiltered
            pool_detect_intraday_breaches(asia_pool, ASIA_SCAN_CAP, intraday_liquidity_depth_pct1, intraday_liquidity_depth_pct2, intraday_liquidity_depth_pct3, alertIntraday, ALERT_INTRADAY_HIGH_BREACH, ALERT_INTRADAY_LOW_BREACH)

        if showLondonFiltered
            pool_detect_intraday_breaches(london_pool, LONDON_SCAN_CAP, intraday_liquidity_depth_pct1, intraday_liquidity_depth_pct2, intraday_liquidity_depth_pct3, alertIntraday, ALERT_INTRADAY_HIGH_BREACH, ALERT_INTRADAY_LOW_BREACH)

        if showNyamFiltered
            pool_detect_intraday_breaches(nyam_pool, NYAM_SCAN_CAP, intraday_liquidity_depth_pct1, intraday_liquidity_depth_pct2, intraday_liquidity_depth_pct3, alertIntraday, ALERT_INTRADAY_HIGH_BREACH, ALERT_INTRADAY_LOW_BREACH)

        if showLunchFiltered
            pool_detect_intraday_breaches(lunch_pool, LUNCH_SCAN_CAP, intraday_liquidity_depth_pct1, intraday_liquidity_depth_pct2, intraday_liquidity_depth_pct3, alertIntraday, ALERT_INTRADAY_HIGH_BREACH, ALERT_INTRADAY_LOW_BREACH)

        if showNypmFiltered
            pool_detect_intraday_breaches(nypm_pool, NYPM_SCAN_CAP, intraday_liquidity_depth_pct1, intraday_liquidity_depth_pct2, intraday_liquidity_depth_pct3, alertIntraday, ALERT_INTRADAY_HIGH_BREACH, ALERT_INTRADAY_LOW_BREACH)

        if showPremarketFiltered
            pool_detect_intraday_breaches(premarket_pool, PREMARKET_SCAN_CAP, premarket_liquidity_depth_pct1, premarket_liquidity_depth_pct2, premarket_liquidity_depth_pct3, alertPremarket, ALERT_PREMARKET_HIGH_BREACH, ALERT_PREMARKET_LOW_BREACH)

        if showOvernightFiltered
            pool_detect_intraday_breaches(overnight_pool, OVERNIGHT_SCAN_CAP, overnight_liquidity_depth_pct1, overnight_liquidity_depth_pct2, overnight_liquidity_depth_pct3, alertOvernight, ALERT_OVERNIGHT_HIGH_BREACH, ALERT_OVERNIGHT_LOW_BREACH)
else if not skip_sunday_overnight and timeframe.in_seconds() <= INTRADAY_SESSION_MAX_TIMEFRAME
    // Sunday evening breach detection - stored levels from previous sessions can still be mitigated
    if showOvernightFiltered
        overnight_liq_pct1 = effectiveEnableOvernightLiquidityDepth ? intradayLiquidityDepthPercent1 : 0
        overnight_liq_pct2 = effectiveEnableOvernightLiquidityDepth ? intradayLiquidityDepthPercent2 : 0
        overnight_liq_pct3 = effectiveEnableOvernightLiquidityDepth ? intradayLiquidityDepthPercent3 : 0
        pool_detect_intraday_breaches(overnight_pool, OVERNIGHT_SCAN_CAP, overnight_liq_pct1, overnight_liq_pct2, overnight_liq_pct3, alertOvernight, ALERT_OVERNIGHT_HIGH_BREACH, ALERT_OVERNIGHT_LOW_BREACH)
    if showPremarketFiltered
        premarket_liq_pct1 = effectiveEnablePremarketLiquidityDepth ? intradayLiquidityDepthPercent1 : 0
        premarket_liq_pct2 = effectiveEnablePremarketLiquidityDepth ? intradayLiquidityDepthPercent2 : 0
        premarket_liq_pct3 = effectiveEnablePremarketLiquidityDepth ? intradayLiquidityDepthPercent3 : 0
        pool_detect_intraday_breaches(premarket_pool, PREMARKET_SCAN_CAP, premarket_liq_pct1, premarket_liq_pct2, premarket_liq_pct3, alertPremarket, ALERT_PREMARKET_HIGH_BREACH, ALERT_PREMARKET_LOW_BREACH)

// Detect 14:00 close mitigation (ONLY after 05:00 next day)
// NOTE: Mitigation detection skips Sunday evening ONLY for Market-Hours mode
if show1400CloseFiltered and (not skip_sunday_liquidity or close1400MitigationWindow == MITIGATION_WINDOW_ANYTIME)
    currentHour_mitigation_1400 = hour(time, NY_TIMEZONE)

    // Determine if we're in the mitigation window based on mode
    isInMitigationWindow_1400 = false
    if close1400MitigationWindow == MITIGATION_WINDOW_ANYTIME
        // Anytime: Any hour is valid (13-hour delay already protects same-day)
        isInMitigationWindow_1400 := true
    else
        // Market-Hours: Only between 05:00-16:00 (excludes overnight 16:00-05:00)
        isInMitigationWindow_1400 := currentHour_mitigation_1400 >= MITIGATION_START_HOUR and currentHour_mitigation_1400 < MARKET_CLOSE_HOUR

    // Check CURRENT level (today's 14:00 that hasn't been pushed to array yet)
    if not na(fourteen_hundred_close.current_close) and not fourteen_hundred_close.current_mitigated
        // Require BOTH: 13+ hours elapsed AND in mitigation window
        // This protects intraday (Tue 14:00 → Wed 05:00) AND handles weekends (Fri 14:00 → Mon 05:00)
        if (time >= fourteen_hundred_close.current_time + INTRADAY_CLOSING_PRICE_MITIGATION_DELAY_MS) and isInMitigationWindow_1400
            // Price touched or crossed the level
            if (high >= fourteen_hundred_close.current_close and low <= fourteen_hundred_close.current_close) or close == fourteen_hundred_close.current_close
                fourteen_hundred_close.current_mitigated := true
                fourteen_hundred_close.current_mitigation_time := time

    // Check stored levels (previous days in array)
    if array.size(fourteen_hundred_close.closes) > 0
        scan_size_1400 = math.min(array.size(fourteen_hundred_close.closes), INTRADAY_CLOSING_PRICE_SCAN_CAP)
        start_index_1400 = math.max(0, array.size(fourteen_hundred_close.closes) - scan_size_1400)

        for i = start_index_1400 to array.size(fourteen_hundred_close.closes) - 1
            if not array.get(fourteen_hundred_close.mitigated, i)
                close_level_1400 = array.get(fourteen_hundred_close.closes, i)
                close_time_stored_1400 = array.get(fourteen_hundred_close.times, i)

                // Require BOTH: 13+ hours elapsed AND in mitigation window
                // This protects intraday (Tue 14:00 → Wed 05:00) AND handles weekends (Fri 14:00 → Mon 05:00)
                if (time >= close_time_stored_1400 + INTRADAY_CLOSING_PRICE_MITIGATION_DELAY_MS) and isInMitigationWindow_1400
                    // Price touched or crossed the level
                    if (high >= close_level_1400 and low <= close_level_1400) or close == close_level_1400
                        array.set(fourteen_hundred_close.mitigated, i, true)
                        array.set(fourteen_hundred_close.mitigation_times, i, time)

// Detect 16:00 close mitigation (ONLY after 05:00 next day)
// NOTE: Mitigation detection skips Sunday evening ONLY for Market-Hours mode
if show1600CloseFiltered and (not skip_sunday_liquidity or close1600MitigationWindow == MITIGATION_WINDOW_ANYTIME)
    currentHour_mitigation = hour(time, NY_TIMEZONE)

    // Determine if we're in the mitigation window based on mode
    isInMitigationWindow = false
    if close1600MitigationWindow == MITIGATION_WINDOW_ANYTIME
        // Anytime: Any hour is valid (13-hour delay already protects same-day)
        isInMitigationWindow := true
    else
        // Market-Hours: Only between 05:00-16:00 (excludes overnight 16:00-05:00)
        isInMitigationWindow := currentHour_mitigation >= MITIGATION_START_HOUR and currentHour_mitigation < MARKET_CLOSE_HOUR

    // Check CURRENT level (today's 16:00 that hasn't been pushed to array yet)
    if not na(sixteen_hundred_close.current_close) and not sixteen_hundred_close.current_mitigated
        // Require BOTH: 13+ hours elapsed AND in mitigation window
        // This protects intraday (Tue 16:00 → Wed 05:00) AND handles weekends (Fri 16:00 → Mon 05:00)
        if (time >= sixteen_hundred_close.current_time + INTRADAY_CLOSING_PRICE_MITIGATION_DELAY_MS) and isInMitigationWindow
            // Price touched or crossed the level
            if (high >= sixteen_hundred_close.current_close and low <= sixteen_hundred_close.current_close) or close == sixteen_hundred_close.current_close
                sixteen_hundred_close.current_mitigated := true
                sixteen_hundred_close.current_mitigation_time := time
                if alert1600Close
                    alert(ALERT_1600_MITIGATED, alert.freq_once_per_bar)

    // Check stored levels (previous days in array)
    if array.size(sixteen_hundred_close.closes) > 0
        scan_size = math.min(array.size(sixteen_hundred_close.closes), INTRADAY_CLOSING_PRICE_SCAN_CAP)
        start_index = math.max(0, array.size(sixteen_hundred_close.closes) - scan_size)

        for i = start_index to array.size(sixteen_hundred_close.closes) - 1
            if not array.get(sixteen_hundred_close.mitigated, i)
                close_level = array.get(sixteen_hundred_close.closes, i)
                close_time_stored = array.get(sixteen_hundred_close.times, i)

                // Require BOTH: 13+ hours elapsed AND in mitigation window
                // This protects intraday (Tue 16:00 → Wed 05:00) AND handles weekends (Fri 16:00 → Mon 05:00)
                if (time >= close_time_stored + INTRADAY_CLOSING_PRICE_MITIGATION_DELAY_MS) and isInMitigationWindow
                    // Price touched or crossed the level
                    if (high >= close_level and low <= close_level) or close == close_level
                        array.set(sixteen_hundred_close.mitigated, i, true)
                        array.set(sixteen_hundred_close.mitigation_times, i, time)
                        if alert1600Close
                            alert(ALERT_1600_MITIGATED, alert.freq_once_per_bar)

// ═══════════════════════════════════════════════════════════════════════════════
// ARRAY PRUNING - Keep arrays bounded to prevent memory growth
// ═══════════════════════════════════════════════════════════════════════════════

// Prune HTF pools (Daily, Weekly, Monthly)
prune_pool(daily_pool, dailyShowLast * 2)
prune_pool(weekly_pool, weeklyShowLast * 2)
prune_pool(monthly_pool, monthlyShowLast * 2)

// Prune Intraday pools
prune_pool(asia_pool, effectiveIntradayShowLast * 2)
prune_pool(london_pool, effectiveIntradayShowLast * 2)
prune_pool(nyam_pool, effectiveIntradayShowLast * 2)
prune_pool(lunch_pool, effectiveIntradayShowLast * 2)
prune_pool(nypm_pool, effectiveIntradayShowLast * 2)
prune_pool(premarket_pool, poisznShowLast * 2)
prune_pool(overnight_pool, poisznShowLast * 2)

// Prune Range Box
prune_range_box(range_box, rangeBoxShowLast * 2)

// Prune Intraday Closes (14:00, 16:00)
prune_intraday_tracker(fourteen_hundred_close, close1400ShowLast * 2)
prune_intraday_tracker(sixteen_hundred_close, close1600ShowLast * 2)

// Prune Timeframe Opens
prune_tf_tracker(four_hour_open, open4HShowLast * 2)
prune_tf_tracker(one_hour_open, open1HShowLast * 2)
prune_tf_tracker(midnight_open, openMnoShowLast * 2)
prune_tf_tracker(eight_thirty_open, open830ShowLast * 2)
prune_tf_tracker(nine_thirty_open, open930ShowLast * 2)
prune_tf_tracker(daily_open, openDailyShowLast * 2)
prune_tf_tracker(weekly_open, openWeeklyShowLast * 2)
prune_tf_tracker(monthly_open, openMonthlyShowLast * 2)

// ═══════════════════════════════════════════════════════════════════════════════
// VISUALIZATION HELPERS
// ═══════════════════════════════════════════════════════════════════════════════

draw_session_backgrounds(pool, showLast, bgColor) =>
    // Draw completed sessions
    if array.size(pool.session_start_times) > 0
        count = math.min(showLast, array.size(pool.session_start_times))
        for i = 0 to count - 1
            idx = array.size(pool.session_start_times) - 1 - i
            start_time = array.get(pool.session_start_times, idx)
            end_time = array.get(pool.session_end_times, idx)
            session_high = array.get(pool.highs, idx)
            session_low = array.get(pool.lows, idx)

            session_box = box.new(start_time, session_high, end_time, session_low, xloc=xloc.bar_time, bgcolor=bgColor, border_color=color.new(bgColor, 100), border_width=LINE_WIDTH_1)
            array.push(all_boxes, session_box)

// Draw live background for active session
draw_live_session_background(pool, sessionString, bgColor) =>
    inSession = not na(time(timeframe.period, sessionString, NY_TIMEZONE))
    if inSession and not na(pool.current_high) and not na(pool.current_low) and not na(pool.current_session_start_time)
        live_box = box.new(pool.current_session_start_time, pool.current_high, time, pool.current_low, xloc=xloc.bar_time, bgcolor=bgColor, border_color=color.new(bgColor, 100), border_width=LINE_WIDTH_1)
        array.push(all_boxes, live_box)

draw_intraday_pool(pool, poolType, showLast, lineColor, lineWidth, enableLiqDepth) =>
    if array.size(pool.highs) > 0
        count = math.min(showLast, array.size(pool.highs))
        for i = 0 to count - 1
            idx = array.size(pool.highs) - 1 - i

            high_val = array.get(pool.highs, idx)
            low_val = array.get(pool.lows, idx)
            high_time = array.get(pool.high_times, idx)
            low_time = array.get(pool.low_times, idx)
            high_index = array.get(pool.high_indices, idx)
            low_index = array.get(pool.low_indices, idx)
            session_end_time = array.get(pool.session_end_times, idx)

            // Get breach status for unmitigated filter
            high_breached = array.get(pool.high_breached, idx)
            low_breached = array.get(pool.low_breached, idx)

            // Skip if unmitigated only mode and both are breached
            if showUnmitigatedOnly and high_breached and low_breached
                continue

            high_end_time = pool_get_high_end_time(pool, idx, time)
            low_end_time = pool_get_low_end_time(pool, idx, time)
            high_end_index = pool_get_high_end_index(pool, idx, bar_index)
            low_end_index = pool_get_low_end_index(pool, idx, bar_index)

            // Draw high line (skip if breached and unmitigated only mode)
            if not (showUnmitigatedOnly and high_breached)
                high_line = create_pool_line(high_time, high_index, high_val, high_end_time, high_end_index, lineColor, lineWidth, line.style_solid)
                array.push(all_lines, high_line)

            // Draw low line (skip if breached and unmitigated only mode)
            if not (showUnmitigatedOnly and low_breached)
                low_line = create_pool_line(low_time, low_index, low_val, low_end_time, low_end_index, lineColor, lineWidth, line.style_solid)
                array.push(all_lines, low_line)

            // Draw intraday liquidity depth lines (percentage-based)
            if enableLiqDepth
                high_breached_liquidity_depth = array.get(pool.high_breached, idx)
                low_breached_liquidity_depth = array.get(pool.low_breached, idx)

                // Only draw liquidity depth if L0 is breached (prerequisite)
                if high_breached_liquidity_depth
                    intraday_high_liquidity_depth = array.get(pool.intraday_high_liquidity_depths, idx)

                    for level_idx = 0 to NUM_INTRADAY_LIQUIDITY_DEPTH_LEVELS - 1
                        percent = get_intraday_percent(level_idx)
                        level_color = get_pool_liq_depth_color(poolType, level_idx, lineColor)
                        level_width = get_pool_liq_depth_width(poolType, level_idx)
                        level_style = get_pool_liq_depth_style(poolType, level_idx)
                        liquidity_depth_high_val = high_val + (high_val * (percent / 100.0))

                        // Get end time: if breached use breach time, otherwise extend to current bar
                        level_breached = array.get(intraday_high_liquidity_depth.breached, level_idx)
                        level_breach_time = array.get(intraday_high_liquidity_depth.breach_times, level_idx)
                        level_end_time = level_breached and not na(level_breach_time) ? level_breach_time : time
                        level_breach_index = array.get(intraday_high_liquidity_depth.breach_indices, level_idx)
                        level_end_index = level_breached and not na(level_breach_index) ? level_breach_index : bar_index

                        high_liquidity_depth_line = create_pool_line(high_time, high_index, liquidity_depth_high_val, level_end_time, level_end_index, level_color, level_width, level_style)
                        array.push(all_lines, high_liquidity_depth_line)

                        buffer_liq_depth_labels(pending_label_events, high_index, level_end_index, liquidity_depth_high_val, level_idx, true, poolType)

                        // Draw vertical connector
                        connector_color = get_pool_liq_depth_preset(poolType) == LIQUIDITY_DEPTH_PRESET_POOL_COLORS ? lineColor : DEFAULT_LIQUIDITY_DEPTH_BLUE
                        array.push(all_lines, create_liq_depth_connector(high_time, high_index, high_val, liquidity_depth_high_val, connector_color))

                if low_breached_liquidity_depth
                    intraday_low_liquidity_depth = array.get(pool.intraday_low_liquidity_depths, idx)

                    for level_idx_low = 0 to NUM_INTRADAY_LIQUIDITY_DEPTH_LEVELS - 1
                        percent_low = get_intraday_percent(level_idx_low)
                        level_color_low = get_pool_liq_depth_color(poolType, level_idx_low, lineColor)
                        level_width_low = get_pool_liq_depth_width(poolType, level_idx_low)
                        level_style_low = get_pool_liq_depth_style(poolType, level_idx_low)
                        liquidity_depth_low_val = low_val - (low_val * (percent_low / 100.0))

                        // Get end time: if breached use breach time, otherwise extend to current bar
                        level_breached_low = array.get(intraday_low_liquidity_depth.breached, level_idx_low)
                        level_breach_time_low = array.get(intraday_low_liquidity_depth.breach_times, level_idx_low)
                        level_end_time_low = level_breached_low and not na(level_breach_time_low) ? level_breach_time_low : time
                        level_breach_index_low = array.get(intraday_low_liquidity_depth.breach_indices, level_idx_low)
                        level_end_index_low = level_breached_low and not na(level_breach_index_low) ? level_breach_index_low : bar_index

                        low_liquidity_depth_line = create_pool_line(low_time, low_index, liquidity_depth_low_val, level_end_time_low, level_end_index_low, level_color_low, level_width_low, level_style_low)
                        array.push(all_lines, low_liquidity_depth_line)

                        buffer_liq_depth_labels(pending_label_events, low_index, level_end_index_low, liquidity_depth_low_val, level_idx_low, false, poolType)

                        // Draw vertical connector
                        connector_color_low = get_pool_liq_depth_preset(poolType) == LIQUIDITY_DEPTH_PRESET_POOL_COLORS ? lineColor : DEFAULT_LIQUIDITY_DEPTH_BLUE
                        array.push(all_lines, create_liq_depth_connector(low_time, low_index, low_val, liquidity_depth_low_val, connector_color_low))

            if showLabels
                label_text = build_label(poolType)

                if not (showUnmitigatedOnly and high_breached)
                    buffer_pool_label(pending_label_events, high_val, high_index, high_end_index, label_text, true, high_breached, poolType)

                if not (showUnmitigatedOnly and low_breached)
                    buffer_pool_label(pending_label_events, low_val, low_index, low_end_index, label_text, false, low_breached, poolType)

// ═══════════════════════════════════════════════════════════════════════════════
// VISUALIZATION
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.islast
    // Clear previous visuals
    for line_obj in all_lines
        line.delete(line_obj)
    array.clear(all_lines)

    for label_obj in all_labels
        label.delete(label_obj)
    array.clear(all_labels)
    array.clear(pending_label_events)

    for box_obj in all_boxes
        box.delete(box_obj)
    array.clear(all_boxes)

    // Draw Daily
    if showDailyFiltered and timeframe.in_seconds() >= HTF_MIN_TIMEFRAME
        count = math.min(effectiveDailyShowLast, array.size(daily_pool.highs))
        if count > 0
            for i = 0 to count - 1
                idx = array.size(daily_pool.highs) - 1 - i

                high_val = array.get(daily_pool.highs, idx)
                low_val = array.get(daily_pool.lows, idx)
                high_time = array.get(daily_pool.high_times, idx)
                low_time = array.get(daily_pool.low_times, idx)
                high_index = array.get(daily_pool.high_indices, idx)
                low_index = array.get(daily_pool.low_indices, idx)

                // Get breach status for unmitigated filter
                high_breached = array.get(daily_pool.high_breached, idx)
                low_breached = array.get(daily_pool.low_breached, idx)

                // Skip if unmitigated only mode and both are breached
                if showUnmitigatedOnly and high_breached and low_breached
                    continue

                // Get conditional end times
                high_end_time = pool_get_high_end_time(daily_pool, idx, time)
                low_end_time = pool_get_low_end_time(daily_pool, idx, time)
                high_end_index = pool_get_high_end_index(daily_pool, idx, bar_index)
                low_end_index = pool_get_low_end_index(daily_pool, idx, bar_index)

                // Draw regular levels with their native geometry and styling
                if not (showUnmitigatedOnly and high_breached)
                    array.push(all_lines, create_pool_line(high_time, high_index, high_val, high_end_time, high_end_index, dailyColor, dailyLineWidth, line.style_solid))

                if not (showUnmitigatedOnly and low_breached)
                    array.push(all_lines, create_pool_line(low_time, low_index, low_val, low_end_time, low_end_index, dailyColor, dailyLineWidth, line.style_solid))

                // Draw liquidity depth lines (HTF only: Daily)
                if effectiveEnableDailyLiquidityDepth and isAssetSupported and effectiveIsDailyLiquidityDepthTimeframeValid and dailyLiquidityDepthDistance > 0
                    high_breached_liquidity_depth = array.get(daily_pool.high_breached, idx)
                    low_breached_liquidity_depth = array.get(daily_pool.low_breached, idx)

                    // Only draw liquidity depth if L0 is breached (prerequisite)
                    if high_breached_liquidity_depth
                        high_liquidity_depth = array.get(daily_pool.high_liquidity_depths, idx)
                        for level_idx = 0 to NUM_LIQUIDITY_DEPTH_LEVELS - 1
                            multiplier = level_idx + 1
                            liquidity_depth_high_val = high_val + (multiplier * dailyLiquidityDepthDistance)
                            lvl_color = get_pool_liq_depth_color(POOL_TYPE_DAILY, level_idx, dailyColor)
                            lvl_width = get_pool_liq_depth_width(POOL_TYPE_DAILY, level_idx)
                            lvl_style = get_pool_liq_depth_style(POOL_TYPE_DAILY, level_idx)

                            // Get end time for this level
                            level_breached = array.get(high_liquidity_depth.breached, level_idx)
                            level_breach_time = array.get(high_liquidity_depth.breach_times, level_idx)
                            level_end_time = level_breached and not na(level_breach_time) ? level_breach_time : time
                            level_breach_index = array.get(high_liquidity_depth.breach_indices, level_idx)
                            level_end_index = level_breached and not na(level_breach_index) ? level_breach_index : bar_index

                            array.push(all_lines, create_pool_line(high_time, high_index, liquidity_depth_high_val, level_end_time, level_end_index, lvl_color, lvl_width, lvl_style))
                            if showLabels
                                buffer_liq_depth_labels(pending_label_events, high_index, level_end_index, liquidity_depth_high_val, level_idx, true, POOL_TYPE_DAILY)

                            // Draw vertical connector
                            daily_connector_color = get_pool_liq_depth_preset(POOL_TYPE_DAILY) == LIQUIDITY_DEPTH_PRESET_POOL_COLORS ? dailyColor : DEFAULT_LIQUIDITY_DEPTH_BLUE
                            array.push(all_lines, create_liq_depth_connector(high_time, high_index, high_val, liquidity_depth_high_val, daily_connector_color))

                    if low_breached_liquidity_depth
                        low_liquidity_depth = array.get(daily_pool.low_liquidity_depths, idx)
                        for level_idx = 0 to NUM_LIQUIDITY_DEPTH_LEVELS - 1
                            multiplier = level_idx + 1
                            liquidity_depth_low_val = low_val - (multiplier * dailyLiquidityDepthDistance)
                            lvl_color_low = get_pool_liq_depth_color(POOL_TYPE_DAILY, level_idx, dailyColor)
                            lvl_width_low = get_pool_liq_depth_width(POOL_TYPE_DAILY, level_idx)
                            lvl_style_low = get_pool_liq_depth_style(POOL_TYPE_DAILY, level_idx)

                            // Get end time for this level
                            level_breached_low = array.get(low_liquidity_depth.breached, level_idx)
                            level_breach_time_low = array.get(low_liquidity_depth.breach_times, level_idx)
                            level_end_time_low = level_breached_low and not na(level_breach_time_low) ? level_breach_time_low : time
                            level_breach_index_low = array.get(low_liquidity_depth.breach_indices, level_idx)
                            level_end_index_low = level_breached_low and not na(level_breach_index_low) ? level_breach_index_low : bar_index

                            array.push(all_lines, create_pool_line(low_time, low_index, liquidity_depth_low_val, level_end_time_low, level_end_index_low, lvl_color_low, lvl_width_low, lvl_style_low))
                            if showLabels
                                buffer_liq_depth_labels(pending_label_events, low_index, level_end_index_low, liquidity_depth_low_val, level_idx, false, POOL_TYPE_DAILY)

                            // Draw vertical connector
                            daily_connector_color_low = get_pool_liq_depth_preset(POOL_TYPE_DAILY) == LIQUIDITY_DEPTH_PRESET_POOL_COLORS ? dailyColor : DEFAULT_LIQUIDITY_DEPTH_BLUE
                            array.push(all_lines, create_liq_depth_connector(low_time, low_index, low_val, liquidity_depth_low_val, daily_connector_color_low))

                if showLabels
                    label_text = build_label(POOL_TYPE_DAILY)
                    if not (showUnmitigatedOnly and high_breached)
                        buffer_pool_label(pending_label_events, high_val, high_index, high_end_index, label_text, true, high_breached, POOL_TYPE_DAILY)
                    if not (showUnmitigatedOnly and low_breached)
                        buffer_pool_label(pending_label_events, low_val, low_index, low_end_index, label_text, false, low_breached, POOL_TYPE_DAILY)

    // Draw Weekly
    if showWeeklyFiltered and timeframe.in_seconds() >= HTF_MIN_TIMEFRAME
        count = math.min(effectiveWeeklyShowLast, array.size(weekly_pool.highs))
        if count > 0
            for i = 0 to count - 1
                idx = array.size(weekly_pool.highs) - 1 - i

                high_val = array.get(weekly_pool.highs, idx)
                low_val = array.get(weekly_pool.lows, idx)
                high_time = array.get(weekly_pool.high_times, idx)
                low_time = array.get(weekly_pool.low_times, idx)
                high_index = array.get(weekly_pool.high_indices, idx)
                low_index = array.get(weekly_pool.low_indices, idx)

                // Get breach status for unmitigated filter
                high_breached = array.get(weekly_pool.high_breached, idx)
                low_breached = array.get(weekly_pool.low_breached, idx)

                // Skip if unmitigated only mode and both are breached
                if showUnmitigatedOnly and high_breached and low_breached
                    continue

                // Get conditional end times
                high_end_time = pool_get_high_end_time(weekly_pool, idx, time)
                low_end_time = pool_get_low_end_time(weekly_pool, idx, time)
                high_end_index = pool_get_high_end_index(weekly_pool, idx, bar_index)
                low_end_index = pool_get_low_end_index(weekly_pool, idx, bar_index)

                // Draw regular levels with their native geometry and styling
                if not (showUnmitigatedOnly and high_breached)
                    array.push(all_lines, create_pool_line(high_time, high_index, high_val, high_end_time, high_end_index, weeklyColor, weeklyLineWidth, line.style_solid))

                if not (showUnmitigatedOnly and low_breached)
                    array.push(all_lines, create_pool_line(low_time, low_index, low_val, low_end_time, low_end_index, weeklyColor, weeklyLineWidth, line.style_solid))

                // Draw liquidity depth lines (HTF only: Weekly)
                if effectiveEnableWeeklyLiquidityDepth and isAssetSupported and effectiveIsWeeklyLiquidityDepthTimeframeValid and weeklyLiquidityDepthDistance > 0
                    high_breached_liquidity_depth = array.get(weekly_pool.high_breached, idx)
                    low_breached_liquidity_depth = array.get(weekly_pool.low_breached, idx)

                    if high_breached_liquidity_depth
                        high_liquidity_depth = array.get(weekly_pool.high_liquidity_depths, idx)
                        for level_idx = 0 to NUM_LIQUIDITY_DEPTH_LEVELS - 1
                            multiplier = level_idx + 1
                            liquidity_depth_high_val = high_val + (multiplier * weeklyLiquidityDepthDistance)
                            lvl_color = get_pool_liq_depth_color(POOL_TYPE_WEEKLY, level_idx, weeklyColor)
                            lvl_width = get_pool_liq_depth_width(POOL_TYPE_WEEKLY, level_idx)
                            lvl_style = get_pool_liq_depth_style(POOL_TYPE_WEEKLY, level_idx)
                            level_breached = array.get(high_liquidity_depth.breached, level_idx)
                            level_breach_time = array.get(high_liquidity_depth.breach_times, level_idx)
                            level_end_time = level_breached and not na(level_breach_time) ? level_breach_time : time
                            level_breach_index = array.get(high_liquidity_depth.breach_indices, level_idx)
                            level_end_index = level_breached and not na(level_breach_index) ? level_breach_index : bar_index
                            array.push(all_lines, create_pool_line(high_time, high_index, liquidity_depth_high_val, level_end_time, level_end_index, lvl_color, lvl_width, lvl_style))
                            if showLabels
                                buffer_liq_depth_labels(pending_label_events, high_index, level_end_index, liquidity_depth_high_val, level_idx, true, POOL_TYPE_WEEKLY)
                            // Draw vertical connector
                            weekly_connector_color = get_pool_liq_depth_preset(POOL_TYPE_WEEKLY) == LIQUIDITY_DEPTH_PRESET_POOL_COLORS ? weeklyColor : DEFAULT_LIQUIDITY_DEPTH_BLUE
                            array.push(all_lines, create_liq_depth_connector(high_time, high_index, high_val, liquidity_depth_high_val, weekly_connector_color))

                    if low_breached_liquidity_depth
                        low_liquidity_depth = array.get(weekly_pool.low_liquidity_depths, idx)
                        for level_idx = 0 to NUM_LIQUIDITY_DEPTH_LEVELS - 1
                            multiplier = level_idx + 1
                            liquidity_depth_low_val = low_val - (multiplier * weeklyLiquidityDepthDistance)
                            lvl_color_low = get_pool_liq_depth_color(POOL_TYPE_WEEKLY, level_idx, weeklyColor)
                            lvl_width_low = get_pool_liq_depth_width(POOL_TYPE_WEEKLY, level_idx)
                            lvl_style_low = get_pool_liq_depth_style(POOL_TYPE_WEEKLY, level_idx)
                            level_breached_low = array.get(low_liquidity_depth.breached, level_idx)
                            level_breach_time_low = array.get(low_liquidity_depth.breach_times, level_idx)
                            level_end_time_low = level_breached_low and not na(level_breach_time_low) ? level_breach_time_low : time
                            level_breach_index_low = array.get(low_liquidity_depth.breach_indices, level_idx)
                            level_end_index_low = level_breached_low and not na(level_breach_index_low) ? level_breach_index_low : bar_index
                            array.push(all_lines, create_pool_line(low_time, low_index, liquidity_depth_low_val, level_end_time_low, level_end_index_low, lvl_color_low, lvl_width_low, lvl_style_low))
                            if showLabels
                                buffer_liq_depth_labels(pending_label_events, low_index, level_end_index_low, liquidity_depth_low_val, level_idx, false, POOL_TYPE_WEEKLY)
                            // Draw vertical connector
                            weekly_connector_color_low = get_pool_liq_depth_preset(POOL_TYPE_WEEKLY) == LIQUIDITY_DEPTH_PRESET_POOL_COLORS ? weeklyColor : DEFAULT_LIQUIDITY_DEPTH_BLUE
                            array.push(all_lines, create_liq_depth_connector(low_time, low_index, low_val, liquidity_depth_low_val, weekly_connector_color_low))

                if showLabels
                    label_text = build_label(POOL_TYPE_WEEKLY)
                    if not (showUnmitigatedOnly and high_breached)
                        buffer_pool_label(pending_label_events, high_val, high_index, high_end_index, label_text, true, high_breached, POOL_TYPE_WEEKLY)
                    if not (showUnmitigatedOnly and low_breached)
                        buffer_pool_label(pending_label_events, low_val, low_index, low_end_index, label_text, false, low_breached, POOL_TYPE_WEEKLY)

    // Draw Monthly
    if showMonthlyFiltered and timeframe.in_seconds() >= HTF_MIN_TIMEFRAME
        count = math.min(effectiveMonthlyShowLast, array.size(monthly_pool.highs))
        if count > 0
            for i = 0 to count - 1
                idx = array.size(monthly_pool.highs) - 1 - i

                high_val = array.get(monthly_pool.highs, idx)
                low_val = array.get(monthly_pool.lows, idx)
                high_time = array.get(monthly_pool.high_times, idx)
                low_time = array.get(monthly_pool.low_times, idx)
                high_index = array.get(monthly_pool.high_indices, idx)
                low_index = array.get(monthly_pool.low_indices, idx)

                // Get breach status for unmitigated filter
                high_breached = array.get(monthly_pool.high_breached, idx)
                low_breached = array.get(monthly_pool.low_breached, idx)

                // Skip if unmitigated only mode and both are breached
                if showUnmitigatedOnly and high_breached and low_breached
                    continue

                // Get conditional end times
                high_end_time = pool_get_high_end_time(monthly_pool, idx, time)
                low_end_time = pool_get_low_end_time(monthly_pool, idx, time)
                high_end_index = pool_get_high_end_index(monthly_pool, idx, bar_index)
                low_end_index = pool_get_low_end_index(monthly_pool, idx, bar_index)

                // Draw regular levels with their native geometry and styling
                if not (showUnmitigatedOnly and high_breached)
                    array.push(all_lines, create_pool_line(high_time, high_index, high_val, high_end_time, high_end_index, monthlyColor, monthlyLineWidth, line.style_solid))

                if not (showUnmitigatedOnly and low_breached)
                    array.push(all_lines, create_pool_line(low_time, low_index, low_val, low_end_time, low_end_index, monthlyColor, monthlyLineWidth, line.style_solid))

                // Draw liquidity depth lines (HTF only: Monthly)
                if effectiveEnableMonthlyLiquidityDepth and isAssetSupported and effectiveIsMonthlyLiquidityDepthTimeframeValid and monthlyLiquidityDepthDistance > 0
                    high_breached_liquidity_depth = array.get(monthly_pool.high_breached, idx)
                    low_breached_liquidity_depth = array.get(monthly_pool.low_breached, idx)

                    if high_breached_liquidity_depth
                        high_liquidity_depth = array.get(monthly_pool.high_liquidity_depths, idx)
                        for level_idx = 0 to NUM_LIQUIDITY_DEPTH_LEVELS - 1
                            multiplier = level_idx + 1
                            liquidity_depth_high_val = high_val + (multiplier * monthlyLiquidityDepthDistance)
                            lvl_color = get_pool_liq_depth_color(POOL_TYPE_MONTHLY, level_idx, monthlyColor)
                            lvl_width = get_pool_liq_depth_width(POOL_TYPE_MONTHLY, level_idx)
                            lvl_style = get_pool_liq_depth_style(POOL_TYPE_MONTHLY, level_idx)
                            level_breached = array.get(high_liquidity_depth.breached, level_idx)
                            level_breach_time = array.get(high_liquidity_depth.breach_times, level_idx)
                            level_end_time = level_breached and not na(level_breach_time) ? level_breach_time : time
                            level_breach_index = array.get(high_liquidity_depth.breach_indices, level_idx)
                            level_end_index = level_breached and not na(level_breach_index) ? level_breach_index : bar_index
                            array.push(all_lines, create_pool_line(high_time, high_index, liquidity_depth_high_val, level_end_time, level_end_index, lvl_color, lvl_width, lvl_style))
                            if showLabels
                                buffer_liq_depth_labels(pending_label_events, high_index, level_end_index, liquidity_depth_high_val, level_idx, true, POOL_TYPE_MONTHLY)
                            // Draw vertical connector
                            monthly_connector_color = get_pool_liq_depth_preset(POOL_TYPE_MONTHLY) == LIQUIDITY_DEPTH_PRESET_POOL_COLORS ? monthlyColor : DEFAULT_LIQUIDITY_DEPTH_BLUE
                            array.push(all_lines, create_liq_depth_connector(high_time, high_index, high_val, liquidity_depth_high_val, monthly_connector_color))

                    if low_breached_liquidity_depth
                        low_liquidity_depth = array.get(monthly_pool.low_liquidity_depths, idx)
                        for level_idx = 0 to NUM_LIQUIDITY_DEPTH_LEVELS - 1
                            multiplier = level_idx + 1
                            liquidity_depth_low_val = low_val - (multiplier * monthlyLiquidityDepthDistance)
                            lvl_color_low = get_pool_liq_depth_color(POOL_TYPE_MONTHLY, level_idx, monthlyColor)
                            lvl_width_low = get_pool_liq_depth_width(POOL_TYPE_MONTHLY, level_idx)
                            lvl_style_low = get_pool_liq_depth_style(POOL_TYPE_MONTHLY, level_idx)
                            level_breached_low = array.get(low_liquidity_depth.breached, level_idx)
                            level_breach_time_low = array.get(low_liquidity_depth.breach_times, level_idx)
                            level_end_time_low = level_breached_low and not na(level_breach_time_low) ? level_breach_time_low : time
                            level_breach_index_low = array.get(low_liquidity_depth.breach_indices, level_idx)
                            level_end_index_low = level_breached_low and not na(level_breach_index_low) ? level_breach_index_low : bar_index
                            array.push(all_lines, create_pool_line(low_time, low_index, liquidity_depth_low_val, level_end_time_low, level_end_index_low, lvl_color_low, lvl_width_low, lvl_style_low))
                            if showLabels
                                buffer_liq_depth_labels(pending_label_events, low_index, level_end_index_low, liquidity_depth_low_val, level_idx, false, POOL_TYPE_MONTHLY)
                            // Draw vertical connector
                            monthly_connector_color_low = get_pool_liq_depth_preset(POOL_TYPE_MONTHLY) == LIQUIDITY_DEPTH_PRESET_POOL_COLORS ? monthlyColor : DEFAULT_LIQUIDITY_DEPTH_BLUE
                            array.push(all_lines, create_liq_depth_connector(low_time, low_index, low_val, liquidity_depth_low_val, monthly_connector_color_low))

                if showLabels
                    label_text = build_label(POOL_TYPE_MONTHLY)
                    if not (showUnmitigatedOnly and high_breached)
                        buffer_pool_label(pending_label_events, high_val, high_index, high_end_index, label_text, true, high_breached, POOL_TYPE_MONTHLY)
                    if not (showUnmitigatedOnly and low_breached)
                        buffer_pool_label(pending_label_events, low_val, low_index, low_end_index, label_text, false, low_breached, POOL_TYPE_MONTHLY)

    // Draw Intraday Session Backgrounds (Completed + Live Sessions)
    if showIntradayBackground and timeframe.in_seconds() <= INTRADAY_SESSION_MAX_TIMEFRAME
        if applyPulseModeFilter(POOL_TYPE_ASIA, true) or showIntradayInTodayMode
            draw_session_backgrounds(asia_pool, effectiveIntradayShowLast, intradayBackgroundColor)
            draw_live_session_background(asia_pool, actualAsiaSession, intradayBackgroundColor)

        if applyPulseModeFilter(POOL_TYPE_LONDON, true) or showIntradayInTodayMode
            draw_session_backgrounds(london_pool, effectiveIntradayShowLast, intradayBackgroundColor)
            draw_live_session_background(london_pool, actualLondonSession, intradayBackgroundColor)

        if applyPulseModeFilter(POOL_TYPE_NYAM, true) or showIntradayInTodayMode
            draw_session_backgrounds(nyam_pool, effectiveIntradayShowLast, intradayBackgroundColor)
            draw_live_session_background(nyam_pool, actualNyamSession, intradayBackgroundColor)

        if applyPulseModeFilter(POOL_TYPE_LUNCH, true) or showIntradayInTodayMode
            draw_session_backgrounds(lunch_pool, effectiveIntradayShowLast, intradayBackgroundColor)
            draw_live_session_background(lunch_pool, actualLunchSession, intradayBackgroundColor)

        if applyPulseModeFilter(POOL_TYPE_NYPM, true) or showIntradayInTodayMode
            draw_session_backgrounds(nypm_pool, effectiveIntradayShowLast, intradayBackgroundColor)
            draw_live_session_background(nypm_pool, actualNypmSession, intradayBackgroundColor)

    // Draw Session Boxes (Killzones) — high-to-low box per session, one toggle or Just Sessions mode
    if sessionBoxesActive and timeframe.in_seconds() <= INTRADAY_SESSION_MAX_TIMEFRAME
        draw_session_backgrounds(asia_pool, sessionBoxShowLast, sessionBoxAsiaColor)
        draw_live_session_background(asia_pool, actualAsiaSession, sessionBoxAsiaColor)
        draw_session_backgrounds(london_pool, sessionBoxShowLast, sessionBoxLondonColor)
        draw_live_session_background(london_pool, actualLondonSession, sessionBoxLondonColor)
        draw_session_backgrounds(nyam_pool, sessionBoxShowLast, sessionBoxNyamColor)
        draw_live_session_background(nyam_pool, actualNyamSession, sessionBoxNyamColor)
        draw_session_backgrounds(nypm_pool, sessionBoxShowLast, sessionBoxNypmColor)
        draw_live_session_background(nypm_pool, actualNypmSession, sessionBoxNypmColor)
        draw_session_backgrounds(premarket_pool, sessionBoxShowLast, sessionBoxPremarketColor)
        draw_live_session_background(premarket_pool, actualPremarketSession, sessionBoxPremarketColor)

    // Draw PoiSzn Session Backgrounds (Completed + Live Sessions)
    if timeframe.in_seconds() <= INTRADAY_SESSION_MAX_TIMEFRAME
        if showPremarketBackground and applyPulseModeFilter(POOL_TYPE_PREMARKET, true)
            draw_session_backgrounds(premarket_pool, effectivePoisznShowLast, premarketBackgroundColor)
            draw_live_session_background(premarket_pool, actualPremarketSession, premarketBackgroundColor)

        if showOvernightBackground and applyPulseModeFilter(POOL_TYPE_OVERNIGHT, true)
            draw_session_backgrounds(overnight_pool, effectivePoisznShowLast, overnightBackgroundColor)
            draw_live_session_background(overnight_pool, actualOvernightSession, overnightBackgroundColor)

    // Draw completed Intraday Sessions.
    // A live (in-progress) session has no final high/low yet, so it is never drawn as a
    // breakable level — it appears only once the session closes and is stored.
    if timeframe.in_seconds() <= INTRADAY_SESSION_MAX_TIMEFRAME
        if showAsiaFiltered
            draw_intraday_pool(asia_pool, POOL_TYPE_ASIA, effectiveIntradayShowLast, intradayColor, intradayLineWidth, effectiveEnableIntradayLiquidityDepth)

        if showLondonFiltered
            draw_intraday_pool(london_pool, POOL_TYPE_LONDON, effectiveIntradayShowLast, intradayColor, intradayLineWidth, effectiveEnableIntradayLiquidityDepth)

        if showNyamFiltered
            draw_intraday_pool(nyam_pool, POOL_TYPE_NYAM, effectiveIntradayShowLast, intradayColor, intradayLineWidth, effectiveEnableIntradayLiquidityDepth)

        if showLunchFiltered
            draw_intraday_pool(lunch_pool, POOL_TYPE_LUNCH, effectiveIntradayShowLast, intradayColor, intradayLineWidth, effectiveEnableIntradayLiquidityDepth)

        if showNypmFiltered
            draw_intraday_pool(nypm_pool, POOL_TYPE_NYPM, effectiveIntradayShowLast, intradayColor, intradayLineWidth, effectiveEnableIntradayLiquidityDepth)

        // Draw PoiSzn Sessions (completed sessions only)
        if showPremarketFiltered
            draw_intraday_pool(premarket_pool, POOL_TYPE_PREMARKET, effectivePoisznShowLast, premarketColor, poisznLineWidth, effectiveEnablePremarketLiquidityDepth)

        if showOvernightFiltered
            draw_intraday_pool(overnight_pool, POOL_TYPE_OVERNIGHT, effectivePoisznShowLast, overnightColor, poisznLineWidth, effectiveEnableOvernightLiquidityDepth)

    flush_label_events(pending_label_events, all_labels)

    // Draw Range Boxes
    if showRangeBoxFiltered and timeframe.in_seconds() >= RANGE_BOX_MIN_TIMEFRAME and timeframe.in_seconds() <= RANGE_BOX_MAX_TIMEFRAME and array.size(range_box.highs) > 0
        count = math.min(effectiveRangeBoxShowLast, array.size(range_box.highs))
        for i = 0 to count - 1
            idx = array.size(range_box.highs) - 1 - i

            high_val = array.get(range_box.highs, idx)
            low_val = array.get(range_box.lows, idx)
            start_time = array.get(range_box.start_times, idx)
            end_time = array.get(range_box.end_times, idx)

            // Determine liquidity depth end time: next range's start OR current time if most recent
            extend_end_time = i > 0 ? array.get(range_box.start_times, idx + 1) : time

            // Draw high line (extended to next range start)
            high_line = line.new(start_time, high_val, extend_end_time, high_val, xloc=xloc.bar_time, color=rangeBoxColor, width=rangeBoxWidth, style=line.style_solid)
            array.push(all_lines, high_line)

            // Draw low line (extended to next range start)
            low_line = line.new(start_time, low_val, extend_end_time, low_val, xloc=xloc.bar_time, color=rangeBoxColor, width=rangeBoxWidth, style=line.style_solid)
            array.push(all_lines, low_line)

            // Draw vertical lines only at actual range boundaries (2:00-2:15)
            left_line = line.new(start_time, high_val, start_time, low_val, xloc=xloc.bar_time, color=rangeBoxColor, width=rangeBoxWidth, style=line.style_solid)
            array.push(all_lines, left_line)

            right_line = line.new(end_time, high_val, end_time, low_val, xloc=xloc.bar_time, color=rangeBoxColor, width=rangeBoxWidth, style=line.style_solid)
            array.push(all_lines, right_line)

            // Draw middle line if enabled (extended to next range start)
            if showRangeMiddleLine
                middle_price = (high_val + low_val) / 2
                middle_line = line.new(start_time, middle_price, extend_end_time, middle_price, xloc=xloc.bar_time, color=rangeMiddleColor, width=rangeBoxWidth, style=line.style_dotted)
                array.push(all_lines, middle_line)

    // Intraday Closes (14:00/16:00)
    if show1600CloseFiltered and timeframe.in_seconds() >= INTRADAY_CLOSING_PRICE_MIN_TIMEFRAME and timeframe.in_seconds() <= INTRADAY_CLOSING_PRICE_MAX_TIMEFRAME
        draw_intraday_closes(sixteen_hundred_close, effectiveClose1600ShowLast, MAX_UNMITIGATED_UNLIMITED, false, close1600Color, close1600LineWidth, close1600UntappedWidth, 16, showLabels, labelTextColor, all_lines, all_labels)
    if show1400CloseFiltered and timeframe.in_seconds() >= INTRADAY_CLOSING_PRICE_MIN_TIMEFRAME and timeframe.in_seconds() <= INTRADAY_CLOSING_PRICE_MAX_TIMEFRAME
        draw_intraday_closes(fourteen_hundred_close, close1400ShowLast, MAX_UNMITIGATED_UNLIMITED, false, close1400Color, close1400LineWidth, close1400UntappedWidth, 14, showLabels, labelTextColor, all_lines, all_labels)

    // Timeframe Opens
    if show4HOpenFiltered and timeframe.in_seconds() >= 60 and timeframe.in_seconds() <= 14400
        filter4HHour = pulseModeFilter == FILTER_10AM_4H_OPEN ? 10 : na
        draw_timeframe_opens(four_hour_open, open4HShowLast, open4HColor, open4HLineWidth, "4H", true, showLabels, labelTextColor, all_lines, all_labels, na, filter4HHour)
    if show1HOpenFiltered and timeframe.in_seconds() >= 60 and timeframe.in_seconds() <= 3600
        draw_timeframe_opens(one_hour_open, open1HShowLast, open1HColor, open1HLineWidth, "1H", true, showLabels, labelTextColor, all_lines, all_labels)
    if showMnoOpenFiltered and timeframe.in_seconds() >= 60 and timeframe.in_seconds() <= 3600
        draw_timeframe_opens(midnight_open, effectiveOpenMnoShowLast, openMnoColor, openMnoLineWidth, "MNO", false, showLabels, labelTextColor, all_lines, all_labels, MARKET_CLOSE_HOUR)
    if show830OpenFiltered and timeframe.in_seconds() >= 60 and timeframe.in_seconds() <= 3600
        draw_timeframe_opens(eight_thirty_open, effectiveOpen830ShowLast, open830Color, open830LineWidth, "8:30", false, showLabels, labelTextColor, all_lines, all_labels, MARKET_CLOSE_HOUR)
    if show930OpenFiltered and timeframe.in_seconds() >= 60 and timeframe.in_seconds() <= 3600
        draw_timeframe_opens(nine_thirty_open, effectiveOpen930ShowLast, open930Color, open930LineWidth, "9:30", false, showLabels, labelTextColor, all_lines, all_labels, MARKET_CLOSE_HOUR)
    if showDailyOpenFiltered and timeframe.in_seconds() >= 60 and timeframe.in_seconds() < 86400
        draw_timeframe_opens(daily_open, openDailyShowLast, openDailyColor, openDailyLineWidth, "D", false, showLabels, labelTextColor, all_lines, all_labels)
    if showWeeklyOpenFiltered and timeframe.in_seconds() >= 60 and timeframe.in_seconds() < 604800
        draw_timeframe_opens(weekly_open, openWeeklyShowLast, openWeeklyColor, openWeeklyLineWidth, "W", false, showLabels, labelTextColor, all_lines, all_labels)
    if showMonthlyOpenFiltered and timeframe.in_seconds() >= 60 and timeframe.in_seconds() < 2592000
        draw_timeframe_opens(monthly_open, openMonthlyShowLast, openMonthlyColor, openMonthlyLineWidth, "M", false, showLabels, labelTextColor, all_lines, all_labels)

    // Draw Asset Levels Table (optimized: only update when values change)
    var string prev_asset_table = ""
    var string prev_tf_table = ""
    var float prev_daily_dist = 0.0
    var float prev_intraday_pct1 = 0.0
    var bool prev_use_auto = true

    if showAssetLevelsTable and (detectedAsset != prev_asset_table or timeframe.period != prev_tf_table or dailyLiquidityDepthDistance != prev_daily_dist or intradayLiquidityDepthPercent1 != prev_intraday_pct1 or useAutoPercentages != prev_use_auto)
        prev_asset_table := detectedAsset
        prev_tf_table := timeframe.period
        prev_daily_dist := dailyLiquidityDepthDistance
        prev_intraday_pct1 := intradayLiquidityDepthPercent1
        prev_use_auto := useAutoPercentages

        // Calculate dynamic row count (no label rows)
        rowCount = 2  // Asset + TF
        rowCount := rowCount + (effectiveIsDailyLiquidityDepthTimeframeValid ? 1 : 0)
        rowCount := rowCount + (effectiveIsWeeklyLiquidityDepthTimeframeValid ? 1 : 0)
        rowCount := rowCount + (effectiveIsMonthlyLiquidityDepthTimeframeValid ? 1 : 0)
        rowCount := rowCount + 1  // Intraday (always shown)

        // Clear and recreate table
        table.clear(asset_levels_table, 0, 0, 2, rowCount - 1)

        currentRow = 0

        // Asset
        table.cell(asset_levels_table, 0, currentRow, "Asset", text_color=color.white, bgcolor=color.new(color.gray, 10), text_size=size.tiny)
        table.cell(asset_levels_table, 1, currentRow, detectedAsset, text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.tiny)
        currentRow := currentRow + 1

        // Timeframe
        table.cell(asset_levels_table, 0, currentRow, "TF", text_color=color.white, bgcolor=color.new(color.gray, 10), text_size=size.tiny)
        table.cell(asset_levels_table, 1, currentRow, timeframe.period, text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.tiny)
        currentRow := currentRow + 1

        // HTF Liquidity Depth (only if valid)
        if effectiveIsDailyLiquidityDepthTimeframeValid
            dailyLevels = str.tostring(dailyLiquidityDepthDistance) + " | " + str.tostring(dailyLiquidityDepthDistance * 2) + " | " + str.tostring(dailyLiquidityDepthDistance * 3)
            table.cell(asset_levels_table, 0, currentRow, "Daily", text_color=color.white, bgcolor=color.new(color.gray, 10), text_size=size.tiny)
            table.cell(asset_levels_table, 1, currentRow, dailyLevels, text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.tiny)
            currentRow := currentRow + 1

        if effectiveIsWeeklyLiquidityDepthTimeframeValid
            weeklyLevels = str.tostring(weeklyLiquidityDepthDistance) + " | " + str.tostring(weeklyLiquidityDepthDistance * 2) + " | " + str.tostring(weeklyLiquidityDepthDistance * 3)
            table.cell(asset_levels_table, 0, currentRow, "Weekly", text_color=color.white, bgcolor=color.new(color.gray, 10), text_size=size.tiny)
            table.cell(asset_levels_table, 1, currentRow, weeklyLevels, text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.tiny)
            currentRow := currentRow + 1

        if effectiveIsMonthlyLiquidityDepthTimeframeValid
            monthlyLevels = str.tostring(monthlyLiquidityDepthDistance) + " | " + str.tostring(monthlyLiquidityDepthDistance * 2) + " | " + str.tostring(monthlyLiquidityDepthDistance * 3)
            table.cell(asset_levels_table, 0, currentRow, "Monthly", text_color=color.white, bgcolor=color.new(color.gray, 10), text_size=size.tiny)
            table.cell(asset_levels_table, 1, currentRow, monthlyLevels, text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.tiny)
            currentRow := currentRow + 1

        // Intraday Liquidity Depth (percentage-based with source indicator)
        sourceIndicator = useAutoPercentages ? " (Auto)" : " (Manual)"
        intradayLevels = str.tostring(intradayLiquidityDepthPercent1, "#.##") + "% | " + str.tostring(intradayLiquidityDepthPercent2, "#.##") + "% | " + str.tostring(intradayLiquidityDepthPercent3, "#.##") + "%" + sourceIndicator
        table.cell(asset_levels_table, 0, currentRow, "Intraday", text_color=color.white, bgcolor=color.new(color.gray, 10), text_size=size.tiny)
        table.cell(asset_levels_table, 1, currentRow, intradayLevels, text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.tiny)

showOnlyTimeframeAllowed = chart.is_range or timeframe.in_seconds(timeframe.period) <= SHOW_ONLY_MAX_TIMEFRAME_SECONDS
activeShowOnlySession = visibleWindow == WINDOW_LABEL_FROM_0500 ? SESSION_WINDOW_FROM_0500 : visibleWindow == WINDOW_LABEL_FROM_0830 ? SESSION_WINDOW_FROM_0830 : visibleWindow == WINDOW_LABEL_RTH ? SESSION_WINDOW_RTH : SESSION_WINDOW_OVERNIGHT
showOnlyInVisibleWindow = not na(time(timeframe.period, activeShowOnlySession, NY_TIMEZONE))
bool showOnlyInMostRecentDay = true
if showOnlyMostRecent
    showOnlyInMostRecentDay := year(time, NY_TIMEZONE) == year(timenow, NY_TIMEZONE) and month(time, NY_TIMEZONE) == month(timenow, NY_TIMEZONE) and dayofmonth(time, NY_TIMEZONE) == dayofmonth(timenow, NY_TIMEZONE)
hideThisBar = showOnlyEnabled and showOnlyTimeframeAllowed and not (showOnlyInVisibleWindow and (not showOnlyMostRecent or showOnlyInMostRecentDay))

plotcandle(hideThisBar ? open : na, high, low, close, title="Hidden Candles", color=hiddenCandleColor, bordercolor=hiddenCandleColor, wickcolor=hiddenCandleColor, editable=false, display=display.pane, force_overlay=true)

// ═══════════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE - Dynamic display based on Quick Filter
// ═══════════════════════════════════════════════════════════════════════════════

addColorRow(table tbl, int row, string name, color clr) =>
    table.cell(tbl, 0, row, name, text_size=size.small, text_color=color.black)
    table.cell(tbl, 1, row, str.format("R:{0} G:{1} B:{2}", int(color.r(clr)), int(color.g(clr)), int(color.b(clr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 2, row, str.tostring(int(color.t(clr))), text_size=size.small, text_color=color.black)

if showColorTable and barstate.islast
    var table color_table = table.new(position.top_right, 3, 47, bgcolor=color.white, border_width=LINE_WIDTH_1, border_color=color.gray, frame_width=LINE_WIDTH_1, frame_color=color.gray)

    // Header row
    table.cell(color_table, 0, 0, "Setting", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(color_table, 1, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(color_table, 2, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)

    int currentRow = 1

    // HTF Pools
    if showDailyFiltered
        addColorRow(color_table, currentRow, "Daily", dailyColor)
        currentRow += 1
    if showWeeklyFiltered
        addColorRow(color_table, currentRow, "Weekly", weeklyColor)
        currentRow += 1
    if showMonthlyFiltered
        addColorRow(color_table, currentRow, "Monthly", monthlyColor)
        currentRow += 1
    if effectiveEnableDailyLiquidityDepth and showDailyFiltered
        addColorRow(color_table, currentRow, "Daily Liq L1", dailyLiqDepthL1Color)
        currentRow += 1
        addColorRow(color_table, currentRow, "Daily Liq L2", dailyLiqDepthL2Color)
        currentRow += 1
        addColorRow(color_table, currentRow, "Daily Liq L3", dailyLiqDepthL3Color)
        currentRow += 1
    if effectiveEnableWeeklyLiquidityDepth and showWeeklyFiltered
        addColorRow(color_table, currentRow, "Weekly Liq L1", weeklyLiqDepthL1Color)
        currentRow += 1
        addColorRow(color_table, currentRow, "Weekly Liq L2", weeklyLiqDepthL2Color)
        currentRow += 1
        addColorRow(color_table, currentRow, "Weekly Liq L3", weeklyLiqDepthL3Color)
        currentRow += 1
    if effectiveEnableMonthlyLiquidityDepth and showMonthlyFiltered
        addColorRow(color_table, currentRow, "Monthly Liq L1", monthlyLiqDepthL1Color)
        currentRow += 1
        addColorRow(color_table, currentRow, "Monthly Liq L2", monthlyLiqDepthL2Color)
        currentRow += 1
        addColorRow(color_table, currentRow, "Monthly Liq L3", monthlyLiqDepthL3Color)
        currentRow += 1

    // Intraday Sessions (all 5 sessions share same toggle, check any one)
    if showAsiaFiltered
        addColorRow(color_table, currentRow, "Intraday", intradayColor)
        currentRow += 1
        addColorRow(color_table, currentRow, "Intraday BG", intradayBackgroundColor)
        currentRow += 1
        if effectiveEnableIntradayLiquidityDepth
            addColorRow(color_table, currentRow, "ID Liq L1", intradayLiquidityDepthL1Color)
            currentRow += 1
            addColorRow(color_table, currentRow, "ID Liq L2", intradayLiquidityDepthL2Color)
            currentRow += 1
            addColorRow(color_table, currentRow, "ID Liq L3", intradayLiquidityDepthL3Color)
            currentRow += 1

    // Session Boxes (Killzones)
    if sessionBoxesActive
        addColorRow(color_table, currentRow, "Session Box Asia", sessionBoxAsiaColor)
        currentRow += 1
        addColorRow(color_table, currentRow, "Session Box London", sessionBoxLondonColor)
        currentRow += 1
        addColorRow(color_table, currentRow, "Session Box NY AM", sessionBoxNyamColor)
        currentRow += 1
        addColorRow(color_table, currentRow, "Session Box NY PM", sessionBoxNypmColor)
        currentRow += 1
        addColorRow(color_table, currentRow, "Session Box Premarket", sessionBoxPremarketColor)
        currentRow += 1

    // Overnight
    if showOvernightFiltered
        addColorRow(color_table, currentRow, "Overnight", overnightColor)
        currentRow += 1
        addColorRow(color_table, currentRow, "Overnight BG", overnightBackgroundColor)
        currentRow += 1
        if effectiveEnableOvernightLiquidityDepth
            addColorRow(color_table, currentRow, "Overnight Liq L1", overnightLiqDepthL1Color)
            currentRow += 1
            addColorRow(color_table, currentRow, "Overnight Liq L2", overnightLiqDepthL2Color)
            currentRow += 1
            addColorRow(color_table, currentRow, "Overnight Liq L3", overnightLiqDepthL3Color)
            currentRow += 1

    // Premarket
    if showPremarketFiltered
        addColorRow(color_table, currentRow, "Premarket", premarketColor)
        currentRow += 1
        addColorRow(color_table, currentRow, "Premarket BG", premarketBackgroundColor)
        currentRow += 1
        if effectiveEnablePremarketLiquidityDepth
            addColorRow(color_table, currentRow, "Premarket Liq L1", premarketLiqDepthL1Color)
            currentRow += 1
            addColorRow(color_table, currentRow, "Premarket Liq L2", premarketLiqDepthL2Color)
            currentRow += 1
            addColorRow(color_table, currentRow, "Premarket Liq L3", premarketLiqDepthL3Color)
            currentRow += 1

    // Range Box
    if showRangeBoxFiltered
        addColorRow(color_table, currentRow, "Range Box", rangeBoxColor)
        currentRow += 1
        if showRangeMiddleLine
            addColorRow(color_table, currentRow, "Range Middle", rangeMiddleColor)
            currentRow += 1

    // Intraday Closes
    if show1400CloseFiltered
        addColorRow(color_table, currentRow, "14:00 Close", close1400Color)
        currentRow += 1
    if show1600CloseFiltered
        addColorRow(color_table, currentRow, "16:00 Close", close1600Color)
        currentRow += 1

    // HTF Opens
    if show1HOpenFiltered
        addColorRow(color_table, currentRow, "1H Open", open1HColor)
        currentRow += 1
    if show4HOpenFiltered
        addColorRow(color_table, currentRow, "4H Open", open4HColor)
        currentRow += 1
    if showMnoOpenFiltered
        addColorRow(color_table, currentRow, "Midnight Open", openMnoColor)
        currentRow += 1
    if show830OpenFiltered
        addColorRow(color_table, currentRow, "8:30 Open", open830Color)
        currentRow += 1
    if show930OpenFiltered
        addColorRow(color_table, currentRow, "9:30 Open", open930Color)
        currentRow += 1
    if showDailyOpenFiltered
        addColorRow(color_table, currentRow, "Daily Open", openDailyColor)
        currentRow += 1
    if showWeeklyOpenFiltered
        addColorRow(color_table, currentRow, "Weekly Open", openWeeklyColor)
        currentRow += 1
    if showMonthlyOpenFiltered
        addColorRow(color_table, currentRow, "Monthly Open", openMonthlyColor)
        currentRow += 1

    // Label Text (always show if labels enabled)
    if showLabels
        addColorRow(color_table, currentRow, "Label Text", labelTextColor)
        currentRow += 1

    if showOnlyEnabled and showOnlyTimeframeAllowed
        addColorRow(color_table, currentRow, "Hidden Candles", hiddenCandleColor)
        currentRow += 1

// ═══════════════════════════════════════════════════════════════════════════════
// pulse •
