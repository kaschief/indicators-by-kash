monthlyLiqDepthL2Width = input.int(LINE_WIDTH_1, "", options=[LINE_WIDTH_1, LINE_WIDTH_2, LINE_WIDTH_3, LINE_WIDTH_4, LINE_WIDTH_5], group=GROUP_MONTHLY, inline="monthly_l2")
monthlyLiqDepthL3Color = input.color(DEFAULT_LIQUIDITY_DEPTH_EXTENSION_COLOR, "  L3", group=GROUP_MONTHLY, inline="monthly_l3")
monthlyLiqDepthL3Style = input.string(LINE_STYLE_DOTTED, "", options=[LINE_STYLE_SOLID, LINE_STYLE_DASHED, LINE_STYLE_DOTTED], group=GROUP_MONTHLY, inline="monthly_l3")
monthlyLiqDepthL3Width = input.int(LINE_WIDTH_2, "", options=[LINE_WIDTH_1, LINE_WIDTH_2, LINE_WIDTH_3, LINE_WIDTH_4, LINE_WIDTH_5], group=GROUP_MONTHLY, inline="monthly_l3")

// Asset detection and liquidity depth distances (automatic, cached for performance)
detectedAsset = get_detected_asset_name()
dailyLiquidityDepthDistance = get_daily_liquidity_depth_distance()
weeklyLiquidityDepthDistance = get_weekly_liquidity_depth_distance()
monthlyLiquidityDepthDistance = get_monthly_liquidity_depth_distance()
isAssetSupported = is_asset_supported()

// Timeframe gating for liquidity depth (performance: computed once per bar)
currentTimeframeMinutes = timeframe.in_seconds() / 60
isDailyLiquidityDepthTimeframeValid = currentTimeframeMinutes >= 15 and currentTimeframeMinutes <= 60  // 15min to 1hr
isWeeklyLiquidityDepthTimeframeValid = currentTimeframeMinutes >= 240 and currentTimeframeMinutes <= 720  // 4hr to 12hr
isMonthlyLiquidityDepthTimeframeValid = currentTimeframeMinutes >= 720 and currentTimeframeMinutes <= 10080  // 12hr to 1W

// ─── Intraday Sessions ───
showIntraday = input.bool(true, GROUP_INTRADAY, group=GROUP_INTRADAY, tooltip='Asia: 2000-0000\nLondon: 0200-0500\nNY AM: 0930-1200\nLunch: 1200-1330\nNY PM: 1330-1600')
intradayShowLast = input.int(5, UI_SHOW_LAST, minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX_INTRADAY, group=GROUP_INTRADAY, inline='intraday')
intradayColor = input.color(DEFAULT_INTRADAY_COLOR, UI_COLOR, group=GROUP_INTRADAY, inline='intraday')
intradayLineWidth = input.int(LINE_WIDTH_1, UI_WIDTH, options=[LINE_WIDTH_1, LINE_WIDTH_2, LINE_WIDTH_3, LINE_WIDTH_4, LINE_WIDTH_5], group=GROUP_INTRADAY, inline='intraday')
showIntradayBackground = input.bool(false, UI_BACKGROUND, group=GROUP_INTRADAY, inline='intraday_bg')
intradayBackgroundColor = input.color(DEFAULT_INTRADAY_BG_COLOR, "", group=GROUP_INTRADAY, inline='intraday_bg')
enableIntradayLiquidityDepth = input.bool(false, "Liquidity Depth", group=GROUP_INTRADAY, inline='intraday_liq', tooltip="Projects percentage-based liquidity depth levels (L1, L2, L3) for Asia, London, NY AM, Lunch, NY PM sessions.")
intradayLiqDepthColorPreset = input.string(LIQUIDITY_DEPTH_PRESET_DEFAULT, "", options=[LIQUIDITY_DEPTH_PRESET_DEFAULT, LIQUIDITY_DEPTH_PRESET_POOL_COLORS], group=GROUP_INTRADAY, inline='intraday_liq')
useManualIntradayPercentages = input.bool(false, "  Use Manual %", group=GROUP_INTRADAY, inline="intraday_pct_override", tooltip="Enable to override auto-detected percentages. When disabled, percentages adjust based on asset.")
intradayLiquidityDepthPercent1Input = input.float(DEFAULT_INTRADAY_LIQUIDITY_DEPTH_PERCENT_1, "L1 %", minval=0.01, maxval=5.0, step=0.01, group=GROUP_INTRADAY, inline="intraday_pct")
intradayLiquidityDepthPercent2Input = input.float(DEFAULT_INTRADAY_LIQUIDITY_DEPTH_PERCENT_2, "L2 %", minval=0.01, maxval=5.0, step=0.01, group=GROUP_INTRADAY, inline="intraday_pct")
intradayLiquidityDepthPercent3Input = input.float(DEFAULT_INTRADAY_LIQUIDITY_DEPTH_PERCENT_3, "L3 %", minval=0.01, maxval=5.0, step=0.01, group=GROUP_INTRADAY, inline="intraday_pct")
intradayLiquidityDepthL1Color = input.color(DEFAULT_INTRADAY_COLOR, "  L1", group=GROUP_INTRADAY, inline="intraday_l1_style")
intradayLiquidityDepthL1Style = input.string(LINE_STYLE_DASHED, "", options=[LINE_STYLE_SOLID, LINE_STYLE_DASHED, LINE_STYLE_DOTTED], group=GROUP_INTRADAY, inline="intraday_l1_style")
intradayLiquidityDepthL1Width = input.int(LINE_WIDTH_1, "", options=[LINE_WIDTH_1, LINE_WIDTH_2, LINE_WIDTH_3, LINE_WIDTH_4, LINE_WIDTH_5], group=GROUP_INTRADAY, inline="intraday_l1_style")
intradayLiquidityDepthL2Color = input.color(DEFAULT_LIQUIDITY_DEPTH_EXTENSION_COLOR, "  L2", group=GROUP_INTRADAY, inline="intraday_l2_style")
intradayLiquidityDepthL2Style = input.string(LINE_STYLE_DOTTED, "", options=[LINE_STYLE_SOLID, LINE_STYLE_DASHED, LINE_STYLE_DOTTED], group=GROUP_INTRADAY, inline="intraday_l2_style")
intradayLiquidityDepthL2Width = input.int(LINE_WIDTH_1, "", options=[LINE_WIDTH_1, LINE_WIDTH_2, LINE_WIDTH_3, LINE_WIDTH_4, LINE_WIDTH_5], group=GROUP_INTRADAY, inline="intraday_l2_style")
intradayLiquidityDepthL3Color = input.color(DEFAULT_LIQUIDITY_DEPTH_EXTENSION_COLOR, "  L3", group=GROUP_INTRADAY, inline="intraday_l3_style")
intradayLiquidityDepthL3Style = input.string(LINE_STYLE_DOTTED, "", options=[LINE_STYLE_SOLID, LINE_STYLE_DASHED, LINE_STYLE_DOTTED], group=GROUP_INTRADAY, inline="intraday_l3_style")
intradayLiquidityDepthL3Width = input.int(LINE_WIDTH_2, "", options=[LINE_WIDTH_1, LINE_WIDTH_2, LINE_WIDTH_3, LINE_WIDTH_4, LINE_WIDTH_5], group=GROUP_INTRADAY, inline="intraday_l3_style")

// Apply detected asset percentages (override inputs if asset supported and manual override not enabled)
useAutoPercentages = isAssetSupported and not useManualIntradayPercentages
intradayLiquidityDepthPercent1 = useAutoPercentages ? get_intraday_liquidity_depth_percent_1() : intradayLiquidityDepthPercent1Input
intradayLiquidityDepthPercent2 = useAutoPercentages ? get_intraday_liquidity_depth_percent_2() : intradayLiquidityDepthPercent2Input
intradayLiquidityDepthPercent3 = useAutoPercentages ? get_intraday_liquidity_depth_percent_3() : intradayLiquidityDepthPercent3Input

// ─── PoiSzn Sessions (Overnight / Premarket) ───
