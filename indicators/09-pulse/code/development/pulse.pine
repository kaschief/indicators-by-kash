sessionBoxLondonColor = input.color(DEFAULT_SESSION_BOX_LONDON_COLOR, "London", group=GROUP_SESSION_BOXES, inline='sbrow')
sessionBoxNyamColor = input.color(DEFAULT_SESSION_BOX_NYAM_COLOR, "NY AM", group=GROUP_SESSION_BOXES, inline='sbrow')
sessionBoxNypmColor = input.color(DEFAULT_SESSION_BOX_NYPM_COLOR, "NY PM", group=GROUP_SESSION_BOXES, inline='sbrow')
