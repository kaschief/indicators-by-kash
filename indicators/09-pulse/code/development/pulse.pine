weeklyLiqDepthL2Width = input.int(LINE_WIDTH_1, "", options=[LINE_WIDTH_1, LINE_WIDTH_2, LINE_WIDTH_3, LINE_WIDTH_4, LINE_WIDTH_5], group=GROUP_WEEKLY, inline="weekly_l2")
