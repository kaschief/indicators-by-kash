openDailyColor = input.color(DEFAULT_DAILY_OPEN_COLOR, UI_COLOR, group=GROUP_HTF_OPEN_DAILY, inline='daily_open_options')
openDailyLineWidth = input.int(LINE_WIDTH_1, UI_WIDTH, options=[LINE_WIDTH_1, LINE_WIDTH_2, LINE_WIDTH_3, LINE_WIDTH_4, LINE_WIDTH_5], group=GROUP_HTF_OPEN_DAILY, inline='daily_open_options')

