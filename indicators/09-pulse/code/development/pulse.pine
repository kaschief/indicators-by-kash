monthlyLiqDepthL1Width = input.int(LINE_WIDTH_1, "", options=[LINE_WIDTH_1, LINE_WIDTH_2, LINE_WIDTH_3, LINE_WIDTH_4, LINE_WIDTH_5], group=GROUP_MONTHLY, inline="monthly_l1")
