// ═══════════════════════════════════════════════════════════════════════════════
// DEBUG TABLE - Pattern counts by session type (within show last limit)
// ═══════════════════════════════════════════════════════════════════════════════
if barstate.islast and showDebugTable
    var table debug_table = table.new(position.bottom_right, 5, 21, bgcolor=color.black, border_width=1, border_color=color.white)

    // Header row
    table.cell(debug_table, 0, 0, "Pool", text_color=color.white, bgcolor=color.new(color.gray, 50), text_size=size.tiny)
    table.cell(debug_table, 1, 0, "Tot", text_color=color.white, bgcolor=color.new(color.gray, 50), text_size=size.tiny)
    table.cell(debug_table, 2, 0, "IMM", text_color=color.white, bgcolor=color.new(color.gray, 50), text_size=size.tiny)
    table.cell(debug_table, 3, 0, "STD", text_color=color.white, bgcolor=color.new(color.gray, 50), text_size=size.tiny)
    table.cell(debug_table, 4, 0, "DEL", text_color=color.white, bgcolor=color.new(color.gray, 50), text_size=size.tiny)

    row = 1

    // Daily
    if showDaily
        int daily_imm = 0
        int daily_std = 0
        int daily_del = 0
        if array.size(daily_high_pattern_type) > 0
            for i = 0 to array.size(daily_high_pattern_type) - 1
                pattern = array.get(daily_high_pattern_type, i)
                if pattern == IMMEDIATE_LABEL_TEXT
                    daily_imm += 1
                else if pattern == STANDARD_LABEL_TEXT
                    daily_std += 1
                else if pattern == DELAYED_LABEL_TEXT
                    daily_del += 1
        if array.size(daily_low_pattern_type) > 0
            for i = 0 to array.size(daily_low_pattern_type) - 1
                pattern = array.get(daily_low_pattern_type, i)
                if pattern == IMMEDIATE_LABEL_TEXT
                    daily_imm += 1
                else if pattern == STANDARD_LABEL_TEXT
                    daily_std += 1
                else if pattern == DELAYED_LABEL_TEXT
                    daily_del += 1
        daily_total = daily_imm + daily_std + daily_del
        table.cell(debug_table, 0, row, LIQUIDITY_SOURCE_TYPE_DAILY, text_color=color.white, text_size=size.tiny)
        table.cell(debug_table, 1, row, str.tostring(daily_total), text_color=color.aqua, text_size=size.tiny)
        table.cell(debug_table, 2, row, str.tostring(daily_imm), text_color=color.yellow, text_size=size.tiny)
        table.cell(debug_table, 3, row, str.tostring(daily_std), text_color=color.purple, text_size=size.tiny)
        table.cell(debug_table, 4, row, str.tostring(daily_del), text_color=color.lime, text_size=size.tiny)
        row += 1

    // Weekly
    if showWeekly
        int weekly_imm = 0
        int weekly_std = 0
        int weekly_del = 0
        if array.size(weekly_high_pattern_type) > 0
            for i = 0 to array.size(weekly_high_pattern_type) - 1
                pattern = array.get(weekly_high_pattern_type, i)
