color final_bar_color = na
if highlightDelayedType and delayed_detected
    final_bar_color := delayedHighlightColor
else if highlightStandardType and standard_detected
    final_bar_color := standardHighlightColor
else if highlightImmediateType and immediate_detected
    final_bar_color := immediateHighlightColor

barcolor(final_bar_color)

if barstate.isconfirmed
    if highlightDelayedType and delayed_detected
        create_pattern_label(delayed_label_with_sign, delayedLabelTextColor, delayed_levels_used, delayed_sources)
    else if highlightStandardType and standard_detected
        create_pattern_label(standard_label_with_sign, standardLabelTextColor, standard_levels_used, standard_sources)
    else if highlightImmediateType and immediate_detected
        create_pattern_label(immediate_label_with_sign, immediateLabelTextColor, immediate_levels_used, immediate_sources)


// ═══════════════════════════════════════════════════════════════════════════════
// VISUAL OUTPUT (daily lines + labels)
// ═══════════════════════════════════════════════════════════════════════════════
if barstate.islast
    while array.size(all_lines) > 0
        old_line = array.shift(all_lines)
        if not na(old_line)
            line.delete(old_line)

    while array.size(all_labels) > 0
        old_label = array.shift(all_labels)
        if not na(old_label)
            label.delete(old_label)

if barstate.islast and showDaily
    if array.size(daily_highs) > 0
        for i = 0 to array.size(daily_highs) - 1
            tracked_high = array.get(daily_highs, i)
            tracked_low = array.get(daily_lows, i)
            high_time = array.get(daily_high_times, i)
            low_time = array.get(daily_low_times, i)
            high_breached = array.get(daily_high_breached, i)
            low_breached = array.get(daily_low_breached, i)
            high_breach_time = array.get(daily_high_breach_times, i)
            low_breach_time = array.get(daily_low_breach_times, i)
            high_used = array.size(daily_high_used_by_pattern) > i ? array.get(daily_high_used_by_pattern, i) : false
            low_used = array.size(daily_low_used_by_pattern) > i ? array.get(daily_low_used_by_pattern, i) : false

            if not verifyLevels or high_used
                high_end_time = high_breached ? high_breach_time : time
                high_line = line.new(high_time, tracked_high, high_end_time, tracked_high, xloc=xloc.bar_time)
                line.set_color(high_line, dailyHighColor)
                line.set_width(high_line, dailyLineWidth)
                line.set_style(high_line, line.style_solid)
                array.push(all_lines, high_line)

                if showLabels
                    high_label_time = high_breached ? int((high_time + high_end_time) / 2) : high_end_time
                    high_label = label.new(high_label_time, tracked_high, build_daily_label(high_time), style=label.style_label_down, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
                    array.push(all_labels, high_label)

            if not verifyLevels or low_used
                low_end_time = low_breached ? low_breach_time : time
                low_line = line.new(low_time, tracked_low, low_end_time, tracked_low, xloc=xloc.bar_time)
                line.set_color(low_line, dailyLowColor)
                line.set_width(low_line, dailyLineWidth)
                line.set_style(low_line, line.style_solid)
                array.push(all_lines, low_line)

                if showLabels
                    low_label_time = low_breached ? int((low_time + low_end_time) / 2) : low_end_time
                    low_label = label.new(low_label_time, tracked_low, build_daily_label(low_time), style=label.style_label_up, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
                    array.push(all_labels, low_label)

    if not verifyLevels and not na(daily_session_high) and not na(daily_session_high_time)
        active_high_line = line.new(daily_session_high_time, daily_session_high, time, daily_session_high, xloc=xloc.bar_time)
        line.set_color(active_high_line, dailyHighColor)
        line.set_width(active_high_line, dailyLineWidth)
        line.set_style(active_high_line, line.style_solid)
        array.push(all_lines, active_high_line)

        if showLabels
            active_high_label_time = int((daily_session_high_time + time) / 2)
            active_high_label = label.new(active_high_label_time, daily_session_high, build_daily_label(daily_session_high_time), style=label.style_label_down, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
            array.push(all_labels, active_high_label)

    if not verifyLevels and not na(daily_session_low) and not na(daily_session_low_time)
        active_low_line = line.new(daily_session_low_time, daily_session_low, time, daily_session_low, xloc=xloc.bar_time)
        line.set_color(active_low_line, dailyLowColor)
        line.set_width(active_low_line, dailyLineWidth)
        line.set_style(active_low_line, line.style_solid)
        array.push(all_lines, active_low_line)

        if showLabels
            active_low_label_time = int((daily_session_low_time + time) / 2)
            active_low_label = label.new(active_low_label_time, daily_session_low, build_daily_label(daily_session_low_time), style=label.style_label_up, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
            array.push(all_labels, active_low_label)

if barstate.islast and showWeekly
    if array.size(weekly_highs) > 0
        for i = 0 to array.size(weekly_highs) - 1
            tracked_high = array.get(weekly_highs, i)
            tracked_low = array.get(weekly_lows, i)
            high_time = array.get(weekly_high_times, i)
            low_time = array.get(weekly_low_times, i)
            high_breached = array.get(weekly_high_breached, i)
            low_breached = array.get(weekly_low_breached, i)
            high_breach_time = array.get(weekly_high_breach_times, i)
            low_breach_time = array.get(weekly_low_breach_times, i)
            high_used = array.size(weekly_high_used_by_pattern) > i ? array.get(weekly_high_used_by_pattern, i) : false
            low_used = array.size(weekly_low_used_by_pattern) > i ? array.get(weekly_low_used_by_pattern, i) : false

            if not verifyLevels or high_used
                high_end_time = high_breached ? high_breach_time : time
