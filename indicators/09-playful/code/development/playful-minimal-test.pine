NINE_LUNCH_TIME = "1200-1300"
NINE_NYPM_TIME = "1200-1800"

// Auto-detect 24/7 asset by scanning for weekend bars (excluding Sunday 18:00+ reopen)
var bool is_247_asset = false
if barstate.isfirst
    is_247_asset := false
    tf_minutes = timeframe.in_seconds() / 60
    bars_in_7_days = math.ceil(10080 / tf_minutes)
    scan_limit = math.min(bars_in_7_days, bar_index)

    for i = 0 to scan_limit
        if i % 10 == 0
            check_day = dayofweek(time[i], NY_TIMEZONE)
            check_hour = hour(time[i], NY_TIMEZONE)
            is_saturday = check_day == dayofweek.saturday
            is_early_sunday = check_day == dayofweek.sunday and check_hour < SUNDAY_REOPEN_START_HOUR
            if is_saturday or is_early_sunday
                is_247_asset := true
                break

