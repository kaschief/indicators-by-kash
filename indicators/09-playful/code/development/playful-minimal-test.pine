                    nypm_del += 1
        if array.size(nypm_low_pattern_type) > 0
            for i = 0 to array.size(nypm_low_pattern_type) - 1
                pattern = array.get(nypm_low_pattern_type, i)
                if pattern == IMMEDIATE_LABEL_TEXT
                    nypm_imm += 1
                else if pattern == STANDARD_LABEL_TEXT
                    nypm_std += 1
                else if pattern == DELAYED_LABEL_TEXT
                    nypm_del += 1
        nypm_total = nypm_imm + nypm_std + nypm_del
        table.cell(debug_table, 0, row, LIQUIDITY_SOURCE_TYPE_NYPM, text_color=color.white, text_size=size.tiny)
        table.cell(debug_table, 1, row, str.tostring(nypm_total), text_color=color.aqua, text_size=size.tiny)
        table.cell(debug_table, 2, row, str.tostring(nypm_imm), text_color=color.yellow, text_size=size.tiny)
        table.cell(debug_table, 3, row, str.tostring(nypm_std), text_color=color.purple, text_size=size.tiny)
        table.cell(debug_table, 4, row, str.tostring(nypm_del), text_color=color.lime, text_size=size.tiny)
        row += 1

    // ONS
    if showONS
        int ons_imm = 0
        int ons_std = 0
        int ons_del = 0
        if array.size(ons_high_pattern_type) > 0
            for i = 0 to array.size(ons_high_pattern_type) - 1
                pattern = array.get(ons_high_pattern_type, i)
                if pattern == IMMEDIATE_LABEL_TEXT
                    ons_imm += 1
                else if pattern == STANDARD_LABEL_TEXT
                    ons_std += 1
                else if pattern == DELAYED_LABEL_TEXT
                    ons_del += 1
        if array.size(ons_low_pattern_type) > 0
            for i = 0 to array.size(ons_low_pattern_type) - 1
                pattern = array.get(ons_low_pattern_type, i)
                if pattern == IMMEDIATE_LABEL_TEXT
                    ons_imm += 1
                else if pattern == STANDARD_LABEL_TEXT
                    ons_std += 1
                else if pattern == DELAYED_LABEL_TEXT
                    ons_del += 1
        ons_total = ons_imm + ons_std + ons_del
        table.cell(debug_table, 0, row, LIQUIDITY_SOURCE_TYPE_ONS, text_color=color.white, text_size=size.tiny)
        table.cell(debug_table, 1, row, str.tostring(ons_total), text_color=color.aqua, text_size=size.tiny)
        table.cell(debug_table, 2, row, str.tostring(ons_imm), text_color=color.yellow, text_size=size.tiny)
        table.cell(debug_table, 3, row, str.tostring(ons_std), text_color=color.purple, text_size=size.tiny)
        table.cell(debug_table, 4, row, str.tostring(ons_del), text_color=color.lime, text_size=size.tiny)
        row += 1

    // Asset Type Detection
    asset_type_label = is_247_asset ? "24/7" : "Mon-Fri"
    asset_type_color = is_247_asset ? color.new(color.green, 30) : color.new(color.blue, 30)
    table.cell(debug_table, 0, row, "Asset", text_color=color.white, text_size=size.tiny)
    table.cell(debug_table, 1, row, asset_type_label, text_color=color.white, bgcolor=asset_type_color, text_size=size.tiny)
    table.cell(debug_table, 2, row, "", text_color=color.white, text_size=size.tiny)
    table.cell(debug_table, 3, row, "", text_color=color.white, text_size=size.tiny)
    table.cell(debug_table, 4, row, "", text_color=color.white, text_size=size.tiny)
    row += 1

    // Time Mode footer
    time_mode_text = enable_nine_times ? "Time Mode: NINE'S" : "Time Mode: STANDARD"
    table.cell(debug_table, 0, row, time_mode_text, text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.tiny)
    table.merge_cells(debug_table, 0, row, 4, row)

// Playful Minimal