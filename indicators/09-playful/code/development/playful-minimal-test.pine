                    weekly_imm += 1
                else if pattern == STANDARD_LABEL_TEXT
                    weekly_std += 1
                else if pattern == DELAYED_LABEL_TEXT
                    weekly_del += 1
        if array.size(weekly_low_pattern_type) > 0
