if barstate.islast and showNYPM
    if array.size(nypm_highs) > 0
        for i = 0 to array.size(nypm_highs) - 1
            tracked_high = array.get(nypm_highs, i)
            tracked_low = array.get(nypm_lows, i)
            high_time = array.get(nypm_high_times, i)
            low_time = array.get(nypm_low_times, i)
            high_breached = array.get(nypm_high_breached, i)
            low_breached = array.get(nypm_low_breached, i)
            high_breach_time = array.get(nypm_high_breach_times, i)
            low_breach_time = array.get(nypm_low_breach_times, i)
            high_used = array.size(nypm_high_used_by_pattern) > i ? array.get(nypm_high_used_by_pattern, i) : false
            low_used = array.size(nypm_low_used_by_pattern) > i ? array.get(nypm_low_used_by_pattern, i) : false

            if not verifyLevels or high_used
                high_end_time = high_breached ? high_breach_time : time
                high_line = line.new(high_time, tracked_high, high_end_time, tracked_high, xloc=xloc.bar_time)
                line.set_color(high_line, nypmHighColor)
                line.set_width(high_line, nypmLineWidth)
                line.set_style(high_line, line.style_solid)
                array.push(all_lines, high_line)

                if showLabels
                    high_label_time = high_breached ? int((high_time + high_end_time) / 2) : high_end_time
                    high_label = label.new(high_label_time, tracked_high, build_session_label(DEFAULT_NYPM_NAME, high_time, nypm_start_minutes, nypm_end_minutes), style=label.style_label_down, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
                    array.push(all_labels, high_label)

            if not verifyLevels or low_used
                low_end_time = low_breached ? low_breach_time : time
                low_line = line.new(low_time, tracked_low, low_end_time, tracked_low, xloc=xloc.bar_time)
                line.set_color(low_line, nypmLowColor)
                line.set_width(low_line, nypmLineWidth)
                line.set_style(low_line, line.style_solid)
                array.push(all_lines, low_line)

                if showLabels
                    low_label_time = low_breached ? int((low_time + low_end_time) / 2) : low_end_time
                    low_label = label.new(low_label_time, tracked_low, build_session_label(DEFAULT_NYPM_NAME, low_time, nypm_start_minutes, nypm_end_minutes), style=label.style_label_up, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
                    array.push(all_labels, low_label)

    if not verifyLevels and nypm_in_session and not na(nypm_current_high) and not na(nypm_current_high_time)
        active_high_line = line.new(nypm_current_high_time, nypm_current_high, time, nypm_current_high, xloc=xloc.bar_time)
        line.set_color(active_high_line, nypmHighColor)
        line.set_width(active_high_line, nypmLineWidth)
        line.set_style(active_high_line, line.style_solid)
        array.push(all_lines, active_high_line)

        if showLabels
            active_high_label_time = int((nypm_current_high_time + time) / 2)
            active_high_label = label.new(active_high_label_time, nypm_current_high, build_session_label(DEFAULT_NYPM_NAME, nypm_current_high_time, nypm_start_minutes, nypm_end_minutes), style=label.style_label_down, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
