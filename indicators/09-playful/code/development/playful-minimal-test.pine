enable_nine_times = input.bool(false, "Enable NINE's Times", group='⚙️ Global Settings', tooltip='NINE\'S TIMES:\n• Asia: 18:00-03:00\n• London: 03:00-09:30\n• NY AM: 09:30-12:00\n• NY PM: 12:00-18:00\n• Lunch: 12:00-13:00\n• ONS: Unaffected')

showDaily = input.bool(true, 'Enable Daily Levels', group='📅 Daily')
