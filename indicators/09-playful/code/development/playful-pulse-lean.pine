//@version=6

// ═══════════════════════════════════════════════════════════════════════════════
// INDICATOR SETUP
// ═══════════════════════════════════════════════════════════════════════════════
INDICATOR_MAX_LINES = 500
INDICATOR_MAX_LABELS = 500
INDICATOR_TITLE = 'Playful Pulse [Lean]'
SHORT_TITLE = 'Pulse [Lean]'

indicator(INDICATOR_TITLE, shorttitle=SHORT_TITLE, overlay=true, max_lines_count=INDICATOR_MAX_LINES, max_labels_count=INDICATOR_MAX_LABELS)

// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

NY_TIMEZONE = "America/New_York"
SUNDAY_REOPEN_START_HOUR = 18

// Pool type labels
POOL_TYPE_DAILY = "daily"
POOL_TYPE_WEEKLY = "weekly"
POOL_TYPE_MONTHLY = "monthly"

// Default colors
DEFAULT_DAILY_COLOR = #9c27b0
DEFAULT_WEEKLY_COLOR = #ec407a
DEFAULT_MONTHLY_COLOR = #ff9800
DEFAULT_EXTENSION_COLOR = #03a9f4
DEFAULT_LABEL_TEXT_COLOR = color.black

// Scan caps
DAILY_SCAN_CAP = 100
WEEKLY_SCAN_CAP = 50
MONTHLY_SCAN_CAP = 30

// HTF (Daily/Weekly/Monthly) minimum timeframe (in seconds)
HTF_MIN_TIMEFRAME = 60  // 1 minute

// Input limits
SHOW_LAST_MIN = 1
SHOW_LAST_MAX = 50
LINE_WIDTH_MIN = 1
LINE_WIDTH_MAX = 5

// Extension constants (modular for future adjustments)
NUM_EXTENSION_LEVELS = 3         // L1, L2, L3 (easily configurable)

// ═══════════════════════════════════════════════════════════════════════════════
// TYPE DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════════════

// Asset family configuration (data-driven approach)
type AssetFamily
    array<string> identifiers           // Contract codes (e.g., ["NQ", "MNQ"])
    float daily_extension_distance      // Daily L1 distance (e.g., 27)
    float weekly_extension_distance     // Weekly L1 distance (e.g., 81)
    float monthly_extension_distance    // Monthly L1 distance (e.g., 243)
    string display_name                 // Display name (e.g., "NASDAQ")

// Stores extension level data for a single pool entry (one high or low)
type ExtensionLevels
    array<bool> breached      // Index 0 = L1, 1 = L2, 2 = L3, etc.
    array<int> breach_times   // Corresponding breach timestamps

// Main liquidity pool with base levels (L0) and extensions (L1-L3)
type LiquidityPool
    array<float> highs
    array<float> lows
    array<int> high_times
    array<int> low_times
    array<bool> high_breached
    array<bool> low_breached
    array<int> high_breach_times
    array<int> low_breach_times
    // Extension tracking: one ExtensionLevels per pool entry
    array<ExtensionLevels> high_extensions  // Array of extension data for each high
    array<ExtensionLevels> low_extensions   // Array of extension data for each low
    float current_high
    float current_low
    int current_high_time
    int current_low_time

// ═══════════════════════════════════════════════════════════════════════════════
// ASSET CONFIGURATION REGISTRY
// ═══════════════════════════════════════════════════════════════════════════════

// Data-Driven Asset Registry (infinitely scalable)
// To add a new asset: just add one line!
var array<AssetFamily> ASSET_FAMILIES = array.new<AssetFamily>()

if barstate.isfirst
    //                                                                      Daily  Weekly Monthly
    array.push(ASSET_FAMILIES, AssetFamily.new(array.from("NQ", "MNQ"), 27, 81, 243, "NASDAQ"))           // Daily: 27,54,81 | Weekly: 81,162,243 | Monthly: 243,486,729
    array.push(ASSET_FAMILIES, AssetFamily.new(array.from("ES", "MES"), 9, 18, 54, "S&P500"))             // Daily: 9,18,27 | Weekly: 18,36,54 | Monthly: 54,108,162
    array.push(ASSET_FAMILIES, AssetFamily.new(array.from("YM", "MYM"), 81, 243, 243, "DOW"))             // Daily: 81,162,243 | Weekly: 243,486,729 | Monthly: 243,486,729
    array.push(ASSET_FAMILIES, AssetFamily.new(array.from("RTY", "M2K"), 4, 12, 36, "RUSSELL"))           // TODO: Verify Monthly
    array.push(ASSET_FAMILIES, AssetFamily.new(array.from("GC", "MGC"), 3, 6, 18, "GOLD"))                // Daily: 3,6,9 | Weekly: 6,12,18 | Monthly: 18,36,54
    array.push(ASSET_FAMILIES, AssetFamily.new(array.from("CL", "MCL", "QM"), 0.125, 0.375, 1.125, "OIL")) // Daily: 0.125,0.25,0.375 | Weekly: 0.375,0.75,1.125 | Monthly: 1.125,2.25,3.375
    array.push(ASSET_FAMILIES, AssetFamily.new(array.from("BTC", "MBT"), 100, 300, 900, "BTC"))           // TODO: Verify Monthly
    array.push(ASSET_FAMILIES, AssetFamily.new(array.from("ETH", "MET"), 10, 30, 90, "ETH"))              // TODO: Verify Monthly

// ═══════════════════════════════════════════════════════════════════════════════
// ASSET DETECTION FUNCTIONS (must be defined before INPUTS)
// ═══════════════════════════════════════════════════════════════════════════════

// Helper: Check if symbol matches any identifier in a family array
symbol_matches_family(symbol_root, family_identifiers) =>
    matched = false
    for identifier in family_identifiers
        if str.contains(symbol_root, identifier)
            matched := true
            break
    matched

// Find matching asset family for current symbol (loop-based lookup)
find_asset_family() =>
    symbol_root = syminfo.root != "" ? syminfo.root : syminfo.ticker
    var AssetFamily matched_family = na

    matched_family := na  // Reset
    for family in ASSET_FAMILIES
        if symbol_matches_family(symbol_root, family.identifiers)
            matched_family := family
            break

    matched_family

// Performance optimization: Cache lookup result in global scope
var AssetFamily CACHED_ASSET_FAMILY = na

// Initialize cache on first bar
if barstate.isfirst
    CACHED_ASSET_FAMILY := find_asset_family()

// Helper functions use cached result (called during inputs, so cache is ready)
is_asset_supported() =>
    not na(CACHED_ASSET_FAMILY)

get_daily_extension_distance() =>
    na(CACHED_ASSET_FAMILY) ? 0.0 : CACHED_ASSET_FAMILY.daily_extension_distance

get_weekly_extension_distance() =>
    na(CACHED_ASSET_FAMILY) ? 0.0 : CACHED_ASSET_FAMILY.weekly_extension_distance

get_monthly_extension_distance() =>
    na(CACHED_ASSET_FAMILY) ? 0.0 : CACHED_ASSET_FAMILY.monthly_extension_distance

get_detected_asset_name() =>
    na(CACHED_ASSET_FAMILY) ? "NOT SUPPORTED" : CACHED_ASSET_FAMILY.display_name

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Extensions (Central Control) ───
applyExtension = input.bool(false, "Apply Extension", group="Extensions", tooltip="Projects extension levels (L1, L2, L3) above highs and below lows. Automatically adjusts distance based on detected asset.\n\nDaily: Valid on 15min-1hr charts\nWeekly: Valid on 4hr-12hr charts\nMonthly: Valid on 12hr-1W charts")
extensionColor = input.color(DEFAULT_EXTENSION_COLOR, "Extension Color", group="Extensions", inline="extension_style")
extensionLineWidth = input.int(1, "Extension Width", minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group="Extensions", inline="extension_style")

// ─── Daily ───
showDaily = input.bool(true, "Show Daily", group="Daily", inline="daily")
dailyShowLast = input.int(5, "Show Last", minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX, group="Daily", inline="daily_count")
dailyColor = input.color(DEFAULT_DAILY_COLOR, "Color", group="Daily", inline="daily_style")
dailyLineWidth = input.int(2, "Width", minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group="Daily", inline="daily_style")

// Asset detection (automatic, no UI)
detectedAsset = get_detected_asset_name()
dailyExtensionDistance = get_daily_extension_distance()
weeklyExtensionDistance = get_weekly_extension_distance()
monthlyExtensionDistance = get_monthly_extension_distance()
isAssetSupported = is_asset_supported()

// Timeframe gating for extensions
currentTimeframeMinutes = timeframe.in_seconds() / 60
isDailyExtensionTimeframeValid = currentTimeframeMinutes >= 15 and currentTimeframeMinutes <= 60  // 15min to 1hr
isWeeklyExtensionTimeframeValid = currentTimeframeMinutes >= 240 and currentTimeframeMinutes <= 720  // 4hr to 12hr
isMonthlyExtensionTimeframeValid = currentTimeframeMinutes >= 720 and currentTimeframeMinutes <= 10080  // 12hr to 1W

// ─── Weekly ───
showWeekly = input.bool(true, "Show Weekly", group="Weekly", inline="weekly")
weeklyShowLast = input.int(5, "Show Last", minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX, group="Weekly", inline="weekly_count")
weeklyColor = input.color(DEFAULT_WEEKLY_COLOR, "Color", group="Weekly", inline="weekly_style")
weeklyLineWidth = input.int(3, "Width", minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group="Weekly", inline="weekly_style")

// ─── Monthly ───
showMonthly = input.bool(true, "Show Monthly", group="Monthly", inline="monthly")
monthlyShowLast = input.int(5, "Show Last", minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX, group="Monthly", inline="monthly_count")
monthlyColor = input.color(DEFAULT_MONTHLY_COLOR, "Color", group="Monthly", inline="monthly_style")
monthlyLineWidth = input.int(4, "Width", minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group="Monthly", inline="monthly_style")

// ─── Labels ───
showLabels = input.bool(true, "Show Labels", group="Labels", inline="labels")
labelTextColor = input.color(DEFAULT_LABEL_TEXT_COLOR, "Text Color", group="Labels", inline="labels")

// ─── Info Table ───
showInfoTable = input.bool(true, "Show Info Table", group="Info", tooltip="Displays current asset, timeframe, and extension distances")
infoTablePosition = input.string("top_right", "Position", options=["top_left", "top_right", "bottom_left", "bottom_right"], group="Info")

// ═══════════════════════════════════════════════════════════════════════════════
// 24/7 ASSET AUTO-DETECTION & SUNDAY LIQUIDITY HANDLING
// ═══════════════════════════════════════════════════════════════════════════════

var bool is247Asset = true
var bool detectionCompleted = false

if not detectionCompleted
    barsIn7Days = int(10080 / (timeframe.in_seconds() / 60))

    if bar_index >= barsIn7Days
        currentDay = dayofweek(time, NY_TIMEZONE)
        currentHour = hour(time, NY_TIMEZONE)
        isSaturdayNow = currentDay == dayofweek.saturday
        isEarlySundayNow = currentDay == dayofweek.sunday and currentHour < SUNDAY_REOPEN_START_HOUR

        if isSaturdayNow or isEarlySundayNow
            is247Asset := true
        else
            maxLookback = math.min(9999, barsIn7Days)
            foundWeekendBar = false

            for lookback = 0 to maxLookback by 20
                checkDay = dayofweek(time[lookback], NY_TIMEZONE)
                checkHour = hour(time[lookback], NY_TIMEZONE)

                isSaturday = checkDay == dayofweek.saturday
                isEarlySunday = checkDay == dayofweek.sunday and checkHour < SUNDAY_REOPEN_START_HOUR
                if isSaturday or isEarlySunday
                    foundWeekendBar := true
                    break

            is247Asset := foundWeekendBar

        detectionCompleted := true

// ═══════════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// Helper: Create ExtensionLevels with initialized arrays for N levels
create_extension_levels() =>
    ExtensionLevels.new(array.new<bool>(), array.new<int>())

// Helper: Initialize extension levels for a new pool entry
init_extension_levels() =>
    ext = create_extension_levels()
    for i = 0 to NUM_EXTENSION_LEVELS - 1
        array.push(ext.breached, false)
        array.push(ext.breach_times, na)
    ext

create_pool() =>
    LiquidityPool.new(array.new_float(), array.new_float(), array.new_int(), array.new_int(), array.new_bool(), array.new_bool(), array.new_int(), array.new_int(), array.new<ExtensionLevels>(), array.new<ExtensionLevels>(), na, na, na, na)

pool_get_high_end_time(pool, index, fallback_time) =>
    high_breached = array.get(pool.high_breached, index)
    high_breach_time = array.get(pool.high_breach_times, index)
    high_breached and not na(high_breach_time) ? high_breach_time : fallback_time

pool_get_low_end_time(pool, index, fallback_time) =>
    low_breached = array.get(pool.low_breached, index)
    low_breach_time = array.get(pool.low_breach_times, index)
    low_breached and not na(low_breach_time) ? low_breach_time : fallback_time

pool_store_session(pool) =>
    if not na(pool.current_high)
        array.push(pool.highs, pool.current_high)
        array.push(pool.lows, pool.current_low)
        array.push(pool.high_times, pool.current_high_time)
        array.push(pool.low_times, pool.current_low_time)
        array.push(pool.high_breached, false)
        array.push(pool.low_breached, false)
        array.push(pool.high_breach_times, na)
        array.push(pool.low_breach_times, na)
        // Initialize extension levels for this pool entry
        array.push(pool.high_extensions, init_extension_levels())
        array.push(pool.low_extensions, init_extension_levels())

pool_detect_breaches(pool, scan_cap, extension_distance) =>
    if array.size(pool.highs) > 0
        scan_size = math.min(array.size(pool.highs), scan_cap)
        start_index = math.max(0, array.size(pool.highs) - scan_size)

        for i = start_index to array.size(pool.highs) - 1
            tracked_high = array.get(pool.highs, i)
            tracked_low = array.get(pool.lows, i)

            // Level 0 breach detection (base level)
            if not array.get(pool.high_breached, i)
                if high >= tracked_high
                    array.set(pool.high_breached, i, true)
                    array.set(pool.high_breach_times, i, time)

            if not array.get(pool.low_breached, i)
                if low <= tracked_low
                    array.set(pool.low_breached, i, true)
                    array.set(pool.low_breach_times, i, time)

            // Extension level breach detection (L1, L2, L3, ...)
            high_ext = array.get(pool.high_extensions, i)
            low_ext = array.get(pool.low_extensions, i)

            for level_idx = 0 to NUM_EXTENSION_LEVELS - 1
                multiplier = level_idx + 1  // L1=1x, L2=2x, L3=3x

                // Check high extension level
                if not array.get(high_ext.breached, level_idx)
                    level_price = tracked_high + (multiplier * extension_distance)
                    if high >= level_price
                        array.set(high_ext.breached, level_idx, true)
                        array.set(high_ext.breach_times, level_idx, time)

                // Check low extension level
                if not array.get(low_ext.breached, level_idx)
                    level_price = tracked_low - (multiplier * extension_distance)
                    if low <= level_price
                        array.set(low_ext.breached, level_idx, true)
                        array.set(low_ext.breach_times, level_idx, time)

build_label(pool_type) =>
    pool_type

should_skip_sunday_liquidity(time_value) =>
    not is247Asset and dayofweek(time_value, NY_TIMEZONE) == dayofweek.sunday and hour(time_value, NY_TIMEZONE) >= SUNDAY_REOPEN_START_HOUR

// ═══════════════════════════════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════════════════════════════

var LiquidityPool daily_pool = create_pool()
var LiquidityPool weekly_pool = create_pool()
var LiquidityPool monthly_pool = create_pool()
var array<line> all_lines = array.new<line>()
var array<label> all_labels = array.new<label>()

// ═══════════════════════════════════════════════════════════════════════════════
// DATA COLLECTION
// ═══════════════════════════════════════════════════════════════════════════════

is_new_daily_bar = ta.change(dayofmonth(time, NY_TIMEZONE)) != 0
is_new_weekly_bar = ta.change(weekofyear(time, NY_TIMEZONE)) != 0
is_new_monthly_bar = ta.change(month(time, NY_TIMEZONE)) != 0

skip_sunday_liquidity = should_skip_sunday_liquidity(time)

if barstate.isfirst
    daily_pool.current_high := high
    daily_pool.current_low := low
    daily_pool.current_high_time := time
    daily_pool.current_low_time := time

    weekly_pool.current_high := high
    weekly_pool.current_low := low
    weekly_pool.current_high_time := time
    weekly_pool.current_low_time := time

    monthly_pool.current_high := high
    monthly_pool.current_low := low
    monthly_pool.current_high_time := time
    monthly_pool.current_low_time := time
else
    // Daily tracking
    if is_new_daily_bar
        coming_from_sunday_evening = not is247Asset and dayofweek(time[1], NY_TIMEZONE) == dayofweek.sunday and hour(time[1], NY_TIMEZONE) >= SUNDAY_REOPEN_START_HOUR
        if not coming_from_sunday_evening
            pool_store_session(daily_pool)

        if not skip_sunday_liquidity
            daily_pool.current_high := high
            daily_pool.current_low := low
            daily_pool.current_high_time := time
            daily_pool.current_low_time := time
    else if not skip_sunday_liquidity
        if high > daily_pool.current_high
            daily_pool.current_high := high
            daily_pool.current_high_time := time
        if low < daily_pool.current_low
            daily_pool.current_low := low
            daily_pool.current_low_time := time
    else
        if high > daily_pool.current_high
            daily_pool.current_high := high
            daily_pool.current_high_time := time
        if low < daily_pool.current_low
            daily_pool.current_low := low
            daily_pool.current_low_time := time

    // Weekly tracking
    if is_new_weekly_bar
        pool_store_session(weekly_pool)
        weekly_pool.current_high := high
        weekly_pool.current_low := low
        weekly_pool.current_high_time := time
        weekly_pool.current_low_time := time
    else
        if high > weekly_pool.current_high
            weekly_pool.current_high := high
            weekly_pool.current_high_time := time
        if low < weekly_pool.current_low
            weekly_pool.current_low := low
            weekly_pool.current_low_time := time

    // Monthly tracking
    if is_new_monthly_bar
        pool_store_session(monthly_pool)
        monthly_pool.current_high := high
        monthly_pool.current_low := low
        monthly_pool.current_high_time := time
        monthly_pool.current_low_time := time
    else
        if high > monthly_pool.current_high
            monthly_pool.current_high := high
            monthly_pool.current_high_time := time
        if low < monthly_pool.current_low
            monthly_pool.current_low := low
            monthly_pool.current_low_time := time

// Sunday evening continuation for traditional markets
if not is247Asset and dayofweek(time, NY_TIMEZONE) == dayofweek.sunday and hour(time, NY_TIMEZONE) >= SUNDAY_REOPEN_START_HOUR
    if showDaily and array.size(daily_pool.highs) > 0
        last_index = array.size(daily_pool.highs) - 1
        last_high = array.get(daily_pool.highs, last_index)
        last_low = array.get(daily_pool.lows, last_index)

        if high > last_high
            array.set(daily_pool.highs, last_index, high)
            array.set(daily_pool.high_times, last_index, time)
            array.set(daily_pool.high_breached, last_index, false)
            array.set(daily_pool.high_breach_times, last_index, na)
            daily_pool.current_high := high
            daily_pool.current_high_time := time
        if low < last_low
            array.set(daily_pool.lows, last_index, low)
            array.set(daily_pool.low_times, last_index, time)
            array.set(daily_pool.low_breached, last_index, false)
            array.set(daily_pool.low_breach_times, last_index, na)
            daily_pool.current_low := low
            daily_pool.current_low_time := time

        daily_pool.current_high := last_high
        daily_pool.current_high_time := array.get(daily_pool.high_times, last_index)
        daily_pool.current_low := last_low
        daily_pool.current_low_time := array.get(daily_pool.low_times, last_index)

// ═══════════════════════════════════════════════════════════════════════════════
// BREACH DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

if not skip_sunday_liquidity
    if showDaily
        // Only detect extension breaches if asset is supported and timeframe is valid
        pool_detect_breaches(daily_pool, DAILY_SCAN_CAP, (isAssetSupported and isDailyExtensionTimeframeValid) ? dailyExtensionDistance : 0)

    if showWeekly
        // Detect weekly extension breaches if asset is supported and timeframe is valid
        pool_detect_breaches(weekly_pool, WEEKLY_SCAN_CAP, (isAssetSupported and isWeeklyExtensionTimeframeValid) ? weeklyExtensionDistance : 0)

    if showMonthly
        // Detect monthly extension breaches if asset is supported and timeframe is valid
        pool_detect_breaches(monthly_pool, MONTHLY_SCAN_CAP, (isAssetSupported and isMonthlyExtensionTimeframeValid) ? monthlyExtensionDistance : 0)

// ═══════════════════════════════════════════════════════════════════════════════
// VISUALIZATION
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.islast
    // Clear previous visuals
    for line_obj in all_lines
        line.delete(line_obj)
    array.clear(all_lines)

    for label_obj in all_labels
        label.delete(label_obj)
    array.clear(all_labels)

    // Draw Daily
    if showDaily and timeframe.in_seconds() >= HTF_MIN_TIMEFRAME
        count = math.min(dailyShowLast, array.size(daily_pool.highs))
        if count > 0
            for i = 0 to count - 1
                idx = array.size(daily_pool.highs) - 1 - i

                high_val = array.get(daily_pool.highs, idx)
                low_val = array.get(daily_pool.lows, idx)
                high_time = array.get(daily_pool.high_times, idx)
                low_time = array.get(daily_pool.low_times, idx)

                // Get conditional end times
                high_end_time = pool_get_high_end_time(daily_pool, idx, time)
                low_end_time = pool_get_low_end_time(daily_pool, idx, time)

                // Draw high line
                high_line = line.new(high_time, high_val, high_end_time, high_val, xloc=xloc.bar_time, color=dailyColor, width=dailyLineWidth, style=line.style_solid)
                array.push(all_lines, high_line)

                // Draw low line
                low_line = line.new(low_time, low_val, low_end_time, low_val, xloc=xloc.bar_time, color=dailyColor, width=dailyLineWidth, style=line.style_solid)
                array.push(all_lines, low_line)

                // Draw extension lines if toggle is enabled AND asset is supported AND timeframe is valid
                if applyExtension and isAssetSupported and isDailyExtensionTimeframeValid and dailyExtensionDistance > 0
                    // Check if L0 (base level) has been breached
                    high_breached = array.get(daily_pool.high_breached, idx)
                    low_breached = array.get(daily_pool.low_breached, idx)

                    // Only draw extensions if L0 is breached (prerequisite)
                    if high_breached
                        // Get extension data for this pool entry
                        high_ext = array.get(daily_pool.high_extensions, idx)

                        // Draw all extension levels dynamically
                        for level_idx = 0 to NUM_EXTENSION_LEVELS - 1
                            multiplier = level_idx + 1  // L1=1x, L2=2x, L3=3x

                            // HIGH EXTENSIONS
                            // Calculate level price
                            extended_high_val = high_val + (multiplier * dailyExtensionDistance)

                            // Get end time for this level
                            level_breached = array.get(high_ext.breached, level_idx)
                            level_breach_time = array.get(high_ext.breach_times, level_idx)
                            level_end_time = level_breached and not na(level_breach_time) ? level_breach_time : time

                            // Draw horizontal extension line
                            high_ext_line = line.new(high_time, extended_high_val, level_end_time, extended_high_val, xloc=xloc.bar_time, color=extensionColor, width=extensionLineWidth, style=line.style_dashed)
                            array.push(all_lines, high_ext_line)

                            // Draw vertical connector from L0 to this level
                            high_connector = line.new(high_time, high_val, high_time, extended_high_val, xloc=xloc.bar_time, color=color.new(extensionColor, 80), width=extensionLineWidth, style=line.style_solid)
                            array.push(all_lines, high_connector)

                    if low_breached
                        // Get extension data for this pool entry
                        low_ext = array.get(daily_pool.low_extensions, idx)

                        // Draw all extension levels dynamically
                        for level_idx = 0 to NUM_EXTENSION_LEVELS - 1
                            multiplier = level_idx + 1  // L1=1x, L2=2x, L3=3x

                            // LOW EXTENSIONS
                            // Calculate level price
                            extended_low_val = low_val - (multiplier * dailyExtensionDistance)

                            // Get end time for this level
                            level_breached_low = array.get(low_ext.breached, level_idx)
                            level_breach_time_low = array.get(low_ext.breach_times, level_idx)
                            level_end_time_low = level_breached_low and not na(level_breach_time_low) ? level_breach_time_low : time

                            // Draw horizontal extension line
                            low_ext_line = line.new(low_time, extended_low_val, level_end_time_low, extended_low_val, xloc=xloc.bar_time, color=extensionColor, width=extensionLineWidth, style=line.style_dashed)
                            array.push(all_lines, low_ext_line)

                            // Draw vertical connector from L0 to this level
                            low_connector = line.new(low_time, low_val, low_time, extended_low_val, xloc=xloc.bar_time, color=color.new(extensionColor, 80), width=extensionLineWidth, style=line.style_solid)
                            array.push(all_lines, low_connector)

                // Draw labels
                if showLabels
                    label_text = build_label(POOL_TYPE_DAILY)
                    high_breached = array.get(daily_pool.high_breached, idx)
                    low_breached = array.get(daily_pool.low_breached, idx)

                    // High label
                    high_label_time = high_breached ? int((high_time + high_end_time) / 2) : high_end_time
                    high_label = label.new(high_label_time, high_val, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                    array.push(all_labels, high_label)

                    // Low label
                    low_label_time = low_breached ? int((low_time + low_end_time) / 2) : low_end_time
                    low_label = label.new(low_label_time, low_val, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                    array.push(all_labels, low_label)

                    // Extension labels if toggle is enabled AND asset is supported AND timeframe is valid
                    if applyExtension and isAssetSupported and isDailyExtensionTimeframeValid and dailyExtensionDistance > 0
                        // Check if L0 is breached (prerequisite for showing extensions)
                        high_breached_labels = array.get(daily_pool.high_breached, idx)
                        low_breached_labels = array.get(daily_pool.low_breached, idx)

                        // Only show high extension labels if L0 high is breached
                        if high_breached_labels
                            high_ext_labels = array.get(daily_pool.high_extensions, idx)

                            for level_idx = 0 to NUM_EXTENSION_LEVELS - 1
                                multiplier = level_idx + 1
                                label_text_ext = "L" + str.tostring(multiplier)

                                // High extension label
                                extended_high_val_label = high_val + (multiplier * dailyExtensionDistance)
                                ext_high_label = label.new(high_label_time, extended_high_val_label, label_text_ext, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                                array.push(all_labels, ext_high_label)

                        // Only show low extension labels if L0 low is breached
                        if low_breached_labels
                            low_ext_labels = array.get(daily_pool.low_extensions, idx)

                            for level_idx = 0 to NUM_EXTENSION_LEVELS - 1
                                multiplier = level_idx + 1
                                label_text_ext = "L" + str.tostring(multiplier)

                                // Low extension label
                                extended_low_val_label = low_val - (multiplier * dailyExtensionDistance)
                                ext_low_label = label.new(low_label_time, extended_low_val_label, label_text_ext, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                                array.push(all_labels, ext_low_label)

    // Draw Weekly
    if showWeekly and timeframe.in_seconds() >= HTF_MIN_TIMEFRAME
        count = math.min(weeklyShowLast, array.size(weekly_pool.highs))
        if count > 0
            for i = 0 to count - 1
                idx = array.size(weekly_pool.highs) - 1 - i

                high_val = array.get(weekly_pool.highs, idx)
                low_val = array.get(weekly_pool.lows, idx)
                high_time = array.get(weekly_pool.high_times, idx)
                low_time = array.get(weekly_pool.low_times, idx)

                high_end_time = pool_get_high_end_time(weekly_pool, idx, time)
                low_end_time = pool_get_low_end_time(weekly_pool, idx, time)

                // Draw high line
                high_line = line.new(high_time, high_val, high_end_time, high_val, xloc=xloc.bar_time, color=weeklyColor, width=weeklyLineWidth, style=line.style_solid)
                array.push(all_lines, high_line)

                // Draw low line
                low_line = line.new(low_time, low_val, low_end_time, low_val, xloc=xloc.bar_time, color=weeklyColor, width=weeklyLineWidth, style=line.style_solid)
                array.push(all_lines, low_line)

                // Draw Weekly extension lines if toggle is enabled AND asset is supported AND timeframe is valid
                if applyExtension and isAssetSupported and isWeeklyExtensionTimeframeValid and weeklyExtensionDistance > 0
                    // Check if L0 (base level) has been breached
                    high_breached = array.get(weekly_pool.high_breached, idx)
                    low_breached = array.get(weekly_pool.low_breached, idx)

                    // Only draw extensions if L0 is breached (prerequisite)
                    if high_breached
                        // Get extension data for this pool entry
                        high_ext = array.get(weekly_pool.high_extensions, idx)

                        // Draw all extension levels dynamically
                        for level_idx = 0 to NUM_EXTENSION_LEVELS - 1
                            multiplier = level_idx + 1  // L1=1x, L2=2x, L3=3x

                            // HIGH EXTENSIONS
                            // Calculate level price
                            extended_high_val = high_val + (multiplier * weeklyExtensionDistance)

                            // Get end time for this level
                            level_breached = array.get(high_ext.breached, level_idx)
                            level_breach_time = array.get(high_ext.breach_times, level_idx)
                            level_end_time = level_breached and not na(level_breach_time) ? level_breach_time : time

                            // Draw horizontal extension line
                            high_ext_line = line.new(high_time, extended_high_val, level_end_time, extended_high_val, xloc=xloc.bar_time, color=extensionColor, width=extensionLineWidth, style=line.style_dashed)
                            array.push(all_lines, high_ext_line)

                            // Draw vertical connector from L0 to this level
                            high_connector = line.new(high_time, high_val, high_time, extended_high_val, xloc=xloc.bar_time, color=color.new(extensionColor, 80), width=extensionLineWidth, style=line.style_solid)
                            array.push(all_lines, high_connector)

                    if low_breached
                        // Get extension data for this pool entry
                        low_ext = array.get(weekly_pool.low_extensions, idx)

                        // Draw all extension levels dynamically
                        for level_idx = 0 to NUM_EXTENSION_LEVELS - 1
                            multiplier = level_idx + 1  // L1=1x, L2=2x, L3=3x

                            // LOW EXTENSIONS
                            // Calculate level price
                            extended_low_val = low_val - (multiplier * weeklyExtensionDistance)

                            // Get end time for this level
                            level_breached_low = array.get(low_ext.breached, level_idx)
                            level_breach_time_low = array.get(low_ext.breach_times, level_idx)
                            level_end_time_low = level_breached_low and not na(level_breach_time_low) ? level_breach_time_low : time

                            // Draw horizontal extension line
                            low_ext_line = line.new(low_time, extended_low_val, level_end_time_low, extended_low_val, xloc=xloc.bar_time, color=extensionColor, width=extensionLineWidth, style=line.style_dashed)
                            array.push(all_lines, low_ext_line)

                            // Draw vertical connector from L0 to this level
                            low_connector = line.new(low_time, low_val, low_time, extended_low_val, xloc=xloc.bar_time, color=color.new(extensionColor, 80), width=extensionLineWidth, style=line.style_solid)
                            array.push(all_lines, low_connector)

                // Draw labels
                if showLabels
                    label_text = build_label(POOL_TYPE_WEEKLY)
                    high_breached = array.get(weekly_pool.high_breached, idx)
                    low_breached = array.get(weekly_pool.low_breached, idx)

                    high_label_time = high_breached ? int((high_time + high_end_time) / 2) : high_end_time
                    high_label = label.new(high_label_time, high_val, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                    array.push(all_labels, high_label)

                    low_label_time = low_breached ? int((low_time + low_end_time) / 2) : low_end_time
                    low_label = label.new(low_label_time, low_val, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                    array.push(all_labels, low_label)

                    // Weekly extension labels if toggle is enabled AND asset is supported AND timeframe is valid
                    if applyExtension and isAssetSupported and isWeeklyExtensionTimeframeValid and weeklyExtensionDistance > 0
                        // Check if L0 is breached (prerequisite for showing extensions)
                        high_breached_labels = array.get(weekly_pool.high_breached, idx)
                        low_breached_labels = array.get(weekly_pool.low_breached, idx)

                        // Only show high extension labels if L0 high is breached
                        if high_breached_labels
                            high_ext_labels = array.get(weekly_pool.high_extensions, idx)

                            for level_idx = 0 to NUM_EXTENSION_LEVELS - 1
                                multiplier = level_idx + 1
                                label_text_ext = "L" + str.tostring(multiplier)

                                // High extension label
                                extended_high_val_label = high_val + (multiplier * weeklyExtensionDistance)
                                ext_high_label = label.new(high_label_time, extended_high_val_label, label_text_ext, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                                array.push(all_labels, ext_high_label)

                        // Only show low extension labels if L0 low is breached
                        if low_breached_labels
                            low_ext_labels = array.get(weekly_pool.low_extensions, idx)

                            for level_idx = 0 to NUM_EXTENSION_LEVELS - 1
                                multiplier = level_idx + 1
                                label_text_ext = "L" + str.tostring(multiplier)

                                // Low extension label
                                extended_low_val_label = low_val - (multiplier * weeklyExtensionDistance)
                                ext_low_label = label.new(low_label_time, extended_low_val_label, label_text_ext, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                                array.push(all_labels, ext_low_label)

    // Draw Monthly
    if showMonthly and timeframe.in_seconds() >= HTF_MIN_TIMEFRAME
        count = math.min(monthlyShowLast, array.size(monthly_pool.highs))
        if count > 0
            for i = 0 to count - 1
                idx = array.size(monthly_pool.highs) - 1 - i

                high_val = array.get(monthly_pool.highs, idx)
                low_val = array.get(monthly_pool.lows, idx)
                high_time = array.get(monthly_pool.high_times, idx)
                low_time = array.get(monthly_pool.low_times, idx)

                high_end_time = pool_get_high_end_time(monthly_pool, idx, time)
                low_end_time = pool_get_low_end_time(monthly_pool, idx, time)

                // Draw high line
                high_line = line.new(high_time, high_val, high_end_time, high_val, xloc=xloc.bar_time, color=monthlyColor, width=monthlyLineWidth, style=line.style_solid)
                array.push(all_lines, high_line)

                // Draw low line
                low_line = line.new(low_time, low_val, low_end_time, low_val, xloc=xloc.bar_time, color=monthlyColor, width=monthlyLineWidth, style=line.style_solid)
                array.push(all_lines, low_line)

                // Draw Monthly extension lines if toggle is enabled AND asset is supported AND timeframe is valid
                if applyExtension and isAssetSupported and isMonthlyExtensionTimeframeValid and monthlyExtensionDistance > 0
                    // Check if L0 (base level) has been breached
                    high_breached = array.get(monthly_pool.high_breached, idx)
                    low_breached = array.get(monthly_pool.low_breached, idx)

                    // Only draw extensions if L0 is breached (prerequisite)
                    if high_breached
                        // Get extension data for this pool entry
                        high_ext = array.get(monthly_pool.high_extensions, idx)

                        // Draw all extension levels dynamically
                        for level_idx = 0 to NUM_EXTENSION_LEVELS - 1
                            multiplier = level_idx + 1  // L1=1x, L2=2x, L3=3x

                            // HIGH EXTENSIONS
                            // Calculate level price
                            extended_high_val = high_val + (multiplier * monthlyExtensionDistance)

                            // Get end time for this level
                            level_breached = array.get(high_ext.breached, level_idx)
                            level_breach_time = array.get(high_ext.breach_times, level_idx)
                            level_end_time = level_breached and not na(level_breach_time) ? level_breach_time : time

                            // Draw horizontal extension line
                            high_ext_line = line.new(high_time, extended_high_val, level_end_time, extended_high_val, xloc=xloc.bar_time, color=extensionColor, width=extensionLineWidth, style=line.style_dashed)
                            array.push(all_lines, high_ext_line)

                            // Draw vertical connector from L0 to this level
                            high_connector = line.new(high_time, high_val, high_time, extended_high_val, xloc=xloc.bar_time, color=color.new(extensionColor, 80), width=extensionLineWidth, style=line.style_solid)
                            array.push(all_lines, high_connector)

                    if low_breached
                        // Get extension data for this pool entry
                        low_ext = array.get(monthly_pool.low_extensions, idx)

                        // Draw all extension levels dynamically
                        for level_idx = 0 to NUM_EXTENSION_LEVELS - 1
                            multiplier = level_idx + 1  // L1=1x, L2=2x, L3=3x

                            // LOW EXTENSIONS
                            // Calculate level price
                            extended_low_val = low_val - (multiplier * monthlyExtensionDistance)

                            // Get end time for this level
                            level_breached_low = array.get(low_ext.breached, level_idx)
                            level_breach_time_low = array.get(low_ext.breach_times, level_idx)
                            level_end_time_low = level_breached_low and not na(level_breach_time_low) ? level_breach_time_low : time

                            // Draw horizontal extension line
                            low_ext_line = line.new(low_time, extended_low_val, level_end_time_low, extended_low_val, xloc=xloc.bar_time, color=extensionColor, width=extensionLineWidth, style=line.style_dashed)
                            array.push(all_lines, low_ext_line)

                            // Draw vertical connector from L0 to this level
                            low_connector = line.new(low_time, low_val, low_time, extended_low_val, xloc=xloc.bar_time, color=color.new(extensionColor, 80), width=extensionLineWidth, style=line.style_solid)
                            array.push(all_lines, low_connector)

                // Draw labels
                if showLabels
                    label_text = build_label(POOL_TYPE_MONTHLY)
                    high_breached = array.get(monthly_pool.high_breached, idx)
                    low_breached = array.get(monthly_pool.low_breached, idx)

                    high_label_time = high_breached ? int((high_time + high_end_time) / 2) : high_end_time
                    high_label = label.new(high_label_time, high_val, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                    array.push(all_labels, high_label)

                    low_label_time = low_breached ? int((low_time + low_end_time) / 2) : low_end_time
                    low_label = label.new(low_label_time, low_val, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                    array.push(all_labels, low_label)

                    // Monthly extension labels if toggle is enabled AND asset is supported AND timeframe is valid
                    if applyExtension and isAssetSupported and isMonthlyExtensionTimeframeValid and monthlyExtensionDistance > 0
                        // Check if L0 is breached (prerequisite for showing extensions)
                        high_breached_labels = array.get(monthly_pool.high_breached, idx)
                        low_breached_labels = array.get(monthly_pool.low_breached, idx)

                        // Only show high extension labels if L0 high is breached
                        if high_breached_labels
                            high_ext_labels = array.get(monthly_pool.high_extensions, idx)

                            for level_idx = 0 to NUM_EXTENSION_LEVELS - 1
                                multiplier = level_idx + 1
                                label_text_ext = "L" + str.tostring(multiplier)

                                // High extension label
                                extended_high_val_label = high_val + (multiplier * monthlyExtensionDistance)
                                ext_high_label = label.new(high_label_time, extended_high_val_label, label_text_ext, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                                array.push(all_labels, ext_high_label)

                        // Only show low extension labels if L0 low is breached
                        if low_breached_labels
                            low_ext_labels = array.get(monthly_pool.low_extensions, idx)

                            for level_idx = 0 to NUM_EXTENSION_LEVELS - 1
                                multiplier = level_idx + 1
                                label_text_ext = "L" + str.tostring(multiplier)

                                // Low extension label
                                extended_low_val_label = low_val - (multiplier * monthlyExtensionDistance)
                                ext_low_label = label.new(low_label_time, extended_low_val_label, label_text_ext, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                                array.push(all_labels, ext_low_label)

    // Draw Info Table
    if showInfoTable
        // Determine table position
        table_position = infoTablePosition == "top_left" ? position.top_left : infoTablePosition == "top_right" ? position.top_right : infoTablePosition == "bottom_left" ? position.bottom_left : position.bottom_right

        // Calculate dynamic row count
        rowCount = 2  // Asset + TF always shown
        rowCount := rowCount + (isDailyExtensionTimeframeValid ? 2 : 0)  // Daily values + labels
        rowCount := rowCount + (isWeeklyExtensionTimeframeValid ? 2 : 0)  // Weekly values + labels
        rowCount := rowCount + (isMonthlyExtensionTimeframeValid ? 2 : 0)  // Monthly values + labels

        // Create dynamic table
        var table infoTable = table.new(table_position, 2, rowCount, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

        currentRow = 0

        // Asset
        table.cell(infoTable, 0, currentRow, "Asset", text_color=color.white, bgcolor=color.new(color.gray, 10), text_size=size.tiny)
        table.cell(infoTable, 1, currentRow, detectedAsset, text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.tiny)
        currentRow := currentRow + 1

        // Timeframe
        table.cell(infoTable, 0, currentRow, "TF", text_color=color.white, bgcolor=color.new(color.gray, 10), text_size=size.tiny)
        table.cell(infoTable, 1, currentRow, timeframe.period, text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.tiny)
        currentRow := currentRow + 1

        // Daily Extensions (only if valid)
        if isDailyExtensionTimeframeValid
            dailyL1 = str.tostring(dailyExtensionDistance)
            dailyL2 = str.tostring(dailyExtensionDistance * 2)
            dailyL3 = str.tostring(dailyExtensionDistance * 3)
            dailyLevels = dailyL1 + " | " + dailyL2 + " | " + dailyL3
            table.cell(infoTable, 0, currentRow, "Daily", text_color=color.white, bgcolor=color.new(color.gray, 10), text_size=size.tiny)
            table.cell(infoTable, 1, currentRow, dailyLevels, text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.tiny)
            currentRow := currentRow + 1

            // Daily Level Labels
            table.cell(infoTable, 0, currentRow, "", text_color=color.white, bgcolor=color.new(color.gray, 10), text_size=size.tiny)
            table.cell(infoTable, 1, currentRow, "L1 | L2 | L3", text_color=color.new(color.white, 50), bgcolor=color.new(color.gray, 20), text_size=size.tiny)
            currentRow := currentRow + 1

        // Weekly Extensions (only if valid)
        if isWeeklyExtensionTimeframeValid
            weeklyL1 = str.tostring(weeklyExtensionDistance)
            weeklyL2 = str.tostring(weeklyExtensionDistance * 2)
            weeklyL3 = str.tostring(weeklyExtensionDistance * 3)
            weeklyLevels = weeklyL1 + " | " + weeklyL2 + " | " + weeklyL3
            table.cell(infoTable, 0, currentRow, "Weekly", text_color=color.white, bgcolor=color.new(color.gray, 10), text_size=size.tiny)
            table.cell(infoTable, 1, currentRow, weeklyLevels, text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.tiny)
            currentRow := currentRow + 1

            // Weekly Level Labels
            table.cell(infoTable, 0, currentRow, "", text_color=color.white, bgcolor=color.new(color.gray, 10), text_size=size.tiny)
            table.cell(infoTable, 1, currentRow, "L1 | L2 | L3", text_color=color.new(color.white, 50), bgcolor=color.new(color.gray, 20), text_size=size.tiny)
            currentRow := currentRow + 1

        // Monthly Extensions (only if valid)
        if isMonthlyExtensionTimeframeValid
            monthlyL1 = str.tostring(monthlyExtensionDistance)
            monthlyL2 = str.tostring(monthlyExtensionDistance * 2)
            monthlyL3 = str.tostring(monthlyExtensionDistance * 3)
            monthlyLevels = monthlyL1 + " | " + monthlyL2 + " | " + monthlyL3
            table.cell(infoTable, 0, currentRow, "Monthly", text_color=color.white, bgcolor=color.new(color.gray, 10), text_size=size.tiny)
            table.cell(infoTable, 1, currentRow, monthlyLevels, text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.tiny)
            currentRow := currentRow + 1

            // Monthly Level Labels
            table.cell(infoTable, 0, currentRow, "", text_color=color.white, bgcolor=color.new(color.gray, 10), text_size=size.tiny)
            table.cell(infoTable, 1, currentRow, "L1 | L2 | L3", text_color=color.new(color.white, 50), bgcolor=color.new(color.gray, 20), text_size=size.tiny)
