//@version=6

// ═══════════════════════════════════════════════════════════════════════════════
// INDICATOR SETUP
// ═══════════════════════════════════════════════════════════════════════════════
INDICATOR_MAX_LINES = 300
INDICATOR_MAX_LABELS = 300
INDICATOR_TITLE = 'Playful Prime° [Pro+]'

indicator(INDICATOR_TITLE, shorttitle='Playful Prime° [Pro+]', overlay=true, max_lines_count=INDICATOR_MAX_LINES, max_labels_count=INDICATOR_MAX_LABELS)

