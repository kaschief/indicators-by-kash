POOL_TYPE_WEEKLY = "weekly"
POOL_TYPE_MONTHLY = "monthly"
POOL_TYPE_ASIA = "asia"
POOL_TYPE_LONDON = "london"
POOL_TYPE_NYAM = "nyam"
POOL_TYPE_LUNCH = "lunch"
POOL_TYPE_NYPM = "nypm"
POOL_TYPE_PREMARKET = "premarket"
POOL_TYPE_OVERNIGHT = "overnight"

// Line style options
STYLE_SOLID = "Solid"
STYLE_DASHED = "Dashed"
STYLE_DOTTED = "Dotted"

// Day names
DAY_MON = "MON"
DAY_TUE = "TUE"
DAY_WED = "WED"
DAY_THU = "THU"
DAY_FRI = "FRI"
DAY_SAT = "SAT"
DAY_SUN = "SUN"

// Time divider options
DIVIDER_MIDNIGHT = "Midnight"
DIVIDER_SUNDAY_REOPEN = "Sunday Reopen"

// UI group names
