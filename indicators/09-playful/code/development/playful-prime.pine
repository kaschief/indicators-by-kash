UI_SHOW_LAST = "Show Last"
UI_COLOR = "Color"
UI_WIDTH = "Width"
UI_SHOW_LABELS = "Show Labels"
UI_TEXT_COLOR = "Text Color"
UI_INCLUDE_SUNDAY_EVENING = "Include Sunday Evening"
UI_TOOLTIP_SUNDAY_EVENING = "SUNDAY EVENING LIQUIDITY (Traditional markets):\n\nForex/Futures reopen Sunday 18:00 NY time after Friday close. This 6-hour period is technically \"Sunday\" but traders often consider it Monday's session start.\n\n• ON (default): Include Sunday 18:00-00:00 in HTF liquidity pools (Daily, Weekly, Monthly)\n• OFF: Skip Sunday evening, start fresh Monday 00:00\n\nNote: Crypto/24-7 assets auto-detected and ignore this setting (always include all weekend hours)"
UI_ASIA_SESSION = "Asia Session"
UI_LONDON_SESSION = "London Session"
UI_NYAM_SESSION = "NY AM Session"
UI_LUNCH_SESSION = "Lunch Session"
UI_NYPM_SESSION = "NY PM Session"
UI_PREMARKET_SESSION = "Premarket Session"
UI_OVERNIGHT_SESSION = "Overnight Session"
UI_RANGE_BOX = "Range Box"
UI_SHOW_RANGE_BOX = "Show Range Box"
UI_RANGE_SESSION_TIME = "Range Time"
UI_BOX_COLOR = "Box Color"
UI_MIDDLE_LINE = "Show Middle Line"
UI_SHOW_TIME_DIVIDERS = "Show Time Dividers"
UI_DIVIDER_TIME = "Divider Time"
UI_DIVIDER_STYLE = "Style"

// Session time defaults
DEFAULT_ASIA_SESSION_TIME = "2000-0000" + DAY_CODE_MON_SAT
DEFAULT_LONDON_SESSION_TIME = "0200-0500" + DAY_CODE_MON_SAT
DEFAULT_NYAM_SESSION_TIME = "0930-1200" + DAY_CODE_MON_SAT
DEFAULT_LUNCH_SESSION_TIME = "1200-1330" + DAY_CODE_MON_SAT
DEFAULT_NYPM_SESSION_TIME = "1330-1600" + DAY_CODE_MON_SAT
DEFAULT_PREMARKET_SESSION_TIME = "0500-0915" + DAY_CODE_MON_SAT
DEFAULT_OVERNIGHT_SESSION_TIME = "1600-0500" + DAY_CODE_MON_SAT
DEFAULT_RANGE_SESSION_TIME = "0200-0215" + DAY_CODE_MON_SAT

// Default colors
DEFAULT_DAILY_COLOR = #9c27b0
DEFAULT_WEEKLY_COLOR = #ec407a
DEFAULT_MONTHLY_COLOR = #ff9800
DEFAULT_INTRADAY_COLOR = #00bcd4
DEFAULT_PREMARKET_COLOR = #1565c0
DEFAULT_OVERNIGHT_COLOR = #4caf50
DEFAULT_RANGE_BOX_COLOR = #2196f3
DEFAULT_RANGE_MIDDLE_COLOR = #ff9800
DEFAULT_RANGE_BG_COLOR = color.new(#2196f3, 90)
DEFAULT_TIME_DIVIDER_COLOR = #808080
DEFAULT_LABEL_TEXT_COLOR = color.black

// Scan caps
DAILY_SCAN_CAP = 100
WEEKLY_SCAN_CAP = 50
MONTHLY_SCAN_CAP = 30
ASIA_SCAN_CAP = 50
LONDON_SCAN_CAP = 50
NYAM_SCAN_CAP = 50
LUNCH_SCAN_CAP = 50
NYPM_SCAN_CAP = 50
PREMARKET_SCAN_CAP = 50
OVERNIGHT_SCAN_CAP = 50
RANGE_BOX_SCAN_CAP = 20
TIME_DIVIDER_SCAN_CAP = 100

// Range box timeframe limits (in seconds)
RANGE_BOX_MIN_TIMEFRAME = 60    // 1 minute
RANGE_BOX_MAX_TIMEFRAME = 900   // 15 minutes

// Input limits
SHOW_LAST_MIN = 1
SHOW_LAST_MAX = 50
LINE_WIDTH_MIN = 1
LINE_WIDTH_MAX = 5

// ═══════════════════════════════════════════════════════════════════════════════
// TYPE DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════════════

type LiquidityPool
    array<float> highs
    array<float> lows
    array<int> high_times
    array<int> low_times
    array<bool> high_breached
    array<bool> low_breached
    array<int> high_breach_times
    array<int> low_breach_times
    float current_high
    float current_low
    int current_high_time
    int current_low_time

type RangeBox
    array<float> highs
    array<float> lows
    array<int> start_times
    array<int> end_times
    float current_high
    float current_low
    int current_start_time

type TimeDivider
    array<int> divider_times
    array<int> midpoint_times
    array<string> midpoint_days

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

showDaily = input.bool(true, UI_SHOW + GROUP_DAILY, group=GROUP_DAILY)
dailyShowLast = input.int(5, UI_SHOW_LAST, minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX, group=GROUP_DAILY, inline='daily')
dailyColor = input.color(DEFAULT_DAILY_COLOR, UI_COLOR, group=GROUP_DAILY, inline='daily')
dailyLineWidth = input.int(2, UI_WIDTH, minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group=GROUP_DAILY, inline='daily')

showWeekly = input.bool(true, UI_SHOW + GROUP_WEEKLY, group=GROUP_WEEKLY)
weeklyShowLast = input.int(5, UI_SHOW_LAST, minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX, group=GROUP_WEEKLY, inline='weekly')
weeklyColor = input.color(DEFAULT_WEEKLY_COLOR, UI_COLOR, group=GROUP_WEEKLY, inline='weekly')
weeklyLineWidth = input.int(3, UI_WIDTH, minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group=GROUP_WEEKLY, inline='weekly')

showMonthly = input.bool(true, UI_SHOW + GROUP_MONTHLY, group=GROUP_MONTHLY)
