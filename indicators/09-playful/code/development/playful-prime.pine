showNyam = input.bool(true, UI_SHOW + UI_NYAM_SESSION, group=GROUP_INTRADAY, inline='nyam')
nyamSessionTime = input.session(DEFAULT_NYAM_SESSION_TIME, "", group=GROUP_INTRADAY, inline='nyam')

showLunch = input.bool(true, UI_SHOW + UI_LUNCH_SESSION, group=GROUP_INTRADAY, inline='lunch')
lunchSessionTime = input.session(DEFAULT_LUNCH_SESSION_TIME, "", group=GROUP_INTRADAY, inline='lunch')

showNypm = input.bool(true, UI_SHOW + UI_NYPM_SESSION, group=GROUP_INTRADAY, inline='nypm')
nypmSessionTime = input.session(DEFAULT_NYPM_SESSION_TIME, "", group=GROUP_INTRADAY, inline='nypm')

intradayShowLast = input.int(5, UI_SHOW_LAST, minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX, group=GROUP_INTRADAY, inline='intraday')
intradayColor = input.color(DEFAULT_INTRADAY_COLOR, UI_COLOR, group=GROUP_INTRADAY, inline='intraday')
intradayLineWidth = input.int(2, UI_WIDTH, minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group=GROUP_INTRADAY, inline='intraday')

showPremarket = input.bool(true, UI_SHOW + UI_PREMARKET_SESSION, group=GROUP_POISZN, inline='premarket')
premarketSessionTime = input.session(DEFAULT_PREMARKET_SESSION_TIME, "", group=GROUP_POISZN, inline='premarket')

showOvernight = input.bool(true, UI_SHOW + UI_OVERNIGHT_SESSION, group=GROUP_POISZN, inline='overnight')
overnightSessionTime = input.session(DEFAULT_OVERNIGHT_SESSION_TIME, "", group=GROUP_POISZN, inline='overnight')

premarketColor = input.color(DEFAULT_PREMARKET_COLOR, UI_PREMARKET_SESSION + " " + UI_COLOR, group=GROUP_POISZN, inline='colors')
overnightColor = input.color(DEFAULT_OVERNIGHT_COLOR, UI_OVERNIGHT_SESSION + " " + UI_COLOR, group=GROUP_POISZN, inline='colors')

poisznShowLast = input.int(5, UI_SHOW_LAST, minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX, group=GROUP_POISZN, inline='poiszn')
poisznLineWidth = input.int(2, UI_WIDTH, minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group=GROUP_POISZN, inline='poiszn')

showRangeBox = input.bool(false, UI_SHOW_RANGE_BOX, group=GROUP_RANGE_BOX)
