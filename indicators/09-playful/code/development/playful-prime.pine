rangeMiddleColor = input.color(DEFAULT_RANGE_MIDDLE_COLOR, "Middle " + UI_COLOR, group=GROUP_RANGE_BOX, inline='range_style')
showRangeMiddleLine = input.bool(true, UI_MIDDLE_LINE, group=GROUP_RANGE_BOX, inline='range_options')
rangeBoxShowLast = input.int(10, UI_SHOW_LAST, minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX, group=GROUP_RANGE_BOX, inline='range_options')
rangeBoxWidth = input.int(2, UI_WIDTH, minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group=GROUP_RANGE_BOX, inline='range_options')

showTimeDividers = input.bool(false, "Show Midnight Dividers", group=GROUP_TIME_DIVIDERS)
