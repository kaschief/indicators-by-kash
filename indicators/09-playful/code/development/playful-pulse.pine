mondayLabelColor = input.color(DEFAULT_MONDAY_LABEL_COLOR, "Monday", group=GROUP_TIME_DIVIDERS, inline='day_labels')

showLabels = input.bool(true, GROUP_LABELS, group=GROUP_LABELS, inline='labels')
labelTextColor = input.color(DEFAULT_LABEL_TEXT_COLOR, UI_TEXT_COLOR, group=GROUP_LABELS, inline='labels')
labelOffsetEnabled = input.bool(false, "Smart Label Separation", group=GROUP_LABELS, inline='labels', tooltip="Enable vertical offset stacking to prevent label collisions. Automatically adapts spacing based on asset volatility. Turn ON only if you see overlapping labels.")

// ─── Asset Levels Table ───
showAssetLevelsTable = input.bool(false, "Show Asset Levels", group=GROUP_LABELS, tooltip="Display a table showing detected asset and its liquidity depth levels")

// ─── Color Reference Table ───
showColorTable = input.bool(false, "Show Color Reference Table", group=GROUP_COLOR_TABLE, tooltip="Display a table showing all color settings with RGB values and transparency levels")

// ─── Alerts ───
alertDaily = input.bool(true, "Daily", group=GROUP_ALERTS, inline="alert_htf")
alertWeekly = input.bool(true, "Weekly", group=GROUP_ALERTS, inline="alert_htf")
alertMonthly = input.bool(true, "Monthly", group=GROUP_ALERTS, inline="alert_htf")
alertIntraday = input.bool(false, "Intraday", group=GROUP_ALERTS, inline="alert_sessions", tooltip="Asia, London, NY AM, Lunch, NY PM")
alertOvernight = input.bool(true, "Overnight", group=GROUP_ALERTS, inline="alert_sessions")
alertPremarket = input.bool(true, "Premarket", group=GROUP_ALERTS, inline="alert_sessions")
alert1600Close = input.bool(true, "16:00 Mitigation", group=GROUP_ALERTS, tooltip="Alert when 16:00 close level is mitigated")

// ═══════════════════════════════════════════════════════════════════════════════
// PULSE MODE FILTER LOGIC
// ═══════════════════════════════════════════════════════════════════════════════

// Apply Pulse Mode filter to determine if a pool type should be shown
// Overrides individual ON/OFF toggles when filter is not "All"
applyPulseModeFilter(poolType, individualToggle) =>
    bool result = individualToggle

    if pulseModeFilter == FILTER_MONTHLY
        result := poolType == POOL_TYPE_MONTHLY
    else if pulseModeFilter == FILTER_WEEKLY
        result := poolType == POOL_TYPE_WEEKLY
    else if pulseModeFilter == FILTER_DAILY
        result := poolType == POOL_TYPE_DAILY
    else if pulseModeFilter == FILTER_HTF
        result := poolType == POOL_TYPE_DAILY or poolType == POOL_TYPE_WEEKLY or poolType == POOL_TYPE_MONTHLY
    else if pulseModeFilter == FILTER_INTRADAY
        result := poolType == POOL_TYPE_ASIA or poolType == POOL_TYPE_LONDON or poolType == POOL_TYPE_NYAM or poolType == POOL_TYPE_LUNCH or poolType == POOL_TYPE_NYPM
    else if pulseModeFilter == FILTER_INTRADAY_PREMARKET_OVERNIGHT
        result := poolType == POOL_TYPE_ASIA or poolType == POOL_TYPE_LONDON or poolType == POOL_TYPE_NYAM or poolType == POOL_TYPE_LUNCH or poolType == POOL_TYPE_NYPM or poolType == POOL_TYPE_PREMARKET or poolType == POOL_TYPE_OVERNIGHT
    else if pulseModeFilter == FILTER_PREMARKET_OVERNIGHT
        result := poolType == POOL_TYPE_PREMARKET or poolType == POOL_TYPE_OVERNIGHT
    else if pulseModeFilter == FILTER_1400_1600
        result := poolType == POOL_TYPE_1400 or poolType == POOL_TYPE_1600
    else if pulseModeFilter == FILTER_KEY_OPENS
        result := poolType == POOL_TYPE_MNO_OPEN or poolType == POOL_TYPE_830_OPEN or poolType == POOL_TYPE_930_OPEN
    else if pulseModeFilter == FILTER_HTF_OPENS
        result := poolType == POOL_TYPE_DAILY_OPEN or poolType == POOL_TYPE_WEEKLY_OPEN or poolType == POOL_TYPE_MONTHLY_OPEN
    else if pulseModeFilter == FILTER_4H_OPEN
        result := poolType == POOL_TYPE_4H_OPEN
    else if pulseModeFilter == FILTER_10AM_4H_OPEN
        result := poolType == POOL_TYPE_4H_OPEN
    else if pulseModeFilter == FILTER_1H_OPEN
        result := poolType == POOL_TYPE_1H_OPEN
    else if pulseModeFilter == FILTER_RANGE_BOX
        result := poolType == POOL_TYPE_RANGE_BOX
    else if pulseModeFilter == FILTER_RANGE_BOX_MNO
        result := poolType == POOL_TYPE_RANGE_BOX or poolType == POOL_TYPE_MNO_OPEN
    else if pulseModeFilter == FILTER_RANGE_BOX_1600
        result := poolType == POOL_TYPE_RANGE_BOX or poolType == POOL_TYPE_1600
    else if pulseModeFilter == FILTER_1400_1600_RANGE_BOX
        result := poolType == POOL_TYPE_1400 or poolType == POOL_TYPE_1600 or poolType == POOL_TYPE_RANGE_BOX
    else if pulseModeFilter == FILTER_LIQUIDITY_MAP
        result := poolType == POOL_TYPE_RANGE_BOX or poolType == POOL_TYPE_1400 or poolType == POOL_TYPE_1600 or poolType == POOL_TYPE_PREMARKET or poolType == POOL_TYPE_OVERNIGHT
    else if pulseModeFilter == FILTER_TODAY
        result := poolType == POOL_TYPE_RANGE_BOX or poolType == POOL_TYPE_1400 or poolType == POOL_TYPE_1600 or poolType == POOL_TYPE_PREMARKET or poolType == POOL_TYPE_OVERNIGHT or poolType == POOL_TYPE_DAILY or poolType == POOL_TYPE_WEEKLY or poolType == POOL_TYPE_MONTHLY or poolType == POOL_TYPE_MNO_OPEN or poolType == POOL_TYPE_830_OPEN or poolType == POOL_TYPE_930_OPEN
    else if pulseModeFilter == FILTER_RANGE_KEY_OPENS
        result := poolType == POOL_TYPE_RANGE_BOX or poolType == POOL_TYPE_1400 or poolType == POOL_TYPE_1600 or poolType == POOL_TYPE_MNO_OPEN or poolType == POOL_TYPE_830_OPEN or poolType == POOL_TYPE_930_OPEN
    else if pulseModeFilter == FILTER_WORK_RANGE_KEY_OPENS_HTF
        result := poolType == POOL_TYPE_RANGE_BOX or poolType == POOL_TYPE_1400 or poolType == POOL_TYPE_1600 or poolType == POOL_TYPE_MNO_OPEN or poolType == POOL_TYPE_830_OPEN or poolType == POOL_TYPE_930_OPEN or poolType == POOL_TYPE_DAILY or poolType == POOL_TYPE_WEEKLY or poolType == POOL_TYPE_MONTHLY
    else if pulseModeFilter == FILTER_DAYS
        result := false  // Hide all pools, only show time dividers
    // else FILTER_ALL - use individual toggle

    result

// Apply Pulse Mode filter and timeframe visibility to each pool type
// HTF levels hidden on their native timeframe or higher (e.g., Daily hidden on Daily/Weekly/Monthly)
showDailyFiltered = applyPulseModeFilter(POOL_TYPE_DAILY, showDaily) and timeframe.in_seconds() < 86400  // Hide on Daily or higher
showWeeklyFiltered = applyPulseModeFilter(POOL_TYPE_WEEKLY, showWeekly) and timeframe.in_seconds() < 604800  // Hide on Weekly or higher
showMonthlyFiltered = applyPulseModeFilter(POOL_TYPE_MONTHLY, showMonthly) and timeframe.in_seconds() < 2592000  // Hide on Monthly
showAsiaFiltered = applyPulseModeFilter(POOL_TYPE_ASIA, showIntraday)
showLondonFiltered = applyPulseModeFilter(POOL_TYPE_LONDON, showIntraday)
showNyamFiltered = applyPulseModeFilter(POOL_TYPE_NYAM, showIntraday)
showLunchFiltered = applyPulseModeFilter(POOL_TYPE_LUNCH, showIntraday)
showNypmFiltered = applyPulseModeFilter(POOL_TYPE_NYPM, showIntraday)
showPremarketFiltered = applyPulseModeFilter(POOL_TYPE_PREMARKET, showPremarket)
showOvernightFiltered = applyPulseModeFilter(POOL_TYPE_OVERNIGHT, showOvernight)
show1400CloseFiltered = applyPulseModeFilter(POOL_TYPE_1400, show1400Close)
show1600CloseFiltered = applyPulseModeFilter(POOL_TYPE_1600, show1600Close)
show4HOpenFiltered = applyPulseModeFilter(POOL_TYPE_4H_OPEN, show4HOpen)
show1HOpenFiltered = applyPulseModeFilter(POOL_TYPE_1H_OPEN, show1HOpen)
showMnoOpenFiltered = applyPulseModeFilter(POOL_TYPE_MNO_OPEN, showMnoOpen)
show830OpenFiltered = applyPulseModeFilter(POOL_TYPE_830_OPEN, show830Open)
show930OpenFiltered = applyPulseModeFilter(POOL_TYPE_930_OPEN, show930Open)
showDailyOpenFiltered = applyPulseModeFilter(POOL_TYPE_DAILY_OPEN, showDailyOpen)
showWeeklyOpenFiltered = applyPulseModeFilter(POOL_TYPE_WEEKLY_OPEN, showWeeklyOpen)
showMonthlyOpenFiltered = applyPulseModeFilter(POOL_TYPE_MONTHLY_OPEN, showMonthlyOpen)
showRangeBoxFiltered = applyPulseModeFilter(POOL_TYPE_RANGE_BOX, showRangeBox)

// "Today" filter: override show last values to 1 (most recent only) and auto-enable liquidity depth
isTodayFilter = pulseModeFilter == FILTER_TODAY
effectiveDailyShowLast = isTodayFilter ? 1 : dailyShowLast
effectiveWeeklyShowLast = isTodayFilter ? 1 : weeklyShowLast
effectiveMonthlyShowLast = isTodayFilter ? 1 : monthlyShowLast
effectivePoisznShowLast = isTodayFilter ? 1 : poisznShowLast
effectiveClose1400ShowLast = isTodayFilter ? 5 : close1400ShowLast  // Scan 5 levels to find unmitigated
effectiveClose1600ShowLast = isTodayFilter ? 5 : close1600ShowLast  // Scan 5 levels to find unmitigated
effectiveClose1400MaxUnmitigated = isTodayFilter ? 1 : 999  // Today: show only 1 unmitigated
effectiveClose1600MaxUnmitigated = isTodayFilter ? 1 : 999  // Today: show only 1 unmitigated
effectiveClose1400SkipHistoricalMitigated = isTodayFilter  // Today: only show mitigated from today
effectiveClose1600SkipHistoricalMitigated = isTodayFilter  // Today: only show mitigated from today
effectiveOpenMnoShowLast = isTodayFilter ? 1 : openMnoShowLast
effectiveOpen830ShowLast = isTodayFilter ? 1 : open830ShowLast
effectiveOpen930ShowLast = isTodayFilter ? 1 : open930ShowLast
effectiveEnableDailyLiquidityDepth = isTodayFilter ? true : enableDailyLiquidityDepth
effectiveEnableWeeklyLiquidityDepth = isTodayFilter ? true : enableWeeklyLiquidityDepth
effectiveEnableMonthlyLiquidityDepth = isTodayFilter ? true : enableMonthlyLiquidityDepth
effectiveEnableIntradayLiquidityDepth = isTodayFilter ? true : enableIntradayLiquidityDepth
effectiveEnableOvernightLiquidityDepth = isTodayFilter ? true : enableOvernightLiquidityDepth
effectiveEnablePremarketLiquidityDepth = isTodayFilter ? true : enablePremarketLiquidityDepth
// Today filter: bypass 5-minute timeframe restriction for HTF liquidity depth
effectiveIsDailyLiquidityDepthTimeframeValid = isTodayFilter ? (currentTimeframeMinutes >= 5 and currentTimeframeMinutes <= 60) : isDailyLiquidityDepthTimeframeValid
effectiveIsWeeklyLiquidityDepthTimeframeValid = isTodayFilter ? (currentTimeframeMinutes >= 5 and currentTimeframeMinutes <= 720) : isWeeklyLiquidityDepthTimeframeValid
effectiveIsMonthlyLiquidityDepthTimeframeValid = isTodayFilter ? (currentTimeframeMinutes >= 5 and currentTimeframeMinutes <= 10080) : isMonthlyLiquidityDepthTimeframeValid
// Today filter: force Pool Colors preset for all Liquidity Depth sections
effectiveDailyLiqDepthColorPreset = isTodayFilter ? LIQUIDITY_DEPTH_PRESET_POOL_COLORS : dailyLiqDepthColorPreset
effectiveWeeklyLiqDepthColorPreset = isTodayFilter ? LIQUIDITY_DEPTH_PRESET_POOL_COLORS : weeklyLiqDepthColorPreset
effectiveMonthlyLiqDepthColorPreset = isTodayFilter ? LIQUIDITY_DEPTH_PRESET_POOL_COLORS : monthlyLiqDepthColorPreset
effectiveIntradayLiqDepthColorPreset = isTodayFilter ? LIQUIDITY_DEPTH_PRESET_POOL_COLORS : intradayLiqDepthColorPreset
effectiveOvernightLiqDepthColorPreset = isTodayFilter ? LIQUIDITY_DEPTH_PRESET_POOL_COLORS : overnightLiqDepthColorPreset
effectivePremarketLiqDepthColorPreset = isTodayFilter ? LIQUIDITY_DEPTH_PRESET_POOL_COLORS : premarketLiqDepthColorPreset

// ═══════════════════════════════════════════════════════════════════════════════
// 24/7 ASSET AUTO-DETECTION & SUNDAY LIQUIDITY HANDLING
// ═══════════════════════════════════════════════════════════════════════════════

// Auto-detect 24/7 asset by scanning for weekend bars (excluding Sunday 18:00+ reopen)
// STRATEGY: Default TRUE (assume 24/7), only set FALSE after scanning 7+ days with no weekends
//
// AUTOMATIC SUNDAY EVENING BEHAVIOR:
// • 24/7 assets (crypto): Sunday evening is normal trading → always included
// • Traditional assets (forex/futures): Sunday 18:00-23:59 is thin reopening liquidity → automatically excluded
var bool is247Asset = true
var bool detectionCompleted = false

// Only run detection once after we have 7+ days of data
if not detectionCompleted
    barsIn7Days = int(10080 / (timeframe.in_seconds() / 60))

    if bar_index >= barsIn7Days
        // Check current bar first (fast path - if we loaded on Saturday, instant detect)
        currentDay = dayofweek(time, NY_TIMEZONE)
        currentHour = hour(time, NY_TIMEZONE)
        isSaturdayNow = currentDay == dayofweek.saturday
        isEarlySundayNow = currentDay == dayofweek.sunday and currentHour < SUNDAY_REOPEN_START_HOUR

        if isSaturdayNow or isEarlySundayNow
            // Current bar is weekend - definitely 24/7
            is247Asset := true
        else
            // Scan last 7 days for weekend bars
            maxLookback = math.min(9999, barsIn7Days)
            foundWeekendBar = false

            for lookback = 0 to maxLookback by 20
                checkDay = dayofweek(time[lookback], NY_TIMEZONE)
                checkHour = hour(time[lookback], NY_TIMEZONE)

                isSaturday = checkDay == dayofweek.saturday
                isEarlySunday = checkDay == dayofweek.sunday and checkHour < SUNDAY_REOPEN_START_HOUR
                if isSaturday or isEarlySunday
                    foundWeekendBar := true
                    break

            // Set result based on scan
            is247Asset := foundWeekendBar

        detectionCompleted := true

// Calculate session strings after detection (apply day codes)
// Traditional assets handle Sunday evening exclusion via should_skip_sunday_liquidity()
actualAsiaSession := is247Asset ? ("2000-0000" + DAY_CODE_ALL_DAYS) : (str.replace_all(DEFAULT_ASIA_SESSION_TIME, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualLondonSession := is247Asset ? ("0200-0500" + DAY_CODE_ALL_DAYS) : (str.replace_all(DEFAULT_LONDON_SESSION_TIME, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualNyamSession := is247Asset ? ("0930-1200" + DAY_CODE_ALL_DAYS) : (str.replace_all(DEFAULT_NYAM_SESSION_TIME, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualLunchSession := is247Asset ? ("1200-1330" + DAY_CODE_ALL_DAYS) : (str.replace_all(DEFAULT_LUNCH_SESSION_TIME, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualNypmSession := is247Asset ? ("1330-1600" + DAY_CODE_ALL_DAYS) : (str.replace_all(DEFAULT_NYPM_SESSION_TIME, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualPremarketSession := is247Asset ? ("0500-0915" + DAY_CODE_ALL_DAYS) : (str.replace_all(DEFAULT_PREMARKET_SESSION_TIME, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualOvernightSession := is247Asset ? ("1600-0500" + DAY_CODE_ALL_DAYS) : (str.replace_all(DEFAULT_OVERNIGHT_SESSION_TIME, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualRangeSession := is247Asset ? ("0200-0215" + DAY_CODE_ALL_DAYS) : (str.replace_all(rangeSessionTime, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)

// ═══════════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

create_pool() =>
    LiquidityPool.new(array.new_float(), array.new_float(), array.new_int(), array.new_int(), array.new_bool(), array.new_bool(), array.new_int(), array.new_int(), array.new_int(), array.new_int(), array.new<LiquidityDepthLevels>(), array.new<LiquidityDepthLevels>(), array.new<LiquidityDepthLevels>(), array.new<LiquidityDepthLevels>(), na, na, na, na, na)

create_range_box() =>
    RangeBox.new(array.new_float(), array.new_float(), array.new_int(), array.new_int(), na, na, na)

create_time_divider() =>
    TimeDivider.new(array.new_int(), array.new_int(), array.new_string())

create_1400_close() =>
    IntradayClosingPriceTracker.new(array.new_float(), array.new_int(), array.new_bool(), array.new_int(), array.new_int(), na, na, false, na, na)

create_1600_close() =>
    IntradayClosingPriceTracker.new(array.new_float(), array.new_int(), array.new_bool(), array.new_int(), array.new_int(), na, na, false, na, na)

create_tf_open() =>
    TimeframeOpenTracker.new(array.new_float(), array.new_int(), array.new_int(), na, na, na)

// Array pruning functions - keep arrays bounded to prevent memory growth
prune_tf_tracker(TimeframeOpenTracker tracker, int maxSize) =>
    while array.size(tracker.opens) > maxSize
        array.shift(tracker.opens)
        array.shift(tracker.times)
        array.shift(tracker.hours)

prune_intraday_tracker(IntradayClosingPriceTracker tracker, int maxSize) =>
    while array.size(tracker.closes) > maxSize
        array.shift(tracker.closes)
        array.shift(tracker.times)
        array.shift(tracker.mitigated)
        array.shift(tracker.mitigation_times)
        array.shift(tracker.capture_hours)

prune_pool(LiquidityPool pool, int maxSize) =>
    while array.size(pool.highs) > maxSize
        array.shift(pool.highs)
        array.shift(pool.lows)
        array.shift(pool.high_times)
        array.shift(pool.low_times)
        array.shift(pool.high_breached)
        array.shift(pool.low_breached)
        array.shift(pool.high_breach_times)
        array.shift(pool.low_breach_times)
        if array.size(pool.session_start_times) > 0
            array.shift(pool.session_start_times)
        if array.size(pool.session_end_times) > 0
            array.shift(pool.session_end_times)
        if array.size(pool.high_liquidity_depths) > 0
            array.shift(pool.high_liquidity_depths)
        if array.size(pool.low_liquidity_depths) > 0
            array.shift(pool.low_liquidity_depths)
        if array.size(pool.intraday_high_liquidity_depths) > 0
            array.shift(pool.intraday_high_liquidity_depths)
        if array.size(pool.intraday_low_liquidity_depths) > 0
            array.shift(pool.intraday_low_liquidity_depths)

prune_range_box(RangeBox box, int maxSize) =>
    while array.size(box.highs) > maxSize
        array.shift(box.highs)
        array.shift(box.lows)
        array.shift(box.start_times)
        array.shift(box.end_times)

// Unified drawing for timeframe opens
// use_hour_format: true for intraday (shows "4H 0600"), false for HTF (shows "D Open")
// Calculate end time for timeframe opens - extends to specific hour if provided
calc_open_end_time(int start_time, int default_end, int extend_to_hour) =>
    if na(extend_to_hour)
        default_end
    else
        target_time = timestamp(NY_TIMEZONE, year(start_time, NY_TIMEZONE), month(start_time, NY_TIMEZONE), dayofmonth(start_time, NY_TIMEZONE), extend_to_hour, 0, 0)
        math.min(target_time, time)

draw_timeframe_opens(TimeframeOpenTracker tracker, int showLast, color lineColor, int lineWidth, string prefix, bool use_hour_format, bool showLabels, color labelTextColor, array<line> all_lines, array<label> all_labels, int extend_to_hour = na, int filter_hour = na) =>
    levels_drawn = 0

    if not na(tracker.current_open) and (na(filter_hour) or tracker.current_hour == filter_hour)
        current_end = calc_open_end_time(tracker.current_time, time, extend_to_hour)
        current_line = line.new(tracker.current_time, tracker.current_open, current_end, tracker.current_open, xloc=xloc.bar_time, color=lineColor, width=lineWidth, style=line.style_solid)
        array.push(all_lines, current_line)

        if showLabels
            label_text = use_hour_format ? prefix + " " + (tracker.current_hour < 10 ? "0" : "") + str.tostring(tracker.current_hour) + "00" : prefix + " Open"
            array.push(all_labels, label.new(current_end, tracker.current_open, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100)))

        levels_drawn += 1

    if array.size(tracker.opens) > 0
        for i = array.size(tracker.opens) - 1 to 0
            if levels_drawn >= showLast
                break

            open_hour = array.get(tracker.hours, i)
            if not na(filter_hour) and open_hour != filter_hour
                continue

            open_price = array.get(tracker.opens, i)
            open_time = array.get(tracker.times, i)
            default_end = i < array.size(tracker.opens) - 1 ? array.get(tracker.times, i + 1) : (not na(tracker.current_time) ? tracker.current_time : time)
            end_time = calc_open_end_time(open_time, default_end, extend_to_hour)

            array.push(all_lines, line.new(open_time, open_price, end_time, open_price, xloc=xloc.bar_time, color=lineColor, width=lineWidth, style=line.style_solid))

            if showLabels
                label_text = use_hour_format ? prefix + " " + (open_hour < 10 ? "0" : "") + str.tostring(open_hour) + "00" : prefix + " Open"
                array.push(all_labels, label.new(end_time, open_price, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100)))

            levels_drawn += 1

// Unified drawing for intraday closes (14:00/16:00) with mitigation tracking
draw_intraday_closes(IntradayClosingPriceTracker tracker, int showLast, int maxUnmitigated, bool skipHistoricalMitigated, color lineColor, int lineWidth, int untappedWidth, int fallbackHour, bool showLabels, color labelTextColor, array<line> all_lines, array<label> all_labels) =>
    levels_drawn = 0
    unmitigated_drawn = 0
    untapped_width_assigned = false

    if not na(tracker.current_close)
        current_is_mitigated = tracker.current_mitigated
        // Skip if unmitigated only mode and current is mitigated
        if not (showUnmitigatedOnly and current_is_mitigated)
            // Check unmitigated cap
            if current_is_mitigated or unmitigated_drawn < maxUnmitigated
                current_mitigation_time_val = tracker.current_mitigation_time
                current_end_time = (current_is_mitigated and not na(current_mitigation_time_val)) ? current_mitigation_time_val : time
                current_line_width = current_is_mitigated ? lineWidth : untappedWidth
                if not current_is_mitigated
                    untapped_width_assigned := true
                    unmitigated_drawn += 1
                array.push(all_lines, line.new(tracker.current_time, tracker.current_close, current_end_time, tracker.current_close, xloc=xloc.bar_time, color=lineColor, width=current_line_width, style=line.style_solid))
                if showLabels
                    label_time = (current_is_mitigated and not na(current_mitigation_time_val)) ? int((tracker.current_time + current_mitigation_time_val) / 2) : current_end_time
                    array.push(all_labels, label.new(label_time, tracker.current_close, str.tostring(tracker.current_capture_hour) + ":00", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100)))
                levels_drawn += 1

    if array.size(tracker.closes) > 0
        for i = array.size(tracker.closes) - 1 to 0
            if levels_drawn >= showLast
                break
            is_mitigated = array.get(tracker.mitigated, i)
            // Skip historical mitigated: unmitigated-only mode OR Today mode (only show today's mitigated)
            if is_mitigated and (showUnmitigatedOnly or skipHistoricalMitigated)
                continue
            // Skip if unmitigated cap reached
            if not is_mitigated and unmitigated_drawn >= maxUnmitigated
                continue
            close_price = array.get(tracker.closes, i)
            close_time = array.get(tracker.times, i)
            mitigation_time = array.get(tracker.mitigation_times, i)
            end_time = (is_mitigated and not na(mitigation_time)) ? mitigation_time : time
            lw = lineWidth
            if not is_mitigated and not untapped_width_assigned
                lw := untappedWidth
                untapped_width_assigned := true
            if not is_mitigated
                unmitigated_drawn += 1
            array.push(all_lines, line.new(close_time, close_price, end_time, close_price, xloc=xloc.bar_time, color=lineColor, width=lw, style=line.style_solid))
            if showLabels
                label_time = (is_mitigated and not na(mitigation_time)) ? int((close_time + mitigation_time) / 2) : end_time
                capture_hour = (i < array.size(tracker.capture_hours)) ? array.get(tracker.capture_hours, i) : fallbackHour
                array.push(all_labels, label.new(label_time, close_price, str.tostring(capture_hour) + ":00", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100)))
            levels_drawn += 1

pool_get_high_end_time(pool, index, fallback_time) =>
    high_breached = array.get(pool.high_breached, index)
    high_breach_time = array.get(pool.high_breach_times, index)
    high_breached and not na(high_breach_time) ? high_breach_time : fallback_time

pool_get_low_end_time(pool, index, fallback_time) =>
    low_breached = array.get(pool.low_breached, index)
    low_breach_time = array.get(pool.low_breach_times, index)
    low_breached and not na(low_breach_time) ? low_breach_time : fallback_time

pool_store_session(pool) =>
    if not na(pool.current_high)
        array.push(pool.highs, pool.current_high)
        array.push(pool.lows, pool.current_low)
        array.push(pool.high_times, pool.current_high_time)
        array.push(pool.low_times, pool.current_low_time)
        array.push(pool.high_breached, false)
        array.push(pool.low_breached, false)
        array.push(pool.high_breach_times, na)
        array.push(pool.low_breach_times, na)

        // Initialize liquidity depth levels for this pool entry (HTF only)
        high_liquidity_depth = LiquidityDepthLevels.new(array.new_bool(NUM_LIQUIDITY_DEPTH_LEVELS, false), array.new_int(NUM_LIQUIDITY_DEPTH_LEVELS, na))
        low_liquidity_depth = LiquidityDepthLevels.new(array.new_bool(NUM_LIQUIDITY_DEPTH_LEVELS, false), array.new_int(NUM_LIQUIDITY_DEPTH_LEVELS, na))
        array.push(pool.high_liquidity_depths, high_liquidity_depth)
        array.push(pool.low_liquidity_depths, low_liquidity_depth)

pool_detect_breaches(pool, scan_cap, liquidity_depth_distance, alertEnabled, alertHighMsg, alertLowMsg) =>
    if array.size(pool.highs) > 0
        scan_size = math.min(array.size(pool.highs), scan_cap)
        start_index = math.max(0, array.size(pool.highs) - scan_size)

        for i = start_index to array.size(pool.highs) - 1
            // Base level (L0) breach detection
            if not array.get(pool.high_breached, i)
                tracked_high = array.get(pool.highs, i)
                if high >= tracked_high
                    array.set(pool.high_breached, i, true)
                    array.set(pool.high_breach_times, i, time)
                    if alertEnabled
                        alert(alertHighMsg, alert.freq_once_per_bar)

            if not array.get(pool.low_breached, i)
                tracked_low = array.get(pool.lows, i)
                if low <= tracked_low
                    array.set(pool.low_breached, i, true)
                    array.set(pool.low_breach_times, i, time)
                    if alertEnabled
                        alert(alertLowMsg, alert.freq_once_per_bar)

            // Liquidity Depth level breach detection (only if distance > 0 for performance)
            if liquidity_depth_distance > 0
                tracked_high = array.get(pool.highs, i)
                tracked_low = array.get(pool.lows, i)
                high_liquidity_depth = array.get(pool.high_liquidity_depths, i)
                low_liquidity_depth = array.get(pool.low_liquidity_depths, i)

                for level_idx = 0 to NUM_LIQUIDITY_DEPTH_LEVELS - 1
                    multiplier = level_idx + 1  // L1=1x, L2=2x, L3=3x

                    // Check high liquidity depth level
                    if not array.get(high_liquidity_depth.breached, level_idx)
                        level_price = tracked_high + (multiplier * liquidity_depth_distance)
                        if high >= level_price
                            array.set(high_liquidity_depth.breached, level_idx, true)
                            array.set(high_liquidity_depth.breach_times, level_idx, time)

                    // Check low liquidity depth level
                    if not array.get(low_liquidity_depth.breached, level_idx)
                        level_price = tracked_low - (multiplier * liquidity_depth_distance)
                        if low <= level_price
                            array.set(low_liquidity_depth.breached, level_idx, true)
                            array.set(low_liquidity_depth.breach_times, level_idx, time)

pool_detect_intraday_breaches(pool, scan_cap, percent1, percent2, percent3, alertEnabled, alertHighMsg, alertLowMsg) =>
    if array.size(pool.highs) > 0
        scan_size = math.min(array.size(pool.highs), scan_cap)
        start_index = math.max(0, array.size(pool.highs) - scan_size)

        for i = start_index to array.size(pool.highs) - 1
            // Base level (L0) breach detection
            if not array.get(pool.high_breached, i)
                tracked_high = array.get(pool.highs, i)
                if high >= tracked_high
                    array.set(pool.high_breached, i, true)
                    array.set(pool.high_breach_times, i, time)
                    if alertEnabled
                        alert(alertHighMsg, alert.freq_once_per_bar)

            if not array.get(pool.low_breached, i)
                tracked_low = array.get(pool.lows, i)
                if low <= tracked_low
                    array.set(pool.low_breached, i, true)
                    array.set(pool.low_breach_times, i, time)
                    if alertEnabled
                        alert(alertLowMsg, alert.freq_once_per_bar)

            // Intraday liquidity depth level breach detection (percentage-based)
            if percent1 > 0
                tracked_high = array.get(pool.highs, i)
                tracked_low = array.get(pool.lows, i)
                intraday_high_liquidity_depth = array.get(pool.intraday_high_liquidity_depths, i)
                intraday_low_liquidity_depth = array.get(pool.intraday_low_liquidity_depths, i)
                percents = array.from(percent1, percent2, percent3)

                for level_idx = 0 to NUM_INTRADAY_LIQUIDITY_DEPTH_LEVELS - 1
                    percent = array.get(percents, level_idx)

                    // Check high liquidity depth level
                    if not array.get(intraday_high_liquidity_depth.breached, level_idx)
                        level_price = tracked_high + (tracked_high * (percent / 100.0))
                        if high >= level_price
                            array.set(intraday_high_liquidity_depth.breached, level_idx, true)
                            array.set(intraday_high_liquidity_depth.breach_times, level_idx, time)

                    // Check low liquidity depth level
                    if not array.get(intraday_low_liquidity_depth.breached, level_idx)
                        level_price = tracked_low - (tracked_low * (percent / 100.0))
                        if low <= level_price
                            array.set(intraday_low_liquidity_depth.breached, level_idx, true)
                            array.set(intraday_low_liquidity_depth.breach_times, level_idx, time)

build_label(pool_type) =>
    pool_type

// Helper: Get intraday liquidity depth percentage for a given level (0, 1, 2)
get_intraday_percent(level_idx) =>
    level_idx == 0 ? intradayLiquidityDepthPercent1 : (level_idx == 1 ? intradayLiquidityDepthPercent2 : intradayLiquidityDepthPercent3)

// Helper: Get intraday liquidity depth color for a given level (0, 1, 2)
get_intraday_color(level_idx, pool_color) =>
    if effectiveIntradayLiqDepthColorPreset == LIQUIDITY_DEPTH_PRESET_POOL_COLORS
        level_idx == 0 ? intradayLiquidityDepthL1Color : (level_idx == 1 ? intradayLiquidityDepthL2Color : intradayLiquidityDepthL3Color)
    else
        DEFAULT_LIQUIDITY_DEPTH_BLUE

// Helper: Get intraday liquidity depth line width for a given level (0, 1, 2)
get_intraday_width(level_idx) =>
    level_idx == 0 ? intradayLiquidityDepthL1Width : (level_idx == 1 ? intradayLiquidityDepthL2Width : intradayLiquidityDepthL3Width)

// Helper: Convert style string to line style constant
convert_line_style(style_str) =>
    style_str == "Solid" ? line.style_solid : (style_str == "Dotted" ? line.style_dotted : line.style_dashed)

// Helper: Get intraday liquidity depth line style for a given level (0, 1, 2)
get_intraday_style(level_idx) =>
    style_str = level_idx == 0 ? intradayLiquidityDepthL1Style : (level_idx == 1 ? intradayLiquidityDepthL2Style : intradayLiquidityDepthL3Style)
    convert_line_style(style_str)

// Helper: Get Daily liquidity depth color for a given level (0, 1, 2)
