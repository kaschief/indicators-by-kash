mondayLabelColor = input.color(color.white, "Monday", group=GROUP_TIME_DIVIDERS, inline='day_labels')

show1600Open = input.bool(false, GROUP_1600_OPEN, group=GROUP_1600_OPEN, tooltip="Track and project the 16:00 1-minute candle open price until mitigated. Automatically captures 18:00 reopen on early-close days (e.g., holidays when market closes at 13:00). Only available on 1H or lower timeframes.")
open1600ShowLast = input.int(10, UI_SHOW_LAST, minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX, group=GROUP_1600_OPEN, inline='1600_options')
open1600Color = input.color(DEFAULT_1600_OPEN_COLOR, UI_COLOR, group=GROUP_1600_OPEN, inline='1600_options')
open1600LineWidth = input.int(2, UI_WIDTH, minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group=GROUP_1600_OPEN, inline='1600_options')
open1600MitigationWindow = input.string(MITIGATION_WINDOW_ANYTIME, "Mitigation Window", group=GROUP_1600_OPEN, inline='1600_mitigation', options=[MITIGATION_WINDOW_ANYTIME, MITIGATION_WINDOW_MARKET_HOURS], tooltip="Anytime: Level can be mitigated any time after 05:00 (includes overnight/Asian session). Levels mitigated more frequently.\nMarket-Hours: Level can ONLY be mitigated during 05:00-16:00 (filters overnight manipulation). Results in MORE levels visible on screen as they persist longer, better for identifying institutional levels.")

showLabels = input.bool(true, GROUP_LABELS, group=GROUP_LABELS, inline='labels')
labelTextColor = input.color(DEFAULT_LABEL_TEXT_COLOR, UI_TEXT_COLOR, group=GROUP_LABELS, inline='labels')

// ═══════════════════════════════════════════════════════════════════════════════
// 24/7 ASSET AUTO-DETECTION & SUNDAY LIQUIDITY HANDLING
// ═══════════════════════════════════════════════════════════════════════════════

// Auto-detect 24/7 asset by scanning for weekend bars (excluding Sunday 18:00+ reopen)
// STRATEGY: Default TRUE (assume 24/7), only set FALSE after scanning 7+ days with no weekends
//
// AUTOMATIC SUNDAY EVENING BEHAVIOR:
// • 24/7 assets (crypto): Sunday evening is normal trading → always included
// • Traditional assets (forex/futures): Sunday 18:00-23:59 is thin reopening liquidity → automatically excluded
var bool is247Asset = true
var bool detectionCompleted = false

// Only run detection once after we have 7+ days of data
if not detectionCompleted
    barsIn7Days = int(10080 / (timeframe.in_seconds() / 60))

    if bar_index >= barsIn7Days
        // Check current bar first (fast path - if we loaded on Saturday, instant detect)
        currentDay = dayofweek(time, NY_TIMEZONE)
        currentHour = hour(time, NY_TIMEZONE)
        isSaturdayNow = currentDay == dayofweek.saturday
        isEarlySundayNow = currentDay == dayofweek.sunday and currentHour < SUNDAY_REOPEN_START_HOUR

        if isSaturdayNow or isEarlySundayNow
            // Current bar is weekend - definitely 24/7
            is247Asset := true
        else
            // Scan last 7 days for weekend bars
            maxLookback = math.min(9999, barsIn7Days)
            foundWeekendBar = false

            for lookback = 0 to maxLookback by 20
                checkDay = dayofweek(time[lookback], NY_TIMEZONE)
                checkHour = hour(time[lookback], NY_TIMEZONE)

                isSaturday = checkDay == dayofweek.saturday
                isEarlySunday = checkDay == dayofweek.sunday and checkHour < SUNDAY_REOPEN_START_HOUR
                if isSaturday or isEarlySunday
                    foundWeekendBar := true
                    break

            // Set result based on scan
            is247Asset := foundWeekendBar

        detectionCompleted := true

// Apply day codes - use all 7 days for both asset types
// Traditional assets handle Sunday evening exclusion via should_skip_sunday_liquidity()
// For 24/7 assets, use default times; for traditional markets, use custom times
actualAsiaSession = is247Asset ? ("2000-0000" + DAY_CODE_ALL_DAYS) : (str.replace_all(asiaSessionTime, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualLondonSession = is247Asset ? ("0200-0500" + DAY_CODE_ALL_DAYS) : (str.replace_all(londonSessionTime, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualNyamSession = is247Asset ? ("0930-1200" + DAY_CODE_ALL_DAYS) : (str.replace_all(nyamSessionTime, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualLunchSession = is247Asset ? ("1200-1330" + DAY_CODE_ALL_DAYS) : (str.replace_all(lunchSessionTime, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualNypmSession = is247Asset ? ("1330-1600" + DAY_CODE_ALL_DAYS) : (str.replace_all(nypmSessionTime, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualPremarketSession = is247Asset ? ("0500-0915" + DAY_CODE_ALL_DAYS) : (str.replace_all(premarketSessionTime, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualOvernightSession = is247Asset ? ("1600-0500" + DAY_CODE_ALL_DAYS) : (str.replace_all(overnightSessionTime, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualRangeSession = is247Asset ? ("0200-0215" + DAY_CODE_ALL_DAYS) : (str.replace_all(rangeSessionTime, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)

// ═══════════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

create_pool() =>
    LiquidityPool.new(array.new_float(), array.new_float(), array.new_int(), array.new_int(), array.new_bool(), array.new_bool(), array.new_int(), array.new_int(), array.new_int(), array.new_int(), na, na, na, na, na)

create_range_box() =>
    RangeBox.new(array.new_float(), array.new_float(), array.new_int(), array.new_int(), na, na, na)

create_time_divider() =>
    TimeDivider.new(array.new_int(), array.new_int(), array.new_string())

create_1600_open() =>
    SixteenHundredOpen.new(array.new_float(), array.new_int(), array.new_bool(), array.new_int(), array.new_int(), na, na, false, na, na)

pool_get_high_end_time(pool, index, fallback_time) =>
    high_breached = array.get(pool.high_breached, index)
    high_breach_time = array.get(pool.high_breach_times, index)
    high_breached and not na(high_breach_time) ? high_breach_time : fallback_time

pool_get_low_end_time(pool, index, fallback_time) =>
    low_breached = array.get(pool.low_breached, index)
    low_breach_time = array.get(pool.low_breach_times, index)
    low_breached and not na(low_breach_time) ? low_breach_time : fallback_time

pool_store_session(pool) =>
    if not na(pool.current_high)
        array.push(pool.highs, pool.current_high)
        array.push(pool.lows, pool.current_low)
        array.push(pool.high_times, pool.current_high_time)
        array.push(pool.low_times, pool.current_low_time)
        array.push(pool.high_breached, false)
        array.push(pool.low_breached, false)
        array.push(pool.high_breach_times, na)
        array.push(pool.low_breach_times, na)

pool_detect_breaches(pool, scan_cap) =>
    if array.size(pool.highs) > 0
        scan_size = math.min(array.size(pool.highs), scan_cap)
        start_index = math.max(0, array.size(pool.highs) - scan_size)

        for i = start_index to array.size(pool.highs) - 1
            if not array.get(pool.high_breached, i)
                tracked_high = array.get(pool.highs, i)
                if high >= tracked_high
                    array.set(pool.high_breached, i, true)
                    array.set(pool.high_breach_times, i, time)

            if not array.get(pool.low_breached, i)
                tracked_low = array.get(pool.lows, i)
                if low <= tracked_low
                    array.set(pool.low_breached, i, true)
                    array.set(pool.low_breach_times, i, time)

build_label(pool_type) =>
    pool_type

should_skip_sunday_liquidity(time_value) =>
    // Traditional markets: skip Sunday 18:00-23:59 (thin reopening liquidity)
    // 24/7 markets: never skip (Sunday is normal trading)
    not is247Asset and dayofweek(time_value, NY_TIMEZONE) == dayofweek.sunday and hour(time_value, NY_TIMEZONE) >= SUNDAY_REOPEN_START_HOUR

track_intraday_session(pool, sessionString, skipSunday) =>
    inSession = not na(time(timeframe.period, sessionString, NY_TIMEZONE))
    wasInSession = not na(time(timeframe.period, sessionString, NY_TIMEZONE)[1])
    sessionJustStarted = inSession and not wasInSession
    sessionJustEnded = not inSession and wasInSession

    // ALWAYS process session endings (to save Friday data before weekend)
    if sessionJustEnded
        // Store session data including end time
        if not na(pool.current_high)
            array.push(pool.highs, pool.current_high)
            array.push(pool.lows, pool.current_low)
            array.push(pool.high_times, pool.current_high_time)
            array.push(pool.low_times, pool.current_low_time)
            array.push(pool.high_breached, false)
            array.push(pool.low_breached, false)
            array.push(pool.high_breach_times, na)
            array.push(pool.low_breach_times, na)
            array.push(pool.session_start_times, pool.current_session_start_time)
            array.push(pool.session_end_times, time)

    // Only process session starts/updates when NOT skipping Sunday
    if not skipSunday
        if sessionJustStarted
            pool.current_high := high
            pool.current_low := low
            pool.current_high_time := time
            pool.current_low_time := time
            pool.current_session_start_time := time

        if inSession
            if high > pool.current_high
                pool.current_high := high
                pool.current_high_time := time
            if low < pool.current_low
                pool.current_low := low
                pool.current_low_time := time

track_range_session(rangeBox, sessionString) =>
    inSession = not na(time(timeframe.period, sessionString, NY_TIMEZONE))
    wasInSession = not na(time(timeframe.period, sessionString, NY_TIMEZONE)[1])
    sessionJustStarted = inSession and not wasInSession
    sessionJustEnded = not inSession and wasInSession

    if sessionJustEnded
        if not na(rangeBox.current_high)
            array.push(rangeBox.highs, rangeBox.current_high)
            array.push(rangeBox.lows, rangeBox.current_low)
            array.push(rangeBox.start_times, rangeBox.current_start_time)
            array.push(rangeBox.end_times, time)

    if sessionJustStarted
        rangeBox.current_high := high
        rangeBox.current_low := low
        rangeBox.current_start_time := time

    if inSession
        if high > rangeBox.current_high
            rangeBox.current_high := high
        if low < rangeBox.current_low
            rangeBox.current_low := low

get_day_name(timestamp) =>
    day = dayofweek(timestamp, NY_TIMEZONE)
    day == dayofweek.monday ? DAY_MON : day == dayofweek.tuesday ? DAY_TUE : day == dayofweek.wednesday ? DAY_WED : day == dayofweek.thursday ? DAY_THU : day == dayofweek.friday ? DAY_FRI : day == dayofweek.saturday ? DAY_SAT : DAY_SUN

detect_time_divider(divider) =>
    currentHour = hour(time, NY_TIMEZONE)
    currentMinute = minute(time, NY_TIMEZONE)
    previousHour = hour(time[1], NY_TIMEZONE)

    // Midnight: detect when hour changes to 0 from any non-zero hour (works on 1H-4H timeframes)
    isDividerTime = currentHour == 0 and currentMinute == 0 and previousHour != 0

    if isDividerTime
        // Store the new divider time
        array.push(divider.divider_times, time)

        // If we have at least 2 dividers, calculate midpoint with previous divider
        if array.size(divider.divider_times) >= 2
            // Get the two most recent dividers
            latest_divider = array.get(divider.divider_times, array.size(divider.divider_times) - 1)
            previous_divider = array.get(divider.divider_times, array.size(divider.divider_times) - 2)

            // Calculate midpoint
            midpoint = int((latest_divider + previous_divider) / 2)

            // Get day name for the latest divider
            day_name = get_day_name(latest_divider)

            // Store midpoint and day name
            array.push(divider.midpoint_times, midpoint)
            array.push(divider.midpoint_days, day_name)

// ═══════════════════════════════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════════════════════════════

var LiquidityPool daily_pool = create_pool()
var LiquidityPool weekly_pool = create_pool()
var LiquidityPool monthly_pool = create_pool()
var LiquidityPool asia_pool = create_pool()
var LiquidityPool london_pool = create_pool()
var LiquidityPool nyam_pool = create_pool()
var LiquidityPool lunch_pool = create_pool()
var LiquidityPool nypm_pool = create_pool()
var LiquidityPool premarket_pool = create_pool()
var LiquidityPool overnight_pool = create_pool()
var RangeBox range_box = create_range_box()
var TimeDivider time_divider = create_time_divider()
var SixteenHundredOpen sixteen_hundred_open = create_1600_open()
var array<line> all_lines = array.new<line>()
var array<label> all_labels = array.new<label>()
var array<box> all_boxes = array.new<box>()

// ═══════════════════════════════════════════════════════════════════════════════
// DATA COLLECTION
// ═══════════════════════════════════════════════════════════════════════════════

is_new_daily_bar = ta.change(dayofmonth(time, NY_TIMEZONE)) != 0
is_new_weekly_bar = ta.change(weekofyear(time, NY_TIMEZONE)) != 0
is_new_monthly_bar = ta.change(month(time, NY_TIMEZONE)) != 0

// Calculate Sunday skip once for all liquidity sources (performance optimization)
skip_sunday_liquidity = should_skip_sunday_liquidity(time)

if barstate.isfirst
    daily_pool.current_high := high
    daily_pool.current_low := low
    daily_pool.current_high_time := time
    daily_pool.current_low_time := time

    weekly_pool.current_high := high
    weekly_pool.current_low := low
    weekly_pool.current_high_time := time
    weekly_pool.current_low_time := time

    monthly_pool.current_high := high
    monthly_pool.current_low := low
    monthly_pool.current_high_time := time
    monthly_pool.current_low_time := time
else if not skip_sunday_liquidity
    // Normal operation: track sessions (Sunday included when setting ON, or non-Sunday days)
    // Daily
    if is_new_daily_bar
        pool_store_session(daily_pool)
        daily_pool.current_high := high
        daily_pool.current_low := low
        daily_pool.current_high_time := time
        daily_pool.current_low_time := time
    else
        if high > daily_pool.current_high
            daily_pool.current_high := high
            daily_pool.current_high_time := time
        if low < daily_pool.current_low
            daily_pool.current_low := low
            daily_pool.current_low_time := time

    // Weekly
    if is_new_weekly_bar
        pool_store_session(weekly_pool)
        weekly_pool.current_high := high
        weekly_pool.current_low := low
        weekly_pool.current_high_time := time
        weekly_pool.current_low_time := time
    else
        if high > weekly_pool.current_high
            weekly_pool.current_high := high
            weekly_pool.current_high_time := time
        if low < weekly_pool.current_low
            weekly_pool.current_low := low
            weekly_pool.current_low_time := time

    // Monthly
    if is_new_monthly_bar
        pool_store_session(monthly_pool)
        monthly_pool.current_high := high
        monthly_pool.current_low := low
        monthly_pool.current_high_time := time
        monthly_pool.current_low_time := time
    else
        if high > monthly_pool.current_high
            monthly_pool.current_high := high
            monthly_pool.current_high_time := time
        if low < monthly_pool.current_low
            monthly_pool.current_low := low
            monthly_pool.current_low_time := time
// When skip_sunday_liquidity is TRUE: HTF pools freeze Friday's data (don't update)
// Intraday/PoiSzn sessions always finalize Friday sessions, but skip starting new ones during Sunday evening

// Intraday session liquidity pool tracking
// ALWAYS call tracking to detect Friday session endings (functions handle Sunday skip internally)
if timeframe.in_seconds() <= INTRADAY_SESSION_MAX_TIMEFRAME
    if showAsia
        track_intraday_session(asia_pool, actualAsiaSession, skip_sunday_liquidity)

    if showLondon
        track_intraday_session(london_pool, actualLondonSession, skip_sunday_liquidity)

    if showNyam
        track_intraday_session(nyam_pool, actualNyamSession, skip_sunday_liquidity)

    if showLunch
        track_intraday_session(lunch_pool, actualLunchSession, skip_sunday_liquidity)

    if showNypm
        track_intraday_session(nypm_pool, actualNypmSession, skip_sunday_liquidity)

    // PoiSzn session liquidity pool tracking
    if showPremarket
        track_intraday_session(premarket_pool, actualPremarketSession, skip_sunday_liquidity)

    if showOvernight
        track_intraday_session(overnight_pool, actualOvernightSession, skip_sunday_liquidity)

// Range box tracking
if not skip_sunday_liquidity
    if showRangeBox
        track_range_session(range_box, actualRangeSession)

// Time divider tracking
if not skip_sunday_liquidity
    if showTimeDividers and timeframe.in_seconds() <= TIME_DIVIDER_MAX_TIMEFRAME
        detect_time_divider(time_divider)

// 16:00/18:00 Open tracking - detect and store
// Automatically captures 16:00 on normal days, 18:00 on early-close days (consistent with overnight session behavior)
// NOTE: Not affected by Sunday skip because 16:00 doesn't occur during Sunday evening (market opens at 18:00)
// and mitigation detection must still run to check stored levels
// Requires intraday timeframe (1H or less) to capture 1-minute candle precisely
if show1600Open and timeframe.in_seconds() <= SIXTEEN_HUNDRED_OPEN_MAX_TIMEFRAME
    currentHour_1600 = hour(time, NY_TIMEZONE)
    currentMinute_1600 = minute(time, NY_TIMEZONE)

    // Try to detect 16:00 first (normal close), then 18:00 (early close reopen)
    is1600Bar = currentHour_1600 == MARKET_CLOSE_HOUR and currentMinute_1600 == 0
    is1800Bar = currentHour_1600 == SUNDAY_REOPEN_START_HOUR and currentMinute_1600 == 0

    // For traditional markets, skip Sunday 16:00 (only 18:00 reopen is valid)
    isSunday = dayofweek(time, NY_TIMEZONE) == dayofweek.sunday
    skipSunday1600 = not is247Asset and isSunday

    if is1600Bar and not skipSunday1600
        // Push previous day's level to storage if it exists
        if not na(sixteen_hundred_open.current_open)
            array.push(sixteen_hundred_open.opens, sixteen_hundred_open.current_open)
            array.push(sixteen_hundred_open.times, sixteen_hundred_open.current_time)
            array.push(sixteen_hundred_open.mitigated, sixteen_hundred_open.current_mitigated)
            array.push(sixteen_hundred_open.mitigation_times, sixteen_hundred_open.current_mitigation_time)
            array.push(sixteen_hundred_open.capture_hours, sixteen_hundred_open.current_capture_hour)

        // Capture new 16:00 open and reset mitigation status
        sixteen_hundred_open.current_open := open
        sixteen_hundred_open.current_time := time
        sixteen_hundred_open.current_mitigated := false
        sixteen_hundred_open.current_mitigation_time := na
        sixteen_hundred_open.current_capture_hour := 16

    else if is1800Bar and not isSunday
        // Only capture 18:00 on WEEKDAYS for early-close holidays (not Sunday reopen)
        // Check if we haven't captured a 16:00 TODAY (early close fallback)
        capturedToday = not na(sixteen_hundred_open.current_open) and dayofmonth(sixteen_hundred_open.current_time, NY_TIMEZONE) == dayofmonth(time, NY_TIMEZONE)

        if not capturedToday
            // Push previous day's level to storage if it exists
            if not na(sixteen_hundred_open.current_open)
                array.push(sixteen_hundred_open.opens, sixteen_hundred_open.current_open)
                array.push(sixteen_hundred_open.times, sixteen_hundred_open.current_time)
                array.push(sixteen_hundred_open.mitigated, sixteen_hundred_open.current_mitigated)
                array.push(sixteen_hundred_open.mitigation_times, sixteen_hundred_open.current_mitigation_time)
                array.push(sixteen_hundred_open.capture_hours, sixteen_hundred_open.current_capture_hour)

            // Capture 18:00 open (early close reopen)
            sixteen_hundred_open.current_open := open
            sixteen_hundred_open.current_time := time
            sixteen_hundred_open.current_mitigated := false
            sixteen_hundred_open.current_mitigation_time := na
            sixteen_hundred_open.current_capture_hour := 18

// ═══════════════════════════════════════════════════════════════════════════════
// DAY LABELS - Simple recurring time check (like date.pine)
// ═══════════════════════════════════════════════════════════════════════════════

// Day labels appear at noon (midpoint between midnight dividers)
currentHour = hour(time, NY_TIMEZONE)
currentMinute = minute(time, NY_TIMEZONE)
currentDay = dayofweek(time, NY_TIMEZONE)

// Midpoint between consecutive midnights is noon (12:00)
isMidpoint = currentHour == 12 and currentMinute == 0

// Plot day labels at midpoint - using plotchar at bottom (no lower option available)
plotchar(showDayLabels and isMidpoint and currentDay == dayofweek.monday, char=" ", text=DAY_MON, location=location.bottom, color=color.new(mondayLabelColor, 100), textcolor=mondayLabelColor, size=size.tiny, editable=false)
plotchar(showDayLabels and isMidpoint and currentDay == dayofweek.tuesday, char=" ", text=DAY_TUE, location=location.bottom, color=color.new(dayLabelColor, 100), textcolor=dayLabelColor, size=size.tiny, editable=false)
plotchar(showDayLabels and isMidpoint and currentDay == dayofweek.wednesday, char=" ", text=DAY_WED, location=location.bottom, color=color.new(dayLabelColor, 100), textcolor=dayLabelColor, size=size.tiny, editable=false)
plotchar(showDayLabels and isMidpoint and currentDay == dayofweek.thursday, char=" ", text=DAY_THU, location=location.bottom, color=color.new(dayLabelColor, 100), textcolor=dayLabelColor, size=size.tiny, editable=false)
plotchar(showDayLabels and isMidpoint and currentDay == dayofweek.friday, char=" ", text=DAY_FRI, location=location.bottom, color=color.new(dayLabelColor, 100), textcolor=dayLabelColor, size=size.tiny, editable=false)
plotchar(showDayLabels and isMidpoint and currentDay == dayofweek.saturday, char=" ", text=DAY_SAT, location=location.bottom, color=color.new(dayLabelColor, 100), textcolor=dayLabelColor, size=size.tiny, editable=false)
plotchar(showDayLabels and isMidpoint and currentDay == dayofweek.sunday, char=" ", text=DAY_SUN, location=location.bottom, color=color.new(dayLabelColor, 100), textcolor=dayLabelColor, size=size.tiny, editable=false)

// ═══════════════════════════════════════════════════════════════════════════════
// BREACH DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

if not skip_sunday_liquidity
    if showDaily
        pool_detect_breaches(daily_pool, DAILY_SCAN_CAP)

    if showWeekly
        pool_detect_breaches(weekly_pool, WEEKLY_SCAN_CAP)

    if showMonthly
        pool_detect_breaches(monthly_pool, MONTHLY_SCAN_CAP)

    // Intraday session breach detection
    if timeframe.in_seconds() <= INTRADAY_SESSION_MAX_TIMEFRAME
        if showAsia
            pool_detect_breaches(asia_pool, ASIA_SCAN_CAP)

        if showLondon
            pool_detect_breaches(london_pool, LONDON_SCAN_CAP)

        if showNyam
            pool_detect_breaches(nyam_pool, NYAM_SCAN_CAP)

        if showLunch
            pool_detect_breaches(lunch_pool, LUNCH_SCAN_CAP)

        if showNypm
            pool_detect_breaches(nypm_pool, NYPM_SCAN_CAP)

        if showPremarket
            pool_detect_breaches(premarket_pool, PREMARKET_SCAN_CAP)

        if showOvernight
            pool_detect_breaches(overnight_pool, OVERNIGHT_SCAN_CAP)

// Detect 16:00 open mitigation (ONLY after 05:00 next day)
// NOTE: Mitigation detection skips Sunday evening for traditional assets (16:00 is traditional market concept)
if show1600Open and not skip_sunday_liquidity
    currentHour_mitigation = hour(time, NY_TIMEZONE)

    // Determine if we're in the mitigation window based on mode
    isInMitigationWindow = false
    if open1600MitigationWindow == MITIGATION_WINDOW_ANYTIME
        // Anytime: Any time from 05:00 onwards (includes overnight/Asian session)
        isInMitigationWindow := currentHour_mitigation >= MITIGATION_START_HOUR
    else
        // Market-Hours: Only between 05:00-16:00 (excludes overnight 16:00-05:00)
        isInMitigationWindow := currentHour_mitigation >= MITIGATION_START_HOUR and currentHour_mitigation < MARKET_CLOSE_HOUR

    // Check CURRENT level (today's 16:00 that hasn't been pushed to array yet)
    if not na(sixteen_hundred_open.current_open) and not sixteen_hundred_open.current_mitigated
        // Require BOTH: 13+ hours elapsed AND in mitigation window
        // This protects intraday (Tue 16:00 → Wed 05:00) AND handles weekends (Fri 16:00 → Mon 05:00)
        if (time >= sixteen_hundred_open.current_time + THIRTEEN_HOURS_MS) and isInMitigationWindow
            // Price touched or crossed the level
            if (high >= sixteen_hundred_open.current_open and low <= sixteen_hundred_open.current_open) or close == sixteen_hundred_open.current_open
                sixteen_hundred_open.current_mitigated := true
                sixteen_hundred_open.current_mitigation_time := time

    // Check stored levels (previous days in array)
    if array.size(sixteen_hundred_open.opens) > 0
        scan_size = math.min(array.size(sixteen_hundred_open.opens), SIXTEEN_HUNDRED_OPEN_SCAN_CAP)
        start_index = math.max(0, array.size(sixteen_hundred_open.opens) - scan_size)

        for i = start_index to array.size(sixteen_hundred_open.opens) - 1
            if not array.get(sixteen_hundred_open.mitigated, i)
                open_level = array.get(sixteen_hundred_open.opens, i)
                open_time_stored = array.get(sixteen_hundred_open.times, i)

                // Require BOTH: 13+ hours elapsed AND in mitigation window
                // This protects intraday (Tue 16:00 → Wed 05:00) AND handles weekends (Fri 16:00 → Mon 05:00)
                if (time >= open_time_stored + THIRTEEN_HOURS_MS) and isInMitigationWindow
                    // Price touched or crossed the level
                    if (high >= open_level and low <= open_level) or close == open_level
                        array.set(sixteen_hundred_open.mitigated, i, true)
                        array.set(sixteen_hundred_open.mitigation_times, i, time)

// ═══════════════════════════════════════════════════════════════════════════════
// VISUALIZATION HELPERS
// ═══════════════════════════════════════════════════════════════════════════════

draw_session_backgrounds(pool, showLast, bgColor) =>
    if array.size(pool.session_start_times) > 0
        count = math.min(showLast, array.size(pool.session_start_times))
        for i = 0 to count - 1
            idx = array.size(pool.session_start_times) - 1 - i
            start_time = array.get(pool.session_start_times, idx)
            end_time = array.get(pool.session_end_times, idx)
            session_high = array.get(pool.highs, idx)
            session_low = array.get(pool.lows, idx)

            // Draw background box for session
            session_box = box.new(start_time, session_high, end_time, session_low, xloc=xloc.bar_time, bgcolor=bgColor, border_color=color.new(bgColor, 100), border_width=1)
            array.push(all_boxes, session_box)

draw_intraday_pool(pool, poolType, showLast, lineColor, lineWidth) =>
    count = math.min(showLast, array.size(pool.highs))
    for i = 0 to count - 1
        idx = array.size(pool.highs) - 1 - i

        high_val = array.get(pool.highs, idx)
        low_val = array.get(pool.lows, idx)
        high_time = array.get(pool.high_times, idx)
        low_time = array.get(pool.low_times, idx)

        high_end_time = pool_get_high_end_time(pool, idx, time)
        low_end_time = pool_get_low_end_time(pool, idx, time)

        high_line = line.new(high_time, high_val, high_end_time, high_val, xloc=xloc.bar_time, color=lineColor, width=lineWidth, style=line.style_solid)
        array.push(all_lines, high_line)

        low_line = line.new(low_time, low_val, low_end_time, low_val, xloc=xloc.bar_time, color=lineColor, width=lineWidth, style=line.style_solid)
        array.push(all_lines, low_line)

        if showLabels
            label_text = build_label(poolType)
            high_breached = array.get(pool.high_breached, idx)
            low_breached = array.get(pool.low_breached, idx)

            high_label_time = high_breached ? int((high_time + high_end_time) / 2) : high_end_time
            high_label = label.new(high_label_time, high_val, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
            array.push(all_labels, high_label)

            low_label_time = low_breached ? int((low_time + low_end_time) / 2) : low_end_time
            low_label = label.new(low_label_time, low_val, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
            array.push(all_labels, low_label)

// ═══════════════════════════════════════════════════════════════════════════════
// VISUALIZATION
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.islast
    // Clear previous visuals
    for line_obj in all_lines
        line.delete(line_obj)
    array.clear(all_lines)

    for label_obj in all_labels
        label.delete(label_obj)
    array.clear(all_labels)

    for box_obj in all_boxes
        box.delete(box_obj)
    array.clear(all_boxes)

    // Draw Daily
    if showDaily and timeframe.in_seconds() >= HTF_MIN_TIMEFRAME
        count = math.min(dailyShowLast, array.size(daily_pool.highs))
        if count > 0
            for i = 0 to count - 1
                idx = array.size(daily_pool.highs) - 1 - i

                high_val = array.get(daily_pool.highs, idx)
                low_val = array.get(daily_pool.lows, idx)
                high_time = array.get(daily_pool.high_times, idx)
                low_time = array.get(daily_pool.low_times, idx)

                // Get conditional end times
                high_end_time = pool_get_high_end_time(daily_pool, idx, time)
                low_end_time = pool_get_low_end_time(daily_pool, idx, time)

                // Draw high line
                high_line = line.new(high_time, high_val, high_end_time, high_val, xloc=xloc.bar_time, color=dailyColor, width=dailyLineWidth, style=line.style_solid)
                array.push(all_lines, high_line)

                // Draw low line
                low_line = line.new(low_time, low_val, low_end_time, low_val, xloc=xloc.bar_time, color=dailyColor, width=dailyLineWidth, style=line.style_solid)
                array.push(all_lines, low_line)

                // Draw labels (middle if breached, right end if active)
                if showLabels
                    label_text = build_label(POOL_TYPE_DAILY)

                    high_breached = array.get(daily_pool.high_breached, idx)
                    low_breached = array.get(daily_pool.low_breached, idx)

                    // High label: middle if breached, at end (current time) if not breached
                    high_label_time = high_breached ? int((high_time + high_end_time) / 2) : high_end_time
                    high_label = label.new(high_label_time, high_val, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                    array.push(all_labels, high_label)

                    // Low label: middle if breached, at end (current time) if not breached
                    low_label_time = low_breached ? int((low_time + low_end_time) / 2) : low_end_time
                    low_label = label.new(low_label_time, low_val, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                    array.push(all_labels, low_label)

    // Draw Weekly
    if showWeekly and timeframe.in_seconds() >= HTF_MIN_TIMEFRAME
        count = math.min(weeklyShowLast, array.size(weekly_pool.highs))
        if count > 0
            for i = 0 to count - 1
                idx = array.size(weekly_pool.highs) - 1 - i

                high_val = array.get(weekly_pool.highs, idx)
                low_val = array.get(weekly_pool.lows, idx)
                high_time = array.get(weekly_pool.high_times, idx)
                low_time = array.get(weekly_pool.low_times, idx)

                // Get conditional end times
                high_end_time = pool_get_high_end_time(weekly_pool, idx, time)
                low_end_time = pool_get_low_end_time(weekly_pool, idx, time)

                // Draw high line
                high_line = line.new(high_time, high_val, high_end_time, high_val, xloc=xloc.bar_time, color=weeklyColor, width=weeklyLineWidth, style=line.style_solid)
                array.push(all_lines, high_line)

                // Draw low line
                low_line = line.new(low_time, low_val, low_end_time, low_val, xloc=xloc.bar_time, color=weeklyColor, width=weeklyLineWidth, style=line.style_solid)
                array.push(all_lines, low_line)

                // Draw labels (middle if breached, right end if active)
                if showLabels
                    label_text = build_label(POOL_TYPE_WEEKLY)

                    high_breached = array.get(weekly_pool.high_breached, idx)
                    low_breached = array.get(weekly_pool.low_breached, idx)

                    // High label: middle if breached, at end (current time) if not breached
                    high_label_time = high_breached ? int((high_time + high_end_time) / 2) : high_end_time
                    high_label = label.new(high_label_time, high_val, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                    array.push(all_labels, high_label)

                    // Low label: middle if breached, at end (current time) if not breached
                    low_label_time = low_breached ? int((low_time + low_end_time) / 2) : low_end_time
                    low_label = label.new(low_label_time, low_val, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                    array.push(all_labels, low_label)

    // Draw Monthly
    if showMonthly and timeframe.in_seconds() >= HTF_MIN_TIMEFRAME
        count = math.min(monthlyShowLast, array.size(monthly_pool.highs))
        if count > 0
            for i = 0 to count - 1
                idx = array.size(monthly_pool.highs) - 1 - i

                high_val = array.get(monthly_pool.highs, idx)
                low_val = array.get(monthly_pool.lows, idx)
                high_time = array.get(monthly_pool.high_times, idx)
                low_time = array.get(monthly_pool.low_times, idx)

                // Get conditional end times
                high_end_time = pool_get_high_end_time(monthly_pool, idx, time)
                low_end_time = pool_get_low_end_time(monthly_pool, idx, time)

                // Draw high line
                high_line = line.new(high_time, high_val, high_end_time, high_val, xloc=xloc.bar_time, color=monthlyColor, width=monthlyLineWidth, style=line.style_solid)
                array.push(all_lines, high_line)

                // Draw low line
                low_line = line.new(low_time, low_val, low_end_time, low_val, xloc=xloc.bar_time, color=monthlyColor, width=monthlyLineWidth, style=line.style_solid)
                array.push(all_lines, low_line)

                // Draw labels (middle if breached, right end if active)
                if showLabels
                    label_text = build_label(POOL_TYPE_MONTHLY)

                    high_breached = array.get(monthly_pool.high_breached, idx)
                    low_breached = array.get(monthly_pool.low_breached, idx)

                    // High label: middle if breached, at end (current time) if not breached
                    high_label_time = high_breached ? int((high_time + high_end_time) / 2) : high_end_time
                    high_label = label.new(high_label_time, high_val, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                    array.push(all_labels, high_label)

                    // Low label: middle if breached, at end (current time) if not breached
                    low_label_time = low_breached ? int((low_time + low_end_time) / 2) : low_end_time
                    low_label = label.new(low_label_time, low_val, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                    array.push(all_labels, low_label)

    // Draw Intraday Session Backgrounds
    if showIntradayBackground and timeframe.in_seconds() <= INTRADAY_SESSION_MAX_TIMEFRAME
        if showAsia
            draw_session_backgrounds(asia_pool, intradayShowLast, intradayBackgroundColor)

        if showLondon
            draw_session_backgrounds(london_pool, intradayShowLast, intradayBackgroundColor)

        if showNyam
            draw_session_backgrounds(nyam_pool, intradayShowLast, intradayBackgroundColor)

        if showLunch
            draw_session_backgrounds(lunch_pool, intradayShowLast, intradayBackgroundColor)

        if showNypm
            draw_session_backgrounds(nypm_pool, intradayShowLast, intradayBackgroundColor)

    // Draw PoiSzn Session Backgrounds
    if timeframe.in_seconds() <= INTRADAY_SESSION_MAX_TIMEFRAME
        if showPremarketBackground and showPremarket
            draw_session_backgrounds(premarket_pool, poisznShowLast, premarketBackgroundColor)

        if showOvernightBackground and showOvernight
            draw_session_backgrounds(overnight_pool, poisznShowLast, overnightBackgroundColor)

    // Draw Intraday Sessions
    if timeframe.in_seconds() <= INTRADAY_SESSION_MAX_TIMEFRAME
        if showAsia
            draw_intraday_pool(asia_pool, POOL_TYPE_ASIA, intradayShowLast, intradayColor, intradayLineWidth)

        if showLondon
            draw_intraday_pool(london_pool, POOL_TYPE_LONDON, intradayShowLast, intradayColor, intradayLineWidth)

        if showNyam
            draw_intraday_pool(nyam_pool, POOL_TYPE_NYAM, intradayShowLast, intradayColor, intradayLineWidth)

        if showLunch
            draw_intraday_pool(lunch_pool, POOL_TYPE_LUNCH, intradayShowLast, intradayColor, intradayLineWidth)

        if showNypm
            draw_intraday_pool(nypm_pool, POOL_TYPE_NYPM, intradayShowLast, intradayColor, intradayLineWidth)

        // Draw PoiSzn Sessions
        if showPremarket
            draw_intraday_pool(premarket_pool, POOL_TYPE_PREMARKET, poisznShowLast, premarketColor, poisznLineWidth)

        if showOvernight
            draw_intraday_pool(overnight_pool, POOL_TYPE_OVERNIGHT, poisznShowLast, overnightColor, poisznLineWidth)

    // Draw Range Boxes
    if showRangeBox and timeframe.in_seconds() >= RANGE_BOX_MIN_TIMEFRAME and timeframe.in_seconds() <= RANGE_BOX_MAX_TIMEFRAME
        count = math.min(rangeBoxShowLast, array.size(range_box.highs))
        for i = 0 to count - 1
            idx = array.size(range_box.highs) - 1 - i

            high_val = array.get(range_box.highs, idx)
            low_val = array.get(range_box.lows, idx)
            start_time = array.get(range_box.start_times, idx)
            end_time = array.get(range_box.end_times, idx)

            // Determine extension end time: next range's start OR current time if most recent
            extend_end_time = i > 0 ? array.get(range_box.start_times, idx + 1) : time

            // Draw high line (extended to next range start)
            high_line = line.new(start_time, high_val, extend_end_time, high_val, xloc=xloc.bar_time, color=rangeBoxColor, width=rangeBoxWidth, style=line.style_solid)
            array.push(all_lines, high_line)

            // Draw low line (extended to next range start)
            low_line = line.new(start_time, low_val, extend_end_time, low_val, xloc=xloc.bar_time, color=rangeBoxColor, width=rangeBoxWidth, style=line.style_solid)
            array.push(all_lines, low_line)

            // Draw vertical lines only at actual range boundaries (2:00-2:15)
            left_line = line.new(start_time, high_val, start_time, low_val, xloc=xloc.bar_time, color=rangeBoxColor, width=rangeBoxWidth, style=line.style_solid)
            array.push(all_lines, left_line)

            right_line = line.new(end_time, high_val, end_time, low_val, xloc=xloc.bar_time, color=rangeBoxColor, width=rangeBoxWidth, style=line.style_solid)
            array.push(all_lines, right_line)

            // Draw middle line if enabled (extended to next range start)
            if showRangeMiddleLine
                middle_price = (high_val + low_val) / 2
                middle_line = line.new(start_time, middle_price, extend_end_time, middle_price, xloc=xloc.bar_time, color=rangeMiddleColor, width=rangeBoxWidth, style=line.style_dotted)
                array.push(all_lines, middle_line)

    // Draw Time Dividers
    if showTimeDividers and timeframe.in_seconds() <= TIME_DIVIDER_MAX_TIMEFRAME
        if array.size(time_divider.divider_times) > 0
            count = math.min(timeDividerShowLast, array.size(time_divider.divider_times))
            for i = 0 to count - 1
                idx = array.size(time_divider.divider_times) - 1 - i
                divider_time = array.get(time_divider.divider_times, idx)

                // Draw vertical line from high to low of chart (use chart extremes)
                divider_line = line.new(divider_time, high, divider_time, low, xloc=xloc.bar_time, color=timeDividerColor, width=1, style=line.style_dashed, extend=extend.both)
                array.push(all_lines, divider_line)

    // Draw 16:00 Opens - current level + stored levels
    // IMPORTANT: Draw current level FIRST (most recent) then fill with array levels
    // Only display on intraday timeframes (1H or less) where 1-minute precision is available
    if show1600Open and timeframe.in_seconds() <= SIXTEEN_HUNDRED_OPEN_MAX_TIMEFRAME
        levels_drawn = 0

        // Draw current level FIRST (today's/most recent 16:00)
        if not na(sixteen_hundred_open.current_open)
            current_open_price = sixteen_hundred_open.current_open
            current_open_time = sixteen_hundred_open.current_time
            current_is_mitigated = sixteen_hundred_open.current_mitigated
            current_mitigation_time_val = sixteen_hundred_open.current_mitigation_time

            // Determine end time: if mitigated use mitigation time, otherwise current time
            current_end_time = (current_is_mitigated and not na(current_mitigation_time_val)) ? current_mitigation_time_val : time

            // Draw current level line
            current_line = line.new(current_open_time, current_open_price, current_end_time, current_open_price, xloc=xloc.bar_time, color=open1600Color, width=open1600LineWidth, style=line.style_solid)
            array.push(all_lines, current_line)

            // Label: at midpoint if mitigated, at end if active
            if showLabels
                current_label_time = (current_is_mitigated and not na(current_mitigation_time_val)) ? int((current_open_time + current_mitigation_time_val) / 2) : current_end_time
                current_label_text = str.tostring(sixteen_hundred_open.current_capture_hour) + ":00"
                current_label = label.new(current_label_time, current_open_price, current_label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                array.push(all_labels, current_label)

            levels_drawn += 1

        // Draw stored levels (from array) - most recent first, up to remaining limit
        if array.size(sixteen_hundred_open.opens) > 0
            for i = array.size(sixteen_hundred_open.opens) - 1 to 0
                if levels_drawn >= open1600ShowLast
                    break

                open_price = array.get(sixteen_hundred_open.opens, i)
                open_time = array.get(sixteen_hundred_open.times, i)
                is_mitigated = array.get(sixteen_hundred_open.mitigated, i)
                mitigation_time = array.get(sixteen_hundred_open.mitigation_times, i)

                // Determine end time
                // If mitigated: use mitigation time (line stops at breach point)
                // If not mitigated: extend to current time (line is still active)
                end_time = (is_mitigated and not na(mitigation_time)) ? mitigation_time : time

                // Draw horizontal line
                open_line = line.new(open_time, open_price, end_time, open_price, xloc=xloc.bar_time, color=open1600Color, width=open1600LineWidth, style=line.style_solid)
                array.push(all_lines, open_line)

                // Draw label at midpoint if mitigated, at end if active
                if showLabels
                    label_time = (is_mitigated and not na(mitigation_time)) ? int((open_time + mitigation_time) / 2) : end_time
                    // Safely get capture hour with fallback for legacy data
                    capture_hour = (i < array.size(sixteen_hundred_open.capture_hours)) ? array.get(sixteen_hundred_open.capture_hours, i) : 16
                    label_text = str.tostring(capture_hour) + ":00"
                    open_label = label.new(label_time, open_price, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                    array.push(all_labels, open_label)

                levels_drawn += 1
