intradayBackgroundColor = input.color(DEFAULT_INTRADAY_BG_COLOR, "", group=GROUP_INTRADAY, inline='intraday_bg')
enableIntradayLiquidityDepth = input.bool(false, "Liquidity Depth", group=GROUP_INTRADAY, inline='intraday_liq', tooltip="Projects percentage-based liquidity depth levels (L1, L2, L3) for Asia, London, NY AM, Lunch, NY PM sessions.")
intradayLiqDepthColorPreset = input.string(LIQUIDITY_DEPTH_PRESET_DEFAULT, "", options=[LIQUIDITY_DEPTH_PRESET_DEFAULT, LIQUIDITY_DEPTH_PRESET_POOL_COLORS], group=GROUP_INTRADAY, inline='intraday_liq')
