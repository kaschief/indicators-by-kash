// ═══════════════════════════════════════════════════════════════════════════════
// TYPE DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════════════

// Liquidity Depth constants (modular for future adjustments)
NUM_LIQUIDITY_DEPTH_LEVELS = 3  // L1, L2, L3 (easily configurable)
NUM_INTRADAY_LIQUIDITY_DEPTH_LEVELS = 3  // Intraday L1, L2, L3
DEFAULT_INTRADAY_LIQUIDITY_DEPTH_PERCENT_1 = 0.09  // First intraday liquidity depth level (%)
DEFAULT_INTRADAY_LIQUIDITY_DEPTH_PERCENT_2 = 0.18  // Second intraday liquidity depth level (%)
DEFAULT_INTRADAY_LIQUIDITY_DEPTH_PERCENT_3 = 0.27  // Third intraday liquidity depth level (%)

// Asset family configuration (data-driven approach)
type AssetFamily
    array<string> identifiers           // Contract codes (e.g., ["NQ", "MNQ"])
    float daily_liquidity_depth_distance      // Daily L1 distance (e.g., 27)
    float weekly_liquidity_depth_distance     // Weekly L1 distance (e.g., 81)
    float monthly_liquidity_depth_distance    // Monthly L1 distance (e.g., 243)
    float intraday_liquidity_depth_percent_1  // Intraday L1 percentage (e.g., 0.09)
    float intraday_liquidity_depth_percent_2  // Intraday L2 percentage (e.g., 0.18)
    float intraday_liquidity_depth_percent_3  // Intraday L3 percentage (e.g., 0.27)
    string display_name                 // Display name (e.g., "NASDAQ")

// Stores liquidity depth level data for a single pool entry (one high or low)
type LiquidityDepthLevels
    array<bool> breached      // Index 0 = L1, 1 = L2, 2 = L3, etc.
    array<int> breach_times   // Corresponding breach timestamps

type LiquidityPool
    array<float> highs
    array<float> lows
    array<int> high_times
    array<int> low_times
    array<bool> high_breached
    array<bool> low_breached
    array<int> high_breach_times
    array<int> low_breach_times
    array<int> session_start_times
    array<int> session_end_times
    // Liquidity Depth tracking: one LiquidityDepthLevels per pool entry (HTF only)
    array<LiquidityDepthLevels> high_liquidity_depths
    array<LiquidityDepthLevels> low_liquidity_depths
    // Intraday Liquidity Depth tracking: one LiquidityDepthLevels per pool entry (intraday sessions only)
    array<LiquidityDepthLevels> intraday_high_liquidity_depths
    array<LiquidityDepthLevels> intraday_low_liquidity_depths
    float current_high
    float current_low
    int current_high_time
    int current_low_time
    int current_session_start_time

type RangeBox
    array<float> highs
    array<float> lows
    array<int> start_times
    array<int> end_times
    float current_high
    float current_low
    int current_start_time

type TimeDivider
    array<int> divider_times
    array<int> midpoint_times
    array<string> midpoint_days

type IntradayClosingPriceTracker
    array<float> closes
    array<int> times
    array<bool> mitigated
    array<int> mitigation_times
    array<int> capture_hours        // Track capture hour (e.g., 14, 16, 18)
    float current_close
    int current_time
    bool current_mitigated
    int current_mitigation_time
    int current_capture_hour        // Capture hour (e.g., 14, 16, 18)

// Simplified tracker for timeframe opens (no mitigation tracking)
type TimeframeOpenTracker
    array<float> opens          // Open prices
    array<int> times            // Open times
    array<int> hours            // Hour of open (for label: 0600, 1000, etc.)
    float current_open
    int current_time
    int current_hour

// ═══════════════════════════════════════════════════════════════════════════════
// ASSET CONFIGURATION REGISTRY (PERFORMANCE: Cached lookup, runs once)
// ═══════════════════════════════════════════════════════════════════════════════

// Data-Driven Asset Registry (infinitely scalable)
var array<AssetFamily> ASSET_FAMILIES = array.new<AssetFamily>()

if barstate.isfirst
    //                                                                      Daily  Weekly Monthly  Intraday%: L1    L2    L3
    array.push(ASSET_FAMILIES, AssetFamily.new(array.from("NQ", "MNQ"), 27, 81, 243, 0.09, 0.18, 0.27, "NASDAQ"))           // Daily: 27,54,81 | Weekly: 81,162,243 | Monthly: 243,486,729 | Intraday: 0.09%, 0.18%, 0.27%
    array.push(ASSET_FAMILIES, AssetFamily.new(array.from("ES", "MES"), 9, 18, 54, 0.03, 0.06, 0.09, "S&P500"))             // Daily: 9,18,27 | Weekly: 18,36,54 | Monthly: 54,108,162 | Intraday: 0.03%, 0.06%, 0.09%
    array.push(ASSET_FAMILIES, AssetFamily.new(array.from("YM", "MYM"), 27, 81, 162, 0.06, 0.12, 0.18, "DOW"))             // Daily: 27,54,81 | Weekly: 81,162,243 | Monthly: 162,324,486 | Intraday: 0.06%, 0.12%, 0.18%
    array.push(ASSET_FAMILIES, AssetFamily.new(array.from("RTY", "M2K"), 4, 12, 36, 0.09, 0.18, 0.27, "RUSSELL"))           // TODO: Verify Monthly | Intraday: 0.09%, 0.18%, 0.27%
    array.push(ASSET_FAMILIES, AssetFamily.new(array.from("GC", "MGC"), 3, 6, 18, 0.09, 0.18, 0.27, "GOLD"))                // Daily: 3,6,9 | Weekly: 6,12,18 | Monthly: 18,36,54 | Intraday: 0.09%, 0.18%, 0.27%
    array.push(ASSET_FAMILIES, AssetFamily.new(array.from("CL", "MCL", "QM"), 0.125, 0.375, 1.125, 0.09, 0.18, 0.27, "OIL")) // Daily: 0.125,0.25,0.375 | Weekly: 0.375,0.75,1.125 | Monthly: 1.125,2.25,3.375 | Intraday: 0.09%, 0.18%, 0.27%
    array.push(ASSET_FAMILIES, AssetFamily.new(array.from("BTC", "MBT"), 100, 300, 900, 0.09, 0.18, 0.27, "BTC"))           // TODO: Verify Monthly | Intraday: 0.09%, 0.18%, 0.27%
    array.push(ASSET_FAMILIES, AssetFamily.new(array.from("ETH", "MET"), 10, 30, 90, 0.09, 0.18, 0.27, "ETH"))           // TODO: Verify Monthly | Intraday: 0.09%, 0.18%, 0.27%

// ═══════════════════════════════════════════════════════════════════════════════
// ASSET DETECTION FUNCTIONS (must be defined before INPUTS)
// ═══════════════════════════════════════════════════════════════════════════════

// Helper: Check if symbol matches any identifier in a family array
symbol_matches_family(symbol_root, family_identifiers) =>
    matched = false
    for identifier in family_identifiers
        if str.contains(symbol_root, identifier)
            matched := true
            break
    matched

// Find matching asset family for current symbol (loop-based lookup)
find_asset_family() =>
    symbol_root = syminfo.root != "" ? syminfo.root : syminfo.ticker
    var AssetFamily matched_family = na

    matched_family := na  // Reset
    for family in ASSET_FAMILIES
        if symbol_matches_family(symbol_root, family.identifiers)
            matched_family := family
            break

    matched_family

// Performance optimization: Cache lookup result in global scope (runs once)
var AssetFamily CACHED_ASSET_FAMILY = na

// Session string cache (performance: calculated once)
var string actualAsiaSession = na
var string actualLondonSession = na
var string actualNyamSession = na
var string actualLunchSession = na
var string actualNypmSession = na
var string actualPremarketSession = na
var string actualOvernightSession = na
var string actualRangeSession = na

// Initialize cache on first bar
if barstate.isfirst
    CACHED_ASSET_FAMILY := find_asset_family()

// Helper functions use cached result (O(1) access after first bar)
is_asset_supported() =>
    not na(CACHED_ASSET_FAMILY)

get_daily_liquidity_depth_distance() =>
    na(CACHED_ASSET_FAMILY) ? 0.0 : CACHED_ASSET_FAMILY.daily_liquidity_depth_distance

get_weekly_liquidity_depth_distance() =>
    na(CACHED_ASSET_FAMILY) ? 0.0 : CACHED_ASSET_FAMILY.weekly_liquidity_depth_distance

get_monthly_liquidity_depth_distance() =>
    na(CACHED_ASSET_FAMILY) ? 0.0 : CACHED_ASSET_FAMILY.monthly_liquidity_depth_distance

get_detected_asset_name() =>
    na(CACHED_ASSET_FAMILY) ? "NOT SUPPORTED" : CACHED_ASSET_FAMILY.display_name

get_intraday_liquidity_depth_percent_1() =>
    na(CACHED_ASSET_FAMILY) ? DEFAULT_INTRADAY_LIQUIDITY_DEPTH_PERCENT_1 : CACHED_ASSET_FAMILY.intraday_liquidity_depth_percent_1

get_intraday_liquidity_depth_percent_2() =>
    na(CACHED_ASSET_FAMILY) ? DEFAULT_INTRADAY_LIQUIDITY_DEPTH_PERCENT_2 : CACHED_ASSET_FAMILY.intraday_liquidity_depth_percent_2

get_intraday_liquidity_depth_percent_3() =>
    na(CACHED_ASSET_FAMILY) ? DEFAULT_INTRADAY_LIQUIDITY_DEPTH_PERCENT_3 : CACHED_ASSET_FAMILY.intraday_liquidity_depth_percent_3

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Pulse Mode (Global Override) ───
pulseModeFilter = input.string(FILTER_WORK_RANGE_KEY_OPENS_HTF, "Show Only", group=GROUP_PULSE_MODE, options=[FILTER_ALL, FILTER_TODAY, FILTER_LIQUIDITY_MAP, FILTER_WORK_RANGE_KEY_OPENS_HTF, FILTER_HTF, FILTER_DAILY, FILTER_WEEKLY, FILTER_MONTHLY, FILTER_INTRADAY, FILTER_INTRADAY_PREMARKET_OVERNIGHT, FILTER_PREMARKET_OVERNIGHT, FILTER_KEY_OPENS, FILTER_HTF_OPENS, FILTER_4H_OPEN, FILTER_10AM_4H_OPEN, FILTER_1H_OPEN, FILTER_1400_1600, FILTER_RANGE_KEY_OPENS, FILTER_RANGE_BOX_MNO, FILTER_RANGE_BOX_1600, FILTER_1400_1600_RANGE_BOX, FILTER_RANGE_BOX, FILTER_DAYS], tooltip="Override all individual ON/OFF toggles to quickly show only specific pool types.\n\n• All: Respect individual toggles\n• Today: Liquidity Map + HTF + 8:30 + 9:30 (last of each)\n\n─ Composite Maps ─\n• Liquidity Map: Range Box + 14:00 + 16:00 + Premarket + Overnight\n• Range Box + Key Opens: Range Box + 14:00 + 16:00 + 8:30 + 9:30\n• Range Box + Key Opens + HTF: Above + Daily + Weekly + Monthly\n\n─ HTF Pools ─\n• HTF: Daily + Weekly + Monthly\n• Daily / Weekly / Monthly: Single HTF type\n\n─ Sessions ─\n• Intraday: Asia + London + NYAM + Lunch + NYPM\n• Intraday + Premarket + Overnight: All sessions\n• Premarket + Overnight: Extended hours only\n\n─ Opens ─\n• Key Opens: 8:30 + 9:30\n• HTF Opens: Daily + Weekly + Monthly\n• 4H Open / 10am 4H Open / 1H Open: Single timeframe\n• Intraday Closes: 14:00 + 16:00\n\n─ Single ─\n• Range Box + 1600\n• Range Box + 1400 + 1600\n• Range Box\n• Days: Midnight dividers + day labels only")
showUnmitigatedOnly = input.bool(false, "Unmitigated Only", group=GROUP_PULSE_MODE, tooltip="Show only levels that have not been breached/mitigated. Hides all breached highs/lows and mitigated price levels.")
todayL1Bold = input.bool(true, "Bold L1 Depth in Today Mode", group=GROUP_PULSE_MODE, tooltip="In Today mode, bold L1 liquidity depth lines with width 2.")

// ─── Daily ───
showDaily = input.bool(true, GROUP_DAILY, group=GROUP_DAILY)
dailyShowLast = input.int(5, UI_SHOW_LAST, minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX, group=GROUP_DAILY, inline='daily')
dailyColor = input.color(DEFAULT_DAILY_COLOR, UI_COLOR, group=GROUP_DAILY, inline='daily')
dailyLineWidth = input.int(2, UI_WIDTH, minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group=GROUP_DAILY, inline='daily')
enableDailyLiquidityDepth = input.bool(false, "Liquidity Depth", group=GROUP_DAILY, inline='daily_liq', tooltip="Projects liquidity depth levels (L1, L2, L3) above highs and below lows.\nValid on 15min-1hr charts.")
dailyLiqDepthColorPreset = input.string(LIQUIDITY_DEPTH_PRESET_DEFAULT, "", options=[LIQUIDITY_DEPTH_PRESET_DEFAULT, LIQUIDITY_DEPTH_PRESET_POOL_COLORS], group=GROUP_DAILY, inline='daily_liq')
dailyLiqDepthL1Color = input.color(DEFAULT_DAILY_COLOR, "  L1", group=GROUP_DAILY, inline="daily_l1")
dailyLiqDepthL1Style = input.string("Dashed", "", options=["Solid", "Dashed", "Dotted"], group=GROUP_DAILY, inline="daily_l1")
dailyLiqDepthL1Width = input.int(1, "", minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group=GROUP_DAILY, inline="daily_l1")
dailyLiqDepthL2Color = input.color(DEFAULT_LIQUIDITY_DEPTH_EXTENSION_COLOR, "  L2", group=GROUP_DAILY, inline="daily_l2")
dailyLiqDepthL2Style = input.string("Dashed", "", options=["Solid", "Dashed", "Dotted"], group=GROUP_DAILY, inline="daily_l2")
dailyLiqDepthL2Width = input.int(1, "", minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group=GROUP_DAILY, inline="daily_l2")
dailyLiqDepthL3Color = input.color(DEFAULT_LIQUIDITY_DEPTH_EXTENSION_COLOR, "  L3", group=GROUP_DAILY, inline="daily_l3")
dailyLiqDepthL3Style = input.string("Dashed", "", options=["Solid", "Dashed", "Dotted"], group=GROUP_DAILY, inline="daily_l3")
dailyLiqDepthL3Width = input.int(1, "", minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group=GROUP_DAILY, inline="daily_l3")

// ─── Weekly ───
showWeekly = input.bool(true, GROUP_WEEKLY, group=GROUP_WEEKLY)
weeklyShowLast = input.int(1, UI_SHOW_LAST, minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX, group=GROUP_WEEKLY, inline='weekly')
