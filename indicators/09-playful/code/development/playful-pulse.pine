enableWeeklyLiquidityDepth = input.bool(false, "Liquidity Depth", group=GROUP_WEEKLY, inline='weekly_liq', tooltip="Projects liquidity depth levels (L1, L2, L3) above highs and below lows.\nValid on 4hr-12hr charts.")
weeklyLiqDepthColorPreset = input.string(LIQUIDITY_DEPTH_PRESET_DEFAULT, "", options=[LIQUIDITY_DEPTH_PRESET_DEFAULT, LIQUIDITY_DEPTH_PRESET_POOL_COLORS], group=GROUP_WEEKLY, inline='weekly_liq')
