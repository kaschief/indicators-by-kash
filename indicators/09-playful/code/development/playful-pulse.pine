UI_TEXT_COLOR = "Text"
UI_BACKGROUND = "Background"
UI_ASIA_SESSION = "Asia"
UI_LONDON_SESSION = "London"
UI_NYAM_SESSION = "NY AM"
UI_LUNCH_SESSION = "Lunch"
UI_NYPM_SESSION = "NY PM"
UI_PREMARKET_SESSION = "Premarket"
UI_OVERNIGHT_SESSION = "Overnight"
UI_MIDDLE_LINE = "Middle Line"

// Session time defaults
DEFAULT_ASIA_SESSION_TIME = "2000-0000" + DAY_CODE_MON_SAT
DEFAULT_LONDON_SESSION_TIME = "0200-0500" + DAY_CODE_MON_SAT
DEFAULT_NYAM_SESSION_TIME = "0930-1200" + DAY_CODE_MON_SAT
DEFAULT_LUNCH_SESSION_TIME = "1200-1330" + DAY_CODE_MON_SAT
DEFAULT_NYPM_SESSION_TIME = "1330-1600" + DAY_CODE_MON_SAT
DEFAULT_PREMARKET_SESSION_TIME = "0500-0915" + DAY_CODE_MON_SAT
DEFAULT_OVERNIGHT_SESSION_TIME = "1600-0500" + DAY_CODE_MON_SAT
DEFAULT_RANGE_SESSION_TIME = "0200-0215" + DAY_CODE_MON_SAT

// Default colors
DEFAULT_DAILY_COLOR = #9c27b0
DEFAULT_WEEKLY_COLOR = #ec407a
DEFAULT_MONTHLY_COLOR = #ff9800
DEFAULT_INTRADAY_COLOR = #00bcd4
DEFAULT_PREMARKET_COLOR = #1565c0
DEFAULT_OVERNIGHT_COLOR = #4caf50
DEFAULT_RANGE_BOX_COLOR = #2196f3
DEFAULT_RANGE_MIDDLE_COLOR = #ff9800
DEFAULT_TIME_DIVIDER_COLOR = #808080
DEFAULT_1600_OPEN_COLOR = #ff5722
DEFAULT_LABEL_TEXT_COLOR = color.black

// Default session background colors (with transparency)
DEFAULT_INTRADAY_BG_COLOR = color.new(#00bcd4, 95)
DEFAULT_PREMARKET_BG_COLOR = color.new(#1565c0, 95)
DEFAULT_OVERNIGHT_BG_COLOR = color.new(#4caf50, 95)

// Scan caps
DAILY_SCAN_CAP = 100
WEEKLY_SCAN_CAP = 50
MONTHLY_SCAN_CAP = 30
ASIA_SCAN_CAP = 50
LONDON_SCAN_CAP = 50
NYAM_SCAN_CAP = 50
LUNCH_SCAN_CAP = 50
NYPM_SCAN_CAP = 50
PREMARKET_SCAN_CAP = 50
OVERNIGHT_SCAN_CAP = 50
RANGE_BOX_SCAN_CAP = 20
SIXTEEN_HUNDRED_OPEN_SCAN_CAP = 30

// Time offsets (in milliseconds)
THIRTEEN_HOURS_MS = 13 * 60 * 60 * 1000  // 16:00 to 05:00 next day

// Range box timeframe limits (in seconds)
RANGE_BOX_MIN_TIMEFRAME = 60    // 1 minute
RANGE_BOX_MAX_TIMEFRAME = 900   // 15 minutes

// HTF (Daily/Weekly/Monthly) minimum timeframe (in seconds) - too noisy on sub-1min
HTF_MIN_TIMEFRAME = 60  // 1 minute

// Intraday session timeframe limit (in seconds) - only useful on sub-30min charts
INTRADAY_SESSION_MAX_TIMEFRAME = 1800  // 30 minutes

// 16:00 open timeframe limit (in seconds) - needs intraday precision
SIXTEEN_HUNDRED_OPEN_MAX_TIMEFRAME = 3600  // 1 hour

// Time divider timeframe limit (in seconds) - midnight candles exist up to 4H
TIME_DIVIDER_MAX_TIMEFRAME = 14400  // 4 hours

// Input limits
SHOW_LAST_MIN = 1
SHOW_LAST_MAX = 50
LINE_WIDTH_MIN = 1
LINE_WIDTH_MAX = 5

// ═══════════════════════════════════════════════════════════════════════════════
// TYPE DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════════════

type LiquidityPool
    array<float> highs
    array<float> lows
    array<int> high_times
    array<int> low_times
    array<bool> high_breached
    array<bool> low_breached
    array<int> high_breach_times
    array<int> low_breach_times
    array<int> session_start_times
    array<int> session_end_times
    float current_high
    float current_low
    int current_high_time
    int current_low_time
    int current_session_start_time

type RangeBox
    array<float> highs
    array<float> lows
    array<int> start_times
    array<int> end_times
    float current_high
    float current_low
    int current_start_time

type TimeDivider
    array<int> divider_times
    array<int> midpoint_times
    array<string> midpoint_days

type SixteenHundredOpen
    array<float> opens
    array<int> times
    array<bool> mitigated
    array<int> mitigation_times
    array<int> capture_hours        // Track if level was from 16:00 or 18:00
    float current_open
    int current_time
    bool current_mitigated
    int current_mitigation_time
    int current_capture_hour        // 16 or 18

// ═══════════════════════════════════════════════════════════════════════════════
