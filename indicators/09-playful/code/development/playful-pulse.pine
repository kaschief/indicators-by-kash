// Asset detection and liquidity depth distances (automatic, cached for performance)
detectedAsset = get_detected_asset_name()
dailyLiquidityDepthDistance = get_daily_liquidity_depth_distance()
weeklyLiquidityDepthDistance = get_weekly_liquidity_depth_distance()
monthlyLiquidityDepthDistance = get_monthly_liquidity_depth_distance()
isAssetSupported = is_asset_supported()

// Timeframe gating for liquidity depth (performance: computed once per bar)
currentTimeframeMinutes = timeframe.in_seconds() / 60
isDailyLiquidityDepthTimeframeValid = currentTimeframeMinutes >= 15 and currentTimeframeMinutes <= 60  // 15min to 1hr
isWeeklyLiquidityDepthTimeframeValid = currentTimeframeMinutes >= 240 and currentTimeframeMinutes <= 720  // 4hr to 12hr
isMonthlyLiquidityDepthTimeframeValid = currentTimeframeMinutes >= 720 and currentTimeframeMinutes <= 10080  // 12hr to 1W

// ─── Intraday Sessions ───
showIntraday = input.bool(true, GROUP_INTRADAY, group=GROUP_INTRADAY, tooltip='Asia: 2000-0000\nLondon: 0200-0500\nNY AM: 0930-1200\nLunch: 1200-1330\nNY PM: 1330-1600')
