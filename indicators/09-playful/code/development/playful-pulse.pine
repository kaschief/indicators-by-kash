// Scan caps
DAILY_SCAN_CAP = 100
WEEKLY_SCAN_CAP = 50
MONTHLY_SCAN_CAP = 30
ASIA_SCAN_CAP = 50
LONDON_SCAN_CAP = 50
NYAM_SCAN_CAP = 50
LUNCH_SCAN_CAP = 50
NYPM_SCAN_CAP = 50
PREMARKET_SCAN_CAP = 50
OVERNIGHT_SCAN_CAP = 50
RANGE_BOX_SCAN_CAP = 20
SIXTEEN_HUNDRED_OPEN_SCAN_CAP = 30

// Time offsets (in milliseconds)
THIRTEEN_HOURS_MS = 13 * 60 * 60 * 1000  // 16:00 to 05:00 next day

// Range box timeframe limits (in seconds)
RANGE_BOX_MIN_TIMEFRAME = 60    // 1 minute
RANGE_BOX_MAX_TIMEFRAME = 3600  // 1 hour

// HTF (Daily/Weekly/Monthly) minimum timeframe (in seconds) - too noisy on sub-1min
HTF_MIN_TIMEFRAME = 60  // 1 minute

// Intraday session timeframe limit (in seconds) - only useful on sub-30min charts
INTRADAY_SESSION_MAX_TIMEFRAME = 1800  // 30 minutes

// 16:00 open timeframe limits (in seconds) - needs intraday precision, min 1m to avoid duplicates
SIXTEEN_HUNDRED_OPEN_MIN_TIMEFRAME = 60    // 1 minute (prevents duplicate captures on sub-1m)
SIXTEEN_HUNDRED_OPEN_MAX_TIMEFRAME = 3600  // 1 hour

// Time divider timeframe limit (in seconds) - midnight candles exist up to 1H
TIME_DIVIDER_MAX_TIMEFRAME = 3600  // 1 hour

// Input limits
SHOW_LAST_MIN = 1
SHOW_LAST_MAX = 50
LINE_WIDTH_MIN = 1
LINE_WIDTH_MAX = 5

// Label offset constants (as percentage of price)
LABEL_OFFSET_MIN = 0.01     // Minimum offset for lowest priority pool
LABEL_OFFSET_MAX = 0.15     // Maximum offset for highest priority pool
LABEL_OFFSET_SINGLE = 0.02  // Offset when only one pool is enabled

// ═══════════════════════════════════════════════════════════════════════════════
// TYPE DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════════════

// Liquidity Depth constants (modular for future adjustments)
NUM_LIQUIDITY_DEPTH_LEVELS = 3  // L1, L2, L3 (easily configurable)
NUM_INTRADAY_LIQUIDITY_DEPTH_LEVELS = 3  // Intraday L1, L2, L3
DEFAULT_INTRADAY_LIQUIDITY_DEPTH_PERCENT_1 = 0.09  // First intraday liquidity depth level (%)
DEFAULT_INTRADAY_LIQUIDITY_DEPTH_PERCENT_2 = 0.18  // Second intraday liquidity depth level (%)
DEFAULT_INTRADAY_LIQUIDITY_DEPTH_PERCENT_3 = 0.27  // Third intraday liquidity depth level (%)

// Asset family configuration (data-driven approach)
type AssetFamily
    array<string> identifiers           // Contract codes (e.g., ["NQ", "MNQ"])
    float daily_liquidity_depth_distance      // Daily L1 distance (e.g., 27)
    float weekly_liquidity_depth_distance     // Weekly L1 distance (e.g., 81)
    float monthly_liquidity_depth_distance    // Monthly L1 distance (e.g., 243)
    float intraday_liquidity_depth_percent_1  // Intraday L1 percentage (e.g., 0.09)
    float intraday_liquidity_depth_percent_2  // Intraday L2 percentage (e.g., 0.18)
    float intraday_liquidity_depth_percent_3  // Intraday L3 percentage (e.g., 0.27)
    string display_name                 // Display name (e.g., "NASDAQ")

// Stores liquidity depth level data for a single pool entry (one high or low)
type LiquidityDepthLevels
    array<bool> breached      // Index 0 = L1, 1 = L2, 2 = L3, etc.
    array<int> breach_times   // Corresponding breach timestamps

type LiquidityPool
    array<float> highs
    array<float> lows
    array<int> high_times
    array<int> low_times
    array<bool> high_breached
    array<bool> low_breached
    array<int> high_breach_times
    array<int> low_breach_times
    array<int> session_start_times
    array<int> session_end_times
    // Liquidity Depth tracking: one LiquidityDepthLevels per pool entry (HTF only)
    array<LiquidityDepthLevels> high_liquidity_depths
    array<LiquidityDepthLevels> low_liquidity_depths
    // Intraday Liquidity Depth tracking: one LiquidityDepthLevels per pool entry (intraday sessions only)
    array<LiquidityDepthLevels> intraday_high_liquidity_depths
    array<LiquidityDepthLevels> intraday_low_liquidity_depths
    float current_high
    float current_low
    int current_high_time
    int current_low_time
    int current_session_start_time

type RangeBox
    array<float> highs
    array<float> lows
    array<int> start_times
    array<int> end_times
    float current_high
    float current_low
    int current_start_time

type TimeDivider
    array<int> divider_times
    array<int> midpoint_times
    array<string> midpoint_days

type SixteenHundredOpen
    array<float> opens
    array<int> times
    array<bool> mitigated
    array<int> mitigation_times
    array<int> capture_hours        // Track if level was from 16:00 or 18:00
    float current_open
    int current_time
    bool current_mitigated
    int current_mitigation_time
    int current_capture_hour        // 16 or 18

// ═══════════════════════════════════════════════════════════════════════════════
// ASSET CONFIGURATION REGISTRY (PERFORMANCE: Cached lookup, runs once)
// ═══════════════════════════════════════════════════════════════════════════════

// Data-Driven Asset Registry (infinitely scalable)
var array<AssetFamily> ASSET_FAMILIES = array.new<AssetFamily>()

if barstate.isfirst
    //                                                                      Daily  Weekly Monthly  Intraday%: L1    L2    L3
    array.push(ASSET_FAMILIES, AssetFamily.new(array.from("NQ", "MNQ"), 27, 81, 243, 0.09, 0.18, 0.27, "NASDAQ"))           // Daily: 27,54,81 | Weekly: 81,162,243 | Monthly: 243,486,729 | Intraday: 0.09%, 0.18%, 0.27%
    array.push(ASSET_FAMILIES, AssetFamily.new(array.from("ES", "MES"), 9, 18, 54, 0.03, 0.06, 0.09, "S&P500"))             // Daily: 9,18,27 | Weekly: 18,36,54 | Monthly: 54,108,162 | Intraday: 0.03%, 0.06%, 0.09%
    array.push(ASSET_FAMILIES, AssetFamily.new(array.from("YM", "MYM"), 81, 243, 243, 0.09, 0.18, 0.27, "DOW"))             // Daily: 81,162,243 | Weekly: 243,486,729 | Monthly: 243,486,729 | Intraday: 0.09%, 0.18%, 0.27%
    array.push(ASSET_FAMILIES, AssetFamily.new(array.from("RTY", "M2K"), 4, 12, 36, 0.09, 0.18, 0.27, "RUSSELL"))           // TODO: Verify Monthly | Intraday: 0.09%, 0.18%, 0.27%
    array.push(ASSET_FAMILIES, AssetFamily.new(array.from("GC", "MGC"), 3, 6, 18, 0.09, 0.18, 0.27, "GOLD"))                // Daily: 3,6,9 | Weekly: 6,12,18 | Monthly: 18,36,54 | Intraday: 0.09%, 0.18%, 0.27%
    array.push(ASSET_FAMILIES, AssetFamily.new(array.from("CL", "MCL", "QM"), 0.125, 0.375, 1.125, 0.09, 0.18, 0.27, "OIL")) // Daily: 0.125,0.25,0.375 | Weekly: 0.375,0.75,1.125 | Monthly: 1.125,2.25,3.375 | Intraday: 0.09%, 0.18%, 0.27%
    array.push(ASSET_FAMILIES, AssetFamily.new(array.from("BTC", "MBT"), 100, 300, 900, 0.09, 0.18, 0.27, "BTC"))           // TODO: Verify Monthly | Intraday: 0.09%, 0.18%, 0.27%
    array.push(ASSET_FAMILIES, AssetFamily.new(array.from("ETH", "MET"), 10, 30, 90, 0.09, 0.18, 0.27, "ETH"))           // TODO: Verify Monthly | Intraday: 0.09%, 0.18%, 0.27%

// ═══════════════════════════════════════════════════════════════════════════════
// ASSET DETECTION FUNCTIONS (must be defined before INPUTS)
// ═══════════════════════════════════════════════════════════════════════════════

// Helper: Check if symbol matches any identifier in a family array
symbol_matches_family(symbol_root, family_identifiers) =>
    matched = false
    for identifier in family_identifiers
        if str.contains(symbol_root, identifier)
            matched := true
            break
    matched

// Find matching asset family for current symbol (loop-based lookup)
find_asset_family() =>
    symbol_root = syminfo.root != "" ? syminfo.root : syminfo.ticker
    var AssetFamily matched_family = na

    matched_family := na  // Reset
    for family in ASSET_FAMILIES
        if symbol_matches_family(symbol_root, family.identifiers)
            matched_family := family
            break

    matched_family

// Performance optimization: Cache lookup result in global scope (runs once)
var AssetFamily CACHED_ASSET_FAMILY = na

// Session string cache (performance: calculated once)
var string actualAsiaSession = na
var string actualLondonSession = na
var string actualNyamSession = na
var string actualLunchSession = na
var string actualNypmSession = na
var string actualPremarketSession = na
var string actualOvernightSession = na
var string actualRangeSession = na

// Initialize cache on first bar
if barstate.isfirst
    CACHED_ASSET_FAMILY := find_asset_family()

// Helper functions use cached result (O(1) access after first bar)
is_asset_supported() =>
    not na(CACHED_ASSET_FAMILY)

get_daily_liquidity_depth_distance() =>
    na(CACHED_ASSET_FAMILY) ? 0.0 : CACHED_ASSET_FAMILY.daily_liquidity_depth_distance

get_weekly_liquidity_depth_distance() =>
    na(CACHED_ASSET_FAMILY) ? 0.0 : CACHED_ASSET_FAMILY.weekly_liquidity_depth_distance

get_monthly_liquidity_depth_distance() =>
    na(CACHED_ASSET_FAMILY) ? 0.0 : CACHED_ASSET_FAMILY.monthly_liquidity_depth_distance

get_detected_asset_name() =>
    na(CACHED_ASSET_FAMILY) ? "NOT SUPPORTED" : CACHED_ASSET_FAMILY.display_name

get_intraday_liquidity_depth_percent_1() =>
    na(CACHED_ASSET_FAMILY) ? DEFAULT_INTRADAY_LIQUIDITY_DEPTH_PERCENT_1 : CACHED_ASSET_FAMILY.intraday_liquidity_depth_percent_1

get_intraday_liquidity_depth_percent_2() =>
    na(CACHED_ASSET_FAMILY) ? DEFAULT_INTRADAY_LIQUIDITY_DEPTH_PERCENT_2 : CACHED_ASSET_FAMILY.intraday_liquidity_depth_percent_2

get_intraday_liquidity_depth_percent_3() =>
    na(CACHED_ASSET_FAMILY) ? DEFAULT_INTRADAY_LIQUIDITY_DEPTH_PERCENT_3 : CACHED_ASSET_FAMILY.intraday_liquidity_depth_percent_3

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Pulse Mode (Global Override) ───
pulseModeFilter = input.string(FILTER_ALL, "Show Only", group=GROUP_PULSE_MODE, options=[FILTER_ALL, FILTER_RANGE_BOX, FILTER_1600, FILTER_1600_RANGE_BOX, FILTER_PREMARKET, FILTER_OVERNIGHT, FILTER_INTRADAY, FILTER_DAILY, FILTER_WEEKLY, FILTER_MONTHLY, FILTER_HTF], tooltip="Override all individual ON/OFF toggles to quickly show only specific pool types.\n\n• All: Respect individual toggles\n• Range Box/16:00: Show ONLY that type\n• Range Box + 1600: Show both together\n• Premarket/Overnight: Show ONLY that session\n• Intraday: Show Asia + London + NYAM + Lunch + NYPM\n• Daily/Weekly/Monthly: Show ONLY that type\n• HTF: Show Daily + Weekly + Monthly")

showDaily = input.bool(true, GROUP_DAILY, group=GROUP_DAILY)
dailyShowLast = input.int(5, UI_SHOW_LAST, minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX, group=GROUP_DAILY, inline='daily')
dailyColor = input.color(DEFAULT_DAILY_COLOR, UI_COLOR, group=GROUP_DAILY, inline='daily')
dailyLineWidth = input.int(2, UI_WIDTH, minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group=GROUP_DAILY, inline='daily')

showWeekly = input.bool(true, GROUP_WEEKLY, group=GROUP_WEEKLY)
weeklyShowLast = input.int(5, UI_SHOW_LAST, minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX, group=GROUP_WEEKLY, inline='weekly')
weeklyColor = input.color(DEFAULT_WEEKLY_COLOR, UI_COLOR, group=GROUP_WEEKLY, inline='weekly')
weeklyLineWidth = input.int(3, UI_WIDTH, minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group=GROUP_WEEKLY, inline='weekly')
useTradingWeek = input.bool(false, "Week Starts Sunday 18:00", group=GROUP_WEEKLY, tooltip="Toggle week start behavior:\n• OFF (default): Week starts Monday 00:00 ET (calendar week)\n• ON: Week starts Sunday 18:00 ET (market reopen)\n\nON aligns weekly pools with futures trading cycle (Sunday evening open through Friday close)")

showMonthly = input.bool(true, GROUP_MONTHLY, group=GROUP_MONTHLY)
monthlyShowLast = input.int(5, UI_SHOW_LAST, minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX, group=GROUP_MONTHLY, inline='monthly')
monthlyColor = input.color(DEFAULT_MONTHLY_COLOR, UI_COLOR, group=GROUP_MONTHLY, inline='monthly')
monthlyLineWidth = input.int(4, UI_WIDTH, minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group=GROUP_MONTHLY, inline='monthly')

// ─── HTF Liquidity Depth (Daily/Weekly/Monthly) ───
enableLiquidityDepth = input.bool(false, "Enable HTF Liquidity Depth", group=GROUP_HTF_LIQUIDITY_DEPTH, tooltip="Projects liquidity depth levels (L1, L2, L3) above highs and below lows for HTF pools (Daily/Weekly/Monthly). Automatically adjusts distance based on detected asset.\n\nDaily: Valid on 15min-1hr charts\nWeekly: Valid on 4hr-12hr charts\nMonthly: Valid on 12hr-1W charts")
liquidityDepthColor = input.color(DEFAULT_LIQUIDITY_DEPTH_COLOR, "Color", group=GROUP_HTF_LIQUIDITY_DEPTH, inline="liquidity_depth_style")
liquidityDepthLineWidth = input.int(1, "Width", minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group=GROUP_HTF_LIQUIDITY_DEPTH, inline="liquidity_depth_style")

// Asset detection and liquidity depth distances (automatic, cached for performance)
detectedAsset = get_detected_asset_name()
dailyLiquidityDepthDistance = get_daily_liquidity_depth_distance()
weeklyLiquidityDepthDistance = get_weekly_liquidity_depth_distance()
monthlyLiquidityDepthDistance = get_monthly_liquidity_depth_distance()
isAssetSupported = is_asset_supported()

// Timeframe gating for liquidity depth (performance: computed once per bar)
currentTimeframeMinutes = timeframe.in_seconds() / 60
isDailyLiquidityDepthTimeframeValid = currentTimeframeMinutes >= 15 and currentTimeframeMinutes <= 60  // 15min to 1hr
isWeeklyLiquidityDepthTimeframeValid = currentTimeframeMinutes >= 240 and currentTimeframeMinutes <= 720  // 4hr to 12hr
isMonthlyLiquidityDepthTimeframeValid = currentTimeframeMinutes >= 720 and currentTimeframeMinutes <= 10080  // 12hr to 1W

showAsia = input.bool(true, UI_ASIA_SESSION, group=GROUP_INTRADAY, inline='intraday1')
showLondon = input.bool(true, UI_LONDON_SESSION, group=GROUP_INTRADAY, inline='intraday1')
showNyam = input.bool(true, UI_NYAM_SESSION, group=GROUP_INTRADAY, inline='intraday1')
showLunch = input.bool(true, UI_LUNCH_SESSION, group=GROUP_INTRADAY, inline='intraday1')
showNypm = input.bool(true, UI_NYPM_SESSION, group=GROUP_INTRADAY, inline='intraday1', tooltip='Asia: 2000-0000\nLondon: 0200-0500\nNY AM: 0930-1200\nLunch: 1200-1330\nNY PM: 1330-1600')

intradayShowLast = input.int(5, UI_SHOW_LAST, minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX, group=GROUP_INTRADAY, inline='intraday')
intradayColor = input.color(DEFAULT_INTRADAY_COLOR, UI_COLOR, group=GROUP_INTRADAY, inline='intraday')
intradayLineWidth = input.int(2, UI_WIDTH, minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group=GROUP_INTRADAY, inline='intraday')

showIntradayBackground = input.bool(false, UI_BACKGROUND, group=GROUP_INTRADAY, inline='intraday_bg')
intradayBackgroundColor = input.color(DEFAULT_INTRADAY_BG_COLOR, "", group=GROUP_INTRADAY, inline='intraday_bg')

// ─── Intraday Liquidity Depth (Asia/London/NY AM/Lunch/NY PM/Premarket/Overnight) ───
enableIntradayLiquidityDepth = input.bool(false, "Enable Intraday Liquidity Depth", group=GROUP_INTRADAY_LIQUIDITY_DEPTH, tooltip="Projects percentage-based liquidity depth levels (L1, L2, L3) above highs and below lows for intraday sessions only (Asia, London, NY AM, Lunch, NY PM, Premarket, Overnight).\n\nLiquidity Depth calculated as percentage of the high/low price.\n\nPercentages automatically adjust based on detected asset.")
useManualIntradayPercentages = input.bool(false, "Use Manual %", group=GROUP_INTRADAY_LIQUIDITY_DEPTH, inline="intraday_override", tooltip="Enable to override auto-detected percentages and use manual values below. When disabled, percentages automatically adjust based on asset (NQ/CL/GC: 0.09/0.18/0.27%, ES: 0.03/0.06/0.09%).")
intradayLiquidityDepthPercent1Input = input.float(DEFAULT_INTRADAY_LIQUIDITY_DEPTH_PERCENT_1, "L1 %", minval=0.01, maxval=5.0, step=0.01, group=GROUP_INTRADAY_LIQUIDITY_DEPTH, inline="intraday_liquidity_depth_pct")
intradayLiquidityDepthPercent2Input = input.float(DEFAULT_INTRADAY_LIQUIDITY_DEPTH_PERCENT_2, "L2 %", minval=0.01, maxval=5.0, step=0.01, group=GROUP_INTRADAY_LIQUIDITY_DEPTH, inline="intraday_liquidity_depth_pct")
intradayLiquidityDepthPercent3Input = input.float(DEFAULT_INTRADAY_LIQUIDITY_DEPTH_PERCENT_3, "L3 %", minval=0.01, maxval=5.0, step=0.01, group=GROUP_INTRADAY_LIQUIDITY_DEPTH, inline="intraday_liquidity_depth_pct")
intradayLiquidityDepthColor = input.color(DEFAULT_INTRADAY_LIQUIDITY_DEPTH_COLOR, "Color", group=GROUP_INTRADAY_LIQUIDITY_DEPTH, inline="intraday_liquidity_depth_style")
intradayLiquidityDepthLineWidth = input.int(1, "Width", minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group=GROUP_INTRADAY_LIQUIDITY_DEPTH, inline="intraday_liquidity_depth_style")

// Apply detected asset percentages (override inputs if asset supported and manual override not enabled)
useAutoPercentages = isAssetSupported and not useManualIntradayPercentages
intradayLiquidityDepthPercent1 = useAutoPercentages ? get_intraday_liquidity_depth_percent_1() : intradayLiquidityDepthPercent1Input
intradayLiquidityDepthPercent2 = useAutoPercentages ? get_intraday_liquidity_depth_percent_2() : intradayLiquidityDepthPercent2Input
intradayLiquidityDepthPercent3 = useAutoPercentages ? get_intraday_liquidity_depth_percent_3() : intradayLiquidityDepthPercent3Input

showOvernight = input.bool(true, UI_OVERNIGHT_SESSION, group=GROUP_POISZN, inline='overnight')
overnightColor = input.color(DEFAULT_OVERNIGHT_COLOR, UI_COLOR, group=GROUP_POISZN, inline='overnight')
showOvernightBackground = input.bool(false, UI_BACKGROUND, group=GROUP_POISZN, inline='overnight')
overnightBackgroundColor = input.color(DEFAULT_OVERNIGHT_BG_COLOR, "", group=GROUP_POISZN, inline='overnight', tooltip='Overnight: 1600-0500')
showPremarket = input.bool(true, UI_PREMARKET_SESSION, group=GROUP_POISZN, inline='premarket')
premarketColor = input.color(DEFAULT_PREMARKET_COLOR, UI_COLOR, group=GROUP_POISZN, inline='premarket')
showPremarketBackground = input.bool(false, UI_BACKGROUND, group=GROUP_POISZN, inline='premarket')
premarketBackgroundColor = input.color(DEFAULT_PREMARKET_BG_COLOR, "", group=GROUP_POISZN, inline='premarket', tooltip='Premarket: 0500-0915')

poisznShowLast = input.int(5, UI_SHOW_LAST, minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX, group=GROUP_POISZN, inline='poiszn')
poisznLineWidth = input.int(2, UI_WIDTH, minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group=GROUP_POISZN, inline='poiszn')

showRangeBox = input.bool(false, GROUP_RANGE_BOX, group=GROUP_RANGE_BOX, inline='range')
rangeSessionTime = input.session(DEFAULT_RANGE_SESSION_TIME, "", group=GROUP_RANGE_BOX, inline='range')
rangeBoxColor = input.color(DEFAULT_RANGE_BOX_COLOR, UI_COLOR, group=GROUP_RANGE_BOX, inline='range_style')
rangeMiddleColor = input.color(DEFAULT_RANGE_MIDDLE_COLOR, UI_MIDDLE_LINE, group=GROUP_RANGE_BOX, inline='range_style')
showRangeMiddleLine = input.bool(true, UI_MIDDLE_LINE, group=GROUP_RANGE_BOX, inline='range_options')
rangeBoxShowLast = input.int(15, UI_SHOW_LAST, minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX, group=GROUP_RANGE_BOX, inline='range_options')
rangeBoxWidth = input.int(2, UI_WIDTH, minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group=GROUP_RANGE_BOX, inline='range_options')

show1600Open = input.bool(false, GROUP_1600_OPEN, group=GROUP_1600_OPEN, tooltip="Track and project the 16:00 1-minute candle open price until mitigated. Automatically captures 18:00 reopen on early-close days (e.g., holidays when market closes at 13:00). Only available on 1m to 1H timeframes.")
open1600ShowLast = input.int(15, UI_SHOW_LAST, minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX, group=GROUP_1600_OPEN, inline='1600_options')
open1600Color = input.color(DEFAULT_1600_OPEN_COLOR, UI_COLOR, group=GROUP_1600_OPEN, inline='1600_options')
open1600LineWidth = input.int(2, UI_WIDTH, minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group=GROUP_1600_OPEN, inline='1600_options')
open1600MitigationWindow = input.string(MITIGATION_WINDOW_ANYTIME, "Mitigation Window", group=GROUP_1600_OPEN, inline='1600_mitigation', options=[MITIGATION_WINDOW_ANYTIME, MITIGATION_WINDOW_MARKET_HOURS], tooltip="Anytime: Level can be mitigated any time after 05:00 (includes overnight/Asian session). Levels mitigated more frequently.\nMarket-Hours: Level can ONLY be mitigated during 05:00-16:00 (filters overnight manipulation). Results in MORE levels visible on screen as they persist longer, better for identifying institutional levels.")

showTimeDividers = input.bool(false, "Midnight Dividers", group=GROUP_TIME_DIVIDERS, inline='dividers')
timeDividerShowLast = input.int(15, UI_SHOW_LAST, minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX, group=GROUP_TIME_DIVIDERS, inline='dividers')
timeDividerColor = input.color(DEFAULT_TIME_DIVIDER_COLOR, UI_COLOR, group=GROUP_TIME_DIVIDERS, inline='dividers')

showDayLabels = input.bool(false, "Day Labels", group=GROUP_TIME_DIVIDERS, inline='day_labels')
dayLabelColor = input.color(DEFAULT_DAY_LABEL_COLOR, UI_COLOR, group=GROUP_TIME_DIVIDERS, inline='day_labels')
mondayLabelColor = input.color(DEFAULT_MONDAY_LABEL_COLOR, "Monday", group=GROUP_TIME_DIVIDERS, inline='day_labels')

showLabels = input.bool(true, GROUP_LABELS, group=GROUP_LABELS, inline='labels')
labelTextColor = input.color(DEFAULT_LABEL_TEXT_COLOR, UI_TEXT_COLOR, group=GROUP_LABELS, inline='labels')
labelOffsetEnabled = input.bool(false, "Smart Label Separation", group=GROUP_LABELS, inline='labels', tooltip="Enable vertical offset stacking to prevent label collisions. Automatically adapts spacing based on asset volatility. Turn ON only if you see overlapping labels.")

// ─── Asset Levels Table ───
showAssetLevelsTable = input.bool(false, "Show Asset Levels", group=GROUP_LABELS, tooltip="Display a table showing detected asset and its liquidity depth levels")

// ─── Color Reference Table ───
showColorTable = input.bool(false, "Show Color Reference Table", group=GROUP_COLOR_TABLE, tooltip="Display a table showing all color settings with RGB values and transparency levels")

// ═══════════════════════════════════════════════════════════════════════════════
// PULSE MODE FILTER LOGIC
// ═══════════════════════════════════════════════════════════════════════════════

// Apply Pulse Mode filter to determine if a pool type should be shown
// Overrides individual ON/OFF toggles when filter is not "All"
applyPulseModeFilter(poolType, individualToggle) =>
    bool result = individualToggle

    if pulseModeFilter == FILTER_MONTHLY
        result := poolType == POOL_TYPE_MONTHLY
    else if pulseModeFilter == FILTER_WEEKLY
        result := poolType == POOL_TYPE_WEEKLY
    else if pulseModeFilter == FILTER_DAILY
        result := poolType == POOL_TYPE_DAILY
    else if pulseModeFilter == FILTER_HTF
        result := poolType == POOL_TYPE_DAILY or poolType == POOL_TYPE_WEEKLY or poolType == POOL_TYPE_MONTHLY
    else if pulseModeFilter == FILTER_INTRADAY
        result := poolType == POOL_TYPE_ASIA or poolType == POOL_TYPE_LONDON or poolType == POOL_TYPE_NYAM or poolType == POOL_TYPE_LUNCH or poolType == POOL_TYPE_NYPM
    else if pulseModeFilter == FILTER_OVERNIGHT
        result := poolType == POOL_TYPE_OVERNIGHT
    else if pulseModeFilter == FILTER_PREMARKET
        result := poolType == POOL_TYPE_PREMARKET
    else if pulseModeFilter == FILTER_1600
        result := poolType == POOL_TYPE_1600
    else if pulseModeFilter == FILTER_RANGE_BOX
        result := poolType == POOL_TYPE_RANGE_BOX
    else if pulseModeFilter == FILTER_1600_RANGE_BOX
        result := poolType == POOL_TYPE_1600 or poolType == POOL_TYPE_RANGE_BOX
    // else FILTER_ALL - use individual toggle

    result

// Apply Pulse Mode filter and timeframe visibility to each pool type
// HTF levels hidden on their native timeframe or higher (e.g., Daily hidden on Daily/Weekly/Monthly)
showDailyFiltered = applyPulseModeFilter(POOL_TYPE_DAILY, showDaily) and timeframe.in_seconds() < 86400  // Hide on Daily or higher
showWeeklyFiltered = applyPulseModeFilter(POOL_TYPE_WEEKLY, showWeekly) and timeframe.in_seconds() < 604800  // Hide on Weekly or higher
showMonthlyFiltered = applyPulseModeFilter(POOL_TYPE_MONTHLY, showMonthly) and timeframe.in_seconds() < 2592000  // Hide on Monthly
showAsiaFiltered = applyPulseModeFilter(POOL_TYPE_ASIA, showAsia)
showLondonFiltered = applyPulseModeFilter(POOL_TYPE_LONDON, showLondon)
showNyamFiltered = applyPulseModeFilter(POOL_TYPE_NYAM, showNyam)
showLunchFiltered = applyPulseModeFilter(POOL_TYPE_LUNCH, showLunch)
showNypmFiltered = applyPulseModeFilter(POOL_TYPE_NYPM, showNypm)
showPremarketFiltered = applyPulseModeFilter(POOL_TYPE_PREMARKET, showPremarket)
showOvernightFiltered = applyPulseModeFilter(POOL_TYPE_OVERNIGHT, showOvernight)
show1600OpenFiltered = applyPulseModeFilter(POOL_TYPE_1600, show1600Open)
showRangeBoxFiltered = applyPulseModeFilter(POOL_TYPE_RANGE_BOX, showRangeBox)

// ═══════════════════════════════════════════════════════════════════════════════
// 24/7 ASSET AUTO-DETECTION & SUNDAY LIQUIDITY HANDLING
// ═══════════════════════════════════════════════════════════════════════════════

// Auto-detect 24/7 asset by scanning for weekend bars (excluding Sunday 18:00+ reopen)
// STRATEGY: Default TRUE (assume 24/7), only set FALSE after scanning 7+ days with no weekends
//
// AUTOMATIC SUNDAY EVENING BEHAVIOR:
// • 24/7 assets (crypto): Sunday evening is normal trading → always included
// • Traditional assets (forex/futures): Sunday 18:00-23:59 is thin reopening liquidity → automatically excluded
var bool is247Asset = true
var bool detectionCompleted = false

// Only run detection once after we have 7+ days of data
if not detectionCompleted
    barsIn7Days = int(10080 / (timeframe.in_seconds() / 60))

    if bar_index >= barsIn7Days
        // Check current bar first (fast path - if we loaded on Saturday, instant detect)
        currentDay = dayofweek(time, NY_TIMEZONE)
        currentHour = hour(time, NY_TIMEZONE)
        isSaturdayNow = currentDay == dayofweek.saturday
        isEarlySundayNow = currentDay == dayofweek.sunday and currentHour < SUNDAY_REOPEN_START_HOUR

        if isSaturdayNow or isEarlySundayNow
            // Current bar is weekend - definitely 24/7
            is247Asset := true
        else
            // Scan last 7 days for weekend bars
            maxLookback = math.min(9999, barsIn7Days)
            foundWeekendBar = false

            for lookback = 0 to maxLookback by 20
                checkDay = dayofweek(time[lookback], NY_TIMEZONE)
                checkHour = hour(time[lookback], NY_TIMEZONE)

                isSaturday = checkDay == dayofweek.saturday
                isEarlySunday = checkDay == dayofweek.sunday and checkHour < SUNDAY_REOPEN_START_HOUR
                if isSaturday or isEarlySunday
                    foundWeekendBar := true
                    break

            // Set result based on scan
            is247Asset := foundWeekendBar

        detectionCompleted := true

// Calculate session strings after detection (apply day codes)
// Traditional assets handle Sunday evening exclusion via should_skip_sunday_liquidity()
actualAsiaSession := is247Asset ? ("2000-0000" + DAY_CODE_ALL_DAYS) : (str.replace_all(DEFAULT_ASIA_SESSION_TIME, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualLondonSession := is247Asset ? ("0200-0500" + DAY_CODE_ALL_DAYS) : (str.replace_all(DEFAULT_LONDON_SESSION_TIME, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualNyamSession := is247Asset ? ("0930-1200" + DAY_CODE_ALL_DAYS) : (str.replace_all(DEFAULT_NYAM_SESSION_TIME, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualLunchSession := is247Asset ? ("1200-1330" + DAY_CODE_ALL_DAYS) : (str.replace_all(DEFAULT_LUNCH_SESSION_TIME, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualNypmSession := is247Asset ? ("1330-1600" + DAY_CODE_ALL_DAYS) : (str.replace_all(DEFAULT_NYPM_SESSION_TIME, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualPremarketSession := is247Asset ? ("0500-0915" + DAY_CODE_ALL_DAYS) : (str.replace_all(DEFAULT_PREMARKET_SESSION_TIME, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualOvernightSession := is247Asset ? ("1600-0500" + DAY_CODE_ALL_DAYS) : (str.replace_all(DEFAULT_OVERNIGHT_SESSION_TIME, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)
actualRangeSession := is247Asset ? ("0200-0215" + DAY_CODE_ALL_DAYS) : (str.replace_all(rangeSessionTime, DAY_CODE_MON_SAT, "") + DAY_CODE_ALL_DAYS)

// ═══════════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

create_pool() =>
    LiquidityPool.new(array.new_float(), array.new_float(), array.new_int(), array.new_int(), array.new_bool(), array.new_bool(), array.new_int(), array.new_int(), array.new_int(), array.new_int(), array.new<LiquidityDepthLevels>(), array.new<LiquidityDepthLevels>(), array.new<LiquidityDepthLevels>(), array.new<LiquidityDepthLevels>(), na, na, na, na, na)

create_range_box() =>
    RangeBox.new(array.new_float(), array.new_float(), array.new_int(), array.new_int(), na, na, na)

create_time_divider() =>
    TimeDivider.new(array.new_int(), array.new_int(), array.new_string())

create_1600_open() =>
    SixteenHundredOpen.new(array.new_float(), array.new_int(), array.new_bool(), array.new_int(), array.new_int(), na, na, false, na, na)

pool_get_high_end_time(pool, index, fallback_time) =>
    high_breached = array.get(pool.high_breached, index)
    high_breach_time = array.get(pool.high_breach_times, index)
    high_breached and not na(high_breach_time) ? high_breach_time : fallback_time

pool_get_low_end_time(pool, index, fallback_time) =>
    low_breached = array.get(pool.low_breached, index)
    low_breach_time = array.get(pool.low_breach_times, index)
    low_breached and not na(low_breach_time) ? low_breach_time : fallback_time

pool_store_session(pool) =>
    if not na(pool.current_high)
        array.push(pool.highs, pool.current_high)
        array.push(pool.lows, pool.current_low)
        array.push(pool.high_times, pool.current_high_time)
        array.push(pool.low_times, pool.current_low_time)
        array.push(pool.high_breached, false)
        array.push(pool.low_breached, false)
        array.push(pool.high_breach_times, na)
        array.push(pool.low_breach_times, na)

        // Initialize liquidity depth levels for this pool entry (HTF only)
        high_liquidity_depth = LiquidityDepthLevels.new(array.new_bool(NUM_LIQUIDITY_DEPTH_LEVELS, false), array.new_int(NUM_LIQUIDITY_DEPTH_LEVELS, na))
        low_liquidity_depth = LiquidityDepthLevels.new(array.new_bool(NUM_LIQUIDITY_DEPTH_LEVELS, false), array.new_int(NUM_LIQUIDITY_DEPTH_LEVELS, na))
        array.push(pool.high_liquidity_depths, high_liquidity_depth)
        array.push(pool.low_liquidity_depths, low_liquidity_depth)

pool_detect_breaches(pool, scan_cap, liquidity_depth_distance) =>
    if array.size(pool.highs) > 0
        scan_size = math.min(array.size(pool.highs), scan_cap)
        start_index = math.max(0, array.size(pool.highs) - scan_size)

        for i = start_index to array.size(pool.highs) - 1
            // Base level (L0) breach detection
            if not array.get(pool.high_breached, i)
                tracked_high = array.get(pool.highs, i)
                if high >= tracked_high
                    array.set(pool.high_breached, i, true)
                    array.set(pool.high_breach_times, i, time)

            if not array.get(pool.low_breached, i)
                tracked_low = array.get(pool.lows, i)
                if low <= tracked_low
                    array.set(pool.low_breached, i, true)
                    array.set(pool.low_breach_times, i, time)

            // Liquidity Depth level breach detection (only if distance > 0 for performance)
            if liquidity_depth_distance > 0
                tracked_high = array.get(pool.highs, i)
                tracked_low = array.get(pool.lows, i)
                high_liquidity_depth = array.get(pool.high_liquidity_depths, i)
                low_liquidity_depth = array.get(pool.low_liquidity_depths, i)

                for level_idx = 0 to NUM_LIQUIDITY_DEPTH_LEVELS - 1
                    multiplier = level_idx + 1  // L1=1x, L2=2x, L3=3x

                    // Check high liquidity depth level
                    if not array.get(high_liquidity_depth.breached, level_idx)
                        level_price = tracked_high + (multiplier * liquidity_depth_distance)
                        if high >= level_price
                            array.set(high_liquidity_depth.breached, level_idx, true)
                            array.set(high_liquidity_depth.breach_times, level_idx, time)

                    // Check low liquidity depth level
                    if not array.get(low_liquidity_depth.breached, level_idx)
                        level_price = tracked_low - (multiplier * liquidity_depth_distance)
                        if low <= level_price
                            array.set(low_liquidity_depth.breached, level_idx, true)
                            array.set(low_liquidity_depth.breach_times, level_idx, time)

pool_detect_intraday_breaches(pool, scan_cap, percent1, percent2, percent3) =>
    if array.size(pool.highs) > 0
        scan_size = math.min(array.size(pool.highs), scan_cap)
        start_index = math.max(0, array.size(pool.highs) - scan_size)

        for i = start_index to array.size(pool.highs) - 1
            // Base level (L0) breach detection
            if not array.get(pool.high_breached, i)
                tracked_high = array.get(pool.highs, i)
                if high >= tracked_high
                    array.set(pool.high_breached, i, true)
                    array.set(pool.high_breach_times, i, time)

            if not array.get(pool.low_breached, i)
                tracked_low = array.get(pool.lows, i)
                if low <= tracked_low
                    array.set(pool.low_breached, i, true)
                    array.set(pool.low_breach_times, i, time)

            // Intraday liquidity depth level breach detection (percentage-based)
            if percent1 > 0
                tracked_high = array.get(pool.highs, i)
                tracked_low = array.get(pool.lows, i)
                intraday_high_liquidity_depth = array.get(pool.intraday_high_liquidity_depths, i)
                intraday_low_liquidity_depth = array.get(pool.intraday_low_liquidity_depths, i)
                percents = array.from(percent1, percent2, percent3)

                for level_idx = 0 to NUM_INTRADAY_LIQUIDITY_DEPTH_LEVELS - 1
                    percent = array.get(percents, level_idx)

                    // Check high liquidity depth level
                    if not array.get(intraday_high_liquidity_depth.breached, level_idx)
                        level_price = tracked_high + (tracked_high * (percent / 100.0))
                        if high >= level_price
                            array.set(intraday_high_liquidity_depth.breached, level_idx, true)
                            array.set(intraday_high_liquidity_depth.breach_times, level_idx, time)

                    // Check low liquidity depth level
                    if not array.get(intraday_low_liquidity_depth.breached, level_idx)
                        level_price = tracked_low - (tracked_low * (percent / 100.0))
                        if low <= level_price
                            array.set(intraday_low_liquidity_depth.breached, level_idx, true)
                            array.set(intraday_low_liquidity_depth.breach_times, level_idx, time)

build_label(pool_type) =>
    pool_type

// Helper: Get intraday liquidity depth percentage for a given level (0, 1, 2)
get_intraday_percent(level_idx) =>
    level_idx == 0 ? intradayLiquidityDepthPercent1 : (level_idx == 1 ? intradayLiquidityDepthPercent2 : intradayLiquidityDepthPercent3)

should_skip_sunday_liquidity(time_value) =>
    // Traditional markets: skip Sunday 18:00-23:59 (thin reopening liquidity)
    // 24/7 markets: never skip (Sunday is normal trading)
    not is247Asset and dayofweek(time_value, NY_TIMEZONE) == dayofweek.sunday and hour(time_value, NY_TIMEZONE) >= SUNDAY_REOPEN_START_HOUR

track_intraday_session(pool, sessionString, skipSunday) =>
    inSession = not na(time(timeframe.period, sessionString, NY_TIMEZONE))
    wasInSession = not na(time(timeframe.period, sessionString, NY_TIMEZONE)[1])
    sessionJustStarted = inSession and not wasInSession
    sessionJustEnded = not inSession and wasInSession

    // ALWAYS process session endings (to save Friday data before weekend)
    if sessionJustEnded
        // Store session data including end time
        if not na(pool.current_high)
            array.push(pool.highs, pool.current_high)
            array.push(pool.lows, pool.current_low)
            array.push(pool.high_times, pool.current_high_time)
            array.push(pool.low_times, pool.current_low_time)
            array.push(pool.high_breached, false)
            array.push(pool.low_breached, false)
            array.push(pool.high_breach_times, na)
            array.push(pool.low_breach_times, na)
            array.push(pool.session_start_times, pool.current_session_start_time)
            array.push(pool.session_end_times, time)

            // Initialize intraday liquidity depth levels for this pool entry
            intraday_high_liquidity_depth = LiquidityDepthLevels.new(array.new_bool(NUM_INTRADAY_LIQUIDITY_DEPTH_LEVELS, false), array.new_int(NUM_INTRADAY_LIQUIDITY_DEPTH_LEVELS, na))
            intraday_low_liquidity_depth = LiquidityDepthLevels.new(array.new_bool(NUM_INTRADAY_LIQUIDITY_DEPTH_LEVELS, false), array.new_int(NUM_INTRADAY_LIQUIDITY_DEPTH_LEVELS, na))
            array.push(pool.intraday_high_liquidity_depths, intraday_high_liquidity_depth)
            array.push(pool.intraday_low_liquidity_depths, intraday_low_liquidity_depth)

        // CRITICAL: Clear current session tracking after storing (prevents Sunday ghost sessions)
        pool.current_high := na
        pool.current_low := na
        pool.current_high_time := na
        pool.current_low_time := na
        pool.current_session_start_time := na

    // Only process session starts/updates when NOT skipping Sunday
    if not skipSunday
        if sessionJustStarted
            pool.current_high := high
            pool.current_low := low
            pool.current_high_time := time
            pool.current_low_time := time
            pool.current_session_start_time := time

        if inSession
            if high > pool.current_high
                pool.current_high := high
                pool.current_high_time := time
            if low < pool.current_low
                pool.current_low := low
                pool.current_low_time := time

track_range_session(rangeBox, sessionString) =>
    inSession = not na(time(timeframe.period, sessionString, NY_TIMEZONE))
    wasInSession = not na(time(timeframe.period, sessionString, NY_TIMEZONE)[1])
    sessionJustStarted = inSession and not wasInSession
    sessionJustEnded = not inSession and wasInSession

    if sessionJustEnded
        if not na(rangeBox.current_high)
            array.push(rangeBox.highs, rangeBox.current_high)
            array.push(rangeBox.lows, rangeBox.current_low)
            array.push(rangeBox.start_times, rangeBox.current_start_time)
            array.push(rangeBox.end_times, time)

        // Clear current session tracking after storing
        rangeBox.current_high := na
        rangeBox.current_low := na
        rangeBox.current_start_time := na

    if sessionJustStarted
        rangeBox.current_high := high
        rangeBox.current_low := low
        rangeBox.current_start_time := time

    if inSession
        if high > rangeBox.current_high
            rangeBox.current_high := high
        if low < rangeBox.current_low
            rangeBox.current_low := low

get_day_name(timestamp) =>
    day = dayofweek(timestamp, NY_TIMEZONE)
    day == dayofweek.monday ? DAY_MON : day == dayofweek.tuesday ? DAY_TUE : day == dayofweek.wednesday ? DAY_WED : day == dayofweek.thursday ? DAY_THU : day == dayofweek.friday ? DAY_FRI : day == dayofweek.saturday ? DAY_SAT : DAY_SUN

detect_time_divider(divider) =>
    currentHour = hour(time, NY_TIMEZONE)
    currentMinute = minute(time, NY_TIMEZONE)
    previousHour = hour(time[1], NY_TIMEZONE)

    // Midnight: detect when hour changes to 0 from any non-zero hour (works on 1H-4H timeframes)
    isDividerTime = currentHour == 0 and currentMinute == 0 and previousHour != 0

    if isDividerTime
        // Store the new divider time
        array.push(divider.divider_times, time)

        // If we have at least 2 dividers, calculate midpoint with previous divider
        if array.size(divider.divider_times) >= 2
            // Get the two most recent dividers
            latest_divider = array.get(divider.divider_times, array.size(divider.divider_times) - 1)
            previous_divider = array.get(divider.divider_times, array.size(divider.divider_times) - 2)

            // Calculate midpoint
            midpoint = int((latest_divider + previous_divider) / 2)

            // Get day name for the latest divider
            day_name = get_day_name(latest_divider)

            // Store midpoint and day name
            array.push(divider.midpoint_times, midpoint)
            array.push(divider.midpoint_days, day_name)

// ═══════════════════════════════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════════════════════════════

var LiquidityPool daily_pool = create_pool()
var LiquidityPool weekly_pool = create_pool()
var LiquidityPool monthly_pool = create_pool()
var LiquidityPool asia_pool = create_pool()
var LiquidityPool london_pool = create_pool()
var LiquidityPool nyam_pool = create_pool()
var LiquidityPool lunch_pool = create_pool()
var LiquidityPool nypm_pool = create_pool()
var LiquidityPool premarket_pool = create_pool()
var LiquidityPool overnight_pool = create_pool()
var RangeBox range_box = create_range_box()
var TimeDivider time_divider = create_time_divider()
var SixteenHundredOpen sixteen_hundred_open = create_1600_open()
var array<line> all_lines = array.new<line>()
var array<label> all_labels = array.new<label>()
var array<box> all_boxes = array.new<box>()
var table asset_levels_table = table.new(position.top_right, 3, 6, border_width=1)

// ═══════════════════════════════════════════════════════════════════════════════
// DATA COLLECTION
// ═══════════════════════════════════════════════════════════════════════════════

is_new_daily_bar = ta.change(dayofmonth(time, NY_TIMEZONE)) != 0
is_new_weekly_bar = ta.change(weekofyear(time, NY_TIMEZONE)) != 0
is_new_monthly_bar = ta.change(month(time, NY_TIMEZONE)) != 0

// Trading week detection: Triggers when market reopens Sunday 18:00 ET (new trading week)
is_new_trading_week = false
if not is247Asset  // Only for traditional assets
    currentDay = dayofweek(time, NY_TIMEZONE)
    currentHour = hour(time, NY_TIMEZONE)
    prevDay = dayofweek(time[1], NY_TIMEZONE)
    prevHour = hour(time[1], NY_TIMEZONE)

    // New trading week = crossing into Sunday 18:00+ from before
    isSundayReopenNow = currentDay == dayofweek.sunday and currentHour >= SUNDAY_REOPEN_START_HOUR
    wasSundayReopenBefore = prevDay == dayofweek.sunday and prevHour >= SUNDAY_REOPEN_START_HOUR

    is_new_trading_week := isSundayReopenNow and not wasSundayReopenBefore

// Detect toggle change and clear weekly pool to prevent duplicate data
var bool prev_trading_week_mode = useTradingWeek
if useTradingWeek != prev_trading_week_mode
    // Clear all weekly pool arrays when switching modes
    array.clear(weekly_pool.highs)
    array.clear(weekly_pool.lows)
    array.clear(weekly_pool.high_times)
    array.clear(weekly_pool.low_times)
    array.clear(weekly_pool.high_breached)
    array.clear(weekly_pool.low_breached)
    array.clear(weekly_pool.high_breach_times)
    array.clear(weekly_pool.low_breach_times)
    array.clear(weekly_pool.session_start_times)
    array.clear(weekly_pool.session_end_times)
    array.clear(weekly_pool.high_liquidity_depths)
    array.clear(weekly_pool.low_liquidity_depths)
    prev_trading_week_mode := useTradingWeek

// Calculate Sunday skip once for all liquidity sources (performance optimization)
skip_sunday_liquidity = should_skip_sunday_liquidity(time)

if barstate.isfirst
    daily_pool.current_high := high
    daily_pool.current_low := low
    daily_pool.current_high_time := time
    daily_pool.current_low_time := time

    weekly_pool.current_high := high
    weekly_pool.current_low := low
    weekly_pool.current_high_time := time
    weekly_pool.current_low_time := time

    monthly_pool.current_high := high
    monthly_pool.current_low := low
    monthly_pool.current_high_time := time
    monthly_pool.current_low_time := time
else
    // Daily tracking - runs on all non-first bars
    if is_new_daily_bar
        // Don't store if coming from Sunday evening (traditional markets only)
        // Sunday data was already merged into Friday's stored pool
        coming_from_sunday_evening = not is247Asset and dayofweek(time[1], NY_TIMEZONE) == dayofweek.sunday and hour(time[1], NY_TIMEZONE) >= SUNDAY_REOPEN_START_HOUR
        if not coming_from_sunday_evening
            pool_store_session(daily_pool)

        // Only initialize new tracking if NOT skipping Sunday
        if not skip_sunday_liquidity
            if not coming_from_sunday_evening
                // Normal start: initialize with opening prices
                daily_pool.current_high := high
                daily_pool.current_low := low
                daily_pool.current_high_time := time
                daily_pool.current_low_time := time
            else
                // Coming from Sunday evening: Start fresh Monday tracking
                // Each day should have its own high/low recorded
                // Friday's levels (including Sunday extension) are already stored
                daily_pool.current_high := high
                daily_pool.current_low := low
                daily_pool.current_high_time := time
                daily_pool.current_low_time := time
    else if not skip_sunday_liquidity
        // Update tracking during the day
        if high > daily_pool.current_high
            daily_pool.current_high := high
            daily_pool.current_high_time := time
        if low < daily_pool.current_low
            daily_pool.current_low := low
            daily_pool.current_low_time := time
    else
        if high > daily_pool.current_high
            daily_pool.current_high := high
            daily_pool.current_high_time := time
        if low < daily_pool.current_low
            daily_pool.current_low := low
            daily_pool.current_low_time := time

    // Weekly (toggle between calendar week and trading week)
    weekly_reset_trigger = useTradingWeek ? is_new_trading_week : is_new_weekly_bar
    if weekly_reset_trigger
        pool_store_session(weekly_pool)
        weekly_pool.current_high := high
        weekly_pool.current_low := low
        weekly_pool.current_high_time := time
        weekly_pool.current_low_time := time
    else
        if high > weekly_pool.current_high
            weekly_pool.current_high := high
            weekly_pool.current_high_time := time
        if low < weekly_pool.current_low
            weekly_pool.current_low := low
            weekly_pool.current_low_time := time

    // Monthly
    if is_new_monthly_bar
        pool_store_session(monthly_pool)
        monthly_pool.current_high := high
        monthly_pool.current_low := low
        monthly_pool.current_high_time := time
        monthly_pool.current_low_time := time
    else
        if high > monthly_pool.current_high
            monthly_pool.current_high := high
            monthly_pool.current_high_time := time
        if low < monthly_pool.current_low
            monthly_pool.current_low := low
            monthly_pool.current_low_time := time
// When skip_sunday_liquidity is TRUE: HTF pools freeze Friday's data (don't update)
// Intraday/PoiSzn sessions always finalize Friday sessions, but skip starting new ones during Sunday evening

// Intraday session liquidity pool tracking
// ALWAYS call tracking to detect Friday session endings (functions handle Sunday skip internally)
if timeframe.in_seconds() <= INTRADAY_SESSION_MAX_TIMEFRAME
    if showAsiaFiltered
        track_intraday_session(asia_pool, actualAsiaSession, skip_sunday_liquidity)

    if showLondonFiltered
        track_intraday_session(london_pool, actualLondonSession, skip_sunday_liquidity)

    if showNyamFiltered
        track_intraday_session(nyam_pool, actualNyamSession, skip_sunday_liquidity)

    if showLunchFiltered
        track_intraday_session(lunch_pool, actualLunchSession, skip_sunday_liquidity)

    if showNypmFiltered
        track_intraday_session(nypm_pool, actualNypmSession, skip_sunday_liquidity)

    // PoiSzn session liquidity pool tracking
    if showPremarketFiltered
        track_intraday_session(premarket_pool, actualPremarketSession, skip_sunday_liquidity)

    if showOvernightFiltered
        track_intraday_session(overnight_pool, actualOvernightSession, skip_sunday_liquidity)

// Sunday 18:00-23:59 Continuation for Traditional Markets
// For futures/forex: Sunday evening is part of Friday's trading session
// Update Friday's stored daily pool if new highs/lows occur during Sunday reopen
if not is247Asset and dayofweek(time, NY_TIMEZONE) == dayofweek.sunday and hour(time, NY_TIMEZONE) >= SUNDAY_REOPEN_START_HOUR
    // Update DAILY pool only (Friday's stored high/low)
    if showDaily and array.size(daily_pool.highs) > 0
        last_index = array.size(daily_pool.highs) - 1
        last_high = array.get(daily_pool.highs, last_index)
        last_low = array.get(daily_pool.lows, last_index)


        // Update both price AND timestamp when new highs/lows are made
        // Also reset breach status since this is a new level
        if high > last_high
            array.set(daily_pool.highs, last_index, high)
            array.set(daily_pool.high_times, last_index, time)
            array.set(daily_pool.high_breached, last_index, false)
            array.set(daily_pool.high_breach_times, last_index, na)
            // Also update current tracking
            daily_pool.current_high := high
            daily_pool.current_high_time := time
        if low < last_low
            array.set(daily_pool.lows, last_index, low)
            array.set(daily_pool.low_times, last_index, time)
            array.set(daily_pool.low_breached, last_index, false)
            array.set(daily_pool.low_breach_times, last_index, na)
            // Also update current tracking
            daily_pool.current_low := low
            daily_pool.current_low_time := time

        // Maintain Friday's levels in current tracking even if no new highs/lows
        // This ensures Monday starts with Friday's levels, not Sunday's gap prices
        // ALWAYS set to Friday's stored values during Sunday evening
        daily_pool.current_high := last_high
        daily_pool.current_high_time := array.get(daily_pool.high_times, last_index)
        daily_pool.current_low := last_low
        daily_pool.current_low_time := array.get(daily_pool.low_times, last_index)

// Range box tracking
if not skip_sunday_liquidity
    if showRangeBoxFiltered
        track_range_session(range_box, actualRangeSession)

// Time divider tracking
if not skip_sunday_liquidity
    if showTimeDividers and timeframe.in_seconds() <= TIME_DIVIDER_MAX_TIMEFRAME
        detect_time_divider(time_divider)

// 16:00/18:00 Open tracking - detect and store
// Automatically captures 16:00 on normal days, 18:00 on early-close days (consistent with overnight session behavior)
// NOTE: Not affected by Sunday skip because 16:00 doesn't occur during Sunday evening (market opens at 18:00)
// and mitigation detection must still run to check stored levels
// Requires intraday timeframe (1m to 1H) to capture 1-minute candle precisely
if show1600OpenFiltered and timeframe.in_seconds() >= SIXTEEN_HUNDRED_OPEN_MIN_TIMEFRAME and timeframe.in_seconds() <= SIXTEEN_HUNDRED_OPEN_MAX_TIMEFRAME
    currentHour_1600 = hour(time, NY_TIMEZONE)
    currentMinute_1600 = minute(time, NY_TIMEZONE)

    // Try to detect 16:00 first (normal close), then 18:00 (early close reopen)
    is1600Bar = currentHour_1600 == MARKET_CLOSE_HOUR and currentMinute_1600 == 0
    is1800Bar = currentHour_1600 == SUNDAY_REOPEN_START_HOUR and currentMinute_1600 == 0

    // For traditional markets, skip Sunday 16:00 (only 18:00 reopen is valid)
    isSunday = dayofweek(time, NY_TIMEZONE) == dayofweek.sunday
    skipSunday1600 = not is247Asset and isSunday

    if is1600Bar and not skipSunday1600
        // Push previous day's level to storage if it exists
        if not na(sixteen_hundred_open.current_open)
            array.push(sixteen_hundred_open.opens, sixteen_hundred_open.current_open)
            array.push(sixteen_hundred_open.times, sixteen_hundred_open.current_time)
            array.push(sixteen_hundred_open.mitigated, sixteen_hundred_open.current_mitigated)
            array.push(sixteen_hundred_open.mitigation_times, sixteen_hundred_open.current_mitigation_time)
            array.push(sixteen_hundred_open.capture_hours, sixteen_hundred_open.current_capture_hour)

        // Capture new 16:00 open and reset mitigation status
        sixteen_hundred_open.current_open := open
        sixteen_hundred_open.current_time := time
        sixteen_hundred_open.current_mitigated := false
        sixteen_hundred_open.current_mitigation_time := na
        sixteen_hundred_open.current_capture_hour := 16

    else if is1800Bar and not isSunday
        // Only capture 18:00 on WEEKDAYS for early-close holidays (not Sunday reopen)
        // Check if we haven't captured a 16:00 TODAY (early close fallback)
        capturedToday = not na(sixteen_hundred_open.current_open) and dayofmonth(sixteen_hundred_open.current_time, NY_TIMEZONE) == dayofmonth(time, NY_TIMEZONE)

        if not capturedToday
            // Push previous day's level to storage if it exists
            if not na(sixteen_hundred_open.current_open)
                array.push(sixteen_hundred_open.opens, sixteen_hundred_open.current_open)
                array.push(sixteen_hundred_open.times, sixteen_hundred_open.current_time)
                array.push(sixteen_hundred_open.mitigated, sixteen_hundred_open.current_mitigated)
                array.push(sixteen_hundred_open.mitigation_times, sixteen_hundred_open.current_mitigation_time)
                array.push(sixteen_hundred_open.capture_hours, sixteen_hundred_open.current_capture_hour)

            // Capture 18:00 open (early close reopen)
            sixteen_hundred_open.current_open := open
            sixteen_hundred_open.current_time := time
            sixteen_hundred_open.current_mitigated := false
            sixteen_hundred_open.current_mitigation_time := na
            sixteen_hundred_open.current_capture_hour := 18

// ═══════════════════════════════════════════════════════════════════════════════
// DAY LABELS - Simple recurring time check (like date.pine)
// ═══════════════════════════════════════════════════════════════════════════════

// Day labels appear at noon (midpoint between midnight dividers)
currentHour = hour(time, NY_TIMEZONE)
currentMinute = minute(time, NY_TIMEZONE)
currentDay = dayofweek(time, NY_TIMEZONE)

// Midpoint between consecutive midnights is noon (12:00)
isMidpoint = currentHour == 12 and currentMinute == 0

// Plot day labels at midpoint - using plotchar at bottom (no lower option available)
plotchar(showDayLabels and timeframe.in_seconds() <= TIME_DIVIDER_MAX_TIMEFRAME and isMidpoint and currentDay == dayofweek.monday, char=" ", text=DAY_MON, location=location.bottom, color=color.new(mondayLabelColor, 100), textcolor=mondayLabelColor, size=size.tiny, editable=false)
plotchar(showDayLabels and timeframe.in_seconds() <= TIME_DIVIDER_MAX_TIMEFRAME and isMidpoint and currentDay == dayofweek.tuesday, char=" ", text=DAY_TUE, location=location.bottom, color=color.new(dayLabelColor, 100), textcolor=dayLabelColor, size=size.tiny, editable=false)
plotchar(showDayLabels and timeframe.in_seconds() <= TIME_DIVIDER_MAX_TIMEFRAME and isMidpoint and currentDay == dayofweek.wednesday, char=" ", text=DAY_WED, location=location.bottom, color=color.new(dayLabelColor, 100), textcolor=dayLabelColor, size=size.tiny, editable=false)
plotchar(showDayLabels and timeframe.in_seconds() <= TIME_DIVIDER_MAX_TIMEFRAME and isMidpoint and currentDay == dayofweek.thursday, char=" ", text=DAY_THU, location=location.bottom, color=color.new(dayLabelColor, 100), textcolor=dayLabelColor, size=size.tiny, editable=false)
plotchar(showDayLabels and timeframe.in_seconds() <= TIME_DIVIDER_MAX_TIMEFRAME and isMidpoint and currentDay == dayofweek.friday, char=" ", text=DAY_FRI, location=location.bottom, color=color.new(dayLabelColor, 100), textcolor=dayLabelColor, size=size.tiny, editable=false)
plotchar(showDayLabels and timeframe.in_seconds() <= TIME_DIVIDER_MAX_TIMEFRAME and isMidpoint and currentDay == dayofweek.saturday, char=" ", text=DAY_SAT, location=location.bottom, color=color.new(dayLabelColor, 100), textcolor=dayLabelColor, size=size.tiny, editable=false)
plotchar(showDayLabels and timeframe.in_seconds() <= TIME_DIVIDER_MAX_TIMEFRAME and isMidpoint and currentDay == dayofweek.sunday, char=" ", text=DAY_SUN, location=location.bottom, color=color.new(dayLabelColor, 100), textcolor=dayLabelColor, size=size.tiny, editable=false)

// ═══════════════════════════════════════════════════════════════════════════════
// BREACH DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

// HTF breach detection: Always run regardless of Sunday skip (prevents breach detection failure on Weekly timeframe)
if showDailyFiltered
    // Only track liquidity depth if enabled, asset supported, and timeframe valid
    daily_liquidity_depth_dist = (enableLiquidityDepth and isAssetSupported and isDailyLiquidityDepthTimeframeValid) ? dailyLiquidityDepthDistance : 0
    pool_detect_breaches(daily_pool, DAILY_SCAN_CAP, daily_liquidity_depth_dist)

if showWeeklyFiltered
    // Only track liquidity depth if enabled, asset supported, and timeframe valid
    weekly_liquidity_depth_dist = (enableLiquidityDepth and isAssetSupported and isWeeklyLiquidityDepthTimeframeValid) ? weeklyLiquidityDepthDistance : 0
    pool_detect_breaches(weekly_pool, WEEKLY_SCAN_CAP, weekly_liquidity_depth_dist)

if showMonthlyFiltered
    // Only track liquidity depth if enabled, asset supported, and timeframe valid
    monthly_liquidity_depth_dist = (enableLiquidityDepth and isAssetSupported and isMonthlyLiquidityDepthTimeframeValid) ? monthlyLiquidityDepthDistance : 0
    pool_detect_breaches(monthly_pool, MONTHLY_SCAN_CAP, monthly_liquidity_depth_dist)

if not skip_sunday_liquidity
    // Intraday session breach detection (percentage-based liquidity depth)
    // Use filtered versions to respect Pulse Mode filter
    if timeframe.in_seconds() <= INTRADAY_SESSION_MAX_TIMEFRAME
        // Determine liquidity depth percentages based on toggle
        intraday_liquidity_depth_pct1 = enableIntradayLiquidityDepth ? intradayLiquidityDepthPercent1 : 0
        intraday_liquidity_depth_pct2 = enableIntradayLiquidityDepth ? intradayLiquidityDepthPercent2 : 0
        intraday_liquidity_depth_pct3 = enableIntradayLiquidityDepth ? intradayLiquidityDepthPercent3 : 0

        if showAsiaFiltered
            pool_detect_intraday_breaches(asia_pool, ASIA_SCAN_CAP, intraday_liquidity_depth_pct1, intraday_liquidity_depth_pct2, intraday_liquidity_depth_pct3)

        if showLondonFiltered
            pool_detect_intraday_breaches(london_pool, LONDON_SCAN_CAP, intraday_liquidity_depth_pct1, intraday_liquidity_depth_pct2, intraday_liquidity_depth_pct3)

        if showNyamFiltered
            pool_detect_intraday_breaches(nyam_pool, NYAM_SCAN_CAP, intraday_liquidity_depth_pct1, intraday_liquidity_depth_pct2, intraday_liquidity_depth_pct3)

        if showLunchFiltered
            pool_detect_intraday_breaches(lunch_pool, LUNCH_SCAN_CAP, intraday_liquidity_depth_pct1, intraday_liquidity_depth_pct2, intraday_liquidity_depth_pct3)

        if showNypmFiltered
            pool_detect_intraday_breaches(nypm_pool, NYPM_SCAN_CAP, intraday_liquidity_depth_pct1, intraday_liquidity_depth_pct2, intraday_liquidity_depth_pct3)

        if showPremarketFiltered
            pool_detect_intraday_breaches(premarket_pool, PREMARKET_SCAN_CAP, intraday_liquidity_depth_pct1, intraday_liquidity_depth_pct2, intraday_liquidity_depth_pct3)

        if showOvernightFiltered
            pool_detect_intraday_breaches(overnight_pool, OVERNIGHT_SCAN_CAP, intraday_liquidity_depth_pct1, intraday_liquidity_depth_pct2, intraday_liquidity_depth_pct3)

// Detect 16:00 open mitigation (ONLY after 05:00 next day)
// NOTE: Mitigation detection skips Sunday evening for traditional assets (16:00 is traditional market concept)
if show1600OpenFiltered and not skip_sunday_liquidity
    currentHour_mitigation = hour(time, NY_TIMEZONE)

    // Determine if we're in the mitigation window based on mode
    isInMitigationWindow = false
    if open1600MitigationWindow == MITIGATION_WINDOW_ANYTIME
        // Anytime: Any time from 05:00 onwards (includes overnight/Asian session)
        isInMitigationWindow := currentHour_mitigation >= MITIGATION_START_HOUR
    else
        // Market-Hours: Only between 05:00-16:00 (excludes overnight 16:00-05:00)
        isInMitigationWindow := currentHour_mitigation >= MITIGATION_START_HOUR and currentHour_mitigation < MARKET_CLOSE_HOUR

    // Check CURRENT level (today's 16:00 that hasn't been pushed to array yet)
    if not na(sixteen_hundred_open.current_open) and not sixteen_hundred_open.current_mitigated
        // Require BOTH: 13+ hours elapsed AND in mitigation window
        // This protects intraday (Tue 16:00 → Wed 05:00) AND handles weekends (Fri 16:00 → Mon 05:00)
        if (time >= sixteen_hundred_open.current_time + THIRTEEN_HOURS_MS) and isInMitigationWindow
            // Price touched or crossed the level
            if (high >= sixteen_hundred_open.current_open and low <= sixteen_hundred_open.current_open) or close == sixteen_hundred_open.current_open
                sixteen_hundred_open.current_mitigated := true
                sixteen_hundred_open.current_mitigation_time := time

    // Check stored levels (previous days in array)
    if array.size(sixteen_hundred_open.opens) > 0
        scan_size = math.min(array.size(sixteen_hundred_open.opens), SIXTEEN_HUNDRED_OPEN_SCAN_CAP)
        start_index = math.max(0, array.size(sixteen_hundred_open.opens) - scan_size)

        for i = start_index to array.size(sixteen_hundred_open.opens) - 1
            if not array.get(sixteen_hundred_open.mitigated, i)
                open_level = array.get(sixteen_hundred_open.opens, i)
                open_time_stored = array.get(sixteen_hundred_open.times, i)

                // Require BOTH: 13+ hours elapsed AND in mitigation window
                // This protects intraday (Tue 16:00 → Wed 05:00) AND handles weekends (Fri 16:00 → Mon 05:00)
                if (time >= open_time_stored + THIRTEEN_HOURS_MS) and isInMitigationWindow
                    // Price touched or crossed the level
                    if (high >= open_level and low <= open_level) or close == open_level
                        array.set(sixteen_hundred_open.mitigated, i, true)
                        array.set(sixteen_hundred_open.mitigation_times, i, time)

// ═══════════════════════════════════════════════════════════════════════════════
// AUTO-ADAPTIVE LABEL SPACING CALCULATION
// ═══════════════════════════════════════════════════════════════════════════════

// Calculate auto-adaptive spacing multiplier based on ATR (volatility) and price structure
// ATR as percentage of price gives volatility-normalized measure
// Recalculate every bar to ensure accurate ATR measurement
labelSpacing = math.max(0.5, math.min(4.0, (ta.atr(14) / close) * 50.0))

// ═══════════════════════════════════════════════════════════════════════════════
// DYNAMIC PRIORITY-BASED OFFSET CALCULATION
// ═══════════════════════════════════════════════════════════════════════════════

// Build a list of enabled pools - priority determined by index position
// Lower index = lower priority, higher index = higher priority
// This allows dynamic stacking - only enabled pools get offset, with spacing relative to each other

var array<string> enabled_pools = array.new<string>()

if barstate.islast
    array.clear(enabled_pools)

    // Add HTF pools (priority 7-9) - order matters: first = lowest priority in this group
    if showDailyFiltered and timeframe.in_seconds() >= HTF_MIN_TIMEFRAME
        array.push(enabled_pools, POOL_TYPE_DAILY)
    if showWeeklyFiltered and timeframe.in_seconds() >= HTF_MIN_TIMEFRAME
        array.push(enabled_pools, POOL_TYPE_WEEKLY)
    if showMonthlyFiltered and timeframe.in_seconds() >= HTF_MIN_TIMEFRAME
        array.push(enabled_pools, POOL_TYPE_MONTHLY)

    // Add intraday pools (priority 0-6) - order matters: first = lowest priority
    if timeframe.in_seconds() <= INTRADAY_SESSION_MAX_TIMEFRAME
        if showAsiaFiltered
            array.push(enabled_pools, POOL_TYPE_ASIA)
        if showLondonFiltered
            array.push(enabled_pools, POOL_TYPE_LONDON)
        if showNyamFiltered
            array.push(enabled_pools, POOL_TYPE_NYAM)
        if showLunchFiltered
            array.push(enabled_pools, POOL_TYPE_LUNCH)
        if showNypmFiltered
            array.push(enabled_pools, POOL_TYPE_NYPM)
        if showPremarketFiltered
            array.push(enabled_pools, POOL_TYPE_PREMARKET)
        if showOvernightFiltered
            array.push(enabled_pools, POOL_TYPE_OVERNIGHT)

// Function to get dynamic offset based on enabled pools
get_dynamic_offset_pct(pool_type) =>
    var float offset = 0.0

    // If offset system is disabled, return 0 (labels sit directly on lines)
    if not labelOffsetEnabled
        offset := 0.0
    else
        // Find this pool's index in enabled list
        pool_index = -1
        total_enabled = array.size(enabled_pools)

        if total_enabled > 0
            for i = 0 to total_enabled - 1
                if array.get(enabled_pools, i) == pool_type
                    pool_index := i
                    break

        // Calculate offset: distribute from min to max based on relative position
        if pool_index >= 0 and total_enabled > 1
            // Spread offsets from LABEL_OFFSET_MIN (lowest priority) to LABEL_OFFSET_MAX (highest priority)
            offset := LABEL_OFFSET_MIN + ((LABEL_OFFSET_MAX - LABEL_OFFSET_MIN) * pool_index / (total_enabled - 1))
        else if pool_index >= 0 and total_enabled == 1
            // Only one pool enabled - minimal offset
            offset := LABEL_OFFSET_SINGLE

    offset

// ═══════════════════════════════════════════════════════════════════════════════
// VISUALIZATION HELPERS
// ═══════════════════════════════════════════════════════════════════════════════

draw_session_backgrounds(pool, showLast, bgColor) =>
    // Draw completed sessions
    if array.size(pool.session_start_times) > 0
        count = math.min(showLast, array.size(pool.session_start_times))
        for i = 0 to count - 1
            idx = array.size(pool.session_start_times) - 1 - i
            start_time = array.get(pool.session_start_times, idx)
            end_time = array.get(pool.session_end_times, idx)
            session_high = array.get(pool.highs, idx)
            session_low = array.get(pool.lows, idx)

            // Draw background box for completed session
            session_box = box.new(start_time, session_high, end_time, session_low, xloc=xloc.bar_time, bgcolor=bgColor, border_color=color.new(bgColor, 100), border_width=1)
            array.push(all_boxes, session_box)

// Draw live background for active session
draw_live_session_background(pool, sessionString, bgColor) =>
    inSession = not na(time(timeframe.period, sessionString, NY_TIMEZONE))
    if inSession and not na(pool.current_high) and not na(pool.current_low) and not na(pool.current_session_start_time)
        live_box = box.new(pool.current_session_start_time, pool.current_high, time, pool.current_low, xloc=xloc.bar_time, bgcolor=bgColor, border_color=color.new(bgColor, 100), border_width=1)
        array.push(all_boxes, live_box)

// Draw live pool lines for active session (high/low liquidity lines)
draw_live_pool_lines(pool, sessionString, poolType, lineColor, lineWidth) =>
    inSession = not na(time(timeframe.period, sessionString, NY_TIMEZONE))
    if inSession and not na(pool.current_high) and not na(pool.current_low) and not na(pool.current_session_start_time)
        // Draw high line from when high was set to current bar
        high_line = line.new(pool.current_high_time, pool.current_high, time, pool.current_high, xloc=xloc.bar_time, color=lineColor, width=lineWidth, style=line.style_solid)
        array.push(all_lines, high_line)

        // Draw low line from when low was set to current bar
        low_line = line.new(pool.current_low_time, pool.current_low, time, pool.current_low, xloc=xloc.bar_time, color=lineColor, width=lineWidth, style=line.style_solid)
        array.push(all_lines, low_line)

        // Draw labels if enabled
        if showLabels
            label_text = build_label(poolType)
            offset_pct = get_dynamic_offset_pct(poolType)

            // High label
            high_offset = pool.current_high * (offset_pct / 100.0) * labelSpacing
            high_label_price = pool.current_high + high_offset
            high_label = label.new(time, high_label_price, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
            array.push(all_labels, high_label)

            // Low label
            low_offset = pool.current_low * (offset_pct / 100.0) * labelSpacing
            low_label_price = pool.current_low - low_offset
            low_label = label.new(time, low_label_price, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
            array.push(all_labels, low_label)

draw_intraday_pool(pool, poolType, showLast, lineColor, lineWidth) =>
    if array.size(pool.highs) > 0
        count = math.min(showLast, array.size(pool.highs))
        for i = 0 to count - 1
            idx = array.size(pool.highs) - 1 - i
    
            high_val = array.get(pool.highs, idx)
            low_val = array.get(pool.lows, idx)
            high_time = array.get(pool.high_times, idx)
            low_time = array.get(pool.low_times, idx)
            session_end_time = array.get(pool.session_end_times, idx)
    
            high_end_time = pool_get_high_end_time(pool, idx, time)
            low_end_time = pool_get_low_end_time(pool, idx, time)
    
            high_line = line.new(high_time, high_val, high_end_time, high_val, xloc=xloc.bar_time, color=lineColor, width=lineWidth, style=line.style_solid)
            array.push(all_lines, high_line)
    
            low_line = line.new(low_time, low_val, low_end_time, low_val, xloc=xloc.bar_time, color=lineColor, width=lineWidth, style=line.style_solid)
            array.push(all_lines, low_line)
    
            // Draw intraday liquidity depth lines (percentage-based)
            if enableIntradayLiquidityDepth
                high_breached_liquidity_depth = array.get(pool.high_breached, idx)
                low_breached_liquidity_depth = array.get(pool.low_breached, idx)
    
                // Only draw liquidity depth if L0 is breached (prerequisite)
                if high_breached_liquidity_depth
                    intraday_high_liquidity_depth = array.get(pool.intraday_high_liquidity_depths, idx)
    
                    for level_idx = 0 to NUM_INTRADAY_LIQUIDITY_DEPTH_LEVELS - 1
                        percent = get_intraday_percent(level_idx)
                        liquidity_depth_high_val = high_val + (high_val * (percent / 100.0))
    
                        // Get end time: if breached use breach time, otherwise extend to current bar
                        level_breached = array.get(intraday_high_liquidity_depth.breached, level_idx)
                        level_breach_time = array.get(intraday_high_liquidity_depth.breach_times, level_idx)
                        level_end_time = level_breached and not na(level_breach_time) ? level_breach_time : time
    
                        // Draw horizontal liquidity depth line
                        high_liquidity_depth_line = line.new(high_time, liquidity_depth_high_val, level_end_time, liquidity_depth_high_val, xloc=xloc.bar_time, color=intradayLiquidityDepthColor, width=intradayLiquidityDepthLineWidth, style=line.style_dashed)
                        array.push(all_lines, high_liquidity_depth_line)
    
                        // Draw vertical connector
                        high_connector = line.new(high_time, high_val, high_time, liquidity_depth_high_val, xloc=xloc.bar_time, color=color.new(intradayLiquidityDepthColor, 80), width=intradayLiquidityDepthLineWidth, style=line.style_solid)
                        array.push(all_lines, high_connector)
    
                if low_breached_liquidity_depth
                    intraday_low_liquidity_depth = array.get(pool.intraday_low_liquidity_depths, idx)
    
                    for level_idx_low = 0 to NUM_INTRADAY_LIQUIDITY_DEPTH_LEVELS - 1
                        percent_low = get_intraday_percent(level_idx_low)
                        liquidity_depth_low_val = low_val - (low_val * (percent_low / 100.0))
    
                        // Get end time: if breached use breach time, otherwise extend to current bar
                        level_breached_low = array.get(intraday_low_liquidity_depth.breached, level_idx_low)
                        level_breach_time_low = array.get(intraday_low_liquidity_depth.breach_times, level_idx_low)
                        level_end_time_low = level_breached_low and not na(level_breach_time_low) ? level_breach_time_low : time
    
                        // Draw horizontal liquidity depth line
                        low_liquidity_depth_line = line.new(low_time, liquidity_depth_low_val, level_end_time_low, liquidity_depth_low_val, xloc=xloc.bar_time, color=intradayLiquidityDepthColor, width=intradayLiquidityDepthLineWidth, style=line.style_dashed)
                        array.push(all_lines, low_liquidity_depth_line)
    
                        // Draw vertical connector
                        low_connector = line.new(low_time, low_val, low_time, liquidity_depth_low_val, xloc=xloc.bar_time, color=color.new(intradayLiquidityDepthColor, 80), width=intradayLiquidityDepthLineWidth, style=line.style_solid)
                        array.push(all_lines, low_connector)
    
            if showLabels
                label_text = build_label(poolType)
                offset_pct = get_dynamic_offset_pct(poolType)
                high_breached = array.get(pool.high_breached, idx)
                low_breached = array.get(pool.low_breached, idx)
    
                // High label: offset upward for visual separation (percentage-based with user multiplier)
                high_label_time = high_breached ? int((high_time + high_end_time) / 2) : high_end_time
                high_offset = high_val * (offset_pct / 100.0) * labelSpacing
                high_label_price = high_val + high_offset
                high_label = label.new(high_label_time, high_label_price, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                array.push(all_labels, high_label)
    
                // Low label: offset downward for visual separation (percentage-based with user multiplier)
                low_label_time = low_breached ? int((low_time + low_end_time) / 2) : low_end_time
                low_offset = low_val * (offset_pct / 100.0) * labelSpacing
                low_label_price = low_val - low_offset
                low_label = label.new(low_label_time, low_label_price, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                array.push(all_labels, low_label)

// ═══════════════════════════════════════════════════════════════════════════════
// VISUALIZATION
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.islast
    // Clear previous visuals
    for line_obj in all_lines
        line.delete(line_obj)
    array.clear(all_lines)

    for label_obj in all_labels
        label.delete(label_obj)
    array.clear(all_labels)

    for box_obj in all_boxes
        box.delete(box_obj)
    array.clear(all_boxes)

    // Note: Vertical offset stacking is now used instead of collision suppression
    // All labels are drawn with position offsets based on priority to prevent overlap

    // Draw Daily
    if showDailyFiltered and timeframe.in_seconds() >= HTF_MIN_TIMEFRAME
        count = math.min(dailyShowLast, array.size(daily_pool.highs))
        if count > 0
            for i = 0 to count - 1
                idx = array.size(daily_pool.highs) - 1 - i

                high_val = array.get(daily_pool.highs, idx)
                low_val = array.get(daily_pool.lows, idx)
                high_time = array.get(daily_pool.high_times, idx)
                low_time = array.get(daily_pool.low_times, idx)

                // Get conditional end times
                high_end_time = pool_get_high_end_time(daily_pool, idx, time)
                low_end_time = pool_get_low_end_time(daily_pool, idx, time)

                // Draw high line
                high_line = line.new(high_time, high_val, high_end_time, high_val, xloc=xloc.bar_time, color=dailyColor, width=dailyLineWidth, style=line.style_solid)
                array.push(all_lines, high_line)

                // Draw low line
                low_line = line.new(low_time, low_val, low_end_time, low_val, xloc=xloc.bar_time, color=dailyColor, width=dailyLineWidth, style=line.style_solid)
                array.push(all_lines, low_line)

                // Draw liquidity depth lines (HTF only: Daily)
                if enableLiquidityDepth and isAssetSupported and isDailyLiquidityDepthTimeframeValid and dailyLiquidityDepthDistance > 0
                    high_breached_liquidity_depth = array.get(daily_pool.high_breached, idx)
                    low_breached_liquidity_depth = array.get(daily_pool.low_breached, idx)

                    // Only draw liquidity depth if L0 is breached (prerequisite)
                    if high_breached_liquidity_depth
                        high_liquidity_depth = array.get(daily_pool.high_liquidity_depths, idx)
                        for level_idx = 0 to NUM_LIQUIDITY_DEPTH_LEVELS - 1
                            multiplier = level_idx + 1
                            liquidity_depth_high_val = high_val + (multiplier * dailyLiquidityDepthDistance)

                            // Get end time for this level
                            level_breached = array.get(high_liquidity_depth.breached, level_idx)
                            level_breach_time = array.get(high_liquidity_depth.breach_times, level_idx)
                            level_end_time = level_breached and not na(level_breach_time) ? level_breach_time : time

                            // Draw horizontal liquidity depth line
                            high_liquidity_depth_line = line.new(high_time, liquidity_depth_high_val, level_end_time, liquidity_depth_high_val, xloc=xloc.bar_time, color=liquidityDepthColor, width=liquidityDepthLineWidth, style=line.style_dashed)
                            array.push(all_lines, high_liquidity_depth_line)

                            // Draw vertical connector
                            high_connector = line.new(high_time, high_val, high_time, liquidity_depth_high_val, xloc=xloc.bar_time, color=color.new(liquidityDepthColor, 80), width=liquidityDepthLineWidth, style=line.style_solid)
                            array.push(all_lines, high_connector)

                    if low_breached_liquidity_depth
                        low_liquidity_depth = array.get(daily_pool.low_liquidity_depths, idx)
                        for level_idx = 0 to NUM_LIQUIDITY_DEPTH_LEVELS - 1
                            multiplier = level_idx + 1
                            liquidity_depth_low_val = low_val - (multiplier * dailyLiquidityDepthDistance)

                            // Get end time for this level
                            level_breached_low = array.get(low_liquidity_depth.breached, level_idx)
                            level_breach_time_low = array.get(low_liquidity_depth.breach_times, level_idx)
                            level_end_time_low = level_breached_low and not na(level_breach_time_low) ? level_breach_time_low : time

                            // Draw horizontal liquidity depth line
                            low_liquidity_depth_line = line.new(low_time, liquidity_depth_low_val, level_end_time_low, liquidity_depth_low_val, xloc=xloc.bar_time, color=liquidityDepthColor, width=liquidityDepthLineWidth, style=line.style_dashed)
                            array.push(all_lines, low_liquidity_depth_line)

                            // Draw vertical connector
                            low_connector = line.new(low_time, low_val, low_time, liquidity_depth_low_val, xloc=xloc.bar_time, color=color.new(liquidityDepthColor, 80), width=liquidityDepthLineWidth, style=line.style_solid)
                            array.push(all_lines, low_connector)

                // Draw labels with vertical offset for stacking (percentage-based with user multiplier)
                if showLabels
                    label_text = build_label(POOL_TYPE_DAILY)
                    offset_pct = get_dynamic_offset_pct(POOL_TYPE_DAILY)

                    high_breached = array.get(daily_pool.high_breached, idx)
                    low_breached = array.get(daily_pool.low_breached, idx)

                    // High label: offset upward for visual separation
                    high_label_time = high_breached ? int((high_time + high_end_time) / 2) : high_end_time
                    high_offset = high_val * (offset_pct / 100.0) * labelSpacing
                    high_label_price = high_val + high_offset
                    high_label = label.new(high_label_time, high_label_price, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                    array.push(all_labels, high_label)

                    // Low label: offset downward for visual separation
                    low_label_time = low_breached ? int((low_time + low_end_time) / 2) : low_end_time
                    low_offset = low_val * (offset_pct / 100.0) * labelSpacing
                    low_label_price = low_val - low_offset
                    low_label = label.new(low_label_time, low_label_price, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                    array.push(all_labels, low_label)

                    // Liquidity Depth labels if enabled
                    if enableLiquidityDepth and isAssetSupported and isDailyLiquidityDepthTimeframeValid and dailyLiquidityDepthDistance > 0
                        high_breached_labels = array.get(daily_pool.high_breached, idx)
                        low_breached_labels = array.get(daily_pool.low_breached, idx)

                        if high_breached_labels
                            high_liquidity_depth_labels = array.get(daily_pool.high_liquidity_depths, idx)
                            for level_idx = 0 to NUM_LIQUIDITY_DEPTH_LEVELS - 1
                                multiplier = level_idx + 1
                                label_text_liquidity_depth = "L" + str.tostring(multiplier)
                                liquidity_depth_high_val_label = high_val + (multiplier * dailyLiquidityDepthDistance)
                                liquidity_depth_high_label = label.new(high_label_time, liquidity_depth_high_val_label, label_text_liquidity_depth, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                                array.push(all_labels, liquidity_depth_high_label)

                        if low_breached_labels
                            low_liquidity_depth_labels = array.get(daily_pool.low_liquidity_depths, idx)
                            for level_idx = 0 to NUM_LIQUIDITY_DEPTH_LEVELS - 1
                                multiplier = level_idx + 1
                                label_text_liquidity_depth = "L" + str.tostring(multiplier)
                                liquidity_depth_low_val_label = low_val - (multiplier * dailyLiquidityDepthDistance)
                                liquidity_depth_low_label = label.new(low_label_time, liquidity_depth_low_val_label, label_text_liquidity_depth, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                                array.push(all_labels, liquidity_depth_low_label)

    // Draw Weekly
    if showWeeklyFiltered and timeframe.in_seconds() >= HTF_MIN_TIMEFRAME
        count = math.min(weeklyShowLast, array.size(weekly_pool.highs))
        if count > 0
            for i = 0 to count - 1
                idx = array.size(weekly_pool.highs) - 1 - i

                high_val = array.get(weekly_pool.highs, idx)
                low_val = array.get(weekly_pool.lows, idx)
                high_time = array.get(weekly_pool.high_times, idx)
                low_time = array.get(weekly_pool.low_times, idx)

                // Get conditional end times
                high_end_time = pool_get_high_end_time(weekly_pool, idx, time)
                low_end_time = pool_get_low_end_time(weekly_pool, idx, time)

                // Draw high line
                high_line = line.new(high_time, high_val, high_end_time, high_val, xloc=xloc.bar_time, color=weeklyColor, width=weeklyLineWidth, style=line.style_solid)
                array.push(all_lines, high_line)

                // Draw low line
                low_line = line.new(low_time, low_val, low_end_time, low_val, xloc=xloc.bar_time, color=weeklyColor, width=weeklyLineWidth, style=line.style_solid)
                array.push(all_lines, low_line)

                // Draw liquidity depth lines (HTF only: Weekly)
                if enableLiquidityDepth and isAssetSupported and isWeeklyLiquidityDepthTimeframeValid and weeklyLiquidityDepthDistance > 0
                    high_breached_liquidity_depth = array.get(weekly_pool.high_breached, idx)
                    low_breached_liquidity_depth = array.get(weekly_pool.low_breached, idx)

                    if high_breached_liquidity_depth
                        high_liquidity_depth = array.get(weekly_pool.high_liquidity_depths, idx)
                        for level_idx = 0 to NUM_LIQUIDITY_DEPTH_LEVELS - 1
                            multiplier = level_idx + 1
                            liquidity_depth_high_val = high_val + (multiplier * weeklyLiquidityDepthDistance)
                            level_breached = array.get(high_liquidity_depth.breached, level_idx)
                            level_breach_time = array.get(high_liquidity_depth.breach_times, level_idx)
                            level_end_time = level_breached and not na(level_breach_time) ? level_breach_time : time
                            high_liquidity_depth_line = line.new(high_time, liquidity_depth_high_val, level_end_time, liquidity_depth_high_val, xloc=xloc.bar_time, color=liquidityDepthColor, width=liquidityDepthLineWidth, style=line.style_dashed)
                            array.push(all_lines, high_liquidity_depth_line)
                            high_connector = line.new(high_time, high_val, high_time, liquidity_depth_high_val, xloc=xloc.bar_time, color=color.new(liquidityDepthColor, 80), width=liquidityDepthLineWidth, style=line.style_solid)
                            array.push(all_lines, high_connector)

                    if low_breached_liquidity_depth
                        low_liquidity_depth = array.get(weekly_pool.low_liquidity_depths, idx)
                        for level_idx = 0 to NUM_LIQUIDITY_DEPTH_LEVELS - 1
                            multiplier = level_idx + 1
                            liquidity_depth_low_val = low_val - (multiplier * weeklyLiquidityDepthDistance)
                            level_breached_low = array.get(low_liquidity_depth.breached, level_idx)
                            level_breach_time_low = array.get(low_liquidity_depth.breach_times, level_idx)
                            level_end_time_low = level_breached_low and not na(level_breach_time_low) ? level_breach_time_low : time
                            low_liquidity_depth_line = line.new(low_time, liquidity_depth_low_val, level_end_time_low, liquidity_depth_low_val, xloc=xloc.bar_time, color=liquidityDepthColor, width=liquidityDepthLineWidth, style=line.style_dashed)
                            array.push(all_lines, low_liquidity_depth_line)
                            low_connector = line.new(low_time, low_val, low_time, liquidity_depth_low_val, xloc=xloc.bar_time, color=color.new(liquidityDepthColor, 80), width=liquidityDepthLineWidth, style=line.style_solid)
                            array.push(all_lines, low_connector)

                // Draw labels with vertical offset for stacking (percentage-based with user multiplier)
                if showLabels
                    label_text = build_label(POOL_TYPE_WEEKLY)
                    offset_pct = get_dynamic_offset_pct(POOL_TYPE_WEEKLY)

                    high_breached = array.get(weekly_pool.high_breached, idx)
                    low_breached = array.get(weekly_pool.low_breached, idx)

                    // High label: offset upward for visual separation
                    high_label_time = high_breached ? int((high_time + high_end_time) / 2) : high_end_time
                    high_offset = high_val * (offset_pct / 100.0) * labelSpacing
                    high_label_price = high_val + high_offset
                    high_label = label.new(high_label_time, high_label_price, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                    array.push(all_labels, high_label)

                    // Low label: offset downward for visual separation
                    low_label_time = low_breached ? int((low_time + low_end_time) / 2) : low_end_time
                    low_offset = low_val * (offset_pct / 100.0) * labelSpacing
                    low_label_price = low_val - low_offset
                    low_label = label.new(low_label_time, low_label_price, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                    array.push(all_labels, low_label)

                    // Liquidity Depth labels if enabled
                    if enableLiquidityDepth and isAssetSupported and isWeeklyLiquidityDepthTimeframeValid and weeklyLiquidityDepthDistance > 0
                        high_breached_labels = array.get(weekly_pool.high_breached, idx)
                        low_breached_labels = array.get(weekly_pool.low_breached, idx)

                        if high_breached_labels
                            high_liquidity_depth_labels = array.get(weekly_pool.high_liquidity_depths, idx)
                            for level_idx = 0 to NUM_LIQUIDITY_DEPTH_LEVELS - 1
                                multiplier = level_idx + 1
                                label_text_liquidity_depth = "L" + str.tostring(multiplier)
                                liquidity_depth_high_val_label = high_val + (multiplier * weeklyLiquidityDepthDistance)
                                liquidity_depth_high_label = label.new(high_label_time, liquidity_depth_high_val_label, label_text_liquidity_depth, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                                array.push(all_labels, liquidity_depth_high_label)

                        if low_breached_labels
                            low_liquidity_depth_labels = array.get(weekly_pool.low_liquidity_depths, idx)
                            for level_idx = 0 to NUM_LIQUIDITY_DEPTH_LEVELS - 1
                                multiplier = level_idx + 1
                                label_text_liquidity_depth = "L" + str.tostring(multiplier)
                                liquidity_depth_low_val_label = low_val - (multiplier * weeklyLiquidityDepthDistance)
                                liquidity_depth_low_label = label.new(low_label_time, liquidity_depth_low_val_label, label_text_liquidity_depth, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                                array.push(all_labels, liquidity_depth_low_label)

    // Draw Monthly
    if showMonthlyFiltered and timeframe.in_seconds() >= HTF_MIN_TIMEFRAME
        count = math.min(monthlyShowLast, array.size(monthly_pool.highs))
        if count > 0
            for i = 0 to count - 1
                idx = array.size(monthly_pool.highs) - 1 - i

                high_val = array.get(monthly_pool.highs, idx)
                low_val = array.get(monthly_pool.lows, idx)
                high_time = array.get(monthly_pool.high_times, idx)
                low_time = array.get(monthly_pool.low_times, idx)

                // Get conditional end times
                high_end_time = pool_get_high_end_time(monthly_pool, idx, time)
                low_end_time = pool_get_low_end_time(monthly_pool, idx, time)

                // Draw high line
                high_line = line.new(high_time, high_val, high_end_time, high_val, xloc=xloc.bar_time, color=monthlyColor, width=monthlyLineWidth, style=line.style_solid)
                array.push(all_lines, high_line)

                // Draw low line
                low_line = line.new(low_time, low_val, low_end_time, low_val, xloc=xloc.bar_time, color=monthlyColor, width=monthlyLineWidth, style=line.style_solid)
                array.push(all_lines, low_line)

                // Draw liquidity depth lines (HTF only: Monthly)
                if enableLiquidityDepth and isAssetSupported and isMonthlyLiquidityDepthTimeframeValid and monthlyLiquidityDepthDistance > 0
                    high_breached_liquidity_depth = array.get(monthly_pool.high_breached, idx)
                    low_breached_liquidity_depth = array.get(monthly_pool.low_breached, idx)

                    if high_breached_liquidity_depth
                        high_liquidity_depth = array.get(monthly_pool.high_liquidity_depths, idx)
                        for level_idx = 0 to NUM_LIQUIDITY_DEPTH_LEVELS - 1
                            multiplier = level_idx + 1
                            liquidity_depth_high_val = high_val + (multiplier * monthlyLiquidityDepthDistance)
                            level_breached = array.get(high_liquidity_depth.breached, level_idx)
                            level_breach_time = array.get(high_liquidity_depth.breach_times, level_idx)
                            level_end_time = level_breached and not na(level_breach_time) ? level_breach_time : time
                            high_liquidity_depth_line = line.new(high_time, liquidity_depth_high_val, level_end_time, liquidity_depth_high_val, xloc=xloc.bar_time, color=liquidityDepthColor, width=liquidityDepthLineWidth, style=line.style_dashed)
                            array.push(all_lines, high_liquidity_depth_line)
                            high_connector = line.new(high_time, high_val, high_time, liquidity_depth_high_val, xloc=xloc.bar_time, color=color.new(liquidityDepthColor, 80), width=liquidityDepthLineWidth, style=line.style_solid)
                            array.push(all_lines, high_connector)

                    if low_breached_liquidity_depth
                        low_liquidity_depth = array.get(monthly_pool.low_liquidity_depths, idx)
                        for level_idx = 0 to NUM_LIQUIDITY_DEPTH_LEVELS - 1
                            multiplier = level_idx + 1
                            liquidity_depth_low_val = low_val - (multiplier * monthlyLiquidityDepthDistance)
                            level_breached_low = array.get(low_liquidity_depth.breached, level_idx)
                            level_breach_time_low = array.get(low_liquidity_depth.breach_times, level_idx)
                            level_end_time_low = level_breached_low and not na(level_breach_time_low) ? level_breach_time_low : time
                            low_liquidity_depth_line = line.new(low_time, liquidity_depth_low_val, level_end_time_low, liquidity_depth_low_val, xloc=xloc.bar_time, color=liquidityDepthColor, width=liquidityDepthLineWidth, style=line.style_dashed)
                            array.push(all_lines, low_liquidity_depth_line)
                            low_connector = line.new(low_time, low_val, low_time, liquidity_depth_low_val, xloc=xloc.bar_time, color=color.new(liquidityDepthColor, 80), width=liquidityDepthLineWidth, style=line.style_solid)
                            array.push(all_lines, low_connector)

                // Draw labels with vertical offset for stacking (percentage-based with user multiplier)
                if showLabels
                    label_text = build_label(POOL_TYPE_MONTHLY)
                    offset_pct = get_dynamic_offset_pct(POOL_TYPE_MONTHLY)

                    high_breached = array.get(monthly_pool.high_breached, idx)
                    low_breached = array.get(monthly_pool.low_breached, idx)

                    // High label: offset upward for visual separation
                    high_label_time = high_breached ? int((high_time + high_end_time) / 2) : high_end_time
                    high_offset = high_val * (offset_pct / 100.0) * labelSpacing
                    high_label_price = high_val + high_offset
                    high_label = label.new(high_label_time, high_label_price, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                    array.push(all_labels, high_label)

                    // Low label: offset downward for visual separation
                    low_label_time = low_breached ? int((low_time + low_end_time) / 2) : low_end_time
                    low_offset = low_val * (offset_pct / 100.0) * labelSpacing
                    low_label_price = low_val - low_offset
                    low_label = label.new(low_label_time, low_label_price, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                    array.push(all_labels, low_label)

                    // Liquidity Depth labels if enabled
                    if enableLiquidityDepth and isAssetSupported and isMonthlyLiquidityDepthTimeframeValid and monthlyLiquidityDepthDistance > 0
                        high_breached_labels = array.get(monthly_pool.high_breached, idx)
                        low_breached_labels = array.get(monthly_pool.low_breached, idx)

                        if high_breached_labels
                            high_liquidity_depth_labels = array.get(monthly_pool.high_liquidity_depths, idx)
                            for level_idx = 0 to NUM_LIQUIDITY_DEPTH_LEVELS - 1
                                multiplier = level_idx + 1
                                label_text_liquidity_depth = "L" + str.tostring(multiplier)
                                liquidity_depth_high_val_label = high_val + (multiplier * monthlyLiquidityDepthDistance)
                                liquidity_depth_high_label = label.new(high_label_time, liquidity_depth_high_val_label, label_text_liquidity_depth, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                                array.push(all_labels, liquidity_depth_high_label)

                        if low_breached_labels
                            low_liquidity_depth_labels = array.get(monthly_pool.low_liquidity_depths, idx)
                            for level_idx = 0 to NUM_LIQUIDITY_DEPTH_LEVELS - 1
                                multiplier = level_idx + 1
                                label_text_liquidity_depth = "L" + str.tostring(multiplier)
                                liquidity_depth_low_val_label = low_val - (multiplier * monthlyLiquidityDepthDistance)
                                liquidity_depth_low_label = label.new(low_label_time, liquidity_depth_low_val_label, label_text_liquidity_depth, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                                array.push(all_labels, liquidity_depth_low_label)

    // Draw Intraday Session Backgrounds (Completed + Live Sessions)
    if showIntradayBackground and timeframe.in_seconds() <= INTRADAY_SESSION_MAX_TIMEFRAME
        if applyPulseModeFilter(POOL_TYPE_ASIA, true)
            draw_session_backgrounds(asia_pool, intradayShowLast, intradayBackgroundColor)
            draw_live_session_background(asia_pool, actualAsiaSession, intradayBackgroundColor)

        if applyPulseModeFilter(POOL_TYPE_LONDON, true)
            draw_session_backgrounds(london_pool, intradayShowLast, intradayBackgroundColor)
            draw_live_session_background(london_pool, actualLondonSession, intradayBackgroundColor)

        if applyPulseModeFilter(POOL_TYPE_NYAM, true)
            draw_session_backgrounds(nyam_pool, intradayShowLast, intradayBackgroundColor)
            draw_live_session_background(nyam_pool, actualNyamSession, intradayBackgroundColor)

        if applyPulseModeFilter(POOL_TYPE_LUNCH, true)
            draw_session_backgrounds(lunch_pool, intradayShowLast, intradayBackgroundColor)
            draw_live_session_background(lunch_pool, actualLunchSession, intradayBackgroundColor)

        if applyPulseModeFilter(POOL_TYPE_NYPM, true)
            draw_session_backgrounds(nypm_pool, intradayShowLast, intradayBackgroundColor)
            draw_live_session_background(nypm_pool, actualNypmSession, intradayBackgroundColor)

    // Draw PoiSzn Session Backgrounds (Completed + Live Sessions)
    if timeframe.in_seconds() <= INTRADAY_SESSION_MAX_TIMEFRAME
        if showPremarketBackground and applyPulseModeFilter(POOL_TYPE_PREMARKET, true)
            draw_session_backgrounds(premarket_pool, poisznShowLast, premarketBackgroundColor)
            draw_live_session_background(premarket_pool, actualPremarketSession, premarketBackgroundColor)

        if showOvernightBackground and applyPulseModeFilter(POOL_TYPE_OVERNIGHT, true)
            draw_session_backgrounds(overnight_pool, poisznShowLast, overnightBackgroundColor)
            draw_live_session_background(overnight_pool, actualOvernightSession, overnightBackgroundColor)

    // Draw Intraday Sessions with vertical offset stacking (Completed + Live)
    if timeframe.in_seconds() <= INTRADAY_SESSION_MAX_TIMEFRAME
        if showAsiaFiltered
            draw_intraday_pool(asia_pool, POOL_TYPE_ASIA, intradayShowLast, intradayColor, intradayLineWidth)
            draw_live_pool_lines(asia_pool, actualAsiaSession, POOL_TYPE_ASIA, intradayColor, intradayLineWidth)

        if showLondonFiltered
            draw_intraday_pool(london_pool, POOL_TYPE_LONDON, intradayShowLast, intradayColor, intradayLineWidth)
            draw_live_pool_lines(london_pool, actualLondonSession, POOL_TYPE_LONDON, intradayColor, intradayLineWidth)

        if showNyamFiltered
            draw_intraday_pool(nyam_pool, POOL_TYPE_NYAM, intradayShowLast, intradayColor, intradayLineWidth)
            draw_live_pool_lines(nyam_pool, actualNyamSession, POOL_TYPE_NYAM, intradayColor, intradayLineWidth)

        if showLunchFiltered
            draw_intraday_pool(lunch_pool, POOL_TYPE_LUNCH, intradayShowLast, intradayColor, intradayLineWidth)
            draw_live_pool_lines(lunch_pool, actualLunchSession, POOL_TYPE_LUNCH, intradayColor, intradayLineWidth)

        if showNypmFiltered
            draw_intraday_pool(nypm_pool, POOL_TYPE_NYPM, intradayShowLast, intradayColor, intradayLineWidth)
            draw_live_pool_lines(nypm_pool, actualNypmSession, POOL_TYPE_NYPM, intradayColor, intradayLineWidth)

        // Draw PoiSzn Sessions (Completed + Live)
        if showPremarketFiltered
            draw_intraday_pool(premarket_pool, POOL_TYPE_PREMARKET, poisznShowLast, premarketColor, poisznLineWidth)
            draw_live_pool_lines(premarket_pool, actualPremarketSession, POOL_TYPE_PREMARKET, premarketColor, poisznLineWidth)

        if showOvernightFiltered
            draw_intraday_pool(overnight_pool, POOL_TYPE_OVERNIGHT, poisznShowLast, overnightColor, poisznLineWidth)
            draw_live_pool_lines(overnight_pool, actualOvernightSession, POOL_TYPE_OVERNIGHT, overnightColor, poisznLineWidth)

    // Draw Range Boxes
    if showRangeBoxFiltered and timeframe.in_seconds() >= RANGE_BOX_MIN_TIMEFRAME and timeframe.in_seconds() <= RANGE_BOX_MAX_TIMEFRAME and array.size(range_box.highs) > 0
        count = math.min(rangeBoxShowLast, array.size(range_box.highs))
        for i = 0 to count - 1
            idx = array.size(range_box.highs) - 1 - i

            high_val = array.get(range_box.highs, idx)
            low_val = array.get(range_box.lows, idx)
            start_time = array.get(range_box.start_times, idx)
            end_time = array.get(range_box.end_times, idx)

            // Determine liquidity depth end time: next range's start OR current time if most recent
            extend_end_time = i > 0 ? array.get(range_box.start_times, idx + 1) : time

            // Draw high line (extended to next range start)
            high_line = line.new(start_time, high_val, extend_end_time, high_val, xloc=xloc.bar_time, color=rangeBoxColor, width=rangeBoxWidth, style=line.style_solid)
            array.push(all_lines, high_line)

            // Draw low line (extended to next range start)
            low_line = line.new(start_time, low_val, extend_end_time, low_val, xloc=xloc.bar_time, color=rangeBoxColor, width=rangeBoxWidth, style=line.style_solid)
            array.push(all_lines, low_line)

            // Draw vertical lines only at actual range boundaries (2:00-2:15)
            left_line = line.new(start_time, high_val, start_time, low_val, xloc=xloc.bar_time, color=rangeBoxColor, width=rangeBoxWidth, style=line.style_solid)
            array.push(all_lines, left_line)

            right_line = line.new(end_time, high_val, end_time, low_val, xloc=xloc.bar_time, color=rangeBoxColor, width=rangeBoxWidth, style=line.style_solid)
            array.push(all_lines, right_line)

            // Draw middle line if enabled (extended to next range start)
            if showRangeMiddleLine
                middle_price = (high_val + low_val) / 2
                middle_line = line.new(start_time, middle_price, extend_end_time, middle_price, xloc=xloc.bar_time, color=rangeMiddleColor, width=rangeBoxWidth, style=line.style_dotted)
                array.push(all_lines, middle_line)

    // Draw Time Dividers
    if showTimeDividers and timeframe.in_seconds() <= TIME_DIVIDER_MAX_TIMEFRAME
        if array.size(time_divider.divider_times) > 0
            count = math.min(timeDividerShowLast, array.size(time_divider.divider_times))
            for i = 0 to count - 1
                idx = array.size(time_divider.divider_times) - 1 - i
                divider_time = array.get(time_divider.divider_times, idx)

                // Draw vertical line from high to low of chart (use chart extremes)
                divider_line = line.new(divider_time, high, divider_time, low, xloc=xloc.bar_time, color=timeDividerColor, width=1, style=line.style_dashed, extend=extend.both)
                array.push(all_lines, divider_line)

    // Draw 16:00 Opens - current level + stored levels
    // IMPORTANT: Draw current level FIRST (most recent) then fill with array levels
    // Only display on intraday timeframes (1m to 1H) where 1-minute precision is available
    if show1600OpenFiltered and timeframe.in_seconds() >= SIXTEEN_HUNDRED_OPEN_MIN_TIMEFRAME and timeframe.in_seconds() <= SIXTEEN_HUNDRED_OPEN_MAX_TIMEFRAME
        levels_drawn = 0

        // Draw current level FIRST (today's/most recent 16:00)
        if not na(sixteen_hundred_open.current_open)
            current_open_price = sixteen_hundred_open.current_open
            current_open_time = sixteen_hundred_open.current_time
            current_is_mitigated = sixteen_hundred_open.current_mitigated
            current_mitigation_time_val = sixteen_hundred_open.current_mitigation_time

            // Determine end time: if mitigated use mitigation time, otherwise current time
            current_end_time = (current_is_mitigated and not na(current_mitigation_time_val)) ? current_mitigation_time_val : time

            // Draw current level line
            current_line = line.new(current_open_time, current_open_price, current_end_time, current_open_price, xloc=xloc.bar_time, color=open1600Color, width=open1600LineWidth, style=line.style_solid)
            array.push(all_lines, current_line)

            // Label: at midpoint if mitigated, at end if active
            if showLabels
                current_label_time = (current_is_mitigated and not na(current_mitigation_time_val)) ? int((current_open_time + current_mitigation_time_val) / 2) : current_end_time
                current_label_text = str.tostring(sixteen_hundred_open.current_capture_hour) + ":00"
                current_label = label.new(current_label_time, current_open_price, current_label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                array.push(all_labels, current_label)

            levels_drawn += 1

        // Draw stored levels (from array) - most recent first, up to remaining limit
        if array.size(sixteen_hundred_open.opens) > 0
            for i = array.size(sixteen_hundred_open.opens) - 1 to 0
                if levels_drawn >= open1600ShowLast
                    break

                open_price = array.get(sixteen_hundred_open.opens, i)
                open_time = array.get(sixteen_hundred_open.times, i)
                is_mitigated = array.get(sixteen_hundred_open.mitigated, i)
                mitigation_time = array.get(sixteen_hundred_open.mitigation_times, i)

                // Determine end time
                // If mitigated: use mitigation time (line stops at breach point)
                // If not mitigated: extend to current time (line is still active)
                end_time = (is_mitigated and not na(mitigation_time)) ? mitigation_time : time

                // Draw horizontal line
                open_line = line.new(open_time, open_price, end_time, open_price, xloc=xloc.bar_time, color=open1600Color, width=open1600LineWidth, style=line.style_solid)
                array.push(all_lines, open_line)

                // Draw label at midpoint if mitigated, at end if active
                if showLabels
                    label_time = (is_mitigated and not na(mitigation_time)) ? int((open_time + mitigation_time) / 2) : end_time
                    // Safely get capture hour with fallback for legacy data
                    capture_hour = (i < array.size(sixteen_hundred_open.capture_hours)) ? array.get(sixteen_hundred_open.capture_hours, i) : 16
                    label_text = str.tostring(capture_hour) + ":00"
                    open_label = label.new(label_time, open_price, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, textcolor=labelTextColor, size=size.tiny, color=color.new(color.white, 100))
                    array.push(all_labels, open_label)

                levels_drawn += 1

    // Draw Asset Levels Table (optimized: only update when values change)
    var string prev_asset_table = ""
    var string prev_tf_table = ""
    var float prev_daily_dist = 0.0
    var float prev_intraday_pct1 = 0.0
    var bool prev_use_auto = true

    if showAssetLevelsTable and (detectedAsset != prev_asset_table or timeframe.period != prev_tf_table or dailyLiquidityDepthDistance != prev_daily_dist or intradayLiquidityDepthPercent1 != prev_intraday_pct1 or useAutoPercentages != prev_use_auto)
        prev_asset_table := detectedAsset
        prev_tf_table := timeframe.period
        prev_daily_dist := dailyLiquidityDepthDistance
        prev_intraday_pct1 := intradayLiquidityDepthPercent1
        prev_use_auto := useAutoPercentages

        // Calculate dynamic row count (no label rows)
        rowCount = 2  // Asset + TF
        rowCount := rowCount + (isDailyLiquidityDepthTimeframeValid ? 1 : 0)
        rowCount := rowCount + (isWeeklyLiquidityDepthTimeframeValid ? 1 : 0)
        rowCount := rowCount + (isMonthlyLiquidityDepthTimeframeValid ? 1 : 0)
        rowCount := rowCount + 1  // Intraday (always shown)

        // Clear and recreate table
        table.clear(asset_levels_table, 0, 0, 2, rowCount)

        currentRow = 0

        // Asset
        table.cell(asset_levels_table, 0, currentRow, "Asset", text_color=color.white, bgcolor=color.new(color.gray, 10), text_size=size.tiny)
        table.cell(asset_levels_table, 1, currentRow, detectedAsset, text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.tiny)
        currentRow := currentRow + 1

        // Timeframe
        table.cell(asset_levels_table, 0, currentRow, "TF", text_color=color.white, bgcolor=color.new(color.gray, 10), text_size=size.tiny)
        table.cell(asset_levels_table, 1, currentRow, timeframe.period, text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.tiny)
        currentRow := currentRow + 1

        // HTF Liquidity Depth (only if valid)
        if isDailyLiquidityDepthTimeframeValid
            dailyLevels = str.tostring(dailyLiquidityDepthDistance) + " | " + str.tostring(dailyLiquidityDepthDistance * 2) + " | " + str.tostring(dailyLiquidityDepthDistance * 3)
            table.cell(asset_levels_table, 0, currentRow, "Daily", text_color=color.white, bgcolor=color.new(color.gray, 10), text_size=size.tiny)
            table.cell(asset_levels_table, 1, currentRow, dailyLevels, text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.tiny)
            currentRow := currentRow + 1

        if isWeeklyLiquidityDepthTimeframeValid
            weeklyLevels = str.tostring(weeklyLiquidityDepthDistance) + " | " + str.tostring(weeklyLiquidityDepthDistance * 2) + " | " + str.tostring(weeklyLiquidityDepthDistance * 3)
            table.cell(asset_levels_table, 0, currentRow, "Weekly", text_color=color.white, bgcolor=color.new(color.gray, 10), text_size=size.tiny)
            table.cell(asset_levels_table, 1, currentRow, weeklyLevels, text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.tiny)
            currentRow := currentRow + 1

        if isMonthlyLiquidityDepthTimeframeValid
            monthlyLevels = str.tostring(monthlyLiquidityDepthDistance) + " | " + str.tostring(monthlyLiquidityDepthDistance * 2) + " | " + str.tostring(monthlyLiquidityDepthDistance * 3)
            table.cell(asset_levels_table, 0, currentRow, "Monthly", text_color=color.white, bgcolor=color.new(color.gray, 10), text_size=size.tiny)
            table.cell(asset_levels_table, 1, currentRow, monthlyLevels, text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.tiny)
            currentRow := currentRow + 1

        // Intraday Liquidity Depth (percentage-based with source indicator)
        sourceIndicator = useAutoPercentages ? " (Auto)" : " (Manual)"
        intradayLevels = str.tostring(intradayLiquidityDepthPercent1, "#.##") + "% | " + str.tostring(intradayLiquidityDepthPercent2, "#.##") + "% | " + str.tostring(intradayLiquidityDepthPercent3, "#.##") + "%" + sourceIndicator
        table.cell(asset_levels_table, 0, currentRow, "Intraday", text_color=color.white, bgcolor=color.new(color.gray, 10), text_size=size.tiny)
        table.cell(asset_levels_table, 1, currentRow, intradayLevels, text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE
// ═══════════════════════════════════════════════════════════════════════════════

if showColorTable and barstate.islast
    var table color_table = table.new(position.top_right, 4, 19, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

    // Header row
    table.cell(color_table, 0, 0, "Color", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(color_table, 1, 0, "Line", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(color_table, 2, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(color_table, 3, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)

    // Daily Color
    table.cell(color_table, 0, 1, "Daily", text_size=size.small)
    table.cell(color_table, 1, 1, "339", text_size=size.small)
    table.cell(color_table, 2, 1, str.format("R:{0} G:{1} B:{2}", int(color.r(dailyColor)), int(color.g(dailyColor)), int(color.b(dailyColor))), text_size=size.small)
    table.cell(color_table, 3, 1, str.tostring(int(color.t(dailyColor))), text_size=size.small)

    // Weekly Color
    table.cell(color_table, 0, 2, "Weekly", text_size=size.small)
    table.cell(color_table, 1, 2, "344", text_size=size.small)
    table.cell(color_table, 2, 2, str.format("R:{0} G:{1} B:{2}", int(color.r(weeklyColor)), int(color.g(weeklyColor)), int(color.b(weeklyColor))), text_size=size.small)
    table.cell(color_table, 3, 2, str.tostring(int(color.t(weeklyColor))), text_size=size.small)

    // Monthly Color
    table.cell(color_table, 0, 3, "Monthly", text_size=size.small)
    table.cell(color_table, 1, 3, "350", text_size=size.small)
    table.cell(color_table, 2, 3, str.format("R:{0} G:{1} B:{2}", int(color.r(monthlyColor)), int(color.g(monthlyColor)), int(color.b(monthlyColor))), text_size=size.small)
    table.cell(color_table, 3, 3, str.tostring(int(color.t(monthlyColor))), text_size=size.small)

    // HTF Liquidity Depth Color
    table.cell(color_table, 0, 4, "HTF Liq Depth", text_size=size.small)
    table.cell(color_table, 1, 4, "355", text_size=size.small)
    table.cell(color_table, 2, 4, str.format("R:{0} G:{1} B:{2}", int(color.r(liquidityDepthColor)), int(color.g(liquidityDepthColor)), int(color.b(liquidityDepthColor))), text_size=size.small)
    table.cell(color_table, 3, 4, str.tostring(int(color.t(liquidityDepthColor))), text_size=size.small)

    // Intraday Color
    table.cell(color_table, 0, 5, "Intraday", text_size=size.small)
    table.cell(color_table, 1, 5, "378", text_size=size.small)
    table.cell(color_table, 2, 5, str.format("R:{0} G:{1} B:{2}", int(color.r(intradayColor)), int(color.g(intradayColor)), int(color.b(intradayColor))), text_size=size.small)
    table.cell(color_table, 3, 5, str.tostring(int(color.t(intradayColor))), text_size=size.small)

    // Intraday Background Color
    table.cell(color_table, 0, 6, "Intraday BG", text_size=size.small)
    table.cell(color_table, 1, 6, "382", text_size=size.small)
    table.cell(color_table, 2, 6, str.format("R:{0} G:{1} B:{2}", int(color.r(intradayBackgroundColor)), int(color.g(intradayBackgroundColor)), int(color.b(intradayBackgroundColor))), text_size=size.small)
    table.cell(color_table, 3, 6, str.tostring(int(color.t(intradayBackgroundColor))), text_size=size.small)

    // Intraday Liquidity Depth Color
    table.cell(color_table, 0, 7, "ID Liq Depth", text_size=size.small)
    table.cell(color_table, 1, 7, "390", text_size=size.small)
    table.cell(color_table, 2, 7, str.format("R:{0} G:{1} B:{2}", int(color.r(intradayLiquidityDepthColor)), int(color.g(intradayLiquidityDepthColor)), int(color.b(intradayLiquidityDepthColor))), text_size=size.small)
    table.cell(color_table, 3, 7, str.tostring(int(color.t(intradayLiquidityDepthColor))), text_size=size.small)

