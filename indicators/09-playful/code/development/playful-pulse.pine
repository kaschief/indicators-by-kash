rangeBoxWidth = input.int(2, UI_WIDTH, minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group=GROUP_RANGE_BOX, inline='range_options')

showTimeDividers = input.bool(false, "Midnight Dividers", group=GROUP_TIME_DIVIDERS, inline='dividers')
