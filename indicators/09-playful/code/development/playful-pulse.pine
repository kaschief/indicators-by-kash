//@version=6

// ═══════════════════════════════════════════════════════════════════════════════
// INDICATOR SETUP
// ═══════════════════════════════════════════════════════════════════════════════
INDICATOR_MAX_LINES = 500
INDICATOR_MAX_LABELS = 500
INDICATOR_TITLE = 'Playful Pulse [Pro+]'
SHORT_TITLE = 'Pulse [Pro+]'

indicator(INDICATOR_TITLE, shorttitle=SHORT_TITLE, overlay=true, max_lines_count=INDICATOR_MAX_LINES, max_labels_count=INDICATOR_MAX_LABELS)

// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

NY_TIMEZONE = "America/New_York"
SUNDAY_REOPEN_START_HOUR = 18  // Also used for early-close holiday reopens
MARKET_CLOSE_HOUR = 16
MITIGATION_START_HOUR = 5  // When 16:00 levels can start being mitigated (next day)

// Day codes for session times
DAY_CODE_MON_SAT = ":23456"
DAY_CODE_ALL_DAYS = ":1234567"

// Pool type labels
POOL_TYPE_DAILY = "daily"
POOL_TYPE_WEEKLY = "weekly"
POOL_TYPE_MONTHLY = "monthly"
POOL_TYPE_ASIA = "asia"
POOL_TYPE_LONDON = "london"
POOL_TYPE_NYAM = "nyam"
POOL_TYPE_LUNCH = "lunch"
POOL_TYPE_NYPM = "nypm"
POOL_TYPE_PREMARKET = "premarket"
POOL_TYPE_OVERNIGHT = "overnight"

// Day names
DAY_MON = "MON"
DAY_TUE = "TUE"
DAY_WED = "WED"
DAY_THU = "THU"
DAY_FRI = "FRI"
DAY_SAT = "SAT"
DAY_SUN = "SUN"

// 16:00 mitigation window modes
