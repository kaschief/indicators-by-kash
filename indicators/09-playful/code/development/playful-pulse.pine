intradayLiquidityDepthPercent1Input = input.float(DEFAULT_INTRADAY_LIQUIDITY_DEPTH_PERCENT_1, "L1 %", minval=0.01, maxval=5.0, step=0.01, group=GROUP_INTRADAY, inline="intraday_pct")
intradayLiquidityDepthPercent2Input = input.float(DEFAULT_INTRADAY_LIQUIDITY_DEPTH_PERCENT_2, "L2 %", minval=0.01, maxval=5.0, step=0.01, group=GROUP_INTRADAY, inline="intraday_pct")
intradayLiquidityDepthPercent3Input = input.float(DEFAULT_INTRADAY_LIQUIDITY_DEPTH_PERCENT_3, "L3 %", minval=0.01, maxval=5.0, step=0.01, group=GROUP_INTRADAY, inline="intraday_pct")
intradayLiquidityDepthL1Color = input.color(DEFAULT_INTRADAY_COLOR, "  L1", group=GROUP_INTRADAY, inline="intraday_l1_style")
intradayLiquidityDepthL1Style = input.string("Dashed", "", options=["Solid", "Dashed", "Dotted"], group=GROUP_INTRADAY, inline="intraday_l1_style")
intradayLiquidityDepthL1Width = input.int(1, "", minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group=GROUP_INTRADAY, inline="intraday_l1_style")
intradayLiquidityDepthL2Color = input.color(DEFAULT_LIQUIDITY_DEPTH_EXTENSION_COLOR, "  L2", group=GROUP_INTRADAY, inline="intraday_l2_style")
intradayLiquidityDepthL2Style = input.string("Dashed", "", options=["Solid", "Dashed", "Dotted"], group=GROUP_INTRADAY, inline="intraday_l2_style")
intradayLiquidityDepthL2Width = input.int(1, "", minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group=GROUP_INTRADAY, inline="intraday_l2_style")
intradayLiquidityDepthL3Color = input.color(DEFAULT_LIQUIDITY_DEPTH_EXTENSION_COLOR, "  L3", group=GROUP_INTRADAY, inline="intraday_l3_style")
intradayLiquidityDepthL3Style = input.string("Dashed", "", options=["Solid", "Dashed", "Dotted"], group=GROUP_INTRADAY, inline="intraday_l3_style")
intradayLiquidityDepthL3Width = input.int(1, "", minval=LINE_WIDTH_MIN, maxval=LINE_WIDTH_MAX, group=GROUP_INTRADAY, inline="intraday_l3_style")

// Apply detected asset percentages (override inputs if asset supported and manual override not enabled)
useAutoPercentages = isAssetSupported and not useManualIntradayPercentages
intradayLiquidityDepthPercent1 = useAutoPercentages ? get_intraday_liquidity_depth_percent_1() : intradayLiquidityDepthPercent1Input
intradayLiquidityDepthPercent2 = useAutoPercentages ? get_intraday_liquidity_depth_percent_2() : intradayLiquidityDepthPercent2Input
intradayLiquidityDepthPercent3 = useAutoPercentages ? get_intraday_liquidity_depth_percent_3() : intradayLiquidityDepthPercent3Input

