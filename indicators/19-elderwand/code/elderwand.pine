monthlyShow = input.bool(false, LABEL_ENABLE_MONTHLY, inline="m", group=GROUP_MONTHLY, active=manualFilterSelected)
monthlyControlsActive = manualFilterSelected ? monthlyShow : monthlyFilterSelected
monthlyColor = input.color(DEFAULT_MONTHLY_COLOR, "", inline="m", group=GROUP_MONTHLY, active=monthlyControlsActive, tooltip=TOOLTIP_MAIN)
