rollingFillRange = input.string(FILL_RANGE_NONE, LABEL_FILL, options=[FILL_RANGE_NONE, FILL_RANGE_1_SIGMA, FILL_RANGE_2_SIGMA, FILL_RANGE_3_SIGMA], inline="r_fill", group=GROUP_ROLLING, active=rollingControlsActive)
