monthlyFillRange = input.string(FILL_RANGE_1_SIGMA, LABEL_FILL, options=[FILL_RANGE_NONE, FILL_RANGE_1_SIGMA, FILL_RANGE_2_SIGMA, FILL_RANGE_3_SIGMA], inline="m_fill", group=GROUP_MONTHLY, active=monthlyControlsActive)
monthlyFillOpacity = input.float(FILL_OPACITY_OTHER_DEFAULT, "", minval=FILL_OPACITY_MIN, maxval=FILL_OPACITY_MAX, step=FILL_OPACITY_STEP, inline="m_fill", group=GROUP_MONTHLY, active=monthlyControlsActive, tooltip=TOOLTIP_HISTORY_FILL)
monthlyVwapWidthChoice = input.string(DEFAULT_VWAP_WIDTH, "", options=["1", "2", "3", "4", "5"], inline="m_bands", group=GROUP_MONTHLY, active=monthlyControlsActive)
monthlyBand1Choice = input.string(BAND_OFF, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="m_bands", group=GROUP_MONTHLY, active=monthlyControlsActive)
monthlyBand2Choice = input.string(DEFAULT_BAND_2_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="m_bands", group=GROUP_MONTHLY, active=monthlyControlsActive)
monthlyBand3Choice = input.string(DEFAULT_BAND_3_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="m_bands", group=GROUP_MONTHLY, active=monthlyControlsActive, tooltip=TOOLTIP_BAND_WIDTH)

