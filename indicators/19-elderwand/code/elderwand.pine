quarterlyFillRange = input.string(FILL_RANGE_1_SIGMA, LABEL_FILL, options=[FILL_RANGE_NONE, FILL_RANGE_1_SIGMA, FILL_RANGE_2_SIGMA, FILL_RANGE_3_SIGMA], inline="q_fill", group=GROUP_QUARTERLY, active=quarterlyControlsActive)
quarterlyFillOpacity = input.float(FILL_OPACITY_OTHER_DEFAULT, "", minval=FILL_OPACITY_MIN, maxval=FILL_OPACITY_MAX, step=FILL_OPACITY_STEP, inline="q_fill", group=GROUP_QUARTERLY, active=quarterlyControlsActive, tooltip=TOOLTIP_HISTORY_FILL)
quarterlyVwapWidthChoice = input.string(DEFAULT_VWAP_WIDTH, "", options=["1", "2", "3", "4", "5"], inline="q_bands", group=GROUP_QUARTERLY, active=quarterlyControlsActive)
