rollingVwapWidthChoice = input.string(DEFAULT_VWAP_WIDTH, "", options=["1", "2", "3", "4", "5"], inline="r_bands", group=GROUP_ROLLING, active=rollingControlsActive)
rollingBand1Choice = input.string(BAND_OFF, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="r_bands", group=GROUP_ROLLING, active=rollingControlsActive)
rollingBand2Choice = input.string(ROLLING_BAND_2_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="r_bands", group=GROUP_ROLLING, active=rollingControlsActive)
