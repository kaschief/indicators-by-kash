quarterlyBand3Choice = input.string(DEFAULT_BAND_3_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="q_bands", group=GROUP_QUARTERLY, active=quarterlyControlsActive, tooltip=TOOLTIP_BAND_WIDTH)

yearlyShow = input.bool(false, LABEL_ENABLE_YEARLY, inline="y", group=GROUP_YEARLY, active=manualFilterSelected)
yearlyControlsActive = manualFilterSelected ? yearlyShow : yearlyFilterSelected
yearlyColor = input.color(DEFAULT_YEARLY_COLOR, "", inline="y", group=GROUP_YEARLY, active=yearlyControlsActive, tooltip=TOOLTIP_MAIN)
