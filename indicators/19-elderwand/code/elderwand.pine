//@version=6
indicator("elderwand •", overlay=true, max_polylines_count=100, max_labels_count=100)

// max_polylines_count=100 is the platform cap; high History can exceed it and Pine silently drops the oldest.

// CONSTANTS

const string NAME_DAILY     = "Daily"
const string NAME_WEEKLY    = "Weekly"
const string NAME_MONTHLY   = "Monthly"
const string NAME_QUARTERLY = "Quarterly"
const string NAME_YEARLY    = "Yearly"
const string NAME_NY        = "NY"
const string NAME_ROLLING   = "Rolling"

const string TIMEZONE          = "America/New_York"

const int    ROLLING_SESSIONS_DEFAULT = 14
const int    ROLLING_SESSIONS_MIN     = 2
const int    ROLLING_SESSIONS_MAX     = 60

// One source of truth for session windows so groups, detection, and cutoffs stay in sync.
const string SESSION_NY             = "0930-1600"
const string SESSION_NY_DISPLAY     = "09:30–16:00"
// 18:00 ET CME reopen edge — drives Skip Holiday Resets and NY's "to next open" extension.
// Only the 18:00 rising edge matters here, so the end time is arbitrary.
const string SESSION_DAILY_REOPEN   = "1800-0930"
const int    REOPEN_HOUR_18         = 18
const int    EXT_CUTOFF_NEXT_OPEN_HOUR = REOPEN_HOUR_18
const string EXT_CUTOFF_NEXT_OPEN_DISPLAY = "18:00"

const string GROUP_GENERAL   = "⚡ Quick Filter"
const string GROUP_QUICK_FILTER_PRICES = "⚡ Quick Filter: Prices"
const string GROUP_DAILY     = "☀️ " + NAME_DAILY
const string GROUP_WEEKLY    = "🌊 " + NAME_WEEKLY
const string GROUP_MONTHLY   = "🏔️ " + NAME_MONTHLY
const string GROUP_QUARTERLY = "💎 " + NAME_QUARTERLY
const string GROUP_YEARLY    = "🏛️ " + NAME_YEARLY
const string GROUP_NY        = "🗽 " + NAME_NY + " · " + SESSION_NY_DISPLAY
const string GROUP_ROLLING   = "🔄 " + NAME_ROLLING
const string GROUP_TABLE     = "🎨 Reference Table"
const string GROUP_QUICK_FILTER_SHOW_ONLY = "⚡ Quick Filter: Show Only"
const string SESSION_WINDOW_OVERNIGHT = "1600-0500:1234567"
const string SESSION_WINDOW_FROM_0500 = "0500-1600:1234567"
const string SESSION_WINDOW_FROM_0830 = "0830-1600:1234567"
const string SESSION_WINDOW_RTH = "0930-1600:1234567"
const string WINDOW_LABEL_OVERNIGHT = "Overnight"
const string WINDOW_LABEL_FROM_0500 = "● ● RTH"
const string WINDOW_LABEL_FROM_0830 = "● RTH"
const string WINDOW_LABEL_RTH = "RTH"

// Default anchor colours
const color DEFAULT_WEEKLY_COLOR    = color.rgb(41,  98,  255)
const color DEFAULT_DAILY_COLOR     = color.rgb(255, 167, 38)
const color DEFAULT_ROLLING_COLOR   = color.rgb(0,   188, 212)
const color DEFAULT_MONTHLY_COLOR   = color.rgb(76,  175, 80)
const color DEFAULT_QUARTERLY_COLOR = color.rgb(247, 11,  241)
const color DEFAULT_YEARLY_COLOR    = color.rgb(128, 25,  34)
const color DEFAULT_NY_COLOR        = color.rgb(74,  74,  74)
const color DEFAULT_HIDDEN_CANDLE_COLOR = color.new(color.rgb(245, 245, 245), 10)
const int   DEFAULT_BAND_1_SIGMA_TRANSPARENCY = 53
const int   DEFAULT_BAND_2_SIGMA_TRANSPARENCY = 59
const int   DEFAULT_BAND_3_SIGMA_TRANSPARENCY = 18
const string BAND_OFF = "Off"
const string DEFAULT_BAND_2_SIGMA_WIDTH = "2"
const string DEFAULT_BAND_3_SIGMA_WIDTH = "2"
const int BAND_1_SIGMA = 1
const int BAND_2_SIGMA = 2
const int BAND_3_SIGMA = 3
// VWAP centerline width (string dropdown values "1"–"5"). All anchors share this default.
const string DEFAULT_VWAP_WIDTH        = "3"
// Per-anchor σ-band width overrides: Daily / Weekly use distinct defaults from the
// shared DEFAULT_BAND_*_SIGMA_WIDTH set, so they get their own named constants.
const string DAILY_BAND_2_SIGMA_WIDTH  = "3"
const string DAILY_BAND_3_SIGMA_WIDTH  = "3"
const string WEEKLY_BAND_2_SIGMA_WIDTH = "3"
const string WEEKLY_BAND_3_SIGMA_WIDTH = "3"
// Rolling-VWAP σ-band defaults differ from the shared set too.
const string ROLLING_BAND_2_SIGMA_WIDTH = "3"
const string ROLLING_BAND_3_SIGMA_WIDTH = "3"

const int HISTORY_MIN         = 1
const int HISTORY_MAX         = 10
const int SHOW_ONLY_MAX_TIMEFRAME_SECONDS = 60 * 60
const int MAX_POLYLINE_POINTS = 9000
const float FILL_OPACITY_OTHER_DEFAULT   = 1.0
const float FILL_OPACITY_DAILY_DEFAULT   = 2.5
const float FILL_OPACITY_WEEKLY_DEFAULT  = 3.0
const float FILL_OPACITY_MIN       = 0.1
const float FILL_OPACITY_MAX       = 100.0
const float FILL_OPACITY_STEP      = 0.1
const float BAND_LABEL_TEXT_TRANSPARENCY_REDUCTION = 55.0
const float BAND_LABEL_TEXT_TRANSPARENCY_MAX  = 12.0
const string LABEL_MERGE_STRICT          = "Strict"
const string LABEL_MERGE_BALANCED        = "Balanced"
const string LABEL_MERGE_WIDE            = "Wide"
const string LABEL_MERGE_CUSTOM          = "Custom"
const float LABEL_MERGE_STRICT_PERCENT   = 0.005
const float LABEL_MERGE_BALANCED_PERCENT = 0.010
const float LABEL_MERGE_WIDE_PERCENT     = 0.025
const float LABEL_MERGE_DISTANCE_MAX     = 0.1
const float LABEL_MERGE_DISTANCE_STEP    = 0.001
const int MS_IN_DAY           = 86400000

const string LABEL_ENABLE_DAILY     = "Enable Daily VWAP"
const string LABEL_ENABLE_WEEKLY    = "Enable Weekly VWAP"
const string LABEL_ENABLE_MONTHLY   = "Enable Monthly VWAP"
const string LABEL_ENABLE_QUARTERLY = "Enable Quarterly VWAP"
const string LABEL_ENABLE_YEARLY    = "Enable Yearly VWAP"
const string LABEL_ENABLE_NY        = "Enable NY VWAP"
const string LABEL_ENABLE_ROLLING   = "Enable Rolling VWAP"
const string LABEL_HISTORY          = "History"
const string LABEL_FILL             = "Fill"
const string LABEL_BAND1            = "1σ"
const string LABEL_BAND2            = "2σ"
const string LABEL_BAND3            = "3σ"
const string LABEL_EXTENSION        = "Extension"
const string PREFIX_VWAP   = "★ "
const string SUFFIX_VWAP   = " VWAP"
const string LABEL_SEPARATOR = " • "

const string EXT_SESSION_ONLY = "Session only"
const string EXT_TO_NEXT_OPEN = "To " + EXT_CUTOFF_NEXT_OPEN_DISPLAY

const string FILL_RANGE_NONE = "None"
const string FILL_RANGE_1_SIGMA = "1σ to -1σ"
const string FILL_RANGE_2_SIGMA = "2σ to -2σ"
const string FILL_RANGE_3_SIGMA = "3σ to -3σ"
// Quick Filter presets: Manual respects per-group toggles; others force their set on, rest off.
const string FILTER_ALL                    = "Manual"
const string FILTER_YEARLY                 = "Yearly Only"
const string FILTER_QUARTERLY              = "Quarterly Only"
const string FILTER_MONTHLY                = "Monthly Only"
const string FILTER_WEEKLY                 = "Weekly Only"
const string FILTER_ROLLING                = "Rolling Only"
const string FILTER_DAILY                  = "Daily Only"
const string FILTER_NY                     = "NY Only"
const string FILTER_WEEKLY_DAILY           = "● Weekly + Daily"
const string FILTER_MONTHLY_WEEKLY_DAILY   = "● ● Monthly + Weekly + Daily"
const string FILTER_QUARTERLY_MONTHLY_WEEKLY_DAILY = "● ● ● Quarterly + Monthly + Weekly + Daily"
const string FILTER_MONTHLY_WEEKLY         = "● ● Monthly + Weekly"
const string FILTER_QUARTERLY_MONTHLY_WEEKLY = "● ● ● Quarterly + Monthly + Weekly"
const string FILTER_QUARTERLY_MONTHLY      = "● ● ● Quarterly + Monthly"
const string FILTER_YEARLY_QUARTERLY_MONTHLY = "● ● ● ● Yearly + Quarterly + Monthly"

const string PRICE_MODE_OFF    = "Off"
const string PRICE_MODE_ACTIVE = "Active"
const string PRICE_MODE_CUSTOM = "Custom"

const string TOOLTIP_QUICK_FILTER = "Override every per-group Enable toggle to show exactly the listed anchors.\n\n• ● Weekly + Daily\n• ● ● Monthly + Weekly\n• ● ● Monthly + Weekly + Daily\n• ● ● ● Quarterly + Monthly\n• ● ● ● Quarterly + Monthly + Weekly\n• ● ● ● Quarterly + Monthly + Weekly + Daily\n• ● ● ● ● Yearly + Quarterly + Monthly\n• Only — show that anchor by itself.\n• Manual — respect individual Enable toggles."
const string TOOLTIP_PRICE_MODE = "Prices on right-edge identities.\n\n• Off — names only.\n• Active — every visible anchor.\n• Custom — per-anchor choices in Quick Filter: Prices."
const string TOOLTIP_CUSTOM_PRICES = "Used when Prices is Custom. Choose which anchors append numeric prices to their right-edge labels."
const string TOOLTIP_VWAP_ONLY = "Global: hide every σ band (1σ / 2σ / 3σ) and its fill across all anchors, leaving only the VWAP centerlines. Overrides each group's σ Bands choice while on."
const string TOOLTIP_LABEL_MERGE = "Combines nearby right-edge labels into one identity.\n\n• Strict — 0.005%.\n• Balanced — 0.010%.\n• Wide — 0.025%.\n• Custom — use %.\n\nMinimum distance is one tick. The widest line supplies the label style; ties use timeframe priority."
const string TOOLTIP_BAND_WIDTH = "Widths left→right: VWAP · " + LABEL_BAND1 + " · " + LABEL_BAND2 + " · " + LABEL_BAND3 + ". VWAP is 1–5; each σ band is Off (hidden) or 1–5 (line width)."
const string TOOLTIP_MAIN   = "Show this VWAP · colour. Auto-hides once the chart timeframe reaches the anchor period."
const string TOOLTIP_HISTORY_FILL = "History: 1 = current only, N = current + N−1 past. Fill: None disables fill; each σ choice fills exactly that band range. The number beside Fill controls fill strength from 0.1–100."
const string TOOLTIP_FILL = "Fill: None disables fill; each σ choice fills exactly that band range. The number beside Fill controls fill strength from 0.1–100."
const string TOOLTIP_ROLLING_SESSIONS = "Number of trading sessions in the rolling window. A session = a calendar day (New York time) that printed bars, so it adapts to the asset: every day counts on 24/7 markets, while weekends and no-trade holidays are skipped and half-days count once."
const string TOOLTIP_INTRADAY_EXTENSION = "Controls how long this intraday VWAP continues plotting after its session ends, using New York time."

// TYPES — one anchored VWAP: config, current-period buffer, retained history

type PeriodLines
    array<polyline> polylines

type VwapAnchor
    string name
    color  lineColor
    int    lineWidth
    int    historyDepth
    float  fillOpacity
    string fillRange
    bool   band1Enabled
    color  band1Color
    int    band1Width
    bool   band2Enabled
    color  band2Color
    int    band2Width
    bool   band3Enabled
    color  band3Color
    int    band3Width
    bool   pricesEnabled
    float  labelVwapValue
    float  labelStdevValue
    int    labelPricePriority
    string labelSize
    bool   visible
    bool   drawVisible
    string displayName
    array<int>         barTimes
    array<float>       vwapValues
    array<float>       stdevValues
    array<PeriodLines> history
    PeriodLines        currentPeriod

type PendingLabel
    int    barTime
    float  price
    float  displayPrice
    int    pricePriority
    string identity
    bool   showPrice
    color  textColor
    string labelSize
    int    lineWidth
    int    priority

new_anchor(string name) =>
    VwapAnchor.new(name=name, barTimes=array.new<int>(), vwapValues=array.new<float>(), stdevValues=array.new<float>(), history=array.new<PeriodLines>())

var array<PendingLabel> pendingLabels = array.new<PendingLabel>()
var array<label> renderedLabels = array.new<label>()

// INPUTS — per anchor: main (Show · colour · History), fill (Fill · strength), bands

quickFilter = input.string(FILTER_WEEKLY_DAILY, "Quick Filter", options=[FILTER_ALL, FILTER_WEEKLY_DAILY, FILTER_MONTHLY_WEEKLY, FILTER_MONTHLY_WEEKLY_DAILY, FILTER_QUARTERLY_MONTHLY, FILTER_QUARTERLY_MONTHLY_WEEKLY, FILTER_QUARTERLY_MONTHLY_WEEKLY_DAILY, FILTER_YEARLY_QUARTERLY_MONTHLY, FILTER_YEARLY, FILTER_QUARTERLY, FILTER_MONTHLY, FILTER_WEEKLY, FILTER_ROLLING, FILTER_DAILY, FILTER_NY], group=GROUP_GENERAL, tooltip=TOOLTIP_QUICK_FILTER)
quickPriceMode = input.string(PRICE_MODE_OFF, "Prices", options=[PRICE_MODE_OFF, PRICE_MODE_ACTIVE, PRICE_MODE_CUSTOM], group=GROUP_GENERAL, tooltip=TOOLTIP_PRICE_MODE)
vwapLinesOnly = input.bool(false, "VWAP Lines Only", group=GROUP_GENERAL, tooltip=TOOLTIP_VWAP_ONLY)
mergeOverlappingLabels = input.bool(true, "Merge Overlapping Labels", inline="label_merge", group=GROUP_GENERAL)
labelMergePreset = input.string(LABEL_MERGE_WIDE, "", options=[LABEL_MERGE_STRICT, LABEL_MERGE_BALANCED, LABEL_MERGE_WIDE, LABEL_MERGE_CUSTOM], inline="label_merge", group=GROUP_GENERAL, active=mergeOverlappingLabels)
customLabelMergeDistancePercent = input.float(LABEL_MERGE_BALANCED_PERCENT, "%", minval=0.0, maxval=LABEL_MERGE_DISTANCE_MAX, step=LABEL_MERGE_DISTANCE_STEP, inline="label_merge", group=GROUP_GENERAL, active=mergeOverlappingLabels and labelMergePreset == LABEL_MERGE_CUSTOM, tooltip=TOOLTIP_LABEL_MERGE)
labelMergeDistancePercent = labelMergePreset == LABEL_MERGE_STRICT ? LABEL_MERGE_STRICT_PERCENT : labelMergePreset == LABEL_MERGE_WIDE ? LABEL_MERGE_WIDE_PERCENT : labelMergePreset == LABEL_MERGE_CUSTOM ? customLabelMergeDistancePercent : LABEL_MERGE_BALANCED_PERCENT
showBands = not vwapLinesOnly

manualFilterSelected = quickFilter == FILTER_ALL
yearlyFilterSelected = quickFilter == FILTER_YEARLY or quickFilter == FILTER_YEARLY_QUARTERLY_MONTHLY
quarterlyFilterSelected = quickFilter == FILTER_QUARTERLY or quickFilter == FILTER_QUARTERLY_MONTHLY or quickFilter == FILTER_QUARTERLY_MONTHLY_WEEKLY or quickFilter == FILTER_QUARTERLY_MONTHLY_WEEKLY_DAILY or quickFilter == FILTER_YEARLY_QUARTERLY_MONTHLY
monthlyFilterSelected = quickFilter == FILTER_MONTHLY or quickFilter == FILTER_MONTHLY_WEEKLY or quickFilter == FILTER_MONTHLY_WEEKLY_DAILY or quickFilter == FILTER_QUARTERLY_MONTHLY or quickFilter == FILTER_QUARTERLY_MONTHLY_WEEKLY or quickFilter == FILTER_QUARTERLY_MONTHLY_WEEKLY_DAILY or quickFilter == FILTER_YEARLY_QUARTERLY_MONTHLY
weeklyFilterSelected = quickFilter == FILTER_WEEKLY or quickFilter == FILTER_WEEKLY_DAILY or quickFilter == FILTER_MONTHLY_WEEKLY or quickFilter == FILTER_MONTHLY_WEEKLY_DAILY or quickFilter == FILTER_QUARTERLY_MONTHLY_WEEKLY or quickFilter == FILTER_QUARTERLY_MONTHLY_WEEKLY_DAILY
rollingFilterSelected = quickFilter == FILTER_ROLLING
dailyFilterSelected = quickFilter == FILTER_DAILY or quickFilter == FILTER_WEEKLY_DAILY or quickFilter == FILTER_MONTHLY_WEEKLY_DAILY or quickFilter == FILTER_QUARTERLY_MONTHLY_WEEKLY_DAILY
nyFilterSelected = quickFilter == FILTER_NY
customPricesSelected = quickPriceMode == PRICE_MODE_CUSTOM

in_quick_filter(string name) =>
    switch quickFilter
        FILTER_YEARLY                 => name == NAME_YEARLY
        FILTER_QUARTERLY              => name == NAME_QUARTERLY
        FILTER_MONTHLY                => name == NAME_MONTHLY
        FILTER_WEEKLY                 => name == NAME_WEEKLY
        FILTER_ROLLING                => name == NAME_ROLLING
        FILTER_DAILY                  => name == NAME_DAILY
        FILTER_NY                     => name == NAME_NY
        FILTER_WEEKLY_DAILY           => name == NAME_DAILY or name == NAME_WEEKLY
        FILTER_MONTHLY_WEEKLY_DAILY   => name == NAME_DAILY or name == NAME_WEEKLY or name == NAME_MONTHLY
        FILTER_QUARTERLY_MONTHLY_WEEKLY_DAILY => name == NAME_DAILY or name == NAME_WEEKLY or name == NAME_MONTHLY or name == NAME_QUARTERLY
        FILTER_MONTHLY_WEEKLY         => name == NAME_WEEKLY or name == NAME_MONTHLY
        FILTER_QUARTERLY_MONTHLY_WEEKLY => name == NAME_WEEKLY or name == NAME_MONTHLY or name == NAME_QUARTERLY
        FILTER_QUARTERLY_MONTHLY      => name == NAME_MONTHLY or name == NAME_QUARTERLY
        FILTER_YEARLY_QUARTERLY_MONTHLY => name == NAME_MONTHLY or name == NAME_QUARTERLY or name == NAME_YEARLY
        => false

yearlyShowPrice = input.bool(false, "Yearly", inline="prices_calendar", group=GROUP_QUICK_FILTER_PRICES, active=customPricesSelected and (manualFilterSelected or yearlyFilterSelected))
quarterlyShowPrice = input.bool(false, "Quarterly", inline="prices_calendar", group=GROUP_QUICK_FILTER_PRICES, active=customPricesSelected and (manualFilterSelected or quarterlyFilterSelected))
monthlyShowPrice = input.bool(false, "Monthly", inline="prices_calendar", group=GROUP_QUICK_FILTER_PRICES, active=customPricesSelected and (manualFilterSelected or monthlyFilterSelected))
weeklyShowPrice = input.bool(false, "Weekly", inline="prices_calendar", group=GROUP_QUICK_FILTER_PRICES, active=customPricesSelected and (manualFilterSelected or weeklyFilterSelected))
rollingShowPrice = input.bool(false, "Rolling", inline="prices_other", group=GROUP_QUICK_FILTER_PRICES, active=customPricesSelected and (manualFilterSelected or rollingFilterSelected))
dailyShowPrice = input.bool(false, "Daily", inline="prices_other", group=GROUP_QUICK_FILTER_PRICES, active=customPricesSelected and (manualFilterSelected or dailyFilterSelected))
nyShowPrice = input.bool(false, "NY", inline="prices_other", group=GROUP_QUICK_FILTER_PRICES, active=customPricesSelected and (manualFilterSelected or nyFilterSelected), tooltip=TOOLTIP_CUSTOM_PRICES)

// INPUTS — Show Only

showOnlyEnabled = input.bool(true, "Show Only", inline="show_only", group=GROUP_QUICK_FILTER_SHOW_ONLY)
hiddenCandleColor = input.color(DEFAULT_HIDDEN_CANDLE_COLOR, "", inline="show_only", group=GROUP_QUICK_FILTER_SHOW_ONLY, active=showOnlyEnabled)
visibleWindow = input.string(WINDOW_LABEL_RTH, "", options=[WINDOW_LABEL_OVERNIGHT, WINDOW_LABEL_FROM_0500, WINDOW_LABEL_FROM_0830, WINDOW_LABEL_RTH], inline="show_only", group=GROUP_QUICK_FILTER_SHOW_ONLY, active=showOnlyEnabled)
showOnlyMostRecent = input.bool(false, "Most Recent Only", inline="show_only", group=GROUP_QUICK_FILTER_SHOW_ONLY, active=showOnlyEnabled, tooltip="Dims candles outside the selected New York window. Elderwand calculations and drawings stay unchanged.\n\n• Overnight — 16:00–05:00.\n• ● ● RTH — 05:00–16:00.\n• ● RTH — 08:30–16:00.\n• RTH — 09:30–16:00.\n\nAvailable through 1-hour and on Range charts.\n\n———\n\nMost Recent Only\nShows the selected window only on the current New York date.\n\nOff — show the window every day.")

dailyShow = input.bool(false, LABEL_ENABLE_DAILY, inline="d", group=GROUP_DAILY, active=manualFilterSelected)
dailyControlsActive = manualFilterSelected ? dailyShow : dailyFilterSelected
dailyColor = input.color(DEFAULT_DAILY_COLOR, "", inline="d", group=GROUP_DAILY, active=dailyControlsActive, tooltip=TOOLTIP_MAIN)
dailyHistory = input.int(HISTORY_MIN, LABEL_HISTORY, minval=HISTORY_MIN, maxval=HISTORY_MAX, inline="d", group=GROUP_DAILY, active=dailyControlsActive)
dailyFillRange = input.string(FILL_RANGE_2_SIGMA, LABEL_FILL, options=[FILL_RANGE_NONE, FILL_RANGE_1_SIGMA, FILL_RANGE_2_SIGMA, FILL_RANGE_3_SIGMA], inline="d_fill", group=GROUP_DAILY, active=dailyControlsActive)
dailyFillOpacity = input.float(FILL_OPACITY_DAILY_DEFAULT, "", minval=FILL_OPACITY_MIN, maxval=FILL_OPACITY_MAX, step=FILL_OPACITY_STEP, inline="d_fill", group=GROUP_DAILY, active=dailyControlsActive, tooltip=TOOLTIP_HISTORY_FILL)
dailyVwapWidthChoice = input.string(DEFAULT_VWAP_WIDTH, "", options=["1", "2", "3", "4", "5"], inline="d_bands", group=GROUP_DAILY, active=dailyControlsActive)
dailyBand1Choice = input.string(BAND_OFF, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="d_bands", group=GROUP_DAILY, active=dailyControlsActive)
dailyBand2Choice = input.string(DAILY_BAND_2_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="d_bands", group=GROUP_DAILY, active=dailyControlsActive)
dailyBand3Choice = input.string(DAILY_BAND_3_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="d_bands", group=GROUP_DAILY, active=dailyControlsActive, tooltip=TOOLTIP_BAND_WIDTH)
dailySkipHolidayResets = input.bool(true, "Skip Holiday Resets", group=GROUP_DAILY, active=dailyControlsActive, tooltip="Anchors the Daily VWAP to the 18:00 ET reopen instead of TradingView's daily bar. On CME holidays (e.g. Memorial Day) TradingView merges the shortened session into one 'D' bar, so the Daily VWAP would otherwise not restart at the post-holiday 18:00 reopen — this forces it to.")

weeklyShow = input.bool(false, LABEL_ENABLE_WEEKLY, inline="w", group=GROUP_WEEKLY, active=manualFilterSelected)
weeklyControlsActive = manualFilterSelected ? weeklyShow : weeklyFilterSelected
weeklyColor = input.color(DEFAULT_WEEKLY_COLOR, "", inline="w", group=GROUP_WEEKLY, active=weeklyControlsActive, tooltip=TOOLTIP_MAIN)
weeklyHistory = input.int(HISTORY_MIN, LABEL_HISTORY, minval=HISTORY_MIN, maxval=HISTORY_MAX, inline="w", group=GROUP_WEEKLY, active=weeklyControlsActive)
weeklyFillRange = input.string(FILL_RANGE_NONE, LABEL_FILL, options=[FILL_RANGE_NONE, FILL_RANGE_1_SIGMA, FILL_RANGE_2_SIGMA, FILL_RANGE_3_SIGMA], inline="w_fill", group=GROUP_WEEKLY, active=weeklyControlsActive)
weeklyFillOpacity = input.float(FILL_OPACITY_WEEKLY_DEFAULT, "", minval=FILL_OPACITY_MIN, maxval=FILL_OPACITY_MAX, step=FILL_OPACITY_STEP, inline="w_fill", group=GROUP_WEEKLY, active=weeklyControlsActive, tooltip=TOOLTIP_HISTORY_FILL)
weeklyVwapWidthChoice = input.string(DEFAULT_VWAP_WIDTH, "", options=["1", "2", "3", "4", "5"], inline="w_bands", group=GROUP_WEEKLY, active=weeklyControlsActive)
weeklyBand1Choice = input.string(BAND_OFF, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="w_bands", group=GROUP_WEEKLY, active=weeklyControlsActive)
weeklyBand2Choice = input.string(WEEKLY_BAND_2_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="w_bands", group=GROUP_WEEKLY, active=weeklyControlsActive)
weeklyBand3Choice = input.string(WEEKLY_BAND_3_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="w_bands", group=GROUP_WEEKLY, active=weeklyControlsActive, tooltip=TOOLTIP_BAND_WIDTH)
weeklySkipHolidayResets = input.bool(true, "Skip Holiday Resets", group=GROUP_WEEKLY, active=weeklyControlsActive, tooltip="Anchors the Weekly VWAP to the Sunday 18:00 ET CME reopen instead of TradingView's weekly bar. On weeks with a Friday holiday (e.g. Juneteenth) TradingView may end the weekly bar early, causing the Weekly VWAP to reset mid-week — this forces it to restart only at the true Sunday reopen.")

nyShow = input.bool(false, LABEL_ENABLE_NY, inline="ny", group=GROUP_NY, active=manualFilterSelected)
nyControlsActive = manualFilterSelected ? nyShow : nyFilterSelected
nyColor = input.color(DEFAULT_NY_COLOR, "", inline="ny", group=GROUP_NY, active=nyControlsActive, tooltip=TOOLTIP_MAIN)
nyHistory = input.int(HISTORY_MIN, LABEL_HISTORY, minval=HISTORY_MIN, maxval=HISTORY_MAX, inline="ny", group=GROUP_NY, active=nyControlsActive)
nyExtension = input.string(EXT_SESSION_ONLY, LABEL_EXTENSION, options=[EXT_SESSION_ONLY, EXT_TO_NEXT_OPEN], group=GROUP_NY, active=nyControlsActive, tooltip=TOOLTIP_INTRADAY_EXTENSION)
nyFillRange = input.string(FILL_RANGE_2_SIGMA, LABEL_FILL, options=[FILL_RANGE_NONE, FILL_RANGE_1_SIGMA, FILL_RANGE_2_SIGMA, FILL_RANGE_3_SIGMA], inline="ny_fill", group=GROUP_NY, active=nyControlsActive)
nyFillOpacity = input.float(FILL_OPACITY_OTHER_DEFAULT, "", minval=FILL_OPACITY_MIN, maxval=FILL_OPACITY_MAX, step=FILL_OPACITY_STEP, inline="ny_fill", group=GROUP_NY, active=nyControlsActive, tooltip=TOOLTIP_HISTORY_FILL)
nyVwapWidthChoice = input.string(DEFAULT_VWAP_WIDTH, "", options=["1", "2", "3", "4", "5"], inline="ny_bands", group=GROUP_NY, active=nyControlsActive)
nyBand1Choice = input.string(BAND_OFF, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="ny_bands", group=GROUP_NY, active=nyControlsActive)
nyBand2Choice = input.string(DEFAULT_BAND_2_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="ny_bands", group=GROUP_NY, active=nyControlsActive)
nyBand3Choice = input.string(DEFAULT_BAND_3_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="ny_bands", group=GROUP_NY, active=nyControlsActive, tooltip=TOOLTIP_BAND_WIDTH)

rollingShow = input.bool(false, LABEL_ENABLE_ROLLING, inline="r", group=GROUP_ROLLING, active=manualFilterSelected)
rollingControlsActive = manualFilterSelected ? rollingShow : rollingFilterSelected
rollingColor = input.color(DEFAULT_ROLLING_COLOR, "", inline="r", group=GROUP_ROLLING, active=rollingControlsActive, tooltip=TOOLTIP_MAIN)
