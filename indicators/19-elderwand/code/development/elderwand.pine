//@version=6
indicator("elderwand •", overlay=true, max_polylines_count=100, max_labels_count=100)

// Anchored VWAPs as polylines: per-band colour/width, last-N history, gap-safe sessions.
// Polyline cap = 100 (platform max). ~8 polylines/period × 7 anchors × History can exceed it
// → Pine silently drops the oldest. Defaults (History=1) ≈ 56; keep History modest.

// CONSTANTS

const string NAME_DAILY     = "Daily"
const string NAME_WEEKLY    = "Weekly"
const string NAME_MONTHLY   = "Monthly"
const string NAME_QUARTERLY = "Quarterly"
const string NAME_YEARLY    = "Yearly"
const string NAME_NY        = "NY"
const string NAME_MNO  = "MNO"
const string NAME_ROLLING   = "Rolling"

const string TIMEZONE          = "America/New_York"

const int    ROLLING_SESSIONS_DEFAULT = 14
const int    ROLLING_SESSIONS_MIN     = 2
const int    ROLLING_SESSIONS_MAX     = 60

// One source of truth for session windows so groups, detection, and cutoffs stay in sync.
const string SESSION_NY             = "0930-1600"
const string SESSION_NY_DISPLAY     = "09:30–16:00"
// 18:00 ET CME reopen edge — drives Daily Holiday Mode and NY's "to next open" extension.
// Only the 18:00 rising edge matters here, so the end time is arbitrary.
const string SESSION_DAILY_REOPEN   = "1800-0930"
const int    REOPEN_HOUR_18         = 18
const string SESSION_MNO_DISPLAY = "00:00–24:00"
const int    EXT_CUTOFF_NEXT_OPEN_HOUR = REOPEN_HOUR_18
const string EXT_CUTOFF_NEXT_OPEN_DISPLAY = "18:00"

const string GROUP_GENERAL   = "⚡ Quick Filter"
const string GROUP_DAILY     = "☀️ " + NAME_DAILY
const string GROUP_WEEKLY    = "🌊 " + NAME_WEEKLY
const string GROUP_MONTHLY   = "🏔️ " + NAME_MONTHLY
const string GROUP_QUARTERLY = "💎 " + NAME_QUARTERLY
const string GROUP_YEARLY    = "🏛️ " + NAME_YEARLY
const string GROUP_NY        = "🗽 " + NAME_NY + " · " + SESSION_NY_DISPLAY
const string GROUP_MNO  = "🌙 " + NAME_MNO + " · " + SESSION_MNO_DISPLAY
const string GROUP_ROLLING   = "🔄 " + NAME_ROLLING
const string GROUP_TABLE     = "🎨 Reference Table"

// Default anchor colours
const color DEFAULT_WEEKLY_COLOR    = color.rgb(41,  98,  255)
const color DEFAULT_DAILY_COLOR     = color.rgb(255, 167, 38)
const color DEFAULT_MNO_COLOR  = color.rgb(149, 103, 230)
const color DEFAULT_ROLLING_COLOR   = color.rgb(0,   188, 212)
const color DEFAULT_MONTHLY_COLOR   = color.rgb(165, 214, 167)
const color DEFAULT_QUARTERLY_COLOR = color.rgb(247, 11,  241)
const color DEFAULT_YEARLY_COLOR    = color.rgb(128, 25,  34)
const color DEFAULT_NY_COLOR        = color.rgb(74,  74,  74)
const int   DEFAULT_BAND_1_SIGMA_TRANSPARENCY = 53
const int   DEFAULT_BAND_2_SIGMA_TRANSPARENCY = 59
const int   DEFAULT_BAND_3_SIGMA_TRANSPARENCY = 18
const string BAND_OFF = "Off"
const string DEFAULT_BAND_1_SIGMA_WIDTH = "1"
const string DEFAULT_BAND_2_SIGMA_WIDTH = "2"
const string DEFAULT_BAND_3_SIGMA_WIDTH = "2"
const int BAND_1_SIGMA = 1
const int BAND_2_SIGMA = 2
const int BAND_3_SIGMA = 3
// VWAP centerline width (string dropdown values "1"–"5"). All anchors share this default.
const string DEFAULT_VWAP_WIDTH        = "3"
// Per-anchor σ-band width overrides: Daily / Weekly / MNO use distinct defaults from the
// shared DEFAULT_BAND_*_SIGMA_WIDTH set, so they get their own named constants.
const string DAILY_BAND_1_SIGMA_WIDTH  = "3"
const string DAILY_BAND_2_SIGMA_WIDTH  = "3"
const string DAILY_BAND_3_SIGMA_WIDTH  = "3"
const string WEEKLY_BAND_1_SIGMA_WIDTH = "2"
const string WEEKLY_BAND_2_SIGMA_WIDTH = "3"
const string WEEKLY_BAND_3_SIGMA_WIDTH = "3"
const string MNO_BAND_2_SIGMA_WIDTH    = "2"
const string MNO_BAND_3_SIGMA_WIDTH    = "3"
// Rolling-VWAP σ-band defaults differ from the shared set too.
const string ROLLING_BAND_1_SIGMA_WIDTH = "2"
const string ROLLING_BAND_2_SIGMA_WIDTH = "3"
const string ROLLING_BAND_3_SIGMA_WIDTH = "3"

const int HISTORY_MIN         = 1
const int HISTORY_MAX         = 10
const int MAX_POLYLINE_POINTS = 9000
const float FILL_OPACITY_DEFAULT         = 0.5
const float FILL_OPACITY_DAILY_DEFAULT   = 2.5
const float FILL_OPACITY_WEEKLY_DEFAULT  = 3.0
const float FILL_OPACITY_MONTHLY_DEFAULT = 8.0
const float FILL_OPACITY_QUARTERLY_DEFAULT = 10.0
const float FILL_OPACITY_YEARLY_DEFAULT    = 12.0
const float FILL_OPACITY_NY_DEFAULT      = 6.0
const float FILL_OPACITY_MIN       = 0.1
const float FILL_OPACITY_MAX       = 100.0
const float FILL_OPACITY_STEP      = 0.1
const float BAND_LABEL_TEXT_TRANSPARENCY_REDUCTION = 55.0
const float BAND_LABEL_TEXT_TRANSPARENCY_MAX  = 12.0
const int MS_IN_DAY           = 86400000

const string LABEL_ENABLE_DAILY     = "Enable Daily VWAP"
const string LABEL_ENABLE_WEEKLY    = "Enable Weekly VWAP"
const string LABEL_ENABLE_MONTHLY   = "Enable Monthly VWAP"
const string LABEL_ENABLE_QUARTERLY = "Enable Quarterly VWAP"
const string LABEL_ENABLE_YEARLY    = "Enable Yearly VWAP"
const string LABEL_ENABLE_NY        = "Enable NY VWAP"
const string LABEL_ENABLE_MNO  = "Enable MNO VWAP"
const string LABEL_ENABLE_ROLLING   = "Enable Rolling VWAP"
const string LABEL_HISTORY          = "History"
const string LABEL_FILL             = "Fill"
const string LABEL_BAND1            = "1σ"
const string LABEL_BAND2            = "2σ"
const string LABEL_BAND3            = "3σ"
const string LABEL_LABEL            = "Label"
const string LABEL_PRICE            = "Price"
const string LABEL_EXTENSION        = "Extension"
const string PREFIX_VWAP   = "★ "
const string SUFFIX_VWAP   = " VWAP"
const string LABEL_SEPARATOR = " • "

const string EXT_SESSION_ONLY = "Session only"
const string EXT_TO_NEXT_OPEN = "To " + EXT_CUTOFF_NEXT_OPEN_DISPLAY

// Per-group label font size
const string FONT_TINY   = "Tiny"
const string FONT_SMALL  = "Small"
const string FONT_NORMAL = "Normal"
const string FONT_LARGE  = "Large"
const string FONT_HUGE   = "Huge"

// Per-group σ band sides: both, only above VWAP, or only below
const string BAND_BOTH     = "All"
const string BAND_UPPER    = "Upper Only"
const string BAND_LOWER    = "Lower Only"
const string BAND_SANDWICH = "Sandwich"

const string FILL_RANGE_NONE = "None"
const string FILL_RANGE_1_SIGMA = "1σ to -1σ"
const string FILL_RANGE_2_SIGMA = "2σ to -2σ"
const string FILL_RANGE_3_SIGMA = "3σ to -3σ"
// Quick Filter presets: All = respect per-group toggles; others force their set on, rest off.
const string FILTER_ALL                    = "All"
const string FILTER_DAILY                  = "Daily"
const string FILTER_WEEKLY                 = "Weekly"
const string FILTER_DAILY_WEEKLY           = "⭐ Daily + Weekly"
const string FILTER_NY                     = "NY"
const string FILTER_DAILY_WEEKLY_NY        = "🗽 Daily + Weekly + NY"
const string FILTER_DAILY_WEEKLY_MONTHLY   = "Daily + Weekly + Monthly"
const string FILTER_MONTHLY                = "Monthly"
const string FILTER_DAILY_NY               = "Daily + NY"
const string FILTER_QUARTERLY              = "Quarterly"
const string FILTER_YEARLY                 = "Yearly"
const string FILTER_QUARTERLY_YEARLY       = "Quarterly + Yearly"
const string FILTER_MONTHLY_QUARTERLY_YEARLY = "Monthly + Quarterly + Yearly"
const string FILTER_MNO               = "Just MNO"
const string FILTER_DAILY_WEEKLY_MNO  = "🌙 Daily + Weekly + MNO"
const string FILTER_DAILY_MNO         = "Daily + MNO"
const string FILTER_ROLLING                = "Rolling"

const string TOOLTIP_QUICK_FILTER = "Override every per-group Enable toggle to quickly show a preset set of anchors.\n\n• All: Respect individual Enable toggles\n• Daily: Daily only\n• Weekly: Weekly only\n• Daily + Weekly: Daily + Weekly\n• NY: NY only\n• Daily + NY: Daily + NY\n• Daily + Weekly + NY: Daily + Weekly + NY\n• Daily + Weekly + Monthly: Daily + Weekly + Monthly\n• Monthly: Monthly only\n• MNO: MNO only\n• Daily + Weekly + MNO: Daily + Weekly + MNO\n• Daily + MNO: Daily + MNO\n• Rolling: Rolling only\n• Quarterly: Quarterly only\n• Yearly: Yearly only\n• Quarterly + Yearly: Quarterly + Yearly\n• Monthly + Quarterly + Yearly: Monthly + Quarterly + Yearly"
const string TOOLTIP_VWAP_ONLY = "Global: hide every σ band (1σ / 2σ / 3σ) and its fill across all anchors, leaving only the VWAP centerlines. Overrides each group's σ Bands choice while on."
const string TOOLTIP_VWAP_STAR = "Prefix every VWAP centerline label with a text star that inherits the line colour (e.g. ★ Daily VWAP). Off = plain label (Daily VWAP). Does not affect σ band tags."
const string TOOLTIP_BAND_SIDE = "Which σ bands to show for this group: All, Upper Only (above VWAP), Lower Only (below VWAP), or Sandwich (both sides, 1σ + 2σ only — drops the outer 3σ). Affects this group's band lines and tags; the centerline always stays. The global VWAP Lines Only overrides this and hides all bands."
const string TOOLTIP_BAND_WIDTH = "Widths left→right: VWAP · " + LABEL_BAND1 + " · " + LABEL_BAND2 + " · " + LABEL_BAND3 + ". VWAP is 1–5; each σ band is Off (hidden) or 1–5 (line width)."
const string TOOLTIP_MAIN   = "Show this VWAP · colour. Auto-hides once the chart timeframe reaches the anchor period."
const string TOOLTIP_HISTORY_FILL = "History: 1 = current only, N = current + N−1 past. Fill: None disables fill; each σ choice fills exactly that band range. The number beside Fill controls fill strength from 0.1–100."
const string TOOLTIP_FILL = "Fill: None disables fill; each σ choice fills exactly that band range. The number beside Fill controls fill strength from 0.1–100."
const string TOOLTIP_ROLLING_SESSIONS = "Number of trading sessions in the rolling window. A session = a calendar day (New York time) that printed bars, so it adapts to the asset: every day counts on 24/7 markets, while weekends and no-trade holidays are skipped and half-days count once."
const string TOOLTIP_INTRADAY_EXTENSION = "Controls how long this intraday VWAP continues plotting after its session ends, using New York time."
const string TOOLTIP_LABELS = "σ Bands picks which sides show (All / Upper / Lower / Sandwich). Label toggles all labels for this group: VWAP plus every enabled σ band. Size sets the tag font. Price appends a text-bullet price to this group's VWAP and σ labels."

// TYPES — one anchored VWAP: config, current-period buffer, retained history

type PeriodLines
    array<polyline> polylines

type VwapAnchor
    string name
    color  lineColor
    int    lineWidth
    int    historyDepth
    float  fillOpacity
    string fillRange
    bool   band1Enabled
    color  band1Color
    int    band1Width
    bool   band2Enabled
    color  band2Color
    int    band2Width
    bool   band3Enabled
    color  band3Color
    int    band3Width
    bool   labelsEnabled
    bool   pricesEnabled
    string labelSize
    bool   showUpper
    bool   showLower
    bool   visible
    bool   drawVisible
    string displayName
    array<int>         barTimes
    array<float>       vwapValues
    array<float>       stdevValues
    array<PeriodLines> history
    PeriodLines        currentPeriod
    label              nameLabel
    array<label>       bandLabels

new_anchor(string name) =>
    VwapAnchor.new(name=name, barTimes=array.new<int>(), vwapValues=array.new<float>(), stdevValues=array.new<float>(), history=array.new<PeriodLines>(), bandLabels=array.new<label>())

// INPUTS — per anchor: main (Show · colour), fill (History · Fill · strength), label (Label · Size), bands

quickFilter = input.string(FILTER_DAILY, "Quick Filter", options=[FILTER_ALL, FILTER_DAILY, FILTER_WEEKLY, FILTER_DAILY_WEEKLY, FILTER_NY, FILTER_DAILY_NY, FILTER_DAILY_WEEKLY_NY, FILTER_DAILY_WEEKLY_MONTHLY, FILTER_MONTHLY, FILTER_MNO, FILTER_DAILY_WEEKLY_MNO, FILTER_DAILY_MNO, FILTER_ROLLING, FILTER_QUARTERLY, FILTER_YEARLY, FILTER_QUARTERLY_YEARLY, FILTER_MONTHLY_QUARTERLY_YEARLY], group=GROUP_GENERAL, tooltip=TOOLTIP_QUICK_FILTER)
vwapLinesOnly = input.bool(false, "VWAP Lines Only", group=GROUP_GENERAL, tooltip=TOOLTIP_VWAP_ONLY)
vwapLabelStar = input.bool(true, "Star on VWAP Labels", group=GROUP_GENERAL, tooltip=TOOLTIP_VWAP_STAR)
showBands = not vwapLinesOnly
vwapLabelPrefix = vwapLabelStar ? PREFIX_VWAP : ""

dailyShow        = input.bool(true, LABEL_ENABLE_DAILY, inline="d", group=GROUP_DAILY)
dailyColor = input.color(DEFAULT_DAILY_COLOR, "", inline="d", group=GROUP_DAILY, tooltip=TOOLTIP_MAIN)
dailyHistory     = input.int(HISTORY_MIN, LABEL_HISTORY, minval=HISTORY_MIN, maxval=HISTORY_MAX, inline="d_fill", group=GROUP_DAILY)
dailyFillRange   = input.string(FILL_RANGE_2_SIGMA, LABEL_FILL, options=[FILL_RANGE_NONE, FILL_RANGE_1_SIGMA, FILL_RANGE_2_SIGMA, FILL_RANGE_3_SIGMA], inline="d_fill", group=GROUP_DAILY)
dailyFillOpacity = input.float(FILL_OPACITY_DAILY_DEFAULT, "", minval=FILL_OPACITY_MIN, maxval=FILL_OPACITY_MAX, step=FILL_OPACITY_STEP, inline="d_fill", group=GROUP_DAILY, tooltip=TOOLTIP_HISTORY_FILL)
dailyBandSide    = input.string(BAND_BOTH, "", options=[BAND_BOTH, BAND_UPPER, BAND_LOWER, BAND_SANDWICH], inline="d_lbl", group=GROUP_DAILY, tooltip=TOOLTIP_BAND_SIDE)
dailyLabels      = input.bool(true, LABEL_LABEL, inline="d_lbl", group=GROUP_DAILY)
dailyLabelSize   = input.string(FONT_TINY, "", options=[FONT_TINY, FONT_SMALL, FONT_NORMAL, FONT_LARGE, FONT_HUGE], inline="d_lbl", group=GROUP_DAILY, tooltip=TOOLTIP_LABELS)
dailyPrices      = input.bool(true, LABEL_PRICE, inline="d_lbl", group=GROUP_DAILY)
dailyVwapWidthChoice = input.string(DEFAULT_VWAP_WIDTH, "", options=["1", "2", "3", "4", "5"], inline="d_bands", group=GROUP_DAILY)
dailyBand1Choice = input.string(DAILY_BAND_1_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="d_bands", group=GROUP_DAILY)
dailyBand2Choice = input.string(DAILY_BAND_2_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="d_bands", group=GROUP_DAILY)
dailyBand3Choice = input.string(DAILY_BAND_3_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="d_bands", group=GROUP_DAILY, tooltip=TOOLTIP_BAND_WIDTH)
dailyHolidayMode = input.bool(true, "Holiday Mode", group=GROUP_DAILY, tooltip="Anchors the Daily VWAP to the 18:00 ET reopen instead of TradingView's daily bar. On CME holidays (e.g. Memorial Day) TradingView merges the shortened session into one 'D' bar, so the Daily VWAP would otherwise not restart at the post-holiday 18:00 reopen — this forces it to.")

weeklyShow        = input.bool(true, LABEL_ENABLE_WEEKLY, inline="w", group=GROUP_WEEKLY)
weeklyColor = input.color(DEFAULT_WEEKLY_COLOR, "", inline="w", group=GROUP_WEEKLY, tooltip=TOOLTIP_MAIN)
weeklyHistory     = input.int(HISTORY_MIN, LABEL_HISTORY, minval=HISTORY_MIN, maxval=HISTORY_MAX, inline="w_fill", group=GROUP_WEEKLY)
weeklyFillRange   = input.string(FILL_RANGE_NONE, LABEL_FILL, options=[FILL_RANGE_NONE, FILL_RANGE_1_SIGMA, FILL_RANGE_2_SIGMA, FILL_RANGE_3_SIGMA], inline="w_fill", group=GROUP_WEEKLY)
weeklyFillOpacity = input.float(FILL_OPACITY_WEEKLY_DEFAULT, "", minval=FILL_OPACITY_MIN, maxval=FILL_OPACITY_MAX, step=FILL_OPACITY_STEP, inline="w_fill", group=GROUP_WEEKLY, tooltip=TOOLTIP_HISTORY_FILL)
weeklyBandSide    = input.string(BAND_BOTH, "", options=[BAND_BOTH, BAND_UPPER, BAND_LOWER, BAND_SANDWICH], inline="w_lbl", group=GROUP_WEEKLY, tooltip=TOOLTIP_BAND_SIDE)
weeklyLabels     = input.bool(true, LABEL_LABEL, inline="w_lbl", group=GROUP_WEEKLY)
weeklyLabelSize   = input.string(FONT_SMALL, "", options=[FONT_TINY, FONT_SMALL, FONT_NORMAL, FONT_LARGE, FONT_HUGE], inline="w_lbl", group=GROUP_WEEKLY, tooltip=TOOLTIP_LABELS)
weeklyPrices      = input.bool(true, LABEL_PRICE, inline="w_lbl", group=GROUP_WEEKLY)
weeklyVwapWidthChoice = input.string(DEFAULT_VWAP_WIDTH, "", options=["1", "2", "3", "4", "5"], inline="w_bands", group=GROUP_WEEKLY)
weeklyBand1Choice = input.string(WEEKLY_BAND_1_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="w_bands", group=GROUP_WEEKLY)
weeklyBand2Choice = input.string(WEEKLY_BAND_2_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="w_bands", group=GROUP_WEEKLY)
weeklyBand3Choice = input.string(WEEKLY_BAND_3_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="w_bands", group=GROUP_WEEKLY, tooltip=TOOLTIP_BAND_WIDTH)

mnoShow        = input.bool(true, LABEL_ENABLE_MNO, inline="mn", group=GROUP_MNO)
mnoColor = input.color(DEFAULT_MNO_COLOR, "", inline="mn", group=GROUP_MNO, tooltip=TOOLTIP_MAIN)
mnoHistory     = input.int(HISTORY_MIN, LABEL_HISTORY, minval=HISTORY_MIN, maxval=HISTORY_MAX, inline="mn_fill", group=GROUP_MNO)
mnoFillRange   = input.string(FILL_RANGE_2_SIGMA, LABEL_FILL, options=[FILL_RANGE_NONE, FILL_RANGE_1_SIGMA, FILL_RANGE_2_SIGMA, FILL_RANGE_3_SIGMA], inline="mn_fill", group=GROUP_MNO)
mnoFillOpacity = input.float(1.0, "", minval=FILL_OPACITY_MIN, maxval=FILL_OPACITY_MAX, step=FILL_OPACITY_STEP, inline="mn_fill", group=GROUP_MNO, tooltip=TOOLTIP_HISTORY_FILL)
mnoBandSide    = input.string(BAND_BOTH, "", options=[BAND_BOTH, BAND_UPPER, BAND_LOWER, BAND_SANDWICH], inline="mn_lbl", group=GROUP_MNO, tooltip=TOOLTIP_BAND_SIDE)
mnoLabels  = input.bool(true, LABEL_LABEL, inline="mn_lbl", group=GROUP_MNO)
mnoLabelSize   = input.string(FONT_TINY, "", options=[FONT_TINY, FONT_SMALL, FONT_NORMAL, FONT_LARGE, FONT_HUGE], inline="mn_lbl", group=GROUP_MNO, tooltip=TOOLTIP_LABELS)
mnoPrices      = input.bool(true, LABEL_PRICE, inline="mn_lbl", group=GROUP_MNO)
mnoVwapWidthChoice = input.string(DEFAULT_VWAP_WIDTH, "", options=["1", "2", "3", "4", "5"], inline="mn_bands", group=GROUP_MNO)
mnoBand1Choice = input.string(BAND_OFF, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="mn_bands", group=GROUP_MNO)
mnoBand2Choice = input.string(MNO_BAND_2_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="mn_bands", group=GROUP_MNO)
mnoBand3Choice = input.string(MNO_BAND_3_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="mn_bands", group=GROUP_MNO, tooltip=TOOLTIP_BAND_WIDTH)

nyShow        = input.bool(true, LABEL_ENABLE_NY, inline="ny", group=GROUP_NY)
nyColor = input.color(DEFAULT_NY_COLOR, "", inline="ny", group=GROUP_NY, tooltip=TOOLTIP_MAIN)
nyExtension   = input.string(EXT_SESSION_ONLY, LABEL_EXTENSION, options=[EXT_SESSION_ONLY, EXT_TO_NEXT_OPEN], group=GROUP_NY, tooltip=TOOLTIP_INTRADAY_EXTENSION)
nyHistory     = input.int(HISTORY_MIN, LABEL_HISTORY, minval=HISTORY_MIN, maxval=HISTORY_MAX, inline="ny_fill", group=GROUP_NY)
nyFillRange   = input.string(FILL_RANGE_2_SIGMA, LABEL_FILL, options=[FILL_RANGE_NONE, FILL_RANGE_1_SIGMA, FILL_RANGE_2_SIGMA, FILL_RANGE_3_SIGMA], inline="ny_fill", group=GROUP_NY)
nyFillOpacity = input.float(FILL_OPACITY_NY_DEFAULT, "", minval=FILL_OPACITY_MIN, maxval=FILL_OPACITY_MAX, step=FILL_OPACITY_STEP, inline="ny_fill", group=GROUP_NY, tooltip=TOOLTIP_HISTORY_FILL)
nyBandSide    = input.string(BAND_BOTH, "", options=[BAND_BOTH, BAND_UPPER, BAND_LOWER, BAND_SANDWICH], inline="ny_lbl", group=GROUP_NY, tooltip=TOOLTIP_BAND_SIDE)
nyLabels         = input.bool(true, LABEL_LABEL, inline="ny_lbl", group=GROUP_NY)
nyLabelSize   = input.string(FONT_TINY, "", options=[FONT_TINY, FONT_SMALL, FONT_NORMAL, FONT_LARGE, FONT_HUGE], inline="ny_lbl", group=GROUP_NY, tooltip=TOOLTIP_LABELS)
nyPrices      = input.bool(true, LABEL_PRICE, inline="ny_lbl", group=GROUP_NY)
nyVwapWidthChoice = input.string(DEFAULT_VWAP_WIDTH, "", options=["1", "2", "3", "4", "5"], inline="ny_bands", group=GROUP_NY)
nyBand1Choice = input.string(DEFAULT_BAND_1_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="ny_bands", group=GROUP_NY)
nyBand2Choice = input.string(DEFAULT_BAND_2_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="ny_bands", group=GROUP_NY)
nyBand3Choice = input.string(DEFAULT_BAND_3_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="ny_bands", group=GROUP_NY, tooltip=TOOLTIP_BAND_WIDTH)

rollingShow        = input.bool(true, LABEL_ENABLE_ROLLING, inline="r", group=GROUP_ROLLING)
rollingColor = input.color(DEFAULT_ROLLING_COLOR, "", inline="r", group=GROUP_ROLLING, tooltip=TOOLTIP_MAIN)
rollingSessions    = input.int(ROLLING_SESSIONS_DEFAULT, "Sessions", minval=ROLLING_SESSIONS_MIN, maxval=ROLLING_SESSIONS_MAX, group=GROUP_ROLLING, tooltip=TOOLTIP_ROLLING_SESSIONS)
rollingFillRange   = input.string(FILL_RANGE_NONE, LABEL_FILL, options=[FILL_RANGE_NONE, FILL_RANGE_1_SIGMA, FILL_RANGE_2_SIGMA, FILL_RANGE_3_SIGMA], inline="r_fill", group=GROUP_ROLLING)
rollingFillOpacity = input.float(FILL_OPACITY_DEFAULT, "", minval=FILL_OPACITY_MIN, maxval=FILL_OPACITY_MAX, step=FILL_OPACITY_STEP, inline="r_fill", group=GROUP_ROLLING, tooltip=TOOLTIP_FILL)
rollingBandSide    = input.string(BAND_BOTH, "", options=[BAND_BOTH, BAND_UPPER, BAND_LOWER, BAND_SANDWICH], inline="r_lbl", group=GROUP_ROLLING, tooltip=TOOLTIP_BAND_SIDE)
rollingLabels  = input.bool(true, LABEL_LABEL, inline="r_lbl", group=GROUP_ROLLING)
rollingLabelSize   = input.string(FONT_TINY, "", options=[FONT_TINY, FONT_SMALL, FONT_NORMAL, FONT_LARGE, FONT_HUGE], inline="r_lbl", group=GROUP_ROLLING, tooltip=TOOLTIP_LABELS)
rollingPrices      = input.bool(true, LABEL_PRICE, inline="r_lbl", group=GROUP_ROLLING)
rollingVwapWidthChoice = input.string(DEFAULT_VWAP_WIDTH, "", options=["1", "2", "3", "4", "5"], inline="r_bands", group=GROUP_ROLLING)
rollingBand1Choice = input.string(ROLLING_BAND_1_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="r_bands", group=GROUP_ROLLING)
rollingBand2Choice = input.string(ROLLING_BAND_2_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="r_bands", group=GROUP_ROLLING)
rollingBand3Choice = input.string(ROLLING_BAND_3_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="r_bands", group=GROUP_ROLLING, tooltip=TOOLTIP_BAND_WIDTH)

monthlyShow        = input.bool(true, LABEL_ENABLE_MONTHLY, inline="m", group=GROUP_MONTHLY)
monthlyColor = input.color(DEFAULT_MONTHLY_COLOR, "", inline="m", group=GROUP_MONTHLY, tooltip=TOOLTIP_MAIN)
