monthlyFillRange   = input.string(FILL_RANGE_1_SIGMA, LABEL_FILL, options=[FILL_RANGE_NONE, FILL_RANGE_1_SIGMA, FILL_RANGE_2_SIGMA, FILL_RANGE_3_SIGMA], inline="m_fill", group=GROUP_MONTHLY)
