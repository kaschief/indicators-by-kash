//@version=6
indicator("elderwand •", overlay=true, max_polylines_count=100)

// Anchored VWAPs drawn as polylines: per-band colour/width, real last-N history,
// gap-safe sessions. Borders are open polylines; the fill is a borderless closed polyline.

// CONSTANTS

const string NAME_DAILY     = "Daily"
const string NAME_WEEKLY    = "Weekly"
const string NAME_MONTHLY   = "Monthly"
const string NAME_NY        = "NY"
const string NAME_OVERNIGHT = "Overnight"

const string TIMEZONE          = "America/New_York"

// Session metadata is centralized so input groups, session detection, and extension cutoffs stay in sync.
const string SESSION_NY             = "0930-1600"
const string SESSION_NY_DISPLAY     = "09:30–16:00"
const int    SESSION_NY_END_HOUR    = 16
const string SESSION_OVERNIGHT      = "1800-0930"
const string SESSION_OVERNIGHT_DISPLAY = "18:00–09:30"
const int    SESSION_OVERNIGHT_START_HOUR = 18
const int    EXT_CUTOFF_CLOSE_HOUR  = SESSION_NY_END_HOUR
const string EXT_CUTOFF_CLOSE_DISPLAY = "16:00"
const int    EXT_CUTOFF_NEXT_OPEN_HOUR = SESSION_OVERNIGHT_START_HOUR
const string EXT_CUTOFF_NEXT_OPEN_DISPLAY = "18:00"

const string GROUP_GENERAL   = "⚡ Quick Filter"
const string GROUP_DAILY     = "☀️ " + NAME_DAILY
const string GROUP_WEEKLY    = "🌊 " + NAME_WEEKLY
const string GROUP_MONTHLY   = "🏔️ " + NAME_MONTHLY
const string GROUP_NY        = "🗽 " + NAME_NY + " · " + SESSION_NY_DISPLAY
const string GROUP_OVERNIGHT = "🌙 " + NAME_OVERNIGHT + " · " + SESSION_OVERNIGHT_DISPLAY
const string GROUP_TABLE     = "🎨 Reference Table"

// Default anchor colours
const color DEFAULT_WEEKLY_COLOR    = color.rgb(41,  98,  255)
const color DEFAULT_DAILY_COLOR     = color.rgb(255, 167, 38)
const color DEFAULT_OVERNIGHT_COLOR = color.rgb(126, 87,  194)
const color DEFAULT_MONTHLY_COLOR   = color.rgb(165, 214, 167)
const color DEFAULT_NY_COLOR        = color.rgb(74,  74,  74)
const int   DEFAULT_BAND_1_SIGMA_TRANSPARENCY = 53
const int   DEFAULT_BAND_2_SIGMA_TRANSPARENCY = 59
const int   DEFAULT_BAND_3_SIGMA_TRANSPARENCY = 18
const int   BAND_1_SIGMA_WIDTH = 1
const int   BAND_2_SIGMA_WIDTH = 2
const int   BAND_3_SIGMA_WIDTH = 2
const int BAND_1_SIGMA = 1
const int BAND_2_SIGMA = 2
const int BAND_3_SIGMA = 3
const int VWAP_WIDTH_DEFAULT = 3
const int VWAP_WIDTH_WEEKLY  = 4

const int HISTORY_MIN         = 1
const int HISTORY_MAX         = 10
const int MAX_POLYLINE_POINTS = 9000
const float FILL_OPACITY_DEFAULT         = 0.5
const float FILL_OPACITY_DAILY_DEFAULT   = 2.5
const float FILL_OPACITY_WEEKLY_DEFAULT  = 3.0
const float FILL_OPACITY_MONTHLY_DEFAULT = 8.0
const float FILL_OPACITY_NY_DEFAULT      = 6.0
const float FILL_OPACITY_MIN       = 0.1
const float FILL_OPACITY_MAX       = 100.0
const float FILL_OPACITY_STEP      = 0.1
const float BAND_LABEL_TEXT_TRANSPARENCY_REDUCTION = 55.0
const float BAND_LABEL_TEXT_TRANSPARENCY_MAX  = 12.0
const int MS_IN_DAY           = 86400000

const string LABEL_ENABLE_DAILY     = "Enable Daily VWAP"
const string LABEL_ENABLE_WEEKLY    = "Enable Weekly VWAP"
const string LABEL_ENABLE_MONTHLY   = "Enable Monthly VWAP"
const string LABEL_ENABLE_NY        = "Enable NY VWAP"
const string LABEL_ENABLE_OVERNIGHT = "Enable Overnight VWAP"
const string LABEL_HISTORY          = "History"
const string LABEL_FILL             = "Fill"
const string LABEL_BAND1            = "1σ"
const string LABEL_BAND2            = "2σ"
const string LABEL_BAND3            = "3σ"
const string LABEL_LABEL            = "Label"
const string LABEL_EXTENSION        = "Extension"
const string PREFIX_VWAP   = "★ "
const string SUFFIX_VWAP   = " VWAP"

const string EXT_SESSION_ONLY = "Session only"
const string EXT_TO_CLOSE     = "To " + EXT_CUTOFF_CLOSE_DISPLAY
const string EXT_TO_NEXT_OPEN = "To " + EXT_CUTOFF_NEXT_OPEN_DISPLAY

// Per-group label font size
const string FONT_TINY   = "Tiny"
const string FONT_SMALL  = "Small"
const string FONT_NORMAL = "Normal"
const string FONT_LARGE  = "Large"
const string FONT_HUGE   = "Huge"

// Per-group σ band sides: both, only above VWAP, or only below
const string LABEL_BAND_SIDE = "σ Bands"
const string BAND_BOTH     = "All"
const string BAND_UPPER    = "Upper Only"
const string BAND_LOWER    = "Lower Only"
const string BAND_SANDWICH = "Sandwich"

const string FILL_RANGE_NONE = "None"
const string FILL_RANGE_1_SIGMA = "1σ to -1σ"
const string FILL_RANGE_2_SIGMA = "2σ to -2σ"
const string FILL_RANGE_3_SIGMA = "3σ to -3σ"
// Quick Filter presets: All respects the per-group toggles; every other preset forces its set of anchors on and the rest off
const string FILTER_ALL                    = "All"
const string FILTER_DAILY                  = "Daily"
const string FILTER_WEEKLY                 = "Weekly"
const string FILTER_DAILY_WEEKLY           = "Work: Daily + Weekly"
const string FILTER_NY                     = "NY"
const string FILTER_DAILY_WEEKLY_NY        = "Prep: Daily + Weekly + NY"
const string FILTER_DAILY_WEEKLY_MONTHLY   = "Daily + Weekly + Monthly"
const string FILTER_MONTHLY                = "Monthly"
const string FILTER_DAILY_NY               = "Daily + NY"
const string FILTER_DAILY_WEEKLY_OVERNIGHT = "Daily + Weekly + Overnight"
const string FILTER_DAILY_OVERNIGHT        = "Daily + Overnight"

const string TOOLTIP_QUICK_FILTER = "Override every per-group Enable toggle to quickly show a preset set of anchors.\n\n• All: Respect individual Enable toggles\n• Daily: Daily only\n• Weekly: Weekly only\n• Daily + Weekly: Daily + Weekly\n• NY: NY only\n• Daily + NY: Daily + NY\n• Daily + Weekly + NY: Daily + Weekly + NY\n• Daily + Weekly + Monthly: Daily + Weekly + Monthly\n• Monthly: Monthly only\n• Daily + Weekly + Overnight: Daily + Weekly + Overnight\n• Daily + Overnight: Daily + Overnight"
const string TOOLTIP_VWAP_ONLY = "Global: hide every σ band (1σ / 2σ / 3σ) and its fill across all anchors, leaving only the VWAP centerlines. Overrides each group's σ Bands choice while on."
const string TOOLTIP_VWAP_STAR = "Prefix every VWAP centerline label with a text star that inherits the line colour (e.g. ★ Daily VWAP). Off = plain label (Daily VWAP). Does not affect σ band tags."
const string TOOLTIP_BAND_SIDE = "Which σ bands to show for this group: All, Upper Only (above VWAP), Lower Only (below VWAP), or Sandwich (both sides, 1σ + 2σ only — drops the outer 3σ). Affects this group's band lines and tags; the centerline always stays. The global VWAP Lines Only overrides this and hides all bands."
const string TOOLTIP_MAIN   = "Show this VWAP · colour. Auto-hides once the chart timeframe reaches the anchor period."
const string TOOLTIP_HISTORY_FILL = "History: 1 = current only, N = current + N−1 past. Fill: None disables fill; each σ choice fills exactly that band range. The number beside Fill controls fill strength from 0.1–100."
const string TOOLTIP_INTRADAY_EXTENSION = "Controls how long this intraday VWAP continues plotting after its session ends, using New York time."
const string TOOLTIP_LABELS = "Label toggles all labels for this group: VWAP plus every enabled σ band. Size sets the tag font."

// TYPES — one anchored VWAP: its config, its current-period point buffer, and its retained history

type PeriodLines
    array<polyline> polylines

type VwapAnchor
    string name
    color  lineColor
    int    lineWidth
    int    historyDepth
    float  fillOpacity
    string fillRange
    bool   band1Enabled
    color  band1Color
    int    band1Width
    bool   band2Enabled
    color  band2Color
    int    band2Width
    bool   band3Enabled
    color  band3Color
    int    band3Width
    bool   labelsEnabled
    string labelSize
    bool   showUpper
    bool   showLower
    bool   visible
    array<int>         barTimes
    array<float>       vwapValues
    array<float>       stdevValues
    array<PeriodLines> history
    PeriodLines        currentPeriod
    label              nameLabel
    array<label>       bandLabels

new_anchor(string name) =>
    VwapAnchor.new(name=name, barTimes=array.new<int>(), vwapValues=array.new<float>(), stdevValues=array.new<float>(), history=array.new<PeriodLines>(), bandLabels=array.new<label>())

// INPUTS — per anchor: main row (Show · colour), fill row (History · Fill · strength), label row (Label · Size), then one row per band

quickFilter = input.string(FILTER_DAILY, "Quick Filter", options=[FILTER_ALL, FILTER_DAILY, FILTER_WEEKLY, FILTER_DAILY_WEEKLY, FILTER_NY, FILTER_DAILY_NY, FILTER_DAILY_WEEKLY_NY, FILTER_DAILY_WEEKLY_MONTHLY, FILTER_MONTHLY, FILTER_DAILY_WEEKLY_OVERNIGHT, FILTER_DAILY_OVERNIGHT], group=GROUP_GENERAL, tooltip=TOOLTIP_QUICK_FILTER)
vwapLinesOnly = input.bool(false, "VWAP Lines Only", group=GROUP_GENERAL, tooltip=TOOLTIP_VWAP_ONLY)
vwapLabelStar = input.bool(true, "Star on VWAP Labels", group=GROUP_GENERAL, tooltip=TOOLTIP_VWAP_STAR)
showBands = not vwapLinesOnly
vwapLabelPrefix = vwapLabelStar ? PREFIX_VWAP : ""

dailyShow        = input.bool(true, LABEL_ENABLE_DAILY, inline="d", group=GROUP_DAILY)
dailyColor = input.color(DEFAULT_DAILY_COLOR, "", inline="d", group=GROUP_DAILY, tooltip=TOOLTIP_MAIN)
dailyHistory     = input.int(HISTORY_MIN, LABEL_HISTORY, minval=HISTORY_MIN, maxval=HISTORY_MAX, inline="d_fill", group=GROUP_DAILY)
dailyFillRange   = input.string(FILL_RANGE_2_SIGMA, LABEL_FILL, options=[FILL_RANGE_NONE, FILL_RANGE_1_SIGMA, FILL_RANGE_2_SIGMA, FILL_RANGE_3_SIGMA], inline="d_fill", group=GROUP_DAILY)
dailyFillOpacity = input.float(FILL_OPACITY_DAILY_DEFAULT, "", minval=FILL_OPACITY_MIN, maxval=FILL_OPACITY_MAX, step=FILL_OPACITY_STEP, inline="d_fill", group=GROUP_DAILY, tooltip=TOOLTIP_HISTORY_FILL)
dailyLabels      = input.bool(true, LABEL_LABEL, inline="d_lbl", group=GROUP_DAILY)
dailyLabelSize   = input.string(FONT_TINY, "", options=[FONT_TINY, FONT_SMALL, FONT_NORMAL, FONT_LARGE, FONT_HUGE], inline="d_lbl", group=GROUP_DAILY, tooltip=TOOLTIP_LABELS)
dailyBandSide    = input.string(BAND_BOTH, LABEL_BAND_SIDE, options=[BAND_BOTH, BAND_UPPER, BAND_LOWER, BAND_SANDWICH], inline="d_bands", group=GROUP_DAILY)
dailyBand1       = input.bool(true,  LABEL_BAND1, inline="d_bands", group=GROUP_DAILY)
dailyBand2       = input.bool(true,  LABEL_BAND2, inline="d_bands", group=GROUP_DAILY)
dailyBand3       = input.bool(true,  LABEL_BAND3, inline="d_bands", group=GROUP_DAILY, tooltip=TOOLTIP_BAND_SIDE)

weeklyShow        = input.bool(true, LABEL_ENABLE_WEEKLY, inline="w", group=GROUP_WEEKLY)
weeklyColor = input.color(DEFAULT_WEEKLY_COLOR, "", inline="w", group=GROUP_WEEKLY, tooltip=TOOLTIP_MAIN)
weeklyHistory     = input.int(HISTORY_MIN, LABEL_HISTORY, minval=HISTORY_MIN, maxval=HISTORY_MAX, inline="w_fill", group=GROUP_WEEKLY)
weeklyFillRange   = input.string(FILL_RANGE_2_SIGMA, LABEL_FILL, options=[FILL_RANGE_NONE, FILL_RANGE_1_SIGMA, FILL_RANGE_2_SIGMA, FILL_RANGE_3_SIGMA], inline="w_fill", group=GROUP_WEEKLY)
weeklyFillOpacity = input.float(FILL_OPACITY_WEEKLY_DEFAULT, "", minval=FILL_OPACITY_MIN, maxval=FILL_OPACITY_MAX, step=FILL_OPACITY_STEP, inline="w_fill", group=GROUP_WEEKLY, tooltip=TOOLTIP_HISTORY_FILL)
weeklyLabels     = input.bool(true, LABEL_LABEL, inline="w_lbl", group=GROUP_WEEKLY)
weeklyLabelSize   = input.string(FONT_SMALL, "", options=[FONT_TINY, FONT_SMALL, FONT_NORMAL, FONT_LARGE, FONT_HUGE], inline="w_lbl", group=GROUP_WEEKLY, tooltip=TOOLTIP_LABELS)
weeklyBandSide    = input.string(BAND_BOTH, LABEL_BAND_SIDE, options=[BAND_BOTH, BAND_UPPER, BAND_LOWER, BAND_SANDWICH], inline="w_bands", group=GROUP_WEEKLY)
weeklyBand1       = input.bool(true,  LABEL_BAND1, inline="w_bands", group=GROUP_WEEKLY)
weeklyBand2       = input.bool(true,  LABEL_BAND2, inline="w_bands", group=GROUP_WEEKLY)
weeklyBand3       = input.bool(true,  LABEL_BAND3, inline="w_bands", group=GROUP_WEEKLY, tooltip=TOOLTIP_BAND_SIDE)

nyShow        = input.bool(true, LABEL_ENABLE_NY, inline="ny", group=GROUP_NY)
nyColor = input.color(DEFAULT_NY_COLOR, "", inline="ny", group=GROUP_NY, tooltip=TOOLTIP_MAIN)
nyExtension   = input.string(EXT_SESSION_ONLY, LABEL_EXTENSION, options=[EXT_SESSION_ONLY, EXT_TO_NEXT_OPEN], group=GROUP_NY, tooltip=TOOLTIP_INTRADAY_EXTENSION)
nyHistory     = input.int(HISTORY_MIN, LABEL_HISTORY, minval=HISTORY_MIN, maxval=HISTORY_MAX, inline="ny_fill", group=GROUP_NY)
nyFillRange   = input.string(FILL_RANGE_2_SIGMA, LABEL_FILL, options=[FILL_RANGE_NONE, FILL_RANGE_1_SIGMA, FILL_RANGE_2_SIGMA, FILL_RANGE_3_SIGMA], inline="ny_fill", group=GROUP_NY)
nyFillOpacity = input.float(FILL_OPACITY_NY_DEFAULT, "", minval=FILL_OPACITY_MIN, maxval=FILL_OPACITY_MAX, step=FILL_OPACITY_STEP, inline="ny_fill", group=GROUP_NY, tooltip=TOOLTIP_HISTORY_FILL)
nyLabels         = input.bool(true, LABEL_LABEL, inline="ny_lbl", group=GROUP_NY)
nyLabelSize   = input.string(FONT_TINY, "", options=[FONT_TINY, FONT_SMALL, FONT_NORMAL, FONT_LARGE, FONT_HUGE], inline="ny_lbl", group=GROUP_NY, tooltip=TOOLTIP_LABELS)
nyBandSide    = input.string(BAND_BOTH, LABEL_BAND_SIDE, options=[BAND_BOTH, BAND_UPPER, BAND_LOWER, BAND_SANDWICH], inline="ny_bands", group=GROUP_NY)
nyBand1       = input.bool(true,  LABEL_BAND1, inline="ny_bands", group=GROUP_NY)
nyBand2       = input.bool(true,  LABEL_BAND2, inline="ny_bands", group=GROUP_NY)
nyBand3       = input.bool(true,  LABEL_BAND3, inline="ny_bands", group=GROUP_NY, tooltip=TOOLTIP_BAND_SIDE)

overnightShow        = input.bool(true, LABEL_ENABLE_OVERNIGHT, inline="on", group=GROUP_OVERNIGHT)
overnightColor = input.color(DEFAULT_OVERNIGHT_COLOR, "", inline="on", group=GROUP_OVERNIGHT, tooltip=TOOLTIP_MAIN)
overnightExtension   = input.string(EXT_SESSION_ONLY, LABEL_EXTENSION, options=[EXT_SESSION_ONLY, EXT_TO_CLOSE, EXT_TO_NEXT_OPEN], group=GROUP_OVERNIGHT, tooltip=TOOLTIP_INTRADAY_EXTENSION)
overnightHistory     = input.int(HISTORY_MIN, LABEL_HISTORY, minval=HISTORY_MIN, maxval=HISTORY_MAX, inline="on_fill", group=GROUP_OVERNIGHT)
overnightFillRange   = input.string(FILL_RANGE_NONE, LABEL_FILL, options=[FILL_RANGE_NONE, FILL_RANGE_1_SIGMA, FILL_RANGE_2_SIGMA, FILL_RANGE_3_SIGMA], inline="on_fill", group=GROUP_OVERNIGHT)
overnightFillOpacity = input.float(FILL_OPACITY_DEFAULT, "", minval=FILL_OPACITY_MIN, maxval=FILL_OPACITY_MAX, step=FILL_OPACITY_STEP, inline="on_fill", group=GROUP_OVERNIGHT, tooltip=TOOLTIP_HISTORY_FILL)
overnightLabels  = input.bool(true, LABEL_LABEL, inline="on_lbl", group=GROUP_OVERNIGHT)
overnightLabelSize   = input.string(FONT_TINY, "", options=[FONT_TINY, FONT_SMALL, FONT_NORMAL, FONT_LARGE, FONT_HUGE], inline="on_lbl", group=GROUP_OVERNIGHT, tooltip=TOOLTIP_LABELS)
overnightBandSide    = input.string(BAND_BOTH, LABEL_BAND_SIDE, options=[BAND_BOTH, BAND_UPPER, BAND_LOWER, BAND_SANDWICH], inline="on_bands", group=GROUP_OVERNIGHT)
overnightBand1       = input.bool(true,  LABEL_BAND1, inline="on_bands", group=GROUP_OVERNIGHT)
overnightBand2       = input.bool(true,  LABEL_BAND2, inline="on_bands", group=GROUP_OVERNIGHT)
overnightBand3       = input.bool(true,  LABEL_BAND3, inline="on_bands", group=GROUP_OVERNIGHT, tooltip=TOOLTIP_BAND_SIDE)

monthlyShow        = input.bool(true, LABEL_ENABLE_MONTHLY, inline="m", group=GROUP_MONTHLY)
monthlyColor = input.color(DEFAULT_MONTHLY_COLOR, "", inline="m", group=GROUP_MONTHLY, tooltip=TOOLTIP_MAIN)
monthlyHistory     = input.int(HISTORY_MIN, LABEL_HISTORY, minval=HISTORY_MIN, maxval=HISTORY_MAX, inline="m_fill", group=GROUP_MONTHLY)
monthlyFillRange   = input.string(FILL_RANGE_1_SIGMA, LABEL_FILL, options=[FILL_RANGE_NONE, FILL_RANGE_1_SIGMA, FILL_RANGE_2_SIGMA, FILL_RANGE_3_SIGMA], inline="m_fill", group=GROUP_MONTHLY)
monthlyFillOpacity = input.float(FILL_OPACITY_MONTHLY_DEFAULT, "", minval=FILL_OPACITY_MIN, maxval=FILL_OPACITY_MAX, step=FILL_OPACITY_STEP, inline="m_fill", group=GROUP_MONTHLY, tooltip=TOOLTIP_HISTORY_FILL)
monthlyLabels    = input.bool(true, LABEL_LABEL, inline="m_lbl", group=GROUP_MONTHLY)
monthlyLabelSize   = input.string(FONT_NORMAL, "", options=[FONT_TINY, FONT_SMALL, FONT_NORMAL, FONT_LARGE, FONT_HUGE], inline="m_lbl", group=GROUP_MONTHLY, tooltip=TOOLTIP_LABELS)
monthlyBandSide    = input.string(BAND_BOTH, LABEL_BAND_SIDE, options=[BAND_BOTH, BAND_UPPER, BAND_LOWER, BAND_SANDWICH], inline="m_bands", group=GROUP_MONTHLY)
monthlyBand1       = input.bool(true,  LABEL_BAND1, inline="m_bands", group=GROUP_MONTHLY)
monthlyBand2       = input.bool(true,  LABEL_BAND2, inline="m_bands", group=GROUP_MONTHLY)
monthlyBand3       = input.bool(true,  LABEL_BAND3, inline="m_bands", group=GROUP_MONTHLY, tooltip=TOOLTIP_BAND_SIDE)

showTable = input.bool(false, "Show Reference Table", group=GROUP_TABLE)

// VOLUME GUARD

cumulativeVolume = ta.cum(volume)
if barstate.islast and cumulativeVolume == 0
    runtime.error("No volume is provided by the data vendor.")

// ANCHOR SIGNALS — stateful built-ins run every bar at a fixed call site

dayChange   = timeframe.change("D")
weekChange  = timeframe.change("W")
monthChange = timeframe.change("M")
inNYSession        = not na(time(timeframe.period, SESSION_NY, TIMEZONE))
inOvernightSession = not na(time(timeframe.period, SESSION_OVERNIGHT, TIMEZONE))
nyOpen        = inNYSession and not inNYSession[1]
overnightOpen = inOvernightSession and not inOvernightSession[1]

chartSecs    = timeframe.in_seconds(timeframe.period)
secsPerDay   = timeframe.in_seconds("1D")
secsPerWeek  = timeframe.in_seconds("1W")
secsPerMonth = timeframe.in_seconds("1M")

extension_cutoff(string extension, int openedAt) =>
    int cutoff = na
    if extension != EXT_SESSION_ONLY
        int cutoffHour = extension == EXT_TO_CLOSE ? EXT_CUTOFF_CLOSE_HOUR : EXT_CUTOFF_NEXT_OPEN_HOUR
        cutoff := timestamp(TIMEZONE, year(openedAt, TIMEZONE), month(openedAt, TIMEZONE), dayofmonth(openedAt, TIMEZONE), cutoffHour, 0)
        if cutoff <= openedAt
            cutoff += MS_IN_DAY
    cutoff

within_extension(int cutoff) =>
    not na(cutoff) and time <= cutoff

var int nyExtensionCutoff = na
var int overnightExtensionCutoff = na
if nyOpen
    nyExtensionCutoff := extension_cutoff(nyExtension, time)
if overnightOpen
    overnightExtensionCutoff := extension_cutoff(overnightExtension, time)

// VWAP ENGINE — each anchor's ta.vwap needs its own fixed call site to keep an independent accumulator

vwap_daily() =>
    bool reset = dayChange or na(hlc3[1])
    [value, upperBand, _] = ta.vwap(hlc3, reset, 1)
    [value, upperBand - value]
vwap_weekly() =>
    bool reset = weekChange or na(hlc3[1])
    [value, upperBand, _] = ta.vwap(hlc3, reset, 1)
    [value, upperBand - value]
vwap_monthly() =>
    bool reset = monthChange or na(hlc3[1])
    [value, upperBand, _] = ta.vwap(hlc3, reset, 1)
    [value, upperBand - value]
vwap_ny() =>
    bool reset = nyOpen or na(hlc3[1])
    [value, upperBand, _] = ta.vwap(hlc3, reset, 1)
    [value, upperBand - value]
vwap_overnight() =>
    bool reset = overnightOpen or na(hlc3[1])
    [value, upperBand, _] = ta.vwap(hlc3, reset, 1)
    [value, upperBand - value]
[dailyVwap,     dailyStdev]     = vwap_daily()
[weeklyVwap,    weeklyStdev]    = vwap_weekly()
[monthlyVwap,   monthlyStdev]   = vwap_monthly()
[nyVwap,        nyStdev]        = vwap_ny()
[overnightVwap, overnightStdev] = vwap_overnight()

// RENDER HELPERS — subsample with a stride so no polyline exceeds the 10,000-point limit

point_stride(int pointCount, int maxPoints) =>
    math.max(int(math.ceil(pointCount / float(maxPoints))), 1)

build_offset_line(array<int> barTimes, array<float> vwapValues, array<float> stdevValues, float deviations, color lineColor, int lineWidth) =>
    int count = array.size(barTimes)
    int stride = point_stride(count, MAX_POLYLINE_POINTS)
    points = array.new<chart.point>()
    int i = 0
    while i < count
        array.push(points, chart.point.from_time(array.get(barTimes, i), array.get(vwapValues, i) + deviations * array.get(stdevValues, i)))
        i += stride
    if (count - 1) % stride != 0
        array.push(points, chart.point.from_time(array.get(barTimes, count - 1), array.get(vwapValues, count - 1) + deviations * array.get(stdevValues, count - 1)))
    polyline.new(points, closed=false, xloc=xloc.bar_time, line_color=lineColor, line_width=lineWidth)

// Fills between the upper edge (upperDev·σ, traced forward) and lower edge (lowerDev·σ, traced back).
// Either edge can be 0 (the VWAP centerline) so a hidden side clips the fill to the visible half.
build_fill_band(array<int> barTimes, array<float> vwapValues, array<float> stdevValues, float upperDev, float lowerDev, color bandColor, float transparency) =>
    int count = array.size(barTimes)
    int stride = point_stride(count, MAX_POLYLINE_POINTS / 2)
    sampleIndices = array.new<int>()
    int i = 0
    while i < count
        array.push(sampleIndices, i)
        i += stride
    if array.last(sampleIndices) != count - 1
        array.push(sampleIndices, count - 1)
    points = array.new<chart.point>()
    for j = 0 to array.size(sampleIndices) - 1
        int bar = array.get(sampleIndices, j)
        array.push(points, chart.point.from_time(array.get(barTimes, bar), array.get(vwapValues, bar) + upperDev * array.get(stdevValues, bar)))
    for j = array.size(sampleIndices) - 1 to 0
        int bar = array.get(sampleIndices, j)
        array.push(points, chart.point.from_time(array.get(barTimes, bar), array.get(vwapValues, bar) + lowerDev * array.get(stdevValues, bar)))
    polyline.new(points, closed=true, xloc=xloc.bar_time, line_color=na, fill_color=color.new(bandColor, transparency))

add_band(PeriodLines period, VwapAnchor anchor, bool lineEnabled, bool fillEnabled, float deviations, color bandColor, int bandWidth) =>
    if lineEnabled
        if anchor.showUpper
            array.push(period.polylines, build_offset_line(anchor.barTimes, anchor.vwapValues, anchor.stdevValues,  deviations, bandColor, bandWidth))
        if anchor.showLower
            array.push(period.polylines, build_offset_line(anchor.barTimes, anchor.vwapValues, anchor.stdevValues, -deviations, bandColor, bandWidth))
    if fillEnabled
        float upperDev = anchor.showUpper ? deviations : 0.0
        float lowerDev = anchor.showLower ? -deviations : 0.0
        array.push(period.polylines, build_fill_band(anchor.barTimes, anchor.vwapValues, anchor.stdevValues, upperDev, lowerDev, bandColor, 100 - anchor.fillOpacity))

build_period(VwapAnchor anchor) =>
    PeriodLines period = PeriodLines.new(array.new<polyline>())
    array.push(period.polylines, build_offset_line(anchor.barTimes, anchor.vwapValues, anchor.stdevValues, 0, anchor.lineColor, anchor.lineWidth))
    add_band(period, anchor, anchor.band1Enabled and showBands, showBands and anchor.fillRange == FILL_RANGE_1_SIGMA, BAND_1_SIGMA, anchor.band1Color, anchor.band1Width)
    add_band(period, anchor, anchor.band2Enabled and showBands, showBands and anchor.fillRange == FILL_RANGE_2_SIGMA, BAND_2_SIGMA, anchor.band2Color, anchor.band2Width)
    add_band(period, anchor, anchor.band3Enabled and showBands, showBands and anchor.fillRange == FILL_RANGE_3_SIGMA, BAND_3_SIGMA, anchor.band3Color, anchor.band3Width)
    period

delete_period(PeriodLines period) =>
    for line in period.polylines
        polyline.delete(line)

// Archive the just-completed period into history and trim to the retained depth (current period is drawn live)

archive_period(VwapAnchor anchor) =>
    if array.size(anchor.barTimes) >= 2
        array.push(anchor.history, build_period(anchor))
        while array.size(anchor.history) > anchor.historyDepth - 1
            delete_period(array.shift(anchor.history))
    array.clear(anchor.barTimes)
    array.clear(anchor.vwapValues)
    array.clear(anchor.stdevValues)

// `shown` keeps the line drawn (incl. a finished session); `accumulating` adds new points (sessions only build inside their window)
update_anchor(VwapAnchor anchor, bool shown, bool accumulating, bool isNewPeriod, float vwapValue, float stdevValue) =>
    anchor.visible := shown
    if isNewPeriod
        archive_period(anchor)
    if accumulating and not na(vwapValue) and not na(stdevValue)
        array.push(anchor.barTimes, time)
        array.push(anchor.vwapValues, vwapValue)
        array.push(anchor.stdevValues, stdevValue)

// LABEL HELPERS — one shared line tag; the VWAP label and every band tag use the same discreet style

label_font_size(string fontSize) =>
    switch fontSize
        FONT_SMALL  => size.small
        FONT_NORMAL => size.normal
        FONT_LARGE  => size.large
        FONT_HUGE   => size.huge
        => size.tiny

band_label_text_color(color bandLineColor) =>
    color.new(bandLineColor, math.min(BAND_LABEL_TEXT_TRANSPARENCY_MAX, math.max(0.0, color.t(bandLineColor) - BAND_LABEL_TEXT_TRANSPARENCY_REDUCTION)))

new_line_label(int barTime, float price, string labelText, color textColor, string labelSize) =>
    label.new(barTime, price, labelText, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, textcolor=textColor, size=labelSize, color=color.new(color.white, 100))

new_band_line_label(int barTime, float price, string labelText, color bandLineColor, string labelSize) =>
    new_line_label(barTime, price, labelText, band_label_text_color(bandLineColor), labelSize)

// Tag a band's upper and lower line at the latest point, tinted to match the band line
add_band_labels(VwapAnchor anchor, bool show, float multiplier, color bandColor) =>
    if show
        int   barTime    = array.last(anchor.barTimes)
        float vwapValue  = array.last(anchor.vwapValues)
        float stdevValue = array.last(anchor.stdevValues)
        string labelText = anchor.name + " " + str.tostring(multiplier) + "σ"
        if anchor.showUpper
            array.push(anchor.bandLabels, new_band_line_label(barTime, vwapValue + multiplier * stdevValue, labelText, bandColor, anchor.labelSize))
        if anchor.showLower
            array.push(anchor.bandLabels, new_band_line_label(barTime, vwapValue - multiplier * stdevValue, labelText, bandColor, anchor.labelSize))

// Redraw the live current period, its name label, and (when set to All) every enabled σ band tag

draw_current_period(VwapAnchor anchor) =>
    if not na(anchor.currentPeriod)
        delete_period(anchor.currentPeriod)
    label.delete(anchor.nameLabel)
    for bandLabel in anchor.bandLabels
        label.delete(bandLabel)
    array.clear(anchor.bandLabels)
    anchor.currentPeriod := na
    if anchor.visible and array.size(anchor.barTimes) >= 2
        anchor.currentPeriod := build_period(anchor)
        if anchor.labelsEnabled
            anchor.nameLabel := new_line_label(array.last(anchor.barTimes), array.last(anchor.vwapValues), vwapLabelPrefix + anchor.name + SUFFIX_VWAP, anchor.lineColor, anchor.labelSize)
            add_band_labels(anchor, anchor.band1Enabled and showBands, BAND_1_SIGMA, anchor.band1Color)
            add_band_labels(anchor, anchor.band2Enabled and showBands, BAND_2_SIGMA, anchor.band2Color)
            add_band_labels(anchor, anchor.band3Enabled and showBands, BAND_3_SIGMA, anchor.band3Color)

// ANCHORS — one instance each; config copied from inputs every bar, then computed and drawn

var VwapAnchor daily     = new_anchor(NAME_DAILY)
var VwapAnchor weekly    = new_anchor(NAME_WEEKLY)
var VwapAnchor monthly   = new_anchor(NAME_MONTHLY)
var VwapAnchor ny        = new_anchor(NAME_NY)
var VwapAnchor overnight = new_anchor(NAME_OVERNIGHT)

daily.historyDepth := dailyHistory
daily.fillOpacity := dailyFillOpacity
daily.fillRange := dailyFillRange
daily.labelsEnabled := dailyLabels
daily.labelSize := label_font_size(dailyLabelSize)
daily.showUpper := dailyBandSide != BAND_LOWER
daily.showLower := dailyBandSide != BAND_UPPER
daily.band1Enabled := dailyBand1
daily.band2Enabled := dailyBand2
daily.band3Enabled := dailyBand3 and dailyBandSide != BAND_SANDWICH

weekly.historyDepth := weeklyHistory
weekly.fillOpacity := weeklyFillOpacity
weekly.fillRange := weeklyFillRange
weekly.labelsEnabled := weeklyLabels
weekly.labelSize := label_font_size(weeklyLabelSize)
weekly.showUpper := weeklyBandSide != BAND_LOWER
weekly.showLower := weeklyBandSide != BAND_UPPER
weekly.band1Enabled := weeklyBand1
weekly.band2Enabled := weeklyBand2
weekly.band3Enabled := weeklyBand3 and weeklyBandSide != BAND_SANDWICH

monthly.historyDepth := monthlyHistory
monthly.fillOpacity := monthlyFillOpacity
monthly.fillRange := monthlyFillRange
monthly.labelsEnabled := monthlyLabels
monthly.labelSize := label_font_size(monthlyLabelSize)
monthly.showUpper := monthlyBandSide != BAND_LOWER
monthly.showLower := monthlyBandSide != BAND_UPPER
monthly.band1Enabled := monthlyBand1
monthly.band2Enabled := monthlyBand2
monthly.band3Enabled := monthlyBand3 and monthlyBandSide != BAND_SANDWICH

ny.historyDepth := nyHistory
ny.fillOpacity := nyFillOpacity
ny.fillRange := nyFillRange
ny.labelsEnabled := nyLabels
ny.labelSize := label_font_size(nyLabelSize)
ny.showUpper := nyBandSide != BAND_LOWER
ny.showLower := nyBandSide != BAND_UPPER
ny.band1Enabled := nyBand1
ny.band2Enabled := nyBand2
ny.band3Enabled := nyBand3 and nyBandSide != BAND_SANDWICH

overnight.historyDepth := overnightHistory
overnight.fillOpacity := overnightFillOpacity
overnight.fillRange := overnightFillRange
overnight.labelsEnabled := overnightLabels
overnight.labelSize := label_font_size(overnightLabelSize)
overnight.showUpper := overnightBandSide != BAND_LOWER
overnight.showLower := overnightBandSide != BAND_UPPER
overnight.band1Enabled := overnightBand1
overnight.band2Enabled := overnightBand2
overnight.band3Enabled := overnightBand3 and overnightBandSide != BAND_SANDWICH

// 1σ and 2σ stay recessed (high transparency); 3σ is the dominant outer level (low transparency).
band_transparency_for_multiplier(float multiplier) =>
    multiplier >= BAND_3_SIGMA ? DEFAULT_BAND_3_SIGMA_TRANSPARENCY : multiplier >= BAND_2_SIGMA ? DEFAULT_BAND_2_SIGMA_TRANSPARENCY : DEFAULT_BAND_1_SIGMA_TRANSPARENCY

// Width separates 2σ/3σ from 1σ; transparency makes 3σ read strongest.
band_width_for_multiplier(float multiplier) =>
    multiplier >= BAND_3_SIGMA ? BAND_3_SIGMA_WIDTH : multiplier >= BAND_2_SIGMA ? BAND_2_SIGMA_WIDTH : BAND_1_SIGMA_WIDTH

// ANCHOR STYLE — the centerline carries the group's identity: full-saturation colour plus the width tier.
// Bands share the colour at increasing transparency; 3σ breaks that pattern to read as the dominant outer level.
apply_anchor_style(VwapAnchor anchor, color anchorColor, int width) =>
    anchor.lineColor := anchorColor
    anchor.lineWidth := width
    anchor.band1Color := color.new(anchorColor, band_transparency_for_multiplier(BAND_1_SIGMA))
    anchor.band2Color := color.new(anchorColor, band_transparency_for_multiplier(BAND_2_SIGMA))
    anchor.band3Color := color.new(anchorColor, band_transparency_for_multiplier(BAND_3_SIGMA))
    anchor.band1Width := band_width_for_multiplier(BAND_1_SIGMA)
    anchor.band2Width := band_width_for_multiplier(BAND_2_SIGMA)
    anchor.band3Width := band_width_for_multiplier(BAND_3_SIGMA)

apply_anchor_style(daily,        dailyColor,     VWAP_WIDTH_DEFAULT)
apply_anchor_style(weekly,       weeklyColor,    VWAP_WIDTH_WEEKLY)
apply_anchor_style(monthly,      monthlyColor,   VWAP_WIDTH_DEFAULT)
apply_anchor_style(ny,           nyColor,        VWAP_WIDTH_DEFAULT)
apply_anchor_style(overnight,    overnightColor, VWAP_WIDTH_DEFAULT)

// QUICK FILTER — resolve each anchor's effective enable: All respects the per-group toggle; every other preset forces its set on and the rest off

in_quick_filter(string name) =>
    switch quickFilter
        FILTER_DAILY                  => name == NAME_DAILY
        FILTER_WEEKLY                 => name == NAME_WEEKLY
        FILTER_DAILY_WEEKLY           => name == NAME_DAILY or name == NAME_WEEKLY
        FILTER_NY                     => name == NAME_NY
        FILTER_DAILY_NY               => name == NAME_DAILY or name == NAME_NY
        FILTER_DAILY_WEEKLY_NY        => name == NAME_DAILY or name == NAME_WEEKLY or name == NAME_NY
        FILTER_DAILY_WEEKLY_MONTHLY   => name == NAME_DAILY or name == NAME_WEEKLY or name == NAME_MONTHLY
        FILTER_MONTHLY                => name == NAME_MONTHLY
        FILTER_DAILY_WEEKLY_OVERNIGHT => name == NAME_DAILY or name == NAME_WEEKLY or name == NAME_OVERNIGHT
        FILTER_DAILY_OVERNIGHT        => name == NAME_DAILY or name == NAME_OVERNIGHT
        => false

filter_enabled(string name, bool individualShow) =>
    quickFilter == FILTER_ALL ? individualShow : in_quick_filter(name)

dailyEnabled        = filter_enabled(NAME_DAILY,         dailyShow)
weeklyEnabled       = filter_enabled(NAME_WEEKLY,        weeklyShow)
monthlyEnabled      = filter_enabled(NAME_MONTHLY,       monthlyShow)
nyEnabled           = filter_enabled(NAME_NY,            nyShow)
overnightEnabled    = filter_enabled(NAME_OVERNIGHT,     overnightShow)

dailyShown     = dailyEnabled     and chartSecs < secsPerDay
weeklyShown    = weeklyEnabled    and chartSecs < secsPerWeek
monthlyShown   = monthlyEnabled   and chartSecs < secsPerMonth
nyShown        = nyEnabled        and chartSecs < secsPerDay
overnightShown = overnightEnabled and chartSecs < secsPerDay
nyAccumulating = nyShown and (inNYSession or within_extension(nyExtensionCutoff))
overnightAccumulating = overnightShown and (inOvernightSession or within_extension(overnightExtensionCutoff))

update_anchor(daily,     dailyShown,     dailyShown,                            dayChange,     dailyVwap,     dailyStdev)
update_anchor(weekly,    weeklyShown,    weeklyShown,                           weekChange,    weeklyVwap,    weeklyStdev)
update_anchor(monthly,   monthlyShown,   monthlyShown,                          monthChange,   monthlyVwap,   monthlyStdev)
update_anchor(ny,        nyShown,        nyAccumulating,                        nyOpen,        nyVwap,        nyStdev)
update_anchor(overnight, overnightShown, overnightAccumulating,                 overnightOpen, overnightVwap, overnightStdev)

if barstate.islast
    draw_current_period(daily)
    draw_current_period(weekly)
    draw_current_period(monthly)
    draw_current_period(ny)
    draw_current_period(overnight)

// REFERENCE TABLE — one row per active line/band: colour (RGB + transparency) and width.
// count_visible_rows and add_anchor_rows MUST use identical inclusion predicates or the table overflows.

add_ref_row(table tbl, int row, string label, color clr, int width, string fillRange, string fillOpacity) =>
    table.cell(tbl, 0, row, label, text_size=size.small, text_color=color.black)
    table.cell(tbl, 1, row, str.format("R:{0} G:{1} B:{2}", int(color.r(clr)), int(color.g(clr)), int(color.b(clr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 2, row, str.tostring(int(color.t(clr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 3, row, str.tostring(width), text_size=size.small, text_color=color.black)
    table.cell(tbl, 4, row, fillRange, text_size=size.small, text_color=color.black)
    table.cell(tbl, 5, row, fillOpacity, text_size=size.small, text_color=color.black)

add_ref_row_if(table tbl, int row, bool include, string label, color clr, int width, string fillRange, string fillOpacity) =>
    int nextRow = row
    if include
        add_ref_row(tbl, row, label, clr, width, fillRange, fillOpacity)
        nextRow := row + 1
    nextRow

count_visible_rows(bool show, VwapAnchor anchor) =>
    (show ? 1 : 0) + (show and anchor.band1Enabled and showBands ? 1 : 0) + (show and anchor.band2Enabled and showBands ? 1 : 0) + (show and anchor.band3Enabled and showBands ? 1 : 0)

add_anchor_rows(table tbl, int row, string name, bool show, VwapAnchor anchor) =>
    int r = row
    r := add_ref_row_if(tbl, r, show,                                      name + SUFFIX_VWAP, anchor.lineColor,   anchor.lineWidth, anchor.fillRange, str.tostring(anchor.fillOpacity))
    r := add_ref_row_if(tbl, r, show and anchor.band1Enabled and showBands, name + " 1σ",       anchor.band1Color,  anchor.band1Width, "", "")
    r := add_ref_row_if(tbl, r, show and anchor.band2Enabled and showBands, name + " 2σ",       anchor.band2Color,  anchor.band2Width, "", "")
    r := add_ref_row_if(tbl, r, show and anchor.band3Enabled and showBands, name + " 3σ",       anchor.band3Color,  anchor.band3Width, "", "")
    r

if showTable and barstate.islast
    int visibleRows = 1 + count_visible_rows(dailyEnabled, daily) + count_visible_rows(weeklyEnabled, weekly) + count_visible_rows(monthlyEnabled, monthly) + count_visible_rows(nyEnabled, ny) + count_visible_rows(overnightEnabled, overnight)
    var table refTable = table.new(position.top_right, 6, math.max(visibleRows, 1), bgcolor=color.white, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)
    table.cell(refTable, 0, 0, "Setting", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(refTable, 1, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(refTable, 2, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(refTable, 3, 0, "Width", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(refTable, 4, 0, "Fill", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(refTable, 5, 0, "Opacity", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    int row = 1
    row := add_anchor_rows(refTable, row, NAME_DAILY,     dailyEnabled,     daily)
    row := add_anchor_rows(refTable, row, NAME_WEEKLY,    weeklyEnabled,    weekly)
    row := add_anchor_rows(refTable, row, NAME_MONTHLY,   monthlyEnabled,   monthly)
    row := add_anchor_rows(refTable, row, NAME_NY,        nyEnabled,        ny)
    row := add_anchor_rows(refTable, row, NAME_OVERNIGHT, overnightEnabled, overnight)
