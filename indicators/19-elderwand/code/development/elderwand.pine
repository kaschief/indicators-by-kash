monthlyBandSide    = input.string(BAND_BOTH, "", options=[BAND_BOTH, BAND_UPPER, BAND_LOWER, BAND_SANDWICH], inline="m_lbl", group=GROUP_MONTHLY, tooltip=TOOLTIP_BAND_SIDE)
monthlyLabels    = input.bool(true, LABEL_LABEL, inline="m_lbl", group=GROUP_MONTHLY)
monthlyLabelSize   = input.string(FONT_NORMAL, "", options=[FONT_TINY, FONT_SMALL, FONT_NORMAL, FONT_LARGE, FONT_HUGE], inline="m_lbl", group=GROUP_MONTHLY, tooltip=TOOLTIP_LABELS)
monthlyPrices      = input.bool(true, LABEL_PRICE, inline="m_lbl", group=GROUP_MONTHLY)
monthlyVwapWidthChoice = input.string(DEFAULT_VWAP_WIDTH, "", options=["1", "2", "3", "4", "5"], inline="m_bands", group=GROUP_MONTHLY)
monthlyBand1Choice = input.string(DEFAULT_BAND_1_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="m_bands", group=GROUP_MONTHLY)
monthlyBand2Choice = input.string(DEFAULT_BAND_2_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="m_bands", group=GROUP_MONTHLY)
monthlyBand3Choice = input.string(DEFAULT_BAND_3_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="m_bands", group=GROUP_MONTHLY, tooltip=TOOLTIP_BAND_WIDTH)

quarterlyShow        = input.bool(true, LABEL_ENABLE_QUARTERLY, inline="q", group=GROUP_QUARTERLY)
quarterlyColor = input.color(DEFAULT_QUARTERLY_COLOR, "", inline="q", group=GROUP_QUARTERLY, tooltip=TOOLTIP_MAIN)
quarterlyHistory     = input.int(HISTORY_MIN, LABEL_HISTORY, minval=HISTORY_MIN, maxval=HISTORY_MAX, inline="q_fill", group=GROUP_QUARTERLY)
quarterlyFillRange   = input.string(FILL_RANGE_1_SIGMA, LABEL_FILL, options=[FILL_RANGE_NONE, FILL_RANGE_1_SIGMA, FILL_RANGE_2_SIGMA, FILL_RANGE_3_SIGMA], inline="q_fill", group=GROUP_QUARTERLY)
quarterlyFillOpacity = input.float(FILL_OPACITY_QUARTERLY_DEFAULT, "", minval=FILL_OPACITY_MIN, maxval=FILL_OPACITY_MAX, step=FILL_OPACITY_STEP, inline="q_fill", group=GROUP_QUARTERLY, tooltip=TOOLTIP_HISTORY_FILL)
quarterlyBandSide    = input.string(BAND_BOTH, "", options=[BAND_BOTH, BAND_UPPER, BAND_LOWER, BAND_SANDWICH], inline="q_lbl", group=GROUP_QUARTERLY, tooltip=TOOLTIP_BAND_SIDE)
quarterlyLabels      = input.bool(true, LABEL_LABEL, inline="q_lbl", group=GROUP_QUARTERLY)
quarterlyLabelSize   = input.string(FONT_NORMAL, "", options=[FONT_TINY, FONT_SMALL, FONT_NORMAL, FONT_LARGE, FONT_HUGE], inline="q_lbl", group=GROUP_QUARTERLY, tooltip=TOOLTIP_LABELS)
quarterlyPrices      = input.bool(true, LABEL_PRICE, inline="q_lbl", group=GROUP_QUARTERLY)
quarterlyVwapWidthChoice = input.string(DEFAULT_VWAP_WIDTH, "", options=["1", "2", "3", "4", "5"], inline="q_bands", group=GROUP_QUARTERLY)
quarterlyBand1Choice = input.string(DEFAULT_BAND_1_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="q_bands", group=GROUP_QUARTERLY)
quarterlyBand2Choice = input.string(DEFAULT_BAND_2_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="q_bands", group=GROUP_QUARTERLY)
quarterlyBand3Choice = input.string(DEFAULT_BAND_3_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="q_bands", group=GROUP_QUARTERLY, tooltip=TOOLTIP_BAND_WIDTH)

yearlyShow        = input.bool(true, LABEL_ENABLE_YEARLY, inline="y", group=GROUP_YEARLY)
yearlyColor = input.color(DEFAULT_YEARLY_COLOR, "", inline="y", group=GROUP_YEARLY, tooltip=TOOLTIP_MAIN)
yearlyHistory     = input.int(HISTORY_MIN, LABEL_HISTORY, minval=HISTORY_MIN, maxval=HISTORY_MAX, inline="y_fill", group=GROUP_YEARLY)
yearlyFillRange   = input.string(FILL_RANGE_1_SIGMA, LABEL_FILL, options=[FILL_RANGE_NONE, FILL_RANGE_1_SIGMA, FILL_RANGE_2_SIGMA, FILL_RANGE_3_SIGMA], inline="y_fill", group=GROUP_YEARLY)
yearlyFillOpacity = input.float(FILL_OPACITY_YEARLY_DEFAULT, "", minval=FILL_OPACITY_MIN, maxval=FILL_OPACITY_MAX, step=FILL_OPACITY_STEP, inline="y_fill", group=GROUP_YEARLY, tooltip=TOOLTIP_HISTORY_FILL)
yearlyBandSide    = input.string(BAND_BOTH, "", options=[BAND_BOTH, BAND_UPPER, BAND_LOWER, BAND_SANDWICH], inline="y_lbl", group=GROUP_YEARLY, tooltip=TOOLTIP_BAND_SIDE)
yearlyLabels      = input.bool(true, LABEL_LABEL, inline="y_lbl", group=GROUP_YEARLY)
yearlyLabelSize   = input.string(FONT_NORMAL, "", options=[FONT_TINY, FONT_SMALL, FONT_NORMAL, FONT_LARGE, FONT_HUGE], inline="y_lbl", group=GROUP_YEARLY, tooltip=TOOLTIP_LABELS)
yearlyPrices      = input.bool(true, LABEL_PRICE, inline="y_lbl", group=GROUP_YEARLY)
yearlyVwapWidthChoice = input.string(DEFAULT_VWAP_WIDTH, "", options=["1", "2", "3", "4", "5"], inline="y_bands", group=GROUP_YEARLY)
yearlyBand1Choice = input.string(DEFAULT_BAND_1_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="y_bands", group=GROUP_YEARLY)
yearlyBand2Choice = input.string(DEFAULT_BAND_2_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="y_bands", group=GROUP_YEARLY)
yearlyBand3Choice = input.string(DEFAULT_BAND_3_SIGMA_WIDTH, "", options=[BAND_OFF, "1", "2", "3", "4", "5"], inline="y_bands", group=GROUP_YEARLY, tooltip=TOOLTIP_BAND_WIDTH)

showTable = input.bool(false, "Show Reference Table", group=GROUP_TABLE)

// VOLUME GUARD

cumulativeVolume = ta.cum(volume)
if barstate.islast and cumulativeVolume == 0
    runtime.error("No volume is provided by the data vendor.")

// ANCHOR SIGNALS — stateful built-ins run every bar at a fixed call site

dayChange   = timeframe.change("D")
weekChange  = timeframe.change("W")
monthChange = timeframe.change("M")
quarterChange = timeframe.change("3M")
yearChange = timeframe.change("12M")
inNYSession     = not na(time(timeframe.period, SESSION_NY, TIMEZONE))
inDailyReopen   = not na(time(timeframe.period, SESSION_DAILY_REOPEN, TIMEZONE))
nyOpen          = inNYSession and not inNYSession[1]
dailyReopenOpen = inDailyReopen and not inDailyReopen[1]
// A new trading session = a calendar day (ET) that printed bars, detected via the day-of-month
// rolling over. This is dynamic across 24/7 and session-based assets, and naturally skips no-data
// holidays while counting half-days exactly once. Drives both the MNO reset and the rolling window.
mnoOpen    = na(time[1]) or dayofmonth(time, TIMEZONE) != dayofmonth(time[1], TIMEZONE)
// Holiday Mode: anchor the Daily VWAP to the 18:00 ET reopen so it restarts even when
// TradingView merges a holiday session into one "D" bar (timeframe.change("D") wouldn't fire).
dailyChange     = dailyHolidayMode ? dailyReopenOpen : dayChange

chartSecs    = timeframe.in_seconds(timeframe.period)
secsPerDay   = timeframe.in_seconds("1D")
secsPerWeek  = timeframe.in_seconds("1W")
secsPerMonth = timeframe.in_seconds("1M")
secsPerQuarter = timeframe.in_seconds("3M")
secsPerYear = timeframe.in_seconds("12M")

extension_cutoff(string extension, int openedAt) =>
    int cutoff = na
    if extension != EXT_SESSION_ONLY
        cutoff := timestamp(TIMEZONE, year(openedAt, TIMEZONE), month(openedAt, TIMEZONE), dayofmonth(openedAt, TIMEZONE), EXT_CUTOFF_NEXT_OPEN_HOUR, 0)
        if cutoff <= openedAt
            cutoff += MS_IN_DAY
    cutoff

within_extension(int cutoff) =>
    not na(cutoff) and time <= cutoff

var int nyExtensionCutoff = na
if nyOpen
    nyExtensionCutoff := extension_cutoff(nyExtension, time)

// VWAP ENGINE — each anchor's ta.vwap needs its own fixed call site to keep an independent accumulator

vwap_daily() =>
    bool reset = dailyChange or na(hlc3[1])
    [value, upperBand, _] = ta.vwap(hlc3, reset, 1)
    [value, upperBand - value]
vwap_weekly() =>
    bool reset = weekChange or na(hlc3[1])
    [value, upperBand, _] = ta.vwap(hlc3, reset, 1)
    [value, upperBand - value]
vwap_monthly() =>
    bool reset = monthChange or na(hlc3[1])
    [value, upperBand, _] = ta.vwap(hlc3, reset, 1)
    [value, upperBand - value]
vwap_quarterly() =>
    bool reset = quarterChange or na(hlc3[1])
    [value, upperBand, _] = ta.vwap(hlc3, reset, 1)
    [value, upperBand - value]
vwap_yearly() =>
    bool reset = yearChange or na(hlc3[1])
    [value, upperBand, _] = ta.vwap(hlc3, reset, 1)
    [value, upperBand - value]
vwap_ny() =>
    bool reset = nyOpen or na(hlc3[1])
    [value, upperBand, _] = ta.vwap(hlc3, reset, 1)
    [value, upperBand - value]
vwap_mno() =>
    bool reset = mnoOpen or na(hlc3[1])
    [value, upperBand, _] = ta.vwap(hlc3, reset, 1)
    [value, upperBand - value]
[dailyVwap,     dailyStdev]     = vwap_daily()
[weeklyVwap,    weeklyStdev]    = vwap_weekly()
[monthlyVwap,   monthlyStdev]   = vwap_monthly()
[quarterlyVwap, quarterlyStdev] = vwap_quarterly()
[yearlyVwap,    yearlyStdev]    = vwap_yearly()
[nyVwap,        nyStdev]        = vwap_ny()
[mnoVwap,  mnoStdev]  = vwap_mno()

// RENDER HELPERS — stride-subsample to stay under the 10,000-point polyline limit

point_stride(int pointCount, int maxPoints) =>
    math.max(int(math.ceil(pointCount / float(maxPoints))), 1)

build_offset_line(array<int> barTimes, array<float> vwapValues, array<float> stdevValues, float deviations, color lineColor, int lineWidth) =>
    int count = array.size(barTimes)
    int stride = point_stride(count, MAX_POLYLINE_POINTS)
    points = array.new<chart.point>()
    int i = 0
    while i < count
        array.push(points, chart.point.from_time(array.get(barTimes, i), array.get(vwapValues, i) + deviations * array.get(stdevValues, i)))
        i += stride
    if (count - 1) % stride != 0
        array.push(points, chart.point.from_time(array.get(barTimes, count - 1), array.get(vwapValues, count - 1) + deviations * array.get(stdevValues, count - 1)))
    polyline.new(points, closed=false, xloc=xloc.bar_time, line_color=lineColor, line_width=lineWidth)

// Closed band: upper edge forward + lower edge back. An edge of 0 = centerline (clips to the visible half).
build_fill_band(array<int> barTimes, array<float> vwapValues, array<float> stdevValues, float upperDev, float lowerDev, color bandColor, float transparency) =>
    int count = array.size(barTimes)
    int stride = point_stride(count, MAX_POLYLINE_POINTS / 2)
    sampleIndices = array.new<int>()
    int i = 0
    while i < count
        array.push(sampleIndices, i)
        i += stride
    if array.last(sampleIndices) != count - 1
        array.push(sampleIndices, count - 1)
    points = array.new<chart.point>()
    for j = 0 to array.size(sampleIndices) - 1
        int bar = array.get(sampleIndices, j)
        array.push(points, chart.point.from_time(array.get(barTimes, bar), array.get(vwapValues, bar) + upperDev * array.get(stdevValues, bar)))
    for j = array.size(sampleIndices) - 1 to 0
        int bar = array.get(sampleIndices, j)
        array.push(points, chart.point.from_time(array.get(barTimes, bar), array.get(vwapValues, bar) + lowerDev * array.get(stdevValues, bar)))
    polyline.new(points, closed=true, xloc=xloc.bar_time, line_color=na, fill_color=color.new(bandColor, transparency))

add_band(PeriodLines period, VwapAnchor anchor, bool lineEnabled, bool fillEnabled, float deviations, color bandColor, int bandWidth) =>
    if lineEnabled
        if anchor.showUpper
            array.push(period.polylines, build_offset_line(anchor.barTimes, anchor.vwapValues, anchor.stdevValues,  deviations, bandColor, bandWidth))
        if anchor.showLower
            array.push(period.polylines, build_offset_line(anchor.barTimes, anchor.vwapValues, anchor.stdevValues, -deviations, bandColor, bandWidth))
    if fillEnabled
        float upperDev = anchor.showUpper ? deviations : 0.0
        float lowerDev = anchor.showLower ? -deviations : 0.0
        array.push(period.polylines, build_fill_band(anchor.barTimes, anchor.vwapValues, anchor.stdevValues, upperDev, lowerDev, bandColor, 100 - anchor.fillOpacity))

build_period(VwapAnchor anchor) =>
    PeriodLines period = PeriodLines.new(array.new<polyline>())
    array.push(period.polylines, build_offset_line(anchor.barTimes, anchor.vwapValues, anchor.stdevValues, 0, anchor.lineColor, anchor.lineWidth))
    add_band(period, anchor, anchor.band1Enabled and showBands, showBands and anchor.fillRange == FILL_RANGE_1_SIGMA, BAND_1_SIGMA, anchor.band1Color, anchor.band1Width)
    add_band(period, anchor, anchor.band2Enabled and showBands, showBands and anchor.fillRange == FILL_RANGE_2_SIGMA, BAND_2_SIGMA, anchor.band2Color, anchor.band2Width)
    add_band(period, anchor, anchor.band3Enabled and showBands, showBands and anchor.fillRange == FILL_RANGE_3_SIGMA, BAND_3_SIGMA, anchor.band3Color, anchor.band3Width)
    period

delete_period(PeriodLines period) =>
    for line in period.polylines
        polyline.delete(line)

// Archive the completed period to history, trim to depth (current period is drawn live)

archive_period(VwapAnchor anchor) =>
    if array.size(anchor.barTimes) >= 2
        array.push(anchor.history, build_period(anchor))
        while array.size(anchor.history) > anchor.historyDepth - 1
            delete_period(array.shift(anchor.history))
    array.clear(anchor.barTimes)
    array.clear(anchor.vwapValues)
    array.clear(anchor.stdevValues)

// shown = keep drawn (incl. finished session); accumulating = add points (only inside the session window)
update_anchor(VwapAnchor anchor, bool shown, bool accumulating, bool isNewPeriod, float vwapValue, float stdevValue) =>
    anchor.visible := shown
    if isNewPeriod
        archive_period(anchor)
    if accumulating and not na(vwapValue) and not na(stdevValue)
        array.push(anchor.barTimes, time)
        array.push(anchor.vwapValues, vwapValue)
        array.push(anchor.stdevValues, stdevValue)

// LABEL HELPERS — shared discreet style for the VWAP label and every band tag

label_font_size(string fontSize) =>
    switch fontSize
        FONT_SMALL  => size.small
        FONT_NORMAL => size.normal
        FONT_LARGE  => size.large
        FONT_HUGE   => size.huge
        => size.tiny

band_label_text_color(color bandLineColor) =>
    color.new(bandLineColor, math.min(BAND_LABEL_TEXT_TRANSPARENCY_MAX, math.max(0.0, color.t(bandLineColor) - BAND_LABEL_TEXT_TRANSPARENCY_REDUCTION)))

new_line_label(int barTime, float price, string labelText, color textColor, string labelSize) =>
    label.new(barTime, price, labelText, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, textcolor=textColor, size=labelSize, color=color.new(color.white, 100))

new_band_line_label(int barTime, float price, string labelText, color bandLineColor, string labelSize) =>
    new_line_label(barTime, price, labelText, band_label_text_color(bandLineColor), labelSize)

line_label_text(VwapAnchor anchor, string baseText, float price) =>
    baseText + (anchor.pricesEnabled ? LABEL_SEPARATOR + str.tostring(price, format.mintick) : "")

has_current_points(VwapAnchor anchor) =>
    anchor.visible and array.size(anchor.barTimes) >= 2 and array.size(anchor.vwapValues) >= 1 and array.size(anchor.stdevValues) >= 1

same_tick(float left, float right) =>
    not na(left) and not na(right) and math.abs(left - right) <= syminfo.mintick

same_current_period_start(VwapAnchor higherAnchor, VwapAnchor lowerAnchor) =>
    array.get(higherAnchor.barTimes, 0) == array.get(lowerAnchor.barTimes, 0)

same_current_vwap_state(VwapAnchor higherAnchor, VwapAnchor lowerAnchor) =>
    bool sameState = false
    if has_current_points(higherAnchor) and has_current_points(lowerAnchor)
        sameState := same_current_period_start(higherAnchor, lowerAnchor) and same_tick(array.last(higherAnchor.vwapValues), array.last(lowerAnchor.vwapValues)) and same_tick(array.last(higherAnchor.stdevValues), array.last(lowerAnchor.stdevValues))
    sameState

reset_duplicate_display(VwapAnchor anchor) =>
    anchor.drawVisible := anchor.visible
    anchor.displayName := anchor.name

collapse_duplicate_into(VwapAnchor higherAnchor, VwapAnchor lowerAnchor) =>
    if higherAnchor.drawVisible and lowerAnchor.drawVisible and same_current_vwap_state(higherAnchor, lowerAnchor)
        higherAnchor.displayName := higherAnchor.displayName + LABEL_SEPARATOR + lowerAnchor.name
        lowerAnchor.drawVisible := false

resolve_duplicate_display(array<VwapAnchor> anchorsByPriority) =>
    int anchorCount = array.size(anchorsByPriority)
    if anchorCount > 0
        for i = 0 to anchorCount - 1
            reset_duplicate_display(array.get(anchorsByPriority, i))
        if anchorCount > 1
            for higherIndex = 0 to anchorCount - 2
                VwapAnchor higherAnchor = array.get(anchorsByPriority, higherIndex)
                for lowerIndex = higherIndex + 1 to anchorCount - 1
                    collapse_duplicate_into(higherAnchor, array.get(anchorsByPriority, lowerIndex))

// Tag the band's upper/lower line at the latest point, tinted to the band colour
add_band_labels(VwapAnchor anchor, bool show, float multiplier, color bandColor) =>
    if show
        int   barTime    = array.last(anchor.barTimes)
        float vwapValue  = array.last(anchor.vwapValues)
        float stdevValue = array.last(anchor.stdevValues)
        string labelText = anchor.displayName + " " + str.tostring(multiplier) + "σ"
        if anchor.showUpper
            float upperPrice = vwapValue + multiplier * stdevValue
            array.push(anchor.bandLabels, new_band_line_label(barTime, upperPrice, line_label_text(anchor, labelText, upperPrice), bandColor, anchor.labelSize))
        if anchor.showLower
            float lowerPrice = vwapValue - multiplier * stdevValue
            array.push(anchor.bandLabels, new_band_line_label(barTime, lowerPrice, line_label_text(anchor, labelText, lowerPrice), bandColor, anchor.labelSize))

// Redraw the live current period: line, name label, and every enabled σ band tag

draw_current_period(VwapAnchor anchor) =>
    if not na(anchor.currentPeriod)
        delete_period(anchor.currentPeriod)
    label.delete(anchor.nameLabel)
    for bandLabel in anchor.bandLabels
        label.delete(bandLabel)
    array.clear(anchor.bandLabels)
    anchor.currentPeriod := na
    if anchor.drawVisible and array.size(anchor.barTimes) >= 2
        anchor.currentPeriod := build_period(anchor)
        if anchor.labelsEnabled
            float vwapPrice = array.last(anchor.vwapValues)
            anchor.nameLabel := new_line_label(array.last(anchor.barTimes), vwapPrice, line_label_text(anchor, vwapLabelPrefix + anchor.displayName + SUFFIX_VWAP, vwapPrice), anchor.lineColor, anchor.labelSize)
            add_band_labels(anchor, anchor.band1Enabled and showBands, BAND_1_SIGMA, anchor.band1Color)
            add_band_labels(anchor, anchor.band2Enabled and showBands, BAND_2_SIGMA, anchor.band2Color)
            add_band_labels(anchor, anchor.band3Enabled and showBands, BAND_3_SIGMA, anchor.band3Color)

// ANCHORS — one instance each; config copied from inputs each bar, then computed + drawn

var VwapAnchor daily     = new_anchor(NAME_DAILY)
var VwapAnchor weekly    = new_anchor(NAME_WEEKLY)
var VwapAnchor monthly   = new_anchor(NAME_MONTHLY)
var VwapAnchor quarterly = new_anchor(NAME_QUARTERLY)
var VwapAnchor yearly    = new_anchor(NAME_YEARLY)
var VwapAnchor ny        = new_anchor(NAME_NY)
var VwapAnchor mno  = new_anchor(NAME_MNO)
var VwapAnchor rolling   = new_anchor(NAME_ROLLING)
var array<VwapAnchor> duplicatePriority = array.from(yearly, quarterly, monthly, weekly, rolling, daily, ny, mno)

// Rolling-VWAP windowed accumulator: per-bar contributions (index-aligned with rolling.barTimes /
// vwapValues / stdevValues) plus running sums and the last-N session-start timestamps.
var array<int>   rollSessionStarts = array.new<int>()
var array<float> rollPV  = array.new<float>()
var array<float> rollVol = array.new<float>()
var array<float> rollP2V = array.new<float>()
var float rollSumPV  = 0.0
var float rollSumVol = 0.0
var float rollSumP2V = 0.0

// σ band choice: "Off" hides the band; "1"–"5" enables it at that line width.
parse_band_choice(string choice) =>
    bool enabled = choice != BAND_OFF
    [enabled, enabled ? int(str.tonumber(choice)) : 1]

[dailyBand1, dailyBand1Width] = parse_band_choice(dailyBand1Choice)
[dailyBand2, dailyBand2Width] = parse_band_choice(dailyBand2Choice)
[dailyBand3, dailyBand3Width] = parse_band_choice(dailyBand3Choice)
[weeklyBand1, weeklyBand1Width] = parse_band_choice(weeklyBand1Choice)
[weeklyBand2, weeklyBand2Width] = parse_band_choice(weeklyBand2Choice)
[weeklyBand3, weeklyBand3Width] = parse_band_choice(weeklyBand3Choice)
[monthlyBand1, monthlyBand1Width] = parse_band_choice(monthlyBand1Choice)
[monthlyBand2, monthlyBand2Width] = parse_band_choice(monthlyBand2Choice)
[monthlyBand3, monthlyBand3Width] = parse_band_choice(monthlyBand3Choice)
[quarterlyBand1, quarterlyBand1Width] = parse_band_choice(quarterlyBand1Choice)
[quarterlyBand2, quarterlyBand2Width] = parse_band_choice(quarterlyBand2Choice)
[quarterlyBand3, quarterlyBand3Width] = parse_band_choice(quarterlyBand3Choice)
[yearlyBand1, yearlyBand1Width] = parse_band_choice(yearlyBand1Choice)
[yearlyBand2, yearlyBand2Width] = parse_band_choice(yearlyBand2Choice)
[yearlyBand3, yearlyBand3Width] = parse_band_choice(yearlyBand3Choice)
[nyBand1, nyBand1Width] = parse_band_choice(nyBand1Choice)
[nyBand2, nyBand2Width] = parse_band_choice(nyBand2Choice)
[nyBand3, nyBand3Width] = parse_band_choice(nyBand3Choice)
[mnoBand1, mnoBand1Width] = parse_band_choice(mnoBand1Choice)
[mnoBand2, mnoBand2Width] = parse_band_choice(mnoBand2Choice)
[mnoBand3, mnoBand3Width] = parse_band_choice(mnoBand3Choice)
[rollingBand1, rollingBand1Width] = parse_band_choice(rollingBand1Choice)
[rollingBand2, rollingBand2Width] = parse_band_choice(rollingBand2Choice)
[rollingBand3, rollingBand3Width] = parse_band_choice(rollingBand3Choice)

daily.historyDepth := dailyHistory
daily.fillOpacity := dailyFillOpacity
daily.fillRange := dailyFillRange
daily.labelsEnabled := dailyLabels
daily.pricesEnabled := dailyPrices
daily.labelSize := label_font_size(dailyLabelSize)
daily.showUpper := dailyBandSide != BAND_LOWER
daily.showLower := dailyBandSide != BAND_UPPER
daily.band1Enabled := dailyBand1
daily.band2Enabled := dailyBand2
daily.band3Enabled := dailyBand3 and dailyBandSide != BAND_SANDWICH
daily.band1Width := dailyBand1Width
daily.band2Width := dailyBand2Width
daily.band3Width := dailyBand3Width

weekly.historyDepth := weeklyHistory
weekly.fillOpacity := weeklyFillOpacity
weekly.fillRange := weeklyFillRange
weekly.labelsEnabled := weeklyLabels
weekly.pricesEnabled := weeklyPrices
weekly.labelSize := label_font_size(weeklyLabelSize)
weekly.showUpper := weeklyBandSide != BAND_LOWER
weekly.showLower := weeklyBandSide != BAND_UPPER
weekly.band1Enabled := weeklyBand1
weekly.band2Enabled := weeklyBand2
weekly.band3Enabled := weeklyBand3 and weeklyBandSide != BAND_SANDWICH
weekly.band1Width := weeklyBand1Width
weekly.band2Width := weeklyBand2Width
weekly.band3Width := weeklyBand3Width

monthly.historyDepth := monthlyHistory
monthly.fillOpacity := monthlyFillOpacity
monthly.fillRange := monthlyFillRange
monthly.labelsEnabled := monthlyLabels
monthly.pricesEnabled := monthlyPrices
monthly.labelSize := label_font_size(monthlyLabelSize)
monthly.showUpper := monthlyBandSide != BAND_LOWER
monthly.showLower := monthlyBandSide != BAND_UPPER
monthly.band1Enabled := monthlyBand1
monthly.band2Enabled := monthlyBand2
monthly.band3Enabled := monthlyBand3 and monthlyBandSide != BAND_SANDWICH
monthly.band1Width := monthlyBand1Width
monthly.band2Width := monthlyBand2Width
monthly.band3Width := monthlyBand3Width

quarterly.historyDepth := quarterlyHistory
quarterly.fillOpacity := quarterlyFillOpacity
quarterly.fillRange := quarterlyFillRange
quarterly.labelsEnabled := quarterlyLabels
quarterly.pricesEnabled := quarterlyPrices
quarterly.labelSize := label_font_size(quarterlyLabelSize)
quarterly.showUpper := quarterlyBandSide != BAND_LOWER
quarterly.showLower := quarterlyBandSide != BAND_UPPER
quarterly.band1Enabled := quarterlyBand1
quarterly.band2Enabled := quarterlyBand2
quarterly.band3Enabled := quarterlyBand3 and quarterlyBandSide != BAND_SANDWICH
quarterly.band1Width := quarterlyBand1Width
quarterly.band2Width := quarterlyBand2Width
quarterly.band3Width := quarterlyBand3Width

yearly.historyDepth := yearlyHistory
yearly.fillOpacity := yearlyFillOpacity
yearly.fillRange := yearlyFillRange
yearly.labelsEnabled := yearlyLabels
yearly.pricesEnabled := yearlyPrices
yearly.labelSize := label_font_size(yearlyLabelSize)
yearly.showUpper := yearlyBandSide != BAND_LOWER
yearly.showLower := yearlyBandSide != BAND_UPPER
yearly.band1Enabled := yearlyBand1
yearly.band2Enabled := yearlyBand2
yearly.band3Enabled := yearlyBand3 and yearlyBandSide != BAND_SANDWICH
yearly.band1Width := yearlyBand1Width
yearly.band2Width := yearlyBand2Width
yearly.band3Width := yearlyBand3Width

ny.historyDepth := nyHistory
ny.fillOpacity := nyFillOpacity
ny.fillRange := nyFillRange
ny.labelsEnabled := nyLabels
ny.pricesEnabled := nyPrices
ny.labelSize := label_font_size(nyLabelSize)
ny.showUpper := nyBandSide != BAND_LOWER
ny.showLower := nyBandSide != BAND_UPPER
ny.band1Enabled := nyBand1
ny.band2Enabled := nyBand2
ny.band3Enabled := nyBand3 and nyBandSide != BAND_SANDWICH
ny.band1Width := nyBand1Width
ny.band2Width := nyBand2Width
ny.band3Width := nyBand3Width

mno.historyDepth := mnoHistory
mno.fillOpacity := mnoFillOpacity
mno.fillRange := mnoFillRange
mno.labelsEnabled := mnoLabels
mno.pricesEnabled := mnoPrices
mno.labelSize := label_font_size(mnoLabelSize)
mno.showUpper := mnoBandSide != BAND_LOWER
mno.showLower := mnoBandSide != BAND_UPPER
mno.band1Enabled := mnoBand1
mno.band2Enabled := mnoBand2
mno.band3Enabled := mnoBand3 and mnoBandSide != BAND_SANDWICH
mno.band1Width := mnoBand1Width
mno.band2Width := mnoBand2Width
mno.band3Width := mnoBand3Width

// Rolling has no discrete periods, so no History; everything else mirrors the other anchors.
rolling.fillOpacity := rollingFillOpacity
rolling.fillRange := rollingFillRange
rolling.labelsEnabled := rollingLabels
rolling.pricesEnabled := rollingPrices
rolling.labelSize := label_font_size(rollingLabelSize)
rolling.showUpper := rollingBandSide != BAND_LOWER
rolling.showLower := rollingBandSide != BAND_UPPER
rolling.band1Enabled := rollingBand1
rolling.band2Enabled := rollingBand2
rolling.band3Enabled := rollingBand3 and rollingBandSide != BAND_SANDWICH
rolling.band1Width := rollingBand1Width
rolling.band2Width := rollingBand2Width
rolling.band3Width := rollingBand3Width

// 3σ reads strongest (low transparency); 1σ/2σ stay recessed.
band_transparency_for_multiplier(float multiplier) =>
    multiplier >= BAND_3_SIGMA ? DEFAULT_BAND_3_SIGMA_TRANSPARENCY : multiplier >= BAND_2_SIGMA ? DEFAULT_BAND_2_SIGMA_TRANSPARENCY : DEFAULT_BAND_1_SIGMA_TRANSPARENCY

// ANCHOR STYLE — centerline = full colour + width tier; bands reuse the colour at rising transparency (3σ excepted). Band widths come from per-group inputs.
apply_anchor_style(VwapAnchor anchor, color anchorColor, int width) =>
    anchor.lineColor := anchorColor
    anchor.lineWidth := width
    anchor.band1Color := color.new(anchorColor, band_transparency_for_multiplier(BAND_1_SIGMA))
    anchor.band2Color := color.new(anchorColor, band_transparency_for_multiplier(BAND_2_SIGMA))
    anchor.band3Color := color.new(anchorColor, band_transparency_for_multiplier(BAND_3_SIGMA))

// Per-anchor VWAP width parsed from the first dropdown in each "_bands" row.
parse_vwap_width(string choice) =>
    int(str.tonumber(choice))

apply_anchor_style(daily,     dailyColor,     parse_vwap_width(dailyVwapWidthChoice))
apply_anchor_style(weekly,    weeklyColor,    parse_vwap_width(weeklyVwapWidthChoice))
apply_anchor_style(monthly,   monthlyColor,   parse_vwap_width(monthlyVwapWidthChoice))
apply_anchor_style(quarterly, quarterlyColor, parse_vwap_width(quarterlyVwapWidthChoice))
apply_anchor_style(yearly,    yearlyColor,    parse_vwap_width(yearlyVwapWidthChoice))
apply_anchor_style(ny,        nyColor,        parse_vwap_width(nyVwapWidthChoice))
apply_anchor_style(mno,       mnoColor,       parse_vwap_width(mnoVwapWidthChoice))
apply_anchor_style(rolling,   rollingColor,   parse_vwap_width(rollingVwapWidthChoice))

// QUICK FILTER — resolve each anchor's effective enable: All respects per-group toggles; presets force their set on, rest off

in_quick_filter(string name) =>
    switch quickFilter
        FILTER_DAILY                  => name == NAME_DAILY
        FILTER_WEEKLY                 => name == NAME_WEEKLY
        FILTER_DAILY_WEEKLY           => name == NAME_DAILY or name == NAME_WEEKLY
        FILTER_NY                     => name == NAME_NY
        FILTER_DAILY_NY               => name == NAME_DAILY or name == NAME_NY
        FILTER_DAILY_WEEKLY_NY        => name == NAME_DAILY or name == NAME_WEEKLY or name == NAME_NY
        FILTER_DAILY_WEEKLY_MONTHLY   => name == NAME_DAILY or name == NAME_WEEKLY or name == NAME_MONTHLY
        FILTER_MONTHLY                => name == NAME_MONTHLY
        FILTER_QUARTERLY              => name == NAME_QUARTERLY
        FILTER_YEARLY                 => name == NAME_YEARLY
        FILTER_QUARTERLY_YEARLY       => name == NAME_QUARTERLY or name == NAME_YEARLY
        FILTER_MONTHLY_QUARTERLY_YEARLY => name == NAME_MONTHLY or name == NAME_QUARTERLY or name == NAME_YEARLY
        FILTER_MNO               => name == NAME_MNO
        FILTER_DAILY_WEEKLY_MNO  => name == NAME_DAILY or name == NAME_WEEKLY or name == NAME_MNO
        FILTER_DAILY_MNO         => name == NAME_DAILY or name == NAME_MNO
        FILTER_ROLLING                => name == NAME_ROLLING
        => false

filter_enabled(string name, bool individualShow) =>
    quickFilter == FILTER_ALL ? individualShow : in_quick_filter(name)

dailyEnabled        = filter_enabled(NAME_DAILY,         dailyShow)
weeklyEnabled       = filter_enabled(NAME_WEEKLY,        weeklyShow)
monthlyEnabled      = filter_enabled(NAME_MONTHLY,       monthlyShow)
quarterlyEnabled    = filter_enabled(NAME_QUARTERLY,     quarterlyShow)
yearlyEnabled       = filter_enabled(NAME_YEARLY,        yearlyShow)
nyEnabled           = filter_enabled(NAME_NY,            nyShow)
mnoEnabled     = filter_enabled(NAME_MNO,      mnoShow)
rollingEnabled      = filter_enabled(NAME_ROLLING,       rollingShow)

dailyShown     = dailyEnabled     and chartSecs < secsPerDay
weeklyShown    = weeklyEnabled    and chartSecs < secsPerWeek
monthlyShown   = monthlyEnabled   and chartSecs < secsPerMonth
quarterlyShown = quarterlyEnabled and chartSecs < secsPerQuarter
yearlyShown    = yearlyEnabled    and chartSecs < secsPerYear
nyShown        = nyEnabled        and chartSecs < secsPerDay
mnoShown  = mnoEnabled  and chartSecs < secsPerDay
// Rolling spans many sessions, so it also reads on the daily chart (one bar = one session).
rollingShown   = rollingEnabled   and chartSecs <= secsPerDay
nyAccumulating = nyShown and (inNYSession or within_extension(nyExtensionCutoff))

update_anchor(daily,     dailyShown,     dailyShown,                            dailyChange,   dailyVwap,     dailyStdev)
update_anchor(weekly,    weeklyShown,    weeklyShown,                           weekChange,    weeklyVwap,    weeklyStdev)
update_anchor(monthly,   monthlyShown,   monthlyShown,                          monthChange,   monthlyVwap,   monthlyStdev)
update_anchor(quarterly, quarterlyShown, quarterlyShown,                        quarterChange, quarterlyVwap, quarterlyStdev)
update_anchor(yearly,    yearlyShown,    yearlyShown,                           yearChange,    yearlyVwap,    yearlyStdev)
update_anchor(ny,        nyShown,        nyAccumulating,                        nyOpen,        nyVwap,        nyStdev)
update_anchor(mno,  mnoShown,  mnoShown,                         mnoOpen,  mnoVwap,  mnoStdev)

// ROLLING VWAP — volume-weighted mean + stdev over a sliding window of the last N trading sessions.
// Commits only confirmed bars (no intrabar double-count); evicts bars older than the oldest of the
// last N session starts, so the window steps forward one session per new day. Inlined at global scope
// because the running sums must be reassigned (Pine functions cannot write to globals).
rolling.visible := rollingShown
if rollingShown and barstate.isconfirmed and not na(hlc3) and not na(volume)
    if mnoOpen
        array.push(rollSessionStarts, time)
        while array.size(rollSessionStarts) > rollingSessions
            array.shift(rollSessionStarts)
    float rollPrice  = hlc3
    float rollBarPV  = rollPrice * volume
    float rollBarP2V = rollPrice * rollBarPV
    rollSumPV  += rollBarPV
    rollSumVol += volume
    rollSumP2V += rollBarP2V
    int rollWindowStart = array.size(rollSessionStarts) > 0 ? array.first(rollSessionStarts) : na
    if not na(rollWindowStart)
        while array.size(rolling.barTimes) > 0 and array.first(rolling.barTimes) < rollWindowStart
            array.shift(rolling.barTimes)
            array.shift(rolling.vwapValues)
            array.shift(rolling.stdevValues)
            rollSumPV  -= array.shift(rollPV)
            rollSumVol -= array.shift(rollVol)
            rollSumP2V -= array.shift(rollP2V)
    float rollVwap  = rollSumVol > 0 ? rollSumPV / rollSumVol : na
    float rollVar   = rollSumVol > 0 ? math.max(rollSumP2V / rollSumVol - rollVwap * rollVwap, 0.0) : na
    float rollStdev = na(rollVar) ? na : math.sqrt(rollVar)
    array.push(rolling.barTimes,    time)
    array.push(rolling.vwapValues,  rollVwap)
    array.push(rolling.stdevValues, rollStdev)
    array.push(rollPV,  rollBarPV)
    array.push(rollVol, volume)
    array.push(rollP2V, rollBarP2V)

if barstate.islast
    resolve_duplicate_display(duplicatePriority)
    draw_current_period(daily)
    draw_current_period(weekly)
    draw_current_period(monthly)
    draw_current_period(quarterly)
    draw_current_period(yearly)
    draw_current_period(ny)
    draw_current_period(mno)
    draw_current_period(rolling)

// REFERENCE TABLE — one row per active line/band: colour (RGB + transparency) and width.
// count_visible_rows and add_anchor_rows MUST share inclusion predicates or the table overflows.

add_ref_row(table tbl, int row, string label, color clr, int width, string fillRange, string fillOpacity) =>
    table.cell(tbl, 0, row, label, text_size=size.small, text_color=color.black)
    table.cell(tbl, 1, row, str.format("R:{0} G:{1} B:{2}", int(color.r(clr)), int(color.g(clr)), int(color.b(clr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 2, row, str.tostring(int(color.t(clr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 3, row, str.tostring(width), text_size=size.small, text_color=color.black)
    table.cell(tbl, 4, row, fillRange, text_size=size.small, text_color=color.black)
    table.cell(tbl, 5, row, fillOpacity, text_size=size.small, text_color=color.black)

add_ref_row_if(table tbl, int row, bool include, string label, color clr, int width, string fillRange, string fillOpacity) =>
    int nextRow = row
    if include
        add_ref_row(tbl, row, label, clr, width, fillRange, fillOpacity)
        nextRow := row + 1
    nextRow

count_visible_rows(bool show, VwapAnchor anchor) =>
    (show ? 1 : 0) + (show and anchor.band1Enabled and showBands ? 1 : 0) + (show and anchor.band2Enabled and showBands ? 1 : 0) + (show and anchor.band3Enabled and showBands ? 1 : 0)

add_anchor_rows(table tbl, int row, string name, bool show, VwapAnchor anchor) =>
    int r = row
    r := add_ref_row_if(tbl, r, show,                                      name + SUFFIX_VWAP, anchor.lineColor,   anchor.lineWidth, anchor.fillRange, str.tostring(anchor.fillOpacity))
    r := add_ref_row_if(tbl, r, show and anchor.band1Enabled and showBands, name + " 1σ",       anchor.band1Color,  anchor.band1Width, "", "")
    r := add_ref_row_if(tbl, r, show and anchor.band2Enabled and showBands, name + " 2σ",       anchor.band2Color,  anchor.band2Width, "", "")
    r := add_ref_row_if(tbl, r, show and anchor.band3Enabled and showBands, name + " 3σ",       anchor.band3Color,  anchor.band3Width, "", "")
    r

if showTable and barstate.islast
    int visibleRows = 1 + count_visible_rows(daily.drawVisible, daily) + count_visible_rows(weekly.drawVisible, weekly) + count_visible_rows(monthly.drawVisible, monthly) + count_visible_rows(quarterly.drawVisible, quarterly) + count_visible_rows(yearly.drawVisible, yearly) + count_visible_rows(ny.drawVisible, ny) + count_visible_rows(mno.drawVisible, mno) + count_visible_rows(rolling.drawVisible, rolling)
    var table refTable = table.new(position.top_right, 6, math.max(visibleRows, 1), bgcolor=color.white, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)
    table.cell(refTable, 0, 0, "Setting", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(refTable, 1, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(refTable, 2, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(refTable, 3, 0, "Width", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(refTable, 4, 0, "Fill", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(refTable, 5, 0, "Opacity", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    int row = 1
    row := add_anchor_rows(refTable, row, daily.displayName,     daily.drawVisible,     daily)
    row := add_anchor_rows(refTable, row, weekly.displayName,    weekly.drawVisible,    weekly)
    row := add_anchor_rows(refTable, row, monthly.displayName,   monthly.drawVisible,   monthly)
    row := add_anchor_rows(refTable, row, quarterly.displayName, quarterly.drawVisible, quarterly)
    row := add_anchor_rows(refTable, row, yearly.displayName,    yearly.drawVisible,    yearly)
    row := add_anchor_rows(refTable, row, ny.displayName,        ny.drawVisible,        ny)
    row := add_anchor_rows(refTable, row, mno.displayName,  mno.drawVisible,  mno)
    row := add_anchor_rows(refTable, row, rolling.displayName,   rolling.drawVisible,   rolling)
