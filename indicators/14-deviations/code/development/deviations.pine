// ═══════════════════════════════════════════════════════════════════════════
// SESSION VARIABLES
// ═══════════════════════════════════════════════════════════════════════════

var array<SessionData> sessions = array.new<SessionData>()
var array<SessionData> activeSessions = array.new<SessionData>()

// Cached parsed deviation zones (Pine Script doesn't support nested collections)
var array<DeviationZone> cachedDeviations_0129 = na
var array<DeviationZone> cachedDeviations_ny_early = na
var array<DeviationZone> cachedDeviations_overnight = na
var array<DeviationZone> cachedDeviations_premarket = na
var array<DeviationZone> cachedDeviations_ivb = na
var array<DeviationZone> cachedDeviations_asia_open = na

// Deviation Glow: Global tracking using string keys (avoids UDT array complexity)
var map<string, int> glowTouchTimes = map.new<string, int>()      // boxKey -> touch timestamp
var map<string, color> glowOriginalColors = map.new<string, color>()  // boxKey -> original color

// Constants for performance
BODY_SUFFIX = "B"
WICK_SUFFIX = "W"
ZONE_OFFSET_BARS = 1  // Width of offset zones in bars
ZONE_OFFSET_START = 0  // How many bars into the range before zones start (0 = at range end, 2 = 2 bars before range end)
DEVIATION_LINE_OPACITY = 60
BAR_MS = int(timeframe.in_seconds() * 1000)

// ═══════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════

// Sessions that show deviations only (no core boxes)
skipsCore(int idx) =>
    idx == IDX_OVERNIGHT or idx == IDX_PREMARKET

// Key sessions whose mitigated high/low line should NOT carry the session-name reminder.
skipsMitigationName(int idx) =>
    idx == IDX_NY_EARLY

// Parsing helpers
parseTimeToMinutes(string timeStr) =>
    hour = str.tonumber(str.substring(timeStr, 0, 2))
    minute = str.tonumber(str.substring(timeStr, 3, 5))
    int(hour * 60 + minute)

// Check if two timestamps are on the same calendar day
isSameCalendarDay(int t1, int t2) =>
    dayofmonth(t1, NY_TIMEZONE) == dayofmonth(t2, NY_TIMEZONE) and month(t1, NY_TIMEZONE) == month(t2, NY_TIMEZONE) and year(t1, NY_TIMEZONE) == year(t2, NY_TIMEZONE)

// Check if a bar is within a session's time window (handles midnight-crossing sessions)
isInSessionTime(int minutes, int startMin, int endMin, bool crossesMidnight) =>
    crossesMidnight ? (minutes >= startMin or minutes <= endMin) : (minutes >= startMin and minutes <= endMin)

toSansSerif(string inputStr) =>
    result = inputStr
    result := str.replace_all(result, "0", "𝟢")
    result := str.replace_all(result, "1", "𝟣")
    result := str.replace_all(result, "2", "𝟤")
    result := str.replace_all(result, "3", "𝟥")
    result := str.replace_all(result, "4", "𝟦")
    result := str.replace_all(result, "5", "𝟧")
    result := str.replace_all(result, "6", "𝟨")
    result := str.replace_all(result, "7", "𝟩")
    result := str.replace_all(result, "8", "𝟪")
    result := str.replace_all(result, "9", "𝟫")
    result

// Darken a color by reducing its transparency (making it more opaque/visible)
// darkenPercent: 0-100, where higher = more darkening (more opaque)
darkenColor(color c, float darkenPercent) =>
    originalTransparency = color.t(c)
    // Reduce transparency by the darken percentage (makes color more visible/darker)
    newTransparency = originalTransparency * (1 - darkenPercent / 100)
    color.new(c, newTransparency)

// Generate unique key for a deviation box (for glow tracking)
// Uses session index + start time + box index to create a unique identifier
getGlowBoxKey(int sessionIndex, int sessionStartTime, int boxIndex) =>
    str.tostring(sessionIndex) + "_" + str.tostring(sessionStartTime) + "_" + str.tostring(boxIndex)

// Reset a deviation box's glow state: restore original color and clean up maps
resetGlowBox(box devBox, string boxKey) =>
    if map.contains(glowOriginalColors, boxKey)
        box.set_bgcolor(devBox, map.get(glowOriginalColors, boxKey))
        map.remove(glowOriginalColors, boxKey)
    if map.contains(glowTouchTimes, boxKey)
        map.remove(glowTouchTimes, boxKey)

// Convert extension preset to hours
getExtendHours(string preset) =>
    switch preset
        EXTEND_3H => 3.0
        EXTEND_6H => 6.0
        EXTEND_8H => 8.0
        EXTEND_12H => 12.0
        EXTEND_NEXT => 20.0
        => 0.0

// Get extension milliseconds for a session by index
getSessionExtendMs(int idx) =>
    preset = switch idx
        IDX_0129 => opening_2130_0129_extend
        IDX_NY_EARLY => opening_0600_0900_extend
        IDX_OVERNIGHT => opening_1600_0500_extend
        IDX_PREMARKET => opening_0500_0915_extend
        IDX_IVB => opening_0930_1000_extend
        IDX_ASIA_OPEN => opening_1800_2100_extend
        => EXTEND_OFF
    int(getExtendHours(preset) * 60 * 60 * 1000)

// Sessions that always track mitigation (bypass "Same Day Only" filter)
// Evening sessions that naturally get mitigated the next trading day
alwaysTrackMitigation(int idx) =>
    switch idx
        IDX_0129 => true        // Rafael (21:30-01:29)
        IDX_ASIA_OPEN => true   // 1800 (18:00-21:00)
        => false

// Earliest strict IVB break on refStartTime's day. A bar that breaks both sides has no knowable
// sequence, so it cannot establish a directional break.
ivbBreakForDay(int refStartTime) =>
    int earliest = na
    int side = 0
    for s in sessions
        if s.sessionIndex == IDX_IVB and isSameCalendarDay(s.startTime, refStartTime)
            int highBreakTime = s.extHighTime
            int lowBreakTime = s.extLowTime
            // IVB is iterated after its consumers, so its stored break time lags one bar here.
            bool breaksHighNow = high > s.wickHigh
            bool breaksLowNow = low < s.wickLow
            if na(highBreakTime) and breaksHighNow and not breaksLowNow
                highBreakTime := time
            if na(lowBreakTime) and breaksLowNow and not breaksHighNow
                lowBreakTime := time
            if not na(highBreakTime) and (na(lowBreakTime) or highBreakTime < lowBreakTime)
                earliest := highBreakTime
                side := 1
            else if not na(lowBreakTime) and (na(highBreakTime) or lowBreakTime < highBreakTime)
                earliest := lowBreakTime
                side := -1
            else if not na(highBreakTime) and highBreakTime == lowBreakTime
                earliest := time
                side := 0
    [earliest, side]

// Draw confirmed mitigation line - extend pending line (if provisional) or draw new solid line
// When provisional: just extends pending line, returns na (solid line already in highMitigationLine)
// When not provisional: creates new solid line and returns it
draw_confirmed_mitigation_line(bool enabled, bool was_provisional, line pending_line, int origin_time, float level, color mit_color) =>
    line result = na
    if not enabled
        result := na
    else if was_provisional and not na(pending_line)
        line.set_x2(pending_line, time)
        // Don't return the pending line - solid line is already stored in highMitigationLine
    else
        result := line.new(origin_time, level, time, level, color=mit_color, style=line.style_solid, width=MITIGATION_LINE_WIDTH, xloc=xloc.bar_time)
    result

// Draw provisional breach lines - solid from origin to breach, dashed pending from breach
// Returns tuple of [solid_line, pending_line]
draw_provisional_breach_lines(bool enabled, int origin_time, float level, color mit_color) =>
    line solid_line = na
    line pending_line = na
    if enabled
        solid_line := line.new(origin_time, level, time, level, color=mit_color, style=line.style_solid, width=MITIGATION_LINE_WIDTH, xloc=xloc.bar_time)
        pending_line := line.new(time, level, time, level, color=mit_color, style=line.style_dashed, width=MITIGATION_PENDING_LINE_WIDTH, xloc=xloc.bar_time)
    [solid_line, pending_line]

// Label a dashed pending line at its right edge while it's still open; remove it once mitigated
resolve_pending_label(bool keep, label lbl, line pending, float level, string txt, color lineClr) =>
    label result = lbl
    if keep and not na(pending)
        color txtClr = color.new(lineClr, math.min(PENDING_LABEL_TRANSPARENCY_MAX, math.max(0.0, color.t(lineClr) - PENDING_LABEL_TRANSPARENCY_REDUCTION)))
        if na(result)
            result := label.new(line.get_x2(pending), level, txt, style=label.style_label_left, textcolor=txtClr, size=size.tiny, color=color.new(color.white, 100), xloc=xloc.bar_time)
        else
            label.set_x(result, line.get_x2(pending))
            label.set_y(result, level)
    else if not na(result)
        label.delete(result)
        result := na
    result

// Floored sqrt density: reminder count grows sublinearly with a run's length, capped. Shared by every
// reminder system so spacing stays consistent.
reminderPlacements(int runMs, int spacingMs, int maxCount) =>
    math.min(maxCount, math.max(1, int(math.floor(math.sqrt(float(runMs) / math.max(1, spacingMs))))))

// Repeat off = one tag at the line midpoint; repeat on = sqrt-sparse tiling keyed off the line's own
// absolute length, so physical chart distance drives density uniformly and long lines don't crowd.
tile_line_labels(line target, float level, string txt, bool repeat, color txtColor, color bgColor) =>
    array<label> tags = array.new<label>()
    int x1 = line.get_x1(target)
    int runMs = line.get_x2(target) - x1
    if runMs > 0
        int count = repeat ? reminderPlacements(runMs, MITIGATION_REMINDER_BASE_MS, MITIGATION_REMINDER_MAX_PER_LINE) : 1
        for placement = 1 to count
            int tagTime = x1 + int(runMs * (placement - 0.5) / count)
            array.push(tags, label.new(tagTime, level, txt, style=label.style_label_center, textcolor=txtColor, size=size.tiny, color=bgColor, xloc=xloc.bar_time))
    tags

resolve_mitigation_reminders(bool keep, array<label> reminders, line mitLine, float level, string txt, bool repeat) =>
    if not keep or na(mitLine)
        for lbl in reminders
            label.delete(lbl)
        array.clear(reminders)
    else if array.size(reminders) == 0
        // Confirmed mitigation lines never move, so build the tags once instead of rebuilding every bar.
        for lbl in tile_line_labels(mitLine, level, txt, repeat, labelColor, labelsBgColor)
            array.push(reminders, lbl)

// Push a color's transparency toward fully invisible by pct (0 = unchanged, 100 = invisible).
fadeToward100(color c, float pct) =>
    color.new(c, color.t(c) + (100.0 - color.t(c)) * pct / 100.0)

// Fade a completed retracement's line + tiled labels toward invisible so they read as inactive. Base
// colors are passed in because Pine can't read a line's current color back.
fadeRetraceElements(line ln, array<label> lbls, color baseLineColor, color baseTextColor, color baseBgColor) =>
    if not na(ln)
        line.set_color(ln, fadeToward100(baseLineColor, completedRetraceFade))
    for lbl in lbls
        label.set_textcolor(lbl, fadeToward100(baseTextColor, completedRetraceFade))
        label.set_color(lbl, fadeToward100(baseBgColor, completedRetraceFade))

shouldShowMitigationName(SessionData sess, bool isHigh) =>
    if sess.sessionIndex == IDX_IVB
        // A single IVB sweep is self-explanatory. Name IVB only after both sides sweep,
        // and place the name on the second (last-swept) side. Same-bar double sweeps
        // have no knowable order, so neither side receives the name.
        bool bothSidesSwept = sess.provisionalHighMitigated and sess.provisionalLowMitigated
        int thisSweepTime = isHigh ? sess.provisionalHighTime : sess.provisionalLowTime
        int otherSweepTime = isHigh ? sess.provisionalLowTime : sess.provisionalHighTime
        bothSidesSwept and not na(thisSweepTime) and not na(otherSweepTime) and thisSweepTime > otherSweepTime
    else
        bool isMitigated = isHigh ? sess.highMitigated : sess.lowMitigated
        bool wasProvisional = isHigh ? sess.provisionalHighMitigated : sess.provisionalLowMitigated
        bool wasOvernightProvisional = sess.delayedMitigation and wasProvisional
        isMitigated and not wasOvernightProvisional

// Convert a bar offset to a time offset (used for xloc.bar_time drawing)
timeWithOffset(int baseTime, int barOffset) =>
    baseTime + barOffset * BAR_MS

// Range candles have no fixed duration, so their confirmation endpoint is the current candle.
ivbConfirmationEndTime(int confirmedBarTime, int provisionalTime, int currentBarTime, bool isRange, int chartBarMs) =>
    int endpoint = isRange ? currentBarTime : confirmedBarTime + 30 * 60 * 1000 - chartBarMs
    math.max(endpoint, provisionalTime)

// Parse deviation string into ordered array of DeviationZone entries
// Example: "1, 2:2.5, 4:4.5" → [{1,1,false}, {2,2.5,true}, {4,4.5,true}]
parseDeviationZones(string deviationStr) =>
    zones = array.new<DeviationZone>()
    tokens = str.split(deviationStr, ",")
    for token in tokens
        trimmed = str.replace_all(token, " ", "")
        if trimmed != ""
            if str.contains(trimmed, ":")
                // Range like "2:2.5"
                parts = str.split(trimmed, ":")
                if array.size(parts) == 2
                    innerVal = str.tonumber(array.get(parts, 0))
                    outerVal = str.tonumber(array.get(parts, 1))
                    zones.push(DeviationZone.new(innerVal, outerVal, true))
            else
                // Single level like "1"
                level = str.tonumber(trimmed)
                zones.push(DeviationZone.new(level, level, false))
    zones

// Drawing helper - unified function for all deviation zones (singles and ranges)
drawDeviations(SessionData sess, float high, float low, float height, array<DeviationZone> zones, color deviationColor, color lineColor, bool showLines, bool showLabels, string labelPosition, color labelColor, string suffix, int startBarOffset, int endBarOffset, bool drawAbove, bool drawBelow) =>
    if array.size(zones) > 0 and (drawAbove or drawBelow)
        // Pre-compute label positioning (shared across all labels)
        baseLabelTime = labelPosition == "Left" ? sess.startTime : sess.endTime
        labelOffset = labelPosition == "Left" ? startBarOffset : endBarOffset
        labelX = timeWithOffset(baseLabelTime, labelOffset)
        labelStyle = labelPosition == "Left" ? label.style_label_right : label.style_label_left

        for zone in zones
            if zone.isRange
                // Draw range as box with labels at both edges
                if drawAbove
                    aboveFrom = high + (height * zone.innerLevel)
                    aboveTo = high + (height * zone.outerLevel)
                    sess.deviationBoxes.push(box.new(timeWithOffset(sess.startTime, startBarOffset), aboveFrom, timeWithOffset(sess.endTime, endBarOffset) + nz(sess.deviationExtendMs, 0), aboveTo, bgcolor=deviationColor, border_color=na, xloc=xloc.bar_time))
                    if showLabels
                        sess.labels.push(label.new(labelX, aboveFrom, toSansSerif("+" + str.tostring(zone.innerLevel) + suffix), style=labelStyle, color=labelsBgColor, textcolor=labelColor, size=size.tiny, xloc=xloc.bar_time))
                        sess.labels.push(label.new(labelX, aboveTo, toSansSerif("+" + str.tostring(zone.outerLevel) + suffix), style=labelStyle, color=labelsBgColor, textcolor=labelColor, size=size.tiny, xloc=xloc.bar_time))

                if drawBelow
                    belowFrom = low - (height * zone.innerLevel)
                    belowTo = low - (height * zone.outerLevel)
                    sess.deviationBoxes.push(box.new(timeWithOffset(sess.startTime, startBarOffset), belowFrom, timeWithOffset(sess.endTime, endBarOffset) + nz(sess.deviationExtendMs, 0), belowTo, bgcolor=deviationColor, border_color=na, xloc=xloc.bar_time))
                    if showLabels
                        sess.labels.push(label.new(labelX, belowFrom, toSansSerif("-" + str.tostring(zone.innerLevel) + suffix), style=labelStyle, color=labelsBgColor, textcolor=labelColor, size=size.tiny, xloc=xloc.bar_time))
                        sess.labels.push(label.new(labelX, belowTo, toSansSerif("-" + str.tostring(zone.outerLevel) + suffix), style=labelStyle, color=labelsBgColor, textcolor=labelColor, size=size.tiny, xloc=xloc.bar_time))
            else
                // Draw single level as line + label
                dev = zone.outerLevel

                if drawAbove and showLines
                    aboveLevel = high + (height * dev)
                    sess.lines.push(line.new(timeWithOffset(sess.startTime, startBarOffset), aboveLevel, timeWithOffset(sess.endTime, endBarOffset) + nz(sess.deviationExtendMs, 0), aboveLevel, color=lineColor, style=line.style_dotted, width=1, xloc=xloc.bar_time))
                    if showLabels
                        sess.labels.push(label.new(labelX, aboveLevel, toSansSerif("+" + str.tostring(dev) + suffix), style=labelStyle, color=labelsBgColor, textcolor=labelColor, size=size.tiny, xloc=xloc.bar_time))

                if drawBelow and showLines
                    belowLevel = low - (height * dev)
                    sess.lines.push(line.new(timeWithOffset(sess.startTime, startBarOffset), belowLevel, timeWithOffset(sess.endTime, endBarOffset) + nz(sess.deviationExtendMs, 0), belowLevel, color=lineColor, style=line.style_dotted, width=1, xloc=xloc.bar_time))
                    if showLabels
                        sess.labels.push(label.new(labelX, belowLevel, toSansSerif("-" + str.tostring(dev) + suffix), style=labelStyle, color=labelsBgColor, textcolor=labelColor, size=size.tiny, xloc=xloc.bar_time))

drawCoreBox(SessionData sess, float highPrice, float lowPrice) =>
    box.new(sess.startTime, highPrice, sess.endTime, lowPrice, bgcolor=sess.coreColor, border_color=na, xloc=xloc.bar_time)

calculateOffsets(SessionData sess, bool isBody) =>
    useOffset = sess.useOffset and sess.deviationMode == OPT_BOTH
    int startOffset = 0
    int endOffset = 0

    if useOffset
        rangeWidth = sess.endBar - sess.startBar
        if isBody
            startOffset := rangeWidth - ZONE_OFFSET_START
            endOffset := rangeWidth - ZONE_OFFSET_START + ZONE_OFFSET_BARS
        else
            startOffset := -(rangeWidth - ZONE_OFFSET_START + ZONE_OFFSET_BARS)
            endOffset := -(rangeWidth - ZONE_OFFSET_START)

    [startOffset, endOffset]

// Get cached deviation zones by session index
getCachedZones(int sessionIdx) =>
    switch sessionIdx
        IDX_0129 => cachedDeviations_0129
        IDX_NY_EARLY => cachedDeviations_ny_early
        IDX_OVERNIGHT => cachedDeviations_overnight
        IDX_PREMARKET => cachedDeviations_premarket
        IDX_IVB => cachedDeviations_ivb
        IDX_ASIA_OPEN => cachedDeviations_asia_open
        => na

isQuickCheckSession(int idx) =>
    idx == IDX_0129 or idx == IDX_ASIA_OPEN

isInFilter(int idx) =>
    if quickFilter == FILTER_ALL
        true
    else if quickFilter == FILTER_RAFAEL_1800
        idx == IDX_0129 or idx == IDX_ASIA_OPEN
    else if quickFilter == FILTER_RAFAEL_1800_EARLY
        idx == IDX_0129 or idx == IDX_ASIA_OPEN or idx == IDX_NY_EARLY
    else if quickFilter == FILTER_RAFAEL_1800_EARLY_IVB
        idx == IDX_0129 or idx == IDX_ASIA_OPEN or idx == IDX_NY_EARLY or idx == IDX_IVB
    else if quickFilter == FILTER_PREP2
        idx == IDX_0129 or idx == IDX_ASIA_OPEN or idx == IDX_NY_EARLY or idx == IDX_IVB or idx == IDX_PREMARKET
    else if quickFilter == FILTER_RAFAEL_1800_EARLY_OVERNIGHT
        idx == IDX_0129 or idx == IDX_ASIA_OPEN or idx == IDX_NY_EARLY or idx == IDX_OVERNIGHT
    else if quickFilter == FILTER_1800
        idx == IDX_ASIA_OPEN
    else if quickFilter == FILTER_1800_EARLY
        idx == IDX_ASIA_OPEN or idx == IDX_NY_EARLY
    else if quickFilter == FILTER_RAFAEL_1800_EARLY_PREMARKET_OVERNIGHT
        idx == IDX_0129 or idx == IDX_ASIA_OPEN or idx == IDX_OVERNIGHT or idx == IDX_PREMARKET or idx == IDX_NY_EARLY
    else if quickFilter == FILTER_IVB
        idx == IDX_IVB
    else if quickFilter == FILTER_NY_EARLY_IVB
        idx == IDX_NY_EARLY or idx == IDX_IVB
    else if quickFilter == FILTER_NY_EARLY_IVB_PREMARKET
        idx == IDX_NY_EARLY or idx == IDX_IVB or idx == IDX_PREMARKET
    else
        true

drawCoreWithDeviations(SessionData sess, float highPrice, float lowPrice, float height, bool isBody) =>
    // Quick check mode: skip deviations for Rafael, 1800
    bool skipDeviations = quickCheckMode and isQuickCheckSession(sess.sessionIndex)
    if not skipDeviations
        [startOffset, endOffset] = calculateOffsets(sess, isBody)
        // Position labels: when both deviations shown, body goes right and wick goes left
        labelPos = sess.deviationMode == OPT_BOTH ? (isBody ? "Right" : "Left") : "Left"
        suffix = isBody ? BODY_SUFFIX : WICK_SUFFIX
        zones = getCachedZones(sess.sessionIndex)

        // Determine whether to show labels based on dropdown value and body/wick type
        showLbls = showAllLabels and (sess.deviationLabelsMode == OPT_BOTH or (sess.deviationLabelsMode == OPT_BODY and isBody) or (sess.deviationLabelsMode == OPT_WICK and not isBody))

        // Draw all deviation zones (turning point zones get special color)
        drawDeviations(sess, highPrice, lowPrice, height, zones, sess.deviationColor, color.new(labelColor, DEVIATION_LINE_OPACITY), showAllLines, showLbls, labelPos, labelColor, suffix, startOffset, endOffset, true, true)

deleteSession(SessionData sess) =>
    if not na(sess.bodyBox)
        box.delete(sess.bodyBox)
    if not na(sess.wickBox)
        box.delete(sess.wickBox)
    for l in sess.lines
        line.delete(l)
    for lbl in sess.labels
        label.delete(lbl)
    for db in sess.deviationBoxes
        box.delete(db)
    // Delete mitigation lines
    if not na(sess.highMitigationLine)
        line.delete(sess.highMitigationLine)
    if not na(sess.lowMitigationLine)
        line.delete(sess.lowMitigationLine)
    for lbl in sess.highMitigationReminders
        label.delete(lbl)
    array.clear(sess.highMitigationReminders)
    for lbl in sess.lowMitigationReminders
        label.delete(lbl)
    array.clear(sess.lowMitigationReminders)
    if not na(sess.midMitigationLine)
        line.delete(sess.midMitigationLine)
    for lbl in sess.midMitigationLabels
        label.delete(lbl)
    array.clear(sess.midMitigationLabels)
    if not na(sess.retrace618Line)
        line.delete(sess.retrace618Line)
    for lbl in sess.retrace618Labels
        label.delete(lbl)
    array.clear(sess.retrace618Labels)
    // Delete pending mitigation lines
    if not na(sess.highPendingLine)
        line.delete(sess.highPendingLine)
    if not na(sess.lowPendingLine)
        line.delete(sess.lowPendingLine)
    if not na(sess.highPendingLabel)
        label.delete(sess.highPendingLabel)
    if not na(sess.lowPendingLabel)
        label.delete(sess.lowPendingLabel)
    // Delete IVB breakout extension projections
    for l in sess.extLines
        line.delete(l)
    array.clear(sess.extLines)
    for lbl in sess.extLabels
        label.delete(lbl)
    array.clear(sess.extLabels)
    // Delete unmitigated lines and labels
    if not na(sess.highUnmitigatedLine)
        line.delete(sess.highUnmitigatedLine)
    if not na(sess.highUnmitigatedLabel)
        label.delete(sess.highUnmitigatedLabel)
    if not na(sess.lowUnmitigatedLine)
        line.delete(sess.lowUnmitigatedLine)
    if not na(sess.lowUnmitigatedLabel)
        label.delete(sess.lowUnmitigatedLabel)

// Clear live drawings from active session (keeps session data, just removes visuals for redraw)
clearLiveDrawings(SessionData sess) =>
    if not na(sess.bodyBox)
        box.delete(sess.bodyBox)
        sess.bodyBox := na
    if not na(sess.wickBox)
        box.delete(sess.wickBox)
        sess.wickBox := na
    for l in sess.lines
        line.delete(l)
    array.clear(sess.lines)
    for lbl in sess.labels
        label.delete(lbl)
    array.clear(sess.labels)
    for db in sess.deviationBoxes
        box.delete(db)
    array.clear(sess.deviationBoxes)

// Draw live deviations for active session (uses projected end time)
drawLiveSessionDeviations(SessionData sess, int projectedEndTime, int currentBarIndex) =>
    // Set temporary end values for drawing
    sess.endTime := projectedEndTime
    sess.endBar := currentBarIndex

    // Calculate heights
    bodyHeight = sess.bodyHigh - sess.bodyLow
    wickHeight = sess.wickHigh - sess.wickLow

    // Draw core boxes
    if not skipsCore(sess.sessionIndex)
        sess.bodyBox := drawCoreBox(sess, sess.bodyHigh, sess.bodyLow)
        sess.wickBox := drawCoreBox(sess, sess.wickHigh, sess.wickLow)

    // Draw body deviations if mode is Body or Both
    if sess.deviationMode == OPT_BODY or sess.deviationMode == OPT_BOTH
        drawCoreWithDeviations(sess, sess.bodyHigh, sess.bodyLow, bodyHeight, true)

    // Draw wick deviations if mode is Wick or Both
    if sess.deviationMode == OPT_WICK or sess.deviationMode == OPT_BOTH
        drawCoreWithDeviations(sess, sess.wickHigh, sess.wickLow, wickHeight, false)

    if showAllLabels and showSessionNames
        labelX = int(math.round((sess.startTime + sess.endTime) / 2))
        labelY = sess.labelPosition == OPT_ABOVE ? sess.wickHigh : sess.wickLow
        labelStyle = sess.labelPosition == OPT_ABOVE ? label.style_label_down : label.style_label_up
        liveLabel = label.new(labelX, labelY, sess.chartLabel, style=labelStyle, textcolor=labelColor, size=size.tiny, color=labelsBgColor, textalign=text.align_center, xloc=xloc.bar_time)
        sess.labels.push(liveLabel)

// ═══════════════════════════════════════════════════════════════════════════
// INITIALIZATION
// ═══════════════════════════════════════════════════════════════════════════

if na(cachedDeviations_0129)
    // Parse and cache all deviation zones
    cachedDeviations_0129 := parseDeviationZones(deviations_2130_0129)
    cachedDeviations_ny_early := parseDeviationZones(deviations_0600_0900)
    cachedDeviations_overnight := parseDeviationZones(deviations_1600_0500)
    cachedDeviations_premarket := parseDeviationZones(deviations_0500_0915)
    cachedDeviations_ivb := parseDeviationZones(deviations_0930_1000)
    cachedDeviations_asia_open := parseDeviationZones(deviations_1800_2100)

// ═══════════════════════════════════════════════════════════════════════════
// SESSION CONFIGURATION - Single array replaces 14 parallel arrays
// ═══════════════════════════════════════════════════════════════════════════

var array<SessionConfig> sessionConfigs = array.from(
    SessionConfig.new(opening_2130_0129, opening_2130_0129_offset, opening_2130_0129_showLabels, 1290, 89, opening_2130_0129_coreColor, opening_2130_0129_deviationColor, SESSION_INTRADAY_0129, CHART_LABEL_0129, opening_2130_0129_labelPosition, opening_2130_0129_mitigation, opening_2130_0129_mitigationColor, opening_2130_0129_delayedMitigation, opening_2130_0129_extend, true, opening_2130_0129_retraceLabelTextColor, opening_2130_0129_retraceLabelBgColor, false, true, RETRACE_MODE_STANDARD),
    SessionConfig.new(opening_0600_0900, opening_0600_0900_offset, opening_0600_0900_showLabels, 360, 540, opening_0600_0900_coreColor, opening_0600_0900_deviationColor, SESSION_EXTENDED_0600_0900, CHART_LABEL_0600_0900, opening_0600_0900_labelPosition, opening_0600_0900_mitigation, opening_0600_0900_mitigationColor, false, opening_0600_0900_extend, true, opening_0600_0900_retraceLabelTextColor, opening_0600_0900_retraceLabelBgColor, true, opening_0600_0900_showRetracement, opening_0600_0900_retracementMode),
    SessionConfig.new(opening_1600_0500, opening_1600_0500_offset, opening_1600_0500_showLabels, 960, 300, opening_1600_0500_coreColor, opening_1600_0500_deviationColor, SESSION_EXTENDED_1600_0500, CHART_LABEL_1600_0500, opening_1600_0500_labelPosition, opening_1600_0500_mitigation, opening_1600_0500_mitigationColor, false, opening_1600_0500_extend, false, labelColor, labelsBgColor, false, true, RETRACE_MODE_STANDARD),
    SessionConfig.new(opening_0500_0915, opening_0500_0915_offset, opening_0500_0915_showLabels, 300, 555, opening_0500_0915_coreColor, opening_0500_0915_deviationColor, SESSION_EXTENDED_0500_0915, CHART_LABEL_0500_0915, opening_0500_0915_labelPosition, opening_0500_0915_mitigation, opening_0500_0915_mitigationColor, false, opening_0500_0915_extend, false, labelColor, labelsBgColor, false, true, RETRACE_MODE_STANDARD),
    SessionConfig.new(opening_1800_2100, opening_1800_2100_offset, opening_1800_2100_showLabels, 1080, 1260, opening_1800_2100_coreColor, opening_1800_2100_deviationColor, SESSION_EXTENDED_1800_2100, CHART_LABEL_1800_2100, opening_1800_2100_labelPosition, opening_1800_2100_mitigation, opening_1800_2100_mitigationColor, opening_1800_2100_delayedMitigation, opening_1800_2100_extend, true, opening_1800_2100_retraceLabelTextColor, opening_1800_2100_retraceLabelBgColor, false, true, RETRACE_MODE_STANDARD),
    SessionConfig.new(opening_0930_1000, opening_0930_1000_offset, opening_0930_1000_showLabels, IVB_START_MIN, IVB_END_MIN, opening_0930_1000_coreColor, opening_0930_1000_deviationColor, SESSION_EXTENDED_0930_1000, CHART_LABEL_0930_1000, opening_0930_1000_labelPosition, opening_0930_1000_mitigation, opening_0930_1000_mitigationColor, false, opening_0930_1000_extend, true, opening_0930_1000_retraceLabelTextColor, opening_0930_1000_retraceLabelBgColor, true, true, RETRACE_MODE_STANDARD)
)

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 1: SESSION DETECTION - Detect new sessions starting
// ═══════════════════════════════════════════════════════════════════════════

barMinutes = validChartContext ? hour(time, NY_TIMEZONE) * 60 + minute(time, NY_TIMEZONE) : 0
prevBarMinutes = validChartContext ? hour(time[1], NY_TIMEZONE) * 60 + minute(time[1], NY_TIMEZONE) : 0
currentDayStart = timestamp(NY_TIMEZONE, year(time, NY_TIMEZONE), month(time, NY_TIMEZONE), dayofmonth(time, NY_TIMEZONE), 0, 0)

// ═══════════════════════════════════════════════════════════════════════════
// 30M DATA - Confirmed close for IVB mitigation
// ═══════════════════════════════════════════════════════════════════════════

// Confirmed (closed) 30m close + its bar-open time, for IVB mitigation. close[1] + lookahead_on
// is the no-repaint idiom: returns only fully-closed 30m values. Single tuple request keeps it to one security call.
// Note: on a 30m chart this confirms one bar later than on lower TFs (the close is only known after the bar closes).
[htf30mClose, htf30mTime] = request.security(syminfo.tickerid, "30", [close[1], time[1]], lookahead=barmerge.lookahead_on)

// Time windows used by mitigation logic
PREMARKET_START_MIN = array.get(sessionConfigs, IDX_PREMARKET).startMin  // 300 = 05:00
CLOSE_1600_MIN = 960  // 16:00 = 16 * 60

if validChartContext
    for i = 0 to array.size(sessionConfigs) - 1
        SessionConfig cfg = array.get(sessionConfigs, i)

        if cfg.mode != OPT_HIDDEN and isInFilter(i)
            // Handle midnight-crossing sessions (e.g., 16:00-05:00)
            crossesMidnight = cfg.endMin < cfg.startMin

            // Check if we're entering this session
            currentlyInSession = isInSessionTime(barMinutes, cfg.startMin, cfg.endMin, crossesMidnight)
            previouslyInSession = isInSessionTime(prevBarMinutes, cfg.startMin, cfg.endMin, crossesMidnight)
            sessionStarted = currentlyInSession and not previouslyInSession

            if sessionStarted
                initBodyHigh = math.max(open, close)
                initBodyLow = math.min(open, close)
                initWickHigh = high
                initWickLow = low

                newSession = SessionData.new(
                     sessionIndex=i,
                     startBar=bar_index,
                     endBar=na,
                     startTime=time,
                     endTime=na,
                     actualEndTime=na,
                     bodyHigh=initBodyHigh,
                     bodyLow=initBodyLow,
                     wickHigh=initWickHigh,
                     wickLow=initWickLow,
                     bodyHeight=na,
                     wickHeight=na,
                     bodyBox=na,
                     wickBox=na,
                     lines=array.new<line>(),
                     labels=array.new<label>(),
                     deviationBoxes=array.new<box>(),
                     coreColor=cfg.coreColor,
                     deviationColor=cfg.deviationColor,
                     sessionName=cfg.name,
                     chartLabel=cfg.chartLabel,
                     useOffset=cfg.offset,
                     deviationMode=cfg.mode,
                     deviationLabelsMode=cfg.showLabels,
                     labelPosition=cfg.labelPosition,
                     showMitigation=cfg.mitigation,
                     mitigationColor=cfg.mitigationColor,
                     dominantHigh=na,
                     dominantLow=na,
                     highBar=bar_index,
                     lowBar=bar_index,
                     highTime=time,
                     lowTime=time,
                     highMitigated=false,
                     lowMitigated=false,
                     highMitigationBar=na,
                     lowMitigationBar=na,
                     highMitigationLine=na,
                     lowMitigationLine=na,
                     highMitigationReminders=array.new<label>(),
                     lowMitigationReminders=array.new<label>(),
                     highUnmitigatedLine=na,
                     lowUnmitigatedLine=na,
                     highUnmitigatedLabel=na,
                     lowUnmitigatedLabel=na,
                     midLevel=na,
                     midMitigated=false,
                     midMitigationLine=na,
                     midMitigationLabels=array.new<label>(),
                     midArmed=false,
                     retraceLevel618=na,
                     retrace618Mitigated=false,
                     retrace618Line=na,
                     retrace618Labels=array.new<label>(),
                     retrace618Armed=false,
                     ivbBreakTime=na,
                     ivbBreakSide=0,
                     ivbRetraceBar=na,
                     ivbRetraceCompleted=false,
                     delayedMitigation=cfg.delayedMitigation,
                     isKeySession=cfg.isKeySession,
                     retraceLabelTextColor=cfg.retraceLabelTextColor,
                     retraceLabelBgColor=cfg.retraceLabelBgColor,
                     retraceCapAt1600=cfg.retraceCapAt1600,
                     showRetracement=cfg.showRetracement,
                     retracementMode=cfg.retracementMode,
                     crossesMidnight=crossesMidnight,
                     provisionalHighMitigated=false,
                     provisionalLowMitigated=false,
                     provisionalHighTime=na,
                     provisionalLowTime=na,
                     highPendingLine=na,
                     lowPendingLine=na,
                     highPendingLabel=na,
                     lowPendingLabel=na,
                     deviationExtendMs=getSessionExtendMs(i),
                     extHighProcessed=false,
                     extLowProcessed=false,
                     extHighTime=na,
                     extLowTime=na,
                     extLines=array.new<line>(),
                     extLabels=array.new<label>()
                 )

                array.push(activeSessions, newSession)

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 2: SESSION TRACKING - Update all active sessions
// ═══════════════════════════════════════════════════════════════════════════

if validChartContext and array.size(activeSessions) > 0
    for sess in activeSessions
        idx = sess.sessionIndex
        SessionConfig sessCfg = array.get(sessionConfigs, idx)

        // Handle midnight-crossing sessions
        crossesMidnight = sessCfg.endMin < sessCfg.startMin

        // Check if current bar is within this session's time range
        isBarInSession = isInSessionTime(barMinutes, sessCfg.startMin, sessCfg.endMin, crossesMidnight)

        if isBarInSession
            // Update session high/low values with current bar
            currentBodyHigh = math.max(open, close)
            currentBodyLow = math.min(open, close)

            // Track bar index when new highs/lows are formed
            if high > sess.wickHigh
                sess.highBar := bar_index
                sess.highTime := time
            if low < sess.wickLow
                sess.lowBar := bar_index
                sess.lowTime := time

            // Update body/wick levels with current bar
            sess.bodyHigh := math.max(sess.bodyHigh, currentBodyHigh)
            sess.bodyLow := math.min(sess.bodyLow, currentBodyLow)
            sess.wickHigh := math.max(sess.wickHigh, high)
            sess.wickLow := math.min(sess.wickLow, low)

            // Live deviation drawing - clear and redraw each bar
            clearLiveDrawings(sess)
            // Calculate projected end time based on session's end minute
            projectedEndTime = crossesMidnight and barMinutes >= sessCfg.startMin ? currentDayStart + 24 * 60 * 60 * 1000 + sessCfg.endMin * 60 * 1000 : currentDayStart + sessCfg.endMin * 60 * 1000
            drawLiveSessionDeviations(sess, projectedEndTime, bar_index)

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 3: SESSION FINALIZATION - Finalize and remove ended sessions
// ═══════════════════════════════════════════════════════════════════════════

if validChartContext and array.size(activeSessions) > 0
    for i = array.size(activeSessions) - 1 to 0
        sess = array.get(activeSessions, i)
        idx = sess.sessionIndex
        SessionConfig endCfg = array.get(sessionConfigs, idx)
        int startMin = endCfg.startMin
        int endMin = endCfg.endMin

        // Handle midnight-crossing sessions
        crossesMidnight = endMin < startMin

        // Detect session end transition
        isCurrentBarInSession = isInSessionTime(barMinutes, startMin, endMin, crossesMidnight)
        wasPreviousBarInSession = isInSessionTime(prevBarMinutes, startMin, endMin, crossesMidnight)
        hasSessionEnded = not isCurrentBarInSession and wasPreviousBarInSession

        if hasSessionEnded
            // Finalize session - calculate heights and draw visualizations
            sess.endBar := bar_index - 1
            // Store actual session end time (for mitigation lines)
            sess.actualEndTime := not na(time[1]) ? time[1] : time
            sess.endTime := sess.actualEndTime

            // Clear live drawings before final draw
            clearLiveDrawings(sess)

            // Store heights for use in progressive unlock
            sess.bodyHeight := sess.bodyHigh - sess.bodyLow
            sess.wickHeight := sess.wickHigh - sess.wickLow
            bodyHeight = sess.bodyHeight
            wickHeight = sess.wickHeight

            // Calculate dominant high/low for mitigation tracking
            // Use wick extremes unless mode is Body-only
            if sess.deviationMode == OPT_BODY
                sess.dominantHigh := sess.bodyHigh
                sess.dominantLow := sess.bodyLow
            else
                sess.dominantHigh := sess.wickHigh
                sess.dominantLow := sess.wickLow

            // Calculate 50% level based on the larger range (both are always shown)
            if wickHeight >= bodyHeight
                sess.midLevel := (sess.wickHigh + sess.wickLow) / 2
            else
                sess.midLevel := (sess.bodyHigh + sess.bodyLow) / 2

            // Draw core boxes
            if not skipsCore(idx)
                sess.bodyBox := drawCoreBox(sess, sess.bodyHigh, sess.bodyLow)
                sess.wickBox := drawCoreBox(sess, sess.wickHigh, sess.wickLow)

            // Draw body deviations if mode is Body or Both
            if sess.deviationMode == OPT_BODY or sess.deviationMode == OPT_BOTH
                drawCoreWithDeviations(sess, sess.bodyHigh, sess.bodyLow, bodyHeight, true)

            // Draw wick deviations if mode is Wick or Both
            if sess.deviationMode == OPT_WICK or sess.deviationMode == OPT_BOTH
                drawCoreWithDeviations(sess, sess.wickHigh, sess.wickLow, wickHeight, false)

            // Draw session name label
            if showAllLabels and showSessionNames
                labelX = int(math.round((sess.startTime + sess.endTime) / 2))
                labelY = sess.labelPosition == OPT_ABOVE ? sess.wickHigh : sess.wickLow
                labelStyle = sess.labelPosition == OPT_ABOVE ? label.style_label_down : label.style_label_up
                sessionLabel = label.new(labelX, labelY, sess.chartLabel, style=labelStyle, textcolor=labelColor, size=size.tiny, color=labelsBgColor, textalign=text.align_center, xloc=xloc.bar_time)
                sess.labels.push(sessionLabel)

            // Add to completed sessions
            sessions.push(sess)

            // Remove oldest session of this type if limit exceeded
            sessionsOfThisType = 0
            for s in sessions
                if s.sessionIndex == sess.sessionIndex
                    sessionsOfThisType += 1

            if sessionsOfThisType > maxSessions
                // Find and delete the oldest session of this type
                for j = 0 to array.size(sessions) - 1
                    oldSession = array.get(sessions, j)
                    if oldSession.sessionIndex == sess.sessionIndex
                        deleteSession(oldSession)
                        array.remove(sessions, j)
                        break

            // Remove from active sessions
            array.remove(activeSessions, i)

// ═══════════════════════════════════════════════════════════════════════════
// IVB BREAKOUT EXTENSION STATISTICS
// ═══════════════════════════════════════════════════════════════════════════
// Rolling history of how far price travels beyond a broken IVB edge (10:00-16:00, same day),
// as a ratio of that day's IVB range. Each broken side contributes one sample. Tracked globally
// (not on SessionData) so the sample window survives maxSessions pruning. A day's samples are
// pushed at 16:00 (or the next day's open on early closes), so the projections drawn on a
// breach always come from prior days only.

type IvbExtState
    array<float> ratios  // Rolling excursion/range samples, capped at the lookback input
    float dayHigh        // Tracked day's IVB wick high (na = no day being tracked)
    float dayLow
    float maxAbove       // Max excursion above dayHigh so far (0 = side never broken)
    float maxBelow
    int dayStart         // currentDayStart of the tracked day, for rollover detection

var IvbExtState ivbExtState = IvbExtState.new(array.new<float>(), na, na, 0.0, 0.0, na)

ivbExtFeatureOn = opening_0930_1000_showExtensions and opening_0930_1000 != OPT_HIDDEN and isInFilter(IDX_IVB)

// Push the tracked day's excursion samples into the rolling window and reset the day state.
finalizeIvbExtDay(IvbExtState st) =>
    if not na(st.dayHigh) and st.dayHigh > st.dayLow
        float statRange = st.dayHigh - st.dayLow
        if st.maxAbove > 0
            array.push(st.ratios, st.maxAbove / statRange)
        if st.maxBelow > 0
            array.push(st.ratios, st.maxBelow / statRange)
        while array.size(st.ratios) > opening_0930_1000_extLookback
            array.shift(st.ratios)
    st.dayHigh := na
    st.dayLow := na
    st.maxAbove := 0.0
    st.maxBelow := 0.0

if validChartContext and ivbExtFeatureOn
    // Close out the tracked day at the 16:00 crossing, or at the first bar of a new NY day
    // (covers early closes that never print a 16:00 bar).
    bool crossed1600 = barMinutes >= CLOSE_1600_MIN and prevBarMinutes < CLOSE_1600_MIN
    if crossed1600 or (not na(ivbExtState.dayStart) and currentDayStart != ivbExtState.dayStart)
        finalizeIvbExtDay(ivbExtState)
    if barMinutes >= IVB_START_MIN and barMinutes <= IVB_END_MIN
        ivbExtState.dayHigh := na(ivbExtState.dayHigh) ? high : math.max(ivbExtState.dayHigh, high)
        ivbExtState.dayLow := na(ivbExtState.dayLow) ? low : math.min(ivbExtState.dayLow, low)
        ivbExtState.dayStart := currentDayStart
    else if barMinutes > IVB_END_MIN and barMinutes < CLOSE_1600_MIN and not na(ivbExtState.dayHigh)
        ivbExtState.maxAbove := math.max(ivbExtState.maxAbove, high - ivbExtState.dayHigh)
        ivbExtState.maxBelow := math.max(ivbExtState.maxBelow, ivbExtState.dayLow - low)

// Project the average / avg+1σ historical breakout extension from a broken IVB wick edge to 16:00.
// Called once per side, on the bar of the first strict wick breach before 16:00.
drawIvbExtensions(SessionData sess, bool brokeHigh) =>
    if ivbExtFeatureOn and showAllLines and barMinutes > IVB_END_MIN and barMinutes < CLOSE_1600_MIN and array.size(ivbExtState.ratios) >= IVB_EXT_MIN_SAMPLES
        // Statistics are trained on wick ranges, so projections must use the same basis even
        // when the IVB display/mitigation mode is configured to use body levels.
        float rangeHeight = sess.wickHigh - sess.wickLow
        float avgRatio = array.avg(ivbExtState.ratios)
        float stdRatio = array.stdev(ivbExtState.ratios)
        float direction = brokeHigh ? 1.0 : -1.0
        float edge = brokeHigh ? sess.wickHigh : sess.wickLow
        float avgLevel = edge + direction * rangeHeight * avgRatio
        float stdLevel = edge + direction * rangeHeight * (avgRatio + stdRatio)
        int endOfDay = currentDayStart + CLOSE_1600_MIN * 60 * 1000
        line avgLine = line.new(time, avgLevel, endOfDay, avgLevel, color=opening_0930_1000_extColor, style=line.style_dashed, width=opening_0930_1000_extWidth, xloc=xloc.bar_time)
        line stdLine = line.new(time, stdLevel, endOfDay, stdLevel, color=opening_0930_1000_extColor, style=line.style_dashed, width=opening_0930_1000_extWidth, xloc=xloc.bar_time)
        array.push(sess.extLines, avgLine)
        array.push(sess.extLines, stdLine)
        if showAllLabels
            for lbl in tile_line_labels(avgLine, avgLevel, LABEL_EXT_AVG, false, opening_0930_1000_extColor, labelsBgColor)
                array.push(sess.extLabels, lbl)
            for lbl in tile_line_labels(stdLine, stdLevel, LABEL_EXT_STD, false, opening_0930_1000_extColor, labelsBgColor)
                array.push(sess.extLabels, lbl)

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 4: MITIGATION DETECTION - Check for breaches on completed sessions
// ═══════════════════════════════════════════════════════════════════════════

// IVB-based retracement requires IVB enabled and in the active filter.
ivbFeatureAvailable = opening_0930_1000 != OPT_HIDDEN and isInFilter(IDX_IVB)

if validChartContext and array.size(sessions) > 0
    for sess in sessions
        if sess.showMitigation and not na(sess.dominantHigh)
            // Same-day mitigation: only track mitigations on the same calendar day (Asia Open is exempt)
            // For midnight-crossing sessions (e.g., Rafael's 21:30-01:29): extend to next calendar day (the day session ends)
            nextDayTimestamp = sess.startTime + 24 * 60 * 60 * 1000
            isOnSessionStartDay = isSameCalendarDay(sess.startTime, time)
            isOnSessionEndDay = sess.crossesMidnight and isSameCalendarDay(nextDayTimestamp, time)
            // For delayed mitigation sessions, overnight window extends to next day's early morning (before 05:00)
            isInNextDayOvernightWindow = sess.delayedMitigation and isSameCalendarDay(nextDayTimestamp, time) and barMinutes < PREMARKET_START_MIN
            isOnActualSessionDay = isOnSessionStartDay or isOnSessionEndDay or isInNextDayOvernightWindow
            shouldTrackMitigation = alwaysTrackMitigation(sess.sessionIndex) or isOnActualSessionDay
            // For delayed mitigation (Asia Open), only evaluate from 05:00 to 16:00 (excludes overnight evening hours)
            canEvaluateMitigation = shouldTrackMitigation and (not sess.delayedMitigation or (barMinutes >= PREMARKET_START_MIN and barMinutes < CLOSE_1600_MIN))
            // Provisional window = genuine overnight only (formation evening + next day pre-05:00). Excludes the next day's post-RTH hours so a holiday-delayed revisit confirms (caps the dash) instead of staying pending past 05:00 — see crossesMidnight sessions (Rafael) where an empty holiday RTH window left the dash running.
            isInOvernightWindow = sess.delayedMitigation and not canEvaluateMitigation and (isOnSessionStartDay or isInNextDayOvernightWindow)
            canEvaluateRetraceMitigation = not sess.retraceCapAt1600 or (shouldTrackMitigation and barMinutes < CLOSE_1600_MIN)
            bool showOpenKeyOverlay = mitigationMode == SESSION_MITIGATED and showUnmitigatedRafaelAsiaOpenLevels and alwaysTrackMitigation(sess.sessionIndex)
            bool showPersistentLevels = mitigationMode == SESSION_UNMITIGATED or showOpenKeyOverlay

            // Extensions have stricter semantics than IVB mitigation: mitigation starts on a
            // configured edge touch, while a breakout projection starts only after price exceeds
            // the IVB wick edge. Keep this independent from highMitigated/lowMitigated so Body mode
            // cannot consume a wick breakout before the extension is evaluated.
            if sess.sessionIndex == IDX_IVB and canEvaluateMitigation and barMinutes < CLOSE_1600_MIN
                if not sess.extHighProcessed and high > sess.wickHigh
                    sess.extHighProcessed := true
                    sess.extHighTime := time
                    drawIvbExtensions(sess, true)
                if not sess.extLowProcessed and low < sess.wickLow
                    sess.extLowProcessed := true
                    sess.extLowTime := time
                    drawIvbExtensions(sess, false)

            // === HIGH MITIGATION LOGIC ===
            if not sess.highMitigated
                if sess.sessionIndex == IDX_IVB
                    // IVB: solid until first wick touch (provisional), then dashed until a 30m candle CLOSES above — the actual mitigation
                    if not sess.provisionalHighMitigated and canEvaluateMitigation and high >= sess.dominantHigh
                        sess.provisionalHighMitigated := true
                        sess.provisionalHighTime := time
                        if mitigationMode == SESSION_MITIGATED
                            [solid, pending] = draw_provisional_breach_lines(showAllLines, sess.highTime, sess.dominantHigh, sess.mitigationColor)
                            sess.highMitigationLine := solid
                            sess.highPendingLine := pending
                    if sess.provisionalHighMitigated and not na(htf30mClose) and htf30mClose > sess.dominantHigh and isSameCalendarDay(sess.startTime, htf30mTime)
                        sess.highMitigated := true
                        sess.highMitigationBar := bar_index
                        if mitigationMode == SESSION_MITIGATED and not na(sess.highPendingLine)
                            line.set_x2(sess.highPendingLine, ivbConfirmationEndTime(htf30mTime, sess.provisionalHighTime, time, chart.is_range, BAR_MS))
                    if sess.provisionalHighMitigated and not na(sess.highPendingLine) and not sess.highMitigated and isOnSessionStartDay
                        line.set_x2(sess.highPendingLine, time)
                else if canEvaluateMitigation and high >= sess.dominantHigh
                    // Mitigation confirmed (either normal or after provisional overnight breach)
                    sess.highMitigated := true
                    sess.highMitigationBar := bar_index
                    if mitigationMode == SESSION_MITIGATED
                        line temp = draw_confirmed_mitigation_line(showAllLines, sess.provisionalHighMitigated, sess.highPendingLine, sess.highTime, sess.dominantHigh, sess.mitigationColor)
                        if not na(temp)
                            sess.highMitigationLine := temp

                else if isInOvernightWindow and high >= sess.dominantHigh
                    // Provisional breach during overnight - draw solid to breach, then dashed continuation
                    if not sess.provisionalHighMitigated
                        sess.provisionalHighMitigated := true
                        sess.provisionalHighTime := time
                        if mitigationMode == SESSION_MITIGATED
                            [solid, pending] = draw_provisional_breach_lines(showAllLines, sess.highTime, sess.dominantHigh, sess.mitigationColor)
                            sess.highMitigationLine := solid
                            sess.highPendingLine := pending

                else if high >= sess.dominantHigh
                    // Level taken outside same-day window (or outside market hours for always-track sessions)
                    sess.highMitigated := true
                    sess.highMitigationBar := bar_index
                    if alwaysTrackMitigation(sess.sessionIndex) and mitigationMode == SESSION_MITIGATED
                        line temp = draw_confirmed_mitigation_line(showAllLines, sess.provisionalHighMitigated, sess.highPendingLine, sess.highTime, sess.dominantHigh, sess.mitigationColor)
                        if not na(temp)
                            sess.highMitigationLine := temp

                // Extend pending line during overnight (before 05:00 confirmation window)
                if sess.sessionIndex != IDX_IVB and sess.provisionalHighMitigated and not na(sess.highPendingLine) and not sess.highMitigated
                    line.set_x2(sess.highPendingLine, time)

            // === LOW MITIGATION LOGIC ===
            if not sess.lowMitigated
                if sess.sessionIndex == IDX_IVB
                    // IVB: solid until first wick touch (provisional), then dashed until a 30m candle CLOSES below — the actual mitigation
                    if not sess.provisionalLowMitigated and canEvaluateMitigation and low <= sess.dominantLow
                        sess.provisionalLowMitigated := true
                        sess.provisionalLowTime := time
                        if mitigationMode == SESSION_MITIGATED
                            [solid, pending] = draw_provisional_breach_lines(showAllLines, sess.lowTime, sess.dominantLow, sess.mitigationColor)
                            sess.lowMitigationLine := solid
                            sess.lowPendingLine := pending
                    if sess.provisionalLowMitigated and not na(htf30mClose) and htf30mClose < sess.dominantLow and isSameCalendarDay(sess.startTime, htf30mTime)
                        sess.lowMitigated := true
                        sess.lowMitigationBar := bar_index
                        if mitigationMode == SESSION_MITIGATED and not na(sess.lowPendingLine)
                            line.set_x2(sess.lowPendingLine, ivbConfirmationEndTime(htf30mTime, sess.provisionalLowTime, time, chart.is_range, BAR_MS))
                    if sess.provisionalLowMitigated and not na(sess.lowPendingLine) and not sess.lowMitigated and isOnSessionStartDay
                        line.set_x2(sess.lowPendingLine, time)
                else if canEvaluateMitigation and low <= sess.dominantLow
                    // Mitigation confirmed (either normal or after provisional overnight breach)
                    sess.lowMitigated := true
                    sess.lowMitigationBar := bar_index
                    if mitigationMode == SESSION_MITIGATED
                        line temp = draw_confirmed_mitigation_line(showAllLines, sess.provisionalLowMitigated, sess.lowPendingLine, sess.lowTime, sess.dominantLow, sess.mitigationColor)
                        if not na(temp)
                            sess.lowMitigationLine := temp

                else if isInOvernightWindow and low <= sess.dominantLow
                    // Provisional breach during overnight - draw solid to breach, then dashed continuation
                    if not sess.provisionalLowMitigated
                        sess.provisionalLowMitigated := true
                        sess.provisionalLowTime := time
                        if mitigationMode == SESSION_MITIGATED
                            [solid, pending] = draw_provisional_breach_lines(showAllLines, sess.lowTime, sess.dominantLow, sess.mitigationColor)
                            sess.lowMitigationLine := solid
                            sess.lowPendingLine := pending

                else if low <= sess.dominantLow
                    // Level taken outside same-day window (or outside market hours for always-track sessions)
                    sess.lowMitigated := true
                    sess.lowMitigationBar := bar_index
                    if alwaysTrackMitigation(sess.sessionIndex) and mitigationMode == SESSION_MITIGATED
                        line temp = draw_confirmed_mitigation_line(showAllLines, sess.provisionalLowMitigated, sess.lowPendingLine, sess.lowTime, sess.dominantLow, sess.mitigationColor)
                        if not na(temp)
                            sess.lowMitigationLine := temp

                // Extend pending line during overnight (before 05:00 confirmation window)
                if sess.sessionIndex != IDX_IVB and sess.provisionalLowMitigated and not na(sess.lowPendingLine) and not sess.lowMitigated
                    line.set_x2(sess.lowPendingLine, time)

            // Right-edge session labels on still-open dashed pending lines; removed once mitigated (Unmitigated mode labels these itself)
            if mitigationMode == SESSION_MITIGATED
                sess.highPendingLabel := resolve_pending_label(showAllLines and showAllLabels and showPendingLabels and not sess.highMitigated, sess.highPendingLabel, sess.highPendingLine, sess.dominantHigh, sess.chartLabel, sess.mitigationColor)
                sess.lowPendingLabel := resolve_pending_label(showAllLines and showAllLabels and showPendingLabels and not sess.lowMitigated, sess.lowPendingLabel, sess.lowPendingLine, sess.dominantLow, sess.chartLabel, sess.mitigationColor)
                bool wantMitigationName = showAllLines and showAllLabels and showSessionNameOnMitigation and sess.isKeySession and not skipsMitigationName(sess.sessionIndex)
                string mitigationTxt = str.lower(sess.chartLabel)
                resolve_mitigation_reminders(wantMitigationName and shouldShowMitigationName(sess, true), sess.highMitigationReminders, sess.highMitigationLine, sess.dominantHigh, mitigationTxt, showMitigationReminders)
                resolve_mitigation_reminders(wantMitigationName and shouldShowMitigationName(sess, false), sess.lowMitigationReminders, sess.lowMitigationLine, sess.dominantLow, mitigationTxt, showMitigationReminders)

            // === CONSOLIDATED POST-MITIGATION CLEANUP (single check replaces duplicates) ===
            // Hand provisional overlay lines to the standard Mitigated presentation.
            bool highOverlayHandedOff = showOpenKeyOverlay and sess.provisionalHighMitigated
            bool lowOverlayHandedOff = showOpenKeyOverlay and sess.provisionalLowMitigated

            // Delete unmitigated line/label when HIGH is mitigated or handed off.
            if (sess.highMitigated or highOverlayHandedOff) and not na(sess.highUnmitigatedLine)
                line.delete(sess.highUnmitigatedLine)
                sess.highUnmitigatedLine := na
                if not na(sess.highUnmitigatedLabel)
                    label.delete(sess.highUnmitigatedLabel)
                    sess.highUnmitigatedLabel := na

            // Delete unmitigated line/label when LOW is mitigated or handed off.
            if (sess.lowMitigated or lowOverlayHandedOff) and not na(sess.lowUnmitigatedLine)
                line.delete(sess.lowUnmitigatedLine)
                sess.lowUnmitigatedLine := na
                if not na(sess.lowUnmitigatedLabel)
                    label.delete(sess.lowUnmitigatedLabel)
                    sess.lowUnmitigatedLabel := na

            // Anchor 0.618 off the first extreme taken; IVB mode may re-anchor below.
            if sess.isKeySession and na(sess.retraceLevel618)
                if sess.highMitigated and not sess.lowMitigated
                    sess.retraceLevel618 := sess.wickHigh - sess.wickHeight * 0.618
                else if sess.lowMitigated and not sess.highMitigated
                    sess.retraceLevel618 := sess.wickLow + sess.wickHeight * 0.618

            // Draw untouched levels in Unmitigated mode or as the Rafael + Asia overlay.
            if showPersistentLevels and showAllLines
                if mitigationMode == SESSION_UNMITIGATED
                    // Unmitigated mode owns its pending-line lifecycle.
                    bool shouldShowHighPending = not sess.highMitigated and sess.provisionalHighMitigated and shouldTrackMitigation
                    if not shouldShowHighPending and not na(sess.highPendingLine)
                        line.delete(sess.highPendingLine)
                        sess.highPendingLine := na
                    bool shouldShowLowPending = not sess.lowMitigated and sess.provisionalLowMitigated and shouldTrackMitigation
                    if not shouldShowLowPending and not na(sess.lowPendingLine)
                        line.delete(sess.lowPendingLine)
                        sess.lowPendingLine := na
                // Clean up unmitigated lines/labels if outside tracking window
                if not shouldTrackMitigation
                    if not na(sess.highUnmitigatedLine)
                        line.delete(sess.highUnmitigatedLine)
                        sess.highUnmitigatedLine := na
                    if not na(sess.highUnmitigatedLabel)
                        label.delete(sess.highUnmitigatedLabel)
                        sess.highUnmitigatedLabel := na
                    if not na(sess.lowUnmitigatedLine)
                        line.delete(sess.lowUnmitigatedLine)
                        sess.lowUnmitigatedLine := na
                    if not na(sess.lowUnmitigatedLabel)
                        label.delete(sess.lowUnmitigatedLabel)
                        sess.lowUnmitigatedLabel := na
                else
                    // Draw for sessions within tracking window (same-day or always-track)
                    // High unmitigated line and label
                    if not sess.highMitigated and (mitigationMode == SESSION_UNMITIGATED or not sess.provisionalHighMitigated)
                        if sess.provisionalHighMitigated
                            // Provisionally mitigated: solid to breach, dashed continuation
                            if na(sess.highPendingLine)
                                // Solid line already exists? Update its endpoint to breach time
                                if not na(sess.highUnmitigatedLine)
                                    line.set_x2(sess.highUnmitigatedLine, sess.provisionalHighTime)
                                else
                                    sess.highUnmitigatedLine := line.new(sess.highTime, sess.dominantHigh, sess.provisionalHighTime, sess.dominantHigh, color=sess.mitigationColor, style=line.style_solid, width=MITIGATION_LINE_WIDTH, xloc=xloc.bar_time)
                                sess.highPendingLine := line.new(sess.provisionalHighTime, sess.dominantHigh, time, sess.dominantHigh, color=sess.mitigationColor, style=line.style_dashed, width=MITIGATION_PENDING_LINE_WIDTH, xloc=xloc.bar_time)
                                if showAllLabels and na(sess.highUnmitigatedLabel)
                                    sess.highUnmitigatedLabel := label.new(time, sess.dominantHigh, sess.chartLabel, style=label.style_label_left, textcolor=labelColor, size=size.tiny, color=color.new(color.white, 100), xloc=xloc.bar_time)
                            else
                                line.set_x2(sess.highPendingLine, time)
                            if not na(sess.highUnmitigatedLabel)
                                label.set_x(sess.highUnmitigatedLabel, time)
                        else
                            // Not provisionally mitigated: solid line to current time
                            if na(sess.highUnmitigatedLine)
                                sess.highUnmitigatedLine := line.new(sess.highTime, sess.dominantHigh, time, sess.dominantHigh, color=sess.mitigationColor, style=line.style_solid, width=MITIGATION_LINE_WIDTH, xloc=xloc.bar_time)
                                if showAllLabels
                                    sess.highUnmitigatedLabel := label.new(time, sess.dominantHigh, sess.chartLabel, style=label.style_label_left, textcolor=labelColor, size=size.tiny, color=color.new(color.white, 100), xloc=xloc.bar_time)
                            else
                                line.set_x2(sess.highUnmitigatedLine, time)
                                if not na(sess.highUnmitigatedLabel)
                                    label.set_x(sess.highUnmitigatedLabel, time)
                    // Low unmitigated line and label
                    if not sess.lowMitigated and (mitigationMode == SESSION_UNMITIGATED or not sess.provisionalLowMitigated)
                        if sess.provisionalLowMitigated
                            // Provisionally mitigated: solid to breach, dashed continuation
                            if na(sess.lowPendingLine)
                                // Solid line already exists? Update its endpoint to breach time
                                if not na(sess.lowUnmitigatedLine)
                                    line.set_x2(sess.lowUnmitigatedLine, sess.provisionalLowTime)
                                else
                                    sess.lowUnmitigatedLine := line.new(sess.lowTime, sess.dominantLow, sess.provisionalLowTime, sess.dominantLow, color=sess.mitigationColor, style=line.style_solid, width=MITIGATION_LINE_WIDTH, xloc=xloc.bar_time)
                                sess.lowPendingLine := line.new(sess.provisionalLowTime, sess.dominantLow, time, sess.dominantLow, color=sess.mitigationColor, style=line.style_dashed, width=MITIGATION_PENDING_LINE_WIDTH, xloc=xloc.bar_time)
                                if showAllLabels and na(sess.lowUnmitigatedLabel)
                                    sess.lowUnmitigatedLabel := label.new(time, sess.dominantLow, sess.chartLabel, style=label.style_label_left, textcolor=labelColor, size=size.tiny, color=color.new(color.white, 100), xloc=xloc.bar_time)
                            else
                                line.set_x2(sess.lowPendingLine, time)
                            if not na(sess.lowUnmitigatedLabel)
                                label.set_x(sess.lowUnmitigatedLabel, time)
                        else
                            // Not provisionally mitigated: solid line to current time
                            if na(sess.lowUnmitigatedLine)
                                sess.lowUnmitigatedLine := line.new(sess.lowTime, sess.dominantLow, time, sess.dominantLow, color=sess.mitigationColor, style=line.style_solid, width=MITIGATION_LINE_WIDTH, xloc=xloc.bar_time)
                                if showAllLabels
                                    sess.lowUnmitigatedLabel := label.new(time, sess.dominantLow, sess.chartLabel, style=label.style_label_left, textcolor=labelColor, size=size.tiny, color=color.new(color.white, 100), xloc=xloc.bar_time)
                            else
                                line.set_x2(sess.lowUnmitigatedLine, time)
                                if not na(sess.lowUnmitigatedLabel)
                                    label.set_x(sess.lowUnmitigatedLabel, time)
            // Standard mode anchors from the first session extreme taken. IVB mode replaces that anchor
            // and direction with the first strict IVB wick break.
            bool usesIvbRetracement = sess.sessionIndex == IDX_NY_EARLY and sess.retracementMode == RETRACE_MODE_IVB
            bool retraceGateOpen = not usesIvbRetracement
            if usesIvbRetracement
                if na(sess.ivbBreakTime)
                    [ivbBreakTime, ivbBreakSide] = ivbBreakForDay(sess.startTime)
                    if not na(ivbBreakTime) and ivbBreakSide != 0
                        sess.ivbBreakTime := ivbBreakTime
                        sess.ivbBreakSide := ivbBreakSide
                        // The first IVB break defines the only valid return direction into NY Early.
                        sess.retraceLevel618 := ivbBreakSide == 1 ? sess.wickHigh - sess.wickHeight * 0.618 : sess.wickLow + sess.wickHeight * 0.618
                        // Arm each level only if the IVB break established price on that level's
                        // originating side. Otherwise a later bar must establish that side first.
                        sess.midArmed := ivbBreakSide == 1 ? high > sess.midLevel : low < sess.midLevel
                        sess.retrace618Armed := ivbBreakSide == 1 ? high > sess.retraceLevel618 : low < sess.retraceLevel618
                // A retracement must occur after the IVB break bar. The break bar itself cannot prove
                // whether its IVB breach or its retracement-level touch happened first.
                retraceGateOpen := ivbFeatureAvailable and not na(sess.ivbBreakTime) and time > sess.ivbBreakTime
            bool canDrawRetrace = sess.showRetracement and retraceGateOpen

            // Check for 50% mitigation (only after an extreme has been mitigated, only in Mitigated mode)
            // Use high/low to detect touches (including wicks), but only AFTER the first mitigation bar
            bool requiredOriginMitigated = usesIvbRetracement ? (sess.ivbBreakSide == 1 ? sess.highMitigated : sess.ivbBreakSide == -1 and sess.lowMitigated) : (sess.highMitigated or sess.lowMitigated)
            if mitigationMode == SESSION_MITIGATED and sess.sessionIndex != IDX_PREMARKET and canEvaluateRetraceMitigation and canDrawRetrace and requiredOriginMitigated and not sess.midMitigated and not na(sess.midLevel)
                // Standard mode follows the first session extreme taken. IVB mode follows the first
                // IVB wick broken: high break retraces down, low break retraces up.
                bool lowWasFirst = sess.lowMitigated and (not sess.highMitigated or sess.lowMitigationBar < sess.highMitigationBar)
                bool retracingUp = usesIvbRetracement ? sess.ivbBreakSide == -1 : lowWasFirst
                firstMitigationBar = usesIvbRetracement ? (sess.ivbBreakSide == 1 ? nz(sess.highMitigationBar, 0) : nz(sess.lowMitigationBar, 0)) : (lowWasFirst ? nz(sess.lowMitigationBar, 0) : nz(sess.highMitigationBar, 0))
                // Only check on bars AFTER the mitigation bar (not the same bar)
                if bar_index > firstMitigationBar
                    bool wasMidArmed = sess.midArmed
                    if usesIvbRetracement and not sess.midArmed and (retracingUp ? low < sess.midLevel : high > sess.midLevel)
                        sess.midArmed := true
                    bool retraceArmed = not usesIvbRetracement or wasMidArmed
                    bool retraceCondition = retraceArmed and (retracingUp ? high >= sess.midLevel : low <= sess.midLevel)
                    if retraceCondition
                        sess.midMitigated := true
                        if showAllLines
                            sess.midMitigationLine := line.new(sess.actualEndTime, sess.midLevel, time, sess.midLevel, color=sess.mitigationColor, style=line.style_dotted, width=MITIGATION_50_LINE_WIDTH, xloc=xloc.bar_time)
                            if showAllLabels and sess.isKeySession
                                sess.midMitigationLabels := tile_line_labels(sess.midMitigationLine, sess.midLevel, LABEL_RETRACE_50, showMitigationReminders, sess.retraceLabelTextColor, sess.retraceLabelBgColor)

            // Use high/low to detect touches (including wicks), but only AFTER the first mitigation bar
            if mitigationMode == SESSION_MITIGATED and canEvaluateRetraceMitigation and canDrawRetrace and requiredOriginMitigated and not sess.retrace618Mitigated and not na(sess.retraceLevel618) and not na(sess.midLevel)
                bool retracingUp618 = usesIvbRetracement ? sess.ivbBreakSide == -1 : sess.retraceLevel618 > sess.midLevel
                // Get the FIRST mitigation bar (whichever extreme was mitigated first)
                bool lowWasFirstCalc = sess.lowMitigated and (not sess.highMitigated or sess.lowMitigationBar < sess.highMitigationBar)
                firstMitigationBar618 = usesIvbRetracement ? (sess.ivbBreakSide == 1 ? nz(sess.highMitigationBar, 0) : nz(sess.lowMitigationBar, 0)) : (lowWasFirstCalc ? nz(sess.lowMitigationBar, 0) : nz(sess.highMitigationBar, 0))
                // Only check on bars AFTER the mitigation bar (not the same bar)
                if bar_index > firstMitigationBar618
                    bool was618Armed = sess.retrace618Armed
                    if usesIvbRetracement and not sess.retrace618Armed and (retracingUp618 ? low < sess.retraceLevel618 : high > sess.retraceLevel618)
                        sess.retrace618Armed := true
                    bool armed618 = not usesIvbRetracement or was618Armed
                    bool retraceCondition618 = armed618 and (retracingUp618 ? high >= sess.retraceLevel618 : low <= sess.retraceLevel618)
                    if retraceCondition618
                        sess.retrace618Mitigated := true
                        if showAllLines
                            sess.retrace618Line := line.new(sess.actualEndTime, sess.retraceLevel618, time, sess.retraceLevel618, color=sess.mitigationColor, style=line.style_dotted, width=MITIGATION_618_LINE_WIDTH, xloc=xloc.bar_time)
                            if showAllLabels
                                sess.retrace618Labels := tile_line_labels(sess.retrace618Line, sess.retraceLevel618, LABEL_RETRACE_618, showMitigationReminders, sess.retraceLabelTextColor, sess.retraceLabelBgColor)

            // An IVB-based NY Early retracement completes only when the denoted return continues to
            // the opposite NY Early boundary (1.0). Earlier touches of that boundary do not count.
            if usesIvbRetracement and na(sess.ivbRetraceBar) and (sess.midMitigated or sess.retrace618Mitigated)
                sess.ivbRetraceBar := bar_index
            if usesIvbRetracement and not sess.ivbRetraceCompleted and not na(sess.ivbRetraceBar) and bar_index > sess.ivbRetraceBar
                bool reachedOppositeBoundary = sess.ivbBreakSide == 1 ? low <= sess.wickLow : sess.ivbBreakSide == -1 and high >= sess.wickHigh
                if reachedOppositeBoundary
                    sess.ivbRetraceCompleted := true

            // Standard retracements complete once both session extremes are reached. NY Early's
            // IVB-based mode instead uses the ordered completion state above.
            bool retracementCompleteForFade = usesIvbRetracement ? sess.ivbRetraceCompleted : sess.highMitigated and sess.lowMitigated
            if fadeCompletedRetracements and retracementCompleteForFade and (sess.midMitigated or sess.retrace618Mitigated)
                fadeRetraceElements(sess.midMitigationLine, sess.midMitigationLabels, sess.mitigationColor, sess.retraceLabelTextColor, sess.retraceLabelBgColor)
                fadeRetraceElements(sess.retrace618Line, sess.retrace618Labels, sess.mitigationColor, sess.retraceLabelTextColor, sess.retraceLabelBgColor)

    // Combine overlapping unmitigated labels (only on last bar for performance)
    if barstate.islast and showAllLines and showAllLabels and mitigationMode == SESSION_UNMITIGATED and array.size(sessions) > 1
        LABEL_OVERLAP_PCT = 0.005  // 0.005% of price tolerance
        // Combine HIGH labels at same price
        for i = 0 to array.size(sessions) - 2
            sessA = array.get(sessions, i)
            if na(sessA.highUnmitigatedLabel) or na(sessA.dominantHigh)
                continue
            tolerance = sessA.dominantHigh * LABEL_OVERLAP_PCT / 100
            for j = i + 1 to array.size(sessions) - 1
                sessB = array.get(sessions, j)
                if na(sessB.highUnmitigatedLabel) or na(sessB.dominantHigh)
                    continue
                if math.abs(sessA.dominantHigh - sessB.dominantHigh) <= tolerance
                    existingText = label.get_text(sessA.highUnmitigatedLabel)
                    newText = existingText + " / " + sessB.chartLabel
                    label.set_text(sessA.highUnmitigatedLabel, newText)
                    label.delete(sessB.highUnmitigatedLabel)
                    sessB.highUnmitigatedLabel := na
        // Combine LOW labels at same price
        for i = 0 to array.size(sessions) - 2
            sessA = array.get(sessions, i)
            if na(sessA.lowUnmitigatedLabel) or na(sessA.dominantLow)
                continue
            tolerance = sessA.dominantLow * LABEL_OVERLAP_PCT / 100
            for j = i + 1 to array.size(sessions) - 1
                sessB = array.get(sessions, j)
                if na(sessB.lowUnmitigatedLabel) or na(sessB.dominantLow)
                    continue
                if math.abs(sessA.dominantLow - sessB.dominantLow) <= tolerance
                    existingText = label.get_text(sessA.lowUnmitigatedLabel)
                    newText = existingText + " / " + sessB.chartLabel
                    label.set_text(sessA.lowUnmitigatedLabel, newText)
                    label.delete(sessB.lowUnmitigatedLabel)
                    sessB.lowUnmitigatedLabel := na

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 5: DEVIATION GLOW - Darken deviation zones when price touches them
// ═══════════════════════════════════════════════════════════════════════════
//
// Architecture: Uses global maps (glowTouchTimes, glowOriginalColors) with string keys
// to track state. This avoids complexity with UDT array references and ensures
// reliable state persistence across bars.
//
// Logic:
// 1. Only process the most recent session of each type
// 2. For each session, check if current time is within glow window (session end + X hours)
// 3. For each deviation box:
//    - If within window AND price touches box: record touch, darken
//    - If within window AND previously touched: keep darkened
//    - If outside window: restore original color, clear touch record

if validChartContext and enableDeviationGlow and array.size(sessions) > 0
    glowWindowMs = int(glowWindowHours * 60 * 60 * 1000)

    // Track which session types we've processed (reset each bar)
    var array<int> processedTypes = array.new<int>()
    array.clear(processedTypes)

    // Process sessions newest-first to find most recent of each type
    for j = array.size(sessions) - 1 to 0
        sess = array.get(sessions, j)

        // Skip if no deviation boxes
        boxCount = array.size(sess.deviationBoxes)
        if boxCount == 0
            continue

        // If we've already processed a newer session of this type, reset this older one
        if array.includes(processedTypes, sess.sessionIndex)
            for i = 0 to boxCount - 1
                resetGlowBox(array.get(sess.deviationBoxes, i), getGlowBoxKey(sess.sessionIndex, sess.startTime, i))
            continue
        array.push(processedTypes, sess.sessionIndex)

        // Get session end time (required for window calculation)
        sessionEndTime = nz(sess.actualEndTime, sess.endTime)
        if na(sessionEndTime) or sessionEndTime == 0
            continue

        // Determine if we're within the glow window
        withinWindow = time <= sessionEndTime + glowWindowMs

        // Process each deviation box
        for i = 0 to boxCount - 1
            devBox = array.get(sess.deviationBoxes, i)
            boxKey = getGlowBoxKey(sess.sessionIndex, sess.startTime, i)

            // Store original color on first encounter (use session's deviation color)
            if not map.contains(glowOriginalColors, boxKey)
                map.put(glowOriginalColors, boxKey, sess.deviationColor)

            originalColor = map.get(glowOriginalColors, boxKey)

            if withinWindow
                // Get box price bounds (handle potential top/bottom swap)
                boxHigh = math.max(box.get_top(devBox), box.get_bottom(devBox))
                boxLow = math.min(box.get_top(devBox), box.get_bottom(devBox))

                // Check if current bar touches the box
                touched = high >= boxLow and low <= boxHigh

                if touched
                    // Record touch and apply darkening
                    map.put(glowTouchTimes, boxKey, time)
                    box.set_bgcolor(devBox, darkenColor(originalColor, glowDarkenPercent))
                else
                    // Check if previously touched (within this window period)
                    if map.contains(glowTouchTimes, boxKey) and map.get(glowTouchTimes, boxKey) > 0
                        // Keep darkened
                        box.set_bgcolor(devBox, darkenColor(originalColor, glowDarkenPercent))
                    else
                        // Not touched - ensure original color
                        box.set_bgcolor(devBox, originalColor)
            else
                // Outside window - restore original color and clear touch record
                resetGlowBox(devBox, boxKey)

// ═══════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE - Dynamic display based on active sessions
// ═══════════════════════════════════════════════════════════════════════════

addSessionColorRows(table tbl, int startRow, string sessionName, color coreClr, color devClr, color mitClr, bool showMit) =>
    table.cell(tbl, 0, startRow, sessionName, text_size=size.small, text_color=color.black)
    table.cell(tbl, 1, startRow, "Core", text_size=size.small, text_color=color.black)
    table.cell(tbl, 2, startRow, str.format("R:{0} G:{1} B:{2}", int(color.r(coreClr)), int(color.g(coreClr)), int(color.b(coreClr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 3, startRow, str.tostring(int(color.t(coreClr))), text_size=size.small, text_color=color.black)

    table.cell(tbl, 0, startRow + 1, sessionName, text_size=size.small, text_color=color.black)
    table.cell(tbl, 1, startRow + 1, "Deviation", text_size=size.small, text_color=color.black)
    table.cell(tbl, 2, startRow + 1, str.format("R:{0} G:{1} B:{2}", int(color.r(devClr)), int(color.g(devClr)), int(color.b(devClr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 3, startRow + 1, str.tostring(int(color.t(devClr))), text_size=size.small, text_color=color.black)

    int rowsAdded = 2
    if showMit
        table.cell(tbl, 0, startRow + rowsAdded, sessionName, text_size=size.small, text_color=color.black)
        table.cell(tbl, 1, startRow + rowsAdded, "Mitigation", text_size=size.small, text_color=color.black)
        table.cell(tbl, 2, startRow + rowsAdded, str.format("R:{0} G:{1} B:{2}", int(color.r(mitClr)), int(color.g(mitClr)), int(color.b(mitClr))), text_size=size.small, text_color=color.black)
        table.cell(tbl, 3, startRow + rowsAdded, str.tostring(int(color.t(mitClr))), text_size=size.small, text_color=color.black)
        rowsAdded += 1
    rowsAdded

addSingleColorRow(table tbl, int row, string name, color clr) =>
    table.cell(tbl, 0, row, name, text_size=size.small, text_color=color.black)
    table.cell(tbl, 1, row, "-", text_size=size.small, text_color=color.black)
    table.cell(tbl, 2, row, str.format("R:{0} G:{1} B:{2}", int(color.r(clr)), int(color.g(clr)), int(color.b(clr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 3, row, str.tostring(int(color.t(clr))), text_size=size.small, text_color=color.black)

addSessionStyleColorRow(table tbl, int row, string sessionName, string styleName, color clr) =>
    table.cell(tbl, 0, row, sessionName, text_size=size.small, text_color=color.black)
    table.cell(tbl, 1, row, styleName, text_size=size.small, text_color=color.black)
    table.cell(tbl, 2, row, str.format("R:{0} G:{1} B:{2}", int(color.r(clr)), int(color.g(clr)), int(color.b(clr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 3, row, str.tostring(int(color.t(clr))), text_size=size.small, text_color=color.black)

addRetracementColorRows(table tbl, int startRow, string sessionName, color textClr, color bgClr) =>
    addSessionStyleColorRow(tbl, startRow, sessionName, "Retracement Text", textClr)
    addSessionStyleColorRow(tbl, startRow + 1, sessionName, "Retracement Bg", bgClr)
    2

if validChartContext and showColorTable and barstate.islast
    var table colorTable = table.new(position.top_right, 4, COLOR_TABLE_MAX_ROWS, bgcolor=color.white, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

    // Header row
    table.cell(colorTable, 0, 0, "Session", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 1, 0, "Type", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 2, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 3, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)

    int currentRow = 1

    // Only show colors for sessions that are BOTH enabled AND in current Quick Filter
    if opening_2130_0129 != OPT_HIDDEN and isInFilter(IDX_0129)
        currentRow += addSessionColorRows(colorTable, currentRow, SESSION_INTRADAY_0129, opening_2130_0129_coreColor, opening_2130_0129_deviationColor, opening_2130_0129_mitigationColor, opening_2130_0129_mitigation)
        currentRow += addRetracementColorRows(colorTable, currentRow, SESSION_INTRADAY_0129, opening_2130_0129_retraceLabelTextColor, opening_2130_0129_retraceLabelBgColor)

    if opening_0600_0900 != OPT_HIDDEN and isInFilter(IDX_NY_EARLY)
        currentRow += addSessionColorRows(colorTable, currentRow, "NY Early", opening_0600_0900_coreColor, opening_0600_0900_deviationColor, opening_0600_0900_mitigationColor, opening_0600_0900_mitigation)
        currentRow += addRetracementColorRows(colorTable, currentRow, "NY Early", opening_0600_0900_retraceLabelTextColor, opening_0600_0900_retraceLabelBgColor)

    if opening_1600_0500 != OPT_HIDDEN and isInFilter(IDX_OVERNIGHT)
        currentRow += addSessionColorRows(colorTable, currentRow, SESSION_EXTENDED_1600_0500, opening_1600_0500_coreColor, opening_1600_0500_deviationColor, opening_1600_0500_mitigationColor, opening_1600_0500_mitigation)

    if opening_0500_0915 != OPT_HIDDEN and isInFilter(IDX_PREMARKET)
        currentRow += addSessionColorRows(colorTable, currentRow, SESSION_EXTENDED_0500_0915, opening_0500_0915_coreColor, opening_0500_0915_deviationColor, opening_0500_0915_mitigationColor, opening_0500_0915_mitigation)

    if opening_0930_1000 != OPT_HIDDEN and isInFilter(IDX_IVB)
        currentRow += addSessionColorRows(colorTable, currentRow, SESSION_EXTENDED_0930_1000, opening_0930_1000_coreColor, opening_0930_1000_deviationColor, opening_0930_1000_mitigationColor, opening_0930_1000_mitigation)
        currentRow += addRetracementColorRows(colorTable, currentRow, SESSION_EXTENDED_0930_1000, opening_0930_1000_retraceLabelTextColor, opening_0930_1000_retraceLabelBgColor)
        if opening_0930_1000_showExtensions
            addSessionStyleColorRow(colorTable, currentRow, SESSION_EXTENDED_0930_1000, "Extensions · Dashed · " + str.tostring(opening_0930_1000_extWidth), opening_0930_1000_extColor)
            currentRow += 1

    if opening_1800_2100 != OPT_HIDDEN and isInFilter(IDX_ASIA_OPEN)
        currentRow += addSessionColorRows(colorTable, currentRow, SESSION_EXTENDED_1800_2100, opening_1800_2100_coreColor, opening_1800_2100_deviationColor, opening_1800_2100_mitigationColor, opening_1800_2100_mitigation)
        currentRow += addRetracementColorRows(colorTable, currentRow, SESSION_EXTENDED_1800_2100, opening_1800_2100_retraceLabelTextColor, opening_1800_2100_retraceLabelBgColor)

    // General colors
    addSingleColorRow(colorTable, currentRow, "Labels Bg", labelsBgColor)
    currentRow += 1

    addSingleColorRow(colorTable, currentRow, "Label", labelColor)
    currentRow += 1

    if showOnlyEnabled
        addSingleColorRow(colorTable, currentRow, LABEL_HIDDEN_CANDLES, hiddenCandleColor)

// ═══════════════════════════════════════════════════════════════════════════
// SHOW ONLY (CANDLE ISOLATION)
// ═══════════════════════════════════════════════════════════════════════════
// The dropdown picks one recurring NY-time window to keep visible; a bar is greyed when it falls OUTSIDE
// that window. Windows are evaluated from const session strings (time() needs consts) and selected by mode.
showOnlyTimeframeAllowed = chart.is_range or timeframe.in_seconds(timeframe.period) <= SHOW_ONLY_MAX_TIMEFRAME_SECONDS
// Pick the chosen window first, then do ONE session lookup per bar instead of evaluating all six.
activeShowOnlySession = visibleWindow == SHOW_FROM_0500 ? SESSION_WINDOW_FROM_0500 : visibleWindow == SHOW_FROM_0830 ? SESSION_WINDOW_FROM_0830 : visibleWindow == SHOW_RTH ? SESSION_WINDOW_RTH : SESSION_WINDOW_OVERNIGHT
inVisibleWindow = not na(time(timeframe.period, activeShowOnlySession, NY_TIMEZONE))
// Most Recent Only narrows the lit window to the current NY calendar day; only pay the date math when it's on.
bool inMostRecentDay = true
if showOnlyMostRecent
    inMostRecentDay := dayofmonth(time, NY_TIMEZONE) == dayofmonth(timenow, NY_TIMEZONE) and month(time, NY_TIMEZONE) == month(timenow, NY_TIMEZONE) and year(time, NY_TIMEZONE) == year(timenow, NY_TIMEZONE)
hideThisBar = showOnlyEnabled and showOnlyTimeframeAllowed and not (inVisibleWindow and (not showOnlyMostRecent or inMostRecentDay))

plotcandle(hideThisBar ? open : na, high, low, close, color=hiddenCandleColor, bordercolor=hiddenCandleColor, wickcolor=hiddenCandleColor, editable=false, display=display.pane, force_overlay=true)

// deviations •
