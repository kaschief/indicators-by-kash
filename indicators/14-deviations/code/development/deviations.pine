// ═══════════════════════════════════════════════════════════════════════════
// SESSION VARIABLES
// ═══════════════════════════════════════════════════════════════════════════

var array<SessionData> sessions = array.new<SessionData>()
var array<SessionData> activeSessions = array.new<SessionData>()
var array<SessionData> lifecycleSessions = array.new<SessionData>()
var array<SessionData> latestCompletedSessions = array.new<SessionData>(5)
var array<SessionData> latestGlowSessions = array.new<SessionData>(5)
var array<SessionData> renderedFocusSessions = array.new<SessionData>()
var array<int> completedLifecycleIndices = array.new<int>()
var array<FocusCandidate> focusCandidatesCache = array.new<FocusCandidate>()
var array<FocusCandidate> focusRankedCache = array.new<FocusCandidate>()
var array<int> selectedFocusIndices = array.new<int>()
var array<SessionData> highOverlapCandidates = array.new<SessionData>()
var array<SessionData> lowOverlapCandidates = array.new<SessionData>()
var line focusAnchorLine = na
var label focusAnchorLabel = na

// Cached parsed deviation zones (Pine Script doesn't support nested collections)
var array<DeviationZone> cachedDeviations_0129 = na
var array<DeviationZone> cachedDeviations_ny_early = na
var array<DeviationZone> cachedDeviations_premarket = na
var array<DeviationZone> cachedDeviations_ivb = na
var array<DeviationZone> cachedDeviations_asia_open = na

// Glow state keyed by deviation box / IVB extension line.
var map<string, int> glowTouchTimes = map.new<string, int>()
var map<string, color> glowOriginalColors = map.new<string, color>()
var map<string, int> ivbExtensionGlowTouchTimes = map.new<string, int>()  // lineKey -> touch timestamp
var map<int, float> ivbHighByDay = map.new<int, float>()
var map<int, float> ivbLowByDay = map.new<int, float>()
var map<int, int> ivbBreakTimeByDay = map.new<int, int>()
var map<int, int> ivbBreakSideByDay = map.new<int, int>()
var map<int, bool> selectedFocusSessionKeys = map.new<int, bool>()

// Constants for performance
BODY_SUFFIX = "B"
WICK_SUFFIX = "W"
ZONE_OFFSET_BARS = 1  // Width of offset zones in bars
ZONE_OFFSET_START = 0  // How many bars into the range before zones start (0 = at range end, 2 = 2 bars before range end)
DEVIATION_LINE_OPACITY = 60
BAR_MS = int(timeframe.in_seconds() * 1000)

// ═══════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════

// Sessions that show deviations only (no core boxes)
skipsCore(int idx) =>
    idx == IDX_PREMARKET or (hideNyEarlyIvbCores and (idx == IDX_NY_EARLY or idx == IDX_IVB))

// Key sessions whose mitigated high/low line should NOT carry the session-name reminder.
skipsMitigationName(int idx) =>
    idx == IDX_NY_EARLY

deleteLines(array<line> lines) =>
    for ln in lines
        line.delete(ln)
    array.clear(lines)

deleteLabels(array<label> labels) =>
    for lbl in labels
        label.delete(lbl)
    array.clear(labels)

// Parsing helpers
parseTimeToMinutes(string timeStr) =>
    hour = str.tonumber(str.substring(timeStr, 0, 2))
    minute = str.tonumber(str.substring(timeStr, 3, 5))
    int(hour * 60 + minute)

// NY calendar-day key (yyyymmdd); precomputed so per-bar day checks avoid timezone datetime calls.
dayKey(int t) =>
    year(t, NY_TIMEZONE) * 10000 + month(t, NY_TIMEZONE) * 100 + dayofmonth(t, NY_TIMEZONE)

// Session windows include their start minute and exclude their end minute.
isInSessionTime(int minutes, int startMin, int endMin, bool crossesMidnight) =>
    crossesMidnight ? (minutes >= startMin or minutes < endMin) : (minutes >= startMin and minutes < endMin)

sessionPriceState(int startMin, int endMin) =>
    int minutes = hour(time, NY_TIMEZONE) * 60 + minute(time, NY_TIMEZONE)
    bool crossesMidnight = endMin < startMin
    bool inSession = isInSessionTime(minutes, startMin, endMin, crossesMidnight)
    bool sessionStarted = inSession and not inSession[1]
    var float sessionBodyHigh = na
    var float sessionBodyLow = na
    var float sessionWickHigh = na
    var float sessionWickLow = na
    var int sessionHighTime = na
    var int sessionLowTime = na
    var int sessionDayKey = na
    var int sessionStartTime = na

    if sessionStarted
        sessionBodyHigh := math.max(open, close)
        sessionBodyLow := math.min(open, close)
        sessionWickHigh := high
        sessionWickLow := low
        sessionHighTime := time
        sessionLowTime := time
        sessionDayKey := dayKey(time)
        sessionStartTime := time
    else if inSession
        float currentBodyHigh = math.max(open, close)
        float currentBodyLow = math.min(open, close)
        if high > sessionWickHigh
            sessionHighTime := time
        if low < sessionWickLow
            sessionLowTime := time
        sessionBodyHigh := math.max(sessionBodyHigh, currentBodyHigh)
        sessionBodyLow := math.min(sessionBodyLow, currentBodyLow)
        sessionWickHigh := math.max(sessionWickHigh, high)
        sessionWickLow := math.min(sessionWickLow, low)

    [sessionBodyHigh, sessionBodyLow, sessionWickHigh, sessionWickLow, sessionHighTime, sessionLowTime, sessionDayKey, sessionStartTime]

toSansSerif(string inputStr) =>
    result = inputStr
    result := str.replace_all(result, "0", "𝟢")
    result := str.replace_all(result, "1", "𝟣")
    result := str.replace_all(result, "2", "𝟤")
    result := str.replace_all(result, "3", "𝟥")
    result := str.replace_all(result, "4", "𝟦")
    result := str.replace_all(result, "5", "𝟧")
    result := str.replace_all(result, "6", "𝟨")
    result := str.replace_all(result, "7", "𝟩")
    result := str.replace_all(result, "8", "𝟪")
    result := str.replace_all(result, "9", "𝟫")
    result

priceModeShows(bool customChoice) =>
    priceAndSizeQuickBoost or quickPriceMode == PRICE_MODE_ACTIVE or (quickPriceMode == PRICE_MODE_CUSTOM and customChoice)

openLevelShowsPrice(int sessionIndex) =>
    sessionIndex == IDX_0129 ? priceModeShows(rafaelShowPrice) : sessionIndex == IDX_ASIA_OPEN and priceModeShows(asiaOpenShowPrice)

levelLabelText(string txt, float level, bool showPrice) =>
    showPrice ? txt + BRAND_BULLET + str.tostring(level, format.mintick) : txt

// Darken a color by reducing its transparency (making it more opaque/visible)
// darkenPercent: 0-100, where higher = more darkening (more opaque)
darkenColor(color c, float darkenPercent) =>
    originalTransparency = color.t(c)
    // Reduce transparency by the darken percentage (makes color more visible/darker)
    newTransparency = originalTransparency * (1 - darkenPercent / 100)
    color.new(c, newTransparency)

// Generate unique key for a deviation box (for glow tracking)
// Uses session index + start time + box index to create a unique identifier
getGlowBoxKey(int sessionIndex, int sessionStartTime, int boxIndex) =>
    str.tostring(sessionIndex) + "_" + str.tostring(sessionStartTime) + "_" + str.tostring(boxIndex)

// Generate a unique key for an IVB extension line.
getIvbExtensionGlowKey(int sessionStartTime, int lineIndex) =>
    "ivb_ext_" + str.tostring(sessionStartTime) + "_" + str.tostring(lineIndex)

// Restore a deviation box and clear its completed glow state.
resetGlowBox(box devBox, string boxKey) =>
    if map.contains(glowOriginalColors, boxKey)
        box.set_bgcolor(devBox, map.get(glowOriginalColors, boxKey))
        map.remove(glowOriginalColors, boxKey)
    if map.contains(glowTouchTimes, boxKey)
        map.remove(glowTouchTimes, boxKey)

// Restore an IVB extension only when it has active glow state.
resetIvbExtensionGlow(line extLine, string lineKey, int normalWidth) =>
    if map.contains(ivbExtensionGlowTouchTimes, lineKey)
        line.set_width(extLine, normalWidth)
        map.remove(ivbExtensionGlowTouchTimes, lineKey)

resetSessionDeviationGlow(SessionData sess) =>
    int boxCount = array.size(sess.deviationBoxes)
    if boxCount > 0
        for i = 0 to boxCount - 1
            resetGlowBox(array.get(sess.deviationBoxes, i), getGlowBoxKey(sess.sessionIndex, sess.startTime, i))

resetSessionIvbExtensionGlow(SessionData sess) =>
    int extensionCount = array.size(sess.extLines)
    if extensionCount > 0
        for i = 0 to extensionCount - 1
            resetIvbExtensionGlow(array.get(sess.extLines, i), getIvbExtensionGlowKey(sess.startTime, i), opening_0930_1000_extWidth)

setLatestGlowSession(int sessionIndex, SessionData candidate) =>
    SessionData previous = array.get(latestGlowSessions, sessionIndex)
    bool changed = na(previous) != na(candidate) or (not na(previous) and not na(candidate) and previous.startTime != candidate.startTime)
    if changed
        if not na(previous) and not keepPastSessionGlow
            resetSessionDeviationGlow(previous)
        array.set(latestGlowSessions, sessionIndex, candidate)

registerLatestCompletedSession(SessionData sess) =>
    SessionData previous = array.get(latestCompletedSessions, sess.sessionIndex)
    if not na(previous) and previous.startTime != sess.startTime and sess.sessionIndex == IDX_IVB
        resetSessionIvbExtensionGlow(previous)
    array.set(latestCompletedSessions, sess.sessionIndex, sess)
    if sess.sessionIndex != IDX_0129 and sess.sessionIndex != IDX_ASIA_OPEN
        setLatestGlowSession(sess.sessionIndex, sess)

// Convert extension preset to hours
getExtendHours(string preset) =>
    switch preset
        EXTEND_3H => 3.0
        EXTEND_6H => 6.0
        EXTEND_8H => 8.0
        EXTEND_12H => 12.0
        EXTEND_NEXT => 20.0
        => 0.0

// Get extension milliseconds for a session by index
getSessionExtendMs(int idx) =>
    preset = switch idx
        IDX_0129 => opening_2130_0129_extend
        IDX_NY_EARLY => opening_0600_0900_extend
        IDX_PREMARKET => opening_0500_0915_extend
        IDX_IVB => opening_0930_1000_extend
        IDX_ASIA_OPEN => opening_1800_2100_extend
        => EXTEND_OFF
    int(getExtendHours(preset) * 60 * 60 * 1000)

// Sessions that always track mitigation (bypass "Same Day Only" filter)
// Evening sessions that naturally get mitigated the next trading day
alwaysTrackMitigation(int idx) =>
    switch idx
        IDX_0129 => true        // Rafael (21:30-01:29)
        IDX_ASIA_OPEN => true   // Asia Open (18:00-21:00)
        => false

focusManaged(int idx) =>
    focusActive and alwaysTrackMitigation(idx)

canConfirmDelayedMitigation(SessionData sess, int currentMinutes, int premarketStartMinute, int closeMinute) =>
    not sess.delayedMitigation or (currentMinutes >= premarketStartMinute and currentMinutes < closeMinute)

isDelayedProvisionalWindow(SessionData sess, int currentMinutes, int premarketStartMinute, int closeMinute, int currentDayKey) =>
    bool isOnSessionStartDay = sess.startDayKey == currentDayKey
    bool isInNextDayOvernightWindow = sess.delayedMitigation and sess.nextDayKey == currentDayKey and currentMinutes < premarketStartMinute
    sess.delayedMitigation and not canConfirmDelayedMitigation(sess, currentMinutes, premarketStartMinute, closeMinute) and (isOnSessionStartDay or isInNextDayOvernightWindow)

provisionalRetracementsEnabled(int sessionIndex) =>
    enableProvisionalRetracements and (sessionIndex == IDX_0129 or sessionIndex == IDX_ASIA_OPEN)

bothSessionBoundariesConfirmed(SessionData sess) =>
    sess.highMitigated and sess.lowMitigated

retracement618ForSide(SessionData sess, int side) =>
    side == 1 ? sess.wickHigh - sess.wickHeight * 0.618 : sess.wickLow + sess.wickHeight * 0.618

replacement618ForSide(SessionData sess, int side) =>
    side == 1 ? sess.wickLow + sess.wickHeight * 0.618 : sess.wickHigh - sess.wickHeight * 0.618

crossedConfirmedReplacementBoundary(SessionData sess, int confirmedSide, int confirmedBar, int currentBar, float barHigh, float barLow, float previousBarClose, string trigger) =>
    float replacementBoundary = trigger == REPLACEMENT_TRIGGER_50 ? sess.midLevel : replacement618ForSide(sess, confirmedSide)
    currentBar > confirmedBar and (confirmedSide == 1 ? previousBarClose > replacementBoundary and barLow <= replacementBoundary : previousBarClose < replacementBoundary and barHigh >= replacementBoundary)

initializeRetracementOrigin(SessionData sess) =>
    bool highTaken = sess.provisionalHighMitigated or sess.highMitigated
    bool lowTaken = sess.provisionalLowMitigated or sess.lowMitigated
    int highOriginBar = sess.provisionalHighMitigated ? sess.provisionalHighBar : sess.highMitigationBar
    int lowOriginBar = sess.provisionalLowMitigated ? sess.provisionalLowBar : sess.lowMitigationBar
    bool highWasFirst = highTaken and (not lowTaken or highOriginBar < lowOriginBar)
    bool lowWasFirst = lowTaken and (not highTaken or lowOriginBar < highOriginBar)
    if sess.retraceOriginSide == 0 and (highWasFirst or lowWasFirst)
        sess.retraceOriginSide := highWasFirst ? 1 : -1
        sess.retraceOriginBar := highWasFirst ? highOriginBar : lowOriginBar
        sess.retraceOriginProvisional := highWasFirst ? not sess.highMitigated : not sess.lowMitigated
        sess.retraceLegStartBar := sess.retraceOriginBar
    true

clearRetracementLeg(SessionData sess) =>
    if not na(sess.midMitigationLine)
        line.delete(sess.midMitigationLine)
        sess.midMitigationLine := na
    deleteLabels(sess.midMitigationLabels)
    if not na(sess.retrace618Line)
        line.delete(sess.retrace618Line)
        sess.retrace618Line := na
    deleteLabels(sess.retrace618Labels)
    sess.midMitigated := false
    sess.midMitigationTime := na
    sess.midMitigationBar := na
    sess.midArmed := false
    sess.retraceLevel618 := na
    sess.retrace618Mitigated := false
    sess.retrace618Time := na
    sess.retrace618Bar := na
    sess.retrace618Armed := false
    sess.retraceTraversalCompleted := false
    sess.retraceFadeApplied := false
    true

replaceProvisionalWithConfirmedOrigin(SessionData sess, int replacementBar) =>
    clearRetracementLeg(sess)
    sess.retraceOriginProvisional := false
    sess.retraceOriginBar := sess.retraceOriginSide == 1 ? sess.highMitigationBar : sess.lowMitigationBar
    sess.retraceLegStartBar := replacementBar
    sess.retraceLevel618 := retracement618ForSide(sess, sess.retraceOriginSide)
    true

replaceProvisionalWithOppositeConfirmedOrigin(SessionData sess, int confirmedSide, int confirmedBar, int replacementBar) =>
    clearRetracementLeg(sess)
    sess.retraceOriginSide := confirmedSide
    sess.retraceOriginBar := confirmedBar
    sess.retraceOriginProvisional := false
    sess.retraceLegStartBar := replacementBar
    sess.retraceLevel618 := retracement618ForSide(sess, confirmedSide)
    true

oppositeConfirmedReplacementSide(SessionData sess) =>
    sess.retraceOriginSide == -1 and sess.highMitigated ? 1 : sess.retraceOriginSide == 1 and sess.lowMitigated ? -1 : 0

// Cache the first directional IVB break for the NY day. A bar that breaks both sides cannot
// establish sequence; a later one-sided break can still qualify.
updateIvbBreakCache(int refDayKey, float barHigh, float barLow, int barTime) =>
    if not map.contains(ivbBreakTimeByDay, refDayKey) and map.contains(ivbHighByDay, refDayKey) and map.contains(ivbLowByDay, refDayKey)
        bool breaksHigh = barHigh > map.get(ivbHighByDay, refDayKey)
        bool breaksLow = barLow < map.get(ivbLowByDay, refDayKey)
        if breaksHigh != breaksLow
            map.put(ivbBreakTimeByDay, refDayKey, barTime)
            map.put(ivbBreakSideByDay, refDayKey, breaksHigh ? 1 : -1)

ivbBreakForDay(int refDayKey) =>
    updateIvbBreakCache(refDayKey, high, low, time)
    int earliest = map.contains(ivbBreakTimeByDay, refDayKey) ? map.get(ivbBreakTimeByDay, refDayKey) : na
    int side = map.contains(ivbBreakSideByDay, refDayKey) ? map.get(ivbBreakSideByDay, refDayKey) : 0
    [earliest, side]

// Draw confirmed mitigation line - extend pending line (if provisional) or draw new solid line
// When provisional: just extends pending line, returns na (solid line already in highMitigationLine)
// When not provisional: creates new solid line and returns it
draw_confirmed_mitigation_line(bool enabled, bool was_provisional, line pending_line, int origin_time, float level, color mit_color) =>
    line result = na
    if not enabled
        result := na
    else if was_provisional and not na(pending_line)
        line.set_x2(pending_line, time)
        // Don't return the pending line - solid line is already stored in highMitigationLine
    else
        result := line.new(origin_time, level, time, level, color=mit_color, style=line.style_solid, width=MITIGATION_LINE_WIDTH, xloc=xloc.bar_time)
    result

// Draw provisional breach lines - solid from origin to breach, dashed pending from breach
// Returns tuple of [solid_line, pending_line]
draw_provisional_breach_lines(bool enabled, int origin_time, float level, color mit_color) =>
    line solid_line = na
    line pending_line = na
    if enabled
        solid_line := line.new(origin_time, level, time, level, color=mit_color, style=line.style_solid, width=MITIGATION_LINE_WIDTH, xloc=xloc.bar_time)
        pending_line := line.new(time, level, time, level, color=mit_color, style=line.style_dashed, width=MITIGATION_PENDING_LINE_WIDTH, xloc=xloc.bar_time)
    [solid_line, pending_line]

// Label a dashed pending line at its right edge while it's still open; remove it once mitigated
resolve_pending_label(bool keep, label lbl, line pending, float level, string txt, int sessionIndex, color lineClr) =>
    label result = lbl
    if keep and not na(pending)
        color txtClr = color.new(lineClr, math.min(PENDING_LABEL_TRANSPARENCY_MAX, math.max(0.0, color.t(lineClr) - PENDING_LABEL_TRANSPARENCY_REDUCTION)))
        string renderedText = levelLabelText(txt, level, openLevelShowsPrice(sessionIndex))
        if na(result)
            result := label.new(line.get_x2(pending), level, renderedText, style=label.style_label_left, textcolor=txtClr, size=globalLabelSize, color=color.new(color.white, 100), xloc=xloc.bar_time)
        else
            label.set_x(result, line.get_x2(pending))
            label.set_y(result, level)
            label.set_text(result, renderedText)
    else if not na(result)
        label.delete(result)
        result := na
    result

reminderPlacements(int runBars, int spacingBars, int maxCount) =>
    math.min(maxCount, math.max(1, int(math.floor(float(runBars) / math.max(1, spacingBars)))))

// Labels use actual chart bars while their underlying lines retain native time coordinates.
tile_line_labels(int startIndex, int endIndex, float level, string txt, bool repeat, color txtColor, color bgColor) =>
    array<label> tags = array.new<label>()
    int minimumIndex = math.max(0, bar_index - BAR_INDEX_DRAWING_LOOKBACK)
    if not na(startIndex) and not na(endIndex) and endIndex >= minimumIndex
        int rangeStartIndex = math.max(startIndex, minimumIndex)
        int runBars = math.max(0, endIndex - rangeStartIndex)
        if runBars > 0
            int count = repeat ? reminderPlacements(runBars, MITIGATION_REMINDER_SPACING_BARS, MITIGATION_REMINDER_MAX_PER_LINE) : 1
            for placement = 1 to count
                int tagIndex = rangeStartIndex + int(runBars * (placement - 0.5) / count)
                array.push(tags, label.new(tagIndex, level, txt, style=label.style_label_center, textcolor=txtColor, size=globalLabelSize, color=bgColor, xloc=xloc.bar_index))
    tags

newIvbProjectionLabel(line target, float level, string caption, bool includePrice, color txtColor, color bgColor) =>
    int labelX = includePrice ? line.get_x2(target) : line.get_x1(target) + int((line.get_x2(target) - line.get_x1(target)) * 0.5)
    string labelText = includePrice ? caption + " • " + str.tostring(level, format.mintick) : caption
    string labelStyle = includePrice ? label.style_label_left : label.style_label_center
    label.new(labelX, level, labelText, style=labelStyle, textcolor=txtColor, size=globalLabelSize, color=bgColor, xloc=xloc.bar_time)

resolve_mitigation_reminders(bool keep, array<label> reminders, line mitLine, int startIndex, int endIndex, float level, string txt, bool repeat) =>
    if not keep or na(mitLine)
        deleteLabels(reminders)
    else if array.size(reminders) == 0
        // Confirmed mitigation lines never move, so build the tags once instead of rebuilding every bar.
        for lbl in tile_line_labels(startIndex, endIndex, level, txt, repeat, labelColor, labelsBgColor)
            array.push(reminders, lbl)

// Unmitigated lines extend every bar, so their tags rebuild once per bar on the last bar only.
resolve_open_level_reminders(bool keep, array<label> reminders, line levelLine, int startIndex, int endIndex, float level, string txt) =>
    if not keep or na(levelLine)
        deleteLabels(reminders)
    else if barstate.islast and (barstate.isnew or array.size(reminders) == 0)
        deleteLabels(reminders)
        for lbl in tile_line_labels(startIndex, endIndex, level, txt, true, labelColor, labelsBgColor)
            array.push(reminders, lbl)

// Push a color's transparency toward fully invisible by pct (0 = unchanged, 100 = invisible).
fadeToward100(color c, float pct) =>
    color.new(c, color.t(c) + (100.0 - color.t(c)) * pct / 100.0)

// Fade a completed retracement's line + tiled labels toward invisible so they read as inactive. Base
// colors are passed in because Pine can't read a line's current color back.
fadeRetraceElements(line ln, array<label> lbls, color baseLineColor, color baseTextColor, color baseBgColor) =>
    if not na(ln)
        line.set_color(ln, fadeToward100(baseLineColor, completedRetraceFade))
    for lbl in lbls
        label.set_textcolor(lbl, fadeToward100(baseTextColor, completedRetraceFade))
        label.set_color(lbl, fadeToward100(baseBgColor, completedRetraceFade))

completedMitigationShouldFade(SessionData sess, bool isHigh) =>
    bool isMitigated = isHigh ? sess.highMitigated : sess.lowMitigated
    bool fadeApplied = isHigh ? sess.highMitigationFadeApplied : sess.lowMitigationFadeApplied
    float level = isHigh ? sess.dominantHigh : sess.dominantLow
    float distancePct = not na(level) ? math.abs(close - level) / math.max(math.abs(level), syminfo.mintick) * 100.0 : 0.0
    bool thresholdReached = distancePct >= completedMitigationDistanceThreshold
    if fadeCompletedMitigationLevels and isMitigated and thresholdReached and not fadeApplied
        if isHigh
            sess.highMitigationFadeApplied := true
        else
            sess.lowMitigationFadeApplied := true
        fadeApplied := true
    fadeCompletedMitigationLevels and isMitigated and fadeApplied

completedMitigationFadePending(SessionData sess) =>
    bool highPending = sess.highMitigated and not sess.highMitigationFadeApplied
    bool lowPending = sess.lowMitigated and not sess.lowMitigationFadeApplied
    mitigationMode == SESSION_MITIGATED and fadeCompletedMitigationLevels and (highPending or lowPending)

styleCompletedMitigationBoundary(SessionData sess, bool isHigh) =>
    bool faded = completedMitigationShouldFade(sess, isHigh)
    color renderedLineColor = faded ? color.new(sess.mitigationColor, math.max(color.t(sess.mitigationColor), completedMitigationFadeOpacity)) : sess.mitigationColor
    color renderedTextColor = faded ? color.new(labelColor, math.max(color.t(labelColor), completedMitigationFadeOpacity)) : labelColor
    color renderedBgColor = faded ? color.new(labelsBgColor, math.max(color.t(labelsBgColor), completedMitigationFadeOpacity)) : labelsBgColor
    line solidLine = isHigh ? sess.highMitigationLine : sess.lowMitigationLine
    line pendingLine = isHigh ? sess.highPendingLine : sess.lowPendingLine
    array<label> reminders = isHigh ? sess.highMitigationReminders : sess.lowMitigationReminders
    if not na(solidLine)
        line.set_color(solidLine, renderedLineColor)
    if not na(pendingLine)
        line.set_color(pendingLine, renderedLineColor)
    for lbl in reminders
        label.set_textcolor(lbl, renderedTextColor)
        label.set_color(lbl, renderedBgColor)

shouldShowMitigationName(SessionData sess, bool isHigh) =>
    if sess.sessionIndex == IDX_IVB
        // A single IVB sweep is self-explanatory. Name IVB only after both sides sweep,
        // and place the name on the second (last-swept) side. Same-bar double sweeps
        // have no knowable order, so neither side receives the name.
        bool bothSidesSwept = sess.provisionalHighMitigated and sess.provisionalLowMitigated
        int thisSweepTime = isHigh ? sess.provisionalHighTime : sess.provisionalLowTime
        int otherSweepTime = isHigh ? sess.provisionalLowTime : sess.provisionalHighTime
        bothSidesSwept and not na(thisSweepTime) and not na(otherSweepTime) and thisSweepTime > otherSweepTime
    else
        bool isMitigated = isHigh ? sess.highMitigated : sess.lowMitigated
        bool wasProvisional = isHigh ? sess.provisionalHighMitigated : sess.provisionalLowMitigated
        bool wasOvernightProvisional = sess.delayedMitigation and wasProvisional
        isMitigated and not wasOvernightProvisional

// Standard retracements complete once their active leg reaches the opposite session boundary.
isRetraceTraversalComplete(SessionData sess) =>
    if sess.sessionIndex == IDX_NY_EARLY and sess.retracementMode == RETRACE_MODE_IVB
        sess.ivbRetraceCompleted
    else if sess.sessionIndex == IDX_IVB
        sess.provisionalHighMitigated and sess.provisionalLowMitigated
    else if provisionalRetracementsEnabled(sess.sessionIndex) and sess.retraceOriginSide != 0
        sess.retraceTraversalCompleted
    else
        sess.highMitigated and sess.lowMitigated

// Monotone once true — Phase 4 stops walking the session. na retraceLevel618 with both extremes
// taken counts as complete: the 0.618 anchor can no longer be established.
sessionLifecycleComplete(SessionData sess) =>
    bool boundariesComplete = sess.highMitigated and sess.lowMitigated
    bool provisionalLifecycle = mitigationMode == SESSION_MITIGATED and sess.showRetracement and provisionalRetracementsEnabled(sess.sessionIndex)
    bool ambiguousTraversalComplete = provisionalLifecycle and boundariesComplete and sess.retraceOriginSide == 0
    bool retracementsComplete = mitigationMode == SESSION_UNMITIGATED or not sess.showRetracement or ambiguousTraversalComplete or (sess.midMitigated and (sess.retrace618Mitigated or na(sess.retraceLevel618)))
    bool originConfirmed = sess.retraceOriginSide == 1 ? sess.highMitigated : sess.retraceOriginSide == -1 and sess.lowMitigated
    bool replacementPending = provisionalLifecycle and sess.retraceOriginProvisional and (originConfirmed or oppositeConfirmedReplacementSide(sess) != 0)
    bool traversalPending = provisionalLifecycle and sess.retraceOriginSide != 0 and not sess.retraceTraversalCompleted
    boundariesComplete and retracementsComplete and not replacementPending and not traversalPending

// Convert a bar offset to a time offset (used for xloc.bar_time drawing)
timeWithOffset(int baseTime, int barOffset) =>
    baseTime + barOffset * BAR_MS

// Range candles have no fixed duration, so their confirmation endpoint is the current candle.
ivbConfirmationEndTime(int confirmedBarTime, int provisionalTime, int currentBarTime, bool isRange, int chartBarMs) =>
    int endpoint = isRange ? currentBarTime : confirmedBarTime + 30 * 60 * 1000 - chartBarMs
    math.max(endpoint, provisionalTime)

// Parse deviation string into ordered array of DeviationZone entries
// Example: "1, 2:2.5, 4:4.5" → [{1,1,false}, {2,2.5,true}, {4,4.5,true}]
parseDeviationZones(string deviationStr) =>
    zones = array.new<DeviationZone>()
    tokens = str.split(deviationStr, ",")
    for token in tokens
        trimmed = str.replace_all(token, " ", "")
        if trimmed != ""
            if str.contains(trimmed, ":")
                // Range like "2:2.5"
                parts = str.split(trimmed, ":")
                if array.size(parts) == 2
                    innerVal = str.tonumber(array.get(parts, 0))
                    outerVal = str.tonumber(array.get(parts, 1))
                    zones.push(DeviationZone.new(innerVal, outerVal, true))
            else
                // Single level like "1"
                level = str.tonumber(trimmed)
                zones.push(DeviationZone.new(level, level, false))
    zones

// Drawing helper - unified function for all deviation zones (singles and ranges)
drawDeviations(SessionData sess, float high, float low, float height, array<DeviationZone> zones, color deviationColor, color lineColor, bool showLines, bool showLabels, string labelPosition, color labelColor, string suffix, int startBarOffset, int endBarOffset, bool drawAbove, bool drawBelow) =>
    if array.size(zones) > 0 and (drawAbove or drawBelow)
        baseLabelTime = labelPosition == "Left" ? sess.startTime : sess.endTime
        labelOffset = labelPosition == "Left" ? startBarOffset : endBarOffset
        labelX = timeWithOffset(baseLabelTime, labelOffset)
        labelStyle = labelPosition == "Left" ? label.style_label_right : label.style_label_left
        startX = timeWithOffset(sess.startTime, startBarOffset)
        endX = timeWithOffset(sess.endTime, endBarOffset) + nz(sess.deviationExtendMs, 0)
        drawingXloc = xloc.bar_time

        for zone in zones
            if zone.isRange
                // Draw range as box with labels at both edges
                if drawAbove
                    aboveFrom = high + (height * zone.innerLevel)
                    aboveTo = high + (height * zone.outerLevel)
                    sess.deviationBoxes.push(box.new(startX, aboveFrom, endX, aboveTo, bgcolor=deviationColor, border_color=na, xloc=drawingXloc))
                    if showLabels
                        sess.labels.push(label.new(labelX, aboveFrom, toSansSerif("+" + str.tostring(zone.innerLevel) + suffix), style=labelStyle, color=labelsBgColor, textcolor=labelColor, size=globalLabelSize, xloc=drawingXloc))
                        sess.labels.push(label.new(labelX, aboveTo, toSansSerif("+" + str.tostring(zone.outerLevel) + suffix), style=labelStyle, color=labelsBgColor, textcolor=labelColor, size=globalLabelSize, xloc=drawingXloc))

                if drawBelow
                    belowFrom = low - (height * zone.innerLevel)
                    belowTo = low - (height * zone.outerLevel)
                    sess.deviationBoxes.push(box.new(startX, belowFrom, endX, belowTo, bgcolor=deviationColor, border_color=na, xloc=drawingXloc))
                    if showLabels
                        sess.labels.push(label.new(labelX, belowFrom, toSansSerif("-" + str.tostring(zone.innerLevel) + suffix), style=labelStyle, color=labelsBgColor, textcolor=labelColor, size=globalLabelSize, xloc=drawingXloc))
                        sess.labels.push(label.new(labelX, belowTo, toSansSerif("-" + str.tostring(zone.outerLevel) + suffix), style=labelStyle, color=labelsBgColor, textcolor=labelColor, size=globalLabelSize, xloc=drawingXloc))
            else
                // Draw single level as line + label
                dev = zone.outerLevel

                if drawAbove and showLines
                    aboveLevel = high + (height * dev)
                    sess.lines.push(line.new(startX, aboveLevel, endX, aboveLevel, color=lineColor, style=line.style_dotted, width=1, xloc=drawingXloc))
                    if showLabels
                        sess.labels.push(label.new(labelX, aboveLevel, toSansSerif("+" + str.tostring(dev) + suffix), style=labelStyle, color=labelsBgColor, textcolor=labelColor, size=globalLabelSize, xloc=drawingXloc))

                if drawBelow and showLines
                    belowLevel = low - (height * dev)
                    sess.lines.push(line.new(startX, belowLevel, endX, belowLevel, color=lineColor, style=line.style_dotted, width=1, xloc=drawingXloc))
                    if showLabels
                        sess.labels.push(label.new(labelX, belowLevel, toSansSerif("-" + str.tostring(dev) + suffix), style=labelStyle, color=labelsBgColor, textcolor=labelColor, size=globalLabelSize, xloc=drawingXloc))

drawCoreBox(SessionData sess, float highPrice, float lowPrice) =>
    box.new(sess.startTime, highPrice, sess.endTime, lowPrice, bgcolor=sess.coreColor, border_color=na, xloc=xloc.bar_time)

calculateOffsets(SessionData sess, bool isBody) =>
    useOffset = sess.useOffset and sess.deviationMode == OPT_BOTH
    int startOffset = 0
    int endOffset = 0

    if useOffset
        rangeWidth = sess.endBar - sess.startBar
        if isBody
            startOffset := rangeWidth - ZONE_OFFSET_START
            endOffset := rangeWidth - ZONE_OFFSET_START + ZONE_OFFSET_BARS
        else
            startOffset := -(rangeWidth - ZONE_OFFSET_START + ZONE_OFFSET_BARS)
            endOffset := -(rangeWidth - ZONE_OFFSET_START)

    [startOffset, endOffset]

// Get cached deviation zones by session index
getCachedZones(int sessionIdx) =>
    switch sessionIdx
        IDX_0129 => cachedDeviations_0129
        IDX_NY_EARLY => cachedDeviations_ny_early
        IDX_PREMARKET => cachedDeviations_premarket
        IDX_IVB => cachedDeviations_ivb
        IDX_ASIA_OPEN => cachedDeviations_asia_open
        => na

isInFilter(int idx) =>
    if quickFilter == FILTER_ALL
        true
    else if quickFilter == FILTER_RAFAEL_ASIA_OPEN
        idx == IDX_0129 or idx == IDX_ASIA_OPEN
    else if quickFilter == FILTER_RAFAEL_ASIA_OPEN_EARLY
        idx == IDX_0129 or idx == IDX_ASIA_OPEN or idx == IDX_NY_EARLY
    else if quickFilter == FILTER_RAFAEL_ASIA_OPEN_EARLY_IVB
        idx == IDX_0129 or idx == IDX_ASIA_OPEN or idx == IDX_NY_EARLY or idx == IDX_IVB
    else if quickFilter == FILTER_PREP2
        idx == IDX_0129 or idx == IDX_ASIA_OPEN or idx == IDX_NY_EARLY or idx == IDX_IVB or idx == IDX_PREMARKET
    else if quickFilter == FILTER_ASIA_OPEN
        idx == IDX_ASIA_OPEN
    else if quickFilter == FILTER_ASIA_OPEN_EARLY
        idx == IDX_ASIA_OPEN or idx == IDX_NY_EARLY
    else if quickFilter == FILTER_IVB
        idx == IDX_IVB
    else if quickFilter == FILTER_PREMARKET
        idx == IDX_PREMARKET
    else if quickFilter == FILTER_NY_EARLY_IVB
        idx == IDX_NY_EARLY or idx == IDX_IVB
    else if quickFilter == FILTER_NY_EARLY_IVB_PREMARKET
        idx == IDX_NY_EARLY or idx == IDX_IVB or idx == IDX_PREMARKET
    else
        true

drawCoreWithDeviations(SessionData sess, float highPrice, float lowPrice, float height, bool isBody) =>
    [startOffset, endOffset] = calculateOffsets(sess, isBody)
    // Position labels: when both deviations shown, body goes right and wick goes left
    labelPos = sess.deviationMode == OPT_BOTH ? (isBody ? "Right" : "Left") : "Left"
    suffix = isBody ? BODY_SUFFIX : WICK_SUFFIX
    zones = getCachedZones(sess.sessionIndex)

    // Determine whether to show labels based on dropdown value and body/wick type
    showLbls = showAllLabels and (sess.deviationLabelsMode == OPT_BOTH or (sess.deviationLabelsMode == OPT_BODY and isBody) or (sess.deviationLabelsMode == OPT_WICK and not isBody))

    // Draw all deviation zones (turning point zones get special color)
    drawDeviations(sess, highPrice, lowPrice, height, zones, sess.deviationColor, color.new(labelColor, DEVIATION_LINE_OPACITY), showAllLines, showLbls, labelPos, labelColor, suffix, startOffset, endOffset, true, true)

drawSessionNameLabel(SessionData sess) =>
    if showAllLabels and showSessionNames
        int labelX = int(math.round((sess.startTime + sess.endTime) / 2))
        float labelY = sess.labelPosition == OPT_ABOVE ? sess.wickHigh : sess.wickLow
        labelStyle = sess.labelPosition == OPT_ABOVE ? label.style_label_down : label.style_label_up
        sess.labels.push(label.new(labelX, labelY, sess.chartLabel, style=labelStyle, textcolor=labelColor, size=globalLabelSize, color=labelsBgColor, textalign=text.align_center, xloc=xloc.bar_time))

// Nulls every handle so the session can be safely re-rendered after deselection.
deleteSession(SessionData sess) =>
    if not na(sess.bodyBox)
        box.delete(sess.bodyBox)
        sess.bodyBox := na
    if not na(sess.wickBox)
        box.delete(sess.wickBox)
        sess.wickBox := na
    deleteLines(sess.lines)
    deleteLabels(sess.labels)
    deviationBoxCount = array.size(sess.deviationBoxes)
    if deviationBoxCount > 0
        for i = 0 to deviationBoxCount - 1
            box.delete(array.get(sess.deviationBoxes, i))
            boxKey = getGlowBoxKey(sess.sessionIndex, sess.startTime, i)
            if map.contains(glowTouchTimes, boxKey)
                map.remove(glowTouchTimes, boxKey)
            if map.contains(glowOriginalColors, boxKey)
                map.remove(glowOriginalColors, boxKey)
    array.clear(sess.deviationBoxes)
    if not na(sess.asiaDev15UpperGlowBox)
        box.delete(sess.asiaDev15UpperGlowBox)
        sess.asiaDev15UpperGlowBox := na
    if not na(sess.asiaDev15LowerGlowBox)
        box.delete(sess.asiaDev15LowerGlowBox)
        sess.asiaDev15LowerGlowBox := na
    if not na(sess.highMitigationLine)
        line.delete(sess.highMitigationLine)
        sess.highMitigationLine := na
    if not na(sess.lowMitigationLine)
        line.delete(sess.lowMitigationLine)
        sess.lowMitigationLine := na
    deleteLabels(sess.highMitigationReminders)
    deleteLabels(sess.lowMitigationReminders)
    if not na(sess.midMitigationLine)
        line.delete(sess.midMitigationLine)
        sess.midMitigationLine := na
    deleteLabels(sess.midMitigationLabels)
    if not na(sess.retrace618Line)
        line.delete(sess.retrace618Line)
        sess.retrace618Line := na
    deleteLabels(sess.retrace618Labels)
    deleteLabels(sess.highUnmitigatedReminders)
    deleteLabels(sess.lowUnmitigatedReminders)
    if not na(sess.highPendingLine)
        line.delete(sess.highPendingLine)
        sess.highPendingLine := na
    if not na(sess.lowPendingLine)
        line.delete(sess.lowPendingLine)
        sess.lowPendingLine := na
    if not na(sess.highPendingLabel)
        label.delete(sess.highPendingLabel)
        sess.highPendingLabel := na
    if not na(sess.lowPendingLabel)
        label.delete(sess.lowPendingLabel)
        sess.lowPendingLabel := na
    extensionLineCount = array.size(sess.extLines)
    if extensionLineCount > 0
        for i = 0 to extensionLineCount - 1
            line.delete(array.get(sess.extLines, i))
            lineKey = getIvbExtensionGlowKey(sess.startTime, i)
            if map.contains(ivbExtensionGlowTouchTimes, lineKey)
                map.remove(ivbExtensionGlowTouchTimes, lineKey)
    array.clear(sess.extLines)
    deleteLabels(sess.extLabels)
    if not na(sess.highUnmitigatedLine)
        line.delete(sess.highUnmitigatedLine)
        sess.highUnmitigatedLine := na
    if not na(sess.highUnmitigatedLabel)
        label.delete(sess.highUnmitigatedLabel)
        sess.highUnmitigatedLabel := na
    if not na(sess.lowUnmitigatedLine)
        line.delete(sess.lowUnmitigatedLine)
        sess.lowUnmitigatedLine := na
    if not na(sess.lowUnmitigatedLabel)
        label.delete(sess.lowUnmitigatedLabel)
        sess.lowUnmitigatedLabel := na

focusDirectionMatches(float levelPrice, float anchorPrice) =>
    focusDirection == FOCUS_DIRECTION_BELOW ? levelPrice <= anchorPrice : focusDirection == FOCUS_DIRECTION_ABOVE ? levelPrice >= anchorPrice : true

nearerFocusDistance(float current, float levelPrice, float anchorPrice) =>
    float candidate = not na(levelPrice) and focusDirectionMatches(levelPrice, anchorPrice) ? math.abs(anchorPrice - levelPrice) : na
    na(candidate) ? current : na(current) ? candidate : math.min(current, candidate)

focusSessionRank(SessionData sess, float anchorPrice) =>
    float nearestUntouched = na
    if not sess.highMitigated
        nearestUntouched := nearerFocusDistance(nearestUntouched, sess.dominantHigh, anchorPrice)
    if not sess.lowMitigated
        nearestUntouched := nearerFocusDistance(nearestUntouched, sess.dominantLow, anchorPrice)
    bool hasUntouchedLevel = not na(nearestUntouched)
    float nearest = nearestUntouched
    if not hasUntouchedLevel
        nearest := nearerFocusDistance(nearest, sess.dominantHigh, anchorPrice)
        nearest := nearerFocusDistance(nearest, sess.dominantLow, anchorPrice)
    [nearest, hasUntouchedLevel]

focusCandidateOutranks(FocusCandidate candidate, FocusCandidate other) =>
    candidate.hasUntouchedLevel != other.hasUntouchedLevel ? candidate.hasUntouchedLevel : candidate.distance != other.distance ? candidate.distance < other.distance : candidate.endTime > other.endTime

retainFocusCandidate(array<FocusCandidate> ranked, FocusCandidate candidate, int focusCount) =>
    int rankedCount = array.size(ranked)
    bool admitted = rankedCount < focusCount
    if not admitted and rankedCount > 0
        admitted := focusCandidateOutranks(candidate, array.last(ranked))
    if admitted
        int insertAt = rankedCount
        if rankedCount > 0
            for scanIndex = 0 to rankedCount - 1
                if focusCandidateOutranks(candidate, array.get(ranked, scanIndex))
                    insertAt := scanIndex
                    break
        if insertAt >= rankedCount
            array.push(ranked, candidate)
        else
            array.insert(ranked, insertAt, candidate)
        if array.size(ranked) > focusCount
            array.pop(ranked)

collectFocusCandidates(array<SessionData> source, array<FocusCandidate> combined, array<FocusCandidate> rankedByType, int sessionIndex, float anchorPrice, int focusCount) =>
    array.clear(rankedByType)
    if array.size(source) > 0
        for sourceIndex = 0 to array.size(source) - 1
            SessionData sess = array.get(source, sourceIndex)
            if sess.sessionIndex == sessionIndex
                [distance, hasUntouchedLevel] = focusSessionRank(sess, anchorPrice)
                if not na(distance)
                    retainFocusCandidate(rankedByType, FocusCandidate.new(hasUntouchedLevel, distance, sourceIndex, sess.endTime), focusCount)
    for candidate in rankedByType
        retainFocusCandidate(combined, candidate, focusCount * 2)

// Focus surfaces distant levels IN ADDITION TO the normal recent view. Ranking is untouched-first,
// so today's already-mitigated sessions lose every slot to deep history unless they are held back.
collectRecentFocusSessions(array<SessionData> source, array<int> selected, int sessionIndex, int keepCount) =>
    int kept = 0
    for sourceIndex = array.size(source) - 1 to 0
        if kept >= keepCount
            break
        if array.get(source, sourceIndex).sessionIndex == sessionIndex
            array.push(selected, sourceIndex)
            kept += 1

mergeOverlappingUnmitigatedLabels(array<SessionData> candidates, bool isHigh, float overlapPct) =>
    int candidateCount = array.size(candidates)
    if candidateCount > 1
        for i = 0 to candidateCount - 2
            SessionData sessA = array.get(candidates, i)
            label labelA = isHigh ? sessA.highUnmitigatedLabel : sessA.lowUnmitigatedLabel
            if na(labelA)
                continue
            float levelA = isHigh ? sessA.dominantHigh : sessA.dominantLow
            float tolerance = levelA * overlapPct / 100
            string mergedText = sessA.chartLabel
            bool mergedShowsPrice = openLevelShowsPrice(sessA.sessionIndex)
            for j = i + 1 to candidateCount - 1
                SessionData sessB = array.get(candidates, j)
                label labelB = isHigh ? sessB.highUnmitigatedLabel : sessB.lowUnmitigatedLabel
                if na(labelB)
                    continue
                float levelB = isHigh ? sessB.dominantHigh : sessB.dominantLow
                if math.abs(levelA - levelB) <= tolerance
                    mergedText += " / " + sessB.chartLabel
                    mergedShowsPrice := mergedShowsPrice or openLevelShowsPrice(sessB.sessionIndex)
                    label.set_text(labelA, levelLabelText(mergedText, levelA, mergedShowsPrice))
                    label.delete(labelB)
                    if isHigh
                        sessB.highUnmitigatedLabel := na
                    else
                        sessB.lowUnmitigatedLabel := na

sessionCurrentLifecycleDrawingCounts(SessionData sess) =>
    int lineCount = array.size(sess.extLines)
    lineCount += na(sess.highMitigationLine) ? 0 : 1
    lineCount += na(sess.lowMitigationLine) ? 0 : 1
    lineCount += na(sess.highUnmitigatedLine) ? 0 : 1
    lineCount += na(sess.lowUnmitigatedLine) ? 0 : 1
    lineCount += na(sess.midMitigationLine) ? 0 : 1
    lineCount += na(sess.retrace618Line) ? 0 : 1
    lineCount += na(sess.highPendingLine) ? 0 : 1
    lineCount += na(sess.lowPendingLine) ? 0 : 1
    int labelCount = array.size(sess.extLabels)
    labelCount += array.size(sess.highMitigationReminders) + array.size(sess.lowMitigationReminders)
    labelCount += array.size(sess.highUnmitigatedReminders) + array.size(sess.lowUnmitigatedReminders)
    labelCount += array.size(sess.midMitigationLabels) + array.size(sess.retrace618Labels)
    labelCount += na(sess.highUnmitigatedLabel) ? 0 : 1
    labelCount += na(sess.lowUnmitigatedLabel) ? 0 : 1
    labelCount += na(sess.highPendingLabel) ? 0 : 1
    labelCount += na(sess.lowPendingLabel) ? 0 : 1
    [lineCount, labelCount]

sessionPotentialLifecycleDrawingCounts(SessionData sess) =>
    int lineCount = 0
    int labelCount = 0
    if showAllLines and sess.showMitigation
        lineCount += 4
        if mitigationMode == SESSION_MITIGATED and sess.showRetracement
            lineCount += 2
        if showAllLabels
            int tiledLabelCount = showMitigationReminders ? MITIGATION_REMINDER_MAX_PER_LINE : 1
            int openBoundaryLabelCount = 1 + (showMitigationReminders ? MITIGATION_REMINDER_MAX_PER_LINE : 0)
            int mitigationBoundaryLabelCount = showSessionNameOnMitigation and sess.isKeySession ? tiledLabelCount : 0
            int provisionalBoundaryLabelCount = showPendingLabels ? 1 : 0
            int boundaryLabelCount = math.max(openBoundaryLabelCount, math.max(mitigationBoundaryLabelCount, provisionalBoundaryLabelCount))
            labelCount += boundaryLabelCount * 2
            if mitigationMode == SESSION_MITIGATED and sess.showRetracement
                labelCount += tiledLabelCount * 2
    bool ivbExtensionsPotential = sess.sessionIndex == IDX_IVB and opening_0930_1000_showExtensions and opening_0930_1000 != OPT_HIDDEN and isInFilter(IDX_IVB) and showAllLines
    if ivbExtensionsPotential
        lineCount += 4
        labelCount += showAllLabels ? 4 : 0
    [lineCount, labelCount]

focusCurrentDrawingCounts(SessionData sess) =>
    int boxCount = array.size(sess.deviationBoxes) + (na(sess.bodyBox) ? 0 : 1) + (na(sess.wickBox) ? 0 : 1)
    [lifecycleLineCount, lifecycleLabelCount] = sessionCurrentLifecycleDrawingCounts(sess)
    int lineCount = array.size(sess.lines) + lifecycleLineCount
    int labelCount = array.size(sess.labels) + lifecycleLabelCount
    [boxCount, lineCount, labelCount]

// Reserve each selected session's complete possible footprint so later lifecycle transitions
// cannot push Focus through TradingView's drawing caps.
focusPotentialDrawingCounts(SessionData sess) =>
    bool drawBodyDeviations = sess.deviationMode == OPT_BODY or sess.deviationMode == OPT_BOTH
    bool drawWickDeviations = sess.deviationMode == OPT_WICK or sess.deviationMode == OPT_BOTH
    bool labelBodyDeviations = showAllLabels and (sess.deviationLabelsMode == OPT_BODY or sess.deviationLabelsMode == OPT_BOTH)
    bool labelWickDeviations = showAllLabels and (sess.deviationLabelsMode == OPT_WICK or sess.deviationLabelsMode == OPT_BOTH)
    int boxCount = skipsCore(sess.sessionIndex) ? 0 : 2
    int lineCount = 0
    int labelCount = showAllLabels and showSessionNames ? 1 : 0
    array<DeviationZone> zones = getCachedZones(sess.sessionIndex)
    for zone in zones
        if zone.isRange
            boxCount += drawBodyDeviations ? 2 : 0
            boxCount += drawWickDeviations ? 2 : 0
            labelCount += labelBodyDeviations ? 4 : 0
            labelCount += labelWickDeviations ? 4 : 0
        else if showAllLines
            lineCount += drawBodyDeviations ? 2 : 0
            lineCount += drawWickDeviations ? 2 : 0
            labelCount += labelBodyDeviations ? 2 : 0
            labelCount += labelWickDeviations ? 2 : 0
    [lifecycleLineCount, lifecycleLabelCount] = sessionPotentialLifecycleDrawingCounts(sess)
    lineCount += lifecycleLineCount
    labelCount += lifecycleLabelCount
    [boxCount, lineCount, labelCount]

// Deferred last-bar reconstruction of one high/low boundary from Phase 4 state.
renderFocusBoundary(SessionData sess, bool isHigh) =>
    bool mitigated = isHigh ? sess.highMitigated : sess.lowMitigated
    bool provisional = isHigh ? sess.provisionalHighMitigated : sess.provisionalLowMitigated
    int originTime = isHigh ? sess.highTime : sess.lowTime
    int originBar = isHigh ? sess.highBar : sess.lowBar
    int provisionalTime = isHigh ? sess.provisionalHighTime : sess.provisionalLowTime
    int provisionalBar = isHigh ? sess.provisionalHighBar : sess.provisionalLowBar
    int mitigationTime = isHigh ? sess.highMitigationTime : sess.lowMitigationTime
    int mitigationBar = isHigh ? sess.highMitigationBar : sess.lowMitigationBar
    float level = isHigh ? sess.dominantHigh : sess.dominantLow
    line renderedSolid = isHigh ? sess.highMitigationLine : sess.lowMitigationLine
    line renderedPending = isHigh ? sess.highPendingLine : sess.lowPendingLine
    label renderedOpenLabel = isHigh ? sess.highUnmitigatedLabel : sess.lowUnmitigatedLabel
    label renderedProvisionalLabel = isHigh ? sess.highPendingLabel : sess.lowPendingLabel
    array<label> mitigationReminders = isHigh ? sess.highMitigationReminders : sess.lowMitigationReminders
    array<label> openReminders = isHigh ? sess.highUnmitigatedReminders : sess.lowUnmitigatedReminders
    // Unmitigated mode deletes a level once it mitigates, matching Phase 4's persistent-level rules.
    if showAllLines and not (mitigationMode == SESSION_UNMITIGATED and mitigated)
        int solidEndTime = provisional ? provisionalTime : mitigated ? mitigationTime : time
        int solidEndBar = provisional ? provisionalBar : mitigated ? mitigationBar : bar_index
        if na(renderedSolid)
            renderedSolid := line.new(originTime, level, solidEndTime, level, color=sess.mitigationColor, style=line.style_solid, width=MITIGATION_LINE_WIDTH, xloc=xloc.bar_time)
        else if line.get_x2(renderedSolid) != solidEndTime
            line.set_x2(renderedSolid, solidEndTime)

        if provisional
            int pendingEndTime = mitigated ? mitigationTime : time
            if na(renderedPending)
                renderedPending := line.new(provisionalTime, level, pendingEndTime, level, color=sess.mitigationColor, style=line.style_dashed, width=MITIGATION_PENDING_LINE_WIDTH, xloc=xloc.bar_time)
            else if line.get_x2(renderedPending) != pendingEndTime
                line.set_x2(renderedPending, pendingEndTime)
        else if not na(renderedPending)
            line.delete(renderedPending)
            renderedPending := na

        // Mitigated mode labels a provisional level via the pending label instead.
        bool openLevel = not mitigated and (mitigationMode == SESSION_UNMITIGATED or not provisional)
        bool showOpenLabel = showAllLabels and openLevel
        if showOpenLabel
            if na(renderedOpenLabel)
                renderedOpenLabel := label.new(time, level, levelLabelText(sess.chartLabel, level, openLevelShowsPrice(sess.sessionIndex)), style=label.style_label_left, textcolor=labelColor, size=globalLabelSize, color=color.new(color.white, 100), xloc=xloc.bar_time)
            else
                label.set_x(renderedOpenLabel, time)
        else if not na(renderedOpenLabel)
            label.delete(renderedOpenLabel)
            renderedOpenLabel := na

        renderedProvisionalLabel := resolve_pending_label(mitigationMode == SESSION_MITIGATED and showAllLabels and showPendingLabels and provisional and not mitigated, renderedProvisionalLabel, renderedPending, level, sess.chartLabel, sess.sessionIndex, sess.mitigationColor)

        bool wantMitigationName = mitigationMode == SESSION_MITIGATED and showAllLabels and showSessionNameOnMitigation and sess.isKeySession and not skipsMitigationName(sess.sessionIndex) and shouldShowMitigationName(sess, isHigh)
        resolve_mitigation_reminders(wantMitigationName, mitigationReminders, renderedSolid, originBar, solidEndBar, level, str.lower(sess.chartLabel), showMitigationReminders)
        resolve_open_level_reminders(showAllLabels and showMitigationReminders and openLevel, openReminders, renderedSolid, originBar, solidEndBar, level, str.lower(sess.chartLabel))
    else
        if not na(renderedSolid)
            line.delete(renderedSolid)
            renderedSolid := na
        if not na(renderedPending)
            line.delete(renderedPending)
            renderedPending := na
        if not na(renderedOpenLabel)
            label.delete(renderedOpenLabel)
            renderedOpenLabel := na
        renderedProvisionalLabel := resolve_pending_label(false, renderedProvisionalLabel, renderedPending, level, sess.chartLabel, sess.sessionIndex, sess.mitigationColor)
        resolve_mitigation_reminders(false, mitigationReminders, renderedSolid, originBar, na, level, str.lower(sess.chartLabel), showMitigationReminders)
        resolve_open_level_reminders(false, openReminders, renderedSolid, originBar, na, level, str.lower(sess.chartLabel))
    [renderedSolid, renderedPending, renderedOpenLabel, renderedProvisionalLabel]

renderFocusRetracement(bool reached, int originTime, int reachedTime, int originBar, int reachedBar, float level, string tagText, color lineColor, color textColor, color bgColor, bool faded, bool refreshStyle, line target, array<label> labels) =>
    line rendered = target
    if reached and showAllLines
        color renderedLineColor = faded ? fadeToward100(lineColor, completedRetraceFade) : lineColor
        color renderedTextColor = faded ? fadeToward100(textColor, completedRetraceFade) : textColor
        color renderedBgColor = faded ? fadeToward100(bgColor, completedRetraceFade) : bgColor
        if na(rendered)
            rendered := line.new(originTime, level, reachedTime, level, color=renderedLineColor, style=line.style_dotted, width=tagText == LABEL_RETRACE_50 ? MITIGATION_50_LINE_WIDTH : MITIGATION_618_LINE_WIDTH, xloc=xloc.bar_time)
        else if refreshStyle
            line.set_color(rendered, renderedLineColor)
        if showAllLabels
            if array.size(labels) == 0
                for lbl in tile_line_labels(originBar, reachedBar, level, tagText, showMitigationReminders, renderedTextColor, renderedBgColor)
                    array.push(labels, lbl)
            else if refreshStyle
                for lbl in labels
                    label.set_textcolor(lbl, renderedTextColor)
                    label.set_color(lbl, renderedBgColor)
        else
            deleteLabels(labels)
    else
        if not na(rendered)
            line.delete(rendered)
            rendered := na
        deleteLabels(labels)
    rendered

renderFocusSession(SessionData sess, bool selected) =>
    if not selected
        deleteSession(sess)
    if selected
        // deleteSession nulls bodyBox on deselection, so na doubles as the drawn-once sentinel.
        if na(sess.bodyBox)
            if not skipsCore(sess.sessionIndex)
                sess.bodyBox := drawCoreBox(sess, sess.bodyHigh, sess.bodyLow)
                sess.wickBox := drawCoreBox(sess, sess.wickHigh, sess.wickLow)
            if sess.deviationMode == OPT_BODY or sess.deviationMode == OPT_BOTH
                drawCoreWithDeviations(sess, sess.bodyHigh, sess.bodyLow, sess.bodyHeight, true)
            if sess.deviationMode == OPT_WICK or sess.deviationMode == OPT_BOTH
                drawCoreWithDeviations(sess, sess.wickHigh, sess.wickLow, sess.wickHeight, false)
            drawSessionNameLabel(sess)

        if sess.showMitigation
            [highSolid, highPending, highOpenLabel, highProvisionalLabel] = renderFocusBoundary(sess, true)
            sess.highMitigationLine := highSolid
            sess.highPendingLine := highPending
            sess.highUnmitigatedLabel := highOpenLabel
            sess.highPendingLabel := highProvisionalLabel

            [lowSolid, lowPending, lowOpenLabel, lowProvisionalLabel] = renderFocusBoundary(sess, false)
            sess.lowMitigationLine := lowSolid
            sess.lowPendingLine := lowPending
            sess.lowUnmitigatedLabel := lowOpenLabel
            sess.lowPendingLabel := lowProvisionalLabel

            bool retracementsFaded = fadeCompletedRetracements and isRetraceTraversalComplete(sess)
            bool refreshRetracementStyle = retracementsFaded != sess.retraceFadeApplied
            sess.midMitigationLine := renderFocusRetracement(sess.midMitigated, sess.actualEndTime, sess.midMitigationTime, sess.actualEndBar, sess.midMitigationBar, sess.midLevel, LABEL_RETRACE_50, sess.mitigationColor, sess.retraceLabelTextColor, sess.retraceLabelBgColor, retracementsFaded, refreshRetracementStyle, sess.midMitigationLine, sess.midMitigationLabels)
            sess.retrace618Line := renderFocusRetracement(sess.retrace618Mitigated, sess.actualEndTime, sess.retrace618Time, sess.actualEndBar, sess.retrace618Bar, sess.retraceLevel618, LABEL_RETRACE_618, sess.mitigationColor, sess.retraceLabelTextColor, sess.retraceLabelBgColor, retracementsFaded, refreshRetracementStyle, sess.retrace618Line, sess.retrace618Labels)
            sess.retraceFadeApplied := retracementsFaded

// Clear live drawings from active session (keeps session data, just removes visuals for redraw)
clearLiveDrawings(SessionData sess) =>
    if not na(sess.bodyBox)
        box.delete(sess.bodyBox)
        sess.bodyBox := na
    if not na(sess.wickBox)
        box.delete(sess.wickBox)
        sess.wickBox := na
    deleteLines(sess.lines)
    deleteLabels(sess.labels)
    for db in sess.deviationBoxes
        box.delete(db)
    array.clear(sess.deviationBoxes)

// Draw live deviations for active session (uses projected end time)
drawLiveSessionDeviations(SessionData sess, int projectedEndTime, int currentBarIndex) =>
    // Set temporary end values for drawing
    sess.endTime := projectedEndTime
    sess.endBar := currentBarIndex

    // Calculate heights
    bodyHeight = sess.bodyHigh - sess.bodyLow
    wickHeight = sess.wickHigh - sess.wickLow

    // Draw core boxes
    if not skipsCore(sess.sessionIndex)
        sess.bodyBox := drawCoreBox(sess, sess.bodyHigh, sess.bodyLow)
        sess.wickBox := drawCoreBox(sess, sess.wickHigh, sess.wickLow)

    // Draw body deviations if mode is Body or Both
    if sess.deviationMode == OPT_BODY or sess.deviationMode == OPT_BOTH
        drawCoreWithDeviations(sess, sess.bodyHigh, sess.bodyLow, bodyHeight, true)

    // Draw wick deviations if mode is Wick or Both
    if sess.deviationMode == OPT_WICK or sess.deviationMode == OPT_BOTH
        drawCoreWithDeviations(sess, sess.wickHigh, sess.wickLow, wickHeight, false)

    drawSessionNameLabel(sess)

updateDeviationGeometry(SessionData sess, float highPrice, float lowPrice, float height, array<DeviationZone> zones, bool showLines, bool showLabels, string labelPosition, int startBarOffset, int endBarOffset, int boxCursor, int lineCursor, int labelCursor) =>
    int nextBox = boxCursor
    int nextLine = lineCursor
    int nextLabel = labelCursor
    int baseLabelTime = labelPosition == "Left" ? sess.startTime : sess.endTime
    int labelOffset = labelPosition == "Left" ? startBarOffset : endBarOffset
    int labelX = timeWithOffset(baseLabelTime, labelOffset)
    int startX = timeWithOffset(sess.startTime, startBarOffset)
    int endX = timeWithOffset(sess.endTime, endBarOffset) + nz(sess.deviationExtendMs, 0)

    for zone in zones
        if zone.isRange
            float aboveFrom = highPrice + height * zone.innerLevel
            float aboveTo = highPrice + height * zone.outerLevel
            box aboveBox = array.get(sess.deviationBoxes, nextBox)
            box.set_left(aboveBox, startX)
            box.set_right(aboveBox, endX)
            box.set_top(aboveBox, aboveFrom)
            box.set_bottom(aboveBox, aboveTo)
            nextBox += 1
            if showLabels
                label aboveInnerLabel = array.get(sess.labels, nextLabel)
                label.set_x(aboveInnerLabel, labelX)
                label.set_y(aboveInnerLabel, aboveFrom)
                nextLabel += 1
                label aboveOuterLabel = array.get(sess.labels, nextLabel)
                label.set_x(aboveOuterLabel, labelX)
                label.set_y(aboveOuterLabel, aboveTo)
                nextLabel += 1

            float belowFrom = lowPrice - height * zone.innerLevel
            float belowTo = lowPrice - height * zone.outerLevel
            box belowBox = array.get(sess.deviationBoxes, nextBox)
            box.set_left(belowBox, startX)
            box.set_right(belowBox, endX)
            box.set_top(belowBox, belowFrom)
            box.set_bottom(belowBox, belowTo)
            nextBox += 1
            if showLabels
                label belowInnerLabel = array.get(sess.labels, nextLabel)
                label.set_x(belowInnerLabel, labelX)
                label.set_y(belowInnerLabel, belowFrom)
                nextLabel += 1
                label belowOuterLabel = array.get(sess.labels, nextLabel)
                label.set_x(belowOuterLabel, labelX)
                label.set_y(belowOuterLabel, belowTo)
                nextLabel += 1
        else if showLines
            float aboveLevel = highPrice + height * zone.outerLevel
            line aboveLine = array.get(sess.lines, nextLine)
            line.set_xy1(aboveLine, startX, aboveLevel)
            line.set_xy2(aboveLine, endX, aboveLevel)
            nextLine += 1
            if showLabels
                label aboveLabel = array.get(sess.labels, nextLabel)
                label.set_x(aboveLabel, labelX)
                label.set_y(aboveLabel, aboveLevel)
                nextLabel += 1

            float belowLevel = lowPrice - height * zone.outerLevel
            line belowLine = array.get(sess.lines, nextLine)
            line.set_xy1(belowLine, startX, belowLevel)
            line.set_xy2(belowLine, endX, belowLevel)
            nextLine += 1
            if showLabels
                label belowLabel = array.get(sess.labels, nextLabel)
                label.set_x(belowLabel, labelX)
                label.set_y(belowLabel, belowLevel)
                nextLabel += 1
    [nextBox, nextLine, nextLabel]

updateCoreDeviationGeometry(SessionData sess, float highPrice, float lowPrice, float height, bool isBody, int boxCursor, int lineCursor, int labelCursor) =>
    int nextBox = boxCursor
    int nextLine = lineCursor
    int nextLabel = labelCursor
    [startOffset, endOffset] = calculateOffsets(sess, isBody)
    string labelPosition = sess.deviationMode == OPT_BOTH ? (isBody ? "Right" : "Left") : "Left"
    bool showLabels = showAllLabels and (sess.deviationLabelsMode == OPT_BOTH or (sess.deviationLabelsMode == OPT_BODY and isBody) or (sess.deviationLabelsMode == OPT_WICK and not isBody))
    [updatedBox, updatedLine, updatedLabel] = updateDeviationGeometry(sess, highPrice, lowPrice, height, getCachedZones(sess.sessionIndex), showAllLines, showLabels, labelPosition, startOffset, endOffset, nextBox, nextLine, nextLabel)
    nextBox := updatedBox
    nextLine := updatedLine
    nextLabel := updatedLabel
    [nextBox, nextLine, nextLabel]

updateLiveSessionDrawings(SessionData sess, int projectedEndTime, int currentBarIndex) =>
    sess.endTime := projectedEndTime
    sess.endBar := currentBarIndex
    float bodyHeight = sess.bodyHigh - sess.bodyLow
    float wickHeight = sess.wickHigh - sess.wickLow

    if not skipsCore(sess.sessionIndex)
        box.set_right(sess.bodyBox, projectedEndTime)
        box.set_top(sess.bodyBox, sess.bodyHigh)
        box.set_bottom(sess.bodyBox, sess.bodyLow)
        box.set_right(sess.wickBox, projectedEndTime)
        box.set_top(sess.wickBox, sess.wickHigh)
        box.set_bottom(sess.wickBox, sess.wickLow)

    int boxCursor = 0
    int lineCursor = 0
    int labelCursor = 0
    if sess.deviationMode == OPT_BODY or sess.deviationMode == OPT_BOTH
        [bodyNextBox, bodyNextLine, bodyNextLabel] = updateCoreDeviationGeometry(sess, sess.bodyHigh, sess.bodyLow, bodyHeight, true, boxCursor, lineCursor, labelCursor)
        boxCursor := bodyNextBox
        lineCursor := bodyNextLine
        labelCursor := bodyNextLabel
    if sess.deviationMode == OPT_WICK or sess.deviationMode == OPT_BOTH
        [wickNextBox, wickNextLine, wickNextLabel] = updateCoreDeviationGeometry(sess, sess.wickHigh, sess.wickLow, wickHeight, false, boxCursor, lineCursor, labelCursor)
        boxCursor := wickNextBox
        lineCursor := wickNextLine
        labelCursor := wickNextLabel

    if showAllLabels and showSessionNames
        label sessionLabel = array.get(sess.labels, labelCursor)
        label.set_x(sessionLabel, int(math.round((sess.startTime + sess.endTime) / 2)))
        label.set_y(sessionLabel, sess.labelPosition == OPT_ABOVE ? sess.wickHigh : sess.wickLow)

// ═══════════════════════════════════════════════════════════════════════════
// INITIALIZATION
// ═══════════════════════════════════════════════════════════════════════════

if na(cachedDeviations_0129)
    // Parse and cache all deviation zones
    cachedDeviations_0129 := parseDeviationZones(deviations_2130_0129)
    cachedDeviations_ny_early := parseDeviationZones(deviations_0600_0900)
    cachedDeviations_premarket := parseDeviationZones(deviations_0500_0915)
    cachedDeviations_ivb := parseDeviationZones(deviations_0930_1000)
    cachedDeviations_asia_open := parseDeviationZones(deviations_1800_2100)

// ═══════════════════════════════════════════════════════════════════════════
// SESSION CONFIGURATION - Single array replaces 14 parallel arrays
// ═══════════════════════════════════════════════════════════════════════════

var array<SessionConfig> sessionConfigs = array.from(
    SessionConfig.new(opening_2130_0129, opening_2130_0129_offset, opening_2130_0129_showLabels, 1290, 90, opening_2130_0129_coreColor, opening_2130_0129_deviationColor, SESSION_INTRADAY_0129, CHART_LABEL_0129, opening_2130_0129_labelPosition, opening_2130_0129_mitigation, opening_2130_0129_mitigationColor, true, opening_2130_0129_extend, true, opening_2130_0129_retraceLabelTextColor, opening_2130_0129_retraceLabelBgColor, false, true, RETRACE_MODE_STANDARD),
    SessionConfig.new(opening_0600_0900, opening_0600_0900_offset, opening_0600_0900_showLabels, 360, 540, opening_0600_0900_coreColor, opening_0600_0900_deviationColor, SESSION_EXTENDED_0600_0900, CHART_LABEL_0600_0900, opening_0600_0900_labelPosition, opening_0600_0900_mitigation, opening_0600_0900_mitigationColor, false, opening_0600_0900_extend, true, opening_0600_0900_retraceLabelTextColor, opening_0600_0900_retraceLabelBgColor, true, opening_0600_0900_showRetracement, opening_0600_0900_retracementMode),
    SessionConfig.new(opening_0500_0915, opening_0500_0915_offset, opening_0500_0915_showLabels, 300, 555, opening_0500_0915_coreColor, opening_0500_0915_deviationColor, SESSION_EXTENDED_0500_0915, CHART_LABEL_0500_0915, opening_0500_0915_labelPosition, opening_0500_0915_mitigation, opening_0500_0915_mitigationColor, false, opening_0500_0915_extend, false, labelColor, labelsBgColor, false, true, RETRACE_MODE_STANDARD),
    SessionConfig.new(opening_1800_2100, opening_1800_2100_offset, opening_1800_2100_showLabels, ASIA_OPEN_START_MIN, ASIA_OPEN_END_MIN, opening_1800_2100_coreColor, opening_1800_2100_deviationColor, SESSION_EXTENDED_1800_2100, CHART_LABEL_1800_2100, opening_1800_2100_labelPosition, opening_1800_2100_mitigation, opening_1800_2100_mitigationColor, true, opening_1800_2100_extend, true, opening_1800_2100_retraceLabelTextColor, opening_1800_2100_retraceLabelBgColor, false, true, RETRACE_MODE_STANDARD),
    SessionConfig.new(opening_0930_1000, opening_0930_1000_offset, opening_0930_1000_showLabels, IVB_START_MIN, IVB_END_MIN, opening_0930_1000_coreColor, opening_0930_1000_deviationColor, SESSION_EXTENDED_0930_1000, CHART_LABEL_0930_1000, opening_0930_1000_labelPosition, opening_0930_1000_mitigation, opening_0930_1000_mitigationColor, false, opening_0930_1000_extend, true, opening_0930_1000_retraceLabelTextColor, opening_0930_1000_retraceLabelBgColor, true, true, RETRACE_MODE_STANDARD)
)

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 1: SESSION DETECTION - Detect new sessions starting
// ═══════════════════════════════════════════════════════════════════════════

barMinutes = validChartContext ? hour(time, NY_TIMEZONE) * 60 + minute(time, NY_TIMEZONE) : 0
currentDayKey = validChartContext ? dayKey(time) : 0
prevBarMinutes = validChartContext ? hour(time[1], NY_TIMEZONE) * 60 + minute(time[1], NY_TIMEZONE) : 0
currentDayStart = timestamp(NY_TIMEZONE, year(time, NY_TIMEZONE), month(time, NY_TIMEZONE), dayofmonth(time, NY_TIMEZONE), 0, 0)

if validChartContext and bar_index > 0 and currentDayKey != currentDayKey[1]
    map.clear(ivbHighByDay)
    map.clear(ivbLowByDay)
    map.clear(ivbBreakTimeByDay)
    map.clear(ivbBreakSideByDay)

// ═══════════════════════════════════════════════════════════════════════════
// 30M DATA - Confirmed close for IVB mitigation
// ═══════════════════════════════════════════════════════════════════════════

// Confirmed standard-OHLC 30m close + its bar-open time, for IVB mitigation. close[1] + lookahead_on
// is the no-repaint idiom: returns only fully-closed 30m values. Single tuple request keeps it to one security call.
// Note: on a 30m chart this confirms one bar later than on lower TFs (the close is only known after the bar closes).
[htf30mClose, htf30mTime] = request.security(ticker.standard(syminfo.tickerid), "30", [close[1], time[1]], lookahead=barmerge.lookahead_on)
htf30mDayKey = na(htf30mTime) ? 0 : dayKey(htf30mTime)

// Accumulate the complete Asia session in the standard 1-minute context. A stateful lower-timeframe
// expression preserves intermediate bars that request.security() would otherwise sample away.
[standardAsiaBodyHigh, standardAsiaBodyLow, standardAsiaWickHigh, standardAsiaWickLow, standardAsiaHighTime, standardAsiaLowTime, standardAsiaDayKey, standardAsiaStartTime] = request.security(ticker.standard(syminfo.tickerid), STANDARD_SESSION_SOURCE_TF, sessionPriceState(ASIA_OPEN_START_MIN, ASIA_OPEN_END_MIN), lookahead=barmerge.lookahead_off)
standardAsiaReady = standardAsiaDayKey == currentDayKey and not na(standardAsiaBodyHigh) and not na(standardAsiaBodyLow) and not na(standardAsiaWickHigh) and not na(standardAsiaWickLow) and not na(standardAsiaHighTime) and not na(standardAsiaLowTime) and not na(standardAsiaStartTime)

// Time windows used by mitigation logic
PREMARKET_START_MIN = array.get(sessionConfigs, IDX_PREMARKET).startMin  // 300 = 05:00
CLOSE_1600_MIN = 960  // 16:00 = 16 * 60

if validChartContext
    for i = 0 to array.size(sessionConfigs) - 1
        SessionConfig cfg = array.get(sessionConfigs, i)

        if cfg.mode != OPT_HIDDEN and isInFilter(i)
            // Handle midnight-crossing sessions (e.g., 16:00-05:00)
            crossesMidnight = cfg.endMin < cfg.startMin

            // Check if we're entering this session
            currentlyInSession = isInSessionTime(barMinutes, cfg.startMin, cfg.endMin, crossesMidnight)
            previouslyInSession = isInSessionTime(prevBarMinutes, cfg.startMin, cfg.endMin, crossesMidnight)
            sessionStarted = currentlyInSession and not previouslyInSession
            if chart.is_range and i == IDX_ASIA_OPEN
                bool hasActiveAsiaSession = false
                if array.size(activeSessions) > 0
                    for activeSession in activeSessions
                        if activeSession.sessionIndex == IDX_ASIA_OPEN
                            hasActiveAsiaSession := true
                            break
                sessionStarted := currentlyInSession and standardAsiaReady and not hasActiveAsiaSession

            if sessionStarted
                if i == IDX_IVB
                    SessionData previousIvb = array.get(latestCompletedSessions, IDX_IVB)
                    if not na(previousIvb)
                        resetSessionIvbExtensionGlow(previousIvb)
                bool usesStandardAsia = chart.is_range and i == IDX_ASIA_OPEN
                initBodyHigh = usesStandardAsia ? standardAsiaBodyHigh : math.max(open, close)
                initBodyLow = usesStandardAsia ? standardAsiaBodyLow : math.min(open, close)
                initWickHigh = usesStandardAsia ? standardAsiaWickHigh : high
                initWickLow = usesStandardAsia ? standardAsiaWickLow : low
                int initStartTime = usesStandardAsia ? standardAsiaStartTime : time
                int initDayKey = usesStandardAsia ? standardAsiaDayKey : currentDayKey

                newSession = SessionData.new(
                     sessionIndex=i,
                     startBar=bar_index,
                     endBar=na,
                     startTime=initStartTime,
                     endTime=na,
                     actualEndTime=na,
                     actualEndBar=na,
                     bodyHigh=initBodyHigh,
                     bodyLow=initBodyLow,
                     wickHigh=initWickHigh,
                     wickLow=initWickLow,
                     bodyHeight=na,
                     wickHeight=na,
                     bodyBox=na,
                     wickBox=na,
                     lines=array.new<line>(),
                     labels=array.new<label>(),
                     deviationBoxes=array.new<box>(),
                     coreColor=cfg.coreColor,
                     deviationColor=cfg.deviationColor,
                     sessionName=cfg.name,
                     chartLabel=cfg.chartLabel,
                     useOffset=cfg.offset,
                     deviationMode=cfg.mode,
                     deviationLabelsMode=cfg.showLabels,
                     labelPosition=cfg.labelPosition,
                     showMitigation=cfg.mitigation,
                     mitigationColor=cfg.mitigationColor,
                     dominantHigh=na,
                     dominantLow=na,
                     highTime=usesStandardAsia ? standardAsiaHighTime : time,
                     lowTime=usesStandardAsia ? standardAsiaLowTime : time,
                     highBar=bar_index,
                     lowBar=bar_index,
                     highMitigated=false,
                     lowMitigated=false,
                     highMitigationBar=na,
                     lowMitigationBar=na,
                     highMitigationTime=na,
                     lowMitigationTime=na,
                     highMitigationLine=na,
                     lowMitigationLine=na,
                     highMitigationReminders=array.new<label>(),
                     lowMitigationReminders=array.new<label>(),
                     highMitigationFadeApplied=false,
                     lowMitigationFadeApplied=false,
                     highUnmitigatedLine=na,
                     lowUnmitigatedLine=na,
                     highUnmitigatedLabel=na,
                     lowUnmitigatedLabel=na,
                     highUnmitigatedReminders=array.new<label>(),
                     lowUnmitigatedReminders=array.new<label>(),
                     midLevel=na,
                     midMitigated=false,
                     midMitigationTime=na,
                     midMitigationBar=na,
                     midMitigationLine=na,
                     midMitigationLabels=array.new<label>(),
                     midArmed=false,
                     retraceLevel618=na,
                     retrace618Mitigated=false,
                     retrace618Time=na,
                     retrace618Bar=na,
                     retrace618Line=na,
                     retrace618Labels=array.new<label>(),
                     retrace618Armed=false,
                     retraceOriginSide=0,
                     retraceOriginBar=na,
                     retraceOriginProvisional=false,
                     retraceLegStartBar=na,
                     retraceTraversalCompleted=false,
                     retraceFadeApplied=false,
                     ivbBreakTime=na,
                     ivbBreakSide=0,
                     ivbRetraceBar=na,
                     ivbRetraceCompleted=false,
                     delayedMitigation=cfg.delayedMitigation,
                     isKeySession=cfg.isKeySession,
                     retraceLabelTextColor=cfg.retraceLabelTextColor,
                     retraceLabelBgColor=cfg.retraceLabelBgColor,
                     retraceCapAt1600=cfg.retraceCapAt1600,
                     showRetracement=cfg.showRetracement,
                     retracementMode=cfg.retracementMode,
                     crossesMidnight=crossesMidnight,
                     startDayKey=initDayKey,
                     nextDayKey=dayKey(initStartTime + 24 * 60 * 60 * 1000),
                     provisionalHighMitigated=false,
                     provisionalLowMitigated=false,
                     provisionalHighTime=na,
                     provisionalLowTime=na,
                     provisionalHighBar=na,
                     provisionalLowBar=na,
                     highPendingLine=na,
                     lowPendingLine=na,
                     highPendingLabel=na,
                     lowPendingLabel=na,
                     deviationExtendMs=getSessionExtendMs(i),
                     asiaDev15UpperGlowBox=na,
                     asiaDev15LowerGlowBox=na,
                     extHighProcessed=false,
                     extLowProcessed=false,
                     extHighTime=na,
                     extLowTime=na,
                     extHighConfirmed=false,
                     extLowConfirmed=false,
                     extLines=array.new<line>(),
                     extLabels=array.new<label>()
                 )

                array.push(activeSessions, newSession)

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 2: SESSION TRACKING - Update all active sessions
// ═══════════════════════════════════════════════════════════════════════════

if validChartContext and array.size(activeSessions) > 0
    for sess in activeSessions
        idx = sess.sessionIndex
        SessionConfig sessCfg = array.get(sessionConfigs, idx)

        // Handle midnight-crossing sessions
        crossesMidnight = sessCfg.endMin < sessCfg.startMin

        // Check if current bar is within this session's time range
        isBarInSession = isInSessionTime(barMinutes, sessCfg.startMin, sessCfg.endMin, crossesMidnight)

        if isBarInSession
            // Update session high/low values with current bar
            bool usesStandardAsia = chart.is_range and idx == IDX_ASIA_OPEN and standardAsiaDayKey == sess.startDayKey
            currentBodyHigh = usesStandardAsia ? standardAsiaBodyHigh : math.max(open, close)
            currentBodyLow = usesStandardAsia ? standardAsiaBodyLow : math.min(open, close)
            currentWickHigh = usesStandardAsia ? standardAsiaWickHigh : high
            currentWickLow = usesStandardAsia ? standardAsiaWickLow : low
            bool bodyGeometryChanged = currentBodyHigh > sess.bodyHigh or currentBodyLow < sess.bodyLow
            bool wickGeometryChanged = currentWickHigh > sess.wickHigh or currentWickLow < sess.wickLow
            bool offsetGeometryChanged = sess.useOffset and sess.deviationMode == OPT_BOTH and sess.endBar != bar_index
            bool liveGeometryChanged = na(sess.endBar) or bodyGeometryChanged or wickGeometryChanged or offsetGeometryChanged

            // Track the bar time when new highs/lows are formed
            if currentWickHigh > sess.wickHigh
                sess.highTime := usesStandardAsia ? standardAsiaHighTime : time
                sess.highBar := bar_index
            if currentWickLow < sess.wickLow
                sess.lowTime := usesStandardAsia ? standardAsiaLowTime : time
                sess.lowBar := bar_index

            // Update body/wick levels with current bar
            sess.bodyHigh := math.max(sess.bodyHigh, currentBodyHigh)
            sess.bodyLow := math.min(sess.bodyLow, currentBodyLow)
            sess.wickHigh := math.max(sess.wickHigh, currentWickHigh)
            sess.wickLow := math.min(sess.wickLow, currentWickLow)

            if liveGeometryChanged
                // Calculate projected end time based on session's end minute
                projectedEndTime = crossesMidnight and barMinutes >= sessCfg.startMin ? currentDayStart + 24 * 60 * 60 * 1000 + sessCfg.endMin * 60 * 1000 : currentDayStart + sessCfg.endMin * 60 * 1000
                if na(sess.endBar)
                    drawLiveSessionDeviations(sess, projectedEndTime, bar_index)
                else
                    updateLiveSessionDrawings(sess, projectedEndTime, bar_index)

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 3: SESSION FINALIZATION - Finalize and remove ended sessions
// ═══════════════════════════════════════════════════════════════════════════

if validChartContext and array.size(activeSessions) > 0
    for i = array.size(activeSessions) - 1 to 0
        sess = array.get(activeSessions, i)
        idx = sess.sessionIndex
        SessionConfig endCfg = array.get(sessionConfigs, idx)
        int startMin = endCfg.startMin
        int endMin = endCfg.endMin

        // Handle midnight-crossing sessions
        crossesMidnight = endMin < startMin

        // Detect session end transition
        isCurrentBarInSession = isInSessionTime(barMinutes, startMin, endMin, crossesMidnight)
        wasPreviousBarInSession = isInSessionTime(prevBarMinutes, startMin, endMin, crossesMidnight)
        hasSessionEnded = not isCurrentBarInSession and wasPreviousBarInSession

        if hasSessionEnded
            // Finalize session - calculate heights and draw visualizations
            sess.endBar := bar_index - 1
            // Time charts end at the scheduled boundary; Range charts stop at the last eligible bar timestamp.
            sess.actualEndTime := chart.is_range and not na(time[1]) ? time[1] : sess.endTime
            sess.actualEndBar := chart.is_range ? sess.endBar : bar_index
            sess.endTime := sess.actualEndTime

            // Clear live drawings before final draw
            clearLiveDrawings(sess)

            // Store heights for use in progressive unlock
            sess.bodyHeight := sess.bodyHigh - sess.bodyLow
            sess.wickHeight := sess.wickHigh - sess.wickLow
            bodyHeight = sess.bodyHeight
            wickHeight = sess.wickHeight

            // Calculate dominant high/low for mitigation tracking
            // Use wick extremes unless mode is Body-only
            if sess.deviationMode == OPT_BODY
                sess.dominantHigh := sess.bodyHigh
                sess.dominantLow := sess.bodyLow
            else
                sess.dominantHigh := sess.wickHigh
                sess.dominantLow := sess.wickLow

            // Calculate 50% level based on the larger range (both are always shown)
            if wickHeight >= bodyHeight
                sess.midLevel := (sess.wickHigh + sess.wickLow) / 2
            else
                sess.midLevel := (sess.bodyHigh + sess.bodyLow) / 2

            // Focus-managed sessions defer their drawings to Phase 4.5; Phase 4 owns every lifecycle.
            if not focusManaged(idx)
                // Draw core boxes
                if not skipsCore(idx)
                    sess.bodyBox := drawCoreBox(sess, sess.bodyHigh, sess.bodyLow)
                    sess.wickBox := drawCoreBox(sess, sess.wickHigh, sess.wickLow)

                // Draw body deviations if mode is Body or Both
                if sess.deviationMode == OPT_BODY or sess.deviationMode == OPT_BOTH
                    drawCoreWithDeviations(sess, sess.bodyHigh, sess.bodyLow, bodyHeight, true)

                // Draw wick deviations if mode is Wick or Both
                if sess.deviationMode == OPT_WICK or sess.deviationMode == OPT_BOTH
                    drawCoreWithDeviations(sess, sess.wickHigh, sess.wickLow, wickHeight, false)

                drawSessionNameLabel(sess)

            // Add to completed sessions
            registerLatestCompletedSession(sess)
            if sess.sessionIndex == IDX_IVB
                map.put(ivbHighByDay, sess.startDayKey, sess.wickHigh)
                map.put(ivbLowByDay, sess.startDayKey, sess.wickLow)
            sessions.push(sess)
            if sess.showMitigation
                lifecycleSessions.push(sess)

            // Focus-managed sessions retain all loaded history for deep ranking.
            if not focusManaged(idx)
                int sessionsOfThisType = 0
                int oldestSessionIndex = na
                for j = 0 to array.size(sessions) - 1
                    SessionData retainedSess = array.get(sessions, j)
                    if retainedSess.sessionIndex == sess.sessionIndex
                        sessionsOfThisType += 1
                        if na(oldestSessionIndex)
                            oldestSessionIndex := j

                if sessionsOfThisType > maxSessions and not na(oldestSessionIndex)
                    SessionData oldSession = array.get(sessions, oldestSessionIndex)
                    if array.size(lifecycleSessions) > 0
                        for lifecycleIndex = array.size(lifecycleSessions) - 1 to 0
                            SessionData lifecycleSession = array.get(lifecycleSessions, lifecycleIndex)
                            if lifecycleSession.sessionIndex == oldSession.sessionIndex and lifecycleSession.startTime == oldSession.startTime
                                array.remove(lifecycleSessions, lifecycleIndex)
                                break
                    deleteSession(oldSession)
                    array.remove(sessions, oldestSessionIndex)

            // Remove from active sessions
            array.remove(activeSessions, i)

// ═══════════════════════════════════════════════════════════════════════════
// IVB BREAKOUT EXTENSION STATISTICS
// ═══════════════════════════════════════════════════════════════════════════
// Rolling history of how far price travels beyond a broken IVB edge (10:00-16:00, same day),
// as a ratio of that day's IVB range. Each broken side contributes one sample. Tracked globally
// (not on SessionData) so the sample window survives maxSessions pruning. A day's samples are
// pushed at 16:00 (or the next day's open on early closes), so the projections drawn on a
// breach always come from prior days only.

type IvbExtState
    array<float> ratios  // Rolling excursion/range samples, capped at the lookback input
    float dayHigh        // Tracked day's IVB wick high (na = no day being tracked)
    float dayLow
    float maxAbove       // Max excursion above dayHigh so far (0 = side never broken)
    float maxBelow
    int dayStart         // currentDayStart of the tracked day, for rollover detection

var IvbExtState ivbExtState = IvbExtState.new(array.new<float>(), na, na, 0.0, 0.0, na)

ivbExtFeatureOn = opening_0930_1000_showExtensions and opening_0930_1000 != OPT_HIDDEN and isInFilter(IDX_IVB)

// Push the tracked day's excursion samples into the rolling window and reset the day state.
finalizeIvbExtDay(IvbExtState st) =>
    if not na(st.dayHigh) and st.dayHigh > st.dayLow
        float statRange = st.dayHigh - st.dayLow
        if st.maxAbove > 0
            array.push(st.ratios, st.maxAbove / statRange)
        if st.maxBelow > 0
            array.push(st.ratios, st.maxBelow / statRange)
        while array.size(st.ratios) > opening_0930_1000_extLookback
            array.shift(st.ratios)
    st.dayHigh := na
    st.dayLow := na
    st.maxAbove := 0.0
    st.maxBelow := 0.0

if validChartContext and ivbExtFeatureOn
    // Close out the tracked day at the 16:00 crossing, or at the first bar of a new NY day
    // (covers early closes that never print a 16:00 bar).
    bool crossed1600 = barMinutes >= CLOSE_1600_MIN and prevBarMinutes < CLOSE_1600_MIN
    if crossed1600 or (not na(ivbExtState.dayStart) and currentDayStart != ivbExtState.dayStart)
        finalizeIvbExtDay(ivbExtState)
    if barMinutes >= IVB_START_MIN and barMinutes < IVB_END_MIN
        ivbExtState.dayHigh := na(ivbExtState.dayHigh) ? high : math.max(ivbExtState.dayHigh, high)
        ivbExtState.dayLow := na(ivbExtState.dayLow) ? low : math.min(ivbExtState.dayLow, low)
        ivbExtState.dayStart := currentDayStart
    else if barMinutes >= IVB_END_MIN and barMinutes < CLOSE_1600_MIN and not na(ivbExtState.dayHigh)
        ivbExtState.maxAbove := math.max(ivbExtState.maxAbove, high - ivbExtState.dayHigh)
        ivbExtState.maxBelow := math.max(ivbExtState.maxBelow, ivbExtState.dayLow - low)

// Reveal the average / avg+1σ projection after confirmation, anchored at the original IVB break.
drawIvbExtensions(SessionData sess, bool brokeHigh) =>
    int projectionStartTime = brokeHigh ? sess.extHighTime : sess.extLowTime
    if ivbExtFeatureOn and showAllLines and barMinutes >= IVB_END_MIN and barMinutes < CLOSE_1600_MIN and not na(projectionStartTime) and array.size(ivbExtState.ratios) >= IVB_EXT_MIN_SAMPLES
        // Statistics are trained on wick ranges, so projections must use the same basis even
        // when the IVB display/mitigation mode is configured to use body levels.
        float rangeHeight = sess.wickHigh - sess.wickLow
        float avgRatio = array.avg(ivbExtState.ratios)
        float stdRatio = array.stdev(ivbExtState.ratios)
        float direction = brokeHigh ? 1.0 : -1.0
        float edge = brokeHigh ? sess.wickHigh : sess.wickLow
        float avgLevel = edge + direction * rangeHeight * avgRatio
        float stdLevel = edge + direction * rangeHeight * (avgRatio + stdRatio)
        int scheduledEndTime = currentDayStart + CLOSE_1600_MIN * 60 * 1000
        int projectionEndTime = math.max(scheduledEndTime, projectionStartTime + IVB_EXT_MIN_VISIBLE_MS)
        line avgLine = line.new(projectionStartTime, avgLevel, projectionEndTime, avgLevel, color=opening_0930_1000_extColor, style=line.style_dashed, width=opening_0930_1000_extWidth, xloc=xloc.bar_time)
        line stdLine = line.new(projectionStartTime, stdLevel, projectionEndTime, stdLevel, color=opening_0930_1000_extColor, style=line.style_dashed, width=opening_0930_1000_extWidth, xloc=xloc.bar_time)
        array.push(sess.extLines, avgLine)
        array.push(sess.extLines, stdLine)
        if showAllLabels
            bool includePrice = priceModeShows(ivbProjectionShowPrice)
            array.push(sess.extLabels, newIvbProjectionLabel(avgLine, avgLevel, LABEL_EXT_AVG, includePrice, opening_0930_1000_extColor, labelsBgColor))
            array.push(sess.extLabels, newIvbProjectionLabel(stdLine, stdLevel, LABEL_EXT_STD, includePrice, opening_0930_1000_extColor, labelsBgColor))

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 3.5: ASIA + RAFAEL FOCUS ANCHOR - Manual anchor line and margin label
// ═══════════════════════════════════════════════════════════════════════════

if validChartContext and barstate.islast
    if focusManualAnchorSelected
        int anchorStartTime = nz(time[1], time)
        if na(focusAnchorLine)
            focusAnchorLine := line.new(anchorStartTime, focusAnchorPrice, time, focusAnchorPrice, xloc=xloc.bar_time, extend=extend.both, color=focusAnchorColor, width=focusAnchorWidth, style=line.style_solid)
        else
            line.set_xy1(focusAnchorLine, anchorStartTime, focusAnchorPrice)
            line.set_xy2(focusAnchorLine, time, focusAnchorPrice)
            line.set_color(focusAnchorLine, focusAnchorColor)
            line.set_width(focusAnchorLine, focusAnchorWidth)
        string anchorText = (focusManualPricePlaced ? LABEL_FOCUS_ANCHOR : LABEL_FOCUS_ANCHOR_UNSET) + " " + str.tostring(focusAnchorPrice, format.mintick)
        if na(focusAnchorLabel)
            focusAnchorLabel := label.new(bar_index + focusAnchorLabelOffset, focusAnchorPrice, anchorText, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, textcolor=focusAnchorColor, size=globalLabelSize, color=labelsBgColor)
        else
            label.set_x(focusAnchorLabel, bar_index + focusAnchorLabelOffset)
            label.set_y(focusAnchorLabel, focusAnchorPrice)
            label.set_text(focusAnchorLabel, anchorText)
            label.set_textcolor(focusAnchorLabel, focusAnchorColor)
            label.set_color(focusAnchorLabel, labelsBgColor)
    else
        if not na(focusAnchorLine)
            line.delete(focusAnchorLine)
            focusAnchorLine := na
        if not na(focusAnchorLabel)
            label.delete(focusAnchorLabel)
            focusAnchorLabel := na

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 4: MITIGATION DETECTION - Check for breaches on completed sessions
// ═══════════════════════════════════════════════════════════════════════════

// IVB-based retracement requires IVB enabled and in the active filter.
ivbFeatureAvailable = opening_0930_1000 != OPT_HIDDEN and isInFilter(IDX_IVB)

if validChartContext and array.size(lifecycleSessions) > 0
    array.clear(completedLifecycleIndices)
    for lifecycleIndex = 0 to array.size(lifecycleSessions) - 1
        SessionData sess = array.get(lifecycleSessions, lifecycleIndex)
        if not na(sess.dominantHigh)
            // Focus-managed sessions run full state here but draw nothing; Phase 4.5 renders them.
            bool eagerDraw = not focusManaged(sess.sessionIndex)
            bool drawMitigationLines = showAllLines and eagerDraw
            // Same-day mitigation: only track mitigations on the same calendar day (Asia Open is exempt)
            // For midnight-crossing sessions (e.g., Rafael's 21:30-01:29): extend to next calendar day (the day session ends)
            isOnSessionStartDay = sess.startDayKey == currentDayKey
            isOnSessionEndDay = sess.crossesMidnight and sess.nextDayKey == currentDayKey
            // For delayed mitigation sessions, overnight window extends to next day's early morning (before 05:00)
            isInNextDayOvernightWindow = sess.delayedMitigation and sess.nextDayKey == currentDayKey and barMinutes < PREMARKET_START_MIN
            isOnActualSessionDay = isOnSessionStartDay or isOnSessionEndDay or isInNextDayOvernightWindow
            bool lifecycleExpired = not alwaysTrackMitigation(sess.sessionIndex) and not isOnActualSessionDay and currentDayKey != sess.startDayKey
            if lifecycleExpired
                completedMitigationShouldFade(sess, true)
                completedMitigationShouldFade(sess, false)
                if not completedMitigationFadePending(sess)
                    array.push(completedLifecycleIndices, lifecycleIndex)
                continue
            shouldTrackMitigation = alwaysTrackMitigation(sess.sessionIndex) or isOnActualSessionDay
            // For delayed mitigation (Asia Open), only evaluate from 05:00 to 16:00 (excludes overnight evening hours)
            canEvaluateMitigation = shouldTrackMitigation and canConfirmDelayedMitigation(sess, barMinutes, PREMARKET_START_MIN, CLOSE_1600_MIN)
            // Provisional window = genuine overnight only (formation evening + next day pre-05:00). Excludes the next day's post-RTH hours so a holiday-delayed revisit confirms (caps the dash) instead of staying pending past 05:00 — see crossesMidnight sessions (Rafael) where an empty holiday RTH window left the dash running.
            isInOvernightWindow = isDelayedProvisionalWindow(sess, barMinutes, PREMARKET_START_MIN, CLOSE_1600_MIN, currentDayKey)
            canEvaluateRetraceMitigation = not sess.retraceCapAt1600 or (shouldTrackMitigation and barMinutes < CLOSE_1600_MIN)
            bool showOpenKeyOverlay = mitigationMode == SESSION_MITIGATED and alwaysTrackMitigation(sess.sessionIndex)
            bool showPersistentLevels = mitigationMode == SESSION_UNMITIGATED or showOpenKeyOverlay

            // Record the first strict wick break per side for NY Early's IVB-based direction.
            // Projection drawing waits for the separate 30-minute close confirmation below.
            if sess.sessionIndex == IDX_IVB and canEvaluateMitigation and barMinutes < CLOSE_1600_MIN
                if not sess.extHighProcessed and high > sess.wickHigh
                    sess.extHighProcessed := true
                    sess.extHighTime := time
                if not sess.extLowProcessed and low < sess.wickLow
                    sess.extLowProcessed := true
                    sess.extLowTime := time
                if not sess.extHighConfirmed and not na(htf30mClose) and htf30mClose > sess.wickHigh and sess.startDayKey == htf30mDayKey
                    sess.extHighConfirmed := true
                    if eagerDraw
                        drawIvbExtensions(sess, true)
                if not sess.extLowConfirmed and not na(htf30mClose) and htf30mClose < sess.wickLow and sess.startDayKey == htf30mDayKey
                    sess.extLowConfirmed := true
                    if eagerDraw
                        drawIvbExtensions(sess, false)

            // === HIGH MITIGATION LOGIC ===
            if not sess.highMitigated
                if sess.sessionIndex == IDX_IVB
                    // IVB: solid until first wick touch (provisional), then dashed until a 30m candle CLOSES above — the actual mitigation
                    if not sess.provisionalHighMitigated and canEvaluateMitigation and high >= sess.dominantHigh
                        sess.provisionalHighMitigated := true
                        sess.provisionalHighTime := time
                        sess.provisionalHighBar := bar_index
                        if mitigationMode == SESSION_MITIGATED
                            [solid, pending] = draw_provisional_breach_lines(drawMitigationLines, sess.highTime, sess.dominantHigh, sess.mitigationColor)
                            sess.highMitigationLine := solid
                            sess.highPendingLine := pending
                    if sess.provisionalHighMitigated and not na(htf30mClose) and htf30mClose > sess.dominantHigh and sess.startDayKey == htf30mDayKey
                        sess.highMitigated := true
                        sess.highMitigationBar := bar_index
                        sess.highMitigationTime := ivbConfirmationEndTime(htf30mTime, sess.provisionalHighTime, time, chart.is_range, BAR_MS)
                        if mitigationMode == SESSION_MITIGATED and not na(sess.highPendingLine)
                            line.set_x2(sess.highPendingLine, sess.highMitigationTime)
                    if sess.provisionalHighMitigated and not na(sess.highPendingLine) and not sess.highMitigated and isOnSessionStartDay
                        line.set_x2(sess.highPendingLine, time)
                else if canEvaluateMitigation and high >= sess.dominantHigh
                    // Mitigation confirmed (either normal or after provisional overnight breach)
                    sess.highMitigated := true
                    sess.highMitigationBar := bar_index
                    sess.highMitigationTime := time
                    if mitigationMode == SESSION_MITIGATED
                        line temp = draw_confirmed_mitigation_line(drawMitigationLines, sess.provisionalHighMitigated, sess.highPendingLine, sess.highTime, sess.dominantHigh, sess.mitigationColor)
                        if not na(temp)
                            sess.highMitigationLine := temp

                else if isInOvernightWindow and high >= sess.dominantHigh
                    // Provisional breach during overnight - draw solid to breach, then dashed continuation
                    if not sess.provisionalHighMitigated
                        sess.provisionalHighMitigated := true
                        sess.provisionalHighTime := time
                        sess.provisionalHighBar := bar_index
                        if mitigationMode == SESSION_MITIGATED
                            [solid, pending] = draw_provisional_breach_lines(drawMitigationLines, sess.highTime, sess.dominantHigh, sess.mitigationColor)
                            sess.highMitigationLine := solid
                            sess.highPendingLine := pending

                else if alwaysTrackMitigation(sess.sessionIndex) and high >= sess.dominantHigh
                    // Level taken outside same-day window (or outside market hours for always-track sessions)
                    sess.highMitigated := true
                    sess.highMitigationBar := bar_index
                    sess.highMitigationTime := time
                    if alwaysTrackMitigation(sess.sessionIndex) and mitigationMode == SESSION_MITIGATED
                        line temp = draw_confirmed_mitigation_line(drawMitigationLines, sess.provisionalHighMitigated, sess.highPendingLine, sess.highTime, sess.dominantHigh, sess.mitigationColor)
                        if not na(temp)
                            sess.highMitigationLine := temp

                // Extend pending line during overnight (before 05:00 confirmation window)
                if sess.sessionIndex != IDX_IVB and sess.provisionalHighMitigated and not na(sess.highPendingLine) and not sess.highMitigated
                    line.set_x2(sess.highPendingLine, time)

            // === LOW MITIGATION LOGIC ===
            if not sess.lowMitigated
                if sess.sessionIndex == IDX_IVB
                    // IVB: solid until first wick touch (provisional), then dashed until a 30m candle CLOSES below — the actual mitigation
                    if not sess.provisionalLowMitigated and canEvaluateMitigation and low <= sess.dominantLow
                        sess.provisionalLowMitigated := true
                        sess.provisionalLowTime := time
                        sess.provisionalLowBar := bar_index
                        if mitigationMode == SESSION_MITIGATED
                            [solid, pending] = draw_provisional_breach_lines(drawMitigationLines, sess.lowTime, sess.dominantLow, sess.mitigationColor)
                            sess.lowMitigationLine := solid
                            sess.lowPendingLine := pending
                    if sess.provisionalLowMitigated and not na(htf30mClose) and htf30mClose < sess.dominantLow and sess.startDayKey == htf30mDayKey
                        sess.lowMitigated := true
                        sess.lowMitigationBar := bar_index
                        sess.lowMitigationTime := ivbConfirmationEndTime(htf30mTime, sess.provisionalLowTime, time, chart.is_range, BAR_MS)
                        if mitigationMode == SESSION_MITIGATED and not na(sess.lowPendingLine)
                            line.set_x2(sess.lowPendingLine, sess.lowMitigationTime)
                    if sess.provisionalLowMitigated and not na(sess.lowPendingLine) and not sess.lowMitigated and isOnSessionStartDay
                        line.set_x2(sess.lowPendingLine, time)
                else if canEvaluateMitigation and low <= sess.dominantLow
                    // Mitigation confirmed (either normal or after provisional overnight breach)
                    sess.lowMitigated := true
                    sess.lowMitigationBar := bar_index
                    sess.lowMitigationTime := time
                    if mitigationMode == SESSION_MITIGATED
                        line temp = draw_confirmed_mitigation_line(drawMitigationLines, sess.provisionalLowMitigated, sess.lowPendingLine, sess.lowTime, sess.dominantLow, sess.mitigationColor)
                        if not na(temp)
                            sess.lowMitigationLine := temp

                else if isInOvernightWindow and low <= sess.dominantLow
                    // Provisional breach during overnight - draw solid to breach, then dashed continuation
                    if not sess.provisionalLowMitigated
                        sess.provisionalLowMitigated := true
                        sess.provisionalLowTime := time
                        sess.provisionalLowBar := bar_index
                        if mitigationMode == SESSION_MITIGATED
                            [solid, pending] = draw_provisional_breach_lines(drawMitigationLines, sess.lowTime, sess.dominantLow, sess.mitigationColor)
                            sess.lowMitigationLine := solid
                            sess.lowPendingLine := pending

                else if alwaysTrackMitigation(sess.sessionIndex) and low <= sess.dominantLow
                    // Level taken outside same-day window (or outside market hours for always-track sessions)
                    sess.lowMitigated := true
                    sess.lowMitigationBar := bar_index
                    sess.lowMitigationTime := time
                    if alwaysTrackMitigation(sess.sessionIndex) and mitigationMode == SESSION_MITIGATED
                        line temp = draw_confirmed_mitigation_line(drawMitigationLines, sess.provisionalLowMitigated, sess.lowPendingLine, sess.lowTime, sess.dominantLow, sess.mitigationColor)
                        if not na(temp)
                            sess.lowMitigationLine := temp

                // Extend pending line during overnight (before 05:00 confirmation window)
                if sess.sessionIndex != IDX_IVB and sess.provisionalLowMitigated and not na(sess.lowPendingLine) and not sess.lowMitigated
                    line.set_x2(sess.lowPendingLine, time)

            bool usesProvisionalOvernightRetracement = provisionalRetracementsEnabled(sess.sessionIndex)
            if usesProvisionalOvernightRetracement
                initializeRetracementOrigin(sess)
                if sess.retraceOriginProvisional
                    bool replacementApplied = false
                    bool bothBoundariesConfirmed = bothSessionBoundariesConfirmed(sess)
                    int confirmedOppositeSide = oppositeConfirmedReplacementSide(sess)
                    // A confirmed opposite side already proves that price traversed the range.
                    if confirmedOppositeSide != 0
                        int confirmedOppositeBar = confirmedOppositeSide == 1 ? sess.highMitigationBar : sess.lowMitigationBar
                        if crossedConfirmedReplacementBoundary(sess, confirmedOppositeSide, confirmedOppositeBar, bar_index, high, low, close[1], confirmedMitigationReplacementTrigger)
                            replaceProvisionalWithOppositeConfirmedOrigin(sess, confirmedOppositeSide, confirmedOppositeBar, bar_index)
                            replacementApplied := true
                    // Once both sides are confirmed, only a later inward crossing from the opposite
                    // side can replace the completed provisional leg.
                    if not replacementApplied and not bothBoundariesConfirmed
                        bool originConfirmed = sess.retraceOriginSide == 1 ? sess.highMitigated : sess.retraceOriginSide == -1 and sess.lowMitigated
                        if originConfirmed
                            int confirmedOriginBar = sess.retraceOriginSide == 1 ? sess.highMitigationBar : sess.lowMitigationBar
                            if crossedConfirmedReplacementBoundary(sess, sess.retraceOriginSide, confirmedOriginBar, bar_index, high, low, close[1], confirmedMitigationReplacementTrigger)
                                replaceProvisionalWithConfirmedOrigin(sess, bar_index)

            // Right-edge session labels on still-open dashed pending lines; removed once mitigated (Unmitigated mode labels these itself)
            if mitigationMode == SESSION_MITIGATED and eagerDraw
                sess.highPendingLabel := resolve_pending_label(showAllLines and showAllLabels and showPendingLabels and not sess.highMitigated, sess.highPendingLabel, sess.highPendingLine, sess.dominantHigh, sess.chartLabel, sess.sessionIndex, sess.mitigationColor)
                sess.lowPendingLabel := resolve_pending_label(showAllLines and showAllLabels and showPendingLabels and not sess.lowMitigated, sess.lowPendingLabel, sess.lowPendingLine, sess.dominantLow, sess.chartLabel, sess.sessionIndex, sess.mitigationColor)
                bool wantMitigationName = showAllLines and showAllLabels and showSessionNameOnMitigation and sess.isKeySession and not skipsMitigationName(sess.sessionIndex)
                string mitigationTxt = str.lower(sess.chartLabel)
                int highMitigationReminderEndBar = sess.provisionalHighMitigated ? sess.provisionalHighBar : sess.highMitigationBar
                int lowMitigationReminderEndBar = sess.provisionalLowMitigated ? sess.provisionalLowBar : sess.lowMitigationBar
                resolve_mitigation_reminders(wantMitigationName and shouldShowMitigationName(sess, true), sess.highMitigationReminders, sess.highMitigationLine, sess.highBar, highMitigationReminderEndBar, sess.dominantHigh, mitigationTxt, showMitigationReminders)
                resolve_mitigation_reminders(wantMitigationName and shouldShowMitigationName(sess, false), sess.lowMitigationReminders, sess.lowMitigationLine, sess.lowBar, lowMitigationReminderEndBar, sess.dominantLow, mitigationTxt, showMitigationReminders)

            // === CONSOLIDATED POST-MITIGATION CLEANUP (single check replaces duplicates) ===
            // Hand provisional overlay lines to the standard Mitigated presentation.
            bool highOverlayHandedOff = showOpenKeyOverlay and sess.provisionalHighMitigated
            bool lowOverlayHandedOff = showOpenKeyOverlay and sess.provisionalLowMitigated

            // Delete unmitigated line/label when HIGH is mitigated or handed off.
            if (sess.highMitigated or highOverlayHandedOff) and not na(sess.highUnmitigatedLine)
                line.delete(sess.highUnmitigatedLine)
                sess.highUnmitigatedLine := na
                if not na(sess.highUnmitigatedLabel)
                    label.delete(sess.highUnmitigatedLabel)
                    sess.highUnmitigatedLabel := na

            // Delete unmitigated line/label when LOW is mitigated or handed off.
            if (sess.lowMitigated or lowOverlayHandedOff) and not na(sess.lowUnmitigatedLine)
                line.delete(sess.lowUnmitigatedLine)
                sess.lowUnmitigatedLine := na
                if not na(sess.lowUnmitigatedLabel)
                    label.delete(sess.lowUnmitigatedLabel)
                    sess.lowUnmitigatedLabel := na

            // Anchor 0.618 off the selected standard origin. IVB Standard arms provisionally;
            // NY Early's IVB-based mode may re-anchor below.
            if sess.isKeySession and na(sess.retraceLevel618)
                if usesProvisionalOvernightRetracement and sess.retraceOriginSide != 0
                    sess.retraceLevel618 := retracement618ForSide(sess, sess.retraceOriginSide)
                else
                    bool highOriginTaken = sess.sessionIndex == IDX_IVB ? sess.provisionalHighMitigated : sess.highMitigated
                    bool lowOriginTaken = sess.sessionIndex == IDX_IVB ? sess.provisionalLowMitigated : sess.lowMitigated
                    if highOriginTaken and not lowOriginTaken
                        sess.retraceLevel618 := sess.wickHigh - sess.wickHeight * 0.618
                    else if lowOriginTaken and not highOriginTaken
                        sess.retraceLevel618 := sess.wickLow + sess.wickHeight * 0.618

            // Draw untouched levels in Unmitigated mode or as the Rafael + Asia overlay.
            if showPersistentLevels and drawMitigationLines
                if mitigationMode == SESSION_UNMITIGATED
                    // Unmitigated mode owns its pending-line lifecycle.
                    bool shouldShowHighPending = not sess.highMitigated and sess.provisionalHighMitigated and shouldTrackMitigation
                    if not shouldShowHighPending and not na(sess.highPendingLine)
                        line.delete(sess.highPendingLine)
                        sess.highPendingLine := na
                    bool shouldShowLowPending = not sess.lowMitigated and sess.provisionalLowMitigated and shouldTrackMitigation
                    if not shouldShowLowPending and not na(sess.lowPendingLine)
                        line.delete(sess.lowPendingLine)
                        sess.lowPendingLine := na
                // Clean up unmitigated lines/labels if outside tracking window
                if not shouldTrackMitigation
                    if not na(sess.highUnmitigatedLine)
                        line.delete(sess.highUnmitigatedLine)
                        sess.highUnmitigatedLine := na
                    if not na(sess.highUnmitigatedLabel)
                        label.delete(sess.highUnmitigatedLabel)
                        sess.highUnmitigatedLabel := na
                    if not na(sess.lowUnmitigatedLine)
                        line.delete(sess.lowUnmitigatedLine)
                        sess.lowUnmitigatedLine := na
                    if not na(sess.lowUnmitigatedLabel)
                        label.delete(sess.lowUnmitigatedLabel)
                        sess.lowUnmitigatedLabel := na
                else
                    // Draw for sessions within tracking window (same-day or always-track)
                    // High unmitigated line and label
                    if not sess.highMitigated and (mitigationMode == SESSION_UNMITIGATED or not sess.provisionalHighMitigated)
                        if sess.provisionalHighMitigated
                            // Provisionally mitigated: solid to breach, dashed continuation
                            if na(sess.highPendingLine)
                                // Solid line already exists? Update its endpoint to breach time
                                if not na(sess.highUnmitigatedLine)
                                    line.set_x2(sess.highUnmitigatedLine, sess.provisionalHighTime)
                                else
                                    sess.highUnmitigatedLine := line.new(sess.highTime, sess.dominantHigh, sess.provisionalHighTime, sess.dominantHigh, color=sess.mitigationColor, style=line.style_solid, width=MITIGATION_LINE_WIDTH, xloc=xloc.bar_time)
                                sess.highPendingLine := line.new(sess.provisionalHighTime, sess.dominantHigh, time, sess.dominantHigh, color=sess.mitigationColor, style=line.style_dashed, width=MITIGATION_PENDING_LINE_WIDTH, xloc=xloc.bar_time)
                                if showAllLabels and na(sess.highUnmitigatedLabel)
                                    sess.highUnmitigatedLabel := label.new(time, sess.dominantHigh, levelLabelText(sess.chartLabel, sess.dominantHigh, openLevelShowsPrice(sess.sessionIndex)), style=label.style_label_left, textcolor=labelColor, size=globalLabelSize, color=color.new(color.white, 100), xloc=xloc.bar_time)
                            else
                                line.set_x2(sess.highPendingLine, time)
                            if not na(sess.highUnmitigatedLabel)
                                label.set_x(sess.highUnmitigatedLabel, time)
                        else
                            // Not provisionally mitigated: solid line to current time
                            if na(sess.highUnmitigatedLine)
                                sess.highUnmitigatedLine := line.new(sess.highTime, sess.dominantHigh, time, sess.dominantHigh, color=sess.mitigationColor, style=line.style_solid, width=MITIGATION_LINE_WIDTH, xloc=xloc.bar_time)
                                if showAllLabels
                                    sess.highUnmitigatedLabel := label.new(time, sess.dominantHigh, levelLabelText(sess.chartLabel, sess.dominantHigh, openLevelShowsPrice(sess.sessionIndex)), style=label.style_label_left, textcolor=labelColor, size=globalLabelSize, color=color.new(color.white, 100), xloc=xloc.bar_time)
                            else
                                line.set_x2(sess.highUnmitigatedLine, time)
                                if not na(sess.highUnmitigatedLabel)
                                    label.set_x(sess.highUnmitigatedLabel, time)
                    // Low unmitigated line and label
                    if not sess.lowMitigated and (mitigationMode == SESSION_UNMITIGATED or not sess.provisionalLowMitigated)
                        if sess.provisionalLowMitigated
                            // Provisionally mitigated: solid to breach, dashed continuation
                            if na(sess.lowPendingLine)
                                // Solid line already exists? Update its endpoint to breach time
                                if not na(sess.lowUnmitigatedLine)
                                    line.set_x2(sess.lowUnmitigatedLine, sess.provisionalLowTime)
                                else
                                    sess.lowUnmitigatedLine := line.new(sess.lowTime, sess.dominantLow, sess.provisionalLowTime, sess.dominantLow, color=sess.mitigationColor, style=line.style_solid, width=MITIGATION_LINE_WIDTH, xloc=xloc.bar_time)
                                sess.lowPendingLine := line.new(sess.provisionalLowTime, sess.dominantLow, time, sess.dominantLow, color=sess.mitigationColor, style=line.style_dashed, width=MITIGATION_PENDING_LINE_WIDTH, xloc=xloc.bar_time)
                                if showAllLabels and na(sess.lowUnmitigatedLabel)
                                    sess.lowUnmitigatedLabel := label.new(time, sess.dominantLow, levelLabelText(sess.chartLabel, sess.dominantLow, openLevelShowsPrice(sess.sessionIndex)), style=label.style_label_left, textcolor=labelColor, size=globalLabelSize, color=color.new(color.white, 100), xloc=xloc.bar_time)
                            else
                                line.set_x2(sess.lowPendingLine, time)
                            if not na(sess.lowUnmitigatedLabel)
                                label.set_x(sess.lowUnmitigatedLabel, time)
                        else
                            // Not provisionally mitigated: solid line to current time
                            if na(sess.lowUnmitigatedLine)
                                sess.lowUnmitigatedLine := line.new(sess.lowTime, sess.dominantLow, time, sess.dominantLow, color=sess.mitigationColor, style=line.style_solid, width=MITIGATION_LINE_WIDTH, xloc=xloc.bar_time)
                                if showAllLabels
                                    sess.lowUnmitigatedLabel := label.new(time, sess.dominantLow, levelLabelText(sess.chartLabel, sess.dominantLow, openLevelShowsPrice(sess.sessionIndex)), style=label.style_label_left, textcolor=labelColor, size=globalLabelSize, color=color.new(color.white, 100), xloc=xloc.bar_time)
                            else
                                line.set_x2(sess.lowUnmitigatedLine, time)
                                if not na(sess.lowUnmitigatedLabel)
                                    label.set_x(sess.lowUnmitigatedLabel, time)

            if eagerDraw and alwaysTrackMitigation(sess.sessionIndex)
                bool keepOpenReminders = showAllLines and showAllLabels and showMitigationReminders
                int highOpenReminderEndBar = sess.provisionalHighMitigated ? sess.provisionalHighBar : bar_index
                int lowOpenReminderEndBar = sess.provisionalLowMitigated ? sess.provisionalLowBar : bar_index
                resolve_open_level_reminders(keepOpenReminders, sess.highUnmitigatedReminders, sess.highUnmitigatedLine, sess.highBar, highOpenReminderEndBar, sess.dominantHigh, str.lower(sess.chartLabel))
                resolve_open_level_reminders(keepOpenReminders, sess.lowUnmitigatedReminders, sess.lowUnmitigatedLine, sess.lowBar, lowOpenReminderEndBar, sess.dominantLow, str.lower(sess.chartLabel))
            // Standard mode anchors from the first session extreme taken. IVB mode replaces that anchor
            // and direction with the first strict IVB wick break.
            bool usesIvbRetracement = sess.sessionIndex == IDX_NY_EARLY and sess.retracementMode == RETRACE_MODE_IVB
            bool usesProvisionalIvbOrigin = sess.sessionIndex == IDX_IVB
            bool standardHighOriginTaken = usesProvisionalOvernightRetracement ? sess.retraceOriginSide == 1 : usesProvisionalIvbOrigin ? sess.provisionalHighMitigated : sess.highMitigated
            bool standardLowOriginTaken = usesProvisionalOvernightRetracement ? sess.retraceOriginSide == -1 : usesProvisionalIvbOrigin ? sess.provisionalLowMitigated : sess.lowMitigated
            int standardHighOriginBar = usesProvisionalOvernightRetracement and standardHighOriginTaken ? nz(sess.retraceOriginBar, 0) : usesProvisionalIvbOrigin ? nz(sess.provisionalHighBar, 0) : nz(sess.highMitigationBar, 0)
            int standardLowOriginBar = usesProvisionalOvernightRetracement and standardLowOriginTaken ? nz(sess.retraceOriginBar, 0) : usesProvisionalIvbOrigin ? nz(sess.provisionalLowBar, 0) : nz(sess.lowMitigationBar, 0)
            bool standardOriginAmbiguous = usesProvisionalIvbOrigin and standardHighOriginTaken and standardLowOriginTaken and standardHighOriginBar == standardLowOriginBar
            bool standardLowWasFirst = standardLowOriginTaken and (not standardHighOriginTaken or standardLowOriginBar < standardHighOriginBar)
            int standardFirstOriginBar = standardLowWasFirst ? standardLowOriginBar : standardHighOriginBar
            bool retraceGateOpen = not usesIvbRetracement
            if usesIvbRetracement
                if na(sess.ivbBreakTime)
                    [ivbBreakTime, ivbBreakSide] = ivbBreakForDay(sess.startDayKey)
                    if not na(ivbBreakTime) and ivbBreakSide != 0
                        sess.ivbBreakTime := ivbBreakTime
                        sess.ivbBreakSide := ivbBreakSide
                        // The first IVB break defines the only valid return direction into NY Early.
                        sess.retraceLevel618 := ivbBreakSide == 1 ? sess.wickHigh - sess.wickHeight * 0.618 : sess.wickLow + sess.wickHeight * 0.618
                        // Arm each level only if the IVB break established price on that level's
                        // originating side. Otherwise a later bar must establish that side first.
                        sess.midArmed := ivbBreakSide == 1 ? high > sess.midLevel : low < sess.midLevel
                        sess.retrace618Armed := ivbBreakSide == 1 ? high > sess.retraceLevel618 : low < sess.retraceLevel618
                // A retracement must occur after the IVB break bar. The break bar itself cannot prove
                // whether its IVB breach or its retracement-level touch happened first.
                retraceGateOpen := ivbFeatureAvailable and not na(sess.ivbBreakTime) and time > sess.ivbBreakTime
            bool canDrawRetrace = sess.showRetracement and retraceGateOpen

            // Check for 50% mitigation after the qualifying origin bar.
            bool currentStandardLegActive = not usesProvisionalOvernightRetracement or not sess.retraceTraversalCompleted
            bool requiredOriginTaken = usesIvbRetracement ? (sess.ivbBreakSide == 1 ? sess.highMitigated : sess.ivbBreakSide == -1 and sess.lowMitigated) : ((standardHighOriginTaken or standardLowOriginTaken) and not standardOriginAmbiguous and currentStandardLegActive)
            if mitigationMode == SESSION_MITIGATED and sess.sessionIndex != IDX_PREMARKET and canEvaluateRetraceMitigation and canDrawRetrace and requiredOriginTaken and not sess.midMitigated and not na(sess.midLevel)
                // Standard mode follows the first session extreme taken. IVB mode follows the first
                // IVB wick broken: high break retraces down, low break retraces up.
                bool retracingUp = usesIvbRetracement ? sess.ivbBreakSide == -1 : standardLowWasFirst
                firstOriginBar = usesIvbRetracement ? (sess.ivbBreakSide == 1 ? nz(sess.highMitigationBar, 0) : nz(sess.lowMitigationBar, 0)) : standardFirstOriginBar
                // The origin bar itself cannot also qualify as the return.
                if bar_index > firstOriginBar
                    bool wasMidArmed = sess.midArmed
                    if usesIvbRetracement and not sess.midArmed and (retracingUp ? low < sess.midLevel : high > sess.midLevel)
                        sess.midArmed := true
                    bool retraceArmed = not usesIvbRetracement or wasMidArmed
                    bool retraceCondition = retraceArmed and (retracingUp ? high >= sess.midLevel : low <= sess.midLevel)
                    if retraceCondition
                        sess.midMitigated := true
                        sess.midMitigationTime := time
                        sess.midMitigationBar := bar_index
                        if drawMitigationLines
                            sess.midMitigationLine := line.new(sess.actualEndTime, sess.midLevel, time, sess.midLevel, color=sess.mitigationColor, style=line.style_dotted, width=MITIGATION_50_LINE_WIDTH, xloc=xloc.bar_time)
                            if showAllLabels and sess.isKeySession
                                sess.midMitigationLabels := tile_line_labels(sess.actualEndBar, sess.midMitigationBar, sess.midLevel, LABEL_RETRACE_50, showMitigationReminders, sess.retraceLabelTextColor, sess.retraceLabelBgColor)

            // Use high/low to detect touches (including wicks), but only after the origin bar.
            if mitigationMode == SESSION_MITIGATED and canEvaluateRetraceMitigation and canDrawRetrace and requiredOriginTaken and not sess.retrace618Mitigated and not na(sess.retraceLevel618) and not na(sess.midLevel)
                bool retracingUp618 = usesIvbRetracement ? sess.ivbBreakSide == -1 : sess.retraceLevel618 > sess.midLevel
                firstOriginBar618 = usesIvbRetracement ? (sess.ivbBreakSide == 1 ? nz(sess.highMitigationBar, 0) : nz(sess.lowMitigationBar, 0)) : standardFirstOriginBar
                // The origin bar itself cannot also qualify as the return.
                if bar_index > firstOriginBar618
                    bool was618Armed = sess.retrace618Armed
                    if usesIvbRetracement and not sess.retrace618Armed and (retracingUp618 ? low < sess.retraceLevel618 : high > sess.retraceLevel618)
                        sess.retrace618Armed := true
                    bool armed618 = not usesIvbRetracement or was618Armed
                    bool retraceCondition618 = armed618 and (retracingUp618 ? high >= sess.retraceLevel618 : low <= sess.retraceLevel618)
                    if retraceCondition618
                        sess.retrace618Mitigated := true
                        sess.retrace618Time := time
                        sess.retrace618Bar := bar_index
                        if drawMitigationLines
                            sess.retrace618Line := line.new(sess.actualEndTime, sess.retraceLevel618, time, sess.retraceLevel618, color=sess.mitigationColor, style=line.style_dotted, width=MITIGATION_618_LINE_WIDTH, xloc=xloc.bar_time)
                            if showAllLabels
                                sess.retrace618Labels := tile_line_labels(sess.actualEndBar, sess.retrace618Bar, sess.retraceLevel618, LABEL_RETRACE_618, showMitigationReminders, sess.retraceLabelTextColor, sess.retraceLabelBgColor)

            // An IVB-based NY Early retracement completes only when the denoted return continues to
            // the opposite NY Early boundary (1.0). Earlier touches of that boundary do not count.
            if usesIvbRetracement and na(sess.ivbRetraceBar) and (sess.midMitigated or sess.retrace618Mitigated)
                sess.ivbRetraceBar := bar_index
            if usesIvbRetracement and not sess.ivbRetraceCompleted and not na(sess.ivbRetraceBar) and bar_index > sess.ivbRetraceBar
                bool reachedOppositeBoundary = sess.ivbBreakSide == 1 ? low <= sess.wickLow : sess.ivbBreakSide == -1 and high >= sess.wickHigh
                if reachedOppositeBoundary
                    sess.ivbRetraceCompleted := true

            int retraceLegStartBar = nz(sess.retraceLegStartBar, sess.retraceOriginBar)
            bool replacementActivationBar = not sess.retraceOriginProvisional and retraceLegStartBar > nz(sess.retraceOriginBar, retraceLegStartBar) and bar_index == retraceLegStartBar
            if usesProvisionalOvernightRetracement and not sess.retraceTraversalCompleted and sess.retraceOriginSide != 0 and (bar_index > retraceLegStartBar or replacementActivationBar)
                bool reachedOppositeBoundary = sess.retraceOriginSide == 1 ? low <= sess.dominantLow : high >= sess.dominantHigh
                if reachedOppositeBoundary
                    sess.retraceTraversalCompleted := true

            if eagerDraw and fadeCompletedRetracements and not sess.retraceFadeApplied and isRetraceTraversalComplete(sess) and (sess.midMitigated or sess.retrace618Mitigated)
                fadeRetraceElements(sess.midMitigationLine, sess.midMitigationLabels, sess.mitigationColor, sess.retraceLabelTextColor, sess.retraceLabelBgColor)
                fadeRetraceElements(sess.retrace618Line, sess.retrace618Labels, sess.mitigationColor, sess.retraceLabelTextColor, sess.retraceLabelBgColor)
                sess.retraceFadeApplied := true

            completedMitigationShouldFade(sess, true)
            completedMitigationShouldFade(sess, false)
            bool mitigationFadePending = completedMitigationFadePending(sess)
            if sessionLifecycleComplete(sess) and not mitigationFadePending
                array.push(completedLifecycleIndices, lifecycleIndex)

    if array.size(completedLifecycleIndices) > 0
        for removalIndex = array.size(completedLifecycleIndices) - 1 to 0
            array.remove(lifecycleSessions, array.get(completedLifecycleIndices, removalIndex))

// Combine overlapping unmitigated labels on compact eligible sets. Focus-managed sessions are
// excluded because Phase 4.5 owns their labels.
if validChartContext and barstate.islast and showAllLines and showAllLabels and mitigationMode == SESSION_UNMITIGATED and array.size(sessions) > 1
    LABEL_OVERLAP_PCT = 0.005  // 0.005% of price tolerance
    array.clear(highOverlapCandidates)
    array.clear(lowOverlapCandidates)
    for candidateSess in sessions
        if focusManaged(candidateSess.sessionIndex)
            continue
        if not na(candidateSess.highUnmitigatedLabel) and not na(candidateSess.dominantHigh)
            array.push(highOverlapCandidates, candidateSess)
        if not na(candidateSess.lowUnmitigatedLabel) and not na(candidateSess.dominantLow)
            array.push(lowOverlapCandidates, candidateSess)
    mergeOverlappingUnmitigatedLabels(highOverlapCandidates, true, LABEL_OVERLAP_PCT)
    mergeOverlappingUnmitigatedLabels(lowOverlapCandidates, false, LABEL_OVERLAP_PCT)

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 4.5: ASIA + RAFAEL FOCUS - Selection and drawing budget
// ═══════════════════════════════════════════════════════════════════════════
// Runs after Phase 4 so rendering reads this bar's finished state; re-ranks every last-bar
// tick because a Current Price anchor moves with each tick.

if validChartContext and focusActive and barstate.islast and array.size(sessions) > 0
    map.clear(selectedFocusSessionKeys)
    array.clear(focusCandidatesCache)
    array.clear(selectedFocusIndices)
    int currentFocusBoxCount = 0
    int currentFocusLineCount = 0
    int currentFocusLabelCount = 0
    for renderedSess in renderedFocusSessions
        [renderedBoxCount, renderedLineCount, renderedLabelCount] = focusCurrentDrawingCounts(renderedSess)
        currentFocusBoxCount += renderedBoxCount
        currentFocusLineCount += renderedLineCount
        currentFocusLabelCount += renderedLabelCount
    int focusBudget = FOCUS_DRAWING_LIMIT - FOCUS_DRAWING_HEADROOM
    // Calculate the non-Focus base before deleting old Focus members so their drawings are
    // subtracted exactly once during a membership change.
    int baseBoxCount = math.max(0, array.size(box.all) - currentFocusBoxCount)
    int baseLineCount = math.max(0, array.size(line.all) - currentFocusLineCount)
    int baseLabelCount = math.max(0, array.size(label.all) - currentFocusLabelCount)
    int nonFocusGrowthLineCount = 0
    int nonFocusGrowthLabelCount = 0
    for lifecycleSess in lifecycleSessions
        if not focusManaged(lifecycleSess.sessionIndex)
            [currentLifecycleLineCount, currentLifecycleLabelCount] = sessionCurrentLifecycleDrawingCounts(lifecycleSess)
            [potentialLifecycleLineCount, potentialLifecycleLabelCount] = sessionPotentialLifecycleDrawingCounts(lifecycleSess)
            nonFocusGrowthLineCount += math.max(0, potentialLifecycleLineCount - currentLifecycleLineCount)
            nonFocusGrowthLabelCount += math.max(0, potentialLifecycleLabelCount - currentLifecycleLabelCount)
    collectFocusCandidates(sessions, focusCandidatesCache, focusRankedCache, IDX_0129, focusAnchorPrice, focusSessionCount)
    collectFocusCandidates(sessions, focusCandidatesCache, focusRankedCache, IDX_ASIA_OPEN, focusAnchorPrice, focusSessionCount)
    // The recent view comes first so it can never lose its slots to a better-ranked distant level.
    collectRecentFocusSessions(sessions, selectedFocusIndices, IDX_0129, maxSessions)
    collectRecentFocusSessions(sessions, selectedFocusIndices, IDX_ASIA_OPEN, maxSessions)
    for selectedIndex in selectedFocusIndices
        SessionData recentSess = array.get(sessions, selectedIndex)
        map.put(selectedFocusSessionKeys, recentSess.startTime, true)
    for candidate in focusCandidatesCache
        SessionData candidateSess = array.get(sessions, candidate.sourceIndex)
        int candidateKey = candidateSess.startTime
        if not map.contains(selectedFocusSessionKeys, candidateKey)
            array.push(selectedFocusIndices, candidate.sourceIndex)
            map.put(selectedFocusSessionKeys, candidateKey, true)
    // Release only previously rendered sessions whose membership changed.
    for renderedSess in renderedFocusSessions
        if not map.contains(selectedFocusSessionKeys, renderedSess.startTime)
            renderFocusSession(renderedSess, false)
    array.clear(renderedFocusSessions)
    int reservedFocusBoxCount = 0
    int reservedFocusLineCount = 0
    int reservedFocusLabelCount = 0
    // Recent sessions are admitted first. Each reservation covers current drawings and all
    // lifecycle growth, so selected sessions cannot silently lose older objects later.
    for selectedIndex in selectedFocusIndices
        SessionData selectedSess = array.get(sessions, selectedIndex)
        [currentBoxCount, currentLineCount, currentLabelCount] = focusCurrentDrawingCounts(selectedSess)
        [potentialBoxCount, potentialLineCount, potentialLabelCount] = focusPotentialDrawingCounts(selectedSess)
        int requiredBoxCount = math.max(currentBoxCount, potentialBoxCount)
        int requiredLineCount = math.max(currentLineCount, potentialLineCount)
        int requiredLabelCount = math.max(currentLabelCount, potentialLabelCount)
        bool admitted = baseBoxCount + reservedFocusBoxCount + requiredBoxCount <= focusBudget and baseLineCount + nonFocusGrowthLineCount + reservedFocusLineCount + requiredLineCount <= focusBudget and baseLabelCount + nonFocusGrowthLabelCount + reservedFocusLabelCount + requiredLabelCount <= focusBudget
        renderFocusSession(selectedSess, admitted)
        if admitted
            array.push(renderedFocusSessions, selectedSess)
            reservedFocusBoxCount += requiredBoxCount
            reservedFocusLineCount += requiredLineCount
            reservedFocusLabelCount += requiredLabelCount
// Apply the latched style after Focus reconstructs deferred drawings.
if validChartContext and barstate.islast and array.size(sessions) > 0
    for sess in sessions
        styleCompletedMitigationBoundary(sess, true)
        styleCompletedMitigationBoundary(sess, false)

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 5: DEVIATION GLOW - Darken deviation zones when price touches them
// ═══════════════════════════════════════════════════════════════════════════

if validChartContext and enableDeviationGlow
    glowWindowMs = int(glowWindowHours * 60 * 60 * 1000)

    for sessionIndex = 0 to array.size(latestGlowSessions) - 1
        SessionData sess = array.get(latestGlowSessions, sessionIndex)
        if na(sess)
            continue
        boxCount = array.size(sess.deviationBoxes)
        if boxCount == 0
            continue

        sessionEndTime = nz(sess.actualEndTime, sess.endTime)
        if na(sessionEndTime) or sessionEndTime == 0
            continue

        withinWindow = time <= sessionEndTime + glowWindowMs

        for i = 0 to boxCount - 1
            devBox = array.get(sess.deviationBoxes, i)
            boxKey = getGlowBoxKey(sess.sessionIndex, sess.startTime, i)

            if withinWindow
                if not map.contains(glowOriginalColors, boxKey)
                    map.put(glowOriginalColors, boxKey, sess.deviationColor)
                originalColor = map.get(glowOriginalColors, boxKey)
                boxHigh = math.max(box.get_top(devBox), box.get_bottom(devBox))
                boxLow = math.min(box.get_top(devBox), box.get_bottom(devBox))
                touched = high >= boxLow and low <= boxHigh

                if touched and not map.contains(glowTouchTimes, boxKey)
                    map.put(glowTouchTimes, boxKey, time)
                    box.set_bgcolor(devBox, darkenColor(originalColor, glowDarkenPercent))
            else if not keepPastSessionGlow
                resetGlowBox(devBox, boxKey)

// ═══════════════════════════════════════════════════════════════════════════
// ASIA OPEN 1.25–1.5 DEVIATION GLOW - Reveal the crossed wick-deviation band during NY Early
// ═══════════════════════════════════════════════════════════════════════════

if validChartContext and enableAsiaOpenDev15Glow and barMinutes >= 360 and barMinutes <= 540 and array.size(sessions) > 0
    int asiaSessionIndex = na
    for i = array.size(sessions) - 1 to 0
        SessionData candidate = array.get(sessions, i)
        if candidate.sessionIndex == IDX_ASIA_OPEN and candidate.nextDayKey == currentDayKey
            asiaSessionIndex := i
            break

    if not na(asiaSessionIndex)
        SessionData asiaSess = array.get(sessions, asiaSessionIndex)
        float asiaRange = asiaSess.wickHigh - asiaSess.wickLow
        if asiaRange > 0
            float upperInner = asiaSess.wickHigh + asiaRange * 1.25
            float upperOuter = asiaSess.wickHigh + asiaRange * 1.5
            float lowerInner = asiaSess.wickLow - asiaRange * 1.25
            float lowerOuter = asiaSess.wickLow - asiaRange * 1.5
            color asiaGlowColor = darkenColor(asiaSess.deviationColor, glowDarkenPercent)

            if high >= upperOuter and na(asiaSess.asiaDev15UpperGlowBox)
                asiaSess.asiaDev15UpperGlowBox := box.new(asiaSess.startTime, upperOuter, asiaSess.actualEndTime, upperInner, bgcolor=asiaGlowColor, border_color=na, xloc=xloc.bar_time)

            if low <= lowerOuter and na(asiaSess.asiaDev15LowerGlowBox)
                asiaSess.asiaDev15LowerGlowBox := box.new(asiaSess.startTime, lowerInner, asiaSess.actualEndTime, lowerOuter, bgcolor=asiaGlowColor, border_color=na, xloc=xloc.bar_time)

            array.set(sessions, asiaSessionIndex, asiaSess)

// ═══════════════════════════════════════════════════════════════════════════
// IVB EXTENSION GLOW - Hold each latest-IVB projection wide after its first hit
// ═══════════════════════════════════════════════════════════════════════════

if validChartContext and enableIvbExtensionGlow
    ivbGlowWindowMs = int(ivbExtensionGlowWindowHours * 60 * 60 * 1000)
    ivbGlowWidth = math.max(opening_0930_1000_extWidth, glowIvbExtensionWidth)
    canWidenIvbExtension = ivbGlowWidth > opening_0930_1000_extWidth
    bool nextIvbActive = false
    for activeSess in activeSessions
        if activeSess.sessionIndex == IDX_IVB
            nextIvbActive := true
    SessionData sess = array.get(latestCompletedSessions, IDX_IVB)
    if not na(sess)
        extensionCount = array.size(sess.extLines)
        if extensionCount > 0
            for i = 0 to extensionCount - 1
                extLine = array.get(sess.extLines, i)
                lineKey = getIvbExtensionGlowKey(sess.startTime, i)
                if nextIvbActive or not canWidenIvbExtension
                    resetIvbExtensionGlow(extLine, lineKey, opening_0930_1000_extWidth)
                else if map.contains(ivbExtensionGlowTouchTimes, lineKey)
                    touchTime = map.get(ivbExtensionGlowTouchTimes, lineKey)
                    if touchTime > 0 and time >= touchTime + ivbGlowWindowMs
                        // Keep the recorded first hit so an expired line cannot reactivate.
                        line.set_width(extLine, opening_0930_1000_extWidth)
                        map.put(ivbExtensionGlowTouchTimes, lineKey, -touchTime)
                else
                    extensionLevel = line.get_y1(extLine)
                    touched = time >= line.get_x1(extLine) and high >= extensionLevel and low <= extensionLevel
                    if touched
                        map.put(ivbExtensionGlowTouchTimes, lineKey, time)
                        line.set_width(extLine, ivbGlowWidth)

// ═══════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE - Dynamic display based on active sessions
// ═══════════════════════════════════════════════════════════════════════════

addSessionColorRows(table tbl, int startRow, string sessionName, color coreClr, color devClr, color mitClr, bool showMit) =>
    table.cell(tbl, 0, startRow, sessionName, text_size=size.small, text_color=color.black)
    table.cell(tbl, 1, startRow, "Core", text_size=size.small, text_color=color.black)
    table.cell(tbl, 2, startRow, str.format("R:{0} G:{1} B:{2}", int(color.r(coreClr)), int(color.g(coreClr)), int(color.b(coreClr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 3, startRow, str.tostring(int(color.t(coreClr))), text_size=size.small, text_color=color.black)

    table.cell(tbl, 0, startRow + 1, sessionName, text_size=size.small, text_color=color.black)
    table.cell(tbl, 1, startRow + 1, "Deviation", text_size=size.small, text_color=color.black)
    table.cell(tbl, 2, startRow + 1, str.format("R:{0} G:{1} B:{2}", int(color.r(devClr)), int(color.g(devClr)), int(color.b(devClr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 3, startRow + 1, str.tostring(int(color.t(devClr))), text_size=size.small, text_color=color.black)

    int rowsAdded = 2
    if showMit
        table.cell(tbl, 0, startRow + rowsAdded, sessionName, text_size=size.small, text_color=color.black)
        table.cell(tbl, 1, startRow + rowsAdded, "Mitigation", text_size=size.small, text_color=color.black)
        table.cell(tbl, 2, startRow + rowsAdded, str.format("R:{0} G:{1} B:{2}", int(color.r(mitClr)), int(color.g(mitClr)), int(color.b(mitClr))), text_size=size.small, text_color=color.black)
        table.cell(tbl, 3, startRow + rowsAdded, str.tostring(int(color.t(mitClr))), text_size=size.small, text_color=color.black)
        rowsAdded += 1
    rowsAdded

addSingleColorRow(table tbl, int row, string name, color clr) =>
    table.cell(tbl, 0, row, name, text_size=size.small, text_color=color.black)
    table.cell(tbl, 1, row, "-", text_size=size.small, text_color=color.black)
    table.cell(tbl, 2, row, str.format("R:{0} G:{1} B:{2}", int(color.r(clr)), int(color.g(clr)), int(color.b(clr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 3, row, str.tostring(int(color.t(clr))), text_size=size.small, text_color=color.black)

addSessionStyleColorRow(table tbl, int row, string sessionName, string styleName, color clr) =>
    table.cell(tbl, 0, row, sessionName, text_size=size.small, text_color=color.black)
    table.cell(tbl, 1, row, styleName, text_size=size.small, text_color=color.black)
    table.cell(tbl, 2, row, str.format("R:{0} G:{1} B:{2}", int(color.r(clr)), int(color.g(clr)), int(color.b(clr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 3, row, str.tostring(int(color.t(clr))), text_size=size.small, text_color=color.black)

addRetracementColorRows(table tbl, int startRow, string sessionName, color textClr, color bgClr) =>
    addSessionStyleColorRow(tbl, startRow, sessionName, "Retracement Text", textClr)
    addSessionStyleColorRow(tbl, startRow + 1, sessionName, "Retracement Bg", bgClr)
    2

if validChartContext and showColorTable and barstate.islast
    var table colorTable = table.new(position.top_right, 4, COLOR_TABLE_MAX_ROWS, bgcolor=color.white, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

    // Header row
    table.cell(colorTable, 0, 0, "Session", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 1, 0, "Type", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 2, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 3, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)

    int currentRow = 1

    // Only show colors for sessions that are BOTH enabled AND in current Quick Filter
    if opening_2130_0129 != OPT_HIDDEN and isInFilter(IDX_0129)
        currentRow += addSessionColorRows(colorTable, currentRow, SESSION_INTRADAY_0129, opening_2130_0129_coreColor, opening_2130_0129_deviationColor, opening_2130_0129_mitigationColor, opening_2130_0129_mitigation)
        currentRow += addRetracementColorRows(colorTable, currentRow, SESSION_INTRADAY_0129, opening_2130_0129_retraceLabelTextColor, opening_2130_0129_retraceLabelBgColor)

    if opening_0600_0900 != OPT_HIDDEN and isInFilter(IDX_NY_EARLY)
        currentRow += addSessionColorRows(colorTable, currentRow, "NY Early", opening_0600_0900_coreColor, opening_0600_0900_deviationColor, opening_0600_0900_mitigationColor, opening_0600_0900_mitigation)
        currentRow += addRetracementColorRows(colorTable, currentRow, "NY Early", opening_0600_0900_retraceLabelTextColor, opening_0600_0900_retraceLabelBgColor)

    if opening_0500_0915 != OPT_HIDDEN and isInFilter(IDX_PREMARKET)
        currentRow += addSessionColorRows(colorTable, currentRow, SESSION_EXTENDED_0500_0915, opening_0500_0915_coreColor, opening_0500_0915_deviationColor, opening_0500_0915_mitigationColor, opening_0500_0915_mitigation)

    if opening_0930_1000 != OPT_HIDDEN and isInFilter(IDX_IVB)
        currentRow += addSessionColorRows(colorTable, currentRow, SESSION_EXTENDED_0930_1000, opening_0930_1000_coreColor, opening_0930_1000_deviationColor, opening_0930_1000_mitigationColor, opening_0930_1000_mitigation)
        currentRow += addRetracementColorRows(colorTable, currentRow, SESSION_EXTENDED_0930_1000, opening_0930_1000_retraceLabelTextColor, opening_0930_1000_retraceLabelBgColor)
        if opening_0930_1000_showExtensions
            extensionGlowWidens = enableIvbExtensionGlow and glowIvbExtensionWidth > opening_0930_1000_extWidth
            extensionWidthLabel = str.tostring(opening_0930_1000_extWidth) + (extensionGlowWidens ? " → " + str.tostring(glowIvbExtensionWidth) + " hit" : "")
            addSessionStyleColorRow(colorTable, currentRow, SESSION_EXTENDED_0930_1000, "Extensions · Dashed · " + extensionWidthLabel, opening_0930_1000_extColor)
            currentRow += 1

    if opening_1800_2100 != OPT_HIDDEN and isInFilter(IDX_ASIA_OPEN)
        currentRow += addSessionColorRows(colorTable, currentRow, SESSION_EXTENDED_1800_2100, opening_1800_2100_coreColor, opening_1800_2100_deviationColor, opening_1800_2100_mitigationColor, opening_1800_2100_mitigation)
        currentRow += addRetracementColorRows(colorTable, currentRow, SESSION_EXTENDED_1800_2100, opening_1800_2100_retraceLabelTextColor, opening_1800_2100_retraceLabelBgColor)

    // General colors
    addSingleColorRow(colorTable, currentRow, "Labels Bg", labelsBgColor)
    currentRow += 1

    addSingleColorRow(colorTable, currentRow, "Label", labelColor)
    currentRow += 1

    if focusManualAnchorSelected
        addSingleColorRow(colorTable, currentRow, LABEL_FOCUS_ANCHOR_COLOR, focusAnchorColor)
        currentRow += 1

    if secondaryPaneMode and showPriceCandlesInPane
        addSingleColorRow(colorTable, currentRow, "Up Body", paneUpBodyColor)
        currentRow += 1
        addSingleColorRow(colorTable, currentRow, "Down Body", paneDownBodyColor)
        currentRow += 1
        addSingleColorRow(colorTable, currentRow, "Up Border", paneUpBorderColor)
        currentRow += 1
        addSingleColorRow(colorTable, currentRow, "Down Border", paneDownBorderColor)
        currentRow += 1
        addSingleColorRow(colorTable, currentRow, "Up Wick", paneUpWickColor)
        currentRow += 1
        addSingleColorRow(colorTable, currentRow, "Down Wick", paneDownWickColor)
        currentRow += 1

    if showOnlyEnabled
        addSingleColorRow(colorTable, currentRow, LABEL_HIDDEN_CANDLES, hiddenCandleColor)

// ═══════════════════════════════════════════════════════════════════════════
// SHOW ONLY (CANDLE ISOLATION)
// ═══════════════════════════════════════════════════════════════════════════
// The dropdown picks one recurring NY-time window to keep visible; a bar is greyed when it falls OUTSIDE
// that window. Windows are evaluated from const session strings (time() needs consts) and selected by mode.
showOnlyTimeframeAllowed = chart.is_range or timeframe.in_seconds(timeframe.period) <= SHOW_ONLY_MAX_TIMEFRAME_SECONDS
// Pick the chosen window first, then do ONE session lookup per bar instead of evaluating all six.
activeShowOnlySession = visibleWindow == SHOW_FROM_0500 ? SESSION_WINDOW_FROM_0500 : visibleWindow == SHOW_FROM_0830 ? SESSION_WINDOW_FROM_0830 : visibleWindow == SHOW_RTH ? SESSION_WINDOW_RTH : SESSION_WINDOW_OVERNIGHT
inVisibleWindow = not na(time(timeframe.period, activeShowOnlySession, NY_TIMEZONE))
// Most Recent Only narrows the lit window to the current NY calendar day; only pay the date math when it's on.
bool inMostRecentDay = true
if showOnlyMostRecent
    inMostRecentDay := dayofmonth(time, NY_TIMEZONE) == dayofmonth(timenow, NY_TIMEZONE) and month(time, NY_TIMEZONE) == month(timenow, NY_TIMEZONE) and year(time, NY_TIMEZONE) == year(timenow, NY_TIMEZONE)
hideThisBar = showOnlyEnabled and showOnlyTimeframeAllowed and not (inVisibleWindow and (not showOnlyMostRecent or inMostRecentDay))

showPanePriceCandles = secondaryPaneMode and showPriceCandlesInPane
paneBodyColor = close >= open ? paneUpBodyColor : paneDownBodyColor
paneBorderColor = close >= open ? paneUpBorderColor : paneDownBorderColor
paneWickColor = close >= open ? paneUpWickColor : paneDownWickColor
hideMainChartCandle = not secondaryPaneMode and hideThisBar
hidePaneCandle = showPanePriceCandles and hideThisBar

plotcandle(showPanePriceCandles ? open : na, high, low, close, title="Pane Price Candles", color=paneBodyColor, bordercolor=paneBorderColor, wickcolor=paneWickColor, editable=false, display=display.pane)
plotcandle(hidePaneCandle ? open : na, high, low, close, title="Pane Hidden Candles", color=hiddenCandleColor, bordercolor=hiddenCandleColor, wickcolor=hiddenCandleColor, editable=false, display=display.pane)
plotcandle(hideMainChartCandle ? open : na, high, low, close, title="Hidden Candles", color=hiddenCandleColor, bordercolor=hiddenCandleColor, wickcolor=hiddenCandleColor, editable=false, display=display.pane, force_overlay=true)

// deviations •
