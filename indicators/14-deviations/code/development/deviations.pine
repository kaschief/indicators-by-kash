FILTER_RAFAEL_1800_NYAM_LITE = "Work: Rafael + 1800 + NYAM Lite"
FILTER_RAFAEL_1800_2203_NYAM_LITE = "Deep: Rafael + 1800 + 2203 + NYAM Lite"
FILTER_1800 = "1800 Range"
FILTER_1800_EARLY = "1800 + Early"
FILTER_RAFAEL_1800_FULL_NYAM = "Rafael + 1800 + Full NYAM"
FILTER_RAFAEL_1800_FULL_NYAM_OVERNIGHT = "Rafael + 1800 + Full NYAM + Overnight"
FILTER_INTRADAY = "Intraday"
FILTER_0800_0850 = "News Release"
FILTER_1845_2203 = "Evening Range"
FILTER_IVB = "IVB"
FILTER_PREP2 = "★ Rafael + 1800 + Early + IVB + Premarket"

// Deviation extension presets
EXTEND_OFF = "-"
EXTEND_6H = "6h"
EXTEND_12H = "12h"
EXTEND_NEXT = "Until Next"
EXTEND_CUSTOM = "Custom"

// Default deviation zones (unified - body = wick for all sessions)
DEV_A_PREMARKET = "0.25:0.5, 0.75:1"                     // Premarket (05:00-09:15)
DEV_B_NY_EARLY = "0.25:0.5, 1.33:1.66"                   // NY Early Hours (06:00-09:00)
DEV_C_ASIA = "0.25:0.5, 1:1.25, 1.33:1.66"              // Asia Open (18:00-21:00)
DEV_D_NY_OPEN_15M = "1, 2:2.5"                           // NY Open 15m (09:30-09:45)
DEV_E_30S_OPENING = "1:1.25, 2:2.156, 2.33:2.5, 4:4.5"  // 30s Opening (09:30:00-09:30:30)
DEV_F_INTRADAY = "1, 2:2.5, 4:4.5, 6:6.5"               // Intraday sessions
DEV_G_OVERNIGHT = "0.25:0.5, 0.75:1, 1.25:1.5"          // Overnight (16:00-05:00)
DEV_H_RAFAEL = "0.5:1, 2:2.5, 3, 4:4.5"  // Rafael (21:30-01:29)
DEV_I_NEWS_EVENING = "0.25:0.5, 1:1.25, 1.33:1.66, 2:2.5, 4:4.5"  // News Release (08:00-08:50), Evening Range (18:45-22:03)
DEV_J_IVB = "0.25:0.5, 1:1.5"                                    // IVB (09:30-10:00)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - General Settings
// ═══════════════════════════════════════════════════════════════════════════

quickFilter = input.string(FILTER_PREP2, "Quick Filter", options=[FILTER_ALL, FILTER_RAFAEL, FILTER_RAFAEL_1800, FILTER_RAFAEL_1800_EARLY, FILTER_RAFAEL_1800_EARLY_IVB, FILTER_PREP2, FILTER_RAFAEL_1800_EARLY_2203, FILTER_RAFAEL_1800_EARLY_OVERNIGHT, FILTER_FULL_NYAM, FILTER_NYAM_LITE, FILTER_RAFAEL_1800_NYAM_LITE, FILTER_RAFAEL_1800_2203_NYAM_LITE, FILTER_RAFAEL_1800_FULL_NYAM, FILTER_RAFAEL_1800_FULL_NYAM_OVERNIGHT, FILTER_INTRADAY, FILTER_1800, FILTER_1800_EARLY, FILTER_0800_0850, FILTER_1845_2203, FILTER_IVB, FILTER_NY_EARLY_IVB], group=GROUP_GENERAL, tooltip="Quick filter presets for session visibility.")
maxSessions = input.int(3, LABEL_SESSIONS, group=GROUP_GENERAL, tooltip=TOOLTIP_MAX_SESSIONS, minval=1, maxval=50)
showOnlyEnabled = input.bool(true, LABEL_SHOW_ONLY, inline="show_only", group=GROUP_GENERAL, tooltip=TOOLTIP_SHOW_ONLY)
hiddenCandleColor = input.color(DEFAULT_HIDDEN_CANDLE_COLOR, "", inline="show_only", group=GROUP_GENERAL, tooltip=TOOLTIP_SHOW_ONLY)
visibleWindow = input.string(SHOW_FROM_0500, "", options=[SHOW_OVERNIGHT, SHOW_FROM_0500, SHOW_FROM_0830, SHOW_RTH], inline="show_only", group=GROUP_GENERAL, tooltip=TOOLTIP_SHOW_ONLY)
showOnlyMostRecent = input.bool(false, LABEL_MOST_RECENT_ONLY, inline="show_only", group=GROUP_GENERAL, tooltip=TOOLTIP_SHOW_ONLY + "\n\n———\n\n" + LABEL_MOST_RECENT_ONLY + "\n" + TOOLTIP_MOST_RECENT_ONLY)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - Mitigation
// ═══════════════════════════════════════════════════════════════════════════

mitigationMode = input.string(SESSION_MITIGATED, "Mode", options=[SESSION_MITIGATED, SESSION_UNMITIGATED], group=GROUP_MITIGATION, tooltip="Mitigated: Show lines when levels are touched\nUnmitigated: Show persistent lines for untouched levels")
showPendingLabels = input.bool(true, "Label Provisional Lines", group=GROUP_MITIGATION, tooltip="Adds a right-edge session label to provisional (dashed) mitigation lines so you can identify which session each dashed line belongs to on a busy chart.")

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - Labels
// ═══════════════════════════════════════════════════════════════════════════

showLabels = input.bool(false, LABEL_SHOW_SESSION_NAMES, group=GROUP_SESSION_LABELS, tooltip=TOOLTIP_SHOW_SESSION_NAMES)
showSessionNameOnMitigation = input.bool(true, "Show Session Name on Key Mitigations", group=GROUP_SESSION_LABELS, tooltip=TOOLTIP_SHOW_SESSION_NAME_ON_MITIGATION)
showMitigationReminders = input.bool(true, LABEL_MITIGATION_REMINDER, group=GROUP_SESSION_LABELS, tooltip=TOOLTIP_MITIGATION_REMINDER)
labelColor = input.color(color.rgb(120, 123, 134), LABEL_LABEL_COLOR, inline="label_colors", group=GROUP_SESSION_LABELS)
labelsBgColor = input.color(color.new(color.rgb(255, 255, 255), 50), "Background", inline="label_colors", group=GROUP_SESSION_LABELS, tooltip="Background color for session and deviation labels. Key-session 0.5 and 0.618 labels use their session-specific controls instead. Set transparency to 100 for no background.")

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - Display
// ═══════════════════════════════════════════════════════════════════════════

enableDeviationGlow = input.bool(false, "Deviation Glow", group=GROUP_DISPLAY, tooltip="Darken deviation zones when price touches them. The darkening only persists while the touch is within the configured time window.")
glowDarkenPercent = input.float(25.0, "  └ Opacity", inline="glow_settings", group=GROUP_DISPLAY, minval=0.1, maxval=99.9, step=0.1)
glowWindowHours = input.float(6.0, "Duration", inline="glow_settings", group=GROUP_DISPLAY, minval=0.5, maxval=24.0, step=0.5, tooltip="Time window in hours. Touches older than this will not show the darkening effect.")
quickCheckMode = input.bool(true, "Quick Check", group=GROUP_DISPLAY, tooltip="Hide deviations for Rafael, 1800, and 2203 - show core only")

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - Intraday Sessions
// ═══════════════════════════════════════════════════════════════════════════

deviations_intraday = input.string(DEV_F_INTRADAY, "Deviations", group=GROUP_INTRADAY)

opening_2000_2015 = input.string(OPT_WICK, SESSION_INTRADAY_2015, inline="2015_1", options=[OPT_HIDDEN, OPT_CORE, OPT_BODY, OPT_WICK, OPT_BOTH], group=GROUP_INTRADAY)
opening_2000_2015_offset = input.bool(false, LABEL_OFFSET, inline="2015_1", group=GROUP_INTRADAY)
opening_2000_2015_mitigation = input.bool(true, LABEL_MITIGATION, inline="2015_1", group=GROUP_INTRADAY)
opening_2000_2015_extend = input.string(EXTEND_6H, LABEL_EXTEND, inline="2015_extend", options=[EXTEND_OFF, EXTEND_6H, EXTEND_12H, EXTEND_NEXT, EXTEND_CUSTOM], group=GROUP_INTRADAY)
opening_2000_2015_extendCustom = input.float(8, LABEL_EXTEND_CUSTOM, inline="2015_extend", group=GROUP_INTRADAY, minval=0.5, maxval=24, step=0.5)
opening_2000_2015_coreColor = input.color(color.new(color.rgb(255, 235, 59), 85), LABEL_CORE, inline="2015_2", group=GROUP_INTRADAY)
opening_2000_2015_deviationColor = input.color(color.new(color.rgb(255, 235, 59), 80), LABEL_DEVIATIONS, inline="2015_2", group=GROUP_INTRADAY)
opening_2000_2015_mitigationColor = input.color(color.new(color.rgb(251, 192, 45), 50), LABEL_MITIGATION, inline="2015_2", group=GROUP_INTRADAY)
opening_2000_2015_showLabels = input.string(OPT_NONE, LABEL_DEVIATION_LABELS, inline="2015_3", options=[OPT_NONE, OPT_BODY, OPT_WICK, OPT_BOTH], group=GROUP_INTRADAY)
opening_2000_2015_labelPosition = input.string(OPT_ABOVE, LABEL_SESSION_NAME_POSITION, inline="2015_3", options=[OPT_ABOVE, OPT_BELOW], group=GROUP_INTRADAY)

opening_0200_0215 = input.string(OPT_WICK, SESSION_INTRADAY_0215, inline="0215_1", options=[OPT_HIDDEN, OPT_CORE, OPT_BODY, OPT_WICK, OPT_BOTH], group=GROUP_INTRADAY)
opening_0200_0215_offset = input.bool(false, LABEL_OFFSET, inline="0215_1", group=GROUP_INTRADAY)
opening_0200_0215_mitigation = input.bool(true, LABEL_MITIGATION, inline="0215_1", group=GROUP_INTRADAY)
opening_0200_0215_extend = input.string(EXTEND_6H, LABEL_EXTEND, inline="0215_extend", options=[EXTEND_OFF, EXTEND_6H, EXTEND_12H, EXTEND_NEXT, EXTEND_CUSTOM], group=GROUP_INTRADAY)
opening_0200_0215_extendCustom = input.float(8, LABEL_EXTEND_CUSTOM, inline="0215_extend", group=GROUP_INTRADAY, minval=0.5, maxval=24, step=0.5)
opening_0200_0215_coreColor = input.color(color.new(color.rgb(144, 191, 249), 85), LABEL_CORE, inline="0215_2", group=GROUP_INTRADAY)
opening_0200_0215_deviationColor = input.color(color.new(color.rgb(144, 191, 249), 70), LABEL_DEVIATIONS, inline="0215_2", group=GROUP_INTRADAY)
opening_0200_0215_mitigationColor = input.color(color.new(color.rgb(33, 150, 243), 50), LABEL_MITIGATION, inline="0215_2", group=GROUP_INTRADAY)
opening_0200_0215_showLabels = input.string(OPT_NONE, LABEL_DEVIATION_LABELS, inline="0215_3", options=[OPT_NONE, OPT_BODY, OPT_WICK, OPT_BOTH], group=GROUP_INTRADAY)
opening_0200_0215_labelPosition = input.string(OPT_ABOVE, LABEL_SESSION_NAME_POSITION, inline="0215_3", options=[OPT_ABOVE, OPT_BELOW], group=GROUP_INTRADAY)
opening_0900_0915 = input.string(OPT_WICK, SESSION_INTRADAY_0915, inline="0915_1", options=[OPT_HIDDEN, OPT_CORE, OPT_BODY, OPT_WICK, OPT_BOTH], group=GROUP_INTRADAY)
