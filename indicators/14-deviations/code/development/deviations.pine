//@version=6
indicator("deviations •", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════
// CHART CONTEXT
// ═══════════════════════════════════════════════════════════════════════════

validTimeChart = timeframe.period == "30S" or (timeframe.isminutes and (timeframe.multiplier <= 5 or timeframe.multiplier == 15 or timeframe.multiplier == 30))
validChartContext = chart.is_range or validTimeChart

// ═══════════════════════════════════════════════════════════════════════════
// TYPE DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════════

type DeviationZone
    float innerLevel   // Start of range (or the level itself for singles)
    float outerLevel   // End of range (same as innerLevel for singles)
    bool isRange       // true = range like 2:2.5, false = single like 1

type SessionConfig
    string mode              // OPT_HIDDEN, OPT_CORE, OPT_BODY, OPT_WICK, OPT_BOTH
    bool offset
    string showLabels        // OPT_NONE, OPT_BODY, OPT_WICK, OPT_BOTH
    int startMin
    int endMin
    color coreColor
    color deviationColor
    string name
    string chartLabel
    string labelPosition     // OPT_ABOVE, OPT_BELOW
    bool mitigation
    color mitigationColor
    bool delayedMitigation
    string extend            // EXTEND_OFF, EXTEND_6H, etc.
    bool isKeySession
    color retraceLabelTextColor
    color retraceLabelBgColor
    bool retraceCapAt1600
    bool showRetracement
    string retracementMode

type SessionData
    int sessionIndex
    int startBar
    int endBar
    int startTime
    int endTime
    int actualEndTime  // True session end time (for mitigation lines - not extended like endTime)
    float bodyHigh
    float bodyLow
    float wickHigh
    float wickLow
    float bodyHeight
    float wickHeight
    box bodyBox
    box wickBox
    array<line> lines
    array<label> labels
    array<box> deviationBoxes
    color coreColor
    color deviationColor
    string sessionName
    string chartLabel
    bool useOffset
    string deviationMode        // Hide, Core, Body, Wick, Both - which deviations to draw
    string deviationLabelsMode  // None, Body, Wick, Both - which deviation labels to show
    string labelPosition
    // Mitigation tracking
    bool showMitigation
    color mitigationColor
    float dominantHigh
    float dominantLow
    int highBar
    int lowBar
    int highTime
    int lowTime
    bool highMitigated
    bool lowMitigated
    int highMitigationBar
    int lowMitigationBar
    line highMitigationLine
    line lowMitigationLine
    array<label> highMitigationReminders
    array<label> lowMitigationReminders
    // Unmitigated level lines
    line highUnmitigatedLine
    line lowUnmitigatedLine
    label highUnmitigatedLabel
    label lowUnmitigatedLabel
    // 50% mitigation tracking
    float midLevel
    bool midMitigated
    line midMitigationLine
    array<label> midMitigationLabels
    bool midArmed
    // 61.8% retracement tracking (key sessions)
    float retraceLevel618
    bool retrace618Mitigated
    line retrace618Line
    array<label> retrace618Labels
    bool retrace618Armed
    int ivbBreakTime
    int ivbBreakSide  // 1 = IVB high broke first, -1 = IVB low broke first
    int ivbRetraceBar
    bool ivbRetraceCompleted
    // Delayed mitigation (evaluate only from 05:00 onward)
    bool delayedMitigation
    bool isKeySession
    color retraceLabelTextColor
    color retraceLabelBgColor
    bool retraceCapAt1600
    bool showRetracement
    string retracementMode
    // Midnight-crossing session (e.g., 21:30-01:29) - extends same-day logic to next calendar day
    bool crossesMidnight
    // Provisional mitigation tracking (overnight breach pending 05:00 confirmation)
    bool provisionalHighMitigated
    bool provisionalLowMitigated
    int provisionalHighTime
    int provisionalLowTime
    line highPendingLine
    line lowPendingLine
    label highPendingLabel
    label lowPendingLabel
    // Deviation extension (extends deviation zones beyond session end)
    int deviationExtendMs
    // IVB breakout extension projections (avg / avg+1σ lines and labels)
    bool extHighProcessed
    bool extLowProcessed
    int extHighTime
    int extLowTime
    array<line> extLines
    array<label> extLabels

// ═══════════════════════════════════════════════════════════════════════════
// UI STRING CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════

// Group names
GROUP_GENERAL = "General"
GROUP_MITIGATION = "Mitigation"
GROUP_LABELS = "Labels"
GROUP_DISPLAY = "Display"
GROUP_2130_0129 = "Key Session: Rafael (21:30–01:29)"
GROUP_1600_0500 = "Extended Opening: Overnight (16:00–05:00)"
GROUP_0500_0915 = "Extended Opening: Premarket (05:00–09:15)"
GROUP_0600_0900 = "Key Session: NY Early Hours (06:00–09:00)"
GROUP_0930_1000 = "Key Session: IVB (09:30–10:00)"
GROUP_1800_2100 = "Key Session: Asia Open (18:00–21:00)"
GROUP_COLOR_TABLE = "Color Reference Table"

// Common input labels
LABEL_SESSIONS = "No. Of Sessions"
LABEL_SHOW_SESSION_NAMES = "Show Session Names"
LABEL_SESSION_NAME_POSITION = "Session Name"
LABEL_LABEL_COLOR = "Label Color"
LABEL_CORE = "Core"
LABEL_DEVIATIONS = "Deviations"
LABEL_DEVIATION_LABELS = "Dev. Label"
LABEL_OFFSET = "Offset"
LABEL_SHOW_ONLY = "Show Only"
LABEL_HIDDEN_CANDLES = "Hidden Candles"
LABEL_MOST_RECENT_ONLY = "Most Recent Only"
TOOLTIP_MOST_RECENT_ONLY = "Narrows Show Only to a single occurrence: mutes every EARLIER copy of the chosen window too, leaving only the current NY date's occurrence lit, so today's price action reads in isolation. Deviation zones, lines and labels stay fully visible.\n\nMutes on the candle level only, so 'most recent' follows the calendar date — while a session is live this is the latest occurrence; with no session today (weekend/holiday) nothing in the window is lit until the next one opens.\n\nOff = every day's window stays lit."
TOOLTIP_SHOW_ONLY = "Keep only the chosen NY-time window lit and grey out (recolor body, wick and outline) every candle outside it, every day, so the deviation zones read cleanly without manually changing chart colors. The color picker sets the hidden-candle color; the dropdown picks WHICH session stays visible:\n• Overnight (16:00–05:00) — the standard overnight\n• ● ● RTH (05:00–16:00) — premarket into the cash session (default)\n• ● RTH (08:30–16:00) — the 08:30 open through the cash close\n• RTH (09:30–16:00) — the regular trading hours cash session\n\nIntraday only — no effect above the 1-hour timeframe."
LABEL_MITIGATION = "Mitigation"
LABEL_RETRACE_50 = "0.5"
LABEL_RETRACE_618 = "0.618"
LABEL_RETRACE_COLOR = "Retracement Label"
LABEL_RETRACE_BG = "Background"
LABEL_SHOW_RETRACEMENT = "Show 0.5 / 0.618 Labels"
LABEL_RETRACEMENT_MODE = "Retracement Mode"
TOOLTIP_SHOW_RETRACEMENT = "Show this session's 0.5 and 0.618 retracement labels when price returns to those levels after an extreme is taken."
TOOLTIP_RETRACEMENT_MODE = "Standard: the 0.5 / 0.618 retracement qualifies as soon as price returns to the level after a session extreme is taken (normal key-session behavior).\n\nIVB-Based: the first strict break of the completed IVB wick range defines the retracement direction. An IVB high break tracks a downward return from this session's high; an IVB low break tracks an upward return from this session's low. The return must occur on a later bar. IVB must be enabled and included by the active Quick Filter. A bar that breaks both IVB sides cannot establish the required sequence."
LABEL_MITIGATION_REMINDER = "Add Mitigation Reminder Labels"
BRAND_BULLET = " • "
LABEL_EXTEND = "Extend"

// Session UI labels (shown in settings panel)
SESSION_INTRADAY_0129 = "Rafael"
SESSION_EXTENDED_1600_0500 = "Overnight"
SESSION_EXTENDED_0500_0915 = "Premarket"
SESSION_EXTENDED_0600_0900 = "NY Early Hours"
SESSION_EXTENDED_0930_1000 = "IVB"
SESSION_EXTENDED_1800_2100 = "Asia Open"

// Chart labels (shown on the chart - can be different/multi-line)
CHART_LABEL_0129 = "Rafael"
CHART_LABEL_1600_0500 = "Overnight"
CHART_LABEL_0500_0915 = "Premarket"
CHART_LABEL_0600_0900 = "NY Early Hours"
CHART_LABEL_0930_1000 = "IVB"
CHART_LABEL_1800_2100 = "Asia Open"

// Timezone
NY_TIMEZONE = "America/New_York"

// Show Only: keep the chosen recurring NY-time window lit and grey out everything else (the overnight
// window crosses midnight, which Pine session strings handle as end < start). Listed in dropdown order,
// narrowing from the widest span down to RTH.
SESSION_WINDOW_OVERNIGHT = "1600-0500:1234567" // 16:00–05:00 — the original Deviations overnight
SESSION_WINDOW_FROM_0500 = "0500-1600:1234567" // 05:00–16:00 — premarket into the cash session
SESSION_WINDOW_FROM_0830 = "0830-1600:1234567" // 08:30–16:00 — the 08:30 open through the cash close
SESSION_WINDOW_RTH = "0930-1600:1234567"       // 09:30–16:00 — the regular trading hours cash session
SHOW_ONLY_MAX_TIMEFRAME_SECONDS = 60 * 60  // Feature is intraday-only: inactive above the 1-hour chart timeframe
SHOW_OVERNIGHT = "Overnight"
SHOW_FROM_0500 = "● ● RTH"
SHOW_FROM_0830 = "● RTH"
SHOW_RTH = "RTH"

// Style constants
MITIGATION_LINE_WIDTH = 2
MITIGATION_50_LINE_WIDTH = 1
MITIGATION_618_LINE_WIDTH = 1
MITIGATION_PENDING_LINE_WIDTH = 1
PENDING_LABEL_TRANSPARENCY_REDUCTION = 55.0
PENDING_LABEL_TRANSPARENCY_MAX = 12.0
COLOR_TABLE_MAX_ROWS = 60

// Reminder density keys off a line's absolute length, not the session period, so physical chart distance
// drives spacing uniformly (matches Revelio). Floored sqrt over an 8h base: a line earns a 2nd tag past
// ~1.3 days, a 3rd past ~3 days. Cap holds the ceiling at 3 tags per line.
MITIGATION_REMINDER_BASE_MS = 8 * 60 * 60 * 1000
MITIGATION_REMINDER_MAX_PER_LINE = 3

// Show Only — color the hidden (greyed) candles take
const color DEFAULT_HIDDEN_CANDLE_COLOR = color.new(color.rgb(245, 245, 245), 10)


// Tooltips
TOOLTIP_MAX_SESSIONS = "Max number of sessions to display per opening type"
TOOLTIP_SHOW_SESSION_NAMES = "Show session name labels"
TOOLTIP_SHOW_SESSION_NAME_ON_MITIGATION = "Add the session name to mitigation markers for the key sessions (Rafael, Asia Open, IVB).\n\n• 0.5 / 0.618 labels stay bare and use the session's retracement label colors.\n• The mitigated high/low line gets a session-name label (at its midpoint, or tiled along it when Add Mitigation Reminder Labels is on, e.g. asia open).\n\nOff = high/low lines stay unlabelled."
TOOLTIP_RETRACE_TEXT_COLOR = "Text color for this session's 0.5 and 0.618 retracement labels."
TOOLTIP_RETRACE_BG_COLOR = "Background for this session's 0.5 and 0.618 retracement labels."
TOOLTIP_FADE_RETRACE = "Standard retracements fade once BOTH session extremes have been reached, completing the range traversal. NY Early in IVB-Based mode fades only when its qualifying 0.5 / 0.618 return subsequently continues to the opposite NY Early boundary (1.0); an earlier touch of that boundary does not complete the later retracement. Fade % controls how far the completed line and labels move toward invisible.\n\nOff = completed retracements keep their normal colors."
TOOLTIP_MITIGATION_REMINDER = "Repeat a key session's markers sparsely along the line they belong to, so a faded line stays identifiable when you scroll away from its midpoint.\n\n• Mitigated high/low lines repeat the session name.\n• 0.5 / 0.618 lines repeat their own label.\n\nDensity keys off each line's own length and stays sparse (sublinear): most lines get a single tag, and only long extensions earn a second.\n\nOff = one label at each line's midpoint only."

// IVB session window (NY minutes) - shared by the session config and the extension statistics
IVB_START_MIN = 570
IVB_END_MIN = 600

// IVB breakout extensions - minimum recorded samples before projections draw
IVB_EXT_MIN_SAMPLES = 5
LABEL_EXT_AVG = "ivb avg"
LABEL_EXT_STD = "ivb +1σ"

TOOLTIP_IVB_EXTENSIONS = "Project how far price historically travels beyond a broken IVB edge. On the first wick breach of an IVB side, Average and Average + 1 standard deviation levels draw from the breach to 16:00. Both share one color and width and use dashed lines.\n\nBoth are measured as a ratio of each day's IVB range. Every broken side of a past IVB contributes one sample (10:00–16:00 max excursion); Lookback caps how many samples the statistics use. Levels appear only once at least 5 samples exist. Requires IVB Mitigation to be on."

// Option values
OPT_HIDDEN = "Hidden"
OPT_NONE = "None"
OPT_CORE = "Core"
OPT_BODY = "Body"
OPT_WICK = "Wick"
OPT_BOTH = "Both"
OPT_ABOVE = "Above"
OPT_BELOW = "Below"

// Session indices
IDX_0129 = 0
IDX_NY_EARLY = 1
IDX_OVERNIGHT = 2
IDX_PREMARKET = 3
IDX_ASIA_OPEN = 4
IDX_IVB = 5

// Global mitigation display mode
SESSION_MITIGATED = "Mitigated"
SESSION_UNMITIGATED = "Unmitigated"

RETRACE_MODE_STANDARD = "Standard"
RETRACE_MODE_IVB = "IVB-Based"

// Quick filter presets
FILTER_ALL = "All"
FILTER_RAFAEL_1800 = "Rafael + 1800"
FILTER_RAFAEL_1800_EARLY = "☾ Rafael + 1800 + Early"
FILTER_RAFAEL_1800_EARLY_IVB = "Rafael + 1800 + Early + IVB"
FILTER_NY_EARLY_IVB = "NY Early + IVB"
FILTER_NY_EARLY_IVB_PREMARKET = "NY Early + IVB + Premarket"
FILTER_RAFAEL_1800_EARLY_OVERNIGHT = "Rafael + 1800 + Early + Overnight"
FILTER_1800 = "1800 Range"
FILTER_1800_EARLY = "1800 + Early"
FILTER_RAFAEL_1800_EARLY_PREMARKET_OVERNIGHT = "Rafael + 1800 + Early + Premarket + Overnight"
FILTER_IVB = "IVB"
FILTER_PREP2 = "★ Rafael + 1800 + Early + IVB + Premarket"

// Deviation extension presets
EXTEND_OFF = "-"
EXTEND_3H = "3h"
EXTEND_6H = "6h"
EXTEND_8H = "8h"
EXTEND_12H = "12h"
EXTEND_NEXT = "Until Next"

// Default deviation zones (unified - body = wick for all sessions)
DEV_A_PREMARKET = "0.25:0.5, 0.75:1"                     // Premarket (05:00-09:15)
DEV_B_NY_EARLY = "0.25:0.5, 1.33:1.66"                   // NY Early Hours (06:00-09:00)
DEV_C_ASIA = "0.25:0.5, 1:1.25, 1.33:1.66"              // Asia Open (18:00-21:00)
DEV_G_OVERNIGHT = "0.25:0.5, 0.75:1, 1.25:1.5"          // Overnight (16:00-05:00)
DEV_H_RAFAEL = "0.5:1, 2:2.5, 3, 4:4.5"  // Rafael (21:30-01:29)
DEV_J_IVB = "0.25:0.5, 1:1.5"                                    // IVB (09:30-10:00)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - General Settings
// ═══════════════════════════════════════════════════════════════════════════

quickFilter = input.string(FILTER_PREP2, "Quick Filter", options=[FILTER_ALL, FILTER_RAFAEL_1800, FILTER_RAFAEL_1800_EARLY, FILTER_RAFAEL_1800_EARLY_IVB, FILTER_PREP2, FILTER_RAFAEL_1800_EARLY_OVERNIGHT, FILTER_RAFAEL_1800_EARLY_PREMARKET_OVERNIGHT, FILTER_1800, FILTER_1800_EARLY, FILTER_IVB, FILTER_NY_EARLY_IVB, FILTER_NY_EARLY_IVB_PREMARKET], group=GROUP_GENERAL, tooltip="Quick filter presets for session visibility.")
maxSessions = input.int(3, LABEL_SESSIONS, group=GROUP_GENERAL, tooltip=TOOLTIP_MAX_SESSIONS, minval=1, maxval=50)
showOnlyEnabled = input.bool(true, LABEL_SHOW_ONLY, inline="show_only", group=GROUP_GENERAL, tooltip=TOOLTIP_SHOW_ONLY)
hiddenCandleColor = input.color(DEFAULT_HIDDEN_CANDLE_COLOR, "", inline="show_only", group=GROUP_GENERAL, tooltip=TOOLTIP_SHOW_ONLY)
visibleWindow = input.string(SHOW_FROM_0500, "", options=[SHOW_OVERNIGHT, SHOW_FROM_0500, SHOW_FROM_0830, SHOW_RTH], inline="show_only", group=GROUP_GENERAL, tooltip=TOOLTIP_SHOW_ONLY)
showOnlyMostRecent = input.bool(false, LABEL_MOST_RECENT_ONLY, inline="show_only", group=GROUP_GENERAL, tooltip=TOOLTIP_SHOW_ONLY + "\n\n———\n\n" + LABEL_MOST_RECENT_ONLY + "\n" + TOOLTIP_MOST_RECENT_ONLY)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - Mitigation
// ═══════════════════════════════════════════════════════════════════════════

mitigationMode = input.string(SESSION_MITIGATED, "Mode", options=[SESSION_MITIGATED, SESSION_UNMITIGATED], group=GROUP_MITIGATION, tooltip="Mitigated: Show lines when levels are touched\nUnmitigated: Show persistent lines for untouched levels")
showUnmitigatedRafaelAsiaOpenLevels = input.bool(false, "Show Unmitigated Rafael + Asia Open Levels", group=GROUP_MITIGATION, tooltip="Keep unmitigated Rafael and Asia Open highs and lows visible while using Mitigated mode.")

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - Labels
// ═══════════════════════════════════════════════════════════════════════════

showAllLabels = input.bool(true, "Show All Labels", group=GROUP_LABELS, tooltip="Master label switch. Off hides every chart label while preserving all label settings below, so turning it back on restores the same label configuration.")
showSessionNames = input.bool(false, LABEL_SHOW_SESSION_NAMES, group=GROUP_LABELS, tooltip=TOOLTIP_SHOW_SESSION_NAMES)
showPendingLabels = input.bool(true, "Label Provisional Lines", group=GROUP_LABELS, tooltip="Adds a right-edge session label to provisional (dashed) mitigation lines so you can identify which session each dashed line belongs to on a busy chart.")
showSessionNameOnMitigation = input.bool(true, "Show Session Name on Key Mitigations", group=GROUP_LABELS, tooltip=TOOLTIP_SHOW_SESSION_NAME_ON_MITIGATION)
showMitigationReminders = input.bool(true, LABEL_MITIGATION_REMINDER, group=GROUP_LABELS, tooltip=TOOLTIP_MITIGATION_REMINDER)
labelColor = input.color(color.rgb(120, 123, 134), LABEL_LABEL_COLOR, inline="label_colors", group=GROUP_LABELS)
labelsBgColor = input.color(color.new(color.rgb(255, 255, 255), 50), "Background", inline="label_colors", group=GROUP_LABELS, tooltip="Background color for session and deviation labels. Key-session 0.5 and 0.618 labels use their session-specific controls instead. Set transparency to 100 for no background.")
fadeCompletedRetracements = input.bool(true, "Fade Completed Retracement Levels", inline="fade", group=GROUP_LABELS, tooltip=TOOLTIP_FADE_RETRACE)
completedRetraceFade = input.int(65, "Fade %", minval=0, maxval=100, inline="fade", group=GROUP_LABELS, tooltip="How far to fade each completed 0.5 / 0.618 line and label toward invisible once its retracement completes.")

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - Display
// ═══════════════════════════════════════════════════════════════════════════

showAllLines = input.bool(true, "Show All Lines", group=GROUP_DISPLAY, tooltip="Master line switch. Off hides deviation levels, mitigation lines, provisional lines, unmitigated extensions and retracement lines while leaving boxes visible. Calculations continue normally.")
enableDeviationGlow = input.bool(true, "Deviation Glow", group=GROUP_DISPLAY, tooltip="Darken deviation zones when price touches them. The darkening only persists while the touch is within the configured time window.")
glowDarkenPercent = input.float(25.0, "  └ Opacity", inline="glow_settings", group=GROUP_DISPLAY, minval=0.1, maxval=99.9, step=0.1)
glowWindowHours = input.float(6.0, "Duration", inline="glow_settings", group=GROUP_DISPLAY, minval=0.5, maxval=24.0, step=0.5, tooltip="Time window in hours. Touches older than this will not show the darkening effect.")
quickCheckMode = input.bool(true, "Quick Check", group=GROUP_DISPLAY, tooltip="Hide deviations for Rafael and 1800 - show core only")

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - 16:00-05:00
// ═══════════════════════════════════════════════════════════════════════════

deviations_1600_0500 = input.string(DEV_G_OVERNIGHT, "Deviations", group=GROUP_1600_0500)

opening_1600_0500 = input.string(OPT_WICK, SESSION_EXTENDED_1600_0500, inline="1600_1", options=[OPT_HIDDEN, OPT_BODY, OPT_WICK, OPT_BOTH], group=GROUP_1600_0500)
opening_1600_0500_offset = input.bool(false, LABEL_OFFSET, inline="1600_1", group=GROUP_1600_0500)
opening_1600_0500_mitigation = input.bool(true, LABEL_MITIGATION, inline="1600_1", group=GROUP_1600_0500)
opening_1600_0500_extend = input.string(EXTEND_OFF, LABEL_EXTEND, inline="1600_extend", options=[EXTEND_OFF, EXTEND_3H, EXTEND_6H, EXTEND_8H, EXTEND_12H, EXTEND_NEXT], group=GROUP_1600_0500)
opening_1600_0500_coreColor = input.color(color.new(color.rgb(219, 219, 219), 94), LABEL_CORE, inline="1600_2", group=GROUP_1600_0500)
opening_1600_0500_deviationColor = input.color(color.new(color.rgb(219, 219, 219), 82), LABEL_DEVIATIONS, inline="1600_2", group=GROUP_1600_0500)
opening_1600_0500_mitigationColor = input.color(color.new(color.rgb(219, 219, 219), 0), LABEL_MITIGATION, inline="1600_2", group=GROUP_1600_0500)
opening_1600_0500_showLabels = input.string(OPT_NONE, LABEL_DEVIATION_LABELS, inline="1600_3", options=[OPT_NONE, OPT_BODY, OPT_WICK, OPT_BOTH], group=GROUP_1600_0500)
opening_1600_0500_labelPosition = input.string(OPT_ABOVE, LABEL_SESSION_NAME_POSITION, inline="1600_3", options=[OPT_ABOVE, OPT_BELOW], group=GROUP_1600_0500)
// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - 05:00-09:15
// ═══════════════════════════════════════════════════════════════════════════

deviations_0500_0915 = input.string(DEV_A_PREMARKET, "Deviations", group=GROUP_0500_0915)

opening_0500_0915 = input.string(OPT_WICK, SESSION_EXTENDED_0500_0915, inline="0500_1", options=[OPT_HIDDEN, OPT_BODY, OPT_WICK, OPT_BOTH], group=GROUP_0500_0915)
opening_0500_0915_offset = input.bool(false, LABEL_OFFSET, inline="0500_1", group=GROUP_0500_0915)
opening_0500_0915_mitigation = input.bool(true, LABEL_MITIGATION, inline="0500_1", group=GROUP_0500_0915)
opening_0500_0915_extend = input.string(EXTEND_OFF, LABEL_EXTEND, inline="0500_extend", options=[EXTEND_OFF, EXTEND_3H, EXTEND_6H, EXTEND_8H, EXTEND_12H, EXTEND_NEXT], group=GROUP_0500_0915)
opening_0500_0915_coreColor = input.color(color.new(color.rgb(77, 243, 8), 100), LABEL_CORE, inline="0500_2", group=GROUP_0500_0915)
opening_0500_0915_deviationColor = input.color(color.new(color.rgb(77, 243, 8), 93), LABEL_DEVIATIONS, inline="0500_2", group=GROUP_0500_0915)
opening_0500_0915_mitigationColor = input.color(color.new(color.rgb(77, 243, 8), 20), LABEL_MITIGATION, inline="0500_2", group=GROUP_0500_0915)
opening_0500_0915_showLabels = input.string(OPT_NONE, LABEL_DEVIATION_LABELS, inline="0500_3", options=[OPT_NONE, OPT_BODY, OPT_WICK, OPT_BOTH], group=GROUP_0500_0915)
opening_0500_0915_labelPosition = input.string(OPT_BELOW, LABEL_SESSION_NAME_POSITION, inline="0500_3", options=[OPT_ABOVE, OPT_BELOW], group=GROUP_0500_0915)
// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - Key Session: Asia Open (18:00-21:00)
// ═══════════════════════════════════════════════════════════════════════════

deviations_1800_2100 = input.string(DEV_C_ASIA, "Deviations", group=GROUP_1800_2100)

opening_1800_2100 = input.string(OPT_CORE, SESSION_EXTENDED_1800_2100, inline="1800_1", options=[OPT_HIDDEN, OPT_CORE, OPT_BODY, OPT_WICK, OPT_BOTH], group=GROUP_1800_2100)
opening_1800_2100_offset = input.bool(false, LABEL_OFFSET, inline="1800_1", group=GROUP_1800_2100)
opening_1800_2100_mitigation = input.bool(true, LABEL_MITIGATION, inline="1800_1", group=GROUP_1800_2100)
opening_1800_2100_extend = input.string(EXTEND_OFF, LABEL_EXTEND, inline="1800_extend", options=[EXTEND_OFF, EXTEND_3H, EXTEND_6H, EXTEND_8H, EXTEND_12H, EXTEND_NEXT], group=GROUP_1800_2100)
