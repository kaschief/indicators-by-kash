//@version=6
indicator("deviations •", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════
// CHART CONTEXT
// ═══════════════════════════════════════════════════════════════════════════

validTimeChart = timeframe.period == "30S" or (timeframe.isminutes and (timeframe.multiplier <= 5 or timeframe.multiplier == 15 or timeframe.multiplier == 30))
validChartContext = chart.is_range or validTimeChart

// ═══════════════════════════════════════════════════════════════════════════
// TYPE DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════════

type DeviationZone
    float innerLevel   // Start of range (or the level itself for singles)
    float outerLevel   // End of range (same as innerLevel for singles)
    bool isRange       // true = range like 2:2.5, false = single like 1

type SessionConfig
    string mode              // OPT_HIDDEN, OPT_CORE, OPT_BODY, OPT_WICK, OPT_BOTH
    bool offset
    string showLabels        // OPT_NONE, OPT_BODY, OPT_WICK, OPT_BOTH
    int startMin
    int endMin
    color coreColor
    color deviationColor
    string name
    string chartLabel
    string labelPosition     // OPT_ABOVE, OPT_BELOW
    bool mitigation
    color mitigationColor
    bool delayedMitigation
    string extend            // EXTEND_OFF, EXTEND_6H, etc.
    bool isKeySession
    color retraceLabelTextColor
    color retraceLabelBgColor
    bool retraceCapAt1600
    bool showRetracement
    string retracementMode

type SessionData
    int sessionIndex
    int startBar
    int endBar
    int startTime
    int endTime
    int actualEndTime  // Unextended endpoint used by completed drawings and mitigation lines
    int actualEndBar
    float bodyHigh
    float bodyLow
    float wickHigh
    float wickLow
    float bodyHeight
    float wickHeight
    box bodyBox
    box wickBox
    array<line> lines
    array<label> labels
    array<box> deviationBoxes
    color coreColor
    color deviationColor
    string sessionName
    string chartLabel
    bool useOffset
    string deviationMode        // Hide, Core, Body, Wick, Both - which deviations to draw
    string deviationLabelsMode  // None, Body, Wick, Both - which deviation labels to show
    string labelPosition
    // Mitigation tracking
    bool showMitigation
    color mitigationColor
    float dominantHigh
    float dominantLow
    int highTime
    int lowTime
    int highBar
    int lowBar
    bool highMitigated
    bool lowMitigated
    int highMitigationBar
    int lowMitigationBar
    int highMitigationTime
    int lowMitigationTime
    line highMitigationLine
    line lowMitigationLine
    array<label> highMitigationReminders
    array<label> lowMitigationReminders
    bool highMitigationFadeApplied
    bool lowMitigationFadeApplied
    // Unmitigated level lines
    line highUnmitigatedLine
    line lowUnmitigatedLine
    label highUnmitigatedLabel
    label lowUnmitigatedLabel
    array<label> highUnmitigatedReminders
    array<label> lowUnmitigatedReminders
    // 50% mitigation tracking
    float midLevel
    bool midMitigated
    int midMitigationTime
    int midMitigationBar
    line midMitigationLine
    array<label> midMitigationLabels
    bool midArmed
    // 61.8% retracement tracking (key sessions)
    float retraceLevel618
    bool retrace618Mitigated
    int retrace618Time
    int retrace618Bar
    line retrace618Line
    array<label> retrace618Labels
    bool retrace618Armed
    int retraceOriginSide  // 1 = high, -1 = low
    int retraceOriginBar
    bool retraceOriginProvisional
    int retraceLegStartBar
    bool retraceTraversalCompleted
    bool retraceFadeApplied
    int ivbBreakTime
    int ivbBreakSide  // 1 = IVB high broke first, -1 = IVB low broke first
    int ivbRetraceBar
    bool ivbRetraceCompleted
    // Delayed mitigation (evaluate only from 05:00 onward)
    bool delayedMitigation
    bool isKeySession
    color retraceLabelTextColor
    color retraceLabelBgColor
    bool retraceCapAt1600
    bool showRetracement
    string retracementMode
    // Midnight-crossing session (e.g., 21:30-01:29) - extends same-day logic to next calendar day
    bool crossesMidnight
    int startDayKey
    int nextDayKey
    // Provisional boundary tracking (IVB close confirmation and overnight handoff)
    bool provisionalHighMitigated
    bool provisionalLowMitigated
    int provisionalHighTime
    int provisionalLowTime
    int provisionalHighBar
    int provisionalLowBar
    line highPendingLine
    line lowPendingLine
    label highPendingLabel
    label lowPendingLabel
    // Deviation extension (extends deviation zones beyond session end)
    int deviationExtendMs
    // Asia Open's 1.25–1.5 wick-deviation zones, revealed after a 1.5 cross during NY Early.
    box asiaDev15UpperGlowBox
    box asiaDev15LowerGlowBox
    // IVB breakout extension projections (avg / avg+1σ lines and optional price labels)
    bool extHighProcessed
    bool extLowProcessed
    int extHighTime
    int extLowTime
    bool extHighConfirmed
    bool extLowConfirmed
    array<line> extLines
    array<label> extLabels

type FocusCandidate
    bool hasUntouchedLevel
    float distance
    int sourceIndex
    int endTime

// ═══════════════════════════════════════════════════════════════════════════
// UI STRING CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════

// Group names
GROUP_QUICK_FILTER = "⚡ Quick Filter"
GROUP_QUICK_FILTER_PRICES = "⚡ Quick Filter: Prices"
GROUP_MITIGATION = "Mitigation"
GROUP_LABELS = "Labels"
GROUP_DISPLAY = "Display"
GROUP_SECONDARY_PANE = "Secondary Pane"
GROUP_2130_0129 = "Key Session: Rafael (21:30–01:29)"
GROUP_0500_0915 = "Extended Opening: Premarket (05:00–09:15)"
GROUP_0600_0900 = "Key Session: NY Early Hours (06:00–09:00)"
GROUP_0930_1000 = "Key Session: IVB (09:30–10:00)"
GROUP_1800_2100 = "Key Session: Asia Open (18:00–21:00)"
GROUP_FOCUS = "⚡ Quick Filter: Asia and Rafael Focus"
GROUP_COLOR_TABLE = "Color Reference Table"

// Common input labels
LABEL_SESSIONS = "No. Of Sessions"
LABEL_SHOW_SESSION_NAMES = "Show Session Names"
LABEL_SESSION_NAME_POSITION = "Session Name"
LABEL_LABEL_COLOR = "Label Color"
LABEL_CORE = "Core"
LABEL_DEVIATIONS = "Deviations"
LABEL_DEVIATION_LABELS = "Dev. Label"
LABEL_OFFSET = "Offset"
LABEL_SHOW_ONLY = "Show Only"
LABEL_HIDDEN_CANDLES = "Hidden Candles"
LABEL_MOST_RECENT_ONLY = "Most Recent Only"
LABEL_SHOW_PANE_CANDLES = "Show Price Candles in Pane"
TOOLTIP_MOST_RECENT_ONLY = "Narrows Show Only to a single occurrence: mutes every EARLIER copy of the chosen window too, leaving only the current NY date's occurrence lit, so today's price action reads in isolation. Deviation zones, lines and labels stay fully visible.\n\nMutes on the candle level only, so 'most recent' follows the calendar date — while a session is live this is the latest occurrence; with no session today (weekend/holiday) nothing in the window is lit until the next one opens.\n\nOff = every day's window stays lit."
TOOLTIP_SHOW_ONLY = "Keep only the chosen NY-time window lit and grey out (recolor body, wick and outline) every candle outside it, every day, so the deviation zones read cleanly without manually changing chart colors. The color picker sets the hidden-candle color; the dropdown picks WHICH session stays visible:\n• Overnight (16:00–05:00) — the standard overnight\n• ● ● RTH (05:00–16:00) — premarket into the cash session (default)\n• ● RTH (08:30–16:00) — the 08:30 open through the cash close\n• RTH (09:30–16:00) — the regular trading hours cash session\n\nSecondary pane: applies only to pane candles and never changes main-chart candles.\n\nIntraday only — no effect above the 1-hour timeframe."
LABEL_MITIGATION = "Mitigation"
LABEL_RETRACE_50 = "0.5"
LABEL_RETRACE_618 = "0.618"
LABEL_RETRACE_COLOR = "Retracement Label"
LABEL_RETRACE_BG = "Background"
LABEL_SHOW_RETRACEMENT = "Show 0.5 / 0.618 Labels"
LABEL_RETRACEMENT_MODE = "Retracement Mode"
LABEL_SIZE_TINY = "Tiny"
LABEL_SIZE_SMALL = "Small"
LABEL_SIZE_NORMAL = "Normal"
LABEL_SIZE_LARGE = "Large"
LABEL_SIZE_HUGE = "Huge"
TOOLTIP_SHOW_RETRACEMENT = "Show this session's 0.5 and 0.618 retracement labels when price returns to those levels after an extreme is taken."
TOOLTIP_RETRACEMENT_MODE = "Standard: the 0.5 / 0.618 retracement qualifies as soon as price returns to the level after a session extreme is taken (normal key-session behavior).\n\nIVB-Based: the first strict break of the completed IVB wick range defines the retracement direction. An IVB high break tracks a downward return from this session's high; an IVB low break tracks an upward return from this session's low. The return must occur on a later bar. IVB must be enabled and included by the active Quick Filter. A bar that breaks both IVB sides cannot establish the required sequence."
LABEL_MITIGATION_REMINDER = "Add Mitigation Reminder Labels"
BRAND_BULLET = " • "
LABEL_EXTEND = "Extend"

// Session UI labels (shown in settings panel)
SESSION_INTRADAY_0129 = "Rafael"
SESSION_EXTENDED_0500_0915 = "Premarket"
SESSION_EXTENDED_0600_0900 = "NY Early Hours"
SESSION_EXTENDED_0930_1000 = "IVB"
SESSION_EXTENDED_1800_2100 = "Asia Open"

// Chart labels (shown on the chart - can be different/multi-line)
CHART_LABEL_0129 = "Rafael"
CHART_LABEL_0500_0915 = "Premarket"
CHART_LABEL_0600_0900 = "NY Early Hours"
CHART_LABEL_0930_1000 = "IVB"
CHART_LABEL_1800_2100 = "Asia Open"

// Timezone
NY_TIMEZONE = "America/New_York"

// Show Only: keep the chosen recurring NY-time window lit and grey out everything else (the overnight
// window crosses midnight, which Pine session strings handle as end < start). Listed in dropdown order,
// narrowing from the widest span down to RTH.
SESSION_WINDOW_OVERNIGHT = "1600-0500:1234567" // 16:00–05:00 — the original Deviations overnight
SESSION_WINDOW_FROM_0500 = "0500-1600:1234567" // 05:00–16:00 — premarket into the cash session
SESSION_WINDOW_FROM_0830 = "0830-1600:1234567" // 08:30–16:00 — the 08:30 open through the cash close
SESSION_WINDOW_RTH = "0930-1600:1234567"       // 09:30–16:00 — the regular trading hours cash session
SHOW_ONLY_MAX_TIMEFRAME_SECONDS = 60 * 60  // Feature is intraday-only: inactive above the 1-hour chart timeframe
SHOW_OVERNIGHT = "Overnight"
SHOW_FROM_0500 = "● ● RTH"
SHOW_FROM_0830 = "● RTH"
SHOW_RTH = "RTH"

PLACEMENT_MAIN_CHART = "Main Chart"
PLACEMENT_SECONDARY_PANE = "Secondary Pane"

// Style constants
MITIGATION_LINE_WIDTH = 2
MITIGATION_50_LINE_WIDTH = 1
MITIGATION_618_LINE_WIDTH = 1
MITIGATION_PENDING_LINE_WIDTH = 1
PENDING_LABEL_TRANSPARENCY_REDUCTION = 55.0
PENDING_LABEL_TRANSPARENCY_MAX = 12.0
COLOR_TABLE_MAX_ROWS = 66

// Reminder density follows actual chart-bar distance so closed sessions cannot create or stack tags.
MITIGATION_REMINDER_SPACING_BARS = 120
MITIGATION_REMINDER_MAX_PER_LINE = 3
BAR_INDEX_DRAWING_LOOKBACK = 9999

// Show Only — color the hidden (greyed) candles take
const color DEFAULT_HIDDEN_CANDLE_COLOR = color.new(color.rgb(245, 245, 245), 10)
const color DEFAULT_PANE_UP_BODY_COLOR = #fafafa
const color DEFAULT_PANE_DOWN_BODY_COLOR = color.new(#5b9cf6, 25)
const color DEFAULT_PANE_UP_BORDER_COLOR = color.new(#808080, 25)
const color DEFAULT_PANE_DOWN_BORDER_COLOR = color.new(#808080, 20)
const color DEFAULT_PANE_WICK_COLOR = #9c9c9c


// Tooltips
TOOLTIP_KEEP_PAST_GLOW = "Earlier sessions keep the glow they earned while live instead of clearing it. They never register new touches.\n\nOff = only the most recent session of each type shows glow."
TOOLTIP_MAX_SESSIONS = "Max sessions shown per opening type."
TOOLTIP_SHOW_SESSION_NAMES = "Show session name labels"
TOOLTIP_SHOW_SESSION_NAME_ON_MITIGATION = "Add the session name to mitigation markers for the key sessions (Rafael, Asia Open, IVB).\n\n• 0.5 / 0.618 labels stay bare and use the session's retracement label colors.\n• The mitigated high/low line gets a session-name label (at its midpoint, or tiled along it when Add Mitigation Reminder Labels is on, e.g. asia open).\n\nOff = high/low lines stay unlabelled."
TOOLTIP_RETRACE_TEXT_COLOR = "Text color for this session's 0.5 and 0.618 retracement labels."
TOOLTIP_RETRACE_BG_COLOR = "Background for this session's 0.5 and 0.618 retracement labels."
TOOLTIP_FADE_RETRACE = "Standard retracements fade once BOTH session extremes have been reached, completing the range traversal. NY Early in IVB-Based mode fades only when its qualifying 0.5 / 0.618 return subsequently continues to the opposite NY Early boundary (1.0); an earlier touch of that boundary does not complete the later retracement. Fade % controls how far the completed line and labels move toward invisible.\n\nOff = completed retracements keep their normal colors."
TOOLTIP_FADE_MITIGATION = "Completed high/low levels from every session fade after current price moves the configured percentage away. Once triggered, the fade stays applied. Fade opacity is the minimum transparency applied to both solid and dashed boundary segments and their labels: 0 is visible, 100 is hidden.\n\nOff = completed mitigation levels keep their normal colors."
TOOLTIP_MITIGATION_REMINDER = "Repeat a key session's markers sparsely along the line they belong to, so a faded line stays identifiable when you scroll away from its midpoint.\n\n• Mitigated high/low lines repeat the session name.\n• 0.5 / 0.618 lines repeat their own label.\n\nDensity follows actual chart candles: short higher-timeframe lines stay sparse, while the same elapsed span can earn more reminders on lower timeframes.\n\nOff = one label at each line's midpoint only."

TOOLTIP_FOCUS = "Surfaces distant untouched Rafael and Asia Open levels on top of the recent sessions, nearest first."
TOOLTIP_FOCUS_COUNT = "Per session type."
TOOLTIP_FOCUS_ANCHOR = "Manual ranks from the Price level."

// IVB session window (NY minutes) - shared by the session config and the extension statistics
IVB_START_MIN = 570
IVB_END_MIN = 600

// Asia Open uses standard 1-minute OHLC on Range charts so synthetic gap-fill bars do not widen it.
ASIA_OPEN_START_MIN = 1080
ASIA_OPEN_END_MIN = 1260
STANDARD_SESSION_SOURCE_TF = "1"

// IVB breakout extensions - minimum recorded samples before projections draw
IVB_EXT_MIN_SAMPLES = 5
IVB_EXT_MIN_VISIBLE_MS = 6 * 60 * 60 * 1000
TOOLTIP_IVB_EXTENSIONS = "Projects IVB Average and +1σ breakout levels after a confirmed 30-minute close outside the IVB wick range. Lines end at 16:00 or after six hours for late breakouts. Lookback sets the sample count. Requires at least 5 samples and IVB Mitigation."

// Option values
OPT_HIDDEN = "Hidden"
OPT_NONE = "None"
OPT_CORE = "Core"
OPT_BODY = "Body"
OPT_WICK = "Wick"
OPT_BOTH = "Both"
OPT_ABOVE = "Above"
OPT_BELOW = "Below"

// Session indices
IDX_0129 = 0
IDX_NY_EARLY = 1
IDX_PREMARKET = 2
IDX_ASIA_OPEN = 3
IDX_IVB = 4

// Global mitigation display mode
SESSION_MITIGATED = "Mitigated"
SESSION_UNMITIGATED = "Unmitigated"

RETRACE_MODE_STANDARD = "Standard"
RETRACE_MODE_IVB = "IVB-Based"
REPLACEMENT_TRIGGER_618 = "0.618"
REPLACEMENT_TRIGGER_50 = "0.5"

// Quick filter presets
FILTER_ALL = "All"
FILTER_RAFAEL_ASIA_OPEN = "Rafael + Asia Open"
FILTER_RAFAEL_ASIA_OPEN_EARLY = "☾ Rafael + Asia Open + Early"
FILTER_RAFAEL_ASIA_OPEN_EARLY_IVB = "Rafael + Asia Open + Early + IVB"
FILTER_NY_EARLY_IVB = "NY Early + IVB"
FILTER_NY_EARLY_IVB_PREMARKET = "NY Early + IVB + Premarket"
FILTER_ASIA_OPEN = "Asia Open"
FILTER_ASIA_OPEN_EARLY = "Asia Open + Early"
FILTER_IVB = "IVB"
FILTER_PREMARKET = "Premarket"
FILTER_PREP2 = "★ Rafael + Asia Open + Early + IVB + Premarket"

PRICE_MODE_OFF = "Off"
PRICE_MODE_ACTIVE = "Active"
PRICE_MODE_CUSTOM = "Custom"
LABEL_EXT_AVG = "ivb avg"
LABEL_EXT_STD = "ivb +1σ"
TOOLTIP_PRICE_MODE = "Numeric prices on right-edge unmitigated Rafael and Asia Open levels and at the right end of IVB projection lines. IVB projection captions sit at the line midpoint without prices and move to the right endpoint when prices are shown.\n\n• Off — no numeric prices.\n• Active — all three categories.\n• Custom — choices in Quick Filter: Prices."
TOOLTIP_CUSTOM_PRICES = "Used when Prices is Custom. Choose which categories show numeric prices."
TOOLTIP_LABEL_MASTER = "Show All Labels is the master label switch. Off hides every chart label while preserving the settings below.\n\n———\n\nPrice & Size Quick Boost temporarily shows prices on active Rafael, Asia Open and IVB projections and renders every chart label at Small size. Your Prices mode and selected label size stay unchanged."

FOCUS_DIRECTION_OFF = "Off"
FOCUS_DIRECTION_BELOW = "↓ Below"
FOCUS_DIRECTION_ABOVE = "↑ Above"
FOCUS_DIRECTION_AROUND = "↕ Around"
FOCUS_ANCHOR_PRICE = "Current Price"
FOCUS_ANCHOR_MANUAL = "Manual"
// Must match the max_*_count limits declared in indicator().
FOCUS_DRAWING_LIMIT = 500
// Reserved for non-Focus drawings that can still grow after Focus admission.
FOCUS_DRAWING_HEADROOM = 50
LABEL_FOCUS_ANCHOR = "ASIA + RAFAEL FOCUS ANCHOR"
LABEL_FOCUS_ANCHOR_UNSET = "ASIA + RAFAEL FOCUS ANCHOR UNSET"
LABEL_FOCUS_ANCHOR_COLOR = "Anchor Line"

// Deviation extension presets
EXTEND_OFF = "-"
EXTEND_3H = "3h"
EXTEND_6H = "6h"
EXTEND_8H = "8h"
EXTEND_12H = "12h"
EXTEND_NEXT = "Until Next"

// Default deviation zones (unified - body = wick for all sessions)
DEV_A_PREMARKET = "0.25:0.5, 0.75:1"                     // Premarket (05:00-09:15)
DEV_B_NY_EARLY = "0.25:0.5, 1.33:1.66"                   // NY Early Hours (06:00-09:00)
DEV_C_ASIA = "0.25:0.5, 1:1.25, 1.33:1.66"              // Asia Open (18:00-21:00)
DEV_H_RAFAEL = "0.5:1, 2:2.5, 3, 4:4.5"  // Rafael (21:30-01:29)
DEV_J_IVB = "0.25:0.5, 1:1.5"                                    // IVB (09:30-10:00)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - Quick Filter
// ═══════════════════════════════════════════════════════════════════════════

quickFilter = input.string(FILTER_PREP2, "Quick Filter", options=[FILTER_ALL, FILTER_RAFAEL_ASIA_OPEN, FILTER_RAFAEL_ASIA_OPEN_EARLY, FILTER_RAFAEL_ASIA_OPEN_EARLY_IVB, FILTER_PREP2, FILTER_ASIA_OPEN, FILTER_ASIA_OPEN_EARLY, FILTER_IVB, FILTER_PREMARKET, FILTER_NY_EARLY_IVB, FILTER_NY_EARLY_IVB_PREMARKET], group=GROUP_QUICK_FILTER, tooltip="Quick filter presets for session visibility.")
maxSessions = input.int(3, LABEL_SESSIONS, group=GROUP_QUICK_FILTER, tooltip=TOOLTIP_MAX_SESSIONS, minval=1, maxval=100)
quickPriceMode = input.string(PRICE_MODE_OFF, "Prices", options=[PRICE_MODE_OFF, PRICE_MODE_ACTIVE, PRICE_MODE_CUSTOM], group=GROUP_QUICK_FILTER, tooltip=TOOLTIP_PRICE_MODE)
showOnlyEnabled = input.bool(true, LABEL_SHOW_ONLY, inline="show_only", group=GROUP_QUICK_FILTER, tooltip=TOOLTIP_SHOW_ONLY)
hiddenCandleColor = input.color(DEFAULT_HIDDEN_CANDLE_COLOR, "", inline="show_only", group=GROUP_QUICK_FILTER, tooltip=TOOLTIP_SHOW_ONLY)
visibleWindow = input.string(SHOW_FROM_0500, "", options=[SHOW_OVERNIGHT, SHOW_FROM_0500, SHOW_FROM_0830, SHOW_RTH], inline="show_only", group=GROUP_QUICK_FILTER, tooltip=TOOLTIP_SHOW_ONLY)
showOnlyMostRecent = input.bool(false, LABEL_MOST_RECENT_ONLY, inline="show_only", group=GROUP_QUICK_FILTER, tooltip=TOOLTIP_SHOW_ONLY + "\n\n———\n\n" + LABEL_MOST_RECENT_ONLY + "\n" + TOOLTIP_MOST_RECENT_ONLY)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - Quick Filter: Prices
// ═══════════════════════════════════════════════════════════════════════════

rafaelShowPrice = input.bool(false, "Rafael", inline="quick_prices", group=GROUP_QUICK_FILTER_PRICES, active=quickPriceMode == PRICE_MODE_CUSTOM)
asiaOpenShowPrice = input.bool(false, "Asia Open", inline="quick_prices", group=GROUP_QUICK_FILTER_PRICES, active=quickPriceMode == PRICE_MODE_CUSTOM)
ivbProjectionShowPrice = input.bool(false, "IVB Projections", inline="quick_prices", group=GROUP_QUICK_FILTER_PRICES, active=quickPriceMode == PRICE_MODE_CUSTOM, tooltip=TOOLTIP_CUSTOM_PRICES)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - Quick Filter: Asia and Rafael Focus
// ═══════════════════════════════════════════════════════════════════════════

focusDirection = input.string(FOCUS_DIRECTION_OFF, "Asia + Rafael Focus", options=[FOCUS_DIRECTION_OFF, FOCUS_DIRECTION_ABOVE, FOCUS_DIRECTION_AROUND, FOCUS_DIRECTION_BELOW], inline="focus_mode", group=GROUP_FOCUS, tooltip=TOOLTIP_FOCUS)
focusActive = focusDirection != FOCUS_DIRECTION_OFF
focusSessionCount = input.int(3, "Sessions", options=[1, 2, 3, 4, 5, 10, 15, 20], inline="focus_mode", group=GROUP_FOCUS, active=focusActive, tooltip=TOOLTIP_FOCUS_COUNT)
focusAnchorMode = input.string(FOCUS_ANCHOR_PRICE, "Anchor", options=[FOCUS_ANCHOR_PRICE, FOCUS_ANCHOR_MANUAL], inline="focus_anchor", group=GROUP_FOCUS, active=focusActive, tooltip=TOOLTIP_FOCUS_ANCHOR)
focusManualAnchorSelected = focusActive and focusAnchorMode == FOCUS_ANCHOR_MANUAL
focusManualPrice = input.price(0.0, "Price", inline="focus_anchor", group=GROUP_FOCUS, active=focusManualAnchorSelected)
focusAnchorColor = input.color(color.new(color.rgb(242, 54, 69), 0), LABEL_FOCUS_ANCHOR_COLOR, inline="focus_anchor_style", group=GROUP_FOCUS, active=focusManualAnchorSelected)
focusAnchorWidth = input.int(2, "", options=[1, 2, 3, 4, 5], inline="focus_anchor_style", group=GROUP_FOCUS, active=focusManualAnchorSelected)
focusAnchorLabelOffset = input.int(300, "Offset", minval=0, maxval=500, inline="focus_anchor_style", group=GROUP_FOCUS, active=focusManualAnchorSelected, tooltip="Shift the Manual anchor label this many bars into the right margin.")

// An unplaced manual anchor falls back to price so Focus still ranks.
focusManualPricePlaced = not na(focusManualPrice) and focusManualPrice > 0
focusAnchorPrice = focusAnchorMode == FOCUS_ANCHOR_MANUAL and focusManualPricePlaced ? focusManualPrice : close

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - Mitigation
// ═══════════════════════════════════════════════════════════════════════════

mitigationMode = input.string(SESSION_MITIGATED, "Mode", options=[SESSION_MITIGATED, SESSION_UNMITIGATED], group=GROUP_MITIGATION, tooltip="Mitigated: Show completed levels; Rafael and Asia Open also keep their untouched boundaries visible\nUnmitigated: Show persistent lines for untouched levels")
enableProvisionalRetracements = input.bool(true, "Enable Provisional Retracements", group=GROUP_MITIGATION, tooltip="Track Rafael and Asia Open 0.5 / 0.618 returns from the first provisional overnight mitigation.")
confirmedMitigationReplacementTrigger = input.string(REPLACEMENT_TRIGGER_618, "Confirmed mitigation replacement trigger", options=[REPLACEMENT_TRIGGER_618, REPLACEMENT_TRIGGER_50], group=GROUP_MITIGATION, active=enableProvisionalRetracements, tooltip="After confirmation, 0.618 replaces on the first inward 0.618 crossing. 0.5 waits for the midpoint.")

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - Labels
// ═══════════════════════════════════════════════════════════════════════════

showAllLabels = input.bool(true, "Show All Labels", inline="labels_master", group=GROUP_LABELS)
labelTextSize = input.string(LABEL_SIZE_TINY, "", options=[LABEL_SIZE_TINY, LABEL_SIZE_SMALL, LABEL_SIZE_NORMAL, LABEL_SIZE_LARGE, LABEL_SIZE_HUGE], inline="labels_master", group=GROUP_LABELS)
priceAndSizeQuickBoost = input.bool(false, "Price & Size Quick Boost", inline="labels_master", group=GROUP_LABELS, tooltip=TOOLTIP_LABEL_MASTER)
globalLabelSize = priceAndSizeQuickBoost ? size.small : labelTextSize == LABEL_SIZE_TINY ? size.tiny : labelTextSize == LABEL_SIZE_NORMAL ? size.normal : labelTextSize == LABEL_SIZE_LARGE ? size.large : labelTextSize == LABEL_SIZE_HUGE ? size.huge : size.small
showSessionNames = input.bool(false, LABEL_SHOW_SESSION_NAMES, group=GROUP_LABELS, tooltip=TOOLTIP_SHOW_SESSION_NAMES)
showPendingLabels = input.bool(true, "Label Provisional Lines", group=GROUP_LABELS, tooltip="Adds a right-edge session label to provisional (dashed) mitigation lines so you can identify which session each dashed line belongs to on a busy chart.")
