// ═══════════════════════════════════════════════════════════════════════════
// SESSION VARIABLES
// ═══════════════════════════════════════════════════════════════════════════

var array<SessionData> sessions = array.new<SessionData>()
var array<SessionData> activeSessions = array.new<SessionData>()

// Cached parsed deviation zones (unified - body = wick for all sessions)
var array<DeviationZone> cachedDeviations_intraday = na
var array<DeviationZone> cachedDeviations_0500_0915 = na
var array<DeviationZone> cachedDeviations_0600_0900 = na
var array<DeviationZone> cachedDeviations_0930_0945 = na
var array<DeviationZone> cachedDeviations_0930_1000 = na
var array<DeviationZone> cachedDeviations_0930_093030 = na
var array<DeviationZone> cachedDeviations_1600_0500 = na
var array<DeviationZone> cachedDeviations_1800_2100 = na
var array<DeviationZone> cachedDeviations_0500_0745 = na

// Deviation Glow: Global tracking using string keys (avoids UDT array complexity)
var map<string, int> glowTouchTimes = map.new<string, int>()      // boxKey -> touch timestamp
var map<string, color> glowOriginalColors = map.new<string, color>()  // boxKey -> original color

// Constants for performance
BODY_SUFFIX = "B"
WICK_SUFFIX = "W"
ZONE_OFFSET_BARS = 1  // Width of offset zones in bars
ZONE_OFFSET_START = 0  // How many bars into the range before zones start (0 = at range end, 2 = 2 bars before range end)
DEVIATION_LINE_OPACITY = 60
BAR_MS = int(timeframe.in_seconds() * 1000)

// ═══════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════

// Parsing helpers
parseTimeToMinutes(string timeStr) =>
    hour = str.tonumber(str.substring(timeStr, 0, 2))
    minute = str.tonumber(str.substring(timeStr, 3, 5))
    int(hour * 60 + minute)

toSansSerif(string inputStr) =>
    result = inputStr
    result := str.replace_all(result, "0", "𝟢")
    result := str.replace_all(result, "1", "𝟣")
    result := str.replace_all(result, "2", "𝟤")
    result := str.replace_all(result, "3", "𝟥")
    result := str.replace_all(result, "4", "𝟦")
    result := str.replace_all(result, "5", "𝟧")
    result := str.replace_all(result, "6", "𝟨")
    result := str.replace_all(result, "7", "𝟩")
    result := str.replace_all(result, "8", "𝟪")
    result := str.replace_all(result, "9", "𝟫")
    result

// Darken a color by reducing its transparency (making it more opaque/visible)
// darkenPercent: 0-100, where higher = more darkening (more opaque)
darkenColor(color c, float darkenPercent) =>
    originalTransparency = color.t(c)
    // Reduce transparency by the darken percentage (makes color more visible/darker)
    newTransparency = originalTransparency * (1 - darkenPercent / 100)
    color.new(c, newTransparency)

// Generate unique key for a deviation box (for glow tracking)
// Uses session index + start time + box index to create a unique identifier
getGlowBoxKey(int sessionIndex, int sessionStartTime, int boxIndex) =>
    str.tostring(sessionIndex) + "_" + str.tostring(sessionStartTime) + "_" + str.tostring(boxIndex)

// Reset a deviation box's glow state: restore original color and clean up maps
resetGlowBox(box devBox, string boxKey) =>
    if map.contains(glowOriginalColors, boxKey)
        box.set_bgcolor(devBox, map.get(glowOriginalColors, boxKey))
        map.remove(glowOriginalColors, boxKey)
    if map.contains(glowTouchTimes, boxKey)
        map.remove(glowTouchTimes, boxKey)

// Convert a bar offset to a time offset (used for xloc.bar_time drawing)
timeWithOffset(int baseTime, int barOffset) =>
    baseTime + barOffset * BAR_MS

// Parse deviation string into ordered array of DeviationZone entries
// Example: "1, 2:2.5, 4:4.5" → [{1,1,false}, {2,2.5,true}, {4,4.5,true}]
parseDeviationZones(string deviationStr) =>
    zones = array.new<DeviationZone>()
    tokens = str.split(deviationStr, ",")
    for token in tokens
        trimmed = str.replace_all(token, " ", "")
        if trimmed != ""
            if str.contains(trimmed, ":")
                // Range like "2:2.5"
                parts = str.split(trimmed, ":")
                if array.size(parts) == 2
                    innerVal = str.tonumber(array.get(parts, 0))
                    outerVal = str.tonumber(array.get(parts, 1))
                    zones.push(DeviationZone.new(innerVal, outerVal, true))
            else
                // Single level like "1"
                level = str.tonumber(trimmed)
                zones.push(DeviationZone.new(level, level, false))
    zones

// Helper to get bias label text for a session (returns empty string if no bias should be shown)
getBiasLabelText(SessionData sess, BiasData biasData, bool show1600Bias) =>
    string result = ""
    if array.includes(BIAS_DISPLAY_SESSIONS, sess.sessionIndex) and show1600Bias and not na(biasData.bias)
        sessionDate = dayofmonth(sess.startTime, NY_TIMEZONE)
        if sessionDate != biasData.biasDate
            if biasData.bias == BIAS_ABOVE
                result := BIAS_LABEL_ABOVE
            else if biasData.bias == BIAS_BELOW
                result := BIAS_LABEL_BELOW
            else
                // INSIDE: determine directional hint based on session position relative to Evaluation Day's Premarket range
                sessionAboveRange = sess.wickLow > biasData.evalRangeHigh
                sessionBelowRange = sess.wickHigh < biasData.evalRangeLow
                result := sessionAboveRange ? BIAS_LABEL_INSIDE_BELOW : sessionBelowRange ? BIAS_LABEL_INSIDE_ABOVE : BIAS_LABEL_INSIDE
    result

// Drawing helper - unified function for all deviation zones (singles and ranges)
drawDeviations(SessionData sess, float high, float low, float height, array<DeviationZone> zones, color deviationColor, color lineColor, bool showLabels, string labelPosition, color labelColor, string suffix, int startBarOffset, int endBarOffset, bool drawAbove, bool drawBelow) =>
    if array.size(zones) > 0 and (drawAbove or drawBelow)
        // Pre-compute label positioning (shared across all labels)
        baseLabelTime = labelPosition == "Left" ? sess.startTime : sess.endTime
        labelOffset = labelPosition == "Left" ? startBarOffset : endBarOffset
        labelX = timeWithOffset(baseLabelTime, labelOffset)
        labelStyle = labelPosition == "Left" ? label.style_label_right : label.style_label_left

        for zone in zones
            if zone.isRange
                // Draw range as box with labels at both edges
                if drawAbove
                    aboveFrom = high + (height * zone.innerLevel)
                    aboveTo = high + (height * zone.outerLevel)
                    sess.deviationBoxes.push(box.new(timeWithOffset(sess.startTime, startBarOffset), aboveFrom, timeWithOffset(sess.endTime, endBarOffset), aboveTo, bgcolor=deviationColor, border_color=na, xloc=xloc.bar_time))
                    if showLabels
                        sess.labels.push(label.new(labelX, aboveFrom, toSansSerif("+" + str.tostring(zone.innerLevel) + suffix), style=labelStyle, color=labelsBgColor, textcolor=labelColor, size=size.tiny, xloc=xloc.bar_time))
                        sess.labels.push(label.new(labelX, aboveTo, toSansSerif("+" + str.tostring(zone.outerLevel) + suffix), style=labelStyle, color=labelsBgColor, textcolor=labelColor, size=size.tiny, xloc=xloc.bar_time))

                if drawBelow
                    belowFrom = low - (height * zone.innerLevel)
                    belowTo = low - (height * zone.outerLevel)
                    sess.deviationBoxes.push(box.new(timeWithOffset(sess.startTime, startBarOffset), belowFrom, timeWithOffset(sess.endTime, endBarOffset), belowTo, bgcolor=deviationColor, border_color=na, xloc=xloc.bar_time))
                    if showLabels
                        sess.labels.push(label.new(labelX, belowFrom, toSansSerif("-" + str.tostring(zone.innerLevel) + suffix), style=labelStyle, color=labelsBgColor, textcolor=labelColor, size=size.tiny, xloc=xloc.bar_time))
                        sess.labels.push(label.new(labelX, belowTo, toSansSerif("-" + str.tostring(zone.outerLevel) + suffix), style=labelStyle, color=labelsBgColor, textcolor=labelColor, size=size.tiny, xloc=xloc.bar_time))
            else
                // Draw single level as line + label
                dev = zone.outerLevel

                if drawAbove
                    aboveLevel = high + (height * dev)
                    sess.lines.push(line.new(timeWithOffset(sess.startTime, startBarOffset), aboveLevel, timeWithOffset(sess.endTime, endBarOffset), aboveLevel, color=lineColor, style=line.style_dotted, width=1, xloc=xloc.bar_time))
                    if showLabels
                        sess.labels.push(label.new(labelX, aboveLevel, toSansSerif("+" + str.tostring(dev) + suffix), style=labelStyle, color=labelsBgColor, textcolor=labelColor, size=size.tiny, xloc=xloc.bar_time))

                if drawBelow
                    belowLevel = low - (height * dev)
                    sess.lines.push(line.new(timeWithOffset(sess.startTime, startBarOffset), belowLevel, timeWithOffset(sess.endTime, endBarOffset), belowLevel, color=lineColor, style=line.style_dotted, width=1, xloc=xloc.bar_time))
                    if showLabels
                        sess.labels.push(label.new(labelX, belowLevel, toSansSerif("-" + str.tostring(dev) + suffix), style=labelStyle, color=labelsBgColor, textcolor=labelColor, size=size.tiny, xloc=xloc.bar_time))

drawCoreBox(SessionData sess, float highPrice, float lowPrice) =>
    coreBox = box.new(sess.startTime, highPrice, sess.endTime, lowPrice, bgcolor=sess.coreColor, border_color=na, xloc=xloc.bar_time)
    topLine = line.new(sess.startTime, highPrice, sess.endTime, highPrice, color=color.new(color.gray, 50), style=line.style_dotted, width=1, xloc=xloc.bar_time)
    bottomLine = line.new(sess.startTime, lowPrice, sess.endTime, lowPrice, color=color.new(color.gray, 50), style=line.style_dotted, width=1, xloc=xloc.bar_time)
    sess.lines.push(topLine)
    sess.lines.push(bottomLine)
    coreBox

calculateOffsets(SessionData sess, bool isBody) =>
    useOffset = sess.useOffset and sess.deviationMode == OPT_BOTH
    int startOffset = 0
    int endOffset = 0

    if useOffset
        rangeWidth = sess.endBar - sess.startBar
        if isBody
            startOffset := rangeWidth - ZONE_OFFSET_START
            endOffset := rangeWidth - ZONE_OFFSET_START + ZONE_OFFSET_BARS
        else
            startOffset := -(rangeWidth - ZONE_OFFSET_START + ZONE_OFFSET_BARS)
            endOffset := -(rangeWidth - ZONE_OFFSET_START)

    [startOffset, endOffset]

// Get cached deviation zones (avoids re-parsing strings on every bar)
getCachedZones(string sessionName) =>
    if sessionName == SESSION_EXTENDED_1600_0500
        cachedDeviations_1600_0500
    else if sessionName == SESSION_EXTENDED_0500_0915
        cachedDeviations_0500_0915
    else if sessionName == SESSION_EXTENDED_0600_0900
        cachedDeviations_0600_0900
    else if sessionName == SESSION_EXTENDED_0930_0945
        cachedDeviations_0930_0945
    else if sessionName == SESSION_EXTENDED_0930_1000
        cachedDeviations_0930_1000
    else if sessionName == SESSION_EXTENDED_0930_093030
        cachedDeviations_0930_093030
    else if sessionName == SESSION_EXTENDED_1800_2100
        cachedDeviations_1800_2100
    else if sessionName == SESSION_EXTENDED_0500_0745
        cachedDeviations_0500_0745
    else
        cachedDeviations_intraday

drawCoreWithDeviations(SessionData sess, float highPrice, float lowPrice, float height, bool isBody) =>
    [startOffset, endOffset] = calculateOffsets(sess, isBody)
    // Position labels: when both deviations shown, body goes right and wick goes left
    labelPos = sess.deviationMode == OPT_BOTH ? (isBody ? "Right" : "Left") : "Left"
    suffix = isBody ? BODY_SUFFIX : WICK_SUFFIX
    zones = getCachedZones(sess.sessionName)

    // Determine whether to show labels based on dropdown value and body/wick type
    showLbls = sess.deviationLabelsMode == OPT_BOTH or (sess.deviationLabelsMode == OPT_BODY and isBody) or (sess.deviationLabelsMode == OPT_WICK and not isBody)

    // Draw all deviation zones (turning point zones get special color)
    drawDeviations(sess, highPrice, lowPrice, height, zones, sess.deviationColor, color.new(labelColor, DEVIATION_LINE_OPACITY), showLbls, labelPos, labelColor, suffix, startOffset, endOffset, true, true)

deleteSession(SessionData sess) =>
    if not na(sess.bodyBox)
        box.delete(sess.bodyBox)
    if not na(sess.wickBox)
        box.delete(sess.wickBox)
    for l in sess.lines
        line.delete(l)
    for lbl in sess.labels
        label.delete(lbl)
    for db in sess.deviationBoxes
        box.delete(db)
    // Delete mitigation lines
    if not na(sess.highMitigationLine)
        line.delete(sess.highMitigationLine)
    if not na(sess.lowMitigationLine)
        line.delete(sess.lowMitigationLine)
    if not na(sess.midMitigationLine)
        line.delete(sess.midMitigationLine)
    // Delete pending mitigation lines
    if not na(sess.highPendingLine)
        line.delete(sess.highPendingLine)
    if not na(sess.lowPendingLine)
        line.delete(sess.lowPendingLine)
    // Delete proximity lines
    if not na(sess.highProximityLine)
        line.delete(sess.highProximityLine)
    if not na(sess.lowProximityLine)
        line.delete(sess.lowProximityLine)

// Clear live drawings from active session (keeps session data, just removes visuals for redraw)
clearLiveDrawings(SessionData sess) =>
    if not na(sess.bodyBox)
        box.delete(sess.bodyBox)
        sess.bodyBox := na
    if not na(sess.wickBox)
        box.delete(sess.wickBox)
        sess.wickBox := na
    for l in sess.lines
        line.delete(l)
    array.clear(sess.lines)
    for lbl in sess.labels
        label.delete(lbl)
    array.clear(sess.labels)
    for db in sess.deviationBoxes
        box.delete(db)
    array.clear(sess.deviationBoxes)

// Draw live deviations for active session (uses projected end time)
drawLiveSessionDeviations(SessionData sess, int projectedEndTime, int currentBarIndex, BiasData biasData) =>
    // Set temporary end values for drawing
    sess.endTime := projectedEndTime
    sess.endBar := currentBarIndex

    // Calculate heights
    bodyHeight = sess.bodyHigh - sess.bodyLow
    wickHeight = sess.wickHigh - sess.wickLow

    // Always draw body box (except 30s Opening which is wick-only)
    if sess.sessionIndex != THIRTYSECOPENING_SESSION_IDX
        sess.bodyBox := drawCoreBox(sess, sess.bodyHigh, sess.bodyLow)

    // Always draw wick box
    sess.wickBox := drawCoreBox(sess, sess.wickHigh, sess.wickLow)

    // Draw body deviations if mode is Body or Both (except 30s Opening)
    if (sess.deviationMode == OPT_BODY or sess.deviationMode == OPT_BOTH) and sess.sessionIndex != THIRTYSECOPENING_SESSION_IDX
        drawCoreWithDeviations(sess, sess.bodyHigh, sess.bodyLow, bodyHeight, true)

    // Draw wick deviations if mode is Wick or Both
    if sess.deviationMode == OPT_WICK or sess.deviationMode == OPT_BOTH
        drawCoreWithDeviations(sess, sess.wickHigh, sess.wickLow, wickHeight, false)

    // Draw live session name label with bias (if applicable)
    if showLabels
        labelX = int(math.round((sess.startTime + sess.endTime) / 2))
        labelY = sess.labelPosition == OPT_ABOVE ? sess.wickHigh : sess.wickLow
        labelStyle = sess.labelPosition == OPT_ABOVE ? label.style_label_down : label.style_label_up

        labelText = sess.chartLabel
        biasText = getBiasLabelText(sess, biasData, show1600Bias)
        if biasText != ""
            labelText := labelText + "\n" + biasText

        liveLabel = label.new(labelX, labelY, labelText, style=labelStyle, textcolor=labelColor, size=size.tiny, color=labelsBgColor, textalign=text.align_center, xloc=xloc.bar_time)
        sess.labels.push(liveLabel)

// ═══════════════════════════════════════════════════════════════════════════
// INITIALIZATION
// ═══════════════════════════════════════════════════════════════════════════

if na(cachedDeviations_intraday)
    cachedDeviations_intraday := parseDeviationZones(deviations_intraday)
    cachedDeviations_0500_0915 := parseDeviationZones(deviations_0500_0915)
    cachedDeviations_0600_0900 := parseDeviationZones(deviations_0600_0900)
    cachedDeviations_0930_0945 := parseDeviationZones(deviations_0930_0945)
    cachedDeviations_0930_1000 := parseDeviationZones(deviations_0930_1000)
    cachedDeviations_0930_093030 := parseDeviationZones(deviations_0930_093030)
    cachedDeviations_1600_0500 := parseDeviationZones(deviations_1600_0500)
    cachedDeviations_1800_2100 := parseDeviationZones(deviations_1800_2100)
    cachedDeviations_0500_0745 := parseDeviationZones(deviations_0500_0745)

// ═══════════════════════════════════════════════════════════════════════════
// QUICK FILTER LOGIC
// ═══════════════════════════════════════════════════════════════════════════

// Session indices: 0=20:15, 1=22:00, 2=02:15, 3=09:15, 4=12:30, 5=14:15, 6=NY Early Hours, 7=Overnight, 8=Premarket, 9=NY Open 15m, 10=NY Open 30m, 11=Asia Open, 12=Mini ONS, 13=30s Opening
isInFilter(int idx) =>
    if quickFilter == FILTER_ALL
        true
    else if quickFilter == FILTER_1800
        idx == 11
    else if quickFilter == FILTER_DAILY_1800
        idx == 1 or idx == 11
    else if quickFilter == FILTER_DAILY_1800_EARLY
        idx == 1 or idx == 6 or idx == 11
    else if quickFilter == FILTER_DAILY_1800_MINI_EARLY
        idx == 1 or idx == 6 or idx == 11 or idx == 12
    else if quickFilter == FILTER_DAILY_1800_FULL_NYAM
        idx == 1 or idx == 3 or idx == 6 or idx == 9 or idx == 10 or idx == 11 or idx == 12 or idx == 13
    else if quickFilter == FILTER_OVERNIGHT_NY_EARLY
        idx == 6 or idx == 7
    else if quickFilter == FILTER_OVERNIGHT_MINI_EARLY
        idx == 6 or idx == 7 or idx == 12
    else if quickFilter == FILTER_OVERNIGHT_POST_LATE_NY
        idx == 7 or idx == 10
    else if quickFilter == FILTER_OVERNIGHT_PREMARKET
        idx == 7 or idx == 8
    else if quickFilter == FILTER_CLEAR_BIAS
        idx == 6 or idx == 7 or idx == 8 or idx == 12
    else if quickFilter == FILTER_DAILY_MINI_EARLY
        idx == 1 or idx == 6 or idx == 12
    else if quickFilter == FILTER_DAILY_915
        idx == 1 or idx == 3
    else if quickFilter == FILTER_FULL_NYAM
        idx == 3 or idx == 6 or idx == 9 or idx == 10 or idx == 12 or idx == 13
    else if quickFilter == FILTER_PRE_LATE_NY
        idx == 9
    else if quickFilter == FILTER_LATE_NY
        idx == 9 or idx == 10
    else if quickFilter == FILTER_POST_LATE_NY
        idx == 10
    else if quickFilter == FILTER_30S_ONLY
        idx == 13
    else
        true

// ═══════════════════════════════════════════════════════════════════════════
// SESSION CONFIGURATION
// ═══════════════════════════════════════════════════════════════════════════

var array<string> openingSessions_mode = array.from(opening_2000_2015, opening_2100_2200, opening_0200_0215, opening_0900_0915, opening_1200_1230, opening_1400_1415, opening_0600_0900, opening_1600_0500, opening_0500_0915, opening_0930_0945, opening_0930_1000, opening_1800_2100, opening_0500_0745, opening_0930_093030)
var array<bool> openingSessions_offset = array.from(opening_2000_2015_offset, opening_2100_2200_offset, opening_0200_0215_offset, opening_0900_0915_offset, opening_1200_1230_offset, opening_1400_1415_offset, opening_0600_0900_offset, opening_1600_0500_offset, opening_0500_0915_offset, opening_0930_0945_offset, opening_0930_1000_offset, opening_1800_2100_offset, opening_0500_0745_offset, opening_0930_093030_offset)
var array<string> openingSessions_showLabels = array.from(opening_2000_2015_showLabels, opening_2100_2200_showLabels, opening_0200_0215_showLabels, opening_0900_0915_showLabels, opening_1200_1230_showLabels, opening_1400_1415_showLabels, opening_0600_0900_showLabels, opening_1600_0500_showLabels, opening_0500_0915_showLabels, opening_0930_0945_showLabels, opening_0930_1000_showLabels, opening_1800_2100_showLabels, opening_0500_0745_showLabels, opening_0930_093030_showLabels)
var array<int> openingSessions_startMin = array.from(1200, 1260, 120, 540, 720, 840, 360, 960, 300, 570, 570, 1080, 300, 570)
var array<int> openingSessions_endMin = array.from(1215, 1320, 135, 555, 750, 855, 540, 300, 555, 585, 600, 1260, 465, 570)
var array<color> openingSessions_coreColor = array.from(opening_2000_2015_coreColor, opening_2100_2200_coreColor, opening_0200_0215_coreColor, opening_0900_0915_coreColor, opening_1200_1230_coreColor, opening_1400_1415_coreColor, opening_0600_0900_coreColor, opening_1600_0500_coreColor, opening_0500_0915_coreColor, opening_0930_0945_coreColor, opening_0930_1000_coreColor, opening_1800_2100_coreColor, opening_0500_0745_coreColor, opening_0930_093030_coreColor)
var array<color> openingSessions_deviationColor = array.from(opening_2000_2015_deviationColor, opening_2100_2200_deviationColor, opening_0200_0215_deviationColor, opening_0900_0915_deviationColor, opening_1200_1230_deviationColor, opening_1400_1415_deviationColor, opening_0600_0900_deviationColor, opening_1600_0500_deviationColor, opening_0500_0915_deviationColor, opening_0930_0945_deviationColor, opening_0930_1000_deviationColor, opening_1800_2100_deviationColor, opening_0500_0745_deviationColor, opening_0930_093030_deviationColor)
var array<string> openingSessions_name = array.from(SESSION_INTRADAY_2015, SESSION_INTRADAY_2200, SESSION_INTRADAY_0215, SESSION_INTRADAY_0915, SESSION_INTRADAY_1230, SESSION_INTRADAY_1415, SESSION_EXTENDED_0600_0900, SESSION_EXTENDED_1600_0500, SESSION_EXTENDED_0500_0915, SESSION_EXTENDED_0930_0945, SESSION_EXTENDED_0930_1000, SESSION_EXTENDED_1800_2100, SESSION_EXTENDED_0500_0745, SESSION_EXTENDED_0930_093030)
var array<string> openingSessions_chartLabel = array.from(CHART_LABEL_2015, CHART_LABEL_2200, CHART_LABEL_0215, CHART_LABEL_0915, CHART_LABEL_1230, CHART_LABEL_1415, CHART_LABEL_0600_0900, CHART_LABEL_1600_0500, CHART_LABEL_0500_0915, CHART_LABEL_0930_0945, CHART_LABEL_0930_1000, CHART_LABEL_1800_2100, CHART_LABEL_0500_0745, CHART_LABEL_0930_093030)
var array<string> openingSessions_labelPosition = array.from(opening_2000_2015_labelPosition, opening_2100_2200_labelPosition, opening_0200_0215_labelPosition, opening_0900_0915_labelPosition, opening_1200_1230_labelPosition, opening_1400_1415_labelPosition, opening_0600_0900_labelPosition, opening_1600_0500_labelPosition, opening_0500_0915_labelPosition, opening_0930_0945_labelPosition, opening_0930_1000_labelPosition, opening_1800_2100_labelPosition, opening_0500_0745_labelPosition, opening_0930_093030_labelPosition)
var array<bool> openingSessions_mitigation = array.from(opening_2000_2015_mitigation, opening_2100_2200_mitigation, opening_0200_0215_mitigation, opening_0900_0915_mitigation, opening_1200_1230_mitigation, opening_1400_1415_mitigation, opening_0600_0900_mitigation, opening_1600_0500_mitigation, opening_0500_0915_mitigation, opening_0930_0945_mitigation, opening_0930_1000_mitigation, opening_1800_2100_mitigation, opening_0500_0745_mitigation, opening_0930_093030_mitigation)
var array<color> openingSessions_mitigationColor = array.from(opening_2000_2015_mitigationColor, opening_2100_2200_mitigationColor, opening_0200_0215_mitigationColor, opening_0900_0915_mitigationColor, opening_1200_1230_mitigationColor, opening_1400_1415_mitigationColor, opening_0600_0900_mitigationColor, opening_1600_0500_mitigationColor, opening_0500_0915_mitigationColor, opening_0930_0945_mitigationColor, opening_0930_1000_mitigationColor, opening_1800_2100_mitigationColor, opening_0500_0745_mitigationColor, opening_0930_093030_mitigationColor)
var array<bool> openingSessions_alert = array.from(opening_2000_2015_alert, opening_2100_2200_alert, opening_0200_0215_alert, opening_0900_0915_alert, opening_1200_1230_alert, opening_1400_1415_alert, opening_0600_0900_alert, opening_1600_0500_alert, opening_0500_0915_alert, opening_0930_0945_alert, opening_0930_1000_alert, opening_1800_2100_alert, opening_0500_0745_alert, opening_0930_093030_alert)
var array<bool> openingSessions_delayedMitigation = array.from(false, false, false, false, false, false, false, false, false, false, false, opening_1800_2100_delayedMitigation, false, false)

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 1: SESSION DETECTION - Detect new sessions starting
// ═══════════════════════════════════════════════════════════════════════════

barMinutes = validTimeframe ? hour(time, NY_TIMEZONE) * 60 + minute(time, NY_TIMEZONE) : 0
prevBarMinutes = validTimeframe ? hour(time[1], NY_TIMEZONE) * 60 + minute(time[1], NY_TIMEZONE) : 0
barSeconds = validTimeframe ? second(time, NY_TIMEZONE) : 0
prevBarSeconds = validTimeframe ? second(time[1], NY_TIMEZONE) : 0
currentDayStart = timestamp(NY_TIMEZONE, year(time, NY_TIMEZONE), month(time, NY_TIMEZONE), dayofmonth(time, NY_TIMEZONE), 0, 0)

// ═══════════════════════════════════════════════════════════════════════════
// 30S OPENING DATA - Fetch actual 30-second candle data
// ═══════════════════════════════════════════════════════════════════════════

// Store the 09:30:00 30S candle data
var float stored30sHigh = na
var float stored30sLow = na
var float stored30sOpen = na
var float stored30sClose = na
var int stored30sDate = na

isOn30sTimeframe = timeframe.period == "30S"
current30sDetectionDate = dayofmonth(time, NY_TIMEZONE)
needToCapture30sData = na(stored30sDate) or stored30sDate != current30sDetectionDate

// Fetch all 30S candles within each higher timeframe bar (only when needed)
// Note: request.security_lower_tf must be called unconditionally, but we skip processing if not needed
ltfHighs = request.security_lower_tf(syminfo.tickerid, "30S", high)
ltfLows = request.security_lower_tf(syminfo.tickerid, "30S", low)
ltfOpens = request.security_lower_tf(syminfo.tickerid, "30S", open)
ltfCloses = request.security_lower_tf(syminfo.tickerid, "30S", close)
ltfTimes = request.security_lower_tf(syminfo.tickerid, "30S", time)

// Capture 30S candle data (only if we don't have today's data yet)
if needToCapture30sData
    if isOn30sTimeframe
        // On 30S timeframe: use current bar directly when at 09:30:00
        if barMinutes == 570 and barSeconds == 0
            stored30sHigh := high
            stored30sLow := low
            stored30sOpen := open
            stored30sClose := close
            stored30sDate := current30sDetectionDate
    else
        // On higher timeframes: search through all 30S candles in this bar
        if array.size(ltfTimes) > 0
            for i = 0 to array.size(ltfTimes) - 1
                ltfTime = array.get(ltfTimes, i)
                ltfMinutes = hour(ltfTime, NY_TIMEZONE) * 60 + minute(ltfTime, NY_TIMEZONE)
                ltfSeconds = second(ltfTime, NY_TIMEZONE)
                // Found the 09:30:00 30S candle
                if ltfMinutes == 570 and ltfSeconds == 0
                    stored30sHigh := array.get(ltfHighs, i)
                    stored30sLow := array.get(ltfLows, i)
                    stored30sOpen := array.get(ltfOpens, i)
                    stored30sClose := array.get(ltfCloses, i)
                    stored30sDate := current30sDetectionDate
                    break

// ═══════════════════════════════════════════════════════════════════════════
// 1600 BIAS DETECTION - Track Premarket range and classify at 16:00
// ═══════════════════════════════════════════════════════════════════════════

// Time windows for 1600 Bias
PREMARKET_START_MIN = array.get(openingSessions_startMin, PREMARKET_SESSION_IDX)  // 300 = 05:00
PREMARKET_END_MIN = array.get(openingSessions_endMin, PREMARKET_SESSION_IDX)      // 555 = 09:15
CLOSE_1600_MIN = 960  // 16:00 = 16 * 60

// Bias state
var BiasData biasData = BiasData.new()
if validTimeframe and show1600Bias
    currentDate = dayofmonth(time, NY_TIMEZONE)

    inPremarketWindow = barMinutes >= PREMARKET_START_MIN and barMinutes <= PREMARKET_END_MIN
    is1600Bar = barMinutes == CLOSE_1600_MIN and prevBarMinutes != CLOSE_1600_MIN

    // Reset Premarket tracking at start of new day's Premarket
    if inPremarketWindow and (na(biasData.premarketDate) or currentDate != biasData.premarketDate)
        biasData.premarketHigh := high
        biasData.premarketLow := low
        biasData.premarketDate := currentDate

    // Update Premarket high/low during Premarket window
    if inPremarketWindow and currentDate == biasData.premarketDate
        biasData.premarketHigh := math.max(biasData.premarketHigh, high)
        biasData.premarketLow := math.min(biasData.premarketLow, low)

    // At 16:00, classify bias based on where close is relative to today's Premarket range
    if is1600Bar and not na(biasData.premarketHigh) and not na(biasData.premarketLow)
        biasData.close1600 := close

        // Store Evaluation Day's Premarket range for label comparison on Trading Day
        biasData.evalRangeHigh := biasData.premarketHigh
        biasData.evalRangeLow := biasData.premarketLow

        // Determine bias
        if close > biasData.premarketHigh
            biasData.bias := BIAS_ABOVE
        else if close < biasData.premarketLow
            biasData.bias := BIAS_BELOW
        else
            biasData.bias := BIAS_INSIDE

        // Set the date this bias was calculated (Evaluation Day)
        biasData.biasDate := currentDate

if validTimeframe
    for i = 0 to array.size(openingSessions_mode) - 1
        mode = array.get(openingSessions_mode, i)

        if mode != OPT_OFF and isInFilter(i)
            startMin = array.get(openingSessions_startMin, i)
            endMin = array.get(openingSessions_endMin, i)

            // Handle midnight-crossing sessions (e.g., 16:00-05:00)
            crossesMidnight = endMin < startMin

            // Check if we're entering this session
            // Special handling for 30s Opening (index 13) - uses second-level precision
            currentlyInSession = i == THIRTYSECOPENING_SESSION_IDX ? (barMinutes == 570 and barSeconds < 30) : (crossesMidnight ? (barMinutes >= startMin or barMinutes <= endMin) : (barMinutes >= startMin and barMinutes <= endMin))
            previouslyInSession = i == THIRTYSECOPENING_SESSION_IDX ? (prevBarMinutes == 570 and prevBarSeconds < 30) : (crossesMidnight ? (prevBarMinutes >= startMin or prevBarMinutes <= endMin) : (prevBarMinutes >= startMin and prevBarMinutes <= endMin))
            sessionStarted = currentlyInSession and not previouslyInSession

            if sessionStarted
                // Skip 30s Opening if accurate 30S data is not available (historical limitation)
                if i == THIRTYSECOPENING_SESSION_IDX and na(stored30sHigh)
                    continue

                // Create new session and add to active sessions
                coreColor = array.get(openingSessions_coreColor, i)
                deviationColor = array.get(openingSessions_deviationColor, i)
                sessionName = array.get(openingSessions_name, i)
                chartLabel = array.get(openingSessions_chartLabel, i)
                useOffset = array.get(openingSessions_offset, i)
                showDeviationLabels = array.get(openingSessions_showLabels, i)
                labelPosition = array.get(openingSessions_labelPosition, i)
                showMitigation = array.get(openingSessions_mitigation, i)
                mitigationColor = array.get(openingSessions_mitigationColor, i)
                enableAlert = array.get(openingSessions_alert, i)
                delayedMitigation = array.get(openingSessions_delayedMitigation, i)

                // For 30s Opening, use stored 30S candle data; otherwise use current bar
                initBodyHigh = i == THIRTYSECOPENING_SESSION_IDX and not na(stored30sOpen) ? math.max(stored30sOpen, stored30sClose) : math.max(open, close)
                initBodyLow = i == THIRTYSECOPENING_SESSION_IDX and not na(stored30sOpen) ? math.min(stored30sOpen, stored30sClose) : math.min(open, close)
                initWickHigh = i == THIRTYSECOPENING_SESSION_IDX and not na(stored30sHigh) ? stored30sHigh : high
                initWickLow = i == THIRTYSECOPENING_SESSION_IDX and not na(stored30sLow) ? stored30sLow : low

                newSession = SessionData.new(
                     sessionIndex=i,
                     startBar=bar_index,
                     endBar=na,
                     startTime=time,
                     endTime=na,
                     actualEndTime=na,
                     bodyHigh=initBodyHigh,
                     bodyLow=initBodyLow,
                     wickHigh=initWickHigh,
                     wickLow=initWickLow,
                     bodyHeight=na,
                     wickHeight=na,
                     bodyBox=na,
                     wickBox=na,
                     lines=array.new<line>(),
                     labels=array.new<label>(),
                     deviationBoxes=array.new<box>(),
                     coreColor=coreColor,
                     deviationColor=deviationColor,
                     sessionName=sessionName,
                     chartLabel=chartLabel,
                     useOffset=useOffset,
                     deviationMode=mode,
                     deviationLabelsMode=showDeviationLabels,
                     labelPosition=labelPosition,
                     showMitigation=showMitigation,
                     mitigationColor=mitigationColor,
                     dominantHigh=na,
                     dominantLow=na,
                     highBar=bar_index,
                     lowBar=bar_index,
                     highTime=time,
                     lowTime=time,
                     highMitigated=false,
                     lowMitigated=false,
                     highMitigationBar=na,
                     lowMitigationBar=na,
                     highMitigationLine=na,
                     lowMitigationLine=na,
                     highUnmitigatedLine=na,
                     lowUnmitigatedLine=na,
                     highUnmitigatedLabel=na,
                     lowUnmitigatedLabel=na,
                     midLevel=na,
                     midMitigated=false,
                     midMitigationLine=na,
                     highProximityLine=na,
                     lowProximityLine=na,
                     enableAlert=enableAlert,
                     delayedMitigation=delayedMitigation,
                     provisionalHighMitigated=false,
                     provisionalLowMitigated=false,
                     provisionalHighTime=na,
                     provisionalLowTime=na,
                     highPendingLine=na,
                     lowPendingLine=na
                 )

                array.push(activeSessions, newSession)

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 2: SESSION TRACKING - Update all active sessions
// ═══════════════════════════════════════════════════════════════════════════

if validTimeframe and array.size(activeSessions) > 0
    for sess in activeSessions
        idx = sess.sessionIndex
        startMin = array.get(openingSessions_startMin, idx)
        endMin = array.get(openingSessions_endMin, idx)

        // Handle midnight-crossing sessions
        crossesMidnight = endMin < startMin

        // Check if current bar is within this session's time range
        // Special handling for 30s Opening (index 13) - uses second-level precision
        isBarInSession = idx == THIRTYSECOPENING_SESSION_IDX ? (barMinutes == 570 and barSeconds < 30) : (crossesMidnight ? (barMinutes >= startMin or barMinutes <= endMin) : (barMinutes >= startMin and barMinutes <= endMin))

        if isBarInSession
            // Skip updates for 30s Opening - data is complete from request.security()
            if idx != THIRTYSECOPENING_SESSION_IDX
                // Update session high/low values with current bar
                currentBodyHigh = math.max(open, close)
                currentBodyLow = math.min(open, close)

                // Track bar index when new highs/lows are formed
                if high > sess.wickHigh
                    sess.highBar := bar_index
                    sess.highTime := time
                if low < sess.wickLow
                    sess.lowBar := bar_index
                    sess.lowTime := time

                sess.bodyHigh := math.max(sess.bodyHigh, currentBodyHigh)
                sess.bodyLow := math.min(sess.bodyLow, currentBodyLow)
                sess.wickHigh := math.max(sess.wickHigh, high)
                sess.wickLow := math.min(sess.wickLow, low)

                // Live deviation drawing - clear and redraw each bar
                clearLiveDrawings(sess)
                // Calculate projected end time based on session's end minute
                projectedEndTime = crossesMidnight and barMinutes >= startMin ? currentDayStart + 24 * 60 * 60 * 1000 + endMin * 60 * 1000 : currentDayStart + endMin * 60 * 1000
                drawLiveSessionDeviations(sess, projectedEndTime, bar_index, biasData)

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 3: SESSION FINALIZATION - Finalize and remove ended sessions
// ═══════════════════════════════════════════════════════════════════════════

if validTimeframe and array.size(activeSessions) > 0
    for i = array.size(activeSessions) - 1 to 0
        sess = array.get(activeSessions, i)
        idx = sess.sessionIndex
        startMin = array.get(openingSessions_startMin, idx)
        endMin = array.get(openingSessions_endMin, idx)

        // Handle midnight-crossing sessions
        crossesMidnight = endMin < startMin

        // Detect session end transition
        // Special handling for 30s Opening (index 13) - uses second-level precision
        isCurrentBarInSession = idx == THIRTYSECOPENING_SESSION_IDX ? (barMinutes == 570 and barSeconds < 30) : (crossesMidnight ? (barMinutes >= startMin or barMinutes <= endMin) : (barMinutes >= startMin and barMinutes <= endMin))
        wasPreviousBarInSession = idx == THIRTYSECOPENING_SESSION_IDX ? (prevBarMinutes == 570 and prevBarSeconds < 30) : (crossesMidnight ? (prevBarMinutes >= startMin or prevBarMinutes <= endMin) : (prevBarMinutes >= startMin and prevBarMinutes <= endMin))
        hasSessionEnded = not isCurrentBarInSession and wasPreviousBarInSession

        if hasSessionEnded
            // Finalize session - calculate heights and draw visualizations
            sess.endBar := bar_index - 1
            // Store actual session end time (for mitigation lines)
            sess.actualEndTime := not na(time[1]) ? time[1] : time
            // For 30s Opening, extend visualization until 16:00 (RTH close)
            if idx == THIRTYSECOPENING_SESSION_IDX
                sess.endTime := currentDayStart + CLOSE_1600_MIN * 60 * 1000
            else
                sess.endTime := sess.actualEndTime

            // Clear live drawings before final draw
            clearLiveDrawings(sess)

            // Store heights for use in progressive unlock
            sess.bodyHeight := sess.bodyHigh - sess.bodyLow
            sess.wickHeight := sess.wickHigh - sess.wickLow
            bodyHeight = sess.bodyHeight
            wickHeight = sess.wickHeight

            // Calculate dominant high/low for mitigation tracking
            // Use wick extremes unless mode is Body-only
            if sess.deviationMode == OPT_BODY
                sess.dominantHigh := sess.bodyHigh
                sess.dominantLow := sess.bodyLow
            else
                sess.dominantHigh := sess.wickHigh
                sess.dominantLow := sess.wickLow

            // Calculate 50% level based on the larger range (both are always shown)
            if wickHeight >= bodyHeight
                sess.midLevel := (sess.wickHigh + sess.wickLow) / 2
            else
                sess.midLevel := (sess.bodyHigh + sess.bodyLow) / 2

            // Always draw body box (except 30s Opening which is wick-only)
            if idx != THIRTYSECOPENING_SESSION_IDX
                sess.bodyBox := drawCoreBox(sess, sess.bodyHigh, sess.bodyLow)

            // Always draw wick box
            sess.wickBox := drawCoreBox(sess, sess.wickHigh, sess.wickLow)

            // Draw body deviations if mode is Body or Both (except 30s Opening)
            if (sess.deviationMode == OPT_BODY or sess.deviationMode == OPT_BOTH) and idx != THIRTYSECOPENING_SESSION_IDX
                drawCoreWithDeviations(sess, sess.bodyHigh, sess.bodyLow, bodyHeight, true)

            // Draw wick deviations if mode is Wick or Both
            if sess.deviationMode == OPT_WICK or sess.deviationMode == OPT_BOTH
                drawCoreWithDeviations(sess, sess.wickHigh, sess.wickLow, wickHeight, false)

            // Draw session name label
            if showLabels
                labelX = int(math.round((sess.startTime + sess.endTime) / 2))
                labelY = sess.labelPosition == OPT_ABOVE ? sess.wickHigh : sess.wickLow
                labelStyle = sess.labelPosition == OPT_ABOVE ? label.style_label_down : label.style_label_up

                labelText = sess.chartLabel
                biasText = getBiasLabelText(sess, biasData, show1600Bias)
                if biasText != ""
                    labelText := labelText + "\n" + biasText

                sessionLabel = label.new(labelX, labelY, labelText, style=labelStyle, textcolor=labelColor, size=size.tiny, color=labelsBgColor, textalign=text.align_center, xloc=xloc.bar_time)
                sess.labels.push(sessionLabel)

            // Add to completed sessions
            sessions.push(sess)

            // Remove oldest session of this type if limit exceeded
            sessionsOfThisType = 0
            for s in sessions
                if s.sessionIndex == sess.sessionIndex
                    sessionsOfThisType += 1

            if sessionsOfThisType > maxSessions
                // Find and delete the oldest session of this type
                for j = 0 to array.size(sessions) - 1
                    oldSession = array.get(sessions, j)
                    if oldSession.sessionIndex == sess.sessionIndex
                        deleteSession(oldSession)
                        array.remove(sessions, j)
                        break

            // Remove from active sessions
            array.remove(activeSessions, i)

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 4: MITIGATION DETECTION - Check for breaches on completed sessions
// ═══════════════════════════════════════════════════════════════════════════

// Calculate ATR for proximity detection
atrValue = ta.atr(PROXIMITY_ATR_PERIOD)
atrRange = atrValue * PROXIMITY_ATR_MULTIPLIER

if validTimeframe and array.size(sessions) > 0
    for sess in sessions
        if sess.showMitigation and not na(sess.dominantHigh)
            // For delayed mitigation, only evaluate from 05:00 to 16:00 (excludes overnight evening hours)
            canEvaluateMitigation = not sess.delayedMitigation or (barMinutes >= PREMARKET_START_MIN and barMinutes < CLOSE_1600_MIN)
            isInOvernightWindow = sess.delayedMitigation and not canEvaluateMitigation

            // === HIGH MITIGATION LOGIC ===
            if not sess.highMitigated
                if canEvaluateMitigation and high >= sess.dominantHigh
                    // Mitigation confirmed (either normal or after provisional overnight breach)
                    sess.highMitigated := true
                    sess.highMitigationBar := bar_index
                    if mitigationMode == MIT_MITIGATED
                        if sess.provisionalHighMitigated
                            // Had overnight breach - extend dashed line to confirmation point, keep solid at breach
                            if not na(sess.highPendingLine)
                                line.set_x2(sess.highPendingLine, time)
                        else
                            // Normal mitigation (no overnight breach) - draw solid line
                            sess.highMitigationLine := line.new(sess.highTime, sess.dominantHigh, time, sess.dominantHigh, color=sess.mitigationColor, style=line.style_solid, width=MITIGATION_LINE_WIDTH, xloc=xloc.bar_time)
                    // Delete unmitigated line and label
                    if not na(sess.highUnmitigatedLine)
                        line.delete(sess.highUnmitigatedLine)
                        sess.highUnmitigatedLine := na
                    if not na(sess.highUnmitigatedLabel)
                        label.delete(sess.highUnmitigatedLabel)
                        sess.highUnmitigatedLabel := na
                    if sess.enableAlert
                        alertMsg = sess.sessionName + ALERT_HIGH_MITIGATED
                        alert(alertMsg, alert.freq_once_per_bar)

                else if isInOvernightWindow and high >= sess.dominantHigh
                    // Provisional breach during overnight - draw solid to breach, then dashed continuation
                    if not sess.provisionalHighMitigated
                        sess.provisionalHighMitigated := true
                        sess.provisionalHighTime := time
                        if mitigationMode == MIT_MITIGATED
                            // Solid line from origin to breach point
                            sess.highMitigationLine := line.new(sess.highTime, sess.dominantHigh, time, sess.dominantHigh, color=sess.mitigationColor, style=line.style_solid, width=MITIGATION_LINE_WIDTH, xloc=xloc.bar_time)
                            // Dashed pending line starts from breach point
                            sess.highPendingLine := line.new(time, sess.dominantHigh, time, sess.dominantHigh, color=sess.mitigationColor, style=line.style_dashed, width=MITIGATION_PENDING_LINE_WIDTH, xloc=xloc.bar_time)

                // Extend pending line during overnight (before 05:00 confirmation window)
                if sess.provisionalHighMitigated and not na(sess.highPendingLine) and not sess.highMitigated
                    line.set_x2(sess.highPendingLine, time)

            // === LOW MITIGATION LOGIC ===
            if not sess.lowMitigated
                if canEvaluateMitigation and low <= sess.dominantLow
                    // Mitigation confirmed (either normal or after provisional overnight breach)
                    sess.lowMitigated := true
                    sess.lowMitigationBar := bar_index
                    if mitigationMode == MIT_MITIGATED
                        if sess.provisionalLowMitigated
                            // Had overnight breach - extend dashed line to confirmation point, keep solid at breach
                            if not na(sess.lowPendingLine)
                                line.set_x2(sess.lowPendingLine, time)
                        else
                            // Normal mitigation (no overnight breach) - draw solid line
                            sess.lowMitigationLine := line.new(sess.lowTime, sess.dominantLow, time, sess.dominantLow, color=sess.mitigationColor, style=line.style_solid, width=MITIGATION_LINE_WIDTH, xloc=xloc.bar_time)
                    // Delete unmitigated line and label
                    if not na(sess.lowUnmitigatedLine)
                        line.delete(sess.lowUnmitigatedLine)
                        sess.lowUnmitigatedLine := na
                    if not na(sess.lowUnmitigatedLabel)
                        label.delete(sess.lowUnmitigatedLabel)
                        sess.lowUnmitigatedLabel := na
                    if sess.enableAlert
                        alertMsg = sess.sessionName + ALERT_LOW_MITIGATED
                        alert(alertMsg, alert.freq_once_per_bar)

                else if isInOvernightWindow and low <= sess.dominantLow
                    // Provisional breach during overnight - draw solid to breach, then dashed continuation
                    if not sess.provisionalLowMitigated
                        sess.provisionalLowMitigated := true
                        sess.provisionalLowTime := time
                        if mitigationMode == MIT_MITIGATED
                            // Solid line from origin to breach point
                            sess.lowMitigationLine := line.new(sess.lowTime, sess.dominantLow, time, sess.dominantLow, color=sess.mitigationColor, style=line.style_solid, width=MITIGATION_LINE_WIDTH, xloc=xloc.bar_time)
                            // Dashed pending line starts from breach point
                            sess.lowPendingLine := line.new(time, sess.dominantLow, time, sess.dominantLow, color=sess.mitigationColor, style=line.style_dashed, width=MITIGATION_PENDING_LINE_WIDTH, xloc=xloc.bar_time)

                // Extend pending line during overnight (before 05:00 confirmation window)
                if sess.provisionalLowMitigated and not na(sess.lowPendingLine) and not sess.lowMitigated
                    line.set_x2(sess.lowPendingLine, time)

            // Unmitigated mode: show persistent lines for unmitigated levels
            if mitigationMode == MIT_UNMITIGATED
                // High unmitigated line and label
                if not sess.highMitigated
                    if na(sess.highUnmitigatedLine)
                        sess.highUnmitigatedLine := line.new(sess.highTime, sess.dominantHigh, time, sess.dominantHigh, color=sess.mitigationColor, style=line.style_solid, width=MITIGATION_LINE_WIDTH, xloc=xloc.bar_time)
                        sess.highUnmitigatedLabel := label.new(time, sess.dominantHigh, sess.chartLabel, style=label.style_label_left, textcolor=labelColor, size=size.tiny, color=color.new(color.white, 100), xloc=xloc.bar_time)
                    else
                        line.set_x2(sess.highUnmitigatedLine, time)
                        label.set_x(sess.highUnmitigatedLabel, time)
                // Low unmitigated line and label
                if not sess.lowMitigated
                    if na(sess.lowUnmitigatedLine)
                        sess.lowUnmitigatedLine := line.new(sess.lowTime, sess.dominantLow, time, sess.dominantLow, color=sess.mitigationColor, style=line.style_solid, width=MITIGATION_LINE_WIDTH, xloc=xloc.bar_time)
                        sess.lowUnmitigatedLabel := label.new(time, sess.dominantLow, sess.chartLabel, style=label.style_label_left, textcolor=labelColor, size=size.tiny, color=color.new(color.white, 100), xloc=xloc.bar_time)
                    else
                        line.set_x2(sess.lowUnmitigatedLine, time)
                        label.set_x(sess.lowUnmitigatedLabel, time)

            // Check for 50% mitigation (only after an extreme has been mitigated, only in Mitigated mode)
            if mitigationMode == MIT_MITIGATED and (sess.highMitigated or sess.lowMitigated) and not sess.midMitigated and not na(sess.midLevel)
                if low <= sess.midLevel and high >= sess.midLevel
                    sess.midMitigated := true
                    sess.midMitigationLine := line.new(sess.actualEndTime, sess.midLevel, time, sess.midLevel, color=sess.mitigationColor, style=line.style_dotted, width=MITIGATION_50_LINE_WIDTH, xloc=xloc.bar_time)
                    if sess.enableAlert
                        alertMsg = close[1] > sess.midLevel ? sess.sessionName + ALERT_MID_MITIGATED_FROM_ABOVE : sess.sessionName + ALERT_MID_MITIGATED_FROM_BELOW
                        alert(alertMsg, alert.freq_once_per_bar)

            // Proximity detection for unmitigated levels
            if showProximity and not na(atrRange)
                // High proximity: show dashed line if unmitigated high is within ATR range AND price is approaching
                if not sess.highMitigated
                    highDistance = sess.dominantHigh - close
                    highDistancePrev = sess.dominantHigh - close[PROXIMITY_LOOKBACK]
                    isApproachingHigh = highDistance < highDistancePrev
                    if highDistance > 0 and highDistance <= atrRange and isApproachingHigh
                        if na(sess.highProximityLine)
                            sess.highProximityLine := line.new(sess.highTime, sess.dominantHigh, time, sess.dominantHigh, color=sess.mitigationColor, style=line.style_dashed, width=PROXIMITY_LINE_WIDTH, xloc=xloc.bar_time)
                        else
                            line.set_x2(sess.highProximityLine, time)
                    else
                        if not na(sess.highProximityLine)
                            line.delete(sess.highProximityLine)
                            sess.highProximityLine := na
                else
                    // High was mitigated, delete proximity line if exists
                    if not na(sess.highProximityLine)
                        line.delete(sess.highProximityLine)
                        sess.highProximityLine := na

                // Low proximity: show dashed line if unmitigated low is within ATR range AND price is approaching
                if not sess.lowMitigated
                    lowDistance = close - sess.dominantLow
                    lowDistancePrev = close[PROXIMITY_LOOKBACK] - sess.dominantLow
                    isApproachingLow = lowDistance < lowDistancePrev
                    if lowDistance > 0 and lowDistance <= atrRange and isApproachingLow
                        if na(sess.lowProximityLine)
                            sess.lowProximityLine := line.new(sess.lowTime, sess.dominantLow, time, sess.dominantLow, color=sess.mitigationColor, style=line.style_dashed, width=PROXIMITY_LINE_WIDTH, xloc=xloc.bar_time)
                        else
                            line.set_x2(sess.lowProximityLine, time)
                    else
                        if not na(sess.lowProximityLine)
                            line.delete(sess.lowProximityLine)
                            sess.lowProximityLine := na
                else
                    // Low was mitigated, delete proximity line if exists
                    if not na(sess.lowProximityLine)
                        line.delete(sess.lowProximityLine)
                        sess.lowProximityLine := na

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 5: DEVIATION GLOW - Darken deviation zones when price touches them
// ═══════════════════════════════════════════════════════════════════════════
//
// Architecture: Uses global maps (glowTouchTimes, glowOriginalColors) with string keys
// to track state. This avoids complexity with UDT array references and ensures
// reliable state persistence across bars.
//
// Logic:
// 1. Only process the most recent session of each type
// 2. For each session, check if current time is within glow window (session end + X hours)
// 3. For each deviation box:
//    - If within window AND price touches box: record touch, darken
//    - If within window AND previously touched: keep darkened
//    - If outside window: restore original color, clear touch record

if validTimeframe and enableDeviationGlow and array.size(sessions) > 0
    glowWindowMs = int(glowWindowHours * 60 * 60 * 1000)

    // Track which session types we've processed (reset each bar)
    var array<int> processedTypes = array.new<int>()
    array.clear(processedTypes)

    // Process sessions newest-first to find most recent of each type
    for j = array.size(sessions) - 1 to 0
        sess = array.get(sessions, j)

        // Skip if no deviation boxes
        boxCount = array.size(sess.deviationBoxes)
        if boxCount == 0
            continue

        // If we've already processed a newer session of this type, reset this older one
        if array.includes(processedTypes, sess.sessionIndex)
            for i = 0 to boxCount - 1
                resetGlowBox(array.get(sess.deviationBoxes, i), getGlowBoxKey(sess.sessionIndex, sess.startTime, i))
            continue
        array.push(processedTypes, sess.sessionIndex)

        // Get session end time (required for window calculation)
        sessionEndTime = nz(sess.actualEndTime, sess.endTime)
        if na(sessionEndTime) or sessionEndTime == 0
            continue

        // Determine if we're within the glow window
        withinWindow = time <= sessionEndTime + glowWindowMs

        // Process each deviation box
        for i = 0 to boxCount - 1
            devBox = array.get(sess.deviationBoxes, i)
            boxKey = getGlowBoxKey(sess.sessionIndex, sess.startTime, i)

            // Store original color on first encounter (use session's deviation color)
            if not map.contains(glowOriginalColors, boxKey)
                map.put(glowOriginalColors, boxKey, sess.deviationColor)

            originalColor = map.get(glowOriginalColors, boxKey)

            if withinWindow
                // Get box price bounds (handle potential top/bottom swap)
                boxHigh = math.max(box.get_top(devBox), box.get_bottom(devBox))
                boxLow = math.min(box.get_top(devBox), box.get_bottom(devBox))

                // Check if current bar touches the box
                touched = high >= boxLow and low <= boxHigh

                if touched
                    // Record touch and apply darkening
                    map.put(glowTouchTimes, boxKey, time)
                    box.set_bgcolor(devBox, darkenColor(originalColor, glowDarkenPercent))
                else
                    // Check if previously touched (within this window period)
                    if map.contains(glowTouchTimes, boxKey) and map.get(glowTouchTimes, boxKey) > 0
                        // Keep darkened
                        box.set_bgcolor(devBox, darkenColor(originalColor, glowDarkenPercent))
                    else
                        // Not touched - ensure original color
                        box.set_bgcolor(devBox, originalColor)
            else
                // Outside window - restore original color and clear touch record
                resetGlowBox(devBox, boxKey)

// ═══════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE - Dynamic display based on active sessions
// ═══════════════════════════════════════════════════════════════════════════

addSessionColorRows(table tbl, int startRow, string sessionName, color coreClr, color devClr, color mitClr, bool showMit) =>
    table.cell(tbl, 0, startRow, sessionName, text_size=size.small, text_color=color.black)
    table.cell(tbl, 1, startRow, "Core", text_size=size.small, text_color=color.black)
    table.cell(tbl, 2, startRow, str.format("R:{0} G:{1} B:{2}", int(color.r(coreClr)), int(color.g(coreClr)), int(color.b(coreClr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 3, startRow, str.tostring(int(color.t(coreClr))), text_size=size.small, text_color=color.black)

    table.cell(tbl, 0, startRow + 1, sessionName, text_size=size.small, text_color=color.black)
    table.cell(tbl, 1, startRow + 1, "Deviation", text_size=size.small, text_color=color.black)
    table.cell(tbl, 2, startRow + 1, str.format("R:{0} G:{1} B:{2}", int(color.r(devClr)), int(color.g(devClr)), int(color.b(devClr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 3, startRow + 1, str.tostring(int(color.t(devClr))), text_size=size.small, text_color=color.black)

    int rowsAdded = 2
    if showMit
        table.cell(tbl, 0, startRow + rowsAdded, sessionName, text_size=size.small, text_color=color.black)
        table.cell(tbl, 1, startRow + rowsAdded, "Mitigation", text_size=size.small, text_color=color.black)
        table.cell(tbl, 2, startRow + rowsAdded, str.format("R:{0} G:{1} B:{2}", int(color.r(mitClr)), int(color.g(mitClr)), int(color.b(mitClr))), text_size=size.small, text_color=color.black)
        table.cell(tbl, 3, startRow + rowsAdded, str.tostring(int(color.t(mitClr))), text_size=size.small, text_color=color.black)
        rowsAdded += 1
    rowsAdded

addSingleColorRow(table tbl, int row, string name, color clr) =>
    table.cell(tbl, 0, row, name, text_size=size.small, text_color=color.black)
    table.cell(tbl, 1, row, "-", text_size=size.small, text_color=color.black)
    table.cell(tbl, 2, row, str.format("R:{0} G:{1} B:{2}", int(color.r(clr)), int(color.g(clr)), int(color.b(clr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 3, row, str.tostring(int(color.t(clr))), text_size=size.small, text_color=color.black)

if validTimeframe and showColorTable and barstate.islast
    var table colorTable = table.new(position.top_right, 4, 50, bgcolor=color.white, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

    // Header row
    table.cell(colorTable, 0, 0, "Session", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 1, 0, "Type", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 2, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 3, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)

    int currentRow = 1

    // Only show colors for sessions that are BOTH enabled AND in current Quick Filter
    // Session indices: 0=20:15, 1=22:00, 2=02:15, 3=09:15, 4=12:30, 5=14:15, 6=NY Early, 7=Overnight, 8=Premarket, 9=NY Open 15m, 10=NY Open 30m, 11=Asia Open, 12=Mini ONS, 13=30s Opening
    if opening_2000_2015 != OPT_OFF and isInFilter(0)
        currentRow += addSessionColorRows(colorTable, currentRow, "20:15", opening_2000_2015_coreColor, opening_2000_2015_deviationColor, opening_2000_2015_mitigationColor, opening_2000_2015_mitigation)

    if opening_2100_2200 != OPT_OFF and isInFilter(1)
        currentRow += addSessionColorRows(colorTable, currentRow, "22:00", opening_2100_2200_coreColor, opening_2100_2200_deviationColor, opening_2100_2200_mitigationColor, opening_2100_2200_mitigation)

    if opening_0200_0215 != OPT_OFF and isInFilter(2)
        currentRow += addSessionColorRows(colorTable, currentRow, "02:15", opening_0200_0215_coreColor, opening_0200_0215_deviationColor, opening_0200_0215_mitigationColor, opening_0200_0215_mitigation)

    if opening_0900_0915 != OPT_OFF and isInFilter(3)
        currentRow += addSessionColorRows(colorTable, currentRow, "09:15", opening_0900_0915_coreColor, opening_0900_0915_deviationColor, opening_0900_0915_mitigationColor, opening_0900_0915_mitigation)

    if opening_1200_1230 != OPT_OFF and isInFilter(4)
        currentRow += addSessionColorRows(colorTable, currentRow, "12:00 Lunch", opening_1200_1230_coreColor, opening_1200_1230_deviationColor, opening_1200_1230_mitigationColor, opening_1200_1230_mitigation)

    if opening_1400_1415 != OPT_OFF and isInFilter(5)
        currentRow += addSessionColorRows(colorTable, currentRow, "14:15", opening_1400_1415_coreColor, opening_1400_1415_deviationColor, opening_1400_1415_mitigationColor, opening_1400_1415_mitigation)

    if opening_0600_0900 != OPT_OFF and isInFilter(6)
        currentRow += addSessionColorRows(colorTable, currentRow, "NY Early", opening_0600_0900_coreColor, opening_0600_0900_deviationColor, opening_0600_0900_mitigationColor, opening_0600_0900_mitigation)

    if opening_1600_0500 != OPT_OFF and isInFilter(7)
        currentRow += addSessionColorRows(colorTable, currentRow, "Overnight", opening_1600_0500_coreColor, opening_1600_0500_deviationColor, opening_1600_0500_mitigationColor, opening_1600_0500_mitigation)

    if opening_0500_0915 != OPT_OFF and isInFilter(8)
        currentRow += addSessionColorRows(colorTable, currentRow, "Premarket", opening_0500_0915_coreColor, opening_0500_0915_deviationColor, opening_0500_0915_mitigationColor, opening_0500_0915_mitigation)

    if opening_0930_0945 != OPT_OFF and isInFilter(9)
        currentRow += addSessionColorRows(colorTable, currentRow, "NY Open 15m", opening_0930_0945_coreColor, opening_0930_0945_deviationColor, opening_0930_0945_mitigationColor, opening_0930_0945_mitigation)

    if opening_0930_1000 != OPT_OFF and isInFilter(10)
        currentRow += addSessionColorRows(colorTable, currentRow, "NY Open 30m", opening_0930_1000_coreColor, opening_0930_1000_deviationColor, opening_0930_1000_mitigationColor, opening_0930_1000_mitigation)

    if opening_1800_2100 != OPT_OFF and isInFilter(11)
        currentRow += addSessionColorRows(colorTable, currentRow, "Asia Open", opening_1800_2100_coreColor, opening_1800_2100_deviationColor, opening_1800_2100_mitigationColor, opening_1800_2100_mitigation)

    if opening_0500_0745 != OPT_OFF and isInFilter(12)
        currentRow += addSessionColorRows(colorTable, currentRow, "05:00-07:45", opening_0500_0745_coreColor, opening_0500_0745_deviationColor, opening_0500_0745_mitigationColor, opening_0500_0745_mitigation)

    if opening_0930_093030 != OPT_OFF and isInFilter(13)
        currentRow += addSessionColorRows(colorTable, currentRow, "30s Opening", opening_0930_093030_coreColor, opening_0930_093030_deviationColor, opening_0930_093030_mitigationColor, opening_0930_093030_mitigation)

    // General colors
    if showLabels
        addSingleColorRow(colorTable, currentRow, "Labels Bg", labelsBgColor)
        currentRow += 1

    addSingleColorRow(colorTable, currentRow, "Label", labelColor)
    currentRow += 1

    if muteOvernight
        addSingleColorRow(colorTable, currentRow, "Mute Overnight", muteOvernightColor)

// ═══════════════════════════════════════════════════════════════════════════
// MUTE OVERNIGHT CANDLES
// ═══════════════════════════════════════════════════════════════════════════

overnightSession = "1600-0500:12345"
inOvernight = not na(time(timeframe.period, overnightSession, NY_TIMEZONE))

plotcandle(muteOvernight and inOvernight ? open : na, high, low, close, color=muteOvernightColor, bordercolor=muteOvernightColor, wickcolor=muteOvernightColor, editable=false, display=display.pane, force_overlay=true)
