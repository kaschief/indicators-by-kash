// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - General Settings
// ═══════════════════════════════════════════════════════════════════════════

quickFilter = input.string(FILTER_WORK_1800_FULL_NYAM, "Quick Filter", options=[FILTER_ALL, FILTER_RAFAEL, FILTER_RAFAEL_1800, FILTER_RAFAEL_1800_EARLY, FILTER_RAFAEL_1800_EARLY_OVERNIGHT, FILTER_1800, FILTER_1800_EARLY, FILTER_1800_BIAS, FILTER_WORK_1800_FULL_NYAM, FILTER_OVERNIGHT_PREMARKET_DISCOVERY, FILTER_CLEAR_BIAS, FILTER_30S_ONLY], group=GROUP_GENERAL, tooltip="Filter presets:\n• Rafael's Range: Rafael only\n• Rafael + 1800: Rafael + Asia Open\n• Rafael + 1800 + Early: Rafael + Asia Open + NY Early\n• Rafael + 1800 + Early + Overnight: Rafael + Asia Open + NY Early + Overnight\n• 1800 Range: Asia Open only\n• 1800 + Early: Asia Open + NY Early\n• 1800 + Bias: Asia Open + NY Early + Premarket + Discovery\n• Work: 1800 + Mini + Early + Overnight + Discovery + 09:15 + NY Open + 30s\n• Bias: Overnight + Premarket + Discovery\n• Clear Bias: Overnight + Premarket + Mini + NY Early + Discovery\n• 30s Opening: 30s Opening only")
maxSessions = input.int(1, LABEL_SESSIONS, group=GROUP_GENERAL, tooltip=TOOLTIP_MAX_SESSIONS, minval=1, maxval=50)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - Mitigation
// ═══════════════════════════════════════════════════════════════════════════

mitigationMode = input.string(MIT_MITIGATED, "Mode", options=[MIT_MITIGATED, MIT_UNMITIGATED], inline="mitigation_mode", group=GROUP_MITIGATION, tooltip="Mitigated: Show lines when levels are touched\nUnmitigated: Show persistent lines for untouched levels")
mitigationTodayOnly = input.bool(true, "Same-Day Only", inline="mitigation_mode", group=GROUP_MITIGATION, tooltip="Only track same-day mitigations. Rafael + Asia Open always track.")
showProximity = input.bool(false, "Show Proximity Levels", group=GROUP_MITIGATION, tooltip="Show dashed lines for unmitigated highs/lows within ATR range of current price")

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - Labels
// ═══════════════════════════════════════════════════════════════════════════

showLabels = input.bool(false, LABEL_SHOW_SESSION_NAMES, group=GROUP_SESSION_LABELS, tooltip=TOOLTIP_SHOW_SESSION_NAMES)
labelColor = input.color(color.rgb(120, 123, 134), LABEL_LABEL_COLOR, inline="label_colors", group=GROUP_SESSION_LABELS)
labelsBgColor = input.color(color.new(color.rgb(245, 245, 245), 20), "Background", inline="label_colors", group=GROUP_SESSION_LABELS, tooltip="Background color for session and deviation labels. Set transparency to 100 for no background.")

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - Display
// ═══════════════════════════════════════════════════════════════════════════

show1600Bias = input.bool(true, "Show 1600 Bias", group=GROUP_DISPLAY, tooltip="Show directional bias on Premarket label based on where the previous day's 16:00 closed relative to that day's Premarket range.\n\n↑ Bullish: 1600 closed above Premarket high\n↓ Bearish: 1600 closed below Premarket low\n↔ Return to Range: 1600 closed inside Premarket range")
muteOvernight = input.bool(true, LABEL_MUTE_OVERNIGHT, inline="mute_overnight", group=GROUP_DISPLAY, tooltip="Mute candle colors during the overnight session (16:00-05:00 NY time)")
muteOvernightColor = input.color(DEFAULT_OVERNIGHT_MUTE_COLOR, "", inline="mute_overnight", group=GROUP_DISPLAY)
enableDeviationGlow = input.bool(false, "Deviation Glow", group=GROUP_DISPLAY, tooltip="Darken deviation zones when price touches them. The darkening only persists while the touch is within the configured time window.")
glowDarkenPercent = input.float(25.0, "  └ Opacity", inline="glow_settings", group=GROUP_DISPLAY, minval=0.1, maxval=99.9, step=0.1)
glowWindowHours = input.float(6.0, "Duration", inline="glow_settings", group=GROUP_DISPLAY, minval=0.5, maxval=24.0, step=0.5, tooltip="Time window in hours. Touches older than this will not show the darkening effect.")

