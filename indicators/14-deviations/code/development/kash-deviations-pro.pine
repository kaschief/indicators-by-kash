var array<string> openingSessions_mode = array.from(opening_2000_2015, opening_2100_2200, opening_0200_0215, opening_0900_0915, opening_1200_1230, opening_1400_1415, opening_0600_0900, opening_1600_0500, opening_0500_0915, opening_0930_0945, opening_0930_1000, opening_1800_2100, opening_0500_0745)
var array<bool> openingSessions_offset = array.from(opening_2000_2015_offset, opening_2100_2200_offset, opening_0200_0215_offset, opening_0900_0915_offset, opening_1200_1230_offset, opening_1400_1415_offset, opening_0600_0900_offset, opening_1600_0500_offset, opening_0500_0915_offset, opening_0930_0945_offset, opening_0930_1000_offset, opening_1800_2100_offset, opening_0500_0745_offset)
var array<string> openingSessions_showLabels = array.from(opening_2000_2015_showLabels, opening_2100_2200_showLabels, opening_0200_0215_showLabels, opening_0900_0915_showLabels, opening_1200_1230_showLabels, opening_1400_1415_showLabels, opening_0600_0900_showLabels, opening_1600_0500_showLabels, opening_0500_0915_showLabels, opening_0930_0945_showLabels, opening_0930_1000_showLabels, opening_1800_2100_showLabels, opening_0500_0745_showLabels)
var array<int> openingSessions_startMin = array.from(1200, 1260, 120, 540, 720, 840, 360, 960, 300, 570, 570, 1080, 300)
var array<int> openingSessions_endMin = array.from(1215, 1320, 135, 555, 750, 855, 540, 300, 555, 585, 600, 1260, 465)
var array<color> openingSessions_coreColor = array.from(opening_2000_2015_coreColor, opening_2100_2200_coreColor, opening_0200_0215_coreColor, opening_0900_0915_coreColor, opening_1200_1230_coreColor, opening_1400_1415_coreColor, opening_0600_0900_coreColor, opening_1600_0500_coreColor, opening_0500_0915_coreColor, opening_0930_0945_coreColor, opening_0930_1000_coreColor, opening_1800_2100_coreColor, opening_0500_0745_coreColor)
var array<color> openingSessions_deviationColor = array.from(opening_2000_2015_deviationColor, opening_2100_2200_deviationColor, opening_0200_0215_deviationColor, opening_0900_0915_deviationColor, opening_1200_1230_deviationColor, opening_1400_1415_deviationColor, opening_0600_0900_deviationColor, opening_1600_0500_deviationColor, opening_0500_0915_deviationColor, opening_0930_0945_deviationColor, opening_0930_1000_deviationColor, opening_1800_2100_deviationColor, opening_0500_0745_deviationColor)
var array<string> openingSessions_name = array.from(SESSION_INTRADAY_2015, SESSION_INTRADAY_2200, SESSION_INTRADAY_0215, SESSION_INTRADAY_0915, SESSION_INTRADAY_1230, SESSION_INTRADAY_1415, SESSION_EXTENDED_0600_0900, SESSION_EXTENDED_1600_0500, SESSION_EXTENDED_0500_0915, SESSION_EXTENDED_0930_0945, SESSION_EXTENDED_0930_1000, SESSION_EXTENDED_1800_2100, SESSION_EXTENDED_0500_0745)
var array<string> openingSessions_chartLabel = array.from(CHART_LABEL_2015, CHART_LABEL_2200, CHART_LABEL_0215, CHART_LABEL_0915, CHART_LABEL_1230, CHART_LABEL_1415, CHART_LABEL_0600_0900, CHART_LABEL_1600_0500, CHART_LABEL_0500_0915, CHART_LABEL_0930_0945, CHART_LABEL_0930_1000, CHART_LABEL_1800_2100, CHART_LABEL_0500_0745)
var array<string> openingSessions_labelPosition = array.from(opening_2000_2015_labelPosition, opening_2100_2200_labelPosition, opening_0200_0215_labelPosition, opening_0900_0915_labelPosition, opening_1200_1230_labelPosition, opening_1400_1415_labelPosition, opening_0600_0900_labelPosition, opening_1600_0500_labelPosition, opening_0500_0915_labelPosition, opening_0930_0945_labelPosition, opening_0930_1000_labelPosition, opening_1800_2100_labelPosition, opening_0500_0745_labelPosition)
var array<bool> openingSessions_mitigation = array.from(opening_2000_2015_mitigation, opening_2100_2200_mitigation, opening_0200_0215_mitigation, opening_0900_0915_mitigation, opening_1200_1230_mitigation, opening_1400_1415_mitigation, opening_0600_0900_mitigation, opening_1600_0500_mitigation, opening_0500_0915_mitigation, opening_0930_0945_mitigation, opening_0930_1000_mitigation, opening_1800_2100_mitigation, opening_0500_0745_mitigation)
var array<color> openingSessions_mitigationColor = array.from(opening_2000_2015_mitigationColor, opening_2100_2200_mitigationColor, opening_0200_0215_mitigationColor, opening_0900_0915_mitigationColor, opening_1200_1230_mitigationColor, opening_1400_1415_mitigationColor, opening_0600_0900_mitigationColor, opening_1600_0500_mitigationColor, opening_0500_0915_mitigationColor, opening_0930_0945_mitigationColor, opening_0930_1000_mitigationColor, opening_1800_2100_mitigationColor, opening_0500_0745_mitigationColor)
var array<bool> openingSessions_alert = array.from(opening_2000_2015_alert, opening_2100_2200_alert, opening_0200_0215_alert, opening_0900_0915_alert, opening_1200_1230_alert, opening_1400_1415_alert, opening_0600_0900_alert, opening_1600_0500_alert, opening_0500_0915_alert, opening_0930_0945_alert, opening_0930_1000_alert, opening_1800_2100_alert, opening_0500_0745_alert)

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 1: SESSION DETECTION - Detect new sessions starting
// ═══════════════════════════════════════════════════════════════════════════

barMinutes = validTimeframe ? hour(time, "America/New_York") * 60 + minute(time, "America/New_York") : 0
prevBarMinutes = validTimeframe ? hour(time[1], "America/New_York") * 60 + minute(time[1], "America/New_York") : 0

if validTimeframe
    for i = 0 to array.size(openingSessions_mode) - 1
        mode = array.get(openingSessions_mode, i)

        if mode != OPT_OFF and isInFilter(i)
            startMin = array.get(openingSessions_startMin, i)
            endMin = array.get(openingSessions_endMin, i)

            // Handle midnight-crossing sessions (e.g., 16:00-05:00)
            crossesMidnight = endMin < startMin

            // Check if we're entering this session
            currentlyInSession = crossesMidnight ? (barMinutes >= startMin or barMinutes <= endMin) : (barMinutes >= startMin and barMinutes <= endMin)
            previouslyInSession = crossesMidnight ? (prevBarMinutes >= startMin or prevBarMinutes <= endMin) : (prevBarMinutes >= startMin and prevBarMinutes <= endMin)
            sessionStarted = currentlyInSession and not previouslyInSession

            if sessionStarted
                // Create new session and add to active sessions
                coreColor = array.get(openingSessions_coreColor, i)
                deviationColor = array.get(openingSessions_deviationColor, i)
                sessionName = array.get(openingSessions_name, i)
                chartLabel = array.get(openingSessions_chartLabel, i)
                useOffset = array.get(openingSessions_offset, i)
                showDeviationLabels = array.get(openingSessions_showLabels, i)
                labelPosition = array.get(openingSessions_labelPosition, i)
                showMitigation = array.get(openingSessions_mitigation, i)
                mitigationColor = array.get(openingSessions_mitigationColor, i)
                enableAlert = array.get(openingSessions_alert, i)
                showBody = mode == OPT_BODY or mode == OPT_BOTH or mode == OPT_CORE
                showWick = mode == OPT_WICK or mode == OPT_BOTH or mode == OPT_CORE
                drawDeviations = mode == OPT_BODY or mode == OPT_WICK or mode == OPT_BOTH

                newSession = SessionData.new(
                     sessionIndex=i,
                     startBar=bar_index,
                     endBar=na,
                     startTime=time,
                     endTime=na,
                     bodyHigh=math.max(open, close),
                     bodyLow=math.min(open, close),
                     wickHigh=high,
                     wickLow=low,
                     bodyHeight=na,
                     wickHeight=na,
                     bodyBox=na,
                     wickBox=na,
                     lines=array.new<line>(),
                     labels=array.new<label>(),
                     deviationBoxes=array.new<box>(),
                     coreColor=coreColor,
                     deviationColor=deviationColor,
                     sessionName=sessionName,
                     chartLabel=chartLabel,
                     useOffset=useOffset,
                     showBody=showBody,
                     showWick=showWick,
                     drawDeviations=drawDeviations,
                     showDeviationLabels=showDeviationLabels,
                     labelPosition=labelPosition,
                     showMitigation=showMitigation,
                     mitigationColor=mitigationColor,
                     dominantHigh=na,
                     dominantLow=na,
                     highBar=bar_index,
                     lowBar=bar_index,
                     highTime=time,
                     lowTime=time,
                     highMitigated=false,
                     lowMitigated=false,
                     highMitigationBar=na,
                     lowMitigationBar=na,
                     highMitigationLine=na,
                     lowMitigationLine=na,
                     highUnmitigatedLine=na,
                     lowUnmitigatedLine=na,
                     highUnmitigatedLabel=na,
                     lowUnmitigatedLabel=na,
                     midLevel=na,
                     midMitigated=false,
                     midMitigationLine=na,
                     highProximityLine=na,
                     lowProximityLine=na,
                     enableAlert=enableAlert
                 )

                array.push(activeSessions, newSession)

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 2: SESSION TRACKING - Update all active sessions
// ═══════════════════════════════════════════════════════════════════════════

if validTimeframe and array.size(activeSessions) > 0
    for sess in activeSessions
        idx = sess.sessionIndex
        startMin = array.get(openingSessions_startMin, idx)
        endMin = array.get(openingSessions_endMin, idx)

        // Handle midnight-crossing sessions
        crossesMidnight = endMin < startMin

        // Check if current bar is within this session's time range
        isBarInSession = crossesMidnight ? (barMinutes >= startMin or barMinutes <= endMin) : (barMinutes >= startMin and barMinutes <= endMin)

        if isBarInSession
            // Update session high/low values with current bar
            currentBodyHigh = math.max(open, close)
            currentBodyLow = math.min(open, close)

            // Track bar index when new highs/lows are formed
            if high > sess.wickHigh
                sess.highBar := bar_index
                sess.highTime := time
            if low < sess.wickLow
                sess.lowBar := bar_index
                sess.lowTime := time

            sess.bodyHigh := math.max(sess.bodyHigh, currentBodyHigh)
            sess.bodyLow := math.min(sess.bodyLow, currentBodyLow)
            sess.wickHigh := math.max(sess.wickHigh, high)
            sess.wickLow := math.min(sess.wickLow, low)

            // Live deviation drawing - clear and redraw each bar
            if showLiveDeviations
                clearLiveDrawings(sess)
                drawLiveSessionDeviations(sess, time, bar_index)

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 3: SESSION FINALIZATION - Finalize and remove ended sessions
// ═══════════════════════════════════════════════════════════════════════════

if validTimeframe and array.size(activeSessions) > 0
    for i = array.size(activeSessions) - 1 to 0
        sess = array.get(activeSessions, i)
        idx = sess.sessionIndex
        startMin = array.get(openingSessions_startMin, idx)
        endMin = array.get(openingSessions_endMin, idx)

        // Handle midnight-crossing sessions
        crossesMidnight = endMin < startMin

        // Detect session end transition
        isCurrentBarInSession = crossesMidnight ? (barMinutes >= startMin or barMinutes <= endMin) : (barMinutes >= startMin and barMinutes <= endMin)
        wasPreviousBarInSession = crossesMidnight ? (prevBarMinutes >= startMin or prevBarMinutes <= endMin) : (prevBarMinutes >= startMin and prevBarMinutes <= endMin)
        hasSessionEnded = not isCurrentBarInSession and wasPreviousBarInSession

        if hasSessionEnded
            // Finalize session - calculate heights and draw visualizations
            sess.endBar := bar_index - 1
            sess.endTime := not na(time[1]) ? time[1] : time

            // Clear live drawings before final draw (if live mode was active)
            if showLiveDeviations
                clearLiveDrawings(sess)

            // Store heights for use in progressive unlock
            sess.bodyHeight := sess.bodyHigh - sess.bodyLow
            sess.wickHeight := sess.wickHigh - sess.wickLow
            bodyHeight = sess.bodyHeight
            wickHeight = sess.wickHeight

            // Calculate dominant high/low for mitigation tracking
            // Use the most extreme value based on what's enabled
            if sess.showBody and sess.showWick
                sess.dominantHigh := sess.wickHigh
                sess.dominantLow := sess.wickLow
            else if sess.showWick
                sess.dominantHigh := sess.wickHigh
                sess.dominantLow := sess.wickLow
            else
                sess.dominantHigh := sess.bodyHigh
                sess.dominantLow := sess.bodyLow

            // Calculate 50% level based on the larger range
            if sess.showBody and sess.showWick
                if wickHeight >= bodyHeight
                    sess.midLevel := (sess.wickHigh + sess.wickLow) / 2
                else
                    sess.midLevel := (sess.bodyHigh + sess.bodyLow) / 2
            else if sess.showWick
                sess.midLevel := (sess.wickHigh + sess.wickLow) / 2
            else
                sess.midLevel := (sess.bodyHigh + sess.bodyLow) / 2

            // Draw body core with deviations
            sess.bodyBox := drawCoreBox(sess, sess.bodyHigh, sess.bodyLow)
            if sess.showBody and sess.drawDeviations
                drawCoreWithDeviations(sess, sess.bodyHigh, sess.bodyLow, bodyHeight, true)

            // Draw wick core with deviations
            sess.wickBox := drawCoreBox(sess, sess.wickHigh, sess.wickLow)
            if sess.showWick and sess.drawDeviations
                drawCoreWithDeviations(sess, sess.wickHigh, sess.wickLow, wickHeight, false)

            // Draw session name label
            if showLabels
                labelX = int(math.round((sess.startTime + sess.endTime) / 2))
                labelY = sess.labelPosition == OPT_ABOVE ? sess.wickHigh : sess.wickLow
                labelStyle = sess.labelPosition == OPT_ABOVE ? label.style_label_down : label.style_label_up
                sessionLabel = label.new(labelX, labelY, sess.chartLabel, style=labelStyle, textcolor=labelColor, size=size.tiny, color=labelsBgColor, textalign=text.align_center, xloc=xloc.bar_time)
                sess.labels.push(sessionLabel)

            // Add to completed sessions
            sessions.push(sess)

            // Remove oldest session of this type if limit exceeded
            sessionsOfThisType = 0
            for s in sessions
                if s.sessionIndex == sess.sessionIndex
                    sessionsOfThisType += 1

            if sessionsOfThisType > maxSessions
                // Find and delete the oldest session of this type
                for j = 0 to array.size(sessions) - 1
                    oldSession = array.get(sessions, j)
                    if oldSession.sessionIndex == sess.sessionIndex
                        deleteSession(oldSession)
                        array.remove(sessions, j)
                        break

            // Remove from active sessions
            array.remove(activeSessions, i)

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 4: MITIGATION DETECTION - Check for breaches on completed sessions
// ═══════════════════════════════════════════════════════════════════════════

// Calculate ATR for proximity detection
atrValue = ta.atr(PROXIMITY_ATR_PERIOD)
atrRange = atrValue * PROXIMITY_ATR_MULTIPLIER

if validTimeframe and array.size(sessions) > 0
    for sess in sessions
        if sess.showMitigation and not na(sess.dominantHigh)
            // Check for high mitigation (price goes above the high)
            if not sess.highMitigated and high >= sess.dominantHigh
                sess.highMitigated := true
                sess.highMitigationBar := bar_index
                // Draw mitigated line if in Mitigated mode
                if mitigationMode == MIT_MITIGATED
                    sess.highMitigationLine := line.new(sess.highTime, sess.dominantHigh, time, sess.dominantHigh, color=sess.mitigationColor, style=line.style_solid, width=MITIGATION_LINE_WIDTH, xloc=xloc.bar_time)
                // Delete unmitigated line and label when mitigated (for Unmitigated mode)
                if not na(sess.highUnmitigatedLine)
                    line.delete(sess.highUnmitigatedLine)
                    sess.highUnmitigatedLine := na
                if not na(sess.highUnmitigatedLabel)
                    label.delete(sess.highUnmitigatedLabel)
                    sess.highUnmitigatedLabel := na
                if sess.enableAlert
                    alertMsg = sess.sessionName + ALERT_HIGH_MITIGATED
                    alert(alertMsg, alert.freq_once_per_bar)

            // Check for low mitigation (price goes below the low)
            if not sess.lowMitigated and low <= sess.dominantLow
                sess.lowMitigated := true
                sess.lowMitigationBar := bar_index
                // Draw mitigated line if in Mitigated mode
                if mitigationMode == MIT_MITIGATED
                    sess.lowMitigationLine := line.new(sess.lowTime, sess.dominantLow, time, sess.dominantLow, color=sess.mitigationColor, style=line.style_solid, width=MITIGATION_LINE_WIDTH, xloc=xloc.bar_time)
                // Delete unmitigated line and label when mitigated (for Unmitigated mode)
                if not na(sess.lowUnmitigatedLine)
                    line.delete(sess.lowUnmitigatedLine)
                    sess.lowUnmitigatedLine := na
                if not na(sess.lowUnmitigatedLabel)
                    label.delete(sess.lowUnmitigatedLabel)
                    sess.lowUnmitigatedLabel := na
                if sess.enableAlert
                    alertMsg = sess.sessionName + ALERT_LOW_MITIGATED
                    alert(alertMsg, alert.freq_once_per_bar)

            // Unmitigated mode: show persistent lines for unmitigated levels
            if mitigationMode == MIT_UNMITIGATED
                // High unmitigated line and label
                if not sess.highMitigated
                    if na(sess.highUnmitigatedLine)
                        sess.highUnmitigatedLine := line.new(sess.highTime, sess.dominantHigh, time, sess.dominantHigh, color=sess.mitigationColor, style=line.style_solid, width=MITIGATION_LINE_WIDTH, xloc=xloc.bar_time)
                        sess.highUnmitigatedLabel := label.new(time, sess.dominantHigh, sess.chartLabel, style=label.style_label_left, textcolor=labelColor, size=size.tiny, color=color.new(color.white, 100), xloc=xloc.bar_time)
                    else
                        line.set_x2(sess.highUnmitigatedLine, time)
                        label.set_x(sess.highUnmitigatedLabel, time)
                // Low unmitigated line and label
                if not sess.lowMitigated
                    if na(sess.lowUnmitigatedLine)
                        sess.lowUnmitigatedLine := line.new(sess.lowTime, sess.dominantLow, time, sess.dominantLow, color=sess.mitigationColor, style=line.style_solid, width=MITIGATION_LINE_WIDTH, xloc=xloc.bar_time)
                        sess.lowUnmitigatedLabel := label.new(time, sess.dominantLow, sess.chartLabel, style=label.style_label_left, textcolor=labelColor, size=size.tiny, color=color.new(color.white, 100), xloc=xloc.bar_time)
                    else
                        line.set_x2(sess.lowUnmitigatedLine, time)
                        label.set_x(sess.lowUnmitigatedLabel, time)

            // Check for 50% mitigation (only after an extreme has been mitigated, only in Mitigated mode)
            if mitigationMode == MIT_MITIGATED and (sess.highMitigated or sess.lowMitigated) and not sess.midMitigated and not na(sess.midLevel)
                if low <= sess.midLevel and high >= sess.midLevel
                    sess.midMitigated := true
                    sess.midMitigationLine := line.new(sess.endTime, sess.midLevel, time, sess.midLevel, color=sess.mitigationColor, style=line.style_dotted, width=MITIGATION_50_LINE_WIDTH, xloc=xloc.bar_time)
                    if sess.enableAlert
                        alertMsg = close[1] > sess.midLevel ? sess.sessionName + ALERT_MID_MITIGATED_FROM_ABOVE : sess.sessionName + ALERT_MID_MITIGATED_FROM_BELOW
                        alert(alertMsg, alert.freq_once_per_bar)

            // Proximity detection for unmitigated levels
            if showProximity and not na(atrRange)
                // High proximity: show dashed line if unmitigated high is within ATR range AND price is approaching
                if not sess.highMitigated
                    highDistance = sess.dominantHigh - close
                    highDistancePrev = sess.dominantHigh - close[PROXIMITY_LOOKBACK]
                    isApproachingHigh = highDistance < highDistancePrev
                    if highDistance > 0 and highDistance <= atrRange and isApproachingHigh
                        if na(sess.highProximityLine)
                            sess.highProximityLine := line.new(sess.highTime, sess.dominantHigh, time, sess.dominantHigh, color=sess.mitigationColor, style=line.style_dashed, width=PROXIMITY_LINE_WIDTH, xloc=xloc.bar_time)
                        else
                            line.set_x2(sess.highProximityLine, time)
                    else
                        if not na(sess.highProximityLine)
                            line.delete(sess.highProximityLine)
                            sess.highProximityLine := na
                else
                    // High was mitigated, delete proximity line if exists
                    if not na(sess.highProximityLine)
                        line.delete(sess.highProximityLine)
                        sess.highProximityLine := na

                // Low proximity: show dashed line if unmitigated low is within ATR range AND price is approaching
                if not sess.lowMitigated
                    lowDistance = close - sess.dominantLow
                    lowDistancePrev = close[PROXIMITY_LOOKBACK] - sess.dominantLow
                    isApproachingLow = lowDistance < lowDistancePrev
                    if lowDistance > 0 and lowDistance <= atrRange and isApproachingLow
                        if na(sess.lowProximityLine)
                            sess.lowProximityLine := line.new(sess.lowTime, sess.dominantLow, time, sess.dominantLow, color=sess.mitigationColor, style=line.style_dashed, width=PROXIMITY_LINE_WIDTH, xloc=xloc.bar_time)
                        else
                            line.set_x2(sess.lowProximityLine, time)
                    else
                        if not na(sess.lowProximityLine)
                            line.delete(sess.lowProximityLine)
                            sess.lowProximityLine := na
                else
                    // Low was mitigated, delete proximity line if exists
                    if not na(sess.lowProximityLine)
                        line.delete(sess.lowProximityLine)
                        sess.lowProximityLine := na

// ═══════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE
// ═══════════════════════════════════════════════════════════════════════════

if validTimeframe and showColorTable and barstate.islast
    var table colorTable = table.new(position.top_right, 4, 43, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

    // Header row
    table.cell(colorTable, 0, 0, "Session", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 1, 0, "Type", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 2, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 3, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)

    // 20:15 Session
    table.cell(colorTable, 0, 1, "20:15", text_size=size.small)
    table.cell(colorTable, 1, 1, "Core", text_size=size.small)
    table.cell(colorTable, 2, 1, str.format("R:{0} G:{1} B:{2}", int(color.r(opening_2000_2015_coreColor)), int(color.g(opening_2000_2015_coreColor)), int(color.b(opening_2000_2015_coreColor))), text_size=size.small)
    table.cell(colorTable, 3, 1, str.tostring(int(color.t(opening_2000_2015_coreColor))), text_size=size.small)

    table.cell(colorTable, 0, 2, "20:15", text_size=size.small)
    table.cell(colorTable, 1, 2, "Deviation", text_size=size.small)
    table.cell(colorTable, 2, 2, str.format("R:{0} G:{1} B:{2}", int(color.r(opening_2000_2015_deviationColor)), int(color.g(opening_2000_2015_deviationColor)), int(color.b(opening_2000_2015_deviationColor))), text_size=size.small)
    table.cell(colorTable, 3, 2, str.tostring(int(color.t(opening_2000_2015_deviationColor))), text_size=size.small)

    table.cell(colorTable, 0, 3, "20:15", text_size=size.small)
    table.cell(colorTable, 1, 3, "Mitigation", text_size=size.small)
    table.cell(colorTable, 2, 3, str.format("R:{0} G:{1} B:{2}", int(color.r(opening_2000_2015_mitigationColor)), int(color.g(opening_2000_2015_mitigationColor)), int(color.b(opening_2000_2015_mitigationColor))), text_size=size.small)
    table.cell(colorTable, 3, 3, str.tostring(int(color.t(opening_2000_2015_mitigationColor))), text_size=size.small)

    // 02:15 Session
    table.cell(colorTable, 0, 4, "02:15", text_size=size.small)
    table.cell(colorTable, 1, 4, "Core", text_size=size.small)
    table.cell(colorTable, 2, 4, str.format("R:{0} G:{1} B:{2}", int(color.r(opening_0200_0215_coreColor)), int(color.g(opening_0200_0215_coreColor)), int(color.b(opening_0200_0215_coreColor))), text_size=size.small)
    table.cell(colorTable, 3, 4, str.tostring(int(color.t(opening_0200_0215_coreColor))), text_size=size.small)

    table.cell(colorTable, 0, 5, "02:15", text_size=size.small)
    table.cell(colorTable, 1, 5, "Deviation", text_size=size.small)
    table.cell(colorTable, 2, 5, str.format("R:{0} G:{1} B:{2}", int(color.r(opening_0200_0215_deviationColor)), int(color.g(opening_0200_0215_deviationColor)), int(color.b(opening_0200_0215_deviationColor))), text_size=size.small)
    table.cell(colorTable, 3, 5, str.tostring(int(color.t(opening_0200_0215_deviationColor))), text_size=size.small)

    table.cell(colorTable, 0, 6, "02:15", text_size=size.small)
    table.cell(colorTable, 1, 6, "Mitigation", text_size=size.small)
    table.cell(colorTable, 2, 6, str.format("R:{0} G:{1} B:{2}", int(color.r(opening_0200_0215_mitigationColor)), int(color.g(opening_0200_0215_mitigationColor)), int(color.b(opening_0200_0215_mitigationColor))), text_size=size.small)
    table.cell(colorTable, 3, 6, str.tostring(int(color.t(opening_0200_0215_mitigationColor))), text_size=size.small)

    // 09:15 Session
    table.cell(colorTable, 0, 7, "09:15", text_size=size.small)
    table.cell(colorTable, 1, 7, "Core", text_size=size.small)
    table.cell(colorTable, 2, 7, str.format("R:{0} G:{1} B:{2}", int(color.r(opening_0900_0915_coreColor)), int(color.g(opening_0900_0915_coreColor)), int(color.b(opening_0900_0915_coreColor))), text_size=size.small)
    table.cell(colorTable, 3, 7, str.tostring(int(color.t(opening_0900_0915_coreColor))), text_size=size.small)

