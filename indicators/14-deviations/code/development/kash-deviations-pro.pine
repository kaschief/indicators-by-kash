//@version=6
indicator("Kash Deviations° [Pro+]", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════
// TYPE DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════════

type ZonePair
    float fromLevel
    float toLevel

type SessionData
    int startBar
    int endBar
    float bodyHigh
    float bodyLow
    float wickHigh
    float wickLow
    box bodyBox
    box wickBox
    array<line> lines
    array<label> labels
    array<box> zoneBoxes

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - Sessions
// ═══════════════════════════════════════════════════════════════════════════

sessionStart = input.string("09:00", "Range Time", inline="s1t", group="Sessions")
sessionEnd = input.string("09:15", "-", inline="s1t", group="Sessions")
maxSessions = input.int(5, "Max Sessions to Display", minval=1, maxval=50, group="Sessions")

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - Ranges
// ═══════════════════════════════════════════════════════════════════════════

showBodyRange = input.bool(true, "Body Range", inline="range", group="Ranges")
bodyRangeColor = input.color(color.new(#8B4513, 85), "", inline="range", group="Ranges")

showWickRange = input.bool(true, "Wick Range", inline="range", group="Ranges")
wickRangeColor = input.color(color.new(#2962FF, 85), "", inline="range", group="Ranges")

rangeLineColor = input.color(color.new(#8B4513, 0), "Range Lines", inline="rl", group="Ranges")
rangeLineStyle = input.string("Dotted", "", inline="rl", options=["Solid", "Dashed", "Dotted"], group="Ranges")
rangeLineWidth = input.int(1, "", inline="rl", minval=1, maxval=5, group="Ranges")

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - Deviations
// ═══════════════════════════════════════════════════════════════════════════

deviations = input.string("1, 2, 2.5, 4, 4.5", "Levels", group="Deviations", tooltip="Comma-separated multiples")

showBodyDeviations = input.bool(true, "Body", inline="bd", group="Deviations")
bodyDeviationColor = input.color(color.new(#8B4513, 50), "", inline="bd", group="Deviations")
bodyDeviationStyle = input.string("Dashed", "", inline="bd", options=["Solid", "Dashed", "Dotted"], group="Deviations")
bodyDeviationWidth = input.int(1, "", inline="bd", minval=1, maxval=5, group="Deviations")

showWickDeviations = input.bool(true, "Wick", inline="wd", group="Deviations")
wickDeviationColor = input.color(color.new(#2962FF, 50), "", inline="wd", group="Deviations")
wickDeviationStyle = input.string("Dashed", "", inline="wd", options=["Solid", "Dashed", "Dotted"], group="Deviations")
wickDeviationWidth = input.int(1, "", inline="wd", minval=1, maxval=5, group="Deviations")

showBodyLabels = input.bool(true, "Body Labels", inline="blbl", group="Deviations")
bodyLabelSize = input.string("Tiny", "", inline="blbl", options=["Tiny", "Small", "Normal", "Large"], group="Deviations")
bodyLabelPosition = input.string("Right", "", inline="blbl", options=["Left", "Right"], group="Deviations")
bodyLabelColor = input.color(#787B86, "", inline="blbl", group="Deviations")

showWickLabels = input.bool(true, "Wick Labels", inline="wlbl", group="Deviations")
wickLabelSize = input.string("Tiny", "", inline="wlbl", options=["Tiny", "Small", "Normal", "Large"], group="Deviations")
wickLabelPosition = input.string("Left", "", inline="wlbl", options=["Left", "Right"], group="Deviations")
wickLabelColor = input.color(#787B86, "", inline="wlbl", group="Deviations")

showBodyZones = input.bool(false, "Body Zones", inline="bz", group="Deviations")
bodyZones = input.string("2:2.5, 4:4.5", "", inline="bz", group="Deviations", tooltip="Pairs of levels to shade (e.g., 2:2.5, 4:4.5)")
bodyZoneColor = input.color(color.new(#8B4513, 90), "", inline="bz", group="Deviations")

showWickZones = input.bool(false, "Wick Zones", inline="wz", group="Deviations")
wickZones = input.string("2:2.5, 4:4.5", "", inline="wz", group="Deviations", tooltip="Pairs of levels to shade (e.g., 2:2.5, 4:4.5)")
wickZoneColor = input.color(color.new(#2962FF, 90), "", inline="wz", group="Deviations")

// ═══════════════════════════════════════════════════════════════════════════
// SESSION VARIABLES
// ═══════════════════════════════════════════════════════════════════════════

var array<SessionData> sessions = array.new<SessionData>()
var SessionData currentSession = na

var array<float> cachedDevLevels = na
var array<ZonePair> cachedBodyZones = na
var array<ZonePair> cachedWickZones = na
var int cachedSessionStartMinutes = na
var int cachedSessionEndMinutes = na

// Constants for performance
BODY_SUFFIX = "B"
WICK_SUFFIX = "W"

// ═══════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════

getLineStyle(string style) =>
    style == "Solid" ? line.style_solid : style == "Dotted" ? line.style_dotted : line.style_dashed

getLabelSize(string sizeStr) =>
    sizeStr == "Tiny" ? size.tiny : sizeStr == "Small" ? size.small : sizeStr == "Normal" ? size.normal : size.large

parseTimeToMinutes(string timeStr) =>
    hour = str.tonumber(str.substring(timeStr, 0, 2))
    minute = str.tonumber(str.substring(timeStr, 3, 5))
    int(hour * 60 + minute)

parseDeviations(string devStr) =>
    devArray = array.new<float>()
    parts = str.split(devStr, ",")
    for part in parts
        trimmed = str.replace_all(part, " ", "")
        if trimmed != ""
            devArray.push(str.tonumber(trimmed))
    devArray

parseZonePairs(string zoneStr) =>
    pairArray = array.new<ZonePair>()
    pairs = str.split(zoneStr, ",")
    for pair in pairs
        trimmed = str.replace_all(pair, " ", "")
        if trimmed != "" and str.contains(trimmed, ":")
            levels = str.split(trimmed, ":")
            if array.size(levels) == 2
                fromVal = str.tonumber(array.get(levels, 0))
                toVal = str.tonumber(array.get(levels, 1))
                pairArray.push(ZonePair.new(fromVal, toVal))
    pairArray

toSansSerif(string inputStr) =>
    result = inputStr
    result := str.replace_all(result, "0", "𝟢")
    result := str.replace_all(result, "1", "𝟣")
    result := str.replace_all(result, "2", "𝟤")
    result := str.replace_all(result, "3", "𝟥")
    result := str.replace_all(result, "4", "𝟦")
    result := str.replace_all(result, "5", "𝟧")
    result := str.replace_all(result, "6", "𝟨")
    result := str.replace_all(result, "7", "𝟩")
    result := str.replace_all(result, "8", "𝟪")
    result := str.replace_all(result, "9", "𝟫")
    result

drawZones(SessionData session, float high, float low, float height, array<ZonePair> zonePairs, color zoneColor) =>
    if array.size(zonePairs) > 0
        for i = 0 to array.size(zonePairs) - 1
            pair = array.get(zonePairs, i)
            fromDev = pair.fromLevel
            toDev = pair.toLevel

            // Draw above zone
            aboveFrom = high + (height * fromDev)
            aboveTo = high + (height * toDev)
            aboveBox = box.new(session.startBar, aboveFrom, session.endBar, aboveTo, bgcolor=zoneColor, border_color=na)
            session.zoneBoxes.push(aboveBox)

            // Draw below zone
            belowFrom = low - (height * fromDev)
            belowTo = low - (height * toDev)
            belowBox = box.new(session.startBar, belowFrom, session.endBar, belowTo, bgcolor=zoneColor, border_color=na)
            session.zoneBoxes.push(belowBox)

drawDeviations(SessionData session, float high, float low, float height, color lineColor, string lineStyle, int lineWidth, bool showLabels, string labelSize, string labelPosition, color labelColor, string suffix) =>
    if array.size(cachedDevLevels) > 0
        for j = 0 to array.size(cachedDevLevels) - 1
            dev = array.get(cachedDevLevels, j)

            // Draw above deviation
            aboveLevel = high + (height * dev)
            aboveLine = line.new(session.startBar, aboveLevel, session.endBar, aboveLevel, color=lineColor, style=getLineStyle(lineStyle), width=lineWidth)
            session.lines.push(aboveLine)

            if showLabels
                labelX = labelPosition == "Left" ? session.startBar : session.endBar
                labelText = toSansSerif("+" + str.tostring(dev) + suffix)
                labelStyle = labelPosition == "Left" ? label.style_label_right : label.style_label_left
                aboveLabel = label.new(labelX, aboveLevel, labelText, style=labelStyle, color=color.new(chart.bg_color, 0), textcolor=labelColor, size=getLabelSize(labelSize))
                session.labels.push(aboveLabel)

            // Draw below deviation
            belowLevel = low - (height * dev)
            belowLine = line.new(session.startBar, belowLevel, session.endBar, belowLevel, color=lineColor, style=getLineStyle(lineStyle), width=lineWidth)
            session.lines.push(belowLine)

            if showLabels
                labelX = labelPosition == "Left" ? session.startBar : session.endBar
                labelText = toSansSerif("-" + str.tostring(dev) + suffix)
                labelStyle = labelPosition == "Left" ? label.style_label_right : label.style_label_left
                belowLabel = label.new(labelX, belowLevel, labelText, style=labelStyle, color=color.new(chart.bg_color, 0), textcolor=labelColor, size=getLabelSize(labelSize))
                session.labels.push(belowLabel)

// ═══════════════════════════════════════════════════════════════════════════
// INITIALIZATION
// ═══════════════════════════════════════════════════════════════════════════

if na(cachedDevLevels)
    cachedDevLevels := parseDeviations(deviations)
    cachedBodyZones := parseZonePairs(bodyZones)
    cachedWickZones := parseZonePairs(wickZones)
    cachedSessionStartMinutes := parseTimeToMinutes(sessionStart)
    cachedSessionEndMinutes := parseTimeToMinutes(sessionEnd)

// ═══════════════════════════════════════════════════════════════════════════
// SESSION DETECTION
// ═══════════════════════════════════════════════════════════════════════════

barMinutes = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")

inSession = barMinutes >= cachedSessionStartMinutes and barMinutes <= cachedSessionEndMinutes
sessionStarted = inSession and not inSession[1]
sessionEnded = not inSession and inSession[1]

if sessionStarted
    currentSession := SessionData.new(bar_index, na, math.max(open, close), math.min(open, close), high, low, na, na, array.new<line>(), array.new<label>(), array.new<box>())

if inSession and not na(currentSession)
    currentSession.bodyHigh := math.max(currentSession.bodyHigh, math.max(open, close))
    currentSession.bodyLow := math.min(currentSession.bodyLow, math.min(open, close))
    currentSession.wickHigh := math.max(currentSession.wickHigh, high)
    currentSession.wickLow := math.min(currentSession.wickLow, low)

if sessionEnded and not na(currentSession)
    currentSession.endBar := bar_index - 1

    bodyHeight = currentSession.bodyHigh - currentSession.bodyLow
    wickHeight = currentSession.wickHigh - currentSession.wickLow

    if showBodyRange
        currentSession.bodyBox := box.new(currentSession.startBar, currentSession.bodyHigh, currentSession.endBar, currentSession.bodyLow, bgcolor=bodyRangeColor, border_color=na)
        topLine = line.new(currentSession.startBar, currentSession.bodyHigh, currentSession.endBar, currentSession.bodyHigh, color=rangeLineColor, style=getLineStyle(rangeLineStyle), width=rangeLineWidth)
        bottomLine = line.new(currentSession.startBar, currentSession.bodyLow, currentSession.endBar, currentSession.bodyLow, color=rangeLineColor, style=getLineStyle(rangeLineStyle), width=rangeLineWidth)
        currentSession.lines.push(topLine)
        currentSession.lines.push(bottomLine)

    if showBodyDeviations
        drawDeviations(currentSession, currentSession.bodyHigh, currentSession.bodyLow, bodyHeight, bodyDeviationColor, bodyDeviationStyle, bodyDeviationWidth, showBodyLabels, bodyLabelSize, bodyLabelPosition, bodyLabelColor, BODY_SUFFIX)

    if showBodyZones
        drawZones(currentSession, currentSession.bodyHigh, currentSession.bodyLow, bodyHeight, cachedBodyZones, bodyZoneColor)

    if showWickRange
        currentSession.wickBox := box.new(currentSession.startBar, currentSession.wickHigh, currentSession.endBar, currentSession.wickLow, bgcolor=wickRangeColor, border_color=na)
        topLine = line.new(currentSession.startBar, currentSession.wickHigh, currentSession.endBar, currentSession.wickHigh, color=rangeLineColor, style=getLineStyle(rangeLineStyle), width=rangeLineWidth)
        bottomLine = line.new(currentSession.startBar, currentSession.wickLow, currentSession.endBar, currentSession.wickLow, color=rangeLineColor, style=getLineStyle(rangeLineStyle), width=rangeLineWidth)
        currentSession.lines.push(topLine)
        currentSession.lines.push(bottomLine)

    if showWickDeviations
        drawDeviations(currentSession, currentSession.wickHigh, currentSession.wickLow, wickHeight, wickDeviationColor, wickDeviationStyle, wickDeviationWidth, showWickLabels, wickLabelSize, wickLabelPosition, wickLabelColor, WICK_SUFFIX)

    if showWickZones
        drawZones(currentSession, currentSession.wickHigh, currentSession.wickLow, wickHeight, cachedWickZones, wickZoneColor)

    sessions.push(currentSession)

    if array.size(sessions) > maxSessions
        oldSession = array.shift(sessions)
        if not na(oldSession.bodyBox)
            box.delete(oldSession.bodyBox)
        if not na(oldSession.wickBox)
            box.delete(oldSession.wickBox)
        for l in oldSession.lines
            line.delete(l)
        for lbl in oldSession.labels
            label.delete(lbl)
        for zb in oldSession.zoneBoxes
            box.delete(zb)

    currentSession := na
