//@version=6
indicator("Kash Deviations° [Pro+]", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════
// TYPE DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════════

type ZonePair
    float fromLevel
    float toLevel

type SessionData
    int sessionIndex
    int startBar
    int endBar
    float bodyHigh
    float bodyLow
    float wickHigh
    float wickLow
    box bodyBox
    box wickBox
    array<line> lines
    array<label> labels
    array<box> deviationBoxes
    color coreColor
    color deviationColor
    string sessionName
    bool useOffset
    bool showBody
    bool showWick
    bool showDeviationLabels

// ═══════════════════════════════════════════════════════════════════════════
// UI STRING CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════

// Group names
GROUP_GENERAL = "General"
GROUP_15MIN = "Intraday 15-Minute Sessions"
GROUP_1600 = "Overnight Session"
GROUP_0500 = "Premarket Session"
GROUP_0600 = "06:00 - 09:00"

// Common input labels
LABEL_SESSIONS = "No. Of Sessions"
LABEL_DEVIATION_LEVELS = "Deviation Levels"
LABEL_SHOW_SESSION_NAMES = "Show Session Names"
LABEL_LABEL_COLOR = "Label Color"
LABEL_BODY_DEVIATIONS = "Body Deviations"
LABEL_WICK_DEVIATIONS = "Wick Deviations"
LABEL_CORE = "Core"
LABEL_DEVIATIONS = "Deviations"
LABEL_DEVIATION_LABELS = "Deviation Labels"
LABEL_OFFSET = "Offset"

// Session time labels
SESSION_2015 = "20:15"
SESSION_0215 = "02:15"
SESSION_0915 = "09:15"
SESSION_1315 = "13:15"
SESSION_1600 = "16:00"
SESSION_0500 = "05:00"
SESSION_0600 = "06:00"

// Tooltips
TOOLTIP_MAX_SESSIONS = "Max number of sessions to display per opening type"
TOOLTIP_DEVIATION_LEVELS = "Comma-separated multiples"
TOOLTIP_SHOW_SESSION_NAMES = "Show session name labels"

// Option values
OPT_OFF = "Off"
OPT_BODY = "Body"
OPT_WICK = "Wick"
OPT_BOTH = "Both"

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - General Settings
// ═══════════════════════════════════════════════════════════════════════════

maxSessions = input.int(5, LABEL_SESSIONS, group=GROUP_GENERAL, tooltip=TOOLTIP_MAX_SESSIONS, minval=1, maxval=50)
deviations = input.string("1, 2, 2.5, 4, 4.5", LABEL_DEVIATION_LEVELS, group=GROUP_GENERAL, tooltip=TOOLTIP_DEVIATION_LEVELS)
showLabels = input.bool(true, LABEL_SHOW_SESSION_NAMES, group=GROUP_GENERAL, tooltip=TOOLTIP_SHOW_SESSION_NAMES)
labelColor = input.color(#787B86, LABEL_LABEL_COLOR, group=GROUP_GENERAL)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - 15-Minute Openings
// ═══════════════════════════════════════════════════════════════════════════

bodyDeviations_15min = input.string("2:2.5, 4:4.5", LABEL_BODY_DEVIATIONS, group=GROUP_15MIN)
wickDeviations_15min = input.string("2:2.5, 4:4.5", LABEL_WICK_DEVIATIONS, group=GROUP_15MIN)

opening_2015 = input.string(OPT_BOTH, SESSION_2015, inline="2015_1", options=[OPT_OFF, OPT_BODY, OPT_WICK, OPT_BOTH], group=GROUP_15MIN)
opening_2015_offset = input.bool(true, LABEL_OFFSET, inline="2015_1", group=GROUP_15MIN)
opening_2015_coreColor = input.color(color.new(#FFEB3B, 85), LABEL_CORE, inline="2015_2", group=GROUP_15MIN)
opening_2015_deviationColor = input.color(color.new(#FFEB3B, 50), LABEL_DEVIATIONS, inline="2015_2", group=GROUP_15MIN)
opening_2015_showLabels = input.bool(true, LABEL_DEVIATION_LABELS, inline="2015_2", group=GROUP_15MIN)

opening_0215 = input.string(OPT_BOTH, SESSION_0215, inline="0215_1", options=[OPT_OFF, OPT_BODY, OPT_WICK, OPT_BOTH], group=GROUP_15MIN)
opening_0215_offset = input.bool(true, LABEL_OFFSET, inline="0215_1", group=GROUP_15MIN)
opening_0215_coreColor = input.color(color.new(#2196F3, 85), LABEL_CORE, inline="0215_2", group=GROUP_15MIN)
opening_0215_deviationColor = input.color(color.new(#2196F3, 50), LABEL_DEVIATIONS, inline="0215_2", group=GROUP_15MIN)
opening_0215_showLabels = input.bool(true, LABEL_DEVIATION_LABELS, inline="0215_2", group=GROUP_15MIN)

opening_0915 = input.string(OPT_BOTH, SESSION_0915, inline="0915_1", options=[OPT_OFF, OPT_BODY, OPT_WICK, OPT_BOTH], group=GROUP_15MIN)
opening_0915_offset = input.bool(true, LABEL_OFFSET, inline="0915_1", group=GROUP_15MIN)
opening_0915_coreColor = input.color(color.new(#FF9800, 85), LABEL_CORE, inline="0915_2", group=GROUP_15MIN)
opening_0915_deviationColor = input.color(color.new(#FF9800, 50), LABEL_DEVIATIONS, inline="0915_2", group=GROUP_15MIN)
opening_0915_showLabels = input.bool(true, LABEL_DEVIATION_LABELS, inline="0915_2", group=GROUP_15MIN)

opening_1315 = input.string(OPT_BOTH, SESSION_1315, inline="1315_1", options=[OPT_OFF, OPT_BODY, OPT_WICK, OPT_BOTH], group=GROUP_15MIN)
opening_1315_offset = input.bool(true, LABEL_OFFSET, inline="1315_1", group=GROUP_15MIN)
opening_1315_coreColor = input.color(color.new(#F44336, 85), LABEL_CORE, inline="1315_2", group=GROUP_15MIN)
opening_1315_deviationColor = input.color(color.new(#F44336, 50), LABEL_DEVIATIONS, inline="1315_2", group=GROUP_15MIN)
opening_1315_showLabels = input.bool(true, LABEL_DEVIATION_LABELS, inline="1315_2", group=GROUP_15MIN)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - 16:00-05:00
// ═══════════════════════════════════════════════════════════════════════════

bodyDeviations_1600 = input.string("2:2.5, 4:4.5", LABEL_BODY_DEVIATIONS, group=GROUP_1600)
wickDeviations_1600 = input.string("0.25:0.5, 1.33:1.66", LABEL_WICK_DEVIATIONS, group=GROUP_1600)

opening_1600 = input.string(OPT_OFF, SESSION_1600, inline="1600_1", options=[OPT_OFF, OPT_BODY, OPT_WICK, OPT_BOTH], group=GROUP_1600)
opening_1600_offset = input.bool(true, LABEL_OFFSET, inline="1600_1", group=GROUP_1600)
opening_1600_coreColor = input.color(color.new(#00BCD4, 85), LABEL_CORE, inline="1600_2", group=GROUP_1600)
opening_1600_deviationColor = input.color(color.new(#00BCD4, 50), LABEL_DEVIATIONS, inline="1600_2", group=GROUP_1600)
opening_1600_showLabels = input.bool(true, LABEL_DEVIATION_LABELS, inline="1600_2", group=GROUP_1600)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - 05:00-09:15
// ═══════════════════════════════════════════════════════════════════════════

bodyDeviations_0500 = input.string("2:2.5, 4:4.5", LABEL_BODY_DEVIATIONS, group=GROUP_0500)
wickDeviations_0500 = input.string("0.25:0.5, 1.33:1.66", LABEL_WICK_DEVIATIONS, group=GROUP_0500)

opening_0500 = input.string(OPT_OFF, SESSION_0500, inline="0500_1", options=[OPT_OFF, OPT_BODY, OPT_WICK, OPT_BOTH], group=GROUP_0500)
opening_0500_offset = input.bool(true, LABEL_OFFSET, inline="0500_1", group=GROUP_0500)
opening_0500_coreColor = input.color(color.new(#4CAF50, 85), LABEL_CORE, inline="0500_2", group=GROUP_0500)
opening_0500_deviationColor = input.color(color.new(#4CAF50, 50), LABEL_DEVIATIONS, inline="0500_2", group=GROUP_0500)
opening_0500_showLabels = input.bool(true, LABEL_DEVIATION_LABELS, inline="0500_2", group=GROUP_0500)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - 06:00-09:00
// ═══════════════════════════════════════════════════════════════════════════

bodyDeviations_0600 = input.string("2:2.5, 4:4.5", LABEL_BODY_DEVIATIONS, group=GROUP_0600)
wickDeviations_0600 = input.string("0.25:0.5, 1.33:1.66", LABEL_WICK_DEVIATIONS, group=GROUP_0600)

opening_0600 = input.string(OPT_OFF, SESSION_0600, inline="0600_1", options=[OPT_OFF, OPT_BODY, OPT_WICK, OPT_BOTH], group=GROUP_0600)
opening_0600_offset = input.bool(true, LABEL_OFFSET, inline="0600_1", group=GROUP_0600)
opening_0600_coreColor = input.color(color.new(#9C27B0, 85), LABEL_CORE, inline="0600_2", group=GROUP_0600)
opening_0600_deviationColor = input.color(color.new(#9C27B0, 50), LABEL_DEVIATIONS, inline="0600_2", group=GROUP_0600)
opening_0600_showLabels = input.bool(true, LABEL_DEVIATION_LABELS, inline="0600_2", group=GROUP_0600)

// ═══════════════════════════════════════════════════════════════════════════
// SESSION VARIABLES
// ═══════════════════════════════════════════════════════════════════════════

var array<SessionData> sessions = array.new<SessionData>()
var array<SessionData> activeSessions = array.new<SessionData>()

var array<float> cachedDevLevels = na
var array<ZonePair> cachedBodyDeviations_15min = na
var array<ZonePair> cachedWickDeviations_15min = na
var array<ZonePair> cachedBodyDeviations_1600 = na
var array<ZonePair> cachedWickDeviations_1600 = na
var array<ZonePair> cachedBodyDeviations_0500 = na
var array<ZonePair> cachedWickDeviations_0500 = na
var array<ZonePair> cachedBodyDeviations_0600 = na
var array<ZonePair> cachedWickDeviations_0600 = na

// Constants for performance
BODY_SUFFIX = "B"
WICK_SUFFIX = "W"
ZONE_OFFSET_BARS = 1  // Width of offset zones in bars
ZONE_OFFSET_START = 0  // How many bars into the range before zones start (0 = at range end, 2 = 2 bars before range end)
DEVIATION_LINE_OPACITY = 60

// ═══════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════

// Style and formatting helpers
getLineStyle(string style) =>
    style == "Solid" ? line.style_solid : style == "Dotted" ? line.style_dotted : line.style_dashed

getLabelSize(string sizeStr) =>
    sizeStr == "Tiny" ? size.tiny : sizeStr == "Small" ? size.small : sizeStr == "Normal" ? size.normal : size.large

// Parsing helpers
parseTimeToMinutes(string timeStr) =>
    hour = str.tonumber(str.substring(timeStr, 0, 2))
    minute = str.tonumber(str.substring(timeStr, 3, 5))
    int(hour * 60 + minute)

parseDeviations(string devStr) =>
    devArray = array.new<float>()
    parts = str.split(devStr, ",")
    for part in parts
        trimmed = str.replace_all(part, " ", "")
        if trimmed != ""
            devArray.push(str.tonumber(trimmed))
    devArray

parseZonePairs(string zoneStr) =>
    pairArray = array.new<ZonePair>()
    pairs = str.split(zoneStr, ",")
    for pair in pairs
        trimmed = str.replace_all(pair, " ", "")
        if trimmed != "" and str.contains(trimmed, ":")
            levels = str.split(trimmed, ":")
            if array.size(levels) == 2
                fromVal = str.tonumber(array.get(levels, 0))
                toVal = str.tonumber(array.get(levels, 1))
                pairArray.push(ZonePair.new(fromVal, toVal))
    pairArray

toSansSerif(string inputStr) =>
    result = inputStr
    result := str.replace_all(result, "0", "𝟢")
    result := str.replace_all(result, "1", "𝟣")
    result := str.replace_all(result, "2", "𝟤")
    result := str.replace_all(result, "3", "𝟥")
    result := str.replace_all(result, "4", "𝟦")
    result := str.replace_all(result, "5", "𝟧")
    result := str.replace_all(result, "6", "𝟨")
    result := str.replace_all(result, "7", "𝟩")
    result := str.replace_all(result, "8", "𝟪")
    result := str.replace_all(result, "9", "𝟫")
    result

// Drawing helpers
drawDeviationZones(SessionData sess, float high, float low, float height, array<ZonePair> zonePairs, color deviationColor, int startBarOffset, int endBarOffset) =>
    if array.size(zonePairs) > 0
        for i = 0 to array.size(zonePairs) - 1
            pair = array.get(zonePairs, i)
            fromDev = pair.fromLevel
            toDev = pair.toLevel

            // Draw above deviation zone
            aboveFrom = high + (height * fromDev)
            aboveTo = high + (height * toDev)
            aboveBox = box.new(sess.startBar + startBarOffset, aboveFrom, sess.endBar + endBarOffset, aboveTo, bgcolor=deviationColor, border_color=na, extend=extend.none)
            sess.deviationBoxes.push(aboveBox)

            // Draw below deviation zone
            belowFrom = low - (height * fromDev)
            belowTo = low - (height * toDev)
            belowBox = box.new(sess.startBar + startBarOffset, belowFrom, sess.endBar + endBarOffset, belowTo, bgcolor=deviationColor, border_color=na, extend=extend.none)
            sess.deviationBoxes.push(belowBox)

drawDeviations(SessionData sess, float high, float low, float height, color lineColor, string lineStyle, int lineWidth, bool showLabels, string labelSize, string labelPosition, color labelColor, string suffix, int startBarOffset, int endBarOffset) =>
    if array.size(cachedDevLevels) > 0
        for j = 0 to array.size(cachedDevLevels) - 1
            dev = array.get(cachedDevLevels, j)

            // Draw above deviation
            aboveLevel = high + (height * dev)
            aboveLine = line.new(sess.startBar + startBarOffset, aboveLevel, sess.endBar + endBarOffset, aboveLevel, color=lineColor, style=getLineStyle(lineStyle), width=lineWidth)
            sess.lines.push(aboveLine)

            if showLabels
                labelX = labelPosition == "Left" ? sess.startBar + startBarOffset : sess.endBar + endBarOffset
                labelText = toSansSerif("+" + str.tostring(dev) + suffix)
                labelStyle = labelPosition == "Left" ? label.style_label_right : label.style_label_left
                aboveLabel = label.new(labelX, aboveLevel, labelText, style=labelStyle, color=color.new(chart.bg_color, 0), textcolor=labelColor, size=getLabelSize(labelSize))
                sess.labels.push(aboveLabel)

            // Draw below deviation
            belowLevel = low - (height * dev)
            belowLine = line.new(sess.startBar + startBarOffset, belowLevel, sess.endBar + endBarOffset, belowLevel, color=lineColor, style=getLineStyle(lineStyle), width=lineWidth)
            sess.lines.push(belowLine)

            if showLabels
                labelX = labelPosition == "Left" ? sess.startBar + startBarOffset : sess.endBar + endBarOffset
                labelText = toSansSerif("-" + str.tostring(dev) + suffix)
                labelStyle = labelPosition == "Left" ? label.style_label_right : label.style_label_left
                belowLabel = label.new(labelX, belowLevel, labelText, style=labelStyle, color=color.new(chart.bg_color, 0), textcolor=labelColor, size=getLabelSize(labelSize))
                sess.labels.push(belowLabel)

drawCoreBox(SessionData sess, float highPrice, float lowPrice) =>
    coreBox = box.new(sess.startBar, highPrice, sess.endBar, lowPrice, bgcolor=sess.coreColor, border_color=na)
    topLine = line.new(sess.startBar, highPrice, sess.endBar, highPrice, color=color.new(color.gray, 50), style=line.style_dotted, width=1)
    bottomLine = line.new(sess.startBar, lowPrice, sess.endBar, lowPrice, color=color.new(color.gray, 50), style=line.style_dotted, width=1)
    sess.lines.push(topLine)
    sess.lines.push(bottomLine)
    coreBox

calculateOffsets(SessionData sess, bool isBody) =>
    useOffset = sess.useOffset and sess.showBody and sess.showWick
    int startOffset = 0
    int endOffset = 0

    if useOffset
        rangeWidth = sess.endBar - sess.startBar
        if isBody
            startOffset := rangeWidth - ZONE_OFFSET_START
            endOffset := rangeWidth - ZONE_OFFSET_START + ZONE_OFFSET_BARS
        else
            startOffset := -(rangeWidth - ZONE_OFFSET_START + ZONE_OFFSET_BARS)
            endOffset := -(rangeWidth - ZONE_OFFSET_START)

    [startOffset, endOffset]

getDeviationConfig(string sessionName, bool isBody) =>
    if sessionName == SESSION_1600
        isBody ? cachedBodyDeviations_1600 : cachedWickDeviations_1600
    else if sessionName == SESSION_0500
        isBody ? cachedBodyDeviations_0500 : cachedWickDeviations_0500
    else if sessionName == SESSION_0600
        isBody ? cachedBodyDeviations_0600 : cachedWickDeviations_0600
    else
        isBody ? cachedBodyDeviations_15min : cachedWickDeviations_15min

drawCoreWithDeviations(SessionData sess, float highPrice, float lowPrice, float height, bool isBody) =>
    [startOffset, endOffset] = calculateOffsets(sess, isBody)
    labelPosition = (sess.showBody and sess.showWick) ? (isBody ? "Right" : "Left") : "Left"
    suffix = isBody ? BODY_SUFFIX : WICK_SUFFIX
    deviationsToUse = getDeviationConfig(sess.sessionName, isBody)

    drawDeviations(sess, highPrice, lowPrice, height, color.new(labelColor, DEVIATION_LINE_OPACITY), "Dotted", 1, sess.showDeviationLabels, "Tiny", labelPosition, labelColor, suffix, startOffset, endOffset)
    drawDeviationZones(sess, highPrice, lowPrice, height, deviationsToUse, sess.deviationColor, startOffset, endOffset)

deleteSession(SessionData sess) =>
    if not na(sess.bodyBox)
        box.delete(sess.bodyBox)
    if not na(sess.wickBox)
        box.delete(sess.wickBox)
    for l in sess.lines
        line.delete(l)
    for lbl in sess.labels
        label.delete(lbl)
    for db in sess.deviationBoxes
        box.delete(db)

// ═══════════════════════════════════════════════════════════════════════════
// INITIALIZATION
// ═══════════════════════════════════════════════════════════════════════════

if na(cachedDevLevels)
    cachedDevLevels := parseDeviations(deviations)
    cachedBodyDeviations_15min := parseZonePairs(bodyDeviations_15min)
    cachedWickDeviations_15min := parseZonePairs(wickDeviations_15min)
    cachedBodyDeviations_1600 := parseZonePairs(bodyDeviations_1600)
    cachedWickDeviations_1600 := parseZonePairs(wickDeviations_1600)
    cachedBodyDeviations_0500 := parseZonePairs(bodyDeviations_0500)
    cachedWickDeviations_0500 := parseZonePairs(wickDeviations_0500)
    cachedBodyDeviations_0600 := parseZonePairs(bodyDeviations_0600)
    cachedWickDeviations_0600 := parseZonePairs(wickDeviations_0600)

// ═══════════════════════════════════════════════════════════════════════════
// SESSION CONFIGURATION
// ═══════════════════════════════════════════════════════════════════════════

var array<string> openingSessions_mode = array.from(opening_2015, opening_0215, opening_0915, opening_1315, opening_1600, opening_0500, opening_0600)
var array<bool> openingSessions_offset = array.from(opening_2015_offset, opening_0215_offset, opening_0915_offset, opening_1315_offset, opening_1600_offset, opening_0500_offset, opening_0600_offset)
var array<bool> openingSessions_showLabels = array.from(opening_2015_showLabels, opening_0215_showLabels, opening_0915_showLabels, opening_1315_showLabels, opening_1600_showLabels, opening_0500_showLabels, opening_0600_showLabels)
var array<int> openingSessions_startMin = array.from(1200, 120, 540, 780, 960, 300, 360)
var array<int> openingSessions_endMin = array.from(1215, 135, 555, 795, 300, 555, 540)
var array<color> openingSessions_coreColor = array.from(opening_2015_coreColor, opening_0215_coreColor, opening_0915_coreColor, opening_1315_coreColor, opening_1600_coreColor, opening_0500_coreColor, opening_0600_coreColor)
var array<color> openingSessions_deviationColor = array.from(opening_2015_deviationColor, opening_0215_deviationColor, opening_0915_deviationColor, opening_1315_deviationColor, opening_1600_deviationColor, opening_0500_deviationColor, opening_0600_deviationColor)
var array<string> openingSessions_name = array.from(SESSION_2015, SESSION_0215, SESSION_0915, SESSION_1315, SESSION_1600, SESSION_0500, SESSION_0600)

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 1: SESSION DETECTION - Detect new sessions starting
// ═══════════════════════════════════════════════════════════════════════════

barMinutes = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
prevBarMinutes = hour(time[1], "America/New_York") * 60 + minute(time[1], "America/New_York")

for i = 0 to array.size(openingSessions_mode) - 1
    mode = array.get(openingSessions_mode, i)

    if mode != OPT_OFF
        startMin = array.get(openingSessions_startMin, i)
        endMin = array.get(openingSessions_endMin, i)

        // Handle midnight-crossing sessions (e.g., 16:00-05:00)
        crossesMidnight = endMin < startMin

        // Check if we're entering this session
        currentlyInSession = crossesMidnight ? (barMinutes >= startMin or barMinutes <= endMin) : (barMinutes >= startMin and barMinutes <= endMin)
        previouslyInSession = crossesMidnight ? (prevBarMinutes >= startMin or prevBarMinutes <= endMin) : (prevBarMinutes >= startMin and prevBarMinutes <= endMin)
        sessionStarted = currentlyInSession and not previouslyInSession

        if sessionStarted
            // Create new session and add to active sessions
            coreColor = array.get(openingSessions_coreColor, i)
            deviationColor = array.get(openingSessions_deviationColor, i)
            sessionName = array.get(openingSessions_name, i)
            useOffset = array.get(openingSessions_offset, i)
            showDeviationLabels = array.get(openingSessions_showLabels, i)
            showBody = mode == OPT_BODY or mode == OPT_BOTH
            showWick = mode == OPT_WICK or mode == OPT_BOTH

            newSession = SessionData.new(
                 sessionIndex=i,
                 startBar=bar_index,
                 endBar=na,
                 bodyHigh=math.max(open, close),
                 bodyLow=math.min(open, close),
                 wickHigh=high,
                 wickLow=low,
                 bodyBox=na,
                 wickBox=na,
                 lines=array.new<line>(),
                 labels=array.new<label>(),
                 deviationBoxes=array.new<box>(),
                 coreColor=coreColor,
                 deviationColor=deviationColor,
                 sessionName=sessionName,
                 useOffset=useOffset,
                 showBody=showBody,
                 showWick=showWick,
                 showDeviationLabels=showDeviationLabels
             )

            array.push(activeSessions, newSession)

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 2: SESSION TRACKING - Update all active sessions
// ═══════════════════════════════════════════════════════════════════════════

if array.size(activeSessions) > 0
    for sess in activeSessions
        idx = sess.sessionIndex
        startMin = array.get(openingSessions_startMin, idx)
        endMin = array.get(openingSessions_endMin, idx)

        // Handle midnight-crossing sessions
        crossesMidnight = endMin < startMin

        // Check if current bar is within this session's time range
        isBarInSession = crossesMidnight ? (barMinutes >= startMin or barMinutes <= endMin) : (barMinutes >= startMin and barMinutes <= endMin)

        if isBarInSession
            // Update session high/low values with current bar
            sess.bodyHigh := math.max(sess.bodyHigh, math.max(open, close))
            sess.bodyLow := math.min(sess.bodyLow, math.min(open, close))
            sess.wickHigh := math.max(sess.wickHigh, high)
            sess.wickLow := math.min(sess.wickLow, low)

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 3: SESSION FINALIZATION - Finalize and remove ended sessions
// ═══════════════════════════════════════════════════════════════════════════

if array.size(activeSessions) > 0
    for i = array.size(activeSessions) - 1 to 0
        sess = array.get(activeSessions, i)
        idx = sess.sessionIndex
        startMin = array.get(openingSessions_startMin, idx)
        endMin = array.get(openingSessions_endMin, idx)

        // Handle midnight-crossing sessions
        crossesMidnight = endMin < startMin

        // Detect session end transition
        isCurrentBarInSession = crossesMidnight ? (barMinutes >= startMin or barMinutes <= endMin) : (barMinutes >= startMin and barMinutes <= endMin)
        wasPreviousBarInSession = crossesMidnight ? (prevBarMinutes >= startMin or prevBarMinutes <= endMin) : (prevBarMinutes >= startMin and prevBarMinutes <= endMin)
        hasSessionEnded = not isCurrentBarInSession and wasPreviousBarInSession

        if hasSessionEnded
            // Finalize session - calculate heights and draw visualizations
            sess.endBar := bar_index - 1

            bodyHeight = sess.bodyHigh - sess.bodyLow
            wickHeight = sess.wickHigh - sess.wickLow

            // Draw body core with deviations
            sess.bodyBox := drawCoreBox(sess, sess.bodyHigh, sess.bodyLow)
            if sess.showBody
                drawCoreWithDeviations(sess, sess.bodyHigh, sess.bodyLow, bodyHeight, true)

            // Draw wick core with deviations
            sess.wickBox := drawCoreBox(sess, sess.wickHigh, sess.wickLow)
            if sess.showWick
                drawCoreWithDeviations(sess, sess.wickHigh, sess.wickLow, wickHeight, false)

            // Draw session name label
            if showLabels
                labelX = math.round((sess.startBar + sess.endBar) / 2)
                sessionLabel = label.new(labelX, sess.wickHigh, sess.sessionName, style=label.style_label_down, textcolor=labelColor, size=size.small, color=color.new(chart.bg_color, 0), textalign=text.align_center)
                sess.labels.push(sessionLabel)

            // Add to completed sessions
            sessions.push(sess)

            // Remove oldest session of this type if limit exceeded
            sessionsOfThisType = 0
            for s in sessions
                if s.sessionIndex == sess.sessionIndex
                    sessionsOfThisType += 1

            if sessionsOfThisType > maxSessions
                // Find and delete the oldest session of this type
                for j = 0 to array.size(sessions) - 1
                    oldSession = array.get(sessions, j)
                    if oldSession.sessionIndex == sess.sessionIndex
                        deleteSession(oldSession)
                        array.remove(sessions, j)
                        break

            // Remove from active sessions
            array.remove(activeSessions, i)
