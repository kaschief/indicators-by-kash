// ═══════════════════════════════════════════════════════════════════════════
// SESSION VARIABLES
// ═══════════════════════════════════════════════════════════════════════════

var array<SessionData> sessions = array.new<SessionData>()
var array<SessionData> activeSessions = array.new<SessionData>()

// Cached parsed deviation zones (unified - body = wick for all sessions)
var array<DeviationZone> cachedDeviations_intraday = na
var array<DeviationZone> cachedDeviations_0500_0915 = na
var array<DeviationZone> cachedDeviations_0600_0900 = na
var array<DeviationZone> cachedDeviations_0930_0945 = na
var array<DeviationZone> cachedDeviations_0930_1000 = na
var array<DeviationZone> cachedDeviations_1600_0500 = na
var array<DeviationZone> cachedDeviations_1800_2100 = na
var array<DeviationZone> cachedDeviations_0500_0745 = na

// Constants for performance
BODY_SUFFIX = "B"
WICK_SUFFIX = "W"
ZONE_OFFSET_BARS = 1  // Width of offset zones in bars
ZONE_OFFSET_START = 0  // How many bars into the range before zones start (0 = at range end, 2 = 2 bars before range end)
DEVIATION_LINE_OPACITY = 60
BAR_MS = int(timeframe.in_seconds() * 1000)

// ═══════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════

// Style and formatting helpers
getLabelSize(string sizeStr) =>
    sizeStr == "Tiny" ? size.tiny : sizeStr == "Small" ? size.small : sizeStr == "Normal" ? size.normal : size.large

// Parsing helpers
parseTimeToMinutes(string timeStr) =>
    hour = str.tonumber(str.substring(timeStr, 0, 2))
    minute = str.tonumber(str.substring(timeStr, 3, 5))
    int(hour * 60 + minute)

toSansSerif(string inputStr) =>
    result = inputStr
    result := str.replace_all(result, "0", "𝟢")
    result := str.replace_all(result, "1", "𝟣")
    result := str.replace_all(result, "2", "𝟤")
    result := str.replace_all(result, "3", "𝟥")
    result := str.replace_all(result, "4", "𝟦")
    result := str.replace_all(result, "5", "𝟧")
    result := str.replace_all(result, "6", "𝟨")
    result := str.replace_all(result, "7", "𝟩")
    result := str.replace_all(result, "8", "𝟪")
    result := str.replace_all(result, "9", "𝟫")
    result

// Convert a bar offset to a time offset (used for xloc.bar_time drawing)
timeWithOffset(int baseTime, int barOffset) =>
    baseTime + barOffset * BAR_MS

// Parse deviation string into ordered array of DeviationZone entries
// Example: "1, 2:2.5, 4:4.5" → [{1,1,false}, {2,2.5,true}, {4,4.5,true}]
parseDeviationZones(string deviationStr) =>
    zones = array.new<DeviationZone>()
    tokens = str.split(deviationStr, ",")
    for token in tokens
        trimmed = str.replace_all(token, " ", "")
        if trimmed != ""
            if str.contains(trimmed, ":")
                // Range like "2:2.5"
                parts = str.split(trimmed, ":")
                if array.size(parts) == 2
                    innerVal = str.tonumber(array.get(parts, 0))
                    outerVal = str.tonumber(array.get(parts, 1))
                    zones.push(DeviationZone.new(innerVal, outerVal, true))
            else
                // Single level like "1"
                level = str.tonumber(trimmed)
                zones.push(DeviationZone.new(level, level, false))
    zones

// Drawing helper - unified function for all deviation zones (singles and ranges)
drawDeviations(SessionData sess, float high, float low, float height, array<DeviationZone> zones, color deviationColor, color lineColor, bool showLabels, string labelSize, string labelPosition, color labelColor, string suffix, int startBarOffset, int endBarOffset, bool drawAbove, bool drawBelow) =>
    if array.size(zones) > 0 and (drawAbove or drawBelow)
        // Pre-compute label positioning (shared across all labels)
        baseLabelTime = labelPosition == "Left" ? sess.startTime : sess.endTime
        labelOffset = labelPosition == "Left" ? startBarOffset : endBarOffset
        labelX = timeWithOffset(baseLabelTime, labelOffset)
        labelStyle = labelPosition == "Left" ? label.style_label_right : label.style_label_left
        lblSize = getLabelSize(labelSize)

        for zone in zones
            if zone.isRange
                // Draw range as box with labels at both edges
                if drawAbove
                    aboveFrom = high + (height * zone.innerLevel)
                    aboveTo = high + (height * zone.outerLevel)
                    sess.deviationBoxes.push(box.new(timeWithOffset(sess.startTime, startBarOffset), aboveFrom, timeWithOffset(sess.endTime, endBarOffset), aboveTo, bgcolor=deviationColor, border_color=na, xloc=xloc.bar_time))
                    if showLabels
                        sess.labels.push(label.new(labelX, aboveFrom, toSansSerif("+" + str.tostring(zone.innerLevel) + suffix), style=labelStyle, color=labelsBgColor, textcolor=labelColor, size=lblSize, xloc=xloc.bar_time))
                        sess.labels.push(label.new(labelX, aboveTo, toSansSerif("+" + str.tostring(zone.outerLevel) + suffix), style=labelStyle, color=labelsBgColor, textcolor=labelColor, size=lblSize, xloc=xloc.bar_time))

                if drawBelow
                    belowFrom = low - (height * zone.innerLevel)
                    belowTo = low - (height * zone.outerLevel)
                    sess.deviationBoxes.push(box.new(timeWithOffset(sess.startTime, startBarOffset), belowFrom, timeWithOffset(sess.endTime, endBarOffset), belowTo, bgcolor=deviationColor, border_color=na, xloc=xloc.bar_time))
                    if showLabels
                        sess.labels.push(label.new(labelX, belowFrom, toSansSerif("-" + str.tostring(zone.innerLevel) + suffix), style=labelStyle, color=labelsBgColor, textcolor=labelColor, size=lblSize, xloc=xloc.bar_time))
                        sess.labels.push(label.new(labelX, belowTo, toSansSerif("-" + str.tostring(zone.outerLevel) + suffix), style=labelStyle, color=labelsBgColor, textcolor=labelColor, size=lblSize, xloc=xloc.bar_time))
            else
                // Draw single level as line + label
                dev = zone.outerLevel

                if drawAbove
                    aboveLevel = high + (height * dev)
                    sess.lines.push(line.new(timeWithOffset(sess.startTime, startBarOffset), aboveLevel, timeWithOffset(sess.endTime, endBarOffset), aboveLevel, color=lineColor, style=line.style_dotted, width=1, xloc=xloc.bar_time))
                    if showLabels
                        sess.labels.push(label.new(labelX, aboveLevel, toSansSerif("+" + str.tostring(dev) + suffix), style=labelStyle, color=labelsBgColor, textcolor=labelColor, size=lblSize, xloc=xloc.bar_time))

                if drawBelow
                    belowLevel = low - (height * dev)
                    sess.lines.push(line.new(timeWithOffset(sess.startTime, startBarOffset), belowLevel, timeWithOffset(sess.endTime, endBarOffset), belowLevel, color=lineColor, style=line.style_dotted, width=1, xloc=xloc.bar_time))
                    if showLabels
                        sess.labels.push(label.new(labelX, belowLevel, toSansSerif("-" + str.tostring(dev) + suffix), style=labelStyle, color=labelsBgColor, textcolor=labelColor, size=lblSize, xloc=xloc.bar_time))

drawCoreBox(SessionData sess, float highPrice, float lowPrice) =>
    coreBox = box.new(sess.startTime, highPrice, sess.endTime, lowPrice, bgcolor=sess.coreColor, border_color=na, xloc=xloc.bar_time)
    topLine = line.new(sess.startTime, highPrice, sess.endTime, highPrice, color=color.new(color.gray, 50), style=line.style_dotted, width=1, xloc=xloc.bar_time)
    bottomLine = line.new(sess.startTime, lowPrice, sess.endTime, lowPrice, color=color.new(color.gray, 50), style=line.style_dotted, width=1, xloc=xloc.bar_time)
    sess.lines.push(topLine)
    sess.lines.push(bottomLine)
    coreBox

calculateOffsets(SessionData sess, bool isBody) =>
    useOffset = sess.useOffset and sess.showBody and sess.showWick
    int startOffset = 0
    int endOffset = 0

    if useOffset
        rangeWidth = sess.endBar - sess.startBar
        if isBody
            startOffset := rangeWidth - ZONE_OFFSET_START
            endOffset := rangeWidth - ZONE_OFFSET_START + ZONE_OFFSET_BARS
        else
            startOffset := -(rangeWidth - ZONE_OFFSET_START + ZONE_OFFSET_BARS)
            endOffset := -(rangeWidth - ZONE_OFFSET_START)

    [startOffset, endOffset]

// Get cached deviation zones (avoids re-parsing strings on every bar)
getCachedZones(string sessionName) =>
    if sessionName == SESSION_EXTENDED_1600_0500
        cachedDeviations_1600_0500
    else if sessionName == SESSION_EXTENDED_0500_0915
        cachedDeviations_0500_0915
    else if sessionName == SESSION_EXTENDED_0600_0900
        cachedDeviations_0600_0900
    else if sessionName == SESSION_EXTENDED_0930_0945
        cachedDeviations_0930_0945
    else if sessionName == SESSION_EXTENDED_0930_1000
        cachedDeviations_0930_1000
    else if sessionName == SESSION_EXTENDED_1800_2100
        cachedDeviations_1800_2100
    else if sessionName == SESSION_EXTENDED_0500_0745
        cachedDeviations_0500_0745
    else
        cachedDeviations_intraday

// Check if session is an intraday session (shares common deviation metric)
isIntradaySession(string sessionName) =>
    sessionName == SESSION_INTRADAY_2015 or sessionName == SESSION_INTRADAY_2200 or sessionName == SESSION_INTRADAY_0215 or sessionName == SESSION_INTRADAY_0915 or sessionName == SESSION_INTRADAY_1230 or sessionName == SESSION_INTRADAY_1415

drawCoreWithDeviations(SessionData sess, float highPrice, float lowPrice, float height, bool isBody) =>
    [startOffset, endOffset] = calculateOffsets(sess, isBody)
    labelPos = (sess.showBody and sess.showWick) ? (isBody ? "Right" : "Left") : "Left"
    suffix = isBody ? BODY_SUFFIX : WICK_SUFFIX
    zones = getCachedZones(sess.sessionName)

    // Determine whether to show labels based on dropdown value and body/wick type
    showLbls = sess.showDeviationLabels == OPT_BOTH or (sess.showDeviationLabels == OPT_BODY and isBody) or (sess.showDeviationLabels == OPT_WICK and not isBody)

    // Draw all deviation zones with same color
    drawDeviations(sess, highPrice, lowPrice, height, zones, sess.deviationColor, color.new(labelColor, DEVIATION_LINE_OPACITY), showLbls, "Tiny", labelPos, labelColor, suffix, startOffset, endOffset, true, true)

deleteSession(SessionData sess) =>
    if not na(sess.bodyBox)
        box.delete(sess.bodyBox)
    if not na(sess.wickBox)
        box.delete(sess.wickBox)
    for l in sess.lines
        line.delete(l)
    for lbl in sess.labels
        label.delete(lbl)
    for db in sess.deviationBoxes
        box.delete(db)
    // Delete mitigation lines
    if not na(sess.highMitigationLine)
        line.delete(sess.highMitigationLine)
    if not na(sess.lowMitigationLine)
        line.delete(sess.lowMitigationLine)
    if not na(sess.midMitigationLine)
        line.delete(sess.midMitigationLine)
    // Delete proximity lines
    if not na(sess.highProximityLine)
        line.delete(sess.highProximityLine)
    if not na(sess.lowProximityLine)
        line.delete(sess.lowProximityLine)

// Clear live drawings from active session (keeps session data, just removes visuals for redraw)
clearLiveDrawings(SessionData sess) =>
    if not na(sess.bodyBox)
        box.delete(sess.bodyBox)
        sess.bodyBox := na
    if not na(sess.wickBox)
        box.delete(sess.wickBox)
        sess.wickBox := na
    for l in sess.lines
        line.delete(l)
    array.clear(sess.lines)
    for lbl in sess.labels
        label.delete(lbl)
    array.clear(sess.labels)
    for db in sess.deviationBoxes
        box.delete(db)
    array.clear(sess.deviationBoxes)

// Draw live deviations for active session (uses current bar time as end time)
drawLiveSessionDeviations(SessionData sess, int currentTime, int currentBarIndex) =>
    // Set temporary end values for drawing
    sess.endTime := currentTime
    sess.endBar := currentBarIndex

    // Calculate heights
    bodyHeight = sess.bodyHigh - sess.bodyLow
    wickHeight = sess.wickHigh - sess.wickLow

    // Draw body core with deviations
    if sess.showBody
        sess.bodyBox := drawCoreBox(sess, sess.bodyHigh, sess.bodyLow)
        if sess.drawDeviations
            drawCoreWithDeviations(sess, sess.bodyHigh, sess.bodyLow, bodyHeight, true)

    // Draw wick core with deviations
    if sess.showWick
        sess.wickBox := drawCoreBox(sess, sess.wickHigh, sess.wickLow)
        if sess.drawDeviations
            drawCoreWithDeviations(sess, sess.wickHigh, sess.wickLow, wickHeight, false)

// ═══════════════════════════════════════════════════════════════════════════
// INITIALIZATION
// ═══════════════════════════════════════════════════════════════════════════

if na(cachedDeviations_intraday)
    cachedDeviations_intraday := parseDeviationZones(deviations_intraday)
    cachedDeviations_0500_0915 := parseDeviationZones(deviations_0500_0915)
    cachedDeviations_0600_0900 := parseDeviationZones(deviations_0600_0900)
    cachedDeviations_0930_0945 := parseDeviationZones(deviations_0930_0945)
    cachedDeviations_0930_1000 := parseDeviationZones(deviations_0930_1000)
    cachedDeviations_1600_0500 := parseDeviationZones(deviations_1600_0500)
    cachedDeviations_1800_2100 := parseDeviationZones(deviations_1800_2100)
    cachedDeviations_0500_0745 := parseDeviationZones(deviations_0500_0745)

// ═══════════════════════════════════════════════════════════════════════════
// QUICK FILTER LOGIC
// ═══════════════════════════════════════════════════════════════════════════

// Session indices: 0=20:15, 1=22:00, 2=02:15, 3=09:15, 4=12:30, 5=14:15, 6=NY Early Hours, 7=Overnight, 8=Premarket, 9=NY Open 15m, 10=NY Open 30m, 11=Asia Open, 12=Mini ONS
isInFilter(int idx) =>
    if quickFilter == FILTER_OFF
        true
    else if quickFilter == FILTER_1800
        idx == 11
    else if quickFilter == FILTER_DAILY_1800
        idx == 1 or idx == 11
    else if quickFilter == FILTER_DAILY_1800_EARLY
        idx == 1 or idx == 6 or idx == 11
    else if quickFilter == FILTER_OVERNIGHT_NY_EARLY
        idx == 6 or idx == 7
    else if quickFilter == FILTER_OVERNIGHT_MINI_EARLY
        idx == 6 or idx == 7 or idx == 12
    else if quickFilter == FILTER_OVERNIGHT_POST_LATE_NY
        idx == 7 or idx == 10
    else if quickFilter == FILTER_DAILY_MINI_EARLY
        idx == 1 or idx == 6 or idx == 12
    else if quickFilter == FILTER_DAILY_915
        idx == 1 or idx == 3
    else if quickFilter == FILTER_FULL_NYAM
        idx == 3 or idx == 6 or idx == 9 or idx == 10 or idx == 12
    else if quickFilter == FILTER_PRE_LATE_NY
        idx == 9
    else if quickFilter == FILTER_LATE_NY
        idx == 9 or idx == 10
    else if quickFilter == FILTER_POST_LATE_NY
        idx == 10
    else
        true

