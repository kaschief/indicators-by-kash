// ═══════════════════════════════════════════════════════════════════════════
// SESSION VARIABLES
// ═══════════════════════════════════════════════════════════════════════════

var array<SessionData> sessions = array.new<SessionData>()
var array<SessionData> activeSessions = array.new<SessionData>()

var array<ZonePair> cachedBodyDeviations_15min = na
var array<ZonePair> cachedWickDeviations_15min = na
var array<ZonePair> cachedBodyDeviations_1600 = na
var array<ZonePair> cachedWickDeviations_1600 = na
var array<ZonePair> cachedBodyDeviations_0500 = na
var array<ZonePair> cachedWickDeviations_0500 = na
var array<ZonePair> cachedBodyDeviations_0600 = na
var array<ZonePair> cachedWickDeviations_0600 = na
var array<ZonePair> cachedBodyDeviations_0930_0945 = na
var array<ZonePair> cachedWickDeviations_0930_0945 = na
var array<ZonePair> cachedBodyDeviations_0930_1000 = na
var array<ZonePair> cachedWickDeviations_0930_1000 = na

// Constants for performance
BODY_SUFFIX = "B"
WICK_SUFFIX = "W"
ZONE_OFFSET_BARS = 1  // Width of offset zones in bars
ZONE_OFFSET_START = 0  // How many bars into the range before zones start (0 = at range end, 2 = 2 bars before range end)
DEVIATION_LINE_OPACITY = 60

// ═══════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════

// Style and formatting helpers
getLineStyle(string style) =>
    style == "Solid" ? line.style_solid : style == "Dotted" ? line.style_dotted : line.style_dashed

getLabelSize(string sizeStr) =>
    sizeStr == "Tiny" ? size.tiny : sizeStr == "Small" ? size.small : sizeStr == "Normal" ? size.normal : size.large

// Parsing helpers
parseTimeToMinutes(string timeStr) =>
    hour = str.tonumber(str.substring(timeStr, 0, 2))
    minute = str.tonumber(str.substring(timeStr, 3, 5))
    int(hour * 60 + minute)

parseZonePairs(string zoneStr) =>
    pairArray = array.new<ZonePair>()
    pairs = str.split(zoneStr, ",")
    for pair in pairs
        trimmed = str.replace_all(pair, " ", "")
        if trimmed != "" and str.contains(trimmed, ":")
            levels = str.split(trimmed, ":")
            if array.size(levels) == 2
                fromVal = str.tonumber(array.get(levels, 0))
                toVal = str.tonumber(array.get(levels, 1))
                pairArray.push(ZonePair.new(fromVal, toVal))
    pairArray

toSansSerif(string inputStr) =>
    result = inputStr
    result := str.replace_all(result, "0", "𝟢")
    result := str.replace_all(result, "1", "𝟣")
    result := str.replace_all(result, "2", "𝟤")
    result := str.replace_all(result, "3", "𝟥")
    result := str.replace_all(result, "4", "𝟦")
    result := str.replace_all(result, "5", "𝟧")
    result := str.replace_all(result, "6", "𝟨")
    result := str.replace_all(result, "7", "𝟩")
    result := str.replace_all(result, "8", "𝟪")
    result := str.replace_all(result, "9", "𝟫")
    result

// Parse deviation string to extract all explicit levels (singles + range endpoints)
// Example: "1, 2:2.5, 4:4.5" → [1.0, 2.0, 2.5, 4.0, 4.5]
parseAllLevels(string deviationStr) =>
    levels = array.new<float>()
    tokens = str.split(deviationStr, ",")
    for token in tokens
        trimmed = str.replace_all(token, " ", "")
        if trimmed != ""
            if str.contains(trimmed, ":")
                // Range like "2:2.5" - extract both endpoints
                parts = str.split(trimmed, ":")
                if array.size(parts) == 2
                    fromVal = str.tonumber(array.get(parts, 0))
                    toVal = str.tonumber(array.get(parts, 1))
                    if not array.includes(levels, fromVal)
                        levels.push(fromVal)
                    if not array.includes(levels, toVal)
                        levels.push(toVal)
            else
                // Single value like "1"
                singleVal = str.tonumber(trimmed)
                if not array.includes(levels, singleVal)
                    levels.push(singleVal)
    levels

// Drawing helpers
drawDeviationZones(SessionData sess, float high, float low, float height, array<ZonePair> zonePairs, color deviationColor, int startBarOffset, int endBarOffset) =>
    if array.size(zonePairs) > 0
        for i = 0 to array.size(zonePairs) - 1
            pair = array.get(zonePairs, i)
            fromDev = pair.fromLevel
            toDev = pair.toLevel

            // Draw above deviation zone
            aboveFrom = high + (height * fromDev)
            aboveTo = high + (height * toDev)
            aboveBox = box.new(sess.startBar + startBarOffset, aboveFrom, sess.endBar + endBarOffset, aboveTo, bgcolor=deviationColor, border_color=na, extend=extend.none)
            sess.deviationBoxes.push(aboveBox)

            // Draw below deviation zone
            belowFrom = low - (height * fromDev)
            belowTo = low - (height * toDev)
            belowBox = box.new(sess.startBar + startBarOffset, belowFrom, sess.endBar + endBarOffset, belowTo, bgcolor=deviationColor, border_color=na, extend=extend.none)
            sess.deviationBoxes.push(belowBox)

drawDeviations(SessionData sess, float high, float low, float height, color lineColor, string lineStyle, int lineWidth, bool showLabels, string labelSize, string labelPosition, color labelColor, string suffix, int startBarOffset, int endBarOffset, array<float> deviationLevels) =>
    if array.size(deviationLevels) > 0
        for j = 0 to array.size(deviationLevels) - 1
            dev = array.get(deviationLevels, j)

            // Draw above deviation
            aboveLevel = high + (height * dev)
            aboveLine = line.new(sess.startBar + startBarOffset, aboveLevel, sess.endBar + endBarOffset, aboveLevel, color=lineColor, style=getLineStyle(lineStyle), width=lineWidth)
            sess.lines.push(aboveLine)

            if showLabels
                labelX = labelPosition == "Left" ? sess.startBar + startBarOffset : sess.endBar + endBarOffset
                labelText = toSansSerif("+" + str.tostring(dev) + suffix)
                labelStyle = labelPosition == "Left" ? label.style_label_right : label.style_label_left
                aboveLabel = label.new(labelX, aboveLevel, labelText, style=labelStyle, color=color.new(chart.bg_color, 0), textcolor=labelColor, size=getLabelSize(labelSize))
                sess.labels.push(aboveLabel)

            // Draw below deviation
            belowLevel = low - (height * dev)
            belowLine = line.new(sess.startBar + startBarOffset, belowLevel, sess.endBar + endBarOffset, belowLevel, color=lineColor, style=getLineStyle(lineStyle), width=lineWidth)
            sess.lines.push(belowLine)

            if showLabels
                labelX = labelPosition == "Left" ? sess.startBar + startBarOffset : sess.endBar + endBarOffset
                labelText = toSansSerif("-" + str.tostring(dev) + suffix)
                labelStyle = labelPosition == "Left" ? label.style_label_right : label.style_label_left
                belowLabel = label.new(labelX, belowLevel, labelText, style=labelStyle, color=color.new(chart.bg_color, 0), textcolor=labelColor, size=getLabelSize(labelSize))
                sess.labels.push(belowLabel)

drawCoreBox(SessionData sess, float highPrice, float lowPrice) =>
    coreBox = box.new(sess.startBar, highPrice, sess.endBar, lowPrice, bgcolor=sess.coreColor, border_color=na)
    topLine = line.new(sess.startBar, highPrice, sess.endBar, highPrice, color=color.new(color.gray, 50), style=line.style_dotted, width=1)
    bottomLine = line.new(sess.startBar, lowPrice, sess.endBar, lowPrice, color=color.new(color.gray, 50), style=line.style_dotted, width=1)
    sess.lines.push(topLine)
    sess.lines.push(bottomLine)
    coreBox

calculateOffsets(SessionData sess, bool isBody) =>
    useOffset = sess.useOffset and sess.showBody and sess.showWick
    int startOffset = 0
    int endOffset = 0

    if useOffset
        rangeWidth = sess.endBar - sess.startBar
        if isBody
            startOffset := rangeWidth - ZONE_OFFSET_START
            endOffset := rangeWidth - ZONE_OFFSET_START + ZONE_OFFSET_BARS
        else
            startOffset := -(rangeWidth - ZONE_OFFSET_START + ZONE_OFFSET_BARS)
            endOffset := -(rangeWidth - ZONE_OFFSET_START)

    [startOffset, endOffset]

getDeviationString(string sessionName, bool isBody) =>
    if sessionName == SESSION_EXTENDED_1600_0500
        isBody ? bodyDeviations_1600 : wickDeviations_1600
    else if sessionName == SESSION_EXTENDED_0500_0915
        isBody ? bodyDeviations_0500 : wickDeviations_0500
    else if sessionName == SESSION_EXTENDED_0600_0900
        isBody ? bodyDeviations_0600 : wickDeviations_0600
    else if sessionName == SESSION_EXTENDED_0930_0945
        isBody ? bodyDeviations_0930_0945 : wickDeviations_0930_0945
    else if sessionName == SESSION_EXTENDED_0930_1000
        isBody ? bodyDeviations_0930_1000 : wickDeviations_0930_1000
    else
        isBody ? bodyDeviations_15min : wickDeviations_15min

drawCoreWithDeviations(SessionData sess, float highPrice, float lowPrice, float height, bool isBody) =>
    [startOffset, endOffset] = calculateOffsets(sess, isBody)
    labelPosition = (sess.showBody and sess.showWick) ? (isBody ? "Right" : "Left") : "Left"
    suffix = isBody ? BODY_SUFFIX : WICK_SUFFIX
    deviationStr = getDeviationString(sess.sessionName, isBody)
    zonePairs = parseZonePairs(deviationStr)
    deviationLevels = parseAllLevels(deviationStr)

    // Determine whether to show labels based on dropdown value and body/wick type
    showLabels = sess.showDeviationLabels == OPT_BOTH or (sess.showDeviationLabels == OPT_BODY and isBody) or (sess.showDeviationLabels == OPT_WICK and not isBody)

    drawDeviations(sess, highPrice, lowPrice, height, color.new(labelColor, DEVIATION_LINE_OPACITY), "Dotted", 1, showLabels, "Tiny", labelPosition, labelColor, suffix, startOffset, endOffset, deviationLevels)
    drawDeviationZones(sess, highPrice, lowPrice, height, zonePairs, sess.deviationColor, startOffset, endOffset)

deleteSession(SessionData sess) =>
    if not na(sess.bodyBox)
        box.delete(sess.bodyBox)
    if not na(sess.wickBox)
        box.delete(sess.wickBox)
    for l in sess.lines
        line.delete(l)
    for lbl in sess.labels
        label.delete(lbl)
    for db in sess.deviationBoxes
        box.delete(db)

// ═══════════════════════════════════════════════════════════════════════════
// INITIALIZATION
// ═══════════════════════════════════════════════════════════════════════════

if na(cachedBodyDeviations_15min)
    cachedBodyDeviations_15min := parseZonePairs(bodyDeviations_15min)
    cachedWickDeviations_15min := parseZonePairs(wickDeviations_15min)
    cachedBodyDeviations_1600 := parseZonePairs(bodyDeviations_1600)
    cachedWickDeviations_1600 := parseZonePairs(wickDeviations_1600)
    cachedBodyDeviations_0500 := parseZonePairs(bodyDeviations_0500)
    cachedWickDeviations_0500 := parseZonePairs(wickDeviations_0500)
    cachedBodyDeviations_0600 := parseZonePairs(bodyDeviations_0600)
    cachedWickDeviations_0600 := parseZonePairs(wickDeviations_0600)
    cachedBodyDeviations_0930_0945 := parseZonePairs(bodyDeviations_0930_0945)
    cachedWickDeviations_0930_0945 := parseZonePairs(wickDeviations_0930_0945)
    cachedBodyDeviations_0930_1000 := parseZonePairs(bodyDeviations_0930_1000)
    cachedWickDeviations_0930_1000 := parseZonePairs(wickDeviations_0930_1000)

// ═══════════════════════════════════════════════════════════════════════════
// SESSION CONFIGURATION
// ═══════════════════════════════════════════════════════════════════════════

var array<string> openingSessions_mode = array.from(opening_2015, opening_0215, opening_0915, opening_0600, opening_1600, opening_0500, opening_0930_0945, opening_0930_1000)
var array<bool> openingSessions_offset = array.from(opening_2015_offset, opening_0215_offset, opening_0915_offset, opening_0600_offset, opening_1600_offset, opening_0500_offset, opening_0930_0945_offset, opening_0930_1000_offset)
var array<string> openingSessions_showLabels = array.from(opening_2015_showLabels, opening_0215_showLabels, opening_0915_showLabels, opening_0600_showLabels, opening_1600_showLabels, opening_0500_showLabels, opening_0930_0945_showLabels, opening_0930_1000_showLabels)
var array<int> openingSessions_startMin = array.from(1200, 120, 540, 360, 960, 300, 570, 570)
var array<int> openingSessions_endMin = array.from(1215, 135, 555, 540, 300, 555, 585, 600)
var array<color> openingSessions_coreColor = array.from(opening_2015_coreColor, opening_0215_coreColor, opening_0915_coreColor, opening_0600_coreColor, opening_1600_coreColor, opening_0500_coreColor, opening_0930_0945_coreColor, opening_0930_1000_coreColor)
var array<color> openingSessions_deviationColor = array.from(opening_2015_deviationColor, opening_0215_deviationColor, opening_0915_deviationColor, opening_0600_deviationColor, opening_1600_deviationColor, opening_0500_deviationColor, opening_0930_0945_deviationColor, opening_0930_1000_deviationColor)
var array<string> openingSessions_name = array.from(SESSION_INTRADAY_2015, SESSION_INTRADAY_0215, SESSION_INTRADAY_0915, SESSION_EXTENDED_0600_0900, SESSION_EXTENDED_1600_0500, SESSION_EXTENDED_0500_0915, SESSION_EXTENDED_0930_0945, SESSION_EXTENDED_0930_1000)
var array<string> openingSessions_labelPosition = array.from(opening_2015_labelPosition, opening_0215_labelPosition, opening_0915_labelPosition, opening_0600_labelPosition, opening_1600_labelPosition, opening_0500_labelPosition, opening_0930_0945_labelPosition, opening_0930_1000_labelPosition)

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 1: SESSION DETECTION - Detect new sessions starting
// ═══════════════════════════════════════════════════════════════════════════

barMinutes = validTimeframe ? hour(time, "America/New_York") * 60 + minute(time, "America/New_York") : 0
prevBarMinutes = validTimeframe ? hour(time[1], "America/New_York") * 60 + minute(time[1], "America/New_York") : 0

if validTimeframe
    for i = 0 to array.size(openingSessions_mode) - 1
        mode = array.get(openingSessions_mode, i)

        if mode != OPT_OFF
            startMin = array.get(openingSessions_startMin, i)
            endMin = array.get(openingSessions_endMin, i)

            // Handle midnight-crossing sessions (e.g., 16:00-05:00)
            crossesMidnight = endMin < startMin

            // Check if we're entering this session
            currentlyInSession = crossesMidnight ? (barMinutes >= startMin or barMinutes <= endMin) : (barMinutes >= startMin and barMinutes <= endMin)
            previouslyInSession = crossesMidnight ? (prevBarMinutes >= startMin or prevBarMinutes <= endMin) : (prevBarMinutes >= startMin and prevBarMinutes <= endMin)
            sessionStarted = currentlyInSession and not previouslyInSession

            if sessionStarted
                // Create new session and add to active sessions
                coreColor = array.get(openingSessions_coreColor, i)
                deviationColor = array.get(openingSessions_deviationColor, i)
                sessionName = array.get(openingSessions_name, i)
                useOffset = array.get(openingSessions_offset, i)
                showDeviationLabels = array.get(openingSessions_showLabels, i)
                labelPosition = array.get(openingSessions_labelPosition, i)
                showBody = mode == OPT_BODY or mode == OPT_BOTH
                showWick = mode == OPT_WICK or mode == OPT_BOTH

                newSession = SessionData.new(
                     sessionIndex=i,
                     startBar=bar_index,
                     endBar=na,
                     bodyHigh=math.max(open, close),
                     bodyLow=math.min(open, close),
                     wickHigh=high,
                     wickLow=low,
                     bodyBox=na,
                     wickBox=na,
                     lines=array.new<line>(),
                     labels=array.new<label>(),
                     deviationBoxes=array.new<box>(),
                     coreColor=coreColor,
                     deviationColor=deviationColor,
                     sessionName=sessionName,
                     useOffset=useOffset,
                     showBody=showBody,
                     showWick=showWick,
                     showDeviationLabels=showDeviationLabels,
                     labelPosition=labelPosition
                 )

                array.push(activeSessions, newSession)

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 2: SESSION TRACKING - Update all active sessions
// ═══════════════════════════════════════════════════════════════════════════

if validTimeframe and array.size(activeSessions) > 0
    for sess in activeSessions
        idx = sess.sessionIndex
        startMin = array.get(openingSessions_startMin, idx)
        endMin = array.get(openingSessions_endMin, idx)

        // Handle midnight-crossing sessions
        crossesMidnight = endMin < startMin

        // Check if current bar is within this session's time range
        isBarInSession = crossesMidnight ? (barMinutes >= startMin or barMinutes <= endMin) : (barMinutes >= startMin and barMinutes <= endMin)

        if isBarInSession
            // Update session high/low values with current bar
            sess.bodyHigh := math.max(sess.bodyHigh, math.max(open, close))
            sess.bodyLow := math.min(sess.bodyLow, math.min(open, close))
            sess.wickHigh := math.max(sess.wickHigh, high)
            sess.wickLow := math.min(sess.wickLow, low)

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 3: SESSION FINALIZATION - Finalize and remove ended sessions
// ═══════════════════════════════════════════════════════════════════════════

if validTimeframe and array.size(activeSessions) > 0
    for i = array.size(activeSessions) - 1 to 0
        sess = array.get(activeSessions, i)
        idx = sess.sessionIndex
        startMin = array.get(openingSessions_startMin, idx)
        endMin = array.get(openingSessions_endMin, idx)

        // Handle midnight-crossing sessions
        crossesMidnight = endMin < startMin

        // Detect session end transition
        isCurrentBarInSession = crossesMidnight ? (barMinutes >= startMin or barMinutes <= endMin) : (barMinutes >= startMin and barMinutes <= endMin)
        wasPreviousBarInSession = crossesMidnight ? (prevBarMinutes >= startMin or prevBarMinutes <= endMin) : (prevBarMinutes >= startMin and prevBarMinutes <= endMin)
        hasSessionEnded = not isCurrentBarInSession and wasPreviousBarInSession

        if hasSessionEnded
            // Finalize session - calculate heights and draw visualizations
            sess.endBar := bar_index - 1

            bodyHeight = sess.bodyHigh - sess.bodyLow
            wickHeight = sess.wickHigh - sess.wickLow

            // Draw body core with deviations
            sess.bodyBox := drawCoreBox(sess, sess.bodyHigh, sess.bodyLow)
            if sess.showBody
                drawCoreWithDeviations(sess, sess.bodyHigh, sess.bodyLow, bodyHeight, true)

            // Draw wick core with deviations
            sess.wickBox := drawCoreBox(sess, sess.wickHigh, sess.wickLow)
            if sess.showWick
                drawCoreWithDeviations(sess, sess.wickHigh, sess.wickLow, wickHeight, false)

            // Draw session name label
            if showLabels
                labelX = math.round((sess.startBar + sess.endBar) / 2)
                labelY = sess.labelPosition == OPT_ABOVE ? sess.wickHigh : sess.wickLow
                labelStyle = sess.labelPosition == OPT_ABOVE ? label.style_label_down : label.style_label_up
                sessionLabel = label.new(labelX, labelY, sess.sessionName, style=labelStyle, textcolor=labelColor, size=size.tiny, color=color.new(chart.bg_color, 0), textalign=text.align_center)
                sess.labels.push(sessionLabel)

            // Add to completed sessions
            sessions.push(sess)

            // Remove oldest session of this type if limit exceeded
            sessionsOfThisType = 0
            for s in sessions
                if s.sessionIndex == sess.sessionIndex
                    sessionsOfThisType += 1

            if sessionsOfThisType > maxSessions
                // Find and delete the oldest session of this type
                for j = 0 to array.size(sessions) - 1
                    oldSession = array.get(sessions, j)
                    if oldSession.sessionIndex == sess.sessionIndex
                        deleteSession(oldSession)
                        array.remove(sessions, j)
                        break

            // Remove from active sessions
            array.remove(activeSessions, i)

// ═══════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE
// ═══════════════════════════════════════════════════════════════════════════

if validTimeframe and showColorTable and barstate.islast
    var table colorTable = table.new(position.top_right, 4, 17, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

    // Header row
    table.cell(colorTable, 0, 0, "Session", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 1, 0, "Type", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 2, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 3, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)

    // 20:15 Session
    table.cell(colorTable, 0, 1, "20:15", text_size=size.small)
    table.cell(colorTable, 1, 1, "Core", text_size=size.small)
    table.cell(colorTable, 2, 1, str.format("R:{0} G:{1} B:{2}", int(color.r(opening_2015_coreColor)), int(color.g(opening_2015_coreColor)), int(color.b(opening_2015_coreColor))), text_size=size.small)
    table.cell(colorTable, 3, 1, str.tostring(int(color.t(opening_2015_coreColor))), text_size=size.small)

    table.cell(colorTable, 0, 2, "20:15", text_size=size.small)
    table.cell(colorTable, 1, 2, "Deviation", text_size=size.small)
    table.cell(colorTable, 2, 2, str.format("R:{0} G:{1} B:{2}", int(color.r(opening_2015_deviationColor)), int(color.g(opening_2015_deviationColor)), int(color.b(opening_2015_deviationColor))), text_size=size.small)
    table.cell(colorTable, 3, 2, str.tostring(int(color.t(opening_2015_deviationColor))), text_size=size.small)

    // 02:15 Session
    table.cell(colorTable, 0, 3, "02:15", text_size=size.small)
    table.cell(colorTable, 1, 3, "Core", text_size=size.small)
    table.cell(colorTable, 2, 3, str.format("R:{0} G:{1} B:{2}", int(color.r(opening_0215_coreColor)), int(color.g(opening_0215_coreColor)), int(color.b(opening_0215_coreColor))), text_size=size.small)
    table.cell(colorTable, 3, 3, str.tostring(int(color.t(opening_0215_coreColor))), text_size=size.small)

    table.cell(colorTable, 0, 4, "02:15", text_size=size.small)
    table.cell(colorTable, 1, 4, "Deviation", text_size=size.small)
    table.cell(colorTable, 2, 4, str.format("R:{0} G:{1} B:{2}", int(color.r(opening_0215_deviationColor)), int(color.g(opening_0215_deviationColor)), int(color.b(opening_0215_deviationColor))), text_size=size.small)
    table.cell(colorTable, 3, 4, str.tostring(int(color.t(opening_0215_deviationColor))), text_size=size.small)

    // 09:15 Session
    table.cell(colorTable, 0, 5, "09:15", text_size=size.small)
    table.cell(colorTable, 1, 5, "Core", text_size=size.small)
    table.cell(colorTable, 2, 5, str.format("R:{0} G:{1} B:{2}", int(color.r(opening_0915_coreColor)), int(color.g(opening_0915_coreColor)), int(color.b(opening_0915_coreColor))), text_size=size.small)
    table.cell(colorTable, 3, 5, str.tostring(int(color.t(opening_0915_coreColor))), text_size=size.small)

    table.cell(colorTable, 0, 6, "09:15", text_size=size.small)
    table.cell(colorTable, 1, 6, "Deviation", text_size=size.small)
    table.cell(colorTable, 2, 6, str.format("R:{0} G:{1} B:{2}", int(color.r(opening_0915_deviationColor)), int(color.g(opening_0915_deviationColor)), int(color.b(opening_0915_deviationColor))), text_size=size.small)
    table.cell(colorTable, 3, 6, str.tostring(int(color.t(opening_0915_deviationColor))), text_size=size.small)

    // Overnight Session
    table.cell(colorTable, 0, 7, "Overnight", text_size=size.small)
    table.cell(colorTable, 1, 7, "Core", text_size=size.small)
    table.cell(colorTable, 2, 7, str.format("R:{0} G:{1} B:{2}", int(color.r(opening_1600_coreColor)), int(color.g(opening_1600_coreColor)), int(color.b(opening_1600_coreColor))), text_size=size.small)
    table.cell(colorTable, 3, 7, str.tostring(int(color.t(opening_1600_coreColor))), text_size=size.small)

    table.cell(colorTable, 0, 8, "Overnight", text_size=size.small)
    table.cell(colorTable, 1, 8, "Deviation", text_size=size.small)
    table.cell(colorTable, 2, 8, str.format("R:{0} G:{1} B:{2}", int(color.r(opening_1600_deviationColor)), int(color.g(opening_1600_deviationColor)), int(color.b(opening_1600_deviationColor))), text_size=size.small)
    table.cell(colorTable, 3, 8, str.tostring(int(color.t(opening_1600_deviationColor))), text_size=size.small)

    // Premarket Session
    table.cell(colorTable, 0, 9, "Premarket", text_size=size.small)
    table.cell(colorTable, 1, 9, "Core", text_size=size.small)
    table.cell(colorTable, 2, 9, str.format("R:{0} G:{1} B:{2}", int(color.r(opening_0500_coreColor)), int(color.g(opening_0500_coreColor)), int(color.b(opening_0500_coreColor))), text_size=size.small)
    table.cell(colorTable, 3, 9, str.tostring(int(color.t(opening_0500_coreColor))), text_size=size.small)

    table.cell(colorTable, 0, 10, "Premarket", text_size=size.small)
    table.cell(colorTable, 1, 10, "Deviation", text_size=size.small)
    table.cell(colorTable, 2, 10, str.format("R:{0} G:{1} B:{2}", int(color.r(opening_0500_deviationColor)), int(color.g(opening_0500_deviationColor)), int(color.b(opening_0500_deviationColor))), text_size=size.small)
    table.cell(colorTable, 3, 10, str.tostring(int(color.t(opening_0500_deviationColor))), text_size=size.small)

    // NY Early Hours Session
    table.cell(colorTable, 0, 11, "NY Early Hours", text_size=size.small)
    table.cell(colorTable, 1, 11, "Core", text_size=size.small)
    table.cell(colorTable, 2, 11, str.format("R:{0} G:{1} B:{2}", int(color.r(opening_0600_coreColor)), int(color.g(opening_0600_coreColor)), int(color.b(opening_0600_coreColor))), text_size=size.small)
    table.cell(colorTable, 3, 11, str.tostring(int(color.t(opening_0600_coreColor))), text_size=size.small)

    table.cell(colorTable, 0, 12, "NY Early Hours", text_size=size.small)
    table.cell(colorTable, 1, 12, "Deviation", text_size=size.small)
    table.cell(colorTable, 2, 12, str.format("R:{0} G:{1} B:{2}", int(color.r(opening_0600_deviationColor)), int(color.g(opening_0600_deviationColor)), int(color.b(opening_0600_deviationColor))), text_size=size.small)
    table.cell(colorTable, 3, 12, str.tostring(int(color.t(opening_0600_deviationColor))), text_size=size.small)

    // NY Open 15m Session
    table.cell(colorTable, 0, 13, "NY Open 15m", text_size=size.small)
    table.cell(colorTable, 1, 13, "Core", text_size=size.small)
    table.cell(colorTable, 2, 13, str.format("R:{0} G:{1} B:{2}", int(color.r(opening_0930_0945_coreColor)), int(color.g(opening_0930_0945_coreColor)), int(color.b(opening_0930_0945_coreColor))), text_size=size.small)
    table.cell(colorTable, 3, 13, str.tostring(int(color.t(opening_0930_0945_coreColor))), text_size=size.small)

    table.cell(colorTable, 0, 14, "NY Open 15m", text_size=size.small)
    table.cell(colorTable, 1, 14, "Deviation", text_size=size.small)
    table.cell(colorTable, 2, 14, str.format("R:{0} G:{1} B:{2}", int(color.r(opening_0930_0945_deviationColor)), int(color.g(opening_0930_0945_deviationColor)), int(color.b(opening_0930_0945_deviationColor))), text_size=size.small)
    table.cell(colorTable, 3, 14, str.tostring(int(color.t(opening_0930_0945_deviationColor))), text_size=size.small)

    // NY Open 30m Session
    table.cell(colorTable, 0, 15, "NY Open 30m", text_size=size.small)
    table.cell(colorTable, 1, 15, "Core", text_size=size.small)
    table.cell(colorTable, 2, 15, str.format("R:{0} G:{1} B:{2}", int(color.r(opening_0930_1000_coreColor)), int(color.g(opening_0930_1000_coreColor)), int(color.b(opening_0930_1000_coreColor))), text_size=size.small)
    table.cell(colorTable, 3, 15, str.tostring(int(color.t(opening_0930_1000_coreColor))), text_size=size.small)

    table.cell(colorTable, 0, 16, "NY Open 30m", text_size=size.small)
    table.cell(colorTable, 1, 16, "Deviation", text_size=size.small)
    table.cell(colorTable, 2, 16, str.format("R:{0} G:{1} B:{2}", int(color.r(opening_0930_1000_deviationColor)), int(color.g(opening_0930_1000_deviationColor)), int(color.b(opening_0930_1000_deviationColor))), text_size=size.small)
    table.cell(colorTable, 3, 16, str.tostring(int(color.t(opening_0930_1000_deviationColor))), text_size=size.small)
