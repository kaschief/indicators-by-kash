//@version=6
indicator("deviations •", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════
// TIMEFRAME RESTRICTION
// ═══════════════════════════════════════════════════════════════════════════

// Only allow 1-5 minute timeframes
validTimeframe = timeframe.period == "1" or timeframe.period == "2" or timeframe.period == "3" or timeframe.period == "4" or timeframe.period == "5"

// ═══════════════════════════════════════════════════════════════════════════
// TYPE DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════════

type DeviationZone
    float innerLevel   // Start of range (or the level itself for singles)
    float outerLevel   // End of range (same as innerLevel for singles)
    bool isRange       // true = range like 2:2.5, false = single like 1

type SessionData
    int sessionIndex
    int startBar
    int endBar
    int startTime
    int endTime
    float bodyHigh
    float bodyLow
    float wickHigh
    float wickLow
    float bodyHeight
    float wickHeight
    box bodyBox
    box wickBox
    array<line> lines
    array<label> labels
    array<box> deviationBoxes
    color coreColor
    color deviationColor
    string sessionName
    string chartLabel
    bool useOffset
    bool showBody
    bool showWick
    bool drawDeviations
    string showDeviationLabels
    string labelPosition
    // Mitigation tracking
    bool showMitigation
    color mitigationColor
    float dominantHigh
    float dominantLow
    int highBar
    int lowBar
    int highTime
    int lowTime
    bool highMitigated
    bool lowMitigated
    int highMitigationBar
    int lowMitigationBar
    line highMitigationLine
    line lowMitigationLine
    // Unmitigated level lines
    line highUnmitigatedLine
    line lowUnmitigatedLine
    label highUnmitigatedLabel
    label lowUnmitigatedLabel
    // 50% mitigation tracking
    float midLevel
    bool midMitigated
    line midMitigationLine
    // Proximity tracking (ATR-based)
    line highProximityLine
    line lowProximityLine
    // Alerts
    bool enableAlert

// ═══════════════════════════════════════════════════════════════════════════
// UI STRING CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════

// Group names
GROUP_GENERAL = "General"
GROUP_INTRADAY = "Intraday Sessions"
GROUP_1600_0500 = "Extended Opening: Overnight (16:00–05:00)"
GROUP_0500_0915 = "Extended Opening: Premarket (05:00–09:15)"
GROUP_0600_0900 = "Extended Opening: NY Early Hours (06:00–09:00)"
GROUP_0930_0945 = "Extended Opening: NY Open 15m (09:30–09:45)"
GROUP_0930_1000 = "Extended Opening: NY Open 30m (09:30–10:00)"
GROUP_1800_2100 = "Extended Opening: Asia Open (18:00–21:00)"
GROUP_0500_0745 = "Extended Opening: Mini ONS (05:00–07:45)"
GROUP_COLOR_TABLE = "Color Reference Table"

// Common input labels
LABEL_SESSIONS = "No. Of Sessions"
LABEL_SHOW_SESSION_NAMES = "Show Session Names"
LABEL_SESSION_NAME_POSITION = "Session Name"
LABEL_LABEL_COLOR = "Label Color"
LABEL_CORE = "Core"
LABEL_DEVIATIONS = "Deviations"
LABEL_DEVIATION_LABELS = "Dev. Label"
LABEL_OFFSET = "Offset"

// Session UI labels (shown in settings panel)
SESSION_INTRADAY_2015 = "20:15"
SESSION_INTRADAY_2200 = "22:00"
SESSION_INTRADAY_0215 = "02:15"
SESSION_INTRADAY_0915 = "09:15"
SESSION_INTRADAY_1230 = "12:30"
SESSION_INTRADAY_1415 = "14:15"
SESSION_EXTENDED_1600_0500 = "Overnight"
SESSION_EXTENDED_0500_0915 = "Premarket"
SESSION_EXTENDED_0600_0900 = "NY Early Hours"
SESSION_EXTENDED_0930_0945 = "NY Open 15m"
SESSION_EXTENDED_0930_1000 = "NY Open 30m"
SESSION_EXTENDED_1800_2100 = "Asia Open"
SESSION_EXTENDED_0500_0745 = "Mini ONS"

// Chart labels (shown on the chart - can be different/multi-line)
CHART_LABEL_2015 = "20:15"
CHART_LABEL_2200 = "22:00\n\nDaily H/L"
CHART_LABEL_0215 = "02:15"
CHART_LABEL_0915 = "09:15"
CHART_LABEL_1230 = "12:30"
CHART_LABEL_1415 = "14:15"
CHART_LABEL_1600_0500 = "Overnight"
CHART_LABEL_0500_0915 = "Premarket"
CHART_LABEL_0600_0900 = "NY Early Hours"
CHART_LABEL_0930_0945 = "NY Open 15m"
CHART_LABEL_0930_1000 = "NY Open 30m"
CHART_LABEL_1800_2100 = "Asia Open"
CHART_LABEL_0500_0745 = "Mini ONS"

// Alert messages
ALERT_HIGH_MITIGATED = " High Mitigated"
ALERT_LOW_MITIGATED = " Low Mitigated"
ALERT_MID_MITIGATED_FROM_ABOVE = " 50% Mitigated from Above"
ALERT_MID_MITIGATED_FROM_BELOW = " 50% Mitigated from Below"

// Style constants
MITIGATION_LINE_WIDTH = 2
MITIGATION_50_LINE_WIDTH = 2
PROXIMITY_LINE_WIDTH = 1

// Proximity detection constants
PROXIMITY_ATR_PERIOD = 15
PROXIMITY_ATR_MULTIPLIER = 3.5
PROXIMITY_LOOKBACK = 3

// Tooltips
TOOLTIP_MAX_SESSIONS = "Max number of sessions to display per opening type"
TOOLTIP_SHOW_SESSION_NAMES = "Show session name labels"

// Option values
OPT_OFF = "Off"
OPT_CORE = "Core"
OPT_BODY = "Body"
OPT_WICK = "Wick"
OPT_BOTH = "Both"
OPT_ABOVE = "Above"
OPT_BELOW = "Below"

// Global mitigation display mode
MIT_MITIGATED = "Mitigated"
MIT_UNMITIGATED = "Unmitigated"

// Quick filter presets (ordered: Asia → Overnight → Pre-NY → NY Session → Late NY)
FILTER_OFF = "Off"
FILTER_1800 = "1800 Range"
FILTER_DAILY_1800 = "Daily HL + 1800 Range"
FILTER_DAILY_1800_EARLY = "Daily HL + 1800 Range + Early"
FILTER_OVERNIGHT_NY_EARLY = "Overnight + Early"
FILTER_OVERNIGHT_MINI_EARLY = "Overnight + Mini + Early"
FILTER_OVERNIGHT_POST_LATE_NY = "Overnight + Post-Late NY"
FILTER_DAILY_MINI_EARLY = "Daily HL + Mini + Early"
FILTER_DAILY_915 = "Daily HL + 915"
FILTER_FULL_NYAM = "Full NYAM"
FILTER_PRE_LATE_NY = "Pre-Late NY"
FILTER_LATE_NY = "Late NY"
FILTER_POST_LATE_NY = "Post-Late NY"

// Default deviation zones (unified - body = wick for all sessions)
// Ordered by proportion: A-D start at quarter (0.25), E-F start at one (1)
DEV_A_0500_0915 = "0.25:0.5, 0.75:1"                     // Premarket (05:00-09:15)
DEV_B_0930_1000 = "0.25:0.5, 1:1.25"                     // NY Open 30m (09:30-10:00)
DEV_C = "0.25:0.5, 1.33:1.66"                            // NY Early Hours
DEV_D_1800_2100 = "0.25:0.5, 1:1.25, 1.33:1.66"          // Asia Open (18:00-21:00)
DEV_E_0930_0945 = "1, 2:2.5"                             // NY Open 15m (09:30-09:45)
DEV_F_INTRADAY = "1, 2:2.5, 4:4.5"                       // Intraday sessions, Mini ONS
DEV_G_OVERNIGHT = "0.25:0.5, 0.75:1, 1.25:1.5"           // Overnight (16:00-05:00)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS - General Settings
// ═══════════════════════════════════════════════════════════════════════════

quickFilter = input.string(FILTER_OFF, "Quick Filter", options=[FILTER_OFF, FILTER_1800, FILTER_DAILY_1800, FILTER_DAILY_1800_EARLY, FILTER_OVERNIGHT_NY_EARLY, FILTER_OVERNIGHT_MINI_EARLY, FILTER_OVERNIGHT_POST_LATE_NY, FILTER_DAILY_MINI_EARLY, FILTER_DAILY_915, FILTER_FULL_NYAM, FILTER_PRE_LATE_NY, FILTER_LATE_NY, FILTER_POST_LATE_NY], group=GROUP_GENERAL, tooltip="Filter presets:\n• 1800 Range: Asia Open only\n• Daily HL + 1800 Range: 22:00, Asia Open\n• Daily HL + 1800 Range + Early: 22:00, Asia Open, NY Early Hours\n• Overnight + Early: Overnight, NY Early Hours\n• Overnight + Mini + Early: Overnight, Mini ONS, NY Early Hours\n• Overnight + Post-Late NY: Overnight, NY Open 30m\n• Daily HL + Mini + Early: 22:00, Mini ONS, NY Early Hours\n• Daily HL + 915: 22:00, 09:15\n• Full NYAM: 09:15, NY Open 15m/30m, Mini ONS, NY Early Hours\n• Pre-Late NY: NY Open 15m only\n• Late NY: NY Open 15m + 30m\n• Post-Late NY: NY Open 30m only")
mitigationMode = input.string(MIT_MITIGATED, "Mitigation Mode", options=[MIT_MITIGATED, MIT_UNMITIGATED], group=GROUP_GENERAL, tooltip="Mitigated: Show lines when levels are touched\nUnmitigated: Show persistent lines for untouched levels")
maxSessions = input.int(5, LABEL_SESSIONS, group=GROUP_GENERAL, tooltip=TOOLTIP_MAX_SESSIONS, minval=1, maxval=50)
showLabels = input.bool(true, LABEL_SHOW_SESSION_NAMES, group=GROUP_GENERAL, tooltip=TOOLTIP_SHOW_SESSION_NAMES)
labelColor = input.color(color.rgb(120, 123, 134), LABEL_LABEL_COLOR, group=GROUP_GENERAL)
labelsBgColor = input.color(color.new(color.rgb(245, 245, 245), 20), "Labels Background", group=GROUP_GENERAL, tooltip="Background color for session and deviation labels. Set transparency to 100 for no background.")
showProximity = input.bool(false, "Show Proximity Levels", group=GROUP_GENERAL, tooltip="Show dashed lines for unmitigated highs/lows within ATR range of current price")
showLiveDeviations = input.bool(true, "Show Live Deviations", group=GROUP_GENERAL, tooltip="Draw deviation levels in real-time during active sessions. Levels update as price makes new highs/lows. When disabled, deviations only appear after session ends.")

