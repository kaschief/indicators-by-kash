//@version=6
indicator("Kash Deviations° [Pro+]", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════
// TIMEFRAME RESTRICTION
// ═══════════════════════════════════════════════════════════════════════════

// Only allow 1-5 minute timeframes
validTimeframe = timeframe.period == "1" or timeframe.period == "2" or timeframe.period == "3" or timeframe.period == "4" or timeframe.period == "5"

// ═══════════════════════════════════════════════════════════════════════════
// TYPE DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════════

type ZonePair
    float fromLevel
    float toLevel

type SessionData
    int sessionIndex
    int startBar
    int endBar
    float bodyHigh
    float bodyLow
    float wickHigh
    float wickLow
    box bodyBox
    box wickBox
    array<line> lines
    array<label> labels
    array<box> deviationBoxes
    color coreColor
    color deviationColor
    string sessionName
    bool useOffset
    bool showBody
    bool showWick
    string showDeviationLabels
    string labelPosition

