new_manual_side() =>
    ManualSide.new(
        array.new<int>(), array.new<int>(), array.new<float>(), array.new<bool>(),
        array.new<int>(), array.new<int>(), array.new<line>(), array.new<label>(), array.new<int>())

new_manual_slot() =>
    ManualSlot.new(
        new_manual_side(), new_manual_side(),
        array.new<int>(), array.new<int>(), array.new<int>(), array.new<int>(), false)

var ManualSlot manual = new_manual_slot()

