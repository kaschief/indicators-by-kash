// ═══════════════════════════════════════════════════════════════════════════════
// DERIVED VALUES
// ═══════════════════════════════════════════════════════════════════════════════

chart_tf_seconds = timeframe.in_seconds(timeframe.period)
chart_tf_minutes = chart_tf_seconds / 60

// ═══════════════════════════════════════════════════════════════════════════════
// HTF VALIDATION SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

get_limit_zone() =>
    chart_tf_min = chart_tf_minutes
    switch
        chart_tf_min <= CHART_TF_3M  => "ultra_short"
        chart_tf_min == CHART_TF_5M  => "short"
        chart_tf_min == CHART_TF_10M => "short_med"
        chart_tf_min <= CHART_TF_30M => "medium"
        chart_tf_min <= CHART_TF_1H  => "medium_long"
        chart_tf_min <= CHART_TF_4H  => "long"
        chart_tf_min <= CHART_TF_1D  => "daily"
        chart_tf_min <= CHART_TF_1W  => "weekly"
        chart_tf_min >= CHART_TF_1MO => "monthly"
        => "extended"


get_max_allowed_htf() =>
    chart_tf_min = chart_tf_minutes
    switch
        chart_tf_min <= CHART_TF_3M  => TF_15M
        chart_tf_min == CHART_TF_5M  => TF_1H
        chart_tf_min == CHART_TF_10M => TF_2H
        chart_tf_min == CHART_TF_15M => TF_4H
        chart_tf_min == CHART_TF_30M => TF_4H
        chart_tf_min <= CHART_TF_1H  => TF_1D
        chart_tf_min <= CHART_TF_4H  => TF_1D
        chart_tf_min <= CHART_TF_1D  => TF_1W
        chart_tf_min <= CHART_TF_1W  => TF_3MO
        chart_tf_min >= CHART_TF_1MO => TF_3MO
        => TF_1Y


get_auto_htf_preferred() =>
    chart_tf_min = chart_tf_minutes
    switch
        chart_tf_min <= 2            => TF_15M
        chart_tf_min <= CHART_TF_5M  => TF_1H
        chart_tf_min <= CHART_TF_15M => TF_1H
        chart_tf_min <= CHART_TF_30M => TF_2H
        chart_tf_min <= CHART_TF_1H  => TF_4H
        chart_tf_min <= CHART_TF_4H  => TF_1D
        chart_tf_min <= CHART_TF_1D  => TF_1W
        chart_tf_min <= CHART_TF_1W  => TF_1MO
        chart_tf_min >= CHART_TF_1MO => TF_3MO
        => TF_1Y


validate_and_limit_htf() =>
    if htf1_auto
        limit_tf = get_max_allowed_htf()
        limit_seconds = timeframe.in_seconds(limit_tf)
        auto_tf = get_auto_htf_preferred()
        auto_seconds = timeframe.in_seconds(auto_tf)
        if auto_seconds > chart_tf_seconds and auto_seconds <= limit_seconds
            auto_tf
        else
            limit_tf
    else
        manual_seconds = timeframe.in_seconds(htf1_timeframe)
        if manual_seconds > chart_tf_seconds
            htf1_timeframe
        else
            get_max_allowed_htf()

validated_htf1_timeframe = validate_and_limit_htf()
htf1_is_valid = timeframe.in_seconds(validated_htf1_timeframe) > chart_tf_seconds
htf1_seconds = timeframe.in_seconds(validated_htf1_timeframe)
htf1_extension = 4

// ═══════════════════════════════════════════════════════════════════════════════
// DATA STRUCTURES
