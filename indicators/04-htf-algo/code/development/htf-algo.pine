// ═══════════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

to_tick(price) => math.round(price / syminfo.mintick)
from_tick(tick) => tick * syminfo.mintick

// TimePriceLevel helper functions
clear_time_level(TimePriceLevel level) =>
    array.clear(level.prices)
    array.clear(level.times)
    array.clear(level.mitigated)
    array.clear(level.mitigation_times)
    level.current_price := na
    level.current_time := na
    level.current_mitigated := false
    level.current_mitigation_time := na

prune_time_level(TimePriceLevel level) =>
    while array.size(level.prices) > MAX_STORED_LEVELS
        array.shift(level.prices)
        array.shift(level.times)
        array.shift(level.mitigated)
        array.shift(level.mitigation_times)

// SessionRangeLevel helper functions
clear_session_range_level(SessionRangeLevel level) =>
    level.session_high := na
    level.session_low := na
    level.session_high_time := na
    level.session_low_time := na
    level.in_session := false
    level.current_high := na
    level.current_low := na
    level.current_high_time := na
    level.current_low_time := na
    level.high_mitigated := false
    level.low_mitigated := false
    level.provisional_high_mitigated := false
    level.provisional_low_mitigated := false
    level.provisional_high_time := na
    level.provisional_low_time := na
    array.clear(level.highs)
    array.clear(level.lows)
    array.clear(level.high_times)
    array.clear(level.low_times)
    array.clear(level.highs_mitigated)
    array.clear(level.lows_mitigated)

prune_session_range_level(SessionRangeLevel level) =>
    while array.size(level.highs) > MAX_STORED_LEVELS
        array.shift(level.highs)
        array.shift(level.high_times)
        array.shift(level.highs_mitigated)
    while array.size(level.lows) > MAX_STORED_LEVELS
        array.shift(level.lows)
        array.shift(level.low_times)
        array.shift(level.lows_mitigated)
    while array.size(level.session_starts) > MAX_STORED_LEVELS
        array.shift(level.session_starts)

// Check if time is within session range (handles midnight crossing)
is_in_session_range(int hour_ny, int minute_ny, SessionRangeLevel level) =>
    int current_minutes = hour_ny * 60 + minute_ny
    int start_minutes = level.start_hour * 60 + level.start_minute
    int end_minutes = level.end_hour * 60 + level.end_minute
    if end_minutes > start_minutes
        // Normal session (doesn't cross midnight)
        current_minutes >= start_minutes and current_minutes < end_minutes
    else
        // Session crosses midnight
        current_minutes >= start_minutes or current_minutes < end_minutes

// Check if two timestamps are on the same calendar day (NY timezone)
is_same_calendar_day(int ts1, int ts2) =>
    dayofmonth(ts1, NY_TIMEZONE) == dayofmonth(ts2, NY_TIMEZONE) and
         month(ts1, NY_TIMEZONE) == month(ts2, NY_TIMEZONE) and
         year(ts1, NY_TIMEZONE) == year(ts2, NY_TIMEZONE)

// Check if bar is on the same trading day as session for mitigation purposes
// For midnight-crossing sessions: session day OR next day (until 16:00)
is_same_trading_day(int bar_time, int session_start, bool crosses_midnight) =>
    bool on_session_day = is_same_calendar_day(bar_time, session_start)
    if crosses_midnight
        int next_day_ts = session_start + 24 * 60 * 60 * 1000
        bool on_next_day = is_same_calendar_day(bar_time, next_day_ts)
        on_session_day or on_next_day
    else
        on_session_day

// Track session range level - handles state transitions, high/low updates, and mitigation
track_session_range_level(SessionRangeLevel level, int hour_ny, int minute_ny, float bar_high, float bar_low, int bar_time) =>
    bool currently_in_session = is_in_session_range(hour_ny, minute_ny, level)

    // Session state transitions
    if currently_in_session and not level.in_session
        // Session just started - archive previous session if exists
        if not na(level.current_high)
            array.push(level.highs, level.current_high)
            array.push(level.high_times, level.current_high_time)
            array.push(level.highs_mitigated, level.high_mitigated)
            array.push(level.session_starts, level.current_session_start)
        if not na(level.current_low)
            array.push(level.lows, level.current_low)
            array.push(level.low_times, level.current_low_time)
            array.push(level.lows_mitigated, level.low_mitigated)

        // Start tracking new session
        level.session_high := bar_high
        level.session_low := bar_low
        level.session_high_time := bar_time
        level.session_low_time := bar_time
        level.session_start_time := bar_time
        level.in_session := true

    else if currently_in_session and level.in_session
        // Within session - update high/low
        if bar_high > level.session_high
            level.session_high := bar_high
            level.session_high_time := bar_time
        if bar_low < level.session_low
            level.session_low := bar_low
            level.session_low_time := bar_time

    else if not currently_in_session and level.in_session
        // Session just ended - finalize current levels
        level.current_high := level.session_high
        level.current_low := level.session_low
        level.current_high_time := level.session_high_time
        level.current_low_time := level.session_low_time
        level.current_session_start := level.session_start_time
        level.high_mitigated := false
        level.low_mitigated := false
        level.provisional_high_mitigated := false
        level.provisional_low_mitigated := false
        level.provisional_high_time := na
        level.provisional_low_time := na
        level.in_session := false

    // Mitigation check for current level - uses delayed mitigation logic (like Deviations)
    // For delayed_mitigation sessions: only CONFIRM during 05:00-16:00 NY
    // Touches during overnight (same day, outside 05:00-16:00) are PROVISIONAL only
    if not na(level.current_high) and not level.in_session
        int bar_minutes = hour_ny * 60 + minute_ny
        // Same-day check: session day or next day for midnight-crossing + overnight window
        int next_day_ts = level.current_session_start + 24 * 60 * 60 * 1000
        bool is_on_session_day = is_same_calendar_day(bar_time, level.current_session_start)
        bool is_on_next_day = level.crosses_midnight and is_same_calendar_day(bar_time, next_day_ts)
        bool is_in_next_day_overnight = level.delayed_mitigation and is_same_calendar_day(bar_time, next_day_ts) and bar_minutes < PREMARKET_START_MIN
        bool is_on_actual_session_day = is_on_session_day or is_on_next_day or is_in_next_day_overnight

        // canEvaluateMitigation: can confirm mitigation (05:00-16:00 for delayed sessions, anytime otherwise)
        bool can_evaluate = not level.delayed_mitigation or (bar_minutes >= PREMARKET_START_MIN and bar_minutes < CLOSE_1600_MIN)
        // isInOvernightWindow: provisional only (same day, outside 05:00-16:00)
        bool is_overnight = level.delayed_mitigation and is_on_actual_session_day and not can_evaluate

        // HIGH mitigation
        if not level.high_mitigated
            if can_evaluate and bar_high >= level.current_high
                // Confirmed mitigation (during 05:00-16:00 or non-delayed session)
                level.high_mitigated := true
            else if is_overnight and bar_high >= level.current_high
                // Provisional breach during overnight - NOT confirmed yet
                if not level.provisional_high_mitigated
                    level.provisional_high_mitigated := true
                    level.provisional_high_time := bar_time
            else if bar_high >= level.current_high
                // Touched outside same-day window (days later) - confirm immediately
                level.high_mitigated := true

        // LOW mitigation
        if not level.low_mitigated
            if can_evaluate and bar_low <= level.current_low
                // Confirmed mitigation (during 05:00-16:00 or non-delayed session)
                level.low_mitigated := true
            else if is_overnight and bar_low <= level.current_low
                // Provisional breach during overnight - NOT confirmed yet
                if not level.provisional_low_mitigated
                    level.provisional_low_mitigated := true
                    level.provisional_low_time := bar_time
            else if bar_low <= level.current_low
                // Touched outside same-day window (days later) - confirm immediately
                level.low_mitigated := true

    // Check stored levels mitigation
    int stored_highs = array.size(level.highs)
    if stored_highs > 0
        int scan_size = math.min(stored_highs, 20)
        int start_index = math.max(0, stored_highs - scan_size)
        for i = start_index to stored_highs - 1
            if not array.get(level.highs_mitigated, i)
                if bar_high >= array.get(level.highs, i)
                    array.set(level.highs_mitigated, i, true)

    int stored_lows = array.size(level.lows)
    if stored_lows > 0
        int scan_size = math.min(stored_lows, 20)
        int start_index = math.max(0, stored_lows - scan_size)
        for i = start_index to stored_lows - 1
            if not array.get(level.lows_mitigated, i)
                if bar_low <= array.get(level.lows, i)
                    array.set(level.lows_mitigated, i, true)

    prune_session_range_level(level)

clear_htf_slot(HtfSlot slot) =>
    array.clear(slot.bsl_targets)
    array.clear(slot.bsl_open)
    array.clear(slot.bsl_detect_times)
    array.clear(slot.bsl_fill_times)
    array.clear(slot.ssl_targets)
    array.clear(slot.ssl_open)
    array.clear(slot.ssl_detect_times)
    array.clear(slot.ssl_fill_times)
    array.clear(slot.eligible_high_ticks)
    array.clear(slot.eligible_low_ticks)
    array.clear(slot.eligible_high_times)
    array.clear(slot.eligible_low_times)
    slot.has_history := false

get_size(string sz, bool bump) =>
    switch sz
        SIZE_TINY => bump ? size.small : size.tiny
        SIZE_SMALL => bump ? size.normal : size.small
        SIZE_NORMAL => bump ? size.large : size.normal
        SIZE_LARGE => bump ? size.huge : size.large
        => bump ? size.normal : size.small

get_tier_from_rank(int rank) =>
    if rank <= TIER_MACRO_MAX_RANK
        1
    else if rank <= TIER_SWING_MAX_RANK
        2
    else
        3

// Format HTF tags into a chain (e.g., "8H • 1H")
format_htf_chain(string htf_tags) =>
    if htf_tags == ""
        ""
    else
        tags_arr = str.split(htf_tags, ",")
        result = array.get(tags_arr, 0)
        if array.size(tags_arr) > 1
            for i = 1 to array.size(tags_arr) - 1
                result += LABEL_SEPARATOR + array.get(tags_arr, i)
        result

// Format session tags into a chain (e.g., "asia open | evening range")
format_session_chain(string session_tags) =>
    if session_tags == ""
        ""
    else
        tags_arr = str.split(session_tags, " / ")
        result = array.get(tags_arr, 0)
        if array.size(tags_arr) > 1
            for i = 1 to array.size(tags_arr) - 1
                result += LABEL_SESSION_SEPARATOR + array.get(tags_arr, i)
        result

// Format label: HTF tags with "algo draw", then session tags appended
format_level_label(string htf_tags, string session_tags) =>
    htf_chain = format_htf_chain(htf_tags)
    session_chain = format_session_chain(session_tags)

    if htf_chain != "" and session_chain != ""
        htf_chain + LABEL_SUFFIX + LABEL_SESSION_SEPARATOR + session_chain
    else if htf_chain != ""
        htf_chain + LABEL_SUFFIX
    else
        session_chain

// ═══════════════════════════════════════════════════════════════════════════════
// DYNAMIC MODE - PARAMETERIZED DETECTION FUNCTIONS (DRY)
// ═══════════════════════════════════════════════════════════════════════════════

// BSL Detection: Wick took LOW but closed at/above → target is the HIGH
detect_bsl(float prev_high, float prev_low, float prev_close, int detect_time,
               array<float> bsl_targets, array<bool> bsl_open,
               array<int> bsl_detect_times, array<int> bsl_fill_times,
               array<int> eligible_low_ticks, array<int> eligible_low_times) =>
    int elig_size = array.size(eligible_low_ticks)
    if elig_size == 0
        false
    else
        bool detected = false
        for i = 0 to elig_size - 1
            ref_low = from_tick(array.get(eligible_low_ticks, i))
            if prev_low < ref_low and prev_close >= ref_low
                target_tick = to_tick(prev_high)
                bool already_exists = false
                int tgt_size = array.size(bsl_targets)
                if tgt_size > 0
                    for j = 0 to tgt_size - 1
                        if to_tick(array.get(bsl_targets, j)) == target_tick
                            already_exists := true
                            break
                if not already_exists
                    array.push(bsl_targets, prev_high)
                    array.push(bsl_open, true)
                    array.push(bsl_detect_times, detect_time)
                    array.push(bsl_fill_times, int(na))
                    detected := true
                break
        detected

// SSL Detection: Wick took HIGH but closed at/below → target is the LOW
detect_ssl(float prev_high, float prev_low, float prev_close, int detect_time,
               array<float> ssl_targets, array<bool> ssl_open,
               array<int> ssl_detect_times, array<int> ssl_fill_times,
               array<int> eligible_high_ticks, array<int> eligible_high_times) =>
    int elig_size = array.size(eligible_high_ticks)
    if elig_size == 0
        false
    else
        bool detected = false
        for i = 0 to elig_size - 1
            ref_high = from_tick(array.get(eligible_high_ticks, i))
            if prev_high > ref_high and prev_close <= ref_high
                target_tick = to_tick(prev_low)
                bool already_exists = false
                int tgt_size = array.size(ssl_targets)
                if tgt_size > 0
                    for j = 0 to tgt_size - 1
                        if to_tick(array.get(ssl_targets, j)) == target_tick
                            already_exists := true
                            break
                if not already_exists
                    array.push(ssl_targets, prev_low)
                    array.push(ssl_open, true)
                    array.push(ssl_detect_times, detect_time)
                    array.push(ssl_fill_times, int(na))
                    detected := true
                break
        detected

// Fill Detection: Mark levels as filled when price reaches target
check_fills(float current_high, float current_low, int current_time,
                array<float> bsl_targets, array<bool> bsl_open, array<int> bsl_fill_times,
                array<float> ssl_targets, array<bool> ssl_open, array<int> ssl_fill_times) =>
    // BSL fills when high reaches target
    int bsl_size = array.size(bsl_targets)
    if bsl_size > 0
        for i = 0 to bsl_size - 1
            if array.get(bsl_open, i) and current_high >= array.get(bsl_targets, i)
                array.set(bsl_open, i, false)
                array.set(bsl_fill_times, i, current_time)
    // SSL fills when low reaches target
    int ssl_size = array.size(ssl_targets)
    if ssl_size > 0
        for i = 0 to ssl_size - 1
            if array.get(ssl_open, i) and current_low <= array.get(ssl_targets, i)
                array.set(ssl_open, i, false)
                array.set(ssl_fill_times, i, current_time)

// Track eligible reference levels for a candle
track_candle(float candle_high, float candle_low, int candle_time, int cap,
                 array<int> eligible_high_ticks, array<int> eligible_low_ticks,
                 array<int> eligible_high_times, array<int> eligible_low_times) =>
    // Track high as potential SSL reference
    high_tick = to_tick(candle_high)
    array.push(eligible_high_ticks, high_tick)
    array.push(eligible_high_times, candle_time)
    if array.size(eligible_high_ticks) > cap
        array.shift(eligible_high_ticks)
        array.shift(eligible_high_times)
    // Track low as potential BSL reference
    low_tick = to_tick(candle_low)
    array.push(eligible_low_ticks, low_tick)
    array.push(eligible_low_times, candle_time)
    if array.size(eligible_low_ticks) > cap
        array.shift(eligible_low_ticks)
        array.shift(eligible_low_times)

// Remove eligible levels that were broken by the candle
remove_broken(float candle_high, float candle_low,
                  array<int> eligible_high_ticks, array<int> eligible_high_times,
                  array<int> eligible_low_ticks, array<int> eligible_low_times) =>
    // Remove broken highs (exceeded by candle high)
    if array.size(eligible_high_ticks) > 0
        idx = array.size(eligible_high_ticks) - 1
        while idx >= 0
            if candle_high >= from_tick(array.get(eligible_high_ticks, idx))
                array.remove(eligible_high_ticks, idx)
                array.remove(eligible_high_times, idx)
            idx -= 1
    // Remove broken lows (exceeded by candle low)
    if array.size(eligible_low_ticks) > 0
        idx = array.size(eligible_low_ticks) - 1
        while idx >= 0
            if candle_low <= from_tick(array.get(eligible_low_ticks, idx))
                array.remove(eligible_low_ticks, idx)
                array.remove(eligible_low_times, idx)
            idx -= 1

// Process HTF detection - centralized logic for all dynamic HTF slots
process_htf(float prev_h, float prev_l, float prev_c, int prev_t,
                array<float> bsl_targets, array<bool> bsl_open,
                array<int> bsl_detect_times, array<int> bsl_fill_times,
                array<float> ssl_targets, array<bool> ssl_open,
                array<int> ssl_detect_times, array<int> ssl_fill_times,
                array<int> eligible_high_ticks, array<int> eligible_low_ticks,
                array<int> eligible_high_times, array<int> eligible_low_times,
                bool has_history, int HTF_LOOKBACK_CANDLES_MAX) =>
    result = has_history
    if not na(prev_h)
        if has_history
            detect_bsl(prev_h, prev_l, prev_c, prev_t, bsl_targets, bsl_open, bsl_detect_times, bsl_fill_times, eligible_low_ticks, eligible_low_times)
            detect_ssl(prev_h, prev_l, prev_c, prev_t, ssl_targets, ssl_open, ssl_detect_times, ssl_fill_times, eligible_high_ticks, eligible_high_times)
            remove_broken(prev_h, prev_l, eligible_high_ticks, eligible_high_times, eligible_low_ticks, eligible_low_times)
        track_candle(prev_h, prev_l, prev_t, HTF_LOOKBACK_CANDLES_MAX, eligible_high_ticks, eligible_low_ticks, eligible_high_times, eligible_low_times)
        result := true
    result

slot_process_htf(float prev_h, float prev_l, float prev_c, int prev_t, HtfSlot slot, int HTF_LOOKBACK_CANDLES_MAX) =>
    if not na(prev_h)
        if slot.has_history
            detect_bsl(prev_h, prev_l, prev_c, prev_t, slot.bsl_targets, slot.bsl_open, slot.bsl_detect_times, slot.bsl_fill_times, slot.eligible_low_ticks, slot.eligible_low_times)
            detect_ssl(prev_h, prev_l, prev_c, prev_t, slot.ssl_targets, slot.ssl_open, slot.ssl_detect_times, slot.ssl_fill_times, slot.eligible_high_ticks, slot.eligible_high_times)
            remove_broken(prev_h, prev_l, slot.eligible_high_ticks, slot.eligible_high_times, slot.eligible_low_ticks, slot.eligible_low_times)
        track_candle(prev_h, prev_l, prev_t, HTF_LOOKBACK_CANDLES_MAX, slot.eligible_high_ticks, slot.eligible_low_ticks, slot.eligible_high_times, slot.eligible_low_times)
        slot.has_history := true

slot_check_fills(float current_high, float current_low, int current_time, HtfSlot slot) =>
    check_fills(current_high, current_low, current_time, slot.bsl_targets, slot.bsl_open, slot.bsl_fill_times, slot.ssl_targets, slot.ssl_open, slot.ssl_fill_times)

// Find nearest OPEN level within ADR band
find_nearest_in_range(array<float> targets, array<bool> is_open, float lower_band, float upper_band, float current_price) =>
    float nearest = na
    float min_dist = na
    if array.size(targets) > 0
        for i = 0 to array.size(targets) - 1
            if array.get(is_open, i)
                target = array.get(targets, i)
                if target >= lower_band and target <= upper_band
                    dist = math.abs(target - current_price)
                    if na(min_dist) or dist < min_dist
                        min_dist := dist
                        nearest := target
    nearest

// Collect OPEN levels, deduplicate by price
// out_tags stores comma-separated list of all contributing TFs, primary (highest rank) first
// out_session_tags stores session/time level tags separately (kept empty for HTF levels)
// htf_rank: lower = higher TF (1=Monthly, 2=Weekly, 3=Daily, etc.)
// max_levels: max BSL + SSL per TF (passed from caller based on ADR filter setting)
collect_levels(array<float> bsl_targets, array<bool> bsl_open,
                   array<float> ssl_targets, array<bool> ssl_open,
                   float lower_band, float upper_band, string htf_tag, int htf_rank,
                   bool use_adr_filter, int max_levels, float current_price,
                   array<int> out_ticks, array<bool> out_is_bsl, array<string> out_tags, array<string> out_session_tags, array<int> out_ranks, array<int> out_source_counts) =>
    int max_bsl = max_levels
    int max_ssl = max_levels

    // Temporary arrays to collect eligible levels, then sort by proximity
    var array<float> temp_bsl = array.new_float()
    var array<float> temp_ssl = array.new_float()
    array.clear(temp_bsl)
    array.clear(temp_ssl)

    // First pass: collect all eligible BSL levels above current price
    int bsl_size = array.size(bsl_targets)
    if bsl_size > 0
        for i = 0 to bsl_size - 1
            if array.get(bsl_open, i)
                target = array.get(bsl_targets, i)
                bool in_range = use_adr_filter ? (target >= lower_band and target <= upper_band) : true
                if in_range and target > current_price
                    array.push(temp_bsl, target)

    // Sort ascending (lowest first = nearest to price from above)
    array.sort(temp_bsl, order.ascending)

    // Take up to max_bsl nearest levels and add to output
    int bsl_to_add = math.min(max_bsl, array.size(temp_bsl))
    if bsl_to_add > 0
        for i = 0 to bsl_to_add - 1
            target = array.get(temp_bsl, i)
            tick = to_tick(target)
            found_idx = -1
            int out_size = array.size(out_ticks)
            if out_size > 0
                for j = 0 to out_size - 1
                    if array.get(out_ticks, j) == tick and array.get(out_is_bsl, j)
                        found_idx := j
                        break
            if found_idx >= 0
                existing_tags = array.get(out_tags, found_idx)
                existing_rank = array.get(out_ranks, found_idx)
                if htf_rank < existing_rank
                    array.set(out_tags, found_idx, htf_tag + "," + existing_tags)
                    array.set(out_ranks, found_idx, htf_rank)
                else
                    array.set(out_tags, found_idx, existing_tags + "," + htf_tag)
                array.set(out_source_counts, found_idx, array.get(out_source_counts, found_idx) + 1)
            else
                array.push(out_ticks, tick)
                array.push(out_is_bsl, true)
                array.push(out_tags, htf_tag)
                array.push(out_session_tags, "")
                array.push(out_ranks, htf_rank)
                array.push(out_source_counts, 1)

    // First pass: collect all eligible SSL levels below current price
    int ssl_size = array.size(ssl_targets)
    if ssl_size > 0
        for i = 0 to ssl_size - 1
            if array.get(ssl_open, i)
                target = array.get(ssl_targets, i)
                bool in_range = use_adr_filter ? (target >= lower_band and target <= upper_band) : true
                if in_range and target < current_price
                    array.push(temp_ssl, target)

    // Sort descending (highest first = nearest to price from below)
    array.sort(temp_ssl, order.descending)

    // Take up to max_ssl nearest levels and add to output
    int ssl_to_add = math.min(max_ssl, array.size(temp_ssl))
    if ssl_to_add > 0
        for i = 0 to ssl_to_add - 1
            target = array.get(temp_ssl, i)
            tick = to_tick(target)
            found_idx = -1
            int out_size = array.size(out_ticks)
            if out_size > 0
                for j = 0 to out_size - 1
                    if array.get(out_ticks, j) == tick and not array.get(out_is_bsl, j)
                        found_idx := j
                        break
            if found_idx >= 0
                existing_tags = array.get(out_tags, found_idx)
                existing_rank = array.get(out_ranks, found_idx)
                if htf_rank < existing_rank
                    array.set(out_tags, found_idx, htf_tag + "," + existing_tags)
                    array.set(out_ranks, found_idx, htf_rank)
                else
                    array.set(out_tags, found_idx, existing_tags + "," + htf_tag)
                array.set(out_source_counts, found_idx, array.get(out_source_counts, found_idx) + 1)
            else
                array.push(out_ticks, tick)
                array.push(out_is_bsl, false)
                array.push(out_tags, htf_tag)
                array.push(out_session_tags, "")
                array.push(out_ranks, htf_rank)
                array.push(out_source_counts, 1)

slot_collect_levels(HtfSlot slot, float lower_band, float upper_band, string htf_tag, bool use_adr, int max_levels, float current_price, array<int> out_ticks, array<bool> out_is_bsl, array<string> out_tags, array<string> out_session_tags, array<int> out_ranks, array<int> out_source_counts) =>
    collect_levels(slot.bsl_targets, slot.bsl_open, slot.ssl_targets, slot.ssl_open, lower_band, upper_band, htf_tag, slot.rank, use_adr, max_levels, current_price, out_ticks, out_is_bsl, out_tags, out_session_tags, out_ranks, out_source_counts)

// Format time level label with date (e.g., "16:00 Yesterday" or "16:00 Jan 28")
format_time_level_label(string base_text, int level_time) =>
    int today_start = timestamp(year, month, dayofmonth, 0, 0, 0)
    int yesterday_start = today_start - 24 * 60 * 60 * 1000
    bool is_yesterday = level_time >= yesterday_start and level_time < today_start
    if is_yesterday
        base_text + " Yesterday"
    else
        string month_str = str.format("{0,date,MMM}", level_time)
        string day_str = str.format("{0,date,d}", level_time)
        base_text + " " + month_str + " " + day_str

// Find tick index in array, returns -1 if not found (exact match)
find_tick_index(int tick, array<int> ticks) =>
    int found_idx = -1
    int arr_size = array.size(ticks)
    if arr_size > 0
        for j = 0 to arr_size - 1
            if array.get(ticks, j) == tick
                found_idx := j
                break
    found_idx

// Find nearby tick index within tolerance, returns -1 if not found
// Returns the index of the closest match within tolerance
find_nearby_tick_index(int tick, array<int> ticks, int tolerance_ticks) =>
    int found_idx = -1
    int arr_size = array.size(ticks)
    if arr_size > 0
        int min_dist = tolerance_ticks + 1
        for j = 0 to arr_size - 1
            int existing_tick = array.get(ticks, j)
            int dist = math.abs(existing_tick - tick)
            if dist <= tolerance_ticks and dist < min_dist
                min_dist := dist
                found_idx := j
    found_idx

// Merge tag into existing entry at index (appends with " / " if not empty)
merge_tag_at_index(int idx, string new_tag, array<string> tags) =>
    existing_tags = array.get(tags, idx)
    if existing_tags == ""
        array.set(tags, idx, new_tag)
    else
        array.set(tags, idx, existing_tags + " / " + new_tag)

// Add or merge a session/time level into open levels arrays
// Merges with existing entries at same or nearby price - one line per price with all names
add_or_merge_open_level(int tick, string session_tag, array<int> out_ticks, array<bool> out_is_bsl, array<string> out_tags, array<string> out_session_tags, array<int> out_ranks, array<int> out_source_counts) =>
    // Calculate tolerance in ticks based on price (0.005% of price)
    float price = from_tick(tick)
    float tolerance_price = price * LEVEL_MERGE_PCT / 100
    int tolerance_ticks = math.max(1, int(math.round(tolerance_price / syminfo.mintick)))

    int found_idx = find_nearby_tick_index(tick, out_ticks, tolerance_ticks)
    if found_idx >= 0
        merge_tag_at_index(found_idx, session_tag, out_session_tags)
        array.set(out_source_counts, found_idx, array.get(out_source_counts, found_idx) + 1)
    else
        array.push(out_ticks, tick)
        array.push(out_is_bsl, true)
        array.push(out_tags, "")
        array.push(out_session_tags, session_tag)
        array.push(out_ranks, TIME_LEVEL_RANK)
        array.push(out_source_counts, 1)

// Collect unmitigated time-based levels within ADR range
// Merges with existing HTF levels if they share the same price tick
// When most_recent_only=true, only shows the current level (older levels visible once current is taken out)
collect_time_levels(TimePriceLevel level, float lower_band, float upper_band, bool use_adr_filter, bool most_recent_only,
                    array<int> out_ticks, array<bool> out_is_bsl, array<string> out_tags, array<string> out_session_tags, array<int> out_ranks, array<int> out_source_counts) =>
    bool current_added = false
    if not na(level.current_price) and not level.current_mitigated
        bool in_range = use_adr_filter ? (level.current_price >= lower_band and level.current_price <= upper_band) : true
        if in_range
            int tick = to_tick(level.current_price)
            string time_tag = format_time_level_label(level.label_text, level.current_time)
            add_or_merge_open_level(tick, time_tag, out_ticks, out_is_bsl, out_tags, out_session_tags, out_ranks, out_source_counts)
            current_added := true

    // Skip stored levels if most_recent_only is enabled and current level was added
    if not (most_recent_only and current_added)
        int stored_size = array.size(level.prices)
        if stored_size > 0
            for i = 0 to stored_size - 1
                if not array.get(level.mitigated, i)
                    float lvl = array.get(level.prices, i)
                    bool in_range = use_adr_filter ? (lvl >= lower_band and lvl <= upper_band) : true
                    if in_range
                        int tick = to_tick(lvl)
                        string time_tag = format_time_level_label(level.label_text, array.get(level.times, i))
                        add_or_merge_open_level(tick, time_tag, out_ticks, out_is_bsl, out_tags, out_session_tags, out_ranks, out_source_counts)
                        if most_recent_only
                            break  // Only show the most recent stored level

// Draw provisional session levels as dashed lines (same position as other lines)
draw_session_provisional_lines(SessionRangeLevel level, float lower_band, float upper_band, bool use_adr_filter,
                                color line_color, int start_bar, int end_bar,
                                array<line> lines_arr, array<label> labels_arr,
                                color bsl_col, color ssl_col, float current_price, string label_size) =>
    if not level.in_session
        // HIGH: if provisional but not mitigated, draw dashed line
        if not na(level.current_high) and not level.high_mitigated and level.provisional_high_mitigated
            bool in_range = use_adr_filter ? (level.current_high >= lower_band and level.current_high <= upper_band) : true
            if in_range
                ln = line.new(start_bar, level.current_high, end_bar, level.current_high, color=line_color, width=PROVISIONAL_LINE_WIDTH, style=line.style_dashed)
                array.push(lines_arr, ln)
                lbl_col = level.current_high > current_price ? bsl_col : ssl_col
                lb = label.new(end_bar, level.current_high, level.label_text, style=label.style_label_left, textcolor=lbl_col, size=get_size(label_size, false), color=color.new(color.white, 100))
                array.push(labels_arr, lb)

        // LOW: if provisional but not mitigated, draw dashed line
        if not na(level.current_low) and not level.low_mitigated and level.provisional_low_mitigated
            bool in_range = use_adr_filter ? (level.current_low >= lower_band and level.current_low <= upper_band) : true
            if in_range
                ln = line.new(start_bar, level.current_low, end_bar, level.current_low, color=line_color, width=PROVISIONAL_LINE_WIDTH, style=line.style_dashed)
                array.push(lines_arr, ln)
                lbl_col = level.current_low > current_price ? bsl_col : ssl_col
                lb = label.new(end_bar, level.current_low, level.label_text, style=label.style_label_left, textcolor=lbl_col, size=get_size(label_size, false), color=color.new(color.white, 100))
                array.push(labels_arr, lb)

// Collect unmitigated session range levels (high and low) within ADR range
// Provisional levels are skipped here - they're drawn separately with solid+dashed lines
collect_session_range_levels(SessionRangeLevel level, float lower_band, float upper_band, bool use_adr_filter,
                             array<int> out_ticks, array<bool> out_is_bsl, array<string> out_tags, array<string> out_session_tags, array<int> out_ranks, array<int> out_source_counts) =>
    // Current session high (unmitigated) - skip if provisional (drawn separately)
    if not na(level.current_high) and not level.high_mitigated and not level.in_session and not level.provisional_high_mitigated
        bool in_range = use_adr_filter ? (level.current_high >= lower_band and level.current_high <= upper_band) : true
        if in_range
            int tick = to_tick(level.current_high)
            add_or_merge_open_level(tick, level.label_text, out_ticks, out_is_bsl, out_tags, out_session_tags, out_ranks, out_source_counts)

    // Current session low (unmitigated) - skip if provisional (drawn separately)
    if not na(level.current_low) and not level.low_mitigated and not level.in_session and not level.provisional_low_mitigated
        bool in_range = use_adr_filter ? (level.current_low >= lower_band and level.current_low <= upper_band) : true
        if in_range
            int tick = to_tick(level.current_low)
            add_or_merge_open_level(tick, level.label_text, out_ticks, out_is_bsl, out_tags, out_session_tags, out_ranks, out_source_counts)

    // Stored highs
    int stored_highs = array.size(level.highs)
    if stored_highs > 0
        for i = 0 to stored_highs - 1
            if not array.get(level.highs_mitigated, i)
                float lvl = array.get(level.highs, i)
                bool in_range = use_adr_filter ? (lvl >= lower_band and lvl <= upper_band) : true
                if in_range
                    int tick = to_tick(lvl)
                    add_or_merge_open_level(tick, level.label_text, out_ticks, out_is_bsl, out_tags, out_session_tags, out_ranks, out_source_counts)

    // Stored lows
    int stored_lows = array.size(level.lows)
    if stored_lows > 0
        for i = 0 to stored_lows - 1
            if not array.get(level.lows_mitigated, i)
                float lvl = array.get(level.lows, i)
                bool in_range = use_adr_filter ? (lvl >= lower_band and lvl <= upper_band) : true
                if in_range
                    int tick = to_tick(lvl)
                    add_or_merge_open_level(tick, level.label_text, out_ticks, out_is_bsl, out_tags, out_session_tags, out_ranks, out_source_counts)

// Draw consolidated levels with progressive widths/sizes and position-based label colors
draw_consolidated(array<int> ticks, array<bool> is_bsl, array<string> tags, array<string> session_tags, array<int> ranks, array<int> source_counts,
                      array<line> lines_arr, array<label> labels_arr,
                      color line_col, color macro_col, color session_col, color bsl_col, color ssl_col, color c1600_col,
                      float current_price, int end_bar,
                      int w1, int w2, int w3, string s1, string s2, string s3, bool multi_type_only,
                      bool do_highlight, int nearest_bsl_tick, int nearest_ssl_tick, bool show_price) =>
    int tick_count = array.size(ticks)
    if tick_count > 0
        for i = 0 to tick_count - 1
            rank = array.get(ranks, i)
            htf_tags = array.get(tags, i)
            sess_tags = array.get(session_tags, i)
            bool has_htf = htf_tags != ""
            bool is_time_level = rank == TIME_LEVEL_RANK
            bool is_macro = rank <= TIER_MACRO_MAX_RANK and not is_time_level
            int source_count = array.get(source_counts, i)
            if multi_type_only and not is_macro and source_count < 2
                continue
            tick = array.get(ticks, i)
            price = from_tick(tick)
            is_buy = array.get(is_bsl, i)
            tier = is_time_level ? 2 : get_tier_from_rank(rank)
            bool is_nearest = do_highlight and ((is_buy and tick == nearest_bsl_tick) or (not is_buy and tick == nearest_ssl_tick))
            line_w = tier == 1 ? w1 : tier == 2 ? w2 : w3
            line_w := is_nearest ? line_w + 1 : line_w
            tier_size = tier == 1 ? s1 : tier == 2 ? s2 : s3
            lbl_sz = get_size(tier_size, is_nearest)
            // Line color: 1600-only → c1600_col, macro → macro_col, has session → session_col, else → line_col
            bool is_1600_only = str.startswith(sess_tags, "16:00") and not has_htf and not str.contains(sess_tags, " / ")
            bool has_session = str.contains(sess_tags, "Asia") or str.contains(sess_tags, "Evening") or str.contains(sess_tags, "Rafael")
            ln_col = is_1600_only ? c1600_col : (is_macro ? macro_col : (has_session ? session_col : line_col))
            // Label color: macro → macro_col, everything else (including 1600) → BSL/SSL based on position
            bool is_above_price = price > current_price
            lbl_col = is_macro ? macro_col : (is_above_price ? bsl_col : ssl_col)
            lbl_text = format_level_label(htf_tags, sess_tags)
            lbl_text += show_price ? " • " + str.tostring(price, format.mintick) : ""
            ln = line.new(end_bar - LINE_LENGTH, price, end_bar, price, color=ln_col, width=line_w, style=line.style_solid)
            lb = label.new(end_bar, price, lbl_text, style=label.style_label_left, textcolor=lbl_col, size=lbl_sz, color=color.new(color.white, 100))
            array.push(lines_arr, ln)
            array.push(labels_arr, lb)

// Parameterized HTF tag generator - works for any timeframe
get_htf_tag_for_tf(simple string tf) =>
    local_htf_seconds = timeframe.in_seconds(tf)
    local_htf_minutes = local_htf_seconds / 60

    if local_htf_minutes < CHART_TF_1D
        if local_htf_minutes % CHART_TF_1H == 0
            str.tostring(int(local_htf_minutes / CHART_TF_1H)) + "H"
        else
            str.tostring(int(local_htf_minutes)) + "m"
    else if local_htf_minutes == CHART_TF_1D
        "1D"
    else if local_htf_minutes == CHART_TF_1W
        "1W"
    else if tf == TF_1MO
        "1M"
    else if tf == TF_3MO
        "3M"
    else if tf == '6M'
        "6M"
    else if tf == TF_1Y
        "12M"
    else
        tf

// ═══════════════════════════════════════════════════════════════════════════════
// CHANGE DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

current_ticker = ticker.standard()
current_chart_tf = timeframe.period

symbol_changed = current_ticker != last_ticker
chart_tf_changed = current_chart_tf != last_chart_tf

needs_reset = symbol_changed or chart_tf_changed

if needs_reset
    initialized := true
    last_ticker := current_ticker
    last_chart_tf := current_chart_tf
    clear_time_level(level_1600)
    clear_session_range_level(level_asia_open)
    clear_session_range_level(level_evening)
    clear_session_range_level(level_rafael)
    clear_htf_slot(slot_1mo)
    clear_htf_slot(slot_1w)
    clear_htf_slot(slot_1d)
    clear_htf_slot(slot_12h)
    clear_htf_slot(slot_8h)
    clear_htf_slot(slot_7h)
    clear_htf_slot(slot_4h)
    clear_htf_slot(slot_1h)

// Clear state on first bar (handles replay mode)
if barstate.isfirst
    clear_time_level(level_1600)
    clear_session_range_level(level_asia_open)
    clear_session_range_level(level_evening)
    clear_session_range_level(level_rafael)
    clear_htf_slot(slot_1mo)
    clear_htf_slot(slot_1w)
    clear_htf_slot(slot_1d)
    clear_htf_slot(slot_12h)
    clear_htf_slot(slot_8h)
    clear_htf_slot(slot_7h)
    clear_htf_slot(slot_4h)
    clear_htf_slot(slot_1h)

// ═══════════════════════════════════════════════════════════════════════════════
// HTF REQUEST.SECURITY CALLS (8 HTF SLOTS)
// ═══════════════════════════════════════════════════════════════════════════════

// Dynamic HTF1 (Monthly)
[sec_1mo_open, sec_1mo_high, sec_1mo_low, sec_1mo_close, sec_1mo_time] = request.security(syminfo.tickerid, htf_1mo, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
int seconds_1mo = timeframe.in_seconds(htf_1mo)
bool valid_1mo = enabled_1mo and seconds_1mo > chart_tf_seconds
bool changed_1mo = valid_1mo and ta.change(time(htf_1mo)) != 0

// Dynamic HTF2 (Weekly)
[sec_1w_open, sec_1w_high, sec_1w_low, sec_1w_close, sec_1w_time] = request.security(syminfo.tickerid, htf_1w, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
int seconds_1w = timeframe.in_seconds(htf_1w)
bool valid_1w = enabled_1w and seconds_1w > chart_tf_seconds
bool changed_1w = valid_1w and ta.change(time(htf_1w)) != 0

// Dynamic HTF3 (Daily)
[sec_1d_open, sec_1d_high, sec_1d_low, sec_1d_close, sec_1d_time] = request.security(syminfo.tickerid, htf_1d, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
int seconds_1d = timeframe.in_seconds(htf_1d)
bool valid_1d = enabled_1d and seconds_1d > chart_tf_seconds
bool changed_1d = valid_1d and ta.change(time(htf_1d)) != 0

// Dynamic HTF4 (12H)
[sec_12h_open, sec_12h_high, sec_12h_low, sec_12h_close, sec_12h_time] = request.security(syminfo.tickerid, htf_12h, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
int seconds_12h = timeframe.in_seconds(htf_12h)
bool valid_12h = enabled_12h and seconds_12h > chart_tf_seconds
bool changed_12h = valid_12h and ta.change(time(htf_12h)) != 0

// Dynamic HTF5 (8H)
[sec_8h_open, sec_8h_high, sec_8h_low, sec_8h_close, sec_8h_time] = request.security(syminfo.tickerid, htf_8h, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
int seconds_8h = timeframe.in_seconds(htf_8h)
bool valid_8h = enabled_8h and seconds_8h > chart_tf_seconds
bool changed_8h = valid_8h and ta.change(time(htf_8h)) != 0

// Dynamic HTF6 (7H)
// Note: 7H is excluded when on 4H chart due to unreliable bar alignment
[sec_7h_open, sec_7h_high, sec_7h_low, sec_7h_close, sec_7h_time] = request.security(syminfo.tickerid, htf_7h, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
int seconds_7h = timeframe.in_seconds(htf_7h)
bool is_7h_on_4h_chart = chart_tf_seconds == TF_4H_SECONDS and seconds_7h == TF_7H_SECONDS
bool valid_7h = enabled_7h and seconds_7h > chart_tf_seconds and not is_7h_on_4h_chart
bool changed_7h = valid_7h and ta.change(time(htf_7h)) != 0

// Dynamic HTF7 (4H)
[sec_4h_open, sec_4h_high, sec_4h_low, sec_4h_close, sec_4h_time] = request.security(syminfo.tickerid, htf_4h, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
int seconds_4h = timeframe.in_seconds(htf_4h)
bool valid_4h = enabled_4h and seconds_4h > chart_tf_seconds
bool changed_4h = valid_4h and ta.change(time(htf_4h)) != 0

// Dynamic HTF8 (1H)
[sec_1h_open, sec_1h_high, sec_1h_low, sec_1h_close, sec_1h_time] = request.security(syminfo.tickerid, htf_1h, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
int seconds_1h = timeframe.in_seconds(htf_1h)
bool valid_1h = enabled_1h and seconds_1h > chart_tf_seconds
bool changed_1h = valid_1h and ta.change(time(htf_1h)) != 0

// ═══════════════════════════════════════════════════════════════════════════════
// ADR CALCULATION (5-day Average Daily Range)
// ═══════════════════════════════════════════════════════════════════════════════

// NY midnight detection for ADR tracking (works on any timeframe)
int ny_hour = hour(time, "America/New_York")
int ny_day = dayofweek(time, "America/New_York")
int prev_ny_day = dayofweek(time[1], "America/New_York")
// Day must change AND we must be in early hours (avoids weekend gaps recording partial days)
bool is_new_ny_day = (ny_day != prev_ny_day) and (ny_hour < 4)

// ADR state tracking
var array<float> adr_daily_ranges = array.new_float()
var float adr_current_high = high
var float adr_current_low = low
var float adr_current_open = open
var int adr_day_start_time = time
var float current_adr = na

// Historical day data for ADR boxes
var array<float> adr_hist_opens = array.new_float()
var array<float> adr_hist_adrs = array.new_float()
var array<int> adr_hist_starts = array.new_int()
var array<int> adr_hist_ends = array.new_int()

// Track daily range (NY Midnight method)
if is_new_ny_day
    // Store completed day's range
    float day_range = adr_current_high - adr_current_low
    if day_range > 0
        array.unshift(adr_daily_ranges, day_range)
        if array.size(adr_daily_ranges) > 20
            array.pop(adr_daily_ranges)
    // Store completed day for historical ADR boxes
    if not na(current_adr) and adr_day_start_time > 0
        array.unshift(adr_hist_opens, adr_current_open)
        array.unshift(adr_hist_adrs, current_adr)
        array.unshift(adr_hist_starts, adr_day_start_time)
        array.unshift(adr_hist_ends, time)
        // Limit history
        if array.size(adr_hist_opens) > 20
            array.pop(adr_hist_opens)
            array.pop(adr_hist_adrs)
            array.pop(adr_hist_starts)
            array.pop(adr_hist_ends)
    // Reset for new day
    adr_current_high := high
    adr_current_low := low
    adr_current_open := open
    adr_day_start_time := time
else
    adr_current_high := math.max(adr_current_high, high)
    adr_current_low := math.min(adr_current_low, low)

// Calculate ADR
calc_adr(array<float> ranges, int lookback) =>
    int count = math.min(lookback, array.size(ranges))
    if count > 0
        float sum = 0.0
        for i = 0 to count - 1
            sum += array.get(ranges, i)
        sum / count
    else
        float(na)

current_adr := calc_adr(adr_daily_ranges, adr_period)

// ADR band for relevance filtering (matches ADR indicator: anchor = day's open, full ADR each direction)
float adr_range = nz(current_adr, 0) * adr_multiplier
float adr_upper = adr_current_open + adr_range
float adr_lower = adr_current_open - adr_range

// ═══════════════════════════════════════════════════════════════════════════════
// DYNAMIC MODE - DETECTION LOGIC (using parameterized functions)
// ═══════════════════════════════════════════════════════════════════════════════

if valid_1mo and changed_1mo
    slot_process_htf(sec_1mo_high[1], sec_1mo_low[1], sec_1mo_close[1], int(sec_1mo_time[1]), slot_1mo, HTF_LOOKBACK_CANDLES_MAX)
if valid_1w and changed_1w
    slot_process_htf(sec_1w_high[1], sec_1w_low[1], sec_1w_close[1], int(sec_1w_time[1]), slot_1w, HTF_LOOKBACK_CANDLES_MAX)
if valid_1d and changed_1d
    slot_process_htf(sec_1d_high[1], sec_1d_low[1], sec_1d_close[1], int(sec_1d_time[1]), slot_1d, HTF_LOOKBACK_CANDLES_MAX)
if valid_12h and changed_12h
    slot_process_htf(sec_12h_high[1], sec_12h_low[1], sec_12h_close[1], int(sec_12h_time[1]), slot_12h, HTF_LOOKBACK_CANDLES_MAX)
if valid_8h and changed_8h
    slot_process_htf(sec_8h_high[1], sec_8h_low[1], sec_8h_close[1], int(sec_8h_time[1]), slot_8h, HTF_LOOKBACK_CANDLES_MAX)
if valid_7h and changed_7h
    slot_process_htf(sec_7h_high[1], sec_7h_low[1], sec_7h_close[1], int(sec_7h_time[1]), slot_7h, HTF_LOOKBACK_CANDLES_MAX)
if valid_4h and changed_4h
    slot_process_htf(sec_4h_high[1], sec_4h_low[1], sec_4h_close[1], int(sec_4h_time[1]), slot_4h, HTF_LOOKBACK_CANDLES_MAX)
if valid_1h and changed_1h
    slot_process_htf(sec_1h_high[1], sec_1h_low[1], sec_1h_close[1], int(sec_1h_time[1]), slot_1h, HTF_LOOKBACK_CANDLES_MAX)

// Fill Detection (only for enabled HTFs)
if enabled_1mo
    slot_check_fills(high, low, int(time), slot_1mo)
if enabled_1w
    slot_check_fills(high, low, int(time), slot_1w)
if enabled_1d
    slot_check_fills(high, low, int(time), slot_1d)
if enabled_12h
    slot_check_fills(high, low, int(time), slot_12h)
if enabled_8h
    slot_check_fills(high, low, int(time), slot_8h)
if enabled_7h
    slot_check_fills(high, low, int(time), slot_7h)
if enabled_4h
    slot_check_fills(high, low, int(time), slot_4h)
if enabled_1h
    slot_check_fills(high, low, int(time), slot_1h)

// ═══════════════════════════════════════════════════════════════════════════════
// 16:00 CLOSE TRACKING
// ═══════════════════════════════════════════════════════════════════════════════

// Time-based price level capture and mitigation
if show_1600_close and time_levels_tf_valid
    int current_hour_ny = hour(time, NY_TIMEZONE)
    int current_minute_ny = minute(time, NY_TIMEZONE)
    bool is_target_bar = current_hour_ny == level_1600.target_hour and current_minute_ny == level_1600.target_minute

    if is_target_bar
        if not na(level_1600.current_price)
            array.push(level_1600.prices, level_1600.current_price)
            array.push(level_1600.times, level_1600.current_time)
            array.push(level_1600.mitigated, level_1600.current_mitigated)
            array.push(level_1600.mitigation_times, level_1600.current_mitigation_time)

        level_1600.current_price := close
        level_1600.current_time := time
        level_1600.current_mitigated := false
        level_1600.current_mitigation_time := na

    bool is_in_mitigation_window = time_level_mitigation_window == MITIGATION_WINDOW_ANYTIME or (current_hour_ny >= 5 and current_hour_ny < 16)

    if not na(level_1600.current_price) and not level_1600.current_mitigated
        if (time >= level_1600.current_time + MITIGATION_DELAY_MS) and is_in_mitigation_window
            if (high >= level_1600.current_price and low <= level_1600.current_price) or close == level_1600.current_price
                level_1600.current_mitigated := true
                level_1600.current_mitigation_time := time

    int stored_size = array.size(level_1600.prices)
    if stored_size > 0
        int scan_size = math.min(stored_size, 20)
        int start_index = math.max(0, stored_size - scan_size)
        for i = start_index to stored_size - 1
            if not array.get(level_1600.mitigated, i)
                float lvl = array.get(level_1600.prices, i)
                int lvl_time = array.get(level_1600.times, i)
                if (time >= lvl_time + MITIGATION_DELAY_MS) and is_in_mitigation_window
                    if (high >= lvl and low <= lvl) or close == lvl
                        array.set(level_1600.mitigated, i, true)
                        array.set(level_1600.mitigation_times, i, time)

    prune_time_level(level_1600)

// ═══════════════════════════════════════════════════════════════════════════════
// SESSION RANGE TRACKING
// ═══════════════════════════════════════════════════════════════════════════════

int session_hour_ny = hour(time, NY_TIMEZONE)
int session_minute_ny = minute(time, NY_TIMEZONE)

if show_asia_open and time_levels_tf_valid
    track_session_range_level(level_asia_open, session_hour_ny, session_minute_ny, high, low, int(time))

if show_evening and time_levels_tf_valid
    track_session_range_level(level_evening, session_hour_ny, session_minute_ny, high, low, int(time))

if show_rafael and time_levels_tf_valid
    track_session_range_level(level_rafael, session_hour_ny, session_minute_ny, high, low, int(time))

// ═══════════════════════════════════════════════════════════════════════════════
// DISPLAY SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.islast

    // Clear previous lines/labels
    for ln in level_lines
        line.delete(ln)
    for lb in level_labels
        label.delete(lb)
    array.clear(level_lines)
    array.clear(level_labels)

    // Line positioning: offset slides both start and end together
    int line_start_bar = bar_index + LINE_START_OFFSET
    int line_end_bar = bar_index + LINE_START_OFFSET + LINE_LENGTH

    // Temporary arrays for consolidation
    var array<int> cons_ticks = array.new_int()
    var array<bool> cons_is_bsl = array.new_bool()
    var array<string> cons_tags = array.new_string()
    var array<string> cons_session_tags = array.new_string()
    var array<int> cons_ranks = array.new_int()
    var array<int> cons_source_counts = array.new_int()
    array.clear(cons_ticks)
    array.clear(cons_is_bsl)
    array.clear(cons_tags)
    array.clear(cons_session_tags)
    array.clear(cons_ranks)
    array.clear(cons_source_counts)

    // ADR filter: user toggle AND chart TF must be below threshold
    bool use_adr = adr_filter_enabled and chart_tf_seconds < ADR_FILTER_MAX_TF_SECONDS
    // Level caps: when ADR filter ON use rank-based caps, when OFF use global limit
    int cap_macro = use_adr ? 999 : open_lines_count
    int cap_swing = use_adr ? 2 : open_lines_count
    int cap_intra = use_adr ? 999 : open_lines_count

    // Collect levels from all HTFs (rank 1=highest TF, 8=lowest)
    if valid_1mo
        slot_collect_levels(slot_1mo, adr_lower, adr_upper, get_htf_tag_for_tf(htf_1mo), use_adr, cap_macro, close, cons_ticks, cons_is_bsl, cons_tags, cons_session_tags, cons_ranks, cons_source_counts)
    if valid_1w
        slot_collect_levels(slot_1w, adr_lower, adr_upper, get_htf_tag_for_tf(htf_1w), use_adr, cap_macro, close, cons_ticks, cons_is_bsl, cons_tags, cons_session_tags, cons_ranks, cons_source_counts)
    if valid_1d
        slot_collect_levels(slot_1d, adr_lower, adr_upper, get_htf_tag_for_tf(htf_1d), use_adr, cap_macro, close, cons_ticks, cons_is_bsl, cons_tags, cons_session_tags, cons_ranks, cons_source_counts)
    if valid_12h
        slot_collect_levels(slot_12h, adr_lower, adr_upper, get_htf_tag_for_tf(htf_12h), use_adr, cap_swing, close, cons_ticks, cons_is_bsl, cons_tags, cons_session_tags, cons_ranks, cons_source_counts)
    if valid_8h
        slot_collect_levels(slot_8h, adr_lower, adr_upper, get_htf_tag_for_tf(htf_8h), use_adr, cap_swing, close, cons_ticks, cons_is_bsl, cons_tags, cons_session_tags, cons_ranks, cons_source_counts)
    if valid_7h
        slot_collect_levels(slot_7h, adr_lower, adr_upper, get_htf_tag_for_tf(htf_7h), use_adr, cap_swing, close, cons_ticks, cons_is_bsl, cons_tags, cons_session_tags, cons_ranks, cons_source_counts)
    if valid_4h
        slot_collect_levels(slot_4h, adr_lower, adr_upper, get_htf_tag_for_tf(htf_4h), use_adr, cap_intra, close, cons_ticks, cons_is_bsl, cons_tags, cons_session_tags, cons_ranks, cons_source_counts)
    if valid_1h
        slot_collect_levels(slot_1h, adr_lower, adr_upper, get_htf_tag_for_tf(htf_1h), use_adr, cap_intra, close, cons_ticks, cons_is_bsl, cons_tags, cons_session_tags, cons_ranks, cons_source_counts)

    // Collect time-based levels (only on 15m or lower)
    if show_1600_close and time_levels_tf_valid
        collect_time_levels(level_1600, adr_lower, adr_upper, use_adr, time_level_most_recent_only, cons_ticks, cons_is_bsl, cons_tags, cons_session_tags, cons_ranks, cons_source_counts)
    if show_asia_open and time_levels_tf_valid
        collect_session_range_levels(level_asia_open, adr_lower, adr_upper, use_adr, cons_ticks, cons_is_bsl, cons_tags, cons_session_tags, cons_ranks, cons_source_counts)
    if show_evening and time_levels_tf_valid
        collect_session_range_levels(level_evening, adr_lower, adr_upper, use_adr, cons_ticks, cons_is_bsl, cons_tags, cons_session_tags, cons_ranks, cons_source_counts)
    if show_rafael and time_levels_tf_valid
        collect_session_range_levels(level_rafael, adr_lower, adr_upper, use_adr, cons_ticks, cons_is_bsl, cons_tags, cons_session_tags, cons_ranks, cons_source_counts)

    // Find nearest BSL (above price) and SSL (below price) for highlighting
    int nearest_bsl_tick = na
    int nearest_ssl_tick = na
    int current_tick = to_tick(close)
    int cons_size = array.size(cons_ticks)
    if cons_size > 0
        float min_bsl_dist = na
        float min_ssl_dist = na
        for i = 0 to cons_size - 1
            int lvl_tick = array.get(cons_ticks, i)
            bool is_buy = array.get(cons_is_bsl, i)
            if is_buy and lvl_tick > current_tick
                float dist = lvl_tick - current_tick
                if na(min_bsl_dist) or dist < min_bsl_dist
                    min_bsl_dist := dist
                    nearest_bsl_tick := lvl_tick
            else if not is_buy and lvl_tick < current_tick
                float dist = current_tick - lvl_tick
                if na(min_ssl_dist) or dist < min_ssl_dist
                    min_ssl_dist := dist
                    nearest_ssl_tick := lvl_tick

    // Merge ADR labels into nearby levels (if ADR lines enabled and at same price)
    bool adr_upper_merged = false
    bool adr_lower_merged = false
    if show_adr_lines and chart_tf_seconds < ADR_FILTER_MAX_TF_SECONDS and not na(current_adr)
        int adr_upper_tick = to_tick(adr_upper)
        int adr_lower_tick = to_tick(adr_lower)
        float tolerance_price = adr_upper * LEVEL_MERGE_PCT / 100
        int tolerance_ticks = math.max(1, int(math.round(tolerance_price / syminfo.mintick)))

        for i = 0 to array.size(cons_ticks) - 1
            int lvl_tick = array.get(cons_ticks, i)
            if not adr_upper_merged and math.abs(lvl_tick - adr_upper_tick) <= tolerance_ticks
                string existing = array.get(cons_session_tags, i)
                array.set(cons_session_tags, i, existing == "" ? "ADR+" : existing + LABEL_SESSION_SEPARATOR + "ADR+")
                adr_upper_merged := true
            if not adr_lower_merged and math.abs(lvl_tick - adr_lower_tick) <= tolerance_ticks
                string existing = array.get(cons_session_tags, i)
                array.set(cons_session_tags, i, existing == "" ? "ADR-" : existing + LABEL_SESSION_SEPARATOR + "ADR-")
                adr_lower_merged := true

    // Draw consolidated levels (one line per unique price, highest HTF label with TF context)
    draw_consolidated(cons_ticks, cons_is_bsl, cons_tags, cons_session_tags, cons_ranks, cons_source_counts, level_lines, level_labels,
        line_color, macro_line_color, session_line_color, bsl_text_color, ssl_text_color, close_1600_color,
        close, line_end_bar,
        width_macro, width_swing, width_intra,
        size_macro, size_swing, size_intra, multi_type_only,
        highlight_nearest, nearest_bsl_tick, nearest_ssl_tick, show_price_on_label)

    // Draw provisional session levels as dashed lines (only on 15m or lower)
    if time_levels_tf_valid
        if show_asia_open
            draw_session_provisional_lines(level_asia_open, adr_lower, adr_upper, use_adr, session_line_color, line_start_bar, line_end_bar, level_lines, level_labels, bsl_text_color, ssl_text_color, close, size_swing)
        if show_evening
            draw_session_provisional_lines(level_evening, adr_lower, adr_upper, use_adr, session_line_color, line_start_bar, line_end_bar, level_lines, level_labels, bsl_text_color, ssl_text_color, close, size_swing)
        if show_rafael
            draw_session_provisional_lines(level_rafael, adr_lower, adr_upper, use_adr, session_line_color, line_start_bar, line_end_bar, level_lines, level_labels, bsl_text_color, ssl_text_color, close, size_swing)

    // Draw ADR lines at same position as algo levels (only if not merged with existing level)
    if show_adr_lines and chart_tf_seconds < ADR_FILTER_MAX_TF_SECONDS and not na(current_adr)
        line.delete(adr_upper_line)
        line.delete(adr_lower_line)
        label.delete(adr_upper_label)
        label.delete(adr_lower_label)
        if not adr_upper_merged
            adr_upper_line := line.new(bar_index + LINE_START_OFFSET, adr_upper, line_end_bar, adr_upper, color=adr_lines_color, style=line.style_solid, width=1)
            adr_upper_label := label.new(line_end_bar, adr_upper, "ADR+", style=label.style_label_left, textcolor=adr_lines_color, size=size.tiny, color=color.new(color.white, 100))
        if not adr_lower_merged
            adr_lower_line := line.new(bar_index + LINE_START_OFFSET, adr_lower, line_end_bar, adr_lower, color=adr_lines_color, style=line.style_solid, width=1)
            adr_lower_label := label.new(line_end_bar, adr_lower, "ADR-", style=label.style_label_left, textcolor=adr_lines_color, size=size.tiny, color=color.new(color.white, 100))


// ═══════════════════════════════════════════════════════════════════════════════
// ADR BOXES DEBUG VISUALIZATION (verify ADR calculation matches ADR indicator)
// ═══════════════════════════════════════════════════════════════════════════════

var box adr_current_box = na
var array<box> adr_hist_boxes = array.new<box>()

if show_adr_boxes and chart_tf_seconds < ADR_FILTER_MAX_TF_SECONDS and barstate.islast
    // Delete old boxes
    box.delete(adr_current_box)
    for b in adr_hist_boxes
        box.delete(b)
    array.clear(adr_hist_boxes)

    // Draw current day's ADR box
    if not na(current_adr)
        float curr_upper = adr_current_open + (current_adr * adr_multiplier)
        float curr_lower = adr_current_open - (current_adr * adr_multiplier)
        adr_current_box := box.new(adr_day_start_time, curr_upper, time, curr_lower,
                                   xloc=xloc.bar_time, border_color=adr_box_color, bgcolor=adr_box_color,
                                   border_width=1, border_style=line.style_solid)

    // Draw historical ADR boxes
    int hist_count = math.min(adr_box_days - 1, array.size(adr_hist_opens))
    if hist_count > 0
        for i = 0 to hist_count - 1
            float h_open = array.get(adr_hist_opens, i)
            float h_adr = array.get(adr_hist_adrs, i)
            int h_start = array.get(adr_hist_starts, i)
            int h_end = array.get(adr_hist_ends, i)
            float h_upper = h_open + (h_adr * adr_multiplier)
            float h_lower = h_open - (h_adr * adr_multiplier)
            box h_box = box.new(h_start, h_upper, h_end, h_lower,
                                xloc=xloc.bar_time, border_color=adr_box_color, bgcolor=adr_box_color,
                                border_width=1, border_style=line.style_solid)
            array.push(adr_hist_boxes, h_box)

// ═══════════════════════════════════════════════════════════════════════════════
// FILLED LEVEL HISTORY (Backtest Visualization)
// ═══════════════════════════════════════════════════════════════════════════════

var array<line> fills_lines = array.new<line>()
var array<label> fills_labels = array.new<label>()

// Temp arrays for consolidation (reused each render)
var array<int> fh_ticks = array.new<int>()
var array<int> fh_detect_times = array.new<int>()
var array<int> fh_fill_times = array.new<int>()
var array<string> fh_tags = array.new<string>()

// Add or merge a filled time level into fh_* arrays
add_or_merge_filled_level(int tick, string time_tag, int draw_start, int fill_time) =>
    int found_idx = find_tick_index(tick, fh_ticks)
    if found_idx >= 0
        merge_tag_at_index(found_idx, time_tag, fh_tags)
        0  // merged, not a new entry
    else
        array.push(fh_ticks, tick)
        array.push(fh_detect_times, draw_start)
        array.push(fh_fill_times, fill_time)
        array.push(fh_tags, time_tag)
        1  // new entry

// Helper: Collect filled levels from one HTF into consolidation arrays
collect_filled_history_for_htf(array<float> targets, array<bool> is_open,
                               array<int> detect_times, array<int> fill_times,
                               array<float> hist_opens, array<float> hist_adrs,
                               array<int> hist_starts, array<int> hist_ends,
                               float adr_mult, int max_days, string htf_tag) =>
    int collected = 0
    int hist_count = math.min(max_days, array.size(hist_opens))
    int level_count = array.size(targets)

    if level_count > 0 and hist_count > 0
        for i = 0 to level_count - 1
            if not array.get(is_open, i)
                float target = array.get(targets, i)
                int detect_t = array.get(detect_times, i)
                int fill_t = array.get(fill_times, i)

                if na(detect_t) or na(fill_t)
                    continue

                for d = 0 to hist_count - 1
                    float day_open = array.get(hist_opens, d)
                    float day_adr = array.get(hist_adrs, d)
                    int day_start = array.get(hist_starts, d)
                    int day_end = array.get(hist_ends, d)

                    float day_upper = day_open + (day_adr * adr_mult)
                    float day_lower = day_open - (day_adr * adr_mult)

                    if target >= day_lower and target <= day_upper
                        if fill_t <= day_end and fill_t >= day_start
                            int tick = to_tick(target)
                            int draw_start = math.max(detect_t, day_start)

                            // Check if tick already exists
                            int found_idx = -1
                            int fh_size = array.size(fh_ticks)
                            if fh_size > 0
                                for j = 0 to fh_size - 1
                                    if array.get(fh_ticks, j) == tick
                                        found_idx := j
                                        break

                            if found_idx >= 0
                                // Merge: use earliest detect, latest fill, combine tags
                                existing_detect = array.get(fh_detect_times, found_idx)
                                existing_fill = array.get(fh_fill_times, found_idx)
                                existing_tags = array.get(fh_tags, found_idx)
                                array.set(fh_detect_times, found_idx, math.min(existing_detect, draw_start))
                                array.set(fh_fill_times, found_idx, math.max(existing_fill, fill_t))
                                if not str.contains(existing_tags, htf_tag)
                                    array.set(fh_tags, found_idx, existing_tags + " • " + htf_tag)
                            else
                                // New entry
                                array.push(fh_ticks, tick)
                                array.push(fh_detect_times, draw_start)
                                array.push(fh_fill_times, fill_t)
                                array.push(fh_tags, htf_tag)
                                collected += 1
                            break
    collected

// Helper: Collect filled levels from one HTF for TODAY only
collect_filled_today(array<float> targets, array<bool> is_open,
                     array<int> detect_times, array<int> fill_times,
                     float today_open, float today_adr, int today_start,
                     float adr_mult, string htf_tag) =>
    int collected = 0
    int level_count = array.size(targets)
    if level_count > 0 and not na(today_adr)
        float day_upper = today_open + (today_adr * adr_mult)
        float day_lower = today_open - (today_adr * adr_mult)

        for i = 0 to level_count - 1
            if not array.get(is_open, i)
                float target = array.get(targets, i)
                int detect_t = array.get(detect_times, i)
                int fill_t = array.get(fill_times, i)

                if na(detect_t) or na(fill_t)
                    continue

                // Check if level is within today's ADR and filled today
                if target >= day_lower and target <= day_upper
                    if fill_t >= today_start
                        int tick = to_tick(target)
                        int draw_start = math.max(detect_t, today_start)

                        // Check if tick already exists (dedup)
                        int found_idx = -1
                        int fh_size = array.size(fh_ticks)
                        if fh_size > 0
                            for j = 0 to fh_size - 1
                                if array.get(fh_ticks, j) == tick
                                    found_idx := j
                                    break

                        if found_idx >= 0
                            // Merge: use earliest detect, latest fill, combine tags
                            existing_detect = array.get(fh_detect_times, found_idx)
                            existing_fill = array.get(fh_fill_times, found_idx)
                            existing_tags = array.get(fh_tags, found_idx)
                            array.set(fh_detect_times, found_idx, math.min(existing_detect, draw_start))
                            array.set(fh_fill_times, found_idx, math.max(existing_fill, fill_t))
                            if not str.contains(existing_tags, htf_tag)
                                array.set(fh_tags, found_idx, existing_tags + " • " + htf_tag)
                        else
                            // New entry
                            array.push(fh_ticks, tick)
                            array.push(fh_detect_times, draw_start)
                            array.push(fh_fill_times, fill_t)
                            array.push(fh_tags, htf_tag)
                            collected += 1
    collected

// Helper: Collect filled time levels for fills display
// Merges with existing HTF filled levels if they share the same price tick
collect_filled_time_levels(TimePriceLevel level, float today_open, float today_adr, int today_start, float adr_mult) =>
    int collected = 0
    if not na(today_adr)
        float day_upper = today_open + (today_adr * adr_mult)
        float day_lower = today_open - (today_adr * adr_mult)

        // Check current level if mitigated
        if not na(level.current_price) and level.current_mitigated and not na(level.current_mitigation_time)
            if level.current_price >= day_lower and level.current_price <= day_upper
                if level.current_mitigation_time >= today_start
                    int tick = to_tick(level.current_price)
                    int draw_start = math.max(level.current_time, today_start)
                    string time_tag = format_time_level_label(level.label_text, level.current_time)
                    collected += add_or_merge_filled_level(tick, time_tag, draw_start, level.current_mitigation_time)

        // Check stored levels
        int stored_size = array.size(level.prices)
        if stored_size > 0
            for i = 0 to stored_size - 1
                if array.get(level.mitigated, i)
                    float lvl = array.get(level.prices, i)
                    int lvl_time = array.get(level.times, i)
                    int mit_time = array.get(level.mitigation_times, i)
                    if not na(mit_time) and lvl >= day_lower and lvl <= day_upper
                        if mit_time >= today_start
                            int tick = to_tick(lvl)
                            int draw_start = math.max(lvl_time, today_start)
                            string time_tag = format_time_level_label(level.label_text, lvl_time)
                            collected += add_or_merge_filled_level(tick, time_tag, draw_start, mit_time)
    collected

slot_collect_filled_today(HtfSlot slot, float today_open, float today_adr, int today_start, float adr_mult, string htf_tag) =>
    collect_filled_today(slot.bsl_targets, slot.bsl_open, slot.bsl_detect_times, slot.bsl_fill_times, today_open, today_adr, today_start, adr_mult, htf_tag)
    collect_filled_today(slot.ssl_targets, slot.ssl_open, slot.ssl_detect_times, slot.ssl_fill_times, today_open, today_adr, today_start, adr_mult, htf_tag)

slot_collect_filled_history(HtfSlot slot, array<float> hist_opens, array<float> hist_adrs, array<int> hist_starts, array<int> hist_ends, float adr_mult, int max_days, string htf_tag) =>
    collect_filled_history_for_htf(slot.bsl_targets, slot.bsl_open, slot.bsl_detect_times, slot.bsl_fill_times, hist_opens, hist_adrs, hist_starts, hist_ends, adr_mult, max_days, htf_tag)
    collect_filled_history_for_htf(slot.ssl_targets, slot.ssl_open, slot.ssl_detect_times, slot.ssl_fill_times, hist_opens, hist_adrs, hist_starts, hist_ends, adr_mult, max_days, htf_tag)

if show_fills and barstate.islast
    // Clear old visuals
    for ln in fills_lines
        line.delete(ln)
    array.clear(fills_lines)
    for lb in fills_labels
        label.delete(lb)
    array.clear(fills_labels)

    // Clear consolidation arrays
    array.clear(fh_ticks)
    array.clear(fh_detect_times)
    array.clear(fh_fill_times)
    array.clear(fh_tags)

    // Collect from all enabled HTFs - TODAY (always when feature is on)
    if enabled_1mo
        slot_collect_filled_today(slot_1mo, adr_current_open, current_adr, adr_day_start_time, adr_multiplier, get_htf_tag_for_tf(htf_1mo))
    if enabled_1w
        slot_collect_filled_today(slot_1w, adr_current_open, current_adr, adr_day_start_time, adr_multiplier, get_htf_tag_for_tf(htf_1w))
    if enabled_1d
        slot_collect_filled_today(slot_1d, adr_current_open, current_adr, adr_day_start_time, adr_multiplier, get_htf_tag_for_tf(htf_1d))
    if enabled_12h
        slot_collect_filled_today(slot_12h, adr_current_open, current_adr, adr_day_start_time, adr_multiplier, get_htf_tag_for_tf(htf_12h))
    if enabled_8h
        slot_collect_filled_today(slot_8h, adr_current_open, current_adr, adr_day_start_time, adr_multiplier, get_htf_tag_for_tf(htf_8h))
    if enabled_7h
        slot_collect_filled_today(slot_7h, adr_current_open, current_adr, adr_day_start_time, adr_multiplier, get_htf_tag_for_tf(htf_7h))
    if enabled_4h
        slot_collect_filled_today(slot_4h, adr_current_open, current_adr, adr_day_start_time, adr_multiplier, get_htf_tag_for_tf(htf_4h))
    if enabled_1h
        slot_collect_filled_today(slot_1h, adr_current_open, current_adr, adr_day_start_time, adr_multiplier, get_htf_tag_for_tf(htf_1h))

    // Collect filled time levels
    if show_1600_close
        collect_filled_time_levels(level_1600, adr_current_open, current_adr, adr_day_start_time, adr_multiplier)

    // Collect from all enabled HTFs - PAST DAYS (only if Historical is enabled)
    if fills_historical
        if enabled_1mo
            slot_collect_filled_history(slot_1mo, adr_hist_opens, adr_hist_adrs, adr_hist_starts, adr_hist_ends, adr_multiplier, fills_historical_days, get_htf_tag_for_tf(htf_1mo))
        if enabled_1w
            slot_collect_filled_history(slot_1w, adr_hist_opens, adr_hist_adrs, adr_hist_starts, adr_hist_ends, adr_multiplier, fills_historical_days, get_htf_tag_for_tf(htf_1w))
        if enabled_1d
            slot_collect_filled_history(slot_1d, adr_hist_opens, adr_hist_adrs, adr_hist_starts, adr_hist_ends, adr_multiplier, fills_historical_days, get_htf_tag_for_tf(htf_1d))
        if enabled_12h
            slot_collect_filled_history(slot_12h, adr_hist_opens, adr_hist_adrs, adr_hist_starts, adr_hist_ends, adr_multiplier, fills_historical_days, get_htf_tag_for_tf(htf_12h))
        if enabled_8h
            slot_collect_filled_history(slot_8h, adr_hist_opens, adr_hist_adrs, adr_hist_starts, adr_hist_ends, adr_multiplier, fills_historical_days, get_htf_tag_for_tf(htf_8h))
        if enabled_7h
            slot_collect_filled_history(slot_7h, adr_hist_opens, adr_hist_adrs, adr_hist_starts, adr_hist_ends, adr_multiplier, fills_historical_days, get_htf_tag_for_tf(htf_7h))
        if enabled_4h
            slot_collect_filled_history(slot_4h, adr_hist_opens, adr_hist_adrs, adr_hist_starts, adr_hist_ends, adr_multiplier, fills_historical_days, get_htf_tag_for_tf(htf_4h))
        if enabled_1h
            slot_collect_filled_history(slot_1h, adr_hist_opens, adr_hist_adrs, adr_hist_starts, adr_hist_ends, adr_multiplier, fills_historical_days, get_htf_tag_for_tf(htf_1h))

    // Draw consolidated levels
    int fh_count = array.size(fh_ticks)
    if fh_count > 0
        for i = 0 to fh_count - 1
            float target = from_tick(array.get(fh_ticks, i))
            int draw_start = array.get(fh_detect_times, i)
            int fill_t = array.get(fh_fill_times, i)
            string tags = array.get(fh_tags, i)

            line new_line = line.new(draw_start, target, fill_t, target,
                                     xloc=xloc.bar_time, color=backtest_fills_color,
                                     style=line.style_dashed, width=1)
            array.push(fills_lines, new_line)

            int label_time = int((draw_start + fill_t) / 2)
            label new_label = label.new(label_time, target, tags,
                                        xloc=xloc.bar_time, style=label.style_none,
                                        textcolor=backtest_fills_color, size=size.tiny)
            array.push(fills_labels, new_label)

// ═══════════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE
// ═══════════════════════════════════════════════════════════════════════════════

if show_color_table and barstate.islast
    var table colorTable = table.new(position.top_right, 3, 9, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

    table.cell(colorTable, 0, 0, "Color", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 1, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 2, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)

    table.cell(colorTable, 0, 1, "Line", text_size=size.small)
    table.cell(colorTable, 1, 1, str.format("R:{0} G:{1} B:{2}", color.r(line_color), color.g(line_color), color.b(line_color)), text_size=size.small)
    table.cell(colorTable, 2, 1, str.tostring(color.t(line_color)), text_size=size.small)

    table.cell(colorTable, 0, 2, "Macro", text_size=size.small)
    table.cell(colorTable, 1, 2, str.format("R:{0} G:{1} B:{2}", color.r(macro_line_color), color.g(macro_line_color), color.b(macro_line_color)), text_size=size.small)
    table.cell(colorTable, 2, 2, str.tostring(color.t(macro_line_color)), text_size=size.small)

    table.cell(colorTable, 0, 3, "Session", text_size=size.small)
    table.cell(colorTable, 1, 3, str.format("R:{0} G:{1} B:{2}", color.r(session_line_color), color.g(session_line_color), color.b(session_line_color)), text_size=size.small)
    table.cell(colorTable, 2, 3, str.tostring(color.t(session_line_color)), text_size=size.small)

    table.cell(colorTable, 0, 4, "BSL Label", text_size=size.small)
    table.cell(colorTable, 1, 4, str.format("R:{0} G:{1} B:{2}", color.r(bsl_text_color), color.g(bsl_text_color), color.b(bsl_text_color)), text_size=size.small)
    table.cell(colorTable, 2, 4, str.tostring(color.t(bsl_text_color)), text_size=size.small)

