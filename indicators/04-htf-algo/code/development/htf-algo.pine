// ═══════════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

to_tick(price) => math.round(price / syminfo.mintick)
from_tick(tick) => tick * syminfo.mintick

// Dynamic reference level cap based on HTF timeframe (matches LTF Algo behavior)
get_reference_levels_cap() =>
    htf_min = timeframe.in_seconds(validated_htf1_timeframe) / 60
    if htf_min <= 2
        CAP_ULTRA_SHORT
    else if htf_min <= 5
        CAP_SHORT
    else if htf_min <= 30
        CAP_MEDIUM_SHORT
    else if htf_min <= 90
        CAP_MEDIUM
    else if htf_min <= 240
        CAP_MEDIUM_LONG
    else if htf_min <= 10080  // Up to weekly
        CAP_LONG
    else
        CAP_DEFAULT

get_line_style(style_string) =>
    switch style_string
        STYLE_DASHED => line.style_dashed
        STYLE_DOTTED => line.style_dotted
        => line.style_solid

get_label_text_size() => size.small

convert_size_str(string sz) =>
    switch sz
        SIZE_TINY => size.tiny
        SIZE_SMALL => size.small
        SIZE_NORMAL => size.normal
        SIZE_LARGE => size.large
        => size.small

get_size_from_rank(int rank) =>
    // Rank 1-2: Macro (tier 1), Rank 3-4: Swing (tier 2), Rank 5-8: Intraday (tier 3)
    if rank <= 2
        convert_size_str(dyn_size_tier1)
    else if rank <= 4
        convert_size_str(dyn_size_tier2)
    else
        convert_size_str(dyn_size_tier3)

// Format main label: (b) D or (s) 8H - just the primary TF with prefix
format_dyn_label_main(string all_tags, bool is_bsl) =>
    prefix = is_bsl ? "(b) " : "(s) "
    tags_arr = str.split(all_tags, ",")
    prefix + array.get(tags_arr, 0)

// Format secondary label: +4H, 8H (tiny, only if multiple TFs)
// Returns empty string if single TF
format_dyn_label_secondary(string all_tags) =>
    tags_arr = str.split(all_tags, ",")
    if array.size(tags_arr) == 1
        ""
    else
        others = ""
        for i = 1 to array.size(tags_arr) - 1
            others += (i > 1 ? ", " : "") + array.get(tags_arr, i)
        "+" + others

bg_none() => color.new(color.white, 100)

// ═══════════════════════════════════════════════════════════════════════════════
// DYNAMIC MODE - PARAMETERIZED DETECTION FUNCTIONS (DRY)
// ═══════════════════════════════════════════════════════════════════════════════

// BSL Detection: Wick took LOW but closed at/above → target is the HIGH
dyn_detect_bsl(float prev_high, float prev_low, float prev_close,
               array<float> bsl_targets, array<bool> bsl_open, array<int> bsl_wick_times,
               array<int> eligible_low_ticks, array<int> eligible_low_times) =>
    int elig_size = array.size(eligible_low_ticks)
    if elig_size == 0
        false
    else
        bool detected = false
        for i = 0 to elig_size - 1
            ref_low = from_tick(array.get(eligible_low_ticks, i))
            if prev_low < ref_low and prev_close >= ref_low
                target_tick = to_tick(prev_high)
                bool already_exists = false
                int tgt_size = array.size(bsl_targets)
                if tgt_size > 0
                    for j = 0 to tgt_size - 1
                        if to_tick(array.get(bsl_targets, j)) == target_tick
                            already_exists := true
                            break
                if not already_exists
                    array.push(bsl_targets, prev_high)
                    array.push(bsl_open, true)
                    array.push(bsl_wick_times, array.get(eligible_low_times, i))
                    detected := true
                break
        detected

// SSL Detection: Wick took HIGH but closed at/below → target is the LOW
dyn_detect_ssl(float prev_high, float prev_low, float prev_close,
               array<float> ssl_targets, array<bool> ssl_open, array<int> ssl_wick_times,
               array<int> eligible_high_ticks, array<int> eligible_high_times) =>
    int elig_size = array.size(eligible_high_ticks)
    if elig_size == 0
        false
    else
        bool detected = false
        for i = 0 to elig_size - 1
            ref_high = from_tick(array.get(eligible_high_ticks, i))
            if prev_high > ref_high and prev_close <= ref_high
                target_tick = to_tick(prev_low)
                bool already_exists = false
                int tgt_size = array.size(ssl_targets)
                if tgt_size > 0
                    for j = 0 to tgt_size - 1
                        if to_tick(array.get(ssl_targets, j)) == target_tick
                            already_exists := true
                            break
                if not already_exists
                    array.push(ssl_targets, prev_low)
                    array.push(ssl_open, true)
                    array.push(ssl_wick_times, array.get(eligible_high_times, i))
                    detected := true
                break
        detected

// Fill Detection: Mark levels as filled when price reaches target
dyn_check_fills(float current_high, float current_low,
                array<float> bsl_targets, array<bool> bsl_open,
                array<float> ssl_targets, array<bool> ssl_open) =>
    // BSL fills when high reaches target
    int bsl_size = array.size(bsl_targets)
    if bsl_size > 0
        for i = 0 to bsl_size - 1
            if array.get(bsl_open, i) and current_high >= array.get(bsl_targets, i)
                array.set(bsl_open, i, false)
    // SSL fills when low reaches target
    int ssl_size = array.size(ssl_targets)
    if ssl_size > 0
        for i = 0 to ssl_size - 1
            if array.get(ssl_open, i) and current_low <= array.get(ssl_targets, i)
                array.set(ssl_open, i, false)

// Track eligible reference levels for a candle
dyn_track_candle(float candle_high, float candle_low, int candle_time, int cap,
                 array<int> eligible_high_ticks, array<int> eligible_low_ticks,
                 array<int> eligible_high_times, array<int> eligible_low_times) =>
    // Track high as potential SSL reference
    high_tick = to_tick(candle_high)
    array.push(eligible_high_ticks, high_tick)
    array.push(eligible_high_times, candle_time)
    if array.size(eligible_high_ticks) > cap
        array.shift(eligible_high_ticks)
        array.shift(eligible_high_times)
    // Track low as potential BSL reference
    low_tick = to_tick(candle_low)
    array.push(eligible_low_ticks, low_tick)
    array.push(eligible_low_times, candle_time)
    if array.size(eligible_low_ticks) > cap
        array.shift(eligible_low_ticks)
        array.shift(eligible_low_times)

// Remove eligible levels that were broken by the candle
dyn_remove_broken(float candle_high, float candle_low,
                  array<int> eligible_high_ticks, array<int> eligible_high_times,
                  array<int> eligible_low_ticks, array<int> eligible_low_times) =>
    // Remove broken highs (exceeded by candle high)
    if array.size(eligible_high_ticks) > 0
        idx = array.size(eligible_high_ticks) - 1
        while idx >= 0
            if candle_high >= from_tick(array.get(eligible_high_ticks, idx))
                array.remove(eligible_high_ticks, idx)
                array.remove(eligible_high_times, idx)
            idx -= 1
    // Remove broken lows (exceeded by candle low)
    if array.size(eligible_low_ticks) > 0
        idx = array.size(eligible_low_ticks) - 1
        while idx >= 0
            if candle_low <= from_tick(array.get(eligible_low_ticks, idx))
                array.remove(eligible_low_ticks, idx)
                array.remove(eligible_low_times, idx)
            idx -= 1

// Find nearest OPEN level within ADR band
dyn_find_nearest_in_range(array<float> targets, array<bool> is_open, float lower_band, float upper_band, float current_price) =>
    float nearest = na
    float min_dist = na
    if array.size(targets) > 0
        for i = 0 to array.size(targets) - 1
            if array.get(is_open, i)
                target = array.get(targets, i)
                if target >= lower_band and target <= upper_band
                    dist = math.abs(target - current_price)
                    if na(min_dist) or dist < min_dist
                        min_dist := dist
                        nearest := target
    nearest

// Collect OPEN levels within ADR band, deduplicate by price
// out_tags stores comma-separated list of all contributing TFs, primary (highest rank) first
// htf_rank: lower = higher TF (1=Monthly, 2=Weekly, 3=Daily, etc.)
dyn_collect_levels(array<float> bsl_targets, array<bool> bsl_open,
                   array<float> ssl_targets, array<bool> ssl_open,
                   float lower_band, float upper_band, string htf_tag, int htf_rank,
                   array<int> out_ticks, array<bool> out_is_bsl, array<string> out_tags, array<int> out_ranks) =>
    // Collect BSL levels (cache array sizes for performance)
    int bsl_size = array.size(bsl_targets)
    if bsl_size > 0
        for i = 0 to bsl_size - 1
            if array.get(bsl_open, i)
                target = array.get(bsl_targets, i)
                if target >= lower_band and target <= upper_band
                    tick = to_tick(target)
                    found_idx = -1
                    int out_size = array.size(out_ticks)
                    if out_size > 0
                        for j = 0 to out_size - 1
                            if array.get(out_ticks, j) == tick and array.get(out_is_bsl, j)
                                found_idx := j
                                break
                    if found_idx >= 0
                        // Append this TF to the tags list
                        existing_tags = array.get(out_tags, found_idx)
                        existing_rank = array.get(out_ranks, found_idx)
                        if htf_rank < existing_rank
                            // New TF is higher rank - put it first
                            array.set(out_tags, found_idx, htf_tag + "," + existing_tags)
                            array.set(out_ranks, found_idx, htf_rank)
                        else
                            // Append to end
                            array.set(out_tags, found_idx, existing_tags + "," + htf_tag)
                    else
                        array.push(out_ticks, tick)
                        array.push(out_is_bsl, true)
                        array.push(out_tags, htf_tag)
                        array.push(out_ranks, htf_rank)
    // Collect SSL levels
    int ssl_size = array.size(ssl_targets)
    if ssl_size > 0
        for i = 0 to ssl_size - 1
            if array.get(ssl_open, i)
                target = array.get(ssl_targets, i)
                if target >= lower_band and target <= upper_band
                    tick = to_tick(target)
                    found_idx = -1
                    int out_size = array.size(out_ticks)
                    if out_size > 0
                        for j = 0 to out_size - 1
                            if array.get(out_ticks, j) == tick and not array.get(out_is_bsl, j)
                                found_idx := j
                                break
                    if found_idx >= 0
                        // Append this TF to the tags list
                        existing_tags = array.get(out_tags, found_idx)
                        existing_rank = array.get(out_ranks, found_idx)
                        if htf_rank < existing_rank
                            // New TF is higher rank - put it first
                            array.set(out_tags, found_idx, htf_tag + "," + existing_tags)
                            array.set(out_ranks, found_idx, htf_rank)
                        else
                            // Append to end
                            array.set(out_tags, found_idx, existing_tags + "," + htf_tag)
                    else
                        array.push(out_ticks, tick)
                        array.push(out_is_bsl, false)
                        array.push(out_tags, htf_tag)
                        array.push(out_ranks, htf_rank)

// Get line width from HTF rank (3 tiers: Macro, Swing, Intraday)
get_width_from_rank(int rank, int w1, int w2, int w3) =>
    if rank <= 2
        w1  // Macro: Monthly, Weekly
    else if rank <= 4
        w2  // Swing: Daily, 12H
    else
        w3  // Intraday: 8H, 7H, 4H, 1H

// Find clean start bar (scan backwards, stop where candle would cross level)
find_clean_start_bar(float price, bool is_bsl, int max_lookback) =>
    int start_bar = bar_index
    for i = 1 to max_lookback
        if bar_index - i < 0
            break
        // BSL: stop if candle high >= price (would cross line)
        // SSL: stop if candle low <= price (would cross line)
        if is_bsl
            if high[i] >= price
                start_bar := bar_index - i + 1  // Start one bar after the crossing
                break
        else
            if low[i] <= price
                start_bar := bar_index - i + 1
                break
        start_bar := bar_index - i
    start_bar

// Draw consolidated levels with progressive widths/sizes and separate BSL/SSL label colors
// Uses two-label approach: main label at configured size, secondary tiny label for additional TFs
dyn_draw_consolidated(array<int> ticks, array<bool> is_bsl, array<string> tags, array<int> ranks,
                      array<line> lines_arr, array<label> labels_arr, array<label> labels_secondary_arr,
                      color line_col, color bsl_lbl_col, color ssl_lbl_col, string line_style_str,
                      int end_bar, int w1, int w2, int w3) =>
    line_style_val = get_line_style(line_style_str)
    int tick_count = array.size(ticks)
    if tick_count > 0
        for i = 0 to tick_count - 1
            price = from_tick(array.get(ticks, i))
            is_buy = array.get(is_bsl, i)
            all_tags = array.get(tags, i)
            rank = array.get(ranks, i)
            line_w = get_width_from_rank(rank, w1, w2, w3)
            lbl_sz = get_size_from_rank(rank)
            lbl_col = is_buy ? bsl_lbl_col : ssl_lbl_col
            // Main label: (b) D or (s) 8H - primary TF with prefix
            main_text = format_dyn_label_main(all_tags, is_buy)
            // Secondary label: +4H, 8H - additional TFs (empty if single TF)
            secondary_text = format_dyn_label_secondary(all_tags)
            // Find clean start (no candle crossing)
            start_bar = find_clean_start_bar(price, is_buy, LINE_LOOKBACK_BARS)
            ln = line.new(start_bar, price, end_bar, price, color=line_col, width=line_w, style=line_style_val)
            lb = label.new(end_bar, price, main_text, style=label.style_label_left, textcolor=lbl_col, size=lbl_sz, color=color.new(color.white, 100))
            array.push(lines_arr, ln)
            array.push(labels_arr, lb)
            // Create secondary tiny label if there are additional TFs
            if secondary_text != ""
                lb_sec = label.new(end_bar + 8, price, secondary_text, style=label.style_label_left, textcolor=lbl_col, size=size.tiny, color=color.new(color.white, 100))
                array.push(labels_secondary_arr, lb_sec)

// Parameterized HTF tag generator - works for any timeframe
get_htf_tag_for_tf(simple string tf) =>
    local_htf_seconds = timeframe.in_seconds(tf)
    local_htf_minutes = local_htf_seconds / 60

    if local_htf_minutes < 1440  // Less than 1 day (intraday)
        if local_htf_minutes % 60 == 0
            str.tostring(int(local_htf_minutes / 60)) + "H"  // Hours: 1H, 4H, etc.
        else
            str.tostring(int(local_htf_minutes)) + "m"       // Minutes: 15m, 30m, etc.
    else if local_htf_minutes == 1440
        "1D"  // Daily
    else if local_htf_minutes == 10080
        "1W"  // Weekly
    else if tf == '1M'
        "1M"  // Monthly
    else if tf == '3M'
        "3M"  // Quarterly
    else if tf == '6M'
        "6M"  // Semiannual
    else if tf == '12M'
        "12M" // Yearly
    else
        tf  // Fallback

get_htf_tag() => get_htf_tag_for_tf(validated_htf1_timeframe)

get_timeframe_text_with_suffix(is_bsl) =>
    prefix = is_bsl ? "(b) " : "(s) "
    prefix + get_htf_tag()

// Parameterized label text for any HTF
get_label_text(simple string htf_tag, bool is_bsl) =>
    prefix = is_bsl ? "(b) " : "(s) "
    prefix + htf_tag

create_end_label(end_time, target_price, label_text_color, is_bsl, tooltip_text) =>
    lab = label.new(
         x=end_time,
         y=target_price,
         text=get_timeframe_text_with_suffix(is_bsl),
         style=label.style_label_left,
         textcolor=label_text_color,
         size=get_label_text_size(),
         xloc=xloc.bar_time,
         tooltip=tooltip_text
     )
    label.set_color(lab, bg_none())
    lab

format_tooltip(is_bsl, wick_timestamp) =>
    type_text = is_bsl ? "BSL: Wick took LOW" : "SSL: Wick took HIGH"
    formatted_time = str.format_time(wick_timestamp, "MMM dd, yyyy HH:mm", syminfo.timezone)
    type_text + " • " + formatted_time + ", " + get_htf_tag()

// Convert timeframe to user-friendly display
get_user_friendly_timeframe(tf) =>
    switch tf
        '15' => '15m'
        '30' => '30m'
        '60' => '1H'
        '120' => '2H'
        '240' => '4H'
        '1D' => '1D'
        '1W' => '1W'
        '1M' => '1M'
        '3M' => '3M'
        '6M' => '6M'
        '12M' => '12M'
        => tf



// Get current chart timeframe display
get_chart_tf_display() =>
    if timeframe.isintraday
        m = timeframe.multiplier
        m % 60 == 0 ? str.tostring(m / 60) + "H" : str.tostring(m) + "m"
    else if timeframe.isdaily
        str.tostring(timeframe.multiplier) + "D"
    else if timeframe.isweekly
        str.tostring(timeframe.multiplier) + "W"
    else if timeframe.ismonthly
        str.tostring(timeframe.multiplier) + "M"
    else
        timeframe.period

// Get allowed HTF preset list with cap - CLEAN FORMAT
get_allowed_htf_presets() =>
    chart_tf_min = get_chart_tf_minutes_cached()
    preset_list = array.new<string>()
    cap_display = ""

    if chart_tf_min <= 3  // 1-3m chart → cap: 15m
        array.push(preset_list, "15m")
        cap_display := "15m"
    else if chart_tf_min == 5  // 5m → cap: 1H
        array.push(preset_list, "15m")
        array.push(preset_list, "30m")
        array.push(preset_list, "1H")
        cap_display := "1H"
    else if chart_tf_min == 10  // 10m → cap: 2H
        array.push(preset_list, "15m")
        array.push(preset_list, "30m")
        array.push(preset_list, "1H")
        array.push(preset_list, "2H")
        cap_display := "2H"
    else if chart_tf_min == 15  // 15m → cap: 4H
        array.push(preset_list, "30m")
        array.push(preset_list, "1H")
        array.push(preset_list, "2H")
        array.push(preset_list, "4H")
        cap_display := "4H"
    else if chart_tf_min == 30  // 30m → cap: 4H
        array.push(preset_list, "1H")
        array.push(preset_list, "2H")
        array.push(preset_list, "4H")
        cap_display := "4H"
    else if chart_tf_min <= 60  // 45-60m → cap: 1D
        array.push(preset_list, "2H")
        array.push(preset_list, "4H")
        array.push(preset_list, "1D")
        cap_display := "1D"
    else if chart_tf_min <= 240  // 2H-4H-6H-7H etc → cap: 1D
        array.push(preset_list, "1D")
        cap_display := "1D"
    else if chart_tf_min <= 1440  // Daily → cap: 1W
        array.push(preset_list, "1W")
        cap_display := "1W"
    else if chart_tf_min <= 10080  // Weekly → cap: 3M
        array.push(preset_list, "1M")
        array.push(preset_list, "3M")
        cap_display := "3M"
    else if chart_tf_min >= 43800  // Monthly+ → cap: 3M
        array.push(preset_list, "3M")
        cap_display := "3M"

    // Convert array to comma-separated string with cap
    if array.size(preset_list) == 0
        "None"
    else
        preset_result = ""
        for i = 0 to array.size(preset_list) - 1
            if i > 0
                preset_result := preset_result + ", "
            preset_result := preset_result + array.get(preset_list, i)

        // Format: "Presets: 15m, 30m, 1H • Any up to 1H"
        "Presets: " + preset_result + " • Any up to " + cap_display

// Parameterized function to add eligible level (replaces 6 duplicate functions)
// Uses direct loop instead of array.indexof for better performance
add_eligible_level(float price, int timestamp, array<int> ticks_arr, array<int> times_arr, int cap) =>
    tick = to_tick(price)
    // Check if tick already exists (direct loop, no array.indexof)
    bool exists = false
    int arr_size = array.size(ticks_arr)
    if arr_size > 0
        for i = 0 to arr_size - 1
            if array.get(ticks_arr, i) == tick
                exists := true
                break
    if not exists
        array.push(ticks_arr, tick)
        array.push(times_arr, timestamp)
        // Prune if over cap
        while array.size(ticks_arr) > cap
            array.shift(ticks_arr)
            array.shift(times_arr)

// Reset state function for TF/symbol changes
reset_state() =>
    // Clear HTF arrays
    array.clear(htf1_buyside_failure_bars)
    array.clear(htf1_buyside_failure_times)
    array.clear(htf1_buyside_targets)
    array.clear(htf1_buyside_open)
    array.clear(htf1_buyside_fill_bars)
    array.clear(htf1_buyside_fill_times)
    array.clear(htf1_sellside_failure_bars)
    array.clear(htf1_sellside_failure_times)
    array.clear(htf1_sellside_targets)
    array.clear(htf1_sellside_open)
    array.clear(htf1_sellside_fill_bars)
    array.clear(htf1_sellside_fill_times)
    array.clear(htf1_eligible_high_ticks)
    array.clear(htf1_eligible_low_ticks)
    array.clear(htf1_eligible_high_times)
    array.clear(htf1_eligible_low_times)

    // Clean up visual elements
    for ln in htf1_buyside_lines
        line.delete(ln)
    array.clear(htf1_buyside_lines)
    array.clear(htf1_buyside_wick_times)
    for lb in htf1_buyside_labels
        label.delete(lb)
    array.clear(htf1_buyside_labels)
    for ln in htf1_sellside_lines
        line.delete(ln)
    array.clear(htf1_sellside_lines)
    array.clear(htf1_sellside_wick_times)
    for lb in htf1_sellside_labels
        label.delete(lb)
    array.clear(htf1_sellside_labels)

// ═══════════════════════════════════════════════════════════════════════════════
// CHANGE DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

current_ticker = ticker.standard()
current_chart_tf = timeframe.period
current_htf_tf = validated_htf1_timeframe
current_limit_zone = get_limit_zone()


symbol_changed = current_ticker != last_ticker
chart_tf_changed = current_chart_tf != last_chart_tf
htf_tf_changed = current_htf_tf != last_htf_tf


limit_zone_changed = current_limit_zone != last_limit_zone
needs_reset = symbol_changed or chart_tf_changed or (htf1_auto and limit_zone_changed) or (not htf1_auto and htf_tf_changed)

if needs_reset
    reset_state()
    initialized := true
    last_ticker := current_ticker
    last_chart_tf := current_chart_tf
    last_htf_tf := current_htf_tf
    last_limit_zone := current_limit_zone

// ═══════════════════════════════════════════════════════════════════════════════
// HTF CANDLE TRACKING - Using request.security for accurate OHLC
// ═══════════════════════════════════════════════════════════════════════════════

// HTF OHLC (Manual mode)
[sec_htf1_open, sec_htf1_high, sec_htf1_low, sec_htf1_close, sec_htf1_time] = request.security(syminfo.tickerid, validated_htf1_timeframe, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
bool htf1_changed = ta.change(time(validated_htf1_timeframe)) != 0
var bool htf1_has_history = false

// ═══════════════════════════════════════════════════════════════════════════════
// DYNAMIC MODE - REQUEST.SECURITY CALLS (8 HTF SLOTS)
// ═══════════════════════════════════════════════════════════════════════════════

// Dynamic mode enabled check
bool is_dynamic_mode = htf_mode == MODE_DYNAMIC

// Dynamic HTF1 (Monthly)
[sec_dyn1_open, sec_dyn1_high, sec_dyn1_low, sec_dyn1_close, sec_dyn1_time] = request.security(syminfo.tickerid, dyn_htf1, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
int dyn_htf1_seconds = timeframe.in_seconds(dyn_htf1)
bool dyn_htf1_valid = is_dynamic_mode and dyn_htf1_enabled and dyn_htf1_seconds > chart_tf_seconds
bool dyn_htf1_changed = dyn_htf1_valid and ta.change(time(dyn_htf1)) != 0

// Dynamic HTF2 (Weekly)
[sec_dyn2_open, sec_dyn2_high, sec_dyn2_low, sec_dyn2_close, sec_dyn2_time] = request.security(syminfo.tickerid, dyn_htf2, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
int dyn_htf2_seconds = timeframe.in_seconds(dyn_htf2)
bool dyn_htf2_valid = is_dynamic_mode and dyn_htf2_enabled and dyn_htf2_seconds > chart_tf_seconds
bool dyn_htf2_changed = dyn_htf2_valid and ta.change(time(dyn_htf2)) != 0

// Dynamic HTF3 (Daily)
[sec_dyn3_open, sec_dyn3_high, sec_dyn3_low, sec_dyn3_close, sec_dyn3_time] = request.security(syminfo.tickerid, dyn_htf3, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
int dyn_htf3_seconds = timeframe.in_seconds(dyn_htf3)
bool dyn_htf3_valid = is_dynamic_mode and dyn_htf3_enabled and dyn_htf3_seconds > chart_tf_seconds
bool dyn_htf3_changed = dyn_htf3_valid and ta.change(time(dyn_htf3)) != 0

// Dynamic HTF4 (12H)
[sec_dyn4_open, sec_dyn4_high, sec_dyn4_low, sec_dyn4_close, sec_dyn4_time] = request.security(syminfo.tickerid, dyn_htf4, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
int dyn_htf4_seconds = timeframe.in_seconds(dyn_htf4)
bool dyn_htf4_valid = is_dynamic_mode and dyn_htf4_enabled and dyn_htf4_seconds > chart_tf_seconds
bool dyn_htf4_changed = dyn_htf4_valid and ta.change(time(dyn_htf4)) != 0

// Dynamic HTF5 (8H)
[sec_dyn5_open, sec_dyn5_high, sec_dyn5_low, sec_dyn5_close, sec_dyn5_time] = request.security(syminfo.tickerid, dyn_htf5, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
int dyn_htf5_seconds = timeframe.in_seconds(dyn_htf5)
bool dyn_htf5_valid = is_dynamic_mode and dyn_htf5_enabled and dyn_htf5_seconds > chart_tf_seconds
bool dyn_htf5_changed = dyn_htf5_valid and ta.change(time(dyn_htf5)) != 0

// Dynamic HTF6 (7H)
// Note: 7H is excluded when on 4H chart due to unreliable bar alignment
[sec_dyn6_open, sec_dyn6_high, sec_dyn6_low, sec_dyn6_close, sec_dyn6_time] = request.security(syminfo.tickerid, dyn_htf6, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
int dyn_htf6_seconds = timeframe.in_seconds(dyn_htf6)
bool is_7h_on_4h_chart = chart_tf_seconds == 14400 and dyn_htf6_seconds == 25200
bool dyn_htf6_valid = is_dynamic_mode and dyn_htf6_enabled and dyn_htf6_seconds > chart_tf_seconds and not is_7h_on_4h_chart
bool dyn_htf6_changed = dyn_htf6_valid and ta.change(time(dyn_htf6)) != 0

// Dynamic HTF7 (4H)
[sec_dyn7_open, sec_dyn7_high, sec_dyn7_low, sec_dyn7_close, sec_dyn7_time] = request.security(syminfo.tickerid, dyn_htf7, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
int dyn_htf7_seconds = timeframe.in_seconds(dyn_htf7)
bool dyn_htf7_valid = is_dynamic_mode and dyn_htf7_enabled and dyn_htf7_seconds > chart_tf_seconds
bool dyn_htf7_changed = dyn_htf7_valid and ta.change(time(dyn_htf7)) != 0

// Dynamic HTF8 (1H)
[sec_dyn8_open, sec_dyn8_high, sec_dyn8_low, sec_dyn8_close, sec_dyn8_time] = request.security(syminfo.tickerid, dyn_htf8, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
int dyn_htf8_seconds = timeframe.in_seconds(dyn_htf8)
bool dyn_htf8_valid = is_dynamic_mode and dyn_htf8_enabled and dyn_htf8_seconds > chart_tf_seconds
bool dyn_htf8_changed = dyn_htf8_valid and ta.change(time(dyn_htf8)) != 0

// ═══════════════════════════════════════════════════════════════════════════════
// ADR CALCULATION (5-day Average Daily Range)
// ═══════════════════════════════════════════════════════════════════════════════

// NY midnight detection for ADR tracking (works on any timeframe)
int ny_hour = hour(time, "America/New_York")
int ny_day = dayofweek(time, "America/New_York")
int prev_ny_day = dayofweek(time[1], "America/New_York")
// Day must change AND we must be in early hours (avoids weekend gaps recording partial days)
bool is_new_ny_day = (ny_day != prev_ny_day) and (ny_hour < 4)

// ADR state tracking
var array<float> adr_daily_ranges = array.new_float()
var float adr_current_high = high
var float adr_current_low = low
var float adr_current_open = open
var int adr_day_start_time = time
var float current_adr = na

// Historical day data for ADR boxes
var array<float> adr_hist_opens = array.new_float()
var array<float> adr_hist_adrs = array.new_float()
var array<int> adr_hist_starts = array.new_int()
var array<int> adr_hist_ends = array.new_int()

// Track daily range (NY Midnight method)
if is_new_ny_day
    // Store completed day's range
    float day_range = adr_current_high - adr_current_low
    if day_range > 0
        array.unshift(adr_daily_ranges, day_range)
        if array.size(adr_daily_ranges) > 20
            array.pop(adr_daily_ranges)
    // Store completed day for historical ADR boxes
    if not na(current_adr) and adr_day_start_time > 0
        array.unshift(adr_hist_opens, adr_current_open)
        array.unshift(adr_hist_adrs, current_adr)
        array.unshift(adr_hist_starts, adr_day_start_time)
        array.unshift(adr_hist_ends, time)
        // Limit history
        if array.size(adr_hist_opens) > 20
            array.pop(adr_hist_opens)
            array.pop(adr_hist_adrs)
            array.pop(adr_hist_starts)
            array.pop(adr_hist_ends)
    // Reset for new day
    adr_current_high := high
    adr_current_low := low
    adr_current_open := open
    adr_day_start_time := time
else
    adr_current_high := math.max(adr_current_high, high)
    adr_current_low := math.min(adr_current_low, low)

// Calculate ADR
calc_adr(array<float> ranges, int lookback) =>
    int count = math.min(lookback, array.size(ranges))
    if count > 0
        float sum = 0.0
        for i = 0 to count - 1
            sum += array.get(ranges, i)
        sum / count
    else
        float(na)

current_adr := calc_adr(adr_daily_ranges, adr_lookback)

// ADR band for relevance filtering (matches ADR indicator: anchor = day's open, full ADR each direction)
float adr_range = nz(current_adr, 0) * adr_multiplier
float adr_upper = adr_current_open + adr_range
float adr_lower = adr_current_open - adr_range

// ═══════════════════════════════════════════════════════════════════════════════
// DYNAMIC MODE - DETECTION LOGIC (using parameterized functions)
// ═══════════════════════════════════════════════════════════════════════════════

// Reference level cap for Dynamic mode
int dyn_ref_cap = CAP_MEDIUM

// Dynamic HTF1 (Monthly) Detection
if dyn_htf1_valid and dyn_htf1_changed
    prev_h = sec_dyn1_high[1]
    prev_l = sec_dyn1_low[1]
    prev_c = sec_dyn1_close[1]
    prev_t = int(sec_dyn1_time[1])
    if not na(prev_h)
        // Detection only after we have reference levels
        if dyn1_has_history
            dyn_detect_bsl(prev_h, prev_l, prev_c, dyn1_bsl_targets, dyn1_bsl_open, dyn1_bsl_wick_times, dyn1_eligible_low_ticks, dyn1_eligible_low_times)
            dyn_detect_ssl(prev_h, prev_l, prev_c, dyn1_ssl_targets, dyn1_ssl_open, dyn1_ssl_wick_times, dyn1_eligible_high_ticks, dyn1_eligible_high_times)
            dyn_remove_broken(prev_h, prev_l, dyn1_eligible_high_ticks, dyn1_eligible_high_times, dyn1_eligible_low_ticks, dyn1_eligible_low_times)
        // Always track candle to build reference levels
        dyn_track_candle(prev_h, prev_l, prev_t, dyn_ref_cap, dyn1_eligible_high_ticks, dyn1_eligible_low_ticks, dyn1_eligible_high_times, dyn1_eligible_low_times)
        dyn1_has_history := true

// Dynamic HTF2 (Weekly) Detection
if dyn_htf2_valid and dyn_htf2_changed
    prev_h = sec_dyn2_high[1]
    prev_l = sec_dyn2_low[1]
    prev_c = sec_dyn2_close[1]
    prev_t = int(sec_dyn2_time[1])
    if not na(prev_h)
        if dyn2_has_history
            dyn_detect_bsl(prev_h, prev_l, prev_c, dyn2_bsl_targets, dyn2_bsl_open, dyn2_bsl_wick_times, dyn2_eligible_low_ticks, dyn2_eligible_low_times)
            dyn_detect_ssl(prev_h, prev_l, prev_c, dyn2_ssl_targets, dyn2_ssl_open, dyn2_ssl_wick_times, dyn2_eligible_high_ticks, dyn2_eligible_high_times)
            dyn_remove_broken(prev_h, prev_l, dyn2_eligible_high_ticks, dyn2_eligible_high_times, dyn2_eligible_low_ticks, dyn2_eligible_low_times)
        dyn_track_candle(prev_h, prev_l, prev_t, dyn_ref_cap, dyn2_eligible_high_ticks, dyn2_eligible_low_ticks, dyn2_eligible_high_times, dyn2_eligible_low_times)
        dyn2_has_history := true

// Dynamic HTF3 (Daily) Detection
if dyn_htf3_valid and dyn_htf3_changed
    prev_h = sec_dyn3_high[1]
    prev_l = sec_dyn3_low[1]
    prev_c = sec_dyn3_close[1]
    prev_t = int(sec_dyn3_time[1])
    if not na(prev_h)
        if dyn3_has_history
            dyn_detect_bsl(prev_h, prev_l, prev_c, dyn3_bsl_targets, dyn3_bsl_open, dyn3_bsl_wick_times, dyn3_eligible_low_ticks, dyn3_eligible_low_times)
            dyn_detect_ssl(prev_h, prev_l, prev_c, dyn3_ssl_targets, dyn3_ssl_open, dyn3_ssl_wick_times, dyn3_eligible_high_ticks, dyn3_eligible_high_times)
            dyn_remove_broken(prev_h, prev_l, dyn3_eligible_high_ticks, dyn3_eligible_high_times, dyn3_eligible_low_ticks, dyn3_eligible_low_times)
        dyn_track_candle(prev_h, prev_l, prev_t, dyn_ref_cap, dyn3_eligible_high_ticks, dyn3_eligible_low_ticks, dyn3_eligible_high_times, dyn3_eligible_low_times)
        dyn3_has_history := true

// Dynamic HTF4 (12H) Detection
if dyn_htf4_valid and dyn_htf4_changed
    prev_h = sec_dyn4_high[1]
    prev_l = sec_dyn4_low[1]
    prev_c = sec_dyn4_close[1]
    prev_t = int(sec_dyn4_time[1])
    if not na(prev_h)
        if dyn4_has_history
            dyn_detect_bsl(prev_h, prev_l, prev_c, dyn4_bsl_targets, dyn4_bsl_open, dyn4_bsl_wick_times, dyn4_eligible_low_ticks, dyn4_eligible_low_times)
            dyn_detect_ssl(prev_h, prev_l, prev_c, dyn4_ssl_targets, dyn4_ssl_open, dyn4_ssl_wick_times, dyn4_eligible_high_ticks, dyn4_eligible_high_times)
            dyn_remove_broken(prev_h, prev_l, dyn4_eligible_high_ticks, dyn4_eligible_high_times, dyn4_eligible_low_ticks, dyn4_eligible_low_times)
        dyn_track_candle(prev_h, prev_l, prev_t, dyn_ref_cap, dyn4_eligible_high_ticks, dyn4_eligible_low_ticks, dyn4_eligible_high_times, dyn4_eligible_low_times)
        dyn4_has_history := true

// Dynamic HTF5 (8H) Detection
if dyn_htf5_valid and dyn_htf5_changed
    prev_h = sec_dyn5_high[1]
    prev_l = sec_dyn5_low[1]
    prev_c = sec_dyn5_close[1]
    prev_t = int(sec_dyn5_time[1])
    if not na(prev_h)
        if dyn5_has_history
            dyn_detect_bsl(prev_h, prev_l, prev_c, dyn5_bsl_targets, dyn5_bsl_open, dyn5_bsl_wick_times, dyn5_eligible_low_ticks, dyn5_eligible_low_times)
            dyn_detect_ssl(prev_h, prev_l, prev_c, dyn5_ssl_targets, dyn5_ssl_open, dyn5_ssl_wick_times, dyn5_eligible_high_ticks, dyn5_eligible_high_times)
            dyn_remove_broken(prev_h, prev_l, dyn5_eligible_high_ticks, dyn5_eligible_high_times, dyn5_eligible_low_ticks, dyn5_eligible_low_times)
        dyn_track_candle(prev_h, prev_l, prev_t, dyn_ref_cap, dyn5_eligible_high_ticks, dyn5_eligible_low_ticks, dyn5_eligible_high_times, dyn5_eligible_low_times)
        dyn5_has_history := true

// Dynamic HTF6 (7H) Detection
if dyn_htf6_valid and dyn_htf6_changed
    prev_h = sec_dyn6_high[1]
    prev_l = sec_dyn6_low[1]
    prev_c = sec_dyn6_close[1]
    prev_t = int(sec_dyn6_time[1])
    if not na(prev_h)
        if dyn6_has_history
            dyn_detect_bsl(prev_h, prev_l, prev_c, dyn6_bsl_targets, dyn6_bsl_open, dyn6_bsl_wick_times, dyn6_eligible_low_ticks, dyn6_eligible_low_times)
            dyn_detect_ssl(prev_h, prev_l, prev_c, dyn6_ssl_targets, dyn6_ssl_open, dyn6_ssl_wick_times, dyn6_eligible_high_ticks, dyn6_eligible_high_times)
            dyn_remove_broken(prev_h, prev_l, dyn6_eligible_high_ticks, dyn6_eligible_high_times, dyn6_eligible_low_ticks, dyn6_eligible_low_times)
        dyn_track_candle(prev_h, prev_l, prev_t, dyn_ref_cap, dyn6_eligible_high_ticks, dyn6_eligible_low_ticks, dyn6_eligible_high_times, dyn6_eligible_low_times)
        dyn6_has_history := true

// Dynamic HTF7 (4H) Detection
if dyn_htf7_valid and dyn_htf7_changed
    prev_h = sec_dyn7_high[1]
    prev_l = sec_dyn7_low[1]
    prev_c = sec_dyn7_close[1]
    prev_t = int(sec_dyn7_time[1])
    if not na(prev_h)
        if dyn7_has_history
            dyn_detect_bsl(prev_h, prev_l, prev_c, dyn7_bsl_targets, dyn7_bsl_open, dyn7_bsl_wick_times, dyn7_eligible_low_ticks, dyn7_eligible_low_times)
            dyn_detect_ssl(prev_h, prev_l, prev_c, dyn7_ssl_targets, dyn7_ssl_open, dyn7_ssl_wick_times, dyn7_eligible_high_ticks, dyn7_eligible_high_times)
            dyn_remove_broken(prev_h, prev_l, dyn7_eligible_high_ticks, dyn7_eligible_high_times, dyn7_eligible_low_ticks, dyn7_eligible_low_times)
        dyn_track_candle(prev_h, prev_l, prev_t, dyn_ref_cap, dyn7_eligible_high_ticks, dyn7_eligible_low_ticks, dyn7_eligible_high_times, dyn7_eligible_low_times)
        dyn7_has_history := true

// Dynamic HTF8 (1H) Detection
if dyn_htf8_valid and dyn_htf8_changed
    prev_h = sec_dyn8_high[1]
    prev_l = sec_dyn8_low[1]
    prev_c = sec_dyn8_close[1]
    prev_t = int(sec_dyn8_time[1])
    if not na(prev_h)
        if dyn8_has_history
            dyn_detect_bsl(prev_h, prev_l, prev_c, dyn8_bsl_targets, dyn8_bsl_open, dyn8_bsl_wick_times, dyn8_eligible_low_ticks, dyn8_eligible_low_times)
            dyn_detect_ssl(prev_h, prev_l, prev_c, dyn8_ssl_targets, dyn8_ssl_open, dyn8_ssl_wick_times, dyn8_eligible_high_ticks, dyn8_eligible_high_times)
            dyn_remove_broken(prev_h, prev_l, dyn8_eligible_high_ticks, dyn8_eligible_high_times, dyn8_eligible_low_ticks, dyn8_eligible_low_times)
        dyn_track_candle(prev_h, prev_l, prev_t, dyn_ref_cap, dyn8_eligible_high_ticks, dyn8_eligible_low_ticks, dyn8_eligible_high_times, dyn8_eligible_low_times)
        dyn8_has_history := true

// Dynamic Mode - Fill Detection (only for enabled HTFs)
if is_dynamic_mode
    if dyn_htf1_enabled
        dyn_check_fills(high, low, dyn1_bsl_targets, dyn1_bsl_open, dyn1_ssl_targets, dyn1_ssl_open)
    if dyn_htf2_enabled
        dyn_check_fills(high, low, dyn2_bsl_targets, dyn2_bsl_open, dyn2_ssl_targets, dyn2_ssl_open)
    if dyn_htf3_enabled
        dyn_check_fills(high, low, dyn3_bsl_targets, dyn3_bsl_open, dyn3_ssl_targets, dyn3_ssl_open)
    if dyn_htf4_enabled
        dyn_check_fills(high, low, dyn4_bsl_targets, dyn4_bsl_open, dyn4_ssl_targets, dyn4_ssl_open)
    if dyn_htf5_enabled
        dyn_check_fills(high, low, dyn5_bsl_targets, dyn5_bsl_open, dyn5_ssl_targets, dyn5_ssl_open)
    if dyn_htf6_enabled
        dyn_check_fills(high, low, dyn6_bsl_targets, dyn6_bsl_open, dyn6_ssl_targets, dyn6_ssl_open)
    if dyn_htf7_enabled
        dyn_check_fills(high, low, dyn7_bsl_targets, dyn7_bsl_open, dyn7_ssl_targets, dyn7_ssl_open)
    if dyn_htf8_enabled
        dyn_check_fills(high, low, dyn8_bsl_targets, dyn8_bsl_open, dyn8_ssl_targets, dyn8_ssl_open)

// ═══════════════════════════════════════════════════════════════════════════════
// MANUAL MODE - DETECTION LOGIC
// ═══════════════════════════════════════════════════════════════════════════════

if htf1_is_valid
    // Initialize on last confirmed historical bar
    if not initialized and barstate.islastconfirmedhistory and not needs_reset
        initialized := true

    if htf1_changed
        // Get completed HTF candle values from request.security (same as overlay)
        float prev_htf_high = sec_htf1_high[1]
        float prev_htf_low = sec_htf1_low[1]
        float prev_htf_close = sec_htf1_close[1]
        int prev_htf_time = int(sec_htf1_time[1])

        // Run detection only if we have valid previous candle AND have seen at least one complete candle
        if not na(prev_htf_high) and htf1_has_history
            // ═══ DETECTION on completed HTF candle ═══
            local_sellside_detected = false
            local_buyside_detected = false

            // BSL Detection first (like LTF Algo): Wick took LOW but closed at/above
            if array.size(htf1_eligible_low_ticks) > 0 and not local_buyside_detected
                for i = 0 to array.size(htf1_eligible_low_ticks) - 1
                    ref_low_tick = array.get(htf1_eligible_low_ticks, i)
                    ref_low = from_tick(ref_low_tick)
                    if prev_htf_low < ref_low and prev_htf_close >= ref_low
                        // Check if we already have this target (deduplication)
                        int target_tick = to_tick(prev_htf_high)
                        bool already_exists = false
                        if array.size(htf1_buyside_targets) > 0
                            for j = 0 to array.size(htf1_buyside_targets) - 1
                                if to_tick(array.get(htf1_buyside_targets, j)) == target_tick
                                    already_exists := true
                                    break

                        if not already_exists
                            wick_timestamp = array.get(htf1_eligible_low_times, i)
                            // Check if already filled on this bar
                            bool already_filled = high >= prev_htf_high
                            array.push(htf1_buyside_failure_bars, bar_index)
                            array.push(htf1_buyside_failure_times, int(time))
                            array.push(htf1_buyside_targets, prev_htf_high)
                            array.push(htf1_buyside_open, not already_filled)
                            array.push(htf1_buyside_fill_bars, already_filled ? bar_index : int(na))
                            array.push(htf1_buyside_fill_times, already_filled ? int(time) : int(na))
                            array.push(htf1_buyside_lines, na)
                            array.push(htf1_buyside_labels, na)
                            array.push(htf1_buyside_wick_times, wick_timestamp)
                            local_buyside_detected := true
                        break

            // SSL Detection: Wick took HIGH but closed at/below
            if array.size(htf1_eligible_high_ticks) > 0 and not local_sellside_detected
                for i = 0 to array.size(htf1_eligible_high_ticks) - 1
                    ref_high_tick = array.get(htf1_eligible_high_ticks, i)
                    ref_high = from_tick(ref_high_tick)
                    if prev_htf_high > ref_high and prev_htf_close <= ref_high
                        // Check if we already have this target (deduplication)
                        int target_tick = to_tick(prev_htf_low)
                        bool already_exists = false
                        if array.size(htf1_sellside_targets) > 0
                            for j = 0 to array.size(htf1_sellside_targets) - 1
                                if to_tick(array.get(htf1_sellside_targets, j)) == target_tick
                                    already_exists := true
                                    break

                        if not already_exists
                            wick_timestamp = array.get(htf1_eligible_high_times, i)
                            // Check if already filled on this bar
                            bool already_filled = low <= prev_htf_low
                            array.push(htf1_sellside_failure_bars, bar_index)
                            array.push(htf1_sellside_failure_times, int(time))
                            array.push(htf1_sellside_targets, prev_htf_low)
                            array.push(htf1_sellside_open, not already_filled)
                            array.push(htf1_sellside_fill_bars, already_filled ? bar_index : int(na))
                            array.push(htf1_sellside_fill_times, already_filled ? int(time) : int(na))
                            array.push(htf1_sellside_lines, na)
                            array.push(htf1_sellside_labels, na)
                            array.push(htf1_sellside_wick_times, wick_timestamp)
                            local_sellside_detected := true
                        break

            // Remove broken levels
            if array.size(htf1_eligible_high_ticks) > 0
                idx = array.size(htf1_eligible_high_ticks) - 1
                while idx >= 0
                    if prev_htf_high >= from_tick(array.get(htf1_eligible_high_ticks, idx))
                        array.remove(htf1_eligible_high_ticks, idx)
                        array.remove(htf1_eligible_high_times, idx)
                    idx -= 1

            if array.size(htf1_eligible_low_ticks) > 0
                idx = array.size(htf1_eligible_low_ticks) - 1
                while idx >= 0
                    if prev_htf_low <= from_tick(array.get(htf1_eligible_low_ticks, idx))
                        array.remove(htf1_eligible_low_ticks, idx)
                        array.remove(htf1_eligible_low_times, idx)
                    idx -= 1

        // Add completed candle's levels as new eligible levels (always, if valid)
        if not na(prev_htf_high)
            int ref_cap = get_reference_levels_cap()
            add_eligible_level(prev_htf_high, prev_htf_time, htf1_eligible_high_ticks, htf1_eligible_high_times, ref_cap)
            add_eligible_level(prev_htf_low, prev_htf_time, htf1_eligible_low_ticks, htf1_eligible_low_times, ref_cap)
            htf1_has_history := true

    // ═══ FILL DETECTION on every bar ═══
    // Check if price has reached targets using LTF bar data
    if array.size(htf1_sellside_targets) > 0
        for i = 0 to array.size(htf1_sellside_targets) - 1
            if array.get(htf1_sellside_open, i) and bar_index > array.get(htf1_sellside_failure_bars, i)
                if low <= array.get(htf1_sellside_targets, i)
                    array.set(htf1_sellside_open, i, false)
                    array.set(htf1_sellside_fill_bars, i, bar_index)
                    array.set(htf1_sellside_fill_times, i, int(time))

    if array.size(htf1_buyside_targets) > 0
        for i = 0 to array.size(htf1_buyside_targets) - 1
            if array.get(htf1_buyside_open, i) and bar_index > array.get(htf1_buyside_failure_bars, i)
                if high >= array.get(htf1_buyside_targets, i)
                    array.set(htf1_buyside_open, i, false)
                    array.set(htf1_buyside_fill_bars, i, bar_index)
                    array.set(htf1_buyside_fill_times, i, int(time))

// ═══════════════════════════════════════════════════════════════════════════════
// HTF CANDLE OVERLAY (DEBUG)
// ═══════════════════════════════════════════════════════════════════════════════

// Track bar index where current HTF candle started
var int dbg_htf_start_bar = na
var box dbg_current_wick = na
var box dbg_current_body = na

// HTF change detection
bool dbg_change_htf = ta.change(time(validated_htf1_timeframe)) != 0

// Use input colors for HTF candles
color dbg_bull_color = htf_bull_body_color
color dbg_bear_color = htf_bear_body_color
color dbg_bull_wick = htf_bull_wick_color
color dbg_bear_wick = htf_bear_wick_color

if show_htf_candles
    if dbg_change_htf
        // Draw COMPLETED candle: started at dbg_htf_start_bar, ended at bar_index - 1
        // OHLC from sec_htf_*[1] = previous HTF candle's final values
        if not na(dbg_htf_start_bar)
            float prev_o = sec_htf1_open[1]
            float prev_h = sec_htf1_high[1]
            float prev_l = sec_htf1_low[1]
            float prev_c = sec_htf1_close[1]
            int end_bar = bar_index - 1
            bool prev_bull = prev_c > prev_o

            // Wick box
            box.new(dbg_htf_start_bar, prev_h, end_bar, prev_l, prev_bull ? dbg_bull_wick : dbg_bear_wick, bgcolor=prev_bull ? dbg_bull_wick : dbg_bear_wick)
            // Body box
            if prev_bull
                box.new(dbg_htf_start_bar, prev_c, end_bar, prev_o, dbg_bull_color, bgcolor=dbg_bull_color)
            else
                box.new(dbg_htf_start_bar, prev_o, end_bar, prev_c, dbg_bear_color, bgcolor=dbg_bear_color)

        // New HTF candle starts at current bar
        dbg_htf_start_bar := bar_index

    // Draw current forming candle on last bar
    if barstate.islast and not na(dbg_htf_start_bar)
        box.delete(dbg_current_wick)
        box.delete(dbg_current_body)

        bool is_bull = sec_htf1_close > sec_htf1_open
        // Wick
        dbg_current_wick := box.new(dbg_htf_start_bar, sec_htf1_high, bar_index, sec_htf1_low, is_bull ? dbg_bull_wick : dbg_bear_wick, bgcolor=is_bull ? dbg_bull_wick : dbg_bear_wick)
        // Body
        if is_bull
            dbg_current_body := box.new(dbg_htf_start_bar, sec_htf1_close, bar_index, sec_htf1_open, dbg_bull_color, bgcolor=dbg_bull_color)
        else
            dbg_current_body := box.new(dbg_htf_start_bar, sec_htf1_open, bar_index, sec_htf1_close, dbg_bear_color, bgcolor=dbg_bear_color)

// ═══════════════════════════════════════════════════════════════════════════════
// DISPLAY SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.islast

    // ═══════════════════════════════════════════════════════════════════════════
    // DYNAMIC MODE DISPLAY - Show ALL open levels within ADR range from ALL TFs
    // ═══════════════════════════════════════════════════════════════════════════
    // DYNAMIC MODE DISPLAY - Consolidated levels (deduplicated, highest HTF shown)
    // ═══════════════════════════════════════════════════════════════════════════
    if is_dynamic_mode
        // Clear previous lines/labels
        for ln in dyn_lines
            line.delete(ln)
        for lb in dyn_labels
            label.delete(lb)
        for lb in dyn_labels_secondary
            label.delete(lb)
        array.clear(dyn_lines)
        array.clear(dyn_labels)
        array.clear(dyn_labels_secondary)

        // Line end (start is calculated per-level to avoid crossing candles)
        int line_end_bar = bar_index + LINE_EXTENSION_BARS

        // Temporary arrays for consolidation
        var array<int> cons_ticks = array.new_int()
        var array<bool> cons_is_bsl = array.new_bool()
        var array<string> cons_tags = array.new_string()
        var array<int> cons_ranks = array.new_int()
        array.clear(cons_ticks)
        array.clear(cons_is_bsl)
        array.clear(cons_tags)
        array.clear(cons_ranks)

        // Collect levels from all HTFs (rank 1=highest TF, 8=lowest)
        if dyn_htf1_valid
            dyn_collect_levels(dyn1_bsl_targets, dyn1_bsl_open, dyn1_ssl_targets, dyn1_ssl_open, adr_lower, adr_upper, get_htf_tag_for_tf(dyn_htf1), 1, cons_ticks, cons_is_bsl, cons_tags, cons_ranks)
        if dyn_htf2_valid
            dyn_collect_levels(dyn2_bsl_targets, dyn2_bsl_open, dyn2_ssl_targets, dyn2_ssl_open, adr_lower, adr_upper, get_htf_tag_for_tf(dyn_htf2), 2, cons_ticks, cons_is_bsl, cons_tags, cons_ranks)
        if dyn_htf3_valid
            dyn_collect_levels(dyn3_bsl_targets, dyn3_bsl_open, dyn3_ssl_targets, dyn3_ssl_open, adr_lower, adr_upper, get_htf_tag_for_tf(dyn_htf3), 3, cons_ticks, cons_is_bsl, cons_tags, cons_ranks)
        if dyn_htf4_valid
            dyn_collect_levels(dyn4_bsl_targets, dyn4_bsl_open, dyn4_ssl_targets, dyn4_ssl_open, adr_lower, adr_upper, get_htf_tag_for_tf(dyn_htf4), 4, cons_ticks, cons_is_bsl, cons_tags, cons_ranks)
        if dyn_htf5_valid
            dyn_collect_levels(dyn5_bsl_targets, dyn5_bsl_open, dyn5_ssl_targets, dyn5_ssl_open, adr_lower, adr_upper, get_htf_tag_for_tf(dyn_htf5), 5, cons_ticks, cons_is_bsl, cons_tags, cons_ranks)
        if dyn_htf6_valid
            dyn_collect_levels(dyn6_bsl_targets, dyn6_bsl_open, dyn6_ssl_targets, dyn6_ssl_open, adr_lower, adr_upper, get_htf_tag_for_tf(dyn_htf6), 6, cons_ticks, cons_is_bsl, cons_tags, cons_ranks)
        if dyn_htf7_valid
            dyn_collect_levels(dyn7_bsl_targets, dyn7_bsl_open, dyn7_ssl_targets, dyn7_ssl_open, adr_lower, adr_upper, get_htf_tag_for_tf(dyn_htf7), 7, cons_ticks, cons_is_bsl, cons_tags, cons_ranks)
        if dyn_htf8_valid
            dyn_collect_levels(dyn8_bsl_targets, dyn8_bsl_open, dyn8_ssl_targets, dyn8_ssl_open, adr_lower, adr_upper, get_htf_tag_for_tf(dyn_htf8), 8, cons_ticks, cons_is_bsl, cons_tags, cons_ranks)

        // Draw consolidated levels (one line per unique price, highest HTF label with TF context)
        // Each line starts from a clean point (no candle crossing) up to 50 bars back
        dyn_draw_consolidated(cons_ticks, cons_is_bsl, cons_tags, cons_ranks, dyn_lines, dyn_labels, dyn_labels_secondary, dyn_line_color, dyn_bsl_label_color, dyn_ssl_label_color, open_style, line_end_bar, dyn_width_tier1, dyn_width_tier2, dyn_width_tier3)

    // ═══════════════════════════════════════════════════════════════════════════
    // MANUAL MODE DISPLAY - HTF1/HTF2/HTF3 lines (only when not in Dynamic mode)
    // ═══════════════════════════════════════════════════════════════════════════

    // BSL DISPLAY PROCESSING (Manual mode only)
    if not is_dynamic_mode and array.size(htf1_buyside_failure_bars) > 0
        local_open_lines_shown = 0
        local_filled_lines_shown = 0

        for i = array.size(htf1_buyside_failure_bars) - 1 to 0
            local_is_open = array.get(htf1_buyside_open, i)
            local_current_line = array.get(htf1_buyside_lines, i)
            local_current_label = array.get(htf1_buyside_labels, i)
            local_target = array.get(htf1_buyside_targets, i)

            local_should_show = false

            // Show open lines first, then filled lines
            if local_is_open and local_open_lines_shown < open_lines_count
                local_should_show := true
                local_open_lines_shown += 1
            else if not local_is_open and local_filled_lines_shown < filled_lines_count
                local_should_show := true
                local_filled_lines_shown += 1

            if local_should_show
                local_failure_time = array.get(htf1_buyside_failure_times, i)
                local_fill_time = array.get(htf1_buyside_fill_times, i)

                local_end_time = local_is_open ? time + (chart_tf_seconds * 1000 * htf1_extension) : local_fill_time
                local_line_color = local_is_open ? htf1_line_color : color.new(htf1_line_color, filled_opacity)
                local_line_style = get_line_style(local_is_open ? open_style : filled_style)
                local_line_width = local_is_open ? htf1_open_width : htf1_filled_width

                if na(local_current_line)
                    local_new_line = line.new(local_failure_time, local_target, local_end_time, local_target, xloc=xloc.bar_time)
                    line.set_color(local_new_line, local_line_color)
                    line.set_style(local_new_line, local_line_style)
                    line.set_width(local_new_line, local_line_width)
                    array.set(htf1_buyside_lines, i, local_new_line)
                else
                    line.set_xy1(local_current_line, local_failure_time, local_target)
                    line.set_xy2(local_current_line, local_end_time, local_target)
                    line.set_color(local_current_line, local_line_color)
                    line.set_style(local_current_line, local_line_style)
                    line.set_width(local_current_line, local_line_width)

                // Label management - only show on open lines
                if local_is_open
                    wick_timestamp = array.get(htf1_buyside_wick_times, i)
                    tooltip_text = format_tooltip(true, wick_timestamp)

                    if na(local_current_label)
                        local_new_label = label.new(
                             x=local_end_time,
                             y=local_target,
                             text=get_timeframe_text_with_suffix(true),
                             style=label.style_label_left,
                             textcolor=htf1_bsl_label_color,
                             size=get_label_text_size(),
                             xloc=xloc.bar_time,
                             tooltip=tooltip_text
                         )
                        label.set_color(local_new_label, bg_none())
                        array.set(htf1_buyside_labels, i, local_new_label)
                    else
                        label.set_xy(local_current_label, local_end_time, local_target)
                        label.set_text(local_current_label, get_timeframe_text_with_suffix(true))
                        label.set_textcolor(local_current_label, htf1_bsl_label_color)
                        label.set_size(local_current_label, get_label_text_size())
                        label.set_color(local_current_label, bg_none())
                        label.set_tooltip(local_current_label, tooltip_text)
                else if not na(local_current_label)
                    label.delete(local_current_label)
                    array.set(htf1_buyside_labels, i, na)
            else
                if not na(local_current_line)
                    line.delete(local_current_line)
                    array.set(htf1_buyside_lines, i, na)
                if not na(local_current_label)
                    label.delete(local_current_label)
                    array.set(htf1_buyside_labels, i, na)

    // SSL DISPLAY PROCESSING (Manual mode only)
    if not is_dynamic_mode and array.size(htf1_sellside_failure_bars) > 0
        local_open_lines_shown = 0
        local_filled_lines_shown = 0

        for i = array.size(htf1_sellside_failure_bars) - 1 to 0
            local_is_open = array.get(htf1_sellside_open, i)
            local_current_line = array.get(htf1_sellside_lines, i)
            local_current_label = array.get(htf1_sellside_labels, i)
            local_target = array.get(htf1_sellside_targets, i)

            local_should_show = false

            // Show open lines first, then filled lines
            if local_is_open and local_open_lines_shown < open_lines_count
                local_should_show := true
                local_open_lines_shown += 1
            else if not local_is_open and local_filled_lines_shown < filled_lines_count
                local_should_show := true
                local_filled_lines_shown += 1

            if local_should_show
                local_failure_time = array.get(htf1_sellside_failure_times, i)
                local_fill_time = array.get(htf1_sellside_fill_times, i)

                local_end_time = local_is_open ? time + (chart_tf_seconds * 1000 * htf1_extension) : local_fill_time
                local_line_color = local_is_open ? htf1_line_color : color.new(htf1_line_color, filled_opacity)
                local_line_style = get_line_style(local_is_open ? open_style : filled_style)
                local_line_width = local_is_open ? htf1_open_width : htf1_filled_width

                if na(local_current_line)
                    local_new_line = line.new(local_failure_time, local_target, local_end_time, local_target, xloc=xloc.bar_time)
                    line.set_color(local_new_line, local_line_color)
                    line.set_style(local_new_line, local_line_style)
                    line.set_width(local_new_line, local_line_width)
                    array.set(htf1_sellside_lines, i, local_new_line)
                else
                    line.set_xy1(local_current_line, local_failure_time, local_target)
                    line.set_xy2(local_current_line, local_end_time, local_target)
                    line.set_color(local_current_line, local_line_color)
                    line.set_style(local_current_line, local_line_style)
                    line.set_width(local_current_line, local_line_width)

                // Label management - only show on open lines
                if local_is_open
                    wick_timestamp = array.get(htf1_sellside_wick_times, i)
                    tooltip_text = format_tooltip(false, wick_timestamp)

                    if na(local_current_label)
                        local_new_label = label.new(
                             x=local_end_time,
                             y=local_target,
                             text=get_timeframe_text_with_suffix(false),
                             style=label.style_label_left,
                             textcolor=htf1_ssl_label_color,
                             size=get_label_text_size(),
                             xloc=xloc.bar_time,
                             tooltip=tooltip_text
                         )
                        label.set_color(local_new_label, bg_none())
                        array.set(htf1_sellside_labels, i, local_new_label)
                    else
                        label.set_xy(local_current_label, local_end_time, local_target)
                        label.set_text(local_current_label, get_timeframe_text_with_suffix(false))
                        label.set_textcolor(local_current_label, htf1_ssl_label_color)
                        label.set_size(local_current_label, get_label_text_size())
                        label.set_color(local_current_label, bg_none())
                        label.set_tooltip(local_current_label, tooltip_text)
                else if not na(local_current_label)
                    label.delete(local_current_label)
                    array.set(htf1_sellside_labels, i, na)
            else
                if not na(local_current_line)
                    line.delete(local_current_line)
                    array.set(htf1_sellside_lines, i, na)
                if not na(local_current_label)
                    label.delete(local_current_label)
                    array.set(htf1_sellside_labels, i, na)

// ═══════════════════════════════════════════════════════════════════════════════
// MEMORY CLEANUP
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.islast and initialized
    cleanup_max = math.max(100, (open_lines_count + filled_lines_count) * 2)

    // BSL-FIRST CLEANUP (LTF v3.0 PARITY) with enhanced memory management
    while array.size(htf1_buyside_failure_bars) > cleanup_max
        cleanup_old_line = array.shift(htf1_buyside_lines)
        cleanup_old_label = array.shift(htf1_buyside_labels)
        if not na(cleanup_old_line)
            line.delete(cleanup_old_line)
        if not na(cleanup_old_label)
            label.delete(cleanup_old_label)
        array.shift(htf1_buyside_failure_bars)
        array.shift(htf1_buyside_failure_times)
        array.shift(htf1_buyside_targets)
        array.shift(htf1_buyside_open)
        array.shift(htf1_buyside_fill_bars)
        array.shift(htf1_buyside_fill_times)
        array.shift(htf1_buyside_wick_times)

    while array.size(htf1_sellside_failure_bars) > cleanup_max
        cleanup_old_line = array.shift(htf1_sellside_lines)
        cleanup_old_label = array.shift(htf1_sellside_labels)
        if not na(cleanup_old_line)
            line.delete(cleanup_old_line)
        if not na(cleanup_old_label)
            label.delete(cleanup_old_label)
        array.shift(htf1_sellside_failure_bars)
        array.shift(htf1_sellside_failure_times)
        array.shift(htf1_sellside_targets)
        array.shift(htf1_sellside_open)
        array.shift(htf1_sellside_fill_bars)
        array.shift(htf1_sellside_fill_times)
        array.shift(htf1_sellside_wick_times)

// ═══════════════════════════════════════════════════════════════════════════════
// ADR BOXES DEBUG VISUALIZATION (verify ADR calculation matches ADR indicator)
// ═══════════════════════════════════════════════════════════════════════════════

var box adr_current_box = na
var array<box> adr_hist_boxes = array.new<box>()

if show_adr_boxes and is_dynamic_mode and barstate.islast
    // Delete old boxes
    box.delete(adr_current_box)
    for b in adr_hist_boxes
        box.delete(b)
    array.clear(adr_hist_boxes)

    // Draw current day's ADR box
    if not na(current_adr)
        float curr_upper = adr_current_open + (current_adr * adr_multiplier)
        float curr_lower = adr_current_open - (current_adr * adr_multiplier)
        adr_current_box := box.new(adr_day_start_time, curr_upper, time, curr_lower,
                                   xloc=xloc.bar_time, border_color=adr_box_color, bgcolor=adr_box_color,
                                   border_width=1, border_style=line.style_solid)

    // Draw historical ADR boxes
    int hist_count = math.min(adr_box_days - 1, array.size(adr_hist_opens))
    if hist_count > 0
        for i = 0 to hist_count - 1
            float h_open = array.get(adr_hist_opens, i)
            float h_adr = array.get(adr_hist_adrs, i)
            int h_start = array.get(adr_hist_starts, i)
            int h_end = array.get(adr_hist_ends, i)
            float h_upper = h_open + (h_adr * adr_multiplier)
            float h_lower = h_open - (h_adr * adr_multiplier)
            box h_box = box.new(h_start, h_upper, h_end, h_lower,
                                xloc=xloc.bar_time, border_color=adr_box_color, bgcolor=adr_box_color,
                                border_width=1, border_style=line.style_solid)
            array.push(adr_hist_boxes, h_box)

// HTF Algo Draw° [Pro+]