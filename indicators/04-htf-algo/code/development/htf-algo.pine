//@version=6
indicator('htf algo •', overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// HTF ALGO DRAW - HIGHER TIMEFRAME ALGORITHMIC LIQUIDITY DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

// Indicator meta
const string ALGO_DRAW_SUFFIX = " algo draw [NEW]"
const string SUFFIX_BSL = "(b)"
const string SUFFIX_SSL = "(s)"

// Reference level caps (same as LTF Algo)
const int CAP_ULTRA_SHORT = 80
const int CAP_SHORT = 100
const int CAP_MEDIUM_SHORT = 150
const int CAP_MEDIUM = 200
const int CAP_MEDIUM_LONG = 300
const int CAP_LONG = 400
const int CAP_DEFAULT = 200

// Magic numbers
const int MS_IN_SEC = 1000
const int OPEN_LINES_CAP = 10
const int FILLED_LINES_CAP = 10
const int MEMORY_MIN_TOTAL_MAX = 100
const int MEMORY_PRUNE_MULTIPLIER = 8
const int DASHBOARD_BASE_ROWS = 3
const int TABLE_SPACER_TRANSPARENCY = 100

// Style options
const string STYLE_SOLID = 'Solid'
const string STYLE_DASHED = 'Dashed'
const string STYLE_DOTTED = 'Dotted'

// Group constants for input organization
const string GROUP_HTF1 = "HTF 1"
const string GROUP_HTF2 = "HTF 2"
const string GROUP_HTF3 = "HTF 3"
const string GROUP_LINE_STYLES = "Line Styles"
const string GROUP_DASHBOARD = "Dashboard"
const string GROUP_DEV = "Development"

// Size options
const string SIZE_TINY = 'Tiny'
const string SIZE_SMALL = 'Small'
const string SIZE_NORMAL = 'Normal'
const string SIZE_LARGE = 'Large'

// Position options
const string POS_TOP_LEFT = 'Top Left'
const string POS_TOP_CENTER = 'Top Center'
const string POS_TOP_RIGHT = 'Top Right'
const string POS_MIDDLE_LEFT = 'Middle Left'
const string POS_MIDDLE_CENTER = 'Middle Center'
const string POS_MIDDLE_RIGHT = 'Middle Right'
const string POS_BOTTOM_LEFT = 'Bottom Left'
const string POS_BOTTOM_CENTER = 'Bottom Center'
const string POS_BOTTOM_RIGHT = 'Bottom Right'

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

// HTF 1
htf1_enabled = input.bool(true, 'Enable', group=GROUP_HTF1, inline='1')
htf1_auto = input.bool(true, 'Auto', group=GROUP_HTF1, inline='1')
htf1_timeframe = input.timeframe('60', '', group=GROUP_HTF1, inline='1')
htf1_open_lines = input.int(2, 'Open', minval=1, maxval=20, group=GROUP_HTF1, inline='2')
htf1_open_width = input.int(1, '', minval=1, maxval=5, group=GROUP_HTF1, inline='2')
htf1_filled_lines = input.int(1, 'Filled', minval=0, maxval=20, group=GROUP_HTF1, inline='3')
htf1_filled_width = input.int(1, '', minval=1, maxval=5, group=GROUP_HTF1, inline='3')
htf1_line_color = input.color(color.rgb(233, 30, 99), 'Line', group=GROUP_HTF1, inline='4')
htf1_fill_color = input.color(color.rgb(249, 121, 246), 'Fill', group=GROUP_HTF1, inline='4')
htf1_label_color = input.color(color.rgb(236, 64, 122), 'Label', group=GROUP_HTF1, inline='4')

// HTF 2
htf2_enabled = input.bool(false, '', group=GROUP_HTF2, inline='1')
htf2_timeframe = input.timeframe('240', '', group=GROUP_HTF2, inline='1')
htf2_open_lines = input.int(1, 'Open', minval=1, maxval=10, group=GROUP_HTF2, inline='2')
htf2_open_width = input.int(3, '', minval=1, maxval=5, group=GROUP_HTF2, inline='2')
htf2_filled_lines = input.int(0, 'Filled', minval=0, maxval=10, group=GROUP_HTF2, inline='3')
htf2_filled_width = input.int(1, '', minval=1, maxval=5, group=GROUP_HTF2, inline='3')
htf2_line_color = input.color(color.rgb(233, 30, 99), 'Line', group=GROUP_HTF2, inline='4')
htf2_fill_color = input.color(color.rgb(249, 121, 246), 'Fill', group=GROUP_HTF2, inline='4')
htf2_label_color = input.color(color.rgb(236, 64, 122), 'Label', group=GROUP_HTF2, inline='4')

// HTF 3
htf3_enabled = input.bool(false, '', group=GROUP_HTF3, inline='1')
htf3_timeframe = input.timeframe('1D', '', group=GROUP_HTF3, inline='1')
htf3_open_lines = input.int(1, 'Open', minval=1, maxval=10, group=GROUP_HTF3, inline='2')
htf3_open_width = input.int(5, '', minval=1, maxval=5, group=GROUP_HTF3, inline='2')
htf3_filled_lines = input.int(0, 'Filled', minval=0, maxval=10, group=GROUP_HTF3, inline='3')
htf3_filled_width = input.int(1, '', minval=1, maxval=5, group=GROUP_HTF3, inline='3')
htf3_line_color = input.color(color.rgb(233, 30, 99), 'Line', group=GROUP_HTF3, inline='4')
htf3_fill_color = input.color(color.rgb(249, 121, 246), 'Fill', group=GROUP_HTF3, inline='4')
htf3_label_color = input.color(color.rgb(236, 64, 122), 'Label', group=GROUP_HTF3, inline='4')

// Line Styles
open_style = input.string(STYLE_SOLID, 'Open', options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], group=GROUP_LINE_STYLES, inline='1')
filled_style = input.string(STYLE_DASHED, 'Filled', options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], group=GROUP_LINE_STYLES, inline='1')
filled_opacity = input.int(20, 'Opacity', minval=0, maxval=95, group=GROUP_LINE_STYLES, inline='1')

// Dashboard
show_dashboard = input.bool(false, 'Show', group=GROUP_DASHBOARD, inline='1')
table_position = input.string(POS_TOP_RIGHT, '', options=[POS_TOP_LEFT, POS_TOP_CENTER, POS_TOP_RIGHT, POS_MIDDLE_LEFT, POS_MIDDLE_CENTER, POS_MIDDLE_RIGHT, POS_BOTTOM_LEFT, POS_BOTTOM_CENTER, POS_BOTTOM_RIGHT], group=GROUP_DASHBOARD, inline='1')
show_color_table = input.bool(false, 'Colors', group=GROUP_DASHBOARD, inline='1')
table_bg_color = input.color(color.new(color.rgb(41, 98, 255), 90), 'Background', group=GROUP_DASHBOARD, inline='2')
table_border_color = input.color(color.rgb(41, 98, 255), 'Border', group=GROUP_DASHBOARD, inline='2')
default_text_color = input.color(color.rgb(120, 123, 134), 'Text', group=GROUP_DASHBOARD, inline='2')

// Development
show_htf_candles = input.bool(false, "HTF Candles", group=GROUP_DEV, inline='1', tooltip="Debug overlay showing HTF candles")
htf_bull_body_color = input.color(color.new(color.rgb(102, 187, 106), 74), "Bull", group=GROUP_DEV, inline='1')
htf_bull_wick_color = input.color(color.new(color.rgb(129, 199, 132), 85), "", group=GROUP_DEV, inline='1')
htf_bear_body_color = input.color(color.new(color.rgb(240, 98, 146), 74), "Bear", group=GROUP_DEV, inline='1')
htf_bear_wick_color = input.color(color.new(color.rgb(250, 161, 164), 80), "", group=GROUP_DEV, inline='1')

// ═══════════════════════════════════════════════════════════════════════════════
// DERIVED VALUES
// ═══════════════════════════════════════════════════════════════════════════════

open_lines_count = htf1_open_lines
filled_lines_count = htf1_filled_lines
chart_tf_seconds = timeframe.in_seconds(timeframe.period)
chart_tf_minutes = chart_tf_seconds / 60

// ═══════════════════════════════════════════════════════════════════════════════
// HTF VALIDATION SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

get_chart_tf_minutes_cached() => chart_tf_minutes


get_limit_zone() =>
    chart_tf_min = get_chart_tf_minutes_cached()
    switch
        chart_tf_min <= 3  => "ultra_short"    // 1-3m → 15m limit
        chart_tf_min == 5  => "short"          // 5m → 1H limit
        chart_tf_min == 10 => "short_med"      // 10m → 2H limit
        chart_tf_min <= 30 => "medium"         // 15-30m → 4H limit
        chart_tf_min <= 60 => "medium_long"    // 45-60m → 1D limit
        chart_tf_min <= 240 => "long"          // 2H-4H → 1D limit
        chart_tf_min <= 1440 => "daily"        // 1D → 1W limit
        chart_tf_min <= 10080 => "weekly"      // 1W → 3M limit
        chart_tf_min >= 43800 => "monthly"     // 1M+ → 3M limit
        => "extended"                          // Quarterly+ → Yearly limit


get_max_allowed_htf() =>
    chart_tf_min = get_chart_tf_minutes_cached()
    switch
        chart_tf_min <= 3  => '15'      // 1-3m max 15m
        chart_tf_min == 5  => '60'      // 5m max 1H
        chart_tf_min == 10 => '120'     // 10m max 2H
        chart_tf_min == 15 => '240'     // 15m max 4H
        chart_tf_min == 30 => '240'     // 30m max 4H
        chart_tf_min <= 60 => '1D'      // 45-60m max 1D
        chart_tf_min <= 240 => '1D'     // 2H-4H max 1D
        chart_tf_min <= 1440 => '1W'    // Daily max Weekly
        chart_tf_min <= 10080 => '3M'   // Weekly max 3M (allows Quarterly!)
        chart_tf_min >= 43800 => '3M'   // Monthly max 3M (consistent)
        => '12M'                        // Quarterly+ max Yearly


get_auto_htf_preferred() =>
    chart_tf_min = get_chart_tf_minutes_cached()
    switch
        chart_tf_min <= 2  => '15'   // 1-2m → 15m preferred
        chart_tf_min <= 5  => '60'   // 3-5m → 1H preferred
        chart_tf_min <= 15 => '60'   // 10-15m → 1H preferred
        chart_tf_min <= 30 => '120'  // 20-30m → 2H preferred
        chart_tf_min <= 60 => '240'  // 45-60m → 4H preferred
        chart_tf_min <= 240 => '1D'  // 2H-4H → 1D preferred
        chart_tf_min <= 1440 => '1W' // Daily → 1W preferred
        chart_tf_min <= 10080 => '1M'// Weekly → 1M preferred
        chart_tf_min >= 43800 => '3M'// Monthly+ → 3M preferred
        => '12M'                     // Quarterly+ → Yearly preferred


validate_and_limit_htf() =>
    limit_tf = get_max_allowed_htf()
    limit_seconds = timeframe.in_seconds(limit_tf)

    // AUTO MODE: use preferred, MANUAL MODE: use user selection
    req_tf = htf1_auto ? get_auto_htf_preferred() : htf1_timeframe
    req_seconds = timeframe.in_seconds(req_tf)

    // Validate: Must be > chart TF and <= limit
    if req_seconds > chart_tf_seconds and req_seconds <= limit_seconds
        req_tf
    else
        limit_tf  // Fallback to limit if invalid


// HTF1 validation (uses auto-htf logic)
validated_htf1_timeframe = validate_and_limit_htf()
htf1_is_valid = htf1_enabled and timeframe.in_seconds(validated_htf1_timeframe) > chart_tf_seconds
htf1_seconds = timeframe.in_seconds(validated_htf1_timeframe)

// HTF2 validation (manual only, must be > chart TF)
htf2_seconds = timeframe.in_seconds(htf2_timeframe)
htf2_is_valid = htf2_enabled and htf2_seconds > chart_tf_seconds

// HTF3 validation (manual only, must be > chart TF)
htf3_seconds = timeframe.in_seconds(htf3_timeframe)
htf3_is_valid = htf3_enabled and htf3_seconds > chart_tf_seconds

// Visual hierarchy: higher TF = further label extension (in bars)
htf1_extension = 4
htf2_extension = htf2_seconds > htf1_seconds ? 6 : 4
htf3_extension = htf3_seconds > math.max(htf1_seconds, htf2_seconds) ? 8 : (htf3_seconds > htf1_seconds ? 6 : 4)

