var string last_limit_zone = ""

// ═══════════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

to_tick(price) => math.round(price / syminfo.mintick)
from_tick(tick) => tick * syminfo.mintick

// TimePriceLevel helper functions
clear_time_level(TimePriceLevel level) =>
    array.clear(level.prices)
    array.clear(level.times)
    array.clear(level.mitigated)
    array.clear(level.mitigation_times)
    level.current_price := na
    level.current_time := na
    level.current_mitigated := false
    level.current_mitigation_time := na

prune_time_level(TimePriceLevel level) =>
    while array.size(level.prices) > MAX_STORED_LEVELS
        array.shift(level.prices)
        array.shift(level.times)
        array.shift(level.mitigated)
        array.shift(level.mitigation_times)

clear_htf_slot(HtfSlot slot) =>
    array.clear(slot.bsl_targets)
    array.clear(slot.bsl_open)
    array.clear(slot.bsl_detect_times)
    array.clear(slot.bsl_fill_times)
    array.clear(slot.ssl_targets)
    array.clear(slot.ssl_open)
    array.clear(slot.ssl_detect_times)
    array.clear(slot.ssl_fill_times)
    array.clear(slot.eligible_high_ticks)
    array.clear(slot.eligible_low_ticks)
    array.clear(slot.eligible_high_times)
    array.clear(slot.eligible_low_times)
    slot.has_history := false

clear_manual_side(ManualSide side) =>
    array.clear(side.failure_bars)
    array.clear(side.failure_times)
    array.clear(side.targets)
    array.clear(side.is_open)
    array.clear(side.fill_bars)
    array.clear(side.fill_times)
    for ln in side.lines
        line.delete(ln)
    array.clear(side.lines)
    for lb in side.labels
        label.delete(lb)
    array.clear(side.labels)
    array.clear(side.wick_times)

clear_manual_slot(ManualSlot slot) =>
    clear_manual_side(slot.buyside)
    clear_manual_side(slot.sellside)
    array.clear(slot.eligible_high_ticks)
    array.clear(slot.eligible_low_ticks)
    array.clear(slot.eligible_high_times)
    array.clear(slot.eligible_low_times)
    slot.has_history := false

get_reference_levels_cap() =>
    htf_min = timeframe.in_seconds(validated_htf1_timeframe) / 60
    if htf_min <= 2
        CAP_ULTRA_SHORT
    else if htf_min <= 5
        CAP_SHORT
    else if htf_min <= 30
        CAP_MEDIUM_SHORT
    else if htf_min <= 90
        CAP_MEDIUM
    else if htf_min <= 240
        CAP_MEDIUM_LONG
    else if htf_min <= 10080  // Up to weekly
        CAP_LONG
    else
        CAP_DEFAULT


get_size(string sz, bool bump) =>
    switch sz
        SIZE_TINY => bump ? size.small : size.tiny
        SIZE_SMALL => bump ? size.normal : size.small
        SIZE_NORMAL => bump ? size.large : size.normal
        SIZE_LARGE => bump ? size.huge : size.large
        => bump ? size.normal : size.small

get_tier_from_rank(int rank) =>
    if rank <= TIER_MACRO_MAX_RANK
        1
    else if rank <= TIER_SWING_MAX_RANK
        2
    else
        3

format_label(string content, bool is_bsl) =>
    prefix = is_bsl ? LABEL_PREFIX_BSL : LABEL_PREFIX_SSL
    prefix + content + LABEL_SUFFIX

format_dyn_label(string all_tags, bool is_bsl) =>
    tags_arr = str.split(all_tags, ",")
    result = array.get(tags_arr, 0)
    if array.size(tags_arr) > 1
        for i = 1 to array.size(tags_arr) - 1
            result += LABEL_SEPARATOR + array.get(tags_arr, i)
    format_label(result, is_bsl)

// ═══════════════════════════════════════════════════════════════════════════════
// DYNAMIC MODE - PARAMETERIZED DETECTION FUNCTIONS (DRY)
// ═══════════════════════════════════════════════════════════════════════════════

// BSL Detection: Wick took LOW but closed at/above → target is the HIGH
dyn_detect_bsl(float prev_high, float prev_low, float prev_close, int detect_time,
               array<float> bsl_targets, array<bool> bsl_open,
               array<int> bsl_detect_times, array<int> bsl_fill_times,
               array<int> eligible_low_ticks, array<int> eligible_low_times) =>
    int elig_size = array.size(eligible_low_ticks)
    if elig_size == 0
        false
    else
        bool detected = false
        for i = 0 to elig_size - 1
            ref_low = from_tick(array.get(eligible_low_ticks, i))
            if prev_low < ref_low and prev_close >= ref_low
                target_tick = to_tick(prev_high)
                bool already_exists = false
                int tgt_size = array.size(bsl_targets)
                if tgt_size > 0
                    for j = 0 to tgt_size - 1
                        if to_tick(array.get(bsl_targets, j)) == target_tick
                            already_exists := true
                            break
                if not already_exists
                    array.push(bsl_targets, prev_high)
                    array.push(bsl_open, true)
                    array.push(bsl_detect_times, detect_time)
                    array.push(bsl_fill_times, int(na))
                    detected := true
                break
        detected

// SSL Detection: Wick took HIGH but closed at/below → target is the LOW
dyn_detect_ssl(float prev_high, float prev_low, float prev_close, int detect_time,
               array<float> ssl_targets, array<bool> ssl_open,
               array<int> ssl_detect_times, array<int> ssl_fill_times,
               array<int> eligible_high_ticks, array<int> eligible_high_times) =>
    int elig_size = array.size(eligible_high_ticks)
    if elig_size == 0
        false
    else
        bool detected = false
        for i = 0 to elig_size - 1
            ref_high = from_tick(array.get(eligible_high_ticks, i))
            if prev_high > ref_high and prev_close <= ref_high
                target_tick = to_tick(prev_low)
                bool already_exists = false
                int tgt_size = array.size(ssl_targets)
                if tgt_size > 0
                    for j = 0 to tgt_size - 1
                        if to_tick(array.get(ssl_targets, j)) == target_tick
                            already_exists := true
                            break
                if not already_exists
                    array.push(ssl_targets, prev_low)
                    array.push(ssl_open, true)
                    array.push(ssl_detect_times, detect_time)
                    array.push(ssl_fill_times, int(na))
                    detected := true
                break
        detected

// Fill Detection: Mark levels as filled when price reaches target
dyn_check_fills(float current_high, float current_low, int current_time,
                array<float> bsl_targets, array<bool> bsl_open, array<int> bsl_fill_times,
                array<float> ssl_targets, array<bool> ssl_open, array<int> ssl_fill_times) =>
    // BSL fills when high reaches target
    int bsl_size = array.size(bsl_targets)
    if bsl_size > 0
        for i = 0 to bsl_size - 1
            if array.get(bsl_open, i) and current_high >= array.get(bsl_targets, i)
                array.set(bsl_open, i, false)
                array.set(bsl_fill_times, i, current_time)
    // SSL fills when low reaches target
    int ssl_size = array.size(ssl_targets)
    if ssl_size > 0
        for i = 0 to ssl_size - 1
            if array.get(ssl_open, i) and current_low <= array.get(ssl_targets, i)
                array.set(ssl_open, i, false)
                array.set(ssl_fill_times, i, current_time)

// Track eligible reference levels for a candle
dyn_track_candle(float candle_high, float candle_low, int candle_time, int cap,
                 array<int> eligible_high_ticks, array<int> eligible_low_ticks,
                 array<int> eligible_high_times, array<int> eligible_low_times) =>
    // Track high as potential SSL reference
    high_tick = to_tick(candle_high)
    array.push(eligible_high_ticks, high_tick)
    array.push(eligible_high_times, candle_time)
    if array.size(eligible_high_ticks) > cap
        array.shift(eligible_high_ticks)
        array.shift(eligible_high_times)
    // Track low as potential BSL reference
    low_tick = to_tick(candle_low)
    array.push(eligible_low_ticks, low_tick)
    array.push(eligible_low_times, candle_time)
    if array.size(eligible_low_ticks) > cap
        array.shift(eligible_low_ticks)
        array.shift(eligible_low_times)

// Remove eligible levels that were broken by the candle
dyn_remove_broken(float candle_high, float candle_low,
                  array<int> eligible_high_ticks, array<int> eligible_high_times,
                  array<int> eligible_low_ticks, array<int> eligible_low_times) =>
    // Remove broken highs (exceeded by candle high)
    if array.size(eligible_high_ticks) > 0
        idx = array.size(eligible_high_ticks) - 1
        while idx >= 0
            if candle_high >= from_tick(array.get(eligible_high_ticks, idx))
                array.remove(eligible_high_ticks, idx)
                array.remove(eligible_high_times, idx)
            idx -= 1
    // Remove broken lows (exceeded by candle low)
    if array.size(eligible_low_ticks) > 0
        idx = array.size(eligible_low_ticks) - 1
        while idx >= 0
            if candle_low <= from_tick(array.get(eligible_low_ticks, idx))
                array.remove(eligible_low_ticks, idx)
                array.remove(eligible_low_times, idx)
            idx -= 1

// Process HTF detection - centralized logic for all dynamic HTF slots
dyn_process_htf(float prev_h, float prev_l, float prev_c, int prev_t,
                array<float> bsl_targets, array<bool> bsl_open,
                array<int> bsl_detect_times, array<int> bsl_fill_times,
                array<float> ssl_targets, array<bool> ssl_open,
                array<int> ssl_detect_times, array<int> ssl_fill_times,
                array<int> eligible_high_ticks, array<int> eligible_low_ticks,
                array<int> eligible_high_times, array<int> eligible_low_times,
                bool has_history, int ref_cap) =>
    result = has_history
    if not na(prev_h)
        if has_history
            dyn_detect_bsl(prev_h, prev_l, prev_c, prev_t, bsl_targets, bsl_open, bsl_detect_times, bsl_fill_times, eligible_low_ticks, eligible_low_times)
            dyn_detect_ssl(prev_h, prev_l, prev_c, prev_t, ssl_targets, ssl_open, ssl_detect_times, ssl_fill_times, eligible_high_ticks, eligible_high_times)
            dyn_remove_broken(prev_h, prev_l, eligible_high_ticks, eligible_high_times, eligible_low_ticks, eligible_low_times)
        dyn_track_candle(prev_h, prev_l, prev_t, ref_cap, eligible_high_ticks, eligible_low_ticks, eligible_high_times, eligible_low_times)
        result := true
    result

slot_process_htf(float prev_h, float prev_l, float prev_c, int prev_t, HtfSlot slot, int ref_cap) =>
    if not na(prev_h)
        if slot.has_history
            dyn_detect_bsl(prev_h, prev_l, prev_c, prev_t, slot.bsl_targets, slot.bsl_open, slot.bsl_detect_times, slot.bsl_fill_times, slot.eligible_low_ticks, slot.eligible_low_times)
            dyn_detect_ssl(prev_h, prev_l, prev_c, prev_t, slot.ssl_targets, slot.ssl_open, slot.ssl_detect_times, slot.ssl_fill_times, slot.eligible_high_ticks, slot.eligible_high_times)
            dyn_remove_broken(prev_h, prev_l, slot.eligible_high_ticks, slot.eligible_high_times, slot.eligible_low_ticks, slot.eligible_low_times)
        dyn_track_candle(prev_h, prev_l, prev_t, ref_cap, slot.eligible_high_ticks, slot.eligible_low_ticks, slot.eligible_high_times, slot.eligible_low_times)
        slot.has_history := true

slot_check_fills(float current_high, float current_low, int current_time, HtfSlot slot) =>
    dyn_check_fills(current_high, current_low, current_time, slot.bsl_targets, slot.bsl_open, slot.bsl_fill_times, slot.ssl_targets, slot.ssl_open, slot.ssl_fill_times)

// Find nearest OPEN level within ADR band
dyn_find_nearest_in_range(array<float> targets, array<bool> is_open, float lower_band, float upper_band, float current_price) =>
    float nearest = na
    float min_dist = na
    if array.size(targets) > 0
        for i = 0 to array.size(targets) - 1
            if array.get(is_open, i)
                target = array.get(targets, i)
                if target >= lower_band and target <= upper_band
                    dist = math.abs(target - current_price)
                    if na(min_dist) or dist < min_dist
                        min_dist := dist
                        nearest := target
    nearest

// Collect OPEN levels, deduplicate by price
// out_tags stores comma-separated list of all contributing TFs, primary (highest rank) first
// htf_rank: lower = higher TF (1=Monthly, 2=Weekly, 3=Daily, etc.)
// max_levels: max BSL + SSL per TF (passed from caller based on ADR filter setting)
dyn_collect_levels(array<float> bsl_targets, array<bool> bsl_open,
                   array<float> ssl_targets, array<bool> ssl_open,
                   float lower_band, float upper_band, string htf_tag, int htf_rank,
                   bool use_adr_filter, int max_levels, float current_price,
                   array<int> out_ticks, array<bool> out_is_bsl, array<string> out_tags, array<int> out_ranks) =>
    int max_bsl = max_levels
    int max_ssl = max_levels

    // Temporary arrays to collect eligible levels, then sort by proximity
    var array<float> temp_bsl = array.new_float()
    var array<float> temp_ssl = array.new_float()
    array.clear(temp_bsl)
    array.clear(temp_ssl)

    // First pass: collect all eligible BSL levels above current price
    int bsl_size = array.size(bsl_targets)
    if bsl_size > 0
        for i = 0 to bsl_size - 1
            if array.get(bsl_open, i)
                target = array.get(bsl_targets, i)
                bool in_range = use_adr_filter ? (target >= lower_band and target <= upper_band) : true
                if in_range and target > current_price
                    array.push(temp_bsl, target)

    // Sort ascending (lowest first = nearest to price from above)
    array.sort(temp_bsl, order.ascending)

    // Take up to max_bsl nearest levels and add to output
    int bsl_to_add = math.min(max_bsl, array.size(temp_bsl))
    if bsl_to_add > 0
        for i = 0 to bsl_to_add - 1
            target = array.get(temp_bsl, i)
            tick = to_tick(target)
            found_idx = -1
            int out_size = array.size(out_ticks)
            if out_size > 0
                for j = 0 to out_size - 1
                    if array.get(out_ticks, j) == tick and array.get(out_is_bsl, j)
                        found_idx := j
                        break
            if found_idx >= 0
                existing_tags = array.get(out_tags, found_idx)
                existing_rank = array.get(out_ranks, found_idx)
                if htf_rank < existing_rank
                    array.set(out_tags, found_idx, htf_tag + "," + existing_tags)
                    array.set(out_ranks, found_idx, htf_rank)
                else
                    array.set(out_tags, found_idx, existing_tags + "," + htf_tag)
            else
                array.push(out_ticks, tick)
                array.push(out_is_bsl, true)
                array.push(out_tags, htf_tag)
                array.push(out_ranks, htf_rank)

    // First pass: collect all eligible SSL levels below current price
    int ssl_size = array.size(ssl_targets)
    if ssl_size > 0
        for i = 0 to ssl_size - 1
            if array.get(ssl_open, i)
                target = array.get(ssl_targets, i)
                bool in_range = use_adr_filter ? (target >= lower_band and target <= upper_band) : true
                if in_range and target < current_price
                    array.push(temp_ssl, target)

    // Sort descending (highest first = nearest to price from below)
    array.sort(temp_ssl, order.descending)

    // Take up to max_ssl nearest levels and add to output
    int ssl_to_add = math.min(max_ssl, array.size(temp_ssl))
    if ssl_to_add > 0
        for i = 0 to ssl_to_add - 1
            target = array.get(temp_ssl, i)
            tick = to_tick(target)
            found_idx = -1
            int out_size = array.size(out_ticks)
            if out_size > 0
                for j = 0 to out_size - 1
                    if array.get(out_ticks, j) == tick and not array.get(out_is_bsl, j)
                        found_idx := j
                        break
            if found_idx >= 0
                existing_tags = array.get(out_tags, found_idx)
                existing_rank = array.get(out_ranks, found_idx)
                if htf_rank < existing_rank
                    array.set(out_tags, found_idx, htf_tag + "," + existing_tags)
                    array.set(out_ranks, found_idx, htf_rank)
                else
                    array.set(out_tags, found_idx, existing_tags + "," + htf_tag)
            else
                array.push(out_ticks, tick)
                array.push(out_is_bsl, false)
                array.push(out_tags, htf_tag)
                array.push(out_ranks, htf_rank)

slot_collect_levels(HtfSlot slot, float lower_band, float upper_band, string htf_tag, bool use_adr, int max_levels, float current_price, array<int> out_ticks, array<bool> out_is_bsl, array<string> out_tags, array<int> out_ranks) =>
    dyn_collect_levels(slot.bsl_targets, slot.bsl_open, slot.ssl_targets, slot.ssl_open, lower_band, upper_band, htf_tag, slot.rank, use_adr, max_levels, current_price, out_ticks, out_is_bsl, out_tags, out_ranks)

// Format time level label with date (e.g., "16:00 Jan 2")
format_time_level_label(string base_text, int level_time) =>
    string month_str = str.format("{0,date,MMM}", level_time)
    string day_str = str.format("{0,date,d}", level_time)
    base_text + " " + month_str + " " + day_str

// Find tick index in array, returns -1 if not found
find_tick_index(int tick, array<int> ticks) =>
    int found_idx = -1
    int arr_size = array.size(ticks)
    if arr_size > 0
        for j = 0 to arr_size - 1
            if array.get(ticks, j) == tick
                found_idx := j
                break
    found_idx

// Merge tag into existing entry at index
merge_tag_at_index(int idx, string new_tag, array<string> tags) =>
    existing_tags = array.get(tags, idx)
    array.set(tags, idx, existing_tags + "," + new_tag)

// Add or merge a time level into open levels arrays
add_or_merge_open_level(int tick, string time_tag, array<int> out_ticks, array<bool> out_is_bsl, array<string> out_tags, array<int> out_ranks) =>
    int found_idx = find_tick_index(tick, out_ticks)
    if found_idx >= 0
        merge_tag_at_index(found_idx, time_tag, out_tags)
    else
        array.push(out_ticks, tick)
        array.push(out_is_bsl, true)
        array.push(out_tags, time_tag)
        array.push(out_ranks, TIME_LEVEL_RANK)

// Collect unmitigated time-based levels within ADR range
// Merges with existing HTF levels if they share the same price tick
// When most_recent_only=true, only shows the current level (older levels visible once current is taken out)
collect_time_levels(TimePriceLevel level, float lower_band, float upper_band, bool use_adr_filter, bool most_recent_only,
                    array<int> out_ticks, array<bool> out_is_bsl, array<string> out_tags, array<int> out_ranks) =>
    bool current_added = false
    if not na(level.current_price) and not level.current_mitigated
        bool in_range = use_adr_filter ? (level.current_price >= lower_band and level.current_price <= upper_band) : true
        if in_range
            int tick = to_tick(level.current_price)
            string time_tag = format_time_level_label(level.label_text, level.current_time)
            add_or_merge_open_level(tick, time_tag, out_ticks, out_is_bsl, out_tags, out_ranks)
            current_added := true

    // Skip stored levels if most_recent_only is enabled and current level was added
    if not (most_recent_only and current_added)
        int stored_size = array.size(level.prices)
        if stored_size > 0
            for i = 0 to stored_size - 1
                if not array.get(level.mitigated, i)
                    float lvl = array.get(level.prices, i)
                    bool in_range = use_adr_filter ? (lvl >= lower_band and lvl <= upper_band) : true
                    if in_range
                        int tick = to_tick(lvl)
                        string time_tag = format_time_level_label(level.label_text, array.get(level.times, i))
                        add_or_merge_open_level(tick, time_tag, out_ticks, out_is_bsl, out_tags, out_ranks)
                        if most_recent_only
                            break  // Only show the most recent stored level

// Draw consolidated levels with progressive widths/sizes and separate BSL/SSL label colors
dyn_draw_consolidated(array<int> ticks, array<bool> is_bsl, array<string> tags, array<int> ranks,
                      array<line> lines_arr, array<label> labels_arr,
                      color line_col, color macro_col, color bsl_lbl_col, color ssl_lbl_col, color c1600_col, int end_bar,
                      int w1, int w2, int w3, string s1, string s2, string s3, bool multi_tf_only,
                      bool do_highlight, int nearest_bsl_tick, int nearest_ssl_tick, bool show_price) =>
    int tick_count = array.size(ticks)
    if tick_count > 0
        for i = 0 to tick_count - 1
            rank = array.get(ranks, i)
            all_tags = array.get(tags, i)
            bool is_time_level = rank == TIME_LEVEL_RANK
            bool is_macro = rank <= TIER_MACRO_MAX_RANK and not is_time_level
            bool has_multiple_tfs = str.contains(all_tags, ",")
            if multi_tf_only and not is_macro and not has_multiple_tfs and not is_time_level
                continue
            tick = array.get(ticks, i)
            price = from_tick(tick)
            is_buy = array.get(is_bsl, i)
            tier = is_time_level ? 2 : get_tier_from_rank(rank)
            bool is_nearest = do_highlight and not is_time_level and ((is_buy and tick == nearest_bsl_tick) or (not is_buy and tick == nearest_ssl_tick))
            line_w = tier == 1 ? w1 : tier == 2 ? w2 : w3
            line_w := is_nearest ? line_w + 1 : line_w
            tier_size = tier == 1 ? s1 : tier == 2 ? s2 : s3
            lbl_sz = get_size(tier_size, is_nearest)
            lbl_col = is_time_level ? c1600_col : (is_buy ? bsl_lbl_col : ssl_lbl_col)
            lbl_text = is_time_level ? all_tags : format_dyn_label(all_tags, is_buy)
            lbl_text += show_price ? " • " + str.tostring(price, format.mintick) : ""
            ln_col = is_time_level ? c1600_col : (is_macro ? macro_col : line_col)
            ln = line.new(end_bar - LINE_LOOKBACK_BARS, price, end_bar, price, color=ln_col, width=line_w, style=line.style_solid)
            lb = label.new(end_bar, price, lbl_text, style=label.style_label_left, textcolor=lbl_col, size=lbl_sz, color=color.new(color.white, 100))
            array.push(lines_arr, ln)
            array.push(labels_arr, lb)

// Parameterized HTF tag generator - works for any timeframe
get_htf_tag_for_tf(simple string tf) =>
    local_htf_seconds = timeframe.in_seconds(tf)
    local_htf_minutes = local_htf_seconds / 60

    if local_htf_minutes < CHART_TF_1D
        if local_htf_minutes % CHART_TF_1H == 0
            str.tostring(int(local_htf_minutes / CHART_TF_1H)) + "H"
        else
            str.tostring(int(local_htf_minutes)) + "m"
    else if local_htf_minutes == CHART_TF_1D
        "1D"
    else if local_htf_minutes == CHART_TF_1W
        "1W"
    else if tf == TF_1MO
        "1M"
    else if tf == TF_3MO
        "3M"
    else if tf == '6M'
        "6M"
    else if tf == TF_1Y
        "12M"
    else
        tf

create_end_label(end_time, target_price, label_text_color, is_bsl, tooltip_text) =>
    lab = label.new(
         x=end_time,
         y=target_price,
         text=format_label(get_htf_tag_for_tf(validated_htf1_timeframe), is_bsl),
         style=label.style_label_left,
         textcolor=label_text_color,
         size=get_size(htf1_label_size, false),
         xloc=xloc.bar_time,
         tooltip=tooltip_text
     )
    label.set_color(lab, COLOR_TRANSPARENT)
    lab

format_tooltip(is_bsl, wick_timestamp) =>
    type_text = is_bsl ? "BSL: Wick took LOW" : "SSL: Wick took HIGH"
    formatted_time = str.format_time(wick_timestamp, "MMM dd, yyyy HH:mm", syminfo.timezone)
    type_text + " • " + formatted_time + ", " + get_htf_tag_for_tf(validated_htf1_timeframe)

// Manual mode display - parameterized for BSL/SSL
manual_display_levels(array<int> failure_bars, array<int> failure_times, array<float> targets,
                      array<bool> is_open_arr, array<int> fill_times, array<line> lines_arr,
                      array<label> labels_arr, array<int> wick_times, bool is_bsl, color text_color) =>
    local_open_shown = 0
    local_filled_shown = 0
    arr_size = array.size(failure_bars)
    if arr_size > 0
        for i = arr_size - 1 to 0
            local_is_open = array.get(is_open_arr, i)
            local_line = array.get(lines_arr, i)
            local_label = array.get(labels_arr, i)
            local_target = array.get(targets, i)
            local_show = false

            if local_is_open and local_open_shown < open_lines_count
                local_show := true
                local_open_shown += 1
            else if not local_is_open and local_filled_shown < filled_lines_count
                local_show := true
                local_filled_shown += 1

            if local_show
                local_fail_time = array.get(failure_times, i)
                local_fill_time = array.get(fill_times, i)
                local_end_time = local_is_open ? time + (chart_tf_seconds * 1000 * htf1_extension) : local_fill_time
                local_ln_color = local_is_open ? line_color : manual_filled_color
                local_ln_style = local_is_open ? line.style_solid : line.style_dashed
                local_ln_width = local_is_open ? htf1_open_width : htf1_filled_width

                if na(local_line)
                    new_line = line.new(local_fail_time, local_target, local_end_time, local_target, xloc=xloc.bar_time)
                    line.set_color(new_line, local_ln_color)
                    line.set_style(new_line, local_ln_style)
                    line.set_width(new_line, local_ln_width)
                    array.set(lines_arr, i, new_line)
                else
                    line.set_xy1(local_line, local_fail_time, local_target)
                    line.set_xy2(local_line, local_end_time, local_target)
                    line.set_color(local_line, local_ln_color)
                    line.set_style(local_line, local_ln_style)
                    line.set_width(local_line, local_ln_width)

                if local_is_open
                    wick_ts = array.get(wick_times, i)
                    tt_text = format_tooltip(is_bsl, wick_ts)
                    if na(local_label)
                        new_label = label.new(x=local_end_time, y=local_target,
                             text=format_label(get_htf_tag_for_tf(validated_htf1_timeframe), is_bsl),
                             style=label.style_label_left, textcolor=text_color,
                             size=get_size(htf1_label_size, false), xloc=xloc.bar_time, tooltip=tt_text)
                        label.set_color(new_label, COLOR_TRANSPARENT)
                        array.set(labels_arr, i, new_label)
                    else
                        label.set_xy(local_label, local_end_time, local_target)
                        label.set_text(local_label, format_label(get_htf_tag_for_tf(validated_htf1_timeframe), is_bsl))
                        label.set_textcolor(local_label, text_color)
                        label.set_size(local_label, get_size(htf1_label_size, false))
                        label.set_color(local_label, COLOR_TRANSPARENT)
                        label.set_tooltip(local_label, tt_text)
                else if not na(local_label)
                    label.delete(local_label)
                    array.set(labels_arr, i, na)
            else
                if not na(local_line)
                    line.delete(local_line)
                    array.set(lines_arr, i, na)
                if not na(local_label)
                    label.delete(local_label)
                    array.set(labels_arr, i, na)

// Manual mode cleanup - parameterized for BSL/SSL
manual_cleanup_levels(array<int> failure_bars, array<int> failure_times, array<float> targets,
                      array<bool> is_open_arr, array<int> fill_bars, array<int> fill_times,
                      array<line> lines_arr, array<label> labels_arr, array<int> wick_times, int max_size) =>
    while array.size(failure_bars) > max_size
        old_line = array.shift(lines_arr)
        old_label = array.shift(labels_arr)
        if not na(old_line)
            line.delete(old_line)
        if not na(old_label)
            label.delete(old_label)
        array.shift(failure_bars)
        array.shift(failure_times)
        array.shift(targets)
        array.shift(is_open_arr)
        array.shift(fill_bars)
        array.shift(fill_times)
        array.shift(wick_times)

// Manual mode fill detection - parameterized for BSL/SSL
manual_check_fills(array<float> targets, array<bool> is_open_arr, array<int> failure_bars,
                   array<int> fill_bars, array<int> fill_times, bool is_bsl) =>
    arr_size = array.size(targets)
    if arr_size > 0
        for i = 0 to arr_size - 1
            if array.get(is_open_arr, i) and bar_index > array.get(failure_bars, i)
                target = array.get(targets, i)
                filled = is_bsl ? high >= target : low <= target
                if filled
                    array.set(is_open_arr, i, false)
                    array.set(fill_bars, i, bar_index)
                    array.set(fill_times, i, int(time))

// Get current chart timeframe display
get_chart_tf_display() =>
    if timeframe.isintraday
        m = timeframe.multiplier
        m % 60 == 0 ? str.tostring(m / 60) + "H" : str.tostring(m) + "m"
    else if timeframe.isdaily
        str.tostring(timeframe.multiplier) + "D"
    else if timeframe.isweekly
        str.tostring(timeframe.multiplier) + "W"
    else if timeframe.ismonthly
        str.tostring(timeframe.multiplier) + "M"
    else
        timeframe.period

// Get allowed HTF preset list with cap - CLEAN FORMAT
get_allowed_htf_presets() =>
    chart_tf_min = chart_tf_minutes
    preset_list = array.new<string>()
    cap_display = ""

    if chart_tf_min <= 3  // 1-3m chart → cap: 15m
        array.push(preset_list, "15m")
        cap_display := "15m"
    else if chart_tf_min == 5  // 5m → cap: 1H
        array.push(preset_list, "15m")
        array.push(preset_list, "30m")
        array.push(preset_list, "1H")
        cap_display := "1H"
    else if chart_tf_min == 10  // 10m → cap: 2H
        array.push(preset_list, "15m")
        array.push(preset_list, "30m")
        array.push(preset_list, "1H")
        array.push(preset_list, "2H")
        cap_display := "2H"
    else if chart_tf_min == 15  // 15m → cap: 4H
        array.push(preset_list, "30m")
        array.push(preset_list, "1H")
        array.push(preset_list, "2H")
        array.push(preset_list, "4H")
        cap_display := "4H"
    else if chart_tf_min == 30  // 30m → cap: 4H
        array.push(preset_list, "1H")
        array.push(preset_list, "2H")
        array.push(preset_list, "4H")
        cap_display := "4H"
    else if chart_tf_min <= 60  // 45-60m → cap: 1D
        array.push(preset_list, "2H")
        array.push(preset_list, "4H")
        array.push(preset_list, "1D")
        cap_display := "1D"
    else if chart_tf_min <= 240  // 2H-4H-6H-7H etc → cap: 1D
        array.push(preset_list, "1D")
        cap_display := "1D"
    else if chart_tf_min <= 1440  // Daily → cap: 1W
        array.push(preset_list, "1W")
        cap_display := "1W"
    else if chart_tf_min <= 10080  // Weekly → cap: 3M
        array.push(preset_list, "1M")
        array.push(preset_list, "3M")
        cap_display := "3M"
    else if chart_tf_min >= 43800  // Monthly+ → cap: 3M
        array.push(preset_list, "3M")
        cap_display := "3M"

    // Convert array to comma-separated string with cap
    if array.size(preset_list) == 0
        "None"
    else
        preset_result = ""
        for i = 0 to array.size(preset_list) - 1
            if i > 0
                preset_result := preset_result + ", "
            preset_result := preset_result + array.get(preset_list, i)

        // Format: "Presets: 15m, 30m, 1H • Any up to 1H"
        "Presets: " + preset_result + " • Any up to " + cap_display

// Parameterized function to add eligible level (replaces 6 duplicate functions)
// Uses direct loop instead of array.indexof for better performance
add_eligible_level(float price, int timestamp, array<int> ticks_arr, array<int> times_arr, int cap) =>
    tick = to_tick(price)
    // Check if tick already exists (direct loop, no array.indexof)
    bool exists = false
    int arr_size = array.size(ticks_arr)
    if arr_size > 0
        for i = 0 to arr_size - 1
            if array.get(ticks_arr, i) == tick
                exists := true
                break
    if not exists
        array.push(ticks_arr, tick)
        array.push(times_arr, timestamp)
        // Prune if over cap
        while array.size(ticks_arr) > cap
            array.shift(ticks_arr)
            array.shift(times_arr)

// Reset state function for TF/symbol changes
reset_state() =>
    clear_manual_slot(manual)

// ═══════════════════════════════════════════════════════════════════════════════
// CHANGE DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

current_ticker = ticker.standard()
current_chart_tf = timeframe.period
current_htf_tf = validated_htf1_timeframe
current_limit_zone = get_limit_zone()


symbol_changed = current_ticker != last_ticker
chart_tf_changed = current_chart_tf != last_chart_tf
htf_tf_changed = current_htf_tf != last_htf_tf


limit_zone_changed = current_limit_zone != last_limit_zone
needs_reset = symbol_changed or chart_tf_changed or (htf1_auto and limit_zone_changed) or (not htf1_auto and htf_tf_changed)

if needs_reset
    reset_state()
    initialized := true
    last_ticker := current_ticker
    last_chart_tf := current_chart_tf
    last_htf_tf := current_htf_tf
    last_limit_zone := current_limit_zone
    clear_time_level(level_1600)
    clear_htf_slot(slot1)
    clear_htf_slot(slot2)
    clear_htf_slot(slot3)
    clear_htf_slot(slot4)
    clear_htf_slot(slot5)
    clear_htf_slot(slot6)
    clear_htf_slot(slot7)
    clear_htf_slot(slot8)

// Clear state on first bar (handles replay mode)
if barstate.isfirst
    clear_manual_slot(manual)
    clear_time_level(level_1600)
    clear_htf_slot(slot1)
    clear_htf_slot(slot2)
    clear_htf_slot(slot3)
    clear_htf_slot(slot4)
    clear_htf_slot(slot5)
    clear_htf_slot(slot6)
    clear_htf_slot(slot7)
    clear_htf_slot(slot8)

// ═══════════════════════════════════════════════════════════════════════════════
// HTF CANDLE TRACKING - Using request.security for accurate OHLC
// ═══════════════════════════════════════════════════════════════════════════════

// HTF OHLC (Manual mode)
[sec_htf1_open, sec_htf1_high, sec_htf1_low, sec_htf1_close, sec_htf1_time] = request.security(syminfo.tickerid, validated_htf1_timeframe, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
bool htf1_changed = ta.change(time(validated_htf1_timeframe)) != 0

// ═══════════════════════════════════════════════════════════════════════════════
// DYNAMIC MODE - REQUEST.SECURITY CALLS (8 HTF SLOTS)
// ═══════════════════════════════════════════════════════════════════════════════

// Dynamic mode enabled check
bool is_dynamic_mode = htf_mode == MODE_DYNAMIC

// Dynamic HTF1 (Monthly)
[sec_dyn1_open, sec_dyn1_high, sec_dyn1_low, sec_dyn1_close, sec_dyn1_time] = request.security(syminfo.tickerid, dyn_htf1, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
int dyn_htf1_seconds = timeframe.in_seconds(dyn_htf1)
bool dyn_htf1_valid = is_dynamic_mode and dyn_htf1_enabled and dyn_htf1_seconds > chart_tf_seconds
bool dyn_htf1_changed = dyn_htf1_valid and ta.change(time(dyn_htf1)) != 0

// Dynamic HTF2 (Weekly)
[sec_dyn2_open, sec_dyn2_high, sec_dyn2_low, sec_dyn2_close, sec_dyn2_time] = request.security(syminfo.tickerid, dyn_htf2, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
int dyn_htf2_seconds = timeframe.in_seconds(dyn_htf2)
bool dyn_htf2_valid = is_dynamic_mode and dyn_htf2_enabled and dyn_htf2_seconds > chart_tf_seconds
bool dyn_htf2_changed = dyn_htf2_valid and ta.change(time(dyn_htf2)) != 0

// Dynamic HTF3 (Daily)
[sec_dyn3_open, sec_dyn3_high, sec_dyn3_low, sec_dyn3_close, sec_dyn3_time] = request.security(syminfo.tickerid, dyn_htf3, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
int dyn_htf3_seconds = timeframe.in_seconds(dyn_htf3)
bool dyn_htf3_valid = is_dynamic_mode and dyn_htf3_enabled and dyn_htf3_seconds > chart_tf_seconds
bool dyn_htf3_changed = dyn_htf3_valid and ta.change(time(dyn_htf3)) != 0

// Dynamic HTF4 (12H)
[sec_dyn4_open, sec_dyn4_high, sec_dyn4_low, sec_dyn4_close, sec_dyn4_time] = request.security(syminfo.tickerid, dyn_htf4, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
int dyn_htf4_seconds = timeframe.in_seconds(dyn_htf4)
bool dyn_htf4_valid = is_dynamic_mode and dyn_htf4_enabled and dyn_htf4_seconds > chart_tf_seconds
bool dyn_htf4_changed = dyn_htf4_valid and ta.change(time(dyn_htf4)) != 0

// Dynamic HTF5 (8H)
[sec_dyn5_open, sec_dyn5_high, sec_dyn5_low, sec_dyn5_close, sec_dyn5_time] = request.security(syminfo.tickerid, dyn_htf5, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
int dyn_htf5_seconds = timeframe.in_seconds(dyn_htf5)
bool dyn_htf5_valid = is_dynamic_mode and dyn_htf5_enabled and dyn_htf5_seconds > chart_tf_seconds
bool dyn_htf5_changed = dyn_htf5_valid and ta.change(time(dyn_htf5)) != 0

// Dynamic HTF6 (7H)
// Note: 7H is excluded when on 4H chart due to unreliable bar alignment
[sec_dyn6_open, sec_dyn6_high, sec_dyn6_low, sec_dyn6_close, sec_dyn6_time] = request.security(syminfo.tickerid, dyn_htf6, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
int dyn_htf6_seconds = timeframe.in_seconds(dyn_htf6)
bool is_7h_on_4h_chart = chart_tf_seconds == TF_4H_SECONDS and dyn_htf6_seconds == TF_7H_SECONDS
bool dyn_htf6_valid = is_dynamic_mode and dyn_htf6_enabled and dyn_htf6_seconds > chart_tf_seconds and not is_7h_on_4h_chart
bool dyn_htf6_changed = dyn_htf6_valid and ta.change(time(dyn_htf6)) != 0

// Dynamic HTF7 (4H)
[sec_dyn7_open, sec_dyn7_high, sec_dyn7_low, sec_dyn7_close, sec_dyn7_time] = request.security(syminfo.tickerid, dyn_htf7, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
int dyn_htf7_seconds = timeframe.in_seconds(dyn_htf7)
bool dyn_htf7_valid = is_dynamic_mode and dyn_htf7_enabled and dyn_htf7_seconds > chart_tf_seconds
bool dyn_htf7_changed = dyn_htf7_valid and ta.change(time(dyn_htf7)) != 0

// Dynamic HTF8 (1H)
[sec_dyn8_open, sec_dyn8_high, sec_dyn8_low, sec_dyn8_close, sec_dyn8_time] = request.security(syminfo.tickerid, dyn_htf8, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
int dyn_htf8_seconds = timeframe.in_seconds(dyn_htf8)
bool dyn_htf8_valid = is_dynamic_mode and dyn_htf8_enabled and dyn_htf8_seconds > chart_tf_seconds
bool dyn_htf8_changed = dyn_htf8_valid and ta.change(time(dyn_htf8)) != 0

// ═══════════════════════════════════════════════════════════════════════════════
// ADR CALCULATION (5-day Average Daily Range)
// ═══════════════════════════════════════════════════════════════════════════════

// NY midnight detection for ADR tracking (works on any timeframe)
int ny_hour = hour(time, "America/New_York")
int ny_day = dayofweek(time, "America/New_York")
int prev_ny_day = dayofweek(time[1], "America/New_York")
// Day must change AND we must be in early hours (avoids weekend gaps recording partial days)
bool is_new_ny_day = (ny_day != prev_ny_day) and (ny_hour < 4)

// ADR state tracking
var array<float> adr_daily_ranges = array.new_float()
var float adr_current_high = high
var float adr_current_low = low
var float adr_current_open = open
var int adr_day_start_time = time
var float current_adr = na

// Historical day data for ADR boxes
var array<float> adr_hist_opens = array.new_float()
var array<float> adr_hist_adrs = array.new_float()
var array<int> adr_hist_starts = array.new_int()
var array<int> adr_hist_ends = array.new_int()

// Track daily range (NY Midnight method)
if is_new_ny_day
    // Store completed day's range
    float day_range = adr_current_high - adr_current_low
    if day_range > 0
        array.unshift(adr_daily_ranges, day_range)
        if array.size(adr_daily_ranges) > 20
            array.pop(adr_daily_ranges)
    // Store completed day for historical ADR boxes
    if not na(current_adr) and adr_day_start_time > 0
        array.unshift(adr_hist_opens, adr_current_open)
        array.unshift(adr_hist_adrs, current_adr)
        array.unshift(adr_hist_starts, adr_day_start_time)
        array.unshift(adr_hist_ends, time)
        // Limit history
        if array.size(adr_hist_opens) > 20
            array.pop(adr_hist_opens)
            array.pop(adr_hist_adrs)
            array.pop(adr_hist_starts)
            array.pop(adr_hist_ends)
    // Reset for new day
    adr_current_high := high
    adr_current_low := low
    adr_current_open := open
    adr_day_start_time := time
else
    adr_current_high := math.max(adr_current_high, high)
    adr_current_low := math.min(adr_current_low, low)

// Calculate ADR
calc_adr(array<float> ranges, int lookback) =>
    int count = math.min(lookback, array.size(ranges))
    if count > 0
        float sum = 0.0
        for i = 0 to count - 1
            sum += array.get(ranges, i)
        sum / count
    else
        float(na)

current_adr := calc_adr(adr_daily_ranges, adr_lookback)

// ADR band for relevance filtering (matches ADR indicator: anchor = day's open, full ADR each direction)
float adr_range = nz(current_adr, 0) * adr_multiplier
float adr_upper = adr_current_open + adr_range
float adr_lower = adr_current_open - adr_range

// ═══════════════════════════════════════════════════════════════════════════════
// DYNAMIC MODE - DETECTION LOGIC (using parameterized functions)
// ═══════════════════════════════════════════════════════════════════════════════

// Reference level cap for Dynamic mode
int dyn_ref_cap = CAP_MEDIUM

if dyn_htf1_valid and dyn_htf1_changed
    slot_process_htf(sec_dyn1_high[1], sec_dyn1_low[1], sec_dyn1_close[1], int(sec_dyn1_time[1]), slot1, dyn_ref_cap)
if dyn_htf2_valid and dyn_htf2_changed
    slot_process_htf(sec_dyn2_high[1], sec_dyn2_low[1], sec_dyn2_close[1], int(sec_dyn2_time[1]), slot2, dyn_ref_cap)
if dyn_htf3_valid and dyn_htf3_changed
    slot_process_htf(sec_dyn3_high[1], sec_dyn3_low[1], sec_dyn3_close[1], int(sec_dyn3_time[1]), slot3, dyn_ref_cap)
if dyn_htf4_valid and dyn_htf4_changed
    slot_process_htf(sec_dyn4_high[1], sec_dyn4_low[1], sec_dyn4_close[1], int(sec_dyn4_time[1]), slot4, dyn_ref_cap)
if dyn_htf5_valid and dyn_htf5_changed
    slot_process_htf(sec_dyn5_high[1], sec_dyn5_low[1], sec_dyn5_close[1], int(sec_dyn5_time[1]), slot5, dyn_ref_cap)
if dyn_htf6_valid and dyn_htf6_changed
    slot_process_htf(sec_dyn6_high[1], sec_dyn6_low[1], sec_dyn6_close[1], int(sec_dyn6_time[1]), slot6, dyn_ref_cap)
if dyn_htf7_valid and dyn_htf7_changed
    slot_process_htf(sec_dyn7_high[1], sec_dyn7_low[1], sec_dyn7_close[1], int(sec_dyn7_time[1]), slot7, dyn_ref_cap)
if dyn_htf8_valid and dyn_htf8_changed
    slot_process_htf(sec_dyn8_high[1], sec_dyn8_low[1], sec_dyn8_close[1], int(sec_dyn8_time[1]), slot8, dyn_ref_cap)

// Dynamic Mode - Fill Detection (only for enabled HTFs)
if is_dynamic_mode
    if dyn_htf1_enabled
        slot_check_fills(high, low, int(time), slot1)
    if dyn_htf2_enabled
        slot_check_fills(high, low, int(time), slot2)
    if dyn_htf3_enabled
        slot_check_fills(high, low, int(time), slot3)
    if dyn_htf4_enabled
        slot_check_fills(high, low, int(time), slot4)
    if dyn_htf5_enabled
        slot_check_fills(high, low, int(time), slot5)
    if dyn_htf6_enabled
        slot_check_fills(high, low, int(time), slot6)
    if dyn_htf7_enabled
        slot_check_fills(high, low, int(time), slot7)
    if dyn_htf8_enabled
        slot_check_fills(high, low, int(time), slot8)

// ═══════════════════════════════════════════════════════════════════════════════
// 16:00 CLOSE TRACKING
// ═══════════════════════════════════════════════════════════════════════════════

// Time-based price level capture and mitigation
if show_1600_close
    int current_hour_ny = hour(time, NY_TIMEZONE)
    int current_minute_ny = minute(time, NY_TIMEZONE)
    bool is_target_bar = current_hour_ny == level_1600.target_hour and current_minute_ny == level_1600.target_minute

    if is_target_bar
        if not na(level_1600.current_price)
            array.push(level_1600.prices, level_1600.current_price)
            array.push(level_1600.times, level_1600.current_time)
            array.push(level_1600.mitigated, level_1600.current_mitigated)
            array.push(level_1600.mitigation_times, level_1600.current_mitigation_time)

        level_1600.current_price := close
        level_1600.current_time := time
        level_1600.current_mitigated := false
        level_1600.current_mitigation_time := na

    bool is_in_mitigation_window = time_level_mitigation_window == MITIGATION_WINDOW_ANYTIME or (current_hour_ny >= 5 and current_hour_ny < 16)

    if not na(level_1600.current_price) and not level_1600.current_mitigated
        if (time >= level_1600.current_time + MITIGATION_DELAY_MS) and is_in_mitigation_window
            if (high >= level_1600.current_price and low <= level_1600.current_price) or close == level_1600.current_price
                level_1600.current_mitigated := true
                level_1600.current_mitigation_time := time

    int stored_size = array.size(level_1600.prices)
    if stored_size > 0
        int scan_size = math.min(stored_size, 20)
        int start_index = math.max(0, stored_size - scan_size)
        for i = start_index to stored_size - 1
            if not array.get(level_1600.mitigated, i)
                float lvl = array.get(level_1600.prices, i)
                int lvl_time = array.get(level_1600.times, i)
                if (time >= lvl_time + MITIGATION_DELAY_MS) and is_in_mitigation_window
                    if (high >= lvl and low <= lvl) or close == lvl
                        array.set(level_1600.mitigated, i, true)
                        array.set(level_1600.mitigation_times, i, time)

    prune_time_level(level_1600)

// ═══════════════════════════════════════════════════════════════════════════════
// MANUAL MODE - DETECTION LOGIC
// ═══════════════════════════════════════════════════════════════════════════════

if htf1_is_valid
    // Initialize on last confirmed historical bar
    if not initialized and barstate.islastconfirmedhistory and not needs_reset
        initialized := true

    if htf1_changed
        // Get completed HTF candle values from request.security (same as overlay)
        float prev_htf_high = sec_htf1_high[1]
        float prev_htf_low = sec_htf1_low[1]
        float prev_htf_close = sec_htf1_close[1]
        int prev_htf_time = int(sec_htf1_time[1])

        // Run detection only if we have valid previous candle AND have seen at least one complete candle
        if not na(prev_htf_high) and manual.has_history
            // ═══ DETECTION on completed HTF candle ═══
            local_sellside_detected = false
            local_buyside_detected = false

            // BSL Detection first (like LTF Algo): Wick took LOW but closed at/above
            if array.size(manual.eligible_low_ticks) > 0 and not local_buyside_detected
                for i = 0 to array.size(manual.eligible_low_ticks) - 1
                    ref_low_tick = array.get(manual.eligible_low_ticks, i)
                    ref_low = from_tick(ref_low_tick)
                    if prev_htf_low < ref_low and prev_htf_close >= ref_low
                        // Check if we already have this target (deduplication)
                        int target_tick = to_tick(prev_htf_high)
                        bool already_exists = false
                        if array.size(manual.buyside.targets) > 0
                            for j = 0 to array.size(manual.buyside.targets) - 1
                                if to_tick(array.get(manual.buyside.targets, j)) == target_tick
                                    already_exists := true
                                    break

                        if not already_exists
                            wick_timestamp = array.get(manual.eligible_low_times, i)
                            // Check if already filled on this bar
                            bool already_filled = high >= prev_htf_high
                            array.push(manual.buyside.failure_bars, bar_index)
                            array.push(manual.buyside.failure_times, int(time))
                            array.push(manual.buyside.targets, prev_htf_high)
                            array.push(manual.buyside.is_open, not already_filled)
                            array.push(manual.buyside.fill_bars, already_filled ? bar_index : int(na))
                            array.push(manual.buyside.fill_times, already_filled ? int(time) : int(na))
                            array.push(manual.buyside.lines, na)
                            array.push(manual.buyside.labels, na)
                            array.push(manual.buyside.wick_times, wick_timestamp)
                            local_buyside_detected := true
                        break

            // SSL Detection: Wick took HIGH but closed at/below
            if array.size(manual.eligible_high_ticks) > 0 and not local_sellside_detected
                for i = 0 to array.size(manual.eligible_high_ticks) - 1
                    ref_high_tick = array.get(manual.eligible_high_ticks, i)
                    ref_high = from_tick(ref_high_tick)
                    if prev_htf_high > ref_high and prev_htf_close <= ref_high
                        // Check if we already have this target (deduplication)
                        int target_tick = to_tick(prev_htf_low)
                        bool already_exists = false
                        if array.size(manual.sellside.targets) > 0
                            for j = 0 to array.size(manual.sellside.targets) - 1
                                if to_tick(array.get(manual.sellside.targets, j)) == target_tick
                                    already_exists := true
                                    break

                        if not already_exists
                            wick_timestamp = array.get(manual.eligible_high_times, i)
                            // Check if already filled on this bar
                            bool already_filled = low <= prev_htf_low
                            array.push(manual.sellside.failure_bars, bar_index)
                            array.push(manual.sellside.failure_times, int(time))
                            array.push(manual.sellside.targets, prev_htf_low)
                            array.push(manual.sellside.is_open, not already_filled)
                            array.push(manual.sellside.fill_bars, already_filled ? bar_index : int(na))
                            array.push(manual.sellside.fill_times, already_filled ? int(time) : int(na))
                            array.push(manual.sellside.lines, na)
                            array.push(manual.sellside.labels, na)
                            array.push(manual.sellside.wick_times, wick_timestamp)
                            local_sellside_detected := true
                        break

            // Remove broken levels (reuses Dynamic mode function)
            dyn_remove_broken(prev_htf_high, prev_htf_low, manual.eligible_high_ticks, manual.eligible_high_times, manual.eligible_low_ticks, manual.eligible_low_times)

        // Add completed candle's levels as new eligible levels (always, if valid)
        if not na(prev_htf_high)
            int ref_cap = get_reference_levels_cap()
            add_eligible_level(prev_htf_high, prev_htf_time, manual.eligible_high_ticks, manual.eligible_high_times, ref_cap)
            add_eligible_level(prev_htf_low, prev_htf_time, manual.eligible_low_ticks, manual.eligible_low_times, ref_cap)
            manual.has_history := true

    // Fill detection on every bar
    manual_check_fills(manual.sellside.targets, manual.sellside.is_open, manual.sellside.failure_bars,
         manual.sellside.fill_bars, manual.sellside.fill_times, false)
    manual_check_fills(manual.buyside.targets, manual.buyside.is_open, manual.buyside.failure_bars,
         manual.buyside.fill_bars, manual.buyside.fill_times, true)

// ═══════════════════════════════════════════════════════════════════════════════
// HTF CANDLE OVERLAY (DEBUG)
// ═══════════════════════════════════════════════════════════════════════════════

// Track bar index where current HTF candle started
var int dbg_htf_start_bar = na
var box dbg_current_wick = na
var box dbg_current_body = na

// HTF change detection
bool dbg_change_htf = ta.change(time(validated_htf1_timeframe)) != 0

// Use input colors for HTF candles
color dbg_bull_color = htf_bull_body_color
color dbg_bear_color = htf_bear_body_color
color dbg_bull_wick = htf_bull_wick_color
color dbg_bear_wick = htf_bear_wick_color

if show_htf_candles
    if dbg_change_htf
        // Draw COMPLETED candle: started at dbg_htf_start_bar, ended at bar_index - 1
        // OHLC from sec_htf_*[1] = previous HTF candle's final values
        if not na(dbg_htf_start_bar)
            float prev_o = sec_htf1_open[1]
            float prev_h = sec_htf1_high[1]
            float prev_l = sec_htf1_low[1]
            float prev_c = sec_htf1_close[1]
            int end_bar = bar_index - 1
            bool prev_bull = prev_c > prev_o

            // Wick box
            box.new(dbg_htf_start_bar, prev_h, end_bar, prev_l, prev_bull ? dbg_bull_wick : dbg_bear_wick, bgcolor=prev_bull ? dbg_bull_wick : dbg_bear_wick)
            // Body box
            if prev_bull
                box.new(dbg_htf_start_bar, prev_c, end_bar, prev_o, dbg_bull_color, bgcolor=dbg_bull_color)
            else
                box.new(dbg_htf_start_bar, prev_o, end_bar, prev_c, dbg_bear_color, bgcolor=dbg_bear_color)

        // New HTF candle starts at current bar
        dbg_htf_start_bar := bar_index

    // Draw current forming candle on last bar
    if barstate.islast and not na(dbg_htf_start_bar)
        box.delete(dbg_current_wick)
        box.delete(dbg_current_body)

        bool is_bull = sec_htf1_close > sec_htf1_open
        // Wick
        dbg_current_wick := box.new(dbg_htf_start_bar, sec_htf1_high, bar_index, sec_htf1_low, is_bull ? dbg_bull_wick : dbg_bear_wick, bgcolor=is_bull ? dbg_bull_wick : dbg_bear_wick)
        // Body
        if is_bull
            dbg_current_body := box.new(dbg_htf_start_bar, sec_htf1_close, bar_index, sec_htf1_open, dbg_bull_color, bgcolor=dbg_bull_color)
        else
            dbg_current_body := box.new(dbg_htf_start_bar, sec_htf1_open, bar_index, sec_htf1_close, dbg_bear_color, bgcolor=dbg_bear_color)

// ═══════════════════════════════════════════════════════════════════════════════
// DISPLAY SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.islast

    // ═══════════════════════════════════════════════════════════════════════════
    // DYNAMIC MODE DISPLAY - Show ALL open levels within ADR range from ALL TFs
    // ═══════════════════════════════════════════════════════════════════════════
    // DYNAMIC MODE DISPLAY - Consolidated levels (deduplicated, highest HTF shown)
    // ═══════════════════════════════════════════════════════════════════════════
    if is_dynamic_mode
        // Clear previous lines/labels
        for ln in dyn_lines
            line.delete(ln)
        for lb in dyn_labels
            label.delete(lb)
        array.clear(dyn_lines)
        array.clear(dyn_labels)

        // Line end (start is calculated per-level to avoid crossing candles)
        int line_end_bar = bar_index + LINE_EXTENSION_BARS

        // Temporary arrays for consolidation
        var array<int> cons_ticks = array.new_int()
        var array<bool> cons_is_bsl = array.new_bool()
        var array<string> cons_tags = array.new_string()
        var array<int> cons_ranks = array.new_int()
        array.clear(cons_ticks)
        array.clear(cons_is_bsl)
        array.clear(cons_tags)
        array.clear(cons_ranks)

        // ADR filter: user toggle AND chart TF must be below threshold
        bool use_adr = adr_filter_enabled and chart_tf_seconds < ADR_FILTER_MAX_TF_SECONDS
        // Level caps: when ADR filter ON use rank-based caps, when OFF use global limit
        int cap_macro = use_adr ? 999 : open_lines_count
        int cap_swing = use_adr ? 2 : open_lines_count
        int cap_intra = use_adr ? 999 : open_lines_count

        // Collect levels from all HTFs (rank 1=highest TF, 8=lowest)
        if dyn_htf1_valid
            slot_collect_levels(slot1, adr_lower, adr_upper, get_htf_tag_for_tf(dyn_htf1), use_adr, cap_macro, close, cons_ticks, cons_is_bsl, cons_tags, cons_ranks)
        if dyn_htf2_valid
            slot_collect_levels(slot2, adr_lower, adr_upper, get_htf_tag_for_tf(dyn_htf2), use_adr, cap_macro, close, cons_ticks, cons_is_bsl, cons_tags, cons_ranks)
        if dyn_htf3_valid
            slot_collect_levels(slot3, adr_lower, adr_upper, get_htf_tag_for_tf(dyn_htf3), use_adr, cap_macro, close, cons_ticks, cons_is_bsl, cons_tags, cons_ranks)
        if dyn_htf4_valid
            slot_collect_levels(slot4, adr_lower, adr_upper, get_htf_tag_for_tf(dyn_htf4), use_adr, cap_swing, close, cons_ticks, cons_is_bsl, cons_tags, cons_ranks)
        if dyn_htf5_valid
            slot_collect_levels(slot5, adr_lower, adr_upper, get_htf_tag_for_tf(dyn_htf5), use_adr, cap_swing, close, cons_ticks, cons_is_bsl, cons_tags, cons_ranks)
        if dyn_htf6_valid
            slot_collect_levels(slot6, adr_lower, adr_upper, get_htf_tag_for_tf(dyn_htf6), use_adr, cap_swing, close, cons_ticks, cons_is_bsl, cons_tags, cons_ranks)
        if dyn_htf7_valid
            slot_collect_levels(slot7, adr_lower, adr_upper, get_htf_tag_for_tf(dyn_htf7), use_adr, cap_intra, close, cons_ticks, cons_is_bsl, cons_tags, cons_ranks)
        if dyn_htf8_valid
            slot_collect_levels(slot8, adr_lower, adr_upper, get_htf_tag_for_tf(dyn_htf8), use_adr, cap_intra, close, cons_ticks, cons_is_bsl, cons_tags, cons_ranks)

        // Collect time-based levels
        if show_1600_close
            collect_time_levels(level_1600, adr_lower, adr_upper, use_adr, time_level_most_recent_only, cons_ticks, cons_is_bsl, cons_tags, cons_ranks)

        // Find nearest BSL (above price) and SSL (below price) for highlighting
        // Must apply same multi_tf_only filter as draw function
        int nearest_bsl_tick = na
        int nearest_ssl_tick = na
        int current_tick = to_tick(close)
        int cons_size = array.size(cons_ticks)
        if cons_size > 0
            float min_bsl_dist = na
            float min_ssl_dist = na
            for i = 0 to cons_size - 1
                int rank = array.get(cons_ranks, i)
                string all_tags = array.get(cons_tags, i)
                bool is_macro = rank <= TIER_MACRO_MAX_RANK
                bool has_multiple_tfs = str.contains(all_tags, ",")
                if multi_tf_only and not is_macro and not has_multiple_tfs
                    continue
                int lvl_tick = array.get(cons_ticks, i)
                bool is_buy = array.get(cons_is_bsl, i)
                if is_buy and lvl_tick > current_tick
                    float dist = lvl_tick - current_tick
                    if na(min_bsl_dist) or dist < min_bsl_dist
                        min_bsl_dist := dist
                        nearest_bsl_tick := lvl_tick
                else if not is_buy and lvl_tick < current_tick
                    float dist = current_tick - lvl_tick
                    if na(min_ssl_dist) or dist < min_ssl_dist
                        min_ssl_dist := dist
                        nearest_ssl_tick := lvl_tick

        // Draw consolidated levels (one line per unique price, highest HTF label with TF context)
        dyn_draw_consolidated(cons_ticks, cons_is_bsl, cons_tags, cons_ranks, dyn_lines, dyn_labels,
            line_color, macro_line_color, bsl_text_color, ssl_text_color, close_1600_color, line_end_bar,
            dyn_width_tier1, dyn_width_tier2, dyn_width_tier3,
            dyn_size_tier1, dyn_size_tier2, dyn_size_tier3, multi_tf_only,
            highlight_nearest, nearest_bsl_tick, nearest_ssl_tick, show_price_on_label)

    // ═══════════════════════════════════════════════════════════════════════════
    // MANUAL MODE DISPLAY - HTF1/HTF2/HTF3 lines (only when not in Dynamic mode)
    // ═══════════════════════════════════════════════════════════════════════════

    // BSL/SSL Display (Manual mode only)
    if not is_dynamic_mode
        manual_display_levels(manual.buyside.failure_bars, manual.buyside.failure_times, manual.buyside.targets,
             manual.buyside.is_open, manual.buyside.fill_times, manual.buyside.lines, manual.buyside.labels,
             manual.buyside.wick_times, true, bsl_text_color)
        manual_display_levels(manual.sellside.failure_bars, manual.sellside.failure_times, manual.sellside.targets,
             manual.sellside.is_open, manual.sellside.fill_times, manual.sellside.lines, manual.sellside.labels,
             manual.sellside.wick_times, false, ssl_text_color)

// ═══════════════════════════════════════════════════════════════════════════════
// MEMORY CLEANUP
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.islast and initialized
    cleanup_max = math.max(100, (open_lines_count + filled_lines_count) * 2)
    manual_cleanup_levels(manual.buyside.failure_bars, manual.buyside.failure_times, manual.buyside.targets,
         manual.buyside.is_open, manual.buyside.fill_bars, manual.buyside.fill_times,
         manual.buyside.lines, manual.buyside.labels, manual.buyside.wick_times, cleanup_max)
    manual_cleanup_levels(manual.sellside.failure_bars, manual.sellside.failure_times, manual.sellside.targets,
         manual.sellside.is_open, manual.sellside.fill_bars, manual.sellside.fill_times,
         manual.sellside.lines, manual.sellside.labels, manual.sellside.wick_times, cleanup_max)

// ═══════════════════════════════════════════════════════════════════════════════
// ADR BOXES DEBUG VISUALIZATION (verify ADR calculation matches ADR indicator)
// ═══════════════════════════════════════════════════════════════════════════════

var box adr_current_box = na
var array<box> adr_hist_boxes = array.new<box>()

if show_adr_boxes and is_dynamic_mode and chart_tf_seconds < ADR_FILTER_MAX_TF_SECONDS and barstate.islast
    // Delete old boxes
    box.delete(adr_current_box)
    for b in adr_hist_boxes
        box.delete(b)
    array.clear(adr_hist_boxes)

    // Draw current day's ADR box
    if not na(current_adr)
        float curr_upper = adr_current_open + (current_adr * adr_multiplier)
        float curr_lower = adr_current_open - (current_adr * adr_multiplier)
        adr_current_box := box.new(adr_day_start_time, curr_upper, time, curr_lower,
                                   xloc=xloc.bar_time, border_color=adr_box_color, bgcolor=adr_box_color,
                                   border_width=1, border_style=line.style_solid)

    // Draw historical ADR boxes
    int hist_count = math.min(adr_box_days - 1, array.size(adr_hist_opens))
    if hist_count > 0
        for i = 0 to hist_count - 1
            float h_open = array.get(adr_hist_opens, i)
            float h_adr = array.get(adr_hist_adrs, i)
            int h_start = array.get(adr_hist_starts, i)
            int h_end = array.get(adr_hist_ends, i)
            float h_upper = h_open + (h_adr * adr_multiplier)
            float h_lower = h_open - (h_adr * adr_multiplier)
            box h_box = box.new(h_start, h_upper, h_end, h_lower,
                                xloc=xloc.bar_time, border_color=adr_box_color, bgcolor=adr_box_color,
                                border_width=1, border_style=line.style_solid)
            array.push(adr_hist_boxes, h_box)

// ═══════════════════════════════════════════════════════════════════════════════
// FILLED LEVEL HISTORY (Backtest Visualization)
// ═══════════════════════════════════════════════════════════════════════════════

var array<line> fills_lines = array.new<line>()
var array<label> fills_labels = array.new<label>()

// Temp arrays for consolidation (reused each render)
var array<int> fh_ticks = array.new<int>()
var array<int> fh_detect_times = array.new<int>()
var array<int> fh_fill_times = array.new<int>()
var array<string> fh_tags = array.new<string>()

// Add or merge a filled time level into fh_* arrays
add_or_merge_filled_level(int tick, string time_tag, int draw_start, int fill_time) =>
    int found_idx = find_tick_index(tick, fh_ticks)
    if found_idx >= 0
        merge_tag_at_index(found_idx, time_tag, fh_tags)
        0  // merged, not a new entry
    else
        array.push(fh_ticks, tick)
        array.push(fh_detect_times, draw_start)
        array.push(fh_fill_times, fill_time)
        array.push(fh_tags, time_tag)
        1  // new entry

// Helper: Collect filled levels from one HTF into consolidation arrays
collect_filled_history_for_htf(array<float> targets, array<bool> is_open,
                               array<int> detect_times, array<int> fill_times,
                               array<float> hist_opens, array<float> hist_adrs,
                               array<int> hist_starts, array<int> hist_ends,
                               float adr_mult, int max_days, string htf_tag) =>
    int collected = 0
    int hist_count = math.min(max_days, array.size(hist_opens))
    int level_count = array.size(targets)

    if level_count > 0 and hist_count > 0
        for i = 0 to level_count - 1
            if not array.get(is_open, i)
                float target = array.get(targets, i)
                int detect_t = array.get(detect_times, i)
                int fill_t = array.get(fill_times, i)

                if na(detect_t) or na(fill_t)
                    continue

                for d = 0 to hist_count - 1
                    float day_open = array.get(hist_opens, d)
                    float day_adr = array.get(hist_adrs, d)
                    int day_start = array.get(hist_starts, d)
                    int day_end = array.get(hist_ends, d)

                    float day_upper = day_open + (day_adr * adr_mult)
                    float day_lower = day_open - (day_adr * adr_mult)

                    if target >= day_lower and target <= day_upper
                        if fill_t <= day_end and fill_t >= day_start
                            int tick = to_tick(target)
                            int draw_start = math.max(detect_t, day_start)

                            // Check if tick already exists
                            int found_idx = -1
                            int fh_size = array.size(fh_ticks)
                            if fh_size > 0
                                for j = 0 to fh_size - 1
                                    if array.get(fh_ticks, j) == tick
                                        found_idx := j
                                        break

                            if found_idx >= 0
                                // Merge: use earliest detect, latest fill, combine tags
                                existing_detect = array.get(fh_detect_times, found_idx)
                                existing_fill = array.get(fh_fill_times, found_idx)
                                existing_tags = array.get(fh_tags, found_idx)
                                array.set(fh_detect_times, found_idx, math.min(existing_detect, draw_start))
                                array.set(fh_fill_times, found_idx, math.max(existing_fill, fill_t))
                                if not str.contains(existing_tags, htf_tag)
                                    array.set(fh_tags, found_idx, existing_tags + " • " + htf_tag)
                            else
                                // New entry
                                array.push(fh_ticks, tick)
                                array.push(fh_detect_times, draw_start)
                                array.push(fh_fill_times, fill_t)
                                array.push(fh_tags, htf_tag)
                                collected += 1
                            break
    collected

// Helper: Collect filled levels from one HTF for TODAY only
collect_filled_today(array<float> targets, array<bool> is_open,
                     array<int> detect_times, array<int> fill_times,
                     float today_open, float today_adr, int today_start,
                     float adr_mult, string htf_tag) =>
    int collected = 0
    int level_count = array.size(targets)
    if level_count > 0 and not na(today_adr)
        float day_upper = today_open + (today_adr * adr_mult)
        float day_lower = today_open - (today_adr * adr_mult)

        for i = 0 to level_count - 1
            if not array.get(is_open, i)
                float target = array.get(targets, i)
                int detect_t = array.get(detect_times, i)
                int fill_t = array.get(fill_times, i)

                if na(detect_t) or na(fill_t)
                    continue

                // Check if level is within today's ADR and filled today
                if target >= day_lower and target <= day_upper
                    if fill_t >= today_start
                        int tick = to_tick(target)
                        int draw_start = math.max(detect_t, today_start)

                        // Check if tick already exists (dedup)
                        int found_idx = -1
                        int fh_size = array.size(fh_ticks)
                        if fh_size > 0
                            for j = 0 to fh_size - 1
                                if array.get(fh_ticks, j) == tick
                                    found_idx := j
                                    break

                        if found_idx >= 0
                            // Merge: use earliest detect, latest fill, combine tags
                            existing_detect = array.get(fh_detect_times, found_idx)
                            existing_fill = array.get(fh_fill_times, found_idx)
                            existing_tags = array.get(fh_tags, found_idx)
                            array.set(fh_detect_times, found_idx, math.min(existing_detect, draw_start))
                            array.set(fh_fill_times, found_idx, math.max(existing_fill, fill_t))
                            if not str.contains(existing_tags, htf_tag)
                                array.set(fh_tags, found_idx, existing_tags + " • " + htf_tag)
                        else
                            // New entry
                            array.push(fh_ticks, tick)
                            array.push(fh_detect_times, draw_start)
                            array.push(fh_fill_times, fill_t)
                            array.push(fh_tags, htf_tag)
                            collected += 1
    collected

// Helper: Collect filled time levels for fills display
// Merges with existing HTF filled levels if they share the same price tick
collect_filled_time_levels(TimePriceLevel level, float today_open, float today_adr, int today_start, float adr_mult) =>
    int collected = 0
    if not na(today_adr)
        float day_upper = today_open + (today_adr * adr_mult)
        float day_lower = today_open - (today_adr * adr_mult)

        // Check current level if mitigated
        if not na(level.current_price) and level.current_mitigated and not na(level.current_mitigation_time)
            if level.current_price >= day_lower and level.current_price <= day_upper
                if level.current_mitigation_time >= today_start
                    int tick = to_tick(level.current_price)
                    int draw_start = math.max(level.current_time, today_start)
                    string time_tag = format_time_level_label(level.label_text, level.current_time)
                    collected += add_or_merge_filled_level(tick, time_tag, draw_start, level.current_mitigation_time)

        // Check stored levels
        int stored_size = array.size(level.prices)
        if stored_size > 0
            for i = 0 to stored_size - 1
                if array.get(level.mitigated, i)
                    float lvl = array.get(level.prices, i)
                    int lvl_time = array.get(level.times, i)
                    int mit_time = array.get(level.mitigation_times, i)
                    if not na(mit_time) and lvl >= day_lower and lvl <= day_upper
                        if mit_time >= today_start
                            int tick = to_tick(lvl)
                            int draw_start = math.max(lvl_time, today_start)
                            string time_tag = format_time_level_label(level.label_text, lvl_time)
                            collected += add_or_merge_filled_level(tick, time_tag, draw_start, mit_time)
    collected

slot_collect_filled_today(HtfSlot slot, float today_open, float today_adr, int today_start, float adr_mult, string htf_tag) =>
    collect_filled_today(slot.bsl_targets, slot.bsl_open, slot.bsl_detect_times, slot.bsl_fill_times, today_open, today_adr, today_start, adr_mult, htf_tag)
    collect_filled_today(slot.ssl_targets, slot.ssl_open, slot.ssl_detect_times, slot.ssl_fill_times, today_open, today_adr, today_start, adr_mult, htf_tag)

slot_collect_filled_history(HtfSlot slot, array<float> hist_opens, array<float> hist_adrs, array<int> hist_starts, array<int> hist_ends, float adr_mult, int max_days, string htf_tag) =>
    collect_filled_history_for_htf(slot.bsl_targets, slot.bsl_open, slot.bsl_detect_times, slot.bsl_fill_times, hist_opens, hist_adrs, hist_starts, hist_ends, adr_mult, max_days, htf_tag)
    collect_filled_history_for_htf(slot.ssl_targets, slot.ssl_open, slot.ssl_detect_times, slot.ssl_fill_times, hist_opens, hist_adrs, hist_starts, hist_ends, adr_mult, max_days, htf_tag)

if show_fills and is_dynamic_mode and barstate.islast
    // Clear old visuals
    for ln in fills_lines
        line.delete(ln)
    array.clear(fills_lines)
    for lb in fills_labels
        label.delete(lb)
    array.clear(fills_labels)

    // Clear consolidation arrays
    array.clear(fh_ticks)
    array.clear(fh_detect_times)
    array.clear(fh_fill_times)
    array.clear(fh_tags)

    // Collect from all enabled HTFs - TODAY (always when feature is on)
    if dyn_htf1_enabled
        slot_collect_filled_today(slot1, adr_current_open, current_adr, adr_day_start_time, adr_multiplier, get_htf_tag_for_tf(dyn_htf1))
    if dyn_htf2_enabled
        slot_collect_filled_today(slot2, adr_current_open, current_adr, adr_day_start_time, adr_multiplier, get_htf_tag_for_tf(dyn_htf2))
    if dyn_htf3_enabled
        slot_collect_filled_today(slot3, adr_current_open, current_adr, adr_day_start_time, adr_multiplier, get_htf_tag_for_tf(dyn_htf3))
    if dyn_htf4_enabled
        slot_collect_filled_today(slot4, adr_current_open, current_adr, adr_day_start_time, adr_multiplier, get_htf_tag_for_tf(dyn_htf4))
    if dyn_htf5_enabled
        slot_collect_filled_today(slot5, adr_current_open, current_adr, adr_day_start_time, adr_multiplier, get_htf_tag_for_tf(dyn_htf5))
    if dyn_htf6_enabled
        slot_collect_filled_today(slot6, adr_current_open, current_adr, adr_day_start_time, adr_multiplier, get_htf_tag_for_tf(dyn_htf6))
    if dyn_htf7_enabled
        slot_collect_filled_today(slot7, adr_current_open, current_adr, adr_day_start_time, adr_multiplier, get_htf_tag_for_tf(dyn_htf7))
    if dyn_htf8_enabled
        slot_collect_filled_today(slot8, adr_current_open, current_adr, adr_day_start_time, adr_multiplier, get_htf_tag_for_tf(dyn_htf8))

    // Collect filled time levels
    if show_1600_close
        collect_filled_time_levels(level_1600, adr_current_open, current_adr, adr_day_start_time, adr_multiplier)

    // Collect from all enabled HTFs - PAST DAYS (only if Historical is enabled)
    if fills_historical
        if dyn_htf1_enabled
            slot_collect_filled_history(slot1, adr_hist_opens, adr_hist_adrs, adr_hist_starts, adr_hist_ends, adr_multiplier, fills_historical_days, get_htf_tag_for_tf(dyn_htf1))
        if dyn_htf2_enabled
            slot_collect_filled_history(slot2, adr_hist_opens, adr_hist_adrs, adr_hist_starts, adr_hist_ends, adr_multiplier, fills_historical_days, get_htf_tag_for_tf(dyn_htf2))
        if dyn_htf3_enabled
            slot_collect_filled_history(slot3, adr_hist_opens, adr_hist_adrs, adr_hist_starts, adr_hist_ends, adr_multiplier, fills_historical_days, get_htf_tag_for_tf(dyn_htf3))
        if dyn_htf4_enabled
            slot_collect_filled_history(slot4, adr_hist_opens, adr_hist_adrs, adr_hist_starts, adr_hist_ends, adr_multiplier, fills_historical_days, get_htf_tag_for_tf(dyn_htf4))
        if dyn_htf5_enabled
            slot_collect_filled_history(slot5, adr_hist_opens, adr_hist_adrs, adr_hist_starts, adr_hist_ends, adr_multiplier, fills_historical_days, get_htf_tag_for_tf(dyn_htf5))
        if dyn_htf6_enabled
            slot_collect_filled_history(slot6, adr_hist_opens, adr_hist_adrs, adr_hist_starts, adr_hist_ends, adr_multiplier, fills_historical_days, get_htf_tag_for_tf(dyn_htf6))
        if dyn_htf7_enabled
            slot_collect_filled_history(slot7, adr_hist_opens, adr_hist_adrs, adr_hist_starts, adr_hist_ends, adr_multiplier, fills_historical_days, get_htf_tag_for_tf(dyn_htf7))
        if dyn_htf8_enabled
            slot_collect_filled_history(slot8, adr_hist_opens, adr_hist_adrs, adr_hist_starts, adr_hist_ends, adr_multiplier, fills_historical_days, get_htf_tag_for_tf(dyn_htf8))

    // Draw consolidated levels
    int fh_count = array.size(fh_ticks)
    if fh_count > 0
        for i = 0 to fh_count - 1
            float target = from_tick(array.get(fh_ticks, i))
            int draw_start = array.get(fh_detect_times, i)
            int fill_t = array.get(fh_fill_times, i)
            string tags = array.get(fh_tags, i)

            line new_line = line.new(draw_start, target, fill_t, target,
                                     xloc=xloc.bar_time, color=backtest_fills_color,
                                     style=line.style_dashed, width=1)
            array.push(fills_lines, new_line)

            int label_time = int((draw_start + fill_t) / 2)
            label new_label = label.new(label_time, target, tags,
                                        xloc=xloc.bar_time, style=label.style_none,
                                        textcolor=backtest_fills_color, size=size.tiny)
            array.push(fills_labels, new_label)

// ═══════════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE
// ═══════════════════════════════════════════════════════════════════════════════

if show_color_table and barstate.islast
    var table colorTable = table.new(position.top_right, 3, 13, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

    table.cell(colorTable, 0, 0, "Color", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 1, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 2, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)

    table.cell(colorTable, 0, 1, "Line", text_size=size.small)
    table.cell(colorTable, 1, 1, str.format("R:{0} G:{1} B:{2}", color.r(line_color), color.g(line_color), color.b(line_color)), text_size=size.small)
    table.cell(colorTable, 2, 1, str.tostring(color.t(line_color)), text_size=size.small)

    table.cell(colorTable, 0, 2, "Macro", text_size=size.small)
    table.cell(colorTable, 1, 2, str.format("R:{0} G:{1} B:{2}", color.r(macro_line_color), color.g(macro_line_color), color.b(macro_line_color)), text_size=size.small)
    table.cell(colorTable, 2, 2, str.tostring(color.t(macro_line_color)), text_size=size.small)

    table.cell(colorTable, 0, 3, "Manual Filled", text_size=size.small)
    table.cell(colorTable, 1, 3, str.format("R:{0} G:{1} B:{2}", color.r(manual_filled_color), color.g(manual_filled_color), color.b(manual_filled_color)), text_size=size.small)
    table.cell(colorTable, 2, 3, str.tostring(color.t(manual_filled_color)), text_size=size.small)

    table.cell(colorTable, 0, 4, "BSL Label", text_size=size.small)
    table.cell(colorTable, 1, 4, str.format("R:{0} G:{1} B:{2}", color.r(bsl_text_color), color.g(bsl_text_color), color.b(bsl_text_color)), text_size=size.small)
    table.cell(colorTable, 2, 4, str.tostring(color.t(bsl_text_color)), text_size=size.small)

    table.cell(colorTable, 0, 5, "SSL Label", text_size=size.small)
    table.cell(colorTable, 1, 5, str.format("R:{0} G:{1} B:{2}", color.r(ssl_text_color), color.g(ssl_text_color), color.b(ssl_text_color)), text_size=size.small)
    table.cell(colorTable, 2, 5, str.tostring(color.t(ssl_text_color)), text_size=size.small)

    table.cell(colorTable, 0, 6, "HTF Bull Body", text_size=size.small)
    table.cell(colorTable, 1, 6, str.format("R:{0} G:{1} B:{2}", color.r(htf_bull_body_color), color.g(htf_bull_body_color), color.b(htf_bull_body_color)), text_size=size.small)
    table.cell(colorTable, 2, 6, str.tostring(color.t(htf_bull_body_color)), text_size=size.small)

    table.cell(colorTable, 0, 7, "HTF Bull Wick", text_size=size.small)
    table.cell(colorTable, 1, 7, str.format("R:{0} G:{1} B:{2}", color.r(htf_bull_wick_color), color.g(htf_bull_wick_color), color.b(htf_bull_wick_color)), text_size=size.small)
    table.cell(colorTable, 2, 7, str.tostring(color.t(htf_bull_wick_color)), text_size=size.small)

    table.cell(colorTable, 0, 8, "HTF Bear Body", text_size=size.small)
    table.cell(colorTable, 1, 8, str.format("R:{0} G:{1} B:{2}", color.r(htf_bear_body_color), color.g(htf_bear_body_color), color.b(htf_bear_body_color)), text_size=size.small)
    table.cell(colorTable, 2, 8, str.tostring(color.t(htf_bear_body_color)), text_size=size.small)

    table.cell(colorTable, 0, 9, "HTF Bear Wick", text_size=size.small)
    table.cell(colorTable, 1, 9, str.format("R:{0} G:{1} B:{2}", color.r(htf_bear_wick_color), color.g(htf_bear_wick_color), color.b(htf_bear_wick_color)), text_size=size.small)
    table.cell(colorTable, 2, 9, str.tostring(color.t(htf_bear_wick_color)), text_size=size.small)

    table.cell(colorTable, 0, 10, "ADR Box", text_size=size.small)
    table.cell(colorTable, 1, 10, str.format("R:{0} G:{1} B:{2}", color.r(adr_box_color), color.g(adr_box_color), color.b(adr_box_color)), text_size=size.small)
    table.cell(colorTable, 2, 10, str.tostring(color.t(adr_box_color)), text_size=size.small)

    table.cell(colorTable, 0, 11, "Backtest Fills", text_size=size.small)
    table.cell(colorTable, 1, 11, str.format("R:{0} G:{1} B:{2}", color.r(backtest_fills_color), color.g(backtest_fills_color), color.b(backtest_fills_color)), text_size=size.small)
    table.cell(colorTable, 2, 11, str.tostring(color.t(backtest_fills_color)), text_size=size.small)

    table.cell(colorTable, 0, 12, "16:00 Close", text_size=size.small)
    table.cell(colorTable, 1, 12, str.format("R:{0} G:{1} B:{2}", color.r(close_1600_color), color.g(close_1600_color), color.b(close_1600_color)), text_size=size.small)
    table.cell(colorTable, 2, 12, str.tostring(color.t(close_1600_color)), text_size=size.small)

// ═══════════════════════════════════════════════════════════════════════════════
// STATUS TABLE
// ═══════════════════════════════════════════════════════════════════════════════

if show_status_table and barstate.islast
    var table status_table = table.new(position.bottom_center, 4, 1, border_width=0)

    string left_pad = status_table_offset < 0 ? "" : str.repeat(" ", status_table_offset * 3)
    string right_pad = status_table_offset > 0 ? "" : str.repeat(" ", math.abs(status_table_offset) * 3)

    string mode_display = htf_mode == MODE_DYNAMIC ? "d" : "m"
    string mtf_display = htf_mode == MODE_DYNAMIC and multi_tf_only ? "  mtf" : ""
    bool adr_applies = htf_mode == MODE_DYNAMIC and adr_filter_enabled and chart_tf_seconds < ADR_FILTER_MAX_TF_SECONDS
    string adr_display = adr_applies ? (adr_multiplier == 1.0 ? "  adr" : "  adr " + str.tostring(adr_multiplier, "#.#")) : ""
    string status_text = mode_display + mtf_display + adr_display

    table.cell(status_table, 0, 0, left_pad, bgcolor=color.new(color.white, 100), text_size=size.tiny)
    table.cell(status_table, 1, 0, "htf algo •", bgcolor=color.black, text_color=color.white, text_size=size.tiny)
    table.cell(status_table, 2, 0, status_text, bgcolor=COLOR_STATUS_BG, text_color=color.black, text_size=size.tiny)
    table.cell(status_table, 3, 0, right_pad, bgcolor=color.new(color.white, 100), text_size=size.tiny)

// htf algo •