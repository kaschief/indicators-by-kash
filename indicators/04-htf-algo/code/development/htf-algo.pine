const string GROUP_TIME_LEVELS = "Time Levels"
const int MAX_STORED_LEVELS = 50

// Time-based price level type
type TimePriceLevel
    int target_hour
    int target_minute
    string label_text
    color level_color
    array<float> prices
    array<int> times
    array<bool> mitigated
    array<int> mitigation_times
    float current_price
    int current_time
    bool current_mitigated
    int current_mitigation_time

// HTF slot type for dynamic mode
type HtfSlot
    string timeframe
    int rank
    bool has_history
    array<float> bsl_targets
    array<bool> bsl_open
    array<int> bsl_detect_times
    array<int> bsl_fill_times
    array<float> ssl_targets
    array<bool> ssl_open
    array<int> ssl_detect_times
    array<int> ssl_fill_times
    array<int> eligible_high_ticks
    array<int> eligible_low_ticks
    array<int> eligible_high_times
    array<int> eligible_low_times

// Manual mode side type (buyside or sellside)
type ManualSide
    array<int> failure_bars
    array<int> failure_times
    array<float> targets
    array<bool> is_open
    array<int> fill_bars
    array<int> fill_times
    array<line> lines
    array<label> labels
    array<int> wick_times

// Manual mode slot type
type ManualSlot
    ManualSide buyside
    ManualSide sellside
    array<int> eligible_high_ticks
    array<int> eligible_low_ticks
    array<int> eligible_high_times
    array<int> eligible_low_times
    bool has_history


