            array.shift(htf3_eligible_low_times)

// Reset state function for TF/symbol changes
reset_state() =>
    // Clear HTF1 arrays
    array.clear(htf1_buyside_failure_bars)
    array.clear(htf1_buyside_failure_times)
    array.clear(htf1_buyside_targets)
    array.clear(htf1_buyside_open)
    array.clear(htf1_buyside_fill_bars)
    array.clear(htf1_buyside_fill_times)
    array.clear(htf1_sellside_failure_bars)
    array.clear(htf1_sellside_failure_times)
    array.clear(htf1_sellside_targets)
    array.clear(htf1_sellside_open)
    array.clear(htf1_sellside_fill_bars)
    array.clear(htf1_sellside_fill_times)
    array.clear(htf1_eligible_high_ticks)
    array.clear(htf1_eligible_low_ticks)
    array.clear(htf1_eligible_high_times)
    array.clear(htf1_eligible_low_times)

    // Clear HTF2 arrays
    array.clear(htf2_buyside_failure_bars)
    array.clear(htf2_buyside_failure_times)
    array.clear(htf2_buyside_targets)
    array.clear(htf2_buyside_open)
    array.clear(htf2_buyside_fill_bars)
    array.clear(htf2_buyside_fill_times)
    array.clear(htf2_sellside_failure_bars)
    array.clear(htf2_sellside_failure_times)
    array.clear(htf2_sellside_targets)
    array.clear(htf2_sellside_open)
    array.clear(htf2_sellside_fill_bars)
    array.clear(htf2_sellside_fill_times)
    array.clear(htf2_eligible_high_ticks)
    array.clear(htf2_eligible_low_ticks)
    array.clear(htf2_eligible_high_times)
    array.clear(htf2_eligible_low_times)

    // Clear HTF3 arrays
    array.clear(htf3_buyside_failure_bars)
    array.clear(htf3_buyside_failure_times)
    array.clear(htf3_buyside_targets)
    array.clear(htf3_buyside_open)
    array.clear(htf3_buyside_fill_bars)
    array.clear(htf3_buyside_fill_times)
    array.clear(htf3_sellside_failure_bars)
    array.clear(htf3_sellside_failure_times)
    array.clear(htf3_sellside_targets)
    array.clear(htf3_sellside_open)
    array.clear(htf3_sellside_fill_bars)
    array.clear(htf3_sellside_fill_times)
    array.clear(htf3_eligible_high_ticks)
    array.clear(htf3_eligible_low_ticks)
    array.clear(htf3_eligible_high_times)
    array.clear(htf3_eligible_low_times)

    // Clean up HTF1 visual elements
    if array.size(htf1_buyside_lines) > 0
        for i = 0 to array.size(htf1_buyside_lines) - 1
            if not na(array.get(htf1_buyside_lines, i))
                line.delete(array.get(htf1_buyside_lines, i))
    array.clear(htf1_buyside_lines)
    array.clear(htf1_buyside_wick_times)
    if array.size(htf1_buyside_labels) > 0
        for i = 0 to array.size(htf1_buyside_labels) - 1
            if not na(array.get(htf1_buyside_labels, i))
                label.delete(array.get(htf1_buyside_labels, i))
    array.clear(htf1_buyside_labels)
    if array.size(htf1_sellside_lines) > 0
        for i = 0 to array.size(htf1_sellside_lines) - 1
            if not na(array.get(htf1_sellside_lines, i))
                line.delete(array.get(htf1_sellside_lines, i))
    array.clear(htf1_sellside_lines)
    array.clear(htf1_sellside_wick_times)
    if array.size(htf1_sellside_labels) > 0
        for i = 0 to array.size(htf1_sellside_labels) - 1
            if not na(array.get(htf1_sellside_labels, i))
                label.delete(array.get(htf1_sellside_labels, i))
    array.clear(htf1_sellside_labels)

    // Clean up HTF2 visual elements
    if array.size(htf2_buyside_lines) > 0
        for i = 0 to array.size(htf2_buyside_lines) - 1
            if not na(array.get(htf2_buyside_lines, i))
                line.delete(array.get(htf2_buyside_lines, i))
    array.clear(htf2_buyside_lines)
    array.clear(htf2_buyside_wick_times)
    if array.size(htf2_buyside_labels) > 0
        for i = 0 to array.size(htf2_buyside_labels) - 1
            if not na(array.get(htf2_buyside_labels, i))
                label.delete(array.get(htf2_buyside_labels, i))
    array.clear(htf2_buyside_labels)
    if array.size(htf2_sellside_lines) > 0
        for i = 0 to array.size(htf2_sellside_lines) - 1
            if not na(array.get(htf2_sellside_lines, i))
                line.delete(array.get(htf2_sellside_lines, i))
    array.clear(htf2_sellside_lines)
    array.clear(htf2_sellside_wick_times)
    if array.size(htf2_sellside_labels) > 0
        for i = 0 to array.size(htf2_sellside_labels) - 1
            if not na(array.get(htf2_sellside_labels, i))
                label.delete(array.get(htf2_sellside_labels, i))
    array.clear(htf2_sellside_labels)

    // Clean up HTF3 visual elements
    if array.size(htf3_buyside_lines) > 0
        for i = 0 to array.size(htf3_buyside_lines) - 1
            if not na(array.get(htf3_buyside_lines, i))
                line.delete(array.get(htf3_buyside_lines, i))
    array.clear(htf3_buyside_lines)
    array.clear(htf3_buyside_wick_times)
    if array.size(htf3_buyside_labels) > 0
        for i = 0 to array.size(htf3_buyside_labels) - 1
            if not na(array.get(htf3_buyside_labels, i))
                label.delete(array.get(htf3_buyside_labels, i))
    array.clear(htf3_buyside_labels)
    if array.size(htf3_sellside_lines) > 0
        for i = 0 to array.size(htf3_sellside_lines) - 1
            if not na(array.get(htf3_sellside_lines, i))
                line.delete(array.get(htf3_sellside_lines, i))
    array.clear(htf3_sellside_lines)
    array.clear(htf3_sellside_wick_times)
    if array.size(htf3_sellside_labels) > 0
        for i = 0 to array.size(htf3_sellside_labels) - 1
            if not na(array.get(htf3_sellside_labels, i))
                label.delete(array.get(htf3_sellside_labels, i))
    array.clear(htf3_sellside_labels)

// ═══════════════════════════════════════════════════════════════════════════════
// CHANGE DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

current_ticker = ticker.standard()
current_chart_tf = timeframe.period
current_htf_tf = validated_htf1_timeframe
current_limit_zone = get_limit_zone()


symbol_changed = current_ticker != last_ticker
chart_tf_changed = current_chart_tf != last_chart_tf
htf_tf_changed = current_htf_tf != last_htf_tf


limit_zone_changed = current_limit_zone != last_limit_zone
needs_reset = symbol_changed or chart_tf_changed or (htf1_auto and limit_zone_changed) or (not htf1_auto and htf_tf_changed)

if needs_reset
    reset_state()

    htf_bars_processed := 0
    htf_unique_bars := 0
    initialized := true


    cached_bsl_open := -1
    cached_ssl_open := -1
    cached_tracking_lows := -1
    cached_tracking_highs := -1
    cached_mode_text := ""
    cached_htf_tag := ""
    last_ticker := current_ticker
    last_chart_tf := current_chart_tf
    last_htf_tf := current_htf_tf
    last_limit_zone := current_limit_zone

// ═══════════════════════════════════════════════════════════════════════════════
// HTF CANDLE TRACKING - Using request.security for accurate OHLC
// ═══════════════════════════════════════════════════════════════════════════════

// HTF1 OHLC
[sec_htf1_open, sec_htf1_high, sec_htf1_low, sec_htf1_close, sec_htf1_time] = request.security(syminfo.tickerid, validated_htf1_timeframe, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
bool htf1_changed = ta.change(time(validated_htf1_timeframe)) != 0
var bool htf1_has_history = false

// HTF2 OHLC (always fetch, guard processing with htf2_is_valid)
[sec_htf2_open, sec_htf2_high, sec_htf2_low, sec_htf2_close, sec_htf2_time] = request.security(syminfo.tickerid, htf2_timeframe, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
bool htf2_changed = htf2_is_valid and ta.change(time(htf2_timeframe)) != 0
var bool htf2_has_history = false

// HTF3 OHLC (always fetch, guard processing with htf3_is_valid)
[sec_htf3_open, sec_htf3_high, sec_htf3_low, sec_htf3_close, sec_htf3_time] = request.security(syminfo.tickerid, htf3_timeframe, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)
bool htf3_changed = htf3_is_valid and ta.change(time(htf3_timeframe)) != 0
var bool htf3_has_history = false

if htf1_is_valid
    // Initialize on last confirmed historical bar
    if not initialized and barstate.islastconfirmedhistory and not needs_reset
        initialized := true

    if htf1_changed
        // Get completed HTF candle values from request.security (same as overlay)
        float prev_htf_high = sec_htf1_high[1]
        float prev_htf_low = sec_htf1_low[1]
        float prev_htf_close = sec_htf1_close[1]
        int prev_htf_time = int(sec_htf1_time[1])

        // Run detection only if we have valid previous candle AND have seen at least one complete candle
        if not na(prev_htf_high) and htf1_has_history
            // ═══ DETECTION on completed HTF candle ═══
            local_sellside_detected = false
            local_buyside_detected = false

            // BSL Detection first (like LTF Algo): Wick took LOW but closed at/above
            if array.size(htf1_eligible_low_ticks) > 0 and not local_buyside_detected
                for i = 0 to array.size(htf1_eligible_low_ticks) - 1
                    ref_low_tick = array.get(htf1_eligible_low_ticks, i)
                    ref_low = from_tick(ref_low_tick)
                    if prev_htf_low < ref_low and prev_htf_close >= ref_low
                        // Check if we already have this target (deduplication)
                        int target_tick = to_tick(prev_htf_high)
                        bool already_exists = false
                        if array.size(htf1_buyside_targets) > 0
                            for j = 0 to array.size(htf1_buyside_targets) - 1
                                if to_tick(array.get(htf1_buyside_targets, j)) == target_tick
                                    already_exists := true
                                    break

                        if not already_exists
                            wick_timestamp = array.get(htf1_eligible_low_times, i)
                            array.push(htf1_buyside_failure_bars, bar_index)
                            array.push(htf1_buyside_failure_times, int(time))
                            array.push(htf1_buyside_targets, prev_htf_high)
                            array.push(htf1_buyside_open, true)
                            array.push(htf1_buyside_fill_bars, int(na))
                            array.push(htf1_buyside_fill_times, int(na))
                            array.push(htf1_buyside_lines, na)
                            array.push(htf1_buyside_labels, na)
                            array.push(htf1_buyside_wick_times, wick_timestamp)
                            local_buyside_detected := true
                        break

            // SSL Detection: Wick took HIGH but closed at/below
            if array.size(htf1_eligible_high_ticks) > 0 and not local_sellside_detected
                for i = 0 to array.size(htf1_eligible_high_ticks) - 1
                    ref_high_tick = array.get(htf1_eligible_high_ticks, i)
                    ref_high = from_tick(ref_high_tick)
                    if prev_htf_high > ref_high and prev_htf_close <= ref_high
                        // Check if we already have this target (deduplication)
                        int target_tick = to_tick(prev_htf_low)
                        bool already_exists = false
                        if array.size(htf1_sellside_targets) > 0
                            for j = 0 to array.size(htf1_sellside_targets) - 1
                                if to_tick(array.get(htf1_sellside_targets, j)) == target_tick
                                    already_exists := true
                                    break

                        if not already_exists
                            wick_timestamp = array.get(htf1_eligible_high_times, i)
                            array.push(htf1_sellside_failure_bars, bar_index)
                            array.push(htf1_sellside_failure_times, int(time))
                            array.push(htf1_sellside_targets, prev_htf_low)
                            array.push(htf1_sellside_open, true)
                            array.push(htf1_sellside_fill_bars, int(na))
                            array.push(htf1_sellside_fill_times, int(na))
                            array.push(htf1_sellside_lines, na)
                            array.push(htf1_sellside_labels, na)
                            array.push(htf1_sellside_wick_times, wick_timestamp)
                            local_sellside_detected := true
                        break

            // Remove broken levels
            if array.size(htf1_eligible_high_ticks) > 0
                idx = array.size(htf1_eligible_high_ticks) - 1
                while idx >= 0
                    if prev_htf_high >= from_tick(array.get(htf1_eligible_high_ticks, idx))
                        array.remove(htf1_eligible_high_ticks, idx)
                        array.remove(htf1_eligible_high_times, idx)
                    idx -= 1

            if array.size(htf1_eligible_low_ticks) > 0
                idx = array.size(htf1_eligible_low_ticks) - 1
                while idx >= 0
                    if prev_htf_low <= from_tick(array.get(htf1_eligible_low_ticks, idx))
                        array.remove(htf1_eligible_low_ticks, idx)
                        array.remove(htf1_eligible_low_times, idx)
                    idx -= 1

        // Add completed candle's levels as new eligible levels (always, if valid)
        if not na(prev_htf_high)
            add_htf1_eligible_high(prev_htf_high, prev_htf_time)
            add_htf1_eligible_low(prev_htf_low, prev_htf_time)
            htf1_has_history := true

        htf_unique_bars := htf_unique_bars + 1
        htf_bars_processed := htf_bars_processed + 1

    // ═══ FILL DETECTION on every bar ═══
    // Check if price has reached targets using LTF bar data
    if array.size(htf1_sellside_targets) > 0
        for i = 0 to array.size(htf1_sellside_targets) - 1
            if array.get(htf1_sellside_open, i) and bar_index > array.get(htf1_sellside_failure_bars, i)
                if low <= array.get(htf1_sellside_targets, i)
                    array.set(htf1_sellside_open, i, false)
                    array.set(htf1_sellside_fill_bars, i, bar_index)
                    array.set(htf1_sellside_fill_times, i, int(time))

    if array.size(htf1_buyside_targets) > 0
        for i = 0 to array.size(htf1_buyside_targets) - 1
            if array.get(htf1_buyside_open, i) and bar_index > array.get(htf1_buyside_failure_bars, i)
                if high >= array.get(htf1_buyside_targets, i)
                    array.set(htf1_buyside_open, i, false)
                    array.set(htf1_buyside_fill_bars, i, bar_index)
                    array.set(htf1_buyside_fill_times, i, int(time))

// ═══════════════════════════════════════════════════════════════════════════════
// HTF2 DETECTION & FILL
// ═══════════════════════════════════════════════════════════════════════════════

if htf2_is_valid and htf2_changed
    float prev_htf2_high = sec_htf2_high[1]
    float prev_htf2_low = sec_htf2_low[1]
    float prev_htf2_close = sec_htf2_close[1]
    int prev_htf2_time = int(sec_htf2_time[1])

    if not na(prev_htf2_high) and htf2_has_history
        local_htf2_buyside_detected = false
        local_htf2_sellside_detected = false

        // BSL Detection
        if array.size(htf2_eligible_low_ticks) > 0 and not local_htf2_buyside_detected
            for i = 0 to array.size(htf2_eligible_low_ticks) - 1
                ref_low_tick = array.get(htf2_eligible_low_ticks, i)
                ref_low = from_tick(ref_low_tick)
                if prev_htf2_low < ref_low and prev_htf2_close >= ref_low
                    int target_tick = to_tick(prev_htf2_high)
                    bool already_exists = false
                    if array.size(htf2_buyside_targets) > 0
                        for j = 0 to array.size(htf2_buyside_targets) - 1
                            if to_tick(array.get(htf2_buyside_targets, j)) == target_tick
                                already_exists := true
                                break
                    if not already_exists
                        wick_timestamp = array.get(htf2_eligible_low_times, i)
                        array.push(htf2_buyside_failure_bars, bar_index)
                        array.push(htf2_buyside_failure_times, int(time))
                        array.push(htf2_buyside_targets, prev_htf2_high)
                        array.push(htf2_buyside_open, true)
                        array.push(htf2_buyside_fill_bars, int(na))
                        array.push(htf2_buyside_fill_times, int(na))
                        array.push(htf2_buyside_lines, na)
                        array.push(htf2_buyside_labels, na)
                        array.push(htf2_buyside_wick_times, wick_timestamp)
                        local_htf2_buyside_detected := true
                    break

        // SSL Detection
        if array.size(htf2_eligible_high_ticks) > 0 and not local_htf2_sellside_detected
            for i = 0 to array.size(htf2_eligible_high_ticks) - 1
                ref_high_tick = array.get(htf2_eligible_high_ticks, i)
                ref_high = from_tick(ref_high_tick)
                if prev_htf2_high > ref_high and prev_htf2_close <= ref_high
                    int target_tick = to_tick(prev_htf2_low)
                    bool already_exists = false
                    if array.size(htf2_sellside_targets) > 0
                        for j = 0 to array.size(htf2_sellside_targets) - 1
                            if to_tick(array.get(htf2_sellside_targets, j)) == target_tick
                                already_exists := true
                                break
                    if not already_exists
                        wick_timestamp = array.get(htf2_eligible_high_times, i)
                        array.push(htf2_sellside_failure_bars, bar_index)
                        array.push(htf2_sellside_failure_times, int(time))
                        array.push(htf2_sellside_targets, prev_htf2_low)
                        array.push(htf2_sellside_open, true)
                        array.push(htf2_sellside_fill_bars, int(na))
                        array.push(htf2_sellside_fill_times, int(na))
                        array.push(htf2_sellside_lines, na)
                        array.push(htf2_sellside_labels, na)
                        array.push(htf2_sellside_wick_times, wick_timestamp)
                        local_htf2_sellside_detected := true
                    break

        // Remove broken levels
        if array.size(htf2_eligible_high_ticks) > 0
            idx = array.size(htf2_eligible_high_ticks) - 1
            while idx >= 0
                if prev_htf2_high >= from_tick(array.get(htf2_eligible_high_ticks, idx))
                    array.remove(htf2_eligible_high_ticks, idx)
                    array.remove(htf2_eligible_high_times, idx)
                idx -= 1
        if array.size(htf2_eligible_low_ticks) > 0
            idx = array.size(htf2_eligible_low_ticks) - 1
            while idx >= 0
                if prev_htf2_low <= from_tick(array.get(htf2_eligible_low_ticks, idx))
                    array.remove(htf2_eligible_low_ticks, idx)
                    array.remove(htf2_eligible_low_times, idx)
                idx -= 1

    if not na(prev_htf2_high)
        add_htf2_eligible_high(prev_htf2_high, prev_htf2_time)
        add_htf2_eligible_low(prev_htf2_low, prev_htf2_time)
        htf2_has_history := true

// HTF2 fill detection
if htf2_is_valid
    if array.size(htf2_sellside_targets) > 0
        for i = 0 to array.size(htf2_sellside_targets) - 1
            if array.get(htf2_sellside_open, i) and bar_index > array.get(htf2_sellside_failure_bars, i)
                if low <= array.get(htf2_sellside_targets, i)
                    array.set(htf2_sellside_open, i, false)
                    array.set(htf2_sellside_fill_bars, i, bar_index)
                    array.set(htf2_sellside_fill_times, i, int(time))
    if array.size(htf2_buyside_targets) > 0
        for i = 0 to array.size(htf2_buyside_targets) - 1
            if array.get(htf2_buyside_open, i) and bar_index > array.get(htf2_buyside_failure_bars, i)
                if high >= array.get(htf2_buyside_targets, i)
                    array.set(htf2_buyside_open, i, false)
                    array.set(htf2_buyside_fill_bars, i, bar_index)
                    array.set(htf2_buyside_fill_times, i, int(time))

// ═══════════════════════════════════════════════════════════════════════════════
// HTF3 DETECTION & FILL
// ═══════════════════════════════════════════════════════════════════════════════

if htf3_is_valid and htf3_changed
    float prev_htf3_high = sec_htf3_high[1]
    float prev_htf3_low = sec_htf3_low[1]
    float prev_htf3_close = sec_htf3_close[1]
    int prev_htf3_time = int(sec_htf3_time[1])

    if not na(prev_htf3_high) and htf3_has_history
        local_htf3_buyside_detected = false
        local_htf3_sellside_detected = false

        // BSL Detection
        if array.size(htf3_eligible_low_ticks) > 0 and not local_htf3_buyside_detected
            for i = 0 to array.size(htf3_eligible_low_ticks) - 1
                ref_low_tick = array.get(htf3_eligible_low_ticks, i)
                ref_low = from_tick(ref_low_tick)
                if prev_htf3_low < ref_low and prev_htf3_close >= ref_low
                    int target_tick = to_tick(prev_htf3_high)
                    bool already_exists = false
                    if array.size(htf3_buyside_targets) > 0
                        for j = 0 to array.size(htf3_buyside_targets) - 1
                            if to_tick(array.get(htf3_buyside_targets, j)) == target_tick
                                already_exists := true
                                break
                    if not already_exists
                        wick_timestamp = array.get(htf3_eligible_low_times, i)
                        array.push(htf3_buyside_failure_bars, bar_index)
                        array.push(htf3_buyside_failure_times, int(time))
                        array.push(htf3_buyside_targets, prev_htf3_high)
                        array.push(htf3_buyside_open, true)
                        array.push(htf3_buyside_fill_bars, int(na))
                        array.push(htf3_buyside_fill_times, int(na))
                        array.push(htf3_buyside_lines, na)
                        array.push(htf3_buyside_labels, na)
                        array.push(htf3_buyside_wick_times, wick_timestamp)
                        local_htf3_buyside_detected := true
                    break

        // SSL Detection
        if array.size(htf3_eligible_high_ticks) > 0 and not local_htf3_sellside_detected
            for i = 0 to array.size(htf3_eligible_high_ticks) - 1
                ref_high_tick = array.get(htf3_eligible_high_ticks, i)
                ref_high = from_tick(ref_high_tick)
                if prev_htf3_high > ref_high and prev_htf3_close <= ref_high
                    int target_tick = to_tick(prev_htf3_low)
                    bool already_exists = false
                    if array.size(htf3_sellside_targets) > 0
                        for j = 0 to array.size(htf3_sellside_targets) - 1
                            if to_tick(array.get(htf3_sellside_targets, j)) == target_tick
                                already_exists := true
                                break
                    if not already_exists
                        wick_timestamp = array.get(htf3_eligible_high_times, i)
                        array.push(htf3_sellside_failure_bars, bar_index)
                        array.push(htf3_sellside_failure_times, int(time))
                        array.push(htf3_sellside_targets, prev_htf3_low)
                        array.push(htf3_sellside_open, true)
                        array.push(htf3_sellside_fill_bars, int(na))
                        array.push(htf3_sellside_fill_times, int(na))
                        array.push(htf3_sellside_lines, na)
                        array.push(htf3_sellside_labels, na)
                        array.push(htf3_sellside_wick_times, wick_timestamp)
                        local_htf3_sellside_detected := true
                    break

        // Remove broken levels
        if array.size(htf3_eligible_high_ticks) > 0
            idx = array.size(htf3_eligible_high_ticks) - 1
            while idx >= 0
                if prev_htf3_high >= from_tick(array.get(htf3_eligible_high_ticks, idx))
                    array.remove(htf3_eligible_high_ticks, idx)
                    array.remove(htf3_eligible_high_times, idx)
                idx -= 1
        if array.size(htf3_eligible_low_ticks) > 0
            idx = array.size(htf3_eligible_low_ticks) - 1
            while idx >= 0
                if prev_htf3_low <= from_tick(array.get(htf3_eligible_low_ticks, idx))
                    array.remove(htf3_eligible_low_ticks, idx)
                    array.remove(htf3_eligible_low_times, idx)
                idx -= 1

    if not na(prev_htf3_high)
        add_htf3_eligible_high(prev_htf3_high, prev_htf3_time)
        add_htf3_eligible_low(prev_htf3_low, prev_htf3_time)
        htf3_has_history := true

// HTF3 fill detection
if htf3_is_valid
    if array.size(htf3_sellside_targets) > 0
        for i = 0 to array.size(htf3_sellside_targets) - 1
            if array.get(htf3_sellside_open, i) and bar_index > array.get(htf3_sellside_failure_bars, i)
                if low <= array.get(htf3_sellside_targets, i)
                    array.set(htf3_sellside_open, i, false)
                    array.set(htf3_sellside_fill_bars, i, bar_index)
                    array.set(htf3_sellside_fill_times, i, int(time))
    if array.size(htf3_buyside_targets) > 0
        for i = 0 to array.size(htf3_buyside_targets) - 1
            if array.get(htf3_buyside_open, i) and bar_index > array.get(htf3_buyside_failure_bars, i)
                if high >= array.get(htf3_buyside_targets, i)
                    array.set(htf3_buyside_open, i, false)
                    array.set(htf3_buyside_fill_bars, i, bar_index)
                    array.set(htf3_buyside_fill_times, i, int(time))

// ═══════════════════════════════════════════════════════════════════════════════
// HTF CANDLE OVERLAY (DEBUG)
// ═══════════════════════════════════════════════════════════════════════════════

// Track bar index where current HTF candle started
var int dbg_htf_start_bar = na
var box dbg_current_wick = na
var box dbg_current_body = na

// HTF change detection
bool dbg_change_htf = ta.change(time(validated_htf1_timeframe)) != 0

// Use input colors for HTF candles
color dbg_bull_color = htf_bull_body_color
color dbg_bear_color = htf_bear_body_color
color dbg_bull_wick = htf_bull_wick_color
color dbg_bear_wick = htf_bear_wick_color

if show_htf_candles
    if dbg_change_htf
        // Draw COMPLETED candle: started at dbg_htf_start_bar, ended at bar_index - 1
        // OHLC from sec_htf_*[1] = previous HTF candle's final values
        if not na(dbg_htf_start_bar)
            float prev_o = sec_htf1_open[1]
            float prev_h = sec_htf1_high[1]
            float prev_l = sec_htf1_low[1]
            float prev_c = sec_htf1_close[1]
            int end_bar = bar_index - 1
            bool prev_bull = prev_c > prev_o

            // Wick box
            box.new(dbg_htf_start_bar, prev_h, end_bar, prev_l, prev_bull ? dbg_bull_wick : dbg_bear_wick, bgcolor=prev_bull ? dbg_bull_wick : dbg_bear_wick)
            // Body box
            if prev_bull
                box.new(dbg_htf_start_bar, prev_c, end_bar, prev_o, dbg_bull_color, bgcolor=dbg_bull_color)
            else
                box.new(dbg_htf_start_bar, prev_o, end_bar, prev_c, dbg_bear_color, bgcolor=dbg_bear_color)

        // New HTF candle starts at current bar
        dbg_htf_start_bar := bar_index

    // Draw current forming candle on last bar
    if barstate.islast and not na(dbg_htf_start_bar)
        box.delete(dbg_current_wick)
        box.delete(dbg_current_body)

        bool is_bull = sec_htf1_close > sec_htf1_open
        // Wick
        dbg_current_wick := box.new(dbg_htf_start_bar, sec_htf1_high, bar_index, sec_htf1_low, is_bull ? dbg_bull_wick : dbg_bear_wick, bgcolor=is_bull ? dbg_bull_wick : dbg_bear_wick)
        // Body
        if is_bull
            dbg_current_body := box.new(dbg_htf_start_bar, sec_htf1_close, bar_index, sec_htf1_open, dbg_bull_color, bgcolor=dbg_bull_color)
        else
            dbg_current_body := box.new(dbg_htf_start_bar, sec_htf1_open, bar_index, sec_htf1_close, dbg_bear_color, bgcolor=dbg_bear_color)

// ═══════════════════════════════════════════════════════════════════════════════
// DISPLAY SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.islast


    // BSL DISPLAY PROCESSING
    if array.size(htf1_buyside_failure_bars) > 0
        local_open_lines_shown = 0
        local_filled_lines_shown = 0

        for i = array.size(htf1_buyside_failure_bars) - 1 to 0
            local_is_open = array.get(htf1_buyside_open, i)
            local_current_line = array.get(htf1_buyside_lines, i)
            local_current_label = array.get(htf1_buyside_labels, i)
            local_target = array.get(htf1_buyside_targets, i)
            local_tick = to_tick(local_target)

            local_should_show = false

            // Show open lines first, then filled lines (skip if higher TF has same level)
            if local_is_open and local_open_lines_shown < open_lines_count
                if not higher_tf_has_open_bsl_at_tick(local_tick)
                    local_should_show := true
                    local_open_lines_shown += 1
            else if not local_is_open and local_filled_lines_shown < filled_lines_count
                local_should_show := true
                local_filled_lines_shown += 1

            if local_should_show
                local_failure_time = array.get(htf1_buyside_failure_times, i)
                local_fill_time = array.get(htf1_buyside_fill_times, i)

                local_end_time = local_is_open ? time + (chart_tf_seconds * 1000 * htf1_extension) : local_fill_time
                local_line_color = local_is_open ? htf1_line_color : htf1_fill_color
                local_line_style = get_line_style(local_is_open ? open_style : filled_style)
                local_line_width = local_is_open ? htf1_open_width : htf1_filled_width

                if na(local_current_line)
                    local_new_line = line.new(local_failure_time, local_target, local_end_time, local_target, xloc=xloc.bar_time)
                    line.set_color(local_new_line, local_line_color)
                    line.set_style(local_new_line, local_line_style)
                    line.set_width(local_new_line, local_line_width)
                    array.set(htf1_buyside_lines, i, local_new_line)
                else
                    line.set_xy1(local_current_line, local_failure_time, local_target)
                    line.set_xy2(local_current_line, local_end_time, local_target)
                    line.set_color(local_current_line, local_line_color)
                    line.set_style(local_current_line, local_line_style)
                    line.set_width(local_current_line, local_line_width)

                // Label management - only show on open lines
                if local_is_open
                    wick_timestamp = array.get(htf1_buyside_wick_times, i)
                    tooltip_text = format_tooltip(true, wick_timestamp)

                    if na(local_current_label)
                        local_new_label = label.new(
                             x=local_end_time,
                             y=local_target,
                             text=get_timeframe_text_with_suffix(true),
                             style=label.style_label_left,
                             textcolor=htf1_label_color,
                             size=get_label_text_size(),
                             xloc=xloc.bar_time,
                             tooltip=tooltip_text
                         )
                        label.set_color(local_new_label, bg_none())
                        array.set(htf1_buyside_labels, i, local_new_label)
                    else
                        label.set_xy(local_current_label, local_end_time, local_target)
                        label.set_text(local_current_label, get_timeframe_text_with_suffix(true))
                        label.set_textcolor(local_current_label, htf1_label_color)
                        label.set_size(local_current_label, get_label_text_size())
                        label.set_color(local_current_label, bg_none())
                        label.set_tooltip(local_current_label, tooltip_text)
                else if not na(local_current_label)
                    label.delete(local_current_label)
                    array.set(htf1_buyside_labels, i, na)
            else
                if not na(local_current_line)
                    line.delete(local_current_line)
                    array.set(htf1_buyside_lines, i, na)
                if not na(local_current_label)
                    label.delete(local_current_label)
                    array.set(htf1_buyside_labels, i, na)

    // SSL DISPLAY PROCESSING
    if array.size(htf1_sellside_failure_bars) > 0
        local_open_lines_shown = 0
        local_filled_lines_shown = 0

        for i = array.size(htf1_sellside_failure_bars) - 1 to 0
            local_is_open = array.get(htf1_sellside_open, i)
            local_current_line = array.get(htf1_sellside_lines, i)
            local_current_label = array.get(htf1_sellside_labels, i)
            local_target = array.get(htf1_sellside_targets, i)
            local_tick = to_tick(local_target)

            local_should_show = false

            // Show open lines first, then filled lines (skip if higher TF has same level)
            if local_is_open and local_open_lines_shown < open_lines_count
                if not higher_tf_has_open_ssl_at_tick(local_tick)
                    local_should_show := true
                    local_open_lines_shown += 1
            else if not local_is_open and local_filled_lines_shown < filled_lines_count
                local_should_show := true
                local_filled_lines_shown += 1

            if local_should_show
                local_failure_time = array.get(htf1_sellside_failure_times, i)
                local_fill_time = array.get(htf1_sellside_fill_times, i)

                local_end_time = local_is_open ? time + (chart_tf_seconds * 1000 * htf1_extension) : local_fill_time
                local_line_color = local_is_open ? htf1_line_color : htf1_fill_color
                local_line_style = get_line_style(local_is_open ? open_style : filled_style)
                local_line_width = local_is_open ? htf1_open_width : htf1_filled_width

                if na(local_current_line)
                    local_new_line = line.new(local_failure_time, local_target, local_end_time, local_target, xloc=xloc.bar_time)
                    line.set_color(local_new_line, local_line_color)
                    line.set_style(local_new_line, local_line_style)
                    line.set_width(local_new_line, local_line_width)
                    array.set(htf1_sellside_lines, i, local_new_line)
                else
                    line.set_xy1(local_current_line, local_failure_time, local_target)
                    line.set_xy2(local_current_line, local_end_time, local_target)
                    line.set_color(local_current_line, local_line_color)
                    line.set_style(local_current_line, local_line_style)
                    line.set_width(local_current_line, local_line_width)

                // Label management - only show on open lines
                if local_is_open
                    wick_timestamp = array.get(htf1_sellside_wick_times, i)
                    tooltip_text = format_tooltip(false, wick_timestamp)

                    if na(local_current_label)
                        local_new_label = label.new(
                             x=local_end_time,
                             y=local_target,
                             text=get_timeframe_text_with_suffix(false),
                             style=label.style_label_left,
                             textcolor=htf1_label_color,
                             size=get_label_text_size(),
                             xloc=xloc.bar_time,
                             tooltip=tooltip_text
                         )
                        label.set_color(local_new_label, bg_none())
                        array.set(htf1_sellside_labels, i, local_new_label)
                    else
                        label.set_xy(local_current_label, local_end_time, local_target)
                        label.set_text(local_current_label, get_timeframe_text_with_suffix(false))
                        label.set_textcolor(local_current_label, htf1_label_color)
                        label.set_size(local_current_label, get_label_text_size())
                        label.set_color(local_current_label, bg_none())
                        label.set_tooltip(local_current_label, tooltip_text)
                else if not na(local_current_label)
                    label.delete(local_current_label)
                    array.set(htf1_sellside_labels, i, na)
            else
                if not na(local_current_line)
                    line.delete(local_current_line)
                    array.set(htf1_sellside_lines, i, na)
                if not na(local_current_label)
                    label.delete(local_current_label)
                    array.set(htf1_sellside_labels, i, na)

    // ═══ HTF2 DISPLAY (configurable lines per BSL/SSL) ═══
    if htf2_is_valid
        htf2_tag = get_htf_tag_for_tf(htf2_timeframe)
        htf2_bsl_shown = 0
        htf2_ssl_shown = 0

        // HTF2 BSL - show open lines (skip if higher TF has same level)
        if array.size(htf2_buyside_failure_bars) > 0
            for i = array.size(htf2_buyside_failure_bars) - 1 to 0
                if array.get(htf2_buyside_open, i) and htf2_bsl_shown < htf2_open_lines
                    local_target = array.get(htf2_buyside_targets, i)
                    local_tick = to_tick(local_target)

                    // Skip if HTF3 is higher TF and has open level at same tick
                    if htf3_is_valid and htf3_seconds > htf2_seconds and htf3_has_open_bsl_at_tick(local_tick)
                        continue

                    local_failure_time = array.get(htf2_buyside_failure_times, i)
                    local_end_time = time + (chart_tf_seconds * 1000 * htf2_extension)
                    local_current_line = array.get(htf2_buyside_lines, i)
                    if na(local_current_line)
                        local_new_line = line.new(local_failure_time, local_target, local_end_time, local_target, xloc=xloc.bar_time, color=htf2_line_color, style=get_line_style(open_style), width=htf2_open_width)
                        array.set(htf2_buyside_lines, i, local_new_line)
                    else
                        line.set_xy1(local_current_line, local_failure_time, local_target)
                        line.set_xy2(local_current_line, local_end_time, local_target)
                    local_current_label = array.get(htf2_buyside_labels, i)
                    if na(local_current_label)
                        local_new_label = label.new(local_end_time, local_target, get_label_text(htf2_tag, true), xloc=xloc.bar_time, style=label.style_label_left, textcolor=htf2_label_color, size=size.small, color=bg_none())
                        array.set(htf2_buyside_labels, i, local_new_label)
                    else
                        label.set_xy(local_current_label, local_end_time, local_target)
                    htf2_bsl_shown += 1

        // HTF2 SSL - show open lines (skip if higher TF has same level)
        if array.size(htf2_sellside_failure_bars) > 0
            for i = array.size(htf2_sellside_failure_bars) - 1 to 0
                if array.get(htf2_sellside_open, i) and htf2_ssl_shown < htf2_open_lines
                    local_target = array.get(htf2_sellside_targets, i)
                    local_tick = to_tick(local_target)

                    // Skip if HTF3 is higher TF and has open level at same tick
                    if htf3_is_valid and htf3_seconds > htf2_seconds and htf3_has_open_ssl_at_tick(local_tick)
                        continue

                    local_failure_time = array.get(htf2_sellside_failure_times, i)
                    local_end_time = time + (chart_tf_seconds * 1000 * htf2_extension)
                    local_current_line = array.get(htf2_sellside_lines, i)
                    if na(local_current_line)
                        local_new_line = line.new(local_failure_time, local_target, local_end_time, local_target, xloc=xloc.bar_time, color=htf2_line_color, style=get_line_style(open_style), width=htf2_open_width)
                        array.set(htf2_sellside_lines, i, local_new_line)
                    else
                        line.set_xy1(local_current_line, local_failure_time, local_target)
                        line.set_xy2(local_current_line, local_end_time, local_target)
                    local_current_label = array.get(htf2_sellside_labels, i)
                    if na(local_current_label)
                        local_new_label = label.new(local_end_time, local_target, get_label_text(htf2_tag, false), xloc=xloc.bar_time, style=label.style_label_left, textcolor=htf2_label_color, size=size.small, color=bg_none())
                        array.set(htf2_sellside_labels, i, local_new_label)
                    else
                        label.set_xy(local_current_label, local_end_time, local_target)
                    htf2_ssl_shown += 1

    // ═══ HTF3 DISPLAY (configurable lines per BSL/SSL) ═══
    if htf3_is_valid
        htf3_tag = get_htf_tag_for_tf(htf3_timeframe)
        htf3_bsl_shown = 0
        htf3_ssl_shown = 0

        // HTF3 BSL - show open lines (highest TF, no deduplication needed)
        if array.size(htf3_buyside_failure_bars) > 0
            for i = array.size(htf3_buyside_failure_bars) - 1 to 0
                if array.get(htf3_buyside_open, i) and htf3_bsl_shown < htf3_open_lines
                    local_failure_time = array.get(htf3_buyside_failure_times, i)
                    local_target = array.get(htf3_buyside_targets, i)
                    local_end_time = time + (chart_tf_seconds * 1000 * htf3_extension)
                    local_current_line = array.get(htf3_buyside_lines, i)
                    if na(local_current_line)
                        local_new_line = line.new(local_failure_time, local_target, local_end_time, local_target, xloc=xloc.bar_time, color=htf3_line_color, style=get_line_style(open_style), width=htf3_open_width)
                        array.set(htf3_buyside_lines, i, local_new_line)
                    else
                        line.set_xy1(local_current_line, local_failure_time, local_target)
                        line.set_xy2(local_current_line, local_end_time, local_target)
                    local_current_label = array.get(htf3_buyside_labels, i)
                    if na(local_current_label)
                        local_new_label = label.new(local_end_time, local_target, get_label_text(htf3_tag, true), xloc=xloc.bar_time, style=label.style_label_left, textcolor=htf3_label_color, size=size.small, color=bg_none())
                        array.set(htf3_buyside_labels, i, local_new_label)
                    else
                        label.set_xy(local_current_label, local_end_time, local_target)
                    htf3_bsl_shown += 1

        // HTF3 SSL - show open lines (highest TF, no deduplication needed)
        if array.size(htf3_sellside_failure_bars) > 0
            for i = array.size(htf3_sellside_failure_bars) - 1 to 0
                if array.get(htf3_sellside_open, i) and htf3_ssl_shown < htf3_open_lines
                    local_failure_time = array.get(htf3_sellside_failure_times, i)
                    local_target = array.get(htf3_sellside_targets, i)
                    local_end_time = time + (chart_tf_seconds * 1000 * htf3_extension)
                    local_current_line = array.get(htf3_sellside_lines, i)
                    if na(local_current_line)
                        local_new_line = line.new(local_failure_time, local_target, local_end_time, local_target, xloc=xloc.bar_time, color=htf3_line_color, style=get_line_style(open_style), width=htf3_open_width)
                        array.set(htf3_sellside_lines, i, local_new_line)
                    else
                        line.set_xy1(local_current_line, local_failure_time, local_target)
                        line.set_xy2(local_current_line, local_end_time, local_target)
                    local_current_label = array.get(htf3_sellside_labels, i)
                    if na(local_current_label)
                        local_new_label = label.new(local_end_time, local_target, get_label_text(htf3_tag, false), xloc=xloc.bar_time, style=label.style_label_left, textcolor=htf3_label_color, size=size.small, color=bg_none())
                        array.set(htf3_sellside_labels, i, local_new_label)
                    else
                        label.set_xy(local_current_label, local_end_time, local_target)
                    htf3_ssl_shown += 1


// ═══════════════════════════════════════════════════════════════════════════════
// DASHBOARD
// ═══════════════════════════════════════════════════════════════════════════════

if show_dashboard and initialized

    bsl_total = array.size(htf1_buyside_targets)
    ssl_total = array.size(htf1_sellside_targets)
    current_bsl_open = 0
    current_ssl_open = 0

    if bsl_total > 0
        for i = 0 to bsl_total - 1
            if array.get(htf1_buyside_open, i)
                current_bsl_open += 1

    if ssl_total > 0
        for i = 0 to ssl_total - 1
            if array.get(htf1_sellside_open, i)
                current_ssl_open += 1

    current_tracking_lows = array.size(htf1_eligible_low_ticks)
    current_tracking_highs = array.size(htf1_eligible_high_ticks)
    current_mode_text = "Mode: " + (htf1_auto ? "Auto" : "Manual") + " • Limit: " + get_user_friendly_timeframe(get_max_allowed_htf())
    current_htf_tag = get_htf_tag()


    dashboard_needs_update = (current_bsl_open != cached_bsl_open or current_ssl_open != cached_ssl_open or current_tracking_lows != cached_tracking_lows or current_tracking_highs != cached_tracking_highs or current_mode_text != cached_mode_text or current_htf_tag != cached_htf_tag)

    if dashboard_needs_update
        if not na(htf_dashboard)
            table.delete(htf_dashboard)

        htf_dashboard := table.new(get_table_position(), 1, 4, bgcolor=table_bg_color, border_width=1, border_color=table_border_color)
        table.cell(htf_dashboard, 0, 0, current_htf_tag, text_color=default_text_color, text_size=get_table_text_size())
        table.cell(htf_dashboard, 0, 1, "BSL: " + str.tostring(current_bsl_open), text_color=default_text_color, text_size=get_table_text_size())
        table.cell(htf_dashboard, 0, 2, "SSL: " + str.tostring(current_ssl_open), text_color=default_text_color, text_size=get_table_text_size())
        table.cell(htf_dashboard, 0, 3, "Limit: " + get_user_friendly_timeframe(get_max_allowed_htf()), text_color=default_text_color, text_size=get_table_text_size())

        cached_bsl_open := current_bsl_open
        cached_ssl_open := current_ssl_open
        cached_tracking_lows := current_tracking_lows
        cached_tracking_highs := current_tracking_highs
        cached_mode_text := current_mode_text
        cached_htf_tag := current_htf_tag

// ═══════════════════════════════════════════════════════════════════════════════
// OPTIMIZATION 6: ENHANCED MEMORY CLEANUP - BSL FIRST
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.islast and initialized
    cleanup_max = math.max(100, (open_lines_count + filled_lines_count) * 2)

    // BSL-FIRST CLEANUP (LTF v3.0 PARITY) with enhanced memory management
    while array.size(htf1_buyside_failure_bars) > cleanup_max
        cleanup_old_line = array.shift(htf1_buyside_lines)
        cleanup_old_label = array.shift(htf1_buyside_labels)
        if not na(cleanup_old_line)
            line.delete(cleanup_old_line)
        if not na(cleanup_old_label)
            label.delete(cleanup_old_label)
        array.shift(htf1_buyside_failure_bars)
        array.shift(htf1_buyside_failure_times)
        array.shift(htf1_buyside_targets)
        array.shift(htf1_buyside_open)
        array.shift(htf1_buyside_fill_bars)
        array.shift(htf1_buyside_fill_times)
        array.shift(htf1_buyside_wick_times)

    while array.size(htf1_sellside_failure_bars) > cleanup_max
        cleanup_old_line = array.shift(htf1_sellside_lines)
        cleanup_old_label = array.shift(htf1_sellside_labels)
        if not na(cleanup_old_line)
            line.delete(cleanup_old_line)
        if not na(cleanup_old_label)
            label.delete(cleanup_old_label)
        array.shift(htf1_sellside_failure_bars)
        array.shift(htf1_sellside_failure_times)
        array.shift(htf1_sellside_targets)
        array.shift(htf1_sellside_open)
        array.shift(htf1_sellside_fill_bars)
        array.shift(htf1_sellside_fill_times)
        array.shift(htf1_sellside_wick_times)

// ═══════════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE
// ═══════════════════════════════════════════════════════════════════════════════

if show_color_table and barstate.islast
    var table colorTable = table.new(position.top_right, 3, 17, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

    // Header
    table.cell(colorTable, 0, 0, "Color", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 1, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 2, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)

    // HTF1 Colors
    table.cell(colorTable, 0, 1, "HTF1 Line", text_size=size.small)
    table.cell(colorTable, 1, 1, str.format("R:{0} G:{1} B:{2}", color.r(htf1_line_color), color.g(htf1_line_color), color.b(htf1_line_color)), text_size=size.small)
    table.cell(colorTable, 2, 1, str.tostring(color.t(htf1_line_color)), text_size=size.small)

    table.cell(colorTable, 0, 2, "HTF1 Fill", text_size=size.small)
    table.cell(colorTable, 1, 2, str.format("R:{0} G:{1} B:{2}", color.r(htf1_fill_color), color.g(htf1_fill_color), color.b(htf1_fill_color)), text_size=size.small)
    table.cell(colorTable, 2, 2, str.tostring(color.t(htf1_fill_color)), text_size=size.small)

    table.cell(colorTable, 0, 3, "HTF1 Label", text_size=size.small)
    table.cell(colorTable, 1, 3, str.format("R:{0} G:{1} B:{2}", color.r(htf1_label_color), color.g(htf1_label_color), color.b(htf1_label_color)), text_size=size.small)
    table.cell(colorTable, 2, 3, str.tostring(color.t(htf1_label_color)), text_size=size.small)

    // HTF2 Colors
    table.cell(colorTable, 0, 4, "HTF2 Line", text_size=size.small)
    table.cell(colorTable, 1, 4, str.format("R:{0} G:{1} B:{2}", color.r(htf2_line_color), color.g(htf2_line_color), color.b(htf2_line_color)), text_size=size.small)
    table.cell(colorTable, 2, 4, str.tostring(color.t(htf2_line_color)), text_size=size.small)

    table.cell(colorTable, 0, 5, "HTF2 Fill", text_size=size.small)
    table.cell(colorTable, 1, 5, str.format("R:{0} G:{1} B:{2}", color.r(htf2_fill_color), color.g(htf2_fill_color), color.b(htf2_fill_color)), text_size=size.small)
    table.cell(colorTable, 2, 5, str.tostring(color.t(htf2_fill_color)), text_size=size.small)

    table.cell(colorTable, 0, 6, "HTF2 Label", text_size=size.small)
    table.cell(colorTable, 1, 6, str.format("R:{0} G:{1} B:{2}", color.r(htf2_label_color), color.g(htf2_label_color), color.b(htf2_label_color)), text_size=size.small)
    table.cell(colorTable, 2, 6, str.tostring(color.t(htf2_label_color)), text_size=size.small)

    // HTF3 Colors
    table.cell(colorTable, 0, 7, "HTF3 Line", text_size=size.small)
    table.cell(colorTable, 1, 7, str.format("R:{0} G:{1} B:{2}", color.r(htf3_line_color), color.g(htf3_line_color), color.b(htf3_line_color)), text_size=size.small)
    table.cell(colorTable, 2, 7, str.tostring(color.t(htf3_line_color)), text_size=size.small)

    table.cell(colorTable, 0, 8, "HTF3 Fill", text_size=size.small)
    table.cell(colorTable, 1, 8, str.format("R:{0} G:{1} B:{2}", color.r(htf3_fill_color), color.g(htf3_fill_color), color.b(htf3_fill_color)), text_size=size.small)
    table.cell(colorTable, 2, 8, str.tostring(color.t(htf3_fill_color)), text_size=size.small)

    table.cell(colorTable, 0, 9, "HTF3 Label", text_size=size.small)
    table.cell(colorTable, 1, 9, str.format("R:{0} G:{1} B:{2}", color.r(htf3_label_color), color.g(htf3_label_color), color.b(htf3_label_color)), text_size=size.small)
    table.cell(colorTable, 2, 9, str.tostring(color.t(htf3_label_color)), text_size=size.small)

    // Dashboard Colors
    table.cell(colorTable, 0, 10, "Dash BG", text_size=size.small)
    table.cell(colorTable, 1, 10, str.format("R:{0} G:{1} B:{2}", color.r(table_bg_color), color.g(table_bg_color), color.b(table_bg_color)), text_size=size.small)
    table.cell(colorTable, 2, 10, str.tostring(color.t(table_bg_color)), text_size=size.small)

    table.cell(colorTable, 0, 11, "Dash Border", text_size=size.small)
    table.cell(colorTable, 1, 11, str.format("R:{0} G:{1} B:{2}", color.r(table_border_color), color.g(table_border_color), color.b(table_border_color)), text_size=size.small)
    table.cell(colorTable, 2, 11, str.tostring(color.t(table_border_color)), text_size=size.small)

    table.cell(colorTable, 0, 12, "Dash Text", text_size=size.small)
    table.cell(colorTable, 1, 12, str.format("R:{0} G:{1} B:{2}", color.r(default_text_color), color.g(default_text_color), color.b(default_text_color)), text_size=size.small)
    table.cell(colorTable, 2, 12, str.tostring(color.t(default_text_color)), text_size=size.small)

    // HTF Candle Colors
    table.cell(colorTable, 0, 13, "HTF Bull Body", text_size=size.small)
    table.cell(colorTable, 1, 13, str.format("R:{0} G:{1} B:{2}", color.r(htf_bull_body_color), color.g(htf_bull_body_color), color.b(htf_bull_body_color)), text_size=size.small)
    table.cell(colorTable, 2, 13, str.tostring(color.t(htf_bull_body_color)), text_size=size.small)

    table.cell(colorTable, 0, 14, "HTF Bull Wick", text_size=size.small)
    table.cell(colorTable, 1, 14, str.format("R:{0} G:{1} B:{2}", color.r(htf_bull_wick_color), color.g(htf_bull_wick_color), color.b(htf_bull_wick_color)), text_size=size.small)
    table.cell(colorTable, 2, 14, str.tostring(color.t(htf_bull_wick_color)), text_size=size.small)

    table.cell(colorTable, 0, 15, "HTF Bear Body", text_size=size.small)
    table.cell(colorTable, 1, 15, str.format("R:{0} G:{1} B:{2}", color.r(htf_bear_body_color), color.g(htf_bear_body_color), color.b(htf_bear_body_color)), text_size=size.small)
    table.cell(colorTable, 2, 15, str.tostring(color.t(htf_bear_body_color)), text_size=size.small)

    table.cell(colorTable, 0, 16, "HTF Bear Wick", text_size=size.small)
    table.cell(colorTable, 1, 16, str.format("R:{0} G:{1} B:{2}", color.r(htf_bear_wick_color), color.g(htf_bear_wick_color), color.b(htf_bear_wick_color)), text_size=size.small)
    table.cell(colorTable, 2, 16, str.tostring(color.t(htf_bear_wick_color)), text_size=size.small)

// HTF Algo Draw° [Pro+]