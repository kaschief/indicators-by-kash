// ═══════════════════════════════════════════════════════════════════════════════
// DERIVED VALUES
// ═══════════════════════════════════════════════════════════════════════════════

chart_tf_seconds = timeframe.in_seconds(timeframe.period)
chart_tf_minutes = chart_tf_seconds / 60

// ═══════════════════════════════════════════════════════════════════════════════
// HTF VALIDATION SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

get_limit_zone() =>
    chart_tf_min = chart_tf_minutes
    switch
        chart_tf_min <= 3  => "ultra_short"    // 1-3m → 15m limit
        chart_tf_min == 5  => "short"          // 5m → 1H limit
        chart_tf_min == 10 => "short_med"      // 10m → 2H limit
        chart_tf_min <= 30 => "medium"         // 15-30m → 4H limit
        chart_tf_min <= 60 => "medium_long"    // 45-60m → 1D limit
        chart_tf_min <= 240 => "long"          // 2H-4H → 1D limit
        chart_tf_min <= 1440 => "daily"        // 1D → 1W limit
        chart_tf_min <= 10080 => "weekly"      // 1W → 3M limit
        chart_tf_min >= 43800 => "monthly"     // 1M+ → 3M limit
        => "extended"                          // Quarterly+ → Yearly limit


get_max_allowed_htf() =>
    chart_tf_min = chart_tf_minutes
    switch
        chart_tf_min <= 3  => '15'      // 1-3m max 15m
        chart_tf_min == 5  => '60'      // 5m max 1H
        chart_tf_min == 10 => '120'     // 10m max 2H
        chart_tf_min == 15 => '240'     // 15m max 4H
        chart_tf_min == 30 => '240'     // 30m max 4H
        chart_tf_min <= 60 => '1D'      // 45-60m max 1D
        chart_tf_min <= 240 => '1D'     // 2H-4H max 1D
        chart_tf_min <= 1440 => '1W'    // Daily max Weekly
        chart_tf_min <= 10080 => '3M'   // Weekly max 3M (allows Quarterly!)
        chart_tf_min >= 43800 => '3M'   // Monthly max 3M (consistent)
        => '12M'                        // Quarterly+ max Yearly


get_auto_htf_preferred() =>
    chart_tf_min = chart_tf_minutes
    switch
        chart_tf_min <= 2  => '15'   // 1-2m → 15m preferred
        chart_tf_min <= 5  => '60'   // 3-5m → 1H preferred
        chart_tf_min <= 15 => '60'   // 10-15m → 1H preferred
        chart_tf_min <= 30 => '120'  // 20-30m → 2H preferred
        chart_tf_min <= 60 => '240'  // 45-60m → 4H preferred
        chart_tf_min <= 240 => '1D'  // 2H-4H → 1D preferred
        chart_tf_min <= 1440 => '1W' // Daily → 1W preferred
        chart_tf_min <= 10080 => '1M'// Weekly → 1M preferred
        chart_tf_min >= 43800 => '3M'// Monthly+ → 3M preferred
        => '12M'                     // Quarterly+ → Yearly preferred


validate_and_limit_htf() =>
    if htf1_auto
        limit_tf = get_max_allowed_htf()
        limit_seconds = timeframe.in_seconds(limit_tf)
        auto_tf = get_auto_htf_preferred()
        auto_seconds = timeframe.in_seconds(auto_tf)
        if auto_seconds > chart_tf_seconds and auto_seconds <= limit_seconds
            auto_tf
        else
            limit_tf
    else
        manual_seconds = timeframe.in_seconds(htf1_timeframe)
        if manual_seconds > chart_tf_seconds
            htf1_timeframe
        else
            get_max_allowed_htf()

validated_htf1_timeframe = validate_and_limit_htf()
htf1_is_valid = timeframe.in_seconds(validated_htf1_timeframe) > chart_tf_seconds
htf1_seconds = timeframe.in_seconds(validated_htf1_timeframe)
htf1_extension = 4

