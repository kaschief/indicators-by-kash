// Chart TF thresholds (minutes)
const int CHART_TF_3M = 3
const int CHART_TF_5M = 5
const int CHART_TF_10M = 10
const int CHART_TF_15M = 15
const int CHART_TF_30M = 30
const int CHART_TF_1H = 60
const int CHART_TF_4H = 240
const int CHART_TF_1D = 1440
const int CHART_TF_1W = 10080
const int CHART_TF_1MO = 43800

const string LABEL_SEPARATOR = " • "
const string LABEL_SESSION_SEPARATOR = " | "
const string LABEL_SUFFIX = " algo draw"

color COLOR_TRANSPARENT = color.new(color.white, 100)

// Time-based price level constants
const string NY_TIMEZONE = "America/New_York"
const int MITIGATION_DELAY_MS = 13 * 60 * 60 * 1000
const int TIME_LEVEL_RANK = 0
const string MITIGATION_WINDOW_ANYTIME = "Anytime"
const string MITIGATION_WINDOW_MARKET_HOURS = "Market-Hours"
const string GROUP_TIME_LEVELS = "Time Levels"
const int MAX_STORED_LEVELS = 50

// Session level name constants
const string SESSION_NAME_ASIA_OPEN = "Asia Open"
const string SESSION_NAME_EVENING = "Evening Range"
const string SESSION_NAME_RAFAEL = "Rafael Range"

// Session mitigation time constants (minutes from midnight)
const int PREMARKET_START_MIN = 5 * 60    // 05:00 NY = 300 minutes
const int CLOSE_1600_MIN = 16 * 60        // 16:00 NY = 960 minutes

// Level merge tolerance (0.005% of price - levels within this range are combined)
const float LEVEL_MERGE_PCT = 0.005

// Time-based price level type
type TimePriceLevel
    int target_hour
    int target_minute
    string label_text
    color level_color
    array<float> prices
    array<int> times
    array<bool> mitigated
    array<int> mitigation_times
    float current_price
    int current_time
    bool current_mitigated
    int current_mitigation_time

// Session range level type
type SessionRangeLevel
    int start_hour
    int start_minute
    int end_hour
    int end_minute
    string label_text
    color level_color
    bool delayed_mitigation       // true = only mitigate during 05:00-16:00 NY
    bool crosses_midnight         // true if session end < start (e.g., 21:30-01:29)
    // Current session tracking
    float session_high
    float session_low
    int session_high_time
    int session_low_time
    int session_start_time        // timestamp when session started
    bool in_session
    // Completed session (current unmitigated)
    float current_high
    float current_low
    int current_high_time
    int current_low_time
    int current_session_start     // start time of the completed session (for same-day check)
    bool high_mitigated
    bool low_mitigated
    // Provisional mitigation tracking (overnight breaches before 05:00 confirmation)
    bool provisional_high_mitigated
    bool provisional_low_mitigated
    int provisional_high_time
    int provisional_low_time
    // Historical arrays
    array<float> highs
    array<float> lows
    array<int> high_times
    array<int> low_times
    array<int> session_starts     // start time of each historical session
    array<bool> highs_mitigated
    array<bool> lows_mitigated

// HTF slot type for dynamic mode
type HtfSlot
    string timeframe
    int rank
    bool has_history
    array<float> bsl_targets
    array<bool> bsl_open
    array<int> bsl_detect_times
    array<int> bsl_fill_times
    array<float> ssl_targets
    array<bool> ssl_open
    array<int> ssl_detect_times
    array<int> ssl_fill_times
    array<int> eligible_high_ticks
    array<int> eligible_low_ticks
    array<int> eligible_high_times
    array<int> eligible_low_times

