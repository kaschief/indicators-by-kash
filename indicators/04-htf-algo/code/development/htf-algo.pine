//@version=6
indicator('htf algo • development', overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// HTF ALGO DRAW - HIGHER TIMEFRAME ALGORITHMIC LIQUIDITY DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

// Reference level caps (same as LTF Algo)
const int CAP_ULTRA_SHORT = 80
const int CAP_SHORT = 100
const int CAP_MEDIUM_SHORT = 150
const int CAP_MEDIUM = 200
const int CAP_MEDIUM_LONG = 300
const int CAP_LONG = 400
const int CAP_DEFAULT = 200

// Magic numbers
const int OPEN_LINES_CAP = 10
const int FILLED_LINES_CAP = 10

// Line display constants
const int LINE_LOOKBACK_BARS = 15
const int LINE_EXTENSION_BARS = 15

// Style options
const string STYLE_SOLID = 'Solid'
const string STYLE_DASHED = 'Dashed'
const string STYLE_DOTTED = 'Dotted'

// Mode options
const string MODE_MANUAL = "Manual"
const string MODE_DYNAMIC = "Dynamic"

// Group constants for input organization
const string GROUP_MODE = "Mode"
const string GROUP_HTF = "Manual • HTF"
const string GROUP_DYN_MACRO = "Dynamic • Macro"
const string GROUP_DYN_SWING = "Dynamic • Swing"
const string GROUP_DYN_INTRADAY = "Dynamic • Intraday"
const string GROUP_DYN_FILTER = "Dynamic • Filter"
const string GROUP_DYN_STYLE = "Dynamic • Style"
const string GROUP_LINE_STYLES = "Line Styles"
const string GROUP_DEV = "Development"

// Size options
const string SIZE_TINY = 'Tiny'
const string SIZE_SMALL = 'Small'
const string SIZE_NORMAL = 'Normal'
const string SIZE_LARGE = 'Large'


// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

// Mode Selection
htf_mode = input.string(MODE_MANUAL, "Mode", options=[MODE_MANUAL, MODE_DYNAMIC], group=GROUP_MODE, tooltip="Manual: Pick specific HTFs to display\nDynamic: Auto-find highest HTF with levels in today's ADR range")

// HTF 1 (Manual Mode)
htf1_enabled = input.bool(true, 'Enable', group=GROUP_HTF, inline='1')
htf1_auto = input.bool(true, 'Auto TF', group=GROUP_HTF, inline='1')
htf1_timeframe = input.timeframe('60', 'Manual TF', group=GROUP_HTF, inline='2')
htf1_open_lines = input.int(2, 'Open', minval=1, maxval=20, group=GROUP_HTF, inline='3')
htf1_open_width = input.int(1, 'Width', minval=1, maxval=5, group=GROUP_HTF, inline='3')
htf1_filled_lines = input.int(1, 'Filled', minval=0, maxval=20, group=GROUP_HTF, inline='4')
htf1_filled_width = input.int(1, 'Width', minval=1, maxval=5, group=GROUP_HTF, inline='4')
htf1_line_color = input.color(color.rgb(233, 30, 99), 'Line', group=GROUP_HTF, inline='5')
htf1_bsl_label_color = input.color(color.rgb(242, 54, 69), 'BSL', group=GROUP_HTF, inline='5')
htf1_ssl_label_color = input.color(color.rgb(49, 121, 245), 'SSL', group=GROUP_HTF, inline='5')

// Dynamic • Macro (Monthly, Weekly)
dyn_htf1_enabled = input.bool(true, 'M', group=GROUP_DYN_MACRO, inline='tf')
dyn_htf2_enabled = input.bool(true, 'W', group=GROUP_DYN_MACRO, inline='tf')
dyn_width_tier1 = input.int(4, 'Width', minval=1, maxval=5, group=GROUP_DYN_MACRO, inline='style')
dyn_size_tier1 = input.string(SIZE_NORMAL, 'Size', options=[SIZE_TINY, SIZE_SMALL, SIZE_NORMAL, SIZE_LARGE], group=GROUP_DYN_MACRO, inline='style')

// Dynamic • Swing (Daily, 12H)
dyn_htf3_enabled = input.bool(true, 'D', group=GROUP_DYN_SWING, inline='tf')
dyn_htf4_enabled = input.bool(true, '12H', group=GROUP_DYN_SWING, inline='tf')
dyn_width_tier2 = input.int(3, 'Width', minval=1, maxval=5, group=GROUP_DYN_SWING, inline='style')
dyn_size_tier2 = input.string(SIZE_SMALL, 'Size', options=[SIZE_TINY, SIZE_SMALL, SIZE_NORMAL, SIZE_LARGE], group=GROUP_DYN_SWING, inline='style')

// Dynamic • Intraday (8H, 7H, 4H, 1H)
dyn_htf5_enabled = input.bool(false, '8H', group=GROUP_DYN_INTRADAY, inline='tf')
dyn_htf6_enabled = input.bool(false, '7H', group=GROUP_DYN_INTRADAY, inline='tf')
dyn_htf7_enabled = input.bool(true, '4H', group=GROUP_DYN_INTRADAY, inline='tf2')
dyn_htf8_enabled = input.bool(true, '1H', group=GROUP_DYN_INTRADAY, inline='tf2')
dyn_width_tier3 = input.int(2, 'Width', minval=1, maxval=5, group=GROUP_DYN_INTRADAY, inline='style')
dyn_size_tier3 = input.string(SIZE_TINY, 'Size', options=[SIZE_TINY, SIZE_SMALL, SIZE_NORMAL, SIZE_LARGE], group=GROUP_DYN_INTRADAY, inline='style')

// Fixed timeframes (not user-configurable)
dyn_htf1 = '1M'
dyn_htf2 = '1W'
dyn_htf3 = '1D'
dyn_htf4 = '720'
dyn_htf5 = '480'
dyn_htf6 = '420'
dyn_htf7 = '240'
dyn_htf8 = '60'

// Dynamic • Filter (ADR relevance)
adr_lookback = input.int(5, 'ADR', minval=1, maxval=20, group=GROUP_DYN_FILTER, inline='adr', tooltip='Number of days for ADR calculation')
adr_multiplier = input.float(1.0, '×', minval=0.4, maxval=2.0, step=0.1, group=GROUP_DYN_FILTER, inline='adr', tooltip='1.0 = exact ADR, 1.5 = extended range')

// Dynamic • Style
dyn_line_color = input.color(color.rgb(233, 30, 99), 'Line', group=GROUP_DYN_STYLE, inline='colors')
dyn_bsl_label_color = input.color(color.rgb(242, 54, 69), 'BSL', group=GROUP_DYN_STYLE, inline='colors')
dyn_ssl_label_color = input.color(color.rgb(49, 121, 245), 'SSL', group=GROUP_DYN_STYLE, inline='colors')

// Line Styles
open_style = input.string(STYLE_SOLID, 'Open', options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], group=GROUP_LINE_STYLES, inline='1')
filled_style = input.string(STYLE_DASHED, 'Filled', options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], group=GROUP_LINE_STYLES, inline='1')
filled_opacity = input.int(20, 'Opacity', minval=0, maxval=95, group=GROUP_LINE_STYLES, inline='1')

// Development
show_htf_candles = input.bool(false, "HTF Candles", group=GROUP_DEV, inline='1', tooltip="Debug overlay showing HTF candles")
