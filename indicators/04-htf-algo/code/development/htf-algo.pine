// DYNAMIC MODE - DATA STRUCTURES
// ═══════════════════════════════════════════════════════════════════════════════

new_htf_slot(string tf, int rank) =>
    HtfSlot.new(tf, rank, false,
        array.new<float>(), array.new<bool>(), array.new<int>(), array.new<int>(),
        array.new<float>(), array.new<bool>(), array.new<int>(), array.new<int>(),
        array.new<int>(), array.new<int>(), array.new<int>(), array.new<int>())

var HtfSlot slot1 = new_htf_slot(dyn_htf1, 1)
var HtfSlot slot2 = new_htf_slot(dyn_htf2, 2)
var HtfSlot slot3 = new_htf_slot(dyn_htf3, 3)
