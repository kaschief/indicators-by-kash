    HtfSlot.new(tf, rank, false,
        array.new<float>(), array.new<bool>(), array.new<int>(), array.new<int>(),
        array.new<float>(), array.new<bool>(), array.new<int>(), array.new<int>(),
        array.new<int>(), array.new<int>(), array.new<int>(), array.new<int>())

