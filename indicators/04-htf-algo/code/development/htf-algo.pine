// ═══════════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

to_tick(price) => math.round(price / syminfo.mintick)
from_tick(tick) => tick * syminfo.mintick

// Cross-HTF deduplication: check if a higher TF has an open level at same tick
htf3_has_open_bsl_at_tick(int tick) =>
    result = false
    if htf3_is_valid and array.size(htf3_buyside_targets) > 0
        for i = 0 to array.size(htf3_buyside_targets) - 1
            if array.get(htf3_buyside_open, i) and to_tick(array.get(htf3_buyside_targets, i)) == tick
                result := true
                break
    result

htf3_has_open_ssl_at_tick(int tick) =>
    result = false
    if htf3_is_valid and array.size(htf3_sellside_targets) > 0
        for i = 0 to array.size(htf3_sellside_targets) - 1
            if array.get(htf3_sellside_open, i) and to_tick(array.get(htf3_sellside_targets, i)) == tick
                result := true
                break
    result

htf2_has_open_bsl_at_tick(int tick) =>
    result = false
    if htf2_is_valid and array.size(htf2_buyside_targets) > 0
        for i = 0 to array.size(htf2_buyside_targets) - 1
            if array.get(htf2_buyside_open, i) and to_tick(array.get(htf2_buyside_targets, i)) == tick
                result := true
                break
    result

htf2_has_open_ssl_at_tick(int tick) =>
    result = false
    if htf2_is_valid and array.size(htf2_sellside_targets) > 0
        for i = 0 to array.size(htf2_sellside_targets) - 1
            if array.get(htf2_sellside_open, i) and to_tick(array.get(htf2_sellside_targets, i)) == tick
                result := true
                break
    result

// HTF1 deduplication: skip if any higher TF has open level at same tick
higher_tf_has_open_bsl_at_tick(int tick) =>
    bool htf2_higher = htf2_is_valid and htf2_seconds > htf1_seconds
    bool htf3_higher = htf3_is_valid and htf3_seconds > htf1_seconds
    (htf2_higher and htf2_has_open_bsl_at_tick(tick)) or (htf3_higher and htf3_has_open_bsl_at_tick(tick))

higher_tf_has_open_ssl_at_tick(int tick) =>
    bool htf2_higher = htf2_is_valid and htf2_seconds > htf1_seconds
    bool htf3_higher = htf3_is_valid and htf3_seconds > htf1_seconds
    (htf2_higher and htf2_has_open_ssl_at_tick(tick)) or (htf3_higher and htf3_has_open_ssl_at_tick(tick))

// Dynamic reference level cap based on HTF timeframe (matches LTF Algo behavior)
get_reference_levels_cap() =>
    htf_min = timeframe.in_seconds(validated_htf1_timeframe) / 60
    if htf_min <= 2
        CAP_ULTRA_SHORT
    else if htf_min <= 5
        CAP_SHORT
    else if htf_min <= 30
        CAP_MEDIUM_SHORT
    else if htf_min <= 90
        CAP_MEDIUM
    else if htf_min <= 240
        CAP_MEDIUM_LONG
    else if htf_min <= 10080  // Up to weekly
        CAP_LONG
    else
        CAP_DEFAULT

get_line_style(style_string) =>
    switch style_string
        STYLE_DASHED => line.style_dashed
        STYLE_DOTTED => line.style_dotted
        => line.style_solid

get_label_text_size() => size.small

get_table_text_size() => size.tiny

bg_none() => color.new(color.white, 100)

// Parameterized HTF tag generator - works for any timeframe
get_htf_tag_for_tf(simple string tf) =>
    local_htf_seconds = timeframe.in_seconds(tf)
    local_htf_minutes = local_htf_seconds / 60

    if local_htf_minutes < 1440  // Less than 1 day (intraday)
        if local_htf_minutes % 60 == 0
            str.tostring(int(local_htf_minutes / 60)) + "H"  // Hours: 1H, 4H, etc.
        else
            str.tostring(int(local_htf_minutes)) + "m"       // Minutes: 15m, 30m, etc.
    else if local_htf_minutes == 1440
        "1D"  // Daily
    else if local_htf_minutes == 10080
        "1W"  // Weekly
    else if tf == '1M'
        "1M"  // Monthly
    else if tf == '3M'
        "3M"  // Quarterly
    else if tf == '6M'
        "6M"  // Semiannual
    else if tf == '12M'
        "12M" // Yearly
    else
        tf  // Fallback

get_htf_tag() => get_htf_tag_for_tf(validated_htf1_timeframe)

get_htf_tag_text() => get_htf_tag() + ALGO_DRAW_SUFFIX

get_timeframe_text_with_suffix(is_bsl) =>
    base_text = get_htf_tag_text()
    suffix_text = is_bsl ? SUFFIX_BSL : SUFFIX_SSL
    suffix_text + " " + base_text

// Parameterized label text for any HTF
get_label_text(simple string htf_tag, bool is_bsl) =>
    suffix_text = is_bsl ? SUFFIX_BSL : SUFFIX_SSL
    suffix_text + " " + htf_tag + ALGO_DRAW_SUFFIX

create_end_label(end_time, target_price, label_text_color, is_bsl, tooltip_text) =>
    lab = label.new(
         x=end_time,
         y=target_price,
         text=get_timeframe_text_with_suffix(is_bsl),
         style=label.style_label_left,
         textcolor=label_text_color,
         size=get_label_text_size(),
         xloc=xloc.bar_time,
         tooltip=tooltip_text
     )
    label.set_color(lab, bg_none())
    lab

format_tooltip(is_bsl, wick_timestamp) =>
    type_text = is_bsl ? "BSL: Wick took LOW" : "SSL: Wick took HIGH"
    formatted_time = str.format_time(wick_timestamp, "MMM dd, yyyy HH:mm", syminfo.timezone)
    type_text + " • " + formatted_time + ", " + get_htf_tag()

// Convert timeframe to user-friendly display
get_user_friendly_timeframe(tf) =>
    switch tf
        '15' => '15m'
        '30' => '30m'
        '60' => '1H'
        '120' => '2H'
        '240' => '4H'
        '1D' => '1D'
        '1W' => '1W'
        '1M' => '1M'
        '3M' => '3M'
        '6M' => '6M'
        '12M' => '12M'
        => tf



// Dashboard positioning helpers
get_table_position() =>
    switch table_position
        POS_TOP_LEFT => position.top_left
        POS_TOP_CENTER => position.top_center
        POS_TOP_RIGHT => position.top_right
        POS_MIDDLE_LEFT => position.middle_left
        POS_MIDDLE_CENTER => position.middle_center
        POS_MIDDLE_RIGHT => position.middle_right
        POS_BOTTOM_LEFT => position.bottom_left
        POS_BOTTOM_CENTER => position.bottom_center
        POS_BOTTOM_RIGHT => position.bottom_right
        => position.top_right

// Get current chart timeframe display
get_chart_tf_display() =>
    if timeframe.isintraday
        m = timeframe.multiplier
        m % 60 == 0 ? str.tostring(m / 60) + "H" : str.tostring(m) + "m"
    else if timeframe.isdaily
        str.tostring(timeframe.multiplier) + "D"
    else if timeframe.isweekly
        str.tostring(timeframe.multiplier) + "W"
    else if timeframe.ismonthly
        str.tostring(timeframe.multiplier) + "M"
    else
        timeframe.period

// Get allowed HTF preset list with cap - CLEAN FORMAT
get_allowed_htf_presets() =>
    chart_tf_min = get_chart_tf_minutes_cached()
    preset_list = array.new<string>()
    cap_display = ""

    if chart_tf_min <= 3  // 1-3m chart → cap: 15m
        array.push(preset_list, "15m")
        cap_display := "15m"
    else if chart_tf_min == 5  // 5m → cap: 1H
        array.push(preset_list, "15m")
        array.push(preset_list, "30m")
        array.push(preset_list, "1H")
        cap_display := "1H"
    else if chart_tf_min == 10  // 10m → cap: 2H
        array.push(preset_list, "15m")
        array.push(preset_list, "30m")
        array.push(preset_list, "1H")
        array.push(preset_list, "2H")
        cap_display := "2H"
    else if chart_tf_min == 15  // 15m → cap: 4H
        array.push(preset_list, "30m")
        array.push(preset_list, "1H")
        array.push(preset_list, "2H")
        array.push(preset_list, "4H")
        cap_display := "4H"
    else if chart_tf_min == 30  // 30m → cap: 4H
        array.push(preset_list, "1H")
        array.push(preset_list, "2H")
        array.push(preset_list, "4H")
        cap_display := "4H"
    else if chart_tf_min <= 60  // 45-60m → cap: 1D
        array.push(preset_list, "2H")
        array.push(preset_list, "4H")
        array.push(preset_list, "1D")
        cap_display := "1D"
    else if chart_tf_min <= 240  // 2H-4H-6H-7H etc → cap: 1D
        array.push(preset_list, "1D")
        cap_display := "1D"
    else if chart_tf_min <= 1440  // Daily → cap: 1W
        array.push(preset_list, "1W")
        cap_display := "1W"
    else if chart_tf_min <= 10080  // Weekly → cap: 3M
        array.push(preset_list, "1M")
        array.push(preset_list, "3M")
        cap_display := "3M"
    else if chart_tf_min >= 43800  // Monthly+ → cap: 3M
        array.push(preset_list, "3M")
        cap_display := "3M"

    // Convert array to comma-separated string with cap
    if array.size(preset_list) == 0
        "None"
    else
        preset_result = ""
        for i = 0 to array.size(preset_list) - 1
            if i > 0
                preset_result := preset_result + ", "
            preset_result := preset_result + array.get(preset_list, i)

        // Format: "Presets: 15m, 30m, 1H • Any up to 1H"
        "Presets: " + preset_result + " • Any up to " + cap_display

add_htf1_eligible_high(price, timestamp) =>
    tick = to_tick(price)
    if array.indexof(htf1_eligible_high_ticks, tick) == -1
        array.push(htf1_eligible_high_ticks, tick)
        array.push(htf1_eligible_high_times, timestamp)
        while array.size(htf1_eligible_high_ticks) > get_reference_levels_cap()
            array.shift(htf1_eligible_high_ticks)
            array.shift(htf1_eligible_high_times)

add_htf1_eligible_low(price, timestamp) =>
    tick = to_tick(price)
    if array.indexof(htf1_eligible_low_ticks, tick) == -1
        array.push(htf1_eligible_low_ticks, tick)
        array.push(htf1_eligible_low_times, timestamp)
        while array.size(htf1_eligible_low_ticks) > get_reference_levels_cap()
            array.shift(htf1_eligible_low_ticks)
            array.shift(htf1_eligible_low_times)

