// Buffered so clustering can order identities and style the active carrier line.
type PendingLabel
    float price
    int xPos
    int recencyTime
    string touchKey
    string namePart
    string pricePart
    bool wantPrice
    bool hitTrace
    color textColor
    color bgColor
    string sizeName
    int rank
    int effectiveLineWidth
    line activeLine
    color activeLineColor

// Buffered so coincident swept reminders match merged right-edge identities.
type PendingReminder
