    int effectiveLineWidth

// Shared newest-first allocator metadata for level lines and histograms.
type RenderBudgetAnchor
    array<Profile> profiles
    SessionStyle style
    bool levelsEnabled
    bool histogramEnabled
    array<bool> focusSelections
    bool restrictToFocus
    bool surfaceSweptLevels

// One completed profile competing for a Focus slot.
type FocusCandidate
    float distance
    int profileIndex
    int endTime

type FocusHitLevel
    Profile profile
    float price
    int breachTime
    int nextProfileFinalizedTime
    bool sweptLevel
    bool surfaceSweptLevels
    int sweptKeepMs
    bool olderSweptEligible
    bool limitDailyRetouches
    string levelName
    string sourceProfileKey
    string key

// Declared before the calculation functions so the developing-profile builder can read the
// pending bucket that confirmed fallback bars accumulate into.
chartBarMs = timeframe.in_seconds(timeframe.period) * 1000
// Range and other non-time bars are not five-minute-alignable, so parity bucketing is time-charts only.
fallbackBucketAggregationActive = chart.is_standard and chartBarMs < FALLBACK_PARITY_BUCKET_MS and FALLBACK_PARITY_BUCKET_MS % chartBarMs == 0
var float fallbackBucketHigh = na
var float fallbackBucketLow = na
var float fallbackBucketVolume = na
var int fallbackBucketId = -1

// Touch contact set for the current bar: price ranges that actually traded, one per eligible
// lower-timeframe sub-bar (or the chart bar as fallback). Realtime entries follow the price path
// between consecutive updates, so interior revisits remain detectable on larger chart bars.
var array<float> levelHitContactHighs = array.new<float>()
var array<float> levelHitContactLows = array.new<float>()
var array<int> levelHitContactTimes = array.new<int>()
varip float livePreviousClose = na
varip int liveCoveredBarTime = na

// ═══════════════════════════════════════════════════════════════════════════════
// FUNCTIONS — calculation (parameterized, reused for every anchor)
// ═══════════════════════════════════════════════════════════════════════════════

autoIntrabarTimeframe() =>
    chartSeconds = timeframe.in_seconds(timeframe.period)
    chartSeconds < 60 ? "1S" : chartSeconds <= 15 * 60 ? "1" : chartSeconds <= 60 * 60 ? "5" : chartSeconds <= 4 * 60 * 60 ? "15" : "60"

newAnchorState() =>
    AnchorState.new(array.new<float>(), array.new<float>(), array.new<float>(), array.new<Profile>(), START_TIME_UNSET, START_TIME_UNSET)

newMergeState() =>
    MergeState.new(array.new<float>(), array.new<float>(), array.new<float>(), START_TIME_UNSET, 0, 0)

mergeCombine(string mode) =>
    mode == MERGE_COMBINE

mergeAll(string mode) =>
    mode == MERGE_ALL

mergeDepth(string mode) =>
    mode == MERGE_EARLIEST ? 1 : mode == MERGE_COMBINE ? 2 : 0

newAnchorProcessPolicy(int keepProfiles, int mergeDepth, bool mergeAllShorts, bool combineShorts, float shortSpanFraction, bool continuousBoundary, bool prepareHistogram, bool requireObservedBoundary) =>
    AnchorProcessPolicy.new(keepProfiles, mergeDepth, mergeAllShorts, combineShorts, shortSpanFraction, continuousBoundary, prepareHistogram, requireObservedBoundary)

newMergedAnchorProcessPolicy(int keepProfiles, string mergeMode, float shortSpanFraction, bool continuousBoundary, bool prepareHistogram) =>
    newAnchorProcessPolicy(keepProfiles, mergeDepth(mergeMode), mergeAll(mergeMode), mergeCombine(mergeMode), shortSpanFraction, continuousBoundary, prepareHistogram, false)

newCalendarAnchorProcessPolicy(int keepProfiles, bool prepareHistogram, bool requireObservedBoundary) =>
    newAnchorProcessPolicy(keepProfiles, 0, false, false, 1.0, true, prepareHistogram, requireObservedBoundary)

newMaturityState() =>
    MaturityState.new(na, na, na, false, 0, array.new<float>())

newProfile(int startTime, int endTime, int rowCount) =>
    Profile.new(startTime, endTime, na, na, na, rowCount, array.new<float>(rowCount, 0.0), 0.0, 0, 0, 0, na, na, na, na, na, na, false, na, na, na, na, na, na, false, false, false, false, false, false, false, false, false, false, false, false, false)

newRemoteProfile(int startTime, int endTime, float priceLow, float priceHigh, float pocPrice, float valueAreaHighPrice, float valueAreaLowPrice, bool hasAlternatePoc, float alternatePocPrice) =>
    Profile profile = newProfile(startTime, endTime, PROFILE_ROWS)
    profile.priceLow := priceLow
    profile.priceHigh := priceHigh
    profile.pocPrice := pocPrice
    profile.valueAreaHighPrice := valueAreaHighPrice
    profile.valueAreaLowPrice := valueAreaLowPrice
    profile.hasAlternatePoc := hasAlternatePoc
    profile.alternatePocPrice := alternatePocPrice
    profile.isValid := true
    profile

clampRow(float rawRow, int rowCount) =>
    math.max(0, math.min(rowCount - 1, int(math.floor(rawRow))))

toLabelSize(string sizeName) =>
    sizeName == LABEL_SIZE_TINY ? size.tiny : sizeName == LABEL_SIZE_NORMAL ? size.normal : sizeName == LABEL_SIZE_LARGE ? size.large : sizeName == LABEL_SIZE_HUGE ? size.huge : size.small

// Ordered tiny→huge so a merged cluster can keep its largest member's size.
labelSizeRank(string sizeName) =>
    sizeName == LABEL_SIZE_TINY ? 0 : sizeName == LABEL_SIZE_SMALL ? 1 : sizeName == LABEL_SIZE_NORMAL ? 2 : sizeName == LABEL_SIZE_LARGE ? 3 : 4

largerLabelSize(string a, string b) =>
    labelSizeRank(a) >= labelSizeRank(b) ? a : b

levelHitCircleSizeForAnchor(string anchorName) =>
    if anchorName == LABEL_RTH_ANCHOR or anchorName == LABEL_GLOBEX_ANCHOR
        LABEL_SIZE_NORMAL
    else if anchorName == LABEL_WEEKLY_ANCHOR
        LABEL_SIZE_LARGE
    else
        LABEL_SIZE_HUGE

monthName(int monthNumber) =>
    switch monthNumber
        1 => "Jan"
        2 => "Feb"
        3 => "Mar"
        4 => "Apr"
        5 => "May"
        6 => "Jun"
        7 => "Jul"
        8 => "Aug"
        9 => "Sep"
        10 => "Oct"
        11 => "Nov"
        => "Dec"

periodDateText(int startTime, string labelMode, bool useUtcTimezone) =>
    int startMonth = useUtcTimezone ? month(startTime, UTC_TIMEZONE) : month(startTime, NY_TIMEZONE)
    int startYear = useUtcTimezone ? year(startTime, UTC_TIMEZONE) : year(startTime, NY_TIMEZONE)
    if labelMode == PERIOD_LABEL_QUARTER
        int quarterNumber = int(math.floor((startMonth - 1) / 3)) + 1
        "Q" + str.tostring(quarterNumber) + " " + str.tostring(startYear)
    else if labelMode == PERIOD_LABEL_MONTH
        monthName(startMonth) + " " + str.tostring(startYear)
    else
        int startDay = useUtcTimezone ? dayofmonth(startTime, UTC_TIMEZONE) : dayofmonth(startTime, NY_TIMEZONE)
        monthName(startMonth) + " " + str.tostring(startDay)

calendarDateText(int eventTime, bool useUtcTimezone) =>
    int eventMonth = useUtcTimezone ? month(eventTime, UTC_TIMEZONE) : month(eventTime, NY_TIMEZONE)
    int eventDay = useUtcTimezone ? dayofmonth(eventTime, UTC_TIMEZONE) : dayofmonth(eventTime, NY_TIMEZONE)
    int eventYear = useUtcTimezone ? year(eventTime, UTC_TIMEZONE) : year(eventTime, NY_TIMEZONE)
    monthName(eventMonth) + " " + str.tostring(eventDay) + ", " + str.tostring(eventYear)

sameCalendarDate(int firstTime, int secondTime, string timezone) =>
    year(firstTime, timezone) == year(secondTime, timezone) and month(firstTime, timezone) == month(secondTime, timezone) and dayofmonth(firstTime, timezone) == dayofmonth(secondTime, timezone)

toLineStyle(string styleName) =>
    styleName == STYLE_DASHED ? line.style_dashed : styleName == STYLE_DOTTED ? line.style_dotted : line.style_solid

isTrueWeekendBar(int barTime) =>
    int barDay = dayofweek(barTime, NY_TIMEZONE)
    int barHour = hour(barTime, NY_TIMEZONE)
    barDay == dayofweek.saturday or (barDay == dayofweek.sunday and barHour < SUNDAY_REOPEN_START_HOUR)

calendarDayStart(string timezone) =>
    ta.change(dayofmonth(time, timezone)) != 0

shiftedCalendarDayStart(string timezone, int timeShiftMilliseconds) =>
    ta.change(dayofmonth(time + timeShiftMilliseconds, timezone)) != 0

calendarWeekStart(string timezone) =>
    ta.change(weekofyear(time, timezone)) != 0

calendarMonthStart(string timezone) =>
    ta.change(month(time, timezone)) != 0

// Quarters are the calendar standard: Jan–Mar, Apr–Jun, Jul–Sep, Oct–Dec.
calendarQuarterStart(string timezone) =>
    ta.change(month(time, timezone)) != 0 and (month(time, timezone) - 1) % 3 == 0

selectAssetCalendarStart(bool useUtcCalendar, bool utcStart, bool marketStart) =>
    useUtcCalendar ? utcStart : marketStart

isBeforeNyCutoff(int cutoffHour, int cutoffMinute) =>
    int currentMinutes = hour(time, NY_TIMEZONE) * 60 + minute(time, NY_TIMEZONE)
    int cutoffMinutes = cutoffHour * 60 + cutoffMinute
    currentMinutes < cutoffMinutes

// Compact raw samples in place without changing the final profile's histogram resolution.
compactSamples(array<float> highs, array<float> lows, array<float> volumes) =>
    int sampleCount = array.size(volumes)
    if sampleCount > 0
        float rawHigh = array.max(highs)
        float rawLow = array.min(lows)
        float priceSpan = math.max(rawHigh - rawLow, syminfo.mintick * SAMPLE_COMPACT_ROWS)
        float compactLow = rawHigh == rawLow ? rawLow - priceSpan * 0.5 : rawLow
        float rowHeight = priceSpan / SAMPLE_COMPACT_ROWS
        array<float> rowVolumes = array.new<float>(SAMPLE_COMPACT_ROWS, 0.0)
        for sampleIndex = 0 to sampleCount - 1
            float sampleHigh = array.get(highs, sampleIndex)
            float sampleLow = array.get(lows, sampleIndex)
            float sampleVolume = array.get(volumes, sampleIndex)
            int firstRow = clampRow((sampleLow - compactLow) / rowHeight, SAMPLE_COMPACT_ROWS)
            int lastRow = clampRow((sampleHigh - compactLow) / rowHeight, SAMPLE_COMPACT_ROWS)
            int rowsTouched = math.max(1, lastRow - firstRow + 1)
            float volumePerRow = sampleVolume / rowsTouched
            for rowIndex = firstRow to lastRow
                array.set(rowVolumes, rowIndex, array.get(rowVolumes, rowIndex) + volumePerRow)
        array.clear(highs)
        array.clear(lows)
        array.clear(volumes)
        for rowIndex = 0 to SAMPLE_COMPACT_ROWS - 1
            float rowVolume = array.get(rowVolumes, rowIndex)
            if rowVolume > 0
                float rowPrice = compactLow + (rowIndex + 0.5) * rowHeight
                array.push(highs, rowPrice)
                array.push(lows, rowPrice)
                array.push(volumes, rowVolume)

compactIfNeeded(array<float> highs, array<float> lows, array<float> volumes) =>
    if array.size(volumes) > SAMPLE_COMPACT_THRESHOLD
        compactSamples(highs, lows, volumes)

prepareBarVolumeSamples(array<float> intrabarHighs, array<float> intrabarLows, array<float> intrabarVolumes, float chartHigh, float chartLow, float chartVolume, bool enabled) =>
    array<float> preparedHighs = array.new<float>()
    array<float> preparedLows = array.new<float>()
    array<float> preparedVolumes = array.new<float>()
    if enabled
        int intrabarCount = array.size(intrabarVolumes)
        if intrabarCount > 0
            for intrabarIndex = 0 to intrabarCount - 1
                float subVolume = array.get(intrabarVolumes, intrabarIndex)
                float subHigh = array.get(intrabarHighs, intrabarIndex)
                float subLow = array.get(intrabarLows, intrabarIndex)
                if not na(subVolume) and subVolume > 0 and not na(subHigh) and not na(subLow)
                    array.push(preparedHighs, subHigh)
                    array.push(preparedLows, subLow)
                    array.push(preparedVolumes, subVolume)
        if array.size(preparedVolumes) == 0 and not na(chartVolume) and chartVolume > 0 and not na(chartHigh) and not na(chartLow)
            array.push(preparedHighs, chartHigh)
            array.push(preparedLows, chartLow)
            array.push(preparedVolumes, chartVolume)
    [preparedHighs, preparedLows, preparedVolumes]

appendPreparedBarVolume(array<float> highs, array<float> lows, array<float> volumes, array<float> preparedHighs, array<float> preparedLows, array<float> preparedVolumes, bool compactAfter) =>
    if array.size(preparedVolumes) > 0
        array.concat(highs, preparedHighs)
        array.concat(lows, preparedLows)
        array.concat(volumes, preparedVolumes)
        if compactAfter
            compactIfNeeded(highs, lows, volumes)
    true

// Lower-tf sub-bars when available (HD); falls back to the chart bar so every session still builds.
appendBarVolume(array<float> highs, array<float> lows, array<float> volumes, array<float> intrabarHighs, array<float> intrabarLows, array<float> intrabarVolumes, float chartHigh, float chartLow, float chartVolume, bool compactAfter) =>
    [preparedHighs, preparedLows, preparedVolumes] = prepareBarVolumeSamples(intrabarHighs, intrabarLows, intrabarVolumes, chartHigh, chartLow, chartVolume, true)
    appendPreparedBarVolume(highs, lows, volumes, preparedHighs, preparedLows, preparedVolumes, compactAfter)

prepareProfileHistogram(Profile profile) =>
    int rowCount = profile.rowCount
    int halfWindow = HISTOGRAM_SMOOTHING / 2
    array<float> smoothedVolumes = array.new<float>(rowCount, 0.0)
    float maxSmoothedVolume = 0.0
    float windowSum = 0.0
    int windowCount = 0
    for seedRow = 0 to math.min(halfWindow, rowCount - 1)
        windowSum += array.get(profile.rowVolumes, seedRow)
        windowCount += 1
    for rowIndex = 0 to rowCount - 1
        if rowIndex > 0
            int enteringRow = rowIndex + halfWindow
            if enteringRow < rowCount
                windowSum += array.get(profile.rowVolumes, enteringRow)
                windowCount += 1
            int leavingRow = rowIndex - halfWindow - 1
            if leavingRow >= 0
                windowSum -= array.get(profile.rowVolumes, leavingRow)
                windowCount -= 1
        float smoothedVolume = windowSum / windowCount
        array.set(smoothedVolumes, rowIndex, smoothedVolume)
        maxSmoothedVolume := math.max(maxSmoothedVolume, smoothedVolume)
    profile.rowVolumes := smoothedVolumes
    profile.maxHistogramVolume := maxSmoothedVolume
    true

buildProfile(array<float> highs, array<float> lows, array<float> volumes, int rowCount, float valueAreaPercent, int startTime, int endTime, bool prepareHistogram) =>
    Profile profile = newProfile(startTime, endTime, rowCount)
    int barCount = array.size(volumes)
    if barCount > 0
        float rawHigh = array.max(highs)
        float rawLow = array.min(lows)
        float priceSpan = math.max(rawHigh - rawLow, syminfo.mintick * rowCount)
        float profileLow = rawHigh == rawLow ? rawLow - priceSpan * 0.5 : rawLow
        float rowHeight = priceSpan / rowCount

        for barIndex = 0 to barCount - 1
            float barHigh = array.get(highs, barIndex)
            float barLow = array.get(lows, barIndex)
            float barVolume = array.get(volumes, barIndex)
            int firstRow = clampRow((barLow - profileLow) / rowHeight, rowCount)
            int lastRow = clampRow((barHigh - profileLow) / rowHeight, rowCount)
            int rowsTouched = math.max(1, lastRow - firstRow + 1)
            float volumePerRow = barVolume / rowsTouched
            for rowIndex = firstRow to lastRow
                array.set(profile.rowVolumes, rowIndex, array.get(profile.rowVolumes, rowIndex) + volumePerRow)

        float totalVolume = 0.0
        float maxRowVolume = 0.0
        int pocRow = 0
        for rowIndex = 0 to rowCount - 1
            float rowVolume = array.get(profile.rowVolumes, rowIndex)
            totalVolume += rowVolume
            if rowVolume > maxRowVolume
                maxRowVolume := rowVolume
                pocRow := rowIndex

        int valueAreaLowRow = pocRow
        int valueAreaHighRow = pocRow
        float accumulatedVolume = array.get(profile.rowVolumes, pocRow)
        float targetVolume = totalVolume * valueAreaPercent * 0.01
        while accumulatedVolume < targetVolume and (valueAreaLowRow > 0 or valueAreaHighRow < rowCount - 1)
            float volumeBelow = valueAreaLowRow > 0 ? array.get(profile.rowVolumes, valueAreaLowRow - 1) : -1.0
            float volumeAbove = valueAreaHighRow < rowCount - 1 ? array.get(profile.rowVolumes, valueAreaHighRow + 1) : -1.0
            if volumeAbove >= volumeBelow
                valueAreaHighRow += 1
                accumulatedVolume += math.max(volumeAbove, 0)
            else
                valueAreaLowRow -= 1
                accumulatedVolume += math.max(volumeBelow, 0)

        // aPOC is the heaviest qualifying node outside the POC shoulder; distance is ignored.
        int pocShoulder = math.max(1, int(math.round(rowCount * ALTERNATE_POC_WINDOW_FRAC)))
        int alternateRow = -1
        float alternateVolume = 0.0
        for rowIndex = 0 to rowCount - 1
            if math.abs(rowIndex - pocRow) > pocShoulder
                float rowVolume = array.get(profile.rowVolumes, rowIndex)
                if rowVolume > alternateVolume
                    alternateVolume := rowVolume
                    alternateRow := rowIndex
        bool hasAlternatePoc = false
        float alternatePocPrice = na
        if alternateRow >= 0 and maxRowVolume > 0 and alternateVolume / maxRowVolume >= ALTERNATE_POC_MIN_RATIO
            hasAlternatePoc := true
            alternatePocPrice := profileLow + (alternateRow + 0.5) * rowHeight

        profile.priceLow := profileLow
        profile.priceHigh := profileLow + priceSpan
        profile.pocRow := pocRow
        profile.valueAreaLowRow := valueAreaLowRow
        profile.valueAreaHighRow := valueAreaHighRow
        profile.pocPrice := profileLow + (pocRow + 0.5) * rowHeight
        profile.valueAreaHighPrice := profileLow + (valueAreaHighRow + 1) * rowHeight
        profile.valueAreaLowPrice := profileLow + valueAreaLowRow * rowHeight
        profile.hasAlternatePoc := hasAlternatePoc
        profile.alternatePocPrice := alternatePocPrice
        profile.isValid := totalVolume > 0
        if profile.isValid and prepareHistogram
            prepareProfileHistogram(profile)
        else if profile.isValid
            array.clear(profile.rowVolumes)
    profile

buildDevelopingProfile(array<float> barHighs, array<float> barLows, array<float> barVolumes, int startTime, array<float> intrabarHighs, array<float> intrabarLows, array<float> intrabarVolumes, bool prepareHistogram) =>
    int originalSize = array.size(barVolumes)
    if not na(fallbackBucketVolume)
        array.push(barHighs, fallbackBucketHigh)
        array.push(barLows, fallbackBucketLow)
        array.push(barVolumes, fallbackBucketVolume)
    if not barstate.isconfirmed
        appendBarVolume(barHighs, barLows, barVolumes, intrabarHighs, intrabarLows, intrabarVolumes, high, low, volume, false)
    Profile profile = buildProfile(barHighs, barLows, barVolumes, PROFILE_ROWS, valueAreaPercent, startTime, time, prepareHistogram)
    while array.size(barVolumes) > originalSize
        array.pop(barHighs)
        array.pop(barLows)
        array.pop(barVolumes)
    profile

buildDevelopingAnchorProfile(AnchorState state, array<float> intrabarHighs, array<float> intrabarLows, array<float> intrabarVolumes, bool prepareHistogram) =>
    buildDevelopingProfile(state.barHighs, state.barLows, state.barVolumes, state.startTime, intrabarHighs, intrabarLows, intrabarVolumes, prepareHistogram)

averageCompletedVolume(MaturityState state) =>
    int sampleCount = array.size(state.completedVolumes)
    float volumeSum = 0.0
    if sampleCount > 0
        for historyIndex = 0 to sampleCount - 1
            volumeSum += array.get(state.completedVolumes, historyIndex)
    sampleCount > 0 ? volumeSum / sampleCount : na

profileStructureStable(Profile profile, float previousVah, float previousVal, float previousPoc) =>
    float valueAreaWidth = math.max(syminfo.mintick, profile.valueAreaHighPrice - profile.valueAreaLowPrice)
    float tolerance = valueAreaWidth * MATURITY_STABILITY_FRACTION
    profile.isValid and not na(previousVah) and math.abs(profile.valueAreaHighPrice - previousVah) <= tolerance and math.abs(profile.valueAreaLowPrice - previousVal) <= tolerance and math.abs(profile.pocPrice - previousPoc) <= tolerance

resetMaturityState(MaturityState state) =>
    state.valueAreaHigh := na
    state.valueAreaLow := na
    state.poc := na
    state.stable := false

updateMaturityState(MaturityState state, array<float> highs, array<float> lows, array<float> volumes) =>
    if array.size(volumes) > 0
        Profile snapshot = buildProfile(highs, lows, volumes, PROFILE_ROWS, valueAreaPercent, 0, 0, false)
        if snapshot.isValid
            state.stable := profileStructureStable(snapshot, state.valueAreaHigh, state.valueAreaLow, state.poc)
            state.valueAreaHigh := snapshot.valueAreaHighPrice
            state.valueAreaLow := snapshot.valueAreaLowPrice
            state.poc := snapshot.pocPrice

advanceMaturityState(MaturityState state, AnchorState anchor, bool periodStart, bool sessionComplete, int historyLimit) =>
    bool advanced = false
    if periodStart
        if array.size(anchor.barVolumes) > 0
            float completedVolume = array.sum(anchor.barVolumes)
            if completedVolume > 0
                array.push(state.completedVolumes, completedVolume)
                while array.size(state.completedVolumes) > historyLimit
                    array.shift(state.completedVolumes)
        state.sessionsCompleted := 0
        resetMaturityState(state)
        advanced := true
    else if sessionComplete
        state.sessionsCompleted += 1
        updateMaturityState(state, anchor.barHighs, anchor.barLows, anchor.barVolumes)
        advanced := true
    advanced

maturityShowsDeveloping(MaturityState state, AnchorState anchor, string currentMode, int fallbackSessions, int earlyMinimumSessions, int earlyVolumeThresholdPercent) =>
    bool sessionMature = state.sessionsCompleted >= fallbackSessions
    bool earlyMature = false
    if barstate.islast
        float averageVolume = averageCompletedVolume(state)
        float currentVolume = array.size(anchor.barVolumes) > 0 ? array.sum(anchor.barVolumes) : 0.0
        earlyMature := state.sessionsCompleted >= earlyMinimumSessions and state.stable and not na(averageVolume) and currentVolume >= averageVolume * earlyVolumeThresholdPercent * 0.01
    currentMode == CURRENT_ON or (currentMode == CURRENT_AUTO and (sessionMature or earlyMature))

// Positional fill may cross the core; traversal fill erodes only traded portions and can re-side it.
erodeCoreFromAbove(ValueGap gap, float returnLow) =>
    gap.coreTop := math.max(gap.coreBottom, math.min(gap.coreTop, returnLow))

erodeCoreFromBelow(ValueGap gap, float returnHigh) =>
    gap.coreBottom := math.min(gap.coreTop, math.max(gap.coreBottom, returnHigh))

advanceValueGap(ValueGap gap, float returnHigh, float returnLow, int eventTime, bool traversalFill) =>
    if na(gap.fillTime)
        if traversalFill
            bool reachesBelow = returnLow <= gap.coreBottom
            bool reachesAbove = returnHigh >= gap.coreTop
            if returnHigh >= gap.coreBottom and returnLow <= gap.coreTop
                if reachesBelow and reachesAbove
                    gap.coreTop := gap.coreBottom
                else if reachesBelow
                    erodeCoreFromBelow(gap, returnHigh)
                    gap.entryDirection := ValueGapEntryDirection.fromBelow
                else if reachesAbove
                    erodeCoreFromAbove(gap, returnLow)
                    gap.entryDirection := ValueGapEntryDirection.fromAbove
// Inside the core, use the side price most recently approached from.
                else if gap.entryDirection == ValueGapEntryDirection.fromAbove
                    erodeCoreFromAbove(gap, returnLow)
                else
                    erodeCoreFromBelow(gap, returnHigh)
            else if reachesAbove
                gap.entryDirection := ValueGapEntryDirection.fromAbove
            else
                gap.entryDirection := ValueGapEntryDirection.fromBelow
        else if gap.entryDirection == ValueGapEntryDirection.fromAbove
            erodeCoreFromAbove(gap, returnLow)
        else
            erodeCoreFromBelow(gap, returnHigh)
        if gap.coreTop <= gap.coreBottom
            gap.fillTime := eventTime

valueGapFromProfiles(Profile previousProfile, Profile currentProfile, int leftTime, int creationTime) =>
    float bullishTop = currentProfile.valueAreaLowPrice
    float bullishBottom = previousProfile.valueAreaHighPrice
    float bearishTop = previousProfile.valueAreaLowPrice
    float bearishBottom = currentProfile.valueAreaHighPrice
    ValueGap gap = na
    if bullishTop - bullishBottom >= syminfo.mintick
        gap := ValueGap.new(leftTime, creationTime, bullishTop, bullishBottom, true, na, ValueGapEntryDirection.fromAbove, bullishTop, bullishBottom)
    else if bearishTop - bearishBottom >= syminfo.mintick
        gap := ValueGap.new(leftTime, creationTime, bearishTop, bearishBottom, false, na, ValueGapEntryDirection.fromBelow, bearishTop, bearishBottom)
    gap

appendValueGap(Profile previousProfile, Profile completedProfile, array<ValueGap> valueGaps) =>
    ValueGap gap = valueGapFromProfiles(previousProfile, completedProfile, completedProfile.startTime, completedProfile.endTime)
    if not na(gap)
        float previousRange = math.max(previousProfile.priceHigh - previousProfile.priceLow, syminfo.mintick)
        float confirmedPercent = (gap.top - gap.bottom) / previousRange * 100
        if confirmedPercent >= confirmedValueGapMinPercent
            array.push(valueGaps, gap)

syncValueGapProfile(array<Profile> profiles, array<Profile> sourceProfiles, array<ValueGap> valueGaps) =>
    if array.size(profiles) > 0
        Profile completedProfile = array.last(profiles)
        int sourceCount = array.size(sourceProfiles)
        bool sourceChanged = sourceCount == 0
        if sourceCount > 0
            Profile latestSource = array.last(sourceProfiles)
            sourceChanged := completedProfile.startTime != latestSource.startTime or completedProfile.endTime != latestSource.endTime
        if sourceChanged
            if array.size(valueGaps) > 0
                for gapIndex = array.size(valueGaps) - 1 to 0
                    ValueGap candidate = array.get(valueGaps, gapIndex)
                    if candidate.leftTime == completedProfile.startTime
                        array.remove(valueGaps, gapIndex)

            bool replacesLatest = false
            if sourceCount > 0
                Profile currentSource = array.last(sourceProfiles)
                replacesLatest := currentSource.startTime == completedProfile.startTime
            if replacesLatest
                array.set(sourceProfiles, sourceCount - 1, completedProfile)
            else
                array.push(sourceProfiles, completedProfile)
                if array.size(sourceProfiles) > 2
                    array.shift(sourceProfiles)

            if array.size(sourceProfiles) == 2
                appendValueGap(array.first(sourceProfiles), array.last(sourceProfiles), valueGaps)

            while array.size(valueGaps) > MAX_STORED_VALUE_GAPS
                array.shift(valueGaps)

// The confirming session cannot fill its own value-area gap.
updateValueGapPriceFills(array<ValueGap> valueGaps, float breachHigh, float breachLow) =>
    if array.size(valueGaps) > 0 and not na(breachHigh) and not na(breachLow)
        for gapIndex = 0 to array.size(valueGaps) - 1
            ValueGap gap = array.get(valueGaps, gapIndex)
            if na(gap.fillTime) and time > gap.creationTime
                advanceValueGap(gap, breachHigh, breachLow, time, valueGapTraversalFill)

nyPriceWindowTimestampEligible(int timestamp, int startMinute, bool allDays) =>
    int day = dayofweek(timestamp, NY_TIMEZONE)
    bool dayEligible = allDays or (day >= dayofweek.monday and day <= dayofweek.friday)
    int minuteOfDay = hour(timestamp, NY_TIMEZONE) * 60 + minute(timestamp, NY_TIMEZONE)
    dayEligible and minuteOfDay >= startMinute and minuteOfDay < RTH_END_MINUTE

priceWindowMayContainEligiblePrice(int startMinute, array<int> intrabarTimes, bool allDays, bool fallbackWindow) =>
    bool possible = false
    int intrabarCount = array.size(intrabarTimes)
    if intrabarCount > 0
        int firstTime = array.first(intrabarTimes)
        int lastTime = array.last(intrabarTimes)
        int windowSpanMs = (RTH_END_MINUTE - startMinute) * 60 * 1000
        possible := nyPriceWindowTimestampEligible(firstTime, startMinute, allDays) or nyPriceWindowTimestampEligible(lastTime, startMinute, allDays) or lastTime - firstTime >= windowSpanMs
    else
        possible := fallbackWindow
    possible

priceWindowRange(int startMinute, array<float> intrabarHighs, array<float> intrabarLows, array<int> intrabarTimes, bool allDays, bool fallbackWindow) =>
    float eligibleHigh = na
    float eligibleLow = na
    int intrabarCount = array.size(intrabarTimes)
    if intrabarCount > 0
        for intrabarIndex = 0 to intrabarCount - 1
            if nyPriceWindowTimestampEligible(array.get(intrabarTimes, intrabarIndex), startMinute, allDays)
                float subHigh = array.get(intrabarHighs, intrabarIndex)
                float subLow = array.get(intrabarLows, intrabarIndex)
                eligibleHigh := na(eligibleHigh) ? subHigh : math.max(eligibleHigh, subHigh)
                eligibleLow := na(eligibleLow) ? subLow : math.min(eligibleLow, subLow)
    else if fallbackWindow
        eligibleHigh := high
        eligibleLow := low
    [eligibleHigh, eligibleLow]

valueGapFillStartMinute(string fillWindow) =>
    fillWindow == WINDOW_LABEL_RTH ? RTH_START_MINUTE : fillWindow == WINDOW_LABEL_FROM_0830 ? FROM_0830_START_MINUTE : FROM_0500_START_MINUTE

fillRangeMayContainEligiblePrice(string fillWindow, array<int> intrabarTimes, bool allDays, bool fallbackWindow) =>
    fillWindow == WINDOW_LABEL_OVERNIGHT or priceWindowMayContainEligiblePrice(valueGapFillStartMinute(fillWindow), intrabarTimes, allDays, fallbackWindow)

valueGapFillRange(string fillWindow, array<float> intrabarHighs, array<float> intrabarLows, array<int> intrabarTimes, bool allDays, bool fallbackWindow) =>
    float eligibleHigh = na
    float eligibleLow = na
    if fillWindow == WINDOW_LABEL_OVERNIGHT
        eligibleHigh := high
        eligibleLow := low
    else
        [windowHigh, windowLow] = priceWindowRange(valueGapFillStartMinute(fillWindow), intrabarHighs, intrabarLows, intrabarTimes, allDays, fallbackWindow)
        eligibleHigh := windowHigh
        eligibleLow := windowLow
    [eligibleHigh, eligibleLow]

reminderPlacements(int runMs, int spacingMs, int maxCount) =>
    math.min(maxCount, math.max(1, int(math.floor(math.sqrt(float(runMs) / math.max(1, spacingMs))))))

levelEndpoint(int endTime, int breachTime, string extensionMode) =>
    int rightEdge = endTime
    bool extendRight = false
    if extensionMode == LEVEL_BREACH_ANY or extensionMode == LEVEL_BREACH_SAME or extensionMode == LEVEL_BREACH_SWEEP
        if na(breachTime)
            extendRight := true
        else
            rightEdge := breachTime
    [rightEdge, extendRight]

// ═══════════════════════════════════════════════════════════════════════════════
// FUNCTIONS — rendering
// ═══════════════════════════════════════════════════════════════════════════════

var array<box> drawnBoxes = array.new<box>()
var array<line> drawnLines = array.new<line>()
var array<polyline> drawnPolylines = array.new<polyline>()
var array<label> drawnLabels = array.new<label>()
var array<PendingLabel> pendingLabels = array.new<PendingLabel>()
var array<PendingReminder> pendingReminders = array.new<PendingReminder>()
var array<PendingAnchorReminder> pendingAnchorReminders = array.new<PendingAnchorReminder>()

// Preserve earlier render priorities; discard new drawings after a global cap is reached.
trackBox(box drawing) =>
    bool retained = array.size(drawnBoxes) < INDICATOR_MAX_BOXES
    if retained
        array.push(drawnBoxes, drawing)
    else
        box.delete(drawing)
    retained

trackLine(line drawing) =>
    bool retained = array.size(drawnLines) < INDICATOR_MAX_LINES
    if retained
        array.push(drawnLines, drawing)
    else
        line.delete(drawing)
    retained

trackPolyline(polyline drawing) =>
    bool retained = array.size(drawnPolylines) < INDICATOR_MAX_POLYLINES
    if retained
        array.push(drawnPolylines, drawing)
    else
        polyline.delete(drawing)
    retained

trackLabel(label drawing) =>
    bool retained = array.size(drawnLabels) < INDICATOR_MAX_LABELS
    if retained
        array.push(drawnLabels, drawing)
    else
        label.delete(drawing)
    retained

clearDrawings() =>
    if array.size(drawnBoxes) > 0
        for boxIndex = 0 to array.size(drawnBoxes) - 1
            box.delete(array.get(drawnBoxes, boxIndex))
        array.clear(drawnBoxes)
    if array.size(drawnLines) > 0
        for lineIndex = 0 to array.size(drawnLines) - 1
            line.delete(array.get(drawnLines, lineIndex))
        array.clear(drawnLines)
    if array.size(drawnPolylines) > 0
        for polylineIndex = 0 to array.size(drawnPolylines) - 1
            polyline.delete(array.get(drawnPolylines, polylineIndex))
        array.clear(drawnPolylines)
    if array.size(drawnLabels) > 0
        for labelIndex = 0 to array.size(drawnLabels) - 1
            label.delete(array.get(drawnLabels, labelIndex))
        array.clear(drawnLabels)
    array.clear(pendingLabels)
    array.clear(pendingReminders)
    array.clear(pendingAnchorReminders)

valueGapUntouched(ValueGap gap) =>
    gap.coreTop >= gap.top and gap.coreBottom <= gap.bottom

valueGapFillPercent(ValueGap gap) =>
    float gapRange = gap.top - gap.bottom
    if gapRange <= 0
        0
    else
        float rawPercent = (gapRange - (gap.coreTop - gap.coreBottom)) / gapRange * 100
        int(math.min(na(gap.fillTime) ? 99 : 100, math.round(math.max(0, math.min(100, rawPercent)))))

valueGapLabelText(ValueGap gap, bool useUtcTimezone) =>
    bool isFilled = not na(gap.fillTime)
    string fillSuffix = isFilled ? " " + SWEPT_CHECKMARK : valueGapUntouched(gap) ? "" : " " + str.tostring(valueGapFillPercent(gap), "#") + "%"
    string dateText = calendarDateText(gap.creationTime, useUtcTimezone)
    valueGapSource + " Value Gap" + fillSuffix + "\n" + dateText

valueGapBoxGeometry(ValueGap gap) =>
    [gap.top, gap.coreTop, gap.coreTop, gap.coreBottom, gap.coreBottom, gap.bottom]

// Fill order is not creation order, so the newest mitigation is found by fillTime, not by position.
latestFilledValueGapIndex(array<ValueGap> valueGaps, bool enabled) =>
    int latestIndex = -1
    if enabled and array.size(valueGaps) > 0
        int latestFill = -1
        for gapIndex = 0 to array.size(valueGaps) - 1
            ValueGap gap = array.get(valueGaps, gapIndex)
            if not na(gap.fillTime) and gap.fillTime > latestFill
                latestFill := gap.fillTime
                latestIndex := gapIndex
    latestIndex

selectValueGapFloats(array<ValueGap> valueGaps, bool enabled, int nearestCount) =>
    array<int> selected = array.new<int>()
    int gapCount = array.size(valueGaps)
    if enabled and gapCount > 0
        for gapIndex = gapCount - 1 to 0
            ValueGap candidate = array.get(valueGaps, gapIndex)
            if na(candidate.fillTime)
                array.push(selected, gapIndex)
                break
        int additionalCount = math.min(nearestCount, gapCount - array.size(selected))
        if additionalCount > 0
            for selection = 1 to additionalCount
                float nearestDistance = 1e20
                int nearestIndex = -1
                for gapIndex = 0 to gapCount - 1
                    ValueGap gap = array.get(valueGaps, gapIndex)
                    if na(gap.fillTime) and not array.includes(selected, gapIndex)
                        float distance = close >= gap.bottom and close <= gap.top ? 0.0 : math.min(math.abs(close - gap.bottom), math.abs(close - gap.top))
                        if distance < nearestDistance
                            nearestDistance := distance
                            nearestIndex := gapIndex
                if nearestIndex >= 0
                    array.push(selected, nearestIndex)
    selected

confirmedValueGapStyle() =>
    ValueGapStyle.new(bullishValueGapUnfilledColor, bearishValueGapUnfilledColor, valueGapFilledColor, bullishValueGapBorderColor, bearishValueGapBorderColor, valueGapShowLabels, bullishValueGapLabelColor, bearishValueGapLabelColor, valueGapMitigatedLabelColor, valueGapLabelSize, valueGapShowMidpointLine, valueGapMidpointOpenLineColor, valueGapMidpointMitigatedLineColor, valueGapShowMidpointLabel, valueGapShowQuartileLines, valueGapQuartileOpenLineColor, valueGapQuartileMitigatedLineColor, valueGapShowQuartileLabels, valueGapInternalLabelSize, valueGapInternalLabelFade, valueGapShowInternalReminders)

upcomingValueGapStyle() =>
    ValueGapStyle.new(upcomingValueGapColor, upcomingValueGapColor, valueGapFilledColor, upcomingValueGapBorderColor, upcomingValueGapBorderColor, valueGapShowLabels, bullishValueGapLabelColor, bearishValueGapLabelColor, valueGapMitigatedLabelColor, valueGapLabelSize, valueGapShowMidpointLine, valueGapMidpointOpenLineColor, valueGapMidpointMitigatedLineColor, false, valueGapShowQuartileLines, valueGapQuartileOpenLineColor, valueGapQuartileMitigatedLineColor, false, valueGapInternalLabelSize, valueGapInternalLabelFade, false)

floatingValueGapStyle() =>
    ValueGapStyle.new(bullishValueGapUnfilledColor, bearishValueGapUnfilledColor, valueGapFilledColor, bullishValueGapBorderColor, bearishValueGapBorderColor, valueGapShowLabels, bullishValueGapLabelColor, bearishValueGapLabelColor, valueGapMitigatedLabelColor, valueGapLabelSize, valueGapShowMidpointLine, valueGapMidpointOpenLineColor, valueGapMidpointMitigatedLineColor, false, valueGapShowQuartileLines, valueGapQuartileOpenLineColor, valueGapQuartileMitigatedLineColor, false, valueGapInternalLabelSize, valueGapInternalLabelFade, false)

valueGapLevelFilled(ValueGap gap, float levelPrice) =>
    not na(gap.fillTime) or levelPrice >= gap.coreTop or levelPrice <= gap.coreBottom

// Only the confirmed style enables reminders, so runMs is always a bar_time span, never a bar count.
valueGapInternalPlacements(ValueGapStyle style, int runMs) =>
    style.showInternalReminders and runMs > 0 ? reminderPlacements(runMs, SWEPT_REMINDER_BASE_MS, VALUE_GAP_REMINDER_MAX_PER_LEVEL) : 1

valueGapInternalLabelText(float levelFraction) =>
    valueGapSource + " Gap " + str.tostring(int(levelFraction * 100)) + "%"

valueGapLabelCost(ValueGap gap, ValueGapStyle style, int runMs) =>
    int placements = valueGapInternalPlacements(style, runMs)
    int internalLabels = na(gap.fillTime) ? (style.showMidpointLine and style.showMidpointLabel ? placements : 0) + (style.showQuartileLines and style.showQuartileLabels ? 2 * placements : 0) : 0
    (style.showLabels ? 1 : 0) + internalLabels

valueGapBoxCost(ValueGap gap, ValueGapStyle style) =>
    [topFilledTop, topFilledBottom, coreTop, coreBottom, bottomFilledTop, bottomFilledBottom] = valueGapBoxGeometry(gap)
    (topFilledTop != topFilledBottom ? 1 : 0) + (coreTop != coreBottom ? 1 : 0) + (bottomFilledTop != bottomFilledBottom ? 1 : 0) + 1

pushValueGapInternalLabels(int leftEdge, int rightEdge, int placements, string xLocation, float price, string labelText, color textColor, string labelSize) =>
    for placement = 1 to placements
        int labelEdge = leftEdge + int((rightEdge - leftEdge) * (placement - 0.5) / placements)
        trackLabel(label.new(labelEdge, price, labelText, xloc=xLocation, yloc=yloc.price, color=VALUE_GAP_MIDPOINT_LABEL_BG, textcolor=textColor, style=label.style_label_center, size=labelSize, textalign=text.align_center))

renderStyledValueGap(ValueGap gap, int leftEdge, int rightEdge, string xLocation, ValueGapStyle style, string labelText, bool emphasize) =>
    color unfilledColor = gap.bullish ? style.bullishColor : style.bearishColor
    int referenceWidth = emphasize ? VALUE_GAP_BOLD_REFERENCE_WIDTH : VALUE_GAP_REFERENCE_WIDTH
    [topFilledTop, topFilledBottom, coreTop, coreBottom, bottomFilledTop, bottomFilledBottom] = valueGapBoxGeometry(gap)
    if topFilledTop != topFilledBottom
        trackBox(box.new(left=leftEdge, top=topFilledTop, right=rightEdge, bottom=topFilledBottom, xloc=xLocation, bgcolor=style.filledColor, border_color=na))
    if coreTop != coreBottom
        trackBox(box.new(left=leftEdge, top=coreTop, right=rightEdge, bottom=coreBottom, xloc=xLocation, bgcolor=unfilledColor, border_color=na))
    if bottomFilledTop != bottomFilledBottom
        trackBox(box.new(left=leftEdge, top=bottomFilledTop, right=rightEdge, bottom=bottomFilledBottom, xloc=xLocation, bgcolor=style.filledColor, border_color=na))

    bool gapFilled = not na(gap.fillTime)
    float gapRange = gap.top - gap.bottom
    color gapLabelColor = gap.bullish ? style.bullishLabelColor : style.bearishLabelColor
    color internalLabelColor = color.new(gapLabelColor, math.min(100, int(color.t(gapLabelColor)) + style.internalLabelFade))
    string internalLabelSize = toLabelSize(style.internalLabelSize)
    int internalPlacements = valueGapInternalPlacements(style, rightEdge - leftEdge)
    if style.showMidpointLine
        float cePrice = gap.bottom + gapRange * VALUE_GAP_CE_LEVEL
        bool midpointMitigated = valueGapLevelFilled(gap, cePrice)
        color midpointLineColor = midpointMitigated ? style.midpointMitigatedLineColor : style.midpointOpenLineColor
        trackLine(line.new(leftEdge, cePrice, rightEdge, cePrice, xloc=xLocation, color=midpointLineColor, style=line.style_dashed, width=referenceWidth))
        if style.showMidpointLabel and not gapFilled
            pushValueGapInternalLabels(leftEdge, rightEdge, internalPlacements, xLocation, cePrice, valueGapInternalLabelText(VALUE_GAP_CE_LEVEL), internalLabelColor, internalLabelSize)
    if style.showQuartileLines
        float q1Price = gap.bottom + gapRange * VALUE_GAP_Q1_LEVEL
        float q3Price = gap.bottom + gapRange * VALUE_GAP_Q3_LEVEL
        bool q1Mitigated = valueGapLevelFilled(gap, q1Price)
        bool q3Mitigated = valueGapLevelFilled(gap, q3Price)
        color q1LineColor = q1Mitigated ? style.quartileMitigatedLineColor : style.quartileOpenLineColor
        color q3LineColor = q3Mitigated ? style.quartileMitigatedLineColor : style.quartileOpenLineColor
        trackLine(line.new(leftEdge, q1Price, rightEdge, q1Price, xloc=xLocation, color=q1LineColor, style=line.style_dotted, width=referenceWidth))
        trackLine(line.new(leftEdge, q3Price, rightEdge, q3Price, xloc=xLocation, color=q3LineColor, style=line.style_dotted, width=referenceWidth))
        if style.showQuartileLabels and not gapFilled
            pushValueGapInternalLabels(leftEdge, rightEdge, internalPlacements, xLocation, q1Price, valueGapInternalLabelText(VALUE_GAP_Q1_LEVEL), internalLabelColor, internalLabelSize)
            pushValueGapInternalLabels(leftEdge, rightEdge, internalPlacements, xLocation, q3Price, valueGapInternalLabelText(VALUE_GAP_Q3_LEVEL), internalLabelColor, internalLabelSize)

    color borderColor = gap.bullish ? style.bullishBorderColor : style.bearishBorderColor
    trackBox(box.new(left=leftEdge, top=gap.top, right=rightEdge, bottom=gap.bottom, xloc=xLocation, bgcolor=na, border_color=borderColor, border_width=referenceWidth))

    if style.showLabels
        int labelEdge = leftEdge + int((rightEdge - leftEdge) * 0.5)
        bool labelAbove = not gap.bullish
        float labelPrice = labelAbove ? gap.top : gap.bottom
        string labelStyle = labelAbove ? label.style_label_down : label.style_label_up
        color labelColor = gapFilled ? style.mitigatedLabelColor : gapLabelColor
        trackLabel(label.new(labelEdge, labelPrice, labelText, xloc=xLocation, yloc=yloc.price, color=VALUE_GAP_LABEL_BG_TRANSPARENT, textcolor=labelColor, style=labelStyle, size=toLabelSize(style.labelSize), textalign=text.align_center))

renderFloatingValueGaps(array<ValueGap> valueGaps, array<int> selectedIndices, bool useUtcTimezone) =>
    int floatCount = array.size(selectedIndices)
    if floatCount > 0
        ValueGapStyle style = floatingValueGapStyle()
        for floatSlot = 0 to floatCount - 1
            ValueGap gap = array.get(valueGaps, array.get(selectedIndices, floatSlot))
            int leftBar = bar_index + floatingValueGapOffset + floatSlot * (floatingValueGapWidth + 10)
            int rightBar = leftBar + floatingValueGapWidth
            renderStyledValueGap(gap, leftBar, rightBar, xloc.bar_index, style, valueGapLabelText(gap, useUtcTimezone), false)

renderUpcomingValueGap(array<Profile> profiles, Profile liveProfile, bool enabled, bool useUtcTimezone) =>
    if enabled and not na(liveProfile) and array.size(profiles) > 0
        Profile previousProfile = array.last(profiles)
        if liveProfile.isValid
            ValueGap upcomingGap = valueGapFromProfiles(previousProfile, liveProfile, liveProfile.startTime, time)
            if not na(upcomingGap)
                float previousRange = math.max(previousProfile.priceHigh - previousProfile.priceLow, syminfo.mintick)
                float upcomingPercent = (upcomingGap.top - upcomingGap.bottom) / previousRange * 100
                if upcomingPercent >= upcomingValueGapMinPercent
                    int leftBar = bar_index + upcomingValueGapOffset
                    int rightBar = leftBar + upcomingValueGapWidth
                    string dateText = calendarDateText(liveProfile.startTime, useUtcTimezone)
                    renderStyledValueGap(upcomingGap, leftBar, rightBar, xloc.bar_index, upcomingValueGapStyle(), "Upcoming " + valueGapSource + " Value Gap\n" + dateText, false)

renderValueGaps(array<ValueGap> valueGaps, bool enabled, array<int> floatingIndices, int displayLimit, bool useUtcTimezone) =>
    int gapCount = array.size(valueGaps)
    if enabled and gapCount > 0
        ValueGapStyle style = confirmedValueGapStyle()
        int liveRightPadding = int(timeframe.in_seconds(timeframe.period) * 1000) * VALUE_GAP_RIGHT_EDGE_CUSHION
        int linesPerGap = (style.showMidpointLine ? 1 : 0) + (style.showQuartileLines ? 2 : 0)
// Budget gaps newest-first using each gap's actual drawing cost.
        int firstGapIndex = gapCount
        int selectedCount = 0
        int lineCost = 0
        int labelCost = 0
        int boxCost = 0
        for gapIndex = gapCount - 1 to 0
            ValueGap candidate = array.get(valueGaps, gapIndex)
            bool candidateFilled = not na(candidate.fillTime)
            if not array.includes(floatingIndices, gapIndex) and (not candidateFilled or not hideFilledValueGaps)
                int candidateRight = candidateFilled ? candidate.fillTime : time + liveRightPadding
                int candidateLabels = valueGapLabelCost(candidate, style, candidateRight - candidate.leftTime)
                int candidateBoxes = valueGapBoxCost(candidate, style)
                if lineCost + linesPerGap > VALUE_GAP_LINE_BUDGET or labelCost + candidateLabels > VALUE_GAP_LABEL_BUDGET or boxCost + candidateBoxes > VALUE_GAP_BOX_BUDGET
                    break
                lineCost += linesPerGap
                labelCost += candidateLabels
                boxCost += candidateBoxes
                firstGapIndex := gapIndex
                selectedCount += 1
                if selectedCount >= displayLimit
                    break
        if firstGapIndex < gapCount
            int boldGapIndex = latestFilledValueGapIndex(valueGaps, boldLastFilledValueGap and not hideFilledValueGaps)
            for gapIndex = firstGapIndex to gapCount - 1
                ValueGap gap = array.get(valueGaps, gapIndex)
                if array.includes(floatingIndices, gapIndex)
                    continue
                bool isFilled = not na(gap.fillTime)
                if isFilled and hideFilledValueGaps
                    continue
                int rightTime = isFilled ? gap.fillTime : time + liveRightPadding
                renderStyledValueGap(gap, gap.leftTime, rightTime, xloc.bar_time, style, valueGapLabelText(gap, useUtcTimezone), gapIndex == boldGapIndex)

// Trailing margin keeps a repeat off the right-edge label, which already names the level there.
anchorReminderRun(int anchorEndTime, int runEndTime) =>
    int runStart = anchorEndTime + ANCHOR_REMINDER_MIN_SPACING_MS
    int runEnd = math.min(runEndTime, time - ANCHOR_REMINDER_MIN_SPACING_MS)
    [runStart, runEnd - runStart]

renderAnchorLevelReminders(int anchorEndTime, int runEndTime, float price, string reminderText, string levelName, color textColor, color bgColor, string sizeName) =>
    [reminderRunStart, eligibleRunMs] = anchorReminderRun(anchorEndTime, runEndTime)
    if anchorLevelLabelMode != ANCHOR_LABEL_MODE_OFF and eligibleRunMs > 0
        int reminderCount = 1
        if anchorLevelLabelMode == ANCHOR_LABEL_MODE_REMINDERS
            reminderCount := reminderPlacements(eligibleRunMs, ANCHOR_REMINDER_MIN_SPACING_MS, ANCHOR_REMINDER_MAX_PER_LEVEL)
        // Strong phase separation keeps nearby POC / VAH / VAL text from vertically stacking.
        float levelFrac = levelName == LABEL_VAH ? 0.5 : levelName == LABEL_VAL ? 0.85 : 0.15
        for placement = 1 to reminderCount
            int reminderTime = reminderRunStart + int(eligibleRunMs * (placement - 1 + levelFrac) / reminderCount)
            trackLabel(label.new(reminderTime, price, reminderText, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, textcolor=textColor, size=toLabelSize(sizeName), color=bgColor))

// Declared before retention helpers because the calendar policy depends on asset classification.
var bool isTwentyFourSevenAsset = false
var bool assetClassificationReady = false

sameNyDate(int firstTime, int secondTime) =>
    sameCalendarDate(firstTime, secondTime, NY_TIMEZONE)

calendarDateSerial(int eventTime, string timezone) =>
    int dateTimestamp = timestamp(UTC_TIMEZONE, year(eventTime, timezone), month(eventTime, timezone), dayofmonth(eventTime, timezone), 0, 0)
    int(dateTimestamp / MS_PER_DAY)

weekdayDistance(int firstDateSerial, int secondDateSerial) =>
    int calendarSpan = math.max(0, secondDateSerial - firstDateSerial)
    int tradingDays = calendarSpan > MAX_LEVEL_HIT_TRADING_DAY_SCAN ? MAX_LEVEL_HIT_WEEKDAY_RETENTION_DAYS : 0
    if calendarSpan > 0 and calendarSpan <= MAX_LEVEL_HIT_TRADING_DAY_SCAN
        for dayOffset = 1 to calendarSpan
            int weekday = dayofweek((firstDateSerial + dayOffset) * MS_PER_DAY, UTC_TIMEZONE)
            if weekday >= dayofweek.monday and weekday <= dayofweek.friday
                tradingDays += 1
    tradingDays

levelHitRetentionDays() =>
    levelHitHistory == LEVEL_HIT_HISTORY_ONE_DAY ? 1 : levelHitHistory == LEVEL_HIT_HISTORY_THREE_DAYS ? 3 : isTwentyFourSevenAsset ? 7 : MAX_LEVEL_HIT_WEEKDAY_RETENTION_DAYS

levelHitDetectionStartMinute() =>
    levelHitDetectionWindow == WINDOW_LABEL_FROM_0500 ? FROM_0500_START_MINUTE : levelHitDetectionWindow == WINDOW_LABEL_FROM_0830 ? FROM_0830_START_MINUTE : RTH_START_MINUTE

mostRecentWeekday(int dateSerial) =>
    int weekday = dayofweek(dateSerial * MS_PER_DAY, UTC_TIMEZONE)
    weekday == dayofweek.saturday ? dateSerial - 1 : weekday == dayofweek.sunday ? dateSerial - 2 : dateSerial

levelHitReferenceDateSerial() =>
    int currentDateSerial = calendarDateSerial(time, NY_TIMEZONE)
    int currentMinute = hour(time, NY_TIMEZONE) * 60 + minute(time, NY_TIMEZONE)
    int candidateDateSerial = currentMinute >= levelHitDetectionStartMinute() ? currentDateSerial : currentDateSerial - 1
    isTwentyFourSevenAsset ? candidateDateSerial : mostRecentWeekday(candidateDateSerial)

levelHitDayDistance(int hitTime) =>
    int hitDateSerial = calendarDateSerial(hitTime, NY_TIMEZONE)
    int referenceDateSerial = levelHitReferenceDateSerial()
    isTwentyFourSevenAsset ? math.max(0, referenceDateSerial - hitDateSerial) : weekdayDistance(hitDateSerial, referenceDateSerial)

levelHitTraceActive(int hitTime, bool tracePresentationActive) =>
    tracePresentationActive and not na(hitTime) and (levelHitHistory == LEVEL_HIT_HISTORY_CURRENT_WINDOW ? sameNyDate(hitTime, time) : levelHitDayDistance(hitTime) < levelHitRetentionDays())

levelHitSourceProfileKey(int startTime, int endTime, SessionStyle style) =>
    style.labelAnchor + "|" + str.tostring(startTime) + "|" + str.tostring(endTime)

levelHitKey(string sourceProfileKey, string levelName) =>
    sourceProfileKey + "|" + levelName

plainPreviousLabel(string labelText) =>
    str.replace_all(str.replace_all(labelText, "[", ""), "]", "")

levelIdentity(int startTime, SessionStyle style, bool isLive, bool isLast, string levelName, bool sweptDenote, bool plainPrevious) =>
    string dateText = periodDateText(startTime, style.periodLabelMode, style.useUtcLabelTimezone)
    string previousText = plainPrevious and isLast ? plainPreviousLabel(style.labelLast) : style.labelLast
    string nameText = isLive ? style.labelLive + " " + levelName : isLast ? previousText + " " + levelName : style.labelAnchor + " " + levelName + " " + dateText
    nameText + (sweptDenote ? " " + SWEPT_CHECKMARK : "")

levelLabelRank(string levelName, SessionStyle style, bool isLive, bool isLast) =>
    int levelWeight = levelName == LABEL_POC ? 3 : levelName == LABEL_ALTERNATE_POC ? 1 : 2
    int anchorWeight = style.periodLabelMode == PERIOD_LABEL_QUARTER ? 1 : 0
    int recencyWeight = isLive ? 2 : isLast ? 1 : 0
    levelWeight * 100 + anchorWeight * 10 + recencyWeight

effectiveLevelLineWidth(int lineWidth, SessionStyle style, bool sweptDenote) =>
    sweptDenote ? style.sweptContinuationWidth : lineWidth

identityPrecedes(int candidateWidth, int candidateRank, int candidateOrder, int currentWidth, int currentRank, int currentOrder) =>
    candidateWidth > currentWidth or (candidateWidth == currentWidth and (candidateRank > currentRank or (candidateRank == currentRank and candidateOrder < currentOrder)))

prioritizedIdentityPrecedes(int candidatePriority, int candidateWidth, int candidateRank, int candidateOrder, int currentPriority, int currentWidth, int currentRank, int currentOrder) =>
    candidatePriority > currentPriority or (candidatePriority == currentPriority and identityPrecedes(candidateWidth, candidateRank, candidateOrder, currentWidth, currentRank, currentOrder))

labelMergeTolerance(float price) =>
    math.max(syminfo.mintick, math.abs(price) * labelMergeDistancePercent / 100.0)

nearestLabelCluster(float price, bool dedupe, array<float> clusterPrices) =>
    int foundIndex = -1
    float tolerance = labelMergeTolerance(price)
    float minDistance = tolerance + syminfo.mintick
    if dedupe and array.size(clusterPrices) > 0
        for clusterIndex = 0 to array.size(clusterPrices) - 1
            float distance = math.abs(array.get(clusterPrices, clusterIndex) - price)
            if distance <= tolerance and distance < minDistance
                minDistance := distance
                foundIndex := clusterIndex
    foundIndex

newestUnusedIndex(array<int> recencyTimes, array<bool> used) =>
    int newestIndex = -1
    int newestTime = -1
    if array.size(recencyTimes) > 0
        for candidateIndex = 0 to array.size(recencyTimes) - 1
            int candidateTime = array.get(recencyTimes, candidateIndex)
            if not array.get(used, candidateIndex) and (newestIndex < 0 or candidateTime > newestTime)
                newestIndex := candidateIndex
                newestTime := candidateTime
    newestIndex

orderedClusterIdentities(int clusterIndex, string separator, int fallbackOrder, array<int> identityCluster, array<string> identityName, array<int> identityPriority, array<int> identityWidth, array<int> identityRank, array<int> identityOrder) =>
    string body = ""
    int clusterIdentityCount = 0
    if array.size(identityName) > 0
        for identityIndex = 0 to array.size(identityName) - 1
            if array.get(identityCluster, identityIndex) == clusterIndex
                clusterIdentityCount += 1
    array<bool> identityUsed = array.new<bool>(array.size(identityName), false)
    if clusterIdentityCount > 0
        for identityPosition = 1 to clusterIdentityCount
            int bestIdentityIndex = -1
            int bestPriority = -1
            int bestWidth = -1
            int bestRank = -1
            int bestOrder = fallbackOrder
            for identityIndex = 0 to array.size(identityName) - 1
                if array.get(identityCluster, identityIndex) == clusterIndex and not array.get(identityUsed, identityIndex)
                    int candidatePriority = array.get(identityPriority, identityIndex)
                    int candidateWidth = array.get(identityWidth, identityIndex)
                    int candidateRank = array.get(identityRank, identityIndex)
                    int candidateOrder = array.get(identityOrder, identityIndex)
                    if prioritizedIdentityPrecedes(candidatePriority, candidateWidth, candidateRank, candidateOrder, bestPriority, bestWidth, bestRank, bestOrder)
                        bestIdentityIndex := identityIndex
                        bestPriority := candidatePriority
                        bestWidth := candidateWidth
                        bestRank := candidateRank
                        bestOrder := candidateOrder
            if bestIdentityIndex >= 0
                string nextName = array.get(identityName, bestIdentityIndex)
                body := body == "" ? nextName : body + separator + nextName
                array.set(identityUsed, bestIdentityIndex, true)
    body

fadeColor(color baseColor, float fadeFraction) =>
    color.new(baseColor, 100 - (100 - color.t(baseColor)) * (1 - fadeFraction))

// sweptDenote adds a faded dashed continuation after the solid swept segment.
drawLevel(int startTime, int endTime, float price, color lineColor, int lineWidth, string styleName, bool extendRight, color labelColor, string levelName, SessionStyle style, bool sweptDenote, color sweptContinuationColor, bool hitTraceActive, bool archivedTouch, bool isLive, bool isLast, int anchorEndTime) =>
    line primaryLine = line.new(x1=startTime, y1=price, x2=endTime, y2=price, xloc=xloc.bar_time, extend=extendRight ? extend.right : extend.none, color=lineColor, width=lineWidth, style=toLineStyle(styleName))
    bool primaryLineRetained = trackLine(primaryLine)
    line activeLine = extendRight and primaryLineRetained ? primaryLine : na
    color activeLineColor = extendRight and primaryLineRetained ? lineColor : na
    color labelTextColor = sweptDenote ? fadeColor(labelColor, sweptLabelTextFadePercent / 100.0) : labelColor
    string dateText = periodDateText(startTime, style.periodLabelMode, style.useUtcLabelTimezone)
    int labelRank = levelLabelRank(levelName, style, isLive, isLast)
    int effectiveLineWidth = effectiveLevelLineWidth(lineWidth, style, sweptDenote)
    // Swept levels are tagged by the swept-line reminders below, never here, or they draw the same name twice.
    if not isLive and not sweptDenote and levelName != LABEL_ALTERNATE_POC
        int visibleEndTime = extendRight ? time : endTime
        string anchorLabelName = isLast ? style.labelLast + " " + levelName : style.labelAnchor + " " + levelName + " " + dateText
        color anchorReminderTextColor = fadeColor(labelTextColor, anchorReminderFadePercent / 100.0)
        [_, anchorRunMs] = anchorReminderRun(anchorEndTime, visibleEndTime)
        if anchorLevelLabelMode != ANCHOR_LABEL_MODE_OFF and anchorRunMs > 0
            array.push(pendingAnchorReminders, PendingAnchorReminder.new(price, anchorEndTime, visibleEndTime, anchorLabelName, anchorReminderTextColor, style.levelLabelBgColor, style.levelLabelSize, levelName, labelRank, effectiveLineWidth))
    if sweptDenote
        line sweptContinuationLine = line.new(x1=endTime, y1=price, x2=time, y2=price, xloc=xloc.bar_time, extend=extend.right, color=sweptContinuationColor, width=style.sweptContinuationWidth, style=line.style_dashed)
        bool sweptContinuationRetained = trackLine(sweptContinuationLine)
        activeLine := sweptContinuationRetained ? sweptContinuationLine : na
        activeLineColor := sweptContinuationRetained ? sweptContinuationColor : na
    // Touched identities reuse the normal right-edge merge only while Touch Marker Labels are active.
    if extendRight or sweptDenote or hitTraceActive
        string priceText = str.tostring(price, format.mintick)
        string detailsText = levelIdentity(startTime, style, isLive, isLast, levelName, sweptDenote, false) + (hitTraceActive and archivedTouch ? " " + LEVEL_HIT_ARCHIVED_SYMBOL : "")
        string touchKey = isLive ? "" : levelHitKey(levelHitSourceProfileKey(startTime, anchorEndTime, style), levelName)
        // Buffer the right-edge label instead of drawing it; flushPendingLabels merges coincident prices.
        array.push(pendingLabels, PendingLabel.new(price, bar_index + style.levelLabelOffset, anchorEndTime, touchKey, detailsText, priceText, style.showPrice, hitTraceActive, labelTextColor, style.levelLabelBgColor, style.levelLabelSize, labelRank, effectiveLineWidth, activeLine, activeLineColor))
        // Last and live profiles are self-evident, so only older completed profiles carry a date.
        if sweptDenote
            string reminderName = isLive ? style.labelLive + " " + levelName : isLast ? style.labelLast + " " + levelName : style.labelAnchor + " " + levelName + " " + dateText
            array.push(pendingReminders, PendingReminder.new(price, endTime, reminderName, labelTextColor, style.levelLabelBgColor, style.levelLabelSize, levelName, labelRank, effectiveLineWidth))

// Merge nearby right-edge labels; one active contributor supplies the visual carrier.
flushPendingLabels(bool dedupe, map<string, int> touchClusters) =>
    int pendingCount = array.size(pendingLabels)
    if pendingCount > 0
        map<int, int> touchGroupLabelClusters = map.new<int, int>()
        array<float> clusterPrice = array.new<float>()
        array<bool> clusterWantPrice = array.new<bool>()
        array<bool> clusterHitTrace = array.new<bool>()
        array<string> clusterPriceText = array.new<string>()
        array<color> clusterColor = array.new<color>()
        array<color> clusterBg = array.new<color>()
        array<string> clusterSize = array.new<string>()
        array<int> clusterX = array.new<int>()
        array<int> clusterRecencyTime = array.new<int>()
        array<int> clusterDominantWidth = array.new<int>()
        array<int> clusterDominantRank = array.new<int>()
        array<int> clusterDominantOrder = array.new<int>()
        array<int> clusterDominantPending = array.new<int>()
        array<bool> clusterDominantHasActiveLine = array.new<bool>()
        array<int> pendingCluster = array.new<int>(pendingCount, -1)
        array<int> identityCluster = array.new<int>()
        array<string> identityName = array.new<string>()
        array<int> identityPriority = array.new<int>()
        array<int> identityWidth = array.new<int>()
        array<int> identityRank = array.new<int>()
        array<int> identityOrder = array.new<int>()
        for pendingIndex = 0 to pendingCount - 1
            PendingLabel pending = array.get(pendingLabels, pendingIndex)
            int touchGroup = pending.touchKey != "" and map.contains(touchClusters, pending.touchKey) ? map.get(touchClusters, pending.touchKey) : -1
            int foundIndex = touchGroup >= 0 and map.contains(touchGroupLabelClusters, touchGroup) ? map.get(touchGroupLabelClusters, touchGroup) : nearestLabelCluster(pending.price, dedupe, clusterPrice)
            if foundIndex >= 0
                array.set(clusterRecencyTime, foundIndex, math.max(array.get(clusterRecencyTime, foundIndex), pending.recencyTime))
                array.set(clusterWantPrice, foundIndex, array.get(clusterWantPrice, foundIndex) or pending.wantPrice)
                array.set(clusterHitTrace, foundIndex, array.get(clusterHitTrace, foundIndex) or pending.hitTrace)
                array.set(clusterSize, foundIndex, largerLabelSize(array.get(clusterSize, foundIndex), pending.sizeName))
                bool pendingHasActiveLine = not na(pending.activeLine)
                bool dominantHasActiveLine = array.get(clusterDominantHasActiveLine, foundIndex)
                bool pendingPrecedes = (pendingHasActiveLine and not dominantHasActiveLine) or (pendingHasActiveLine == dominantHasActiveLine and identityPrecedes(pending.effectiveLineWidth, pending.rank, pendingIndex, array.get(clusterDominantWidth, foundIndex), array.get(clusterDominantRank, foundIndex), array.get(clusterDominantOrder, foundIndex)))
                if pendingPrecedes
                    array.set(clusterColor, foundIndex, pending.textColor)
                    array.set(clusterBg, foundIndex, pending.bgColor)
                    array.set(clusterPrice, foundIndex, pending.price)
                    array.set(clusterPriceText, foundIndex, pending.pricePart)
                    array.set(clusterX, foundIndex, pending.xPos)
                    array.set(clusterDominantWidth, foundIndex, pending.effectiveLineWidth)
                    array.set(clusterDominantRank, foundIndex, pending.rank)
                    array.set(clusterDominantOrder, foundIndex, pendingIndex)
                    array.set(clusterDominantPending, foundIndex, pendingIndex)
                    array.set(clusterDominantHasActiveLine, foundIndex, pendingHasActiveLine)
            else
                array.push(clusterPrice, pending.price)
                array.push(clusterWantPrice, pending.wantPrice)
                array.push(clusterHitTrace, pending.hitTrace)
                array.push(clusterPriceText, pending.pricePart)
                array.push(clusterColor, pending.textColor)
                array.push(clusterBg, pending.bgColor)
                array.push(clusterSize, pending.sizeName)
                array.push(clusterX, pending.xPos)
                array.push(clusterRecencyTime, pending.recencyTime)
                array.push(clusterDominantWidth, pending.effectiveLineWidth)
                array.push(clusterDominantRank, pending.rank)
                array.push(clusterDominantOrder, pendingIndex)
                array.push(clusterDominantPending, pendingIndex)
                array.push(clusterDominantHasActiveLine, not na(pending.activeLine))
                foundIndex := array.size(clusterPrice) - 1
            if touchGroup >= 0
                map.put(touchGroupLabelClusters, touchGroup, foundIndex)
            array.set(pendingCluster, pendingIndex, foundIndex)
            if pending.namePart != ""
                array.push(identityCluster, foundIndex)
                array.push(identityName, pending.namePart)
                array.push(identityPriority, 0)
                array.push(identityWidth, pending.effectiveLineWidth)
                array.push(identityRank, pending.rank)
                array.push(identityOrder, pendingIndex)
        if dedupe and mergedLineFadePercent > 0
            float mergedLineFadeFraction = mergedLineFadePercent / 100.0
            for pendingIndex = 0 to pendingCount - 1
                int clusterIndex = array.get(pendingCluster, pendingIndex)
                if pendingIndex != array.get(clusterDominantPending, clusterIndex)
                    PendingLabel pending = array.get(pendingLabels, pendingIndex)
                    // Defends the setter if a future tracker policy removes retained lines mid-pass.
                    if not na(pending.activeLine) and array.includes(drawnLines, pending.activeLine)
                        line.set_color(pending.activeLine, fadeColor(pending.activeLineColor, mergedLineFadeFraction))
        int clusterCount = array.size(clusterPrice)
        array<bool> clusterRendered = array.new<bool>(clusterCount, false)
        for renderPosition = 0 to clusterCount - 1
            if array.size(drawnLabels) >= INDICATOR_MAX_LABELS
                break
            int clusterIndex = newestUnusedIndex(clusterRecencyTime, clusterRendered)
            if clusterIndex >= 0
                array.set(clusterRendered, clusterIndex, true)
                string body = orderedClusterIdentities(clusterIndex, LABEL_NAME_SEPARATOR, pendingCount, identityCluster, identityName, identityPriority, identityWidth, identityRank, identityOrder)
                string labelText = array.get(clusterWantPrice, clusterIndex) ? (body == "" ? array.get(clusterPriceText, clusterIndex) : body + " " + BRAND_BULLET + " " + array.get(clusterPriceText, clusterIndex)) : body
                string finalText = array.get(clusterHitTrace, clusterIndex) ? "● " + labelText : labelText
                trackLabel(label.new(array.get(clusterX, clusterIndex), array.get(clusterPrice, clusterIndex), finalText, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, textcolor=array.get(clusterColor, clusterIndex), size=toLabelSize(array.get(clusterSize, clusterIndex)), color=array.get(clusterBg, clusterIndex)))
        array.clear(pendingLabels)

// Merge coincident active anchor reminders before applying their sparse placement geometry.
flushPendingAnchorReminders(bool dedupe) =>
    int pendingCount = array.size(pendingAnchorReminders)
    if pendingCount > 0
        array<float> clusterPrice = array.new<float>()
        array<int> clusterAnchorEndTime = array.new<int>()
        array<int> clusterRunEndTime = array.new<int>()
        array<color> clusterColor = array.new<color>()
        array<color> clusterBg = array.new<color>()
        array<string> clusterSize = array.new<string>()
        array<string> clusterLevelName = array.new<string>()
        array<int> clusterDominantWidth = array.new<int>()
        array<int> clusterDominantRank = array.new<int>()
        array<int> clusterDominantOrder = array.new<int>()
        array<int> identityCluster = array.new<int>()
        array<string> identityName = array.new<string>()
        array<int> identityPriority = array.new<int>()
        array<int> identityWidth = array.new<int>()
        array<int> identityRank = array.new<int>()
        array<int> identityOrder = array.new<int>()
        for reminderIndex = 0 to pendingCount - 1
            PendingAnchorReminder pending = array.get(pendingAnchorReminders, reminderIndex)
            int foundIndex = nearestLabelCluster(pending.price, dedupe, clusterPrice)
            if foundIndex >= 0
                array.set(clusterSize, foundIndex, largerLabelSize(array.get(clusterSize, foundIndex), pending.sizeName))
                if identityPrecedes(pending.effectiveLineWidth, pending.rank, reminderIndex, array.get(clusterDominantWidth, foundIndex), array.get(clusterDominantRank, foundIndex), array.get(clusterDominantOrder, foundIndex))
                    array.set(clusterPrice, foundIndex, pending.price)
                    array.set(clusterAnchorEndTime, foundIndex, pending.anchorEndTime)
                    array.set(clusterRunEndTime, foundIndex, pending.runEndTime)
                    array.set(clusterColor, foundIndex, pending.textColor)
                    array.set(clusterBg, foundIndex, pending.bgColor)
                    array.set(clusterLevelName, foundIndex, pending.levelName)
                    array.set(clusterDominantWidth, foundIndex, pending.effectiveLineWidth)
                    array.set(clusterDominantRank, foundIndex, pending.rank)
                    array.set(clusterDominantOrder, foundIndex, reminderIndex)
            else
                array.push(clusterPrice, pending.price)
                array.push(clusterAnchorEndTime, pending.anchorEndTime)
                array.push(clusterRunEndTime, pending.runEndTime)
                array.push(clusterColor, pending.textColor)
                array.push(clusterBg, pending.bgColor)
                array.push(clusterSize, pending.sizeName)
                array.push(clusterLevelName, pending.levelName)
                array.push(clusterDominantWidth, pending.effectiveLineWidth)
                array.push(clusterDominantRank, pending.rank)
                array.push(clusterDominantOrder, reminderIndex)
                foundIndex := array.size(clusterPrice) - 1
            array.push(identityCluster, foundIndex)
            array.push(identityName, pending.namePart)
            array.push(identityPriority, 0)
            array.push(identityWidth, pending.effectiveLineWidth)
            array.push(identityRank, pending.rank)
            array.push(identityOrder, reminderIndex)
        for clusterIndex = 0 to array.size(clusterPrice) - 1
            string reminderText = orderedClusterIdentities(clusterIndex, LABEL_NAME_SEPARATOR, pendingCount, identityCluster, identityName, identityPriority, identityWidth, identityRank, identityOrder)
            renderAnchorLevelReminders(array.get(clusterAnchorEndTime, clusterIndex), array.get(clusterRunEndTime, clusterIndex), array.get(clusterPrice, clusterIndex), reminderText, array.get(clusterLevelName, clusterIndex), array.get(clusterColor, clusterIndex), array.get(clusterBg, clusterIndex), array.get(clusterSize, clusterIndex))
        array.clear(pendingAnchorReminders)

// Merge coincident swept reminders and space repeats sublinearly by run length.
flushPendingReminders(bool dedupe) =>
    int reminderCount = array.size(pendingReminders)
    if reminderCount > 0
        array<float> clusterPrice = array.new<float>()
        array<int> clusterEndTime = array.new<int>()
        array<color> clusterColor = array.new<color>()
        array<color> clusterBg = array.new<color>()
        array<string> clusterSize = array.new<string>()
        array<string> clusterLevelName = array.new<string>()
        array<int> clusterDominantWidth = array.new<int>()
        array<int> clusterDominantRank = array.new<int>()
        array<int> clusterDominantOrder = array.new<int>()
        array<int> identityCluster = array.new<int>()
        array<string> identityName = array.new<string>()
        array<int> identityPriority = array.new<int>()
        array<int> identityWidth = array.new<int>()
        array<int> identityRank = array.new<int>()
        array<int> identityOrder = array.new<int>()
        for reminderIndex = 0 to reminderCount - 1
            PendingReminder pending = array.get(pendingReminders, reminderIndex)
            int foundIndex = nearestLabelCluster(pending.price, dedupe, clusterPrice)
            if foundIndex >= 0
                array.set(clusterEndTime, foundIndex, math.min(array.get(clusterEndTime, foundIndex), pending.endTime))
                array.set(clusterSize, foundIndex, largerLabelSize(array.get(clusterSize, foundIndex), pending.sizeName))
                if identityPrecedes(pending.effectiveLineWidth, pending.rank, reminderIndex, array.get(clusterDominantWidth, foundIndex), array.get(clusterDominantRank, foundIndex), array.get(clusterDominantOrder, foundIndex))
                    array.set(clusterColor, foundIndex, pending.textColor)
                    array.set(clusterBg, foundIndex, pending.bgColor)
                    array.set(clusterLevelName, foundIndex, pending.levelName)
                    array.set(clusterPrice, foundIndex, pending.price)
                    array.set(clusterDominantWidth, foundIndex, pending.effectiveLineWidth)
                    array.set(clusterDominantRank, foundIndex, pending.rank)
                    array.set(clusterDominantOrder, foundIndex, reminderIndex)
            else
                array.push(clusterPrice, pending.price)
                array.push(clusterEndTime, pending.endTime)
                array.push(clusterColor, pending.textColor)
                array.push(clusterBg, pending.bgColor)
                array.push(clusterSize, pending.sizeName)
                array.push(clusterLevelName, pending.levelName)
                array.push(clusterDominantWidth, pending.effectiveLineWidth)
                array.push(clusterDominantRank, pending.rank)
                array.push(clusterDominantOrder, reminderIndex)
                foundIndex := array.size(clusterPrice) - 1
            array.push(identityCluster, foundIndex)
            array.push(identityName, pending.namePart)
            array.push(identityPriority, 0)
            array.push(identityWidth, pending.effectiveLineWidth)
            array.push(identityRank, pending.rank)
            array.push(identityOrder, reminderIndex)
        for clusterIndex = 0 to array.size(clusterPrice) - 1
            int endTime = array.get(clusterEndTime, clusterIndex)
            // Trailing margin keeps a tag off the right-edge label, which already names the level there.
            int sweptRunMs = (time - SWEPT_REMINDER_BASE_MS) - endTime
            if sweptRunMs > 0
                int runReminderCount = reminderPlacements(sweptRunMs, SWEPT_REMINDER_BASE_MS, SWEPT_REMINDER_MAX_PER_LINE)
                // Phase offsets interleave level types across each reminder run.
                string levelName = array.get(clusterLevelName, clusterIndex)
                float levelFrac = levelName == LABEL_VAH ? 0.4 : levelName == LABEL_VAL ? 0.6 : levelName == LABEL_ALTERNATE_POC ? 0.8 : 0.2
                float price = array.get(clusterPrice, clusterIndex)
                string reminderText = orderedClusterIdentities(clusterIndex, LABEL_NAME_SEPARATOR, reminderCount, identityCluster, identityName, identityPriority, identityWidth, identityRank, identityOrder)
                color textColor = array.get(clusterColor, clusterIndex)
                color bgColor = array.get(clusterBg, clusterIndex)
                string sizeName = array.get(clusterSize, clusterIndex)
                for placement = 1 to runReminderCount
                    int reminderTime = endTime + int(sweptRunMs * (placement - 1 + levelFrac) / runReminderCount)
                    trackLabel(label.new(reminderTime, price, reminderText, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, textcolor=textColor, size=toLabelSize(sizeName), color=bgColor))
        array.clear(pendingReminders)

pruneLevelHitEvents(array<LevelHitEvent> events, bool tracePresentationActive, map<string, bool> retainedSourceProfiles) =>
    if not tracePresentationActive
        array.clear(events)
    else if array.size(events) > 0
        for eventIndex = array.size(events) - 1 to 0
            LevelHitEvent hitEvent = array.get(events, eventIndex)
            bool sourceProfileRetained = map.contains(retainedSourceProfiles, hitEvent.sourceProfileKey)
            if not levelHitTraceActive(hitEvent.hitTime, tracePresentationActive) or not sourceProfileRetained
                array.remove(events, eventIndex)
    true

levelHitArchivedSwept(LevelHitEvent hitEvent, LevelHitPresentation presentation) =>
    hitEvent.archivedSwept and not presentation.lineVisibleAtLiveEdge

registerArchivedLevelHitKeys(array<LevelHitEvent> events, map<string, LevelHitPresentation> presentations, map<string, bool> archivedLevelHitKeys) =>
    map.clear(archivedLevelHitKeys)
    if array.size(events) > 0
        for eventIndex = 0 to array.size(events) - 1
            LevelHitEvent hitEvent = array.get(events, eventIndex)
            if sameNyDate(hitEvent.hitTime, time) and map.contains(presentations, hitEvent.key) and levelHitArchivedSwept(hitEvent, map.get(presentations, hitEvent.key))
                map.put(archivedLevelHitKeys, hitEvent.key, true)
    true

levelHitEventGroups(array<LevelHitEvent> events, bool tracePresentationActive, map<string, bool> renderedLevelHitKeys, map<string, LevelHitPresentation> presentations) =>
    int eventCount = array.size(events)
    array<int> eventGroups = array.new<int>(eventCount, -1)
    array<int> groupBarTimes = array.new<int>()
    array<float> groupPrices = array.new<float>()
    if tracePresentationActive and eventCount > 0
        for eventIndex = 0 to eventCount - 1
            LevelHitEvent hitEvent = array.get(events, eventIndex)
            bool focusSourceVisible = not hitEvent.focusOnly or map.contains(renderedLevelHitKeys, hitEvent.key)
            if levelHitTraceActive(hitEvent.hitTime, tracePresentationActive) and focusSourceVisible and map.contains(presentations, hitEvent.key)
                int groupIndex = -1
                float tolerance = labelMergeTolerance(hitEvent.price)
                if array.size(groupBarTimes) > 0
                    for candidateIndex = 0 to array.size(groupBarTimes) - 1
                        bool sameCandle = array.get(groupBarTimes, candidateIndex) == hitEvent.barTime
                        bool samePrice = math.abs(array.get(groupPrices, candidateIndex) - hitEvent.price) <= tolerance
                        if sameCandle and samePrice
                            groupIndex := candidateIndex
                            break
                if groupIndex < 0
                    array.push(groupBarTimes, hitEvent.barTime)
                    array.push(groupPrices, hitEvent.price)
                    groupIndex := array.size(groupBarTimes) - 1
                array.set(eventGroups, eventIndex, groupIndex)
    eventGroups

registerLevelHitLabelClusters(array<LevelHitEvent> events, array<int> eventGroups, map<string, int> touchClusters) =>
    map.clear(touchClusters)
    if array.size(events) > 0
        for eventIndex = 0 to array.size(events) - 1
            int groupIndex = array.get(eventGroups, eventIndex)
            if groupIndex >= 0
                map.put(touchClusters, array.get(events, eventIndex).key, groupIndex)
    true

bufferLevelHitLabels(array<LevelHitEvent> events, bool labelsActive, map<string, bool> renderedLevelHitKeys, map<string, LevelHitPresentation> presentations) =>
    if labelsActive and array.size(events) > 0
        map<string, bool> bufferedKeys = map.new<string, bool>()
        for eventIndex = array.size(events) - 1 to 0
            LevelHitEvent hitEvent = array.get(events, eventIndex)
            bool focusSourceVisible = not hitEvent.focusOnly or map.contains(renderedLevelHitKeys, hitEvent.key)
            bool presentationAvailable = map.contains(presentations, hitEvent.key)
            bool alreadyVisible = map.contains(renderedLevelHitKeys, hitEvent.key)
            bool alreadyBuffered = map.contains(bufferedKeys, hitEvent.key)
            if sameNyDate(hitEvent.hitTime, time) and focusSourceVisible and presentationAvailable and not alreadyVisible and not alreadyBuffered
                LevelHitPresentation presentation = map.get(presentations, hitEvent.key)
                bool archived = levelHitArchivedSwept(hitEvent, presentation)
                string priceText = str.tostring(hitEvent.price, format.mintick)
                string labelIdentity = presentation.labelIdentity + (hitEvent.unselectedAnchor ? " " + LEVEL_HIT_UNSELECTED_ANCHOR_SYMBOL : "") + (archived ? " " + LEVEL_HIT_ARCHIVED_SYMBOL : "")
                array.push(pendingLabels, PendingLabel.new(hitEvent.price, bar_index + presentation.labelOffset, hitEvent.hitTime, hitEvent.key, labelIdentity, priceText, presentation.showPrice, true, presentation.labelColor, presentation.labelBgColor, presentation.labelSize, presentation.rank, presentation.effectiveLineWidth, na, na))
                map.put(bufferedKeys, hitEvent.key, true)
    true

twoDigitText(int value) =>
    (value < 10 ? "0" : "") + str.tostring(value)

levelHitTimeText(int hitTime) =>
    twoDigitText(hour(hitTime, NY_TIMEZONE)) + ":" + twoDigitText(minute(hitTime, NY_TIMEZONE)) + " NY"

// Same-candle hits within label tolerance always share one circle and right-edge label cluster.
renderLevelHitCircles(array<LevelHitEvent> events, array<int> eventGroups, map<string, LevelHitPresentation> presentations) =>
    int eventCount = array.size(events)
    if eventCount > 0
        array<int> groupBarTimes = array.new<int>()
        array<int> groupHitTimes = array.new<int>()
        array<float> groupPrices = array.new<float>()
        array<color> groupColors = array.new<color>()
        array<string> groupSizes = array.new<string>()
        array<int> groupDominantPriority = array.new<int>()
        array<int> groupDominantWidth = array.new<int>()
        array<int> groupDominantRank = array.new<int>()
        array<int> groupDominantOrder = array.new<int>()
        array<int> identityGroup = array.new<int>()
        array<string> identityName = array.new<string>()
        array<int> identityPriority = array.new<int>()
        array<int> identityWidth = array.new<int>()
        array<int> identityRank = array.new<int>()
        array<int> identityOrder = array.new<int>()
        for eventIndex = 0 to eventCount - 1
            int groupIndex = array.get(eventGroups, eventIndex)
            LevelHitEvent hitEvent = array.get(events, eventIndex)
            if groupIndex >= 0 and map.contains(presentations, hitEvent.key)
                LevelHitPresentation presentation = map.get(presentations, hitEvent.key)
                bool archived = levelHitArchivedSwept(hitEvent, presentation)
                if groupIndex < array.size(groupBarTimes)
                    bool presentationPrecedes = prioritizedIdentityPrecedes(presentation.anchorPriority, presentation.effectiveLineWidth, presentation.rank, eventIndex, array.get(groupDominantPriority, groupIndex), array.get(groupDominantWidth, groupIndex), array.get(groupDominantRank, groupIndex), array.get(groupDominantOrder, groupIndex))
                    if presentationPrecedes
                        array.set(groupColors, groupIndex, presentation.lineColor)
                        array.set(groupSizes, groupIndex, presentation.circleSize)
                        array.set(groupDominantPriority, groupIndex, presentation.anchorPriority)
                        array.set(groupDominantWidth, groupIndex, presentation.effectiveLineWidth)
                        array.set(groupDominantRank, groupIndex, presentation.rank)
                        array.set(groupDominantOrder, groupIndex, eventIndex)
                else
                    array.push(groupBarTimes, hitEvent.barTime)
                    array.push(groupHitTimes, hitEvent.hitTime)
                    array.push(groupPrices, hitEvent.price)
                    array.push(groupColors, presentation.lineColor)
                    array.push(groupSizes, presentation.circleSize)
                    array.push(groupDominantPriority, presentation.anchorPriority)
                    array.push(groupDominantWidth, presentation.effectiveLineWidth)
                    array.push(groupDominantRank, presentation.rank)
                    array.push(groupDominantOrder, eventIndex)
                array.push(identityGroup, groupIndex)
                string annotatedIdentity = presentation.identity + (hitEvent.unselectedAnchor ? " " + LEVEL_HIT_UNSELECTED_ANCHOR_SYMBOL : "") + (archived ? " " + LEVEL_HIT_ARCHIVED_SYMBOL : "")
                array.push(identityName, annotatedIdentity)
                array.push(identityPriority, presentation.anchorPriority)
                array.push(identityWidth, presentation.effectiveLineWidth)
                array.push(identityRank, presentation.rank)
                array.push(identityOrder, eventIndex)
        if array.size(groupBarTimes) > 0
            for groupIndex = array.size(groupBarTimes) - 1 to 0
                int barTime = array.get(groupBarTimes, groupIndex)
                int hitTime = array.get(groupHitTimes, groupIndex)
                float hitPrice = array.get(groupPrices, groupIndex)
                color hitColor = array.get(groupColors, groupIndex)
                string identities = orderedClusterIdentities(groupIndex, "\n", eventCount, identityGroup, identityName, identityPriority, identityWidth, identityRank, identityOrder)
                string tooltipText = identities + "\nHit " + levelHitTimeText(hitTime)
                trackLabel(label.new(barTime, hitPrice, "●", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_none, color=na, textcolor=color.new(hitColor, 0), size=toLabelSize(array.get(groupSizes, groupIndex)), tooltip=tooltipText))
    true

// Scale visible opacity so fading respects the base transparency.
dimLevelColor(color baseColor, bool touched, bool dimTouched, float dimFraction) =>
    touched and dimTouched ? fadeColor(baseColor, dimFraction) : baseColor

// Draw each contiguous histogram run as one borderless filled polyline.
pushHistogramPolyline(array<chart.point> points, color fillColor) =>
    if array.size(points) >= 3
        trackPolyline(polyline.new(points, curved=false, closed=true, xloc=xloc.bar_time, line_color=color.new(fillColor, 100), fill_color=fillColor))

// Later of two breach timestamps, ignoring na so an unswept level never wins.
maxBreachTime(int a, int b) =>
    int result = na(a) ? b : na(b) ? a : int(math.max(a, b))
    result

// Most recent sweep across the profile's levels; na when none are swept.
profileLastBreach(Profile profile) =>
    int latest = maxBreachTime(profile.pocBreachTime, profile.valueAreaHighBreachTime)
    latest := maxBreachTime(latest, profile.valueAreaLowBreachTime)
    latest := profile.hasAlternatePoc ? maxBreachTime(latest, profile.alternatePocBreachTime) : latest
    latest

profileSweptContinuationVisible(Profile profile, bool isMostRecentCompleted, string extensionMode, int sweptKeepMs, bool focusSurfaced) =>
    int lastBreach = profileLastBreach(profile)
    bool withinKeepWindow = sweptKeepMs > 0 and not na(lastBreach) and time - lastBreach <= sweptKeepMs
    extensionMode == LEVEL_BREACH_SWEEP and (isMostRecentCompleted or focusSurfaced or withinKeepWindow)

// The value area splits the silhouette into at most three runs (below/inside/above VA), one polyline each.
histogramRunCount(Profile profile) =>
    not profile.isValid ? 0 : (profile.valueAreaLowRow > 0 ? 1 : 0) + 1 + (profile.valueAreaHighRow < profile.rowCount - 1 ? 1 : 0)

focusDirectionMatches(float levelPrice, float focusPrice, string focusDirection) =>
    focusDirection == FOCUS_DIRECTION_BELOW ? levelPrice <= focusPrice : focusDirection == FOCUS_DIRECTION_ABOVE ? levelPrice >= focusPrice : focusDirection == FOCUS_DIRECTION_AROUND

// Ignores levels on the unwanted side of the anchor.
nearerFocusDistance(float current, float levelPrice, float focusPrice, string focusDirection) =>
    float candidate = not na(levelPrice) and focusDirectionMatches(levelPrice, focusPrice, focusDirection) ? math.abs(focusPrice - levelPrice) : na
    na(candidate) ? current : na(current) ? candidate : math.min(current, candidate)

// na when the profile has no enabled level on the requested side.
profileFocusDistance(Profile profile, SessionStyle style, float focusPrice, string focusDirection) =>
    float nearest = na
    if profile.isValid
        if style.showPoc
            nearest := nearerFocusDistance(nearest, profile.pocPrice, focusPrice, focusDirection)
        if style.showAlternatePoc and profile.hasAlternatePoc
            nearest := nearerFocusDistance(nearest, profile.alternatePocPrice, focusPrice, focusDirection)
        if style.showValueArea
            nearest := nearerFocusDistance(nearest, profile.valueAreaHighPrice, focusPrice, focusDirection)
            nearest := nearerFocusDistance(nearest, profile.valueAreaLowPrice, focusPrice, focusDirection)
    nearest

// An unplaced manual anchor falls back to price.
focusAnchorPrice(string anchorMode, float manualPrice, bool manualPlaced, float currentPrice) =>
    anchorMode == FOCUS_ANCHOR_MANUAL and manualPlaced ? manualPrice : currentPrice

renderBudgetProfileAllowed(RenderBudgetAnchor anchor, int profileIndex) =>
    not anchor.restrictToFocus or array.get(anchor.focusSelections, profileIndex)

anchorSurfacesSweptLevels(RenderBudgetAnchor anchor, int profileIndex) =>
    anchor.restrictToFocus and anchor.surfaceSweptLevels and array.get(anchor.focusSelections, profileIndex)

// Ties resolve to the newer profile.
focusCandidateOutranks(FocusCandidate candidate, FocusCandidate other) =>
    candidate.distance != other.distance ? candidate.distance < other.distance : candidate.endTime > other.endTime

// Bounded insertion: a deep search never grows past the requested count.
retainFocusCandidate(array<FocusCandidate> ranked, FocusCandidate candidate, int focusCount) =>
    int rankedCount = array.size(ranked)
    bool admitted = rankedCount < focusCount
    if not admitted and rankedCount > 0
        admitted := focusCandidateOutranks(candidate, array.last(ranked))
    if admitted
        int insertAt = rankedCount
        if rankedCount > 0
            for scanIndex = 0 to rankedCount - 1
                if focusCandidateOutranks(candidate, array.get(ranked, scanIndex))
                    insertAt := scanIndex
                    break
        if insertAt >= rankedCount
            array.push(ranked, candidate)
        else
            array.insert(ranked, insertAt, candidate)
        if array.size(ranked) > focusCount
            array.pop(ranked)
    admitted

// Each anchor ranks independently; RTH and Globex are produced in pairs and get their own allowance.
selectFocusedProfiles(array<RenderBudgetAnchor> anchors, int dailyAnchorCount, float focusPrice, string focusDirection, int focusCount) =>
    int anchorLimit = math.min(dailyAnchorCount, array.size(anchors))
    // Sized before any early exit so a restricted anchor is never read past its end.
    if anchorLimit > 0
        for anchorIndex = 0 to anchorLimit - 1
            RenderBudgetAnchor anchor = array.get(anchors, anchorIndex)
            array.clear(anchor.focusSelections)
            if anchor.restrictToFocus and array.size(anchor.profiles) > 0
                for profileIndex = 0 to array.size(anchor.profiles) - 1
                    array.push(anchor.focusSelections, false)
    if anchorLimit > 0 and focusCount > 0 and not na(focusPrice)
        for anchorIndex = 0 to anchorLimit - 1
            RenderBudgetAnchor anchor = array.get(anchors, anchorIndex)
            if anchor.restrictToFocus and array.size(anchor.profiles) > 0
                array<FocusCandidate> ranked = array.new<FocusCandidate>()
                for profileIndex = 0 to array.size(anchor.profiles) - 1
                    Profile profile = array.get(anchor.profiles, profileIndex)
                    float distance = profileFocusDistance(profile, anchor.style, focusPrice, focusDirection)
                    if not na(distance)
                        retainFocusCandidate(ranked, FocusCandidate.new(distance, profileIndex, profile.endTime), focusCount)
                if array.size(ranked) > 0
                    for rankedIndex = 0 to array.size(ranked) - 1
                        array.set(anchor.focusSelections, array.get(ranked, rankedIndex).profileIndex, true)
    true

// A manual anchor draws its own reference line, tagged in the right margin so it can be found and dragged.
renderFocusAnchor(bool anchorVisible, float anchorPrice, bool anchorPlaced, color anchorColor, int anchorWidth, int anchorLabelOffset) =>
    if anchorVisible and not na(anchorPrice) and anchorPrice > 0
        trackLine(line.new(time[1], anchorPrice, time, anchorPrice, xloc=xloc.bar_time, extend=extend.both, color=anchorColor, width=anchorWidth, style=line.style_solid))
        string anchorText = (anchorPlaced ? LABEL_FOCUS_ANCHOR : LABEL_FOCUS_ANCHOR_UNSET) + " " + str.tostring(anchorPrice, format.mintick)
        trackLabel(label.new(bar_index + anchorLabelOffset, anchorPrice, anchorText, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, textcolor=anchorColor, size=size.small, color=levelLabelBgColor))
    true

// Must mirror every level-line emission path in renderProfile and drawLevel.
profileLineCount(Profile profile, SessionStyle style, bool isMostRecentCompleted, bool focusSurfaced) =>
    int lineCount = 0
    if not na(profile)
        if profile.isValid
            bool profileDenote = profileSweptContinuationVisible(profile, isMostRecentCompleted, style.extensionMode, style.sweptKeepMs, focusSurfaced)
            if style.showPoc
                lineCount += 1 + (profileDenote and not na(profile.pocBreachTime) ? 1 : 0)
            if style.showAlternatePoc and profile.hasAlternatePoc
                lineCount += 1 + (profileDenote and not na(profile.alternatePocBreachTime) ? 1 : 0)
            if style.showValueArea
                lineCount += 2
                lineCount += profileDenote and not na(profile.valueAreaHighBreachTime) ? 1 : 0
                lineCount += profileDenote and not na(profile.valueAreaLowBreachTime) ? 1 : 0
    lineCount

liveProfileLineCount(Profile profile, bool enabled, SessionStyle style) =>
    enabled and not na(profile) ? profileLineCount(profile, style, false, false) : 0

newestCandidateEndTime(array<Profile> profiles, int candidateIndex) =>
    candidateIndex >= 0 ? nz(array.get(profiles, candidateIndex).endTime, -1) : -1

// Allocate a completed-profile drawing budget newest-first; registration order breaks ties.
anchorHistogramCost(RenderBudgetAnchor anchor) =>
    int cost = 0
    if anchor.histogramEnabled and array.size(anchor.profiles) > 0
        for profileIndex = 0 to array.size(anchor.profiles) - 1
            if renderBudgetProfileAllowed(anchor, profileIndex)
                cost += histogramRunCount(array.get(anchor.profiles, profileIndex))
    cost

totalHistogramCost(array<RenderBudgetAnchor> anchors) =>
    int cost = 0
    if array.size(anchors) > 0
        for anchorIndex = 0 to array.size(anchors) - 1
            cost += anchorHistogramCost(array.get(anchors, anchorIndex))
    cost

// The allocator drops oldest first, which would discard the closest focus profiles. Trim the farthest
// up front so ranking survives and the allocator has nothing left to cut.
trimFocusToBudget(array<RenderBudgetAnchor> anchors, int dailyAnchorCount, float focusPrice, string focusDirection, int budget) =>
    int anchorLimit = math.min(dailyAnchorCount, array.size(anchors))
    if anchorLimit > 0
        bool trimming = true
        while trimming and totalHistogramCost(anchors) > budget
            int farthestAnchorIndex = -1
            int farthestProfileIndex = -1
            float farthestDistance = na
            for anchorIndex = 0 to anchorLimit - 1
                RenderBudgetAnchor anchor = array.get(anchors, anchorIndex)
                if anchor.restrictToFocus and array.size(anchor.profiles) > 0
                    for profileIndex = 0 to array.size(anchor.profiles) - 1
                        if array.get(anchor.focusSelections, profileIndex)
                            float distance = profileFocusDistance(array.get(anchor.profiles, profileIndex), anchor.style, focusPrice, focusDirection)
                            if not na(distance) and (na(farthestDistance) or distance > farthestDistance)
                                farthestDistance := distance
                                farthestAnchorIndex := anchorIndex
                                farthestProfileIndex := profileIndex
            if farthestAnchorIndex < 0
                trimming := false
            else
                array.set(array.get(anchors, farthestAnchorIndex).focusSelections, farthestProfileIndex, false)
    true

allocateProfileBudget(array<RenderBudgetAnchor> anchors, int budget, bool histogramBudget) =>
    int remaining = budget
    int anchorCount = array.size(anchors)
    array<int> candidateIndices = array.new<int>(anchorCount, -1)
    for anchorIndex = 0 to anchorCount - 1
        RenderBudgetAnchor anchor = array.get(anchors, anchorIndex)
        bool enabled = histogramBudget ? anchor.histogramEnabled : anchor.levelsEnabled
        array.set(candidateIndices, anchorIndex, enabled ? array.size(anchor.profiles) - 1 : -1)
    bool exhausted = false
    while not exhausted
        int newestTime = -1
        int newestAnchorIndex = -1
        for anchorIndex = 0 to anchorCount - 1
            RenderBudgetAnchor anchor = array.get(anchors, anchorIndex)
            int candidateTime = newestCandidateEndTime(anchor.profiles, array.get(candidateIndices, anchorIndex))
            if candidateTime > newestTime
                newestTime := candidateTime
                newestAnchorIndex := anchorIndex
        if newestAnchorIndex < 0
            exhausted := true
        else
            RenderBudgetAnchor newestAnchor = array.get(anchors, newestAnchorIndex)
            int newestProfileIndex = array.get(candidateIndices, newestAnchorIndex)
            Profile chosen = array.get(newestAnchor.profiles, newestProfileIndex)
            bool isMostRecentCompleted = newestProfileIndex == array.size(newestAnchor.profiles) - 1
            bool profileAllowed = renderBudgetProfileAllowed(newestAnchor, newestProfileIndex)
            int cost = not profileAllowed ? 0 : histogramBudget ? histogramRunCount(chosen) : profileLineCount(chosen, newestAnchor.style, isMostRecentCompleted, anchorSurfacesSweptLevels(newestAnchor, newestProfileIndex))
            if cost > remaining
                exhausted := true
            else
                remaining -= cost
                array.set(candidateIndices, newestAnchorIndex, newestProfileIndex - 1)
    array<int> firstAllowedIndices = array.new<int>(anchorCount, 0)
    for anchorIndex = 0 to anchorCount - 1
        array.set(firstAllowedIndices, anchorIndex, array.get(candidateIndices, anchorIndex) + 1)
    firstAllowedIndices

profileLevelBreachTime(Profile profile, string levelName) =>
    levelName == LABEL_POC ? profile.pocBreachTime : levelName == LABEL_VAH ? profile.valueAreaHighBreachTime : levelName == LABEL_VAL ? profile.valueAreaLowBreachTime : profile.alternatePocBreachTime

levelHitAnchorPriority(string labelAnchor) =>
    labelAnchor == LABEL_QUARTERLY_ANCHOR ? 4 : labelAnchor == LABEL_MONTHLY_ANCHOR ? 3 : labelAnchor == LABEL_WEEKLY_ANCHOR ? 2 : 1

profileLevelHitPresentation(Profile profile, int profileIndex, int profileCount, SessionStyle style, bool surfaceSweptLevels, string levelName) =>
    bool isMostRecentCompleted = profileIndex == profileCount - 1
    bool sweptContinuationVisible = profileSweptContinuationVisible(profile, isMostRecentCompleted, style.extensionMode, style.sweptKeepMs, surfaceSweptLevels)
    int breachTime = profileLevelBreachTime(profile, levelName)
    bool sweptDenote = sweptContinuationVisible and not na(breachTime)
    [_, extendsRight] = levelEndpoint(profile.endTime, breachTime, style.extensionMode)
// Marker dots stay high-visibility on aged profiles, so value-area dots always use the strong color.
    color lineColor = levelName == LABEL_POC ? style.pocColor : levelName == LABEL_ALTERNATE_POC ? style.alternatePocColor : style.valueAreaLastColor
    color baseLabelColor = levelName == LABEL_POC ? style.pocLabelColor : levelName == LABEL_ALTERNATE_POC ? style.alternatePocLabelColor : style.valueAreaLabelColor
    color labelColor = sweptDenote ? fadeColor(baseLabelColor, sweptLabelTextFadePercent / 100.0) : baseLabelColor
    int lineWidth = levelName == LABEL_POC ? style.pocWidth : levelName == LABEL_ALTERNATE_POC ? style.alternatePocWidth : isMostRecentCompleted ? style.valueAreaLastWidth : style.valueAreaWidth
    LevelHitPresentation.new(levelIdentity(profile.startTime, style, false, isMostRecentCompleted, levelName, sweptDenote, true), levelIdentity(profile.startTime, style, false, isMostRecentCompleted, levelName, sweptDenote, false), lineColor, labelColor, style.levelLabelBgColor, style.showPrice, levelHitCircleSizeForAnchor(style.labelAnchor), style.levelLabelSize, style.levelLabelOffset, effectiveLevelLineWidth(lineWidth, style, sweptDenote), levelLabelRank(levelName, style, false, isMostRecentCompleted), levelHitAnchorPriority(style.labelAnchor), extendsRight or sweptDenote)

registerProfileLevelHitPresentations(map<string, LevelHitPresentation> presentations, Profile profile, int profileIndex, int profileCount, SessionStyle style, bool surfaceSweptLevels) =>
    if profile.isValid and time > profile.endTime
        string sourceProfileKey = levelHitSourceProfileKey(profile.startTime, profile.endTime, style)
        map.put(presentations, levelHitKey(sourceProfileKey, LABEL_POC), profileLevelHitPresentation(profile, profileIndex, profileCount, style, surfaceSweptLevels, LABEL_POC))
        map.put(presentations, levelHitKey(sourceProfileKey, LABEL_VAH), profileLevelHitPresentation(profile, profileIndex, profileCount, style, surfaceSweptLevels, LABEL_VAH))
        map.put(presentations, levelHitKey(sourceProfileKey, LABEL_VAL), profileLevelHitPresentation(profile, profileIndex, profileCount, style, surfaceSweptLevels, LABEL_VAL))
        if profile.hasAlternatePoc
            map.put(presentations, levelHitKey(sourceProfileKey, LABEL_ALTERNATE_POC), profileLevelHitPresentation(profile, profileIndex, profileCount, style, surfaceSweptLevels, LABEL_ALTERNATE_POC))
    true

registerAnchorLevelHitPresentations(map<string, LevelHitPresentation> presentations, RenderBudgetAnchor anchor, int fromIndex, bool active, bool selectedOnly, bool surfaceSweptLevels) =>
    int profileCount = array.size(anchor.profiles)
    if active and profileCount > 0
        for profileIndex = math.max(0, fromIndex) to profileCount - 1
            if not selectedOnly or renderBudgetProfileAllowed(anchor, profileIndex)
                registerProfileLevelHitPresentations(presentations, array.get(anchor.profiles, profileIndex), profileIndex, profileCount, anchor.style, surfaceSweptLevels)
    true

registerRenderedLevelHitKey(map<string, bool> renderedLevelHitKeys, Profile profile, SessionStyle style, string levelName, bool isLive) =>
    if not isLive
        string sourceProfileKey = levelHitSourceProfileKey(profile.startTime, profile.endTime, style)
        map.put(renderedLevelHitKeys, levelHitKey(sourceProfileKey, levelName), true)
    true

renderProfile(Profile profile, SessionStyle style, bool developingProfileActive, bool isMostRecentCompleted, bool focusSurfaced, bool isLive, bool histogramAllowed, bool levelsAllowed, bool touchLabelsActive, map<string, bool> archivedLevelHitKeys, map<string, bool> renderedLevelHitKeys) =>
    if profile.isValid
        float priceRange = profile.priceHigh - profile.priceLow
        bool useDevelopingColors = developingProfileActive and style.developingEnabled

        if style.showHistogram and histogramAllowed and profile.maxHistogramVolume > 0
            int rowCount = profile.rowCount
            float rowHeight = priceRange / rowCount
            int baselineTime = profile.startTime
            int profileMilliseconds = math.max(1, profile.endTime - profile.startTime)
            int histogramWidthMilliseconds = math.max(1, int(math.round(profileMilliseconds * HISTOGRAM_WIDTH_PERCENT * 0.01)))
            array<chart.point> points = array.new<chart.point>()
            bool runStarted = false
            bool runInsideVa = false
            for rowIndex = 0 to rowCount - 1
                bool insideVa = rowIndex >= profile.valueAreaLowRow and rowIndex <= profile.valueAreaHighRow
                float rowBottom = profile.priceLow + rowIndex * rowHeight
                float rowVolume = array.get(profile.rowVolumes, rowIndex)
                int widthMilliseconds = int(math.round(rowVolume / profile.maxHistogramVolume * histogramWidthMilliseconds))
                int outerTime = baselineTime + widthMilliseconds
                // VA membership flipped: close this run and start a new one at the same boundary.
                if runStarted and insideVa != runInsideVa
                    array.push(points, chart.point.from_time(baselineTime, rowBottom))
                    pushHistogramPolyline(points, runInsideVa ? style.histogramInsideColor : style.histogramOutsideColor)
                    points := array.new<chart.point>()
                    runStarted := false
                if not runStarted
                    runStarted := true
                    runInsideVa := insideVa
                    array.push(points, chart.point.from_time(baselineTime, rowBottom))
                array.push(points, chart.point.from_time(outerTime, rowBottom + rowHeight / 2))
                if rowIndex == rowCount - 1
                    array.push(points, chart.point.from_time(baselineTime, rowBottom + rowHeight))
                    pushHistogramPolyline(points, runInsideVa ? style.histogramInsideColor : style.histogramOutsideColor)

        if style.showSessionBox
            trackBox(box.new(left=profile.startTime, top=profile.priceHigh, right=profile.endTime, bottom=profile.priceLow, xloc=xloc.bar_time, border_width=0, bgcolor=style.sessionBoxColor))

        // Retain the newest swept profile, focus-surfaced profiles, and older profiles still inside their keep window.
        bool profileDenote = profileSweptContinuationVisible(profile, isMostRecentCompleted, style.extensionMode, style.sweptKeepMs, focusSurfaced)
        string profileHitSourceKey = isLive ? "" : levelHitSourceProfileKey(profile.startTime, profile.endTime, style)
        if levelsAllowed and style.showPoc
            [pocRight, pocExtend] = levelEndpoint(profile.endTime, profile.pocBreachTime, style.extensionMode)
            color pocBaseColor = useDevelopingColors ? style.developingColor : style.pocColor
            bool pocSweptDenote = profileDenote and not na(profile.pocBreachTime)
            color pocColor = pocSweptDenote and isMostRecentCompleted ? pocBaseColor : dimLevelColor(pocBaseColor, not na(profile.pocBreachTime), style.dimTouched, style.dimFraction)
            color pocContinuation = dimLevelColor(pocBaseColor, true, true, style.sweptContinuationFraction)
            bool pocHitTrace = touchLabelsActive and not na(profile.pocHitTime) and sameNyDate(profile.pocHitTime, time)
            bool pocArchivedTouch = not isLive and map.contains(archivedLevelHitKeys, levelHitKey(profileHitSourceKey, LABEL_POC))
            drawLevel(profile.startTime, pocRight, profile.pocPrice, pocColor, style.pocWidth, style.pocStyle, pocExtend, useDevelopingColors ? style.developingColor : style.pocLabelColor, LABEL_POC, style, pocSweptDenote, pocContinuation, pocHitTrace, pocArchivedTouch, isLive, isMostRecentCompleted, profile.endTime)
            registerRenderedLevelHitKey(renderedLevelHitKeys, profile, style, LABEL_POC, isLive)
        if levelsAllowed and style.showAlternatePoc and profile.hasAlternatePoc
            [alternateRight, alternateExtend] = levelEndpoint(profile.endTime, profile.alternatePocBreachTime, style.extensionMode)
            color alternateBaseColor = useDevelopingColors ? style.developingColor : style.alternatePocColor
            bool alternateSweptDenote = profileDenote and not na(profile.alternatePocBreachTime)
            color alternateColor = alternateSweptDenote and isMostRecentCompleted ? alternateBaseColor : dimLevelColor(alternateBaseColor, not na(profile.alternatePocBreachTime), style.dimTouched, style.dimFraction)
            color alternateContinuation = dimLevelColor(alternateBaseColor, true, true, style.sweptContinuationFraction)
            bool alternateHitTrace = touchLabelsActive and not na(profile.alternatePocHitTime) and sameNyDate(profile.alternatePocHitTime, time)
            bool alternateArchivedTouch = not isLive and map.contains(archivedLevelHitKeys, levelHitKey(profileHitSourceKey, LABEL_ALTERNATE_POC))
            drawLevel(profile.startTime, alternateRight, profile.alternatePocPrice, alternateColor, style.alternatePocWidth, style.alternatePocStyle, alternateExtend, useDevelopingColors ? style.developingColor : style.alternatePocLabelColor, LABEL_ALTERNATE_POC, style, alternateSweptDenote, alternateContinuation, alternateHitTrace, alternateArchivedTouch, isLive, isMostRecentCompleted, profile.endTime)
            registerRenderedLevelHitKey(renderedLevelHitKeys, profile, style, LABEL_ALTERNATE_POC, isLive)
        if levelsAllowed and style.showValueArea
            [valueAreaHighRight, valueAreaHighExtend] = levelEndpoint(profile.endTime, profile.valueAreaHighBreachTime, style.extensionMode)
            color valueAreaBaseColor = useDevelopingColors ? style.developingColor : isMostRecentCompleted ? style.valueAreaLastColor : style.valueAreaColor
            int valueAreaLineWidth = isMostRecentCompleted ? style.valueAreaLastWidth : style.valueAreaWidth
            bool vahSweptDenote = profileDenote and not na(profile.valueAreaHighBreachTime)
            color vahColor = vahSweptDenote and isMostRecentCompleted ? valueAreaBaseColor : dimLevelColor(valueAreaBaseColor, not na(profile.valueAreaHighBreachTime), style.dimTouched, style.dimFraction)
            color vahContinuation = dimLevelColor(valueAreaBaseColor, true, true, style.sweptContinuationFraction)
            bool vahHitTrace = touchLabelsActive and not na(profile.valueAreaHighHitTime) and sameNyDate(profile.valueAreaHighHitTime, time)
            bool vahArchivedTouch = not isLive and map.contains(archivedLevelHitKeys, levelHitKey(profileHitSourceKey, LABEL_VAH))
            drawLevel(profile.startTime, valueAreaHighRight, profile.valueAreaHighPrice, vahColor, valueAreaLineWidth, style.valueAreaStyle, valueAreaHighExtend, useDevelopingColors ? style.developingColor : style.valueAreaLabelColor, LABEL_VAH, style, vahSweptDenote, vahContinuation, vahHitTrace, vahArchivedTouch, isLive, isMostRecentCompleted, profile.endTime)
            registerRenderedLevelHitKey(renderedLevelHitKeys, profile, style, LABEL_VAH, isLive)
            [valueAreaLowRight, valueAreaLowExtend] = levelEndpoint(profile.endTime, profile.valueAreaLowBreachTime, style.extensionMode)
            bool valSweptDenote = profileDenote and not na(profile.valueAreaLowBreachTime)
            color valColor = valSweptDenote and isMostRecentCompleted ? valueAreaBaseColor : dimLevelColor(valueAreaBaseColor, not na(profile.valueAreaLowBreachTime), style.dimTouched, style.dimFraction)
            color valContinuation = dimLevelColor(valueAreaBaseColor, true, true, style.sweptContinuationFraction)
            bool valHitTrace = touchLabelsActive and not na(profile.valueAreaLowHitTime) and sameNyDate(profile.valueAreaLowHitTime, time)
            bool valArchivedTouch = not isLive and map.contains(archivedLevelHitKeys, levelHitKey(profileHitSourceKey, LABEL_VAL))
            drawLevel(profile.startTime, valueAreaLowRight, profile.valueAreaLowPrice, valColor, valueAreaLineWidth, style.valueAreaStyle, valueAreaLowExtend, useDevelopingColors ? style.developingColor : style.valueAreaLabelColor, LABEL_VAL, style, valSweptDenote, valContinuation, valHitTrace, valArchivedTouch, isLive, isMostRecentCompleted, profile.endTime)
            registerRenderedLevelHitKey(renderedLevelHitKeys, profile, style, LABEL_VAL, isLive)

// ═══════════════════════════════════════════════════════════════════════════════
// FUNCTIONS — anchor engine
// ═══════════════════════════════════════════════════════════════════════════════

// Finalize a period and apply the selected short-session merge policy.
finalizePeriod(AnchorState state, MergeState mergeState, int startTime, int endTime, int lastBarTime, int keepProfiles, int mergeDepth, bool mergeAllShorts, bool combineShorts, float shortSpanFraction, bool prepareHistogram) =>
    if array.size(state.barVolumes) > 0
        int periodSpan = lastBarTime - startTime
        int normalSpan = mergeState.normalSpan
        bool mergeEnabled = mergeAllShorts or mergeDepth > 0
        bool isShortPeriod = mergeEnabled and normalSpan > 0 and periodSpan < int(normalSpan * shortSpanFraction)
        bool canMerge = isShortPeriod and (mergeAllShorts or mergeState.foldCount < mergeDepth) and array.size(mergeState.pendingVolumes) > 0 and array.size(state.profiles) > 0
        if canMerge
            int baseFinalizedTime = array.get(state.profiles, array.size(state.profiles) - 1).finalizedTime
            array.concat(mergeState.pendingHighs, state.barHighs)
            array.concat(mergeState.pendingLows, state.barLows)
            array.concat(mergeState.pendingVolumes, state.barVolumes)
            compactIfNeeded(mergeState.pendingHighs, mergeState.pendingLows, mergeState.pendingVolumes)
            Profile merged = buildProfile(mergeState.pendingHighs, mergeState.pendingLows, mergeState.pendingVolumes, PROFILE_ROWS, valueAreaPercent, mergeState.pendingStartTime, endTime, prepareHistogram)
            if merged.isValid
                merged.finalizedTime := baseFinalizedTime
                array.pop(state.profiles)
                array.push(state.profiles, merged)
                while array.size(state.profiles) > keepProfiles
                    array.shift(state.profiles)
            mergeState.foldCount += 1
        else
            Profile profile = buildProfile(state.barHighs, state.barLows, state.barVolumes, PROFILE_ROWS, valueAreaPercent, startTime, endTime, prepareHistogram)
            if profile.isValid
                profile.finalizedTime := time
                array.push(state.profiles, profile)
                while array.size(state.profiles) > keepProfiles
                    array.shift(state.profiles)
                // Calibrate normal full-session span from non-merged periods (drives short detection).
                if periodSpan > normalSpan
                    mergeState.normalSpan := periodSpan
                if mergeEnabled
// Select the short-session fold base from the chosen merge mode.
                    bool becomesBase = combineShorts ? isShortPeriod : not isShortPeriod
                    if becomesBase
                        array.clear(mergeState.pendingHighs)
                        array.clear(mergeState.pendingLows)
                        array.clear(mergeState.pendingVolumes)
                        array.concat(mergeState.pendingHighs, state.barHighs)
                        array.concat(mergeState.pendingLows, state.barLows)
                        array.concat(mergeState.pendingVolumes, state.barVolumes)
                        mergeState.pendingStartTime := startTime
                        mergeState.foldCount := combineShorts ? 1 : 0
                    else if combineShorts and not isShortPeriod
                        array.clear(mergeState.pendingHighs)
                        array.clear(mergeState.pendingLows)
                        array.clear(mergeState.pendingVolumes)
                        mergeState.foldCount := 0
        array.clear(state.barHighs)
        array.clear(state.barLows)
        array.clear(state.barVolumes)

processAnchor(AnchorState state, MergeState mergeState, AnchorProcessPolicy policy, bool enabled, bool inWindow, bool periodStart, bool periodEnd, array<float> preparedHighs, array<float> preparedLows, array<float> preparedVolumes, bool barConfirmed) =>
    if enabled
        bool shouldStart = periodStart or (not policy.requireObservedBoundary and state.startTime == START_TIME_UNSET and inWindow)

        if periodEnd and array.size(state.barVolumes) > 0
// End early-close profiles at the last traded bar.
            finalizePeriod(state, mergeState, state.startTime, state.lastBarTime, state.lastBarTime, policy.keepProfiles, policy.mergeDepth, policy.mergeAllShorts, policy.combineShorts, policy.shortSpanFraction, policy.prepareHistogram)

        if shouldStart
            if array.size(state.barVolumes) > 0
// Continuous anchors end at the new period boundary; RTH falls back to time[1].
                int boundaryEnd = policy.continuousBoundary ? time : time[1]
                finalizePeriod(state, mergeState, state.startTime, boundaryEnd, state.lastBarTime, policy.keepProfiles, policy.mergeDepth, policy.mergeAllShorts, policy.combineShorts, policy.shortSpanFraction, policy.prepareHistogram)
            state.startTime := time

        if inWindow and barConfirmed
            appendPreparedBarVolume(state.barHighs, state.barLows, state.barVolumes, preparedHighs, preparedLows, preparedVolumes, true)
            state.lastBarTime := time

syncProfileHistogram(Profile target, Profile source) =>
    target.priceLow := source.priceLow
    target.priceHigh := source.priceHigh
    target.rowCount := source.rowCount
    target.rowVolumes := array.copy(source.rowVolumes)
    target.maxHistogramVolume := source.maxHistogramVolume
    target.pocRow := source.pocRow
    target.valueAreaLowRow := source.valueAreaLowRow
    target.valueAreaHighRow := source.valueAreaHighRow
    true

profileIndexByStart(array<Profile> profiles, int startTime) =>
    int profileIndex = -1
    if startTime != START_TIME_UNSET
        if array.size(profiles) > 0
            for candidateIndex = array.size(profiles) - 1 to 0
                if array.get(profiles, candidateIndex).startTime == startTime
                    profileIndex := candidateIndex
                    break
    profileIndex

storeProfile(AnchorState state, Profile profile, int keepProfiles) =>
    profile.finalizedTime := time
    array.push(state.profiles, profile)
    while array.size(state.profiles) > keepProfiles
        array.shift(state.profiles)
    array.size(state.profiles) - 1

emptyRemoteProfileResult() =>
    float unavailablePrice = na
    Profile histogramSnapshot = na
    Profile developingSnapshot = na
    [START_TIME_UNSET, START_TIME_UNSET, unavailablePrice, unavailablePrice, unavailablePrice, unavailablePrice, unavailablePrice, false, unavailablePrice, histogramSnapshot, developingSnapshot, 0]

fixedQuarterlyContext(bool enabled, bool developingEnabled, bool useUtcCalendar, bool prepareHistogram) =>
    if not enabled
        emptyRemoteProfileResult()
    else
        [fixedHighs, fixedLows, fixedVolumes] = request.security_lower_tf(syminfo.tickerid, QUARTERLY_INTRABAR_TIMEFRAME, [high, low, volume], ignore_invalid_timeframe=true, calc_bars_count=QUARTERLY_INTRABAR_BARS)
        bool utcQuarterBoundary = calendarQuarterStart(UTC_TIMEZONE)
        bool marketQuarterBoundary = calendarQuarterStart(NY_TIMEZONE)
        bool quarterBoundary = selectAssetCalendarStart(useUtcCalendar, utcQuarterBoundary, marketQuarterBoundary)
        bool utcDayBoundary = calendarDayStart(UTC_TIMEZONE)
        bool marketRthInSession = not na(time(timeframe.period, RTH_SESSION, NY_TIMEZONE))
        bool marketSessionComplete = not marketRthInSession and marketRthInSession[1]
        bool maturitySessionComplete = useUtcCalendar ? utcDayBoundary : marketSessionComplete
        var AnchorState state = newAnchorState()
        var MergeState mergeState = newMergeState()
        var MaturityState maturityState = newMaturityState()
        var AnchorProcessPolicy policy = newCalendarAnchorProcessPolicy(quarterlyProfilesToShow, prepareHistogram, true)
        if developingEnabled
            advanceMaturityState(maturityState, state, quarterBoundary, maturitySessionComplete, QUARTERLY_MATURITY_HISTORY)
        [preparedHighs, preparedLows, preparedVolumes] = prepareBarVolumeSamples(fixedHighs, fixedLows, fixedVolumes, high, low, volume, true)
        processAnchor(state, mergeState, policy, true, true, quarterBoundary, false, preparedHighs, preparedLows, preparedVolumes, true)
        Profile latestProfile = array.size(state.profiles) > 0 ? array.last(state.profiles) : na
        bool latestAvailable = not na(latestProfile) and latestProfile.isValid
        bool sameCompletionDay = latestAvailable and (useUtcCalendar ? sameCalendarDate(time, latestProfile.endTime, UTC_TIMEZONE) : sameCalendarDate(time, latestProfile.endTime, NY_TIMEZONE))
        bool histogramPublishWindow = sameCompletionDay and minute(time) == QUARTERLY_SNAPSHOT_MINUTE
        bool weeklyHistogramSnapshot = useUtcCalendar ? dayofweek(time, UTC_TIMEZONE) == dayofweek.monday and hour(time, UTC_TIMEZONE) == QUARTERLY_UTC_WEEKLY_SNAPSHOT_HOUR and minute(time, UTC_TIMEZONE) == QUARTERLY_SNAPSHOT_MINUTE : dayofweek(time, NY_TIMEZONE) == dayofweek.monday and hour(time, NY_TIMEZONE) == QUARTERLY_MARKET_WEEKLY_SNAPSHOT_HOUR and minute(time, NY_TIMEZONE) == QUARTERLY_SNAPSHOT_MINUTE
        Profile histogramSnapshot = prepareHistogram and latestAvailable and (histogramPublishWindow or weeklyHistogramSnapshot or barstate.islast) ? latestProfile : na
        Profile developingSnapshot = developingEnabled and state.startTime != START_TIME_UNSET and array.size(state.barVolumes) > 0 and barstate.islast ? buildProfile(state.barHighs, state.barLows, state.barVolumes, PROFILE_ROWS, valueAreaPercent, state.startTime, time, prepareHistogram) : na
        bool showDeveloping = developingEnabled and maturityShowsDeveloping(maturityState, state, quarterlyCurrentMode, useUtcCalendar ? QUARTERLY_UTC_MATURITY_SESSIONS : QUARTERLY_MARKET_MATURITY_SESSIONS, useUtcCalendar ? QUARTERLY_UTC_EARLY_MATURITY_SESSIONS : QUARTERLY_MARKET_EARLY_MATURITY_SESSIONS, MATURITY_EARLY_VOLUME_THRESHOLD_PERCENT)
        [latestAvailable ? latestProfile.startTime : START_TIME_UNSET, latestAvailable ? latestProfile.endTime : START_TIME_UNSET, latestAvailable ? latestProfile.priceLow : na, latestAvailable ? latestProfile.priceHigh : na, latestAvailable ? latestProfile.pocPrice : na, latestAvailable ? latestProfile.valueAreaHighPrice : na, latestAvailable ? latestProfile.valueAreaLowPrice : na, latestAvailable ? latestProfile.hasAlternatePoc : false, latestAvailable ? latestProfile.alternatePocPrice : na, histogramSnapshot, developingSnapshot, showDeveloping ? 1 : 0]

updateMitigation(array<Profile> profiles, bool active, bool sameSessionOnly, bool inWindowNow, float breachHigh, float breachLow) =>
    if active and array.size(profiles) > 0 and not (sameSessionOnly and not inWindowNow)
        if not na(breachHigh) and not na(breachLow)
            for profileIndex = 0 to array.size(profiles) - 1
                Profile profile = array.get(profiles, profileIndex)
                if time > profile.endTime
                    if na(profile.pocBreachTime) and breachLow < profile.pocPrice and breachHigh > profile.pocPrice
                        profile.pocBreachTime := time
                    if na(profile.valueAreaHighBreachTime) and breachLow < profile.valueAreaHighPrice and breachHigh > profile.valueAreaHighPrice
                        profile.valueAreaHighBreachTime := time
                    if na(profile.valueAreaLowBreachTime) and breachLow < profile.valueAreaLowPrice and breachHigh > profile.valueAreaLowPrice
                        profile.valueAreaLowBreachTime := time
                    if profile.hasAlternatePoc and na(profile.alternatePocBreachTime) and breachLow < profile.alternatePocPrice and breachHigh > profile.alternatePocPrice
                        profile.alternatePocBreachTime := time

registerLevelHitSourceProfiles(map<string, bool> retainedSourceProfiles, array<Profile> profiles, int fromIndex, bool sourceActive, SessionStyle style) =>
    if sourceActive and array.size(profiles) > 0
        for profileIndex = math.max(0, fromIndex) to array.size(profiles) - 1
            Profile profile = array.get(profiles, profileIndex)
            map.put(retainedSourceProfiles, levelHitSourceProfileKey(profile.startTime, profile.endTime, style), true)
    true

activeLastBarUpdate() =>
    barstate.islast

levelHitUsesMarketClock() =>
    barstate.isrealtime and (chart.is_range or (not na(time_close) and timenow >= time and timenow <= time_close))

// Repeated updates merge the same timed range; Replay retains its distinct lower-timeframe ranges.
recordLevelHitRanges(array<LevelHitRange> ranges, bool active, int barTime, int referenceTime) =>
    int contactCount = array.size(levelHitContactTimes)
    bool marketClockUpdate = levelHitUsesMarketClock()
    if active and contactCount > 0
        for contactIndex = 0 to contactCount - 1
            float contactHigh = array.get(levelHitContactHighs, contactIndex)
            float contactLow = array.get(levelHitContactLows, contactIndex)
            int rangeTime = marketClockUpdate ? barTime : array.get(levelHitContactTimes, contactIndex)
            int rangeCount = array.size(ranges)
            int matchingRangeIndex = -1
            if rangeCount > 0
                for rangeIndex = rangeCount - 1 to 0
                    int existingTime = array.get(ranges, rangeIndex).barTime
                    if existingTime == rangeTime
                        matchingRangeIndex := rangeIndex
                        break
                    if existingTime < rangeTime
                        break
            if matchingRangeIndex >= 0
                LevelHitRange existingRange = array.get(ranges, matchingRangeIndex)
                existingRange.highPrice := math.max(existingRange.highPrice, contactHigh)
                existingRange.lowPrice := math.min(existingRange.lowPrice, contactLow)
            else
                array.push(ranges, LevelHitRange.new(rangeTime, contactHigh, contactLow))
    int oldestAllowedTime = referenceTime - FOCUS_HIT_RANGE_RETENTION_MS
    while array.size(ranges) > 0 and (array.get(ranges, 0).barTime < oldestAllowedTime or array.size(ranges) > MAX_FOCUS_HIT_RANGES)
        array.shift(ranges)
    true

levelMarkedTimeOnDate(array<LevelHitEvent> events, string key, int referenceTime) =>
    int markedTime = na
    if array.size(events) > 0
        for eventIndex = array.size(events) - 1 to 0
            LevelHitEvent hitEvent = array.get(events, eventIndex)
            if hitEvent.key == key and sameNyDate(hitEvent.hitTime, referenceTime)
                markedTime := hitEvent.hitTime
                break
    markedTime

insertLevelHitEvent(array<LevelHitEvent> events, LevelHitEvent hitEvent) =>
    int insertAt = array.size(events)
    if array.size(events) > 0
        for eventIndex = 0 to array.size(events) - 1
            if hitEvent.barTime < array.get(events, eventIndex).barTime
                insertAt := eventIndex
                break
    if insertAt >= array.size(events)
        array.push(events, hitEvent)
    else
        array.insert(events, insertAt, hitEvent)
    while array.size(events) > MAX_LEVEL_HIT_EVENTS
        array.shift(events)
    true

processLevelHitAtTime(float levelPrice, int previousHitTime, string sourceProfileKey, string key, bool focusOnly, bool archivedSwept, bool unselectedAnchor, array<LevelHitEvent> events, float hitHigh, float hitLow, int hitTime, int hitBarTime, bool searchEventArchive) =>
    bool hitNow = not na(hitHigh) and not na(hitLow) and hitLow <= levelPrice and hitHigh >= levelPrice
    int markedTime = searchEventArchive ? levelMarkedTimeOnDate(events, key, hitTime) : not na(previousHitTime) and sameNyDate(previousHitTime, hitTime) ? previousHitTime : na
    bool firstHitToday = hitNow and na(markedTime)
    if firstHitToday
        markedTime := hitTime
        insertLevelHitEvent(events, LevelHitEvent.new(markedTime, hitBarTime, levelPrice, sourceProfileKey, key, focusOnly, archivedSwept, unselectedAnchor))
    [not na(markedTime) ? markedTime : previousHitTime, firstHitToday]

firstLevelHitContactTime(float levelPrice) =>
    int contactTime = na
    int contactCount = array.size(levelHitContactTimes)
    if contactCount > 0
        for contactIndex = 0 to contactCount - 1
            if array.get(levelHitContactLows, contactIndex) <= levelPrice and array.get(levelHitContactHighs, contactIndex) >= levelPrice
                contactTime := array.get(levelHitContactTimes, contactIndex)
                break
    contactTime

// A degenerate [level, level] range replays the contact through the shared dedupe-and-insert core.
processLevelHit(float levelPrice, int previousHitTime, string sourceProfileKey, string key, bool focusOnly, bool archivedSwept, bool unselectedAnchor, array<LevelHitEvent> events) =>
    int contactTime = firstLevelHitContactTime(levelPrice)
    float contactPrice = not na(contactTime) ? levelPrice : na
    bool activeEdgeUpdate = activeLastBarUpdate()
    int updateTime = levelHitUsesMarketClock() ? timenow : time
    processLevelHitAtTime(levelPrice, previousHitTime, sourceProfileKey, key, focusOnly, archivedSwept, unselectedAnchor, events, contactPrice, contactPrice, not na(contactTime) ? contactTime : updateTime, time, activeEdgeUpdate)

processProfileLevelHit(float levelPrice, int previousHitTime, bool dailyTouchConsumed, string sourceProfileKey, string key, bool focusOnly, bool archivedSwept, bool unselectedAnchor, bool eligible, bool limitDailyRetouches, array<LevelHitEvent> events) =>
    int updatedHitTime = previousHitTime
    bool updatedDailyTouchConsumed = dailyTouchConsumed
    if eligible and (not limitDailyRetouches or not dailyTouchConsumed)
        [markedTime, hitRecorded] = processLevelHit(levelPrice, previousHitTime, sourceProfileKey, key, focusOnly, archivedSwept, unselectedAnchor, events)
        updatedHitTime := markedTime
        updatedDailyTouchConsumed := dailyTouchConsumed or (limitDailyRetouches and hitRecorded)
    [updatedHitTime, updatedDailyTouchConsumed]

updateProfileLevelHitTrace(Profile profile, int profileIndex, int profileCount, SessionStyle style, array<LevelHitEvent> events, bool surfaceSweptLevels, bool sourceAnchorSelected, bool focusOnly, bool includeOlderLevels, bool limitDailyRetouches) =>
    if time > profile.endTime
        string sourceProfileKey = levelHitSourceProfileKey(profile.startTime, profile.endTime, style)
        bool isMostRecentCompleted = profileIndex == profileCount - 1
        bool sweptContinuationVisible = profileSweptContinuationVisible(profile, isMostRecentCompleted, style.extensionMode, style.sweptKeepMs, surfaceSweptLevels)
        bool pocSweptDenote = sweptContinuationVisible and not na(profile.pocBreachTime)
        bool vahSweptDenote = sweptContinuationVisible and not na(profile.valueAreaHighBreachTime)
        bool valSweptDenote = sweptContinuationVisible and not na(profile.valueAreaLowBreachTime)
        bool alternateSweptDenote = sweptContinuationVisible and not na(profile.alternatePocBreachTime)
        [_, pocExtendsRight] = levelEndpoint(profile.endTime, profile.pocBreachTime, style.extensionMode)
        [_, vahExtendsRight] = levelEndpoint(profile.endTime, profile.valueAreaHighBreachTime, style.extensionMode)
        [_, valExtendsRight] = levelEndpoint(profile.endTime, profile.valueAreaLowBreachTime, style.extensionMode)
        [_, alternateExtendsRight] = levelEndpoint(profile.endTime, profile.alternatePocBreachTime, style.extensionMode)
        bool archivedSweptEligible = includeOlderLevels and style.extensionMode == LEVEL_BREACH_SWEEP
        bool pocVisibleAtLiveEdge = pocExtendsRight or pocSweptDenote
        bool vahVisibleAtLiveEdge = vahExtendsRight or vahSweptDenote
        bool valVisibleAtLiveEdge = valExtendsRight or valSweptDenote
        bool alternateVisibleAtLiveEdge = alternateExtendsRight or alternateSweptDenote
        bool pocHitEligible = style.showPoc and (pocVisibleAtLiveEdge or archivedSweptEligible)
        bool vahHitEligible = style.showValueArea and (vahVisibleAtLiveEdge or archivedSweptEligible)
        bool valHitEligible = style.showValueArea and (valVisibleAtLiveEdge or archivedSweptEligible)
        bool alternateHitEligible = style.showAlternatePoc and profile.hasAlternatePoc and (alternateVisibleAtLiveEdge or archivedSweptEligible)
        bool limitAnchorRetouches = includeOlderLevels and limitDailyRetouches and (style.labelAnchor == LABEL_RTH_ANCHOR or style.labelAnchor == LABEL_GLOBEX_ANCHOR)
        [pocHitTime, pocDailyTouchConsumed] = processProfileLevelHit(profile.pocPrice, profile.pocHitTime, profile.pocDailyTouchConsumed, sourceProfileKey, levelHitKey(sourceProfileKey, LABEL_POC), focusOnly, not pocVisibleAtLiveEdge, not sourceAnchorSelected, pocHitEligible, limitAnchorRetouches, events)
        profile.pocHitTime := pocHitTime
        profile.pocDailyTouchConsumed := pocDailyTouchConsumed
        [vahHitTime, vahDailyTouchConsumed] = processProfileLevelHit(profile.valueAreaHighPrice, profile.valueAreaHighHitTime, profile.valueAreaHighDailyTouchConsumed, sourceProfileKey, levelHitKey(sourceProfileKey, LABEL_VAH), focusOnly, not vahVisibleAtLiveEdge, not sourceAnchorSelected, vahHitEligible, limitAnchorRetouches, events)
        profile.valueAreaHighHitTime := vahHitTime
        profile.valueAreaHighDailyTouchConsumed := vahDailyTouchConsumed
        [valHitTime, valDailyTouchConsumed] = processProfileLevelHit(profile.valueAreaLowPrice, profile.valueAreaLowHitTime, profile.valueAreaLowDailyTouchConsumed, sourceProfileKey, levelHitKey(sourceProfileKey, LABEL_VAL), focusOnly, not valVisibleAtLiveEdge, not sourceAnchorSelected, valHitEligible, limitAnchorRetouches, events)
        profile.valueAreaLowHitTime := valHitTime
        profile.valueAreaLowDailyTouchConsumed := valDailyTouchConsumed
        [alternateHitTime, alternateDailyTouchConsumed] = processProfileLevelHit(profile.alternatePocPrice, profile.alternatePocHitTime, profile.alternatePocDailyTouchConsumed, sourceProfileKey, levelHitKey(sourceProfileKey, LABEL_ALTERNATE_POC), focusOnly, not alternateVisibleAtLiveEdge, not sourceAnchorSelected, alternateHitEligible, limitAnchorRetouches, events)
        profile.alternatePocHitTime := alternateHitTime
        profile.alternatePocDailyTouchConsumed := alternateDailyTouchConsumed
    true

hitTraceProfileFromIndex(array<Profile> profiles, bool focusDeepRetention, int normalProfileCount) =>
    focusDeepRetention ? math.max(0, array.size(profiles) - normalProfileCount) : 0

// Touch Marker hit state remains independent of mitigation.
updateLevelHitTrace(array<Profile> profiles, int fromIndex, bool active, bool sourceAnchorSelected, bool includeOlderLevels, bool limitDailyRetouches, SessionStyle style, array<LevelHitEvent> events) =>
    if active and (style.showPoc or style.showValueArea or style.showAlternatePoc) and array.size(profiles) > 0
        int profileCount = array.size(profiles)
        for profileIndex = math.max(0, fromIndex) to profileCount - 1
            updateProfileLevelHitTrace(array.get(profiles, profileIndex), profileIndex, profileCount, style, events, false, sourceAnchorSelected, false, includeOlderLevels, limitDailyRetouches)
    true

// Focus-selected profiles add their visible levels without recruiting the retained search archive.
updateFocusedLevelHitTrace(RenderBudgetAnchor anchor, bool active, bool includeOlderLevels, bool limitDailyRetouches, array<LevelHitEvent> events) =>
    if active and anchor.restrictToFocus and (anchor.style.showPoc or anchor.style.showValueArea or anchor.style.showAlternatePoc)
        int profileCount = array.size(anchor.profiles)
        if profileCount > 0
            for profileIndex = 0 to profileCount - 1
                if renderBudgetProfileAllowed(anchor, profileIndex)
                    updateProfileLevelHitTrace(array.get(anchor.profiles, profileIndex), profileIndex, profileCount, anchor.style, events, anchor.surfaceSweptLevels, true, true, includeOlderLevels, limitDailyRetouches)
    true

insertFocusHitLevel(array<FocusHitLevel> levels, FocusHitLevel candidate) =>
    int insertAt = array.size(levels)
    if array.size(levels) > 0
        for levelIndex = 0 to array.size(levels) - 1
            if candidate.price < array.get(levels, levelIndex).price
                insertAt := levelIndex
                break
    if insertAt >= array.size(levels)
        array.push(levels, candidate)
    else
        array.insert(levels, insertAt, candidate)
    true

addFocusHitLevel(array<FocusHitLevel> levels, Profile profile, float levelPrice, int breachTime, int nextProfileFinalizedTime, bool sweptLevel, bool surfaceSweptLevels, int sweptKeepMs, bool olderSweptEligible, bool limitDailyRetouches, string levelName, string sourceProfileKey) =>
    insertFocusHitLevel(levels, FocusHitLevel.new(profile, levelPrice, breachTime, nextProfileFinalizedTime, sweptLevel, surfaceSweptLevels, sweptKeepMs, olderSweptEligible, limitDailyRetouches, levelName, sourceProfileKey, levelHitKey(sourceProfileKey, levelName)))

collectFocusedHitLevels(RenderBudgetAnchor anchor, bool active, bool includeOlderLevels, bool limitDailyRetouches, array<FocusHitLevel> levels) =>
    if active and anchor.restrictToFocus and array.size(anchor.profiles) > 0
        int profileCount = array.size(anchor.profiles)
        bool limitAnchorRetouches = includeOlderLevels and limitDailyRetouches and (anchor.style.labelAnchor == LABEL_RTH_ANCHOR or anchor.style.labelAnchor == LABEL_GLOBEX_ANCHOR)
        for profileIndex = 0 to profileCount - 1
            if renderBudgetProfileAllowed(anchor, profileIndex)
                Profile profile = array.get(anchor.profiles, profileIndex)
                if profile.isValid and time > profile.endTime
                    string sourceProfileKey = levelHitSourceProfileKey(profile.startTime, profile.endTime, anchor.style)
                    int nextProfileFinalizedTime = profileIndex < profileCount - 1 ? array.get(anchor.profiles, profileIndex + 1).finalizedTime : na
                    bool sweptLevel = anchor.style.extensionMode == LEVEL_BREACH_SWEEP
                    if anchor.style.showPoc
                        bool pocOlderSweptEligible = includeOlderLevels and sweptLevel and not na(profile.pocBreachTime)
                        addFocusHitLevel(levels, profile, profile.pocPrice, profile.pocBreachTime, nextProfileFinalizedTime, sweptLevel, anchor.surfaceSweptLevels, anchor.style.sweptKeepMs, pocOlderSweptEligible, limitAnchorRetouches, LABEL_POC, sourceProfileKey)
                    if anchor.style.showValueArea
                        bool vahOlderSweptEligible = includeOlderLevels and sweptLevel and not na(profile.valueAreaHighBreachTime)
                        bool valOlderSweptEligible = includeOlderLevels and sweptLevel and not na(profile.valueAreaLowBreachTime)
                        addFocusHitLevel(levels, profile, profile.valueAreaHighPrice, profile.valueAreaHighBreachTime, nextProfileFinalizedTime, sweptLevel, anchor.surfaceSweptLevels, anchor.style.sweptKeepMs, vahOlderSweptEligible, limitAnchorRetouches, LABEL_VAH, sourceProfileKey)
                        addFocusHitLevel(levels, profile, profile.valueAreaLowPrice, profile.valueAreaLowBreachTime, nextProfileFinalizedTime, sweptLevel, anchor.surfaceSweptLevels, anchor.style.sweptKeepMs, valOlderSweptEligible, limitAnchorRetouches, LABEL_VAL, sourceProfileKey)
                    if anchor.style.showAlternatePoc and profile.hasAlternatePoc
                        bool alternateOlderSweptEligible = includeOlderLevels and sweptLevel and not na(profile.alternatePocBreachTime)
                        addFocusHitLevel(levels, profile, profile.alternatePocPrice, profile.alternatePocBreachTime, nextProfileFinalizedTime, sweptLevel, anchor.surfaceSweptLevels, anchor.style.sweptKeepMs, alternateOlderSweptEligible, limitAnchorRetouches, LABEL_ALTERNATE_POC, sourceProfileKey)
    true

focusedHitLevelsKey(array<FocusHitLevel> levels) =>
    string key = ""
    if array.size(levels) > 0
        for levelIndex = 0 to array.size(levels) - 1
            key += "|" + array.get(levels, levelIndex).key
    key

firstFocusHitLevelAtOrAbove(array<FocusHitLevel> levels, float price) =>
    int leftIndex = 0
    int rightIndex = array.size(levels)
    while leftIndex < rightIndex
        int middleIndex = int(math.floor((leftIndex + rightIndex) / 2))
        if array.get(levels, middleIndex).price < price
            leftIndex := middleIndex + 1
        else
            rightIndex := middleIndex
    leftIndex

profileLastBreachAtTime(Profile profile, int rangeTime) =>
    int latestBreachTime = not na(profile.pocBreachTime) and profile.pocBreachTime < rangeTime ? profile.pocBreachTime : na
    latestBreachTime := not na(profile.valueAreaHighBreachTime) and profile.valueAreaHighBreachTime < rangeTime ? maxBreachTime(latestBreachTime, profile.valueAreaHighBreachTime) : latestBreachTime
    latestBreachTime := not na(profile.valueAreaLowBreachTime) and profile.valueAreaLowBreachTime < rangeTime ? maxBreachTime(latestBreachTime, profile.valueAreaLowBreachTime) : latestBreachTime
    latestBreachTime := profile.hasAlternatePoc and not na(profile.alternatePocBreachTime) and profile.alternatePocBreachTime < rangeTime ? maxBreachTime(latestBreachTime, profile.alternatePocBreachTime) : latestBreachTime
    latestBreachTime

focusHitLevelVisibleAtTime(FocusHitLevel level, int rangeTime) =>
    bool beforeBreach = na(level.breachTime) or rangeTime <= level.breachTime
    bool mostRecentAtTime = na(level.nextProfileFinalizedTime) or rangeTime < level.nextProfileFinalizedTime
    int lastBreachTime = level.sweptLevel ? profileLastBreachAtTime(level.profile, rangeTime) : na
    bool withinSweptKeep = level.sweptLevel and not na(lastBreachTime) and rangeTime - lastBreachTime <= level.sweptKeepMs
    beforeBreach or (level.sweptLevel and (level.surfaceSweptLevels or mostRecentAtTime or withinSweptKeep))

focusHitLevelPreviousTime(FocusHitLevel level) =>
    level.levelName == LABEL_POC ? level.profile.pocHitTime : level.levelName == LABEL_VAH ? level.profile.valueAreaHighHitTime : level.levelName == LABEL_VAL ? level.profile.valueAreaLowHitTime : level.profile.alternatePocHitTime

setFocusHitLevelTime(FocusHitLevel level, int hitTime) =>
    if level.levelName == LABEL_POC
        level.profile.pocHitTime := hitTime
    else if level.levelName == LABEL_VAH
        level.profile.valueAreaHighHitTime := hitTime
    else if level.levelName == LABEL_VAL
        level.profile.valueAreaLowHitTime := hitTime
    else
        level.profile.alternatePocHitTime := hitTime
    true

focusHitLevelDailyTouchConsumed(FocusHitLevel level) =>
    level.levelName == LABEL_POC ? level.profile.pocDailyTouchConsumed : level.levelName == LABEL_VAH ? level.profile.valueAreaHighDailyTouchConsumed : level.levelName == LABEL_VAL ? level.profile.valueAreaLowDailyTouchConsumed : level.profile.alternatePocDailyTouchConsumed

setFocusHitLevelDailyTouchConsumed(FocusHitLevel level) =>
    if level.levelName == LABEL_POC
        level.profile.pocDailyTouchConsumed := true
    else if level.levelName == LABEL_VAH
        level.profile.valueAreaHighDailyTouchConsumed := true
    else if level.levelName == LABEL_VAL
        level.profile.valueAreaLowDailyTouchConsumed := true
    else
        level.profile.alternatePocDailyTouchConsumed := true
    true

levelHitDateKey(string key, int hitTime) =>
    key + "|" + str.tostring(calendarDateSerial(hitTime, NY_TIMEZONE))

backfillFocusedLevelHitTrace(array<FocusHitLevel> levels, array<LevelHitRange> ranges, array<LevelHitEvent> events, bool tracePresentationActive) =>
    int levelCount = array.size(levels)
    if tracePresentationActive and levelCount > 0 and array.size(ranges) > 0
        map<string, bool> markedDateKeys = map.new<string, bool>()
        if array.size(events) > 0
            for eventIndex = 0 to array.size(events) - 1
                LevelHitEvent hitEvent = array.get(events, eventIndex)
                map.put(markedDateKeys, levelHitDateKey(hitEvent.key, hitEvent.hitTime), true)
        for rangeIndex = 0 to array.size(ranges) - 1
            LevelHitRange hitRange = array.get(ranges, rangeIndex)
            if hitRange.barTime < time and levelHitTraceActive(hitRange.barTime, tracePresentationActive)
                int levelIndex = firstFocusHitLevelAtOrAbove(levels, hitRange.lowPrice)
                while levelIndex < levelCount
                    FocusHitLevel level = array.get(levels, levelIndex)
                    if level.price > hitRange.highPrice
                        break
                    string markedDateKey = levelHitDateKey(level.key, hitRange.barTime)
                    bool visibleAtTime = focusHitLevelVisibleAtTime(level, hitRange.barTime)
                    bool olderTouch = level.olderSweptEligible and not visibleAtTime
                    bool dailyTouchBlocked = level.limitDailyRetouches and focusHitLevelDailyTouchConsumed(level)
                    bool activeAtTime = hitRange.barTime > level.profile.endTime and (visibleAtTime or olderTouch)
                    if activeAtTime and not dailyTouchBlocked and not map.contains(markedDateKeys, markedDateKey)
                        [markedTime, hitRecorded] = processLevelHitAtTime(level.price, focusHitLevelPreviousTime(level), level.sourceProfileKey, level.key, true, olderTouch, false, events, hitRange.highPrice, hitRange.lowPrice, hitRange.barTime, hitRange.barTime, true)
                        setFocusHitLevelTime(level, markedTime)
                        if hitRecorded
                            if level.limitDailyRetouches
                                setFocusHitLevelDailyTouchConsumed(level)
                            map.put(markedDateKeys, markedDateKey, true)
                    levelIndex += 1
    true

registerFocusedLevelHitSourceProfiles(map<string, bool> retainedSourceProfiles, RenderBudgetAnchor anchor, bool active) =>
    if active and anchor.restrictToFocus and array.size(anchor.profiles) > 0
        for profileIndex = 0 to array.size(anchor.profiles) - 1
            if renderBudgetProfileAllowed(anchor, profileIndex)
                Profile profile = array.get(anchor.profiles, profileIndex)
                map.put(retainedSourceProfiles, levelHitSourceProfileKey(profile.startTime, profile.endTime, anchor.style), true)
    true

// Advance a two-sided sweep when close clears each side by the configured margin.
sweepStep(bool reachedAbove, bool reachedBelow, float level, float margin) =>
    bool above = reachedAbove or close >= level + margin
    bool below = reachedBelow or close <= level - margin
    int sweptTime = above and below ? time : na
    [above, below, sweptTime]

// Until Swept completes after confirmed closes clear both sides.
updateSweep(array<Profile> profiles, bool active, float marginFraction) =>
    if active and array.size(profiles) > 0
        for profileIndex = 0 to array.size(profiles) - 1
            Profile profile = array.get(profiles, profileIndex)
            if time > profile.endTime
                float margin = (profile.priceHigh - profile.priceLow) * marginFraction
                if na(profile.pocBreachTime)
                    [pocAbove, pocBelow, pocSwept] = sweepStep(profile.pocSweptAbove, profile.pocSweptBelow, profile.pocPrice, margin)
                    profile.pocSweptAbove := pocAbove
                    profile.pocSweptBelow := pocBelow
                    if not na(pocSwept)
                        profile.pocBreachTime := pocSwept
                if na(profile.valueAreaHighBreachTime)
                    [vahAbove, vahBelow, vahSwept] = sweepStep(profile.valueAreaHighSweptAbove, profile.valueAreaHighSweptBelow, profile.valueAreaHighPrice, margin)
                    profile.valueAreaHighSweptAbove := vahAbove
                    profile.valueAreaHighSweptBelow := vahBelow
                    if not na(vahSwept)
                        profile.valueAreaHighBreachTime := vahSwept
                if na(profile.valueAreaLowBreachTime)
                    [valAbove, valBelow, valSwept] = sweepStep(profile.valueAreaLowSweptAbove, profile.valueAreaLowSweptBelow, profile.valueAreaLowPrice, margin)
                    profile.valueAreaLowSweptAbove := valAbove
                    profile.valueAreaLowSweptBelow := valBelow
                    if not na(valSwept)
                        profile.valueAreaLowBreachTime := valSwept
                if profile.hasAlternatePoc and na(profile.alternatePocBreachTime)
                    [apocAbove, apocBelow, apocSwept] = sweepStep(profile.alternatePocSweptAbove, profile.alternatePocSweptBelow, profile.alternatePocPrice, margin)
                    profile.alternatePocSweptAbove := apocAbove
                    profile.alternatePocSweptBelow := apocBelow
                    if not na(apocSwept)
                        profile.alternatePocBreachTime := apocSwept

updateAnchorLevels(AnchorState state, bool mitigationActive, bool sameSessionOnly, bool inWindowNow, bool sweepActive, float breachHigh, float breachLow, float sweepMarginFraction) =>
    updateMitigation(state.profiles, mitigationActive, sameSessionOnly, inWindowNow, breachHigh, breachLow)
    updateSweep(state.profiles, sweepActive, sweepMarginFraction)

renderAnchor(RenderBudgetAnchor anchor, Profile liveProfile, bool developingProfileActive, bool showDeveloping, int histogramFromIndex, int lineFromIndex, bool touchLabelsActive, map<string, bool> archivedLevelHitKeys, map<string, bool> renderedLevelHitKeys) =>
    if anchor.levelsEnabled
        int profileCount = array.size(anchor.profiles)
        if profileCount > 0
            for profileIndex = 0 to profileCount - 1
                if renderBudgetProfileAllowed(anchor, profileIndex)
                    bool histogramAllowed = profileIndex >= histogramFromIndex
                    // Focused profiles draw whole or not at all.
                    bool focusWholeProfile = not anchor.restrictToFocus or not anchor.histogramEnabled or histogramAllowed
                    renderProfile(array.get(anchor.profiles, profileIndex), anchor.style, false, profileIndex == profileCount - 1, anchorSurfacesSweptLevels(anchor, profileIndex), false, histogramAllowed, profileIndex >= lineFromIndex and focusWholeProfile, touchLabelsActive, archivedLevelHitKeys, renderedLevelHitKeys)
        if showDeveloping and not na(liveProfile)
            renderProfile(liveProfile, anchor.style, developingProfileActive, false, false, true, true, true, false, archivedLevelHitKeys, renderedLevelHitKeys)

// ═══════════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE
// ═══════════════════════════════════════════════════════════════════════════════
type ColorRow
    string name
    color swatchColor
    string widthText

addColorRow(array<ColorRow> rows, string name, color swatchColor, string widthText) =>
    array.push(rows, ColorRow.new(name, swatchColor, widthText))

writeColorRow(table colorTable, int row, ColorRow entry) =>
    bool hasColor = not na(entry.swatchColor)
    string rgbText = hasColor ? str.format("R:{0} G:{1} B:{2}", int(color.r(entry.swatchColor)), int(color.g(entry.swatchColor)), int(color.b(entry.swatchColor))) : ""
    string transText = hasColor ? str.tostring(int(color.t(entry.swatchColor))) : ""
    table.cell(colorTable, 0, row, entry.name, text_size=size.small, text_color=color.rgb(0, 0, 0))
    table.cell(colorTable, 1, row, rgbText, text_size=size.small, text_color=color.rgb(0, 0, 0))
    table.cell(colorTable, 2, row, transText, text_size=size.small, text_color=color.rgb(0, 0, 0))
    table.cell(colorTable, 3, row, entry.widthText, text_size=size.small, text_color=color.rgb(0, 0, 0))

sessionLevelLabelsActive(bool enabled, SessionStyle style) =>
    bool rightEdgeLabelsActive = style.extensionMode != LEVEL_PERIOD and (style.showValueArea or style.showPoc or style.showAlternatePoc)
    bool anchorLabelsActive = anchorLevelLabelMode != ANCHOR_LABEL_MODE_OFF and (style.showValueArea or style.showPoc)
    enabled and (rightEdgeLabelsActive or anchorLabelsActive)

collectValueGapColorRows(array<ColorRow> rows, string prefix, bool enabled, ValueGapStyle style, bool includeFilled) =>
    if enabled
        addColorRow(rows, prefix + " +", style.bullishColor, "")
        addColorRow(rows, prefix + " −", style.bearishColor, "")
        addColorRow(rows, prefix + " Border +", style.bullishBorderColor, "")
        addColorRow(rows, prefix + " Border −", style.bearishBorderColor, "")
        if includeFilled
            addColorRow(rows, prefix + " Filled", style.filledColor, "")
        if style.showLabels
            addColorRow(rows, prefix + " Label +", style.bullishLabelColor, "")
            addColorRow(rows, prefix + " Label −", style.bearishLabelColor, "")
            addColorRow(rows, prefix + " Label ✓", style.mitigatedLabelColor, "")
        if style.showMidpointLine
            addColorRow(rows, prefix + " 50% Line Open", style.midpointOpenLineColor, "1")
            addColorRow(rows, prefix + " 50% Line ✓", style.midpointMitigatedLineColor, "1")
        if style.showQuartileLines
            addColorRow(rows, prefix + " Q Line Open", style.quartileOpenLineColor, "1")
            addColorRow(rows, prefix + " Q Line ✓", style.quartileMitigatedLineColor, "1")

collectSessionColorRows(array<ColorRow> rows, string sessionName, bool enabled, bool showDeveloping, SessionStyle style) =>
    if enabled
        bool levelsActive = style.showValueArea or style.showPoc or style.showAlternatePoc
        bool levelLabelsActive = sessionLevelLabelsActive(enabled, style)
        bool alternatePocLabelsActive = style.extensionMode != LEVEL_PERIOD and style.showAlternatePoc
        if style.showValueArea
            addColorRow(rows, sessionName + " " + LABEL_VALUE_AREA_HIGH_LOW, style.valueAreaColor, str.tostring(style.valueAreaWidth))
            addColorRow(rows, sessionName + " " + LABEL_LAST_VALUE_AREA_COLOR, style.valueAreaLastColor, str.tostring(style.valueAreaLastWidth))
        if style.showPoc
            addColorRow(rows, sessionName + " " + LABEL_POC, style.pocColor, str.tostring(style.pocWidth))
        if style.showAlternatePoc
            addColorRow(rows, sessionName + " " + LABEL_ALTERNATE_POC, style.alternatePocColor, str.tostring(style.alternatePocWidth))
        if style.showHistogram
            addColorRow(rows, sessionName + " " + LABEL_HISTOGRAM + " " + LABEL_HISTOGRAM_INSIDE, style.histogramInsideColor, "")
            addColorRow(rows, sessionName + " " + LABEL_HISTOGRAM + " " + LABEL_HISTOGRAM_OUTSIDE, style.histogramOutsideColor, "")
        if style.showSessionBox
            addColorRow(rows, sessionName + " " + LABEL_BOX, style.sessionBoxColor, "")
        if levelLabelsActive and style.showValueArea
            addColorRow(rows, sessionName + " " + LABEL_LEVEL_LABELS + " " + LABEL_VALUE_AREA_HIGH_LOW, style.valueAreaLabelColor, "")
        if levelLabelsActive and style.showPoc
            addColorRow(rows, sessionName + " " + LABEL_LEVEL_LABELS + " " + LABEL_POC, style.pocLabelColor, "")
        if alternatePocLabelsActive
            addColorRow(rows, sessionName + " " + LABEL_LEVEL_LABELS + " " + LABEL_ALTERNATE_POC, style.alternatePocLabelColor, "")
        if style.developingEnabled and showDeveloping and levelsActive
            addColorRow(rows, sessionName + " Developing", style.developingColor, "")

// ═══════════════════════════════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════════════════════════════
var table colorTable = na

var array<Profile> valueGapSourceProfiles = array.new<Profile>()
var array<ValueGap> valueGapRecords = array.new<ValueGap>()
varip array<LevelHitEvent> levelHitEvents = array.new<LevelHitEvent>()
varip array<LevelHitRange> levelHitRanges = array.new<LevelHitRange>()
varip string focusedHitBackfillKey = ""
var map<string, bool> retainedLevelHitSourceProfiles = map.new<string, bool>()
var map<string, bool> renderedLevelHitKeys = map.new<string, bool>()
var map<string, LevelHitPresentation> levelHitPresentations = map.new<string, LevelHitPresentation>()
var map<string, int> levelHitLabelClusters = map.new<string, int>()
var map<string, bool> archivedLevelHitKeys = map.new<string, bool>()
var AnchorState rthState = newAnchorState()
var AnchorState globexState = newAnchorState()
var AnchorState weeklyState = newAnchorState()
var AnchorState monthlyState = newAnchorState()
var AnchorState quarterlyState = newAnchorState()

var MergeState rthMergeState = newMergeState()
var MergeState globexMergeState = newMergeState()
var MergeState weeklyMergeState = newMergeState()
var MergeState monthlyMergeState = newMergeState()

// ═══════════════════════════════════════════════════════════════════════════════
// STYLES
// ═══════════════════════════════════════════════════════════════════════════════
showActivePrices = quickPriceMode == PRICE_MODE_ACTIVE
useCustomPrices = quickPriceMode == PRICE_MODE_CUSTOM
effectiveRthShowPrice = showActivePrices or (useCustomPrices and rthShowPrice)
effectiveGlobexShowPrice = showActivePrices or (useCustomPrices and globexShowPrice)
effectiveWeeklyShowPrice = showActivePrices or (useCustomPrices and weeklyShowPrice)
effectiveMonthlyShowPrice = showActivePrices or (useCustomPrices and monthlyShowPrice)
effectiveQuarterlyShowPrice = showActivePrices or (useCustomPrices and quarterlyShowPrice)

var rthStyle = SessionStyle.new(rthExtensionMode, rthDimTouched, rthDimPercent / 100.0, rthShowPoc, rthPocColor, int(str.tonumber(rthPocWidth)), rthPocStyle, rthShowAlternatePoc, rthAlternatePocColor, int(str.tonumber(rthAlternatePocWidth)), rthAlternatePocStyle, rthShowValueArea, rthValueAreaColor, rthValueAreaLastColor, int(str.tonumber(rthValueAreaWidth)), rthValueAreaStyle, rthShowHistogram, rthHistogramInsideColor, rthHistogramOutsideColor, rthShowSessionBox, rthSessionBoxColor, effectiveRthShowPrice, levelLabelBgColor, rthValueAreaLabelColor, rthPocLabelColor, rthAlternatePocLabelColor, rthLevelLabelSize, levelLabelOffset, rthDevelopingEnabled, rthDevelopingColor, sweptContinuationLineFadePercent / 100.0, RTH_SWEPT_CONTINUATION_WIDTH, rthSweptKeepDays * MS_PER_DAY, LABEL_RTH_ANCHOR, PERIOD_LABEL_DAY, false, LABEL_RTH_LIVE, LABEL_RTH_LAST, int(str.tonumber(rthValueAreaLastWidth)))
var globexStyle = SessionStyle.new(globexExtensionMode, globexDimTouched, globexDimPercent / 100.0, globexShowPoc, globexPocColor, int(str.tonumber(globexPocWidth)), globexPocStyle, globexShowAlternatePoc, globexAlternatePocColor, int(str.tonumber(globexAlternatePocWidth)), globexAlternatePocStyle, globexShowValueArea, globexValueAreaColor, globexValueAreaLastColor, int(str.tonumber(globexValueAreaWidth)), globexValueAreaStyle, globexShowHistogram, globexHistogramInsideColor, globexHistogramOutsideColor, globexShowSessionBox, globexSessionBoxColor, effectiveGlobexShowPrice, levelLabelBgColor, globexValueAreaLabelColor, globexPocLabelColor, globexAlternatePocLabelColor, globexLevelLabelSize, levelLabelOffset, false, globexValueAreaColor, sweptContinuationLineFadePercent / 100.0, GLOBEX_SWEPT_CONTINUATION_WIDTH, globexSweptKeepDays * MS_PER_DAY, LABEL_GLOBEX_ANCHOR, PERIOD_LABEL_DAY, false, LABEL_GLOBEX_LIVE, LABEL_GLOBEX_LAST, int(str.tonumber(globexValueAreaLastWidth)))
var weeklyStyle = SessionStyle.new(weeklyExtensionMode, weeklyDimTouched, weeklyDimPercent / 100.0, weeklyShowPoc, weeklyPocColor, int(str.tonumber(weeklyPocWidth)), weeklyPocStyle, weeklyShowAlternatePoc, weeklyAlternatePocColor, int(str.tonumber(weeklyAlternatePocWidth)), weeklyAlternatePocStyle, weeklyShowValueArea, weeklyValueAreaColor, weeklyValueAreaLastColor, int(str.tonumber(weeklyValueAreaWidth)), weeklyValueAreaStyle, weeklyShowHistogram, weeklyHistogramInsideColor, weeklyHistogramOutsideColor, weeklyShowSessionBox, weeklySessionBoxColor, effectiveWeeklyShowPrice, levelLabelBgColor, weeklyValueAreaLabelColor, weeklyPocLabelColor, weeklyAlternatePocLabelColor, weeklyLevelLabelSize, levelLabelOffset, false, weeklyValueAreaColor, sweptContinuationLineFadePercent / 100.0, WEEKLY_SWEPT_CONTINUATION_WIDTH, weeklySweptKeepWeeks * MS_PER_WEEK, LABEL_WEEKLY_ANCHOR, PERIOD_LABEL_DAY, false, LABEL_WEEKLY_LIVE, LABEL_WEEKLY_LAST, int(str.tonumber(weeklyValueAreaLastWidth)))
var monthlyStyle = SessionStyle.new(monthlyExtensionMode, monthlyDimTouched, monthlyDimPercent / 100.0, monthlyShowPoc, monthlyPocColor, int(str.tonumber(monthlyPocWidth)), monthlyPocStyle, monthlyShowAlternatePoc, monthlyAlternatePocColor, int(str.tonumber(monthlyAlternatePocWidth)), monthlyAlternatePocStyle, monthlyShowValueArea, monthlyValueAreaColor, monthlyValueAreaLastColor, int(str.tonumber(monthlyValueAreaWidth)), monthlyValueAreaStyle, monthlyShowHistogram, monthlyHistogramInsideColor, monthlyHistogramOutsideColor, monthlyShowSessionBox, monthlySessionBoxColor, effectiveMonthlyShowPrice, levelLabelBgColor, monthlyValueAreaLabelColor, monthlyPocLabelColor, monthlyAlternatePocLabelColor, monthlyLevelLabelSize, levelLabelOffset, false, monthlyValueAreaColor, sweptContinuationLineFadePercent / 100.0, MONTHLY_SWEPT_CONTINUATION_WIDTH, monthlySweptKeepMonths * MS_PER_MONTH, LABEL_MONTHLY_ANCHOR, PERIOD_LABEL_MONTH, false, LABEL_MONTHLY_LIVE, LABEL_MONTHLY_LAST, int(str.tonumber(monthlyValueAreaLastWidth)))
var quarterlyStyle = SessionStyle.new(quarterlyExtensionMode, quarterlyDimTouched, quarterlyDimPercent / 100.0, quarterlyShowPoc, quarterlyPocColor, int(str.tonumber(quarterlyPocWidth)), quarterlyPocStyle, quarterlyShowAlternatePoc, quarterlyAlternatePocColor, int(str.tonumber(quarterlyAlternatePocWidth)), quarterlyAlternatePocStyle, quarterlyShowValueArea, quarterlyValueAreaColor, quarterlyValueAreaLastColor, int(str.tonumber(quarterlyValueAreaWidth)), quarterlyValueAreaStyle, quarterlyShowHistogram, quarterlyHistogramInsideColor, quarterlyHistogramOutsideColor, quarterlyShowSessionBox, quarterlySessionBoxColor, effectiveQuarterlyShowPrice, levelLabelBgColor, quarterlyValueAreaLabelColor, quarterlyPocLabelColor, quarterlyAlternatePocLabelColor, quarterlyLevelLabelSize, levelLabelOffset, false, quarterlyValueAreaColor, sweptContinuationLineFadePercent / 100.0, QUARTERLY_SWEPT_CONTINUATION_WIDTH, quarterlySweptKeepQuarters * MS_PER_QUARTER, LABEL_QUARTERLY_ANCHOR, PERIOD_LABEL_QUARTER, false, LABEL_QUARTERLY_LIVE, LABEL_QUARTERLY_LAST, int(str.tonumber(quarterlyValueAreaLastWidth)))

// ═══════════════════════════════════════════════════════════════════════════════
// QUICK FILTER
// ═══════════════════════════════════════════════════════════════════════════════
// Quick Filter membership is shared by input activation and runtime rendering.
levelHitTimeframeAllowed = chart.is_range or timeframe.in_seconds(timeframe.period) <= LEVEL_HIT_MAX_TIMEFRAME_SECONDS

valueGapsActive = valueGapsEnabled or isGapsFilter
rthGapsPreset = valueGapsActive and isGapsFilter and valueGapSourceIsRth
globexGapsPreset = valueGapsActive and isGapsFilter and not valueGapSourceIsRth

rthFilterEnabled = rthQuickFilterActive or rthGapsPreset or (isAll and rthEnabled)
globexFilterEnabled = globexQuickFilterActive or globexGapsPreset or (isAll and globexEnabled)
weeklyFilterEnabled = weeklyQuickFilterActive or (isAll and weeklyEnabled)
monthlyFilterEnabled = monthlyQuickFilterActive or (isAll and monthlyEnabled)
quarterlyFilterEnabled = quarterlyQuickFilterActive or (isAll and quarterlyEnabled)

// Deep history only for an anchor that actually draws.
rthProfilesToRetain = focusSelected and rthFilterEnabled ? FOCUS_SEARCH_DEPTH : rthEffectiveProfilesToShow
globexProfilesToRetain = focusSelected and globexFilterEnabled ? FOCUS_SEARCH_DEPTH : globexEffectiveProfilesToShow

// Hit Trace chooses eligible sources without owning anchor calculation.
levelHitUnselectedAnchorsActive = levelHitTraceEnabled and levelHitIncludeAllAnchors and levelHitTimeframeAllowed

// The gaps preset changes presentation only; it does not rewrite anchor controls.
rthEffectiveExtensionMode = rthGapsPreset ? LEVEL_BREACH_ANY : rthExtensionMode
rthStyle.extensionMode := rthEffectiveExtensionMode
rthStyle.showPoc := not rthGapsPreset and rthShowPoc
rthStyle.showAlternatePoc := not rthGapsPreset and rthShowAlternatePoc
rthStyle.showValueArea := rthGapsPreset or rthShowValueArea

globexEffectiveExtensionMode = globexGapsPreset ? LEVEL_BREACH_ANY : globexExtensionMode
globexStyle.extensionMode := globexEffectiveExtensionMode
globexStyle.showPoc := not globexGapsPreset and globexShowPoc
globexStyle.showAlternatePoc := not globexGapsPreset and globexShowAlternatePoc
globexStyle.showValueArea := globexGapsPreset or globexShowValueArea

rthShowDeveloping     = isAll ? true : includeDevelopingRth
globexShowDeveloping  = isAll ? true : includeDevelopingGlobex

// ═══════════════════════════════════════════════════════════════════════════════
// DATA & BOUNDARIES
// ═══════════════════════════════════════════════════════════════════════════════
intrabarTimeframe = autoIntrabarTimeframe()
[intrabarHighs, intrabarLows, intrabarVolumes, intrabarTimes] = request.security_lower_tf(syminfo.tickerid, intrabarTimeframe, [high, low, volume, time], ignore_invalid_timeframe=true)

// Weekend bars distinguish 24/7 assets from session-based instruments.
if not assetClassificationReady
    if syminfo.type == "crypto"
        isTwentyFourSevenAsset := true
        assetClassificationReady := true
    else if isTrueWeekendBar(time)
        isTwentyFourSevenAsset := true
        assetClassificationReady := true
    else
        int barsInWeek = math.max(1, int(math.ceil(SECONDS_PER_WEEK / timeframe.in_seconds(timeframe.period))))
        int observationWindow = math.min(ASSET_DETECTION_MAX_LOOKBACK, barsInWeek)
        if bar_index >= observationWindow
            isTwentyFourSevenAsset := false
            assetClassificationReady := true

// Select the RTH day mask by asset class; time() requires constant session strings.
rthInSessionWeekday = not na(time(timeframe.period, RTH_SESSION, NY_TIMEZONE))
rthInSessionAllDays = not na(time(timeframe.period, RTH_SESSION_ALL_DAYS, NY_TIMEZONE))
rthInSession = isTwentyFourSevenAsset ? rthInSessionAllDays : rthInSessionWeekday
rthSessionStart = rthInSession and not rthInSession[1]
rthSessionEnd = not rthInSession and rthInSession[1]

// Continuous anchors use the NY calendar for futures and UTC for 24/7 assets.
useUtcCalendarAnchors = isTwentyFourSevenAsset
globexStyle.useUtcLabelTimezone := useUtcCalendarAnchors
weeklyStyle.useUtcLabelTimezone := useUtcCalendarAnchors
monthlyStyle.useUtcLabelTimezone := useUtcCalendarAnchors
quarterlyStyle.useUtcLabelTimezone := useUtcCalendarAnchors
utcDayStart = calendarDayStart(UTC_TIMEZONE)
futuresGlobexStart = shiftedCalendarDayStart(NY_TIMEZONE, GLOBEX_REOPEN_SHIFT_MS)
globexDayStart = selectAssetCalendarStart(useUtcCalendarAnchors, utcDayStart, futuresGlobexStart)
utcWeekStart = calendarWeekStart(UTC_TIMEZONE)
weeklyReopenInSession = not na(time(timeframe.period, WEEKLY_REOPEN_SESSION, NY_TIMEZONE))
futuresWeekStart = weeklyReopenInSession and not weeklyReopenInSession[1] and dayofweek(time, NY_TIMEZONE) == dayofweek.sunday
weeklyPeriodStart = selectAssetCalendarStart(useUtcCalendarAnchors, utcWeekStart, futuresWeekStart)
utcMonthStart = calendarMonthStart(UTC_TIMEZONE)
nyMonthStart = calendarMonthStart(NY_TIMEZONE)
monthlyPeriodStart = selectAssetCalendarStart(useUtcCalendarAnchors, utcMonthStart, nyMonthStart)

// Keep frequent remote values scalar; Profile objects cross contexts only for sparse histogram snapshots.
[quarterlySnapshotStartTime, quarterlySnapshotEndTime, quarterlySnapshotPriceLow, quarterlySnapshotPriceHigh, quarterlySnapshotPocPrice, quarterlySnapshotValueAreaHighPrice, quarterlySnapshotValueAreaLowPrice, quarterlySnapshotHasAlternatePoc, quarterlySnapshotAlternatePocPrice, quarterlyHistogramSnapshot, quarterlyDevelopingSnapshot, requestedQuarterlyShowDeveloping] = request.security(syminfo.tickerid, QUARTERLY_CALCULATION_TIMEFRAME, fixedQuarterlyContext(true, quarterlyFilterEnabled, useUtcCalendarAnchors, quarterlyFilterEnabled and quarterlyShowHistogram), gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off, calc_bars_count=QUARTERLY_CALCULATION_BARS)
int quarterlyProfileIndex = profileIndexByStart(quarterlyState.profiles, quarterlySnapshotStartTime)
if quarterlySnapshotStartTime != START_TIME_UNSET
    if quarterlyProfileIndex < 0
        Profile quarterlyProfile = newRemoteProfile(quarterlySnapshotStartTime, quarterlySnapshotEndTime, quarterlySnapshotPriceLow, quarterlySnapshotPriceHigh, quarterlySnapshotPocPrice, quarterlySnapshotValueAreaHighPrice, quarterlySnapshotValueAreaLowPrice, quarterlySnapshotHasAlternatePoc, quarterlySnapshotAlternatePocPrice)
        quarterlyProfileIndex := storeProfile(quarterlyState, quarterlyProfile, quarterlyProfilesToShow)
    if not na(quarterlyHistogramSnapshot)
        syncProfileHistogram(array.get(quarterlyState.profiles, quarterlyProfileIndex), quarterlyHistogramSnapshot)

// Count completed sessions before exposing a mature profile.
maturitySessionComplete = useUtcCalendarAnchors ? utcDayStart : rthSessionEnd
var MaturityState weeklyMaturityState = newMaturityState()
var MaturityState monthlyMaturityState = newMaturityState()
advanceMaturityState(weeklyMaturityState, weeklyState, weeklyPeriodStart, maturitySessionComplete, WEEKLY_MATURITY_HISTORY)
advanceMaturityState(monthlyMaturityState, monthlyState, monthlyPeriodStart, maturitySessionComplete, MONTHLY_MATURITY_HISTORY)

// Auto maturity uses anchor-specific history floors and a 45% completed-volume threshold.
weeklyShowDeveloping = maturityShowsDeveloping(weeklyMaturityState, weeklyState, weeklyCurrentMode, useUtcCalendarAnchors ? WEEKLY_UTC_MATURITY_SESSIONS : WEEKLY_MARKET_MATURITY_SESSIONS, WEEKLY_EARLY_MATURITY_SESSIONS, MATURITY_EARLY_VOLUME_THRESHOLD_PERCENT)
monthlyShowDeveloping = maturityShowsDeveloping(monthlyMaturityState, monthlyState, monthlyCurrentMode, useUtcCalendarAnchors ? MONTHLY_UTC_MATURITY_SESSIONS : MONTHLY_MARKET_MATURITY_SESSIONS, useUtcCalendarAnchors ? MONTHLY_UTC_EARLY_MATURITY_SESSIONS : MONTHLY_MARKET_EARLY_MATURITY_SESSIONS, MATURITY_EARLY_VOLUME_THRESHOLD_PERCENT)
var bool quarterlyShowDeveloping = false
if not na(requestedQuarterlyShowDeveloping)
    quarterlyShowDeveloping := requestedQuarterlyShowDeveloping == 1

// Show Only keeps one recurring NY-time window visible.
inVisibleOvernight = not na(time(timeframe.period, SESSION_WINDOW_OVERNIGHT, NY_TIMEZONE))
inVisibleFrom0500 = not na(time(timeframe.period, SESSION_WINDOW_FROM_0500, NY_TIMEZONE))
inVisibleFrom0830 = not na(time(timeframe.period, SESSION_WINDOW_FROM_0830, NY_TIMEZONE))
inVisibleRth = not na(time(timeframe.period, SESSION_WINDOW_RTH, NY_TIMEZONE))
inVisibleWindow = visibleWindow == WINDOW_LABEL_FROM_0500 ? inVisibleFrom0500 : visibleWindow == WINDOW_LABEL_FROM_0830 ? inVisibleFrom0830 : visibleWindow == WINDOW_LABEL_RTH ? inVisibleRth : inVisibleOvernight
// Most Recent Only keeps the selected window on the current NY date.
inMostRecentDay = sameCalendarDate(time, timenow, NY_TIMEZONE)
hideThisBar = showOnlyEnabled and not (inVisibleWindow and (not showOnlyMostRecent or inMostRecentDay))
plotcandle(hideThisBar ? open : na, high, low, close, color=hiddenCandleColor, wickcolor=hiddenCandleColor, bordercolor=hiddenCandleColor, editable=false, display=display.pane, force_overlay=true)

// ═══════════════════════════════════════════════════════════════════════════════
// PROCESS
// ═══════════════════════════════════════════════════════════════════════════════
levelHitDetectionEnabled = levelHitTraceEnabled and levelHitTimeframeAllowed
levelHitWindowStartMinute = levelHitDetectionStartMinute()
levelHitFallbackWindow = levelHitDetectionWindow == WINDOW_LABEL_FROM_0500 ? inVisibleFrom0500 : levelHitDetectionWindow == WINDOW_LABEL_FROM_0830 ? inVisibleFrom0830 : rthInSession
rthEligibleRangeRequested = valueGapsActive and valueGapFillWindow == WINDOW_LABEL_RTH
rthEligibleRangeNeeded = rthEligibleRangeRequested and priceWindowMayContainEligiblePrice(RTH_START_MINUTE, intrabarTimes, isTwentyFourSevenAsset, rthInSession)
float rthEligibleHigh = na
float rthEligibleLow = na
if rthEligibleRangeNeeded
    [calculatedRthHigh, calculatedRthLow] = priceWindowRange(RTH_START_MINUTE, intrabarHighs, intrabarLows, intrabarTimes, isTwentyFourSevenAsset, rthInSession)
    rthEligibleHigh := calculatedRthHigh
    rthEligibleLow := calculatedRthLow

array.clear(levelHitContactHighs)
array.clear(levelHitContactLows)
array.clear(levelHitContactTimes)
bool levelHitWindowActiveNow = false
if levelHitDetectionEnabled
    bool marketClockUpdate = levelHitUsesMarketClock()
    if marketClockUpdate
        int updateTime = timenow
        if nyPriceWindowTimestampEligible(updateTime, levelHitWindowStartMinute, isTwentyFourSevenAsset) and not na(close)
            levelHitWindowActiveNow := true
            if nyPriceWindowTimestampEligible(time, levelHitWindowStartMinute, isTwentyFourSevenAsset)
                if time != liveCoveredBarTime
                    array.push(levelHitContactHighs, high)
                    array.push(levelHitContactLows, low)
                    array.push(levelHitContactTimes, updateTime)
                    livePreviousClose := close
                    liveCoveredBarTime := time
                else
                    array.push(levelHitContactHighs, math.max(livePreviousClose, close))
                    array.push(levelHitContactLows, math.min(livePreviousClose, close))
                    array.push(levelHitContactTimes, updateTime)
                    livePreviousClose := close
            else
                // The bar opened before the window, so only the in-window tick price itself counts.
                array.push(levelHitContactHighs, close)
                array.push(levelHitContactLows, close)
                array.push(levelHitContactTimes, updateTime)
                livePreviousClose := close
                liveCoveredBarTime := time
    else if priceWindowMayContainEligiblePrice(levelHitWindowStartMinute, intrabarTimes, isTwentyFourSevenAsset, levelHitFallbackWindow)
        int hitIntrabarCount = array.size(intrabarTimes)
        if hitIntrabarCount > 0
            for intrabarIndex = 0 to hitIntrabarCount - 1
                int subTime = array.get(intrabarTimes, intrabarIndex)
                if nyPriceWindowTimestampEligible(subTime, levelHitWindowStartMinute, isTwentyFourSevenAsset)
                    float subHigh = array.get(intrabarHighs, intrabarIndex)
                    float subLow = array.get(intrabarLows, intrabarIndex)
                    if not na(subHigh) and not na(subLow)
                        array.push(levelHitContactHighs, subHigh)
                        array.push(levelHitContactLows, subLow)
                        array.push(levelHitContactTimes, subTime)
        else if not na(high) and not na(low)
            array.push(levelHitContactHighs, high)
            array.push(levelHitContactLows, low)
            array.push(levelHitContactTimes, time)
        levelHitWindowActiveNow := array.size(levelHitContactTimes) > 0

if valueGapsActive
    bool valueGapFallbackWindow = valueGapFillWindow == WINDOW_LABEL_FROM_0500 ? inVisibleFrom0500 : valueGapFillWindow == WINDOW_LABEL_FROM_0830 ? inVisibleFrom0830 : rthInSession
    float valueGapBreachHigh = valueGapFillWindow == WINDOW_LABEL_RTH ? rthEligibleHigh : na
    float valueGapBreachLow = valueGapFillWindow == WINDOW_LABEL_RTH ? rthEligibleLow : na
    if valueGapFillWindow != WINDOW_LABEL_RTH
        bool valueGapRangeNeeded = fillRangeMayContainEligiblePrice(valueGapFillWindow, intrabarTimes, isTwentyFourSevenAsset, valueGapFallbackWindow)
        if valueGapRangeNeeded
            [calculatedGapHigh, calculatedGapLow] = valueGapFillRange(valueGapFillWindow, intrabarHighs, intrabarLows, intrabarTimes, isTwentyFourSevenAsset, valueGapFallbackWindow)
            valueGapBreachHigh := calculatedGapHigh
            valueGapBreachLow := calculatedGapLow
    if not na(valueGapBreachHigh) and not na(valueGapBreachLow)
        updateValueGapPriceFills(valueGapRecords, valueGapBreachHigh, valueGapBreachLow)

float fallbackSampleHigh = high
float fallbackSampleLow = low
float fallbackSampleVolume = volume
float fallbackFlushHigh = na
float fallbackFlushLow = na
float fallbackFlushVolume = na
if fallbackBucketAggregationActive and barstate.isconfirmed
    bool fallbackBarNeeded = array.size(intrabarVolumes) == 0
    int barBucketId = time / FALLBACK_PARITY_BUCKET_MS
// A pending bucket is stale once HD data resumes or the bar belongs to a newer bucket.
    if not na(fallbackBucketVolume) and (not fallbackBarNeeded or barBucketId != fallbackBucketId)
        fallbackFlushHigh := fallbackBucketHigh
        fallbackFlushLow := fallbackBucketLow
        fallbackFlushVolume := fallbackBucketVolume
        fallbackBucketHigh := na
        fallbackBucketLow := na
        fallbackBucketVolume := na
        fallbackBucketId := -1
    if fallbackBarNeeded
        if not na(volume) and volume > 0 and not na(high) and not na(low)
            fallbackBucketHigh := na(fallbackBucketHigh) ? high : math.max(fallbackBucketHigh, high)
            fallbackBucketLow := na(fallbackBucketLow) ? low : math.min(fallbackBucketLow, low)
            fallbackBucketVolume := na(fallbackBucketVolume) ? volume : fallbackBucketVolume + volume
            fallbackBucketId := barBucketId
        if time_close % FALLBACK_PARITY_BUCKET_MS == 0 and not na(fallbackBucketVolume)
            fallbackSampleHigh := fallbackBucketHigh
            fallbackSampleLow := fallbackBucketLow
            fallbackSampleVolume := fallbackBucketVolume
            fallbackBucketHigh := na
            fallbackBucketLow := na
            fallbackBucketVolume := na
            fallbackBucketId := -1
        else
            fallbackSampleVolume := na

[preparedBarHighs, preparedBarLows, preparedBarVolumes] = prepareBarVolumeSamples(intrabarHighs, intrabarLows, intrabarVolumes, fallbackSampleHigh, fallbackSampleLow, fallbackSampleVolume, barstate.isconfirmed)
if not na(fallbackFlushVolume)
    array.insert(preparedBarHighs, 0, fallbackFlushHigh)
    array.insert(preparedBarLows, 0, fallbackFlushLow)
    array.insert(preparedBarVolumes, 0, fallbackFlushVolume)

// Policies are allocated once; per-bar calls pass only state, events and prepared samples.
var AnchorProcessPolicy rthProcessPolicy = newMergedAnchorProcessPolicy(rthProfilesToRetain, rthMergeMode, RTH_MERGE_SPAN_FRACTION, false, rthFilterEnabled and rthShowHistogram)
var AnchorProcessPolicy globexProcessPolicy = newMergedAnchorProcessPolicy(globexProfilesToRetain, globexMergeMode, GLOBEX_MERGE_SPAN_FRACTION, true, globexFilterEnabled and globexShowHistogram)
var AnchorProcessPolicy weeklyProcessPolicy = newCalendarAnchorProcessPolicy(weeklyProfilesToShow, weeklyFilterEnabled and weeklyShowHistogram, false)
var AnchorProcessPolicy monthlyProcessPolicy = newCalendarAnchorProcessPolicy(monthlyProfilesToShow, monthlyFilterEnabled and monthlyShowHistogram, false)

processAnchor(rthState, rthMergeState, rthProcessPolicy, true, rthInSession, rthSessionStart, rthSessionEnd, preparedBarHighs, preparedBarLows, preparedBarVolumes, barstate.isconfirmed)
processAnchor(globexState, globexMergeState, globexProcessPolicy, true, true, globexDayStart, false, preparedBarHighs, preparedBarLows, preparedBarVolumes, barstate.isconfirmed)
processAnchor(weeklyState, weeklyMergeState, weeklyProcessPolicy, true, true, weeklyPeriodStart, false, preparedBarHighs, preparedBarLows, preparedBarVolumes, barstate.isconfirmed)
processAnchor(monthlyState, monthlyMergeState, monthlyProcessPolicy, true, true, monthlyPeriodStart, false, preparedBarHighs, preparedBarLows, preparedBarVolumes, barstate.isconfirmed)

if valueGapsActive
    syncValueGapProfile(valueGapSourceIsRth ? rthState.profiles : globexState.profiles, valueGapSourceProfiles, valueGapRecords)

rthMitigationActive = rthEffectiveExtensionMode == LEVEL_BREACH_ANY or rthEffectiveExtensionMode == LEVEL_BREACH_SAME
globexMitigationActive = globexEffectiveExtensionMode == LEVEL_BREACH_ANY
weeklyMitigationActive = weeklyExtensionMode == LEVEL_BREACH_ANY
monthlyMitigationActive = monthlyExtensionMode == LEVEL_BREACH_ANY
quarterlyMitigationActive = quarterlyExtensionMode == LEVEL_BREACH_ANY
rthDevelopingProfileActive = rthFilterEnabled and rthInSession and rthDevelopingEnabled and isBeforeNyCutoff(rthDevelopingCutoffHour, rthDevelopingCutoffMinute)
rthSweepActive = rthEffectiveExtensionMode == LEVEL_BREACH_SWEEP
globexSweepActive = globexEffectiveExtensionMode == LEVEL_BREACH_SWEEP
weeklySweepActive = weeklyExtensionMode == LEVEL_BREACH_SWEEP
monthlySweepActive = monthlyExtensionMode == LEVEL_BREACH_SWEEP
quarterlySweepActive = quarterlyExtensionMode == LEVEL_BREACH_SWEEP
levelHitDetectionActive = levelHitDetectionEnabled and levelHitWindowActiveNow
levelHitTracePresentationActive = levelHitDetectionEnabled and (levelHitHistory != LEVEL_HIT_HISTORY_CURRENT_WINDOW or levelHitDetectionActive)
rthHitTraceSourceActive = levelHitDetectionEnabled and (rthFilterEnabled or levelHitUnselectedAnchorsActive) and rthEffectiveExtensionMode != LEVEL_PERIOD
globexHitTraceSourceActive = levelHitDetectionEnabled and (globexFilterEnabled or levelHitUnselectedAnchorsActive) and globexEffectiveExtensionMode != LEVEL_PERIOD
weeklyHitTraceSourceActive = levelHitDetectionEnabled and (weeklyFilterEnabled or levelHitUnselectedAnchorsActive) and weeklyExtensionMode != LEVEL_PERIOD
monthlyHitTraceSourceActive = levelHitDetectionEnabled and (monthlyFilterEnabled or levelHitUnselectedAnchorsActive) and monthlyExtensionMode != LEVEL_PERIOD
quarterlyHitTraceSourceActive = levelHitDetectionEnabled and (quarterlyFilterEnabled or levelHitUnselectedAnchorsActive) and quarterlyExtensionMode != LEVEL_PERIOD
rthFocusedHitTraceActive = focusHitTraceActive and rthHitTraceSourceActive
globexFocusedHitTraceActive = focusHitTraceActive and globexHitTraceSourceActive
recordLevelHitRanges(levelHitRanges, levelHitDetectionActive and (rthFocusedHitTraceActive or globexFocusedHitTraceActive), time, time)

int rthHitTraceFromIndex = hitTraceProfileFromIndex(rthState.profiles, focusSelected and rthFilterEnabled, rthEffectiveProfilesToShow)
int globexHitTraceFromIndex = hitTraceProfileFromIndex(globexState.profiles, focusSelected and globexFilterEnabled, globexEffectiveProfilesToShow)
map.clear(retainedLevelHitSourceProfiles)
registerLevelHitSourceProfiles(retainedLevelHitSourceProfiles, rthState.profiles, rthHitTraceFromIndex, rthHitTraceSourceActive, rthStyle)
registerLevelHitSourceProfiles(retainedLevelHitSourceProfiles, globexState.profiles, globexHitTraceFromIndex, globexHitTraceSourceActive, globexStyle)
registerLevelHitSourceProfiles(retainedLevelHitSourceProfiles, weeklyState.profiles, 0, weeklyHitTraceSourceActive, weeklyStyle)
registerLevelHitSourceProfiles(retainedLevelHitSourceProfiles, monthlyState.profiles, 0, monthlyHitTraceSourceActive, monthlyStyle)
registerLevelHitSourceProfiles(retainedLevelHitSourceProfiles, quarterlyState.profiles, 0, quarterlyHitTraceSourceActive, quarterlyStyle)
updateLevelHitTrace(rthState.profiles, rthHitTraceFromIndex, levelHitDetectionActive and rthHitTraceSourceActive, rthFilterEnabled, levelHitIncludeOlderLevels, levelHitLimitDailyRetouches, rthStyle, levelHitEvents)
updateLevelHitTrace(globexState.profiles, globexHitTraceFromIndex, levelHitDetectionActive and globexHitTraceSourceActive, globexFilterEnabled, levelHitIncludeOlderLevels, levelHitLimitDailyRetouches, globexStyle, levelHitEvents)
updateLevelHitTrace(weeklyState.profiles, 0, levelHitDetectionActive and weeklyHitTraceSourceActive, weeklyFilterEnabled, levelHitIncludeOlderLevels, levelHitLimitDailyRetouches, weeklyStyle, levelHitEvents)
updateLevelHitTrace(monthlyState.profiles, 0, levelHitDetectionActive and monthlyHitTraceSourceActive, monthlyFilterEnabled, levelHitIncludeOlderLevels, levelHitLimitDailyRetouches, monthlyStyle, levelHitEvents)
updateLevelHitTrace(quarterlyState.profiles, 0, levelHitDetectionActive and quarterlyHitTraceSourceActive, quarterlyFilterEnabled, levelHitIncludeOlderLevels, levelHitLimitDailyRetouches, quarterlyStyle, levelHitEvents)

if barstate.isconfirmed
    float sweepMarginFraction = sweepConfirmMarginPercent / 100.0
    bool mitigationRangeNeeded = rthMitigationActive or globexMitigationActive or weeklyMitigationActive or monthlyMitigationActive or quarterlyMitigationActive
    float mitigationBreachHigh = mitigationRangeNeeded ? (array.size(intrabarHighs) > 0 ? array.max(intrabarHighs) : high) : na
    float mitigationBreachLow = mitigationRangeNeeded ? (array.size(intrabarLows) > 0 ? array.min(intrabarLows) : low) : na
    updateAnchorLevels(rthState, rthMitigationActive, rthEffectiveExtensionMode == LEVEL_BREACH_SAME, rthInSession, rthSweepActive, mitigationBreachHigh, mitigationBreachLow, sweepMarginFraction)
    updateAnchorLevels(globexState, globexMitigationActive, false, true, globexSweepActive, mitigationBreachHigh, mitigationBreachLow, sweepMarginFraction)
    updateAnchorLevels(weeklyState, weeklyMitigationActive, false, true, weeklySweepActive, mitigationBreachHigh, mitigationBreachLow, sweepMarginFraction)
    updateAnchorLevels(monthlyState, monthlyMitigationActive, false, true, monthlySweepActive, mitigationBreachHigh, mitigationBreachLow, sweepMarginFraction)
    updateAnchorLevels(quarterlyState, quarterlyMitigationActive, false, true, quarterlySweepActive, mitigationBreachHigh, mitigationBreachLow, sweepMarginFraction)

// ═══════════════════════════════════════════════════════════════════════════════
// RENDER
// ═══════════════════════════════════════════════════════════════════════════════
if barstate.islast
    clearDrawings()
    map.clear(renderedLevelHitKeys)
    map.clear(levelHitPresentations)
    bool valueGapFloatingActive = valueGapsActive and valueGapDisplayMode != VALUE_GAP_DISPLAY_HISTORICAL
    bool valueGapHistoricalActive = valueGapsActive and valueGapDisplayMode != VALUE_GAP_DISPLAY_FLOATING
    // Globex is continuous: no session gate.
    bool upcomingValueGapActive = valueGapsActive and upcomingValueGapEnabled and (valueGapSourceIsRth ? rthInSession : true)
    bool useUtcValueGapLabels = not valueGapSourceIsRth and useUtcCalendarAnchors
    bool rthUpcomingSource = upcomingValueGapActive and valueGapSourceIsRth
    bool globexUpcomingSource = upcomingValueGapActive and not valueGapSourceIsRth
    Profile rthLiveProfile = na
    Profile globexLiveProfile = na
    Profile weeklyLiveProfile = na
    Profile monthlyLiveProfile = na
    Profile quarterlyLiveProfile = na
    if rthInSession and ((rthFilterEnabled and rthShowDeveloping) or rthUpcomingSource)
        rthLiveProfile := buildDevelopingAnchorProfile(rthState, intrabarHighs, intrabarLows, intrabarVolumes, rthFilterEnabled and rthShowHistogram)
    if ((globexFilterEnabled and globexShowDeveloping) or globexUpcomingSource) and array.size(globexState.barVolumes) > 0
        globexLiveProfile := buildDevelopingAnchorProfile(globexState, intrabarHighs, intrabarLows, intrabarVolumes, globexFilterEnabled and globexShowHistogram)
    if weeklyFilterEnabled and weeklyShowDeveloping and array.size(weeklyState.barVolumes) > 0
        weeklyLiveProfile := buildDevelopingAnchorProfile(weeklyState, intrabarHighs, intrabarLows, intrabarVolumes, weeklyShowHistogram)
    if monthlyFilterEnabled and monthlyShowDeveloping and array.size(monthlyState.barVolumes) > 0
        monthlyLiveProfile := buildDevelopingAnchorProfile(monthlyState, intrabarHighs, intrabarLows, intrabarVolumes, monthlyShowHistogram)
    if quarterlyFilterEnabled and quarterlyShowDeveloping and not na(quarterlyDevelopingSnapshot)
        quarterlyLiveProfile := quarterlyDevelopingSnapshot
    array<int> floatingValueGapIndices = selectValueGapFloats(valueGapRecords, valueGapFloatingActive, valueGapNearestFloats)
    int historicalGapLimit = valueGapDisplayMode == VALUE_GAP_DISPLAY_RECENT_FLOATING ? 1 : valueGapsToShow
    renderValueGaps(valueGapRecords, valueGapHistoricalActive, floatingValueGapIndices, historicalGapLimit, useUtcValueGapLabels)
    if valueGapFloatingActive
        renderFloatingValueGaps(valueGapRecords, floatingValueGapIndices, useUtcValueGapLabels)
    renderUpcomingValueGap(valueGapSourceIsRth ? rthState.profiles : globexState.profiles, valueGapSourceIsRth ? rthLiveProfile : globexLiveProfile, upcomingValueGapActive, useUtcValueGapLabels)
    // Live profiles are the newest drawings, so their runs are reserved before completed profiles compete.
    bool rthHistogramActive = rthFilterEnabled and rthShowHistogram
    bool globexHistogramActive = globexFilterEnabled and globexShowHistogram
    bool weeklyHistogramActive = weeklyFilterEnabled and weeklyShowHistogram
    bool monthlyHistogramActive = monthlyFilterEnabled and monthlyShowHistogram
    bool quarterlyHistogramActive = quarterlyFilterEnabled and quarterlyShowHistogram
    bool focusActive = focusSelected and (rthFilterEnabled or globexFilterEnabled)
    float focusAnchor = focusAnchorPrice(focusAnchorMode, focusManualPrice, focusManualPricePlaced, close)
    bool focusManualAnchorVisible = focusActive and focusAnchorMode == FOCUS_ANCHOR_MANUAL
    renderFocusAnchor(focusManualAnchorVisible, focusAnchor, focusManualPricePlaced, focusAnchorColor, focusAnchorWidth, focusAnchorLabelOffset)
    int liveHistogramReserve = (rthHistogramActive and rthShowDeveloping and array.size(rthState.barVolumes) > 0 ? 3 : 0) + (globexHistogramActive and globexShowDeveloping and array.size(globexState.barVolumes) > 0 ? 3 : 0) + (weeklyHistogramActive and weeklyShowDeveloping and array.size(weeklyState.barVolumes) > 0 ? 3 : 0) + (monthlyHistogramActive and monthlyShowDeveloping and array.size(monthlyState.barVolumes) > 0 ? 3 : 0) + (quarterlyHistogramActive and quarterlyShowDeveloping and not na(quarterlyLiveProfile) ? 3 : 0)
    array<RenderBudgetAnchor> renderBudgetAnchors = array.new<RenderBudgetAnchor>()
    array.push(renderBudgetAnchors, RenderBudgetAnchor.new(rthState.profiles, rthStyle, rthFilterEnabled, rthHistogramActive, array.new<bool>(), focusActive and rthFilterEnabled, focusSurfaceSweptLevels))
    array.push(renderBudgetAnchors, RenderBudgetAnchor.new(globexState.profiles, globexStyle, globexFilterEnabled, globexHistogramActive, array.new<bool>(), focusActive and globexFilterEnabled, focusSurfaceSweptLevels))
    array.push(renderBudgetAnchors, RenderBudgetAnchor.new(weeklyState.profiles, weeklyStyle, weeklyFilterEnabled, weeklyHistogramActive, array.new<bool>(), false, false))
    array.push(renderBudgetAnchors, RenderBudgetAnchor.new(monthlyState.profiles, monthlyStyle, monthlyFilterEnabled, monthlyHistogramActive, array.new<bool>(), false, false))
    array.push(renderBudgetAnchors, RenderBudgetAnchor.new(quarterlyState.profiles, quarterlyStyle, quarterlyFilterEnabled, quarterlyHistogramActive, array.new<bool>(), false, false))
    registerAnchorLevelHitPresentations(levelHitPresentations, array.get(renderBudgetAnchors, 0), rthHitTraceFromIndex, rthHitTraceSourceActive, false, false)
    registerAnchorLevelHitPresentations(levelHitPresentations, array.get(renderBudgetAnchors, 1), globexHitTraceFromIndex, globexHitTraceSourceActive, false, false)
    registerAnchorLevelHitPresentations(levelHitPresentations, array.get(renderBudgetAnchors, 2), 0, weeklyHitTraceSourceActive, false, false)
    registerAnchorLevelHitPresentations(levelHitPresentations, array.get(renderBudgetAnchors, 3), 0, monthlyHitTraceSourceActive, false, false)
    registerAnchorLevelHitPresentations(levelHitPresentations, array.get(renderBudgetAnchors, 4), 0, quarterlyHitTraceSourceActive, false, false)
    if focusActive
        selectFocusedProfiles(renderBudgetAnchors, DAILY_PROFILE_ANCHOR_COUNT, focusAnchor, focusDirection, focusProfileCount)
        trimFocusToBudget(renderBudgetAnchors, DAILY_PROFILE_ANCHOR_COUNT, focusAnchor, focusDirection, INDICATOR_MAX_POLYLINES - liveHistogramReserve)
        registerFocusedLevelHitSourceProfiles(retainedLevelHitSourceProfiles, array.get(renderBudgetAnchors, 0), rthFocusedHitTraceActive)
        registerFocusedLevelHitSourceProfiles(retainedLevelHitSourceProfiles, array.get(renderBudgetAnchors, 1), globexFocusedHitTraceActive)
        registerAnchorLevelHitPresentations(levelHitPresentations, array.get(renderBudgetAnchors, 0), 0, rthFocusedHitTraceActive, true, focusSurfaceSweptLevels)
        registerAnchorLevelHitPresentations(levelHitPresentations, array.get(renderBudgetAnchors, 1), 0, globexFocusedHitTraceActive, true, focusSurfaceSweptLevels)
        array<FocusHitLevel> focusedHitLevels = array.new<FocusHitLevel>()
        collectFocusedHitLevels(array.get(renderBudgetAnchors, 0), rthFocusedHitTraceActive, levelHitIncludeOlderLevels, levelHitLimitDailyRetouches, focusedHitLevels)
        collectFocusedHitLevels(array.get(renderBudgetAnchors, 1), globexFocusedHitTraceActive, levelHitIncludeOlderLevels, levelHitLimitDailyRetouches, focusedHitLevels)
        string currentFocusedHitBackfillKey = focusedHitLevelsKey(focusedHitLevels)
        if levelHitTracePresentationActive and currentFocusedHitBackfillKey != focusedHitBackfillKey
            backfillFocusedLevelHitTrace(focusedHitLevels, levelHitRanges, levelHitEvents, true)
            focusedHitBackfillKey := currentFocusedHitBackfillKey
        else if not levelHitTracePresentationActive
            focusedHitBackfillKey := ""
        updateFocusedLevelHitTrace(array.get(renderBudgetAnchors, 0), levelHitDetectionActive and rthFocusedHitTraceActive, levelHitIncludeOlderLevels, levelHitLimitDailyRetouches, levelHitEvents)
        updateFocusedLevelHitTrace(array.get(renderBudgetAnchors, 1), levelHitDetectionActive and globexFocusedHitTraceActive, levelHitIncludeOlderLevels, levelHitLimitDailyRetouches, levelHitEvents)
    else
        focusedHitBackfillKey := ""
    pruneLevelHitEvents(levelHitEvents, levelHitTracePresentationActive, retainedLevelHitSourceProfiles)
    array<int> histogramFromIndices = allocateProfileBudget(renderBudgetAnchors, INDICATOR_MAX_POLYLINES - liveHistogramReserve, true)
    int liveLineReserve = liveProfileLineCount(rthLiveProfile, rthFilterEnabled and rthShowDeveloping, rthStyle) + liveProfileLineCount(globexLiveProfile, globexFilterEnabled and globexShowDeveloping, globexStyle) + liveProfileLineCount(weeklyLiveProfile, weeklyFilterEnabled and weeklyShowDeveloping, weeklyStyle) + liveProfileLineCount(monthlyLiveProfile, monthlyFilterEnabled and monthlyShowDeveloping, monthlyStyle) + liveProfileLineCount(quarterlyLiveProfile, quarterlyFilterEnabled and quarterlyShowDeveloping, quarterlyStyle)
    int completedLineBudget = math.max(0, INDICATOR_MAX_LINES - array.size(drawnLines) - liveLineReserve)
    array<int> lineFromIndices = allocateProfileBudget(renderBudgetAnchors, completedLineBudget, false)
    int rthHistogramFromIndex = array.get(histogramFromIndices, 0)
    int globexHistogramFromIndex = array.get(histogramFromIndices, 1)
    int weeklyHistogramFromIndex = array.get(histogramFromIndices, 2)
    int monthlyHistogramFromIndex = array.get(histogramFromIndices, 3)
    int quarterlyHistogramFromIndex = array.get(histogramFromIndices, 4)
    int rthLineFromIndex = array.get(lineFromIndices, 0)
    int globexLineFromIndex = array.get(lineFromIndices, 1)
    int weeklyLineFromIndex = array.get(lineFromIndices, 2)
    int monthlyLineFromIndex = array.get(lineFromIndices, 3)
    int quarterlyLineFromIndex = array.get(lineFromIndices, 4)
    bool touchLabelsActive = levelHitShowLabels and levelHitDetectionActive
    registerArchivedLevelHitKeys(levelHitEvents, levelHitPresentations, archivedLevelHitKeys)
    renderAnchor(array.get(renderBudgetAnchors, 0), rthLiveProfile, rthDevelopingProfileActive, rthShowDeveloping, rthHistogramFromIndex, rthLineFromIndex, touchLabelsActive, archivedLevelHitKeys, renderedLevelHitKeys)
    renderAnchor(array.get(renderBudgetAnchors, 1), globexLiveProfile, false, globexShowDeveloping, globexHistogramFromIndex, globexLineFromIndex, touchLabelsActive, archivedLevelHitKeys, renderedLevelHitKeys)
    renderAnchor(array.get(renderBudgetAnchors, 2), weeklyLiveProfile, false, weeklyShowDeveloping, weeklyHistogramFromIndex, weeklyLineFromIndex, touchLabelsActive, archivedLevelHitKeys, renderedLevelHitKeys)
    renderAnchor(array.get(renderBudgetAnchors, 3), monthlyLiveProfile, false, monthlyShowDeveloping, monthlyHistogramFromIndex, monthlyLineFromIndex, touchLabelsActive, archivedLevelHitKeys, renderedLevelHitKeys)
    renderAnchor(array.get(renderBudgetAnchors, 4), quarterlyLiveProfile, false, quarterlyShowDeveloping, quarterlyHistogramFromIndex, quarterlyLineFromIndex, touchLabelsActive, archivedLevelHitKeys, renderedLevelHitKeys)
    array<int> levelHitGroupIndices = levelHitEventGroups(levelHitEvents, levelHitTracePresentationActive, renderedLevelHitKeys, levelHitPresentations)
    registerLevelHitLabelClusters(levelHitEvents, levelHitGroupIndices, levelHitLabelClusters)
    bufferLevelHitLabels(levelHitEvents, touchLabelsActive, renderedLevelHitKeys, levelHitPresentations)
    // Preserve right-edge labels and recent hits before secondary reminder labels under drawing pressure.
    flushPendingLabels(dedupeLabels, levelHitLabelClusters)
    renderLevelHitCircles(levelHitEvents, levelHitGroupIndices, levelHitPresentations)
    flushPendingAnchorReminders(dedupeLabels)
    flushPendingReminders(dedupeLabels)

    if showColorTable
        bool hasLevelLabelBackground = focusManualAnchorVisible or sessionLevelLabelsActive(rthFilterEnabled, rthStyle) or sessionLevelLabelsActive(globexFilterEnabled, globexStyle) or sessionLevelLabelsActive(weeklyFilterEnabled, weeklyStyle) or sessionLevelLabelsActive(monthlyFilterEnabled, monthlyStyle) or sessionLevelLabelsActive(quarterlyFilterEnabled, quarterlyStyle)

        array<ColorRow> colorRows = array.new<ColorRow>()
        if hasLevelLabelBackground
            addColorRow(colorRows, LABEL_LEVEL_LABEL_BACKGROUND, levelLabelBgColor, "")
        if focusManualAnchorVisible
            addColorRow(colorRows, LABEL_MANUAL_FOCUS_ANCHOR, focusAnchorColor, str.tostring(focusAnchorWidth))
        bool upcomingGapColorsActive = valueGapsActive and upcomingValueGapEnabled
        collectValueGapColorRows(colorRows, valueGapSource + " Value Gaps", valueGapsActive, confirmedValueGapStyle(), true)
        if upcomingGapColorsActive
            addColorRow(colorRows, "Upcoming Gap Fill", upcomingValueGapColor, "")
            addColorRow(colorRows, "Upcoming Gap Border", upcomingValueGapBorderColor, "")
        collectSessionColorRows(colorRows, SESSION_RTH, rthFilterEnabled, rthShowDeveloping, rthStyle)
        collectSessionColorRows(colorRows, SESSION_GLOBEX, globexFilterEnabled, globexShowDeveloping, globexStyle)
        collectSessionColorRows(colorRows, SESSION_WEEKLY, weeklyFilterEnabled, weeklyShowDeveloping, weeklyStyle)
        collectSessionColorRows(colorRows, SESSION_MONTHLY, monthlyFilterEnabled, monthlyShowDeveloping, monthlyStyle)
        collectSessionColorRows(colorRows, SESSION_QUARTERLY, quarterlyFilterEnabled, quarterlyShowDeveloping, quarterlyStyle)
        if showOnlyEnabled
            addColorRow(colorRows, LABEL_HIDDEN_CANDLES, hiddenCandleColor, "")

        if not na(colorTable)
            table.delete(colorTable)
        colorTable := table.new(position.top_right, 4, array.size(colorRows) + 1, bgcolor=color.rgb(255, 255, 255), border_width=1, border_color=color.rgb(128, 128, 128), frame_width=1, frame_color=color.rgb(128, 128, 128))
        table.cell(colorTable, 0, 0, LABEL_TABLE_SETTING, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        table.cell(colorTable, 1, 0, LABEL_TABLE_RGB, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        table.cell(colorTable, 2, 0, LABEL_TABLE_TRANSPARENCY, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        table.cell(colorTable, 3, 0, LABEL_TABLE_WIDTH, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)

        if array.size(colorRows) > 0
            for rowIndex = 0 to array.size(colorRows) - 1
                writeColorRow(colorTable, rowIndex + 1, array.get(colorRows, rowIndex))
    else if not na(colorTable)
        table.delete(colorTable)
        colorTable := na

// revelio •
