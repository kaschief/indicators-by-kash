rthValueGapDisplayMode = input.string(VALUE_GAP_DISPLAY_HISTORICAL_FLOATING, "Display", options=[VALUE_GAP_DISPLAY_HISTORICAL, VALUE_GAP_DISPLAY_HISTORICAL_FLOATING, VALUE_GAP_DISPLAY_RECENT_FLOATING, VALUE_GAP_DISPLAY_FLOATING], inline="rth_vag_display", group=GROUP_RTH_VALUE_GAPS_LIVE, tooltip="Historical draws anchored confirmed gaps. Historical + Floating floats open selections while retaining the configured history. Most Recent + Floating keeps one recent anchored gap plus the open floats. Floating Only hides anchored gaps while lifecycle tracking continues.")
