LABEL_GLOBEX_SWEPT_KEEP = "Days to Keep Globex Swept Lines"
LABEL_WEEKLY_SWEPT_KEEP = "Weeks to Keep Weekly Swept Lines"
LABEL_MONTHLY_SWEPT_KEEP = "Months to Keep Monthly Swept Lines"
LABEL_QUARTERLY_SWEPT_KEEP = "Quarters to Keep Quarterly Swept Lines"
TOOLTIP_SWEEP_MARGIN = "Until Swept only. A side qualifies after a close exceeds the level by this share of the profile range. Both sides must qualify."
TOOLTIP_SWEPT_CONTINUATION_LINE_FADE = "Extra fade for swept dashed lines."
TOOLTIP_SWEPT_LABEL_TEXT_FADE = "Extra fade for swept label text."
TOOLTIP_RTH_SWEPT_KEEP = "Days to retain older RTH swept lines. Controls line visibility only; retained levels remain eligible for Touch Markers. The newest profile always remains."
TOOLTIP_GLOBEX_SWEPT_KEEP = "Days to retain older Globex swept lines. Controls line visibility only; retained levels remain eligible for Touch Markers. The newest profile always remains."
TOOLTIP_WEEKLY_SWEPT_KEEP = "Weeks to retain older Weekly swept lines. Controls line visibility only; retained levels remain eligible for Touch Markers. The newest profile always remains."
TOOLTIP_MONTHLY_SWEPT_KEEP = "Months to retain older Monthly swept lines. Controls line visibility only; retained levels remain eligible for Touch Markers. The newest profile always remains."
TOOLTIP_QUARTERLY_SWEPT_KEEP = "Quarters to retain older Quarterly swept lines. Controls line visibility only; retained levels remain eligible for Touch Markers. The newest profile always remains."
