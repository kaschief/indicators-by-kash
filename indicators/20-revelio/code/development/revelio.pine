monthlyValueAreaLastColor = input.color(color.new(color.rgb(76, 175, 80), 0), LABEL_LAST_VALUE_AREA_COLOR, inline="monthly_value_area_last", group=GROUP_MONTHLY, active=monthlyControlsActive)
