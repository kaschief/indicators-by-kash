// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Utility
// ═══════════════════════════════════════════════════════════════════════════════
showColorTable = input.bool(false, "Color & Widths Reference Table", tooltip="Show a reference table (top-right) listing every color's RGB, transparency and line width.", group=GROUP_UTILITY)

// ═══════════════════════════════════════════════════════════════════════════════
// TYPES
// ═══════════════════════════════════════════════════════════════════════════════
enum ValueGapEntryDirection
    fromBelow
    fromAbove

type Profile
    int startTime
    int endTime
    float priceLow
    float priceHigh
    int rowCount
    array<float> rowVolumes
    int pocRow
    int valueAreaLowRow
    int valueAreaHighRow
    float pocPrice
    float valueAreaHighPrice
    float valueAreaLowPrice
    int pocBreachTime
    int valueAreaHighBreachTime
    int valueAreaLowBreachTime
    bool hasAlternatePoc
    float alternatePocPrice
    int alternatePocBreachTime
    bool isValid
    bool pocSweptAbove
    bool pocSweptBelow
    bool valueAreaHighSweptAbove
    bool valueAreaHighSweptBelow
    bool valueAreaLowSweptAbove
    bool valueAreaLowSweptBelow
    bool alternatePocSweptAbove
    bool alternatePocSweptBelow

// Confirmed non-overlap between consecutive RTH value areas after short-session merging. leftTime
// begins at the confirming profile's open; creationTime is its close and gates later fill tracking.
type ValueGap
    int leftTime
    int creationTime
    float top
    float bottom
    bool bullish
    int fillTime
    ValueGapEntryDirection entryDirection
    float coreTop
    float coreBottom

type ValueGapStyle
    color bullishColor
    color bearishColor
    color filledColor
    bool showBorders
    color bullishBorderColor
    color bearishBorderColor
    bool showLabels
    color bullishLabelColor
    color bearishLabelColor
    color mitigatedLabelColor
    string labelSize
    bool showMidpointLine
    color midpointOpenLineColor
    color midpointMitigatedLineColor
    bool showMidpointLabel
    bool showQuartileLines
    color quartileOpenLineColor
    color quartileMitigatedLineColor
    bool showQuartileLabels
    string internalLabelSize
    int internalLabelFade
    bool showInternalReminders

type SessionStyle
    string extensionMode
    bool dimTouched
    float dimFraction
    bool showPoc
    color pocColor
    int pocWidth
    string pocStyle
    bool showAlternatePoc
    color alternatePocColor
    int alternatePocWidth
    string alternatePocStyle
    bool showValueArea
    color valueAreaColor
    color valueAreaLastColor
    int valueAreaWidth
    string valueAreaStyle
    bool showHistogram
    color histogramInsideColor
    color histogramOutsideColor
    bool showSessionBox
    color sessionBoxColor
    bool showPrice
    color levelLabelBgColor
    color valueAreaLabelColor
    color pocLabelColor
    color alternatePocLabelColor
    string levelLabelSize
    int levelLabelOffset
    bool developingEnabled
    color developingColor
    float sweptContinuationFraction
    int sweptContinuationWidth
    int sweptKeepMs
    string labelAnchor
    bool labelMonthOnly
    string labelLive
    string labelLast
    bool highlightEnabled
    int highlightOpacity
    bool showSweptReminders
    bool showSweptReminderDate
    int valueAreaLastWidth

// A buffered right-edge level label, collected during rendering so coincident-price labels can be
// merged into one before being drawn. rank ranks importance for which entry's color/size/price wins
// in a merged cluster (higher = more important): level type dominates, recency breaks ties.
type PendingLabel
    float price
    int xPos
    string namePart
    string pricePart
    bool wantPrice
    color textColor
    color bgColor
    string sizeName
    int rank

// A buffered swept-line reminder, collected so coincident-price reminders can carry the same merged
// identity as their right-edge label (otherwise a shared line's reminder reads only one anchor's name).
// endTime anchors the swept run; levelName drives the phase-shift; rank picks the cluster's winner.
type PendingReminder
    float price
    int endTime
    string namePart
    color textColor
    color bgColor
    string sizeName
    string levelName
    int rank

// Buffered active anchor reminder. Buffering lets Merge Overlapping Labels cluster coincident
// POC / VAH / VAL reminders before their sparse placements are generated.
type PendingAnchorReminder
    float price
    int anchorStartTime
    int anchorEndTime
    int runEndTime
    string namePart
    color textColor
    color bgColor
    string sizeName
    string levelName
    int rank

// ═══════════════════════════════════════════════════════════════════════════════
// FUNCTIONS — calculation (parameterized, reused for every anchor)
// ═══════════════════════════════════════════════════════════════════════════════

autoIntrabarTimeframe() =>
    chartSeconds = timeframe.in_seconds(timeframe.period)
    chartSeconds <= 60 ? "1S" : chartSeconds <= 15 * 60 ? "1" : chartSeconds <= 60 * 60 ? "5" : chartSeconds <= 4 * 60 * 60 ? "15" : "60"

selectedIntrabarTimeframe() =>
    intrabarResolution == "Auto" ? autoIntrabarTimeframe() : intrabarResolution

clampRow(float rawRow, int rowCount) =>
    math.max(0, math.min(rowCount - 1, int(math.floor(rawRow))))

toLabelSize(string sizeName) =>
    sizeName == LABEL_SIZE_TINY ? size.tiny : sizeName == LABEL_SIZE_NORMAL ? size.normal : sizeName == LABEL_SIZE_LARGE ? size.large : sizeName == LABEL_SIZE_HUGE ? size.huge : size.small

// Ordered tiny→huge so a merged cluster can keep its largest member's size.
labelSizeRank(string sizeName) =>
    sizeName == LABEL_SIZE_TINY ? 0 : sizeName == LABEL_SIZE_SMALL ? 1 : sizeName == LABEL_SIZE_NORMAL ? 2 : sizeName == LABEL_SIZE_LARGE ? 3 : 4

largerLabelSize(string a, string b) =>
    labelSizeRank(a) >= labelSizeRank(b) ? a : b

monthName(int monthNumber) =>
    switch monthNumber
        1 => "Jan"
        2 => "Feb"
        3 => "Mar"
        4 => "Apr"
        5 => "May"
        6 => "Jun"
        7 => "Jul"
        8 => "Aug"
        9 => "Sep"
        10 => "Oct"
        11 => "Nov"
        => "Dec"

toLineStyle(string styleName) =>
    styleName == STYLE_DASHED ? line.style_dashed : styleName == STYLE_DOTTED ? line.style_dotted : line.style_solid

isTrueWeekendBar(int barTime) =>
    int barDay = dayofweek(barTime, NY_TIMEZONE)
    int barHour = hour(barTime, NY_TIMEZONE)
    barDay == dayofweek.saturday or (barDay == dayofweek.sunday and barHour < SUNDAY_REOPEN_START_HOUR)

calendarDayStart(string timezone) =>
    ta.change(dayofmonth(time, timezone)) != 0

shiftedCalendarDayStart(string timezone, int timeShiftMilliseconds) =>
    ta.change(dayofmonth(time + timeShiftMilliseconds, timezone)) != 0

calendarWeekStart(string timezone) =>
    ta.change(weekofyear(time, timezone)) != 0

calendarMonthStart(string timezone) =>
    ta.change(month(time, timezone)) != 0

selectAssetCalendarStart(bool useUtcCalendar, bool utcStart, bool marketStart) =>
    useUtcCalendar ? utcStart : marketStart

isBeforeNyCutoff(int cutoffHour, int cutoffMinute) =>
    int currentMinutes = hour(time, NY_TIMEZONE) * 60 + minute(time, NY_TIMEZONE)
    int cutoffMinutes = cutoffHour * 60 + cutoffMinute
    currentMinutes < cutoffMinutes

// Collapse a period's raw samples into a fine fixed-row histogram in place, replacing each
// occupied row with one representative point sample (price = row center, volume = row total).
// Bounds storage by row count instead of bar count; binning matches buildProfile so the
// finalized profile is unchanged within histogram resolution.
compactSamples(array<float> highs, array<float> lows, array<float> volumes) =>
    int sampleCount = array.size(volumes)
    if sampleCount > 0
        float rawHigh = array.max(highs)
        float rawLow = array.min(lows)
        float priceSpan = math.max(rawHigh - rawLow, syminfo.mintick * SAMPLE_COMPACT_ROWS)
        float compactLow = rawHigh == rawLow ? rawLow - priceSpan * 0.5 : rawLow
        float rowHeight = priceSpan / SAMPLE_COMPACT_ROWS
        array<float> rowVolumes = array.new<float>(SAMPLE_COMPACT_ROWS, 0.0)
        for sampleIndex = 0 to sampleCount - 1
            float sampleHigh = array.get(highs, sampleIndex)
            float sampleLow = array.get(lows, sampleIndex)
            float sampleVolume = array.get(volumes, sampleIndex)
            int firstRow = clampRow((sampleLow - compactLow) / rowHeight, SAMPLE_COMPACT_ROWS)
            int lastRow = clampRow((sampleHigh - compactLow) / rowHeight, SAMPLE_COMPACT_ROWS)
            int rowsTouched = math.max(1, lastRow - firstRow + 1)
            float volumePerRow = sampleVolume / rowsTouched
            for rowIndex = firstRow to lastRow
                array.set(rowVolumes, rowIndex, array.get(rowVolumes, rowIndex) + volumePerRow)
        array.clear(highs)
        array.clear(lows)
        array.clear(volumes)
        for rowIndex = 0 to SAMPLE_COMPACT_ROWS - 1
            float rowVolume = array.get(rowVolumes, rowIndex)
            if rowVolume > 0
                float rowPrice = compactLow + (rowIndex + 0.5) * rowHeight
                array.push(highs, rowPrice)
                array.push(lows, rowPrice)
                array.push(volumes, rowVolume)

compactIfNeeded(array<float> highs, array<float> lows, array<float> volumes) =>
    if array.size(volumes) > SAMPLE_COMPACT_THRESHOLD
        compactSamples(highs, lows, volumes)

// Lower-tf sub-bars when available (HD); falls back to the chart bar so every session still builds.
appendBarVolume(array<float> highs, array<float> lows, array<float> volumes, array<float> intrabarHighs, array<float> intrabarLows, array<float> intrabarVolumes, float chartHigh, float chartLow, float chartVolume, bool compactAfter) =>
    int intrabarCount = array.size(intrabarVolumes)
    bool appended = false
    if intrabarCount > 0
        for intrabarIndex = 0 to intrabarCount - 1
            float subVolume = array.get(intrabarVolumes, intrabarIndex)
            float subHigh = array.get(intrabarHighs, intrabarIndex)
            float subLow = array.get(intrabarLows, intrabarIndex)
            if not na(subVolume) and subVolume > 0 and not na(subHigh) and not na(subLow)
                array.push(highs, subHigh)
                array.push(lows, subLow)
                array.push(volumes, subVolume)
                appended := true
    if not appended and not na(chartVolume) and chartVolume > 0 and not na(chartHigh) and not na(chartLow)
        array.push(highs, chartHigh)
        array.push(lows, chartLow)
        array.push(volumes, chartVolume)
    if compactAfter
        compactIfNeeded(highs, lows, volumes)

buildProfile(array<float> highs, array<float> lows, array<float> volumes, int rowCount, float valueAreaPercent, int startTime, int endTime) =>
    Profile profile = Profile.new(startTime, endTime, na, na, rowCount, array.new<float>(rowCount, 0.0), 0, 0, 0, na, na, na, na, na, na, false, na, na, false, false, false, false, false, false, false, false, false)
    int barCount = array.size(volumes)
    if barCount > 0
        float rawHigh = array.max(highs)
        float rawLow = array.min(lows)
        float priceSpan = math.max(rawHigh - rawLow, syminfo.mintick * rowCount)
        float profileLow = rawHigh == rawLow ? rawLow - priceSpan * 0.5 : rawLow
        float rowHeight = priceSpan / rowCount

        for barIndex = 0 to barCount - 1
            float barHigh = array.get(highs, barIndex)
            float barLow = array.get(lows, barIndex)
            float barVolume = array.get(volumes, barIndex)
            int firstRow = clampRow((barLow - profileLow) / rowHeight, rowCount)
            int lastRow = clampRow((barHigh - profileLow) / rowHeight, rowCount)
            int rowsTouched = math.max(1, lastRow - firstRow + 1)
            float volumePerRow = barVolume / rowsTouched
            for rowIndex = firstRow to lastRow
                array.set(profile.rowVolumes, rowIndex, array.get(profile.rowVolumes, rowIndex) + volumePerRow)

        float totalVolume = 0.0
        float maxRowVolume = 0.0
        int pocRow = 0
        for rowIndex = 0 to rowCount - 1
            float rowVolume = array.get(profile.rowVolumes, rowIndex)
            totalVolume += rowVolume
            if rowVolume > maxRowVolume
                maxRowVolume := rowVolume
                pocRow := rowIndex

        int valueAreaLowRow = pocRow
        int valueAreaHighRow = pocRow
        float accumulatedVolume = array.get(profile.rowVolumes, pocRow)
        float targetVolume = totalVolume * valueAreaPercent * 0.01
        while accumulatedVolume < targetVolume and (valueAreaLowRow > 0 or valueAreaHighRow < rowCount - 1)
            float volumeBelow = valueAreaLowRow > 0 ? array.get(profile.rowVolumes, valueAreaLowRow - 1) : -1.0
            float volumeAbove = valueAreaHighRow < rowCount - 1 ? array.get(profile.rowVolumes, valueAreaHighRow + 1) : -1.0
            if volumeAbove >= volumeBelow
                valueAreaHighRow += 1
                accumulatedVolume += math.max(volumeAbove, 0)
            else
                valueAreaLowRow -= 1
                accumulatedVolume += math.max(volumeBelow, 0)

        // Nearest alternate POC (volume-only): the heaviest secondary node outside the
        // POC's own shoulder. It qualifies purely when it is nearly as heavy as the POC —
        // that near-tie is what lets a small data / resolution change move the POC onto it.
        // Distance is intentionally not considered.
        int pocShoulder = math.max(1, int(math.round(rowCount * ALTERNATE_POC_WINDOW_FRAC)))
        int alternateRow = -1
        float alternateVolume = 0.0
        for rowIndex = 0 to rowCount - 1
            if math.abs(rowIndex - pocRow) > pocShoulder
                float rowVolume = array.get(profile.rowVolumes, rowIndex)
                if rowVolume > alternateVolume
                    alternateVolume := rowVolume
                    alternateRow := rowIndex
        bool hasAlternatePoc = false
        float alternatePocPrice = na
        if alternateRow >= 0 and maxRowVolume > 0 and alternateVolume / maxRowVolume >= ALTERNATE_POC_MIN_RATIO
            hasAlternatePoc := true
            alternatePocPrice := profileLow + (alternateRow + 0.5) * rowHeight

        profile.priceLow := profileLow
        profile.priceHigh := profileLow + priceSpan
        profile.pocRow := pocRow
        profile.valueAreaLowRow := valueAreaLowRow
        profile.valueAreaHighRow := valueAreaHighRow
        profile.pocPrice := profileLow + (pocRow + 0.5) * rowHeight
        profile.valueAreaHighPrice := profileLow + (valueAreaHighRow + 1) * rowHeight
        profile.valueAreaLowPrice := profileLow + valueAreaLowRow * rowHeight
        profile.hasAlternatePoc := hasAlternatePoc
        profile.alternatePocPrice := alternatePocPrice
        profile.isValid := totalVolume > 0
    profile

buildDevelopingProfile(array<float> barHighs, array<float> barLows, array<float> barVolumes, array<int> startRef, array<float> intrabarHighs, array<float> intrabarLows, array<float> intrabarVolumes) =>
    int originalSize = array.size(barVolumes)
    if not barstate.isconfirmed
        appendBarVolume(barHighs, barLows, barVolumes, intrabarHighs, intrabarLows, intrabarVolumes, high, low, volume, false)
    Profile profile = buildProfile(barHighs, barLows, barVolumes, PROFILE_ROWS, valueAreaPercent, array.get(startRef, 0), time)
    while array.size(barVolumes) > originalSize
        array.pop(barHighs)
        array.pop(barLows)
        array.pop(barVolumes)
    profile

// Both modes shrink the same unfilled core; they differ only in which end erodes and whether a bar that
// never touched the core may erode it. Positional lets an eligible bar on the far side collapse the core
// outright, so a gap jumped over during ineligible hours reads as filled. Traversal erodes only what
// eligible price actually traded, and re-sides the gap when price settles on the other side of it.
erodeCoreFromAbove(ValueGap gap, float returnLow) =>
    gap.coreTop := math.max(gap.coreBottom, math.min(gap.coreTop, returnLow))

erodeCoreFromBelow(ValueGap gap, float returnHigh) =>
    gap.coreBottom := math.min(gap.coreTop, math.max(gap.coreBottom, returnHigh))

advanceValueGap(ValueGap gap, float returnHigh, float returnLow, int eventTime, bool traversalFill) =>
    if na(gap.fillTime)
        if traversalFill
            bool reachesBelow = returnLow <= gap.coreBottom
            bool reachesAbove = returnHigh >= gap.coreTop
            if returnHigh >= gap.coreBottom and returnLow <= gap.coreTop
                if reachesBelow and reachesAbove
                    gap.coreTop := gap.coreBottom
                else if reachesBelow
                    erodeCoreFromBelow(gap, returnHigh)
                    gap.entryDirection := ValueGapEntryDirection.fromBelow
                else if reachesAbove
                    erodeCoreFromAbove(gap, returnLow)
                    gap.entryDirection := ValueGapEntryDirection.fromAbove
                // Wholly inside the core: the approach side is unobservable at this resolution, so the
                // side price last came from decides.
                else if gap.entryDirection == ValueGapEntryDirection.fromAbove
                    erodeCoreFromAbove(gap, returnLow)
                else
                    erodeCoreFromBelow(gap, returnHigh)
            else if reachesAbove
                gap.entryDirection := ValueGapEntryDirection.fromAbove
            else
                gap.entryDirection := ValueGapEntryDirection.fromBelow
        else if gap.entryDirection == ValueGapEntryDirection.fromAbove
            erodeCoreFromAbove(gap, returnLow)
        else
            erodeCoreFromBelow(gap, returnHigh)
        if gap.coreTop <= gap.coreBottom
            gap.fillTime := eventTime

valueGapFromProfiles(Profile previousProfile, Profile currentProfile, int leftTime, int creationTime) =>
    float bullishTop = currentProfile.valueAreaLowPrice
    float bullishBottom = previousProfile.valueAreaHighPrice
    float bearishTop = previousProfile.valueAreaLowPrice
    float bearishBottom = currentProfile.valueAreaHighPrice
    ValueGap gap = na
    if bullishTop - bullishBottom >= syminfo.mintick
        gap := ValueGap.new(leftTime, creationTime, bullishTop, bullishBottom, true, na, ValueGapEntryDirection.fromAbove, bullishTop, bullishBottom)
    else if bearishTop - bearishBottom >= syminfo.mintick
        gap := ValueGap.new(leftTime, creationTime, bearishTop, bearishBottom, false, na, ValueGapEntryDirection.fromBelow, bearishTop, bearishBottom)
    gap

appendValueGap(Profile previousProfile, Profile completedProfile, array<ValueGap> valueGaps) =>
    ValueGap gap = valueGapFromProfiles(previousProfile, completedProfile, completedProfile.startTime, completedProfile.endTime)
    if not na(gap)
        array.push(valueGaps, gap)

syncValueGapProfile(array<Profile> profiles, array<Profile> sourceProfiles, array<ValueGap> valueGaps) =>
    if array.size(profiles) > 0
        Profile completedProfile = array.last(profiles)
        int sourceCount = array.size(sourceProfiles)
        bool sourceChanged = sourceCount == 0
        if sourceCount > 0
            Profile latestSource = array.last(sourceProfiles)
            sourceChanged := completedProfile.startTime != latestSource.startTime or completedProfile.endTime != latestSource.endTime
        if sourceChanged
            if array.size(valueGaps) > 0
                for gapIndex = array.size(valueGaps) - 1 to 0
                    ValueGap candidate = array.get(valueGaps, gapIndex)
                    if candidate.leftTime == completedProfile.startTime
                        array.remove(valueGaps, gapIndex)

            bool replacesLatest = false
            if sourceCount > 0
                Profile currentSource = array.last(sourceProfiles)
                replacesLatest := currentSource.startTime == completedProfile.startTime
            if replacesLatest
                array.set(sourceProfiles, sourceCount - 1, completedProfile)
            else
                array.push(sourceProfiles, completedProfile)
                if array.size(sourceProfiles) > 2
                    array.shift(sourceProfiles)

            if array.size(sourceProfiles) == 2
                appendValueGap(array.first(sourceProfiles), array.last(sourceProfiles), valueGaps)

            while array.size(valueGaps) > MAX_STORED_VALUE_GAPS
                array.shift(valueGaps)

updateValueGapPriceFills(array<ValueGap> valueGaps, float breachHigh, float breachLow) =>
    if array.size(valueGaps) > 0 and not na(breachHigh) and not na(breachLow)
        for gapIndex = 0 to array.size(valueGaps) - 1
            ValueGap gap = array.get(valueGaps, gapIndex)
            if na(gap.fillTime) and time > gap.creationTime
                advanceValueGap(gap, breachHigh, breachLow, time, valueGapTraversalFill)

valueGapFillTimestampEligible(int timestamp, string fillMode, bool allDays) =>
    int day = dayofweek(timestamp, NY_TIMEZONE)
    bool dayEligible = allDays or (day >= dayofweek.monday and day <= dayofweek.friday)
    int minuteOfDay = hour(timestamp, NY_TIMEZONE) * 60 + minute(timestamp, NY_TIMEZONE)
    int startMinute = fillMode == VALUE_GAP_FILL_RTH ? 570 : 300
    dayEligible and minuteOfDay >= startMinute and minuteOfDay < 960

valueGapFillRange(string fillMode, array<float> intrabarHighs, array<float> intrabarLows, array<int> intrabarTimes, bool allDays, bool fallbackWindow) =>
    float eligibleHigh = na
    float eligibleLow = na
    if fillMode == VALUE_GAP_FILL_PRICE
        eligibleHigh := high
        eligibleLow := low
    else
        int intrabarCount = array.size(intrabarTimes)
        if intrabarCount > 0
            for intrabarIndex = 0 to intrabarCount - 1
                if valueGapFillTimestampEligible(array.get(intrabarTimes, intrabarIndex), fillMode, allDays)
                    float subHigh = array.get(intrabarHighs, intrabarIndex)
                    float subLow = array.get(intrabarLows, intrabarIndex)
                    eligibleHigh := na(eligibleHigh) ? subHigh : math.max(eligibleHigh, subHigh)
                    eligibleLow := na(eligibleLow) ? subLow : math.min(eligibleLow, subLow)
        else if fallbackWindow
            eligibleHigh := high
            eligibleLow := low
    [eligibleHigh, eligibleLow]

levelEndpoint(int endTime, int breachTime, string extensionMode) =>
    int rightEdge = endTime
    bool extendRight = false
    if extensionMode == LEVEL_BREACH_ANY or extensionMode == LEVEL_BREACH_SAME or extensionMode == LEVEL_BREACH_SWEEP
        if na(breachTime)
            extendRight := true
        else
            rightEdge := breachTime
    [rightEdge, extendRight]

// ═══════════════════════════════════════════════════════════════════════════════
// FUNCTIONS — rendering
// ═══════════════════════════════════════════════════════════════════════════════

var array<box> drawnBoxes = array.new<box>()
var array<line> drawnLines = array.new<line>()
var array<polyline> drawnPolylines = array.new<polyline>()
var array<label> drawnLabels = array.new<label>()
var array<PendingLabel> pendingLabels = array.new<PendingLabel>()
var array<PendingReminder> pendingReminders = array.new<PendingReminder>()
var array<PendingAnchorReminder> pendingAnchorReminders = array.new<PendingAnchorReminder>()

clearDrawings() =>
    if array.size(drawnBoxes) > 0
        for boxIndex = 0 to array.size(drawnBoxes) - 1
            box.delete(array.get(drawnBoxes, boxIndex))
        array.clear(drawnBoxes)
    if array.size(drawnLines) > 0
        for lineIndex = 0 to array.size(drawnLines) - 1
            line.delete(array.get(drawnLines, lineIndex))
        array.clear(drawnLines)
    if array.size(drawnPolylines) > 0
        for polylineIndex = 0 to array.size(drawnPolylines) - 1
            polyline.delete(array.get(drawnPolylines, polylineIndex))
        array.clear(drawnPolylines)
    if array.size(drawnLabels) > 0
        for labelIndex = 0 to array.size(drawnLabels) - 1
            label.delete(array.get(drawnLabels, labelIndex))
        array.clear(drawnLabels)
    array.clear(pendingLabels)
    array.clear(pendingReminders)
    array.clear(pendingAnchorReminders)

valueGapUntouched(ValueGap gap) =>
    gap.coreTop >= gap.top and gap.coreBottom <= gap.bottom

valueGapFillPercent(ValueGap gap) =>
    float gapRange = gap.top - gap.bottom
    if gapRange <= 0
        0
    else
        float rawPercent = (gapRange - (gap.coreTop - gap.coreBottom)) / gapRange * 100
        int(math.min(na(gap.fillTime) ? 99 : 100, math.round(math.max(0, math.min(100, rawPercent)))))

valueGapLabelText(ValueGap gap) =>
    bool isFilled = not na(gap.fillTime)
    string fillSuffix = isFilled ? " " + SWEPT_CHECKMARK : valueGapUntouched(gap) ? "" : " " + str.tostring(valueGapFillPercent(gap), "#") + "%"
    string dateText = monthName(month(gap.creationTime, NY_TIMEZONE)) + " " + str.tostring(dayofmonth(gap.creationTime, NY_TIMEZONE)) + ", " + str.tostring(year(gap.creationTime, NY_TIMEZONE))
    valueGapSource + " Value Gap" + fillSuffix + "\n" + dateText

valueGapBoxGeometry(ValueGap gap) =>
    [gap.top, gap.coreTop, gap.coreTop, gap.coreBottom, gap.coreBottom, gap.bottom]

// Fill order is not creation order, so the newest mitigation is found by fillTime, not by position.
latestFilledValueGapIndex(array<ValueGap> valueGaps, bool enabled) =>
    int latestIndex = -1
    if enabled and array.size(valueGaps) > 0
        int latestFill = -1
        for gapIndex = 0 to array.size(valueGaps) - 1
            ValueGap gap = array.get(valueGaps, gapIndex)
            if not na(gap.fillTime) and gap.fillTime > latestFill
                latestFill := gap.fillTime
                latestIndex := gapIndex
    latestIndex

selectValueGapFloats(array<ValueGap> valueGaps, bool enabled, int nearestCount) =>
    array<int> selected = array.new<int>()
    int gapCount = array.size(valueGaps)
    if enabled and gapCount > 0
        for gapIndex = gapCount - 1 to 0
            ValueGap candidate = array.get(valueGaps, gapIndex)
            if na(candidate.fillTime)
                array.push(selected, gapIndex)
                break
        int additionalCount = math.min(nearestCount, gapCount - array.size(selected))
        if additionalCount > 0
            for selection = 1 to additionalCount
                float nearestDistance = 1e20
                int nearestIndex = -1
                for gapIndex = 0 to gapCount - 1
                    ValueGap gap = array.get(valueGaps, gapIndex)
                    if na(gap.fillTime) and not array.includes(selected, gapIndex)
                        float distance = close >= gap.bottom and close <= gap.top ? 0.0 : math.min(math.abs(close - gap.bottom), math.abs(close - gap.top))
                        if distance < nearestDistance
                            nearestDistance := distance
                            nearestIndex := gapIndex
                if nearestIndex >= 0
                    array.push(selected, nearestIndex)
    selected

confirmedValueGapStyle() =>
    ValueGapStyle.new(bullishValueGapUnfilledColor, bearishValueGapUnfilledColor, valueGapFilledColor, valueGapShowBorders, bullishValueGapBorderColor, bearishValueGapBorderColor, valueGapShowLabels, bullishValueGapLabelColor, bearishValueGapLabelColor, valueGapMitigatedLabelColor, valueGapLabelSize, valueGapShowMidpointLine, valueGapMidpointOpenLineColor, valueGapMidpointMitigatedLineColor, valueGapShowMidpointLabel, valueGapShowQuartileLines, valueGapQuartileOpenLineColor, valueGapQuartileMitigatedLineColor, valueGapShowQuartileLabels, valueGapInternalLabelSize, valueGapInternalLabelFade, valueGapShowInternalReminders)

upcomingValueGapStyle() =>
    ValueGapStyle.new(upcomingValueGapColor, upcomingValueGapColor, valueGapFilledColor, valueGapShowBorders, upcomingValueGapBorderColor, upcomingValueGapBorderColor, valueGapShowLabels, bullishValueGapLabelColor, bearishValueGapLabelColor, valueGapMitigatedLabelColor, valueGapLabelSize, valueGapShowMidpointLine, valueGapMidpointOpenLineColor, valueGapMidpointMitigatedLineColor, false, valueGapShowQuartileLines, valueGapQuartileOpenLineColor, valueGapQuartileMitigatedLineColor, false, valueGapInternalLabelSize, valueGapInternalLabelFade, false)

floatingValueGapStyle() =>
    ValueGapStyle.new(bullishValueGapUnfilledColor, bearishValueGapUnfilledColor, valueGapFilledColor, valueGapShowBorders, bullishValueGapBorderColor, bearishValueGapBorderColor, valueGapShowLabels, bullishValueGapLabelColor, bearishValueGapLabelColor, valueGapMitigatedLabelColor, valueGapLabelSize, valueGapShowMidpointLine, valueGapMidpointOpenLineColor, valueGapMidpointMitigatedLineColor, false, valueGapShowQuartileLines, valueGapQuartileOpenLineColor, valueGapQuartileMitigatedLineColor, false, valueGapInternalLabelSize, valueGapInternalLabelFade, false)

valueGapLevelFilled(ValueGap gap, float levelPrice) =>
    not na(gap.fillTime) or levelPrice >= gap.coreTop or levelPrice <= gap.coreBottom

// Only the confirmed style enables reminders, so runMs is always a bar_time span, never a bar count.
valueGapInternalPlacements(ValueGapStyle style, int runMs) =>
    style.showInternalReminders and runMs > 0 ? math.min(VALUE_GAP_REMINDER_MAX_PER_LEVEL, math.max(1, int(math.round(math.sqrt(float(runMs) / SWEPT_REMINDER_BASE_MS))))) : 1

valueGapInternalLabelText(float levelFraction) =>
    valueGapSource + " Gap " + str.tostring(int(levelFraction * 100)) + "%"

valueGapLabelCost(ValueGap gap, ValueGapStyle style, int runMs) =>
    int placements = valueGapInternalPlacements(style, runMs)
    int internalLabels = na(gap.fillTime) ? (style.showMidpointLine and style.showMidpointLabel ? placements : 0) + (style.showQuartileLines and style.showQuartileLabels ? 2 * placements : 0) : 0
    (style.showLabels ? 1 : 0) + internalLabels

pushValueGapInternalLabels(int leftEdge, int rightEdge, int placements, string xLocation, float price, string labelText, color textColor, string labelSize) =>
    for placement = 1 to placements
        int labelEdge = leftEdge + int((rightEdge - leftEdge) * (placement - 0.5) / placements)
        array.push(drawnLabels, label.new(labelEdge, price, labelText, xloc=xLocation, yloc=yloc.price, color=VALUE_GAP_MIDPOINT_LABEL_BG, textcolor=textColor, style=label.style_label_center, size=labelSize, textalign=text.align_center))

renderStyledValueGap(ValueGap gap, int leftEdge, int rightEdge, string xLocation, ValueGapStyle style, string labelText, bool emphasize) =>
    color unfilledColor = gap.bullish ? style.bullishColor : style.bearishColor
    int referenceWidth = emphasize ? VALUE_GAP_BOLD_REFERENCE_WIDTH : VALUE_GAP_REFERENCE_WIDTH
    [topFilledTop, topFilledBottom, coreTop, coreBottom, bottomFilledTop, bottomFilledBottom] = valueGapBoxGeometry(gap)
    if topFilledTop != topFilledBottom
        array.push(drawnBoxes, box.new(left=leftEdge, top=topFilledTop, right=rightEdge, bottom=topFilledBottom, xloc=xLocation, bgcolor=style.filledColor, border_color=na))
    if coreTop != coreBottom
        array.push(drawnBoxes, box.new(left=leftEdge, top=coreTop, right=rightEdge, bottom=coreBottom, xloc=xLocation, bgcolor=unfilledColor, border_color=na))
    if bottomFilledTop != bottomFilledBottom
        array.push(drawnBoxes, box.new(left=leftEdge, top=bottomFilledTop, right=rightEdge, bottom=bottomFilledBottom, xloc=xLocation, bgcolor=style.filledColor, border_color=na))

    bool gapFilled = not na(gap.fillTime)
    float gapRange = gap.top - gap.bottom
    color gapLabelColor = gap.bullish ? style.bullishLabelColor : style.bearishLabelColor
    color internalLabelColor = color.new(gapLabelColor, math.min(100, int(color.t(gapLabelColor)) + style.internalLabelFade))
    string internalLabelSize = toLabelSize(style.internalLabelSize)
    int internalPlacements = valueGapInternalPlacements(style, rightEdge - leftEdge)
    if style.showMidpointLine
        float cePrice = gap.bottom + gapRange * VALUE_GAP_CE_LEVEL
        bool midpointMitigated = valueGapLevelFilled(gap, cePrice)
        color midpointLineColor = midpointMitigated ? style.midpointMitigatedLineColor : style.midpointOpenLineColor
        array.push(drawnLines, line.new(leftEdge, cePrice, rightEdge, cePrice, xloc=xLocation, color=midpointLineColor, style=line.style_dashed, width=referenceWidth))
        if style.showMidpointLabel and not gapFilled
            pushValueGapInternalLabels(leftEdge, rightEdge, internalPlacements, xLocation, cePrice, valueGapInternalLabelText(VALUE_GAP_CE_LEVEL), internalLabelColor, internalLabelSize)
    if style.showQuartileLines
        float q1Price = gap.bottom + gapRange * VALUE_GAP_Q1_LEVEL
        float q3Price = gap.bottom + gapRange * VALUE_GAP_Q3_LEVEL
        bool q1Mitigated = valueGapLevelFilled(gap, q1Price)
        bool q3Mitigated = valueGapLevelFilled(gap, q3Price)
        color q1LineColor = q1Mitigated ? style.quartileMitigatedLineColor : style.quartileOpenLineColor
        color q3LineColor = q3Mitigated ? style.quartileMitigatedLineColor : style.quartileOpenLineColor
        array.push(drawnLines, line.new(leftEdge, q1Price, rightEdge, q1Price, xloc=xLocation, color=q1LineColor, style=line.style_dotted, width=referenceWidth))
        array.push(drawnLines, line.new(leftEdge, q3Price, rightEdge, q3Price, xloc=xLocation, color=q3LineColor, style=line.style_dotted, width=referenceWidth))
        if style.showQuartileLabels and not gapFilled
            pushValueGapInternalLabels(leftEdge, rightEdge, internalPlacements, xLocation, q1Price, valueGapInternalLabelText(VALUE_GAP_Q1_LEVEL), internalLabelColor, internalLabelSize)
            pushValueGapInternalLabels(leftEdge, rightEdge, internalPlacements, xLocation, q3Price, valueGapInternalLabelText(VALUE_GAP_Q3_LEVEL), internalLabelColor, internalLabelSize)

    if style.showBorders
        color borderColor = gap.bullish ? style.bullishBorderColor : style.bearishBorderColor
        array.push(drawnBoxes, box.new(left=leftEdge, top=gap.top, right=rightEdge, bottom=gap.bottom, xloc=xLocation, bgcolor=na, border_color=borderColor, border_width=referenceWidth))

    if style.showLabels
        int labelEdge = leftEdge + int((rightEdge - leftEdge) * 0.5)
        bool labelAbove = not gap.bullish
        float labelPrice = labelAbove ? gap.top : gap.bottom
        string labelStyle = labelAbove ? label.style_label_down : label.style_label_up
        color labelColor = gapFilled ? style.mitigatedLabelColor : gapLabelColor
        array.push(drawnLabels, label.new(labelEdge, labelPrice, labelText, xloc=xLocation, yloc=yloc.price, color=VALUE_GAP_LABEL_BG_TRANSPARENT, textcolor=labelColor, style=labelStyle, size=toLabelSize(style.labelSize), textalign=text.align_center))

renderFloatingValueGaps(array<ValueGap> valueGaps, array<int> selectedIndices) =>
    int floatCount = array.size(selectedIndices)
    if floatCount > 0
        ValueGapStyle style = floatingValueGapStyle()
        for floatSlot = 0 to floatCount - 1
            ValueGap gap = array.get(valueGaps, array.get(selectedIndices, floatSlot))
            int leftBar = bar_index + floatingValueGapOffset + floatSlot * (floatingValueGapWidth + 2)
            int rightBar = leftBar + floatingValueGapWidth
            renderStyledValueGap(gap, leftBar, rightBar, xloc.bar_index, style, valueGapLabelText(gap), false)

renderUpcomingValueGap(array<Profile> profiles, Profile liveProfile, bool enabled) =>
    if enabled and not na(liveProfile) and array.size(profiles) > 0
        Profile previousProfile = array.last(profiles)
        if liveProfile.isValid
            ValueGap upcomingGap = valueGapFromProfiles(previousProfile, liveProfile, liveProfile.startTime, time)
            if not na(upcomingGap)
                float previousRange = math.max(previousProfile.priceHigh - previousProfile.priceLow, syminfo.mintick)
                float upcomingPercent = (upcomingGap.top - upcomingGap.bottom) / previousRange * 100
                if upcomingPercent >= upcomingValueGapMinPercent
                    int leftBar = bar_index + upcomingValueGapOffset
                    int rightBar = leftBar + upcomingValueGapWidth
                    string dateText = monthName(month(liveProfile.startTime, NY_TIMEZONE)) + " " + str.tostring(dayofmonth(liveProfile.startTime, NY_TIMEZONE)) + ", " + str.tostring(year(liveProfile.startTime, NY_TIMEZONE))
                    renderStyledValueGap(upcomingGap, leftBar, rightBar, xloc.bar_index, upcomingValueGapStyle(), "Upcoming " + valueGapSource + " Value Gap\n" + dateText, false)

renderValueGaps(array<ValueGap> valueGaps, bool enabled, array<int> floatingIndices, int displayLimit) =>
    int gapCount = array.size(valueGaps)
    if enabled and gapCount > 0
        ValueGapStyle style = confirmedValueGapStyle()
        int liveRightPadding = int(timeframe.in_seconds(timeframe.period) * 1000) * VALUE_GAP_RIGHT_EDGE_CUSHION
        int linesPerGap = (style.showMidpointLine ? 1 : 0) + (style.showQuartileLines ? 2 : 0)
        int boxesPerGap = 2 + (style.showBorders ? 1 : 0)
        // Newest-first, billed at each gap's real cost: a filled gap carries no internal tags, and only a
        // long open run earns extra ones. Budgeting the worst case instead would evict gaps that fit.
        int firstGapIndex = gapCount
        int selectedCount = 0
        int lineCost = 0
        int labelCost = 0
        int boxCost = 0
        for gapIndex = gapCount - 1 to 0
            ValueGap candidate = array.get(valueGaps, gapIndex)
            bool candidateFilled = not na(candidate.fillTime)
            if not array.includes(floatingIndices, gapIndex) and (not candidateFilled or not hideFilledValueGaps)
                int candidateRight = candidateFilled ? candidate.fillTime : time + liveRightPadding
                int candidateLabels = valueGapLabelCost(candidate, style, candidateRight - candidate.leftTime)
                if lineCost + linesPerGap > VALUE_GAP_LINE_BUDGET or labelCost + candidateLabels > VALUE_GAP_LABEL_BUDGET or boxCost + boxesPerGap > VALUE_GAP_BOX_BUDGET
                    break
                lineCost += linesPerGap
                labelCost += candidateLabels
                boxCost += boxesPerGap
                firstGapIndex := gapIndex
                selectedCount += 1
                if selectedCount >= displayLimit
                    break
        if firstGapIndex < gapCount
            int boldGapIndex = latestFilledValueGapIndex(valueGaps, boldLastFilledValueGap and not hideFilledValueGaps)
            for gapIndex = firstGapIndex to gapCount - 1
                ValueGap gap = array.get(valueGaps, gapIndex)
                if array.includes(floatingIndices, gapIndex)
                    continue
                bool isFilled = not na(gap.fillTime)
                if isFilled and hideFilledValueGaps
                    continue
                int rightTime = isFilled ? gap.fillTime : time + liveRightPadding
                renderStyledValueGap(gap, gap.leftTime, rightTime, xloc.bar_time, style, valueGapLabelText(gap), gapIndex == boldGapIndex)

// Identity tags live only on the extension beyond the completed anchor. Waiting one swept-reminder
// span keeps the obvious session body and its immediate edge clear. A base label is always singular;
// optional repeats grow only from usable post-delay space, preventing premature adjacent duplicates.
renderAnchorLevelReminders(int anchorStartTime, int anchorEndTime, int runEndTime, float price, string reminderText, string levelName, color textColor, color bgColor, string sizeName) =>
    int anchorSpanMs = math.max(1, anchorEndTime - anchorStartTime)
    int reminderSpacingMs = math.max(ANCHOR_REMINDER_MIN_SPACING_MS, int(anchorSpanMs * anchorReminderSpacingPercent / 100.0))
    int reminderRunStart = anchorEndTime + reminderSpacingMs
    int eligibleRunMs = runEndTime - reminderRunStart
    if anchorLevelLabelMode != ANCHOR_LABEL_MODE_OFF and eligibleRunMs > 0
        int reminderCount = 1
        if anchorLevelLabelMode == ANCHOR_LABEL_MODE_REMINDERS
            float runUnits = float(eligibleRunMs) / reminderSpacingMs
            reminderCount := math.min(SWEPT_REMINDER_MAX_PER_LINE, math.max(1, int(math.round(math.sqrt(runUnits)))))
        // Strong phase separation keeps nearby POC / VAH / VAL text from vertically stacking.
        float levelFrac = levelName == LABEL_VAH ? 0.5 : levelName == LABEL_VAL ? 0.85 : 0.15
        for placement = 1 to reminderCount
            int reminderTime = reminderRunStart + int(eligibleRunMs * (placement - 1 + levelFrac) / reminderCount)
            array.push(drawnLabels, label.new(reminderTime, price, reminderText, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, textcolor=textColor, size=toLabelSize(sizeName), color=bgColor))

// sweptDenote keeps a swept level visible: solid to the sweep point, then a faded dashed continuation.
drawLevel(int startTime, int endTime, float price, color lineColor, int lineWidth, string styleName, bool extendRight, color labelColor, string levelName, SessionStyle style, bool sweptDenote, color sweptContinuationColor, bool isLive, bool isLast, int anchorEndTime) =>
    array.push(drawnLines, line.new(x1=startTime, y1=price, x2=endTime, y2=price, xloc=xloc.bar_time, extend=extendRight ? extend.right : extend.none, color=lineColor, width=lineWidth, style=toLineStyle(styleName)))
    color labelTextColor = sweptDenote ? color.new(labelColor, 100 - (100 - color.t(labelColor)) * (1 - sweptLabelTextFadePercent / 100.0)) : labelColor
    string dateText = style.labelMonthOnly ? monthName(month(startTime, NY_TIMEZONE)) : monthName(month(startTime, NY_TIMEZONE)) + " " + str.tostring(dayofmonth(startTime, NY_TIMEZONE))
    int levelWeight = levelName == LABEL_POC ? 3 : levelName == LABEL_ALTERNATE_POC ? 1 : 2
    int recencyWeight = isLive ? 2 : isLast ? 1 : 0
    int labelRank = levelWeight * 10 + recencyWeight
    if not isLive and levelName != LABEL_ALTERNATE_POC
        int visibleEndTime = extendRight ? time : endTime
        string anchorLabelName = isLast ? style.labelLast + " " + levelName : style.labelAnchor + " " + levelName + " " + dateText
        color anchorReminderTextColor = color.new(labelTextColor, 100 - (100 - color.t(labelTextColor)) * (1 - anchorReminderFadePercent / 100.0))
        int anchorSpanMs = math.max(1, anchorEndTime - startTime)
        int reminderSpacingMs = math.max(ANCHOR_REMINDER_MIN_SPACING_MS, int(anchorSpanMs * anchorReminderSpacingPercent / 100.0))
        if anchorLevelLabelMode != ANCHOR_LABEL_MODE_OFF and visibleEndTime > anchorEndTime + reminderSpacingMs
            array.push(pendingAnchorReminders, PendingAnchorReminder.new(price, startTime, anchorEndTime, visibleEndTime, anchorLabelName, anchorReminderTextColor, style.levelLabelBgColor, style.levelLabelSize, levelName, labelRank))
    if sweptDenote
        array.push(drawnLines, line.new(x1=endTime, y1=price, x2=time, y2=price, xloc=xloc.bar_time, extend=extend.right, color=sweptContinuationColor, width=style.sweptContinuationWidth, style=line.style_dashed))
    if extendRight or sweptDenote
        string priceText = str.tostring(price, format.mintick)
        string statePart = sweptDenote ? " " + SWEPT_CHECKMARK : ""
        string nameText = isLive ? style.labelLive + " " + levelName : isLast ? style.labelLast + " " + levelName : style.labelAnchor + " " + levelName + " " + dateText
        string detailsText = nameText + statePart
        // Buffer the right-edge label instead of drawing it; flushPendingLabels merges coincident prices.
        array.push(pendingLabels, PendingLabel.new(price, bar_index + style.levelLabelOffset, detailsText, priceText, style.showPrice, labelTextColor, style.levelLabelBgColor, style.levelLabelSize, labelRank))
        // Last and live profiles are self-evident, so only older completed profiles carry a date.
        if style.showSweptReminders and sweptDenote
            string reminderName = isLive ? style.labelLive + " " + levelName : isLast ? style.labelLast + " " + levelName : style.labelAnchor + " " + levelName + (style.showSweptReminderDate ? " " + dateText : "")
            array.push(pendingReminders, PendingReminder.new(price, endTime, reminderName, labelTextColor, style.levelLabelBgColor, style.levelLabelSize, levelName, labelRank))

// Collapse buffered right-edge labels: levels within LABEL_MERGE_PCT of each other (min one tick) become
// one label whose names join with LABEL_NAME_SEPARATOR. The highest-rank entry in a cluster wins the
// color, size, background and anchor price, so the most important level drives the merged label's look.
flushPendingLabels(bool dedupe) =>
    int pendingCount = array.size(pendingLabels)
    if pendingCount > 0
        array<float> clusterPrice = array.new<float>()
        array<string> clusterName = array.new<string>()
        array<bool> clusterWantPrice = array.new<bool>()
        array<string> clusterPriceText = array.new<string>()
        array<color> clusterColor = array.new<color>()
        array<color> clusterBg = array.new<color>()
        array<string> clusterSize = array.new<string>()
        array<int> clusterRank = array.new<int>()
        array<int> clusterX = array.new<int>()
        for pendingIndex = 0 to pendingCount - 1
            PendingLabel pending = array.get(pendingLabels, pendingIndex)
            float tolerance = math.max(syminfo.mintick, pending.price * LABEL_MERGE_PCT)
            int foundIndex = -1
            float minDistance = tolerance + syminfo.mintick
            if dedupe and array.size(clusterPrice) > 0
                for clusterIndex = 0 to array.size(clusterPrice) - 1
                    float distance = math.abs(array.get(clusterPrice, clusterIndex) - pending.price)
                    if distance <= tolerance and distance < minDistance
                        minDistance := distance
                        foundIndex := clusterIndex
            if foundIndex >= 0
                if pending.namePart != ""
                    string existingName = array.get(clusterName, foundIndex)
                    array.set(clusterName, foundIndex, existingName == "" ? pending.namePart : existingName + LABEL_NAME_SEPARATOR + pending.namePart)
                array.set(clusterWantPrice, foundIndex, array.get(clusterWantPrice, foundIndex) or pending.wantPrice)
                array.set(clusterSize, foundIndex, largerLabelSize(array.get(clusterSize, foundIndex), pending.sizeName))
                if pending.rank > array.get(clusterRank, foundIndex)
                    array.set(clusterRank, foundIndex, pending.rank)
                    array.set(clusterColor, foundIndex, pending.textColor)
                    array.set(clusterBg, foundIndex, pending.bgColor)
                    array.set(clusterPrice, foundIndex, pending.price)
                    array.set(clusterPriceText, foundIndex, pending.pricePart)
                    array.set(clusterX, foundIndex, pending.xPos)
            else
                array.push(clusterPrice, pending.price)
                array.push(clusterName, pending.namePart)
                array.push(clusterWantPrice, pending.wantPrice)
                array.push(clusterPriceText, pending.pricePart)
                array.push(clusterColor, pending.textColor)
                array.push(clusterBg, pending.bgColor)
                array.push(clusterSize, pending.sizeName)
                array.push(clusterRank, pending.rank)
                array.push(clusterX, pending.xPos)
        for clusterIndex = 0 to array.size(clusterPrice) - 1
            string body = array.get(clusterName, clusterIndex)
            string finalText = array.get(clusterWantPrice, clusterIndex) ? (body == "" ? array.get(clusterPriceText, clusterIndex) : body + " " + BRAND_BULLET + " " + array.get(clusterPriceText, clusterIndex)) : body
            array.push(drawnLabels, label.new(array.get(clusterX, clusterIndex), array.get(clusterPrice, clusterIndex), finalText, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, textcolor=array.get(clusterColor, clusterIndex), size=toLabelSize(array.get(clusterSize, clusterIndex)), color=array.get(clusterBg, clusterIndex)))
        array.clear(pendingLabels)

// Merge coincident active anchor reminders before applying their sparse placement geometry.
flushPendingAnchorReminders(bool dedupe) =>
    int pendingCount = array.size(pendingAnchorReminders)
    if pendingCount > 0
        array<float> clusterPrice = array.new<float>()
        array<int> clusterStartTime = array.new<int>()
        array<int> clusterAnchorEndTime = array.new<int>()
        array<int> clusterRunEndTime = array.new<int>()
        array<string> clusterName = array.new<string>()
        array<color> clusterColor = array.new<color>()
        array<color> clusterBg = array.new<color>()
        array<string> clusterSize = array.new<string>()
        array<string> clusterLevelName = array.new<string>()
        array<int> clusterRank = array.new<int>()
        for reminderIndex = 0 to pendingCount - 1
            PendingAnchorReminder pending = array.get(pendingAnchorReminders, reminderIndex)
            float tolerance = math.max(syminfo.mintick, pending.price * LABEL_MERGE_PCT)
            int foundIndex = -1
            float minDistance = tolerance + syminfo.mintick
            if dedupe and array.size(clusterPrice) > 0
                for clusterIndex = 0 to array.size(clusterPrice) - 1
                    float distance = math.abs(array.get(clusterPrice, clusterIndex) - pending.price)
                    if distance <= tolerance and distance < minDistance
                        minDistance := distance
                        foundIndex := clusterIndex
            if foundIndex >= 0
                string existingName = array.get(clusterName, foundIndex)
                array.set(clusterName, foundIndex, existingName == "" ? pending.namePart : existingName + LABEL_NAME_SEPARATOR + pending.namePart)
                if pending.rank > array.get(clusterRank, foundIndex)
                    array.set(clusterPrice, foundIndex, pending.price)
                    array.set(clusterStartTime, foundIndex, pending.anchorStartTime)
                    array.set(clusterAnchorEndTime, foundIndex, pending.anchorEndTime)
                    array.set(clusterRunEndTime, foundIndex, pending.runEndTime)
                    array.set(clusterColor, foundIndex, pending.textColor)
                    array.set(clusterBg, foundIndex, pending.bgColor)
                    array.set(clusterSize, foundIndex, pending.sizeName)
                    array.set(clusterLevelName, foundIndex, pending.levelName)
                    array.set(clusterRank, foundIndex, pending.rank)
            else
                array.push(clusterPrice, pending.price)
                array.push(clusterStartTime, pending.anchorStartTime)
                array.push(clusterAnchorEndTime, pending.anchorEndTime)
                array.push(clusterRunEndTime, pending.runEndTime)
                array.push(clusterName, pending.namePart)
                array.push(clusterColor, pending.textColor)
                array.push(clusterBg, pending.bgColor)
                array.push(clusterSize, pending.sizeName)
                array.push(clusterLevelName, pending.levelName)
                array.push(clusterRank, pending.rank)
        for clusterIndex = 0 to array.size(clusterPrice) - 1
            renderAnchorLevelReminders(array.get(clusterStartTime, clusterIndex), array.get(clusterAnchorEndTime, clusterIndex), array.get(clusterRunEndTime, clusterIndex), array.get(clusterPrice, clusterIndex), array.get(clusterName, clusterIndex), array.get(clusterLevelName, clusterIndex), array.get(clusterColor, clusterIndex), array.get(clusterBg, clusterIndex), array.get(clusterSize, clusterIndex))
        array.clear(pendingAnchorReminders)

// Spread swept-line reminders along each run, merging coincident-price ones to match the right-edge label.
// Count follows the square root of the run's absolute length: physical distance drives density uniformly
// across anchors, and sublinear growth widens spacing as lines lengthen instead of flooding.
flushPendingReminders(bool dedupe) =>
    int reminderCount = array.size(pendingReminders)
    if reminderCount > 0
        array<float> clusterPrice = array.new<float>()
        array<string> clusterName = array.new<string>()
        array<int> clusterEndTime = array.new<int>()
        array<color> clusterColor = array.new<color>()
        array<color> clusterBg = array.new<color>()
        array<string> clusterSize = array.new<string>()
        array<string> clusterLevelName = array.new<string>()
        array<int> clusterRank = array.new<int>()
        for reminderIndex = 0 to reminderCount - 1
            PendingReminder pending = array.get(pendingReminders, reminderIndex)
            float tolerance = math.max(syminfo.mintick, pending.price * LABEL_MERGE_PCT)
            int foundIndex = -1
            float minDistance = tolerance + syminfo.mintick
            if dedupe and array.size(clusterPrice) > 0
                for clusterIndex = 0 to array.size(clusterPrice) - 1
                    float distance = math.abs(array.get(clusterPrice, clusterIndex) - pending.price)
                    if distance <= tolerance and distance < minDistance
                        minDistance := distance
                        foundIndex := clusterIndex
            if foundIndex >= 0
                string existingName = array.get(clusterName, foundIndex)
                array.set(clusterName, foundIndex, existingName == "" ? pending.namePart : existingName + LABEL_NAME_SEPARATOR + pending.namePart)
                array.set(clusterEndTime, foundIndex, math.min(array.get(clusterEndTime, foundIndex), pending.endTime))
                array.set(clusterSize, foundIndex, largerLabelSize(array.get(clusterSize, foundIndex), pending.sizeName))
                if pending.rank > array.get(clusterRank, foundIndex)
                    array.set(clusterRank, foundIndex, pending.rank)
                    array.set(clusterColor, foundIndex, pending.textColor)
                    array.set(clusterBg, foundIndex, pending.bgColor)
                    array.set(clusterLevelName, foundIndex, pending.levelName)
                    array.set(clusterPrice, foundIndex, pending.price)
            else
                array.push(clusterPrice, pending.price)
                array.push(clusterName, pending.namePart)
                array.push(clusterEndTime, pending.endTime)
                array.push(clusterColor, pending.textColor)
                array.push(clusterBg, pending.bgColor)
                array.push(clusterSize, pending.sizeName)
                array.push(clusterLevelName, pending.levelName)
                array.push(clusterRank, pending.rank)
        for clusterIndex = 0 to array.size(clusterPrice) - 1
            int endTime = array.get(clusterEndTime, clusterIndex)
            int sweptRunMs = time - endTime
            if sweptRunMs > 0
                float runUnits = sweptRunMs / SWEPT_REMINDER_BASE_MS
                int runReminderCount = math.min(SWEPT_REMINDER_MAX_PER_LINE, math.max(1, int(math.round(math.sqrt(runUnits)))))
                // Each level sits at a different fraction within its segment so the level types interleave;
                // dividing by the count (not count+1) keeps the spread across the whole run — at count 1 the
                // four levels still fan out from ~0.2 to ~0.8 instead of bunching past the midpoint.
                string levelName = array.get(clusterLevelName, clusterIndex)
                float levelFrac = levelName == LABEL_VAH ? 0.4 : levelName == LABEL_VAL ? 0.6 : levelName == LABEL_ALTERNATE_POC ? 0.8 : 0.2
                float price = array.get(clusterPrice, clusterIndex)
                string reminderText = array.get(clusterName, clusterIndex)
                color textColor = array.get(clusterColor, clusterIndex)
                color bgColor = array.get(clusterBg, clusterIndex)
                string sizeName = array.get(clusterSize, clusterIndex)
                for placement = 1 to runReminderCount
                    int reminderTime = endTime + int(sweptRunMs * (placement - 1 + levelFrac) / runReminderCount)
                    array.push(drawnLabels, label.new(reminderTime, price, reminderText, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, textcolor=textColor, size=toLabelSize(sizeName), color=bgColor))
        array.clear(pendingReminders)

// Fade a level's colour by scaling its visible opacity. dimFraction 0.5 halves opacity;
// scaling (rather than adding transparency) keeps it well-behaved at any base transparency.
dimLevelColor(color baseColor, bool touched, bool dimTouched, float dimFraction) =>
    touched and dimTouched ? color.new(baseColor, 100 - (100 - color.t(baseColor)) * (1 - dimFraction)) : baseColor

// One contiguous histogram run as a closed filled polyline. Straight segments (not curved) hug the
// stepped silhouette exactly; transparent border so only the fill shows. One drawing object per run.
pushHistogramPolyline(array<chart.point> points, color fillColor) =>
    if array.size(points) >= 3
        array.push(drawnPolylines, polyline.new(points, curved=false, closed=true, xloc=xloc.bar_time, line_color=color.new(fillColor, 100), fill_color=fillColor))

// Later of two breach timestamps, ignoring na so an unswept level never wins.
maxBreachTime(int a, int b) =>
    int result = na(a) ? b : na(b) ? a : int(math.max(a, b))
    result

// Most recent sweep across the profile's levels; na when none are swept.
profileLastBreach(Profile profile) =>
    int latest = maxBreachTime(profile.pocBreachTime, profile.valueAreaHighBreachTime)
    latest := maxBreachTime(latest, profile.valueAreaLowBreachTime)
    latest := profile.hasAlternatePoc ? maxBreachTime(latest, profile.alternatePocBreachTime) : latest
    latest

// The value area splits the silhouette into at most three runs (below/inside/above VA), one polyline each.
histogramRunCount(Profile profile) =>
    not profile.isValid ? 0 : (profile.valueAreaLowRow > 0 ? 1 : 0) + 1 + (profile.valueAreaHighRow < profile.rowCount - 1 ? 1 : 0)

newestCandidateEndTime(array<Profile> profiles, int candidateIndex) =>
    candidateIndex >= 0 ? nz(array.get(profiles, candidateIndex).endTime, -1) : -1

// Pine hard-caps polylines at 100 and silently deletes the OLDEST when over — starving the first-rendered
// anchor wholesale. Instead, grant histograms newest-first across all anchors until the budget runs out,
// so profiles nearest the live edge keep theirs. Returns each anchor's first index allowed to draw.
allocateHistogramBudget(array<Profile> profilesA, bool enabledA, array<Profile> profilesB, bool enabledB, array<Profile> profilesC, bool enabledC, array<Profile> profilesD, bool enabledD, int budget) =>
    int remaining = budget
    int indexA = enabledA ? array.size(profilesA) - 1 : -1
    int indexB = enabledB ? array.size(profilesB) - 1 : -1
    int indexC = enabledC ? array.size(profilesC) - 1 : -1
    int indexD = enabledD ? array.size(profilesD) - 1 : -1
    bool exhausted = false
    while not exhausted
        int timeA = newestCandidateEndTime(profilesA, indexA)
        int timeB = newestCandidateEndTime(profilesB, indexB)
        int timeC = newestCandidateEndTime(profilesC, indexC)
        int timeD = newestCandidateEndTime(profilesD, indexD)
        int bestTime = math.max(math.max(timeA, timeB), math.max(timeC, timeD))
        if bestTime < 0
            exhausted := true
        else
            // Ties resolve in anchor order.
            Profile chosen = bestTime == timeA ? array.get(profilesA, indexA) : bestTime == timeB ? array.get(profilesB, indexB) : bestTime == timeC ? array.get(profilesC, indexC) : array.get(profilesD, indexD)
            int cost = histogramRunCount(chosen)
            if cost > remaining
                exhausted := true
            else
                remaining -= cost
                if bestTime == timeA
                    indexA -= 1
                else if bestTime == timeB
                    indexB -= 1
                else if bestTime == timeC
                    indexC -= 1
                else
                    indexD -= 1
    [indexA + 1, indexB + 1, indexC + 1, indexD + 1]

renderProfile(Profile profile, SessionStyle style, bool developingProfileActive, bool isMostRecentCompleted, bool isLive, bool highlightActive, bool histogramAllowed) =>
    if profile.isValid
        float priceRange = profile.priceHigh - profile.priceLow
        bool useDevelopingColors = developingProfileActive and style.developingEnabled

        // Histogram: one filled polyline per contiguous inside/outside value-area run, silhouette
        // smoothed by a sliding-window mean (O(rows): each step adds the entering row, drops the leaving).
        if style.showHistogram and histogramAllowed
            int rowCount = profile.rowCount
            int halfWindow = HISTOGRAM_SMOOTHING / 2
            array<float> smoothedVolumes = array.new<float>(rowCount, 0.0)
            float maxSmoothedVolume = 0.0
            float windowSum = 0.0
            int windowCount = 0
            for seedRow = 0 to math.min(halfWindow, rowCount - 1)
                windowSum += array.get(profile.rowVolumes, seedRow)
                windowCount += 1
            for rowIndex = 0 to rowCount - 1
                if rowIndex > 0
                    int enteringRow = rowIndex + halfWindow
                    if enteringRow < rowCount
                        windowSum += array.get(profile.rowVolumes, enteringRow)
                        windowCount += 1
                    int leavingRow = rowIndex - halfWindow - 1
                    if leavingRow >= 0
                        windowSum -= array.get(profile.rowVolumes, leavingRow)
                        windowCount -= 1
                float smoothedVolume = windowSum / windowCount
                array.set(smoothedVolumes, rowIndex, smoothedVolume)
                maxSmoothedVolume := math.max(maxSmoothedVolume, smoothedVolume)
            if maxSmoothedVolume > 0
                float rowHeight = priceRange / rowCount
                int baselineTime = profile.startTime
                int profileMilliseconds = math.max(1, profile.endTime - profile.startTime)
                int histogramWidthMilliseconds = math.max(1, int(math.round(profileMilliseconds * HISTOGRAM_WIDTH_PERCENT * 0.01)))
                array<chart.point> points = array.new<chart.point>()
                bool runStarted = false
                bool runInsideVa = false
                for rowIndex = 0 to rowCount - 1
                    bool insideVa = rowIndex >= profile.valueAreaLowRow and rowIndex <= profile.valueAreaHighRow
                    float rowBottom = profile.priceLow + rowIndex * rowHeight
                    float rowVolume = array.get(smoothedVolumes, rowIndex)
                    int widthMilliseconds = int(math.round(rowVolume / maxSmoothedVolume * histogramWidthMilliseconds))
                    int outerTime = baselineTime + widthMilliseconds
                    // VA membership flipped: close this run and start a new one at the same boundary.
                    if runStarted and insideVa != runInsideVa
                        array.push(points, chart.point.from_time(baselineTime, rowBottom))
                        pushHistogramPolyline(points, runInsideVa ? style.histogramInsideColor : style.histogramOutsideColor)
                        points := array.new<chart.point>()
                        runStarted := false
                    if not runStarted
                        runStarted := true
                        runInsideVa := insideVa
                        array.push(points, chart.point.from_time(baselineTime, rowBottom))
                    array.push(points, chart.point.from_time(outerTime, rowBottom + rowHeight / 2))
                    if rowIndex == rowCount - 1
                        array.push(points, chart.point.from_time(baselineTime, rowBottom + rowHeight))
                        pushHistogramPolyline(points, runInsideVa ? style.histogramInsideColor : style.histogramOutsideColor)

        // The highlight box supersedes the live period's normal box; while active, completed profiles
        // drop theirs so only the current period is framed.
        if isLive and style.highlightEnabled
            color highlightFill = color.new(style.sessionBoxColor, 100 - style.highlightOpacity)
            color highlightBorder = color.new(style.sessionBoxColor, 0)
            array.push(drawnBoxes, box.new(left=profile.startTime, top=profile.priceHigh, right=profile.endTime, bottom=profile.priceLow, xloc=xloc.bar_time, border_width=1, border_color=highlightBorder, bgcolor=highlightFill))
        else if style.showSessionBox and not highlightActive
            array.push(drawnBoxes, box.new(left=profile.startTime, top=profile.priceHigh, right=profile.endTime, bottom=profile.priceLow, xloc=xloc.bar_time, border_width=0, bgcolor=style.sessionBoxColor))

        // Touched levels optionally fade so active ones stand out. Swept levels stay denoted instead of
        // vanishing: the most recent completed profile is always kept, older ones only while their last
        // sweep is within the Keep Swept window.
        bool sweepMode = style.extensionMode == LEVEL_BREACH_SWEEP
        int lastBreach = profileLastBreach(profile)
        bool withinKeepWindow = style.sweptKeepMs > 0 and not na(lastBreach) and time - lastBreach <= style.sweptKeepMs
        bool profileDenote = sweepMode and (isMostRecentCompleted or withinKeepWindow)
        if style.showPoc
            [pocRight, pocExtend] = levelEndpoint(profile.endTime, profile.pocBreachTime, style.extensionMode)
            color pocBaseColor = useDevelopingColors ? style.developingColor : style.pocColor
            bool pocSweptDenote = profileDenote and not na(profile.pocBreachTime)
            color pocColor = pocSweptDenote and isMostRecentCompleted ? pocBaseColor : dimLevelColor(pocBaseColor, not na(profile.pocBreachTime), style.dimTouched, style.dimFraction)
            color pocContinuation = dimLevelColor(pocBaseColor, true, true, style.sweptContinuationFraction)
            drawLevel(profile.startTime, pocRight, profile.pocPrice, pocColor, style.pocWidth, style.pocStyle, pocExtend, useDevelopingColors ? style.developingColor : style.pocLabelColor, LABEL_POC, style, pocSweptDenote, pocContinuation, isLive, isMostRecentCompleted, profile.endTime)
        if style.showAlternatePoc and profile.hasAlternatePoc
            [alternateRight, alternateExtend] = levelEndpoint(profile.endTime, profile.alternatePocBreachTime, style.extensionMode)
            color alternateBaseColor = useDevelopingColors ? style.developingColor : style.alternatePocColor
            bool alternateSweptDenote = profileDenote and not na(profile.alternatePocBreachTime)
            color alternateColor = alternateSweptDenote and isMostRecentCompleted ? alternateBaseColor : dimLevelColor(alternateBaseColor, not na(profile.alternatePocBreachTime), style.dimTouched, style.dimFraction)
            color alternateContinuation = dimLevelColor(alternateBaseColor, true, true, style.sweptContinuationFraction)
            drawLevel(profile.startTime, alternateRight, profile.alternatePocPrice, alternateColor, style.alternatePocWidth, style.alternatePocStyle, alternateExtend, useDevelopingColors ? style.developingColor : style.alternatePocLabelColor, LABEL_ALTERNATE_POC, style, alternateSweptDenote, alternateContinuation, isLive, isMostRecentCompleted, profile.endTime)
        if style.showValueArea
            [valueAreaHighRight, valueAreaHighExtend] = levelEndpoint(profile.endTime, profile.valueAreaHighBreachTime, style.extensionMode)
            color valueAreaBaseColor = useDevelopingColors ? style.developingColor : isMostRecentCompleted ? style.valueAreaLastColor : style.valueAreaColor
            int valueAreaLineWidth = isMostRecentCompleted ? style.valueAreaLastWidth : style.valueAreaWidth
            bool vahSweptDenote = profileDenote and not na(profile.valueAreaHighBreachTime)
            color vahColor = vahSweptDenote and isMostRecentCompleted ? valueAreaBaseColor : dimLevelColor(valueAreaBaseColor, not na(profile.valueAreaHighBreachTime), style.dimTouched, style.dimFraction)
            color vahContinuation = dimLevelColor(valueAreaBaseColor, true, true, style.sweptContinuationFraction)
            drawLevel(profile.startTime, valueAreaHighRight, profile.valueAreaHighPrice, vahColor, valueAreaLineWidth, style.valueAreaStyle, valueAreaHighExtend, useDevelopingColors ? style.developingColor : style.valueAreaLabelColor, LABEL_VAH, style, vahSweptDenote, vahContinuation, isLive, isMostRecentCompleted, profile.endTime)
            [valueAreaLowRight, valueAreaLowExtend] = levelEndpoint(profile.endTime, profile.valueAreaLowBreachTime, style.extensionMode)
            bool valSweptDenote = profileDenote and not na(profile.valueAreaLowBreachTime)
            color valColor = valSweptDenote and isMostRecentCompleted ? valueAreaBaseColor : dimLevelColor(valueAreaBaseColor, not na(profile.valueAreaLowBreachTime), style.dimTouched, style.dimFraction)
            color valContinuation = dimLevelColor(valueAreaBaseColor, true, true, style.sweptContinuationFraction)
            drawLevel(profile.startTime, valueAreaLowRight, profile.valueAreaLowPrice, valColor, valueAreaLineWidth, style.valueAreaStyle, valueAreaLowExtend, useDevelopingColors ? style.developingColor : style.valueAreaLabelColor, LABEL_VAL, style, valSweptDenote, valContinuation, isLive, isMostRecentCompleted, profile.endTime)

// ═══════════════════════════════════════════════════════════════════════════════
// FUNCTIONS — anchor engine
// ═══════════════════════════════════════════════════════════════════════════════

// Finalize one accumulated period into a Profile and commit it to the ring. An outlier-short period
// (early close / holiday half-day, vs the self-calibrated normal span) folds into the merge base for up
// to mergeDepth consecutive shorts: "into previous" bases on the prior full session, "combine" on the
// run's first short. The base's raw bars stay in the pending buffer for recombination.
finalizePeriod(array<float> barHighs, array<float> barLows, array<float> barVolumes, int startTime, int endTime, int lastBarTime, int keepProfiles, array<Profile> profiles, int mergeDepth, bool combineShorts, float shortSpanFraction, array<int> normalSpanRef, array<float> pendingHighs, array<float> pendingLows, array<float> pendingVolumes, array<int> pendingStartRef, array<int> foldCountRef) =>
    if array.size(barVolumes) > 0
        int periodSpan = lastBarTime - startTime
        int normalSpan = array.get(normalSpanRef, 0)
        bool isShortPeriod = mergeDepth > 0 and normalSpan > 0 and periodSpan < int(normalSpan * shortSpanFraction)
        bool canMerge = isShortPeriod and array.get(foldCountRef, 0) < mergeDepth and array.size(pendingVolumes) > 0 and array.size(profiles) > 0
        if canMerge
            array.concat(pendingHighs, barHighs)
            array.concat(pendingLows, barLows)
            array.concat(pendingVolumes, barVolumes)
            compactIfNeeded(pendingHighs, pendingLows, pendingVolumes)
            Profile merged = buildProfile(pendingHighs, pendingLows, pendingVolumes, PROFILE_ROWS, valueAreaPercent, array.get(pendingStartRef, 0), endTime)
            if merged.isValid
                array.pop(profiles)
                array.push(profiles, merged)
                while array.size(profiles) > keepProfiles
                    array.shift(profiles)
            array.set(foldCountRef, 0, array.get(foldCountRef, 0) + 1)
        else
            Profile profile = buildProfile(barHighs, barLows, barVolumes, PROFILE_ROWS, valueAreaPercent, startTime, endTime)
            if profile.isValid
                array.push(profiles, profile)
                while array.size(profiles) > keepProfiles
                    array.shift(profiles)
                // Calibrate normal full-session span from non-merged periods (drives short detection).
                if periodSpan > normalSpan
                    array.set(normalSpanRef, 0, periodSpan)
                if mergeDepth > 0
                    // Set the fold base: "combine" → run's first short (seeded one fold); "into previous"
                    // → a full session. In combine mode a full session clears the base.
                    bool becomesBase = combineShorts ? isShortPeriod : not isShortPeriod
                    if becomesBase
                        array.clear(pendingHighs)
                        array.clear(pendingLows)
                        array.clear(pendingVolumes)
                        array.concat(pendingHighs, barHighs)
                        array.concat(pendingLows, barLows)
                        array.concat(pendingVolumes, barVolumes)
                        array.set(pendingStartRef, 0, startTime)
                        array.set(foldCountRef, 0, combineShorts ? 1 : 0)
                    else if combineShorts and not isShortPeriod
                        array.clear(pendingHighs)
                        array.clear(pendingLows)
                        array.clear(pendingVolumes)
                        array.set(foldCountRef, 0, 0)
        array.clear(barHighs)
        array.clear(barLows)
        array.clear(barVolumes)

processSession(bool enabled, int keepProfiles, bool inWindow, bool periodStart, bool periodEnd, array<float> barHighs, array<float> barLows, array<float> barVolumes, array<Profile> profiles, array<int> periodStartRef, array<float> intrabarHighs, array<float> intrabarLows, array<float> intrabarVolumes, int mergeDepth, bool combineShorts, float shortSpanFraction, array<int> normalSpanRef, array<float> pendingHighs, array<float> pendingLows, array<float> pendingVolumes, array<int> pendingStartRef, array<int> periodLastBarRef, array<int> foldCountRef, bool continuousBoundary) =>
    if enabled
        bool shouldStart = periodStart or (array.get(periodStartRef, 0) == START_TIME_UNSET and inWindow)

        if periodEnd and array.size(barVolumes) > 0
            // End at the actual last traded bar, not the first out-of-session bar: on early-close days
            // the post-session gap would otherwise balloon the box and histogram.
            finalizePeriod(barHighs, barLows, barVolumes, array.get(periodStartRef, 0), array.get(periodLastBarRef, 0), array.get(periodLastBarRef, 0), keepProfiles, profiles, mergeDepth, combineShorts, shortSpanFraction, normalSpanRef, pendingHighs, pendingLows, pendingVolumes, pendingStartRef, foldCountRef)

        if shouldStart
            if array.size(barVolumes) > 0
                // Continuous anchors tile edge-to-edge, so end at the new period's boundary (time);
                // RTH uses time[1] (this path is only its fallback).
                int boundaryEnd = continuousBoundary ? time : time[1]
                finalizePeriod(barHighs, barLows, barVolumes, array.get(periodStartRef, 0), boundaryEnd, array.get(periodLastBarRef, 0), keepProfiles, profiles, mergeDepth, combineShorts, shortSpanFraction, normalSpanRef, pendingHighs, pendingLows, pendingVolumes, pendingStartRef, foldCountRef)
            array.set(periodStartRef, 0, time)

        if inWindow and barstate.isconfirmed
            appendBarVolume(barHighs, barLows, barVolumes, intrabarHighs, intrabarLows, intrabarVolumes, high, low, volume, true)
            array.set(periodLastBarRef, 0, time)

updateMitigation(array<Profile> profiles, bool active, bool sameSessionOnly, bool inWindowNow, array<float> intrabarHighs, array<float> intrabarLows) =>
    if active and array.size(profiles) > 0 and not (sameSessionOnly and not inWindowNow)
        float breachHigh = array.size(intrabarHighs) > 0 ? array.max(intrabarHighs) : high
        float breachLow = array.size(intrabarLows) > 0 ? array.min(intrabarLows) : low
        if not na(breachHigh) and not na(breachLow)
            for profileIndex = 0 to array.size(profiles) - 1
                Profile profile = array.get(profiles, profileIndex)
                if time > profile.endTime
                    if na(profile.pocBreachTime) and breachLow < profile.pocPrice and breachHigh > profile.pocPrice
                        profile.pocBreachTime := time
                    if na(profile.valueAreaHighBreachTime) and breachLow < profile.valueAreaHighPrice and breachHigh > profile.valueAreaHighPrice
                        profile.valueAreaHighBreachTime := time
                    if na(profile.valueAreaLowBreachTime) and breachLow < profile.valueAreaLowPrice and breachHigh > profile.valueAreaLowPrice
                        profile.valueAreaLowBreachTime := time
                    if profile.hasAlternatePoc and na(profile.alternatePocBreachTime) and breachLow < profile.alternatePocPrice and breachHigh > profile.alternatePocPrice
                        profile.alternatePocBreachTime := time

// Advance one level's two-sided sweep from the latest close: a side is "reached" when close passes the
// level by margin; returns the side flags plus the completion time once both sides are reached.
sweepStep(bool reachedAbove, bool reachedBelow, float level, float margin) =>
    bool above = reachedAbove or close >= level + margin
    bool below = reachedBelow or close <= level - margin
    int sweptTime = above and below ? time : na
    [above, below, sweptTime]

// "Until Swept": a level stays live until price closes beyond it on both sides, then its breach time is
// stamped at completion. Tracked every confirmed bar since a sweep can span days.
updateSweep(array<Profile> profiles, bool active, float marginFraction) =>
    if active and array.size(profiles) > 0
        for profileIndex = 0 to array.size(profiles) - 1
            Profile profile = array.get(profiles, profileIndex)
            if time > profile.endTime
                float margin = (profile.priceHigh - profile.priceLow) * marginFraction
                if na(profile.pocBreachTime)
                    [pocAbove, pocBelow, pocSwept] = sweepStep(profile.pocSweptAbove, profile.pocSweptBelow, profile.pocPrice, margin)
                    profile.pocSweptAbove := pocAbove
                    profile.pocSweptBelow := pocBelow
                    if not na(pocSwept)
                        profile.pocBreachTime := pocSwept
                if na(profile.valueAreaHighBreachTime)
                    [vahAbove, vahBelow, vahSwept] = sweepStep(profile.valueAreaHighSweptAbove, profile.valueAreaHighSweptBelow, profile.valueAreaHighPrice, margin)
                    profile.valueAreaHighSweptAbove := vahAbove
                    profile.valueAreaHighSweptBelow := vahBelow
                    if not na(vahSwept)
                        profile.valueAreaHighBreachTime := vahSwept
                if na(profile.valueAreaLowBreachTime)
                    [valAbove, valBelow, valSwept] = sweepStep(profile.valueAreaLowSweptAbove, profile.valueAreaLowSweptBelow, profile.valueAreaLowPrice, margin)
                    profile.valueAreaLowSweptAbove := valAbove
                    profile.valueAreaLowSweptBelow := valBelow
                    if not na(valSwept)
                        profile.valueAreaLowBreachTime := valSwept
                if profile.hasAlternatePoc and na(profile.alternatePocBreachTime)
                    [apocAbove, apocBelow, apocSwept] = sweepStep(profile.alternatePocSweptAbove, profile.alternatePocSweptBelow, profile.alternatePocPrice, margin)
                    profile.alternatePocSweptAbove := apocAbove
                    profile.alternatePocSweptBelow := apocBelow
                    if not na(apocSwept)
                        profile.alternatePocBreachTime := apocSwept

renderSession(bool enabled, array<Profile> profiles, Profile liveProfile, SessionStyle style, bool developingProfileActive, bool showDeveloping, int histogramFromIndex) =>
    if enabled
        bool highlightActive = showDeveloping and style.highlightEnabled
        int profileCount = array.size(profiles)
        if profileCount > 0
            for profileIndex = 0 to profileCount - 1
                renderProfile(array.get(profiles, profileIndex), style, false, profileIndex == profileCount - 1, false, highlightActive, profileIndex >= histogramFromIndex)
        if showDeveloping and not na(liveProfile)
            renderProfile(liveProfile, style, developingProfileActive, false, true, highlightActive, true)

// ═══════════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE
// ═══════════════════════════════════════════════════════════════════════════════
type ColorRow
    string name
    color swatchColor
    string widthText

addColorRow(array<ColorRow> rows, string name, color swatchColor, string widthText) =>
    array.push(rows, ColorRow.new(name, swatchColor, widthText))

writeColorRow(table colorTable, int row, ColorRow entry) =>
    bool hasColor = not na(entry.swatchColor)
    string rgbText = hasColor ? str.format("R:{0} G:{1} B:{2}", int(color.r(entry.swatchColor)), int(color.g(entry.swatchColor)), int(color.b(entry.swatchColor))) : ""
    string transText = hasColor ? str.tostring(int(color.t(entry.swatchColor))) : ""
    table.cell(colorTable, 0, row, entry.name, text_size=size.small, text_color=color.rgb(0, 0, 0))
    table.cell(colorTable, 1, row, rgbText, text_size=size.small, text_color=color.rgb(0, 0, 0))
    table.cell(colorTable, 2, row, transText, text_size=size.small, text_color=color.rgb(0, 0, 0))
    table.cell(colorTable, 3, row, entry.widthText, text_size=size.small, text_color=color.rgb(0, 0, 0))

sessionLevelLabelsActive(bool enabled, SessionStyle style) =>
    bool rightEdgeLabelsActive = style.extensionMode != LEVEL_PERIOD and (style.showValueArea or style.showPoc or style.showAlternatePoc)
    bool anchorLabelsActive = anchorLevelLabelMode != ANCHOR_LABEL_MODE_OFF and (style.showValueArea or style.showPoc)
    enabled and (rightEdgeLabelsActive or anchorLabelsActive)

collectValueGapColorRows(array<ColorRow> rows, string prefix, bool enabled, ValueGapStyle style, bool includeFilled) =>
    if enabled
        addColorRow(rows, prefix + " +", style.bullishColor, "")
        addColorRow(rows, prefix + " −", style.bearishColor, "")
        if includeFilled
            addColorRow(rows, prefix + " Filled", style.filledColor, "")
        if style.showBorders
            addColorRow(rows, prefix + " Border +", style.bullishBorderColor, "1")
            addColorRow(rows, prefix + " Border −", style.bearishBorderColor, "1")
        if style.showLabels
            addColorRow(rows, prefix + " Label +", style.bullishLabelColor, "")
            addColorRow(rows, prefix + " Label −", style.bearishLabelColor, "")
            addColorRow(rows, prefix + " Label ✓", style.mitigatedLabelColor, "")
        if style.showMidpointLine
            addColorRow(rows, prefix + " 50% Line Open", style.midpointOpenLineColor, "1")
            addColorRow(rows, prefix + " 50% Line ✓", style.midpointMitigatedLineColor, "1")
        if style.showQuartileLines
            addColorRow(rows, prefix + " Q Line Open", style.quartileOpenLineColor, "1")
            addColorRow(rows, prefix + " Q Line ✓", style.quartileMitigatedLineColor, "1")

collectSessionColorRows(array<ColorRow> rows, string sessionName, bool enabled, bool showDeveloping, SessionStyle style) =>
    if enabled
        bool levelsActive = style.showValueArea or style.showPoc or style.showAlternatePoc
        bool levelLabelsActive = sessionLevelLabelsActive(enabled, style)
        bool alternatePocLabelsActive = style.extensionMode != LEVEL_PERIOD and style.showAlternatePoc
        if style.showValueArea
            addColorRow(rows, sessionName + " " + LABEL_VALUE_AREA_HIGH_LOW, style.valueAreaColor, str.tostring(style.valueAreaWidth))
            addColorRow(rows, sessionName + " " + LABEL_LAST_VALUE_AREA_COLOR, style.valueAreaLastColor, str.tostring(style.valueAreaLastWidth))
        if style.showPoc
            addColorRow(rows, sessionName + " " + LABEL_POC, style.pocColor, str.tostring(style.pocWidth))
        if style.showAlternatePoc
            addColorRow(rows, sessionName + " " + LABEL_ALTERNATE_POC, style.alternatePocColor, str.tostring(style.alternatePocWidth))
        if style.showHistogram
            addColorRow(rows, sessionName + " " + LABEL_VALUE_AREA + " " + LABEL_HISTOGRAM_INSIDE, style.histogramInsideColor, "")
            addColorRow(rows, sessionName + " " + LABEL_VALUE_AREA + " " + LABEL_HISTOGRAM_OUTSIDE, style.histogramOutsideColor, "")
        if style.showSessionBox or (showDeveloping and style.highlightEnabled)
            addColorRow(rows, sessionName + " " + LABEL_SESSION_BOX, style.sessionBoxColor, "")
        if levelLabelsActive and style.showValueArea
            addColorRow(rows, sessionName + " " + LABEL_LEVEL_LABELS + " " + LABEL_VALUE_AREA_HIGH_LOW, style.valueAreaLabelColor, "")
        if levelLabelsActive and style.showPoc
            addColorRow(rows, sessionName + " " + LABEL_LEVEL_LABELS + " " + LABEL_POC, style.pocLabelColor, "")
        if alternatePocLabelsActive
            addColorRow(rows, sessionName + " " + LABEL_LEVEL_LABELS + " " + LABEL_ALTERNATE_POC, style.alternatePocLabelColor, "")
        if style.developingEnabled and showDeveloping and levelsActive
            addColorRow(rows, sessionName + " Developing", style.developingColor, "")
        if style.extensionMode == LEVEL_BREACH_SWEEP and levelsActive
            addColorRow(rows, sessionName + " " + LABEL_SWEPT + " Line", na, str.tostring(style.sweptContinuationWidth))

// ═══════════════════════════════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════════════════════════════
var table colorTable = na

var array<float> rthBarHighs = array.new<float>()
var array<float> rthBarLows = array.new<float>()
var array<float> rthBarVolumes = array.new<float>()
var array<Profile> rthProfiles = array.new<Profile>()
var array<Profile> valueGapSourceProfiles = array.new<Profile>()
var array<ValueGap> valueGapRecords = array.new<ValueGap>()
var array<int> rthStartRef = array.new<int>(1, START_TIME_UNSET)
var array<float> rthPendingHighs = array.new<float>()
var array<float> rthPendingLows = array.new<float>()
var array<float> rthPendingVolumes = array.new<float>()
var array<int> rthPendingStartRef = array.new<int>(1, START_TIME_UNSET)
var array<int> rthLastBarRef = array.new<int>(1, START_TIME_UNSET)
var array<int> rthNormalSpanRef = array.new<int>(1, 0)
var array<int> rthFoldCountRef = array.new<int>(1, 0)

var array<float> globexBarHighs = array.new<float>()
var array<float> globexBarLows = array.new<float>()
var array<float> globexBarVolumes = array.new<float>()
var array<Profile> globexProfiles = array.new<Profile>()
var array<int> globexStartRef = array.new<int>(1, START_TIME_UNSET)
var array<float> globexPendingHighs = array.new<float>()
var array<float> globexPendingLows = array.new<float>()
var array<float> globexPendingVolumes = array.new<float>()
var array<int> globexPendingStartRef = array.new<int>(1, START_TIME_UNSET)
var array<int> globexLastBarRef = array.new<int>(1, START_TIME_UNSET)
var array<int> globexNormalSpanRef = array.new<int>(1, 0)
var array<int> globexFoldCountRef = array.new<int>(1, 0)

// Short-session merge applies to RTH and Globex; weekly/monthly pass these inert buffers
// (merge depth 0, so pending / span / last-bar refs are written but never read).
var array<float> mergeUnusedHighs = array.new<float>()
var array<float> mergeUnusedLows = array.new<float>()
var array<float> mergeUnusedVolumes = array.new<float>()
var array<int> mergeUnusedStartRef = array.new<int>(1, START_TIME_UNSET)
var array<int> mergeUnusedLastBarRef = array.new<int>(1, START_TIME_UNSET)
var array<int> mergeUnusedNormalSpanRef = array.new<int>(1, 0)
var array<int> mergeUnusedFoldCountRef = array.new<int>(1, 0)

var array<float> weeklyBarHighs = array.new<float>()
var array<float> weeklyBarLows = array.new<float>()
var array<float> weeklyBarVolumes = array.new<float>()
var array<Profile> weeklyProfiles = array.new<Profile>()
var array<int> weeklyStartRef = array.new<int>(1, START_TIME_UNSET)

var array<float> monthlyBarHighs = array.new<float>()
var array<float> monthlyBarLows = array.new<float>()
var array<float> monthlyBarVolumes = array.new<float>()
var array<Profile> monthlyProfiles = array.new<Profile>()
var array<int> monthlyStartRef = array.new<int>(1, START_TIME_UNSET)

var bool isTwentyFourSevenAsset = false
var bool assetClassificationReady = false

// ═══════════════════════════════════════════════════════════════════════════════
// STYLES
// ═══════════════════════════════════════════════════════════════════════════════
var rthStyle = SessionStyle.new(rthExtensionMode, rthDimTouched, rthDimPercent / 100.0, rthShowPoc, rthPocColor, int(str.tonumber(rthPocWidth)), rthPocStyle, rthShowAlternatePoc, rthAlternatePocColor, int(str.tonumber(rthAlternatePocWidth)), rthAlternatePocStyle, rthShowValueArea, rthValueAreaColor, rthValueAreaLastColor, int(str.tonumber(rthValueAreaWidth)), rthValueAreaStyle, rthShowHistogram, rthHistogramInsideColor, rthHistogramOutsideColor, rthShowSessionBox, rthSessionBoxColor, rthShowPrice, levelLabelBgColor, rthValueAreaLabelColor, rthPocLabelColor, rthAlternatePocLabelColor, rthLevelLabelSize, levelLabelOffset, rthDevelopingEnabled, rthDevelopingColor, sweptContinuationLineFadePercent / 100.0, int(str.tonumber(rthSweptContinuationWidth)), rthSweptKeepDays * MS_PER_DAY, LABEL_RTH_ANCHOR, false, LABEL_RTH_LIVE, LABEL_RTH_LAST, false, 0, rthShowSweptReminders, rthShowSweptReminderDate, int(str.tonumber(rthValueAreaLastWidth)))
var globexStyle = SessionStyle.new(globexExtensionMode, globexDimTouched, globexDimPercent / 100.0, globexShowPoc, globexPocColor, int(str.tonumber(globexPocWidth)), globexPocStyle, globexShowAlternatePoc, globexAlternatePocColor, int(str.tonumber(globexAlternatePocWidth)), globexAlternatePocStyle, globexShowValueArea, globexValueAreaColor, globexValueAreaLastColor, int(str.tonumber(globexValueAreaWidth)), globexValueAreaStyle, globexShowHistogram, globexHistogramInsideColor, globexHistogramOutsideColor, globexShowSessionBox, globexSessionBoxColor, globexShowPrice, levelLabelBgColor, globexValueAreaLabelColor, globexPocLabelColor, globexAlternatePocLabelColor, globexLevelLabelSize, levelLabelOffset, false, globexValueAreaColor, sweptContinuationLineFadePercent / 100.0, int(str.tonumber(globexSweptContinuationWidth)), 0, LABEL_GLOBEX_ANCHOR, false, LABEL_GLOBEX_LIVE, LABEL_GLOBEX_LAST, false, 0, globexShowSweptReminders, globexShowSweptReminderDate, int(str.tonumber(globexValueAreaLastWidth)))
var weeklyStyle = SessionStyle.new(weeklyExtensionMode, weeklyDimTouched, weeklyDimPercent / 100.0, weeklyShowPoc, weeklyPocColor, int(str.tonumber(weeklyPocWidth)), weeklyPocStyle, weeklyShowAlternatePoc, weeklyAlternatePocColor, int(str.tonumber(weeklyAlternatePocWidth)), weeklyAlternatePocStyle, weeklyShowValueArea, weeklyValueAreaColor, weeklyValueAreaLastColor, int(str.tonumber(weeklyValueAreaWidth)), weeklyValueAreaStyle, weeklyShowHistogram, weeklyHistogramInsideColor, weeklyHistogramOutsideColor, weeklyShowSessionBox, weeklySessionBoxColor, weeklyShowPrice, levelLabelBgColor, weeklyValueAreaLabelColor, weeklyPocLabelColor, weeklyAlternatePocLabelColor, weeklyLevelLabelSize, levelLabelOffset, false, weeklyValueAreaColor, sweptContinuationLineFadePercent / 100.0, int(str.tonumber(weeklySweptContinuationWidth)), weeklySweptKeepWeeks * MS_PER_WEEK, LABEL_WEEKLY_ANCHOR, false, LABEL_WEEKLY_LIVE, LABEL_WEEKLY_LAST, weeklyHighlightEnabled, weeklyHighlightOpacity, weeklyShowSweptReminders, weeklyShowSweptReminderDate, int(str.tonumber(weeklyValueAreaLastWidth)))
var monthlyStyle = SessionStyle.new(monthlyExtensionMode, monthlyDimTouched, monthlyDimPercent / 100.0, monthlyShowPoc, monthlyPocColor, int(str.tonumber(monthlyPocWidth)), monthlyPocStyle, monthlyShowAlternatePoc, monthlyAlternatePocColor, int(str.tonumber(monthlyAlternatePocWidth)), monthlyAlternatePocStyle, monthlyShowValueArea, monthlyValueAreaColor, monthlyValueAreaLastColor, int(str.tonumber(monthlyValueAreaWidth)), monthlyValueAreaStyle, monthlyShowHistogram, monthlyHistogramInsideColor, monthlyHistogramOutsideColor, monthlyShowSessionBox, monthlySessionBoxColor, monthlyShowPrice, levelLabelBgColor, monthlyValueAreaLabelColor, monthlyPocLabelColor, monthlyAlternatePocLabelColor, monthlyLevelLabelSize, levelLabelOffset, false, monthlyValueAreaColor, sweptContinuationLineFadePercent / 100.0, int(str.tonumber(monthlySweptContinuationWidth)), monthlySweptKeepMonths * MS_PER_MONTH, LABEL_MONTHLY_ANCHOR, true, LABEL_MONTHLY_LIVE, LABEL_MONTHLY_LAST, monthlyHighlightEnabled, monthlyHighlightOpacity, monthlyShowSweptReminders, monthlyShowSweptReminderDate, int(str.tonumber(monthlyValueAreaLastWidth)))

// ═══════════════════════════════════════════════════════════════════════════════
// QUICK FILTER
// ═══════════════════════════════════════════════════════════════════════════════
// Quick Filter only decides WHICH anchors show; every anchor always draws its Show Last count. Manual
// respects each anchor's Enable toggle and always shows developing; every other mode gates developing
// on its Include Developing toggle.
isAll         = quickFilter == FILTER_ALL
isCore        = quickFilter == FILTER_CORE
isPrep        = quickFilter == FILTER_PREP
isIntraday    = quickFilter == FILTER_INTRADAY
isDuo         = quickFilter == FILTER_DUO
isSwing       = quickFilter == FILTER_SWING
isGapsFilter  = quickFilter == FILTER_VALUE_GAPS
isRthOnly     = quickFilter == FILTER_RTH_ONLY
isGlobexOnly  = quickFilter == FILTER_GLOBEX_ONLY
isWeeklyOnly  = quickFilter == FILTER_WEEKLY_ONLY
isMonthlyOnly = quickFilter == FILTER_MONTHLY_ONLY

// Core and Prep share the same curated anchor set (drives the filter-enable flags below).
isCurated = isCore or isPrep

valueGapsActive = valueGapsEnabled or isGapsFilter
rthGapsPreset = isGapsFilter and valueGapSourceIsRth
globexGapsPreset = isGapsFilter and not valueGapSourceIsRth

rthFilterEnabled     = isCurated or isIntraday or isDuo or rthGapsPreset or isRthOnly or (isAll and rthEnabled)
globexFilterEnabled  = isPrep or isIntraday or isGlobexOnly or globexGapsPreset or (isAll and globexEnabled)
weeklyFilterEnabled  = isCurated or isDuo or isSwing or isWeeklyOnly or (isAll and weeklyEnabled)
monthlyFilterEnabled = isCurated or isSwing or isMonthlyOnly or (isAll and monthlyEnabled)

// The preset is presentation-only: it does not rewrite the user's anchor controls. It forces the
// value-area context needed to read the gaps, uses one-touch mitigation, and removes both POC types.
rthEffectiveExtensionMode = rthGapsPreset ? LEVEL_BREACH_ANY : rthExtensionMode
rthStyle.extensionMode := rthEffectiveExtensionMode
rthStyle.showPoc := not rthGapsPreset and rthShowPoc
rthStyle.showAlternatePoc := not rthGapsPreset and rthShowAlternatePoc
rthStyle.showValueArea := rthGapsPreset or rthShowValueArea

globexEffectiveExtensionMode = globexGapsPreset ? LEVEL_BREACH_ANY : globexExtensionMode
globexStyle.extensionMode := globexEffectiveExtensionMode
globexStyle.showPoc := not globexGapsPreset and globexShowPoc
globexStyle.showAlternatePoc := not globexGapsPreset and globexShowAlternatePoc
globexStyle.showValueArea := globexGapsPreset or globexShowValueArea

// Gap detection needs the source anchor's raw samples even when a Quick Filter hides its profiles.
rthDataEnabled = rthFilterEnabled or (valueGapsActive and valueGapSourceIsRth)
globexDataEnabled = globexFilterEnabled or (valueGapsActive and not valueGapSourceIsRth)


rthShowDeveloping     = isAll ? true : includeDevelopingRth
globexShowDeveloping  = isAll ? true : includeDevelopingGlobex
weeklyShowDeveloping  = isAll ? true : includeDevelopingWeekly
monthlyShowDeveloping = isAll ? true : includeDevelopingMonthly

// ═══════════════════════════════════════════════════════════════════════════════
// DATA & BOUNDARIES
// ═══════════════════════════════════════════════════════════════════════════════
intrabarTimeframe = selectedIntrabarTimeframe()
[intrabarHighs, intrabarLows, intrabarVolumes, intrabarTimes] = request.security_lower_tf(syminfo.tickerid, intrabarTimeframe, [high, low, volume, time], ignore_invalid_timeframe=true)

// Classify 24/7 assets incrementally: only Saturday / early-Sunday bars prove 24/7 trading (futures can
// print from Sunday 18:00 NY). O(1) per bar; a full week with no weekend bar means session-based.
if not assetClassificationReady
    if syminfo.type == "crypto"
        isTwentyFourSevenAsset := true
        assetClassificationReady := true
    else if isTrueWeekendBar(time)
        isTwentyFourSevenAsset := true
        assetClassificationReady := true
    else
        int barsInWeek = math.max(1, int(math.ceil(SECONDS_PER_WEEK / timeframe.in_seconds(timeframe.period))))
        int observationWindow = math.min(ASSET_DETECTION_MAX_LOOKBACK, barsInWeek)
        if bar_index >= observationWindow
            isTwentyFourSevenAsset := false
            assetClassificationReady := true

// RTH cash window: session-based assets use the Mon-Fri mask, 24/7 assets the all-days window (both
// const strings, as time() requires); the asset classification picks which.
rthInSessionWeekday = not na(time(timeframe.period, RTH_SESSION, NY_TIMEZONE))
rthInSessionAllDays = not na(time(timeframe.period, RTH_SESSION_ALL_DAYS, NY_TIMEZONE))
rthInSession = isTwentyFourSevenAsset ? rthInSessionAllDays : rthInSessionWeekday
rthSessionStart = rthInSession and not rthInSession[1]
rthSessionEnd = not rthInSession and rthInSession[1]

// Globex/Weekly/Monthly are continuous (no session gap): futures-style symbols anchor on the NY
// calendar, crypto / 24-7 assets on the UTC calendar.
useUtcCalendarAnchors = isTwentyFourSevenAsset
utcDayStart = calendarDayStart(UTC_TIMEZONE)
futuresGlobexStart = shiftedCalendarDayStart(NY_TIMEZONE, GLOBEX_REOPEN_SHIFT_MS)
globexDayStart = selectAssetCalendarStart(useUtcCalendarAnchors, utcDayStart, futuresGlobexStart)
utcWeekStart = calendarWeekStart(UTC_TIMEZONE)
weeklyReopenInSession = not na(time(timeframe.period, WEEKLY_REOPEN_SESSION, NY_TIMEZONE))
futuresWeekStart = weeklyReopenInSession and not weeklyReopenInSession[1] and dayofweek(time, NY_TIMEZONE) == dayofweek.sunday
weeklyPeriodStart = selectAssetCalendarStart(useUtcCalendarAnchors, utcWeekStart, futuresWeekStart)
utcMonthStart = calendarMonthStart(UTC_TIMEZONE)
nyMonthStart = calendarMonthStart(NY_TIMEZONE)
monthlyPeriodStart = selectAssetCalendarStart(useUtcCalendarAnchors, utcMonthStart, nyMonthStart)

// Show Only. The dropdown picks one recurring NY-time window to keep visible; a bar is greyed when it
// falls OUTSIDE that window. Windows are evaluated from const session strings (time() needs consts).
showOnlyTimeframeAllowed = timeframe.in_seconds(timeframe.period) <= SHOW_ONLY_MAX_TIMEFRAME_SECONDS
inVisibleOvernight = not na(time(timeframe.period, SESSION_WINDOW_OVERNIGHT, NY_TIMEZONE))
inVisibleFrom0500 = not na(time(timeframe.period, SESSION_WINDOW_FROM_0500, NY_TIMEZONE))
inVisibleFrom0830 = not na(time(timeframe.period, SESSION_WINDOW_FROM_0830, NY_TIMEZONE))
inVisibleRth = not na(time(timeframe.period, SESSION_WINDOW_RTH, NY_TIMEZONE))
inVisibleWindow = visibleWindow == SHOW_FROM_0500 ? inVisibleFrom0500 : visibleWindow == SHOW_FROM_0830 ? inVisibleFrom0830 : visibleWindow == SHOW_RTH ? inVisibleRth : inVisibleOvernight
// Most Recent Only isolates one occurrence. A closed candle is never repainted, so per-bar muting can only
// key off the bar's own clock — "most recent" here means the occurrence on the current NY date (the live one).
inMostRecentDay = dayofmonth(time, NY_TIMEZONE) == dayofmonth(timenow, NY_TIMEZONE) and month(time, NY_TIMEZONE) == month(timenow, NY_TIMEZONE) and year(time, NY_TIMEZONE) == year(timenow, NY_TIMEZONE)
hideThisBar = showOnlyEnabled and showOnlyTimeframeAllowed and not (inVisibleWindow and (not showOnlyMostRecent or inMostRecentDay))
plotcandle(hideThisBar ? open : na, high, low, close, color=hiddenCandleColor, wickcolor=hiddenCandleColor, bordercolor=hiddenCandleColor, editable=false, display=display.pane, force_overlay=true)

// ═══════════════════════════════════════════════════════════════════════════════
// PROCESS
// ═══════════════════════════════════════════════════════════════════════════════
// Map each merge mode to engine controls: fold depth (consecutive shorts) and combine vs
// fold-into-previous. Depth 2 covers every real CME holiday cluster.
mergeCombine(string mode) =>
    mode == MERGE_COMBINE
mergeDepth(string mode) =>
    mode == MERGE_OFF ? 0 : mode == MERGE_EARLIEST ? 1 : 2

if valueGapsActive
    bool valueGapFallbackWindow = valueGapFillMode == VALUE_GAP_FILL_FROM_0500 ? inVisibleFrom0500 : rthInSession
    [valueGapBreachHigh, valueGapBreachLow] = valueGapFillRange(valueGapFillMode, intrabarHighs, intrabarLows, intrabarTimes, isTwentyFourSevenAsset, valueGapFallbackWindow)
    if not na(valueGapBreachHigh) and not na(valueGapBreachLow)
        updateValueGapPriceFills(valueGapRecords, valueGapBreachHigh, valueGapBreachLow)

processSession(rthDataEnabled, rthProfilesToShow, rthInSession, rthSessionStart, rthSessionEnd, rthBarHighs, rthBarLows, rthBarVolumes, rthProfiles, rthStartRef, intrabarHighs, intrabarLows, intrabarVolumes, mergeDepth(rthMergeMode), mergeCombine(rthMergeMode), RTH_MERGE_SPAN_FRACTION, rthNormalSpanRef, rthPendingHighs, rthPendingLows, rthPendingVolumes, rthPendingStartRef, rthLastBarRef, rthFoldCountRef, false)
processSession(globexDataEnabled, globexProfilesToShow, true, globexDayStart, false, globexBarHighs, globexBarLows, globexBarVolumes, globexProfiles, globexStartRef, intrabarHighs, intrabarLows, intrabarVolumes, mergeDepth(globexMergeMode), mergeCombine(globexMergeMode), GLOBEX_MERGE_SPAN_FRACTION, globexNormalSpanRef, globexPendingHighs, globexPendingLows, globexPendingVolumes, globexPendingStartRef, globexLastBarRef, globexFoldCountRef, true)
processSession(weeklyFilterEnabled, weeklyProfilesToShow, true, weeklyPeriodStart, false, weeklyBarHighs, weeklyBarLows, weeklyBarVolumes, weeklyProfiles, weeklyStartRef, intrabarHighs, intrabarLows, intrabarVolumes, 0, false, 1.0, mergeUnusedNormalSpanRef, mergeUnusedHighs, mergeUnusedLows, mergeUnusedVolumes, mergeUnusedStartRef, mergeUnusedLastBarRef, mergeUnusedFoldCountRef, true)
processSession(monthlyFilterEnabled, monthlyProfilesToShow, true, monthlyPeriodStart, false, monthlyBarHighs, monthlyBarLows, monthlyBarVolumes, monthlyProfiles, monthlyStartRef, intrabarHighs, intrabarLows, intrabarVolumes, 0, false, 1.0, mergeUnusedNormalSpanRef, mergeUnusedHighs, mergeUnusedLows, mergeUnusedVolumes, mergeUnusedStartRef, mergeUnusedLastBarRef, mergeUnusedFoldCountRef, true)

if valueGapsActive
    syncValueGapProfile(valueGapSourceIsRth ? rthProfiles : globexProfiles, valueGapSourceProfiles, valueGapRecords)

rthMitigationActive = rthFilterEnabled and (rthEffectiveExtensionMode == LEVEL_BREACH_ANY or rthEffectiveExtensionMode == LEVEL_BREACH_SAME)
globexMitigationActive = globexFilterEnabled and globexEffectiveExtensionMode == LEVEL_BREACH_ANY
weeklyMitigationActive = weeklyFilterEnabled and weeklyExtensionMode == LEVEL_BREACH_ANY
monthlyMitigationActive = monthlyFilterEnabled and monthlyExtensionMode == LEVEL_BREACH_ANY
rthDevelopingProfileActive = rthFilterEnabled and rthInSession and rthDevelopingEnabled and isBeforeNyCutoff(rthDevelopingCutoffHour, rthDevelopingCutoffMinute)
rthSweepActive = rthFilterEnabled and rthEffectiveExtensionMode == LEVEL_BREACH_SWEEP
globexSweepActive = globexFilterEnabled and globexEffectiveExtensionMode == LEVEL_BREACH_SWEEP
weeklySweepActive = weeklyFilterEnabled and weeklyExtensionMode == LEVEL_BREACH_SWEEP
monthlySweepActive = monthlyFilterEnabled and monthlyExtensionMode == LEVEL_BREACH_SWEEP

if barstate.isconfirmed
    updateMitigation(rthProfiles, rthMitigationActive, rthEffectiveExtensionMode == LEVEL_BREACH_SAME, rthInSession, intrabarHighs, intrabarLows)
    updateMitigation(globexProfiles, globexMitigationActive, false, true, intrabarHighs, intrabarLows)
    updateMitigation(weeklyProfiles, weeklyMitigationActive, false, true, intrabarHighs, intrabarLows)
    updateMitigation(monthlyProfiles, monthlyMitigationActive, false, true, intrabarHighs, intrabarLows)
    updateSweep(rthProfiles, rthSweepActive, sweepConfirmMarginPercent / 100.0)
    updateSweep(globexProfiles, globexSweepActive, sweepConfirmMarginPercent / 100.0)
    updateSweep(weeklyProfiles, weeklySweepActive, sweepConfirmMarginPercent / 100.0)
    updateSweep(monthlyProfiles, monthlySweepActive, sweepConfirmMarginPercent / 100.0)

// ═══════════════════════════════════════════════════════════════════════════════
// RENDER
// ═══════════════════════════════════════════════════════════════════════════════
if barstate.islast
    clearDrawings()
    bool valueGapFloatingActive = valueGapsActive and valueGapDisplayMode != VALUE_GAP_DISPLAY_HISTORICAL
    bool valueGapHistoricalActive = valueGapsActive and valueGapDisplayMode != VALUE_GAP_DISPLAY_FLOATING
    // Globex is continuous: no session gate.
    bool upcomingValueGapActive = valueGapsActive and upcomingValueGapEnabled and (valueGapSourceIsRth ? rthInSession : true)
    bool rthUpcomingSource = upcomingValueGapActive and valueGapSourceIsRth
    bool globexUpcomingSource = upcomingValueGapActive and not valueGapSourceIsRth
    Profile rthLiveProfile = na
    Profile globexLiveProfile = na
    Profile weeklyLiveProfile = na
    Profile monthlyLiveProfile = na
    if rthInSession and ((rthFilterEnabled and rthShowDeveloping) or rthUpcomingSource)
        rthLiveProfile := buildDevelopingProfile(rthBarHighs, rthBarLows, rthBarVolumes, rthStartRef, intrabarHighs, intrabarLows, intrabarVolumes)
    if ((globexFilterEnabled and globexShowDeveloping) or globexUpcomingSource) and array.size(globexBarVolumes) > 0
        globexLiveProfile := buildDevelopingProfile(globexBarHighs, globexBarLows, globexBarVolumes, globexStartRef, intrabarHighs, intrabarLows, intrabarVolumes)
    if weeklyFilterEnabled and weeklyShowDeveloping and array.size(weeklyBarVolumes) > 0
        weeklyLiveProfile := buildDevelopingProfile(weeklyBarHighs, weeklyBarLows, weeklyBarVolumes, weeklyStartRef, intrabarHighs, intrabarLows, intrabarVolumes)
    if monthlyFilterEnabled and monthlyShowDeveloping and array.size(monthlyBarVolumes) > 0
        monthlyLiveProfile := buildDevelopingProfile(monthlyBarHighs, monthlyBarLows, monthlyBarVolumes, monthlyStartRef, intrabarHighs, intrabarLows, intrabarVolumes)
    array<int> floatingValueGapIndices = selectValueGapFloats(valueGapRecords, valueGapFloatingActive, valueGapNearestFloats)
    int historicalGapLimit = valueGapDisplayMode == VALUE_GAP_DISPLAY_RECENT_FLOATING ? 1 : valueGapsToShow
    renderValueGaps(valueGapRecords, valueGapHistoricalActive, floatingValueGapIndices, historicalGapLimit)
    if valueGapFloatingActive
        renderFloatingValueGaps(valueGapRecords, floatingValueGapIndices)
    renderUpcomingValueGap(valueGapSourceIsRth ? rthProfiles : globexProfiles, valueGapSourceIsRth ? rthLiveProfile : globexLiveProfile, upcomingValueGapActive)
    // Live profiles are the newest drawings, so their runs are reserved before completed profiles compete.
    bool rthHistogramActive = rthFilterEnabled and rthShowHistogram
    bool globexHistogramActive = globexFilterEnabled and globexShowHistogram
    bool weeklyHistogramActive = weeklyFilterEnabled and weeklyShowHistogram
    bool monthlyHistogramActive = monthlyFilterEnabled and monthlyShowHistogram
    int liveHistogramReserve = (rthHistogramActive and rthShowDeveloping and array.size(rthBarVolumes) > 0 ? 3 : 0) + (globexHistogramActive and globexShowDeveloping and array.size(globexBarVolumes) > 0 ? 3 : 0) + (weeklyHistogramActive and weeklyShowDeveloping and array.size(weeklyBarVolumes) > 0 ? 3 : 0) + (monthlyHistogramActive and monthlyShowDeveloping and array.size(monthlyBarVolumes) > 0 ? 3 : 0)
    [rthHistogramFromIndex, globexHistogramFromIndex, weeklyHistogramFromIndex, monthlyHistogramFromIndex] = allocateHistogramBudget(rthProfiles, rthHistogramActive, globexProfiles, globexHistogramActive, weeklyProfiles, weeklyHistogramActive, monthlyProfiles, monthlyHistogramActive, INDICATOR_MAX_POLYLINES - liveHistogramReserve)
    renderSession(rthFilterEnabled, rthProfiles, rthLiveProfile, rthStyle, rthDevelopingProfileActive, rthShowDeveloping, rthHistogramFromIndex)
    renderSession(globexFilterEnabled, globexProfiles, globexLiveProfile, globexStyle, false, globexShowDeveloping, globexHistogramFromIndex)
    renderSession(weeklyFilterEnabled, weeklyProfiles, weeklyLiveProfile, weeklyStyle, false, weeklyShowDeveloping, weeklyHistogramFromIndex)
    renderSession(monthlyFilterEnabled, monthlyProfiles, monthlyLiveProfile, monthlyStyle, false, monthlyShowDeveloping, monthlyHistogramFromIndex)
    flushPendingAnchorReminders(dedupeLabels)
    flushPendingLabels(dedupeLabels)
    flushPendingReminders(dedupeLabels)

    if showColorTable
        bool hasLevelLabelBackground = sessionLevelLabelsActive(rthFilterEnabled, rthStyle) or sessionLevelLabelsActive(globexFilterEnabled, globexStyle) or sessionLevelLabelsActive(weeklyFilterEnabled, weeklyStyle) or sessionLevelLabelsActive(monthlyFilterEnabled, monthlyStyle)

        array<ColorRow> colorRows = array.new<ColorRow>()
        if hasLevelLabelBackground
            addColorRow(colorRows, LABEL_LEVEL_LABEL_BACKGROUND, levelLabelBgColor, "")
        bool upcomingGapColorsActive = valueGapsActive and upcomingValueGapEnabled
        collectValueGapColorRows(colorRows, valueGapSource + " Value Gaps", valueGapsActive, confirmedValueGapStyle(), true)
        if upcomingGapColorsActive
            addColorRow(colorRows, "Upcoming Gap Fill", upcomingValueGapColor, "")
            if valueGapShowBorders
                addColorRow(colorRows, "Upcoming Gap Border", upcomingValueGapBorderColor, "1")
        collectSessionColorRows(colorRows, SESSION_RTH, rthFilterEnabled, rthShowDeveloping, rthStyle)
        collectSessionColorRows(colorRows, SESSION_GLOBEX, globexFilterEnabled, globexShowDeveloping, globexStyle)
        collectSessionColorRows(colorRows, SESSION_WEEKLY, weeklyFilterEnabled, weeklyShowDeveloping, weeklyStyle)
        collectSessionColorRows(colorRows, SESSION_MONTHLY, monthlyFilterEnabled, monthlyShowDeveloping, monthlyStyle)
        if showOnlyEnabled and showOnlyTimeframeAllowed
            addColorRow(colorRows, LABEL_HIDDEN_CANDLES, hiddenCandleColor, "")

        if not na(colorTable)
            table.delete(colorTable)
        colorTable := table.new(position.top_right, 4, array.size(colorRows) + 1, bgcolor=color.rgb(255, 255, 255), border_width=1, border_color=color.rgb(128, 128, 128), frame_width=1, frame_color=color.rgb(128, 128, 128))
        table.cell(colorTable, 0, 0, LABEL_TABLE_SETTING, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        table.cell(colorTable, 1, 0, LABEL_TABLE_RGB, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        table.cell(colorTable, 2, 0, LABEL_TABLE_TRANSPARENCY, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        table.cell(colorTable, 3, 0, LABEL_TABLE_WIDTH, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)

        if array.size(colorRows) > 0
            for rowIndex = 0 to array.size(colorRows) - 1
                writeColorRow(colorTable, rowIndex + 1, array.get(colorRows, rowIndex))
    else if not na(colorTable)
        table.delete(colorTable)
        colorTable := na
