//@version=6

// ═══════════════════════════════════════════════════════════════════════════════
// INDICATOR SETUP
// ═══════════════════════════════════════════════════════════════════════════════
INDICATOR_MAX_LINES = 500
INDICATOR_MAX_LABELS = 500
INDICATOR_MAX_BOXES = 500
INDICATOR_MAX_POLYLINES = 100
INDICATOR_TITLE = 'revelio • development'

indicator(INDICATOR_TITLE, overlay=true, max_lines_count=INDICATOR_MAX_LINES, max_labels_count=INDICATOR_MAX_LABELS, max_boxes_count=INDICATOR_MAX_BOXES, max_polylines_count=INDICATOR_MAX_POLYLINES, max_bars_back=5000)

// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════
NY_TIMEZONE = "America/New_York"
UTC_TIMEZONE = "GMT+0"

// Session specification (RTH has a daily gap; the 24h sessions are anchored by NY calendar below)
RTH_SESSION = "0930-1600:23456"      // Regular cash session, Mon-Fri (session-based assets)
RTH_SESSION_ALL_DAYS = "0930-1600:1234567"  // Same 09:30-16:00 NY window every day (24/7 assets)
WEEKLY_REOPEN_SESSION = "1800-0930"  // Sunday 18:00 NY futures reopen edge
SUNDAY_REOPEN_START_HOUR = 18
SECONDS_PER_WEEK = 604800
ASSET_DETECTION_MAX_LOOKBACK = 4999
MS_IN_DAY = 86400000

// Brand bullet used between a level's name and its price in detailed labels.
BRAND_BULLET = "•"

SWEPT_GHOST_LINE_WIDTH = 1

START_TIME_UNSET = -1

// Level extension / mitigation modes
LEVEL_PERIOD = "Session Only"
LEVEL_BREACH_ANY = "Until Touched"
LEVEL_BREACH_SAME = "Same-Session Touch"
LEVEL_BREACH_SWEEP = "Until Swept"

// A session whose bar-span is below this fraction of the longest session seen is treated as
// an early close / holiday half-day and merged per the selected mode.
HOLIDAY_MERGE_SPAN_FRACTION = 0.75

PROFILE_ROWS = 250
HISTOGRAM_SMOOTHING = 7
HISTOGRAM_WIDTH_PERCENT = 25.0

// Short-session merge modes (how early closes / holiday half-days combine), ordered least-to-most
// merging. "Earliest" = the oldest short of a run (chart-left). Real CME holiday clusters are at most
// two consecutive short sessions, so these cover the whole option space.
MERGE_OFF = "Off"
MERGE_EARLIEST = "Earliest Into Previous Full Session"
MERGE_ALL = "All Into Previous Full Session"
MERGE_COMBINE = "Combine Shorts"

// Line styles
STYLE_SOLID = "Solid"
STYLE_DASHED = "Dashed"
STYLE_DOTTED = "Dotted"

// Label sizes
LABEL_SIZE_TINY = "Tiny"
LABEL_SIZE_SMALL = "Small"
LABEL_SIZE_NORMAL = "Normal"
LABEL_SIZE_LARGE = "Large"
LABEL_SIZE_HUGE = "Huge"

// Nearest-alternate-POC qualification (volume-only): a secondary node "competes" when
// it is nearly as heavy as the POC — that volume near-tie is what lets a timeframe /
// HD-resolution change tip which node is #1 and move the POC onto it. Price distance is
// deliberately NOT a factor: two near-equal nodes can sit at opposite ends of the profile
// and the POC will still flip between them.
ALTERNATE_POC_WINDOW_FRAC = 0.03  // ignore rows within this fraction of total rows around the POC (its own shoulder)
ALTERNATE_POC_MIN_RATIO = 0.90    // candidate volume must be ≥ this fraction of POC volume to qualify

// Session group labels (each session contains volume profiles)
GROUP_QUICK_FILTER = "⚡ Quick Filter"
GROUP_DISPLAY = "⚙️ Display"
GROUP_SWEEP = "🧹 Sweep"
GROUP_RTH = "🗽 RTH"
GROUP_RTH_ADVANCED = "🗽 RTH: Advanced"
GROUP_WEEKLY = "📅 Weekly"
GROUP_GLOBEX = "🌅 Globex"
GROUP_MONTHLY = "🗓️ Monthly"
GROUP_UTILITY = "🎨 Utility"

// Plain session labels reused where emojis would add noise.
SESSION_RTH = "RTH"
SESSION_WEEKLY = "Weekly"
SESSION_GLOBEX = "Globex"
SESSION_MONTHLY = "Monthly"

// Input labels reused across every session (change once, applies everywhere)
LABEL_ENABLE_RTH = "Enable RTH Session"
LABEL_ENABLE_WEEKLY = "Enable Weekly Session"
LABEL_ENABLE_GLOBEX = "Enable Globex Session"
LABEL_ENABLE_MONTHLY = "Enable Monthly Session"
LABEL_DIM_TOUCHED = "Fade Mitigated Levels"
LABEL_DIM_PERCENT = "%"
LABEL_VALUE_AREA_HIGH_LOW = "VAH/L"
LABEL_VAH = "VAH"
LABEL_VAL = "VAL"
LABEL_POC = "POC"
LABEL_ALTERNATE_POC = "aPOC"
LABEL_VALUE_AREA = "Value"
LABEL_HISTOGRAM_INSIDE = "In"
LABEL_HISTOGRAM_OUTSIDE = "Out"
LABEL_SESSION_BOX = "Session Box"
LABEL_SHORT_SESSION_MERGE = "Merge Short Session"
LABEL_LEVEL_LABELS = "Price Labels"
LABEL_LEVEL_LABEL_OFFSET = "Price Label Offset"
LABEL_LEVEL_LABEL_BACKGROUND = "Price Label Background"
LABEL_MODE_OFF = "Off"
LABEL_MODE_PRICE = "Price"
LABEL_MODE_DETAILS = "With Details"
LABEL_MODE_BOTH = "Both"
TOOLTIP_LEVEL_LABELS = "Tag for each open, untouched level still extending right (POC, VAH/VAL, aPOC). Off = no tag; Price = price only; Label Details = anchor + level name; Both = name and price."
LABEL_DEVELOPING_PROFILE = "Enable Developing Profile"
LABEL_CUTOFF = "Cutoff"
LABEL_SWEPT = "Swept"
LABEL_SWEEP_CONFIRM_MARGIN = "Sweep Confirmation Percent Margin"
LABEL_SWEPT_GHOST_LINE_FADE = "Level Fade Percent"
LABEL_SWEPT_LABEL_TEXT_FADE = "Label Text Fade"
LABEL_SWEPT_KEEP = "Days to Keep Swept Lines"
TOOLTIP_SWEEP_MARGIN = "For 'Until Swept' only. A close counts as a clean departure to one side when it is beyond the level by at least this percentage of the profile's high-low range. The level is swept once price has done this on both sides, which keeps tick-chop on the level from counting."
TOOLTIP_SWEPT_GHOST_LINE_FADE = "Extra fade applied to the dashed ghost continuation of swept levels, on top of the Fade Mitigated Levels setting."
TOOLTIP_SWEPT_LABEL_TEXT_FADE = "Extra fade applied only to swept level label text. 0 = keep the normal label text color; 100 = fully transparent."
TOOLTIP_SWEPT_KEEP = "RTH only. Beyond the most recent RTH profile (always kept), also keep the faded ghost of older swept levels whose sweep happened within this many days. A whole profile is kept when its most recent sweep falls inside the window. 0 = only the most recent RTH profile's swept levels are kept."
MS_PER_DAY = 24 * 60 * 60 * 1000
LABEL_RTH_ANCHOR = "Daily"
LABEL_RTH_LIVE = "★ Today's"
LABEL_RTH_LAST = "Prev"
LABEL_WEEKLY_ANCHOR = "Weekly"
LABEL_WEEKLY_LIVE = "★ This Week's"
LABEL_WEEKLY_LAST = "Last Week's"
LABEL_GLOBEX_ANCHOR = "Globex"
LABEL_GLOBEX_LIVE = "Today's Globex"
LABEL_GLOBEX_LAST = "Prev Globex"
LABEL_MONTHLY_ANCHOR = "Monthly"
LABEL_MONTHLY_LIVE = "★ This Month's"
LABEL_MONTHLY_LAST = "Last Month's"
LABEL_TABLE_SETTING = "Setting"
LABEL_TABLE_RGB = "RGB"
LABEL_TABLE_TRANSPARENCY = "Trans"
LABEL_TABLE_WIDTH = "Width"

FILTER_CUSTOM = "Custom"
FILTER_ALL = "All"
FILTER_LANDSCAPE = "★ Landscape"
FILTER_RTH_ONLY = "RTH Only"
FILTER_WEEKLY_ONLY = "Weekly Only"
FILTER_MONTHLY_ONLY = "Monthly Only"
TOOLTIP_QUICK_FILTER = "Override every session's Enable toggle to quickly show a focused set of profiles.\n\n• Custom — respect each session's own Enable toggle\n• All — force all four anchors (RTH, Weekly, Globex, Monthly) on\n• Landscape — day-prep view: the last 2 completed RTH sessions and the last 2 completed weekly profiles. Today's developing RTH and the current developing week are hidden unless their include toggles below are on\n• RTH Only — RTH profiles only, using the RTH Show Last count\n• Weekly Only — weekly profiles only, using the Weekly Show Last count\n• Monthly Only — monthly profiles only, using the Monthly Show Last count\n\nThe Only modes use each session's own settings, including whether its developing/current profile shows."
TOOLTIP_LANDSCAPE_RTH = "Landscape only. When on, also show today's developing RTH profile alongside the last 2 completed RTH sessions."
TOOLTIP_LANDSCAPE_WEEKLY = "Landscape only. When on, also show the current developing weekly profile alongside the last 2 completed weekly profiles."

LANDSCAPE_PROFILE_COUNT = 2

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Quick Filter
// ═══════════════════════════════════════════════════════════════════════════════
quickFilter = input.string(FILTER_CUSTOM, "Quick Filter", options=[FILTER_CUSTOM, FILTER_ALL, FILTER_LANDSCAPE, FILTER_RTH_ONLY, FILTER_WEEKLY_ONLY, FILTER_MONTHLY_ONLY], group=GROUP_QUICK_FILTER, tooltip=TOOLTIP_QUICK_FILTER)
landscapeIncludeDevelopingRth = input.bool(false, "Include Developing RTH in Landscape Mode", group=GROUP_QUICK_FILTER, tooltip=TOOLTIP_LANDSCAPE_RTH)
landscapeIncludeDevelopingWeekly = input.bool(false, "Include Developing Weekly in Landscape Mode", group=GROUP_QUICK_FILTER, tooltip=TOOLTIP_LANDSCAPE_WEEKLY)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — RTH session
// ═══════════════════════════════════════════════════════════════════════════════
rthEnabled = input.bool(true, LABEL_ENABLE_RTH, inline="rth_top", group=GROUP_RTH, tooltip="Build a volume profile for each Regular Trading Hours cash session (09:30–16:00 New York time, Mon–Fri).")
rthExtensionMode = input.string(LEVEL_BREACH_SWEEP, "", options=[LEVEL_PERIOD, LEVEL_BREACH_ANY, LEVEL_BREACH_SAME, LEVEL_BREACH_SWEEP], inline="rth_top", group=GROUP_RTH, tooltip="How the POC and Value Area High / Low extend after the session closes:\n• Session Only — stays within its session\n• Until Touched — extends right, stops at the first bar that trades through it\n• Same-Session Touch — stops only when a later RTH session trades through it\n• Until Swept — stays live through touches until price has cleanly closed beyond it on BOTH sides (a two-sided sweep), then stops")
rthProfilesToShow = input.int(10, "", minval=1, maxval=50, inline="rth_top", group=GROUP_RTH, tooltip="How many recent profiles this session keeps and draws.")
rthShowValueArea = input.bool(true, LABEL_VALUE_AREA_HIGH_LOW, inline="rth_value_area", group=GROUP_RTH)
rthValueAreaColor = input.color(color.new(color.rgb(41, 98, 255), 20), "", inline="rth_value_area", group=GROUP_RTH)
rthValueAreaWidth = input.string("2", "", options=["1", "2", "3", "4", "5"], inline="rth_value_area", group=GROUP_RTH)
rthValueAreaStyle = input.string(STYLE_SOLID, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="rth_value_area", group=GROUP_RTH)
rthShowPoc = input.bool(true, LABEL_POC, inline="rth_poc", group=GROUP_RTH)
rthPocColor = input.color(color.new(color.rgb(156, 39, 176), 0), "", inline="rth_poc", group=GROUP_RTH)
rthPocWidth = input.string("2", "", options=["1", "2", "3", "4", "5"], inline="rth_poc", group=GROUP_RTH)
rthPocStyle = input.string(STYLE_DASHED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="rth_poc", group=GROUP_RTH)
rthShowAlternatePoc = input.bool(false, LABEL_ALTERNATE_POC, inline="rth_altpoc", group=GROUP_RTH, tooltip="Also mark the alternate POC: a secondary node nearly as heavy as the main POC (by volume), so the POC could shift onto it at a different timeframe or HD resolution. Hidden when no qualifying node exists.")
rthAlternatePocColor = input.color(color.new(color.rgb(233, 30, 99), 0), "", inline="rth_altpoc", group=GROUP_RTH)
rthAlternatePocWidth = input.string("2", "", options=["1", "2", "3", "4", "5"], inline="rth_altpoc", group=GROUP_RTH)
rthAlternatePocStyle = input.string(STYLE_DOTTED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="rth_altpoc", group=GROUP_RTH)
rthDimTouched = input.bool(true, LABEL_DIM_TOUCHED, inline="rth_dim", group=GROUP_RTH, tooltip="Fade levels that have already been touched (mitigated) so untouched, still-active levels keep full strength. Only meaningful in the 'Until Touched' modes.")
rthDimPercent = input.int(85, LABEL_DIM_PERCENT, minval=0, maxval=100, inline="rth_dim", group=GROUP_RTH)
rthShowSessionBox = input.bool(false, LABEL_SESSION_BOX, inline="rth_hist", group=GROUP_RTH)
rthSessionBoxColor = input.color(color.new(color.rgb(187, 217, 251), 90), "", inline="rth_hist", group=GROUP_RTH)
rthShowHistogram = input.bool(true, LABEL_VALUE_AREA, inline="rth_hist", group=GROUP_RTH)
rthHistogramInsideColor = input.color(color.new(color.rgb(91, 156, 246), 75), LABEL_HISTOGRAM_INSIDE, inline="rth_hist", group=GROUP_RTH)
rthHistogramOutsideColor = input.color(color.new(color.rgb(184, 184, 184), 80), LABEL_HISTOGRAM_OUTSIDE, inline="rth_hist", group=GROUP_RTH)
rthValueAreaLabelColor = input.color(color.new(color.rgb(24, 72, 204), 20), LABEL_VALUE_AREA_HIGH_LOW, inline="rth_label_colors", group=GROUP_RTH)
rthPocLabelColor = input.color(color.new(color.rgb(123, 31, 162), 0), LABEL_POC, inline="rth_label_colors", group=GROUP_RTH)
rthAlternatePocLabelColor = input.color(color.new(color.rgb(194, 24, 91), 0), LABEL_ALTERNATE_POC, inline="rth_label_colors", group=GROUP_RTH)
rthLevelLabelMode = input.string(LABEL_MODE_BOTH, LABEL_LEVEL_LABELS, options=[LABEL_MODE_OFF, LABEL_MODE_PRICE, LABEL_MODE_DETAILS, LABEL_MODE_BOTH], inline="rth_labels", group=GROUP_RTH, tooltip=TOOLTIP_LEVEL_LABELS)
rthLevelLabelSize = input.string(LABEL_SIZE_TINY, "", options=[LABEL_SIZE_TINY, LABEL_SIZE_SMALL, LABEL_SIZE_NORMAL, LABEL_SIZE_LARGE, LABEL_SIZE_HUGE], inline="rth_labels", group=GROUP_RTH)
rthMergeMode = input.string(MERGE_ALL, LABEL_SHORT_SESSION_MERGE, options=[MERGE_OFF, MERGE_EARLIEST, MERGE_ALL, MERGE_COMBINE], inline="rth_merge", group=GROUP_RTH_ADVANCED, tooltip="How short sessions (early closes / holiday half-days) are handled. A session counts as short when its bar span is under 75% of the longest RTH session seen.\n• Off — every short session stands alone\n• Earliest Into Previous Full Session — only the earliest (oldest) short folds into the prior full session; later shorts stand alone\n• All Into Previous Full Session — all consecutive shorts fold into the prior full session\n• Combine Shorts — consecutive shorts merge into one block, leaving the prior full session intact")
rthDevelopingEnabled = input.bool(true, LABEL_DEVELOPING_PROFILE, inline="rth_developing", group=GROUP_RTH_ADVANCED, tooltip="Temporarily recolor the live RTH POC, aPOC, and VAH/VAL before the cutoff time so users can tell the profile is still immature.")
rthDevelopingValueAreaColor = input.color(color.new(color.rgb(128, 128, 128), 20), LABEL_VALUE_AREA_HIGH_LOW, inline="rth_developing", group=GROUP_RTH_ADVANCED)
rthDevelopingPocColor = input.color(color.new(color.rgb(206, 147, 216), 0), LABEL_POC, inline="rth_developing", group=GROUP_RTH_ADVANCED)
rthDevelopingAlternatePocColor = input.color(color.new(color.rgb(244, 143, 177), 0), LABEL_ALTERNATE_POC, inline="rth_developing", group=GROUP_RTH_ADVANCED)
rthDevelopingCutoffHour = input.int(10, LABEL_CUTOFF, minval=0, maxval=23, inline="rth_developing", group=GROUP_RTH_ADVANCED)
rthDevelopingCutoffMinute = input.int(30, ":", minval=0, maxval=59, inline="rth_developing", group=GROUP_RTH_ADVANCED, tooltip="New York cutoff time. Developing colors apply only before this HH:MM.")

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Weekly session
// ═══════════════════════════════════════════════════════════════════════════════
weeklyEnabled = input.bool(false, LABEL_ENABLE_WEEKLY, inline="weekly_top", group=GROUP_WEEKLY, tooltip="Build a volume profile for each week. Futures-style symbols use the Sunday 18:00 New York reopen; crypto / 24/7 assets use Monday 00:00 UTC.")
weeklyExtensionMode = input.string(LEVEL_BREACH_SWEEP, "", options=[LEVEL_PERIOD, LEVEL_BREACH_ANY, LEVEL_BREACH_SWEEP], inline="weekly_top", group=GROUP_WEEKLY, tooltip="How the POC and Value Area High / Low extend after the week closes:\n• Session Only — stays within its week\n• Until Touched — extends right, stops at the first bar that trades through it\n• Until Swept — stays live through touches until price has cleanly closed beyond it on BOTH sides, then stops")
weeklyProfilesToShow = input.int(4, "", minval=1, maxval=50, inline="weekly_top", group=GROUP_WEEKLY, tooltip="How many recent profiles this session keeps and draws.")
weeklyShowValueArea = input.bool(true, LABEL_VALUE_AREA_HIGH_LOW, inline="weekly_value_area", group=GROUP_WEEKLY)
weeklyValueAreaColor = input.color(color.new(color.rgb(245, 124, 0), 20), "", inline="weekly_value_area", group=GROUP_WEEKLY)
weeklyValueAreaWidth = input.string("2", "", options=["1", "2", "3", "4", "5"], inline="weekly_value_area", group=GROUP_WEEKLY)
weeklyValueAreaStyle = input.string(STYLE_SOLID, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="weekly_value_area", group=GROUP_WEEKLY)
weeklyShowPoc = input.bool(true, LABEL_POC, inline="weekly_poc", group=GROUP_WEEKLY)
weeklyPocColor = input.color(color.new(color.rgb(171, 71, 188), 0), "", inline="weekly_poc", group=GROUP_WEEKLY)
weeklyPocWidth = input.string("2", "", options=["1", "2", "3", "4", "5"], inline="weekly_poc", group=GROUP_WEEKLY)
weeklyPocStyle = input.string(STYLE_DASHED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="weekly_poc", group=GROUP_WEEKLY)
weeklyShowAlternatePoc = input.bool(false, LABEL_ALTERNATE_POC, inline="weekly_altpoc", group=GROUP_WEEKLY, tooltip="Also mark the alternate POC: a secondary node nearly as heavy as the main POC (by volume), so the POC could shift onto it at a different timeframe or HD resolution. Hidden when no qualifying node exists.")
weeklyAlternatePocColor = input.color(color.new(color.rgb(233, 30, 99), 0), "", inline="weekly_altpoc", group=GROUP_WEEKLY)
weeklyAlternatePocWidth = input.string("2", "", options=["1", "2", "3", "4", "5"], inline="weekly_altpoc", group=GROUP_WEEKLY)
weeklyAlternatePocStyle = input.string(STYLE_DOTTED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="weekly_altpoc", group=GROUP_WEEKLY)
weeklyDimTouched = input.bool(true, LABEL_DIM_TOUCHED, inline="weekly_dim", group=GROUP_WEEKLY, tooltip="Fade levels that have already been touched (mitigated) so untouched, still-active levels keep full strength. Only meaningful in the 'Until Touched' modes.")
weeklyDimPercent = input.int(85, LABEL_DIM_PERCENT, minval=0, maxval=100, inline="weekly_dim", group=GROUP_WEEKLY)
weeklyShowSessionBox = input.bool(false, LABEL_SESSION_BOX, inline="weekly_hist", group=GROUP_WEEKLY)
weeklySessionBoxColor = input.color(color.new(color.rgb(255, 224, 178), 95), "", inline="weekly_hist", group=GROUP_WEEKLY)
weeklyShowHistogram = input.bool(true, LABEL_VALUE_AREA, inline="weekly_hist", group=GROUP_WEEKLY)
weeklyHistogramInsideColor = input.color(color.new(color.rgb(255, 224, 178), 70), LABEL_HISTOGRAM_INSIDE, inline="weekly_hist", group=GROUP_WEEKLY)
weeklyHistogramOutsideColor = input.color(color.new(color.rgb(184, 184, 184), 80), LABEL_HISTOGRAM_OUTSIDE, inline="weekly_hist", group=GROUP_WEEKLY)
weeklyValueAreaLabelColor = input.color(color.new(color.rgb(230, 81, 0), 20), LABEL_VALUE_AREA_HIGH_LOW, inline="weekly_label_colors", group=GROUP_WEEKLY)
weeklyPocLabelColor = input.color(color.new(color.rgb(123, 31, 162), 0), LABEL_POC, inline="weekly_label_colors", group=GROUP_WEEKLY)
weeklyAlternatePocLabelColor = input.color(color.new(color.rgb(194, 24, 91), 0), LABEL_ALTERNATE_POC, inline="weekly_label_colors", group=GROUP_WEEKLY)
weeklyLevelLabelMode = input.string(LABEL_MODE_DETAILS, LABEL_LEVEL_LABELS, options=[LABEL_MODE_OFF, LABEL_MODE_PRICE, LABEL_MODE_DETAILS, LABEL_MODE_BOTH], inline="weekly_labels", group=GROUP_WEEKLY, tooltip=TOOLTIP_LEVEL_LABELS)
weeklyLevelLabelSize = input.string(LABEL_SIZE_NORMAL, "", options=[LABEL_SIZE_TINY, LABEL_SIZE_SMALL, LABEL_SIZE_NORMAL, LABEL_SIZE_LARGE, LABEL_SIZE_HUGE], inline="weekly_labels", group=GROUP_WEEKLY)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Globex session
// ═══════════════════════════════════════════════════════════════════════════════
globexEnabled = input.bool(false, LABEL_ENABLE_GLOBEX, inline="globex_top", group=GROUP_GLOBEX, tooltip="Build a volume profile for each Globex trading day. Futures-style symbols use the 18:00 New York Globex open; crypto / 24/7 assets use 00:00 UTC.")
globexExtensionMode = input.string(LEVEL_BREACH_SWEEP, "", options=[LEVEL_PERIOD, LEVEL_BREACH_ANY, LEVEL_BREACH_SAME, LEVEL_BREACH_SWEEP], inline="globex_top", group=GROUP_GLOBEX, tooltip="How the POC and Value Area High / Low extend after the period closes.\n• Same-Session Touch — only a later Globex period can mitigate the level\n• Until Swept — stays live through touches until price has cleanly closed beyond it on BOTH sides, then stops")
globexProfilesToShow = input.int(10, "", minval=1, maxval=50, inline="globex_top", group=GROUP_GLOBEX, tooltip="How many recent profiles this session keeps and draws.")
globexShowValueArea = input.bool(true, LABEL_VALUE_AREA_HIGH_LOW, inline="globex_value_area", group=GROUP_GLOBEX)
globexValueAreaColor = input.color(color.new(color.rgb(128, 222, 234), 0), "", inline="globex_value_area", group=GROUP_GLOBEX)
globexValueAreaWidth = input.string("1", "", options=["1", "2", "3", "4", "5"], inline="globex_value_area", group=GROUP_GLOBEX)
globexValueAreaStyle = input.string(STYLE_SOLID, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="globex_value_area", group=GROUP_GLOBEX)
globexShowPoc = input.bool(true, LABEL_POC, inline="globex_poc", group=GROUP_GLOBEX)
globexPocColor = input.color(color.new(color.rgb(186, 104, 200), 0), "", inline="globex_poc", group=GROUP_GLOBEX)
globexPocWidth = input.string("1", "", options=["1", "2", "3", "4", "5"], inline="globex_poc", group=GROUP_GLOBEX)
globexPocStyle = input.string(STYLE_DASHED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="globex_poc", group=GROUP_GLOBEX)
globexShowAlternatePoc = input.bool(false, LABEL_ALTERNATE_POC, inline="globex_altpoc", group=GROUP_GLOBEX, tooltip="Also mark the alternate POC: a secondary node nearly as heavy as the main POC (by volume), so the POC could shift onto it at a different timeframe or HD resolution. Hidden when no qualifying node exists.")
globexAlternatePocColor = input.color(color.new(color.rgb(233, 30, 99), 0), "", inline="globex_altpoc", group=GROUP_GLOBEX)
globexAlternatePocWidth = input.string("1", "", options=["1", "2", "3", "4", "5"], inline="globex_altpoc", group=GROUP_GLOBEX)
globexAlternatePocStyle = input.string(STYLE_DOTTED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="globex_altpoc", group=GROUP_GLOBEX)
globexDimTouched = input.bool(true, LABEL_DIM_TOUCHED, inline="globex_dim", group=GROUP_GLOBEX, tooltip="Fade levels that have already been touched (mitigated) so untouched, still-active levels keep full strength. Only meaningful in the 'Until Touched' modes.")
globexDimPercent = input.int(85, LABEL_DIM_PERCENT, minval=0, maxval=100, inline="globex_dim", group=GROUP_GLOBEX)
globexShowSessionBox = input.bool(false, LABEL_SESSION_BOX, inline="globex_hist", group=GROUP_GLOBEX)
globexSessionBoxColor = input.color(color.new(color.rgb(178, 235, 242), 98), "", inline="globex_hist", group=GROUP_GLOBEX)
globexShowHistogram = input.bool(true, LABEL_VALUE_AREA, inline="globex_hist", group=GROUP_GLOBEX)
globexHistogramInsideColor = input.color(color.new(color.rgb(178, 235, 242), 80), LABEL_HISTOGRAM_INSIDE, inline="globex_hist", group=GROUP_GLOBEX)
globexHistogramOutsideColor = input.color(color.new(color.rgb(184, 184, 184), 80), LABEL_HISTOGRAM_OUTSIDE, inline="globex_hist", group=GROUP_GLOBEX)
globexValueAreaLabelColor = input.color(color.new(color.rgb(0, 151, 167), 0), LABEL_VALUE_AREA_HIGH_LOW, inline="globex_label_colors", group=GROUP_GLOBEX)
globexPocLabelColor = input.color(color.new(color.rgb(123, 31, 162), 0), LABEL_POC, inline="globex_label_colors", group=GROUP_GLOBEX)
globexAlternatePocLabelColor = input.color(color.new(color.rgb(194, 24, 91), 0), LABEL_ALTERNATE_POC, inline="globex_label_colors", group=GROUP_GLOBEX)
globexLevelLabelMode = input.string(LABEL_MODE_BOTH, LABEL_LEVEL_LABELS, options=[LABEL_MODE_OFF, LABEL_MODE_PRICE, LABEL_MODE_DETAILS, LABEL_MODE_BOTH], inline="globex_labels", group=GROUP_GLOBEX, tooltip=TOOLTIP_LEVEL_LABELS)
globexLevelLabelSize = input.string(LABEL_SIZE_SMALL, "", options=[LABEL_SIZE_TINY, LABEL_SIZE_SMALL, LABEL_SIZE_NORMAL, LABEL_SIZE_LARGE, LABEL_SIZE_HUGE], inline="globex_labels", group=GROUP_GLOBEX)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Monthly session
// ═══════════════════════════════════════════════════════════════════════════════
monthlyEnabled = input.bool(false, LABEL_ENABLE_MONTHLY, inline="monthly_top", group=GROUP_MONTHLY, tooltip="Build a volume profile for each calendar month. Crypto / 24/7 assets use UTC months; other symbols use New York months.")
monthlyExtensionMode = input.string(LEVEL_BREACH_SWEEP, "", options=[LEVEL_PERIOD, LEVEL_BREACH_ANY, LEVEL_BREACH_SWEEP], inline="monthly_top", group=GROUP_MONTHLY, tooltip="How the POC and Value Area High / Low extend after the month closes:\n• Session Only — stays within its month\n• Until Touched — extends right, stops at the first bar that trades through it\n• Until Swept — stays live through touches until price has cleanly closed beyond it on BOTH sides, then stops")
monthlyProfilesToShow = input.int(3, "", minval=1, maxval=50, inline="monthly_top", group=GROUP_MONTHLY, tooltip="How many recent profiles this session keeps and draws.")
monthlyShowValueArea = input.bool(true, LABEL_VALUE_AREA_HIGH_LOW, inline="monthly_value_area", group=GROUP_MONTHLY)
monthlyValueAreaColor = input.color(color.new(color.rgb(76, 175, 80), 20), "", inline="monthly_value_area", group=GROUP_MONTHLY)
monthlyValueAreaWidth = input.string("3", "", options=["1", "2", "3", "4", "5"], inline="monthly_value_area", group=GROUP_MONTHLY)
monthlyValueAreaStyle = input.string(STYLE_SOLID, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="monthly_value_area", group=GROUP_MONTHLY)
monthlyShowPoc = input.bool(true, LABEL_POC, inline="monthly_poc", group=GROUP_MONTHLY)
monthlyPocColor = input.color(color.new(color.rgb(171, 71, 188), 0), "", inline="monthly_poc", group=GROUP_MONTHLY)
monthlyPocWidth = input.string("3", "", options=["1", "2", "3", "4", "5"], inline="monthly_poc", group=GROUP_MONTHLY)
monthlyPocStyle = input.string(STYLE_DASHED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="monthly_poc", group=GROUP_MONTHLY)
monthlyShowAlternatePoc = input.bool(false, LABEL_ALTERNATE_POC, inline="monthly_altpoc", group=GROUP_MONTHLY, tooltip="Also mark the alternate POC: a secondary node nearly as heavy as the main POC (by volume), so the POC could shift onto it at a different timeframe or HD resolution. Hidden when no qualifying node exists.")
monthlyAlternatePocColor = input.color(color.new(color.rgb(233, 30, 99), 0), "", inline="monthly_altpoc", group=GROUP_MONTHLY)
monthlyAlternatePocWidth = input.string("3", "", options=["1", "2", "3", "4", "5"], inline="monthly_altpoc", group=GROUP_MONTHLY)
monthlyAlternatePocStyle = input.string(STYLE_DOTTED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="monthly_altpoc", group=GROUP_MONTHLY)
monthlyDimTouched = input.bool(true, LABEL_DIM_TOUCHED, inline="monthly_dim", group=GROUP_MONTHLY, tooltip="Fade levels that have already been touched (mitigated) so untouched, still-active levels keep full strength. Only meaningful in the 'Until Touched' modes.")
monthlyDimPercent = input.int(85, LABEL_DIM_PERCENT, minval=0, maxval=100, inline="monthly_dim", group=GROUP_MONTHLY)
monthlyShowSessionBox = input.bool(false, LABEL_SESSION_BOX, inline="monthly_hist", group=GROUP_MONTHLY)
monthlySessionBoxColor = input.color(color.new(color.rgb(200, 230, 201), 95), "", inline="monthly_hist", group=GROUP_MONTHLY)
monthlyShowHistogram = input.bool(true, LABEL_VALUE_AREA, inline="monthly_hist", group=GROUP_MONTHLY)
monthlyHistogramInsideColor = input.color(color.new(color.rgb(200, 230, 201), 55), LABEL_HISTOGRAM_INSIDE, inline="monthly_hist", group=GROUP_MONTHLY)
monthlyHistogramOutsideColor = input.color(color.new(color.rgb(184, 184, 184), 80), LABEL_HISTOGRAM_OUTSIDE, inline="monthly_hist", group=GROUP_MONTHLY)
monthlyValueAreaLabelColor = input.color(color.new(color.rgb(56, 142, 60), 20), LABEL_VALUE_AREA_HIGH_LOW, inline="monthly_label_colors", group=GROUP_MONTHLY)
monthlyPocLabelColor = input.color(color.new(color.rgb(123, 31, 162), 0), LABEL_POC, inline="monthly_label_colors", group=GROUP_MONTHLY)
monthlyAlternatePocLabelColor = input.color(color.new(color.rgb(194, 24, 91), 0), LABEL_ALTERNATE_POC, inline="monthly_label_colors", group=GROUP_MONTHLY)
monthlyLevelLabelMode = input.string(LABEL_MODE_BOTH, LABEL_LEVEL_LABELS, options=[LABEL_MODE_OFF, LABEL_MODE_PRICE, LABEL_MODE_DETAILS, LABEL_MODE_BOTH], inline="monthly_labels", group=GROUP_MONTHLY, tooltip=TOOLTIP_LEVEL_LABELS)
monthlyLevelLabelSize = input.string(LABEL_SIZE_SMALL, "", options=[LABEL_SIZE_TINY, LABEL_SIZE_SMALL, LABEL_SIZE_NORMAL, LABEL_SIZE_LARGE, LABEL_SIZE_HUGE], inline="monthly_labels", group=GROUP_MONTHLY)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Display
// ═══════════════════════════════════════════════════════════════════════════════
valueAreaPercent = input.float(70.0, "Value area %", minval=1.0, maxval=100.0, step=0.5, tooltip="The Value Area is the band, centered on the POC, holding this percentage of total volume. Value Area High / Low are its edges. 70% is the market-profile standard.", group=GROUP_DISPLAY)
intrabarResolution = input.string("Auto", "HD resolution (intrabar data)", options=["Auto", "1S", "5S", "15S", "1", "3", "5", "15"], tooltip="Lower timeframe pulled from inside each chart bar to build the profile and detect breaches. Smaller = more precise. 'Auto' picks a sensible sub-timeframe from the chart timeframe.", group=GROUP_DISPLAY)
levelLabelOffset = input.int(0, LABEL_LEVEL_LABEL_OFFSET, minval=0, maxval=100, tooltip="Shift the price tags this many bars to the right of the last bar, into the empty margin where the extended lines point.", group=GROUP_DISPLAY)
levelLabelBgColor = input.color(color.new(color.rgb(255, 255, 255), 10), LABEL_LEVEL_LABEL_BACKGROUND, group=GROUP_DISPLAY)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Sweep
// ═══════════════════════════════════════════════════════════════════════════════
sweepConfirmMarginPercent = input.float(5.0, LABEL_SWEEP_CONFIRM_MARGIN, minval=0.0, maxval=50.0, step=0.5, inline="sweep_global", tooltip=TOOLTIP_SWEEP_MARGIN, group=GROUP_SWEEP)
sweptGhostLineFadePercent = input.int(60, LABEL_SWEPT_GHOST_LINE_FADE, minval=0, maxval=100, inline="sweep_global", tooltip=TOOLTIP_SWEPT_GHOST_LINE_FADE, group=GROUP_SWEEP)
sweptLabelTextFadePercent = input.int(70, LABEL_SWEPT_LABEL_TEXT_FADE, minval=0, maxval=100, inline="sweep_global", tooltip=TOOLTIP_SWEPT_LABEL_TEXT_FADE, group=GROUP_SWEEP)
rthSweptKeepDays = input.int(0, LABEL_SWEPT_KEEP, minval=0, maxval=365, tooltip=TOOLTIP_SWEPT_KEEP, group=GROUP_SWEEP)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Utility
// ═══════════════════════════════════════════════════════════════════════════════
showColorTable = input.bool(false, "Color table", tooltip="Show a reference table (top-right) listing every color's RGB, transparency and line width.", group=GROUP_UTILITY)

// ═══════════════════════════════════════════════════════════════════════════════
// TYPES
// ═══════════════════════════════════════════════════════════════════════════════
type Profile
    int startTime
    int endTime
    float priceLow
    float priceHigh
    int rowCount
    array<float> rowVolumes
    int pocRow
    int valueAreaLowRow
    int valueAreaHighRow
    float pocPrice
    float valueAreaHighPrice
    float valueAreaLowPrice
    int pocBreachTime
    int valueAreaHighBreachTime
    int valueAreaLowBreachTime
    bool hasAlternatePoc
    float alternatePocPrice
    int alternatePocBreachTime
    bool isValid
    bool pocSweptAbove
    bool pocSweptBelow
    bool valueAreaHighSweptAbove
    bool valueAreaHighSweptBelow
    bool valueAreaLowSweptAbove
    bool valueAreaLowSweptBelow
    bool alternatePocSweptAbove
    bool alternatePocSweptBelow

type SessionStyle
    string extensionMode
    bool dimTouched
    float dimFraction
    bool showPoc
    color pocColor
    int pocWidth
    string pocStyle
    bool showAlternatePoc
    color alternatePocColor
    int alternatePocWidth
    string alternatePocStyle
    bool showValueArea
    color valueAreaColor
    int valueAreaWidth
    string valueAreaStyle
    bool showHistogram
    color histogramInsideColor
    color histogramOutsideColor
    bool showSessionBox
    color sessionBoxColor
    string levelLabelMode
    color levelLabelBgColor
    color valueAreaLabelColor
    color pocLabelColor
    color alternatePocLabelColor
    string levelLabelSize
    int levelLabelOffset
    bool developingEnabled
    color developingValueAreaColor
    color developingPocColor
    color developingAlternatePocColor
    float sweptGhostFraction
    int sweptKeepMs
    string labelAnchor
    bool labelMonthOnly
    string labelLive
    string labelLast

// ═══════════════════════════════════════════════════════════════════════════════
// FUNCTIONS — calculation (parameterized, reused for every anchor)
// ═══════════════════════════════════════════════════════════════════════════════

autoIntrabarTimeframe() =>
    chartSeconds = timeframe.in_seconds(timeframe.period)
    chartSeconds <= 60 ? "1S" : chartSeconds <= 15 * 60 ? "1" : chartSeconds <= 60 * 60 ? "5" : chartSeconds <= 4 * 60 * 60 ? "15" : "60"

selectedIntrabarTimeframe() =>
    intrabarResolution == "Auto" ? autoIntrabarTimeframe() : intrabarResolution

clampRow(float rawRow, int rowCount) =>
    math.max(0, math.min(rowCount - 1, int(math.floor(rawRow))))

toLabelSize(string sizeName) =>
    sizeName == LABEL_SIZE_TINY ? size.tiny : sizeName == LABEL_SIZE_NORMAL ? size.normal : sizeName == LABEL_SIZE_LARGE ? size.large : sizeName == LABEL_SIZE_HUGE ? size.huge : size.small

monthName(int monthNumber) =>
    switch monthNumber
        1 => "Jan"
        2 => "Feb"
        3 => "Mar"
        4 => "Apr"
        5 => "May"
        6 => "Jun"
        7 => "Jul"
        8 => "Aug"
        9 => "Sep"
        10 => "Oct"
        11 => "Nov"
        => "Dec"

// Whole NY-calendar days between a profile's start and the current bar (0 = today, 1 = grand daily).
toLineStyle(string styleName) =>
    styleName == STYLE_DASHED ? line.style_dashed : styleName == STYLE_DOTTED ? line.style_dotted : line.style_solid

isTrueWeekendBar(int barTime) =>
    int barDay = dayofweek(barTime, NY_TIMEZONE)
    int barHour = hour(barTime, NY_TIMEZONE)
    barDay == dayofweek.saturday or (barDay == dayofweek.sunday and barHour < SUNDAY_REOPEN_START_HOUR)

calendarDayStart(string timezone) =>
    ta.change(dayofmonth(time, timezone)) != 0

shiftedCalendarDayStart(string timezone, int timeShiftMilliseconds) =>
    ta.change(dayofmonth(time + timeShiftMilliseconds, timezone)) != 0

calendarWeekStart(string timezone) =>
    ta.change(weekofyear(time, timezone)) != 0

calendarMonthStart(string timezone) =>
    ta.change(month(time, timezone)) != 0

selectAssetCalendarStart(bool useUtcCalendar, bool utcStart, bool marketStart) =>
    useUtcCalendar ? utcStart : marketStart

isBeforeNyCutoff(int cutoffHour, int cutoffMinute) =>
    int currentMinutes = hour(time, NY_TIMEZONE) * 60 + minute(time, NY_TIMEZONE)
    int cutoffMinutes = cutoffHour * 60 + cutoffMinute
    currentMinutes < cutoffMinutes

// Append a confirmed bar's volume-by-price into the accumulator. Uses lower-tf sub-bars
// when available (HD); falls back to the chart bar so every session builds consistently.
appendBarVolume(array<float> highs, array<float> lows, array<float> volumes, array<float> intrabarHighs, array<float> intrabarLows, array<float> intrabarVolumes, float chartHigh, float chartLow, float chartVolume) =>
    int intrabarCount = array.size(intrabarVolumes)
    bool appended = false
    if intrabarCount > 0
        for intrabarIndex = 0 to intrabarCount - 1
            float subVolume = array.get(intrabarVolumes, intrabarIndex)
            float subHigh = array.get(intrabarHighs, intrabarIndex)
            float subLow = array.get(intrabarLows, intrabarIndex)
            if not na(subVolume) and subVolume > 0 and not na(subHigh) and not na(subLow)
                array.push(highs, subHigh)
                array.push(lows, subLow)
                array.push(volumes, subVolume)
                appended := true
    if not appended and not na(chartVolume) and chartVolume > 0 and not na(chartHigh) and not na(chartLow)
        array.push(highs, chartHigh)
        array.push(lows, chartLow)
        array.push(volumes, chartVolume)

// Bin one period's raw bars into rows and derive POC + value area + level prices.
buildProfile(array<float> highs, array<float> lows, array<float> volumes, int rowCount, float valueAreaPercent, int startTime, int endTime) =>
    Profile profile = Profile.new(startTime, endTime, na, na, rowCount, array.new<float>(rowCount, 0.0), 0, 0, 0, na, na, na, na, na, na, false, na, na, false, false, false, false, false, false, false, false, false)
    int barCount = array.size(volumes)
    if barCount > 0
        float rawHigh = array.max(highs)
        float rawLow = array.min(lows)
        float priceSpan = math.max(rawHigh - rawLow, syminfo.mintick * rowCount)
        float profileLow = rawHigh == rawLow ? rawLow - priceSpan * 0.5 : rawLow
        float rowHeight = priceSpan / rowCount

        for barIndex = 0 to barCount - 1
            float barHigh = array.get(highs, barIndex)
            float barLow = array.get(lows, barIndex)
            float barVolume = array.get(volumes, barIndex)
            int firstRow = clampRow((barLow - profileLow) / rowHeight, rowCount)
            int lastRow = clampRow((barHigh - profileLow) / rowHeight, rowCount)
            int rowsTouched = math.max(1, lastRow - firstRow + 1)
            float volumePerRow = barVolume / rowsTouched
            for rowIndex = firstRow to lastRow
                array.set(profile.rowVolumes, rowIndex, array.get(profile.rowVolumes, rowIndex) + volumePerRow)

        float totalVolume = 0.0
        float maxRowVolume = 0.0
        int pocRow = 0
        for rowIndex = 0 to rowCount - 1
            float rowVolume = array.get(profile.rowVolumes, rowIndex)
            totalVolume += rowVolume
            if rowVolume > maxRowVolume
                maxRowVolume := rowVolume
                pocRow := rowIndex

        int valueAreaLowRow = pocRow
        int valueAreaHighRow = pocRow
        float accumulatedVolume = array.get(profile.rowVolumes, pocRow)
        float targetVolume = totalVolume * valueAreaPercent * 0.01
        while accumulatedVolume < targetVolume and (valueAreaLowRow > 0 or valueAreaHighRow < rowCount - 1)
            float volumeBelow = valueAreaLowRow > 0 ? array.get(profile.rowVolumes, valueAreaLowRow - 1) : -1.0
            float volumeAbove = valueAreaHighRow < rowCount - 1 ? array.get(profile.rowVolumes, valueAreaHighRow + 1) : -1.0
            if volumeAbove >= volumeBelow
                valueAreaHighRow += 1
                accumulatedVolume += math.max(volumeAbove, 0)
            else
                valueAreaLowRow -= 1
                accumulatedVolume += math.max(volumeBelow, 0)

        // Nearest alternate POC (volume-only): the heaviest secondary node outside the
        // POC's own shoulder. It qualifies purely when it is nearly as heavy as the POC —
        // that near-tie is what lets a small data / resolution change move the POC onto it.
        // Distance is intentionally not considered.
        int pocShoulder = math.max(1, int(math.round(rowCount * ALTERNATE_POC_WINDOW_FRAC)))
        int alternateRow = -1
        float alternateVolume = 0.0
        for rowIndex = 0 to rowCount - 1
            if math.abs(rowIndex - pocRow) > pocShoulder
                float rowVolume = array.get(profile.rowVolumes, rowIndex)
                if rowVolume > alternateVolume
                    alternateVolume := rowVolume
                    alternateRow := rowIndex
        bool hasAlternatePoc = false
        float alternatePocPrice = na
        if alternateRow >= 0 and maxRowVolume > 0 and alternateVolume / maxRowVolume >= ALTERNATE_POC_MIN_RATIO
            hasAlternatePoc := true
            alternatePocPrice := profileLow + (alternateRow + 0.5) * rowHeight

        profile.priceLow := profileLow
        profile.priceHigh := profileLow + priceSpan
        profile.pocRow := pocRow
        profile.valueAreaLowRow := valueAreaLowRow
        profile.valueAreaHighRow := valueAreaHighRow
        profile.pocPrice := profileLow + (pocRow + 0.5) * rowHeight
        profile.valueAreaHighPrice := profileLow + (valueAreaHighRow + 1) * rowHeight
        profile.valueAreaLowPrice := profileLow + valueAreaLowRow * rowHeight
        profile.hasAlternatePoc := hasAlternatePoc
        profile.alternatePocPrice := alternatePocPrice
        profile.isValid := totalVolume > 0
    profile

// Right end + extend flag for a level line given its anchor's extension mode.
levelEndpoint(int endTime, int breachTime, string extensionMode) =>
    int rightEdge = endTime
    bool extendRight = false
    if extensionMode == LEVEL_BREACH_ANY or extensionMode == LEVEL_BREACH_SAME or extensionMode == LEVEL_BREACH_SWEEP
        if na(breachTime)
            extendRight := true
        else
            rightEdge := breachTime
    [rightEdge, extendRight]

// ═══════════════════════════════════════════════════════════════════════════════
// FUNCTIONS — rendering
// ═══════════════════════════════════════════════════════════════════════════════

var array<box> drawnBoxes = array.new<box>()
var array<line> drawnLines = array.new<line>()
var array<polyline> drawnPolylines = array.new<polyline>()
var array<label> drawnLabels = array.new<label>()

clearDrawings() =>
    if array.size(drawnBoxes) > 0
        for boxIndex = 0 to array.size(drawnBoxes) - 1
            box.delete(array.get(drawnBoxes, boxIndex))
        array.clear(drawnBoxes)
    if array.size(drawnLines) > 0
        for lineIndex = 0 to array.size(drawnLines) - 1
            line.delete(array.get(drawnLines, lineIndex))
        array.clear(drawnLines)
    if array.size(drawnPolylines) > 0
        for polylineIndex = 0 to array.size(drawnPolylines) - 1
            polyline.delete(array.get(drawnPolylines, polylineIndex))
        array.clear(drawnPolylines)
    if array.size(drawnLabels) > 0
        for labelIndex = 0 to array.size(drawnLabels) - 1
            label.delete(array.get(drawnLabels, labelIndex))
        array.clear(drawnLabels)

// Draw a level line, and — when it is still extending right (open / untouched) and labels are on —
// tag it at the right edge (last bar + offset), where the eye lands at the end of the extended line.
// The tag names the anchor in fixed compact form: live profiles read "Current D POC",
// completed profiles use a hollow marker, and older completed profiles add the date.
// sweptDenote keeps a swept level on the chart: solid up to the sweep point, then a faded dashed
// ghost extending right, with its tag preserved so the reference is not lost.
drawLevel(int startTime, int endTime, float price, color lineColor, int lineWidth, string styleName, bool extendRight, color labelColor, string levelName, SessionStyle style, bool sweptDenote, color sweptGhostColor, bool isLive, bool isLast) =>
    array.push(drawnLines, line.new(x1=startTime, y1=price, x2=endTime, y2=price, xloc=xloc.bar_time, extend=extendRight ? extend.right : extend.none, color=lineColor, width=lineWidth, style=toLineStyle(styleName)))
    if sweptDenote
        array.push(drawnLines, line.new(x1=endTime, y1=price, x2=time, y2=price, xloc=xloc.bar_time, extend=extend.right, color=sweptGhostColor, width=SWEPT_GHOST_LINE_WIDTH, style=line.style_dashed))
    if style.levelLabelMode != LABEL_MODE_OFF and (extendRight or sweptDenote)
        string priceText = str.tostring(price, format.mintick)
        string statePart = sweptDenote ? " " + BRAND_BULLET + " " + LABEL_SWEPT : ""
        string dateText = style.labelMonthOnly ? monthName(month(startTime, NY_TIMEZONE)) : monthName(month(startTime, NY_TIMEZONE)) + " " + str.tostring(dayofmonth(startTime, NY_TIMEZONE))
        string nameText = isLive ? style.labelLive + " " + levelName : isLast ? style.labelLast + " " + levelName : style.labelAnchor + " " + levelName + " " + dateText
        string detailsText = nameText + statePart
        string labelText = style.levelLabelMode == LABEL_MODE_PRICE ? priceText : style.levelLabelMode == LABEL_MODE_DETAILS ? detailsText : detailsText + " " + BRAND_BULLET + " " + priceText
        color labelTextColor = sweptDenote ? color.new(labelColor, 100 - (100 - color.t(labelColor)) * (1 - sweptLabelTextFadePercent / 100.0)) : labelColor
        array.push(drawnLabels, label.new(bar_index + style.levelLabelOffset, price, labelText, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, textcolor=labelTextColor, size=toLabelSize(style.levelLabelSize), color=style.levelLabelBgColor))

// Fade a level's colour by scaling its visible opacity. dimFraction 0.5 halves opacity;
// scaling (rather than adding transparency) keeps it well-behaved at any base transparency.
dimLevelColor(color baseColor, bool touched, bool dimTouched, float dimFraction) =>
    touched and dimTouched ? color.new(baseColor, 100 - (100 - color.t(baseColor)) * (1 - dimFraction)) : baseColor

// Trace one contiguous histogram run as a closed, filled polyline. Straight
// (non-curved) segments hug the true stepped silhouette exactly — a curved spline
// overshoots each point, ballooning the fill and bleeding adjacent runs into each
// other. The border is transparent so only the fill shows, and a whole run of rows
// collapses into a single drawing object (off the box budget).
pushHistogramPolyline(array<chart.point> points, color fillColor) =>
    if array.size(points) >= 3
        array.push(drawnPolylines, polyline.new(points, curved=false, closed=true, xloc=xloc.bar_time, line_color=color.new(fillColor, 100), fill_color=fillColor))

// Later of two breach timestamps, ignoring na so an unswept level never wins.
maxBreachTime(int a, int b) =>
    int result = na(a) ? b : na(b) ? a : int(math.max(a, b))
    result

// The profile's most recent sweep, used to decide how long its swept ghosts persist.
// na when none of the profile's levels have been swept.
profileLastBreach(Profile profile) =>
    int latest = maxBreachTime(profile.pocBreachTime, profile.valueAreaHighBreachTime)
    latest := maxBreachTime(latest, profile.valueAreaLowBreachTime)
    latest := profile.hasAlternatePoc ? maxBreachTime(latest, profile.alternatePocBreachTime) : latest
    latest

renderProfile(Profile profile, SessionStyle style, bool developingProfileActive, bool isMostRecentCompleted, bool isLive) =>
    if profile.isValid
        float priceRange = profile.priceHigh - profile.priceLow
        bool useDevelopingColors = developingProfileActive and style.developingEnabled

        // Histogram is traced at full calculation-row resolution as closed filled
        // polylines (one per contiguous inside / outside value-area run). A light
        // moving-average smooths the per-row volume so the silhouette reads as a clean
        // curve. The whole profile is a couple of polyline objects, off the box budget.
        if style.showHistogram
            int rowCount = profile.rowCount
            int halfWindow = int(math.floor(HISTOGRAM_SMOOTHING / 2))
            array<float> smoothedVolumes = array.new<float>(rowCount, 0.0)
            float maxSmoothedVolume = 0.0
            for rowIndex = 0 to rowCount - 1
                float windowSum = 0.0
                int windowCount = 0
                for offset = -halfWindow to halfWindow
                    int neighborRow = rowIndex + offset
                    if neighborRow >= 0 and neighborRow < rowCount
                        windowSum += array.get(profile.rowVolumes, neighborRow)
                        windowCount += 1
                float smoothedVolume = windowCount > 0 ? windowSum / windowCount : 0.0
                array.set(smoothedVolumes, rowIndex, smoothedVolume)
                maxSmoothedVolume := math.max(maxSmoothedVolume, smoothedVolume)
            if maxSmoothedVolume > 0
                float rowHeight = priceRange / rowCount
                int baselineTime = profile.startTime
                int profileMilliseconds = math.max(1, profile.endTime - profile.startTime)
                int histogramWidthMilliseconds = math.max(1, int(math.round(profileMilliseconds * HISTOGRAM_WIDTH_PERCENT * 0.01)))
                array<chart.point> points = array.new<chart.point>()
                bool runStarted = false
                bool runInsideVa = false
                for rowIndex = 0 to rowCount - 1
                    bool insideVa = rowIndex >= profile.valueAreaLowRow and rowIndex <= profile.valueAreaHighRow
                    float rowBottom = profile.priceLow + rowIndex * rowHeight
                    float rowVolume = array.get(smoothedVolumes, rowIndex)
                    int widthMilliseconds = int(math.round(rowVolume / maxSmoothedVolume * histogramWidthMilliseconds))
                    int outerTime = baselineTime + widthMilliseconds
                    // Value-area membership flipped: close the current run on the baseline and start a new one at the same boundary.
                    if runStarted and insideVa != runInsideVa
                        array.push(points, chart.point.from_time(baselineTime, rowBottom))
                        pushHistogramPolyline(points, runInsideVa ? style.histogramInsideColor : style.histogramOutsideColor)
                        points := array.new<chart.point>()
                        runStarted := false
                    if not runStarted
                        runStarted := true
                        runInsideVa := insideVa
                        array.push(points, chart.point.from_time(baselineTime, rowBottom))
                    array.push(points, chart.point.from_time(outerTime, rowBottom + rowHeight / 2))
                    if rowIndex == rowCount - 1
                        array.push(points, chart.point.from_time(baselineTime, rowBottom + rowHeight))
                        pushHistogramPolyline(points, runInsideVa ? style.histogramInsideColor : style.histogramOutsideColor)

        if style.showSessionBox
            array.push(drawnBoxes, box.new(left=profile.startTime, top=profile.priceHigh, right=profile.endTime, bottom=profile.priceLow, xloc=xloc.bar_time, border_width=0, bgcolor=style.sessionBoxColor))

        // Levels keep their chosen styling; touched (mitigated) levels are optionally
        // faded so the untouched, still-active ones stand out.
        // A swept level stays denoted (solid up to the sweep, faded dashed ghost after) instead of
        // disappearing. The most recent completed profile is always kept; older profiles are kept too
        // while their most recent sweep is within the Keep Swept window, since price often revisits a
        // recently swept level. The label still reads "Yesterday's" only for the true most recent.
        bool sweepMode = style.extensionMode == LEVEL_BREACH_SWEEP
        int lastBreach = profileLastBreach(profile)
        bool withinKeepWindow = style.sweptKeepMs > 0 and not na(lastBreach) and time - lastBreach <= style.sweptKeepMs
        bool profileDenote = sweepMode and (isMostRecentCompleted or withinKeepWindow)
        if style.showPoc
            [pocRight, pocExtend] = levelEndpoint(profile.endTime, profile.pocBreachTime, style.extensionMode)
            color pocBaseColor = useDevelopingColors ? style.developingPocColor : style.pocColor
            bool pocSweptDenote = profileDenote and not na(profile.pocBreachTime)
            color pocColor = pocSweptDenote ? pocBaseColor : dimLevelColor(pocBaseColor, not na(profile.pocBreachTime), style.dimTouched, style.dimFraction)
            color pocGhost = dimLevelColor(pocBaseColor, true, true, style.sweptGhostFraction)
            drawLevel(profile.startTime, pocRight, profile.pocPrice, pocColor, style.pocWidth, style.pocStyle, pocExtend, style.pocLabelColor, LABEL_POC, style, pocSweptDenote, pocGhost, isLive, isMostRecentCompleted)
        if style.showAlternatePoc and profile.hasAlternatePoc
            [alternateRight, alternateExtend] = levelEndpoint(profile.endTime, profile.alternatePocBreachTime, style.extensionMode)
            color alternateBaseColor = useDevelopingColors ? style.developingAlternatePocColor : style.alternatePocColor
            bool alternateSweptDenote = profileDenote and not na(profile.alternatePocBreachTime)
            color alternateColor = alternateSweptDenote ? alternateBaseColor : dimLevelColor(alternateBaseColor, not na(profile.alternatePocBreachTime), style.dimTouched, style.dimFraction)
            color alternateGhost = dimLevelColor(alternateBaseColor, true, true, style.sweptGhostFraction)
            drawLevel(profile.startTime, alternateRight, profile.alternatePocPrice, alternateColor, style.alternatePocWidth, style.alternatePocStyle, alternateExtend, style.alternatePocLabelColor, LABEL_ALTERNATE_POC, style, alternateSweptDenote, alternateGhost, isLive, isMostRecentCompleted)
        if style.showValueArea
            [valueAreaHighRight, valueAreaHighExtend] = levelEndpoint(profile.endTime, profile.valueAreaHighBreachTime, style.extensionMode)
            color valueAreaBaseColor = useDevelopingColors ? style.developingValueAreaColor : style.valueAreaColor
            bool vahSweptDenote = profileDenote and not na(profile.valueAreaHighBreachTime)
            color vahColor = vahSweptDenote ? valueAreaBaseColor : dimLevelColor(valueAreaBaseColor, not na(profile.valueAreaHighBreachTime), style.dimTouched, style.dimFraction)
            color vahGhost = dimLevelColor(valueAreaBaseColor, true, true, style.sweptGhostFraction)
            drawLevel(profile.startTime, valueAreaHighRight, profile.valueAreaHighPrice, vahColor, style.valueAreaWidth, style.valueAreaStyle, valueAreaHighExtend, style.valueAreaLabelColor, LABEL_VAH, style, vahSweptDenote, vahGhost, isLive, isMostRecentCompleted)
            [valueAreaLowRight, valueAreaLowExtend] = levelEndpoint(profile.endTime, profile.valueAreaLowBreachTime, style.extensionMode)
            bool valSweptDenote = profileDenote and not na(profile.valueAreaLowBreachTime)
            color valColor = valSweptDenote ? valueAreaBaseColor : dimLevelColor(valueAreaBaseColor, not na(profile.valueAreaLowBreachTime), style.dimTouched, style.dimFraction)
            color valGhost = dimLevelColor(valueAreaBaseColor, true, true, style.sweptGhostFraction)
            drawLevel(profile.startTime, valueAreaLowRight, profile.valueAreaLowPrice, valColor, style.valueAreaWidth, style.valueAreaStyle, valueAreaLowExtend, style.valueAreaLabelColor, LABEL_VAL, style, valSweptDenote, valGhost, isLive, isMostRecentCompleted)

// ═══════════════════════════════════════════════════════════════════════════════
// FUNCTIONS — anchor engine
// ═══════════════════════════════════════════════════════════════════════════════

// Finalize one accumulated period into a Profile and commit it to the ring. A period whose bar-span
// is an outlier-short fraction of the longest period seen (an early close / holiday half-day) folds
// into the current merge base, up to mergeDepth consecutive shorts. The base differs by mode:
// "into previous" uses the prior full session as the base; "combine shorts" uses the first short of a
// run as the base (full sessions stay standalone and reset the base). "Normal" span is self-calibrated
// from the longest period seen, so no session length is hardcoded. The base period's raw bars stay in
// the pending buffer so they can be recombined.
finalizePeriod(array<float> barHighs, array<float> barLows, array<float> barVolumes, int startTime, int endTime, int lastBarTime, int keepProfiles, array<Profile> profiles, int mergeDepth, bool combineShorts, array<int> normalSpanRef, array<float> pendingHighs, array<float> pendingLows, array<float> pendingVolumes, array<int> pendingStartRef, array<int> foldCountRef) =>
    if array.size(barVolumes) > 0
        int periodSpan = lastBarTime - startTime
        int normalSpan = array.get(normalSpanRef, 0)
        bool isShortPeriod = mergeDepth > 0 and normalSpan > 0 and periodSpan < int(normalSpan * HOLIDAY_MERGE_SPAN_FRACTION)
        bool canMerge = isShortPeriod and array.get(foldCountRef, 0) < mergeDepth and array.size(pendingVolumes) > 0 and array.size(profiles) > 0
        if canMerge
            array.concat(pendingHighs, barHighs)
            array.concat(pendingLows, barLows)
            array.concat(pendingVolumes, barVolumes)
            Profile merged = buildProfile(pendingHighs, pendingLows, pendingVolumes, PROFILE_ROWS, valueAreaPercent, array.get(pendingStartRef, 0), endTime)
            if merged.isValid
                array.pop(profiles)
                array.push(profiles, merged)
                while array.size(profiles) > keepProfiles
                    array.shift(profiles)
            array.set(foldCountRef, 0, array.get(foldCountRef, 0) + 1)
        else
            Profile profile = buildProfile(barHighs, barLows, barVolumes, PROFILE_ROWS, valueAreaPercent, startTime, endTime)
            if profile.isValid
                array.push(profiles, profile)
                while array.size(profiles) > keepProfiles
                    array.shift(profiles)
                // Calibrate the normal (full) session span from non-merged periods. Drives short-period
                // detection. Short periods never exceed normalSpan, so they never inflate it.
                if periodSpan > normalSpan
                    array.set(normalSpanRef, 0, periodSpan)
                if mergeDepth > 0
                    // Establish the base that following shorts fold into. "Combine": the first short of
                    // a run is the base (seeded with one fold). "Into previous": a full session is the
                    // base. A full session in combine mode clears the base so the next short starts fresh.
                    bool becomesBase = combineShorts ? isShortPeriod : not isShortPeriod
                    if becomesBase
                        array.clear(pendingHighs)
                        array.clear(pendingLows)
                        array.clear(pendingVolumes)
                        array.concat(pendingHighs, barHighs)
                        array.concat(pendingLows, barLows)
                        array.concat(pendingVolumes, barVolumes)
                        array.set(pendingStartRef, 0, startTime)
                        array.set(foldCountRef, 0, combineShorts ? 1 : 0)
                    else if combineShorts and not isShortPeriod
                        array.clear(pendingHighs)
                        array.clear(pendingLows)
                        array.clear(pendingVolumes)
                        array.set(foldCountRef, 0, 0)
        array.clear(barHighs)
        array.clear(barLows)
        array.clear(barVolumes)

// Accumulate confirmed bars per anchor, finalize finished periods into a ring.
processSession(bool enabled, int keepProfiles, bool inWindow, bool periodStart, bool periodEnd, array<float> barHighs, array<float> barLows, array<float> barVolumes, array<Profile> profiles, array<int> periodStartRef, array<float> intrabarHighs, array<float> intrabarLows, array<float> intrabarVolumes, int mergeDepth, bool combineShorts, array<int> normalSpanRef, array<float> pendingHighs, array<float> pendingLows, array<float> pendingVolumes, array<int> pendingStartRef, array<int> periodLastBarRef, array<int> foldCountRef, bool continuousBoundary) =>
    if enabled
        bool shouldStart = periodStart or (array.get(periodStartRef, 0) == START_TIME_UNSET and inWindow)

        if periodEnd and array.size(barVolumes) > 0
            // End the profile at its actual last traded bar, not the bar where RTH is first detected
            // out of session. On early-close / holiday days there is a data gap after the session, so
            // that out-of-session bar is hours or days later and would balloon the box and histogram.
            finalizePeriod(barHighs, barLows, barVolumes, array.get(periodStartRef, 0), array.get(periodLastBarRef, 0), array.get(periodLastBarRef, 0), keepProfiles, profiles, mergeDepth, combineShorts, normalSpanRef, pendingHighs, pendingLows, pendingVolumes, pendingStartRef, foldCountRef)

        if shouldStart
            if array.size(barVolumes) > 0
                // Continuous anchors have no session gap, so end the finishing profile at the new
                // period's boundary bar (time) to tile edge-to-edge. RTH keeps time[1] (its real
                // finalize happens on the session-end path above; this is only a fallback).
                int boundaryEnd = continuousBoundary ? time : time[1]
                finalizePeriod(barHighs, barLows, barVolumes, array.get(periodStartRef, 0), boundaryEnd, array.get(periodLastBarRef, 0), keepProfiles, profiles, mergeDepth, combineShorts, normalSpanRef, pendingHighs, pendingLows, pendingVolumes, pendingStartRef, foldCountRef)
            array.set(periodStartRef, 0, time)

        if inWindow and barstate.isconfirmed
            appendBarVolume(barHighs, barLows, barVolumes, intrabarHighs, intrabarLows, intrabarVolumes, high, low, volume)
            array.set(periodLastBarRef, 0, time)

// Stamp the breach time of each level once price (lower-tf high/low) trades through it.
updateMitigation(array<Profile> profiles, bool active, bool sameSessionOnly, bool inWindowNow, array<float> intrabarHighs, array<float> intrabarLows) =>
    if active and array.size(profiles) > 0 and not (sameSessionOnly and not inWindowNow)
        float breachHigh = array.size(intrabarHighs) > 0 ? array.max(intrabarHighs) : high
        float breachLow = array.size(intrabarLows) > 0 ? array.min(intrabarLows) : low
        if not na(breachHigh) and not na(breachLow)
            for profileIndex = 0 to array.size(profiles) - 1
                Profile profile = array.get(profiles, profileIndex)
                if time > profile.endTime
                    if na(profile.pocBreachTime) and breachLow < profile.pocPrice and breachHigh > profile.pocPrice
                        profile.pocBreachTime := time
                    if na(profile.valueAreaHighBreachTime) and breachLow < profile.valueAreaHighPrice and breachHigh > profile.valueAreaHighPrice
                        profile.valueAreaHighBreachTime := time
                    if na(profile.valueAreaLowBreachTime) and breachLow < profile.valueAreaLowPrice and breachHigh > profile.valueAreaLowPrice
                        profile.valueAreaLowBreachTime := time
                    if profile.hasAlternatePoc and na(profile.alternatePocBreachTime) and breachLow < profile.alternatePocPrice and breachHigh > profile.alternatePocPrice
                        profile.alternatePocBreachTime := time

// Advance one level's two-sided sweep state from the latest close. A side is "reached" once price
// closes beyond the level by the margin; returns the updated side flags and, once both sides have
// been reached, the completion time (the level is now swept). Centralizes the comparison so the
// four levels never duplicate it.
sweepStep(bool reachedAbove, bool reachedBelow, float level, float margin) =>
    bool above = reachedAbove or close >= level + margin
    bool below = reachedBelow or close <= level - margin
    int sweptTime = above and below ? time : na
    [above, below, sweptTime]

// "Until Swept" mitigation: a prior RTH level stays live until price has cleanly closed beyond it
// on both sides, then its breach time is stamped at that completion bar so it stops and fades like
// any mitigated level. Tracked across every confirmed bar since a sweep can span days.
updateSweep(array<Profile> profiles, bool active, float marginFraction) =>
    if active and array.size(profiles) > 0
        for profileIndex = 0 to array.size(profiles) - 1
            Profile profile = array.get(profiles, profileIndex)
            if time > profile.endTime
                float margin = (profile.priceHigh - profile.priceLow) * marginFraction
                if na(profile.pocBreachTime)
                    [pocAbove, pocBelow, pocSwept] = sweepStep(profile.pocSweptAbove, profile.pocSweptBelow, profile.pocPrice, margin)
                    profile.pocSweptAbove := pocAbove
                    profile.pocSweptBelow := pocBelow
                    if not na(pocSwept)
                        profile.pocBreachTime := pocSwept
                if na(profile.valueAreaHighBreachTime)
                    [vahAbove, vahBelow, vahSwept] = sweepStep(profile.valueAreaHighSweptAbove, profile.valueAreaHighSweptBelow, profile.valueAreaHighPrice, margin)
                    profile.valueAreaHighSweptAbove := vahAbove
                    profile.valueAreaHighSweptBelow := vahBelow
                    if not na(vahSwept)
                        profile.valueAreaHighBreachTime := vahSwept
                if na(profile.valueAreaLowBreachTime)
                    [valAbove, valBelow, valSwept] = sweepStep(profile.valueAreaLowSweptAbove, profile.valueAreaLowSweptBelow, profile.valueAreaLowPrice, margin)
                    profile.valueAreaLowSweptAbove := valAbove
                    profile.valueAreaLowSweptBelow := valBelow
                    if not na(valSwept)
                        profile.valueAreaLowBreachTime := valSwept
                if profile.hasAlternatePoc and na(profile.alternatePocBreachTime)
                    [apocAbove, apocBelow, apocSwept] = sweepStep(profile.alternatePocSweptAbove, profile.alternatePocSweptBelow, profile.alternatePocPrice, margin)
                    profile.alternatePocSweptAbove := apocAbove
                    profile.alternatePocSweptBelow := apocBelow
                    if not na(apocSwept)
                        profile.alternatePocBreachTime := apocSwept

renderSession(bool enabled, array<Profile> profiles, array<float> barHighs, array<float> barLows, array<float> barVolumes, array<int> periodStartRef, SessionStyle style, bool developingProfileActive, bool showDeveloping) =>
    if enabled
        int profileCount = array.size(profiles)
        if profileCount > 0
            for profileIndex = 0 to profileCount - 1
                renderProfile(array.get(profiles, profileIndex), style, false, profileIndex == profileCount - 1, false)
        if showDeveloping and array.size(barVolumes) > 0
            Profile liveProfile = buildProfile(barHighs, barLows, barVolumes, PROFILE_ROWS, valueAreaPercent, array.get(periodStartRef, 0), time)
            renderProfile(liveProfile, style, developingProfileActive, false, true)

// ═══════════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE
// ═══════════════════════════════════════════════════════════════════════════════
addColorRow(table colorTable, int row, string name, color swatchColor, string widthText) =>
    table.cell(colorTable, 0, row, name, text_size=size.small, text_color=color.rgb(0, 0, 0))
    table.cell(colorTable, 1, row, str.format("R:{0} G:{1} B:{2}", int(color.r(swatchColor)), int(color.g(swatchColor)), int(color.b(swatchColor))), text_size=size.small, text_color=color.rgb(0, 0, 0))
    table.cell(colorTable, 2, row, str.tostring(int(color.t(swatchColor))), text_size=size.small, text_color=color.rgb(0, 0, 0))
    table.cell(colorTable, 3, row, widthText, text_size=size.small, text_color=color.rgb(0, 0, 0))

colorRowsForSession(bool enabled, SessionStyle style) =>
    int rows = 0
    if enabled
        if style.showValueArea
            rows += 1
        if style.showPoc
            rows += 1
        if style.showAlternatePoc
            rows += 1
        if style.showHistogram
            rows += 2
        if style.showSessionBox
            rows += 1
        if style.levelLabelMode != LABEL_MODE_OFF
            if style.showValueArea
                rows += 1
            if style.showPoc
                rows += 1
            if style.showAlternatePoc
                rows += 1
        if style.developingEnabled
            rows += 3
    rows

addSessionColorRows(table colorTable, int row, string sessionName, bool enabled, SessionStyle style) =>
    int nextRow = row
    if enabled
        if style.showValueArea
            addColorRow(colorTable, nextRow, sessionName + " " + LABEL_VALUE_AREA_HIGH_LOW, style.valueAreaColor, str.tostring(style.valueAreaWidth))
            nextRow += 1
        if style.showPoc
            addColorRow(colorTable, nextRow, sessionName + " " + LABEL_POC, style.pocColor, str.tostring(style.pocWidth))
            nextRow += 1
        if style.showAlternatePoc
            addColorRow(colorTable, nextRow, sessionName + " " + LABEL_ALTERNATE_POC, style.alternatePocColor, str.tostring(style.alternatePocWidth))
            nextRow += 1
        if style.showHistogram
            addColorRow(colorTable, nextRow, sessionName + " " + LABEL_VALUE_AREA + " " + LABEL_HISTOGRAM_INSIDE, style.histogramInsideColor, "")
            nextRow += 1
            addColorRow(colorTable, nextRow, sessionName + " " + LABEL_VALUE_AREA + " " + LABEL_HISTOGRAM_OUTSIDE, style.histogramOutsideColor, "")
            nextRow += 1
        if style.showSessionBox
            addColorRow(colorTable, nextRow, sessionName + " " + LABEL_SESSION_BOX, style.sessionBoxColor, "")
            nextRow += 1
        if style.levelLabelMode != LABEL_MODE_OFF
            if style.showValueArea
                addColorRow(colorTable, nextRow, sessionName + " " + LABEL_LEVEL_LABELS + " " + LABEL_VALUE_AREA_HIGH_LOW, style.valueAreaLabelColor, "")
                nextRow += 1
            if style.showPoc
                addColorRow(colorTable, nextRow, sessionName + " " + LABEL_LEVEL_LABELS + " " + LABEL_POC, style.pocLabelColor, "")
                nextRow += 1
            if style.showAlternatePoc
                addColorRow(colorTable, nextRow, sessionName + " " + LABEL_LEVEL_LABELS + " " + LABEL_ALTERNATE_POC, style.alternatePocLabelColor, "")
                nextRow += 1
        if style.developingEnabled
            addColorRow(colorTable, nextRow, sessionName + " Developing " + LABEL_VALUE_AREA_HIGH_LOW, style.developingValueAreaColor, "")
            nextRow += 1
            addColorRow(colorTable, nextRow, sessionName + " Developing " + LABEL_POC, style.developingPocColor, "")
            nextRow += 1
            addColorRow(colorTable, nextRow, sessionName + " Developing " + LABEL_ALTERNATE_POC, style.developingAlternatePocColor, "")
            nextRow += 1
    nextRow

// ═══════════════════════════════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════════════════════════════
var table colorTable = na

var array<float> rthBarHighs = array.new<float>()
var array<float> rthBarLows = array.new<float>()
var array<float> rthBarVolumes = array.new<float>()
var array<Profile> rthProfiles = array.new<Profile>()
var array<int> rthStartRef = array.new<int>(1, START_TIME_UNSET)
var array<float> rthPendingHighs = array.new<float>()
var array<float> rthPendingLows = array.new<float>()
var array<float> rthPendingVolumes = array.new<float>()
var array<int> rthPendingStartRef = array.new<int>(1, START_TIME_UNSET)
var array<int> rthLastBarRef = array.new<int>(1, START_TIME_UNSET)
var array<int> rthNormalSpanRef = array.new<int>(1, 0)
var array<int> rthFoldCountRef = array.new<int>(1, 0)

// Merge and the last-bar end-time correction are RTH-only for now; the continuous anchors pass
// these inert buffers. Their merge flag is false, so the pending arrays stay untouched, and the
// span / last-bar refs are written but never read (no merge, no session-gap end-time to correct).
var array<float> mergeUnusedHighs = array.new<float>()
var array<float> mergeUnusedLows = array.new<float>()
var array<float> mergeUnusedVolumes = array.new<float>()
var array<int> mergeUnusedStartRef = array.new<int>(1, START_TIME_UNSET)
var array<int> mergeUnusedLastBarRef = array.new<int>(1, START_TIME_UNSET)
var array<int> mergeUnusedNormalSpanRef = array.new<int>(1, 0)
var array<int> mergeUnusedFoldCountRef = array.new<int>(1, 0)

var array<float> weeklyBarHighs = array.new<float>()
var array<float> weeklyBarLows = array.new<float>()
var array<float> weeklyBarVolumes = array.new<float>()
var array<Profile> weeklyProfiles = array.new<Profile>()
var array<int> weeklyStartRef = array.new<int>(1, START_TIME_UNSET)

var array<float> globexBarHighs = array.new<float>()
var array<float> globexBarLows = array.new<float>()
var array<float> globexBarVolumes = array.new<float>()
var array<Profile> globexProfiles = array.new<Profile>()
var array<int> globexStartRef = array.new<int>(1, START_TIME_UNSET)

var array<float> monthlyBarHighs = array.new<float>()
var array<float> monthlyBarLows = array.new<float>()
var array<float> monthlyBarVolumes = array.new<float>()
var array<Profile> monthlyProfiles = array.new<Profile>()
var array<int> monthlyStartRef = array.new<int>(1, START_TIME_UNSET)

var bool isTwentyFourSevenAsset = false
var bool assetClassificationReady = false

// ═══════════════════════════════════════════════════════════════════════════════
// STYLES
// ═══════════════════════════════════════════════════════════════════════════════
rthStyle = SessionStyle.new(rthExtensionMode, rthDimTouched, rthDimPercent / 100.0, rthShowPoc, rthPocColor, int(str.tonumber(rthPocWidth)), rthPocStyle, rthShowAlternatePoc, rthAlternatePocColor, int(str.tonumber(rthAlternatePocWidth)), rthAlternatePocStyle, rthShowValueArea, rthValueAreaColor, int(str.tonumber(rthValueAreaWidth)), rthValueAreaStyle, rthShowHistogram, rthHistogramInsideColor, rthHistogramOutsideColor, rthShowSessionBox, rthSessionBoxColor, rthLevelLabelMode, levelLabelBgColor, rthValueAreaLabelColor, rthPocLabelColor, rthAlternatePocLabelColor, rthLevelLabelSize, levelLabelOffset, rthDevelopingEnabled, rthDevelopingValueAreaColor, rthDevelopingPocColor, rthDevelopingAlternatePocColor, sweptGhostLineFadePercent / 100.0, rthSweptKeepDays * MS_PER_DAY, LABEL_RTH_ANCHOR, false, LABEL_RTH_LIVE, LABEL_RTH_LAST)
weeklyStyle = SessionStyle.new(weeklyExtensionMode, weeklyDimTouched, weeklyDimPercent / 100.0, weeklyShowPoc, weeklyPocColor, int(str.tonumber(weeklyPocWidth)), weeklyPocStyle, weeklyShowAlternatePoc, weeklyAlternatePocColor, int(str.tonumber(weeklyAlternatePocWidth)), weeklyAlternatePocStyle, weeklyShowValueArea, weeklyValueAreaColor, int(str.tonumber(weeklyValueAreaWidth)), weeklyValueAreaStyle, weeklyShowHistogram, weeklyHistogramInsideColor, weeklyHistogramOutsideColor, weeklyShowSessionBox, weeklySessionBoxColor, weeklyLevelLabelMode, levelLabelBgColor, weeklyValueAreaLabelColor, weeklyPocLabelColor, weeklyAlternatePocLabelColor, weeklyLevelLabelSize, levelLabelOffset, false, weeklyValueAreaColor, weeklyPocColor, weeklyAlternatePocColor, sweptGhostLineFadePercent / 100.0, 0, LABEL_WEEKLY_ANCHOR, false, LABEL_WEEKLY_LIVE, LABEL_WEEKLY_LAST)
globexStyle = SessionStyle.new(globexExtensionMode, globexDimTouched, globexDimPercent / 100.0, globexShowPoc, globexPocColor, int(str.tonumber(globexPocWidth)), globexPocStyle, globexShowAlternatePoc, globexAlternatePocColor, int(str.tonumber(globexAlternatePocWidth)), globexAlternatePocStyle, globexShowValueArea, globexValueAreaColor, int(str.tonumber(globexValueAreaWidth)), globexValueAreaStyle, globexShowHistogram, globexHistogramInsideColor, globexHistogramOutsideColor, globexShowSessionBox, globexSessionBoxColor, globexLevelLabelMode, levelLabelBgColor, globexValueAreaLabelColor, globexPocLabelColor, globexAlternatePocLabelColor, globexLevelLabelSize, levelLabelOffset, false, globexValueAreaColor, globexPocColor, globexAlternatePocColor, sweptGhostLineFadePercent / 100.0, 0, LABEL_GLOBEX_ANCHOR, false, LABEL_GLOBEX_LIVE, LABEL_GLOBEX_LAST)
monthlyStyle = SessionStyle.new(monthlyExtensionMode, monthlyDimTouched, monthlyDimPercent / 100.0, monthlyShowPoc, monthlyPocColor, int(str.tonumber(monthlyPocWidth)), monthlyPocStyle, monthlyShowAlternatePoc, monthlyAlternatePocColor, int(str.tonumber(monthlyAlternatePocWidth)), monthlyAlternatePocStyle, monthlyShowValueArea, monthlyValueAreaColor, int(str.tonumber(monthlyValueAreaWidth)), monthlyValueAreaStyle, monthlyShowHistogram, monthlyHistogramInsideColor, monthlyHistogramOutsideColor, monthlyShowSessionBox, monthlySessionBoxColor, monthlyLevelLabelMode, levelLabelBgColor, monthlyValueAreaLabelColor, monthlyPocLabelColor, monthlyAlternatePocLabelColor, monthlyLevelLabelSize, levelLabelOffset, false, monthlyValueAreaColor, monthlyPocColor, monthlyAlternatePocColor, sweptGhostLineFadePercent / 100.0, 0, LABEL_MONTHLY_ANCHOR, true, LABEL_MONTHLY_LIVE, LABEL_MONTHLY_LAST)

// ═══════════════════════════════════════════════════════════════════════════════
// QUICK FILTER
// ═══════════════════════════════════════════════════════════════════════════════
// Landscape caps RTH + Weekly at the last 2 completed profiles and hides their developing profile
// unless its include toggle is on; the Only modes reuse each anchor's own Show Last and settings.
isCustom      = quickFilter == FILTER_CUSTOM
isAll         = quickFilter == FILTER_ALL
isLandscape   = quickFilter == FILTER_LANDSCAPE
isRthOnly     = quickFilter == FILTER_RTH_ONLY
isWeeklyOnly  = quickFilter == FILTER_WEEKLY_ONLY
isMonthlyOnly = quickFilter == FILTER_MONTHLY_ONLY

rthFilterEnabled     = isAll or isLandscape or isRthOnly or (isCustom and rthEnabled)
weeklyFilterEnabled  = isAll or isLandscape or isWeeklyOnly or (isCustom and weeklyEnabled)
globexFilterEnabled  = isAll or (isCustom and globexEnabled)
monthlyFilterEnabled = isAll or isMonthlyOnly or (isCustom and monthlyEnabled)

rthEffectiveProfiles    = isLandscape ? LANDSCAPE_PROFILE_COUNT : rthProfilesToShow
weeklyEffectiveProfiles = isLandscape ? LANDSCAPE_PROFILE_COUNT : weeklyProfilesToShow

rthShowDeveloping    = isLandscape ? landscapeIncludeDevelopingRth    : true
weeklyShowDeveloping = isLandscape ? landscapeIncludeDevelopingWeekly : true

// ═══════════════════════════════════════════════════════════════════════════════
// DATA & BOUNDARIES
// ═══════════════════════════════════════════════════════════════════════════════
intrabarTimeframe = selectedIntrabarTimeframe()
[intrabarHighs, intrabarLows, intrabarVolumes] = request.security_lower_tf(syminfo.tickerid, intrabarTimeframe, [high, low, volume], ignore_invalid_timeframe=true)

// Classify 24/7 assets by watching for true weekend bars incrementally. Traditional futures
// may print from Sunday 18:00 NY onward, so only Saturday and early-Sunday bars prove 24/7
// trading. Each bar is an O(1) check; if a full week elapses with no weekend bar, the asset
// is session-based. No backward scan, and the result is only marked ready once it is real.
if not assetClassificationReady
    if syminfo.type == "crypto"
        isTwentyFourSevenAsset := true
        assetClassificationReady := true
    else if isTrueWeekendBar(time)
        isTwentyFourSevenAsset := true
        assetClassificationReady := true
    else
        int barsInWeek = math.max(1, int(math.ceil(SECONDS_PER_WEEK / timeframe.in_seconds(timeframe.period))))
        int observationWindow = math.min(ASSET_DETECTION_MAX_LOOKBACK, barsInWeek)
        if bar_index >= observationWindow
            isTwentyFourSevenAsset := false
            assetClassificationReady := true

// RTH uses the NYSE cash window. Session-based assets keep the Mon-Fri mask; 24/7 assets apply
// the same 09:30-16:00 NY window every day so weekends also build an RTH profile. Both windows are
// const strings (time() requires that); the boolean is selected by the asset classification.
rthInSessionWeekday = not na(time(timeframe.period, RTH_SESSION, NY_TIMEZONE))
rthInSessionAllDays = not na(time(timeframe.period, RTH_SESSION_ALL_DAYS, NY_TIMEZONE))
rthInSession = isTwentyFourSevenAsset ? rthInSessionAllDays : rthInSessionWeekday
rthSessionStart = rthInSession and not rthInSession[1]
rthSessionEnd = not rthInSession and rthInSession[1]

// Globex, Weekly and Monthly are continuous anchors, so they have no session gap
// to detect an "entry" from. Futures-style symbols keep the NY trading-day anchors;
// crypto / 24/7 assets use UTC calendar boundaries for new-day, weekly and monthly
// profiles.
SIX_HOURS_MS = 6 * 60 * 60 * 1000
useUtcCalendarAnchors = isTwentyFourSevenAsset
utcDayStart = calendarDayStart(UTC_TIMEZONE)
futuresGlobexStart = shiftedCalendarDayStart(NY_TIMEZONE, SIX_HOURS_MS)
globexDayStart = selectAssetCalendarStart(useUtcCalendarAnchors, utcDayStart, futuresGlobexStart)
utcWeekStart = calendarWeekStart(UTC_TIMEZONE)
weeklyReopenInSession = not na(time(timeframe.period, WEEKLY_REOPEN_SESSION, NY_TIMEZONE))
futuresWeekStart = weeklyReopenInSession and not weeklyReopenInSession[1] and dayofweek(time, NY_TIMEZONE) == dayofweek.sunday
weeklyPeriodStart = selectAssetCalendarStart(useUtcCalendarAnchors, utcWeekStart, futuresWeekStart)
utcMonthStart = calendarMonthStart(UTC_TIMEZONE)
nyMonthStart = calendarMonthStart(NY_TIMEZONE)
monthlyPeriodStart = selectAssetCalendarStart(useUtcCalendarAnchors, utcMonthStart, nyMonthStart)

// ═══════════════════════════════════════════════════════════════════════════════
// PROCESS
// ═══════════════════════════════════════════════════════════════════════════════
// Map the RTH merge mode to its two engine controls: fold depth (consecutive shorts) and whether
// shorts combine with each other (vs folding into the prior full session). "Fold All" uses depth 2,
// which covers every real CME holiday cluster.
rthMergeCombine = rthMergeMode == MERGE_COMBINE
rthMergeDepth = rthMergeMode == MERGE_OFF ? 0 : rthMergeMode == MERGE_EARLIEST ? 1 : 2

processSession(rthFilterEnabled, rthEffectiveProfiles, rthInSession, rthSessionStart, rthSessionEnd, rthBarHighs, rthBarLows, rthBarVolumes, rthProfiles, rthStartRef, intrabarHighs, intrabarLows, intrabarVolumes, rthMergeDepth, rthMergeCombine, rthNormalSpanRef, rthPendingHighs, rthPendingLows, rthPendingVolumes, rthPendingStartRef, rthLastBarRef, rthFoldCountRef, false)
processSession(weeklyFilterEnabled, weeklyEffectiveProfiles, true, weeklyPeriodStart, false, weeklyBarHighs, weeklyBarLows, weeklyBarVolumes, weeklyProfiles, weeklyStartRef, intrabarHighs, intrabarLows, intrabarVolumes, 0, false, mergeUnusedNormalSpanRef, mergeUnusedHighs, mergeUnusedLows, mergeUnusedVolumes, mergeUnusedStartRef, mergeUnusedLastBarRef, mergeUnusedFoldCountRef, true)
processSession(globexFilterEnabled, globexProfilesToShow, true, globexDayStart, false, globexBarHighs, globexBarLows, globexBarVolumes, globexProfiles, globexStartRef, intrabarHighs, intrabarLows, intrabarVolumes, 0, false, mergeUnusedNormalSpanRef, mergeUnusedHighs, mergeUnusedLows, mergeUnusedVolumes, mergeUnusedStartRef, mergeUnusedLastBarRef, mergeUnusedFoldCountRef, true)
processSession(monthlyFilterEnabled, monthlyProfilesToShow, true, monthlyPeriodStart, false, monthlyBarHighs, monthlyBarLows, monthlyBarVolumes, monthlyProfiles, monthlyStartRef, intrabarHighs, intrabarLows, intrabarVolumes, 0, false, mergeUnusedNormalSpanRef, mergeUnusedHighs, mergeUnusedLows, mergeUnusedVolumes, mergeUnusedStartRef, mergeUnusedLastBarRef, mergeUnusedFoldCountRef, true)

rthMitigationActive = rthFilterEnabled and (rthExtensionMode == LEVEL_BREACH_ANY or rthExtensionMode == LEVEL_BREACH_SAME)
weeklyMitigationActive = weeklyFilterEnabled and weeklyExtensionMode == LEVEL_BREACH_ANY
globexMitigationActive = globexFilterEnabled and (globexExtensionMode == LEVEL_BREACH_ANY or globexExtensionMode == LEVEL_BREACH_SAME)
monthlyMitigationActive = monthlyFilterEnabled and monthlyExtensionMode == LEVEL_BREACH_ANY
rthDevelopingProfileActive = rthFilterEnabled and rthInSession and rthDevelopingEnabled and isBeforeNyCutoff(rthDevelopingCutoffHour, rthDevelopingCutoffMinute)
rthSweepActive = rthFilterEnabled and rthExtensionMode == LEVEL_BREACH_SWEEP
weeklySweepActive = weeklyFilterEnabled and weeklyExtensionMode == LEVEL_BREACH_SWEEP
globexSweepActive = globexFilterEnabled and globexExtensionMode == LEVEL_BREACH_SWEEP
monthlySweepActive = monthlyFilterEnabled and monthlyExtensionMode == LEVEL_BREACH_SWEEP

if barstate.isconfirmed
    updateMitigation(rthProfiles, rthMitigationActive, rthExtensionMode == LEVEL_BREACH_SAME, rthInSession, intrabarHighs, intrabarLows)
    updateMitigation(weeklyProfiles, weeklyMitigationActive, false, true, intrabarHighs, intrabarLows)
    updateMitigation(globexProfiles, globexMitigationActive, globexExtensionMode == LEVEL_BREACH_SAME, true, intrabarHighs, intrabarLows)
    updateMitigation(monthlyProfiles, monthlyMitigationActive, false, true, intrabarHighs, intrabarLows)
    updateSweep(rthProfiles, rthSweepActive, sweepConfirmMarginPercent / 100.0)
    updateSweep(weeklyProfiles, weeklySweepActive, sweepConfirmMarginPercent / 100.0)
    updateSweep(globexProfiles, globexSweepActive, sweepConfirmMarginPercent / 100.0)
    updateSweep(monthlyProfiles, monthlySweepActive, sweepConfirmMarginPercent / 100.0)

// ═══════════════════════════════════════════════════════════════════════════════
// RENDER
// ═══════════════════════════════════════════════════════════════════════════════
if barstate.islast
    clearDrawings()
    renderSession(rthFilterEnabled, rthProfiles, rthBarHighs, rthBarLows, rthBarVolumes, rthStartRef, rthStyle, rthDevelopingProfileActive, rthShowDeveloping)
    renderSession(weeklyFilterEnabled, weeklyProfiles, weeklyBarHighs, weeklyBarLows, weeklyBarVolumes, weeklyStartRef, weeklyStyle, false, weeklyShowDeveloping)
    renderSession(globexFilterEnabled, globexProfiles, globexBarHighs, globexBarLows, globexBarVolumes, globexStartRef, globexStyle, false, true)
    renderSession(monthlyFilterEnabled, monthlyProfiles, monthlyBarHighs, monthlyBarLows, monthlyBarVolumes, monthlyStartRef, monthlyStyle, false, true)

    if showColorTable
        int colorTableRows = 1
        bool hasLevelLabelBackground = (rthFilterEnabled and rthStyle.levelLabelMode != LABEL_MODE_OFF) or (weeklyFilterEnabled and weeklyStyle.levelLabelMode != LABEL_MODE_OFF) or (globexFilterEnabled and globexStyle.levelLabelMode != LABEL_MODE_OFF) or (monthlyFilterEnabled and monthlyStyle.levelLabelMode != LABEL_MODE_OFF)
        colorTableRows += hasLevelLabelBackground ? 1 : 0
        colorTableRows += colorRowsForSession(rthFilterEnabled, rthStyle)
        colorTableRows += colorRowsForSession(weeklyFilterEnabled, weeklyStyle)
        colorTableRows += colorRowsForSession(globexFilterEnabled, globexStyle)
        colorTableRows += colorRowsForSession(monthlyFilterEnabled, monthlyStyle)

        if not na(colorTable)
            table.delete(colorTable)
        colorTable := table.new(position.top_right, 4, colorTableRows, bgcolor=color.rgb(255, 255, 255), border_width=1, border_color=color.rgb(128, 128, 128), frame_width=1, frame_color=color.rgb(128, 128, 128))
        table.cell(colorTable, 0, 0, LABEL_TABLE_SETTING, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        table.cell(colorTable, 1, 0, LABEL_TABLE_RGB, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        table.cell(colorTable, 2, 0, LABEL_TABLE_TRANSPARENCY, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        table.cell(colorTable, 3, 0, LABEL_TABLE_WIDTH, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)

        int row = 1
        if hasLevelLabelBackground
            addColorRow(colorTable, row, LABEL_LEVEL_LABEL_BACKGROUND, levelLabelBgColor, "")
            row += 1
        row := addSessionColorRows(colorTable, row, SESSION_RTH, rthFilterEnabled, rthStyle)
        row := addSessionColorRows(colorTable, row, SESSION_WEEKLY, weeklyFilterEnabled, weeklyStyle)
        row := addSessionColorRows(colorTable, row, SESSION_GLOBEX, globexFilterEnabled, globexStyle)
        row := addSessionColorRows(colorTable, row, SESSION_MONTHLY, monthlyFilterEnabled, monthlyStyle)
    else if not na(colorTable)
        table.delete(colorTable)
        colorTable := na
