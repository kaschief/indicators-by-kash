// INPUTS — RTH value-area gaps
// ═══════════════════════════════════════════════════════════════════════════════
rthValueGapsEnabled = input.bool(true, LABEL_RTH_VALUE_GAPS, inline="rth_vag_top", group=GROUP_RTH_VALUE_GAPS, tooltip="Compare consecutive completed RTH value areas after the selected short-session merge mode is applied. A bullish gap forms when the new VAL is above the prior VAH; a bearish gap forms when the new VAH is below the prior VAL. This identifies a gap in accepted value, not necessarily a literal no-trade price gap.")
rthValueGapsToShow = input.int(20, "", minval=1, maxval=50, inline="rth_vag_top", group=GROUP_RTH_VALUE_GAPS)
rthValueGapFillMode = input.string(VALUE_GAP_FILL_PRICE, "", options=[VALUE_GAP_FILL_PRICE, VALUE_GAP_FILL_FROM_0500, VALUE_GAP_FILL_RTH], inline="rth_vag_fill", group=GROUP_RTH_VALUE_GAPS, tooltip="How an open value gap progresses and completes after confirmation:\n• Fill: Any Price — price from any session counts\n• Fill: 05:00 + RTH — New York price from 05:00 through 16:00 counts\n• Fill: RTH Session — only price from 09:30 through 16:00 counts")
rthBullishValueGapUnfilledColor = input.color(DEFAULT_RTH_VALUE_GAP_UNFILLED_COLOR, "+", inline="rth_vag_fill", group=GROUP_RTH_VALUE_GAPS, tooltip="Unfilled bullish value-gap color.")
rthBearishValueGapUnfilledColor = input.color(DEFAULT_RTH_VALUE_GAP_BEARISH_UNFILLED_COLOR, "−", inline="rth_vag_fill", group=GROUP_RTH_VALUE_GAPS, tooltip="Unfilled bearish value-gap color.")
rthValueGapFilledColor = input.color(DEFAULT_RTH_VALUE_GAP_FILLED_COLOR, "✓", inline="rth_vag_fill", group=GROUP_RTH_VALUE_GAPS, tooltip="Filled portion color.")
rthHideFilledValueGaps = input.bool(false, "Hide", inline="rth_vag_fill", group=GROUP_RTH_VALUE_GAPS, tooltip="Hide value gaps after they are completely filled.")
rthValueGapShowBorders = input.bool(true, "Border", inline="rth_vag_border", group=GROUP_RTH_VALUE_GAPS)
rthBullishValueGapBorderColor = input.color(DEFAULT_RTH_VALUE_GAP_BULLISH_BORDER_COLOR, "+", inline="rth_vag_border", group=GROUP_RTH_VALUE_GAPS)
rthBearishValueGapBorderColor = input.color(DEFAULT_RTH_VALUE_GAP_BEARISH_BORDER_COLOR, "−", inline="rth_vag_border", group=GROUP_RTH_VALUE_GAPS)
rthValueGapShowLabels = input.bool(true, "Label", inline="rth_vag_labels", group=GROUP_RTH_VALUE_GAPS)
rthBullishValueGapLabelColor = input.color(DEFAULT_RTH_VALUE_GAP_BULLISH_LABEL_COLOR, "+", inline="rth_vag_labels", group=GROUP_RTH_VALUE_GAPS)
rthBearishValueGapLabelColor = input.color(DEFAULT_RTH_VALUE_GAP_BEARISH_LABEL_COLOR, "−", inline="rth_vag_labels", group=GROUP_RTH_VALUE_GAPS)
rthValueGapDirectionalLabels = input.bool(true, "Directional", inline="rth_vag_labels", group=GROUP_RTH_VALUE_GAPS, tooltip="Place bullish labels below their box and bearish labels above it. Off places every label below.")
rthValueGapInternalLinesMode = input.string(VALUE_GAP_INTERNAL_QUARTILES, "Internal Lines", options=[VALUE_GAP_INTERNAL_OFF, VALUE_GAP_INTERNAL_HALF, VALUE_GAP_INTERNAL_QUARTILES], inline="rth_vag_internals", group=GROUP_RTH_VALUE_GAPS, tooltip="Internal reference lines:\n• Off — none\n• 50% Only — midpoint only\n• Quartiles — 25%, 50% and 75%")
rthValueGapInternalLinesColor = input.color(DEFAULT_VALUE_GAP_INTERNAL_LINES_COLOR, "50%", inline="rth_vag_internals", group=GROUP_RTH_VALUE_GAPS)
rthValueGapQuartileLinesColor = input.color(DEFAULT_VALUE_GAP_QUARTILE_LINES_COLOR, "Q", inline="rth_vag_internals", group=GROUP_RTH_VALUE_GAPS)
rthValueGapShowMidpointLabel = input.bool(false, "50% Label", inline="rth_vag_internals", group=GROUP_RTH_VALUE_GAPS, tooltip="Show a small RTH Gap 50% reference on the midpoint line. Requires Internal Lines.")
rthValueGapShowQuartileLabels = input.bool(false, "Q Labels", inline="rth_vag_internals", group=GROUP_RTH_VALUE_GAPS, tooltip="Place subtle ¼ and ¾ references on anchored historical gaps. Requires Quartiles.")
