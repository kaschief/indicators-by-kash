//@version=6

// ═══════════════════════════════════════════════════════════════════════════════
// INDICATOR SETUP
// ═══════════════════════════════════════════════════════════════════════════════
INDICATOR_MAX_LINES = 500
INDICATOR_MAX_LABELS = 500
INDICATOR_MAX_BOXES = 500
INDICATOR_MAX_POLYLINES = 100
INDICATOR_TITLE = 'revelio •'

indicator(INDICATOR_TITLE, overlay=true, max_lines_count=INDICATOR_MAX_LINES, max_labels_count=INDICATOR_MAX_LABELS, max_boxes_count=INDICATOR_MAX_BOXES, max_polylines_count=INDICATOR_MAX_POLYLINES, max_bars_back=5000)

// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════
NY_TIMEZONE = "America/New_York"
UTC_TIMEZONE = "GMT+0"

// Session specification (RTH has a daily gap; the 24h sessions are anchored by NY calendar below)
RTH_SESSION = "0930-1600:23456"      // Regular cash session, Mon-Fri (session-based assets)
RTH_SESSION_ALL_DAYS = "0930-1600:1234567"  // Same 09:30-16:00 NY window every day (24/7 assets)
WEEKLY_REOPEN_SESSION = "1800-0930"  // Sunday 18:00 NY futures reopen edge
SUNDAY_REOPEN_START_HOUR = 18
SECONDS_PER_WEEK = 604800
ASSET_DETECTION_MAX_LOOKBACK = 4999

// Brand bullet used between a level's name and its price in detailed labels.
BRAND_BULLET = "•"

START_TIME_UNSET = -1

// Level extension / mitigation modes
LEVEL_PERIOD = "Session Only"
LEVEL_BREACH_ANY = "Until Touched"
LEVEL_BREACH_SAME = "Same-Session Touch"
LEVEL_BREACH_SWEEP = "Until Swept"

// A session whose bar-span is below this fraction of the longest session seen is treated as
// an early close / holiday half-day and merged per the selected mode.
HOLIDAY_MERGE_SPAN_FRACTION = 0.75

PROFILE_ROWS = 250
HISTOGRAM_SMOOTHING = 7
HISTOGRAM_WIDTH_PERCENT = 25.0

// Default "Curated Show Last" counts for the Core / Prep views, per cadence.
DEFAULT_CURATED_RTH_GLOBEX_COUNT = 2
DEFAULT_CURATED_WEEKLY_COUNT = 2
DEFAULT_CURATED_MONTHLY_COUNT = 2

// Short-session merge modes (how early-close / holiday half-days combine), least-to-most merging.
MERGE_OFF = "Off"
MERGE_EARLIEST = "Earliest Into Previous Full Session"
MERGE_ALL = "All Into Previous Full Session"
MERGE_COMBINE = "Combine Shorts"

// Line styles
STYLE_SOLID = "Solid"
STYLE_DASHED = "Dashed"
STYLE_DOTTED = "Dotted"

// Label sizes
LABEL_SIZE_TINY = "Tiny"
LABEL_SIZE_SMALL = "Small"
LABEL_SIZE_NORMAL = "Normal"
LABEL_SIZE_LARGE = "Large"
LABEL_SIZE_HUGE = "Huge"

// Alternate-POC qualification (volume-only, distance ignored): a secondary node qualifies when nearly
// as heavy as the POC — that near-tie is what lets a timeframe / HD change flip the POC onto it.
ALTERNATE_POC_WINDOW_FRAC = 0.03  // ignore rows within this fraction of total rows around the POC (its own shoulder)
ALTERNATE_POC_MIN_RATIO = 0.90    // candidate volume must be ≥ this fraction of POC volume to qualify

// Session group labels (each session contains volume profiles)
GROUP_QUICK_FILTER = "⚡ Quick Filter"
GROUP_QUICK_FILTER_SETTINGS = "⚡ Quick Filter: Settings"
GROUP_DISPLAY = "⚙️ Display"
GROUP_SWEEP = "🧹 Sweep"
GROUP_RTH = "🗽 RTH"
GROUP_RTH_ADVANCED = "🗽 RTH: Advanced"
GROUP_WEEKLY = "📅 Weekly"
GROUP_GLOBEX = "🌅 Globex"
GROUP_MONTHLY = "🗓️ Monthly"
GROUP_UTILITY = "🎨 Utility"

// Plain session labels reused where emojis would add noise.
SESSION_RTH = "RTH"
SESSION_WEEKLY = "Weekly"
SESSION_GLOBEX = "Globex"
SESSION_MONTHLY = "Monthly"

// Input labels reused across every session (change once, applies everywhere)
LABEL_ENABLE_RTH = "Enable RTH Session"
LABEL_ENABLE_WEEKLY = "Enable Weekly Session"
LABEL_ENABLE_GLOBEX = "Enable Globex Session"
LABEL_ENABLE_MONTHLY = "Enable Monthly Session"
LABEL_DIM_TOUCHED = "Fade Mitigated Levels"
LABEL_DIM_PERCENT = "%"
LABEL_VALUE_AREA_HIGH_LOW = "VAH/L"
LABEL_VAH = "VAH"
LABEL_VAL = "VAL"
LABEL_POC = "POC"
LABEL_ALTERNATE_POC = "aPOC"
LABEL_VALUE_AREA = "Value"
LABEL_HISTOGRAM_INSIDE = "In"
LABEL_HISTOGRAM_OUTSIDE = "Out"
LABEL_SESSION_BOX = "Session Box"
LABEL_SHORT_SESSION_MERGE = "Merge Short Session"
LABEL_LEVEL_LABELS = "Price Labels"
LABEL_LEVEL_LABEL_OFFSET = "Price Label Offset"
LABEL_LEVEL_LABEL_BACKGROUND = "Price Label Background"
LABEL_MODE_OFF = "Off"
LABEL_MODE_PRICE = "Price"
LABEL_MODE_DETAILS = "With Details"
LABEL_MODE_BOTH = "Both"
TOOLTIP_LEVEL_LABELS = "Tag for each open, untouched level still extending right (POC, VAH/VAL, aPOC). Off = no tag; Price = price only; Label Details = anchor + level name; Both = name and price."
LABEL_DEVELOPING_PROFILE = "Style Developing Profile"
LABEL_SWEPT = "Swept"
LABEL_SWEEP_CONFIRM_MARGIN = "Sweep Confirmation Percent Margin"
LABEL_SWEPT_CONTINUATION_LINE_FADE = "Level Fade Percent"
LABEL_SWEPT_LABEL_TEXT_FADE = "Label Text Fade"
LABEL_SWEPT_KEEP = "Days to Keep Swept Lines"
LABEL_SWEPT_CONTINUATION_LINE_WIDTH = "Swept Line Width"
TOOLTIP_SWEEP_MARGIN = "For 'Until Swept' only. A close counts as a clean departure to one side when it is beyond the level by at least this percentage of the profile's high-low range. The level is swept once price has done this on both sides, which keeps tick-chop on the level from counting."
TOOLTIP_SWEPT_CONTINUATION_LINE_WIDTH = "Width of the dashed continuation line drawn after this anchor's level is swept, so it can differ from the anchor's main line width."
TOOLTIP_SWEPT_CONTINUATION_LINE_FADE = "Extra fade applied to the dashed continuation of swept levels, on top of the Fade Mitigated Levels setting."
TOOLTIP_SWEPT_LABEL_TEXT_FADE = "Extra fade applied only to swept level label text. 0 = keep the normal label text color; 100 = fully transparent."
TOOLTIP_SWEPT_KEEP = "RTH only. Beyond the most recent RTH profile (always kept), also keep the faded continuation of older swept levels whose sweep happened within this many days. A whole profile is kept when its most recent sweep falls inside the window. 0 = only the most recent RTH profile's swept levels are kept."
MS_PER_DAY = 24 * 60 * 60 * 1000
LABEL_RTH_ANCHOR = "Daily"
LABEL_RTH_LIVE = "★ Today's Daily"
LABEL_RTH_LAST = "Prev Daily"
LABEL_WEEKLY_ANCHOR = "Weekly"
LABEL_WEEKLY_LIVE = "★ This Week's"
LABEL_WEEKLY_LAST = "Last Week's"
LABEL_GLOBEX_ANCHOR = "Globex"
LABEL_GLOBEX_LIVE = "Today's Globex"
LABEL_GLOBEX_LAST = "Prev Globex"
LABEL_MONTHLY_ANCHOR = "Monthly"
LABEL_MONTHLY_LIVE = "★ This Month's"
LABEL_MONTHLY_LAST = "Last Month's"
LABEL_TABLE_SETTING = "Setting"
LABEL_TABLE_RGB = "RGB"
LABEL_TABLE_TRANSPARENCY = "Trans"
LABEL_TABLE_WIDTH = "Width"

// On every level row the first swatch is the level line, the second is its label text.
TOOLTIP_LINE_COLOR = "Level line color."
TOOLTIP_LABEL_COLOR = "Label text color for this level."

FILTER_ALL = "Manual"
FILTER_CORE = "★ Core"
FILTER_PREP = "☾ Prep: Core + Globex"
FILTER_INTRADAY = "Intraday: RTH + Globex"
FILTER_SWING = "Swing: Weekly + Monthly"
FILTER_RTH_ONLY = "RTH Only"
FILTER_WEEKLY_ONLY = "Weekly Only"
FILTER_GLOBEX_ONLY = "Globex Only"
FILTER_MONTHLY_ONLY = "Monthly Only"
TOOLTIP_QUICK_FILTER = "Quickly switch which profiles are shown.\n\n• Manual — respect each session's own Enable toggle and settings\n• Core — curated view of RTH, Weekly and Monthly (no Globex), each capped at its Curated Show Last count. Developing profiles are hidden unless their include toggles below are on\n• Prep: Core + Globex — Core plus the Globex anchor\n• Intraday: RTH + Globex — those two anchors only, each at its own Show Last count\n• Swing: Weekly + Monthly — those two anchors only, each at its own Show Last count\n• RTH / Weekly / Globex / Monthly Only — that one anchor only, at its own Show Last count\n\nIn every mode except Manual, an anchor's developing/current profile appears only when its Include Developing toggle below is on, so you can keep the chart to completed profiles."
TOOLTIP_CURATED_LOOKBACK = "Core / Prep only. How many recent completed profiles to show for RTH and Globex (the daily-cadence anchors). Weekly and Monthly have their own counts."
TOOLTIP_CURATED_WEEKLY_LOOKBACK = "Core / Prep only. How many recent completed weekly profiles to show. Kept separate from RTH/Globex so a week of daily profiles doesn't pull weeks of weekly profiles."
TOOLTIP_CURATED_MONTHLY_LOOKBACK = "Core / Prep only. How many recent completed monthly profiles to show."
TOOLTIP_DEVELOPING_RTH = "Applies to every Quick Filter except Manual. When on, also show today's developing RTH profile; when off, only completed RTH profiles show."
TOOLTIP_DEVELOPING_WEEKLY = "Applies to every Quick Filter except Manual. When on, also show the current developing weekly profile; when off, only completed weekly profiles show."
TOOLTIP_DEVELOPING_GLOBEX = "Applies to every Quick Filter except Manual. When on, also show the current developing Globex profile; when off, only completed Globex profiles show."
TOOLTIP_DEVELOPING_MONTHLY = "Applies to every Quick Filter except Manual. When on, also show the current developing monthly profile; when off, only completed monthly profiles show."
TOOLTIP_HIGHLIGHT_CURRENT = "Frame the current developing session's box so it stands out among the other profiles. Only acts on the developing profile (needs its Current toggle on) and works whether or not the normal Session Box is enabled. While on, this anchor's completed profiles drop their session boxes so only the current period is framed."
TOOLTIP_HIGHLIGHT_OPACITY = "Fill opacity of the highlighted current-session box. 0 = invisible, 100 = fully opaque. Uses the anchor's Session Box color."

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Quick Filter
// ═══════════════════════════════════════════════════════════════════════════════
quickFilter = input.string(FILTER_CORE, "Quick Filter", options=[FILTER_ALL, FILTER_CORE, FILTER_PREP, FILTER_INTRADAY, FILTER_SWING, FILTER_RTH_ONLY, FILTER_WEEKLY_ONLY, FILTER_GLOBEX_ONLY, FILTER_MONTHLY_ONLY], group=GROUP_QUICK_FILTER, tooltip=TOOLTIP_QUICK_FILTER)
includeDevelopingRth = input.bool(false, "+RTH", inline="ov_dev", group=GROUP_QUICK_FILTER, tooltip=TOOLTIP_DEVELOPING_RTH)
includeDevelopingWeekly = input.bool(false, "+Weekly", inline="ov_dev", group=GROUP_QUICK_FILTER, tooltip=TOOLTIP_DEVELOPING_WEEKLY)
includeDevelopingGlobex = input.bool(false, "+Globex", inline="ov_dev", group=GROUP_QUICK_FILTER, tooltip=TOOLTIP_DEVELOPING_GLOBEX)
includeDevelopingMonthly = input.bool(false, "+Monthly", inline="ov_dev", group=GROUP_QUICK_FILTER, tooltip=TOOLTIP_DEVELOPING_MONTHLY)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Quick Filter: Settings
// ═══════════════════════════════════════════════════════════════════════════════
curatedLookback = input.int(DEFAULT_CURATED_RTH_GLOBEX_COUNT, "Curated Show Last  ·  RTH/Globex", minval=1, maxval=50, inline="ov_counts", group=GROUP_QUICK_FILTER_SETTINGS, tooltip=TOOLTIP_CURATED_LOOKBACK)
curatedWeeklyLookback = input.int(DEFAULT_CURATED_WEEKLY_COUNT, "Weekly", minval=1, maxval=50, inline="ov_counts2", group=GROUP_QUICK_FILTER_SETTINGS, tooltip=TOOLTIP_CURATED_WEEKLY_LOOKBACK)
curatedMonthlyLookback = input.int(DEFAULT_CURATED_MONTHLY_COUNT, "Monthly", minval=1, maxval=50, inline="ov_counts2", group=GROUP_QUICK_FILTER_SETTINGS, tooltip=TOOLTIP_CURATED_MONTHLY_LOOKBACK)
weeklyHighlightEnabled = input.bool(true, "Weekly Current Highlight", inline="hl_weekly", group=GROUP_QUICK_FILTER_SETTINGS, tooltip=TOOLTIP_HIGHLIGHT_CURRENT)
weeklyHighlightOpacity = input.int(3, "Opacity", minval=0, maxval=100, inline="hl_weekly", group=GROUP_QUICK_FILTER_SETTINGS, tooltip=TOOLTIP_HIGHLIGHT_OPACITY)
monthlyHighlightEnabled = input.bool(true, "Monthly Current Highlight", inline="hl_monthly", group=GROUP_QUICK_FILTER_SETTINGS, tooltip=TOOLTIP_HIGHLIGHT_CURRENT)
monthlyHighlightOpacity = input.int(3, "Opacity", minval=0, maxval=100, inline="hl_monthly", group=GROUP_QUICK_FILTER_SETTINGS, tooltip=TOOLTIP_HIGHLIGHT_OPACITY)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — RTH session
// ═══════════════════════════════════════════════════════════════════════════════
rthEnabled = input.bool(true, LABEL_ENABLE_RTH, inline="rth_top", group=GROUP_RTH, tooltip="Build a volume profile for each Regular Trading Hours cash session (09:30–16:00 New York time, Mon–Fri).")
rthExtensionMode = input.string(LEVEL_BREACH_SWEEP, "", options=[LEVEL_PERIOD, LEVEL_BREACH_ANY, LEVEL_BREACH_SAME, LEVEL_BREACH_SWEEP], inline="rth_top", group=GROUP_RTH, tooltip="How the POC and Value Area High / Low extend after the session closes:\n• Session Only — stays within its session\n• Until Touched — extends right, stops at the first bar that trades through it\n• Same-Session Touch — stops only when a later RTH session trades through it\n• Until Swept — stays live through touches until price has cleanly closed beyond it on BOTH sides (a two-sided sweep), then stops")
rthProfilesToShow = input.int(10, "", minval=1, maxval=50, inline="rth_top", group=GROUP_RTH, tooltip="How many recent profiles this session keeps and draws.")
rthShowValueArea = input.bool(true, LABEL_VALUE_AREA_HIGH_LOW, inline="rth_value_area", group=GROUP_RTH)
rthValueAreaColor = input.color(color.new(color.rgb(41, 98, 255), 20), "", inline="rth_value_area", group=GROUP_RTH, tooltip=TOOLTIP_LINE_COLOR)
rthValueAreaWidth = input.string("2", "", options=["1", "2", "3", "4", "5"], inline="rth_value_area", group=GROUP_RTH)
rthValueAreaStyle = input.string(STYLE_SOLID, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="rth_value_area", group=GROUP_RTH)
rthValueAreaLabelColor = input.color(color.new(color.rgb(24, 72, 204), 20), "", inline="rth_value_area", group=GROUP_RTH, tooltip=TOOLTIP_LABEL_COLOR)
rthShowPoc = input.bool(true, LABEL_POC, inline="rth_poc", group=GROUP_RTH)
rthPocColor = input.color(color.new(color.rgb(156, 39, 176), 0), "", inline="rth_poc", group=GROUP_RTH, tooltip=TOOLTIP_LINE_COLOR)
rthPocWidth = input.string("2", "", options=["1", "2", "3", "4", "5"], inline="rth_poc", group=GROUP_RTH)
rthPocStyle = input.string(STYLE_DASHED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="rth_poc", group=GROUP_RTH)
rthPocLabelColor = input.color(color.new(color.rgb(123, 31, 162), 0), "", inline="rth_poc", group=GROUP_RTH, tooltip=TOOLTIP_LABEL_COLOR)
rthShowAlternatePoc = input.bool(false, LABEL_ALTERNATE_POC, inline="rth_altpoc", group=GROUP_RTH, tooltip="Also mark the alternate POC: a secondary node nearly as heavy as the main POC (by volume), so the POC could shift onto it at a different timeframe or HD resolution. Hidden when no qualifying node exists.")
rthAlternatePocColor = input.color(color.new(color.rgb(233, 30, 99), 0), "", inline="rth_altpoc", group=GROUP_RTH, tooltip=TOOLTIP_LINE_COLOR)
rthAlternatePocWidth = input.string("2", "", options=["1", "2", "3", "4", "5"], inline="rth_altpoc", group=GROUP_RTH)
rthAlternatePocStyle = input.string(STYLE_DOTTED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="rth_altpoc", group=GROUP_RTH)
rthAlternatePocLabelColor = input.color(color.new(color.rgb(194, 24, 91), 0), "", inline="rth_altpoc", group=GROUP_RTH, tooltip=TOOLTIP_LABEL_COLOR)
rthShowSessionBox = input.bool(false, LABEL_SESSION_BOX, inline="rth_hist", group=GROUP_RTH)
rthSessionBoxColor = input.color(color.new(color.rgb(187, 217, 251), 90), "", inline="rth_hist", group=GROUP_RTH)
rthShowHistogram = input.bool(true, LABEL_VALUE_AREA, inline="rth_hist", group=GROUP_RTH)
rthHistogramInsideColor = input.color(color.new(color.rgb(91, 156, 246), 75), LABEL_HISTOGRAM_INSIDE, inline="rth_hist", group=GROUP_RTH)
rthHistogramOutsideColor = input.color(color.new(color.rgb(184, 184, 184), 80), LABEL_HISTOGRAM_OUTSIDE, inline="rth_hist", group=GROUP_RTH)
rthDimTouched = input.bool(true, LABEL_DIM_TOUCHED, inline="rth_dim", group=GROUP_RTH, tooltip="Fade levels that have already been touched (mitigated) so untouched, still-active levels keep full strength. Only meaningful in the 'Until Touched' modes.")
rthDimPercent = input.int(85, LABEL_DIM_PERCENT, minval=0, maxval=100, inline="rth_dim", group=GROUP_RTH)
rthSweptContinuationWidth = input.string("1", LABEL_SWEPT_CONTINUATION_LINE_WIDTH, options=["1", "2", "3", "4", "5"], inline="rth_dim", group=GROUP_RTH, tooltip=TOOLTIP_SWEPT_CONTINUATION_LINE_WIDTH)
rthLevelLabelMode = input.string(LABEL_MODE_BOTH, LABEL_LEVEL_LABELS, options=[LABEL_MODE_OFF, LABEL_MODE_PRICE, LABEL_MODE_DETAILS, LABEL_MODE_BOTH], inline="rth_labels", group=GROUP_RTH, tooltip=TOOLTIP_LEVEL_LABELS)
rthLevelLabelSize = input.string(LABEL_SIZE_TINY, "", options=[LABEL_SIZE_TINY, LABEL_SIZE_SMALL, LABEL_SIZE_NORMAL, LABEL_SIZE_LARGE, LABEL_SIZE_HUGE], inline="rth_labels", group=GROUP_RTH)
rthMergeMode = input.string(MERGE_ALL, LABEL_SHORT_SESSION_MERGE, options=[MERGE_OFF, MERGE_EARLIEST, MERGE_ALL, MERGE_COMBINE], inline="rth_merge", group=GROUP_RTH_ADVANCED, tooltip="How short sessions (early closes / holiday half-days) are handled. A session counts as short when its bar span is under 75% of the longest RTH session seen.\n• Off — every short session stands alone\n• Earliest Into Previous Full Session — only the earliest (oldest) short folds into the prior full session; later shorts stand alone\n• All Into Previous Full Session — all consecutive shorts fold into the prior full session\n• Combine Shorts — consecutive shorts merge into one block, leaving the prior full session intact")
rthDevelopingEnabled = input.bool(true, LABEL_DEVELOPING_PROFILE, inline="rth_developing", group=GROUP_RTH_ADVANCED, tooltip="Temporarily recolor the live RTH POC, aPOC, and VAH/VAL before the cutoff time so users can tell the profile is still immature.")
rthDevelopingValueAreaColor = input.color(color.new(color.rgb(128, 128, 128), 20), LABEL_VALUE_AREA_HIGH_LOW, inline="rth_developing", group=GROUP_RTH_ADVANCED)
rthDevelopingPocColor = input.color(color.new(color.rgb(206, 147, 216), 0), LABEL_POC, inline="rth_developing", group=GROUP_RTH_ADVANCED)
rthDevelopingAlternatePocColor = input.color(color.new(color.rgb(244, 143, 177), 0), LABEL_ALTERNATE_POC, inline="rth_developing", group=GROUP_RTH_ADVANCED)
rthDevelopingCutoffHour = input.int(10, "Developing Cutoff (NY)", minval=0, maxval=23, inline="rth_developing_cutoff", group=GROUP_RTH_ADVANCED)
rthDevelopingCutoffMinute = input.int(30, ":", minval=0, maxval=59, inline="rth_developing_cutoff", group=GROUP_RTH_ADVANCED, tooltip="New York cutoff time. Developing colors apply only before this HH:MM.")

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Weekly session
// ═══════════════════════════════════════════════════════════════════════════════
weeklyEnabled = input.bool(false, LABEL_ENABLE_WEEKLY, inline="weekly_top", group=GROUP_WEEKLY, tooltip="Build a volume profile for each week. Futures-style symbols use the Sunday 18:00 New York reopen; crypto / 24/7 assets use Monday 00:00 UTC.")
weeklyExtensionMode = input.string(LEVEL_BREACH_SWEEP, "", options=[LEVEL_PERIOD, LEVEL_BREACH_ANY, LEVEL_BREACH_SWEEP], inline="weekly_top", group=GROUP_WEEKLY, tooltip="How the POC and Value Area High / Low extend after the week closes:\n• Session Only — stays within its week\n• Until Touched — extends right, stops at the first bar that trades through it\n• Until Swept — stays live through touches until price has cleanly closed beyond it on BOTH sides, then stops")
weeklyProfilesToShow = input.int(5, "", minval=1, maxval=50, inline="weekly_top", group=GROUP_WEEKLY, tooltip="How many recent profiles this session keeps and draws.")
weeklyShowValueArea = input.bool(true, LABEL_VALUE_AREA_HIGH_LOW, inline="weekly_value_area", group=GROUP_WEEKLY)
weeklyValueAreaColor = input.color(color.new(color.rgb(242, 54, 69), 20), "", inline="weekly_value_area", group=GROUP_WEEKLY, tooltip=TOOLTIP_LINE_COLOR)
weeklyValueAreaWidth = input.string("2", "", options=["1", "2", "3", "4", "5"], inline="weekly_value_area", group=GROUP_WEEKLY)
weeklyValueAreaStyle = input.string(STYLE_SOLID, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="weekly_value_area", group=GROUP_WEEKLY)
weeklyValueAreaLabelColor = input.color(color.new(color.rgb(230, 81, 0), 20), "", inline="weekly_value_area", group=GROUP_WEEKLY, tooltip=TOOLTIP_LABEL_COLOR)
weeklyShowPoc = input.bool(true, LABEL_POC, inline="weekly_poc", group=GROUP_WEEKLY)
weeklyPocColor = input.color(color.new(color.rgb(171, 71, 188), 0), "", inline="weekly_poc", group=GROUP_WEEKLY, tooltip=TOOLTIP_LINE_COLOR)
weeklyPocWidth = input.string("2", "", options=["1", "2", "3", "4", "5"], inline="weekly_poc", group=GROUP_WEEKLY)
weeklyPocStyle = input.string(STYLE_DASHED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="weekly_poc", group=GROUP_WEEKLY)
weeklyPocLabelColor = input.color(color.new(color.rgb(123, 31, 162), 0), "", inline="weekly_poc", group=GROUP_WEEKLY, tooltip=TOOLTIP_LABEL_COLOR)
weeklyShowAlternatePoc = input.bool(false, LABEL_ALTERNATE_POC, inline="weekly_altpoc", group=GROUP_WEEKLY, tooltip="Also mark the alternate POC: a secondary node nearly as heavy as the main POC (by volume), so the POC could shift onto it at a different timeframe or HD resolution. Hidden when no qualifying node exists.")
weeklyAlternatePocColor = input.color(color.new(color.rgb(233, 30, 99), 0), "", inline="weekly_altpoc", group=GROUP_WEEKLY, tooltip=TOOLTIP_LINE_COLOR)
weeklyAlternatePocWidth = input.string("2", "", options=["1", "2", "3", "4", "5"], inline="weekly_altpoc", group=GROUP_WEEKLY)
weeklyAlternatePocStyle = input.string(STYLE_DOTTED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="weekly_altpoc", group=GROUP_WEEKLY)
weeklyAlternatePocLabelColor = input.color(color.new(color.rgb(194, 24, 91), 0), "", inline="weekly_altpoc", group=GROUP_WEEKLY, tooltip=TOOLTIP_LABEL_COLOR)
weeklyShowSessionBox = input.bool(false, LABEL_SESSION_BOX, inline="weekly_hist", group=GROUP_WEEKLY)
weeklySessionBoxColor = input.color(color.new(color.rgb(250, 161, 164), 95), "", inline="weekly_hist", group=GROUP_WEEKLY)
weeklyShowHistogram = input.bool(true, LABEL_VALUE_AREA, inline="weekly_hist", group=GROUP_WEEKLY)
weeklyHistogramInsideColor = input.color(color.new(color.rgb(252, 203, 205), 70), LABEL_HISTOGRAM_INSIDE, inline="weekly_hist", group=GROUP_WEEKLY)
weeklyHistogramOutsideColor = input.color(color.new(color.rgb(184, 184, 184), 80), LABEL_HISTOGRAM_OUTSIDE, inline="weekly_hist", group=GROUP_WEEKLY)
weeklyDimTouched = input.bool(true, LABEL_DIM_TOUCHED, inline="weekly_dim", group=GROUP_WEEKLY, tooltip="Fade levels that have already been touched (mitigated) so untouched, still-active levels keep full strength. Only meaningful in the 'Until Touched' modes.")
weeklyDimPercent = input.int(85, LABEL_DIM_PERCENT, minval=0, maxval=100, inline="weekly_dim", group=GROUP_WEEKLY)
weeklySweptContinuationWidth = input.string("2", LABEL_SWEPT_CONTINUATION_LINE_WIDTH, options=["1", "2", "3", "4", "5"], inline="weekly_dim", group=GROUP_WEEKLY, tooltip=TOOLTIP_SWEPT_CONTINUATION_LINE_WIDTH)
