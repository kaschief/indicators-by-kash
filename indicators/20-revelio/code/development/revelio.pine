monthlySweepControlsActive = monthlyControlsActive and monthlyExtensionMode == LEVEL_BREACH_SWEEP
monthlyShowValueArea = input.bool(true, LABEL_VALUE_AREA_HIGH_LOW, inline="monthly_value_area", group=GROUP_MONTHLY, active=monthlyControlsActive)
