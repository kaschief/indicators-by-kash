valueAreaPercent = input.float(70.0, "Value area %", minval=1.0, maxval=100.0, step=0.5, tooltip="The Value Area is the band, centered on the POC, holding this percentage of total volume. Value Area High / Low are its edges. 70% is the market-profile standard.", group=GROUP_DISPLAY)
intrabarResolution = input.string("Auto", "HD resolution (intrabar data)", options=["Auto", "1S", "5S", "15S", "1", "3", "5", "15"], tooltip="Lower timeframe pulled from inside each chart bar to build the profile and detect breaches. Smaller = more precise. 'Auto' picks a sensible sub-timeframe from the chart timeframe.", group=GROUP_DISPLAY)
levelLabelOffset = input.int(20, LABEL_LEVEL_LABEL_OFFSET, minval=0, maxval=100, tooltip="Shift the price tags this many bars to the right of the last bar, into the empty margin where the extended lines point.", group=GROUP_DISPLAY)
