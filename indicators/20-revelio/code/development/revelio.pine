//@version=6

// ═══════════════════════════════════════════════════════════════════════════════
// INDICATOR SETUP
// ═══════════════════════════════════════════════════════════════════════════════
INDICATOR_MAX_LINES = 500
INDICATOR_MAX_LABELS = 500
INDICATOR_MAX_BOXES = 500
INDICATOR_MAX_POLYLINES = 100
INDICATOR_TITLE = 'revelio •'

indicator(INDICATOR_TITLE, overlay=true, max_lines_count=INDICATOR_MAX_LINES, max_labels_count=INDICATOR_MAX_LABELS, max_boxes_count=INDICATOR_MAX_BOXES, max_polylines_count=INDICATOR_MAX_POLYLINES, max_bars_back=5000)

// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════
NY_TIMEZONE = "America/New_York"
UTC_TIMEZONE = "GMT+0"

// Canonical time units. Derived durations below use these instead of repeating unit arithmetic.
MS_PER_HOUR = 60 * 60 * 1000
MS_PER_DAY = 24 * MS_PER_HOUR
MS_PER_WEEK = 7 * MS_PER_DAY
MS_PER_MONTH = 30 * MS_PER_DAY
MS_PER_QUARTER = 3 * MS_PER_MONTH
MINUTES_PER_HOUR = 60
MINUTES_PER_DAY = 24 * MINUTES_PER_HOUR

// Session specification (RTH has a daily gap; the 24h sessions are anchored by NY calendar below)
RTH_SESSION = "0930-1600:23456"      // Regular cash session, Mon-Fri (session-based assets)
RTH_SESSION_ALL_DAYS = "0930-1600:1234567"  // Same 09:30-16:00 NY window every day (24/7 assets)
FROM_0500_START_MINUTE = 300
FROM_0830_START_MINUTE = 510
RTH_START_MINUTE = 570
RTH_END_MINUTE = 960
WEEKLY_REOPEN_SESSION = "1800-0930"  // Sunday 18:00 NY futures reopen edge
SUNDAY_REOPEN_START_HOUR = 18
GLOBEX_REOPEN_SHIFT_MS = 6 * MS_PER_HOUR
SECONDS_PER_WEEK = 604800
ASSET_DETECTION_MAX_LOOKBACK = 4999

// Recurring New York windows used by Show Only; the overnight session crosses midnight.
SESSION_WINDOW_OVERNIGHT = "1600-0500:1234567" // 16:00–05:00 — the standard overnight
SESSION_WINDOW_FROM_0500 = "0500-1600:1234567" // 05:00–16:00 — premarket into the cash session
SESSION_WINDOW_FROM_0830 = "0830-1600:1234567" // 08:30–16:00 — the 08:30 open through the cash close
SESSION_WINDOW_RTH = "0930-1600:1234567"       // 09:30–16:00 — the regular trading hours cash session

// Leading dots distinguish the pre-RTH start times without lengthening dropdown labels.
WINDOW_LABEL_OVERNIGHT = "Overnight"
WINDOW_LABEL_FROM_0500 = "● ● RTH"
WINDOW_LABEL_FROM_0830 = "● RTH"
WINDOW_LABEL_RTH = "RTH"

BRAND_BULLET = "•"
SWEPT_CHECKMARK = "✓"

START_TIME_UNSET = -1

// Level extension / mitigation modes
LEVEL_PERIOD = "Session Only"
LEVEL_BREACH_ANY = "Until Touched"
LEVEL_BREACH_SAME = "Same-Session Touch"
LEVEL_BREACH_SWEEP = "Until Swept"

VALUE_GAP_SOURCE_RTH = "RTH"
VALUE_GAP_SOURCE_GLOBEX = "Globex"

VALUE_GAP_DISPLAY_HISTORICAL = "Historical"
VALUE_GAP_DISPLAY_HISTORICAL_FLOATING = "Historical + Floating"
VALUE_GAP_DISPLAY_RECENT_FLOATING = "Most Recent + Floating"
VALUE_GAP_DISPLAY_FLOATING = "Floating Only"
VALUE_GAP_NEAREST_RECENT_ONLY = "Recent Only"
FOCUS_DIRECTION_OFF = "Off"
FOCUS_DIRECTION_BELOW = "↓ Below"
FOCUS_DIRECTION_ABOVE = "↑ Above"
FOCUS_DIRECTION_AROUND = "↕ Around"
FOCUS_ANCHOR_PRICE = "Current Price"
FOCUS_ANCHOR_MANUAL = "Manual"
TOUCH_MARKERS_OFF = "Off"
TOUCH_MARKERS_ON = "On"
TOUCH_MARKERS_ON_FOCUS = "On + Focus"
LABEL_REMINDERS = "Reminders"
LABEL_FADE_PERCENT = "Fade %"
ANCHOR_LABEL_MODE_OFF = "Off"
ANCHOR_LABEL_MODE_ONCE = "Once"
ANCHOR_LABEL_MODE_REMINDERS = LABEL_REMINDERS
ANCHOR_REMINDER_MIN_SPACING_MS = 3 * MS_PER_DAY
ANCHOR_REMINDER_MAX_PER_LEVEL = 5

// Span thresholds separate short sessions from full RTH/Globex sessions and DST transitions.
RTH_MERGE_SPAN_FRACTION = 0.75
GLOBEX_MERGE_SPAN_FRACTION = 0.90

LABEL_MERGE_STRICT = "Strict"
LABEL_MERGE_BALANCED = "Balanced"
LABEL_MERGE_WIDE = "Wide"
LABEL_MERGE_CUSTOM = "Custom"
LABEL_MERGE_STRICT_PERCENT = 0.005
LABEL_MERGE_BALANCED_PERCENT = 0.010
LABEL_MERGE_WIDE_PERCENT = 0.025
DEFAULT_MERGED_LINE_FADE_PERCENT = 85
LABEL_NAME_SEPARATOR = " | "
PERIOD_LABEL_DAY = "Day"
PERIOD_LABEL_MONTH = "Month"
PERIOD_LABEL_QUARTER = "Quarter"

PROFILE_ROWS = 250
HISTOGRAM_SMOOTHING = 7
HISTOGRAM_WIDTH_PERCENT = 25.0

// Compact long-period samples below Pine's array cap using a grid finer than PROFILE_ROWS.
SAMPLE_COMPACT_THRESHOLD = 60000
SAMPLE_COMPACT_ROWS = 6000
// Where HD data is unavailable (deep history, Bar Replay) the chart-bar fallback is folded into
// aligned five-minute buckets so sub-5m charts build the same profiles as a 5m chart.
FALLBACK_PARITY_BUCKET_MS = 5 * 60 * 1000
// Two calendar quarters plus buffer cover the previous completed quarter from any current-quarter date.
QUARTERLY_MAX_TWO_QUARTERS_DAYS = 184
QUARTERLY_HISTORY_BUFFER_DAYS = 16
QUARTERLY_LOOKBACK_DAYS = QUARTERLY_MAX_TWO_QUARTERS_DAYS + QUARTERLY_HISTORY_BUFFER_DAYS
QUARTERLY_CALCULATION_MINUTES = 15
QUARTERLY_INTRABAR_MINUTES = 5
QUARTERLY_CALCULATION_TIMEFRAME = str.tostring(QUARTERLY_CALCULATION_MINUTES)
QUARTERLY_INTRABAR_TIMEFRAME = str.tostring(QUARTERLY_INTRABAR_MINUTES)
QUARTERLY_CALCULATION_BARS = int(QUARTERLY_LOOKBACK_DAYS * MINUTES_PER_DAY / QUARTERLY_CALCULATION_MINUTES)
QUARTERLY_INTRABAR_BARS = int(QUARTERLY_CALCULATION_BARS * QUARTERLY_CALCULATION_MINUTES / QUARTERLY_INTRABAR_MINUTES)
QUARTERLY_SNAPSHOT_MINUTE = MINUTES_PER_HOUR - QUARTERLY_CALCULATION_MINUTES
// Sparse Monday snapshots transfer histogram rows without returning a Profile object on every bar.
QUARTERLY_UTC_WEEKLY_SNAPSHOT_HOUR = 0
QUARTERLY_MARKET_WEEKLY_SNAPSHOT_HOUR = 9

DEFAULT_RTH_PROFILES = 10
DEFAULT_GLOBEX_PROFILES = 10
DEFAULT_WEEKLY_PROFILES = 5
DEFAULT_MONTHLY_PROFILES = 2
DEFAULT_QUARTERLY_PROFILES = 2
DEFAULT_FOCUS_COUNT = 5
// Retention is destructive and runs before the anchor is known, so Focus always searches this deep.
FOCUS_SEARCH_DEPTH = 250
DAILY_PROFILE_ANCHOR_COUNT = 2
RTH_SWEPT_CONTINUATION_WIDTH = 1
GLOBEX_SWEPT_CONTINUATION_WIDTH = 1
WEEKLY_SWEPT_CONTINUATION_WIDTH = 2
MONTHLY_SWEPT_CONTINUATION_WIDTH = 3
QUARTERLY_SWEPT_CONTINUATION_WIDTH = 4
WEEKLY_MATURITY_HISTORY = 5
MONTHLY_MATURITY_HISTORY = 2
QUARTERLY_MATURITY_HISTORY = 2
MATURITY_STABILITY_FRACTION = 0.20
MATURITY_EARLY_VOLUME_THRESHOLD_PERCENT = 45
WEEKLY_UTC_MATURITY_SESSIONS = 4
WEEKLY_MARKET_MATURITY_SESSIONS = 3
WEEKLY_EARLY_MATURITY_SESSIONS = 2
MONTHLY_UTC_MATURITY_SESSIONS = 15
MONTHLY_MARKET_MATURITY_SESSIONS = 10
MONTHLY_UTC_EARLY_MATURITY_SESSIONS = 7
MONTHLY_MARKET_EARLY_MATURITY_SESSIONS = 5
QUARTERLY_UTC_MATURITY_SESSIONS = 45
QUARTERLY_MARKET_MATURITY_SESSIONS = 30
QUARTERLY_UTC_EARLY_MATURITY_SESSIONS = 22
QUARTERLY_MARKET_EARLY_MATURITY_SESSIONS = 15
MAX_STORED_VALUE_GAPS = 100
VALUE_GAP_LINE_BUDGET = 140
VALUE_GAP_LABEL_BUDGET = 140
VALUE_GAP_BOX_BUDGET = 140
VALUE_GAP_CE_LEVEL = 0.50
VALUE_GAP_Q1_LEVEL = 0.25
VALUE_GAP_Q3_LEVEL = 0.75
VALUE_GAP_RIGHT_EDGE_CUSHION = 3
VALUE_GAP_REFERENCE_WIDTH = 1
VALUE_GAP_BOLD_REFERENCE_WIDTH = 2
VALUE_GAP_REMINDER_MAX_PER_LEVEL = 4
MAX_LEVEL_HIT_EVENTS = INDICATOR_MAX_LABELS
MAX_LEVEL_HIT_TRADING_DAY_SCAN = 10
MAX_LEVEL_HIT_WEEKDAY_RETENTION_DAYS = 5
// Ranges are per lower-timeframe sub-bar, so the cap must cover the full scan window in minutes.
MAX_FOCUS_HIT_RANGES = (MAX_LEVEL_HIT_TRADING_DAY_SCAN + 1) * MINUTES_PER_DAY
FOCUS_HIT_RANGE_RETENTION_MS = (MAX_LEVEL_HIT_TRADING_DAY_SCAN + 1) * MS_PER_DAY

// Shared with the gap family in Gaps so the related features read as one visual system.
DEFAULT_VALUE_GAP_BULLISH_UNFILLED_COLOR = color.new(color.rgb(146, 198, 239), 70)
DEFAULT_VALUE_GAP_BEARISH_UNFILLED_COLOR = color.new(color.rgb(244, 143, 177), 65)
DEFAULT_VALUE_GAP_FILLED_COLOR = color.new(color.rgb(219, 219, 219), 91)
DEFAULT_VALUE_GAP_BULLISH_BORDER_COLOR = color.new(color.rgb(49, 121, 245), 35)
DEFAULT_VALUE_GAP_BEARISH_BORDER_COLOR = color.new(color.rgb(194, 24, 91), 50)
DEFAULT_VALUE_GAP_BULLISH_LABEL_COLOR = color.rgb(57, 120, 221)
DEFAULT_VALUE_GAP_BEARISH_LABEL_COLOR = color.rgb(233, 30, 99)
DEFAULT_VALUE_GAP_MIDPOINT_OPEN_COLOR = color.new(color.rgb(74, 74, 74), 40)
DEFAULT_VALUE_GAP_QUARTILE_OPEN_COLOR = color.new(color.rgb(74, 74, 74), 10)
DEFAULT_VALUE_GAP_MITIGATED_REFERENCE_COLOR = color.new(color.rgb(184, 184, 184), 20)
DEFAULT_UPCOMING_VALUE_GAP_COLOR = color.new(color.rgb(255, 238, 88), 85)
DEFAULT_UPCOMING_VALUE_GAP_BORDER_COLOR = color.rgb(251, 192, 45)
VALUE_GAP_LABEL_BG_TRANSPARENT = color.new(color.rgb(255, 255, 255), 100)
VALUE_GAP_MIDPOINT_LABEL_BG = color.new(color.rgb(255, 255, 255), 50)

// Short-session merge modes (how early-close / holiday half-days combine), least-to-most merging.
MERGE_OFF = "Off"
MERGE_EARLIEST = "Earliest Into Previous Full Session"
MERGE_ALL = "All Into Previous Full Session"
MERGE_COMBINE = "Combine Shorts"

// Line styles
STYLE_SOLID = "Solid"
STYLE_DASHED = "Dashed"
STYLE_DOTTED = "Dotted"

// Label sizes
LABEL_SIZE_TINY = "Tiny"
LABEL_SIZE_SMALL = "Small"
LABEL_SIZE_NORMAL = "Normal"
LABEL_SIZE_LARGE = "Large"
LABEL_SIZE_HUGE = "Huge"
LEVEL_HIT_HISTORY_CURRENT_WINDOW = "Current Window"
LEVEL_HIT_HISTORY_ONE_DAY = "1 Day"
LEVEL_HIT_HISTORY_THREE_DAYS = "3 Days"
LEVEL_HIT_HISTORY_ONE_WEEK = "1 Week"
LEVEL_HIT_UNSELECTED_ANCHOR_SYMBOL = "⁺"
LEVEL_HIT_ARCHIVED_SYMBOL = "◌"

// A secondary node qualifies when its volume nearly matches the POC; distance is ignored.
ALTERNATE_POC_WINDOW_FRAC = 0.03  // ignore rows within this fraction of total rows around the POC (its own shoulder)
ALTERNATE_POC_MIN_RATIO = 0.90    // candidate volume must be ≥ this fraction of POC volume to qualify

// Session group labels (each session contains volume profiles)
GROUP_QUICK_FILTER = "⚡ Quick Filter"
GROUP_QUICK_FILTER_SETTINGS = "⚡ Quick Filter: Settings"
GROUP_QUICK_FILTER_PRICES = "⚡ Quick Filter: Prices"
