LABEL_ALTERNATE_POC = "aPOC"
LABEL_HISTOGRAM = "Histogram"
LABEL_HISTOGRAM_INSIDE = "In"
LABEL_HISTOGRAM_OUTSIDE = "Out"
LABEL_BOX = "Box"
LABEL_SHORT_SESSION_MERGE = "Merge Short Session"
LABEL_LEVEL_LABELS = "Price Labels"
LABEL_LEVEL_LABEL_OFFSET = "Price Label Offset"
LABEL_LEVEL_LABEL_BACKGROUND = "Price Label Background"
LABEL_MANUAL_FOCUS_ANCHOR = "Manual Focus Anchor"
