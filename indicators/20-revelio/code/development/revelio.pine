    bool showMidpointLine
    color midpointOpenLineColor
    color midpointMitigatedLineColor
    bool showMidpointLabel
    bool showQuartileLines
    color quartileOpenLineColor
    color quartileMitigatedLineColor
    bool showQuartileLabels
    string internalLabelSize
    int internalLabelFade
    bool showInternalReminders

type SessionStyle
    string extensionMode
    bool dimTouched
    float dimFraction
    bool showPoc
    color pocColor
    int pocWidth
    string pocStyle
    bool showAlternatePoc
    color alternatePocColor
    int alternatePocWidth
