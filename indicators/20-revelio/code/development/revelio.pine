//@version=6

// ═══════════════════════════════════════════════════════════════════════════════
// INDICATOR SETUP
// ═══════════════════════════════════════════════════════════════════════════════
INDICATOR_MAX_LINES = 500
INDICATOR_MAX_LABELS = 500
INDICATOR_MAX_BOXES = 500
INDICATOR_MAX_POLYLINES = 100
INDICATOR_TITLE = 'revelio •'

indicator(INDICATOR_TITLE, overlay=true, max_lines_count=INDICATOR_MAX_LINES, max_labels_count=INDICATOR_MAX_LABELS, max_boxes_count=INDICATOR_MAX_BOXES, max_polylines_count=INDICATOR_MAX_POLYLINES, max_bars_back=5000)

// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════
NY_TIMEZONE = "America/New_York"
UTC_TIMEZONE = "GMT+0"

// Canonical time units. Derived durations below use these instead of repeating unit arithmetic.
MS_PER_HOUR = 60 * 60 * 1000
MS_PER_DAY = 24 * MS_PER_HOUR
MS_PER_WEEK = 7 * MS_PER_DAY
MS_PER_MONTH = 30 * MS_PER_DAY

// Session specification (RTH has a daily gap; the 24h sessions are anchored by NY calendar below)
RTH_SESSION = "0930-1600:23456"      // Regular cash session, Mon-Fri (session-based assets)
RTH_SESSION_ALL_DAYS = "0930-1600:1234567"  // Same 09:30-16:00 NY window every day (24/7 assets)
WEEKLY_REOPEN_SESSION = "1800-0930"  // Sunday 18:00 NY futures reopen edge
SUNDAY_REOPEN_START_HOUR = 18
GLOBEX_REOPEN_SHIFT_MS = 6 * MS_PER_HOUR
SECONDS_PER_WEEK = 604800
ASSET_DETECTION_MAX_LOOKBACK = 4999

// Recurring NY-time windows Show Only can keep visible — everything outside the chosen window is greyed
// (each repeats every day; the overnight window crosses midnight, which Pine session strings handle as
// end < start). Listed in dropdown order, narrowing from the widest span down to RTH.
SESSION_WINDOW_OVERNIGHT = "1600-0500:1234567" // 16:00–05:00 — the standard overnight
SESSION_WINDOW_FROM_0500 = "0500-1600:1234567" // 05:00–16:00 — premarket into the cash session
SESSION_WINDOW_FROM_0830 = "0830-1600:1234567" // 08:30–16:00 — the 08:30 open through the cash close
SESSION_WINDOW_RTH = "0930-1600:1234567"       // 09:30–16:00 — the regular trading hours cash session

BRAND_BULLET = "•"
SWEPT_CHECKMARK = "✓"

START_TIME_UNSET = -1

// Level extension / mitigation modes
LEVEL_PERIOD = "Session Only"
LEVEL_BREACH_ANY = "Until Touched"
LEVEL_BREACH_SAME = "Same-Session Touch"
LEVEL_BREACH_SWEEP = "Until Swept"

VALUE_GAP_SOURCE_RTH = "RTH"
VALUE_GAP_SOURCE_GLOBEX = "Globex"

// The confirming session cannot fill its own value-area gap.
VALUE_GAP_FILL_PRICE = "Any Price"
VALUE_GAP_FILL_FROM_0500 = "05:00 + RTH"
VALUE_GAP_FILL_RTH = "RTH Session"
VALUE_GAP_DISPLAY_HISTORICAL = "Historical"
VALUE_GAP_DISPLAY_HISTORICAL_FLOATING = "Historical + Floating"
VALUE_GAP_DISPLAY_RECENT_FLOATING = "Most Recent + Floating"
VALUE_GAP_DISPLAY_FLOATING = "Floating Only"
LABEL_REMINDERS = "Reminders"
LABEL_FADE_PERCENT = "Fade %"
ANCHOR_LABEL_MODE_OFF = "Off"
ANCHOR_LABEL_MODE_ONCE = "Once"
ANCHOR_LABEL_MODE_REMINDERS = LABEL_REMINDERS
ANCHOR_REMINDER_MIN_SPACING_MS = int(5 * MS_PER_DAY / 2)

// A session whose bar-span is below this fraction of the longest session seen is treated as
// an early close / holiday half-day and merged per the selected mode. Per-anchor thresholds:
// RTH half-days (09:30-13:00) are ~54% of the full 6.5h cash session, so 0.75 separates cleanly.
// A Globex day is ~23h, so a 13:00 early close still spans ~19h (~83%) — 0.75 would miss it.
// 0.90 catches early closes while DST-transition days (22h/24h, ~92-96%) stay full sessions.
RTH_MERGE_SPAN_FRACTION = 0.75
GLOBEX_MERGE_SPAN_FRACTION = 0.90

// Right-edge level labels whose prices fall within this fraction of price are collapsed into ONE label
// (names joined by the separator), so coincident levels across anchors don't stack on top of each other.
LABEL_MERGE_PCT = 0.005 / 100
LABEL_NAME_SEPARATOR = " | "

PROFILE_ROWS = 250
HISTOGRAM_SMOOTHING = 7
HISTOGRAM_WIDTH_PERCENT = 25.0

// Per-period sample arrays are compacted into a fine histogram once they pass the
// threshold, keeping them well under Pine's 100,000-element array cap on long anchors
// (weekly/monthly/globex) at fine intrabar resolutions (1S on 1-minute charts). The
// working grid is much finer than PROFILE_ROWS so repeated compaction does not degrade
// the final profile.
SAMPLE_COMPACT_THRESHOLD = 60000
SAMPLE_COMPACT_ROWS = 6000

DEFAULT_RTH_PROFILES = 10
DEFAULT_GLOBEX_PROFILES = 10
DEFAULT_WEEKLY_PROFILES = 5
DEFAULT_MONTHLY_PROFILES = 2
MAX_STORED_VALUE_GAPS = 100
VALUE_GAP_LINE_BUDGET = 140
VALUE_GAP_LABEL_BUDGET = 140
VALUE_GAP_BOX_BUDGET = 140
VALUE_GAP_CE_LEVEL = 0.50
VALUE_GAP_Q1_LEVEL = 0.25
VALUE_GAP_Q3_LEVEL = 0.75
VALUE_GAP_RIGHT_EDGE_CUSHION = 3
VALUE_GAP_REFERENCE_WIDTH = 1
VALUE_GAP_BOLD_REFERENCE_WIDTH = 2
VALUE_GAP_REMINDER_MAX_PER_LEVEL = 4

// Shared with the gap family in Gaps so the related features read as one visual system.
DEFAULT_VALUE_GAP_BULLISH_UNFILLED_COLOR = color.new(color.rgb(146, 198, 239), 90)
DEFAULT_VALUE_GAP_BEARISH_UNFILLED_COLOR = color.new(color.rgb(244, 143, 177), 85)
DEFAULT_VALUE_GAP_FILLED_COLOR = color.new(color.rgb(219, 219, 219), 91)
DEFAULT_VALUE_GAP_BULLISH_BORDER_COLOR = color.new(color.rgb(146, 198, 239), 80)
DEFAULT_VALUE_GAP_BEARISH_BORDER_COLOR = color.new(color.rgb(136, 14, 79), 80)
DEFAULT_VALUE_GAP_BULLISH_LABEL_COLOR = color.rgb(77, 208, 225)
DEFAULT_VALUE_GAP_BEARISH_LABEL_COLOR = color.rgb(244, 143, 177)
DEFAULT_VALUE_GAP_MIDPOINT_OPEN_COLOR = color.new(color.rgb(74, 74, 74), 40)
DEFAULT_VALUE_GAP_QUARTILE_OPEN_COLOR = color.new(color.rgb(74, 74, 74), 10)
DEFAULT_VALUE_GAP_MITIGATED_REFERENCE_COLOR = color.new(color.rgb(184, 184, 184), 20)
DEFAULT_UPCOMING_VALUE_GAP_COLOR = color.new(color.rgb(255, 238, 88), 85)
DEFAULT_UPCOMING_VALUE_GAP_BORDER_COLOR = color.rgb(251, 192, 45)
VALUE_GAP_LABEL_BG_TRANSPARENT = color.new(color.rgb(255, 255, 255), 100)
VALUE_GAP_MIDPOINT_LABEL_BG = color.new(color.rgb(255, 255, 255), 50)

// Short-session merge modes (how early-close / holiday half-days combine), least-to-most merging.
MERGE_OFF = "Off"
MERGE_EARLIEST = "Earliest Into Previous Full Session"
MERGE_ALL = "All Into Previous Full Session"
MERGE_COMBINE = "Combine Shorts"

// Line styles
STYLE_SOLID = "Solid"
STYLE_DASHED = "Dashed"
STYLE_DOTTED = "Dotted"

// Label sizes
LABEL_SIZE_TINY = "Tiny"
LABEL_SIZE_SMALL = "Small"
LABEL_SIZE_NORMAL = "Normal"
LABEL_SIZE_LARGE = "Large"
LABEL_SIZE_HUGE = "Huge"

// Alternate-POC qualification (volume-only, distance ignored): a secondary node qualifies when nearly
// as heavy as the POC — that near-tie is what lets a timeframe / HD change flip the POC onto it.
ALTERNATE_POC_WINDOW_FRAC = 0.03  // ignore rows within this fraction of total rows around the POC (its own shoulder)
ALTERNATE_POC_MIN_RATIO = 0.90    // candidate volume must be ≥ this fraction of POC volume to qualify

// Session group labels (each session contains volume profiles)
GROUP_QUICK_FILTER = "⚡ Quick Filter"
GROUP_QUICK_FILTER_SETTINGS = "⚡ Quick Filter: Settings"
GROUP_DISPLAY = "⚙️ Display"
GROUP_LABELS = "🏷️ Labels"
GROUP_SWEEP = "🧹 Sweep"
GROUP_RTH = "🗽 RTH"
GROUP_VALUE_GAPS = "📊 Value Gaps"
GROUP_VALUE_GAPS_RIGHT_EDGE = "📊 Value Gaps — Right Edge"
GROUP_RTH_SWEPT = "🗽 RTH: Swept"
GROUP_GLOBEX = "🌅 Globex"
GROUP_GLOBEX_SWEPT = "🌅 Globex: Swept"
GROUP_WEEKLY = "📅 Weekly"
GROUP_WEEKLY_SWEPT = "📅 Weekly: Swept"
GROUP_MONTHLY = "🗓️ Monthly"
GROUP_MONTHLY_SWEPT = "🗓️ Monthly: Swept"
GROUP_UTILITY = "🎨 Utility"

SESSION_RTH = "RTH"
SESSION_GLOBEX = "Globex"
SESSION_WEEKLY = "Weekly"
SESSION_MONTHLY = "Monthly"

LABEL_ENABLE_RTH = "Enable RTH Session"
LABEL_ENABLE_GLOBEX = "Enable Globex Session"
LABEL_ENABLE_WEEKLY = "Enable Weekly Session"
LABEL_ENABLE_MONTHLY = "Enable Monthly Session"
LABEL_DIM_TOUCHED = "Fade Mitigated Levels"
LABEL_DIM_PERCENT = "%"
LABEL_VALUE_AREA_HIGH_LOW = "VAH/L"
LABEL_VAH = "VAH"
LABEL_VAL = "VAL"
LABEL_POC = "POC"
LABEL_ALTERNATE_POC = "aPOC"
LABEL_ENABLE_VALUE_GAPS = "Enable Value Gaps"
LABEL_VALUE_AREA = "Value"
LABEL_HISTOGRAM_INSIDE = "In"
LABEL_HISTOGRAM_OUTSIDE = "Out"
LABEL_SESSION_BOX = "Session Box"
LABEL_SHORT_SESSION_MERGE = "Merge Short Session"
LABEL_SHOW_PRICE = "Show Price"
LABEL_LEVEL_LABELS = "Price Labels"
LABEL_LEVEL_LABEL_OFFSET = "Price Label Offset"
LABEL_LEVEL_LABEL_BACKGROUND = "Price Label Background"
TOOLTIP_SHOW_PRICE = "Each open, untouched level still extending right (POC, VAH/VAL, aPOC) is always tagged with its anchor + level name. On also appends the price, e.g. 'RTH POC • 5312.50'.\n\nOff = name only."
LABEL_DEVELOPING_PROFILE = "Style Developing Profile"
LABEL_SWEPT = "Swept"
LABEL_SWEEP_CONFIRM_MARGIN = "Sweep Confirmation Percent Margin"
LABEL_SWEPT_CONTINUATION_LINE_FADE = "Level Fade Percent"
LABEL_SWEPT_LABEL_TEXT_FADE = "Label Text Fade"
LABEL_RTH_SWEPT_KEEP = "Days to Keep RTH Swept Lines"
LABEL_WEEKLY_SWEPT_KEEP = "Weeks to Keep Weekly Swept Lines"
LABEL_MONTHLY_SWEPT_KEEP = "Months to Keep Monthly Swept Lines"
LABEL_SWEPT_CONTINUATION_LINE_WIDTH = "Swept Line Width"
LABEL_SWEPT_REMINDER = "Swept Line Reminders"
LABEL_SWEPT_REMINDER_DATE = "Date on Reminders"
TOOLTIP_SWEPT_REMINDER = "Drops a sparse identity tag (anchor + level, e.g. 'Weekly VAH') onto the dashed swept-continuation lines so you can tell which faded line is which when scrolled away from the right-edge label. Count grows with the line's length but stays sparse. Off = right-edge label only."
TOOLTIP_SWEPT_REMINDER_DATE = "Append the profile's date to each swept-line reminder, e.g. 'Weekly POC June 26', so a reminder also says which period it came from. Off = anchor and level only."
TOOLTIP_SWEEP_MARGIN = "For 'Until Swept' only. A close counts as a clean departure to one side when it is beyond the level by at least this percentage of the profile's high-low range. The level is swept once price has done this on both sides, which keeps tick-chop on the level from counting."
TOOLTIP_SWEPT_CONTINUATION_LINE_WIDTH = "Width of the dashed continuation line drawn after this anchor's level is swept, so it can differ from the anchor's main line width."
TOOLTIP_SWEPT_CONTINUATION_LINE_FADE = "Extra fade applied to the dashed continuation of swept levels, on top of the Fade Mitigated Levels setting."
TOOLTIP_SWEPT_LABEL_TEXT_FADE = "Extra fade applied only to swept level label text. 0 = keep the normal label text color; 100 = fully transparent."
TOOLTIP_RTH_SWEPT_KEEP = "RTH only. Beyond the most recent RTH profile (always kept), also keep the faded continuation of older swept levels whose sweep happened within this many days. A whole profile is kept when its most recent sweep falls inside the window. 0 = only the most recent RTH profile's swept levels are kept."
TOOLTIP_WEEKLY_SWEPT_KEEP = "Weekly only. Beyond the most recent weekly profile (always kept), also keep the faded continuation of older swept levels whose sweep happened within this many weeks. A whole profile is kept when its most recent sweep falls inside the window. 0 = only the most recent weekly profile's swept levels are kept."
TOOLTIP_MONTHLY_SWEPT_KEEP = "Monthly only. Beyond the most recent monthly profile (always kept), also keep the faded continuation of older swept levels whose sweep happened within this many months. A whole profile is kept when its most recent sweep falls inside the window. 0 = only the most recent monthly profile's swept levels are kept."
// Safety ceiling on identity reminders per swept line. The count is normally set by the square-root rule
// below (grows with length, sublinearly); this only guards the label budget on extreme runs.
SWEPT_REMINDER_MAX_PER_LINE = 8

// Reminder count keys off a swept line's absolute length, not the anchor's period, so physical chart
// distance drives density uniformly: a line earns a 2nd reminder at ~2.25× this, a 3rd at ~6.25×, etc.
SWEPT_REMINDER_BASE_MS = 3 * MS_PER_DAY
LABEL_RTH_ANCHOR = "RTH"
LABEL_RTH_LIVE = "★ Today's RTH"
LABEL_RTH_LAST = "PREV RTH"
LABEL_GLOBEX_ANCHOR = "Globex"
LABEL_GLOBEX_LIVE = "Today's Globex"
LABEL_GLOBEX_LAST = "PREV GLOBEX"
LABEL_WEEKLY_ANCHOR = "Weekly"
LABEL_WEEKLY_LIVE = "★ This Week's"
LABEL_WEEKLY_LAST = "LAST WEEK'S"
LABEL_MONTHLY_ANCHOR = "Monthly"
LABEL_MONTHLY_LIVE = "★ This Month's"
LABEL_MONTHLY_LAST = "LAST MONTH'S"
LABEL_TABLE_SETTING = "Setting"
LABEL_TABLE_RGB = "RGB"
LABEL_TABLE_TRANSPARENCY = "Trans"
LABEL_TABLE_WIDTH = "Width"

LABEL_LAST_VALUE_AREA_COLOR = "Last VAH/L"
TOOLTIP_LAST_VALUE_AREA_COLOR = "VAH/VAL color for the most recent completed profile."
TOOLTIP_VALUE_AREA_ROW = "VAH/L row: first swatch = line color; dropdowns = width and style; last swatch = label text color."
TOOLTIP_POC_ROW = "POC row: first swatch = line color; dropdowns = width and style; last swatch = label text color."
TOOLTIP_ALTERNATE_POC_ROW = "aPOC marks a secondary node nearly as heavy as the main POC, so an HD or timeframe change could shift the POC onto it. First swatch = line color; dropdowns = width and style; last swatch = label text color."
TOOLTIP_LAST_VALUE_AREA_ROW = TOOLTIP_LAST_VALUE_AREA_COLOR + " The dropdown sets its width."
TOOLTIP_HISTOGRAM_ROW = "Session Box toggles and colors the profile period background. Value toggles the volume histogram; In colors rows inside value area and Out colors rows outside it."
TOOLTIP_DIM_ROW = "Fade touched levels by the selected percentage so untouched levels retain full strength. Only meaningful in Until Touched mode."
TOOLTIP_PRICE_LABEL_ROW = TOOLTIP_SHOW_PRICE + " The dropdown sets label size."

FILTER_ALL = "Manual"
FILTER_CORE = "☾ Core"
FILTER_PREP = "★ Prep: Core + Globex"
FILTER_INTRADAY = "Intraday: RTH + Globex"
FILTER_DUO = "◐ Duo: RTH + Weekly"
FILTER_SWING = "Swing: Weekly + Monthly"
FILTER_VALUE_GAPS = "Value Gaps"
FILTER_RTH_ONLY = "RTH Only"
FILTER_GLOBEX_ONLY = "Globex Only"
FILTER_WEEKLY_ONLY = "Weekly Only"
FILTER_MONTHLY_ONLY = "Monthly Only"
TOOLTIP_QUICK_FILTER = "Quickly switch which profiles are shown. Each anchor always draws its Show Last count (set in Quick Filter: Settings), in every mode.\n\n• Manual — respect each session's own Enable toggle\n• Core — RTH, Weekly and Monthly (no Globex)\n• Prep: Core + Globex — Core plus the Globex anchor\n• Intraday: RTH + Globex — those two anchors only\n• ◐ Duo: RTH + Weekly — those two anchors only\n• Swing: Weekly + Monthly — those two anchors only\n• Value Gaps — the gap Source anchor and its value gaps only; forces VAH/VAL to Until Touched and hides POC/aPOC\n• RTH / Globex / Weekly / Monthly Only — that one anchor only\n\nIn every mode except Manual, an anchor's developing/current profile appears only when its Include Developing toggle below is on, so you can keep the chart to completed profiles."
TOOLTIP_RTH_PROFILES = "How many recent RTH profiles to keep and draw. The single Show Last count for this anchor — applies in every Quick Filter mode."
TOOLTIP_GLOBEX_PROFILES = "How many recent Globex profiles to keep and draw. The single Show Last count for this anchor — applies in every Quick Filter mode."
TOOLTIP_WEEKLY_PROFILES = "How many recent weekly profiles to keep and draw. Kept separate so a week of daily profiles doesn't pull weeks of weekly profiles. Applies in every Quick Filter mode."
TOOLTIP_MONTHLY_PROFILES = "How many recent monthly profiles to keep and draw. Applies in every Quick Filter mode."
TOOLTIP_DEVELOPING_RTH = "Applies to every Quick Filter except Manual. When on, also show today's developing RTH profile; when off, only completed RTH profiles show."
TOOLTIP_DEVELOPING_GLOBEX = "Applies to every Quick Filter except Manual. When on, also show the current developing Globex profile; when off, only completed Globex profiles show."
TOOLTIP_DEVELOPING_WEEKLY = "Applies to every Quick Filter except Manual. When on, also show the current developing weekly profile; when off, only completed weekly profiles show."
TOOLTIP_DEVELOPING_MONTHLY = "Applies to every Quick Filter except Manual. When on, also show the current developing monthly profile; when off, only completed monthly profiles show."
TOOLTIP_HIGHLIGHT_CURRENT = "Frame the current developing session's box so it stands out among the other profiles. Only acts on the developing profile (needs its Current toggle on) and works whether or not the normal Session Box is enabled. While on, this anchor's completed profiles drop their session boxes so only the current period is framed."
TOOLTIP_HIGHLIGHT_OPACITY = "Fill opacity of the highlighted current-session box. 0 = invisible, 100 = fully opaque. Uses the anchor's Session Box color."

// Show Only: keep the chosen recurring NY-time window lit and grey out everything else, so the volume
// profiles read cleanly without manually changing chart colors. Leading dots count how far before the
// RTH open the window starts (● ● RTH from 05:00, ● RTH from 08:30); exact hours live in the tooltip to
// keep the dropdown uncluttered. Daily.
SHOW_OVERNIGHT = "Overnight"
SHOW_FROM_0500 = "● ● RTH"
SHOW_FROM_0830 = "● RTH"
SHOW_RTH = "RTH"
SHOW_ONLY_MAX_TIMEFRAME_SECONDS = 60 * 60  // Feature is intraday-only: inactive above the 1-hour chart timeframe
LABEL_SHOW_ONLY = "Show Only"
LABEL_HIDDEN_CANDLES = "Hidden Candles"
LABEL_MOST_RECENT_ONLY = "Most Recent Only"
TOOLTIP_SHOW_ONLY = "Keep only the chosen NY-time window lit and grey out (recolor body, wick and outline) every candle outside it, every day, so the volume profiles stand out without manually changing chart colors. The color picker sets the hidden-candle color; the dropdown picks WHICH session stays visible:\n• Overnight (16:00–05:00) — the standard overnight session\n• ● ● RTH (05:00–16:00) — premarket into the cash session\n• ● RTH (08:30–16:00) — the 08:30 open through the cash close\n• RTH (09:30–16:00) — the regular trading hours cash session\n\nIntraday only — no effect above the 1-hour timeframe."
TOOLTIP_MOST_RECENT_ONLY = "Narrows Show Only to a single occurrence: mutes every EARLIER copy of the chosen window too, leaving only the current NY date's occurrence lit, so today's price action reads in isolation. Lines, profiles and labels stay fully visible.\n\nMutes on the candle level only, so 'most recent' follows the calendar date — while a session is live this is the latest occurrence; with no session today (weekend/holiday) nothing in the window is lit until the next one opens.\n\nOff = every day's window stays lit."

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Quick Filter
// ═══════════════════════════════════════════════════════════════════════════════
quickFilter = input.string(FILTER_INTRADAY, "Quick Filter", options=[FILTER_ALL, FILTER_CORE, FILTER_PREP, FILTER_INTRADAY, FILTER_DUO, FILTER_SWING, FILTER_VALUE_GAPS, FILTER_RTH_ONLY, FILTER_GLOBEX_ONLY, FILTER_WEEKLY_ONLY, FILTER_MONTHLY_ONLY], group=GROUP_QUICK_FILTER, tooltip=TOOLTIP_QUICK_FILTER)
includeDevelopingRth = input.bool(false, "+RTH", inline="ov_dev", group=GROUP_QUICK_FILTER)
includeDevelopingGlobex = input.bool(false, "+Globex", inline="ov_dev", group=GROUP_QUICK_FILTER)
includeDevelopingWeekly = input.bool(false, "+Weekly", inline="ov_dev", group=GROUP_QUICK_FILTER)
includeDevelopingMonthly = input.bool(true, "+Monthly", inline="ov_dev", group=GROUP_QUICK_FILTER, tooltip="+RTH\n" + TOOLTIP_DEVELOPING_RTH + "\n\n+Globex\n" + TOOLTIP_DEVELOPING_GLOBEX + "\n\n+Weekly\n" + TOOLTIP_DEVELOPING_WEEKLY + "\n\n+Monthly\n" + TOOLTIP_DEVELOPING_MONTHLY)
showOnlyEnabled = input.bool(true, LABEL_SHOW_ONLY, inline="show_only", group=GROUP_QUICK_FILTER)
hiddenCandleColor = input.color(color.new(color.rgb(245, 245, 245), 10), "", inline="show_only", group=GROUP_QUICK_FILTER)
visibleWindow = input.string(SHOW_RTH, "", options=[SHOW_OVERNIGHT, SHOW_FROM_0500, SHOW_FROM_0830, SHOW_RTH], inline="show_only", group=GROUP_QUICK_FILTER)
showOnlyMostRecent = input.bool(false, LABEL_MOST_RECENT_ONLY, inline="show_only", group=GROUP_QUICK_FILTER, tooltip=TOOLTIP_SHOW_ONLY + "\n\n———\n\n" + LABEL_MOST_RECENT_ONLY + "\n" + TOOLTIP_MOST_RECENT_ONLY)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Quick Filter: Settings
// ═══════════════════════════════════════════════════════════════════════════════
rthProfilesToShow = input.int(DEFAULT_RTH_PROFILES, "Show Last  ·  RTH", minval=1, maxval=50, inline="ov_counts", group=GROUP_QUICK_FILTER_SETTINGS)
globexProfilesToShow = input.int(DEFAULT_GLOBEX_PROFILES, "Globex", minval=1, maxval=50, inline="ov_counts", group=GROUP_QUICK_FILTER_SETTINGS, tooltip="RTH\n" + TOOLTIP_RTH_PROFILES + "\n\nGlobex\n" + TOOLTIP_GLOBEX_PROFILES)
weeklyProfilesToShow = input.int(DEFAULT_WEEKLY_PROFILES, "Weekly", minval=1, maxval=50, inline="ov_counts2", group=GROUP_QUICK_FILTER_SETTINGS)
monthlyProfilesToShow = input.int(DEFAULT_MONTHLY_PROFILES, "Monthly", minval=1, maxval=50, inline="ov_counts2", group=GROUP_QUICK_FILTER_SETTINGS, tooltip="Weekly\n" + TOOLTIP_WEEKLY_PROFILES + "\n\nMonthly\n" + TOOLTIP_MONTHLY_PROFILES)
weeklyHighlightEnabled = input.bool(false, "Weekly Current Highlight", inline="hl_weekly", group=GROUP_QUICK_FILTER_SETTINGS)
weeklyHighlightOpacity = input.int(2, "Opacity", minval=0, maxval=100, inline="hl_weekly", group=GROUP_QUICK_FILTER_SETTINGS, tooltip=TOOLTIP_HIGHLIGHT_CURRENT + "\n\n" + TOOLTIP_HIGHLIGHT_OPACITY)
monthlyHighlightEnabled = input.bool(false, "Monthly Current Highlight", inline="hl_monthly", group=GROUP_QUICK_FILTER_SETTINGS)
monthlyHighlightOpacity = input.int(2, "Opacity", minval=0, maxval=100, inline="hl_monthly", group=GROUP_QUICK_FILTER_SETTINGS, tooltip=TOOLTIP_HIGHLIGHT_CURRENT + "\n\n" + TOOLTIP_HIGHLIGHT_OPACITY)
rthMergeMode = input.string(MERGE_ALL, LABEL_SHORT_SESSION_MERGE + "  ·  RTH", options=[MERGE_OFF, MERGE_EARLIEST, MERGE_ALL, MERGE_COMBINE], inline="ov_merge", group=GROUP_QUICK_FILTER_SETTINGS)
globexMergeMode = input.string(MERGE_ALL, "Globex", options=[MERGE_OFF, MERGE_EARLIEST, MERGE_ALL, MERGE_COMBINE], inline="ov_merge", group=GROUP_QUICK_FILTER_SETTINGS, tooltip="How short sessions (early closes / holiday half-days) fold into the prior full one. A session counts as short when its bar span falls under a cutoff of the longest session of that anchor seen:\n• RTH — under 75% (an RTH half-day is ~54% of the 6.5h cash session)\n• Globex — under 90% (a full day runs ~23h, so even a 13:00 early close trims only a few hours, which is why the cutoff is tighter than RTH's)\n\nModes (each applies to both RTH and Globex):\n• Off — every short session stands alone\n• Earliest Into Previous Full Session — only the earliest (oldest) short folds into the prior full session; later shorts stand alone\n• All Into Previous Full Session — all consecutive shorts fold into the prior full session\n• Combine Shorts — consecutive shorts merge into one block, leaving the prior full session intact")

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — RTH session
// ═══════════════════════════════════════════════════════════════════════════════
rthEnabled = input.bool(true, LABEL_ENABLE_RTH, inline="rth_top", group=GROUP_RTH)
rthExtensionMode = input.string(LEVEL_BREACH_SWEEP, "", options=[LEVEL_PERIOD, LEVEL_BREACH_ANY, LEVEL_BREACH_SAME, LEVEL_BREACH_SWEEP], inline="rth_top", group=GROUP_RTH, tooltip="Build a volume profile for each Regular Trading Hours cash session (09:30–16:00 New York time, Mon–Fri).\n\nHow the POC and Value Area High / Low extend after the session closes:\n• Session Only — stays within its session\n• Until Touched — extends right, stops at the first bar that trades through it\n• Same-Session Touch — stops only when a later RTH session trades through it\n• Until Swept — stays live through touches until price has cleanly closed beyond it on BOTH sides (a two-sided sweep), then stops")
rthShowValueArea = input.bool(true, LABEL_VALUE_AREA_HIGH_LOW, inline="rth_value_area", group=GROUP_RTH)
rthValueAreaColor = input.color(color.new(color.rgb(144, 191, 249), 0), "", inline="rth_value_area", group=GROUP_RTH)
rthValueAreaWidth = input.string("2", "", options=["1", "2", "3", "4", "5"], inline="rth_value_area", group=GROUP_RTH)
rthValueAreaStyle = input.string(STYLE_SOLID, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="rth_value_area", group=GROUP_RTH)
rthValueAreaLabelColor = input.color(color.new(color.rgb(24, 72, 204), 20), "", inline="rth_value_area", group=GROUP_RTH, tooltip=TOOLTIP_VALUE_AREA_ROW)
rthValueAreaLastColor = input.color(color.new(color.rgb(73, 128, 216), 0), LABEL_LAST_VALUE_AREA_COLOR, inline="rth_value_area_last", group=GROUP_RTH)
rthValueAreaLastWidth = input.string("2", "", options=["1", "2", "3", "4", "5"], inline="rth_value_area_last", group=GROUP_RTH, tooltip=TOOLTIP_LAST_VALUE_AREA_ROW)
rthShowPoc = input.bool(true, LABEL_POC, inline="rth_poc", group=GROUP_RTH)
rthPocColor = input.color(color.new(color.rgb(156, 39, 176), 0), "", inline="rth_poc", group=GROUP_RTH)
rthPocWidth = input.string("2", "", options=["1", "2", "3", "4", "5"], inline="rth_poc", group=GROUP_RTH)
rthPocStyle = input.string(STYLE_DASHED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="rth_poc", group=GROUP_RTH)
rthPocLabelColor = input.color(color.new(color.rgb(123, 31, 162), 0), "", inline="rth_poc", group=GROUP_RTH, tooltip=TOOLTIP_POC_ROW)
rthShowAlternatePoc = input.bool(false, LABEL_ALTERNATE_POC, inline="rth_altpoc", group=GROUP_RTH)
rthAlternatePocColor = input.color(color.new(color.rgb(233, 30, 99), 0), "", inline="rth_altpoc", group=GROUP_RTH)
rthAlternatePocWidth = input.string("2", "", options=["1", "2", "3", "4", "5"], inline="rth_altpoc", group=GROUP_RTH)
rthAlternatePocStyle = input.string(STYLE_DOTTED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="rth_altpoc", group=GROUP_RTH)
rthAlternatePocLabelColor = input.color(color.new(color.rgb(194, 24, 91), 0), "", inline="rth_altpoc", group=GROUP_RTH, tooltip=TOOLTIP_ALTERNATE_POC_ROW)
rthShowSessionBox = input.bool(false, LABEL_SESSION_BOX, inline="rth_hist", group=GROUP_RTH)
rthSessionBoxColor = input.color(color.new(color.rgb(187, 217, 251), 90), "", inline="rth_hist", group=GROUP_RTH)
rthShowHistogram = input.bool(true, LABEL_VALUE_AREA, inline="rth_hist", group=GROUP_RTH)
rthHistogramInsideColor = input.color(color.new(color.rgb(91, 156, 246), 75), LABEL_HISTOGRAM_INSIDE, inline="rth_hist", group=GROUP_RTH)
rthHistogramOutsideColor = input.color(color.new(color.rgb(184, 184, 184), 80), LABEL_HISTOGRAM_OUTSIDE, inline="rth_hist", group=GROUP_RTH, tooltip=TOOLTIP_HISTOGRAM_ROW)
rthDimTouched = input.bool(true, LABEL_DIM_TOUCHED, inline="rth_dim", group=GROUP_RTH)
rthDimPercent = input.int(85, LABEL_DIM_PERCENT, minval=0, maxval=100, inline="rth_dim", group=GROUP_RTH, tooltip=TOOLTIP_DIM_ROW)
rthShowPrice = input.bool(false, LABEL_SHOW_PRICE, inline="rth_labels", group=GROUP_RTH)
rthLevelLabelSize = input.string(LABEL_SIZE_SMALL, "", options=[LABEL_SIZE_TINY, LABEL_SIZE_SMALL, LABEL_SIZE_NORMAL, LABEL_SIZE_LARGE, LABEL_SIZE_HUGE], inline="rth_labels", group=GROUP_RTH, tooltip=TOOLTIP_PRICE_LABEL_ROW)
rthDevelopingEnabled = input.bool(true, LABEL_DEVELOPING_PROFILE, inline="rth_developing", group=GROUP_RTH)
rthDevelopingColor = input.color(color.new(color.rgb(184, 184, 184), 20), "", inline="rth_developing", group=GROUP_RTH, tooltip="Temporarily recolor the live RTH profile — every line and label — before the cutoff so it reads as still developing.")
rthDevelopingCutoffHour = input.int(11, "Developing Cutoff", minval=0, maxval=23, inline="rth_developing_cutoff", group=GROUP_RTH)
rthDevelopingCutoffMinute = input.int(30, ":", minval=0, maxval=59, inline="rth_developing_cutoff", group=GROUP_RTH, tooltip="New York cutoff time. Developing colors apply only before this HH:MM.")
// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — value-area gaps
// ═══════════════════════════════════════════════════════════════════════════════
valueGapsEnabled = input.bool(true, LABEL_ENABLE_VALUE_GAPS, inline="vag_top", group=GROUP_VALUE_GAPS)
valueGapsToShow = input.int(20, "", minval=1, maxval=50, inline="vag_top", group=GROUP_VALUE_GAPS)
valueGapSource = input.string(VALUE_GAP_SOURCE_RTH, "Source", options=[VALUE_GAP_SOURCE_RTH, VALUE_GAP_SOURCE_GLOBEX], inline="vag_top", group=GROUP_VALUE_GAPS, tooltip="Compare consecutive completed value areas of the Source anchor, after short-session merging. A bullish gap forms when the new VAL is above the prior VAH; a bearish gap forms when the new VAH is below the prior VAL. The number sets how many historical gaps can be shown.\n\nSource keeps building its profiles even when a Quick Filter hides that anchor, so the gaps stay correct.")
valueGapDisplayMode = input.string(VALUE_GAP_DISPLAY_HISTORICAL_FLOATING, "Display", options=[VALUE_GAP_DISPLAY_HISTORICAL, VALUE_GAP_DISPLAY_HISTORICAL_FLOATING, VALUE_GAP_DISPLAY_RECENT_FLOATING, VALUE_GAP_DISPLAY_FLOATING], inline="vag_display", group=GROUP_VALUE_GAPS)
valueGapFillMode = input.string(VALUE_GAP_FILL_PRICE, "Fill", options=[VALUE_GAP_FILL_PRICE, VALUE_GAP_FILL_FROM_0500, VALUE_GAP_FILL_RTH], inline="vag_display", group=GROUP_VALUE_GAPS)
valueGapTraversalFill = input.bool(false, "Traversal", inline="vag_display", group=GROUP_VALUE_GAPS)
valueGapNearestFloats = input.int(0, "Nearest", minval=0, maxval=5, inline="vag_display", group=GROUP_VALUE_GAPS, tooltip="Traversal changes what counts as mitigation.\n\nOff — a gap is filled once eligible price reaches its far edge. Price that jumps the gap during ineligible hours and reopens on the other side therefore reads as a full fill, even though no eligible price traded inside it.\n\nOn — only price that actually trades through the gap fills it, and the gap re-sides itself when price settles on the other side. A bullish gap flushed overnight and reopened below stays open as an overhead target, to be filled from beneath. A gap eaten from both sides shows filled ends and a shrinking untraded middle.\n\nFill controls which prices advance mitigation:\n• Any Price — every session counts\n• 05:00 + RTH — New York price from 05:00 through 16:00 counts\n• RTH Session — only 09:30 through 16:00 counts\n\nDisplay chooses anchored history, right-edge floating gaps, or both. Nearest adds this many open gaps by distance from current price; the most recent open gap always floats in a floating mode.")
bullishValueGapUnfilledColor = input.color(DEFAULT_VALUE_GAP_BULLISH_UNFILLED_COLOR, "+", inline="vag_fill", group=GROUP_VALUE_GAPS)
bearishValueGapUnfilledColor = input.color(DEFAULT_VALUE_GAP_BEARISH_UNFILLED_COLOR, "−", inline="vag_fill", group=GROUP_VALUE_GAPS)
valueGapFilledColor = input.color(DEFAULT_VALUE_GAP_FILLED_COLOR, "✓", inline="vag_fill", group=GROUP_VALUE_GAPS)
hideFilledValueGaps = input.bool(true, "Hide", inline="vag_fill", group=GROUP_VALUE_GAPS)
boldLastFilledValueGap = input.bool(true, "Bold Last ✓", inline="vag_fill", group=GROUP_VALUE_GAPS, tooltip="+ / − set open bullish/bearish fill; ✓ sets the mitigated portion. Hide removes gaps after they reach 100%.\n\nBold Last ✓ draws the most recently mitigated gap's border and 50% / Q lines at width 2, so the last gap price closed stands out from the older mitigated ones. No effect while Hide is on, since those gaps are not drawn.")
valueGapShowBorders = input.bool(true, "Border", inline="vag_edges", group=GROUP_VALUE_GAPS)
bullishValueGapBorderColor = input.color(DEFAULT_VALUE_GAP_BULLISH_BORDER_COLOR, "+", inline="vag_edges", group=GROUP_VALUE_GAPS)
bearishValueGapBorderColor = input.color(DEFAULT_VALUE_GAP_BEARISH_BORDER_COLOR, "−", inline="vag_edges", group=GROUP_VALUE_GAPS)
valueGapShowLabels = input.bool(true, "Label", inline="vag_edges", group=GROUP_VALUE_GAPS)
bullishValueGapLabelColor = input.color(DEFAULT_VALUE_GAP_BULLISH_LABEL_COLOR, "+", inline="vag_edges", group=GROUP_VALUE_GAPS)
bearishValueGapLabelColor = input.color(DEFAULT_VALUE_GAP_BEARISH_LABEL_COLOR, "−", inline="vag_edges", group=GROUP_VALUE_GAPS)
valueGapMitigatedLabelColor = input.color(DEFAULT_VALUE_GAP_MITIGATED_REFERENCE_COLOR, "✓", inline="vag_edges", group=GROUP_VALUE_GAPS, tooltip="Border + / − set bullish/bearish border colors. Label + / − apply while a gap remains open; ✓ is the shared label color at 100%. Gap labels are always directional: bullish below, bearish above.")
valueGapShowMidpointLine = input.bool(true, "50%", inline="vag_half_style", group=GROUP_VALUE_GAPS)
valueGapMidpointOpenLineColor = input.color(DEFAULT_VALUE_GAP_MIDPOINT_OPEN_COLOR, "Line", inline="vag_half_style", group=GROUP_VALUE_GAPS)
valueGapMidpointMitigatedLineColor = input.color(DEFAULT_VALUE_GAP_MITIGATED_REFERENCE_COLOR, "✓", inline="vag_half_style", group=GROUP_VALUE_GAPS)
valueGapShowMidpointLabel = input.bool(true, "Label", inline="vag_half_style", group=GROUP_VALUE_GAPS, tooltip="50% toggles the midpoint line. Line / ✓ set its open and mitigated colors. Label toggles the midpoint tag, shown only while the gap is open; its text uses a softened version of the gap's + / − label color. The line is always dashed, width 1.")
valueGapShowQuartileLines = input.bool(true, "Q", inline="vag_quartile_style", group=GROUP_VALUE_GAPS)
valueGapQuartileOpenLineColor = input.color(DEFAULT_VALUE_GAP_QUARTILE_OPEN_COLOR, "Line", inline="vag_quartile_style", group=GROUP_VALUE_GAPS)
valueGapQuartileMitigatedLineColor = input.color(DEFAULT_VALUE_GAP_MITIGATED_REFERENCE_COLOR, "✓", inline="vag_quartile_style", group=GROUP_VALUE_GAPS)
valueGapShowQuartileLabels = input.bool(false, "Label", inline="vag_quartile_style", group=GROUP_VALUE_GAPS, tooltip="Q toggles the 25% and 75% lines. Line / ✓ set their open and independently mitigated colors. Label toggles their tags, shown only while the gap is open; their text uses a softened version of the gap's + / − label color. Quartile lines are always dotted, width 1.")
valueGapLabelSize = input.string(LABEL_SIZE_TINY, "Text  ·  Gap", options=[LABEL_SIZE_TINY, LABEL_SIZE_SMALL, LABEL_SIZE_NORMAL, LABEL_SIZE_LARGE, LABEL_SIZE_HUGE], inline="vag_text", group=GROUP_VALUE_GAPS)
valueGapInternalLabelSize = input.string(LABEL_SIZE_TINY, "50% / Q", options=[LABEL_SIZE_TINY, LABEL_SIZE_SMALL, LABEL_SIZE_NORMAL, LABEL_SIZE_LARGE, LABEL_SIZE_HUGE], inline="vag_text", group=GROUP_VALUE_GAPS)
valueGapInternalLabelFade = input.int(40, LABEL_FADE_PERCENT, minval=0, maxval=100, inline="vag_text", group=GROUP_VALUE_GAPS)
valueGapShowInternalReminders = input.bool(false, LABEL_REMINDERS, inline="vag_text", group=GROUP_VALUE_GAPS, tooltip="Gap sets the size of the main gap label; 50% / Q sets the size of the internal reference tags. Fade % is the extra transparency added to the gap's + / − label color to derive the internal tag color, so they read softer than the main label.\n\nReminders repeat the 25% / 50% / 75% tags sparsely along an open gap's run, so you can still read them when scrolled away from the gap's midpoint. Count grows with the run's length but stays sparse. Filled gaps carry no internal tags either way.")
floatingValueGapOffset = input.int(24, "Float Offset", minval=1, maxval=100, inline="vag_float_size", group=GROUP_VALUE_GAPS_RIGHT_EDGE)
floatingValueGapWidth = input.int(10, "Width", minval=2, maxval=50, inline="vag_float_size", group=GROUP_VALUE_GAPS_RIGHT_EDGE, tooltip="Float Offset sets how many bars to the right floating confirmed gaps begin. Width sets their horizontal bar width.")
upcomingValueGapEnabled = input.bool(true, "Upcoming", inline="vag_upcoming", group=GROUP_VALUE_GAPS_RIGHT_EDGE)
upcomingValueGapMinPercent = input.float(45.0, "Min %", minval=0.0, maxval=100.0, step=0.5, inline="vag_upcoming", group=GROUP_VALUE_GAPS_RIGHT_EDGE)
upcomingValueGapColor = input.color(DEFAULT_UPCOMING_VALUE_GAP_COLOR, "Fill", inline="vag_upcoming", group=GROUP_VALUE_GAPS_RIGHT_EDGE)
upcomingValueGapBorderColor = input.color(DEFAULT_UPCOMING_VALUE_GAP_BORDER_COLOR, "Border", inline="vag_upcoming", group=GROUP_VALUE_GAPS_RIGHT_EDGE, tooltip="Upcoming compares the Source anchor's developing value area with its latest completed one and may move or disappear before that period closes. Min % hides it until its height reaches that share of the prior profile's range. The swatches set fill and border.")
upcomingValueGapOffset = input.int(10, "Offset", minval=1, maxval=100, inline="vag_upcoming_size", group=GROUP_VALUE_GAPS_RIGHT_EDGE)
upcomingValueGapWidth = input.int(10, "Width", minval=2, maxval=50, inline="vag_upcoming_size", group=GROUP_VALUE_GAPS_RIGHT_EDGE, tooltip="Offset sets how many bars to the right the Upcoming gap begins. Width sets its horizontal bar width.")

valueGapSourceIsRth = valueGapSource == VALUE_GAP_SOURCE_RTH

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — RTH swept
// ═══════════════════════════════════════════════════════════════════════════════
rthShowSweptReminders = input.bool(true, LABEL_SWEPT_REMINDER, group=GROUP_RTH_SWEPT, tooltip=TOOLTIP_SWEPT_REMINDER)
rthShowSweptReminderDate = input.bool(true, LABEL_SWEPT_REMINDER_DATE, group=GROUP_RTH_SWEPT, tooltip=TOOLTIP_SWEPT_REMINDER_DATE)
rthSweptContinuationWidth = input.string("1", LABEL_SWEPT_CONTINUATION_LINE_WIDTH, options=["1", "2", "3", "4", "5"], group=GROUP_RTH_SWEPT, tooltip=TOOLTIP_SWEPT_CONTINUATION_LINE_WIDTH)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Globex session
// ═══════════════════════════════════════════════════════════════════════════════
globexEnabled = input.bool(false, LABEL_ENABLE_GLOBEX, inline="globex_top", group=GROUP_GLOBEX)
globexExtensionMode = input.string(LEVEL_BREACH_SWEEP, "", options=[LEVEL_PERIOD, LEVEL_BREACH_ANY, LEVEL_BREACH_SWEEP], inline="globex_top", group=GROUP_GLOBEX, tooltip="Build a volume profile for each Globex trading day. Futures-style symbols use the 18:00 New York open; crypto / 24/7 assets use 00:00 UTC.\n\nExtension mode controls POC and VAH/L after close: Session Only stays inside the period; Until Touched stops at the first trade-through; Until Swept waits for closes beyond both sides.")
globexShowValueArea = input.bool(true, LABEL_VALUE_AREA_HIGH_LOW, inline="globex_value_area", group=GROUP_GLOBEX)
globexValueAreaColor = input.color(color.new(color.rgb(128, 222, 234), 20), "", inline="globex_value_area", group=GROUP_GLOBEX)
globexValueAreaWidth = input.string("2", "", options=["1", "2", "3", "4", "5"], inline="globex_value_area", group=GROUP_GLOBEX)
globexValueAreaStyle = input.string(STYLE_SOLID, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="globex_value_area", group=GROUP_GLOBEX)
globexValueAreaLabelColor = input.color(color.new(color.rgb(0, 151, 167), 0), "", inline="globex_value_area", group=GROUP_GLOBEX, tooltip=TOOLTIP_VALUE_AREA_ROW)
globexValueAreaLastColor = input.color(color.new(color.rgb(58, 204, 222), 15), LABEL_LAST_VALUE_AREA_COLOR, inline="globex_value_area_last", group=GROUP_GLOBEX)
globexValueAreaLastWidth = input.string("2", "", options=["1", "2", "3", "4", "5"], inline="globex_value_area_last", group=GROUP_GLOBEX, tooltip=TOOLTIP_LAST_VALUE_AREA_ROW)
globexShowPoc = input.bool(true, LABEL_POC, inline="globex_poc", group=GROUP_GLOBEX)
globexPocColor = input.color(color.new(color.rgb(186, 104, 200), 0), "", inline="globex_poc", group=GROUP_GLOBEX)
globexPocWidth = input.string("1", "", options=["1", "2", "3", "4", "5"], inline="globex_poc", group=GROUP_GLOBEX)
globexPocStyle = input.string(STYLE_DASHED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="globex_poc", group=GROUP_GLOBEX)
globexPocLabelColor = input.color(color.new(color.rgb(123, 31, 162), 0), "", inline="globex_poc", group=GROUP_GLOBEX, tooltip=TOOLTIP_POC_ROW)
globexShowAlternatePoc = input.bool(false, LABEL_ALTERNATE_POC, inline="globex_altpoc", group=GROUP_GLOBEX)
globexAlternatePocColor = input.color(color.new(color.rgb(233, 30, 99), 0), "", inline="globex_altpoc", group=GROUP_GLOBEX)
globexAlternatePocWidth = input.string("1", "", options=["1", "2", "3", "4", "5"], inline="globex_altpoc", group=GROUP_GLOBEX)
globexAlternatePocStyle = input.string(STYLE_DOTTED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="globex_altpoc", group=GROUP_GLOBEX)
globexAlternatePocLabelColor = input.color(color.new(color.rgb(194, 24, 91), 0), "", inline="globex_altpoc", group=GROUP_GLOBEX, tooltip=TOOLTIP_ALTERNATE_POC_ROW)
globexShowSessionBox = input.bool(false, LABEL_SESSION_BOX, inline="globex_hist", group=GROUP_GLOBEX)
globexSessionBoxColor = input.color(color.new(color.rgb(178, 235, 242), 98), "", inline="globex_hist", group=GROUP_GLOBEX)
globexShowHistogram = input.bool(true, LABEL_VALUE_AREA, inline="globex_hist", group=GROUP_GLOBEX)
globexHistogramInsideColor = input.color(color.new(color.rgb(178, 235, 242), 80), LABEL_HISTOGRAM_INSIDE, inline="globex_hist", group=GROUP_GLOBEX)
globexHistogramOutsideColor = input.color(color.new(color.rgb(184, 184, 184), 80), LABEL_HISTOGRAM_OUTSIDE, inline="globex_hist", group=GROUP_GLOBEX, tooltip=TOOLTIP_HISTOGRAM_ROW)
globexDimTouched = input.bool(true, LABEL_DIM_TOUCHED, inline="globex_dim", group=GROUP_GLOBEX)
globexDimPercent = input.int(85, LABEL_DIM_PERCENT, minval=0, maxval=100, inline="globex_dim", group=GROUP_GLOBEX, tooltip=TOOLTIP_DIM_ROW)
globexShowPrice = input.bool(false, LABEL_SHOW_PRICE, inline="globex_labels", group=GROUP_GLOBEX)
globexLevelLabelSize = input.string(LABEL_SIZE_SMALL, "", options=[LABEL_SIZE_TINY, LABEL_SIZE_SMALL, LABEL_SIZE_NORMAL, LABEL_SIZE_LARGE, LABEL_SIZE_HUGE], inline="globex_labels", group=GROUP_GLOBEX, tooltip=TOOLTIP_PRICE_LABEL_ROW)
globexShowSweptReminders = input.bool(true, LABEL_SWEPT_REMINDER, group=GROUP_GLOBEX_SWEPT, tooltip=TOOLTIP_SWEPT_REMINDER)
globexShowSweptReminderDate = input.bool(true, LABEL_SWEPT_REMINDER_DATE, group=GROUP_GLOBEX_SWEPT, tooltip=TOOLTIP_SWEPT_REMINDER_DATE)
globexSweptContinuationWidth = input.string("1", LABEL_SWEPT_CONTINUATION_LINE_WIDTH, options=["1", "2", "3", "4", "5"], group=GROUP_GLOBEX_SWEPT, tooltip=TOOLTIP_SWEPT_CONTINUATION_LINE_WIDTH)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Weekly session
// ═══════════════════════════════════════════════════════════════════════════════
weeklyEnabled = input.bool(false, LABEL_ENABLE_WEEKLY, inline="weekly_top", group=GROUP_WEEKLY)
weeklyExtensionMode = input.string(LEVEL_BREACH_SWEEP, "", options=[LEVEL_PERIOD, LEVEL_BREACH_ANY, LEVEL_BREACH_SWEEP], inline="weekly_top", group=GROUP_WEEKLY, tooltip="Build a volume profile for each week. Futures use the Sunday 18:00 New York reopen; crypto / 24/7 assets use Monday 00:00 UTC.\n\nExtension mode controls POC and VAH/L after close: Session Only stays inside the week; Until Touched stops at the first trade-through; Until Swept waits for closes beyond both sides.")
weeklyShowValueArea = input.bool(true, LABEL_VALUE_AREA_HIGH_LOW, inline="weekly_value_area", group=GROUP_WEEKLY)
weeklyValueAreaColor = input.color(color.new(color.rgb(242, 54, 69), 20), "", inline="weekly_value_area", group=GROUP_WEEKLY)
weeklyValueAreaWidth = input.string("2", "", options=["1", "2", "3", "4", "5"], inline="weekly_value_area", group=GROUP_WEEKLY)
weeklyValueAreaStyle = input.string(STYLE_SOLID, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="weekly_value_area", group=GROUP_WEEKLY)
weeklyValueAreaLabelColor = input.color(color.new(color.rgb(230, 81, 0), 20), "", inline="weekly_value_area", group=GROUP_WEEKLY, tooltip=TOOLTIP_VALUE_AREA_ROW)
weeklyValueAreaLastColor = input.color(color.new(color.rgb(242, 54, 69), 0), LABEL_LAST_VALUE_AREA_COLOR, inline="weekly_value_area_last", group=GROUP_WEEKLY)
weeklyValueAreaLastWidth = input.string("3", "", options=["1", "2", "3", "4", "5"], inline="weekly_value_area_last", group=GROUP_WEEKLY, tooltip=TOOLTIP_LAST_VALUE_AREA_ROW)
weeklyShowPoc = input.bool(true, LABEL_POC, inline="weekly_poc", group=GROUP_WEEKLY)
weeklyPocColor = input.color(color.new(color.rgb(171, 71, 188), 0), "", inline="weekly_poc", group=GROUP_WEEKLY)
weeklyPocWidth = input.string("2", "", options=["1", "2", "3", "4", "5"], inline="weekly_poc", group=GROUP_WEEKLY)
weeklyPocStyle = input.string(STYLE_DASHED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="weekly_poc", group=GROUP_WEEKLY)
weeklyPocLabelColor = input.color(color.new(color.rgb(123, 31, 162), 0), "", inline="weekly_poc", group=GROUP_WEEKLY, tooltip=TOOLTIP_POC_ROW)
weeklyShowAlternatePoc = input.bool(false, LABEL_ALTERNATE_POC, inline="weekly_altpoc", group=GROUP_WEEKLY)
weeklyAlternatePocColor = input.color(color.new(color.rgb(233, 30, 99), 0), "", inline="weekly_altpoc", group=GROUP_WEEKLY)
weeklyAlternatePocWidth = input.string("2", "", options=["1", "2", "3", "4", "5"], inline="weekly_altpoc", group=GROUP_WEEKLY)
weeklyAlternatePocStyle = input.string(STYLE_DOTTED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="weekly_altpoc", group=GROUP_WEEKLY)
weeklyAlternatePocLabelColor = input.color(color.new(color.rgb(194, 24, 91), 0), "", inline="weekly_altpoc", group=GROUP_WEEKLY, tooltip=TOOLTIP_ALTERNATE_POC_ROW)
weeklyShowSessionBox = input.bool(false, LABEL_SESSION_BOX, inline="weekly_hist", group=GROUP_WEEKLY)
weeklySessionBoxColor = input.color(color.new(color.rgb(250, 161, 164), 95), "", inline="weekly_hist", group=GROUP_WEEKLY)
weeklyShowHistogram = input.bool(true, LABEL_VALUE_AREA, inline="weekly_hist", group=GROUP_WEEKLY)
