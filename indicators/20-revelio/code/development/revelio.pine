monthlyEnabled = input.bool(false, LABEL_ENABLE_MONTHLY, inline="monthly_top", group=GROUP_MONTHLY, active=isAll)
monthlyControlsActive = isAll ? monthlyEnabled : monthlyMenuControlsActive
