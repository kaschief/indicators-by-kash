//@version=6

// ═══════════════════════════════════════════════════════════════════════════════
// INDICATOR SETUP
// ═══════════════════════════════════════════════════════════════════════════════
INDICATOR_MAX_LINES = 500
INDICATOR_MAX_LABELS = 500
INDICATOR_MAX_BOXES = 500
INDICATOR_MAX_POLYLINES = 100
INDICATOR_TITLE = 'revelio •'

indicator(INDICATOR_TITLE, overlay=true, max_lines_count=INDICATOR_MAX_LINES, max_labels_count=INDICATOR_MAX_LABELS, max_boxes_count=INDICATOR_MAX_BOXES, max_polylines_count=INDICATOR_MAX_POLYLINES, max_bars_back=5000)

// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════
NY_TIMEZONE = "America/New_York"
UTC_TIMEZONE = "GMT+0"

// Canonical time units. Derived durations below use these instead of repeating unit arithmetic.
MS_PER_HOUR = 60 * 60 * 1000
MS_PER_DAY = 24 * MS_PER_HOUR
MS_PER_WEEK = 7 * MS_PER_DAY
MS_PER_MONTH = 30 * MS_PER_DAY
MS_PER_QUARTER = 3 * MS_PER_MONTH
MINUTES_PER_HOUR = 60
MINUTES_PER_DAY = 24 * MINUTES_PER_HOUR

// Session specification (RTH has a daily gap; the 24h sessions are anchored by NY calendar below)
RTH_SESSION = "0930-1600:23456"      // Regular cash session, Mon-Fri (session-based assets)
RTH_SESSION_ALL_DAYS = "0930-1600:1234567"  // Same 09:30-16:00 NY window every day (24/7 assets)
FROM_0500_START_MINUTE = 300
FROM_0830_START_MINUTE = 510
RTH_START_MINUTE = 570
RTH_END_MINUTE = 960
WEEKLY_REOPEN_SESSION = "1800-0930"  // Sunday 18:00 NY futures reopen edge
SUNDAY_REOPEN_START_HOUR = 18
GLOBEX_REOPEN_SHIFT_MS = 6 * MS_PER_HOUR
SECONDS_PER_WEEK = 604800
ASSET_DETECTION_MAX_LOOKBACK = 4999

// Recurring New York windows used by Show Only; the overnight session crosses midnight.
SESSION_WINDOW_OVERNIGHT = "1600-0500:1234567" // 16:00–05:00 — the standard overnight
SESSION_WINDOW_FROM_0500 = "0500-1600:1234567" // 05:00–16:00 — premarket into the cash session
SESSION_WINDOW_FROM_0830 = "0830-1600:1234567" // 08:30–16:00 — the 08:30 open through the cash close
SESSION_WINDOW_RTH = "0930-1600:1234567"       // 09:30–16:00 — the regular trading hours cash session

// Leading dots distinguish the pre-RTH start times without lengthening dropdown labels.
WINDOW_LABEL_OVERNIGHT = "Overnight"
WINDOW_LABEL_FROM_0500 = "● ● RTH"
WINDOW_LABEL_FROM_0830 = "● RTH"
WINDOW_LABEL_RTH = "RTH"

BRAND_BULLET = "•"
SWEPT_CHECKMARK = "✓"

START_TIME_UNSET = -1

// Level extension / mitigation modes
LEVEL_PERIOD = "Session Only"
LEVEL_BREACH_ANY = "Until Touched"
LEVEL_BREACH_SAME = "Same-Session Touch"
LEVEL_BREACH_SWEEP = "Until Swept"

VALUE_GAP_SOURCE_RTH = "RTH"
VALUE_GAP_SOURCE_GLOBEX = "Globex"

VALUE_GAP_DISPLAY_HISTORICAL = "Historical"
VALUE_GAP_DISPLAY_HISTORICAL_FLOATING = "Historical + Floating"
VALUE_GAP_DISPLAY_RECENT_FLOATING = "Most Recent + Floating"
VALUE_GAP_DISPLAY_FLOATING = "Floating Only"
VALUE_GAP_NEAREST_OFF = "Off"
LABEL_REMINDERS = "Reminders"
LABEL_FADE_PERCENT = "Fade %"
ANCHOR_LABEL_MODE_OFF = "Off"
ANCHOR_LABEL_MODE_ONCE = "Once"
ANCHOR_LABEL_MODE_REMINDERS = LABEL_REMINDERS
ANCHOR_REMINDER_MIN_SPACING_MS = 3 * MS_PER_DAY
ANCHOR_REMINDER_MAX_PER_LEVEL = 5

// Span thresholds separate short sessions from full RTH/Globex sessions and DST transitions.
RTH_MERGE_SPAN_FRACTION = 0.75
GLOBEX_MERGE_SPAN_FRACTION = 0.90

LABEL_MERGE_STRICT = "Strict"
LABEL_MERGE_BALANCED = "Balanced"
LABEL_MERGE_WIDE = "Wide"
LABEL_MERGE_CUSTOM = "Custom"
LABEL_MERGE_STRICT_PERCENT = 0.005
LABEL_MERGE_BALANCED_PERCENT = 0.010
LABEL_MERGE_WIDE_PERCENT = 0.025
DEFAULT_MERGED_LINE_FADE_PERCENT = 85
LABEL_NAME_SEPARATOR = " | "
PERIOD_LABEL_DAY = "Day"
PERIOD_LABEL_MONTH = "Month"
PERIOD_LABEL_QUARTER = "Quarter"

PROFILE_ROWS = 250
HISTOGRAM_SMOOTHING = 7
HISTOGRAM_WIDTH_PERCENT = 25.0

// Compact long-period samples below Pine's array cap using a grid finer than PROFILE_ROWS.
SAMPLE_COMPACT_THRESHOLD = 60000
SAMPLE_COMPACT_ROWS = 6000
// Two calendar quarters plus buffer cover the previous completed quarter from any current-quarter date.
QUARTERLY_MAX_TWO_QUARTERS_DAYS = 184
QUARTERLY_HISTORY_BUFFER_DAYS = 16
QUARTERLY_LOOKBACK_DAYS = QUARTERLY_MAX_TWO_QUARTERS_DAYS + QUARTERLY_HISTORY_BUFFER_DAYS
QUARTERLY_CALCULATION_MINUTES = 15
QUARTERLY_INTRABAR_MINUTES = 5
QUARTERLY_CALCULATION_TIMEFRAME = str.tostring(QUARTERLY_CALCULATION_MINUTES)
QUARTERLY_INTRABAR_TIMEFRAME = str.tostring(QUARTERLY_INTRABAR_MINUTES)
QUARTERLY_CALCULATION_BARS = int(QUARTERLY_LOOKBACK_DAYS * MINUTES_PER_DAY / QUARTERLY_CALCULATION_MINUTES)
QUARTERLY_INTRABAR_BARS = int(QUARTERLY_CALCULATION_BARS * QUARTERLY_CALCULATION_MINUTES / QUARTERLY_INTRABAR_MINUTES)
INACTIVE_REQUEST_BARS = 1
QUARTERLY_SNAPSHOT_MINUTE = MINUTES_PER_HOUR - QUARTERLY_CALCULATION_MINUTES
// Sparse Monday snapshots transfer histogram rows without returning a Profile object on every bar.
QUARTERLY_UTC_WEEKLY_SNAPSHOT_HOUR = 0
QUARTERLY_MARKET_WEEKLY_SNAPSHOT_HOUR = 9

DEFAULT_RTH_PROFILES = 10
DEFAULT_GLOBEX_PROFILES = 10
DEFAULT_WEEKLY_PROFILES = 5
DEFAULT_MONTHLY_PROFILES = 2
DEFAULT_QUARTERLY_PROFILES = 2
RTH_SWEPT_CONTINUATION_WIDTH = 1
GLOBEX_SWEPT_CONTINUATION_WIDTH = 1
WEEKLY_SWEPT_CONTINUATION_WIDTH = 2
MONTHLY_SWEPT_CONTINUATION_WIDTH = 3
QUARTERLY_SWEPT_CONTINUATION_WIDTH = 4
WEEKLY_MATURITY_HISTORY = 5
MONTHLY_MATURITY_HISTORY = 2
QUARTERLY_MATURITY_HISTORY = 2
MATURITY_STABILITY_FRACTION = 0.20
MATURITY_EARLY_VOLUME_THRESHOLD_PERCENT = 45
WEEKLY_UTC_MATURITY_SESSIONS = 4
WEEKLY_MARKET_MATURITY_SESSIONS = 3
WEEKLY_EARLY_MATURITY_SESSIONS = 2
MONTHLY_UTC_MATURITY_SESSIONS = 15
MONTHLY_MARKET_MATURITY_SESSIONS = 10
MONTHLY_UTC_EARLY_MATURITY_SESSIONS = 7
MONTHLY_MARKET_EARLY_MATURITY_SESSIONS = 5
QUARTERLY_UTC_MATURITY_SESSIONS = 45
QUARTERLY_MARKET_MATURITY_SESSIONS = 30
QUARTERLY_UTC_EARLY_MATURITY_SESSIONS = 22
QUARTERLY_MARKET_EARLY_MATURITY_SESSIONS = 15
MAX_STORED_VALUE_GAPS = 100
VALUE_GAP_LINE_BUDGET = 140
VALUE_GAP_LABEL_BUDGET = 140
VALUE_GAP_BOX_BUDGET = 140
VALUE_GAP_CE_LEVEL = 0.50
VALUE_GAP_Q1_LEVEL = 0.25
VALUE_GAP_Q3_LEVEL = 0.75
VALUE_GAP_RIGHT_EDGE_CUSHION = 3
VALUE_GAP_REFERENCE_WIDTH = 1
VALUE_GAP_BOLD_REFERENCE_WIDTH = 2
VALUE_GAP_REMINDER_MAX_PER_LEVEL = 4
MAX_LEVEL_HIT_EVENTS = INDICATOR_MAX_LABELS
MAX_LEVEL_HIT_TRADING_DAY_SCAN = 10
MAX_LEVEL_HIT_WEEKDAY_RETENTION_DAYS = 5

// Shared with the gap family in Gaps so the related features read as one visual system.
DEFAULT_VALUE_GAP_BULLISH_UNFILLED_COLOR = color.new(color.rgb(146, 198, 239), 90)
DEFAULT_VALUE_GAP_BEARISH_UNFILLED_COLOR = color.new(color.rgb(244, 143, 177), 85)
DEFAULT_VALUE_GAP_FILLED_COLOR = color.new(color.rgb(219, 219, 219), 91)
VALUE_GAP_BULLISH_BORDER_COLOR = color.new(color.rgb(49, 121, 245), 35)
VALUE_GAP_BEARISH_BORDER_COLOR = color.new(color.rgb(194, 24, 91), 50)
DEFAULT_VALUE_GAP_BULLISH_LABEL_COLOR = color.rgb(57, 120, 221)
DEFAULT_VALUE_GAP_BEARISH_LABEL_COLOR = color.rgb(233, 30, 99)
DEFAULT_VALUE_GAP_MIDPOINT_OPEN_COLOR = color.new(color.rgb(74, 74, 74), 40)
DEFAULT_VALUE_GAP_QUARTILE_OPEN_COLOR = color.new(color.rgb(74, 74, 74), 10)
DEFAULT_VALUE_GAP_MITIGATED_REFERENCE_COLOR = color.new(color.rgb(184, 184, 184), 20)
DEFAULT_UPCOMING_VALUE_GAP_COLOR = color.new(color.rgb(255, 238, 88), 85)
UPCOMING_VALUE_GAP_BORDER_COLOR = color.rgb(251, 192, 45)
VALUE_GAP_LABEL_BG_TRANSPARENT = color.new(color.rgb(255, 255, 255), 100)
VALUE_GAP_MIDPOINT_LABEL_BG = color.new(color.rgb(255, 255, 255), 50)

// Short-session merge modes (how early-close / holiday half-days combine), least-to-most merging.
MERGE_OFF = "Off"
MERGE_EARLIEST = "Earliest Into Previous Full Session"
MERGE_ALL = "All Into Previous Full Session"
MERGE_COMBINE = "Combine Shorts"

// Line styles
STYLE_SOLID = "Solid"
STYLE_DASHED = "Dashed"
STYLE_DOTTED = "Dotted"

// Label sizes
LABEL_SIZE_TINY = "Tiny"
LABEL_SIZE_SMALL = "Small"
LABEL_SIZE_NORMAL = "Normal"
LABEL_SIZE_LARGE = "Large"
LABEL_SIZE_HUGE = "Huge"
LEVEL_HIT_CIRCLE_SCALE_ANCHOR = "Scale by Anchor"
LEVEL_HIT_KEEP_DETECTION_WINDOW = "Detection Window"
LEVEL_HIT_KEEP_ONE_DAY = "1 Day"
LEVEL_HIT_KEEP_THREE_DAYS = "3 Days"
LEVEL_HIT_KEEP_ONE_WEEK = "1 Week"

// A secondary node qualifies when its volume nearly matches the POC; distance is ignored.
ALTERNATE_POC_WINDOW_FRAC = 0.03  // ignore rows within this fraction of total rows around the POC (its own shoulder)
ALTERNATE_POC_MIN_RATIO = 0.90    // candidate volume must be ≥ this fraction of POC volume to qualify

// Session group labels (each session contains volume profiles)
GROUP_QUICK_FILTER = "⚡ Quick Filter"
GROUP_QUICK_FILTER_SETTINGS = "⚡ Quick Filter: Settings"
GROUP_QUICK_FILTER_PRICES = "⚡ Quick Filter: Prices"
GROUP_QUICK_FILTER_HIT_TRACE = "⚡ Quick Filter: Hit Trace"
GROUP_DISPLAY = "⚙️ Display"
GROUP_LABELS = "🏷️ Labels"
GROUP_RIGHT_EDGE = "↔ Right Edge"
GROUP_SWEEP = "🧹 Sweep"
GROUP_RTH = "🗽 RTH"
GROUP_VALUE_GAPS = "📊 Value Gaps"
GROUP_GLOBEX = "🌅 Globex"
GROUP_WEEKLY = "📅 Weekly"
GROUP_MONTHLY = "🗓️ Monthly"
GROUP_QUARTERLY = "🏛️ Quarterly"
GROUP_UTILITY = "🎨 Utility"

SESSION_RTH = "RTH"
SESSION_GLOBEX = "Globex"
SESSION_WEEKLY = "Weekly"
SESSION_MONTHLY = "Monthly"
SESSION_QUARTERLY = "Quarterly"

LABEL_ENABLE_RTH = "Enable RTH Session"
LABEL_ENABLE_GLOBEX = "Enable Globex Session"
LABEL_ENABLE_WEEKLY = "Enable Weekly Session"
LABEL_ENABLE_MONTHLY = "Enable Monthly Session"
LABEL_ENABLE_QUARTERLY = "Enable Quarterly Session"
LABEL_DIM_TOUCHED = "Fade Mitigated Levels"
LABEL_DIM_PERCENT = "%"
LABEL_VALUE_AREA_HIGH_LOW = "VAH/L"
LABEL_VAH = "VAH"
LABEL_VAL = "VAL"
LABEL_POC = "POC"
LABEL_ALTERNATE_POC = "aPOC"
LABEL_ENABLE_VALUE_GAPS = "Enable Value Gaps"
LABEL_VALUE_AREA = "Value"
LABEL_HISTOGRAM_INSIDE = "In"
LABEL_HISTOGRAM_OUTSIDE = "Out"
LABEL_BOX = "Box"
LABEL_SHORT_SESSION_MERGE = "Merge Short Session"
LABEL_LEVEL_LABELS = "Price Labels"
LABEL_LEVEL_LABEL_OFFSET = "Price Label Offset"
LABEL_LEVEL_LABEL_BACKGROUND = "Price Label Background"
LABEL_DEVELOPING_PROFILE = "Style Developing Profile"
LABEL_SWEPT = "Swept"
LABEL_SWEEP_CONFIRM_MARGIN = "Sweep Confirmation Percent Margin"
LABEL_SWEPT_CONTINUATION_LINE_FADE = "Level Fade Percent"
LABEL_SWEPT_LABEL_TEXT_FADE = "Label Text Fade"
LABEL_RTH_SWEPT_KEEP = "Days to Keep RTH Swept Lines"
LABEL_GLOBEX_SWEPT_KEEP = "Days to Keep Globex Swept Lines"
LABEL_WEEKLY_SWEPT_KEEP = "Weeks to Keep Weekly Swept Lines"
LABEL_MONTHLY_SWEPT_KEEP = "Months to Keep Monthly Swept Lines"
LABEL_QUARTERLY_SWEPT_KEEP = "Quarters to Keep Quarterly Swept Lines"
TOOLTIP_SWEEP_MARGIN = "Until Swept only. A side qualifies after a close exceeds the level by this share of the profile range. Both sides must qualify."
TOOLTIP_SWEPT_CONTINUATION_LINE_FADE = "Extra fade for swept dashed lines."
TOOLTIP_SWEPT_LABEL_TEXT_FADE = "Extra fade for swept label text."
TOOLTIP_RTH_SWEPT_KEEP = "Days to retain older RTH swept lines. The newest profile always remains."
TOOLTIP_GLOBEX_SWEPT_KEEP = "Days to retain older Globex swept lines. The newest profile always remains."
TOOLTIP_WEEKLY_SWEPT_KEEP = "Weeks to retain older Weekly swept lines. The newest profile always remains."
TOOLTIP_MONTHLY_SWEPT_KEEP = "Months to retain older Monthly swept lines. The newest profile always remains."
TOOLTIP_QUARTERLY_SWEPT_KEEP = "Quarters to retain older Quarterly swept lines. The newest profile always remains."
SWEPT_REMINDER_MAX_PER_LINE = 7
SWEPT_REMINDER_BASE_MS = 3 * MS_PER_DAY
LABEL_RTH_ANCHOR = "RTH"
LABEL_RTH_LIVE = "★ Today's RTH"
LABEL_RTH_LAST = "PREV RTH"
LABEL_GLOBEX_ANCHOR = "Globex"
LABEL_GLOBEX_LIVE = "Today's Globex"
LABEL_GLOBEX_LAST = "PREV GLOBEX"
LABEL_WEEKLY_ANCHOR = "Weekly"
LABEL_WEEKLY_LIVE = "★ This Week's"
LABEL_WEEKLY_LAST = "LAST WEEK'S"
LABEL_MONTHLY_ANCHOR = "Monthly"
LABEL_MONTHLY_LIVE = "★ This Month's"
LABEL_MONTHLY_LAST = "LAST MONTH'S"
LABEL_QUARTERLY_ANCHOR = "Quarterly"
LABEL_QUARTERLY_LIVE = "★ This Quarter's"
LABEL_QUARTERLY_LAST = "LAST QUARTER'S"
LABEL_TABLE_SETTING = "Setting"
LABEL_TABLE_RGB = "RGB"
LABEL_TABLE_TRANSPARENCY = "Trans"
LABEL_TABLE_WIDTH = "Width"
TOOLTIP_LEVEL_HIT_TRACE = "Marks the first hit inside the selected detection window for completed POC, aPOC, VAH and VAL levels. Hover for identity and time.\n\n• All Anchors — include hidden anchors without drawing them.\n• Fixed — selected circle size.\n• Scale by Anchor — RTH/Globex Normal; Weekly Large; Monthly/Quarterly Huge.\n• Nearby hits on the same candle share one circle, even when label merging is off.\n• A circle leaves when its source profile leaves Show Last.\n• Under drawing pressure, newest circles are retained first.\n\nUp to 1 hour."
TOOLTIP_LEVEL_HIT_WINDOW = "Detect\n• ● ● RTH — 05:00–16:00.\n• ● RTH — 08:30–16:00.\n• RTH — 09:30–16:00.\n\nKeep\nRetains the most recent detection days. Session-based assets skip weekends; 24/7 assets count them. The next day begins when its selected detection window starts."

LABEL_LAST_VALUE_AREA_COLOR = "Last VAH/L"
TOOLTIP_LAST_VALUE_AREA_COLOR = "VAH/VAL color for the most recent completed profile."
TOOLTIP_VALUE_AREA_ROW = "VAH/L row: first swatch = line color; dropdowns = width and style; last swatch = label text color."
TOOLTIP_POC_ROW = "POC row: first swatch = line color; dropdowns = width and style; last swatch = label text color."
TOOLTIP_ALTERNATE_POC_ROW = "aPOC marks a secondary node close to the main POC's volume.\n\nRow: line color · width · style · label color."
TOOLTIP_LAST_VALUE_AREA_ROW = TOOLTIP_LAST_VALUE_AREA_COLOR + " The dropdown sets its width."
TOOLTIP_HISTOGRAM_ROW = "Session Box toggles and colors the profile period background. Value toggles the volume histogram; In colors rows inside value area and Out colors rows outside it."
TOOLTIP_DIM_ROW = "Fade touched levels by the selected percentage so untouched levels retain full strength. Only meaningful in Until Touched mode."
PRICE_MODE_OFF = "Off"
PRICE_MODE_ACTIVE = "Active"
PRICE_MODE_CUSTOM = "Custom"
TOOLTIP_PRICE_MODE = "Prices on right-edge identities.\n\n• Off — names only.\n• Active — every visible anchor.\n• Custom — per-anchor choices in Quick Filter: Settings."
TOOLTIP_CUSTOM_PRICES = "Used when Prices is Custom. Choose exactly which anchors append numeric prices to their right-edge level labels."
TOOLTIP_LEVEL_LABEL_SIZE = "Size of this anchor's right-edge level labels."

FILTER_ALL = "Manual"
FILTER_CORE = "☾ Core"
FILTER_PREP = "★ Prep: Core + Globex"
FILTER_MACRO_PREP = "● Macro Prep: Prep + Quarterly"
FILTER_INTRADAY = "Intraday: RTH + Globex"
FILTER_DUO = "◐ Duo: RTH + Weekly"
FILTER_SWING = "Swing: Weekly + Monthly"
FILTER_HORIZON = "▲ Horizon: Swing + Quarterly"
FILTER_MACRO = "○ Macro: Monthly + Quarterly"
FILTER_VALUE_GAPS = "Value Gaps"
FILTER_RTH_ONLY = "RTH Only"
FILTER_GLOBEX_ONLY = "Globex Only"
FILTER_WEEKLY_ONLY = "Weekly Only"
FILTER_MONTHLY_ONLY = "Monthly Only"
FILTER_QUARTERLY_ONLY = "Quarterly Only"
CURRENT_AUTO = "Auto"
CURRENT_ON = "On"
CURRENT_OFF = "Off"
TOOLTIP_QUICK_FILTER = "Chooses visible anchors; Show Last counts still apply.\n\n• Manual — use Enable toggles.\n• Value Gaps — show the source anchor and gap context.\n• Anchor Only — show one anchor.\n\nUse the + controls for developing profiles."
TOOLTIP_RTH_PROFILES = "Recent RTH profiles to keep and draw in every Quick Filter mode."
TOOLTIP_GLOBEX_PROFILES = "Recent Globex profiles to keep and draw in every Quick Filter mode."
TOOLTIP_WEEKLY_PROFILES = "Recent Weekly profiles to keep and draw in every Quick Filter mode."
TOOLTIP_MONTHLY_PROFILES = "Recent Monthly profiles to keep and draw in every Quick Filter mode."
TOOLTIP_QUARTERLY_PROFILES = "Recent Quarterly profiles to keep and draw in every Quick Filter mode."
TOOLTIP_DEVELOPING_RTH = "Show today's developing RTH profile outside Manual mode."
TOOLTIP_DEVELOPING_GLOBEX = "Show the developing Globex profile outside Manual mode."
TOOLTIP_DEVELOPING_WEEKLY = "Weekly current profile:\n• Auto — show when mature.\n• On — always show.\n• Off — hide."
TOOLTIP_DEVELOPING_MONTHLY = "Monthly current profile:\n• Auto — show when mature.\n• On — always show.\n• Off — hide."
TOOLTIP_DEVELOPING_QUARTERLY = "Quarterly current profile:\n• Auto — show when mature.\n• On — always show.\n• Off — hide."

LEVEL_HIT_MAX_TIMEFRAME_SECONDS = 60 * 60
LABEL_SHOW_ONLY = "Show Only"
LABEL_HIDDEN_CANDLES = "Hidden Candles"
LABEL_MOST_RECENT_ONLY = "Most Recent Only"
TOOLTIP_SHOW_ONLY = "Dims candles outside the selected New York window. Profiles and drawings stay unchanged.\n\n• Overnight — 16:00–05:00.\n• ● ● RTH — 05:00–16:00.\n• ● RTH — 08:30–16:00.\n• RTH — 09:30–16:00.\n\nHigher timeframes dim whole candles; intraday portions cannot be split."
TOOLTIP_MOST_RECENT_ONLY = "Most Recent Only\nShows the selected window only on the current New York date. Weekends and holidays stay dim until the next session.\n\nOff — show the window every day."

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Quick Filter
// ═══════════════════════════════════════════════════════════════════════════════
quickFilter = input.string(FILTER_INTRADAY, "Quick Filter", options=[FILTER_ALL, FILTER_CORE, FILTER_PREP, FILTER_MACRO_PREP, FILTER_INTRADAY, FILTER_DUO, FILTER_SWING, FILTER_HORIZON, FILTER_MACRO, FILTER_VALUE_GAPS, FILTER_RTH_ONLY, FILTER_GLOBEX_ONLY, FILTER_WEEKLY_ONLY, FILTER_MONTHLY_ONLY, FILTER_QUARTERLY_ONLY], group=GROUP_QUICK_FILTER, tooltip=TOOLTIP_QUICK_FILTER)
isAll = quickFilter == FILTER_ALL
isCore = quickFilter == FILTER_CORE
isPrep = quickFilter == FILTER_PREP
isIntraday = quickFilter == FILTER_INTRADAY
isDuo = quickFilter == FILTER_DUO
isSwing = quickFilter == FILTER_SWING
isHorizon = quickFilter == FILTER_HORIZON
isMacro = quickFilter == FILTER_MACRO
isMacroPrep = quickFilter == FILTER_MACRO_PREP
isGapsFilter = quickFilter == FILTER_VALUE_GAPS
isRthOnly = quickFilter == FILTER_RTH_ONLY
isGlobexOnly = quickFilter == FILTER_GLOBEX_ONLY
isWeeklyOnly = quickFilter == FILTER_WEEKLY_ONLY
isMonthlyOnly = quickFilter == FILTER_MONTHLY_ONLY
isQuarterlyOnly = quickFilter == FILTER_QUARTERLY_ONLY
isCurated = isCore or isPrep or isMacroPrep
rthQuickFilterActive = isCurated or isIntraday or isDuo or isRthOnly
globexQuickFilterActive = isPrep or isMacroPrep or isIntraday or isGlobexOnly
weeklyQuickFilterActive = isCurated or isDuo or isSwing or isHorizon or isWeeklyOnly
monthlyQuickFilterActive = isCurated or isSwing or isHorizon or isMacro or isMonthlyOnly
quarterlyQuickFilterActive = isHorizon or isMacro or isMacroPrep or isQuarterlyOnly
rthMenuControlsActive = isAll or rthQuickFilterActive or isGapsFilter
globexMenuControlsActive = isAll or globexQuickFilterActive or isGapsFilter
weeklyMenuControlsActive = isAll or weeklyQuickFilterActive
monthlyMenuControlsActive = isAll or monthlyQuickFilterActive
quarterlyMenuControlsActive = isAll or quarterlyQuickFilterActive
quickPriceMode = input.string(PRICE_MODE_OFF, "Prices", options=[PRICE_MODE_OFF, PRICE_MODE_ACTIVE, PRICE_MODE_CUSTOM], group=GROUP_QUICK_FILTER, tooltip=TOOLTIP_PRICE_MODE)
includeDevelopingRth = input.bool(false, "+RTH", inline="ov_dev", group=GROUP_QUICK_FILTER, active=rthMenuControlsActive)
includeDevelopingGlobex = input.bool(false, "+Globex", inline="ov_dev", group=GROUP_QUICK_FILTER, active=globexMenuControlsActive, tooltip="+RTH\n" + TOOLTIP_DEVELOPING_RTH + "\n\n+Globex\n" + TOOLTIP_DEVELOPING_GLOBEX)
weeklyCurrentMode = input.string(CURRENT_AUTO, "+Weekly", options=[CURRENT_AUTO, CURRENT_ON, CURRENT_OFF], inline="ov_swing_current", group=GROUP_QUICK_FILTER, active=weeklyMenuControlsActive)
monthlyCurrentMode = input.string(CURRENT_AUTO, "+Monthly", options=[CURRENT_AUTO, CURRENT_ON, CURRENT_OFF], inline="ov_swing_current", group=GROUP_QUICK_FILTER, active=monthlyMenuControlsActive)
quarterlyCurrentMode = input.string(CURRENT_AUTO, "+Quarterly", options=[CURRENT_AUTO, CURRENT_ON, CURRENT_OFF], inline="ov_swing_current", group=GROUP_QUICK_FILTER, active=quarterlyMenuControlsActive, tooltip="+Weekly\n" + TOOLTIP_DEVELOPING_WEEKLY + "\n\n+Monthly\n" + TOOLTIP_DEVELOPING_MONTHLY + "\n\n+Quarterly\n" + TOOLTIP_DEVELOPING_QUARTERLY)
showOnlyEnabled = input.bool(true, LABEL_SHOW_ONLY, inline="show_only", group=GROUP_QUICK_FILTER)
hiddenCandleColor = input.color(color.new(color.rgb(245, 245, 245), 10), "", inline="show_only", group=GROUP_QUICK_FILTER, active=showOnlyEnabled)
visibleWindow = input.string(WINDOW_LABEL_RTH, "", options=[WINDOW_LABEL_OVERNIGHT, WINDOW_LABEL_FROM_0500, WINDOW_LABEL_FROM_0830, WINDOW_LABEL_RTH], inline="show_only", group=GROUP_QUICK_FILTER, active=showOnlyEnabled)
showOnlyMostRecent = input.bool(false, LABEL_MOST_RECENT_ONLY, inline="show_only", group=GROUP_QUICK_FILTER, active=showOnlyEnabled, tooltip=TOOLTIP_SHOW_ONLY + "\n\n———\n\n" + LABEL_MOST_RECENT_ONLY + "\n" + TOOLTIP_MOST_RECENT_ONLY)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Quick Filter: Settings
// ═══════════════════════════════════════════════════════════════════════════════
rthProfilesToShow = input.int(DEFAULT_RTH_PROFILES, "Show Last  ·  RTH", minval=1, maxval=50, inline="ov_counts", group=GROUP_QUICK_FILTER_SETTINGS, active=rthMenuControlsActive)
globexProfilesToShow = input.int(DEFAULT_GLOBEX_PROFILES, "Globex", minval=1, maxval=50, inline="ov_counts", group=GROUP_QUICK_FILTER_SETTINGS, active=globexMenuControlsActive, tooltip="RTH\n" + TOOLTIP_RTH_PROFILES + "\n\nGlobex\n" + TOOLTIP_GLOBEX_PROFILES)
weeklyProfilesToShow = input.int(DEFAULT_WEEKLY_PROFILES, "Weekly", minval=1, maxval=50, inline="ov_counts2", group=GROUP_QUICK_FILTER_SETTINGS, active=weeklyMenuControlsActive)
monthlyProfilesToShow = input.int(DEFAULT_MONTHLY_PROFILES, "Monthly", minval=1, maxval=50, inline="ov_counts2", group=GROUP_QUICK_FILTER_SETTINGS, active=monthlyMenuControlsActive)
quarterlyProfilesToShow = input.int(DEFAULT_QUARTERLY_PROFILES, "Quarterly", minval=1, maxval=50, inline="ov_counts2", group=GROUP_QUICK_FILTER_SETTINGS, active=quarterlyMenuControlsActive, tooltip="Weekly\n" + TOOLTIP_WEEKLY_PROFILES + "\n\nMonthly\n" + TOOLTIP_MONTHLY_PROFILES + "\n\nQuarterly\n" + TOOLTIP_QUARTERLY_PROFILES)
rthMergeMode = input.string(MERGE_ALL, LABEL_SHORT_SESSION_MERGE + "  ·  RTH", options=[MERGE_OFF, MERGE_EARLIEST, MERGE_ALL, MERGE_COMBINE], inline="ov_merge", group=GROUP_QUICK_FILTER_SETTINGS, active=rthMenuControlsActive)
globexMergeMode = input.string(MERGE_ALL, "Globex", options=[MERGE_OFF, MERGE_EARLIEST, MERGE_ALL, MERGE_COMBINE], inline="ov_merge", group=GROUP_QUICK_FILTER_SETTINGS, active=globexMenuControlsActive, tooltip="Short Sessions\nRTH: below 75% of its longest span. Globex: below 90%.\n\n• Off — keep separate.\n• Earliest — fold the first short into the prior full session.\n• All — fold consecutive shorts into the prior full session.\n• Combine — merge consecutive shorts.")

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Quick Filter: Prices
// ═══════════════════════════════════════════════════════════════════════════════
rthShowPrice = input.bool(false, "RTH", inline="ov_prices", group=GROUP_QUICK_FILTER_PRICES, active=quickPriceMode == PRICE_MODE_CUSTOM and rthMenuControlsActive)
globexShowPrice = input.bool(false, "Globex", inline="ov_prices", group=GROUP_QUICK_FILTER_PRICES, active=quickPriceMode == PRICE_MODE_CUSTOM and globexMenuControlsActive)
weeklyShowPrice = input.bool(false, "Weekly", inline="ov_prices", group=GROUP_QUICK_FILTER_PRICES, active=quickPriceMode == PRICE_MODE_CUSTOM and weeklyMenuControlsActive)
monthlyShowPrice = input.bool(false, "Monthly", inline="ov_prices", group=GROUP_QUICK_FILTER_PRICES, active=quickPriceMode == PRICE_MODE_CUSTOM and monthlyMenuControlsActive)
quarterlyShowPrice = input.bool(false, "Quarterly", inline="ov_prices", group=GROUP_QUICK_FILTER_PRICES, active=quickPriceMode == PRICE_MODE_CUSTOM and quarterlyMenuControlsActive, tooltip=TOOLTIP_CUSTOM_PRICES)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Quick Filter: Hit Trace
// ═══════════════════════════════════════════════════════════════════════════════
levelHitTraceEnabled = input.bool(true, "Level Hit Trace", inline="level_hit_trace", group=GROUP_QUICK_FILTER_HIT_TRACE)
levelHitIncludeHiddenAnchors = input.bool(true, "All Anchors", inline="level_hit_trace", group=GROUP_QUICK_FILTER_HIT_TRACE, active=levelHitTraceEnabled)
levelHitCircleMode = input.string(LEVEL_HIT_CIRCLE_SCALE_ANCHOR, "Circle", options=[LABEL_SIZE_TINY, LABEL_SIZE_SMALL, LABEL_SIZE_NORMAL, LABEL_SIZE_LARGE, LABEL_SIZE_HUGE, LEVEL_HIT_CIRCLE_SCALE_ANCHOR], inline="level_hit_trace", group=GROUP_QUICK_FILTER_HIT_TRACE, active=levelHitTraceEnabled, tooltip=TOOLTIP_LEVEL_HIT_TRACE)
levelHitDetectionWindow = input.string(WINDOW_LABEL_RTH, "Detect", options=[WINDOW_LABEL_FROM_0500, WINDOW_LABEL_FROM_0830, WINDOW_LABEL_RTH], inline="level_hit_window", group=GROUP_QUICK_FILTER_HIT_TRACE, active=levelHitTraceEnabled)
levelHitKeep = input.string(LEVEL_HIT_KEEP_DETECTION_WINDOW, "Keep", options=[LEVEL_HIT_KEEP_DETECTION_WINDOW, LEVEL_HIT_KEEP_ONE_DAY, LEVEL_HIT_KEEP_THREE_DAYS, LEVEL_HIT_KEEP_ONE_WEEK], inline="level_hit_window", group=GROUP_QUICK_FILTER_HIT_TRACE, active=levelHitTraceEnabled, tooltip=TOOLTIP_LEVEL_HIT_WINDOW)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — RTH session
// ═══════════════════════════════════════════════════════════════════════════════
rthEnabled = input.bool(true, LABEL_ENABLE_RTH, inline="rth_top", group=GROUP_RTH, active=isAll)
rthControlsActive = isAll ? rthEnabled : rthMenuControlsActive
rthExtensionMode = input.string(LEVEL_BREACH_SWEEP, "", options=[LEVEL_PERIOD, LEVEL_BREACH_ANY, LEVEL_BREACH_SAME, LEVEL_BREACH_SWEEP], inline="rth_top", group=GROUP_RTH, active=rthControlsActive, tooltip="RTH: 09:30–16:00 New York, Monday–Friday.\n\n• Session Only — stop at close.\n• Until Touched — stop at first trade-through.\n• Same-Session Touch — later RTH sessions only.\n• Until Swept — qualifying closes on both sides.")
rthSweepControlsActive = rthControlsActive and rthExtensionMode == LEVEL_BREACH_SWEEP
rthShowValueArea = input.bool(true, LABEL_VALUE_AREA_HIGH_LOW, inline="rth_value_area", group=GROUP_RTH, active=rthControlsActive)
rthValueAreaColor = input.color(color.new(color.rgb(144, 191, 249), 0), "", inline="rth_value_area", group=GROUP_RTH, active=rthControlsActive)
rthValueAreaWidth = input.string("2", "", options=["1", "2", "3", "4", "5"], inline="rth_value_area", group=GROUP_RTH, active=rthControlsActive)
rthValueAreaStyle = input.string(STYLE_SOLID, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="rth_value_area", group=GROUP_RTH, active=rthControlsActive)
rthValueAreaLabelColor = input.color(color.new(color.rgb(24, 72, 204), 20), "", inline="rth_value_area", group=GROUP_RTH, active=rthControlsActive, tooltip=TOOLTIP_VALUE_AREA_ROW)
rthValueAreaLastColor = input.color(color.new(color.rgb(73, 128, 216), 0), LABEL_LAST_VALUE_AREA_COLOR, inline="rth_value_area_last", group=GROUP_RTH, active=rthControlsActive)
rthValueAreaLastWidth = input.string("2", "", options=["1", "2", "3", "4", "5"], inline="rth_value_area_last", group=GROUP_RTH, active=rthControlsActive, tooltip=TOOLTIP_LAST_VALUE_AREA_ROW)
rthShowPoc = input.bool(true, LABEL_POC, inline="rth_poc", group=GROUP_RTH, active=rthControlsActive)
rthPocColor = input.color(color.new(color.rgb(156, 39, 176), 0), "", inline="rth_poc", group=GROUP_RTH, active=rthControlsActive)
rthPocWidth = input.string("2", "", options=["1", "2", "3", "4", "5"], inline="rth_poc", group=GROUP_RTH, active=rthControlsActive)
rthPocStyle = input.string(STYLE_DASHED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="rth_poc", group=GROUP_RTH, active=rthControlsActive)
rthPocLabelColor = input.color(color.new(color.rgb(123, 31, 162), 0), "", inline="rth_poc", group=GROUP_RTH, active=rthControlsActive, tooltip=TOOLTIP_POC_ROW)
rthShowAlternatePoc = input.bool(false, LABEL_ALTERNATE_POC, inline="rth_altpoc", group=GROUP_RTH, active=rthControlsActive)
rthAlternatePocColor = input.color(color.new(color.rgb(233, 30, 99), 0), "", inline="rth_altpoc", group=GROUP_RTH, active=rthControlsActive)
rthAlternatePocWidth = input.string("2", "", options=["1", "2", "3", "4", "5"], inline="rth_altpoc", group=GROUP_RTH, active=rthControlsActive)
rthAlternatePocStyle = input.string(STYLE_DOTTED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="rth_altpoc", group=GROUP_RTH, active=rthControlsActive)
rthAlternatePocLabelColor = input.color(color.new(color.rgb(194, 24, 91), 0), "", inline="rth_altpoc", group=GROUP_RTH, active=rthControlsActive, tooltip=TOOLTIP_ALTERNATE_POC_ROW)
rthShowSessionBox = input.bool(false, LABEL_RTH_ANCHOR + " " + LABEL_BOX, inline="rth_hist", group=GROUP_RTH, active=rthControlsActive)
rthSessionBoxColor = input.color(color.new(color.rgb(187, 217, 251), 90), "", inline="rth_hist", group=GROUP_RTH, active=rthControlsActive)
rthShowHistogram = input.bool(true, LABEL_VALUE_AREA, inline="rth_hist", group=GROUP_RTH, active=rthControlsActive)
rthHistogramInsideColor = input.color(color.new(color.rgb(91, 156, 246), 75), LABEL_HISTOGRAM_INSIDE, inline="rth_hist", group=GROUP_RTH, active=rthControlsActive)
rthHistogramOutsideColor = input.color(color.new(color.rgb(184, 184, 184), 80), LABEL_HISTOGRAM_OUTSIDE, inline="rth_hist", group=GROUP_RTH, active=rthControlsActive, tooltip=TOOLTIP_HISTOGRAM_ROW)
rthDimTouched = input.bool(true, LABEL_DIM_TOUCHED, inline="rth_dim", group=GROUP_RTH, active=rthControlsActive)
rthDimPercent = input.int(85, LABEL_DIM_PERCENT, minval=0, maxval=100, inline="rth_dim", group=GROUP_RTH, active=rthControlsActive and rthDimTouched, tooltip=TOOLTIP_DIM_ROW)
rthLevelLabelSize = input.string(LABEL_SIZE_SMALL, LABEL_LEVEL_LABELS, options=[LABEL_SIZE_TINY, LABEL_SIZE_SMALL, LABEL_SIZE_NORMAL, LABEL_SIZE_LARGE, LABEL_SIZE_HUGE], group=GROUP_RTH, active=rthControlsActive, tooltip=TOOLTIP_LEVEL_LABEL_SIZE)
rthDevelopingEnabled = input.bool(true, LABEL_DEVELOPING_PROFILE, inline="rth_developing", group=GROUP_RTH, active=rthControlsActive)
rthDevelopingColor = input.color(color.new(color.rgb(184, 184, 184), 20), "", inline="rth_developing", group=GROUP_RTH, active=rthControlsActive and rthDevelopingEnabled, tooltip="Temporarily recolor the live RTH profile — every line and label — before the cutoff so it reads as still developing.")
rthDevelopingCutoffHour = input.int(11, "Developing Cutoff", minval=0, maxval=23, inline="rth_developing_cutoff", group=GROUP_RTH, active=rthControlsActive and rthDevelopingEnabled)
rthDevelopingCutoffMinute = input.int(30, ":", minval=0, maxval=59, inline="rth_developing_cutoff", group=GROUP_RTH, active=rthControlsActive and rthDevelopingEnabled, tooltip="New York cutoff time. Developing colors apply only before this HH:MM.")

