LABEL_MERGE_BALANCED_PERCENT = 0.010
LABEL_MERGE_WIDE_PERCENT = 0.025
LABEL_MERGE_EXTRA_WIDE_PERCENT = 0.050
MERGED_LINE_FADE_PERCENT = 85
LABEL_NAME_SEPARATOR = " | "
PERIOD_LABEL_DAY = "Day"
PERIOD_LABEL_MONTH = "Month"
PERIOD_LABEL_QUARTER = "Quarter"

PROFILE_ROWS = 250
HISTOGRAM_WIDTH_PERCENT = 25.0
VALUE_AREA_PERCENT = 70.0

// Where HD data is unavailable (deep history, Bar Replay) the chart-bar fallback is folded into
// aligned five-minute buckets so sub-5m charts build the same profiles as a 5m chart.
FALLBACK_PARITY_BUCKET_MS = 5 * 60 * 1000
// Two calendar quarters plus buffer cover the previous completed quarter from any current-quarter date.
QUARTERLY_MAX_TWO_QUARTERS_DAYS = 184
QUARTERLY_HISTORY_BUFFER_DAYS = 16
QUARTERLY_LOOKBACK_DAYS = QUARTERLY_MAX_TWO_QUARTERS_DAYS + QUARTERLY_HISTORY_BUFFER_DAYS
QUARTERLY_CALCULATION_MINUTES = 15
QUARTERLY_INTRABAR_MINUTES = 5
QUARTERLY_CALCULATION_TIMEFRAME = str.tostring(QUARTERLY_CALCULATION_MINUTES)
QUARTERLY_INTRABAR_TIMEFRAME = str.tostring(QUARTERLY_INTRABAR_MINUTES)
QUARTERLY_CALCULATION_BARS = int(QUARTERLY_LOOKBACK_DAYS * MINUTES_PER_DAY / QUARTERLY_CALCULATION_MINUTES)
QUARTERLY_INTRABAR_BARS = int(QUARTERLY_CALCULATION_BARS * QUARTERLY_CALCULATION_MINUTES / QUARTERLY_INTRABAR_MINUTES)
QUARTERLY_SNAPSHOT_MINUTE = MINUTES_PER_HOUR - QUARTERLY_CALCULATION_MINUTES
// Completion-day and sparse Monday snapshots transfer histogram rows without returning a Profile object continuously.
QUARTERLY_UTC_WEEKLY_SNAPSHOT_HOUR = 0
QUARTERLY_MARKET_WEEKLY_SNAPSHOT_HOUR = 9

DEFAULT_RTH_PROFILES = 10
DEFAULT_GLOBEX_PROFILES = 10
DEFAULT_WEEKLY_PROFILES = 5
DEFAULT_MONTHLY_PROFILES = 2
DEFAULT_QUARTERLY_PROFILES = 2
