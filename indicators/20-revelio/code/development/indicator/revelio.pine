UPCOMING_VALUE_GAP_MIN_PERCENT = 45.0
MAX_LEVEL_HIT_EVENTS = INDICATOR_MAX_LABELS
MAX_LEVEL_HIT_TRADING_DAY_SCAN = 10
MAX_LEVEL_HIT_WEEKDAY_RETENTION_DAYS = 5
// Ranges are per lower-timeframe sub-bar, so the cap must cover the full scan window in minutes.
MAX_FOCUS_HIT_RANGES = (MAX_LEVEL_HIT_TRADING_DAY_SCAN + 1) * MINUTES_PER_DAY
FOCUS_HIT_RANGE_RETENTION_MS = (MAX_LEVEL_HIT_TRADING_DAY_SCAN + 1) * MS_PER_DAY
AUTO_SWEPT_ADR_LOOKBACK = 14
AUTO_SWEPT_ADR_MIN_TRIM_SAMPLES = 5
