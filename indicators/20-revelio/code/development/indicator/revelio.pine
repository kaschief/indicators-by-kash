// ═══════════════════════════════════════════════════════════════════════════════
// TYPES
// ═══════════════════════════════════════════════════════════════════════════════
type LevelHitRange
    int barTime
    int chartBarTime
    int contactTime
    float highPrice
    float lowPrice
    float startPrice

type ValueGapStyle
    color bullishColor
    color bearishColor
    color filledColor
    color bullishBorderColor
    color bearishBorderColor
    color bullishLabelColor
    color bearishLabelColor
    color mitigatedLabelColor
    string labelSize
    color midpointOpenLineColor
    color midpointMitigatedLineColor
    bool showMidpointLabel
    color quartileOpenLineColor
    color quartileMitigatedLineColor
    string internalLabelSize
    int internalLabelFade
    bool showInternalReminders

type SessionStyle
    string extensionMode
    bool dimTouched
    float dimFraction
    bool showPoc
    color pocColor
    int pocWidth
    string pocStyle
    bool showAlternatePoc
    color alternatePocColor
    int alternatePocWidth
    string alternatePocStyle
    bool showValueArea
    color valueAreaColor
    color valueAreaLastColor
    int valueAreaWidth
    string valueAreaStyle
    bool showHistogram
    color histogramInsideColor
    color histogramOutsideColor
    bool showSessionBox
    color sessionBoxColor
    bool showPrice
    color levelLabelBgColor
    color valueAreaLabelColor
    color pocLabelColor
    color alternatePocLabelColor
    string levelLabelSize
    int levelLabelOffset
    bool developingEnabled
    color developingColor
    float sweptContinuationFraction
    int sweptContinuationWidth
    int sweptKeepMs
    string labelAnchor
    string periodLabelMode
    bool useUtcLabelTimezone
    string labelLive
    string labelLast
    int valueAreaLastWidth

// Shared newest-first allocator metadata for level lines and histograms.
type RenderBudgetAnchor
    array<revelioCore.Profile> profiles
    revelioCore.AutoSweptState autoSweptState
    SessionStyle style
    bool levelsEnabled
    bool histogramEnabled
    array<bool> focusSelections
    array<int> autoSweptVisibilityMasks
    array<int> autoSweptProtectedVisibilityMasks
    bool restrictToFocus
    bool surfaceSweptLevels

// One completed profile competing for a Focus slot.
type FocusCandidate
    float distance
    int profileIndex
    int endTime

type FocusHitLevel
    revelioCore.Profile profile
    float price
    int breachTime
    int nextProfileFinalizedTime
    int autoGraceEndTime
    revelioCore.AutoSweptState autoSweptState
    revelioCore.AutoSweptLevel autoSweptLevel
    bool sweptLevel
    bool surfaceSweptLevels
    int sweptKeepMs
    bool olderSweptEligible
    bool limitDailyRetouches
    string levelName
    string sourceProfileKey
    string key

// Declared before the calculation functions so the developing-profile builder can read the
// pending bucket that confirmed fallback bars accumulate into.
chartBarMs = timeframe.in_seconds(timeframe.period) * 1000
// Range and other non-time bars are not five-minute-alignable, so parity bucketing is time-charts only.
fallbackBucketAggregationActive = chart.is_standard and chartBarMs < FALLBACK_PARITY_BUCKET_MS and FALLBACK_PARITY_BUCKET_MS % chartBarMs == 0
var float fallbackBucketHigh = na
var float fallbackBucketLow = na
var float fallbackBucketVolume = na
var int fallbackBucketId = -1

// Touch contact set for the current bar: price ranges that actually traded, one per eligible
// lower-timeframe sub-bar (or the chart bar as fallback). Realtime entries follow the price path
// between consecutive updates, so interior revisits remain detectable on larger chart bars.
var array<float> levelHitContactHighs = array.new<float>()
var array<float> levelHitContactLows = array.new<float>()
var array<float> levelHitContactStarts = array.new<float>()
var array<int> levelHitContactTimes = array.new<int>()
varip float livePreviousClose = na
varip int liveCoveredBarTime = na

// ═══════════════════════════════════════════════════════════════════════════════
// FUNCTIONS — calculation (parameterized, reused for every anchor)
// ═══════════════════════════════════════════════════════════════════════════════

autoIntrabarTimeframe() =>
    chartSeconds = timeframe.in_seconds(timeframe.period)
    chartSeconds < 60 ? "1S" : chartSeconds <= 15 * 60 ? "1" : chartSeconds <= 60 * 60 ? "5" : chartSeconds <= 4 * 60 * 60 ? "15" : "60"

mergeCombine(string mode) =>
    mode == MERGE_COMBINE

mergeAll(string mode) =>
    mode == MERGE_ALL

mergeDepth(string mode) =>
    mode == MERGE_EARLIEST ? 1 : mode == MERGE_COMBINE ? 2 : 0

newMergedAnchorProcessPolicy(int keepProfiles, string mergeMode, float shortSpanFraction, bool continuousBoundary, bool prepareHistogram) =>
    revelioCore.newAnchorProcessPolicy(keepProfiles, mergeDepth(mergeMode), mergeAll(mergeMode), mergeCombine(mergeMode), shortSpanFraction, continuousBoundary, prepareHistogram, false)

newCalendarAnchorProcessPolicy(int keepProfiles, bool prepareHistogram, bool requireObservedBoundary) =>
    revelioCore.newAnchorProcessPolicy(keepProfiles, 0, false, false, 1.0, true, prepareHistogram, requireObservedBoundary)

toLabelSize(string sizeName) =>
    sizeName == LABEL_SIZE_TINY ? size.tiny : sizeName == LABEL_SIZE_NORMAL ? size.normal : sizeName == LABEL_SIZE_LARGE ? size.large : sizeName == LABEL_SIZE_HUGE ? size.huge : size.small

levelHitCircleSizeForAnchor(string anchorName) =>
    if anchorName == LABEL_RTH_ANCHOR or anchorName == LABEL_GLOBEX_ANCHOR
        LABEL_SIZE_NORMAL
    else if anchorName == LABEL_WEEKLY_ANCHOR
        LABEL_SIZE_LARGE
    else
        LABEL_SIZE_HUGE

monthName(int monthNumber) =>
    switch monthNumber
        1 => "Jan"
        2 => "Feb"
        3 => "Mar"
        4 => "Apr"
        5 => "May"
        6 => "Jun"
        7 => "Jul"
        8 => "Aug"
        9 => "Sep"
        10 => "Oct"
        11 => "Nov"
        => "Dec"

periodDateText(int startTime, string labelMode, bool useUtcTimezone) =>
    int startMonth = useUtcTimezone ? month(startTime, UTC_TIMEZONE) : month(startTime, NY_TIMEZONE)
    int startYear = useUtcTimezone ? year(startTime, UTC_TIMEZONE) : year(startTime, NY_TIMEZONE)
    if labelMode == PERIOD_LABEL_QUARTER
        int quarterNumber = int(math.floor((startMonth - 1) / 3)) + 1
        "Q" + str.tostring(quarterNumber) + " " + str.tostring(startYear)
    else if labelMode == PERIOD_LABEL_MONTH
        monthName(startMonth) + " " + str.tostring(startYear)
    else
        int startDay = useUtcTimezone ? dayofmonth(startTime, UTC_TIMEZONE) : dayofmonth(startTime, NY_TIMEZONE)
        monthName(startMonth) + " " + str.tostring(startDay)

periodContextText(int startTime, string labelMode, bool useUtcTimezone) =>
    int startMonth = useUtcTimezone ? month(startTime, UTC_TIMEZONE) : month(startTime, NY_TIMEZONE)
    int startYear = useUtcTimezone ? year(startTime, UTC_TIMEZONE) : year(startTime, NY_TIMEZONE)
    labelMode == PERIOD_LABEL_DAY ? monthName(startMonth) : str.tostring(startYear)

periodMemberText(int startTime, string labelMode, bool useUtcTimezone) =>
    int startMonth = useUtcTimezone ? month(startTime, UTC_TIMEZONE) : month(startTime, NY_TIMEZONE)
    if labelMode == PERIOD_LABEL_QUARTER
        "Q" + str.tostring(int(math.floor((startMonth - 1) / 3)) + 1)
    else if labelMode == PERIOD_LABEL_MONTH
        monthName(startMonth)
    else
        int startDay = useUtcTimezone ? dayofmonth(startTime, UTC_TIMEZONE) : dayofmonth(startTime, NY_TIMEZONE)
        str.tostring(startDay)

calendarDateText(int eventTime, bool useUtcTimezone) =>
    int eventMonth = useUtcTimezone ? month(eventTime, UTC_TIMEZONE) : month(eventTime, NY_TIMEZONE)
    int eventDay = useUtcTimezone ? dayofmonth(eventTime, UTC_TIMEZONE) : dayofmonth(eventTime, NY_TIMEZONE)
    int eventYear = useUtcTimezone ? year(eventTime, UTC_TIMEZONE) : year(eventTime, NY_TIMEZONE)
    monthName(eventMonth) + " " + str.tostring(eventDay) + ", " + str.tostring(eventYear)

sameCalendarDate(int firstTime, int secondTime, string timezone) =>
    year(firstTime, timezone) == year(secondTime, timezone) and month(firstTime, timezone) == month(secondTime, timezone) and dayofmonth(firstTime, timezone) == dayofmonth(secondTime, timezone)

toLineStyle(string styleName) =>
    styleName == STYLE_DASHED ? line.style_dashed : styleName == STYLE_DOTTED ? line.style_dotted : line.style_solid

isTrueWeekendBar(int barTime) =>
    int barDay = dayofweek(barTime, NY_TIMEZONE)
    int barHour = hour(barTime, NY_TIMEZONE)
    barDay == dayofweek.saturday or (barDay == dayofweek.sunday and barHour < SUNDAY_REOPEN_START_HOUR)

calendarDayStart(string timezone) =>
    ta.change(dayofmonth(time, timezone)) != 0

shiftedCalendarDayStart(string timezone, int timeShiftMilliseconds) =>
    ta.change(dayofmonth(time + timeShiftMilliseconds, timezone)) != 0

calendarWeekStart(string timezone) =>
    ta.change(weekofyear(time, timezone)) != 0

calendarMonthStart(string timezone) =>
    ta.change(month(time, timezone)) != 0

// Quarters are the calendar standard: Jan–Mar, Apr–Jun, Jul–Sep, Oct–Dec.
calendarQuarterStart(string timezone) =>
    ta.change(month(time, timezone)) != 0 and (month(time, timezone) - 1) % 3 == 0

selectAssetCalendarStart(bool useUtcCalendar, bool utcStart, bool marketStart) =>
    useUtcCalendar ? utcStart : marketStart

isBeforeNyCutoff(int cutoffHour, int cutoffMinute) =>
    int currentMinutes = hour(time, NY_TIMEZONE) * 60 + minute(time, NY_TIMEZONE)
    int cutoffMinutes = cutoffHour * 60 + cutoffMinute
    currentMinutes < cutoffMinutes

buildDevelopingProfile(array<float> barHighs, array<float> barLows, array<float> barVolumes, int startTime, array<float> intrabarHighs, array<float> intrabarLows, array<float> intrabarVolumes, bool prepareHistogram) =>
    int originalSize = array.size(barVolumes)
    if not na(fallbackBucketVolume)
        array.push(barHighs, fallbackBucketHigh)
        array.push(barLows, fallbackBucketLow)
        array.push(barVolumes, fallbackBucketVolume)
    if not barstate.isconfirmed
        revelioCore.appendBarVolume(barHighs, barLows, barVolumes, intrabarHighs, intrabarLows, intrabarVolumes, high, low, volume, false)
    revelioCore.Profile profile = revelioCore.buildProfile(barHighs, barLows, barVolumes, PROFILE_ROWS, VALUE_AREA_PERCENT, startTime, time, prepareHistogram)
    while array.size(barVolumes) > originalSize
        array.pop(barHighs)
        array.pop(barLows)
        array.pop(barVolumes)
    profile

buildDevelopingAnchorProfile(revelioCore.AnchorState state, array<float> intrabarHighs, array<float> intrabarLows, array<float> intrabarVolumes, bool prepareHistogram) =>
    buildDevelopingProfile(state.barHighs, state.barLows, state.barVolumes, state.startTime, intrabarHighs, intrabarLows, intrabarVolumes, prepareHistogram)

nyPriceWindowTimestampEligible(int timestamp, int startMinute, bool allDays) =>
    int day = dayofweek(timestamp, NY_TIMEZONE)
    bool dayEligible = allDays or (day >= dayofweek.monday and day <= dayofweek.friday)
    int minuteOfDay = hour(timestamp, NY_TIMEZONE) * 60 + minute(timestamp, NY_TIMEZONE)
    dayEligible and minuteOfDay >= startMinute and minuteOfDay < RTH_END_MINUTE

priceWindowMayContainEligiblePrice(int startMinute, array<int> intrabarTimes, bool allDays, bool fallbackWindow) =>
    bool possible = false
    int intrabarCount = array.size(intrabarTimes)
    if intrabarCount > 0
        int firstTime = array.first(intrabarTimes)
        int lastTime = array.last(intrabarTimes)
        int windowSpanMs = (RTH_END_MINUTE - startMinute) * 60 * 1000
        possible := nyPriceWindowTimestampEligible(firstTime, startMinute, allDays) or nyPriceWindowTimestampEligible(lastTime, startMinute, allDays) or lastTime - firstTime >= windowSpanMs
    else
        possible := fallbackWindow
    possible

priceWindowRange(int startMinute, array<float> intrabarHighs, array<float> intrabarLows, array<int> intrabarTimes, bool allDays, bool fallbackWindow) =>
    float eligibleHigh = na
    float eligibleLow = na
    int intrabarCount = array.size(intrabarTimes)
    if intrabarCount > 0
        for intrabarIndex = 0 to intrabarCount - 1
            if nyPriceWindowTimestampEligible(array.get(intrabarTimes, intrabarIndex), startMinute, allDays)
                float subHigh = array.get(intrabarHighs, intrabarIndex)
                float subLow = array.get(intrabarLows, intrabarIndex)
                eligibleHigh := na(eligibleHigh) ? subHigh : math.max(eligibleHigh, subHigh)
                eligibleLow := na(eligibleLow) ? subLow : math.min(eligibleLow, subLow)
    else if fallbackWindow
        eligibleHigh := high
        eligibleLow := low
    [eligibleHigh, eligibleLow]

valueGapFillStartMinute(string fillWindow) =>
    fillWindow == WINDOW_LABEL_RTH ? RTH_START_MINUTE : fillWindow == WINDOW_LABEL_FROM_0830 ? FROM_0830_START_MINUTE : FROM_0500_START_MINUTE

fillRangeMayContainEligiblePrice(string fillWindow, array<int> intrabarTimes, bool allDays, bool fallbackWindow) =>
    fillWindow == WINDOW_LABEL_OVERNIGHT or priceWindowMayContainEligiblePrice(valueGapFillStartMinute(fillWindow), intrabarTimes, allDays, fallbackWindow)

valueGapFillRange(string fillWindow, array<float> intrabarHighs, array<float> intrabarLows, array<int> intrabarTimes, bool allDays, bool fallbackWindow) =>
    float eligibleHigh = na
    float eligibleLow = na
    if fillWindow == WINDOW_LABEL_OVERNIGHT
        eligibleHigh := high
        eligibleLow := low
    else
        [windowHigh, windowLow] = priceWindowRange(valueGapFillStartMinute(fillWindow), intrabarHighs, intrabarLows, intrabarTimes, allDays, fallbackWindow)
        eligibleHigh := windowHigh
        eligibleLow := windowLow
    [eligibleHigh, eligibleLow]

reminderPlacements(int runMs, int spacingMs, int maxCount) =>
    math.min(maxCount, math.max(1, int(math.floor(math.sqrt(float(runMs) / math.max(1, spacingMs))))))

levelEndpoint(int endTime, int breachTime, string extensionMode) =>
    int rightEdge = endTime
    bool extendRight = false
    if extensionMode == LEVEL_BREACH_ANY or extensionMode == LEVEL_BREACH_SAME or extensionMode == LEVEL_BREACH_SWEEP
        if na(breachTime)
            extendRight := true
        else
            rightEdge := breachTime
    [rightEdge, extendRight]

// ═══════════════════════════════════════════════════════════════════════════════
// FUNCTIONS — rendering
// ═══════════════════════════════════════════════════════════════════════════════

var array<box> drawnBoxes = array.new<box>()
var array<line> drawnLines = array.new<line>()
var array<polyline> drawnPolylines = array.new<polyline>()
var array<label> drawnLabels = array.new<label>()
var array<revelioInteractions.PendingLabel> pendingLabels = array.new<revelioInteractions.PendingLabel>()
var array<revelioInteractions.PendingReminder> pendingReminders = array.new<revelioInteractions.PendingReminder>()
var array<revelioInteractions.PendingAnchorReminder> pendingAnchorReminders = array.new<revelioInteractions.PendingAnchorReminder>()

// Preserve earlier render priorities; discard new drawings after a global cap is reached.
trackBox(box drawing) =>
    bool retained = array.size(drawnBoxes) < INDICATOR_MAX_BOXES
    if retained
        array.push(drawnBoxes, drawing)
    else
        box.delete(drawing)
    retained

trackLine(line drawing) =>
    bool retained = array.size(drawnLines) < INDICATOR_MAX_LINES
    if retained
        array.push(drawnLines, drawing)
    else
        line.delete(drawing)
    retained

trackPolyline(polyline drawing) =>
    bool retained = array.size(drawnPolylines) < INDICATOR_MAX_POLYLINES
    if retained
        array.push(drawnPolylines, drawing)
    else
        polyline.delete(drawing)
    retained

trackLabel(label drawing) =>
    bool retained = array.size(drawnLabels) < INDICATOR_MAX_LABELS
    if retained
        array.push(drawnLabels, drawing)
    else
        label.delete(drawing)
    retained

clearDrawings() =>
    if array.size(drawnBoxes) > 0
        for boxIndex = 0 to array.size(drawnBoxes) - 1
            box.delete(array.get(drawnBoxes, boxIndex))
        array.clear(drawnBoxes)
    if array.size(drawnLines) > 0
        for lineIndex = 0 to array.size(drawnLines) - 1
            line.delete(array.get(drawnLines, lineIndex))
        array.clear(drawnLines)
    if array.size(drawnPolylines) > 0
        for polylineIndex = 0 to array.size(drawnPolylines) - 1
            polyline.delete(array.get(drawnPolylines, polylineIndex))
        array.clear(drawnPolylines)
    if array.size(drawnLabels) > 0
        for labelIndex = 0 to array.size(drawnLabels) - 1
            label.delete(array.get(drawnLabels, labelIndex))
        array.clear(drawnLabels)
    array.clear(pendingLabels)
    array.clear(pendingReminders)
    array.clear(pendingAnchorReminders)

valueGapLabelText(revelioGaps.ValueGap gap, bool useUtcTimezone) =>
    bool isFilled = not na(gap.fillTime)
    string fillSuffix = isFilled ? " " + SWEPT_CHECKMARK : revelioGaps.isUntouched(gap) ? "" : " " + str.tostring(revelioGaps.fillPercent(gap), "#") + "%"
    string dateText = calendarDateText(gap.creationTime, useUtcTimezone)
    valueGapSource + " Value Gap" + fillSuffix + "\n" + dateText

confirmedValueGapStyle() =>
    ValueGapStyle.new(color.new(color.rgb(146, 198, 239), 70), color.new(color.rgb(244, 143, 177), 65), color.new(color.rgb(219, 219, 219), 91), color.new(color.rgb(49, 121, 245), 35), color.new(color.rgb(194, 24, 91), 50), color.rgb(57, 120, 221), color.rgb(233, 30, 99), color.new(color.rgb(184, 184, 184), 20), LABEL_SIZE_SMALL, color.new(color.rgb(74, 74, 74), 40), color.new(color.rgb(184, 184, 184), 20), true, color.new(color.rgb(74, 74, 74), 10), color.new(color.rgb(184, 184, 184), 20), LABEL_SIZE_TINY, VALUE_GAP_INTERNAL_LABEL_FADE_PERCENT, valueGapShowInternalReminders)

upcomingValueGapStyle() =>
    ValueGapStyle.new(color.new(color.rgb(255, 238, 88), 85), color.new(color.rgb(255, 238, 88), 85), color.new(color.rgb(219, 219, 219), 91), color.rgb(251, 192, 45), color.rgb(251, 192, 45), color.rgb(57, 120, 221), color.rgb(233, 30, 99), color.new(color.rgb(184, 184, 184), 20), LABEL_SIZE_SMALL, color.new(color.rgb(74, 74, 74), 40), color.new(color.rgb(184, 184, 184), 20), false, color.new(color.rgb(74, 74, 74), 10), color.new(color.rgb(184, 184, 184), 20), LABEL_SIZE_TINY, VALUE_GAP_INTERNAL_LABEL_FADE_PERCENT, false)

floatingValueGapStyle() =>
    ValueGapStyle.new(color.new(color.rgb(146, 198, 239), 70), color.new(color.rgb(244, 143, 177), 65), color.new(color.rgb(219, 219, 219), 91), color.new(color.rgb(49, 121, 245), 35), color.new(color.rgb(194, 24, 91), 50), color.rgb(57, 120, 221), color.rgb(233, 30, 99), color.new(color.rgb(184, 184, 184), 20), LABEL_SIZE_SMALL, color.new(color.rgb(74, 74, 74), 40), color.new(color.rgb(184, 184, 184), 20), false, color.new(color.rgb(74, 74, 74), 10), color.new(color.rgb(184, 184, 184), 20), LABEL_SIZE_TINY, VALUE_GAP_INTERNAL_LABEL_FADE_PERCENT, false)

// Only the confirmed style enables reminders, so runMs is always a bar_time span, never a bar count.
valueGapInternalPlacements(ValueGapStyle style, int runMs) =>
    style.showInternalReminders and runMs > 0 ? reminderPlacements(runMs, SWEPT_REMINDER_BASE_MS, VALUE_GAP_REMINDER_MAX_PER_LEVEL) : 1

valueGapInternalLabelText(float levelFraction) =>
    valueGapSource + " Gap " + str.tostring(int(levelFraction * 100)) + "%"

valueGapLabelCost(revelioGaps.ValueGap gap, ValueGapStyle style, int runMs) =>
    int internalLabels = na(gap.fillTime) and style.showMidpointLabel ? valueGapInternalPlacements(style, runMs) : 0
    1 + internalLabels

pushValueGapInternalLabels(int leftEdge, int rightEdge, int placements, string xLocation, float price, string labelText, color textColor, string labelSize) =>
    for placement = 1 to placements
        int labelEdge = leftEdge + int((rightEdge - leftEdge) * (placement - 0.5) / placements)
        trackLabel(label.new(labelEdge, price, labelText, xloc=xLocation, yloc=yloc.price, color=VALUE_GAP_MIDPOINT_LABEL_BG, textcolor=textColor, style=label.style_label_center, size=labelSize, textalign=text.align_center))

renderStyledValueGap(revelioGaps.ValueGap gap, int leftEdge, int rightEdge, string xLocation, ValueGapStyle style, string labelText, bool emphasize) =>
    color unfilledColor = gap.bullish ? style.bullishColor : style.bearishColor
    int referenceWidth = emphasize ? VALUE_GAP_BOLD_REFERENCE_WIDTH : VALUE_GAP_REFERENCE_WIDTH
    [topFilledTop, topFilledBottom, coreTop, coreBottom, bottomFilledTop, bottomFilledBottom] = revelioGaps.boxGeometry(gap)
    if topFilledTop != topFilledBottom
        trackBox(box.new(left=leftEdge, top=topFilledTop, right=rightEdge, bottom=topFilledBottom, xloc=xLocation, bgcolor=style.filledColor, border_color=na))
    if coreTop != coreBottom
        trackBox(box.new(left=leftEdge, top=coreTop, right=rightEdge, bottom=coreBottom, xloc=xLocation, bgcolor=unfilledColor, border_color=na))
    if bottomFilledTop != bottomFilledBottom
        trackBox(box.new(left=leftEdge, top=bottomFilledTop, right=rightEdge, bottom=bottomFilledBottom, xloc=xLocation, bgcolor=style.filledColor, border_color=na))

    bool gapFilled = not na(gap.fillTime)
    float gapRange = gap.top - gap.bottom
    color gapLabelColor = gap.bullish ? style.bullishLabelColor : style.bearishLabelColor
    float cePrice = gap.bottom + gapRange * VALUE_GAP_CE_LEVEL
    bool midpointMitigated = revelioGaps.levelFilled(gap, cePrice)
    color midpointLineColor = midpointMitigated ? style.midpointMitigatedLineColor : style.midpointOpenLineColor
    trackLine(line.new(leftEdge, cePrice, rightEdge, cePrice, xloc=xLocation, color=midpointLineColor, style=line.style_dashed, width=referenceWidth))
    if style.showMidpointLabel and not gapFilled
        color internalLabelColor = color.new(gapLabelColor, math.min(100, int(color.t(gapLabelColor)) + style.internalLabelFade))
        string internalLabelSize = toLabelSize(style.internalLabelSize)
        int internalPlacements = valueGapInternalPlacements(style, rightEdge - leftEdge)
        pushValueGapInternalLabels(leftEdge, rightEdge, internalPlacements, xLocation, cePrice, valueGapInternalLabelText(VALUE_GAP_CE_LEVEL), internalLabelColor, internalLabelSize)

    float q1Price = gap.bottom + gapRange * VALUE_GAP_Q1_LEVEL
    float q3Price = gap.bottom + gapRange * VALUE_GAP_Q3_LEVEL
    bool q1Mitigated = revelioGaps.levelFilled(gap, q1Price)
    bool q3Mitigated = revelioGaps.levelFilled(gap, q3Price)
    color q1LineColor = q1Mitigated ? style.quartileMitigatedLineColor : style.quartileOpenLineColor
    color q3LineColor = q3Mitigated ? style.quartileMitigatedLineColor : style.quartileOpenLineColor
    trackLine(line.new(leftEdge, q1Price, rightEdge, q1Price, xloc=xLocation, color=q1LineColor, style=line.style_dotted, width=referenceWidth))
    trackLine(line.new(leftEdge, q3Price, rightEdge, q3Price, xloc=xLocation, color=q3LineColor, style=line.style_dotted, width=referenceWidth))

    color borderColor = gap.bullish ? style.bullishBorderColor : style.bearishBorderColor
    trackBox(box.new(left=leftEdge, top=gap.top, right=rightEdge, bottom=gap.bottom, xloc=xLocation, bgcolor=na, border_color=borderColor, border_width=referenceWidth))

    int labelEdge = leftEdge + int((rightEdge - leftEdge) * 0.5)
    bool labelAbove = not gap.bullish
    float labelPrice = labelAbove ? gap.top : gap.bottom
    string labelStyle = labelAbove ? label.style_label_down : label.style_label_up
    color labelColor = gapFilled ? style.mitigatedLabelColor : gapLabelColor
    trackLabel(label.new(labelEdge, labelPrice, labelText, xloc=xLocation, yloc=yloc.price, color=VALUE_GAP_LABEL_BG_TRANSPARENT, textcolor=labelColor, style=labelStyle, size=toLabelSize(style.labelSize), textalign=text.align_center))

renderFloatingValueGaps(array<revelioGaps.ValueGap> valueGaps, array<int> selectedIndices, bool useUtcTimezone) =>
    int floatCount = array.size(selectedIndices)
    if floatCount > 0
        ValueGapStyle style = floatingValueGapStyle()
        for floatSlot = 0 to floatCount - 1
            revelioGaps.ValueGap gap = array.get(valueGaps, array.get(selectedIndices, floatSlot))
            int leftBar = bar_index + floatingValueGapOffset + floatSlot * (floatingValueGapWidth + 10)
            int rightBar = leftBar + floatingValueGapWidth
            renderStyledValueGap(gap, leftBar, rightBar, xloc.bar_index, style, valueGapLabelText(gap, useUtcTimezone), false)

renderUpcomingValueGap(array<revelioCore.Profile> profiles, revelioCore.Profile liveProfile, bool enabled, bool useUtcTimezone) =>
    if enabled and not na(liveProfile) and array.size(profiles) > 0
        revelioCore.Profile previousProfile = array.last(profiles)
        if liveProfile.isValid
            revelioGaps.ValueGap upcomingGap = revelioGaps.fromProfiles(previousProfile, liveProfile, liveProfile.startTime, time, syminfo.mintick)
            if not na(upcomingGap)
                float previousRange = math.max(previousProfile.priceHigh - previousProfile.priceLow, syminfo.mintick)
                float upcomingPercent = (upcomingGap.top - upcomingGap.bottom) / previousRange * 100
                if upcomingPercent >= UPCOMING_VALUE_GAP_MIN_PERCENT
                    int leftBar = bar_index + upcomingValueGapOffset
                    int rightBar = leftBar + upcomingValueGapWidth
                    string dateText = calendarDateText(liveProfile.startTime, useUtcTimezone)
                    renderStyledValueGap(upcomingGap, leftBar, rightBar, xloc.bar_index, upcomingValueGapStyle(), "Upcoming " + valueGapSource + " Value Gap\n" + dateText, false)

renderValueGaps(array<revelioGaps.ValueGap> valueGaps, bool enabled, array<int> floatingIndices, int displayLimit, bool useUtcTimezone) =>
    int gapCount = array.size(valueGaps)
    if enabled and gapCount > 0
        ValueGapStyle style = confirmedValueGapStyle()
        int liveRightPadding = int(timeframe.in_seconds(timeframe.period) * 1000) * VALUE_GAP_RIGHT_EDGE_CUSHION
// Budget gaps newest-first using each gap's actual drawing cost.
        int firstGapIndex = gapCount
        int selectedCount = 0
        int lineCost = 0
        int labelCost = 0
        int boxCost = 0
        for gapIndex = gapCount - 1 to 0
            revelioGaps.ValueGap candidate = array.get(valueGaps, gapIndex)
            bool candidateFilled = not na(candidate.fillTime)
            if not array.includes(floatingIndices, gapIndex) and (not candidateFilled or not hideFilledValueGaps)
                int candidateRight = candidateFilled ? candidate.fillTime : time + liveRightPadding
                int candidateLabels = valueGapLabelCost(candidate, style, candidateRight - candidate.leftTime)
                int candidateBoxes = revelioGaps.boxCost(candidate)
                if lineCost + 3 > VALUE_GAP_LINE_BUDGET or labelCost + candidateLabels > VALUE_GAP_LABEL_BUDGET or boxCost + candidateBoxes > VALUE_GAP_BOX_BUDGET
                    break
                lineCost += 3
                labelCost += candidateLabels
                boxCost += candidateBoxes
                firstGapIndex := gapIndex
                selectedCount += 1
                if selectedCount >= displayLimit
                    break
        if firstGapIndex < gapCount
            int boldGapIndex = revelioGaps.latestFilledIndex(valueGaps, boldLastFilledValueGap and not hideFilledValueGaps)
            for gapIndex = firstGapIndex to gapCount - 1
                revelioGaps.ValueGap gap = array.get(valueGaps, gapIndex)
                if array.includes(floatingIndices, gapIndex)
                    continue
                bool isFilled = not na(gap.fillTime)
                if isFilled and hideFilledValueGaps
                    continue
                int rightTime = isFilled ? gap.fillTime : time + liveRightPadding
                renderStyledValueGap(gap, gap.leftTime, rightTime, xloc.bar_time, style, valueGapLabelText(gap, useUtcTimezone), gapIndex == boldGapIndex)

// Trailing margin keeps a repeat off the right-edge label, which already names the level there.
anchorReminderRun(int anchorEndTime, int runEndTime) =>
    int runStart = anchorEndTime + ANCHOR_REMINDER_MIN_SPACING_MS
    int runEnd = math.min(runEndTime, time - ANCHOR_REMINDER_MIN_SPACING_MS)
    [runStart, runEnd - runStart]

// Declared before retention helpers because the calendar policy depends on asset classification.
var bool isTwentyFourSevenAsset = false
var bool assetClassificationReady = false

sameNyDate(int firstTime, int secondTime) =>
    sameCalendarDate(firstTime, secondTime, NY_TIMEZONE)

calendarDateSerial(int eventTime, string timezone) =>
    int dateTimestamp = timestamp(UTC_TIMEZONE, year(eventTime, timezone), month(eventTime, timezone), dayofmonth(eventTime, timezone), 0, 0)
    int(dateTimestamp / MS_PER_DAY)

autoSweptCycleSerial(int eventTime, bool useUtcCalendar) =>
    useUtcCalendar ? calendarDateSerial(eventTime, UTC_TIMEZONE) : calendarDateSerial(eventTime + GLOBEX_REOPEN_SHIFT_MS, NY_TIMEZONE)

weekdayDistance(int firstDateSerial, int secondDateSerial) =>
    int calendarSpan = math.max(0, secondDateSerial - firstDateSerial)
    int tradingDays = calendarSpan > MAX_LEVEL_HIT_TRADING_DAY_SCAN ? MAX_LEVEL_HIT_WEEKDAY_RETENTION_DAYS : 0
    if calendarSpan > 0 and calendarSpan <= MAX_LEVEL_HIT_TRADING_DAY_SCAN
        for dayOffset = 1 to calendarSpan
            int weekday = dayofweek((firstDateSerial + dayOffset) * MS_PER_DAY, UTC_TIMEZONE)
            if weekday >= dayofweek.monday and weekday <= dayofweek.friday
                tradingDays += 1
    tradingDays

levelHitRetentionDays() =>
    levelHitHistory == LEVEL_HIT_HISTORY_ONE_DAY ? 1 : levelHitHistory == LEVEL_HIT_HISTORY_THREE_DAYS ? 3 : isTwentyFourSevenAsset ? 7 : MAX_LEVEL_HIT_WEEKDAY_RETENTION_DAYS

levelHitDetectionStartMinute() =>
    levelHitDetectionWindow == WINDOW_LABEL_FROM_0500 ? FROM_0500_START_MINUTE : levelHitDetectionWindow == WINDOW_LABEL_FROM_0830 ? FROM_0830_START_MINUTE : RTH_START_MINUTE

mostRecentWeekday(int dateSerial) =>
    int weekday = dayofweek(dateSerial * MS_PER_DAY, UTC_TIMEZONE)
    weekday == dayofweek.saturday ? dateSerial - 1 : weekday == dayofweek.sunday ? dateSerial - 2 : dateSerial

levelHitReferenceDateSerial() =>
    int currentDateSerial = calendarDateSerial(time, NY_TIMEZONE)
    int currentMinute = hour(time, NY_TIMEZONE) * 60 + minute(time, NY_TIMEZONE)
    int candidateDateSerial = currentMinute >= levelHitDetectionStartMinute() ? currentDateSerial : currentDateSerial - 1
    isTwentyFourSevenAsset ? candidateDateSerial : mostRecentWeekday(candidateDateSerial)

levelHitDayDistance(int hitTime) =>
    int hitDateSerial = calendarDateSerial(hitTime, NY_TIMEZONE)
    int referenceDateSerial = levelHitReferenceDateSerial()
    isTwentyFourSevenAsset ? math.max(0, referenceDateSerial - hitDateSerial) : weekdayDistance(hitDateSerial, referenceDateSerial)

levelHitTraceActive(int hitTime, bool tracePresentationActive) =>
    tracePresentationActive and not na(hitTime) and (levelHitHistory == LEVEL_HIT_HISTORY_CURRENT_WINDOW ? sameNyDate(hitTime, time) : levelHitDayDistance(hitTime) < levelHitRetentionDays())

levelHitSourceProfileKey(int startTime, int endTime, SessionStyle style) =>
    style.labelAnchor + "|" + str.tostring(startTime) + "|" + str.tostring(endTime)

levelHitKey(string sourceProfileKey, string levelName) =>
    sourceProfileKey + "|" + levelName

plainPreviousLabel(string labelText) =>
    str.replace_all(str.replace_all(labelText, "[", ""), "]", "")

levelIdentity(int startTime, SessionStyle style, bool isLive, bool isLast, string levelName, bool sweptDenote, bool plainPrevious) =>
    string dateText = periodDateText(startTime, style.periodLabelMode, style.useUtcLabelTimezone)
    string previousText = plainPrevious and isLast ? plainPreviousLabel(style.labelLast) : style.labelLast
    string nameText = isLive ? style.labelLive + " " + levelName : isLast ? previousText + " " + levelName : style.labelAnchor + " " + levelName + " " + dateText
    nameText + (sweptDenote ? " " + SWEPT_CHECKMARK : "")

compactProfileToken(string anchorName) =>
    anchorName == LABEL_RTH_ANCHOR ? LABEL_RTH_TOKEN : anchorName == LABEL_GLOBEX_ANCHOR ? LABEL_GLOBEX_TOKEN : anchorName == LABEL_WEEKLY_ANCHOR ? LABEL_WEEKLY_TOKEN : anchorName == LABEL_MONTHLY_ANCHOR ? LABEL_MONTHLY_TOKEN : anchorName == LABEL_QUARTERLY_ANCHOR ? LABEL_QUARTERLY_TOKEN : anchorName

compactProfilePrefix(SessionStyle style, bool isLive, bool isLast) =>
    string token = compactProfileToken(style.labelAnchor)
    isLive ? "★ " + token : isLast ? ((style.labelAnchor == LABEL_RTH_ANCHOR or style.labelAnchor == LABEL_GLOBEX_ANCHOR) ? "[PREV " + token + "]" : "[LAST " + token + "]") : token

levelLabelIdentity(int startTime, int endTime, SessionStyle style, bool isLive, bool isLast, string levelName, bool sweptDenote, string displaySuffix, bool archived, bool unselectedAnchor) =>
    string periodText = periodDateText(startTime, style.periodLabelMode, style.useUtcLabelTimezone)
    string periodContext = periodContextText(startTime, style.periodLabelMode, style.useUtcLabelTimezone)
    string periodMember = periodMemberText(startTime, style.periodLabelMode, style.useUtcLabelTimezone)
    string profilePrefix = isLive ? style.labelLive : isLast ? style.labelLast : style.labelAnchor + " " + periodText
    string baseText = isLive or isLast ? profilePrefix + " " + levelName : style.labelAnchor + " " + levelName + " " + periodText
    string fullSuffix = (sweptDenote ? " " + SWEPT_CHECKMARK : "") + displaySuffix + (unselectedAnchor ? LEVEL_HIT_UNSELECTED_ANCHOR_SYMBOL : "") + (archived ? LEVEL_HIT_ARCHIVED_SYMBOL : "")
    string compactDisplaySuffix = str.replace_all(displaySuffix, " ", "")
    string compactSuffix = (sweptDenote ? SWEPT_CHECKMARK : "") + compactDisplaySuffix + (unselectedAnchor ? LEVEL_HIT_UNSELECTED_ANCHOR_SYMBOL : "") + (archived ? LEVEL_HIT_ARCHIVED_SYMBOL : "")
    string suffix = compactSuffix
    revelioInteractions.LabelIdentity.new(baseText + fullSuffix, style.labelAnchor, profilePrefix, compactProfilePrefix(style, isLive, isLast), levelName, periodText, periodContext, periodMember, style.periodLabelMode != PERIOD_LABEL_DAY, suffix, compactSuffix, isLive, not isLive and isLast, not isLive and not isLast)

levelLabelRank(string levelName, SessionStyle style, bool isLive, bool isLast) =>
    int levelWeight = levelName == LABEL_POC ? 3 : levelName == LABEL_ALTERNATE_POC ? 1 : 2
    int anchorWeight = style.periodLabelMode == PERIOD_LABEL_QUARTER ? 1 : 0
    int recencyWeight = isLive ? 2 : isLast ? 1 : 0
    levelWeight * 100 + anchorWeight * 10 + recencyWeight

effectiveLevelLineWidth(int lineWidth, SessionStyle style, bool sweptDenote) =>
    sweptDenote ? style.sweptContinuationWidth : lineWidth

fadeColor(color baseColor, float fadeFraction) =>
    color.new(baseColor, 100 - (100 - color.t(baseColor)) * (1 - fadeFraction))

// sweptDenote adds a faded dashed continuation after the solid swept segment.
drawLevel(int startTime, int endTime, float price, color lineColor, int lineWidth, string styleName, bool extendRight, color labelColor, string levelName, SessionStyle style, bool sweptDenote, color sweptContinuationColor, bool hitTraceActive, bool archivedTouch, bool isLive, bool isLast, int anchorEndTime, string displaySuffix) =>
    line primaryLine = line.new(x1=startTime, y1=price, x2=endTime, y2=price, xloc=xloc.bar_time, extend=extendRight ? extend.right : extend.none, color=lineColor, width=lineWidth, style=toLineStyle(styleName))
    bool primaryLineRetained = trackLine(primaryLine)
    line activeLine = extendRight and primaryLineRetained ? primaryLine : na
    color activeLineColor = extendRight and primaryLineRetained ? lineColor : na
    color labelTextColor = sweptDenote ? fadeColor(labelColor, SWEPT_LABEL_TEXT_FADE_PERCENT / 100.0) : labelColor
    int labelRank = levelLabelRank(levelName, style, isLive, isLast)
    int effectiveLineWidth = effectiveLevelLineWidth(lineWidth, style, sweptDenote)
    // Swept levels are tagged by the swept-line reminders below, never here, or they draw the same name twice.
    if not isLive and not sweptDenote and levelName != LABEL_ALTERNATE_POC
        int visibleEndTime = extendRight ? time : endTime
        revelioInteractions.LabelIdentity anchorLabelIdentity = levelLabelIdentity(startTime, anchorEndTime, style, false, isLast, levelName, false, "", false, false)
        color anchorReminderTextColor = fadeColor(labelTextColor, ANCHOR_REMINDER_FADE_PERCENT / 100.0)
        [_, anchorRunMs] = anchorReminderRun(anchorEndTime, visibleEndTime)
        if anchorRunMs > 0
            array.push(pendingAnchorReminders, revelioInteractions.PendingAnchorReminder.new(price, anchorEndTime, visibleEndTime, anchorLabelIdentity, anchorReminderTextColor, style.levelLabelBgColor, style.levelLabelSize, levelName, labelRank, effectiveLineWidth))
    if sweptDenote
        line sweptContinuationLine = line.new(x1=endTime, y1=price, x2=time, y2=price, xloc=xloc.bar_time, extend=extend.right, color=sweptContinuationColor, width=style.sweptContinuationWidth, style=line.style_dashed)
        bool sweptContinuationRetained = trackLine(sweptContinuationLine)
        activeLine := sweptContinuationRetained ? sweptContinuationLine : na
        activeLineColor := sweptContinuationRetained ? sweptContinuationColor : na
    // Touched identities reuse the normal right-edge merge only while Touch Marker Labels are active.
    if extendRight or sweptDenote or hitTraceActive
        string priceText = str.tostring(price, format.mintick)
        revelioInteractions.LabelIdentity labelIdentity = levelLabelIdentity(startTime, anchorEndTime, style, isLive, isLast, levelName, sweptDenote, displaySuffix, hitTraceActive and archivedTouch, false)
        string touchKey = isLive ? "" : levelHitKey(levelHitSourceProfileKey(startTime, anchorEndTime, style), levelName)
        // Buffer the right-edge label instead of drawing it; flushPendingLabels merges coincident prices.
        array.push(pendingLabels, revelioInteractions.PendingLabel.new(price, bar_index + style.levelLabelOffset, anchorEndTime, touchKey, labelIdentity, priceText, style.showPrice, hitTraceActive, labelTextColor, style.levelLabelBgColor, style.levelLabelSize, labelRank, effectiveLineWidth, activeLine, activeLineColor))
        // Last and live profiles are self-evident, so only older completed profiles carry a date.
        if sweptDenote
            revelioInteractions.LabelIdentity reminderLabelIdentity = levelLabelIdentity(startTime, anchorEndTime, style, isLive, isLast, levelName, false, displaySuffix, false, false)
            array.push(pendingReminders, revelioInteractions.PendingReminder.new(price, endTime, reminderLabelIdentity, labelTextColor, style.levelLabelBgColor, style.levelLabelSize, levelName, labelRank, effectiveLineWidth))

// Scale visible opacity so fading respects the base transparency.
dimLevelColor(color baseColor, bool touched, bool dimTouched, float dimFraction) =>
    touched and dimTouched ? fadeColor(baseColor, dimFraction) : baseColor

// Draw each contiguous histogram run as one borderless filled polyline.
pushHistogramPolyline(array<chart.point> points, color fillColor) =>
    if array.size(points) >= 3
        trackPolyline(polyline.new(points, curved=false, closed=true, xloc=xloc.bar_time, line_color=color.new(fillColor, 100), fill_color=fillColor))

// Later of two breach timestamps, ignoring na so an unswept level never wins.
maxBreachTime(int a, int b) =>
    int result = na(a) ? b : na(b) ? a : int(math.max(a, b))
    result

// Most recent sweep across the profile's levels; na when none are swept.
profileLastBreach(revelioCore.Profile profile) =>
    int latest = maxBreachTime(profile.pocBreachTime, profile.valueAreaHighBreachTime)
    latest := maxBreachTime(latest, profile.valueAreaLowBreachTime)
    latest := profile.hasAlternatePoc ? maxBreachTime(latest, profile.alternatePocBreachTime) : latest
    latest

profileSweptContinuationVisible(revelioCore.Profile profile, bool isMostRecentCompleted, string extensionMode, int sweptKeepMs, bool focusSurfaced) =>
    int lastBreach = profileLastBreach(profile)
    bool withinKeepWindow = sweptKeepMs > 0 and not na(lastBreach) and time - lastBreach <= sweptKeepMs
    extensionMode == LEVEL_BREACH_SWEEP and (isMostRecentCompleted or focusSurfaced or withinKeepWindow)

profileSweptVisibilityMask(revelioCore.AutoSweptState autoState, revelioCore.Profile profile, bool isMostRecentCompleted, SessionStyle style, bool focusSurfaced) =>
    int visibilityMask = 0
    if style.extensionMode == LEVEL_BREACH_SWEEP
        if autoSweptLines
            visibilityMask := revelioCore.autoSweptVisibilityMask(autoState, profile, time, focusSurfaced)
        else if profileSweptContinuationVisible(profile, isMostRecentCompleted, style.extensionMode, style.sweptKeepMs, focusSurfaced)
            visibilityMask := revelioCore.sweptLevelMask(profile)
    visibilityMask

// The value area splits the silhouette into at most three runs (below/inside/above VA), one polyline each.
histogramRunCount(revelioCore.Profile profile) =>
    not profile.isValid ? 0 : (profile.valueAreaLowRow > 0 ? 1 : 0) + 1 + (profile.valueAreaHighRow < profile.rowCount - 1 ? 1 : 0)

focusDirectionMatches(float levelPrice, float focusPrice, string focusDirection) =>
    focusDirection == FOCUS_DIRECTION_BELOW ? levelPrice <= focusPrice : focusDirection == FOCUS_DIRECTION_ABOVE ? levelPrice >= focusPrice : focusDirection == FOCUS_DIRECTION_AROUND

// Ignores levels on the unwanted side of the anchor.
nearerFocusDistance(float current, float levelPrice, float focusPrice, string focusDirection) =>
    float candidate = not na(levelPrice) and focusDirectionMatches(levelPrice, focusPrice, focusDirection) ? math.abs(focusPrice - levelPrice) : na
    na(candidate) ? current : na(current) ? candidate : math.min(current, candidate)

// na when the profile has no enabled level on the requested side.
profileFocusDistance(revelioCore.Profile profile, SessionStyle style, float focusPrice, string focusDirection) =>
    float nearest = na
    if profile.isValid
        if style.showPoc
            nearest := nearerFocusDistance(nearest, profile.pocPrice, focusPrice, focusDirection)
        if style.showAlternatePoc and profile.hasAlternatePoc
            nearest := nearerFocusDistance(nearest, profile.alternatePocPrice, focusPrice, focusDirection)
        if style.showValueArea
            nearest := nearerFocusDistance(nearest, profile.valueAreaHighPrice, focusPrice, focusDirection)
            nearest := nearerFocusDistance(nearest, profile.valueAreaLowPrice, focusPrice, focusDirection)
    nearest

// An unplaced manual anchor falls back to price.
focusAnchorPrice(string anchorMode, float manualPrice, bool manualPlaced, float currentPrice) =>
    anchorMode == FOCUS_ANCHOR_MANUAL and manualPlaced ? manualPrice : currentPrice

renderBudgetProfileAllowed(RenderBudgetAnchor anchor, int profileIndex) =>
    not anchor.restrictToFocus or array.get(anchor.focusSelections, profileIndex)

anchorSurfacesSweptLevels(RenderBudgetAnchor anchor, int profileIndex) =>
    anchor.restrictToFocus and anchor.surfaceSweptLevels and array.get(anchor.focusSelections, profileIndex)

// Ties resolve to the newer profile.
focusCandidateOutranks(FocusCandidate candidate, FocusCandidate other) =>
    candidate.distance != other.distance ? candidate.distance < other.distance : candidate.endTime > other.endTime

// Bounded insertion: a deep search never grows past the requested count.
retainFocusCandidate(array<FocusCandidate> ranked, FocusCandidate candidate, int focusCount) =>
    int rankedCount = array.size(ranked)
    bool admitted = rankedCount < focusCount
    if not admitted and rankedCount > 0
        admitted := focusCandidateOutranks(candidate, array.last(ranked))
    if admitted
        int insertAt = rankedCount
        if rankedCount > 0
            for scanIndex = 0 to rankedCount - 1
                if focusCandidateOutranks(candidate, array.get(ranked, scanIndex))
                    insertAt := scanIndex
                    break
        if insertAt >= rankedCount
            array.push(ranked, candidate)
        else
            array.insert(ranked, insertAt, candidate)
        if array.size(ranked) > focusCount
            array.pop(ranked)
    admitted

// Each anchor ranks independently; RTH and Globex are produced in pairs and get their own allowance.
selectFocusedProfiles(array<RenderBudgetAnchor> anchors, int dailyAnchorCount, float focusPrice, string focusDirection, int focusCount) =>
    int anchorLimit = math.min(dailyAnchorCount, array.size(anchors))
    // Sized before any early exit so a restricted anchor is never read past its end.
    if anchorLimit > 0
        for anchorIndex = 0 to anchorLimit - 1
            RenderBudgetAnchor anchor = array.get(anchors, anchorIndex)
            array.clear(anchor.focusSelections)
            if anchor.restrictToFocus and array.size(anchor.profiles) > 0
                for profileIndex = 0 to array.size(anchor.profiles) - 1
                    array.push(anchor.focusSelections, false)
    if anchorLimit > 0 and focusCount > 0 and not na(focusPrice)
        for anchorIndex = 0 to anchorLimit - 1
            RenderBudgetAnchor anchor = array.get(anchors, anchorIndex)
            if anchor.restrictToFocus and array.size(anchor.profiles) > 0
                array<FocusCandidate> ranked = array.new<FocusCandidate>()
                for profileIndex = 0 to array.size(anchor.profiles) - 1
                    revelioCore.Profile profile = array.get(anchor.profiles, profileIndex)
                    float distance = profileFocusDistance(profile, anchor.style, focusPrice, focusDirection)
                    if not na(distance)
                        retainFocusCandidate(ranked, FocusCandidate.new(distance, profileIndex, profile.endTime), focusCount)
                if array.size(ranked) > 0
                    for rankedIndex = 0 to array.size(ranked) - 1
                        array.set(anchor.focusSelections, array.get(ranked, rankedIndex).profileIndex, true)
    true

// A manual anchor draws its own reference line, tagged in the right margin so it can be found and dragged.
renderFocusAnchor(bool anchorVisible, float anchorPrice, bool anchorPlaced, color anchorColor, int anchorWidth, int anchorLabelOffset) =>
    if anchorVisible and not na(anchorPrice) and anchorPrice > 0
        trackLine(line.new(time[1], anchorPrice, time, anchorPrice, xloc=xloc.bar_time, extend=extend.both, color=anchorColor, width=anchorWidth, style=line.style_solid))
        string anchorText = (anchorPlaced ? LABEL_FOCUS_ANCHOR : LABEL_FOCUS_ANCHOR_UNSET) + " " + str.tostring(anchorPrice, format.mintick)
        trackLabel(label.new(bar_index + anchorLabelOffset, anchorPrice, anchorText, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, textcolor=anchorColor, size=size.small, color=color.new(color.rgb(249, 248, 248), 25)))
    true

// Must mirror every level-line emission path in renderProfile and drawLevel.
profileLineCount(revelioCore.Profile profile, RenderBudgetAnchor anchor, bool isMostRecentCompleted, bool focusSurfaced) =>
    int lineCount = 0
    if not na(profile)
        if profile.isValid
            int sweptVisibilityMask = profileSweptVisibilityMask(anchor.autoSweptState, profile, isMostRecentCompleted, anchor.style, focusSurfaced)
            int sweptProtectedMask = autoSweptLines and anchor.restrictToFocus ? revelioCore.autoSweptProtectedVisibilityMask(anchor.autoSweptState, profile, time) : 0
            bool pocDenote = revelioCore.autoSweptMaskContains(sweptVisibilityMask, revelioCore.AutoSweptLevel.poc)
            bool alternatePocDenote = revelioCore.autoSweptMaskContains(sweptVisibilityMask, revelioCore.AutoSweptLevel.alternatePoc)
            bool vahDenote = revelioCore.autoSweptMaskContains(sweptVisibilityMask, revelioCore.AutoSweptLevel.valueAreaHigh)
            bool valDenote = revelioCore.autoSweptMaskContains(sweptVisibilityMask, revelioCore.AutoSweptLevel.valueAreaLow)
            bool pocReserved = autoSweptLines and anchor.restrictToFocus and (revelioCore.autoSweptMaskContains(sweptProtectedMask, revelioCore.AutoSweptLevel.poc) or revelioCore.autoSweptCurrentSelected(anchor.autoSweptState, profile.startTime, profile.endTime, revelioCore.AutoSweptLevel.poc))
            bool alternatePocReserved = autoSweptLines and anchor.restrictToFocus and (revelioCore.autoSweptMaskContains(sweptProtectedMask, revelioCore.AutoSweptLevel.alternatePoc) or revelioCore.autoSweptCurrentSelected(anchor.autoSweptState, profile.startTime, profile.endTime, revelioCore.AutoSweptLevel.alternatePoc))
            bool vahReserved = autoSweptLines and anchor.restrictToFocus and (revelioCore.autoSweptMaskContains(sweptProtectedMask, revelioCore.AutoSweptLevel.valueAreaHigh) or revelioCore.autoSweptCurrentSelected(anchor.autoSweptState, profile.startTime, profile.endTime, revelioCore.AutoSweptLevel.valueAreaHigh))
            bool valReserved = autoSweptLines and anchor.restrictToFocus and (revelioCore.autoSweptMaskContains(sweptProtectedMask, revelioCore.AutoSweptLevel.valueAreaLow) or revelioCore.autoSweptCurrentSelected(anchor.autoSweptState, profile.startTime, profile.endTime, revelioCore.AutoSweptLevel.valueAreaLow))
            if anchor.style.showPoc
                lineCount += pocReserved or autoSweptLines and not anchor.restrictToFocus and not focusSurfaced and pocDenote ? 0 : 1 + (pocDenote ? 1 : 0)
            if anchor.style.showAlternatePoc and profile.hasAlternatePoc
                lineCount += alternatePocReserved or autoSweptLines and not anchor.restrictToFocus and not focusSurfaced and alternatePocDenote ? 0 : 1 + (alternatePocDenote ? 1 : 0)
            if anchor.style.showValueArea
                lineCount += vahReserved or autoSweptLines and not anchor.restrictToFocus and not focusSurfaced and vahDenote ? 0 : 1 + (vahDenote ? 1 : 0)
                lineCount += valReserved or autoSweptLines and not anchor.restrictToFocus and not focusSurfaced and valDenote ? 0 : 1 + (valDenote ? 1 : 0)
    lineCount

liveProfileLineCount(revelioCore.Profile profile, bool enabled, RenderBudgetAnchor anchor) =>
    enabled and not na(profile) ? profileLineCount(profile, anchor, false, false) : 0

newestCandidateEndTime(array<revelioCore.Profile> profiles, int candidateIndex) =>
    candidateIndex >= 0 ? nz(array.get(profiles, candidateIndex).endTime, -1) : -1

// Allocate a completed-profile drawing budget newest-first; registration order breaks ties.
anchorHistogramCost(RenderBudgetAnchor anchor) =>
    int cost = 0
    if anchor.histogramEnabled and array.size(anchor.profiles) > 0
        for profileIndex = 0 to array.size(anchor.profiles) - 1
            if renderBudgetProfileAllowed(anchor, profileIndex)
                cost += histogramRunCount(array.get(anchor.profiles, profileIndex))
    cost

totalHistogramCost(array<RenderBudgetAnchor> anchors) =>
    int cost = 0
    if array.size(anchors) > 0
        for anchorIndex = 0 to array.size(anchors) - 1
            cost += anchorHistogramCost(array.get(anchors, anchorIndex))
    cost

// The allocator drops oldest first, which would discard the closest focus profiles. Trim the farthest
// up front so ranking survives and the allocator has nothing left to cut.
trimFocusToBudget(array<RenderBudgetAnchor> anchors, int dailyAnchorCount, float focusPrice, string focusDirection, int budget) =>
    int anchorLimit = math.min(dailyAnchorCount, array.size(anchors))
    if anchorLimit > 0
        bool trimming = true
        while trimming and totalHistogramCost(anchors) > budget
            int farthestAnchorIndex = -1
            int farthestProfileIndex = -1
            float farthestDistance = na
            for anchorIndex = 0 to anchorLimit - 1
                RenderBudgetAnchor anchor = array.get(anchors, anchorIndex)
                if anchor.restrictToFocus and array.size(anchor.profiles) > 0
                    for profileIndex = 0 to array.size(anchor.profiles) - 1
                        if array.get(anchor.focusSelections, profileIndex)
                            float distance = profileFocusDistance(array.get(anchor.profiles, profileIndex), anchor.style, focusPrice, focusDirection)
                            if not na(distance) and (na(farthestDistance) or distance > farthestDistance)
                                farthestDistance := distance
                                farthestAnchorIndex := anchorIndex
                                farthestProfileIndex := profileIndex
            if farthestAnchorIndex < 0
                trimming := false
            else
                array.set(array.get(anchors, farthestAnchorIndex).focusSelections, farthestProfileIndex, false)
    true

allocateProfileBudget(array<RenderBudgetAnchor> anchors, int budget, bool histogramBudget) =>
    int remaining = budget
    int anchorCount = array.size(anchors)
    array<int> candidateIndices = array.new<int>(anchorCount, -1)
    for anchorIndex = 0 to anchorCount - 1
        RenderBudgetAnchor anchor = array.get(anchors, anchorIndex)
        bool enabled = histogramBudget ? anchor.histogramEnabled : anchor.levelsEnabled
        array.set(candidateIndices, anchorIndex, enabled ? array.size(anchor.profiles) - 1 : -1)
    bool exhausted = false
    while not exhausted
        int newestTime = -1
        int newestAnchorIndex = -1
        for anchorIndex = 0 to anchorCount - 1
            RenderBudgetAnchor anchor = array.get(anchors, anchorIndex)
            int candidateTime = newestCandidateEndTime(anchor.profiles, array.get(candidateIndices, anchorIndex))
            if candidateTime > newestTime
                newestTime := candidateTime
                newestAnchorIndex := anchorIndex
        if newestAnchorIndex < 0
            exhausted := true
        else
            RenderBudgetAnchor newestAnchor = array.get(anchors, newestAnchorIndex)
            int newestProfileIndex = array.get(candidateIndices, newestAnchorIndex)
            revelioCore.Profile chosen = array.get(newestAnchor.profiles, newestProfileIndex)
            bool isMostRecentCompleted = newestProfileIndex == array.size(newestAnchor.profiles) - 1
            bool profileAllowed = renderBudgetProfileAllowed(newestAnchor, newestProfileIndex)
            int cost = not profileAllowed ? 0 : histogramBudget ? histogramRunCount(chosen) : profileLineCount(chosen, newestAnchor, isMostRecentCompleted, anchorSurfacesSweptLevels(newestAnchor, newestProfileIndex))
            if cost > remaining
                exhausted := true
            else
                remaining -= cost
                array.set(candidateIndices, newestAnchorIndex, newestProfileIndex - 1)
    array<int> firstAllowedIndices = array.new<int>(anchorCount, 0)
    for anchorIndex = 0 to anchorCount - 1
        array.set(firstAllowedIndices, anchorIndex, array.get(candidateIndices, anchorIndex) + 1)
    firstAllowedIndices

profileLevelBreachTime(revelioCore.Profile profile, string levelName) =>
    levelName == LABEL_POC ? profile.pocBreachTime : levelName == LABEL_VAH ? profile.valueAreaHighBreachTime : levelName == LABEL_VAL ? profile.valueAreaLowBreachTime : profile.alternatePocBreachTime

levelHitAnchorPriority(string labelAnchor) =>
    labelAnchor == LABEL_QUARTERLY_ANCHOR ? 4 : labelAnchor == LABEL_MONTHLY_ANCHOR ? 3 : labelAnchor == LABEL_WEEKLY_ANCHOR ? 2 : 1

profileLevelHitPresentation(revelioCore.Profile profile, int profileIndex, int profileCount, RenderBudgetAnchor anchor, int sweptVisibilityMask, string levelName, revelioCore.AutoSweptLevel autoLevel) =>
    SessionStyle style = anchor.style
    bool isMostRecentCompleted = profileIndex == profileCount - 1
    int breachTime = profileLevelBreachTime(profile, levelName)
    bool sweptContinuationVisible = revelioCore.autoSweptMaskContains(sweptVisibilityMask, autoLevel)
    bool sweptDenote = sweptContinuationVisible and not na(breachTime)
    [_, extendsRight] = levelEndpoint(profile.endTime, breachTime, style.extensionMode)
// Marker dots stay high-visibility on aged profiles, so value-area dots always use the strong color.
    color lineColor = levelName == LABEL_POC ? style.pocColor : levelName == LABEL_ALTERNATE_POC ? style.alternatePocColor : style.valueAreaLastColor
    color baseLabelColor = levelName == LABEL_POC ? style.pocLabelColor : levelName == LABEL_ALTERNATE_POC ? style.alternatePocLabelColor : style.valueAreaLabelColor
    color labelColor = sweptDenote ? fadeColor(baseLabelColor, SWEPT_LABEL_TEXT_FADE_PERCENT / 100.0) : baseLabelColor
    int lineWidth = levelName == LABEL_POC ? style.pocWidth : levelName == LABEL_ALTERNATE_POC ? style.alternatePocWidth : isMostRecentCompleted ? style.valueAreaLastWidth : style.valueAreaWidth
    revelioInteractions.LevelHitPresentation.new(levelIdentity(profile.startTime, style, false, isMostRecentCompleted, levelName, sweptDenote, true), levelLabelIdentity(profile.startTime, profile.endTime, style, false, isMostRecentCompleted, levelName, sweptDenote, "", false, false), lineColor, labelColor, style.levelLabelBgColor, style.showPrice, levelHitCircleSizeForAnchor(style.labelAnchor), style.levelLabelSize, style.levelLabelOffset, effectiveLevelLineWidth(lineWidth, style, sweptDenote), levelLabelRank(levelName, style, false, isMostRecentCompleted), levelHitAnchorPriority(style.labelAnchor), extendsRight or sweptDenote)

registerProfileLevelHitPresentations(map<string, revelioInteractions.LevelHitPresentation> presentations, revelioCore.Profile profile, int profileIndex, int profileCount, RenderBudgetAnchor anchor, bool surfaceSweptLevels) =>
    if profile.isValid and time > profile.endTime
        string sourceProfileKey = levelHitSourceProfileKey(profile.startTime, profile.endTime, anchor.style)
        bool isMostRecentCompleted = profileIndex == profileCount - 1
        int sweptVisibilityMask = profileSweptVisibilityMask(anchor.autoSweptState, profile, isMostRecentCompleted, anchor.style, surfaceSweptLevels)
        map.put(presentations, levelHitKey(sourceProfileKey, LABEL_POC), profileLevelHitPresentation(profile, profileIndex, profileCount, anchor, sweptVisibilityMask, LABEL_POC, revelioCore.AutoSweptLevel.poc))
        map.put(presentations, levelHitKey(sourceProfileKey, LABEL_VAH), profileLevelHitPresentation(profile, profileIndex, profileCount, anchor, sweptVisibilityMask, LABEL_VAH, revelioCore.AutoSweptLevel.valueAreaHigh))
        map.put(presentations, levelHitKey(sourceProfileKey, LABEL_VAL), profileLevelHitPresentation(profile, profileIndex, profileCount, anchor, sweptVisibilityMask, LABEL_VAL, revelioCore.AutoSweptLevel.valueAreaLow))
        if profile.hasAlternatePoc
            map.put(presentations, levelHitKey(sourceProfileKey, LABEL_ALTERNATE_POC), profileLevelHitPresentation(profile, profileIndex, profileCount, anchor, sweptVisibilityMask, LABEL_ALTERNATE_POC, revelioCore.AutoSweptLevel.alternatePoc))
    true

registerAnchorLevelHitPresentations(map<string, revelioInteractions.LevelHitPresentation> presentations, RenderBudgetAnchor anchor, int fromIndex, bool active, bool selectedOnly, bool surfaceSweptLevels) =>
    int profileCount = array.size(anchor.profiles)
    if active and profileCount > 0
        for profileIndex = math.max(0, fromIndex) to profileCount - 1
            if not selectedOnly or renderBudgetProfileAllowed(anchor, profileIndex)
                registerProfileLevelHitPresentations(presentations, array.get(anchor.profiles, profileIndex), profileIndex, profileCount, anchor, surfaceSweptLevels)
    true

autoSweptArchiveLevelPresentation(revelioCore.AutoSweptProfile profile, SessionStyle style, bool isMostRecentCompleted, string levelName, bool visibleAtLiveEdge) =>
    color lineColor = levelName == LABEL_POC ? style.pocColor : levelName == LABEL_ALTERNATE_POC ? style.alternatePocColor : isMostRecentCompleted ? style.valueAreaLastColor : style.valueAreaColor
    color baseLabelColor = levelName == LABEL_POC ? style.pocLabelColor : levelName == LABEL_ALTERNATE_POC ? style.alternatePocLabelColor : style.valueAreaLabelColor
    color labelColor = visibleAtLiveEdge ? fadeColor(baseLabelColor, SWEPT_LABEL_TEXT_FADE_PERCENT / 100.0) : baseLabelColor
    int lineWidth = levelName == LABEL_POC ? style.pocWidth : levelName == LABEL_ALTERNATE_POC ? style.alternatePocWidth : isMostRecentCompleted ? style.valueAreaLastWidth : style.valueAreaWidth
    revelioInteractions.LevelHitPresentation.new(levelIdentity(profile.startTime, style, false, isMostRecentCompleted, levelName, visibleAtLiveEdge, true), levelLabelIdentity(profile.startTime, profile.endTime, style, false, isMostRecentCompleted, levelName, visibleAtLiveEdge, "", false, false), lineColor, labelColor, style.levelLabelBgColor, style.showPrice, levelHitCircleSizeForAnchor(style.labelAnchor), style.levelLabelSize, style.levelLabelOffset, effectiveLevelLineWidth(lineWidth, style, visibleAtLiveEdge), levelLabelRank(levelName, style, false, isMostRecentCompleted), levelHitAnchorPriority(style.labelAnchor), visibleAtLiveEdge)

prepareAutoSweptVisibilityMasks(RenderBudgetAnchor anchor) =>
    array.clear(anchor.autoSweptVisibilityMasks)
    array.clear(anchor.autoSweptProtectedVisibilityMasks)
    if autoSweptLines and anchor.style.extensionMode == LEVEL_BREACH_SWEEP and array.size(anchor.autoSweptState.profiles) > 0
        for profileIndex = 0 to array.size(anchor.autoSweptState.profiles) - 1
            revelioCore.AutoSweptProfile profile = array.get(anchor.autoSweptState.profiles, profileIndex)
            array.push(anchor.autoSweptVisibilityMasks, revelioCore.autoSweptArchiveVisibilityMask(anchor.autoSweptState, profile, time))
            array.push(anchor.autoSweptProtectedVisibilityMasks, revelioCore.autoSweptArchiveProtectedVisibilityMask(anchor.autoSweptState, profile, time))
    true

autoSweptArchiveVisibilityMaskAt(RenderBudgetAnchor anchor, int profileIndex) =>
    profileIndex >= 0 and profileIndex < array.size(anchor.autoSweptVisibilityMasks) ? array.get(anchor.autoSweptVisibilityMasks, profileIndex) : 0

autoSweptArchiveProtectedVisibilityMaskAt(RenderBudgetAnchor anchor, int profileIndex) =>
    profileIndex >= 0 and profileIndex < array.size(anchor.autoSweptProtectedVisibilityMasks) ? array.get(anchor.autoSweptProtectedVisibilityMasks, profileIndex) : 0

autoSweptArchiveLevelEligible(revelioCore.AutoSweptState autoState, revelioCore.AutoSweptProfile profile, revelioCore.AutoSweptLevel level) =>
    not profile.superseded or revelioCore.autoSweptCurrentSelected(autoState, profile.startTime, profile.endTime, level)

autoSweptArchiveProfileEligible(revelioCore.AutoSweptState autoState, revelioCore.AutoSweptProfile profile) =>
    not profile.superseded or revelioCore.autoSweptCurrentSelected(autoState, profile.startTime, profile.endTime, revelioCore.AutoSweptLevel.poc) or revelioCore.autoSweptCurrentSelected(autoState, profile.startTime, profile.endTime, revelioCore.AutoSweptLevel.alternatePoc) or revelioCore.autoSweptCurrentSelected(autoState, profile.startTime, profile.endTime, revelioCore.AutoSweptLevel.valueAreaHigh) or revelioCore.autoSweptCurrentSelected(autoState, profile.startTime, profile.endTime, revelioCore.AutoSweptLevel.valueAreaLow)

registerAutoSweptArchivePresentations(map<string, revelioInteractions.LevelHitPresentation> presentations, RenderBudgetAnchor anchor, bool active, bool includeOlderLevels, bool focusSelectedOnly) =>
    bool correctScope = focusSelectedOnly ? anchor.restrictToFocus : not anchor.restrictToFocus
    if active and autoSweptLines and anchor.style.extensionMode == LEVEL_BREACH_SWEEP and correctScope and array.size(anchor.autoSweptState.profiles) > 0
        for profileIndex = 0 to array.size(anchor.autoSweptState.profiles) - 1
            revelioCore.AutoSweptProfile profile = array.get(anchor.autoSweptState.profiles, profileIndex)
            int retainedIndex = focusSelectedOnly ? revelioCore.profileIndexByStart(anchor.profiles, profile.startTime, START_TIME_UNSET) : -1
            bool profileAllowed = not focusSelectedOnly or retainedIndex >= 0 and renderBudgetProfileAllowed(anchor, retainedIndex)
            if profileAllowed and autoSweptArchiveProfileEligible(anchor.autoSweptState, profile)
                int visibilityMask = autoSweptArchiveVisibilityMaskAt(anchor, profileIndex)
                bool isMostRecentCompleted = array.size(anchor.profiles) > 0 and array.last(anchor.profiles).startTime == profile.startTime
                string sourceProfileKey = levelHitSourceProfileKey(profile.startTime, profile.endTime, anchor.style)
                bool pocVisible = revelioCore.autoSweptMaskContains(visibilityMask, revelioCore.AutoSweptLevel.poc)
                bool alternatePocVisible = revelioCore.autoSweptMaskContains(visibilityMask, revelioCore.AutoSweptLevel.alternatePoc)
                bool vahVisible = revelioCore.autoSweptMaskContains(visibilityMask, revelioCore.AutoSweptLevel.valueAreaHigh)
                bool valVisible = revelioCore.autoSweptMaskContains(visibilityMask, revelioCore.AutoSweptLevel.valueAreaLow)
                if anchor.style.showPoc and autoSweptArchiveLevelEligible(anchor.autoSweptState, profile, revelioCore.AutoSweptLevel.poc) and (pocVisible or includeOlderLevels and not na(profile.pocBreachTime))
                    map.put(presentations, levelHitKey(sourceProfileKey, LABEL_POC), autoSweptArchiveLevelPresentation(profile, anchor.style, isMostRecentCompleted, LABEL_POC, pocVisible))
                if anchor.style.showAlternatePoc and profile.hasAlternatePoc and autoSweptArchiveLevelEligible(anchor.autoSweptState, profile, revelioCore.AutoSweptLevel.alternatePoc) and (alternatePocVisible or includeOlderLevels and not na(profile.alternatePocBreachTime))
                    map.put(presentations, levelHitKey(sourceProfileKey, LABEL_ALTERNATE_POC), autoSweptArchiveLevelPresentation(profile, anchor.style, isMostRecentCompleted, LABEL_ALTERNATE_POC, alternatePocVisible))
                if anchor.style.showValueArea
                    if autoSweptArchiveLevelEligible(anchor.autoSweptState, profile, revelioCore.AutoSweptLevel.valueAreaHigh) and (vahVisible or includeOlderLevels and not na(profile.valueAreaHighBreachTime))
                        map.put(presentations, levelHitKey(sourceProfileKey, LABEL_VAH), autoSweptArchiveLevelPresentation(profile, anchor.style, isMostRecentCompleted, LABEL_VAH, vahVisible))
                    if autoSweptArchiveLevelEligible(anchor.autoSweptState, profile, revelioCore.AutoSweptLevel.valueAreaLow) and (valVisible or includeOlderLevels and not na(profile.valueAreaLowBreachTime))
                        map.put(presentations, levelHitKey(sourceProfileKey, LABEL_VAL), autoSweptArchiveLevelPresentation(profile, anchor.style, isMostRecentCompleted, LABEL_VAL, valVisible))
    true

registerRenderedLevelHitKey(map<string, bool> renderedLevelHitKeys, revelioCore.Profile profile, SessionStyle style, string levelName, bool isLive) =>
    if not isLive
        string sourceProfileKey = levelHitSourceProfileKey(profile.startTime, profile.endTime, style)
        map.put(renderedLevelHitKeys, levelHitKey(sourceProfileKey, levelName), true)
    true

profileLevelAlreadyRendered(map<string, bool> renderedLevelHitKeys, string sourceProfileKey, string levelName, bool isLive) =>
    not isLive and map.contains(renderedLevelHitKeys, levelHitKey(sourceProfileKey, levelName))

renderProfile(revelioCore.Profile profile, RenderBudgetAnchor anchor, bool developingProfileActive, bool isMostRecentCompleted, bool focusSurfaced, bool isLive, bool histogramAllowed, bool levelsAllowed, bool touchLabelsActive, map<string, bool> archivedLevelHitKeys, map<string, bool> renderedLevelHitKeys) =>
    if profile.isValid
        SessionStyle style = anchor.style
        float priceRange = profile.priceHigh - profile.priceLow
        bool useDevelopingColors = developingProfileActive and style.developingEnabled

        if style.showHistogram and histogramAllowed and profile.maxHistogramVolume > 0
            int rowCount = profile.rowCount
            float rowHeight = priceRange / rowCount
            int baselineTime = profile.startTime
            int profileMilliseconds = math.max(1, profile.endTime - profile.startTime)
            int histogramWidthMilliseconds = math.max(1, int(math.round(profileMilliseconds * HISTOGRAM_WIDTH_PERCENT * 0.01)))
            array<chart.point> points = array.new<chart.point>()
            bool runStarted = false
            bool runInsideVa = false
            for rowIndex = 0 to rowCount - 1
                bool insideVa = rowIndex >= profile.valueAreaLowRow and rowIndex <= profile.valueAreaHighRow
                float rowBottom = profile.priceLow + rowIndex * rowHeight
                float rowVolume = array.get(profile.rowVolumes, rowIndex)
                int widthMilliseconds = int(math.round(rowVolume / profile.maxHistogramVolume * histogramWidthMilliseconds))
                int outerTime = baselineTime + widthMilliseconds
                // VA membership flipped: close this run and start a new one at the same boundary.
                if runStarted and insideVa != runInsideVa
                    array.push(points, chart.point.from_time(baselineTime, rowBottom))
                    pushHistogramPolyline(points, runInsideVa ? style.histogramInsideColor : style.histogramOutsideColor)
                    points := array.new<chart.point>()
                    runStarted := false
                if not runStarted
                    runStarted := true
                    runInsideVa := insideVa
                    array.push(points, chart.point.from_time(baselineTime, rowBottom))
                array.push(points, chart.point.from_time(outerTime, rowBottom + rowHeight / 2))
                if rowIndex == rowCount - 1
                    array.push(points, chart.point.from_time(baselineTime, rowBottom + rowHeight))
                    pushHistogramPolyline(points, runInsideVa ? style.histogramInsideColor : style.histogramOutsideColor)

        if style.showSessionBox
            trackBox(box.new(left=profile.startTime, top=profile.priceHigh, right=profile.endTime, bottom=profile.priceLow, xloc=xloc.bar_time, border_width=0, bgcolor=style.sessionBoxColor))

        int sweptVisibilityMask = profileSweptVisibilityMask(anchor.autoSweptState, profile, isMostRecentCompleted, style, focusSurfaced)
        bool pocSweptVisible = revelioCore.autoSweptMaskContains(sweptVisibilityMask, revelioCore.AutoSweptLevel.poc)
        bool alternatePocSweptVisible = revelioCore.autoSweptMaskContains(sweptVisibilityMask, revelioCore.AutoSweptLevel.alternatePoc)
        bool vahSweptVisible = revelioCore.autoSweptMaskContains(sweptVisibilityMask, revelioCore.AutoSweptLevel.valueAreaHigh)
        bool valSweptVisible = revelioCore.autoSweptMaskContains(sweptVisibilityMask, revelioCore.AutoSweptLevel.valueAreaLow)
        string profileHitSourceKey = isLive ? "" : levelHitSourceProfileKey(profile.startTime, profile.endTime, style)
        if levelsAllowed and style.showPoc and not (autoSweptLines and not anchor.restrictToFocus and not focusSurfaced and pocSweptVisible) and not profileLevelAlreadyRendered(renderedLevelHitKeys, profileHitSourceKey, LABEL_POC, isLive)
            [pocRight, pocExtend] = levelEndpoint(profile.endTime, profile.pocBreachTime, style.extensionMode)
            color pocBaseColor = useDevelopingColors ? style.developingColor : style.pocColor
            bool pocSweptDenote = pocSweptVisible and not na(profile.pocBreachTime)
            color pocColor = pocSweptDenote and isMostRecentCompleted ? pocBaseColor : dimLevelColor(pocBaseColor, not na(profile.pocBreachTime), style.dimTouched, style.dimFraction)
            color pocContinuation = dimLevelColor(pocBaseColor, true, true, style.sweptContinuationFraction)
            bool pocHitTrace = touchLabelsActive and not na(profile.pocHitTime) and sameNyDate(profile.pocHitTime, time)
            bool pocArchivedTouch = not isLive and map.contains(archivedLevelHitKeys, levelHitKey(profileHitSourceKey, LABEL_POC))
            drawLevel(profile.startTime, pocRight, profile.pocPrice, pocColor, style.pocWidth, style.pocStyle, pocExtend, useDevelopingColors ? style.developingColor : style.pocLabelColor, LABEL_POC, style, pocSweptDenote, pocContinuation, pocHitTrace, pocArchivedTouch, isLive, isMostRecentCompleted, profile.endTime, "")
            registerRenderedLevelHitKey(renderedLevelHitKeys, profile, style, LABEL_POC, isLive)
        if levelsAllowed and style.showAlternatePoc and profile.hasAlternatePoc and not (autoSweptLines and not anchor.restrictToFocus and not focusSurfaced and alternatePocSweptVisible) and not profileLevelAlreadyRendered(renderedLevelHitKeys, profileHitSourceKey, LABEL_ALTERNATE_POC, isLive)
            [alternateRight, alternateExtend] = levelEndpoint(profile.endTime, profile.alternatePocBreachTime, style.extensionMode)
            color alternateBaseColor = useDevelopingColors ? style.developingColor : style.alternatePocColor
            bool alternateSweptDenote = alternatePocSweptVisible and not na(profile.alternatePocBreachTime)
            color alternateColor = alternateSweptDenote and isMostRecentCompleted ? alternateBaseColor : dimLevelColor(alternateBaseColor, not na(profile.alternatePocBreachTime), style.dimTouched, style.dimFraction)
            color alternateContinuation = dimLevelColor(alternateBaseColor, true, true, style.sweptContinuationFraction)
            bool alternateHitTrace = touchLabelsActive and not na(profile.alternatePocHitTime) and sameNyDate(profile.alternatePocHitTime, time)
            bool alternateArchivedTouch = not isLive and map.contains(archivedLevelHitKeys, levelHitKey(profileHitSourceKey, LABEL_ALTERNATE_POC))
            drawLevel(profile.startTime, alternateRight, profile.alternatePocPrice, alternateColor, style.alternatePocWidth, style.alternatePocStyle, alternateExtend, useDevelopingColors ? style.developingColor : style.alternatePocLabelColor, LABEL_ALTERNATE_POC, style, alternateSweptDenote, alternateContinuation, alternateHitTrace, alternateArchivedTouch, isLive, isMostRecentCompleted, profile.endTime, "")
            registerRenderedLevelHitKey(renderedLevelHitKeys, profile, style, LABEL_ALTERNATE_POC, isLive)
        if levelsAllowed and style.showValueArea
            [valueAreaHighRight, valueAreaHighExtend] = levelEndpoint(profile.endTime, profile.valueAreaHighBreachTime, style.extensionMode)
            color valueAreaBaseColor = useDevelopingColors ? style.developingColor : isMostRecentCompleted ? style.valueAreaLastColor : style.valueAreaColor
            int valueAreaLineWidth = isMostRecentCompleted ? style.valueAreaLastWidth : style.valueAreaWidth
            bool vahSweptDenote = vahSweptVisible and not na(profile.valueAreaHighBreachTime)
            if not (autoSweptLines and not anchor.restrictToFocus and not focusSurfaced and vahSweptVisible) and not profileLevelAlreadyRendered(renderedLevelHitKeys, profileHitSourceKey, LABEL_VAH, isLive)
                color vahColor = vahSweptDenote and isMostRecentCompleted ? valueAreaBaseColor : dimLevelColor(valueAreaBaseColor, not na(profile.valueAreaHighBreachTime), style.dimTouched, style.dimFraction)
                color vahContinuation = dimLevelColor(valueAreaBaseColor, true, true, style.sweptContinuationFraction)
                bool vahHitTrace = touchLabelsActive and not na(profile.valueAreaHighHitTime) and sameNyDate(profile.valueAreaHighHitTime, time)
                bool vahArchivedTouch = not isLive and map.contains(archivedLevelHitKeys, levelHitKey(profileHitSourceKey, LABEL_VAH))
                drawLevel(profile.startTime, valueAreaHighRight, profile.valueAreaHighPrice, vahColor, valueAreaLineWidth, style.valueAreaStyle, valueAreaHighExtend, useDevelopingColors ? style.developingColor : style.valueAreaLabelColor, LABEL_VAH, style, vahSweptDenote, vahContinuation, vahHitTrace, vahArchivedTouch, isLive, isMostRecentCompleted, profile.endTime, "")
                registerRenderedLevelHitKey(renderedLevelHitKeys, profile, style, LABEL_VAH, isLive)
            [valueAreaLowRight, valueAreaLowExtend] = levelEndpoint(profile.endTime, profile.valueAreaLowBreachTime, style.extensionMode)
            bool valSweptDenote = valSweptVisible and not na(profile.valueAreaLowBreachTime)
            if not (autoSweptLines and not anchor.restrictToFocus and not focusSurfaced and valSweptVisible) and not profileLevelAlreadyRendered(renderedLevelHitKeys, profileHitSourceKey, LABEL_VAL, isLive)
                color valColor = valSweptDenote and isMostRecentCompleted ? valueAreaBaseColor : dimLevelColor(valueAreaBaseColor, not na(profile.valueAreaLowBreachTime), style.dimTouched, style.dimFraction)
                color valContinuation = dimLevelColor(valueAreaBaseColor, true, true, style.sweptContinuationFraction)
                bool valHitTrace = touchLabelsActive and not na(profile.valueAreaLowHitTime) and sameNyDate(profile.valueAreaLowHitTime, time)
                bool valArchivedTouch = not isLive and map.contains(archivedLevelHitKeys, levelHitKey(profileHitSourceKey, LABEL_VAL))
                drawLevel(profile.startTime, valueAreaLowRight, profile.valueAreaLowPrice, valColor, valueAreaLineWidth, style.valueAreaStyle, valueAreaLowExtend, useDevelopingColors ? style.developingColor : style.valueAreaLabelColor, LABEL_VAL, style, valSweptDenote, valContinuation, valHitTrace, valArchivedTouch, isLive, isMostRecentCompleted, profile.endTime, "")
                registerRenderedLevelHitKey(renderedLevelHitKeys, profile, style, LABEL_VAL, isLive)

autoSweptArchiveLevelInPass(int protectedVisibilityMask, revelioCore.AutoSweptState autoState, revelioCore.AutoSweptProfile profile, revelioCore.AutoSweptLevel level, bool selectedPass) =>
    bool protectedLevel = revelioCore.autoSweptMaskContains(protectedVisibilityMask, level)
    bool selected = revelioCore.autoSweptCurrentSelected(autoState, profile.startTime, profile.endTime, level)
    selectedPass ? selected and not protectedLevel : protectedLevel

autoSweptArchiveLevelLineCost(int visibilityMask, int protectedVisibilityMask, revelioCore.AutoSweptState autoState, revelioCore.AutoSweptProfile profile, SessionStyle style, bool selectedPass) =>
    int lineCost = 0
    lineCost += style.showPoc and revelioCore.autoSweptMaskContains(visibilityMask, revelioCore.AutoSweptLevel.poc) and autoSweptArchiveLevelInPass(protectedVisibilityMask, autoState, profile, revelioCore.AutoSweptLevel.poc, selectedPass) ? 2 : 0
    lineCost += style.showAlternatePoc and revelioCore.autoSweptMaskContains(visibilityMask, revelioCore.AutoSweptLevel.alternatePoc) and autoSweptArchiveLevelInPass(protectedVisibilityMask, autoState, profile, revelioCore.AutoSweptLevel.alternatePoc, selectedPass) ? 2 : 0
    lineCost += style.showValueArea and revelioCore.autoSweptMaskContains(visibilityMask, revelioCore.AutoSweptLevel.valueAreaHigh) and autoSweptArchiveLevelInPass(protectedVisibilityMask, autoState, profile, revelioCore.AutoSweptLevel.valueAreaHigh, selectedPass) ? 2 : 0
    lineCost += style.showValueArea and revelioCore.autoSweptMaskContains(visibilityMask, revelioCore.AutoSweptLevel.valueAreaLow) and autoSweptArchiveLevelInPass(protectedVisibilityMask, autoState, profile, revelioCore.AutoSweptLevel.valueAreaLow, selectedPass) ? 2 : 0
    lineCost

autoSweptArchiveLineCost(RenderBudgetAnchor anchor, bool selectedPass) =>
    int lineCost = 0
    if autoSweptLines and anchor.levelsEnabled and anchor.style.extensionMode == LEVEL_BREACH_SWEEP and not anchor.restrictToFocus and array.size(anchor.autoSweptState.profiles) > 0
        for profileIndex = 0 to array.size(anchor.autoSweptState.profiles) - 1
            revelioCore.AutoSweptProfile profile = array.get(anchor.autoSweptState.profiles, profileIndex)
            int visibilityMask = autoSweptArchiveVisibilityMaskAt(anchor, profileIndex)
            int protectedVisibilityMask = autoSweptArchiveProtectedVisibilityMaskAt(anchor, profileIndex)
            lineCost += autoSweptArchiveLevelLineCost(visibilityMask, protectedVisibilityMask, anchor.autoSweptState, profile, anchor.style, selectedPass)
    lineCost

totalAutoSweptArchiveLineCost(array<RenderBudgetAnchor> anchors, bool selectedPass) =>
    int lineCost = 0
    if array.size(anchors) > 0
        for anchorIndex = 0 to array.size(anchors) - 1
            lineCost += autoSweptArchiveLineCost(array.get(anchors, anchorIndex), selectedPass)
    lineCost

focusedAutoSweptReservedLineCost(array<RenderBudgetAnchor> anchors) =>
    int lineCost = 0
    if autoSweptLines and array.size(anchors) > 0
        for anchorIndex = 0 to array.size(anchors) - 1
            RenderBudgetAnchor anchor = array.get(anchors, anchorIndex)
            if anchor.levelsEnabled and anchor.style.extensionMode == LEVEL_BREACH_SWEEP and anchor.restrictToFocus and array.size(anchor.autoSweptState.profiles) > 0
                for archiveIndex = 0 to array.size(anchor.autoSweptState.profiles) - 1
                    revelioCore.AutoSweptProfile profile = array.get(anchor.autoSweptState.profiles, archiveIndex)
                    int retainedIndex = revelioCore.profileIndexByStart(anchor.profiles, profile.startTime, START_TIME_UNSET)
                    if retainedIndex >= 0 and renderBudgetProfileAllowed(anchor, retainedIndex)
                        int visibilityMask = autoSweptArchiveVisibilityMaskAt(anchor, archiveIndex)
                        int protectedVisibilityMask = autoSweptArchiveProtectedVisibilityMaskAt(anchor, archiveIndex)
                        lineCost += autoSweptArchiveLevelLineCost(visibilityMask, protectedVisibilityMask, anchor.autoSweptState, profile, anchor.style, false)
                        lineCost += autoSweptArchiveLevelLineCost(visibilityMask, protectedVisibilityMask, anchor.autoSweptState, profile, anchor.style, true)
    lineCost

renderAutoSweptArchiveLevel(revelioCore.AutoSweptProfile profile, revelioCore.AutoSweptState autoState, SessionStyle style, revelioCore.AutoSweptLevel autoLevel, string levelName, float levelPrice, int breachTime, int hitTime, color baseColor, int lineWidth, string lineStyle, color labelColor, bool isMostRecentCompleted, int protectedVisibilityMask, bool selectedPass, bool touchLabelsActive, map<string, bool> archivedLevelHitKeys, map<string, bool> renderedLevelHitKeys) =>
    string sourceProfileKey = levelHitSourceProfileKey(profile.startTime, profile.endTime, style)
    string renderedKey = levelHitKey(sourceProfileKey, levelName)
    if autoSweptArchiveLevelInPass(protectedVisibilityMask, autoState, profile, autoLevel, selectedPass) and not map.contains(renderedLevelHitKeys, renderedKey) and array.size(drawnLines) <= INDICATOR_MAX_LINES - 2
        [lineRight, lineExtend] = levelEndpoint(profile.endTime, breachTime, style.extensionMode)
        color levelColor = isMostRecentCompleted ? baseColor : dimLevelColor(baseColor, true, style.dimTouched, style.dimFraction)
        color continuationColor = dimLevelColor(baseColor, true, true, style.sweptContinuationFraction)
        bool hitTrace = touchLabelsActive and not na(hitTime) and sameNyDate(hitTime, time)
        bool archivedTouch = map.contains(archivedLevelHitKeys, renderedKey)
        string auditSuffix = autoSweptAudit and selectedPass ? AUTO_SWEPT_AUDIT_SUFFIX : ""
        drawLevel(profile.startTime, lineRight, levelPrice, levelColor, lineWidth, lineStyle, lineExtend, labelColor, levelName, style, true, continuationColor, hitTrace, archivedTouch, false, isMostRecentCompleted, profile.endTime, auditSuffix)
        map.put(renderedLevelHitKeys, renderedKey, true)
    true

renderAutoSweptArchiveProfile(revelioCore.AutoSweptProfile profile, int profileIndex, RenderBudgetAnchor anchor, bool selectedPass, bool touchLabelsActive, map<string, bool> archivedLevelHitKeys, map<string, bool> renderedLevelHitKeys) =>
    int visibilityMask = autoSweptArchiveVisibilityMaskAt(anchor, profileIndex)
    int protectedVisibilityMask = autoSweptArchiveProtectedVisibilityMaskAt(anchor, profileIndex)
    bool isMostRecentCompleted = array.size(anchor.profiles) > 0 and array.last(anchor.profiles).startTime == profile.startTime
    if anchor.style.showPoc and revelioCore.autoSweptMaskContains(visibilityMask, revelioCore.AutoSweptLevel.poc)
        renderAutoSweptArchiveLevel(profile, anchor.autoSweptState, anchor.style, revelioCore.AutoSweptLevel.poc, LABEL_POC, profile.pocPrice, profile.pocBreachTime, profile.pocHitTime, anchor.style.pocColor, anchor.style.pocWidth, anchor.style.pocStyle, anchor.style.pocLabelColor, isMostRecentCompleted, protectedVisibilityMask, selectedPass, touchLabelsActive, archivedLevelHitKeys, renderedLevelHitKeys)
    if anchor.style.showAlternatePoc and profile.hasAlternatePoc and revelioCore.autoSweptMaskContains(visibilityMask, revelioCore.AutoSweptLevel.alternatePoc)
        renderAutoSweptArchiveLevel(profile, anchor.autoSweptState, anchor.style, revelioCore.AutoSweptLevel.alternatePoc, LABEL_ALTERNATE_POC, profile.alternatePocPrice, profile.alternatePocBreachTime, profile.alternatePocHitTime, anchor.style.alternatePocColor, anchor.style.alternatePocWidth, anchor.style.alternatePocStyle, anchor.style.alternatePocLabelColor, isMostRecentCompleted, protectedVisibilityMask, selectedPass, touchLabelsActive, archivedLevelHitKeys, renderedLevelHitKeys)
    if anchor.style.showValueArea
        color valueAreaColor = isMostRecentCompleted ? anchor.style.valueAreaLastColor : anchor.style.valueAreaColor
        int valueAreaWidth = isMostRecentCompleted ? anchor.style.valueAreaLastWidth : anchor.style.valueAreaWidth
        if revelioCore.autoSweptMaskContains(visibilityMask, revelioCore.AutoSweptLevel.valueAreaHigh)
            renderAutoSweptArchiveLevel(profile, anchor.autoSweptState, anchor.style, revelioCore.AutoSweptLevel.valueAreaHigh, LABEL_VAH, profile.valueAreaHighPrice, profile.valueAreaHighBreachTime, profile.valueAreaHighHitTime, valueAreaColor, valueAreaWidth, anchor.style.valueAreaStyle, anchor.style.valueAreaLabelColor, isMostRecentCompleted, protectedVisibilityMask, selectedPass, touchLabelsActive, archivedLevelHitKeys, renderedLevelHitKeys)
        if revelioCore.autoSweptMaskContains(visibilityMask, revelioCore.AutoSweptLevel.valueAreaLow)
            renderAutoSweptArchiveLevel(profile, anchor.autoSweptState, anchor.style, revelioCore.AutoSweptLevel.valueAreaLow, LABEL_VAL, profile.valueAreaLowPrice, profile.valueAreaLowBreachTime, profile.valueAreaLowHitTime, valueAreaColor, valueAreaWidth, anchor.style.valueAreaStyle, anchor.style.valueAreaLabelColor, isMostRecentCompleted, protectedVisibilityMask, selectedPass, touchLabelsActive, archivedLevelHitKeys, renderedLevelHitKeys)
    true

renderAutoSweptArchivePass(array<RenderBudgetAnchor> anchors, bool selectedPass, bool touchLabelsActive, map<string, bool> archivedLevelHitKeys, map<string, bool> renderedLevelHitKeys) =>
    if autoSweptLines and array.size(anchors) > 0
        for anchorIndex = 0 to array.size(anchors) - 1
            RenderBudgetAnchor anchor = array.get(anchors, anchorIndex)
            if anchor.levelsEnabled and anchor.style.extensionMode == LEVEL_BREACH_SWEEP and not anchor.restrictToFocus and array.size(anchor.autoSweptState.profiles) > 0
                for profileIndex = array.size(anchor.autoSweptState.profiles) - 1 to 0
                    renderAutoSweptArchiveProfile(array.get(anchor.autoSweptState.profiles, profileIndex), profileIndex, anchor, selectedPass, touchLabelsActive, archivedLevelHitKeys, renderedLevelHitKeys)
    true

renderFocusedAutoSweptReserved(array<RenderBudgetAnchor> anchors, bool selectedPass, bool touchLabelsActive, map<string, bool> archivedLevelHitKeys, map<string, bool> renderedLevelHitKeys) =>
    if autoSweptLines and array.size(anchors) > 0
        for anchorIndex = 0 to array.size(anchors) - 1
            RenderBudgetAnchor anchor = array.get(anchors, anchorIndex)
            if anchor.levelsEnabled and anchor.style.extensionMode == LEVEL_BREACH_SWEEP and anchor.restrictToFocus and array.size(anchor.autoSweptState.profiles) > 0
                for archiveIndex = array.size(anchor.autoSweptState.profiles) - 1 to 0
                    revelioCore.AutoSweptProfile profile = array.get(anchor.autoSweptState.profiles, archiveIndex)
                    int retainedIndex = revelioCore.profileIndexByStart(anchor.profiles, profile.startTime, START_TIME_UNSET)
                    if retainedIndex >= 0 and renderBudgetProfileAllowed(anchor, retainedIndex)
                        renderAutoSweptArchiveProfile(profile, archiveIndex, anchor, selectedPass, touchLabelsActive, archivedLevelHitKeys, renderedLevelHitKeys)
    true

// ═══════════════════════════════════════════════════════════════════════════════
// FUNCTIONS — anchor engine
// ═══════════════════════════════════════════════════════════════════════════════

emptyRemoteProfileResult() =>
    float unavailablePrice = na
    revelioCore.Profile histogramSnapshot = na
    revelioCore.Profile developingSnapshot = na
    [START_TIME_UNSET, START_TIME_UNSET, unavailablePrice, unavailablePrice, unavailablePrice, unavailablePrice, unavailablePrice, false, unavailablePrice, histogramSnapshot, developingSnapshot, 0]

fixedQuarterlyContext(bool enabled, bool developingEnabled, bool useUtcCalendar, bool prepareHistogram) =>
    if not enabled
        emptyRemoteProfileResult()
    else
        [fixedHighs, fixedLows, fixedVolumes] = request.security_lower_tf(syminfo.tickerid, QUARTERLY_INTRABAR_TIMEFRAME, [high, low, volume], ignore_invalid_timeframe=true, calc_bars_count=QUARTERLY_INTRABAR_BARS)
        bool utcQuarterBoundary = calendarQuarterStart(UTC_TIMEZONE)
        bool marketQuarterBoundary = calendarQuarterStart(NY_TIMEZONE)
        bool quarterBoundary = selectAssetCalendarStart(useUtcCalendar, utcQuarterBoundary, marketQuarterBoundary)
        bool utcDayBoundary = calendarDayStart(UTC_TIMEZONE)
        bool marketRthInSession = not na(time(timeframe.period, RTH_SESSION, NY_TIMEZONE))
        bool marketSessionComplete = not marketRthInSession and marketRthInSession[1]
        bool maturitySessionComplete = useUtcCalendar ? utcDayBoundary : marketSessionComplete
        var revelioCore.AnchorState state = revelioCore.newAnchorState(START_TIME_UNSET)
        var revelioCore.MergeState mergeState = revelioCore.newMergeState(START_TIME_UNSET)
        var revelioCore.MaturityState maturityState = revelioCore.newMaturityState()
        var revelioCore.AnchorProcessPolicy policy = newCalendarAnchorProcessPolicy(quarterlyProfilesToShow, prepareHistogram, true)
        if developingEnabled
            revelioCore.advanceMaturityState(maturityState, state, quarterBoundary, maturitySessionComplete, QUARTERLY_MATURITY_HISTORY, PROFILE_ROWS, VALUE_AREA_PERCENT, syminfo.mintick, MATURITY_STABILITY_FRACTION)
        [preparedHighs, preparedLows, preparedVolumes] = revelioCore.prepareBarVolumeSamples(fixedHighs, fixedLows, fixedVolumes, high, low, volume, true)
        revelioCore.processAnchor(state, mergeState, policy, true, true, quarterBoundary, false, preparedHighs, preparedLows, preparedVolumes, true, time, time[1], START_TIME_UNSET, PROFILE_ROWS, VALUE_AREA_PERCENT)
        revelioCore.Profile latestProfile = array.size(state.profiles) > 0 ? array.last(state.profiles) : na
        bool latestAvailable = not na(latestProfile) and latestProfile.isValid
        bool sameCompletionDay = latestAvailable and (useUtcCalendar ? sameCalendarDate(time, latestProfile.endTime, UTC_TIMEZONE) : sameCalendarDate(time, latestProfile.endTime, NY_TIMEZONE))
        // Publish throughout the bounded completion day so any intraday host alignment can sample the rows.
        bool histogramPublishWindow = sameCompletionDay
        bool weeklyHistogramSnapshot = useUtcCalendar ? dayofweek(time, UTC_TIMEZONE) == dayofweek.monday and hour(time, UTC_TIMEZONE) == QUARTERLY_UTC_WEEKLY_SNAPSHOT_HOUR and minute(time, UTC_TIMEZONE) == QUARTERLY_SNAPSHOT_MINUTE : dayofweek(time, NY_TIMEZONE) == dayofweek.monday and hour(time, NY_TIMEZONE) == QUARTERLY_MARKET_WEEKLY_SNAPSHOT_HOUR and minute(time, NY_TIMEZONE) == QUARTERLY_SNAPSHOT_MINUTE
        revelioCore.Profile histogramSnapshot = prepareHistogram and latestAvailable and (histogramPublishWindow or weeklyHistogramSnapshot or barstate.islast) ? latestProfile : na
        revelioCore.Profile developingSnapshot = developingEnabled and state.startTime != START_TIME_UNSET and array.size(state.barVolumes) > 0 and barstate.islast ? revelioCore.buildProfile(state.barHighs, state.barLows, state.barVolumes, PROFILE_ROWS, VALUE_AREA_PERCENT, state.startTime, time, prepareHistogram) : na
        bool showDeveloping = developingEnabled and revelioCore.maturityShowsDeveloping(maturityState, state, quarterlyCurrentMode == CURRENT_ON, quarterlyCurrentMode == CURRENT_AUTO, useUtcCalendar ? QUARTERLY_UTC_MATURITY_SESSIONS : QUARTERLY_MARKET_MATURITY_SESSIONS, useUtcCalendar ? QUARTERLY_UTC_EARLY_MATURITY_SESSIONS : QUARTERLY_MARKET_EARLY_MATURITY_SESSIONS, MATURITY_EARLY_VOLUME_THRESHOLD_PERCENT, barstate.islast)
        [latestAvailable ? latestProfile.startTime : START_TIME_UNSET, latestAvailable ? latestProfile.endTime : START_TIME_UNSET, latestAvailable ? latestProfile.priceLow : na, latestAvailable ? latestProfile.priceHigh : na, latestAvailable ? latestProfile.pocPrice : na, latestAvailable ? latestProfile.valueAreaHighPrice : na, latestAvailable ? latestProfile.valueAreaLowPrice : na, latestAvailable ? latestProfile.hasAlternatePoc : false, latestAvailable ? latestProfile.alternatePocPrice : na, histogramSnapshot, developingSnapshot, showDeveloping ? 1 : 0]

registerLevelHitSourceProfiles(map<string, bool> retainedSourceProfiles, array<revelioCore.Profile> profiles, int fromIndex, bool sourceActive, SessionStyle style) =>
    if sourceActive and array.size(profiles) > 0
        for profileIndex = math.max(0, fromIndex) to array.size(profiles) - 1
            revelioCore.Profile profile = array.get(profiles, profileIndex)
            map.put(retainedSourceProfiles, levelHitSourceProfileKey(profile.startTime, profile.endTime, style), true)
    true

registerAutoSweptArchiveSourceProfiles(map<string, bool> retainedSourceProfiles, revelioCore.AutoSweptState autoState, bool sourceActive, SessionStyle style) =>
    if autoSweptLines and sourceActive and style.extensionMode == LEVEL_BREACH_SWEEP and array.size(autoState.profiles) > 0
        for profileIndex = 0 to array.size(autoState.profiles) - 1
            revelioCore.AutoSweptProfile profile = array.get(autoState.profiles, profileIndex)
            if autoSweptArchiveProfileEligible(autoState, profile)
                map.put(retainedSourceProfiles, levelHitSourceProfileKey(profile.startTime, profile.endTime, style), true)
    true

activeLastBarUpdate() =>
    barstate.islast

levelHitUsesMarketClock() =>
    barstate.isrealtime and (chart.is_range or (not na(time_close) and timenow >= time and timenow <= time_close))

// Historical sub-bars retain their requested timestamps. Live updates compact to one bounded minute
// bucket while preserving the bucket's first update time and approach origin.
recordLevelHitRanges(array<LevelHitRange> ranges, bool active, int barTime, int referenceTime) =>
    int contactCount = array.size(levelHitContactTimes)
    bool marketClockUpdate = levelHitUsesMarketClock()
    if active and contactCount > 0
        for contactIndex = 0 to contactCount - 1
            float contactHigh = array.get(levelHitContactHighs, contactIndex)
            float contactLow = array.get(levelHitContactLows, contactIndex)
            float contactStart = array.get(levelHitContactStarts, contactIndex)
            int contactTime = array.get(levelHitContactTimes, contactIndex)
            int rangeTime = marketClockUpdate ? barTime : contactTime
            int contactBucketTime = int(contactTime / MS_PER_MINUTE) * MS_PER_MINUTE
            int rangeCount = array.size(ranges)
            int matchingRangeIndex = -1
            if rangeCount > 0
                for rangeIndex = rangeCount - 1 to 0
                    LevelHitRange existingRange = array.get(ranges, rangeIndex)
                    bool matchingLiveBucket = marketClockUpdate and existingRange.chartBarTime == barTime and int(existingRange.contactTime / MS_PER_MINUTE) * MS_PER_MINUTE == contactBucketTime
                    bool matchingHistoricalRange = not marketClockUpdate and existingRange.contactTime == contactTime
                    if matchingLiveBucket or matchingHistoricalRange
                        matchingRangeIndex := rangeIndex
                        break
                    int oldestMatchingTime = marketClockUpdate ? contactBucketTime : contactTime
                    if existingRange.contactTime < oldestMatchingTime
                        break
            if matchingRangeIndex >= 0
                LevelHitRange existingRange = array.get(ranges, matchingRangeIndex)
                existingRange.highPrice := math.max(existingRange.highPrice, contactHigh)
                existingRange.lowPrice := math.min(existingRange.lowPrice, contactLow)
            else
                array.push(ranges, LevelHitRange.new(rangeTime, barTime, contactTime, contactHigh, contactLow, contactStart))
    int oldestAllowedTime = referenceTime - FOCUS_HIT_RANGE_RETENTION_MS
    while array.size(ranges) > 0 and (array.get(ranges, 0).barTime < oldestAllowedTime or array.size(ranges) > MAX_FOCUS_HIT_RANGES)
        array.shift(ranges)
    true

levelMarkedTimeOnDate(array<revelioInteractions.LevelHitEvent> events, string key, int referenceTime) =>
    int markedTime = na
    if array.size(events) > 0
        for eventIndex = array.size(events) - 1 to 0
            revelioInteractions.LevelHitEvent hitEvent = array.get(events, eventIndex)
            if hitEvent.key == key and sameNyDate(hitEvent.hitTime, referenceTime)
                markedTime := hitEvent.hitTime
                break
    markedTime

insertLevelHitEvent(array<revelioInteractions.LevelHitEvent> events, revelioInteractions.LevelHitEvent hitEvent) =>
    int insertAt = array.size(events)
    if array.size(events) > 0
        for eventIndex = 0 to array.size(events) - 1
            if hitEvent.barTime < array.get(events, eventIndex).barTime
                insertAt := eventIndex
                break
    if insertAt >= array.size(events)
        array.push(events, hitEvent)
    else
        array.insert(events, insertAt, hitEvent)
    while array.size(events) > MAX_LEVEL_HIT_EVENTS
        array.shift(events)
    true

levelHitApproachDirection(float levelPrice, float startPrice) =>
    na(startPrice) or startPrice == levelPrice ? LEVEL_HIT_DIRECTION_UNRESOLVED : startPrice > levelPrice ? LEVEL_HIT_DIRECTION_FROM_ABOVE : LEVEL_HIT_DIRECTION_FROM_BELOW

processLevelHitAtTime(float levelPrice, int previousHitTime, string sourceProfileKey, string key, bool focusOnly, bool archivedSwept, bool unselectedAnchor, array<revelioInteractions.LevelHitEvent> events, float hitHigh, float hitLow, float hitStartPrice, int hitTime, int contactTime, int hitBarTime, bool searchEventArchive) =>
    bool hitNow = not na(hitHigh) and not na(hitLow) and hitLow <= levelPrice and hitHigh >= levelPrice
    int markedTime = searchEventArchive ? levelMarkedTimeOnDate(events, key, hitTime) : not na(previousHitTime) and sameNyDate(previousHitTime, hitTime) ? previousHitTime : na
    bool firstHitToday = hitNow and na(markedTime)
    if firstHitToday
        markedTime := hitTime
        int approachDirection = levelHitApproachDirection(levelPrice, hitStartPrice)
        insertLevelHitEvent(events, revelioInteractions.LevelHitEvent.new(markedTime, hitBarTime, contactTime, levelPrice, sourceProfileKey, key, focusOnly, archivedSwept, unselectedAnchor, approachDirection))
    [not na(markedTime) ? markedTime : previousHitTime, firstHitToday]

firstLevelHitContact(float levelPrice) =>
    int contactTime = na
    float contactStartPrice = na
    int contactCount = array.size(levelHitContactTimes)
    if contactCount > 0
        for contactIndex = 0 to contactCount - 1
            if array.get(levelHitContactLows, contactIndex) <= levelPrice and array.get(levelHitContactHighs, contactIndex) >= levelPrice
                contactTime := array.get(levelHitContactTimes, contactIndex)
                contactStartPrice := array.get(levelHitContactStarts, contactIndex)
                break
    [contactTime, contactStartPrice]

// A degenerate [level, level] range replays the contact through the shared dedupe-and-insert core.
processLevelHit(float levelPrice, int previousHitTime, string sourceProfileKey, string key, bool focusOnly, bool archivedSwept, bool unselectedAnchor, array<revelioInteractions.LevelHitEvent> events) =>
    [contactTime, contactStartPrice] = firstLevelHitContact(levelPrice)
    float contactPrice = not na(contactTime) ? levelPrice : na
    bool activeEdgeUpdate = activeLastBarUpdate()
    int updateTime = levelHitUsesMarketClock() ? timenow : time
    int eventTime = not na(contactTime) ? contactTime : updateTime
    processLevelHitAtTime(levelPrice, previousHitTime, sourceProfileKey, key, focusOnly, archivedSwept, unselectedAnchor, events, contactPrice, contactPrice, contactStartPrice, eventTime, eventTime, time, activeEdgeUpdate)

processProfileLevelHit(float levelPrice, int previousHitTime, bool dailyTouchConsumed, string sourceProfileKey, string key, bool focusOnly, bool archivedSwept, bool unselectedAnchor, bool eligible, bool limitDailyRetouches, array<revelioInteractions.LevelHitEvent> events) =>
    int updatedHitTime = previousHitTime
    bool updatedDailyTouchConsumed = dailyTouchConsumed
    if eligible and (not limitDailyRetouches or not dailyTouchConsumed)
        [markedTime, hitRecorded] = processLevelHit(levelPrice, previousHitTime, sourceProfileKey, key, focusOnly, archivedSwept, unselectedAnchor, events)
        updatedHitTime := markedTime
        updatedDailyTouchConsumed := dailyTouchConsumed or (limitDailyRetouches and hitRecorded)
    [updatedHitTime, updatedDailyTouchConsumed]

updateProfileLevelHitTrace(array<revelioCore.Profile> profiles, revelioCore.AutoSweptState autoState, revelioCore.Profile profile, int profileIndex, int profileCount, SessionStyle style, array<revelioInteractions.LevelHitEvent> events, bool surfaceSweptLevels, bool sourceAnchorSelected, bool focusOnly, bool includeOlderLevels, bool limitDailyRetouches) =>
    if time > profile.endTime
        string sourceProfileKey = levelHitSourceProfileKey(profile.startTime, profile.endTime, style)
        bool isMostRecentCompleted = profileIndex == profileCount - 1
        int sweptVisibilityMask = profileSweptVisibilityMask(autoState, profile, isMostRecentCompleted, style, surfaceSweptLevels)
        bool pocSweptDenote = revelioCore.autoSweptMaskContains(sweptVisibilityMask, revelioCore.AutoSweptLevel.poc)
        bool vahSweptDenote = revelioCore.autoSweptMaskContains(sweptVisibilityMask, revelioCore.AutoSweptLevel.valueAreaHigh)
        bool valSweptDenote = revelioCore.autoSweptMaskContains(sweptVisibilityMask, revelioCore.AutoSweptLevel.valueAreaLow)
        bool alternateSweptDenote = revelioCore.autoSweptMaskContains(sweptVisibilityMask, revelioCore.AutoSweptLevel.alternatePoc)
        [_, pocExtendsRight] = levelEndpoint(profile.endTime, profile.pocBreachTime, style.extensionMode)
        [_, vahExtendsRight] = levelEndpoint(profile.endTime, profile.valueAreaHighBreachTime, style.extensionMode)
        [_, valExtendsRight] = levelEndpoint(profile.endTime, profile.valueAreaLowBreachTime, style.extensionMode)
        [_, alternateExtendsRight] = levelEndpoint(profile.endTime, profile.alternatePocBreachTime, style.extensionMode)
        bool archivedSweptEligible = includeOlderLevels and style.extensionMode == LEVEL_BREACH_SWEEP
        bool pocVisibleAtLiveEdge = pocExtendsRight or pocSweptDenote
        bool vahVisibleAtLiveEdge = vahExtendsRight or vahSweptDenote
        bool valVisibleAtLiveEdge = valExtendsRight or valSweptDenote
        bool alternateVisibleAtLiveEdge = alternateExtendsRight or alternateSweptDenote
        bool pocHitEligible = style.showPoc and (pocVisibleAtLiveEdge or archivedSweptEligible)
        bool vahHitEligible = style.showValueArea and (vahVisibleAtLiveEdge or archivedSweptEligible)
        bool valHitEligible = style.showValueArea and (valVisibleAtLiveEdge or archivedSweptEligible)
        bool alternateHitEligible = style.showAlternatePoc and profile.hasAlternatePoc and (alternateVisibleAtLiveEdge or archivedSweptEligible)
        bool limitAnchorRetouches = includeOlderLevels and limitDailyRetouches and (style.labelAnchor == LABEL_RTH_ANCHOR or style.labelAnchor == LABEL_GLOBEX_ANCHOR)
        [pocHitTime, pocDailyTouchConsumed] = processProfileLevelHit(profile.pocPrice, profile.pocHitTime, profile.pocDailyTouchConsumed, sourceProfileKey, levelHitKey(sourceProfileKey, LABEL_POC), focusOnly, not pocVisibleAtLiveEdge, not sourceAnchorSelected, pocHitEligible, limitAnchorRetouches, events)
        profile.pocHitTime := pocHitTime
        profile.pocDailyTouchConsumed := pocDailyTouchConsumed
        [vahHitTime, vahDailyTouchConsumed] = processProfileLevelHit(profile.valueAreaHighPrice, profile.valueAreaHighHitTime, profile.valueAreaHighDailyTouchConsumed, sourceProfileKey, levelHitKey(sourceProfileKey, LABEL_VAH), focusOnly, not vahVisibleAtLiveEdge, not sourceAnchorSelected, vahHitEligible, limitAnchorRetouches, events)
        profile.valueAreaHighHitTime := vahHitTime
        profile.valueAreaHighDailyTouchConsumed := vahDailyTouchConsumed
        [valHitTime, valDailyTouchConsumed] = processProfileLevelHit(profile.valueAreaLowPrice, profile.valueAreaLowHitTime, profile.valueAreaLowDailyTouchConsumed, sourceProfileKey, levelHitKey(sourceProfileKey, LABEL_VAL), focusOnly, not valVisibleAtLiveEdge, not sourceAnchorSelected, valHitEligible, limitAnchorRetouches, events)
        profile.valueAreaLowHitTime := valHitTime
        profile.valueAreaLowDailyTouchConsumed := valDailyTouchConsumed
        [alternateHitTime, alternateDailyTouchConsumed] = processProfileLevelHit(profile.alternatePocPrice, profile.alternatePocHitTime, profile.alternatePocDailyTouchConsumed, sourceProfileKey, levelHitKey(sourceProfileKey, LABEL_ALTERNATE_POC), focusOnly, not alternateVisibleAtLiveEdge, not sourceAnchorSelected, alternateHitEligible, limitAnchorRetouches, events)
        profile.alternatePocHitTime := alternateHitTime
        profile.alternatePocDailyTouchConsumed := alternateDailyTouchConsumed
    true

hitTraceProfileFromIndex(array<revelioCore.Profile> profiles, bool focusDeepRetention, int normalProfileCount) =>
    focusDeepRetention ? math.max(0, array.size(profiles) - normalProfileCount) : 0

// Touch Marker hit state remains independent of mitigation.
updateLevelHitTrace(array<revelioCore.Profile> profiles, revelioCore.AutoSweptState autoState, int fromIndex, bool active, bool sourceAnchorSelected, bool includeOlderLevels, bool limitDailyRetouches, SessionStyle style, array<revelioInteractions.LevelHitEvent> events) =>
    if active and (style.showPoc or style.showValueArea or style.showAlternatePoc) and array.size(profiles) > 0
        int profileCount = array.size(profiles)
        for profileIndex = math.max(0, fromIndex) to profileCount - 1
            updateProfileLevelHitTrace(profiles, autoState, array.get(profiles, profileIndex), profileIndex, profileCount, style, events, false, sourceAnchorSelected, false, includeOlderLevels, limitDailyRetouches)
    true

autoSweptArchiveHitTime(revelioCore.AutoSweptProfile profile, revelioCore.AutoSweptLevel level) =>
    level == revelioCore.AutoSweptLevel.poc ? profile.pocHitTime : level == revelioCore.AutoSweptLevel.alternatePoc ? profile.alternatePocHitTime : level == revelioCore.AutoSweptLevel.valueAreaHigh ? profile.valueAreaHighHitTime : profile.valueAreaLowHitTime

autoSweptArchiveDailyTouchConsumed(revelioCore.AutoSweptProfile profile, revelioCore.AutoSweptLevel level) =>
    level == revelioCore.AutoSweptLevel.poc ? profile.pocDailyTouchConsumed : level == revelioCore.AutoSweptLevel.alternatePoc ? profile.alternatePocDailyTouchConsumed : level == revelioCore.AutoSweptLevel.valueAreaHigh ? profile.valueAreaHighDailyTouchConsumed : profile.valueAreaLowDailyTouchConsumed

setAutoSweptArchiveHitState(revelioCore.AutoSweptProfile profile, revelioCore.AutoSweptLevel level, int hitTime, bool dailyTouchConsumed) =>
    if level == revelioCore.AutoSweptLevel.poc
        profile.pocHitTime := hitTime
        profile.pocDailyTouchConsumed := dailyTouchConsumed
    else if level == revelioCore.AutoSweptLevel.alternatePoc
        profile.alternatePocHitTime := hitTime
        profile.alternatePocDailyTouchConsumed := dailyTouchConsumed
    else if level == revelioCore.AutoSweptLevel.valueAreaHigh
        profile.valueAreaHighHitTime := hitTime
        profile.valueAreaHighDailyTouchConsumed := dailyTouchConsumed
    else
        profile.valueAreaLowHitTime := hitTime
        profile.valueAreaLowDailyTouchConsumed := dailyTouchConsumed
    true

updateAutoSweptArchiveLevelHitTrace(revelioCore.AutoSweptProfile profile, SessionStyle style, revelioCore.AutoSweptLevel level, string levelName, float levelPrice, int breachTime, int visibilityMask, bool enabled, bool sourceEligible, bool sourceAnchorSelected, bool includeOlderLevels, bool limitDailyRetouches, array<revelioInteractions.LevelHitEvent> events) =>
    bool visibleAtLiveEdge = revelioCore.autoSweptMaskContains(visibilityMask, level)
    bool olderSweptEligible = includeOlderLevels and not na(breachTime)
    if enabled and sourceEligible and (visibleAtLiveEdge or olderSweptEligible)
        string sourceProfileKey = levelHitSourceProfileKey(profile.startTime, profile.endTime, style)
        bool limitAnchorRetouches = includeOlderLevels and limitDailyRetouches and (style.labelAnchor == LABEL_RTH_ANCHOR or style.labelAnchor == LABEL_GLOBEX_ANCHOR)
        [hitTime, dailyTouchConsumed] = processProfileLevelHit(levelPrice, autoSweptArchiveHitTime(profile, level), autoSweptArchiveDailyTouchConsumed(profile, level), sourceProfileKey, levelHitKey(sourceProfileKey, levelName), false, not visibleAtLiveEdge, not sourceAnchorSelected, true, limitAnchorRetouches, events)
        setAutoSweptArchiveHitState(profile, level, hitTime, dailyTouchConsumed)
    true

updateAutoSweptArchiveHitTrace(array<revelioCore.Profile> retainedProfiles, revelioCore.AutoSweptState autoState, bool active, bool sourceAnchorSelected, bool includeOlderLevels, bool limitDailyRetouches, SessionStyle style, array<revelioInteractions.LevelHitEvent> events) =>
    if active and autoSweptLines and style.extensionMode == LEVEL_BREACH_SWEEP and array.size(autoState.profiles) > 0
        for profileIndex = 0 to array.size(autoState.profiles) - 1
            revelioCore.AutoSweptProfile profile = array.get(autoState.profiles, profileIndex)
            if revelioCore.profileIndexByIdentity(retainedProfiles, profile.startTime, profile.endTime, START_TIME_UNSET) < 0
                int visibilityMask = revelioCore.autoSweptArchiveVisibilityMask(autoState, profile, time)
                updateAutoSweptArchiveLevelHitTrace(profile, style, revelioCore.AutoSweptLevel.poc, LABEL_POC, profile.pocPrice, profile.pocBreachTime, visibilityMask, style.showPoc, autoSweptArchiveLevelEligible(autoState, profile, revelioCore.AutoSweptLevel.poc), sourceAnchorSelected, includeOlderLevels, limitDailyRetouches, events)
                updateAutoSweptArchiveLevelHitTrace(profile, style, revelioCore.AutoSweptLevel.valueAreaHigh, LABEL_VAH, profile.valueAreaHighPrice, profile.valueAreaHighBreachTime, visibilityMask, style.showValueArea, autoSweptArchiveLevelEligible(autoState, profile, revelioCore.AutoSweptLevel.valueAreaHigh), sourceAnchorSelected, includeOlderLevels, limitDailyRetouches, events)
                updateAutoSweptArchiveLevelHitTrace(profile, style, revelioCore.AutoSweptLevel.valueAreaLow, LABEL_VAL, profile.valueAreaLowPrice, profile.valueAreaLowBreachTime, visibilityMask, style.showValueArea, autoSweptArchiveLevelEligible(autoState, profile, revelioCore.AutoSweptLevel.valueAreaLow), sourceAnchorSelected, includeOlderLevels, limitDailyRetouches, events)
                if profile.hasAlternatePoc
                    updateAutoSweptArchiveLevelHitTrace(profile, style, revelioCore.AutoSweptLevel.alternatePoc, LABEL_ALTERNATE_POC, profile.alternatePocPrice, profile.alternatePocBreachTime, visibilityMask, style.showAlternatePoc, autoSweptArchiveLevelEligible(autoState, profile, revelioCore.AutoSweptLevel.alternatePoc), sourceAnchorSelected, includeOlderLevels, limitDailyRetouches, events)
    true

// Focus-selected profiles add their visible levels without recruiting the retained search archive.
updateFocusedLevelHitTrace(RenderBudgetAnchor anchor, bool active, bool includeOlderLevels, bool limitDailyRetouches, array<revelioInteractions.LevelHitEvent> events) =>
    if active and anchor.restrictToFocus and (anchor.style.showPoc or anchor.style.showValueArea or anchor.style.showAlternatePoc)
        int profileCount = array.size(anchor.profiles)
        if profileCount > 0
            for profileIndex = 0 to profileCount - 1
                if renderBudgetProfileAllowed(anchor, profileIndex)
                    updateProfileLevelHitTrace(anchor.profiles, anchor.autoSweptState, array.get(anchor.profiles, profileIndex), profileIndex, profileCount, anchor.style, events, anchor.surfaceSweptLevels, true, true, includeOlderLevels, limitDailyRetouches)
    true

insertFocusHitLevel(array<FocusHitLevel> levels, FocusHitLevel candidate) =>
    int insertAt = array.size(levels)
    if array.size(levels) > 0
        for levelIndex = 0 to array.size(levels) - 1
            if candidate.price < array.get(levels, levelIndex).price
                insertAt := levelIndex
                break
    if insertAt >= array.size(levels)
        array.push(levels, candidate)
    else
        array.insert(levels, insertAt, candidate)
    true

addFocusHitLevel(array<FocusHitLevel> levels, revelioCore.Profile profile, float levelPrice, int breachTime, int nextProfileFinalizedTime, int autoGraceEndTime, revelioCore.AutoSweptState autoState, revelioCore.AutoSweptLevel autoLevel, bool sweptLevel, bool surfaceSweptLevels, int sweptKeepMs, bool olderSweptEligible, bool limitDailyRetouches, string levelName, string sourceProfileKey) =>
    insertFocusHitLevel(levels, FocusHitLevel.new(profile, levelPrice, breachTime, nextProfileFinalizedTime, autoGraceEndTime, autoState, autoLevel, sweptLevel, surfaceSweptLevels, sweptKeepMs, olderSweptEligible, limitDailyRetouches, levelName, sourceProfileKey, levelHitKey(sourceProfileKey, levelName)))

collectFocusedHitLevels(RenderBudgetAnchor anchor, bool active, bool includeOlderLevels, bool limitDailyRetouches, array<FocusHitLevel> levels) =>
    if active and anchor.restrictToFocus and array.size(anchor.profiles) > 0
        int profileCount = array.size(anchor.profiles)
        bool limitAnchorRetouches = includeOlderLevels and limitDailyRetouches and (anchor.style.labelAnchor == LABEL_RTH_ANCHOR or anchor.style.labelAnchor == LABEL_GLOBEX_ANCHOR)
        for profileIndex = 0 to profileCount - 1
            if renderBudgetProfileAllowed(anchor, profileIndex)
                revelioCore.Profile profile = array.get(anchor.profiles, profileIndex)
                if profile.isValid and time > profile.endTime
                    string sourceProfileKey = levelHitSourceProfileKey(profile.startTime, profile.endTime, anchor.style)
                    int nextProfileFinalizedTime = profileIndex < profileCount - 1 ? array.get(anchor.profiles, profileIndex + 1).finalizedTime : na
                    bool sweptLevel = anchor.style.extensionMode == LEVEL_BREACH_SWEEP
                    if anchor.style.showPoc
                        bool pocOlderSweptEligible = includeOlderLevels and sweptLevel and not na(profile.pocBreachTime)
                        int pocAutoGraceEndTime = revelioCore.firstAutoSweptFinalizedAfter(anchor.autoSweptState, profile.pocBreachTime)
                        addFocusHitLevel(levels, profile, profile.pocPrice, profile.pocBreachTime, nextProfileFinalizedTime, pocAutoGraceEndTime, anchor.autoSweptState, revelioCore.AutoSweptLevel.poc, sweptLevel, anchor.surfaceSweptLevels, anchor.style.sweptKeepMs, pocOlderSweptEligible, limitAnchorRetouches, LABEL_POC, sourceProfileKey)
                    if anchor.style.showValueArea
                        bool vahOlderSweptEligible = includeOlderLevels and sweptLevel and not na(profile.valueAreaHighBreachTime)
                        bool valOlderSweptEligible = includeOlderLevels and sweptLevel and not na(profile.valueAreaLowBreachTime)
                        int vahAutoGraceEndTime = revelioCore.firstAutoSweptFinalizedAfter(anchor.autoSweptState, profile.valueAreaHighBreachTime)
                        int valAutoGraceEndTime = revelioCore.firstAutoSweptFinalizedAfter(anchor.autoSweptState, profile.valueAreaLowBreachTime)
                        addFocusHitLevel(levels, profile, profile.valueAreaHighPrice, profile.valueAreaHighBreachTime, nextProfileFinalizedTime, vahAutoGraceEndTime, anchor.autoSweptState, revelioCore.AutoSweptLevel.valueAreaHigh, sweptLevel, anchor.surfaceSweptLevels, anchor.style.sweptKeepMs, vahOlderSweptEligible, limitAnchorRetouches, LABEL_VAH, sourceProfileKey)
                        addFocusHitLevel(levels, profile, profile.valueAreaLowPrice, profile.valueAreaLowBreachTime, nextProfileFinalizedTime, valAutoGraceEndTime, anchor.autoSweptState, revelioCore.AutoSweptLevel.valueAreaLow, sweptLevel, anchor.surfaceSweptLevels, anchor.style.sweptKeepMs, valOlderSweptEligible, limitAnchorRetouches, LABEL_VAL, sourceProfileKey)
                    if anchor.style.showAlternatePoc and profile.hasAlternatePoc
                        bool alternateOlderSweptEligible = includeOlderLevels and sweptLevel and not na(profile.alternatePocBreachTime)
                        int alternateAutoGraceEndTime = revelioCore.firstAutoSweptFinalizedAfter(anchor.autoSweptState, profile.alternatePocBreachTime)
                        addFocusHitLevel(levels, profile, profile.alternatePocPrice, profile.alternatePocBreachTime, nextProfileFinalizedTime, alternateAutoGraceEndTime, anchor.autoSweptState, revelioCore.AutoSweptLevel.alternatePoc, sweptLevel, anchor.surfaceSweptLevels, anchor.style.sweptKeepMs, alternateOlderSweptEligible, limitAnchorRetouches, LABEL_ALTERNATE_POC, sourceProfileKey)
    true

focusedHitLevelsKey(array<FocusHitLevel> levels) =>
    string key = ""
    if array.size(levels) > 0
        for levelIndex = 0 to array.size(levels) - 1
            FocusHitLevel level = array.get(levels, levelIndex)
            key += "|" + level.key
            if autoSweptLines
                key += ":" + str.tostring(level.autoSweptState.revision)
    key

firstFocusHitLevelAtOrAbove(array<FocusHitLevel> levels, float price) =>
    int leftIndex = 0
    int rightIndex = array.size(levels)
    while leftIndex < rightIndex
        int middleIndex = int(math.floor((leftIndex + rightIndex) / 2))
        if array.get(levels, middleIndex).price < price
            leftIndex := middleIndex + 1
        else
            rightIndex := middleIndex
    leftIndex

profileLastBreachAtTime(revelioCore.Profile profile, int rangeTime) =>
    int latestBreachTime = not na(profile.pocBreachTime) and profile.pocBreachTime < rangeTime ? profile.pocBreachTime : na
    latestBreachTime := not na(profile.valueAreaHighBreachTime) and profile.valueAreaHighBreachTime < rangeTime ? maxBreachTime(latestBreachTime, profile.valueAreaHighBreachTime) : latestBreachTime
    latestBreachTime := not na(profile.valueAreaLowBreachTime) and profile.valueAreaLowBreachTime < rangeTime ? maxBreachTime(latestBreachTime, profile.valueAreaLowBreachTime) : latestBreachTime
    latestBreachTime := profile.hasAlternatePoc and not na(profile.alternatePocBreachTime) and profile.alternatePocBreachTime < rangeTime ? maxBreachTime(latestBreachTime, profile.alternatePocBreachTime) : latestBreachTime
    latestBreachTime

focusHitLevelVisibleAtTime(FocusHitLevel level, int rangeTime, int chartBarTime, bool useUtcCalendar) =>
    bool beforeBreach = na(level.breachTime) or rangeTime <= level.breachTime
    bool visible = beforeBreach
    if not beforeBreach and level.sweptLevel
        if autoSweptLines
            bool graceActive = na(level.autoGraceEndTime) or chartBarTime <= level.autoGraceEndTime
            int cycleSerial = autoSweptCycleSerial(rangeTime, useUtcCalendar)
            bool selectedAtTime = revelioCore.autoSweptSelectedAtTime(level.autoSweptState, level.profile.startTime, level.profile.endTime, level.autoSweptLevel, cycleSerial, rangeTime)
            int lastBreachTime = profileLastBreachAtTime(level.profile, rangeTime)
            bool withinSweptKeep = not na(lastBreachTime) and rangeTime - lastBreachTime <= level.sweptKeepMs
            visible := level.surfaceSweptLevels or graceActive or withinSweptKeep or selectedAtTime
        else
            bool mostRecentAtTime = na(level.nextProfileFinalizedTime) or rangeTime < level.nextProfileFinalizedTime
            int lastBreachTime = profileLastBreachAtTime(level.profile, rangeTime)
            bool withinSweptKeep = not na(lastBreachTime) and rangeTime - lastBreachTime <= level.sweptKeepMs
            visible := level.surfaceSweptLevels or mostRecentAtTime or withinSweptKeep
    visible

focusHitLevelPreviousTime(FocusHitLevel level) =>
    level.levelName == LABEL_POC ? level.profile.pocHitTime : level.levelName == LABEL_VAH ? level.profile.valueAreaHighHitTime : level.levelName == LABEL_VAL ? level.profile.valueAreaLowHitTime : level.profile.alternatePocHitTime

setFocusHitLevelTime(FocusHitLevel level, int hitTime) =>
    if level.levelName == LABEL_POC
        level.profile.pocHitTime := hitTime
    else if level.levelName == LABEL_VAH
        level.profile.valueAreaHighHitTime := hitTime
    else if level.levelName == LABEL_VAL
        level.profile.valueAreaLowHitTime := hitTime
    else
        level.profile.alternatePocHitTime := hitTime
    true

focusHitLevelDailyTouchConsumed(FocusHitLevel level) =>
    level.levelName == LABEL_POC ? level.profile.pocDailyTouchConsumed : level.levelName == LABEL_VAH ? level.profile.valueAreaHighDailyTouchConsumed : level.levelName == LABEL_VAL ? level.profile.valueAreaLowDailyTouchConsumed : level.profile.alternatePocDailyTouchConsumed

setFocusHitLevelDailyTouchConsumed(FocusHitLevel level) =>
    if level.levelName == LABEL_POC
        level.profile.pocDailyTouchConsumed := true
    else if level.levelName == LABEL_VAH
        level.profile.valueAreaHighDailyTouchConsumed := true
    else if level.levelName == LABEL_VAL
        level.profile.valueAreaLowDailyTouchConsumed := true
    else
        level.profile.alternatePocDailyTouchConsumed := true
    true

levelHitDateKey(string key, int hitTime) =>
    key + "|" + str.tostring(calendarDateSerial(hitTime, NY_TIMEZONE))

backfillFocusedLevelHitTrace(array<FocusHitLevel> levels, array<LevelHitRange> ranges, array<revelioInteractions.LevelHitEvent> events, bool tracePresentationActive, bool useUtcCalendar) =>
    int levelCount = array.size(levels)
    if tracePresentationActive and levelCount > 0 and array.size(ranges) > 0
        map<string, bool> markedDateKeys = map.new<string, bool>()
        if array.size(events) > 0
            for eventIndex = 0 to array.size(events) - 1
                revelioInteractions.LevelHitEvent hitEvent = array.get(events, eventIndex)
                map.put(markedDateKeys, levelHitDateKey(hitEvent.key, hitEvent.hitTime), true)
        for rangeIndex = 0 to array.size(ranges) - 1
            LevelHitRange hitRange = array.get(ranges, rangeIndex)
            if hitRange.barTime < time and levelHitTraceActive(hitRange.barTime, tracePresentationActive)
                int levelIndex = firstFocusHitLevelAtOrAbove(levels, hitRange.lowPrice)
                while levelIndex < levelCount
                    FocusHitLevel level = array.get(levels, levelIndex)
                    if level.price > hitRange.highPrice
                        break
                    string markedDateKey = levelHitDateKey(level.key, hitRange.barTime)
                    bool visibleAtTime = focusHitLevelVisibleAtTime(level, hitRange.barTime, hitRange.chartBarTime, useUtcCalendar)
                    bool olderTouch = level.olderSweptEligible and not visibleAtTime
                    bool dailyTouchBlocked = level.limitDailyRetouches and focusHitLevelDailyTouchConsumed(level)
                    bool activeAtTime = hitRange.barTime > level.profile.endTime and (visibleAtTime or olderTouch)
                    if activeAtTime and not dailyTouchBlocked and not map.contains(markedDateKeys, markedDateKey)
                        [markedTime, hitRecorded] = processLevelHitAtTime(level.price, focusHitLevelPreviousTime(level), level.sourceProfileKey, level.key, true, olderTouch, false, events, hitRange.highPrice, hitRange.lowPrice, hitRange.startPrice, hitRange.barTime, hitRange.contactTime, hitRange.chartBarTime, true)
                        setFocusHitLevelTime(level, markedTime)
                        if hitRecorded
                            if level.limitDailyRetouches
                                setFocusHitLevelDailyTouchConsumed(level)
                            map.put(markedDateKeys, markedDateKey, true)
                    levelIndex += 1
    true

registerFocusedLevelHitSourceProfiles(map<string, bool> retainedSourceProfiles, RenderBudgetAnchor anchor, bool active) =>
    if active and anchor.restrictToFocus and array.size(anchor.profiles) > 0
        for profileIndex = 0 to array.size(anchor.profiles) - 1
            if renderBudgetProfileAllowed(anchor, profileIndex)
                revelioCore.Profile profile = array.get(anchor.profiles, profileIndex)
                map.put(retainedSourceProfiles, levelHitSourceProfileKey(profile.startTime, profile.endTime, anchor.style), true)
    true

renderAnchor(RenderBudgetAnchor anchor, revelioCore.Profile liveProfile, bool developingProfileActive, bool showDeveloping, int histogramFromIndex, int lineFromIndex, bool touchLabelsActive, map<string, bool> archivedLevelHitKeys, map<string, bool> renderedLevelHitKeys) =>
    if anchor.levelsEnabled
        int profileCount = array.size(anchor.profiles)
        if profileCount > 0
            for profileIndex = 0 to profileCount - 1
                if renderBudgetProfileAllowed(anchor, profileIndex)
                    bool histogramAllowed = profileIndex >= histogramFromIndex
                    // Focused profiles draw whole or not at all.
                    bool focusWholeProfile = not anchor.restrictToFocus or not anchor.histogramEnabled or histogramAllowed
                    renderProfile(array.get(anchor.profiles, profileIndex), anchor, false, profileIndex == profileCount - 1, anchorSurfacesSweptLevels(anchor, profileIndex), false, histogramAllowed, profileIndex >= lineFromIndex and focusWholeProfile, touchLabelsActive, archivedLevelHitKeys, renderedLevelHitKeys)
        if showDeveloping and not na(liveProfile)
            renderProfile(liveProfile, anchor, developingProfileActive, false, false, true, true, true, false, archivedLevelHitKeys, renderedLevelHitKeys)

// ═══════════════════════════════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════════════════════════════
var array<revelioCore.Profile> valueGapSourceProfiles = array.new<revelioCore.Profile>()
var array<revelioGaps.ValueGap> valueGapRecords = array.new<revelioGaps.ValueGap>()
varip array<revelioInteractions.LevelHitEvent> levelHitEvents = array.new<revelioInteractions.LevelHitEvent>()
varip array<LevelHitRange> levelHitRanges = array.new<LevelHitRange>()
varip string focusedHitBackfillKey = ""
var map<string, bool> retainedLevelHitSourceProfiles = map.new<string, bool>()
var map<string, bool> renderedLevelHitKeys = map.new<string, bool>()
var map<string, revelioInteractions.LevelHitPresentation> levelHitPresentations = map.new<string, revelioInteractions.LevelHitPresentation>()
var map<string, int> levelHitLabelClusters = map.new<string, int>()
var map<int, int> levelHitFirstDirections = map.new<int, int>()
var map<string, bool> archivedLevelHitKeys = map.new<string, bool>()
var revelioCore.AnchorState rthState = revelioCore.newAnchorState(START_TIME_UNSET)
var revelioCore.AnchorState globexState = revelioCore.newAnchorState(START_TIME_UNSET)
var revelioCore.AnchorState weeklyState = revelioCore.newAnchorState(START_TIME_UNSET)
var revelioCore.AnchorState monthlyState = revelioCore.newAnchorState(START_TIME_UNSET)
var revelioCore.AnchorState quarterlyState = revelioCore.newAnchorState(START_TIME_UNSET)
var revelioCore.AutoSweptState rthAutoSweptState = revelioCore.newAutoSweptState()
var revelioCore.AutoSweptState globexAutoSweptState = revelioCore.newAutoSweptState()
var revelioCore.AutoSweptState weeklyAutoSweptState = revelioCore.newAutoSweptState()
var revelioCore.AutoSweptState monthlyAutoSweptState = revelioCore.newAutoSweptState()
var revelioCore.AutoSweptState quarterlyAutoSweptState = revelioCore.newAutoSweptState()
var revelioCore.AutoSweptPlan autoSweptPlan = revelioCore.newAutoSweptPlan(START_TIME_UNSET)

var revelioCore.MergeState rthMergeState = revelioCore.newMergeState(START_TIME_UNSET)
var revelioCore.MergeState globexMergeState = revelioCore.newMergeState(START_TIME_UNSET)
var revelioCore.MergeState weeklyMergeState = revelioCore.newMergeState(START_TIME_UNSET)
var revelioCore.MergeState monthlyMergeState = revelioCore.newMergeState(START_TIME_UNSET)

// ═══════════════════════════════════════════════════════════════════════════════
// STYLES
// ═══════════════════════════════════════════════════════════════════════════════
showActivePrices = quickPriceMode == PRICE_MODE_ACTIVE
useCustomPrices = quickPriceMode == PRICE_MODE_CUSTOM
effectiveRthShowPrice = showActivePrices or (useCustomPrices and rthShowPrice)
effectiveGlobexShowPrice = showActivePrices or (useCustomPrices and globexShowPrice)
effectiveWeeklyShowPrice = showActivePrices or (useCustomPrices and weeklyShowPrice)
effectiveMonthlyShowPrice = showActivePrices or (useCustomPrices and monthlyShowPrice)
effectiveQuarterlyShowPrice = showActivePrices or (useCustomPrices and quarterlyShowPrice)

var rthStyle = SessionStyle.new(rthExtensionMode, rthDimTouched, MITIGATED_LEVEL_FADE_PERCENT / 100.0, rthShowPoc, color.new(color.rgb(156, 39, 176), 0), 2, STYLE_DASHED, rthShowAlternatePoc, color.new(color.rgb(233, 30, 99), 0), 2, STYLE_DOTTED, rthShowValueArea, color.new(color.rgb(144, 191, 249), 0), color.new(color.rgb(73, 128, 216), 0), 2, STYLE_SOLID, rthShowHistogram, color.new(color.rgb(91, 156, 246), 75), color.new(color.rgb(184, 184, 184), 80), rthShowSessionBox, color.new(color.rgb(187, 217, 251), 90), effectiveRthShowPrice, color.new(color.rgb(249, 248, 248), 25), color.new(color.rgb(24, 72, 204), 20), color.new(color.rgb(123, 31, 162), 0), color.new(color.rgb(194, 24, 91), 0), LABEL_SIZE_SMALL, levelLabelOffset, rthDevelopingEnabled, color.new(color.rgb(184, 184, 184), 20), SWEPT_CONTINUATION_LINE_FADE_PERCENT / 100.0, RTH_SWEPT_CONTINUATION_WIDTH, rthSweptKeepDays * MS_PER_DAY, LABEL_RTH_ANCHOR, PERIOD_LABEL_DAY, false, LABEL_RTH_LIVE, LABEL_RTH_LAST, 2)
var globexStyle = SessionStyle.new(globexExtensionMode, globexDimTouched, MITIGATED_LEVEL_FADE_PERCENT / 100.0, globexShowPoc, color.new(color.rgb(186, 104, 200), 0), 1, STYLE_DASHED, globexShowAlternatePoc, color.new(color.rgb(233, 30, 99), 0), 1, STYLE_DOTTED, globexShowValueArea, color.new(color.rgb(128, 222, 234), 20), color.new(color.rgb(58, 204, 222), 15), 2, STYLE_SOLID, globexShowHistogram, color.new(color.rgb(178, 235, 242), 80), color.new(color.rgb(184, 184, 184), 80), globexShowSessionBox, color.new(color.rgb(178, 235, 242), 98), effectiveGlobexShowPrice, color.new(color.rgb(249, 248, 248), 25), color.new(color.rgb(0, 151, 167), 0), color.new(color.rgb(123, 31, 162), 0), color.new(color.rgb(194, 24, 91), 0), LABEL_SIZE_SMALL, levelLabelOffset, false, color.new(color.rgb(128, 222, 234), 20), SWEPT_CONTINUATION_LINE_FADE_PERCENT / 100.0, GLOBEX_SWEPT_CONTINUATION_WIDTH, globexSweptKeepDays * MS_PER_DAY, LABEL_GLOBEX_ANCHOR, PERIOD_LABEL_DAY, false, LABEL_GLOBEX_LIVE, LABEL_GLOBEX_LAST, 2)
var weeklyStyle = SessionStyle.new(weeklyExtensionMode, weeklyDimTouched, MITIGATED_LEVEL_FADE_PERCENT / 100.0, weeklyShowPoc, color.new(color.rgb(171, 71, 188), 0), 2, STYLE_DASHED, weeklyShowAlternatePoc, color.new(color.rgb(233, 30, 99), 0), 2, STYLE_DOTTED, weeklyShowValueArea, color.new(color.rgb(242, 54, 69), 20), color.new(color.rgb(242, 54, 69), 0), 2, STYLE_SOLID, weeklyShowHistogram, color.new(color.rgb(252, 203, 205), 70), color.new(color.rgb(184, 184, 184), 80), weeklyShowSessionBox, color.new(color.rgb(250, 161, 164), 95), effectiveWeeklyShowPrice, color.new(color.rgb(249, 248, 248), 25), color.new(color.rgb(230, 81, 0), 20), color.new(color.rgb(123, 31, 162), 0), color.new(color.rgb(194, 24, 91), 0), LABEL_SIZE_SMALL, levelLabelOffset, false, color.new(color.rgb(242, 54, 69), 20), SWEPT_CONTINUATION_LINE_FADE_PERCENT / 100.0, WEEKLY_SWEPT_CONTINUATION_WIDTH, weeklySweptKeepWeeks * MS_PER_WEEK, LABEL_WEEKLY_ANCHOR, PERIOD_LABEL_DAY, false, LABEL_WEEKLY_LIVE, LABEL_WEEKLY_LAST, 3)
var monthlyStyle = SessionStyle.new(monthlyExtensionMode, monthlyDimTouched, MITIGATED_LEVEL_FADE_PERCENT / 100.0, monthlyShowPoc, color.new(color.rgb(171, 71, 188), 0), 3, STYLE_DASHED, monthlyShowAlternatePoc, color.new(color.rgb(233, 30, 99), 0), 3, STYLE_DOTTED, monthlyShowValueArea, color.new(color.rgb(102, 187, 106), 20), color.new(color.rgb(76, 175, 80), 0), 3, STYLE_SOLID, monthlyShowHistogram, color.new(color.rgb(200, 230, 201), 75), color.new(color.rgb(184, 184, 184), 80), monthlyShowSessionBox, color.new(color.rgb(200, 230, 201), 95), effectiveMonthlyShowPrice, color.new(color.rgb(249, 248, 248), 25), color.new(color.rgb(56, 142, 60), 20), color.new(color.rgb(123, 31, 162), 0), color.new(color.rgb(194, 24, 91), 0), LABEL_SIZE_NORMAL, levelLabelOffset, false, color.new(color.rgb(102, 187, 106), 20), SWEPT_CONTINUATION_LINE_FADE_PERCENT / 100.0, MONTHLY_SWEPT_CONTINUATION_WIDTH, monthlySweptKeepMonths * MS_PER_MONTH, LABEL_MONTHLY_ANCHOR, PERIOD_LABEL_MONTH, false, LABEL_MONTHLY_LIVE, LABEL_MONTHLY_LAST, 4)
var quarterlyStyle = SessionStyle.new(quarterlyExtensionMode, quarterlyDimTouched, MITIGATED_LEVEL_FADE_PERCENT / 100.0, quarterlyShowPoc, color.new(color.rgb(171, 71, 188), 0), 4, STYLE_DASHED, quarterlyShowAlternatePoc, color.new(color.rgb(233, 30, 99), 0), 4, STYLE_DOTTED, quarterlyShowValueArea, color.new(color.rgb(255, 167, 38), 20), color.new(color.rgb(251, 140, 0), 0), 4, STYLE_SOLID, quarterlyShowHistogram, color.new(color.rgb(255, 224, 178), 75), color.new(color.rgb(184, 184, 184), 80), quarterlyShowSessionBox, color.new(color.rgb(255, 224, 178), 95), effectiveQuarterlyShowPrice, color.new(color.rgb(249, 248, 248), 25), color.new(color.rgb(239, 108, 0), 20), color.new(color.rgb(123, 31, 162), 0), color.new(color.rgb(194, 24, 91), 0), LABEL_SIZE_NORMAL, levelLabelOffset, false, color.new(color.rgb(255, 167, 38), 20), SWEPT_CONTINUATION_LINE_FADE_PERCENT / 100.0, QUARTERLY_SWEPT_CONTINUATION_WIDTH, quarterlySweptKeepQuarters * MS_PER_QUARTER, LABEL_QUARTERLY_ANCHOR, PERIOD_LABEL_QUARTER, false, LABEL_QUARTERLY_LIVE, LABEL_QUARTERLY_LAST, 5)

// ═══════════════════════════════════════════════════════════════════════════════
// QUICK FILTER
// ═══════════════════════════════════════════════════════════════════════════════
// Quick Filter membership is shared by input activation and runtime rendering.
levelHitTimeframeAllowed = chart.is_range or timeframe.in_seconds(timeframe.period) <= LEVEL_HIT_MAX_TIMEFRAME_SECONDS

valueGapsActive = valueGapsEnabled or isGapsFilter
rthGapsPreset = valueGapsActive and isGapsFilter and valueGapSourceIsRth
globexGapsPreset = valueGapsActive and isGapsFilter and not valueGapSourceIsRth

rthFilterEnabled = rthQuickFilterActive or rthGapsPreset or (isAll and rthEnabled)
globexFilterEnabled = globexQuickFilterActive or globexGapsPreset or (isAll and globexEnabled)
weeklyFilterEnabled = weeklyQuickFilterActive or (isAll and weeklyEnabled)
monthlyFilterEnabled = monthlyQuickFilterActive or (isAll and monthlyEnabled)
quarterlyFilterEnabled = quarterlyQuickFilterActive or (isAll and quarterlyEnabled)

// Deep history only for an anchor that actually draws.
rthProfilesToRetain = focusSelected and rthFilterEnabled ? FOCUS_SEARCH_DEPTH : rthEffectiveProfilesToShow
globexProfilesToRetain = focusSelected and globexFilterEnabled ? FOCUS_SEARCH_DEPTH : globexEffectiveProfilesToShow

// Hit Trace chooses eligible sources without owning anchor calculation.
levelHitUnselectedAnchorsActive = levelHitTraceEnabled and levelHitIncludeAllAnchors and levelHitTimeframeAllowed

// The gaps preset changes presentation only; it does not rewrite anchor controls.
rthEffectiveExtensionMode = rthGapsPreset ? LEVEL_BREACH_ANY : rthExtensionMode
rthStyle.extensionMode := rthEffectiveExtensionMode
rthStyle.showPoc := not rthGapsPreset and rthShowPoc
rthStyle.showAlternatePoc := not rthGapsPreset and rthShowAlternatePoc
rthStyle.showValueArea := rthGapsPreset or rthShowValueArea

globexEffectiveExtensionMode = globexGapsPreset ? LEVEL_BREACH_ANY : globexExtensionMode
globexStyle.extensionMode := globexEffectiveExtensionMode
globexStyle.showPoc := not globexGapsPreset and globexShowPoc
globexStyle.showAlternatePoc := not globexGapsPreset and globexShowAlternatePoc
globexStyle.showValueArea := globexGapsPreset or globexShowValueArea

rthShowDeveloping     = isAll ? true : includeDevelopingRth
globexShowDeveloping  = isAll ? true : includeDevelopingGlobex

rthAutoSweptState.baselineKeepMs := rthStyle.sweptKeepMs
globexAutoSweptState.baselineKeepMs := globexStyle.sweptKeepMs
weeklyAutoSweptState.baselineKeepMs := weeklyStyle.sweptKeepMs
monthlyAutoSweptState.baselineKeepMs := monthlyStyle.sweptKeepMs
quarterlyAutoSweptState.baselineKeepMs := quarterlyStyle.sweptKeepMs
revelioCore.setAutoSweptSourceProfileLimit(rthAutoSweptState, rthEffectiveProfilesToShow)
revelioCore.setAutoSweptSourceProfileLimit(globexAutoSweptState, globexEffectiveProfilesToShow)
revelioCore.setAutoSweptSourceProfileLimit(weeklyAutoSweptState, weeklyProfilesToShow)
revelioCore.setAutoSweptSourceProfileLimit(monthlyAutoSweptState, monthlyProfilesToShow)
revelioCore.setAutoSweptSourceProfileLimit(quarterlyAutoSweptState, quarterlyProfilesToShow)

autoSweptPolicies() =>
    array<revelioCore.AutoSweptPolicy> policies = array.new<revelioCore.AutoSweptPolicy>()
    array.push(policies, revelioCore.newAutoSweptPolicy(rthAutoSweptState, rthFilterEnabled and rthStyle.extensionMode == LEVEL_BREACH_SWEEP, rthStyle.showPoc, rthStyle.showAlternatePoc, rthStyle.showValueArea, AUTO_SWEPT_RTH_ANCHOR_BIT, AUTO_SWEPT_DAILY_ANCHOR_PRIORITY, rthStyle.sweptKeepMs))
    array.push(policies, revelioCore.newAutoSweptPolicy(globexAutoSweptState, globexFilterEnabled and globexStyle.extensionMode == LEVEL_BREACH_SWEEP, globexStyle.showPoc, globexStyle.showAlternatePoc, globexStyle.showValueArea, AUTO_SWEPT_GLOBEX_ANCHOR_BIT, AUTO_SWEPT_DAILY_ANCHOR_PRIORITY, globexStyle.sweptKeepMs))
    array.push(policies, revelioCore.newAutoSweptPolicy(weeklyAutoSweptState, weeklyFilterEnabled and weeklyStyle.extensionMode == LEVEL_BREACH_SWEEP, weeklyStyle.showPoc, weeklyStyle.showAlternatePoc, weeklyStyle.showValueArea, AUTO_SWEPT_WEEKLY_ANCHOR_BIT, AUTO_SWEPT_WEEKLY_ANCHOR_PRIORITY, weeklyStyle.sweptKeepMs))
    array.push(policies, revelioCore.newAutoSweptPolicy(monthlyAutoSweptState, monthlyFilterEnabled and monthlyStyle.extensionMode == LEVEL_BREACH_SWEEP, monthlyStyle.showPoc, monthlyStyle.showAlternatePoc, monthlyStyle.showValueArea, AUTO_SWEPT_MONTHLY_ANCHOR_BIT, AUTO_SWEPT_MONTHLY_ANCHOR_PRIORITY, monthlyStyle.sweptKeepMs))
    array.push(policies, revelioCore.newAutoSweptPolicy(quarterlyAutoSweptState, quarterlyFilterEnabled and quarterlyStyle.extensionMode == LEVEL_BREACH_SWEEP, quarterlyStyle.showPoc, quarterlyStyle.showAlternatePoc, quarterlyStyle.showValueArea, AUTO_SWEPT_QUARTERLY_ANCHOR_BIT, AUTO_SWEPT_QUARTERLY_ANCHOR_PRIORITY, quarterlyStyle.sweptKeepMs))
    policies

// ═══════════════════════════════════════════════════════════════════════════════
// DATA & BOUNDARIES
// ═══════════════════════════════════════════════════════════════════════════════
intrabarTimeframe = autoIntrabarTimeframe()
[intrabarOpens, intrabarHighs, intrabarLows, intrabarVolumes, intrabarTimes] = request.security_lower_tf(syminfo.tickerid, intrabarTimeframe, [open, high, low, volume, time], ignore_invalid_timeframe=true)

// Weekend bars distinguish 24/7 assets from session-based instruments.
if not assetClassificationReady
    if syminfo.type == "crypto"
        isTwentyFourSevenAsset := true
        assetClassificationReady := true
    else if isTrueWeekendBar(time)
        isTwentyFourSevenAsset := true
        assetClassificationReady := true
    else
        int barsInWeek = math.max(1, int(math.ceil(SECONDS_PER_WEEK / timeframe.in_seconds(timeframe.period))))
        int observationWindow = math.min(ASSET_DETECTION_MAX_LOOKBACK, barsInWeek)
        if bar_index >= observationWindow
            isTwentyFourSevenAsset := false
            assetClassificationReady := true

// Select the RTH day mask by asset class; time() requires constant session strings.
rthInSessionWeekday = not na(time(timeframe.period, RTH_SESSION, NY_TIMEZONE))
rthInSessionAllDays = not na(time(timeframe.period, RTH_SESSION_ALL_DAYS, NY_TIMEZONE))
rthInSession = isTwentyFourSevenAsset ? rthInSessionAllDays : rthInSessionWeekday
rthSessionStart = rthInSession and not rthInSession[1]
rthSessionEnd = not rthInSession and rthInSession[1]

// Continuous anchors use the NY calendar for futures and UTC for 24/7 assets.
useUtcCalendarAnchors = isTwentyFourSevenAsset
globexStyle.useUtcLabelTimezone := useUtcCalendarAnchors
weeklyStyle.useUtcLabelTimezone := useUtcCalendarAnchors
monthlyStyle.useUtcLabelTimezone := useUtcCalendarAnchors
quarterlyStyle.useUtcLabelTimezone := useUtcCalendarAnchors
utcDayStart = calendarDayStart(UTC_TIMEZONE)
futuresGlobexStart = shiftedCalendarDayStart(NY_TIMEZONE, GLOBEX_REOPEN_SHIFT_MS)
globexDayStart = selectAssetCalendarStart(useUtcCalendarAnchors, utcDayStart, futuresGlobexStart)
utcWeekStart = calendarWeekStart(UTC_TIMEZONE)
weeklyReopenInSession = not na(time(timeframe.period, WEEKLY_REOPEN_SESSION, NY_TIMEZONE))
futuresWeekStart = weeklyReopenInSession and not weeklyReopenInSession[1] and dayofweek(time, NY_TIMEZONE) == dayofweek.sunday
weeklyPeriodStart = selectAssetCalendarStart(useUtcCalendarAnchors, utcWeekStart, futuresWeekStart)
utcMonthStart = calendarMonthStart(UTC_TIMEZONE)
nyMonthStart = calendarMonthStart(NY_TIMEZONE)
monthlyPeriodStart = selectAssetCalendarStart(useUtcCalendarAnchors, utcMonthStart, nyMonthStart)
utcQuarterStart = calendarQuarterStart(UTC_TIMEZONE)
nyQuarterStart = calendarQuarterStart(NY_TIMEZONE)
quarterlyPeriodStart = selectAssetCalendarStart(useUtcCalendarAnchors, utcQuarterStart, nyQuarterStart)

// Carry the latest 15m developing snapshot onto each lower-timeframe host bar.
[quarterlySnapshotStartTime, quarterlySnapshotEndTime, quarterlySnapshotPriceLow, quarterlySnapshotPriceHigh, quarterlySnapshotPocPrice, quarterlySnapshotValueAreaHighPrice, quarterlySnapshotValueAreaLowPrice, quarterlySnapshotHasAlternatePoc, quarterlySnapshotAlternatePocPrice, quarterlyHistogramSnapshot, quarterlyDevelopingSnapshot, requestedQuarterlyShowDeveloping] = request.security(syminfo.tickerid, QUARTERLY_CALCULATION_TIMEFRAME, fixedQuarterlyContext(true, quarterlyFilterEnabled, useUtcCalendarAnchors, quarterlyFilterEnabled and quarterlyShowHistogram), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, calc_bars_count=QUARTERLY_CALCULATION_BARS)
int quarterlyProfileIndex = revelioCore.profileIndexByStart(quarterlyState.profiles, quarterlySnapshotStartTime, START_TIME_UNSET)
bool quarterlyProfileAdded = quarterlySnapshotStartTime != START_TIME_UNSET and quarterlyProfileIndex < 0
if quarterlySnapshotStartTime != START_TIME_UNSET
    if quarterlyProfileIndex < 0
        if autoSweptLines
            revelioCore.syncAutoSweptArchive(quarterlyAutoSweptState, quarterlyState.profiles, quarterlyFilterEnabled and quarterlyStyle.extensionMode == LEVEL_BREACH_SWEEP, AUTO_SWEPT_ARCHIVE_PROFILES)
        revelioCore.Profile quarterlyProfile = revelioCore.newRemoteProfile(quarterlySnapshotStartTime, quarterlySnapshotEndTime, quarterlySnapshotPriceLow, quarterlySnapshotPriceHigh, quarterlySnapshotPocPrice, quarterlySnapshotValueAreaHighPrice, quarterlySnapshotValueAreaLowPrice, quarterlySnapshotHasAlternatePoc, quarterlySnapshotAlternatePocPrice)
        quarterlyProfileIndex := revelioCore.storeProfile(quarterlyState, quarterlyProfile, quarterlyProfilesToShow, time)
    revelioCore.Profile quarterlyStoredProfile = array.get(quarterlyState.profiles, quarterlyProfileIndex)
    if not na(quarterlyHistogramSnapshot) and quarterlyHistogramSnapshot.maxHistogramVolume > 0 and quarterlyStoredProfile.maxHistogramVolume <= 0
        revelioCore.syncProfileHistogram(quarterlyStoredProfile, quarterlyHistogramSnapshot)

// Count completed sessions before exposing a mature profile.
maturitySessionComplete = useUtcCalendarAnchors ? utcDayStart : rthSessionEnd
var revelioCore.MaturityState weeklyMaturityState = revelioCore.newMaturityState()
var revelioCore.MaturityState monthlyMaturityState = revelioCore.newMaturityState()
revelioCore.advanceMaturityState(weeklyMaturityState, weeklyState, weeklyPeriodStart, maturitySessionComplete, WEEKLY_MATURITY_HISTORY, PROFILE_ROWS, VALUE_AREA_PERCENT, syminfo.mintick, MATURITY_STABILITY_FRACTION)
revelioCore.advanceMaturityState(monthlyMaturityState, monthlyState, monthlyPeriodStart, maturitySessionComplete, MONTHLY_MATURITY_HISTORY, PROFILE_ROWS, VALUE_AREA_PERCENT, syminfo.mintick, MATURITY_STABILITY_FRACTION)

// Auto maturity uses anchor-specific history floors and a 45% completed-volume threshold.
weeklyShowDeveloping = revelioCore.maturityShowsDeveloping(weeklyMaturityState, weeklyState, weeklyCurrentMode == CURRENT_ON, weeklyCurrentMode == CURRENT_AUTO, useUtcCalendarAnchors ? WEEKLY_UTC_MATURITY_SESSIONS : WEEKLY_MARKET_MATURITY_SESSIONS, WEEKLY_EARLY_MATURITY_SESSIONS, MATURITY_EARLY_VOLUME_THRESHOLD_PERCENT, barstate.islast)
monthlyShowDeveloping = revelioCore.maturityShowsDeveloping(monthlyMaturityState, monthlyState, monthlyCurrentMode == CURRENT_ON, monthlyCurrentMode == CURRENT_AUTO, useUtcCalendarAnchors ? MONTHLY_UTC_MATURITY_SESSIONS : MONTHLY_MARKET_MATURITY_SESSIONS, useUtcCalendarAnchors ? MONTHLY_UTC_EARLY_MATURITY_SESSIONS : MONTHLY_MARKET_EARLY_MATURITY_SESSIONS, MATURITY_EARLY_VOLUME_THRESHOLD_PERCENT, barstate.islast)
quarterlyShowDeveloping = quarterlyFilterEnabled and (quarterlyCurrentMode == CURRENT_ON or (quarterlyCurrentMode == CURRENT_AUTO and requestedQuarterlyShowDeveloping == 1))
// Preserve the latest valid 15m snapshot between requested-context updates.
var revelioCore.Profile quarterlyDevelopingCache = na
if not quarterlyFilterEnabled or quarterlyPeriodStart or not quarterlyShowDeveloping
    quarterlyDevelopingCache := na
if quarterlyFilterEnabled and quarterlyShowDeveloping and not quarterlyPeriodStart and not na(quarterlyDevelopingSnapshot)
    quarterlyDevelopingCache := quarterlyDevelopingSnapshot

// Show Only keeps one recurring NY-time window visible.
inVisibleOvernight = not na(time(timeframe.period, SESSION_WINDOW_OVERNIGHT, NY_TIMEZONE))
inVisibleFrom0500 = not na(time(timeframe.period, SESSION_WINDOW_FROM_0500, NY_TIMEZONE))
inVisibleFrom0830 = not na(time(timeframe.period, SESSION_WINDOW_FROM_0830, NY_TIMEZONE))
inVisibleRth = not na(time(timeframe.period, SESSION_WINDOW_RTH, NY_TIMEZONE))
inVisibleWindow = visibleWindow == WINDOW_LABEL_FROM_0500 ? inVisibleFrom0500 : visibleWindow == WINDOW_LABEL_FROM_0830 ? inVisibleFrom0830 : visibleWindow == WINDOW_LABEL_RTH ? inVisibleRth : inVisibleOvernight
// Most Recent Only keeps the selected window on the current NY date.
inMostRecentDay = sameCalendarDate(time, timenow, NY_TIMEZONE)
hideThisBar = showOnlyEnabled and not (inVisibleWindow and (not showOnlyMostRecent or inMostRecentDay))

showPanePriceCandles = secondaryPaneMode and showPriceCandlesInPane
paneBodyColor = close >= open ? paneUpBodyColor : paneDownBodyColor
paneBorderColor = close >= open ? paneUpBorderColor : paneDownBorderColor
paneWickColor = close >= open ? paneUpWickColor : paneDownWickColor
hideMainChartCandle = not secondaryPaneMode and hideThisBar
hidePaneCandle = showPanePriceCandles and hideThisBar

plotcandle(showPanePriceCandles ? open : na, high, low, close, title="Pane Price Candles", color=paneBodyColor, bordercolor=paneBorderColor, wickcolor=paneWickColor, editable=false, display=display.pane)
plotcandle(hidePaneCandle ? open : na, high, low, close, title="Pane Hidden Candles", color=hiddenCandleColor, bordercolor=hiddenCandleColor, wickcolor=hiddenCandleColor, editable=false, display=display.pane)
plotcandle(hideMainChartCandle ? open : na, high, low, close, title="Hidden Candles", color=hiddenCandleColor, bordercolor=hiddenCandleColor, wickcolor=hiddenCandleColor, editable=false, display=display.pane, force_overlay=true)

addColorReferenceRow(table tbl, int row, string name, color clr) =>
    table.cell(tbl, 0, row, name, text_size=size.small, text_color=color.black)
    table.cell(tbl, 1, row, str.format("R:{0} G:{1} B:{2}", int(color.r(clr)), int(color.g(clr)), int(color.b(clr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 2, row, str.tostring(int(color.t(clr))), text_size=size.small, text_color=color.black)

if showColorTable and barstate.islast
    var table colorTable = table.new(position.top_right, 3, 8, bgcolor=color.white, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)
    table.cell(colorTable, 0, 0, "Setting", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 1, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 2, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    addColorReferenceRow(colorTable, 1, "Hidden Candles", hiddenCandleColor)
    addColorReferenceRow(colorTable, 2, "Up Body", paneUpBodyColor)
    addColorReferenceRow(colorTable, 3, "Down Body", paneDownBodyColor)
    addColorReferenceRow(colorTable, 4, "Up Border", paneUpBorderColor)
    addColorReferenceRow(colorTable, 5, "Down Border", paneDownBorderColor)
    addColorReferenceRow(colorTable, 6, "Up Wick", paneUpWickColor)
    addColorReferenceRow(colorTable, 7, "Down Wick", paneDownWickColor)

// ═══════════════════════════════════════════════════════════════════════════════
// PROCESS
// ═══════════════════════════════════════════════════════════════════════════════
levelHitDetectionEnabled = levelHitTraceEnabled and levelHitTimeframeAllowed
levelHitWindowStartMinute = levelHitDetectionStartMinute()
levelHitFallbackWindow = levelHitDetectionWindow == WINDOW_LABEL_FROM_0500 ? inVisibleFrom0500 : levelHitDetectionWindow == WINDOW_LABEL_FROM_0830 ? inVisibleFrom0830 : rthInSession
rthEligibleRangeRequested = valueGapsActive and valueGapFillWindow == WINDOW_LABEL_RTH
rthEligibleRangeNeeded = rthEligibleRangeRequested and priceWindowMayContainEligiblePrice(RTH_START_MINUTE, intrabarTimes, isTwentyFourSevenAsset, rthInSession)
float rthEligibleHigh = na
float rthEligibleLow = na
if rthEligibleRangeNeeded
    [calculatedRthHigh, calculatedRthLow] = priceWindowRange(RTH_START_MINUTE, intrabarHighs, intrabarLows, intrabarTimes, isTwentyFourSevenAsset, rthInSession)
    rthEligibleHigh := calculatedRthHigh
    rthEligibleLow := calculatedRthLow

array.clear(levelHitContactHighs)
array.clear(levelHitContactLows)
array.clear(levelHitContactStarts)
array.clear(levelHitContactTimes)
bool levelHitWindowActiveNow = false
if levelHitDetectionEnabled
    bool marketClockUpdate = levelHitUsesMarketClock()
    if marketClockUpdate
        int updateTime = timenow
        if nyPriceWindowTimestampEligible(updateTime, levelHitWindowStartMinute, isTwentyFourSevenAsset) and not na(close)
            levelHitWindowActiveNow := true
            if nyPriceWindowTimestampEligible(time, levelHitWindowStartMinute, isTwentyFourSevenAsset)
                if time != liveCoveredBarTime
                    array.push(levelHitContactHighs, high)
                    array.push(levelHitContactLows, low)
                    array.push(levelHitContactStarts, open)
                    array.push(levelHitContactTimes, updateTime)
                    livePreviousClose := close
                    liveCoveredBarTime := time
                else
                    array.push(levelHitContactHighs, math.max(livePreviousClose, close))
                    array.push(levelHitContactLows, math.min(livePreviousClose, close))
                    array.push(levelHitContactStarts, livePreviousClose)
                    array.push(levelHitContactTimes, updateTime)
                    livePreviousClose := close
            else
                // The bar opened before the window, so only the in-window tick price itself counts.
                array.push(levelHitContactHighs, close)
                array.push(levelHitContactLows, close)
                array.push(levelHitContactStarts, close)
                array.push(levelHitContactTimes, updateTime)
                livePreviousClose := close
                liveCoveredBarTime := time
    else if priceWindowMayContainEligiblePrice(levelHitWindowStartMinute, intrabarTimes, isTwentyFourSevenAsset, levelHitFallbackWindow)
        int hitIntrabarCount = array.size(intrabarTimes)
        if hitIntrabarCount > 0
            for intrabarIndex = 0 to hitIntrabarCount - 1
                int subTime = array.get(intrabarTimes, intrabarIndex)
                if nyPriceWindowTimestampEligible(subTime, levelHitWindowStartMinute, isTwentyFourSevenAsset)
                    float subHigh = array.get(intrabarHighs, intrabarIndex)
                    float subLow = array.get(intrabarLows, intrabarIndex)
                    float subOpen = array.get(intrabarOpens, intrabarIndex)
                    if not na(subHigh) and not na(subLow)
                        array.push(levelHitContactHighs, subHigh)
                        array.push(levelHitContactLows, subLow)
                        array.push(levelHitContactStarts, subOpen)
                        array.push(levelHitContactTimes, subTime)
        else if not na(high) and not na(low)
            array.push(levelHitContactHighs, high)
            array.push(levelHitContactLows, low)
            array.push(levelHitContactStarts, open)
            array.push(levelHitContactTimes, time)
        levelHitWindowActiveNow := array.size(levelHitContactTimes) > 0

if valueGapsActive
    bool valueGapFallbackWindow = valueGapFillWindow == WINDOW_LABEL_FROM_0500 ? inVisibleFrom0500 : valueGapFillWindow == WINDOW_LABEL_FROM_0830 ? inVisibleFrom0830 : rthInSession
    float valueGapBreachHigh = valueGapFillWindow == WINDOW_LABEL_RTH ? rthEligibleHigh : na
    float valueGapBreachLow = valueGapFillWindow == WINDOW_LABEL_RTH ? rthEligibleLow : na
    if valueGapFillWindow != WINDOW_LABEL_RTH
        bool valueGapRangeNeeded = fillRangeMayContainEligiblePrice(valueGapFillWindow, intrabarTimes, isTwentyFourSevenAsset, valueGapFallbackWindow)
        if valueGapRangeNeeded
            [calculatedGapHigh, calculatedGapLow] = valueGapFillRange(valueGapFillWindow, intrabarHighs, intrabarLows, intrabarTimes, isTwentyFourSevenAsset, valueGapFallbackWindow)
            valueGapBreachHigh := calculatedGapHigh
            valueGapBreachLow := calculatedGapLow
    if not na(valueGapBreachHigh) and not na(valueGapBreachLow)
        revelioGaps.updatePriceFills(valueGapRecords, valueGapBreachHigh, valueGapBreachLow, time, valueGapTraversalFill)

float fallbackSampleHigh = high
float fallbackSampleLow = low
float fallbackSampleVolume = volume
float fallbackFlushHigh = na
float fallbackFlushLow = na
float fallbackFlushVolume = na
if fallbackBucketAggregationActive and barstate.isconfirmed
    bool fallbackBarNeeded = array.size(intrabarVolumes) == 0
    int barBucketId = time / FALLBACK_PARITY_BUCKET_MS
// A pending bucket is stale once HD data resumes or the bar belongs to a newer bucket.
    if not na(fallbackBucketVolume) and (not fallbackBarNeeded or barBucketId != fallbackBucketId)
        fallbackFlushHigh := fallbackBucketHigh
        fallbackFlushLow := fallbackBucketLow
        fallbackFlushVolume := fallbackBucketVolume
        fallbackBucketHigh := na
        fallbackBucketLow := na
        fallbackBucketVolume := na
        fallbackBucketId := -1
    if fallbackBarNeeded
        if not na(volume) and volume > 0 and not na(high) and not na(low)
            fallbackBucketHigh := na(fallbackBucketHigh) ? high : math.max(fallbackBucketHigh, high)
            fallbackBucketLow := na(fallbackBucketLow) ? low : math.min(fallbackBucketLow, low)
            fallbackBucketVolume := na(fallbackBucketVolume) ? volume : fallbackBucketVolume + volume
            fallbackBucketId := barBucketId
        if time_close % FALLBACK_PARITY_BUCKET_MS == 0 and not na(fallbackBucketVolume)
            fallbackSampleHigh := fallbackBucketHigh
            fallbackSampleLow := fallbackBucketLow
            fallbackSampleVolume := fallbackBucketVolume
            fallbackBucketHigh := na
            fallbackBucketLow := na
            fallbackBucketVolume := na
            fallbackBucketId := -1
        else
            fallbackSampleVolume := na

[preparedBarHighs, preparedBarLows, preparedBarVolumes] = revelioCore.prepareBarVolumeSamples(intrabarHighs, intrabarLows, intrabarVolumes, fallbackSampleHigh, fallbackSampleLow, fallbackSampleVolume, barstate.isconfirmed)
if not na(fallbackFlushVolume)
    array.insert(preparedBarHighs, 0, fallbackFlushHigh)
    array.insert(preparedBarLows, 0, fallbackFlushLow)
    array.insert(preparedBarVolumes, 0, fallbackFlushVolume)

// Policies are allocated once; per-bar calls pass only state, events and prepared samples.
var revelioCore.AnchorProcessPolicy rthProcessPolicy = newMergedAnchorProcessPolicy(rthProfilesToRetain, rthMergeMode, RTH_MERGE_SPAN_FRACTION, false, rthFilterEnabled and rthShowHistogram)
var revelioCore.AnchorProcessPolicy globexProcessPolicy = newMergedAnchorProcessPolicy(globexProfilesToRetain, globexMergeMode, GLOBEX_MERGE_SPAN_FRACTION, true, globexFilterEnabled and globexShowHistogram)
var revelioCore.AnchorProcessPolicy weeklyProcessPolicy = newCalendarAnchorProcessPolicy(weeklyProfilesToShow, weeklyFilterEnabled and weeklyShowHistogram, false)
var revelioCore.AnchorProcessPolicy monthlyProcessPolicy = newCalendarAnchorProcessPolicy(monthlyProfilesToShow, monthlyFilterEnabled and monthlyShowHistogram, false)

if autoSweptLines
    if rthSessionStart or rthSessionEnd
        revelioCore.syncAutoSweptArchive(rthAutoSweptState, rthState.profiles, rthFilterEnabled and rthStyle.extensionMode == LEVEL_BREACH_SWEEP, AUTO_SWEPT_ARCHIVE_PROFILES)
    if globexDayStart
        revelioCore.syncAutoSweptArchive(globexAutoSweptState, globexState.profiles, true, AUTO_SWEPT_ARCHIVE_PROFILES)
    if weeklyPeriodStart
        revelioCore.syncAutoSweptArchive(weeklyAutoSweptState, weeklyState.profiles, weeklyFilterEnabled and weeklyStyle.extensionMode == LEVEL_BREACH_SWEEP, AUTO_SWEPT_ARCHIVE_PROFILES)
    if monthlyPeriodStart
        revelioCore.syncAutoSweptArchive(monthlyAutoSweptState, monthlyState.profiles, monthlyFilterEnabled and monthlyStyle.extensionMode == LEVEL_BREACH_SWEEP, AUTO_SWEPT_ARCHIVE_PROFILES)

revelioCore.processAnchor(rthState, rthMergeState, rthProcessPolicy, true, rthInSession, rthSessionStart, rthSessionEnd, preparedBarHighs, preparedBarLows, preparedBarVolumes, barstate.isconfirmed, time, time[1], START_TIME_UNSET, PROFILE_ROWS, VALUE_AREA_PERCENT)
revelioCore.processAnchor(globexState, globexMergeState, globexProcessPolicy, true, true, globexDayStart, false, preparedBarHighs, preparedBarLows, preparedBarVolumes, barstate.isconfirmed, time, time[1], START_TIME_UNSET, PROFILE_ROWS, VALUE_AREA_PERCENT)
revelioCore.processAnchor(weeklyState, weeklyMergeState, weeklyProcessPolicy, true, true, weeklyPeriodStart, false, preparedBarHighs, preparedBarLows, preparedBarVolumes, barstate.isconfirmed, time, time[1], START_TIME_UNSET, PROFILE_ROWS, VALUE_AREA_PERCENT)
revelioCore.processAnchor(monthlyState, monthlyMergeState, monthlyProcessPolicy, true, true, monthlyPeriodStart, false, preparedBarHighs, preparedBarLows, preparedBarVolumes, barstate.isconfirmed, time, time[1], START_TIME_UNSET, PROFILE_ROWS, VALUE_AREA_PERCENT)

if autoSweptLines
    if rthSessionStart or rthSessionEnd
        revelioCore.syncAutoSweptArchive(rthAutoSweptState, rthState.profiles, rthFilterEnabled and rthStyle.extensionMode == LEVEL_BREACH_SWEEP, AUTO_SWEPT_ARCHIVE_PROFILES)
    if globexDayStart
        revelioCore.syncAutoSweptArchive(globexAutoSweptState, globexState.profiles, true, AUTO_SWEPT_ARCHIVE_PROFILES)
    if weeklyPeriodStart
        revelioCore.syncAutoSweptArchive(weeklyAutoSweptState, weeklyState.profiles, weeklyFilterEnabled and weeklyStyle.extensionMode == LEVEL_BREACH_SWEEP, AUTO_SWEPT_ARCHIVE_PROFILES)
    if monthlyPeriodStart
        revelioCore.syncAutoSweptArchive(monthlyAutoSweptState, monthlyState.profiles, monthlyFilterEnabled and monthlyStyle.extensionMode == LEVEL_BREACH_SWEEP, AUTO_SWEPT_ARCHIVE_PROFILES)
    if quarterlyProfileAdded
        revelioCore.syncAutoSweptArchive(quarterlyAutoSweptState, quarterlyState.profiles, quarterlyFilterEnabled and quarterlyStyle.extensionMode == LEVEL_BREACH_SWEEP, AUTO_SWEPT_ARCHIVE_PROFILES)
    if globexDayStart
        int autoSweptCycle = autoSweptCycleSerial(time, useUtcCalendarAnchors)
        float autoSweptAdr = revelioCore.autoSweptTrimmedAdr(globexAutoSweptState, AUTO_SWEPT_ADR_LOOKBACK, AUTO_SWEPT_ADR_MIN_TRIM_SAMPLES)
        array<revelioCore.AutoSweptPolicy> policies = autoSweptPolicies()
        revelioCore.selectAutoSweptPlan(autoSweptPlan, policies, autoSweptCycle, time, open, autoSweptAdr, false, AUTO_SWEPT_ENTRY_ADR_FRACTION, AUTO_SWEPT_EXIT_ADR_FRACTION, AUTO_SWEPT_EXPANSION_BUFFER_ADR_FRACTION, AUTO_SWEPT_CLUSTER_ADR_FRACTION, AUTO_SWEPT_CLUSTER_MINIMUM_TICKS, AUTO_SWEPT_MAX_EXTRA_ZONES, AUTO_SWEPT_MAX_EXTRA_LEVELS, AUTO_SWEPT_SELECTION_HISTORY_DAYS, syminfo.mintick)

if valueGapsActive
    revelioGaps.syncProfile(valueGapSourceIsRth ? rthState.profiles : globexState.profiles, valueGapSourceProfiles, valueGapRecords, syminfo.mintick, CONFIRMED_VALUE_GAP_MIN_PERCENT)

rthMitigationActive = rthEffectiveExtensionMode == LEVEL_BREACH_ANY or rthEffectiveExtensionMode == LEVEL_BREACH_SAME
globexMitigationActive = globexEffectiveExtensionMode == LEVEL_BREACH_ANY
weeklyMitigationActive = weeklyExtensionMode == LEVEL_BREACH_ANY
monthlyMitigationActive = monthlyExtensionMode == LEVEL_BREACH_ANY
quarterlyMitigationActive = quarterlyExtensionMode == LEVEL_BREACH_ANY
rthDevelopingProfileActive = rthFilterEnabled and rthInSession and rthDevelopingEnabled and isBeforeNyCutoff(rthDevelopingCutoffHour, rthDevelopingCutoffMinute)
rthSweepActive = rthEffectiveExtensionMode == LEVEL_BREACH_SWEEP
globexSweepActive = globexEffectiveExtensionMode == LEVEL_BREACH_SWEEP
weeklySweepActive = weeklyExtensionMode == LEVEL_BREACH_SWEEP
monthlySweepActive = monthlyExtensionMode == LEVEL_BREACH_SWEEP
quarterlySweepActive = quarterlyExtensionMode == LEVEL_BREACH_SWEEP
levelHitDetectionActive = levelHitDetectionEnabled and levelHitWindowActiveNow
levelHitTracePresentationActive = levelHitDetectionEnabled and (levelHitHistory != LEVEL_HIT_HISTORY_CURRENT_WINDOW or levelHitDetectionActive)
rthHitTraceSourceActive = levelHitDetectionEnabled and (rthFilterEnabled or levelHitUnselectedAnchorsActive) and rthEffectiveExtensionMode != LEVEL_PERIOD
globexHitTraceSourceActive = levelHitDetectionEnabled and (globexFilterEnabled or levelHitUnselectedAnchorsActive) and globexEffectiveExtensionMode != LEVEL_PERIOD
weeklyHitTraceSourceActive = levelHitDetectionEnabled and (weeklyFilterEnabled or levelHitUnselectedAnchorsActive) and weeklyExtensionMode != LEVEL_PERIOD
monthlyHitTraceSourceActive = levelHitDetectionEnabled and (monthlyFilterEnabled or levelHitUnselectedAnchorsActive) and monthlyExtensionMode != LEVEL_PERIOD
quarterlyHitTraceSourceActive = levelHitDetectionEnabled and (quarterlyFilterEnabled or levelHitUnselectedAnchorsActive) and quarterlyExtensionMode != LEVEL_PERIOD
rthFocusedHitTraceActive = focusHitTraceActive and rthHitTraceSourceActive
globexFocusedHitTraceActive = focusHitTraceActive and globexHitTraceSourceActive
recordLevelHitRanges(levelHitRanges, levelHitDetectionActive and (rthFocusedHitTraceActive or globexFocusedHitTraceActive), time, time)

int rthHitTraceFromIndex = hitTraceProfileFromIndex(rthState.profiles, focusSelected and rthFilterEnabled, rthEffectiveProfilesToShow)
int globexHitTraceFromIndex = hitTraceProfileFromIndex(globexState.profiles, focusSelected and globexFilterEnabled, globexEffectiveProfilesToShow)
updateLevelHitTrace(rthState.profiles, rthAutoSweptState, rthHitTraceFromIndex, levelHitDetectionActive and rthHitTraceSourceActive, rthFilterEnabled, levelHitIncludeOlderLevels, levelHitLimitDailyRetouches, rthStyle, levelHitEvents)
updateLevelHitTrace(globexState.profiles, globexAutoSweptState, globexHitTraceFromIndex, levelHitDetectionActive and globexHitTraceSourceActive, globexFilterEnabled, levelHitIncludeOlderLevels, levelHitLimitDailyRetouches, globexStyle, levelHitEvents)
updateLevelHitTrace(weeklyState.profiles, weeklyAutoSweptState, 0, levelHitDetectionActive and weeklyHitTraceSourceActive, weeklyFilterEnabled, levelHitIncludeOlderLevels, levelHitLimitDailyRetouches, weeklyStyle, levelHitEvents)
updateLevelHitTrace(monthlyState.profiles, monthlyAutoSweptState, 0, levelHitDetectionActive and monthlyHitTraceSourceActive, monthlyFilterEnabled, levelHitIncludeOlderLevels, levelHitLimitDailyRetouches, monthlyStyle, levelHitEvents)
updateLevelHitTrace(quarterlyState.profiles, quarterlyAutoSweptState, 0, levelHitDetectionActive and quarterlyHitTraceSourceActive, quarterlyFilterEnabled, levelHitIncludeOlderLevels, levelHitLimitDailyRetouches, quarterlyStyle, levelHitEvents)
updateAutoSweptArchiveHitTrace(rthState.profiles, rthAutoSweptState, levelHitDetectionActive and rthHitTraceSourceActive, rthFilterEnabled, levelHitIncludeOlderLevels, levelHitLimitDailyRetouches, rthStyle, levelHitEvents)
updateAutoSweptArchiveHitTrace(globexState.profiles, globexAutoSweptState, levelHitDetectionActive and globexHitTraceSourceActive, globexFilterEnabled, levelHitIncludeOlderLevels, levelHitLimitDailyRetouches, globexStyle, levelHitEvents)
updateAutoSweptArchiveHitTrace(weeklyState.profiles, weeklyAutoSweptState, levelHitDetectionActive and weeklyHitTraceSourceActive, weeklyFilterEnabled, levelHitIncludeOlderLevels, levelHitLimitDailyRetouches, weeklyStyle, levelHitEvents)
updateAutoSweptArchiveHitTrace(monthlyState.profiles, monthlyAutoSweptState, levelHitDetectionActive and monthlyHitTraceSourceActive, monthlyFilterEnabled, levelHitIncludeOlderLevels, levelHitLimitDailyRetouches, monthlyStyle, levelHitEvents)
updateAutoSweptArchiveHitTrace(quarterlyState.profiles, quarterlyAutoSweptState, levelHitDetectionActive and quarterlyHitTraceSourceActive, quarterlyFilterEnabled, levelHitIncludeOlderLevels, levelHitLimitDailyRetouches, quarterlyStyle, levelHitEvents)
if autoSweptLines and levelHitDetectionActive
    revelioCore.syncAutoSweptArchiveHits(rthAutoSweptState, rthState.profiles, rthFilterEnabled and rthStyle.extensionMode == LEVEL_BREACH_SWEEP)
    revelioCore.syncAutoSweptArchiveHits(globexAutoSweptState, globexState.profiles, globexFilterEnabled and globexStyle.extensionMode == LEVEL_BREACH_SWEEP)
    revelioCore.syncAutoSweptArchiveHits(weeklyAutoSweptState, weeklyState.profiles, weeklyFilterEnabled and weeklyStyle.extensionMode == LEVEL_BREACH_SWEEP)
    revelioCore.syncAutoSweptArchiveHits(monthlyAutoSweptState, monthlyState.profiles, monthlyFilterEnabled and monthlyStyle.extensionMode == LEVEL_BREACH_SWEEP)
    revelioCore.syncAutoSweptArchiveHits(quarterlyAutoSweptState, quarterlyState.profiles, quarterlyFilterEnabled and quarterlyStyle.extensionMode == LEVEL_BREACH_SWEEP)

if barstate.isconfirmed
    float sweepMarginFraction = SWEEP_CONFIRM_MARGIN_PERCENT / 100.0
    bool mitigationRangeNeeded = rthMitigationActive or globexMitigationActive or weeklyMitigationActive or monthlyMitigationActive or quarterlyMitigationActive
    float mitigationBreachHigh = mitigationRangeNeeded ? (array.size(intrabarHighs) > 0 ? array.max(intrabarHighs) : high) : na
    float mitigationBreachLow = mitigationRangeNeeded ? (array.size(intrabarLows) > 0 ? array.min(intrabarLows) : low) : na
    revelioCore.updateAnchorLevels(rthState, rthMitigationActive, rthEffectiveExtensionMode == LEVEL_BREACH_SAME, rthInSession, rthSweepActive, mitigationBreachHigh, mitigationBreachLow, sweepMarginFraction, close, time)
    revelioCore.updateAnchorLevels(globexState, globexMitigationActive, false, true, globexSweepActive, mitigationBreachHigh, mitigationBreachLow, sweepMarginFraction, close, time)
    revelioCore.updateAnchorLevels(weeklyState, weeklyMitigationActive, false, true, weeklySweepActive, mitigationBreachHigh, mitigationBreachLow, sweepMarginFraction, close, time)
    revelioCore.updateAnchorLevels(monthlyState, monthlyMitigationActive, false, true, monthlySweepActive, mitigationBreachHigh, mitigationBreachLow, sweepMarginFraction, close, time)
    revelioCore.updateAnchorLevels(quarterlyState, quarterlyMitigationActive, false, true, quarterlySweepActive, mitigationBreachHigh, mitigationBreachLow, sweepMarginFraction, close, time)
    if autoSweptLines
        int autoSweptActivationTime = barstate.isrealtime and chart.is_range and na(time_close) ? timenow : na(time_close) ? time : time_close
        revelioCore.updateAutoSweptArchive(rthAutoSweptState, rthSweepActive, sweepMarginFraction, close, time)
        revelioCore.updateAutoSweptArchive(globexAutoSweptState, globexSweepActive, sweepMarginFraction, close, time)
        revelioCore.updateAutoSweptArchive(weeklyAutoSweptState, weeklySweepActive, sweepMarginFraction, close, time)
        revelioCore.updateAutoSweptArchive(monthlyAutoSweptState, monthlySweepActive, sweepMarginFraction, close, time)
        revelioCore.updateAutoSweptArchive(quarterlyAutoSweptState, quarterlySweepActive, sweepMarginFraction, close, time)
        if revelioCore.autoSweptExpansionReady(autoSweptPlan, true, high, low, AUTO_SWEPT_EXPANSION_TRIGGER_ADR_FRACTION)
            int confirmedAutoSweptCycle = autoSweptCycleSerial(time, useUtcCalendarAnchors)
            array<revelioCore.AutoSweptPolicy> policies = autoSweptPolicies()
            revelioCore.selectAutoSweptPlan(autoSweptPlan, policies, confirmedAutoSweptCycle, autoSweptActivationTime, autoSweptPlan.cycleOpen, autoSweptPlan.adr, true, AUTO_SWEPT_ENTRY_ADR_FRACTION, AUTO_SWEPT_EXIT_ADR_FRACTION, AUTO_SWEPT_EXPANSION_BUFFER_ADR_FRACTION, AUTO_SWEPT_CLUSTER_ADR_FRACTION, AUTO_SWEPT_CLUSTER_MINIMUM_TICKS, AUTO_SWEPT_MAX_EXTRA_ZONES, AUTO_SWEPT_MAX_EXTRA_LEVELS, AUTO_SWEPT_SELECTION_HISTORY_DAYS, syminfo.mintick)

plot(autoSweptLines and autoSweptAudit ? autoSweptPlan.adr : na, title="Ⓐ ADR", editable=false, display=display.status_line + display.data_window)

// ═══════════════════════════════════════════════════════════════════════════════
// RENDER
// ═══════════════════════════════════════════════════════════════════════════════
if barstate.islast
    clearDrawings()
    map.clear(renderedLevelHitKeys)
    map.clear(levelHitPresentations)
    bool valueGapFloatingActive = valueGapsActive and valueGapDisplayMode != VALUE_GAP_DISPLAY_HISTORICAL
    bool valueGapHistoricalActive = valueGapsActive and valueGapDisplayMode != VALUE_GAP_DISPLAY_FLOATING
    // Globex is continuous: no session gate.
    bool upcomingValueGapActive = valueGapsActive and upcomingValueGapEnabled and (valueGapSourceIsRth ? rthInSession : true)
    bool useUtcValueGapLabels = not valueGapSourceIsRth and useUtcCalendarAnchors
    bool rthUpcomingSource = upcomingValueGapActive and valueGapSourceIsRth
    bool globexUpcomingSource = upcomingValueGapActive and not valueGapSourceIsRth
    revelioCore.Profile rthLiveProfile = na
    revelioCore.Profile globexLiveProfile = na
    revelioCore.Profile weeklyLiveProfile = na
    revelioCore.Profile monthlyLiveProfile = na
    revelioCore.Profile quarterlyLiveProfile = na
    if rthInSession and ((rthFilterEnabled and rthShowDeveloping) or rthUpcomingSource)
        rthLiveProfile := buildDevelopingAnchorProfile(rthState, intrabarHighs, intrabarLows, intrabarVolumes, rthFilterEnabled and rthShowHistogram)
    if ((globexFilterEnabled and globexShowDeveloping) or globexUpcomingSource) and array.size(globexState.barVolumes) > 0
        globexLiveProfile := buildDevelopingAnchorProfile(globexState, intrabarHighs, intrabarLows, intrabarVolumes, globexFilterEnabled and globexShowHistogram)
    if weeklyFilterEnabled and weeklyShowDeveloping and array.size(weeklyState.barVolumes) > 0
        weeklyLiveProfile := buildDevelopingAnchorProfile(weeklyState, intrabarHighs, intrabarLows, intrabarVolumes, weeklyShowHistogram)
    if monthlyFilterEnabled and monthlyShowDeveloping and array.size(monthlyState.barVolumes) > 0
        monthlyLiveProfile := buildDevelopingAnchorProfile(monthlyState, intrabarHighs, intrabarLows, intrabarVolumes, monthlyShowHistogram)
    if quarterlyFilterEnabled and quarterlyShowDeveloping and not na(quarterlyDevelopingCache)
        quarterlyLiveProfile := quarterlyDevelopingCache
    array<int> floatingValueGapIndices = revelioGaps.selectFloats(valueGapRecords, valueGapFloatingActive, valueGapNearestFloats, close)
    int historicalGapLimit = valueGapDisplayMode == VALUE_GAP_DISPLAY_RECENT_FLOATING ? 1 : valueGapsToShow
    renderValueGaps(valueGapRecords, valueGapHistoricalActive, floatingValueGapIndices, historicalGapLimit, useUtcValueGapLabels)
    if valueGapFloatingActive
        renderFloatingValueGaps(valueGapRecords, floatingValueGapIndices, useUtcValueGapLabels)
    renderUpcomingValueGap(valueGapSourceIsRth ? rthState.profiles : globexState.profiles, valueGapSourceIsRth ? rthLiveProfile : globexLiveProfile, upcomingValueGapActive, useUtcValueGapLabels)
    // Live profiles are the newest drawings, so their runs are reserved before completed profiles compete.
    bool rthHistogramActive = rthFilterEnabled and rthShowHistogram
    bool globexHistogramActive = globexFilterEnabled and globexShowHistogram
    bool weeklyHistogramActive = weeklyFilterEnabled and weeklyShowHistogram
    bool monthlyHistogramActive = monthlyFilterEnabled and monthlyShowHistogram
    bool quarterlyHistogramActive = quarterlyFilterEnabled and quarterlyShowHistogram
    bool focusActive = focusSelected and (rthFilterEnabled or globexFilterEnabled)
    float focusAnchor = focusAnchorPrice(focusAnchorMode, focusManualPrice, focusManualPricePlaced, close)
    bool focusManualAnchorVisible = focusActive and focusAnchorMode == FOCUS_ANCHOR_MANUAL
    renderFocusAnchor(focusManualAnchorVisible, focusAnchor, focusManualPricePlaced, color.new(color.rgb(242, 54, 69), 0), focusAnchorWidth, focusAnchorLabelOffset)
    int liveHistogramReserve = (rthHistogramActive and rthShowDeveloping and array.size(rthState.barVolumes) > 0 ? 3 : 0) + (globexHistogramActive and globexShowDeveloping and array.size(globexState.barVolumes) > 0 ? 3 : 0) + (weeklyHistogramActive and weeklyShowDeveloping and array.size(weeklyState.barVolumes) > 0 ? 3 : 0) + (monthlyHistogramActive and monthlyShowDeveloping and array.size(monthlyState.barVolumes) > 0 ? 3 : 0) + (quarterlyHistogramActive and quarterlyShowDeveloping and not na(quarterlyLiveProfile) ? 3 : 0)
    array<RenderBudgetAnchor> renderBudgetAnchors = array.new<RenderBudgetAnchor>()
    array.push(renderBudgetAnchors, RenderBudgetAnchor.new(rthState.profiles, rthAutoSweptState, rthStyle, rthFilterEnabled, rthHistogramActive, array.new<bool>(), array.new<int>(), array.new<int>(), focusActive and rthFilterEnabled, focusSurfaceSweptLevels))
    array.push(renderBudgetAnchors, RenderBudgetAnchor.new(globexState.profiles, globexAutoSweptState, globexStyle, globexFilterEnabled, globexHistogramActive, array.new<bool>(), array.new<int>(), array.new<int>(), focusActive and globexFilterEnabled, focusSurfaceSweptLevels))
    array.push(renderBudgetAnchors, RenderBudgetAnchor.new(weeklyState.profiles, weeklyAutoSweptState, weeklyStyle, weeklyFilterEnabled, weeklyHistogramActive, array.new<bool>(), array.new<int>(), array.new<int>(), false, false))
    array.push(renderBudgetAnchors, RenderBudgetAnchor.new(monthlyState.profiles, monthlyAutoSweptState, monthlyStyle, monthlyFilterEnabled, monthlyHistogramActive, array.new<bool>(), array.new<int>(), array.new<int>(), false, false))
    array.push(renderBudgetAnchors, RenderBudgetAnchor.new(quarterlyState.profiles, quarterlyAutoSweptState, quarterlyStyle, quarterlyFilterEnabled, quarterlyHistogramActive, array.new<bool>(), array.new<int>(), array.new<int>(), false, false))
    for anchorIndex = 0 to array.size(renderBudgetAnchors) - 1
        prepareAutoSweptVisibilityMasks(array.get(renderBudgetAnchors, anchorIndex))
    bool touchLabelsActive = levelHitShowLabels and levelHitDetectionActive
    registerAnchorLevelHitPresentations(levelHitPresentations, array.get(renderBudgetAnchors, 0), rthHitTraceFromIndex, rthHitTraceSourceActive, false, false)
    registerAnchorLevelHitPresentations(levelHitPresentations, array.get(renderBudgetAnchors, 1), globexHitTraceFromIndex, globexHitTraceSourceActive, false, false)
    registerAnchorLevelHitPresentations(levelHitPresentations, array.get(renderBudgetAnchors, 2), 0, weeklyHitTraceSourceActive, false, false)
    registerAnchorLevelHitPresentations(levelHitPresentations, array.get(renderBudgetAnchors, 3), 0, monthlyHitTraceSourceActive, false, false)
    registerAnchorLevelHitPresentations(levelHitPresentations, array.get(renderBudgetAnchors, 4), 0, quarterlyHitTraceSourceActive, false, false)
    registerAutoSweptArchivePresentations(levelHitPresentations, array.get(renderBudgetAnchors, 0), rthHitTraceSourceActive, levelHitIncludeOlderLevels, false)
    registerAutoSweptArchivePresentations(levelHitPresentations, array.get(renderBudgetAnchors, 1), globexHitTraceSourceActive, levelHitIncludeOlderLevels, false)
    registerAutoSweptArchivePresentations(levelHitPresentations, array.get(renderBudgetAnchors, 2), weeklyHitTraceSourceActive, levelHitIncludeOlderLevels, false)
    registerAutoSweptArchivePresentations(levelHitPresentations, array.get(renderBudgetAnchors, 3), monthlyHitTraceSourceActive, levelHitIncludeOlderLevels, false)
    registerAutoSweptArchivePresentations(levelHitPresentations, array.get(renderBudgetAnchors, 4), quarterlyHitTraceSourceActive, levelHitIncludeOlderLevels, false)
    // Retained sources are consumed only by last-bar event pruning.
    map.clear(retainedLevelHitSourceProfiles)
    registerLevelHitSourceProfiles(retainedLevelHitSourceProfiles, rthState.profiles, rthHitTraceFromIndex, rthHitTraceSourceActive, rthStyle)
    registerLevelHitSourceProfiles(retainedLevelHitSourceProfiles, globexState.profiles, globexHitTraceFromIndex, globexHitTraceSourceActive, globexStyle)
    registerLevelHitSourceProfiles(retainedLevelHitSourceProfiles, weeklyState.profiles, 0, weeklyHitTraceSourceActive, weeklyStyle)
    registerLevelHitSourceProfiles(retainedLevelHitSourceProfiles, monthlyState.profiles, 0, monthlyHitTraceSourceActive, monthlyStyle)
    registerLevelHitSourceProfiles(retainedLevelHitSourceProfiles, quarterlyState.profiles, 0, quarterlyHitTraceSourceActive, quarterlyStyle)
    registerAutoSweptArchiveSourceProfiles(retainedLevelHitSourceProfiles, rthAutoSweptState, rthHitTraceSourceActive, rthStyle)
    registerAutoSweptArchiveSourceProfiles(retainedLevelHitSourceProfiles, globexAutoSweptState, globexHitTraceSourceActive, globexStyle)
    registerAutoSweptArchiveSourceProfiles(retainedLevelHitSourceProfiles, weeklyAutoSweptState, weeklyHitTraceSourceActive, weeklyStyle)
    registerAutoSweptArchiveSourceProfiles(retainedLevelHitSourceProfiles, monthlyAutoSweptState, monthlyHitTraceSourceActive, monthlyStyle)
    registerAutoSweptArchiveSourceProfiles(retainedLevelHitSourceProfiles, quarterlyAutoSweptState, quarterlyHitTraceSourceActive, quarterlyStyle)
    if focusActive
        selectFocusedProfiles(renderBudgetAnchors, DAILY_PROFILE_ANCHOR_COUNT, focusAnchor, focusDirection, focusProfileCount)
        trimFocusToBudget(renderBudgetAnchors, DAILY_PROFILE_ANCHOR_COUNT, focusAnchor, focusDirection, INDICATOR_MAX_POLYLINES - liveHistogramReserve)
        registerFocusedLevelHitSourceProfiles(retainedLevelHitSourceProfiles, array.get(renderBudgetAnchors, 0), rthFocusedHitTraceActive)
        registerFocusedLevelHitSourceProfiles(retainedLevelHitSourceProfiles, array.get(renderBudgetAnchors, 1), globexFocusedHitTraceActive)
        registerAnchorLevelHitPresentations(levelHitPresentations, array.get(renderBudgetAnchors, 0), 0, rthFocusedHitTraceActive, true, focusSurfaceSweptLevels)
        registerAnchorLevelHitPresentations(levelHitPresentations, array.get(renderBudgetAnchors, 1), 0, globexFocusedHitTraceActive, true, focusSurfaceSweptLevels)
        registerAutoSweptArchivePresentations(levelHitPresentations, array.get(renderBudgetAnchors, 0), rthFocusedHitTraceActive, levelHitIncludeOlderLevels, true)
        registerAutoSweptArchivePresentations(levelHitPresentations, array.get(renderBudgetAnchors, 1), globexFocusedHitTraceActive, levelHitIncludeOlderLevels, true)
        array<FocusHitLevel> focusedHitLevels = array.new<FocusHitLevel>()
        collectFocusedHitLevels(array.get(renderBudgetAnchors, 0), rthFocusedHitTraceActive, levelHitIncludeOlderLevels, levelHitLimitDailyRetouches, focusedHitLevels)
        collectFocusedHitLevels(array.get(renderBudgetAnchors, 1), globexFocusedHitTraceActive, levelHitIncludeOlderLevels, levelHitLimitDailyRetouches, focusedHitLevels)
        string currentFocusedHitBackfillKey = focusedHitLevelsKey(focusedHitLevels)
        if levelHitTracePresentationActive and currentFocusedHitBackfillKey != focusedHitBackfillKey
            backfillFocusedLevelHitTrace(focusedHitLevels, levelHitRanges, levelHitEvents, true, useUtcCalendarAnchors)
            focusedHitBackfillKey := currentFocusedHitBackfillKey
        else if not levelHitTracePresentationActive
            focusedHitBackfillKey := ""
        updateFocusedLevelHitTrace(array.get(renderBudgetAnchors, 0), levelHitDetectionActive and rthFocusedHitTraceActive, levelHitIncludeOlderLevels, levelHitLimitDailyRetouches, levelHitEvents)
        updateFocusedLevelHitTrace(array.get(renderBudgetAnchors, 1), levelHitDetectionActive and globexFocusedHitTraceActive, levelHitIncludeOlderLevels, levelHitLimitDailyRetouches, levelHitEvents)
    else
        focusedHitBackfillKey := ""
    revelioInteractions.PresentationConfig interactionConfig = revelioInteractions.PresentationConfig.new(labelMergeDistancePercent, syminfo.mintick, INDICATOR_MAX_LABELS, LABEL_NAME_SEPARATOR, BRAND_BULLET, MERGED_LINE_FADE_PERCENT, LABEL_SIZE_TINY, LABEL_SIZE_NORMAL, LABEL_SIZE_LARGE, LABEL_SIZE_HUGE, ANCHOR_REMINDER_MIN_SPACING_MS, ANCHOR_REMINDER_MAX_PER_LEVEL, SWEPT_REMINDER_BASE_MS, SWEPT_REMINDER_MAX_PER_LINE, LABEL_ALTERNATE_POC, LABEL_VAH, LABEL_VAL, LEVEL_HIT_UNSELECTED_ANCHOR_SYMBOL, LEVEL_HIT_ARCHIVED_SYMBOL, LEVEL_HIT_FIRST_SYMBOL, LEVEL_HIT_FROM_ABOVE_SYMBOL, LEVEL_HIT_FROM_BELOW_SYMBOL, LEVEL_HIT_FROM_ABOVE_TEXT, LEVEL_HIT_FROM_BELOW_TEXT, NY_TIMEZONE, time, bar_index)
    revelioInteractions.HitTracePolicy interactionHitTracePolicy = revelioInteractions.HitTracePolicy.new(levelHitTracePresentationActive, levelHitHistory == LEVEL_HIT_HISTORY_CURRENT_WINDOW, levelHitRetentionDays(), levelHitReferenceDateSerial(), isTwentyFourSevenAsset, UTC_TIMEZONE, MS_PER_DAY, MAX_LEVEL_HIT_TRADING_DAY_SCAN, MAX_LEVEL_HIT_WEEKDAY_RETENTION_DAYS)
    revelioInteractions.pruneLevelHitEvents(levelHitEvents, retainedLevelHitSourceProfiles, interactionConfig, interactionHitTracePolicy)
    array<int> histogramFromIndices = allocateProfileBudget(renderBudgetAnchors, INDICATOR_MAX_POLYLINES - liveHistogramReserve, true)
    int liveLineReserve = liveProfileLineCount(rthLiveProfile, rthFilterEnabled and rthShowDeveloping, array.get(renderBudgetAnchors, 0)) + liveProfileLineCount(globexLiveProfile, globexFilterEnabled and globexShowDeveloping, array.get(renderBudgetAnchors, 1)) + liveProfileLineCount(weeklyLiveProfile, weeklyFilterEnabled and weeklyShowDeveloping, array.get(renderBudgetAnchors, 2)) + liveProfileLineCount(monthlyLiveProfile, monthlyFilterEnabled and monthlyShowDeveloping, array.get(renderBudgetAnchors, 3)) + liveProfileLineCount(quarterlyLiveProfile, quarterlyFilterEnabled and quarterlyShowDeveloping, array.get(renderBudgetAnchors, 4))
    int protectedAutoSweptLineReserve = totalAutoSweptArchiveLineCost(renderBudgetAnchors, false)
    int selectedAutoSweptLineReserve = totalAutoSweptArchiveLineCost(renderBudgetAnchors, true)
    int focusedAutoSweptLineReserve = focusedAutoSweptReservedLineCost(renderBudgetAnchors)
    int completedLineBudget = math.max(0, INDICATOR_MAX_LINES - array.size(drawnLines) - liveLineReserve - protectedAutoSweptLineReserve - selectedAutoSweptLineReserve - focusedAutoSweptLineReserve)
    array<int> lineFromIndices = allocateProfileBudget(renderBudgetAnchors, completedLineBudget, false)
    int rthHistogramFromIndex = array.get(histogramFromIndices, 0)
    int globexHistogramFromIndex = array.get(histogramFromIndices, 1)
    int weeklyHistogramFromIndex = array.get(histogramFromIndices, 2)
    int monthlyHistogramFromIndex = array.get(histogramFromIndices, 3)
    int quarterlyHistogramFromIndex = array.get(histogramFromIndices, 4)
    int rthLineFromIndex = array.get(lineFromIndices, 0)
    int globexLineFromIndex = array.get(lineFromIndices, 1)
    int weeklyLineFromIndex = array.get(lineFromIndices, 2)
    int monthlyLineFromIndex = array.get(lineFromIndices, 3)
    int quarterlyLineFromIndex = array.get(lineFromIndices, 4)
    revelioInteractions.registerArchivedLevelHitKeys(levelHitEvents, levelHitPresentations, archivedLevelHitKeys, interactionConfig)
    // Manual/grace carry and selected relevance lines remain visible before ordinary history.
    renderAutoSweptArchivePass(renderBudgetAnchors, false, touchLabelsActive, archivedLevelHitKeys, renderedLevelHitKeys)
    renderFocusedAutoSweptReserved(renderBudgetAnchors, false, touchLabelsActive, archivedLevelHitKeys, renderedLevelHitKeys)
    renderAutoSweptArchivePass(renderBudgetAnchors, true, touchLabelsActive, archivedLevelHitKeys, renderedLevelHitKeys)
    renderFocusedAutoSweptReserved(renderBudgetAnchors, true, touchLabelsActive, archivedLevelHitKeys, renderedLevelHitKeys)
    renderAnchor(array.get(renderBudgetAnchors, 0), rthLiveProfile, rthDevelopingProfileActive, rthShowDeveloping, rthHistogramFromIndex, rthLineFromIndex, touchLabelsActive, archivedLevelHitKeys, renderedLevelHitKeys)
    renderAnchor(array.get(renderBudgetAnchors, 1), globexLiveProfile, false, globexShowDeveloping, globexHistogramFromIndex, globexLineFromIndex, touchLabelsActive, archivedLevelHitKeys, renderedLevelHitKeys)
    renderAnchor(array.get(renderBudgetAnchors, 2), weeklyLiveProfile, false, weeklyShowDeveloping, weeklyHistogramFromIndex, weeklyLineFromIndex, touchLabelsActive, archivedLevelHitKeys, renderedLevelHitKeys)
    renderAnchor(array.get(renderBudgetAnchors, 3), monthlyLiveProfile, false, monthlyShowDeveloping, monthlyHistogramFromIndex, monthlyLineFromIndex, touchLabelsActive, archivedLevelHitKeys, renderedLevelHitKeys)
    renderAnchor(array.get(renderBudgetAnchors, 4), quarterlyLiveProfile, false, quarterlyShowDeveloping, quarterlyHistogramFromIndex, quarterlyLineFromIndex, touchLabelsActive, archivedLevelHitKeys, renderedLevelHitKeys)
    array<int> levelHitGroupIndices = revelioInteractions.levelHitEventGroups(levelHitEvents, renderedLevelHitKeys, levelHitPresentations, interactionConfig, interactionHitTracePolicy)
    revelioInteractions.registerLevelHitLabelClusters(levelHitEvents, levelHitGroupIndices, levelHitLabelClusters)
    if touchLabelsActive and levelHitShowFirstHit
        revelioInteractions.registerFirstLevelHitDirections(levelHitEvents, levelHitGroupIndices, levelHitFirstDirections, interactionConfig)
    else
        map.clear(levelHitFirstDirections)
    revelioInteractions.bufferLevelHitLabels(levelHitEvents, touchLabelsActive, renderedLevelHitKeys, levelHitPresentations, pendingLabels, interactionConfig)
    // Preserve right-edge labels and recent hits before secondary reminder labels under drawing pressure.
    revelioInteractions.flushPendingLabels(pendingLabels, dedupeLabels, profileFirstLabels, shortenDatedProfiles, shortenPreviousProfiles, shortenLiveProfiles, levelHitLabelClusters, levelHitFirstDirections, drawnLines, drawnLabels, interactionConfig)
    revelioInteractions.renderLevelHitCircles(levelHitEvents, levelHitGroupIndices, levelHitPresentations, levelHitFirstDirections, drawnLabels, interactionConfig)
    revelioInteractions.flushPendingAnchorReminders(pendingAnchorReminders, dedupeLabels, profileFirstLabels, shortenDatedProfiles, shortenPreviousProfiles, shortenLiveProfiles, drawnLabels, interactionConfig)
    revelioInteractions.flushPendingReminders(pendingReminders, dedupeLabels, profileFirstLabels, shortenDatedProfiles, shortenPreviousProfiles, shortenLiveProfiles, drawnLabels, interactionConfig)

// revelio
