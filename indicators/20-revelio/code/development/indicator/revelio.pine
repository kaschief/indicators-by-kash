LABEL_SHOW_ONLY = "Show Only"
LABEL_MOST_RECENT_ONLY = "Most Recent Only"
TOOLTIP_SHOW_ONLY = "Dims candles outside the selected New York window. Profiles and drawings stay unchanged.\n\n• Overnight — 16:00–05:00.\n• ● ● RTH — 05:00–16:00.\n• ● RTH — 08:30–16:00.\n• RTH — 09:30–16:00.\n\nSecondary pane: applies only to pane candles and never changes main-chart candles.\n\nHigher timeframes dim whole candles; intraday portions cannot be split."
TOOLTIP_MOST_RECENT_ONLY = "Most Recent Only\nShows the selected window only on the current New York date. Weekends and holidays stay dim until the next session.\n\nOff — show the window every day."

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Quick Filter
// ═══════════════════════════════════════════════════════════════════════════════
quickFilter = input.string(FILTER_INTRADAY, "Quick Filter", options=[FILTER_ALL, FILTER_MACRO_PREP, FILTER_DUO, FILTER_INTRADAY, FILTER_SWING, FILTER_HORIZON, FILTER_MACRO, FILTER_VALUE_GAPS, FILTER_RTH_ONLY, FILTER_GLOBEX_ONLY, FILTER_WEEKLY_ONLY, FILTER_MONTHLY_ONLY, FILTER_QUARTERLY_ONLY], group=GROUP_QUICK_FILTER, tooltip=TOOLTIP_QUICK_FILTER)
isAll = quickFilter == FILTER_ALL
isIntraday = quickFilter == FILTER_INTRADAY
isDuo = quickFilter == FILTER_DUO
isSwing = quickFilter == FILTER_SWING
isHorizon = quickFilter == FILTER_HORIZON
isMacro = quickFilter == FILTER_MACRO
isMacroPrep = quickFilter == FILTER_MACRO_PREP
isGapsFilter = quickFilter == FILTER_VALUE_GAPS
isRthOnly = quickFilter == FILTER_RTH_ONLY
isGlobexOnly = quickFilter == FILTER_GLOBEX_ONLY
isWeeklyOnly = quickFilter == FILTER_WEEKLY_ONLY
isMonthlyOnly = quickFilter == FILTER_MONTHLY_ONLY
isQuarterlyOnly = quickFilter == FILTER_QUARTERLY_ONLY
rthQuickFilterActive = isMacroPrep or isIntraday or isDuo or isRthOnly
globexQuickFilterActive = isMacroPrep or isIntraday or isGlobexOnly
weeklyQuickFilterActive = isMacroPrep or isDuo or isSwing or isHorizon or isWeeklyOnly
monthlyQuickFilterActive = isMacroPrep or isSwing or isHorizon or isMacro or isMonthlyOnly
quarterlyQuickFilterActive = isHorizon or isMacro or isMacroPrep or isQuarterlyOnly
rthMenuControlsActive = isAll or rthQuickFilterActive or isGapsFilter
globexMenuControlsActive = isAll or globexQuickFilterActive or isGapsFilter
weeklyMenuControlsActive = isAll or weeklyQuickFilterActive
monthlyMenuControlsActive = isAll or monthlyQuickFilterActive
quarterlyMenuControlsActive = isAll or quarterlyQuickFilterActive
quickPriceMode = input.string(PRICE_MODE_OFF, "Prices", options=[PRICE_MODE_OFF, PRICE_MODE_ACTIVE, PRICE_MODE_CUSTOM], group=GROUP_QUICK_FILTER, tooltip=TOOLTIP_PRICE_MODE)
includeDevelopingRth = input.bool(false, "+RTH", inline="ov_dev", group=GROUP_QUICK_FILTER, active=rthMenuControlsActive)
includeDevelopingGlobex = input.bool(false, "+Globex", inline="ov_dev", group=GROUP_QUICK_FILTER, active=globexMenuControlsActive, tooltip="+RTH\n" + TOOLTIP_DEVELOPING_RTH + "\n\n+Globex\n" + TOOLTIP_DEVELOPING_GLOBEX)
weeklyCurrentMode = input.string(CURRENT_AUTO, "+Weekly", options=[CURRENT_AUTO, CURRENT_ON, CURRENT_OFF], inline="ov_swing_current", group=GROUP_QUICK_FILTER, active=weeklyMenuControlsActive)
monthlyCurrentMode = input.string(CURRENT_AUTO, "+Monthly", options=[CURRENT_AUTO, CURRENT_ON, CURRENT_OFF], inline="ov_swing_current", group=GROUP_QUICK_FILTER, active=monthlyMenuControlsActive)
quarterlyCurrentMode = input.string(CURRENT_AUTO, "+Quarterly", options=[CURRENT_AUTO, CURRENT_ON, CURRENT_OFF], inline="ov_swing_current", group=GROUP_QUICK_FILTER, active=quarterlyMenuControlsActive, tooltip="+Weekly\n" + TOOLTIP_DEVELOPING_WEEKLY + "\n\n+Monthly\n" + TOOLTIP_DEVELOPING_MONTHLY + "\n\n+Quarterly\n" + TOOLTIP_DEVELOPING_QUARTERLY)
showOnlyEnabled = input.bool(true, LABEL_SHOW_ONLY, inline="show_only", group=GROUP_QUICK_FILTER)
hiddenCandleColor = input.color(DEFAULT_HIDDEN_CANDLE_COLOR, "", inline="show_only", group=GROUP_QUICK_FILTER, active=showOnlyEnabled)
visibleWindow = input.string(WINDOW_LABEL_RTH, "", options=[WINDOW_LABEL_OVERNIGHT, WINDOW_LABEL_FROM_0500, WINDOW_LABEL_FROM_0830, WINDOW_LABEL_RTH], inline="show_only", group=GROUP_QUICK_FILTER, active=showOnlyEnabled)
showOnlyMostRecent = input.bool(false, LABEL_MOST_RECENT_ONLY, inline="show_only", group=GROUP_QUICK_FILTER, active=showOnlyEnabled, tooltip=TOOLTIP_SHOW_ONLY + "\n\n———\n\n" + LABEL_MOST_RECENT_ONLY + "\n" + TOOLTIP_MOST_RECENT_ONLY)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Quick Filter: Focus
// ═══════════════════════════════════════════════════════════════════════════════
// Declared before the daily counts because Focus supersedes them.
focusControlsActive = rthMenuControlsActive or globexMenuControlsActive
focusDirection = input.string(FOCUS_DIRECTION_OFF, "Intraday Focus", options=[FOCUS_DIRECTION_OFF, FOCUS_DIRECTION_BELOW, FOCUS_DIRECTION_ABOVE, FOCUS_DIRECTION_AROUND], inline="focus_mode", group=GROUP_QUICK_FILTER_FOCUS, active=focusControlsActive)
focusSelected = focusControlsActive and focusDirection != FOCUS_DIRECTION_OFF
// Per anchor; trimFocusToBudget resolves any overflow.
focusProfileCount = input.int(DEFAULT_FOCUS_COUNT, "Profiles", options=[1, 2, 3, 4, 5, 10, 15, 20, 25, 30], inline="focus_mode", group=GROUP_QUICK_FILTER_FOCUS, active=focusSelected, tooltip=TOOLTIP_FOCUS)
// Keep this inline row tooltip-free because input.price tooltips render as chart banners.
focusAnchorMode = input.string(FOCUS_ANCHOR_PRICE, "Anchor", options=[FOCUS_ANCHOR_PRICE, FOCUS_ANCHOR_MANUAL], inline="focus_anchor", group=GROUP_QUICK_FILTER_FOCUS, active=focusSelected)
focusManualAnchorSelected = focusSelected and focusAnchorMode == FOCUS_ANCHOR_MANUAL
focusManualPrice = input.price(0.0, "Price", inline="focus_anchor", group=GROUP_QUICK_FILTER_FOCUS, active=focusManualAnchorSelected)
focusManualPricePlaced = not na(focusManualPrice) and focusManualPrice > 0
focusAnchorWidth = input.int(2, "Width", options=[1, 2, 3, 4, 5], inline="focus_anchor_style", group=GROUP_QUICK_FILTER_FOCUS, active=focusManualAnchorSelected)
focusAnchorLabelOffset = input.int(300, "Offset", minval=0, maxval=1000, inline="focus_anchor_style", group=GROUP_QUICK_FILTER_FOCUS, active=focusManualAnchorSelected, tooltip="Shift the Manual Focus Anchor label this many bars into the right margin.")
focusSurfaceSweptLevels = input.bool(true, "Swept Levels", inline="focus_swept", group=GROUP_QUICK_FILTER_FOCUS, active=focusSelected, tooltip=TOOLTIP_FOCUS_SWEPT)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Quick Filter: Settings
// ═══════════════════════════════════════════════════════════════════════════════
// Focus replaces the daily counts, so these go inert while it runs.
dailyProfileBoostControlsActive = (isIntraday or isRthOnly or isGlobexOnly) and not focusSelected
rthProfilesToShow = input.int(DEFAULT_RTH_PROFILES, "RTH", minval=1, maxval=50, inline="ov_counts", group=GROUP_QUICK_FILTER_SETTINGS, active=rthMenuControlsActive and not focusSelected)
globexProfilesToShow = input.int(DEFAULT_GLOBEX_PROFILES, "Globex", minval=1, maxval=50, inline="ov_counts", group=GROUP_QUICK_FILTER_SETTINGS, active=globexMenuControlsActive and not focusSelected)
dailyProfileBoost = input.string(DAILY_PROFILE_BOOST_OFF, "⚡ Boost", options=[DAILY_PROFILE_BOOST_OFF, DAILY_PROFILE_BOOST_20, DAILY_PROFILE_BOOST_30, DAILY_PROFILE_BOOST_40, DAILY_PROFILE_BOOST_50], inline="ov_counts", group=GROUP_QUICK_FILTER_SETTINGS, active=dailyProfileBoostControlsActive, tooltip="RTH\n" + TOOLTIP_RTH_PROFILES + "\n\nGlobex\n" + TOOLTIP_GLOBEX_PROFILES + "\n\n⚡ Boost\n" + TOOLTIP_DAILY_PROFILE_BOOST)
dailyProfileBoostActive = dailyProfileBoostControlsActive and dailyProfileBoost != DAILY_PROFILE_BOOST_OFF
dailyProfileBoostCount = dailyProfileBoost == DAILY_PROFILE_BOOST_20 ? 20 : dailyProfileBoost == DAILY_PROFILE_BOOST_30 ? 30 : dailyProfileBoost == DAILY_PROFILE_BOOST_40 ? 40 : dailyProfileBoost == DAILY_PROFILE_BOOST_50 ? 50 : 0
rthProfileBoostActive = dailyProfileBoostActive and (isIntraday or isRthOnly)
globexProfileBoostActive = dailyProfileBoostActive and (isIntraday or isGlobexOnly)
rthEffectiveProfilesToShow = rthProfileBoostActive ? dailyProfileBoostCount : rthProfilesToShow
globexEffectiveProfilesToShow = globexProfileBoostActive ? dailyProfileBoostCount : globexProfilesToShow
weeklyProfilesToShow = input.int(DEFAULT_WEEKLY_PROFILES, "W", minval=1, maxval=50, inline="ov_counts2", group=GROUP_QUICK_FILTER_SETTINGS, active=weeklyMenuControlsActive)
monthlyProfilesToShow = input.int(DEFAULT_MONTHLY_PROFILES, "M", minval=1, maxval=50, inline="ov_counts2", group=GROUP_QUICK_FILTER_SETTINGS, active=monthlyMenuControlsActive)
quarterlyProfilesToShow = input.int(DEFAULT_QUARTERLY_PROFILES, "Q", minval=1, maxval=50, inline="ov_counts2", group=GROUP_QUICK_FILTER_SETTINGS, active=quarterlyMenuControlsActive, tooltip="W · Weekly\n" + TOOLTIP_WEEKLY_PROFILES + "\n\nM · Monthly\n" + TOOLTIP_MONTHLY_PROFILES + "\n\nQ · Quarterly\n" + TOOLTIP_QUARTERLY_PROFILES)
rthMergeMode = input.string(MERGE_ALL, LABEL_SHORT_SESSION_MERGE + "  ·  RTH", options=[MERGE_OFF, MERGE_EARLIEST, MERGE_ALL, MERGE_COMBINE], inline="ov_merge", group=GROUP_QUICK_FILTER_SETTINGS, active=rthMenuControlsActive)
globexMergeMode = input.string(MERGE_ALL, "Globex", options=[MERGE_OFF, MERGE_EARLIEST, MERGE_ALL, MERGE_COMBINE], inline="ov_merge", group=GROUP_QUICK_FILTER_SETTINGS, active=globexMenuControlsActive, tooltip="Short Sessions\nRTH: below 75% of its longest span. Globex: below 90%.\n\n• Off — keep separate.\n• Earliest — fold the first short into the prior full session.\n• All — fold consecutive shorts into the prior full session.\n• Combine — merge consecutive shorts.")


// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Quick Filter: Prices
// ═══════════════════════════════════════════════════════════════════════════════
rthShowPrice = input.bool(false, "RTH", inline="ov_prices", group=GROUP_QUICK_FILTER_PRICES, active=quickPriceMode == PRICE_MODE_CUSTOM and rthMenuControlsActive)
globexShowPrice = input.bool(false, "Globex", inline="ov_prices", group=GROUP_QUICK_FILTER_PRICES, active=quickPriceMode == PRICE_MODE_CUSTOM and globexMenuControlsActive)
weeklyShowPrice = input.bool(false, "Weekly", inline="ov_prices", group=GROUP_QUICK_FILTER_PRICES, active=quickPriceMode == PRICE_MODE_CUSTOM and weeklyMenuControlsActive)
monthlyShowPrice = input.bool(false, "Monthly", inline="ov_prices", group=GROUP_QUICK_FILTER_PRICES, active=quickPriceMode == PRICE_MODE_CUSTOM and monthlyMenuControlsActive)
quarterlyShowPrice = input.bool(false, "Quarterly", inline="ov_prices", group=GROUP_QUICK_FILTER_PRICES, active=quickPriceMode == PRICE_MODE_CUSTOM and quarterlyMenuControlsActive, tooltip=TOOLTIP_CUSTOM_PRICES)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Quick Filter: Controls
// ═══════════════════════════════════════════════════════════════════════════════
valueGapsEnabled = input.bool(true, "Gaps", inline="quick_controls_daily", group=GROUP_QUICK_FILTER_CONTROLS)
rthEnabled = input.bool(true, "RTH", inline="quick_controls_daily", group=GROUP_QUICK_FILTER_CONTROLS, active=isAll)
globexEnabled = input.bool(false, "Globex", inline="quick_controls_daily", group=GROUP_QUICK_FILTER_CONTROLS, active=isAll, tooltip="Gaps can be toggled at any time.\n\nRTH and Globex are manual anchor switches and are editable when Quick Filter is Manual.")
weeklyEnabled = input.bool(false, "Weekly", inline="quick_controls_calendar", group=GROUP_QUICK_FILTER_CONTROLS, active=isAll)
monthlyEnabled = input.bool(false, "Monthly", inline="quick_controls_calendar", group=GROUP_QUICK_FILTER_CONTROLS, active=isAll)
quarterlyEnabled = input.bool(false, "Quarterly", inline="quick_controls_calendar", group=GROUP_QUICK_FILTER_CONTROLS, active=isAll, tooltip="Weekly, Monthly and Quarterly are manual anchor switches and are editable when Quick Filter is Manual.")

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Quick Filter: Touch Markers
// ═══════════════════════════════════════════════════════════════════════════════
touchMarkerMode = input.string(TOUCH_MARKERS_ON_FOCUS, "Touch Markers", options=[TOUCH_MARKERS_OFF, TOUCH_MARKERS_ON, TOUCH_MARKERS_ON_FOCUS], inline="touch_markers", group=GROUP_QUICK_FILTER_TOUCH_MARKERS)
levelHitTraceEnabled = touchMarkerMode != TOUCH_MARKERS_OFF
levelHitIncludeAllAnchors = input.bool(false, "Include All Anchors", inline="touch_markers", group=GROUP_QUICK_FILTER_TOUCH_MARKERS, active=levelHitTraceEnabled)
levelHitIncludeOlderLevels = input.bool(false, "Include Older Levels", inline="touch_markers", group=GROUP_QUICK_FILTER_TOUCH_MARKERS, active=levelHitTraceEnabled)
levelHitShowLabels = input.bool(true, "Touch Marker Labels", inline="touch_markers", group=GROUP_QUICK_FILTER_TOUCH_MARKERS, active=levelHitTraceEnabled, tooltip=TOOLTIP_LEVEL_HIT_TRACE)
levelHitDetectionWindow = input.string(WINDOW_LABEL_RTH, "Window", options=[WINDOW_LABEL_FROM_0500, WINDOW_LABEL_FROM_0830, WINDOW_LABEL_RTH], inline="level_hit_window", group=GROUP_QUICK_FILTER_TOUCH_MARKERS, active=levelHitTraceEnabled)
levelHitHistory = input.string(LEVEL_HIT_HISTORY_CURRENT_WINDOW, "History", options=[LEVEL_HIT_HISTORY_CURRENT_WINDOW, LEVEL_HIT_HISTORY_ONE_DAY, LEVEL_HIT_HISTORY_THREE_DAYS, LEVEL_HIT_HISTORY_ONE_WEEK], inline="level_hit_window", group=GROUP_QUICK_FILTER_TOUCH_MARKERS, active=levelHitTraceEnabled)
levelHitLimitDailyRetouches = input.bool(true, "Limit Daily Retouches", inline="level_hit_window", group=GROUP_QUICK_FILTER_TOUCH_MARKERS, active=levelHitTraceEnabled and levelHitIncludeOlderLevels)
levelHitShowFirstHit = input.bool(false, "First Hit", inline="level_hit_window", group=GROUP_QUICK_FILTER_TOUCH_MARKERS, active=levelHitTraceEnabled and levelHitShowLabels, tooltip=TOOLTIP_LEVEL_HIT_WINDOW)
focusHitTraceActive = levelHitTraceEnabled and focusSelected and touchMarkerMode == TOUCH_MARKERS_ON_FOCUS

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — RTH session
// ═══════════════════════════════════════════════════════════════════════════════
rthControlsActive = isAll ? rthEnabled : rthMenuControlsActive
rthExtensionMode = input.string(LEVEL_BREACH_SWEEP, "Extension", options=[LEVEL_PERIOD, LEVEL_BREACH_ANY, LEVEL_BREACH_SAME, LEVEL_BREACH_SWEEP], inline="rth_top", group=GROUP_RTH, active=rthControlsActive, tooltip="RTH: 09:30–16:00 New York, Monday–Friday.\n\n• Session Only — stop at close.\n• Until Touched — stop at first trade-through.\n• Same-Session Touch — later RTH sessions only.\n• Until Swept — qualifying closes on both sides.")
rthSweepControlsActive = rthControlsActive and rthExtensionMode == LEVEL_BREACH_SWEEP
rthShowValueArea = input.bool(true, LABEL_VALUE_AREA_HIGH_LOW, inline="rth_levels", group=GROUP_RTH, active=rthControlsActive)
rthShowPoc = input.bool(true, LABEL_POC, inline="rth_levels", group=GROUP_RTH, active=rthControlsActive)
rthShowAlternatePoc = input.bool(false, LABEL_ALTERNATE_POC, inline="rth_levels", group=GROUP_RTH, active=rthControlsActive)
rthShowSessionBox = input.bool(false, LABEL_BOX, inline="rth_visuals", group=GROUP_RTH, active=rthControlsActive)
rthShowHistogram = input.bool(true, LABEL_HISTOGRAM, inline="rth_visuals", group=GROUP_RTH, active=rthControlsActive)
rthDimTouched = input.bool(true, LABEL_DIM_TOUCHED, inline="rth_visuals", group=GROUP_RTH, active=rthControlsActive, tooltip=TOOLTIP_DIM_ROW)
rthDevelopingEnabled = input.bool(true, LABEL_DEVELOPING_PROFILE, inline="rth_developing", group=GROUP_RTH, active=rthControlsActive)
rthDevelopingCutoffHour = input.int(11, "Until", minval=0, maxval=23, inline="rth_developing", group=GROUP_RTH, active=rthControlsActive and rthDevelopingEnabled)
rthDevelopingCutoffMinute = input.int(30, ":", minval=0, maxval=59, inline="rth_developing", group=GROUP_RTH, active=rthControlsActive and rthDevelopingEnabled, tooltip="Developing style uses the settled gray palette before this New York cutoff.")

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Globex session
// ═══════════════════════════════════════════════════════════════════════════════
globexControlsActive = isAll ? globexEnabled : globexMenuControlsActive
globexExtensionMode = input.string(LEVEL_BREACH_SWEEP, "Extension", options=[LEVEL_PERIOD, LEVEL_BREACH_ANY, LEVEL_BREACH_SWEEP], inline="globex_top", group=GROUP_GLOBEX, active=globexControlsActive, tooltip="Globex Profile\nFutures: 18:00 New York open. 24/7 assets: 00:00 UTC.\n\nLevel Extension\n• Session Only — stop at period close.\n• Until Touched — stop at first trade-through.\n• Until Swept — stop after qualifying closes on both sides.")
globexSweepControlsActive = globexControlsActive and globexExtensionMode == LEVEL_BREACH_SWEEP
globexShowValueArea = input.bool(true, LABEL_VALUE_AREA_HIGH_LOW, inline="globex_levels", group=GROUP_GLOBEX, active=globexControlsActive)
globexShowPoc = input.bool(true, LABEL_POC, inline="globex_levels", group=GROUP_GLOBEX, active=globexControlsActive)
globexShowAlternatePoc = input.bool(false, LABEL_ALTERNATE_POC, inline="globex_levels", group=GROUP_GLOBEX, active=globexControlsActive)
globexShowSessionBox = input.bool(false, LABEL_BOX, inline="globex_visuals", group=GROUP_GLOBEX, active=globexControlsActive)
globexShowHistogram = input.bool(true, LABEL_HISTOGRAM, inline="globex_visuals", group=GROUP_GLOBEX, active=globexControlsActive)
globexDimTouched = input.bool(true, LABEL_DIM_TOUCHED, inline="globex_visuals", group=GROUP_GLOBEX, active=globexControlsActive, tooltip=TOOLTIP_DIM_ROW)
// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Weekly session
// ═══════════════════════════════════════════════════════════════════════════════
weeklyControlsActive = isAll ? weeklyEnabled : weeklyMenuControlsActive
weeklyExtensionMode = input.string(LEVEL_BREACH_SWEEP, "Extension", options=[LEVEL_PERIOD, LEVEL_BREACH_ANY, LEVEL_BREACH_SWEEP], inline="weekly_top", group=GROUP_WEEKLY, active=weeklyControlsActive, tooltip="Weekly starts Sunday 18:00 New York for futures or Monday 00:00 UTC for 24/7 assets.\n\n• Session Only — stop at close.\n• Until Touched — first trade-through.\n• Until Swept — qualifying closes on both sides.")
weeklySweepControlsActive = weeklyControlsActive and weeklyExtensionMode == LEVEL_BREACH_SWEEP
weeklyShowValueArea = input.bool(true, LABEL_VALUE_AREA_HIGH_LOW, inline="weekly_levels", group=GROUP_WEEKLY, active=weeklyControlsActive)
weeklyShowPoc = input.bool(true, LABEL_POC, inline="weekly_levels", group=GROUP_WEEKLY, active=weeklyControlsActive)
weeklyShowAlternatePoc = input.bool(false, LABEL_ALTERNATE_POC, inline="weekly_levels", group=GROUP_WEEKLY, active=weeklyControlsActive)
weeklyShowSessionBox = input.bool(false, LABEL_BOX, inline="weekly_visuals", group=GROUP_WEEKLY, active=weeklyControlsActive)
weeklyShowHistogram = input.bool(true, LABEL_HISTOGRAM, inline="weekly_visuals", group=GROUP_WEEKLY, active=weeklyControlsActive)
weeklyDimTouched = input.bool(true, LABEL_DIM_TOUCHED, inline="weekly_visuals", group=GROUP_WEEKLY, active=weeklyControlsActive, tooltip=TOOLTIP_DIM_ROW)
// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Monthly session
// ═══════════════════════════════════════════════════════════════════════════════
monthlyControlsActive = isAll ? monthlyEnabled : monthlyMenuControlsActive
monthlyExtensionMode = input.string(LEVEL_BREACH_SWEEP, "Extension", options=[LEVEL_PERIOD, LEVEL_BREACH_ANY, LEVEL_BREACH_SWEEP], inline="monthly_top", group=GROUP_MONTHLY, active=monthlyControlsActive, tooltip="Monthly Profile\n24/7 assets use UTC; other symbols use New York time.\n\nLevel Extension\n• Session Only — stop at month close.\n• Until Touched — stop at first trade-through.\n• Until Swept — stop after qualifying closes on both sides.")
monthlySweepControlsActive = monthlyControlsActive and monthlyExtensionMode == LEVEL_BREACH_SWEEP
monthlyShowValueArea = input.bool(true, LABEL_VALUE_AREA_HIGH_LOW, inline="monthly_levels", group=GROUP_MONTHLY, active=monthlyControlsActive)
monthlyShowPoc = input.bool(true, LABEL_POC, inline="monthly_levels", group=GROUP_MONTHLY, active=monthlyControlsActive)
monthlyShowAlternatePoc = input.bool(false, LABEL_ALTERNATE_POC, inline="monthly_levels", group=GROUP_MONTHLY, active=monthlyControlsActive)
monthlyShowSessionBox = input.bool(false, LABEL_BOX, inline="monthly_visuals", group=GROUP_MONTHLY, active=monthlyControlsActive)
monthlyShowHistogram = input.bool(true, LABEL_HISTOGRAM, inline="monthly_visuals", group=GROUP_MONTHLY, active=monthlyControlsActive)
monthlyDimTouched = input.bool(true, LABEL_DIM_TOUCHED, inline="monthly_visuals", group=GROUP_MONTHLY, active=monthlyControlsActive, tooltip=TOOLTIP_DIM_ROW)
// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Quarterly session
// ═══════════════════════════════════════════════════════════════════════════════
quarterlyControlsActive = isAll ? quarterlyEnabled : quarterlyMenuControlsActive
quarterlyExtensionMode = input.string(LEVEL_BREACH_SWEEP, "Extension", options=[LEVEL_PERIOD, LEVEL_BREACH_ANY, LEVEL_BREACH_SWEEP], inline="quarterly_top", group=GROUP_QUARTERLY, active=quarterlyControlsActive, tooltip="Calendar quarters: UTC for 24/7 assets, New York time otherwise.\n\n• Session Only — stop at close.\n• Until Touched — first trade-through.\n• Until Swept — qualifying closes on both sides.")
quarterlySweepControlsActive = quarterlyControlsActive and quarterlyExtensionMode == LEVEL_BREACH_SWEEP
quarterlyShowValueArea = input.bool(true, LABEL_VALUE_AREA_HIGH_LOW, inline="quarterly_levels", group=GROUP_QUARTERLY, active=quarterlyControlsActive)
quarterlyShowPoc = input.bool(true, LABEL_POC, inline="quarterly_levels", group=GROUP_QUARTERLY, active=quarterlyControlsActive)
quarterlyShowAlternatePoc = input.bool(false, LABEL_ALTERNATE_POC, inline="quarterly_levels", group=GROUP_QUARTERLY, active=quarterlyControlsActive)
quarterlyShowSessionBox = input.bool(false, LABEL_BOX, inline="quarterly_visuals", group=GROUP_QUARTERLY, active=quarterlyControlsActive)
quarterlyShowHistogram = input.bool(true, LABEL_HISTOGRAM, inline="quarterly_visuals", group=GROUP_QUARTERLY, active=quarterlyControlsActive)
quarterlyDimTouched = input.bool(true, LABEL_DIM_TOUCHED, inline="quarterly_visuals", group=GROUP_QUARTERLY, active=quarterlyControlsActive, tooltip=TOOLTIP_DIM_ROW)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — value-area gaps
// ═══════════════════════════════════════════════════════════════════════════════
valueGapControlsActive = valueGapsEnabled or quickFilter == FILTER_VALUE_GAPS
valueGapSource = input.string(VALUE_GAP_SOURCE_RTH, "Source", options=[VALUE_GAP_SOURCE_RTH, VALUE_GAP_SOURCE_GLOBEX], inline="vag_top", group=GROUP_VALUE_GAPS, active=valueGapControlsActive)
valueGapDisplayMode = input.string(VALUE_GAP_DISPLAY_FLOATING, "Display", options=[VALUE_GAP_DISPLAY_HISTORICAL, VALUE_GAP_DISPLAY_HISTORICAL_FLOATING, VALUE_GAP_DISPLAY_RECENT_FLOATING, VALUE_GAP_DISPLAY_FLOATING], inline="vag_top", group=GROUP_VALUE_GAPS, active=valueGapControlsActive, tooltip="Source\nRTH or Globex consecutive-session value areas.\n\nDisplay\n• Historical — history only.\n• Historical + Floating — Show Last history plus floating gaps.\n• Most Recent + Floating — one historical gap plus floating gaps.\n• Floating Only — no historical gaps.")
valueGapHistoricalControlsActive = valueGapControlsActive and valueGapDisplayMode != VALUE_GAP_DISPLAY_FLOATING
valueGapHistoryCountActive = valueGapControlsActive and (valueGapDisplayMode == VALUE_GAP_DISPLAY_HISTORICAL or valueGapDisplayMode == VALUE_GAP_DISPLAY_HISTORICAL_FLOATING)
valueGapFloatingControlsActive = valueGapControlsActive and valueGapDisplayMode != VALUE_GAP_DISPLAY_HISTORICAL
valueGapsToShow = input.int(20, "Show Last", minval=1, maxval=50, inline="vag_history", group=GROUP_VALUE_GAPS, active=valueGapHistoryCountActive)
hideFilledValueGaps = input.bool(true, "Hide Filled", inline="vag_history", group=GROUP_VALUE_GAPS, active=valueGapHistoricalControlsActive, tooltip="Confirmed Gaps\nCompare consecutive completed Source value areas.\n\n• Bullish — new VAL above prior VAH.\n• Bearish — new VAH below prior VAL.\n• Show Last — used by Historical modes.\n• Most Recent + Floating always uses one historical gap.\n• Gaps below 5% of the prior profile range are ignored.\n• Hide Filled — remove fully filled historical gaps.")
valueGapFillWindow = input.string(WINDOW_LABEL_FROM_0830, "Fill", options=[WINDOW_LABEL_OVERNIGHT, WINDOW_LABEL_FROM_0500, WINDOW_LABEL_FROM_0830, WINDOW_LABEL_RTH], inline="vag_display", group=GROUP_VALUE_GAPS, active=valueGapControlsActive)
valueGapTraversalFill = input.bool(true, "Traversal", inline="vag_display", group=GROUP_VALUE_GAPS, active=valueGapControlsActive)
valueGapNearestMode = input.string("1", "Nearest", options=[VALUE_GAP_NEAREST_RECENT_ONLY, "1", "2", "3", "4", "5"], inline="vag_display", group=GROUP_VALUE_GAPS, active=valueGapFloatingControlsActive, tooltip="Traversal\n• Off — fill at the far edge.\n• On — fill only traded portions.\n\nFill Window\n• Overnight — overnight prices also count.\n• ● ● RTH — 05:00–16:00 New York.\n• ● RTH — 08:30–16:00 New York.\n• RTH — 09:30–16:00 New York.\n\nNearest\n• Recent Only — most recent open gap only.\n• 1–5 — add open gaps by distance.")
valueGapNearestFloats = valueGapNearestMode == VALUE_GAP_NEAREST_RECENT_ONLY ? 0 : int(str.tonumber(valueGapNearestMode))
upcomingValueGapEnabled = input.bool(false, "Upcoming", inline="vag_upcoming", group=GROUP_VALUE_GAPS, active=valueGapControlsActive, tooltip="Compares the developing Source value area with the latest completed one. It may move or disappear before close. Gaps below 45% of the prior profile range are ignored.")
upcomingValueGapControlsActive = valueGapControlsActive and upcomingValueGapEnabled

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — value-area gap style
// ═══════════════════════════════════════════════════════════════════════════════
boldLastFilledValueGap = input.bool(true, "Highlight Latest Filled Gap", inline="vag_style", group=GROUP_VALUE_GAPS_STYLE, active=valueGapHistoricalControlsActive and not hideFilledValueGaps)
valueGapShowInternalReminders = input.bool(false, "Repeat 50% Labels", inline="vag_style", group=GROUP_VALUE_GAPS_STYLE, active=valueGapControlsActive, tooltip="Highlight uses width 2 on the latest filled historical gap. Repeat adds sparse 50% labels along open gaps.")

valueGapSourceIsRth = valueGapSource == VALUE_GAP_SOURCE_RTH

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Labels
// ═══════════════════════════════════════════════════════════════════════════════
dedupeLabels = input.bool(true, "Merge Overlapping Labels", inline="label_merge", group=GROUP_LABELS)
labelMergePreset = input.string(LABEL_MERGE_WIDE, "", options=[LABEL_MERGE_STRICT, LABEL_MERGE_BALANCED, LABEL_MERGE_WIDE, LABEL_MERGE_EXTRA_WIDE, LABEL_MERGE_CUSTOM], inline="label_merge", group=GROUP_LABELS, active=dedupeLabels)
customLabelMergeDistancePercent = input.float(LABEL_MERGE_BALANCED_PERCENT, "%", minval=0.0, maxval=0.5, step=0.001, inline="label_merge", group=GROUP_LABELS, active=dedupeLabels and labelMergePreset == LABEL_MERGE_CUSTOM, tooltip="Merge Overlapping Labels\nCombines nearby right-edge labels and reminders.\n\nDistance\n• Strict — 0.005%.\n• Balanced — 0.010%.\n• Wide — 0.025%.\n• Extra Wide — 0.050%.\n• Custom — use %.\n\nMinimum distance is one tick. Off keeps labels separate. Secondary lines fade by 85%.")
profileLabelOrder = input.string(LABEL_ORDER_LEVEL_FIRST, "Profile Label Order", options=[LABEL_ORDER_PROFILE_FIRST, LABEL_ORDER_LEVEL_FIRST], inline="profile_label_format", group=GROUP_LABELS)
profileLabelShortening = input.string(LABEL_SHORTEN_NONE, "Shorten", options=[LABEL_SHORTEN_NONE, LABEL_SHORTEN_DATED, LABEL_SHORTEN_DATED_PREVIOUS, LABEL_SHORTEN_ALL], inline="profile_label_format", group=GROUP_LABELS, tooltip="Profile Label Order\n• Profile First — G POC Jul 22.\n• Level First — POC G Jul 22.\n\nShorten\n• None — use full profile names.\n• Dated Profiles — shorten completed dated profiles.\n• Dated + Previous — also shorten previous profiles.\n• All Profiles — also shorten live profiles.\n\nApplies to profile level labels and reminders. Touch Marker hover and Value Gap labels do not change. Shortened labels retain ✓Ⓐ; hover retains ⁺◌ provenance.")
profileFirstLabels = profileLabelOrder == LABEL_ORDER_PROFILE_FIRST
shortenDatedProfiles = profileLabelShortening == LABEL_SHORTEN_DATED or profileLabelShortening == LABEL_SHORTEN_DATED_PREVIOUS or profileLabelShortening == LABEL_SHORTEN_ALL
shortenPreviousProfiles = profileLabelShortening == LABEL_SHORTEN_DATED_PREVIOUS or profileLabelShortening == LABEL_SHORTEN_ALL
shortenLiveProfiles = profileLabelShortening == LABEL_SHORTEN_ALL
labelMergeDistancePercent = labelMergePreset == LABEL_MERGE_STRICT ? LABEL_MERGE_STRICT_PERCENT : labelMergePreset == LABEL_MERGE_WIDE ? LABEL_MERGE_WIDE_PERCENT : labelMergePreset == LABEL_MERGE_EXTRA_WIDE ? LABEL_MERGE_EXTRA_WIDE_PERCENT : labelMergePreset == LABEL_MERGE_CUSTOM ? customLabelMergeDistancePercent : LABEL_MERGE_BALANCED_PERCENT

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — Right Edge
// ═══════════════════════════════════════════════════════════════════════════════
levelLabelOffset = input.int(20, LABEL_LEVEL_LABEL_OFFSET, minval=0, maxval=100, tooltip="Shift price labels this many bars into the right margin.", group=GROUP_RIGHT_EDGE)
floatingValueGapOffset = input.int(150, "Floating Gaps · Offset", minval=1, maxval=500, inline="right_edge_floating", group=GROUP_RIGHT_EDGE, active=valueGapFloatingControlsActive)
floatingValueGapWidth = input.int(10, "Width", minval=2, maxval=50, inline="right_edge_floating", group=GROUP_RIGHT_EDGE, active=valueGapFloatingControlsActive, tooltip="Offset sets where floating gaps begin. Width sets each gap's bar width. Adjacent gaps keep 10 empty bars between them.")
upcomingValueGapOffset = input.int(90, "Upcoming Gap · Offset", minval=1, maxval=100, inline="right_edge_upcoming", group=GROUP_RIGHT_EDGE, active=upcomingValueGapControlsActive)
upcomingValueGapWidth = input.int(10, "Width", minval=2, maxval=50, inline="right_edge_upcoming", group=GROUP_RIGHT_EDGE, active=upcomingValueGapControlsActive, tooltip="Offset sets where the Upcoming gap begins. Width sets its horizontal bar width.")

// ═══════════════════════════════════════════════════════════════════════════════
