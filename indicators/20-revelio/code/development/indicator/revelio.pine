TOOLTIP_RTH_PROFILES = "Recent RTH profiles to draw chronologically. Inactive while Intraday Focus is on, which selects the daily profiles itself."
TOOLTIP_GLOBEX_PROFILES = "Recent Globex profiles to draw chronologically. Inactive while Intraday Focus is on, which selects the daily profiles itself."
TOOLTIP_WEEKLY_PROFILES = "Recent Weekly profiles to keep and draw in every Quick Filter mode."
TOOLTIP_MONTHLY_PROFILES = "Recent Monthly profiles to keep and draw in every Quick Filter mode."
TOOLTIP_QUARTERLY_PROFILES = "Recent Quarterly profiles to keep and draw in every Quick Filter mode."
TOOLTIP_DAILY_PROFILE_BOOST = "Temporarily replaces the active daily Show Last counts with the selected depth.\n\n• Intraday — RTH + Globex.\n• RTH Only — RTH.\n• Globex Only — Globex.\n• Off — restore the normal counts.\n\nRTH and Globex remain editable while boosted; changes apply when Boost is Off. Inactive while Intraday Focus is on."
TOOLTIP_FOCUS = "Nearest whole RTH/Globex profiles to the anchor. Count is per anchor."
TOOLTIP_FOCUS_SWEPT = "Focused profiles carry their swept levels to the right edge, ignoring the Sweep keep windows."
TOOLTIP_DEVELOPING_RTH = "Show today's developing RTH profile outside Manual mode."
