//@version=6

//@description Private Revelio Interactions Library for Touch Marker and level-label presentation.
library("RevelioInteractionsLibrary", overlay=true)

//@type One recorded interaction between price and a retained profile level.
export type LevelHitEvent
    int hitTime
    int barTime
    int contactTime
    float price
    string sourceProfileKey
    string key
    bool focusOnly
    bool archivedSwept
    bool unselectedAnchor
    int approachDirection

//@type Structured fields for one profile-level label identity.
export type LabelIdentity
    string fullText
    string anchorName
    string compactProfilePrefix
    string levelName
    string periodText
    string periodContextKey
    string periodMember
    bool compactContextAfterMembers
    string compactSuffix
    bool datedProfile

//@type Presentation metadata for one retained profile level.
export type LevelHitPresentation
    string identity
    LabelIdentity labelIdentity
    color lineColor
    color labelColor
    color labelBgColor
    bool showPrice
    string circleSize
    int labelSize
    int labelOffset
    int effectiveLineWidth
    int rank
    int anchorPriority
    bool lineVisibleAtLiveEdge

//@type Buffered right-edge label awaiting cluster composition.
export type PendingLabel
    float price
    int xPos
    int recencyTime
    string touchKey
    LabelIdentity labelIdentity
    string pricePart
    bool wantPrice
    bool hitTrace
    color textColor
    color bgColor
    int textSize
    int rank
    int effectiveLineWidth
    line activeLine
    line primaryLine
    color primaryLineColor
    line continuationLine
    color continuationLineColor
    line carrierLine
    color carrierLineColor

//@type Buffered swept reminder awaiting cluster composition.
export type PendingReminder
    float price
    int endTime
    LabelIdentity labelIdentity
    color textColor
    color bgColor
    int textSize
    string levelName
    int rank
    int effectiveLineWidth

//@type Buffered active-anchor reminder awaiting cluster composition.
export type PendingAnchorReminder
    float price
    int anchorEndTime
    int runEndTime
    LabelIdentity labelIdentity
    color textColor
    color bgColor
    int textSize
    string levelName
    int rank
    int effectiveLineWidth

//@type Host-owned presentation settings required by the interaction compositor.
export type PresentationConfig
    float mergeDistancePercent
    float minimumTick
    int maxLabels
    string nameSeparator
    string brandBullet
    int mergedLineFadePercent
    string sizeTiny
    string sizeNormal
    string sizeLarge
    string sizeHuge
    int anchorReminderSpacingMs
    int anchorReminderMaxPerLevel
    int sweptReminderBaseMs
    int sweptReminderMaxPerLine
    string valueAreaHighName
    string valueAreaLowName
    string unselectedAnchorSymbol
    string archivedSymbol
    string firstHitSymbol
    string fromAboveSymbol
    string fromBelowSymbol
    string fromAboveText
    string fromBelowText
    string newYorkTimezone
    int currentTime
    int currentBarIndex

//@type Host-owned Touch Marker retention policy.
export type HitTracePolicy
    bool presentationActive
    bool currentWindowOnly
    int retentionDays
    int referenceDateSerial
    bool twentyFourSevenAsset
    string utcTimezone
    int millisecondsPerDay
    int maxTradingDayScan
    int maxWeekdayRetentionDays

identityPrecedes(int candidateWidth, int candidateRank, int candidateOrder, int currentWidth, int currentRank, int currentOrder) =>
    candidateWidth > currentWidth or (candidateWidth == currentWidth and (candidateRank > currentRank or (candidateRank == currentRank and candidateOrder < currentOrder)))

prioritizedIdentityPrecedes(int candidatePriority, int candidateWidth, int candidateRank, int candidateOrder, int currentPriority, int currentWidth, int currentRank, int currentOrder) =>
    candidatePriority > currentPriority or (candidatePriority == currentPriority and identityPrecedes(candidateWidth, candidateRank, candidateOrder, currentWidth, currentRank, currentOrder))

// Text follows semantic rank; carrier dominance remains width-first.
textIdentityPrecedes(int candidatePriority, int candidateRank, int candidateWidth, int candidateOrder, int currentPriority, int currentRank, int currentWidth, int currentOrder) =>
    candidatePriority > currentPriority or (candidatePriority == currentPriority and (candidateRank > currentRank or (candidateRank == currentRank and (candidateWidth > currentWidth or (candidateWidth == currentWidth and candidateOrder < currentOrder)))))

labelMergeTolerance(float price, PresentationConfig config) =>
    math.max(config.minimumTick, math.abs(price) * config.mergeDistancePercent / 100.0)

nearestLabelCluster(float price, bool dedupe, array<float> clusterPrices, PresentationConfig config) =>
    int foundIndex = -1
    float tolerance = labelMergeTolerance(price, config)
    float minDistance = tolerance + config.minimumTick
    if dedupe and array.size(clusterPrices) > 0
        for clusterIndex = 0 to array.size(clusterPrices) - 1
            float distance = math.abs(array.get(clusterPrices, clusterIndex) - price)
            if distance <= tolerance and distance < minDistance
                minDistance := distance
                foundIndex := clusterIndex
    foundIndex

newestUnusedIndex(array<int> recencyTimes, array<bool> used) =>
    int newestIndex = -1
    int newestTime = -1
    if array.size(recencyTimes) > 0
        for candidateIndex = 0 to array.size(recencyTimes) - 1
            int candidateTime = array.get(recencyTimes, candidateIndex)
            if not array.get(used, candidateIndex) and (newestIndex < 0 or candidateTime > newestTime)
                newestIndex := candidateIndex
                newestTime := candidateTime
    newestIndex

orderedClusterIdentityIndices(int clusterIndex, int fallbackOrder, array<int> identityCluster, array<int> identityPriority, array<int> identityWidth, array<int> identityRank, array<int> identityOrder) =>
    int clusterIdentityCount = 0
    if array.size(identityCluster) > 0
        for identityIndex = 0 to array.size(identityCluster) - 1
            if array.get(identityCluster, identityIndex) == clusterIndex
                clusterIdentityCount += 1
    array<bool> identityUsed = array.new<bool>(array.size(identityCluster), false)
    array<int> orderedIndices = array.new<int>()
    if clusterIdentityCount > 0
        for identityPosition = 1 to clusterIdentityCount
            int bestIdentityIndex = -1
            int bestPriority = -1
            int bestWidth = -1
            int bestRank = -1
            int bestOrder = fallbackOrder
            for identityIndex = 0 to array.size(identityCluster) - 1
                if array.get(identityCluster, identityIndex) == clusterIndex and not array.get(identityUsed, identityIndex)
                    int candidatePriority = array.get(identityPriority, identityIndex)
                    int candidateWidth = array.get(identityWidth, identityIndex)
                    int candidateRank = array.get(identityRank, identityIndex)
                    int candidateOrder = array.get(identityOrder, identityIndex)
                    if textIdentityPrecedes(candidatePriority, candidateRank, candidateWidth, candidateOrder, bestPriority, bestRank, bestWidth, bestOrder)
                        bestIdentityIndex := identityIndex
                        bestPriority := candidatePriority
                        bestWidth := candidateWidth
                        bestRank := candidateRank
                        bestOrder := candidateOrder
            if bestIdentityIndex >= 0
                array.push(orderedIndices, bestIdentityIndex)
                array.set(identityUsed, bestIdentityIndex, true)
    orderedIndices

orderedClusterIdentities(int clusterIndex, string separator, int fallbackOrder, array<int> identityCluster, array<string> identityName, array<int> identityPriority, array<int> identityWidth, array<int> identityRank, array<int> identityOrder) =>
    string body = ""
    array<int> orderedIndices = orderedClusterIdentityIndices(clusterIndex, fallbackOrder, identityCluster, identityPriority, identityWidth, identityRank, identityOrder)
    if array.size(orderedIndices) > 0
        for orderedPosition = 0 to array.size(orderedIndices) - 1
            string nextName = array.get(identityName, array.get(orderedIndices, orderedPosition))
            body := body == "" ? nextName : body + separator + nextName
    body

labelIdentityWithSuffix(LabelIdentity identity, string extraSuffix) =>
    LabelIdentity.new(identity.fullText + extraSuffix, identity.anchorName, identity.compactProfilePrefix, identity.levelName, identity.periodText, identity.periodContextKey, identity.periodMember, identity.compactContextAfterMembers, identity.compactSuffix + extraSuffix, identity.datedProfile)

shortenedGroupKey(LabelIdentity identity, int identityIndex) =>
    identity.datedProfile and identity.levelName != "" and identity.anchorName != "" ? "D|" + identity.levelName + "|" + identity.anchorName : "S|" + str.tostring(identityIndex)

shortenedGroupText(int groupIndex, array<int> orderedIndices, array<int> orderedGroups, array<LabelIdentity> identities) =>
    int firstIdentityIndex = -1
    int groupMemberCount = 0
    string sharedContextKey = ""
    bool sharedContext = true
    for orderedPosition = 0 to array.size(orderedIndices) - 1
        if array.get(orderedGroups, orderedPosition) == groupIndex
            groupMemberCount += 1
            int identityIndex = array.get(orderedIndices, orderedPosition)
            LabelIdentity identity = array.get(identities, identityIndex)
            if firstIdentityIndex < 0
                firstIdentityIndex := identityIndex
                sharedContextKey := identity.periodContextKey
                sharedContext := identity.datedProfile and identity.periodContextKey != "" and identity.periodMember != ""
            else if identity.periodContextKey != sharedContextKey or identity.periodMember == ""
                sharedContext := false
    LabelIdentity first = array.get(identities, firstIdentityIndex)
    string body = ""
    if first.datedProfile
        body := first.compactProfilePrefix + " " + first.levelName + " "
        if groupMemberCount == 1
            body += first.periodText + first.compactSuffix
        else if sharedContext
            bool firstMember = true
            if not first.compactContextAfterMembers
                body += sharedContextKey + " "
            for orderedPosition = 0 to array.size(orderedIndices) - 1
                if array.get(orderedGroups, orderedPosition) == groupIndex
                    LabelIdentity identity = array.get(identities, array.get(orderedIndices, orderedPosition))
                    body += (firstMember ? "" : ", ") + identity.periodMember + identity.compactSuffix
                    firstMember := false
            if first.compactContextAfterMembers
                body += " " + sharedContextKey
        else
            bool firstMember = true
            for orderedPosition = 0 to array.size(orderedIndices) - 1
                if array.get(orderedGroups, orderedPosition) == groupIndex
                    LabelIdentity identity = array.get(identities, array.get(orderedIndices, orderedPosition))
                    body += (firstMember ? "" : ", ") + identity.periodText + identity.compactSuffix
                    firstMember := false
    else
        body := first.compactProfilePrefix + " " + first.levelName + first.compactSuffix
    body

shortenedClusterIdentities(int clusterIndex, string separator, int fallbackOrder, array<int> identityCluster, array<LabelIdentity> identities, array<int> identityPriority, array<int> identityWidth, array<int> identityRank, array<int> identityOrder) =>
    string body = ""
    array<int> orderedIndices = orderedClusterIdentityIndices(clusterIndex, fallbackOrder, identityCluster, identityPriority, identityWidth, identityRank, identityOrder)
    array<string> groupKeys = array.new<string>()
    array<int> orderedGroups = array.new<int>()
    if array.size(orderedIndices) > 0
        for orderedPosition = 0 to array.size(orderedIndices) - 1
            int identityIndex = array.get(orderedIndices, orderedPosition)
            LabelIdentity identity = array.get(identities, identityIndex)
            string groupKey = shortenedGroupKey(identity, identityIndex)
            int groupIndex = -1
            if array.size(groupKeys) > 0
                for candidateGroup = 0 to array.size(groupKeys) - 1
                    if array.get(groupKeys, candidateGroup) == groupKey
                        groupIndex := candidateGroup
                        break
            if groupIndex < 0
                array.push(groupKeys, groupKey)
                groupIndex := array.size(groupKeys) - 1
            array.push(orderedGroups, groupIndex)
        for groupIndex = 0 to array.size(groupKeys) - 1
            string nextText = shortenedGroupText(groupIndex, orderedIndices, orderedGroups, identities)
            body := body == "" ? nextText : body + separator + nextText
    body

composedClusterIdentities(bool shortenLabels, int clusterIndex, string separator, int fallbackOrder, array<int> identityCluster, array<string> identityName, array<LabelIdentity> identityLabel, array<int> identityPriority, array<int> identityWidth, array<int> identityRank, array<int> identityOrder) =>
    shortenLabels ? shortenedClusterIdentities(clusterIndex, separator, fallbackOrder, identityCluster, identityLabel, identityPriority, identityWidth, identityRank, identityOrder) : orderedClusterIdentities(clusterIndex, separator, fallbackOrder, identityCluster, identityName, identityPriority, identityWidth, identityRank, identityOrder)

largerTextSize(int a, int b) =>
    math.max(a, b)

export toLabelSize(string sizeName, string sizeTiny, string sizeNormal, string sizeLarge, string sizeHuge) =>
    sizeName == sizeTiny ? size.tiny : sizeName == sizeNormal ? size.normal : sizeName == sizeLarge ? size.large : sizeName == sizeHuge ? size.huge : size.small

export fadeColor(color baseColor, float fadeFraction) =>
    color.new(baseColor, 100 - (100 - color.t(baseColor)) * (1 - fadeFraction))

mergedLineColor(color baseColor, int transparency) =>
    color.new(baseColor, math.max(int(color.t(baseColor)), transparency))

export trackLabel(array<label> drawnLabels, int maxLabels, label drawing) =>
    bool retained = array.size(drawnLabels) < maxLabels
    if retained
        array.push(drawnLabels, drawing)
    else
        label.delete(drawing)
    retained

export reminderPlacements(int runMs, int spacingMs, int maxCount) =>
    math.min(maxCount, math.max(1, int(math.floor(math.sqrt(float(runMs) / math.max(1, spacingMs))))))

sameDate(int firstTime, int secondTime, string timezone) =>
    year(firstTime, timezone) == year(secondTime, timezone) and month(firstTime, timezone) == month(secondTime, timezone) and dayofmonth(firstTime, timezone) == dayofmonth(secondTime, timezone)

calendarDateSerial(int eventTime, string timezone, string utcTimezone, int millisecondsPerDay) =>
    int dateTimestamp = timestamp(utcTimezone, year(eventTime, timezone), month(eventTime, timezone), dayofmonth(eventTime, timezone), 0, 0)
    int(dateTimestamp / millisecondsPerDay)

export weekdayDistance(int firstDateSerial, int secondDateSerial, string utcTimezone, int millisecondsPerDay, int maxTradingDayScan, int maxWeekdayRetentionDays) =>
    int calendarSpan = math.max(0, secondDateSerial - firstDateSerial)
    int tradingDays = calendarSpan > maxTradingDayScan ? maxWeekdayRetentionDays : 0
    if calendarSpan > 0 and calendarSpan <= maxTradingDayScan
        for dayOffset = 1 to calendarSpan
            int weekday = dayofweek((firstDateSerial + dayOffset) * millisecondsPerDay, utcTimezone)
            if weekday >= dayofweek.monday and weekday <= dayofweek.friday
                tradingDays += 1
    tradingDays

eventActive(int hitTime, PresentationConfig config, HitTracePolicy policy) =>
    bool active = false
    if policy.presentationActive and not na(hitTime)
        int hitDateSerial = calendarDateSerial(hitTime, config.newYorkTimezone, policy.utcTimezone, policy.millisecondsPerDay)
        int dayDistance = policy.twentyFourSevenAsset ? math.max(0, policy.referenceDateSerial - hitDateSerial) : weekdayDistance(hitDateSerial, policy.referenceDateSerial, policy.utcTimezone, policy.millisecondsPerDay, policy.maxTradingDayScan, policy.maxWeekdayRetentionDays)
        active := policy.currentWindowOnly ? sameDate(hitTime, config.currentTime, config.newYorkTimezone) : dayDistance < policy.retentionDays
    active

levelHitArchivedSwept(LevelHitEvent hitEvent, LevelHitPresentation presentation) =>
    hitEvent.archivedSwept and not presentation.lineVisibleAtLiveEdge

//@function Composes nearby right-edge labels and fades secondary line paths.
export flushPendingLabels(array<PendingLabel> pendingLabels, bool dedupe, bool shortenLabels, map<string, int> touchClusters, map<int, LevelHitPresentation> touchGroupPresentations, map<int, int> firstHitDirections, array<label> drawnLabels, PresentationConfig config) =>
    int pendingCount = array.size(pendingLabels)
    if pendingCount > 0
        map<int, int> touchGroupLabelClusters = map.new<int, int>()
        array<float> clusterPrice = array.new<float>()
        array<bool> clusterWantPrice = array.new<bool>()
        array<bool> clusterHitTrace = array.new<bool>()
        array<string> clusterPriceText = array.new<string>()
        array<color> clusterColor = array.new<color>()
        array<color> clusterBg = array.new<color>()
        array<int> clusterSize = array.new<int>()
        array<int> clusterX = array.new<int>()
        array<int> clusterRecencyTime = array.new<int>()
        array<int> clusterDominantWidth = array.new<int>()
        array<int> clusterDominantRank = array.new<int>()
        array<int> clusterDominantOrder = array.new<int>()
        array<int> clusterDominantPending = array.new<int>()
        array<bool> clusterDominantHasActiveLine = array.new<bool>()
        array<int> clusterDominantTouchGroup = array.new<int>()
        array<bool> clusterFirstHit = array.new<bool>()
        array<int> clusterFirstHitDirection = array.new<int>()
        array<int> pendingCluster = array.new<int>(pendingCount, -1)
        array<int> identityCluster = array.new<int>()
        array<string> identityName = array.new<string>()
        array<LabelIdentity> identityLabel = array.new<LabelIdentity>()
        array<int> identityPriority = array.new<int>()
        array<int> identityWidth = array.new<int>()
        array<int> identityRank = array.new<int>()
        array<int> identityOrder = array.new<int>()
        for pendingIndex = 0 to pendingCount - 1
            PendingLabel pending = array.get(pendingLabels, pendingIndex)
            int touchGroup = pending.touchKey != "" and map.contains(touchClusters, pending.touchKey) ? map.get(touchClusters, pending.touchKey) : -1
            bool firstHit = touchGroup >= 0 and map.contains(firstHitDirections, touchGroup)
            int firstHitDirection = firstHit ? map.get(firstHitDirections, touchGroup) : 0
            // Preserve the original merge decision for every preset, Custom percentage and Merge Off.
            int foundIndex = touchGroup >= 0 and map.contains(touchGroupLabelClusters, touchGroup) ? map.get(touchGroupLabelClusters, touchGroup) : nearestLabelCluster(pending.price, dedupe, clusterPrice, config)
            if foundIndex >= 0
                array.set(clusterRecencyTime, foundIndex, math.max(array.get(clusterRecencyTime, foundIndex), pending.recencyTime))
                array.set(clusterWantPrice, foundIndex, array.get(clusterWantPrice, foundIndex) or pending.wantPrice)
                array.set(clusterHitTrace, foundIndex, array.get(clusterHitTrace, foundIndex) or pending.hitTrace)
                array.set(clusterSize, foundIndex, largerTextSize(array.get(clusterSize, foundIndex), pending.textSize))
                if firstHit
                    bool clusterAlreadyFirstHit = array.get(clusterFirstHit, foundIndex)
                    int mergedFirstHitDirection = clusterAlreadyFirstHit and array.get(clusterFirstHitDirection, foundIndex) != firstHitDirection ? 0 : firstHitDirection
                    array.set(clusterFirstHit, foundIndex, true)
                    array.set(clusterFirstHitDirection, foundIndex, mergedFirstHitDirection)
                bool pendingHasActiveLine = not na(pending.activeLine)
                bool dominantHasActiveLine = array.get(clusterDominantHasActiveLine, foundIndex)
                bool pendingPrecedes = (pendingHasActiveLine and not dominantHasActiveLine) or (pendingHasActiveLine == dominantHasActiveLine and identityPrecedes(pending.effectiveLineWidth, pending.rank, pendingIndex, array.get(clusterDominantWidth, foundIndex), array.get(clusterDominantRank, foundIndex), array.get(clusterDominantOrder, foundIndex)))
                if pendingPrecedes
                    array.set(clusterColor, foundIndex, pending.textColor)
                    array.set(clusterBg, foundIndex, pending.bgColor)
                    array.set(clusterPrice, foundIndex, pending.price)
                    array.set(clusterPriceText, foundIndex, pending.pricePart)
                    array.set(clusterX, foundIndex, pending.xPos)
                    array.set(clusterDominantWidth, foundIndex, pending.effectiveLineWidth)
                    array.set(clusterDominantRank, foundIndex, pending.rank)
                    array.set(clusterDominantOrder, foundIndex, pendingIndex)
                    array.set(clusterDominantPending, foundIndex, pendingIndex)
                    array.set(clusterDominantHasActiveLine, foundIndex, pendingHasActiveLine)
                if pending.hitTrace and touchGroup >= 0 and map.contains(touchGroupPresentations, touchGroup)
                    int dominantTouchGroup = array.get(clusterDominantTouchGroup, foundIndex)
                    LevelHitPresentation touchPresentation = map.get(touchGroupPresentations, touchGroup)
                    bool touchPresentationPrecedes = dominantTouchGroup < 0
                    if dominantTouchGroup >= 0
                        LevelHitPresentation dominantTouchPresentation = map.get(touchGroupPresentations, dominantTouchGroup)
                        touchPresentationPrecedes := prioritizedIdentityPrecedes(touchPresentation.anchorPriority, touchPresentation.effectiveLineWidth, touchPresentation.rank, touchGroup, dominantTouchPresentation.anchorPriority, dominantTouchPresentation.effectiveLineWidth, dominantTouchPresentation.rank, dominantTouchGroup)
                    if touchPresentationPrecedes
                        array.set(clusterDominantTouchGroup, foundIndex, touchGroup)
            else
                array.push(clusterPrice, pending.price)
                array.push(clusterWantPrice, pending.wantPrice)
                array.push(clusterHitTrace, pending.hitTrace)
                array.push(clusterPriceText, pending.pricePart)
                array.push(clusterColor, pending.textColor)
                array.push(clusterBg, pending.bgColor)
                array.push(clusterSize, pending.textSize)
                array.push(clusterX, pending.xPos)
                array.push(clusterRecencyTime, pending.recencyTime)
                array.push(clusterDominantWidth, pending.effectiveLineWidth)
                array.push(clusterDominantRank, pending.rank)
                array.push(clusterDominantOrder, pendingIndex)
                array.push(clusterDominantPending, pendingIndex)
                array.push(clusterDominantHasActiveLine, not na(pending.activeLine))
                array.push(clusterDominantTouchGroup, pending.hitTrace and touchGroup >= 0 and map.contains(touchGroupPresentations, touchGroup) ? touchGroup : -1)
                array.push(clusterFirstHit, firstHit)
                array.push(clusterFirstHitDirection, firstHitDirection)
                foundIndex := array.size(clusterPrice) - 1
            if touchGroup >= 0
                map.put(touchGroupLabelClusters, touchGroup, foundIndex)
            array.set(pendingCluster, pendingIndex, foundIndex)
            if pending.labelIdentity.fullText != ""
                array.push(identityCluster, foundIndex)
                array.push(identityName, pending.labelIdentity.fullText)
                array.push(identityLabel, pending.labelIdentity)
                array.push(identityPriority, 0)
                array.push(identityWidth, pending.effectiveLineWidth)
                array.push(identityRank, pending.rank)
                array.push(identityOrder, pendingIndex)
        if dedupe and config.mergedLineFadePercent > 0
            for pendingIndex = 0 to pendingCount - 1
                int clusterIndex = array.get(pendingCluster, pendingIndex)
                if pendingIndex != array.get(clusterDominantPending, clusterIndex)
                    PendingLabel pending = array.get(pendingLabels, pendingIndex)
                    if not na(pending.activeLine)
                        if not na(pending.primaryLine)
                            line.set_color(pending.primaryLine, mergedLineColor(pending.primaryLineColor, config.mergedLineFadePercent))
                        if not na(pending.continuationLine)
                            line.set_color(pending.continuationLine, mergedLineColor(pending.continuationLineColor, config.mergedLineFadePercent))
                        if not na(pending.carrierLine)
                            line.set_color(pending.carrierLine, mergedLineColor(pending.carrierLineColor, config.mergedLineFadePercent))
        int clusterCount = array.size(clusterPrice)
        array<bool> clusterRendered = array.new<bool>(clusterCount, false)
        for renderPosition = 0 to clusterCount - 1
            if array.size(drawnLabels) >= config.maxLabels
                break
            int clusterIndex = newestUnusedIndex(clusterRecencyTime, clusterRendered)
            if clusterIndex >= 0
                array.set(clusterRendered, clusterIndex, true)
                string body = composedClusterIdentities(shortenLabels, clusterIndex, config.nameSeparator, pendingCount, identityCluster, identityName, identityLabel, identityPriority, identityWidth, identityRank, identityOrder)
                string labelText = array.get(clusterWantPrice, clusterIndex) ? (body == "" ? array.get(clusterPriceText, clusterIndex) : body + " " + config.brandBullet + " " + array.get(clusterPriceText, clusterIndex)) : body
                int firstHitDirection = array.get(clusterFirstHitDirection, clusterIndex)
                string directionSymbol = firstHitDirection < 0 ? config.fromAboveSymbol : firstHitDirection > 0 ? config.fromBelowSymbol : ""
                string firstHitBadge = config.firstHitSymbol + (directionSymbol != "" ? " " + directionSymbol : "")
                string hitPrefix = "●" + (array.get(clusterFirstHit, clusterIndex) ? " " + firstHitBadge : "") + " "
                string finalText = array.get(clusterHitTrace, clusterIndex) ? hitPrefix + labelText : labelText
                color finalTextColor = array.get(clusterColor, clusterIndex)
                int finalTextSize = array.get(clusterSize, clusterIndex)
                int dominantTouchGroup = array.get(clusterDominantTouchGroup, clusterIndex)
                // Temporary hit labels reuse the winning anchor's native label styling.
                if array.get(clusterHitTrace, clusterIndex) and dominantTouchGroup >= 0 and map.contains(touchGroupPresentations, dominantTouchGroup)
                    LevelHitPresentation touchPresentation = map.get(touchGroupPresentations, dominantTouchGroup)
                    finalTextColor := touchPresentation.labelColor
                    finalTextSize := touchPresentation.labelSize
                trackLabel(drawnLabels, config.maxLabels, label.new(array.get(clusterX, clusterIndex), array.get(clusterPrice, clusterIndex), finalText, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, textcolor=finalTextColor, size=finalTextSize, color=array.get(clusterBg, clusterIndex)))
        array.clear(pendingLabels)
    true

//@function Composes active-anchor reminder labels.
export flushPendingAnchorReminders(array<PendingAnchorReminder> pendingReminders, bool dedupe, bool shortenLabels, array<label> drawnLabels, PresentationConfig config) =>
    int pendingCount = array.size(pendingReminders)
    if pendingCount > 0
        array<float> clusterPrice = array.new<float>()
        array<int> clusterAnchorEndTime = array.new<int>()
        array<int> clusterRunEndTime = array.new<int>()
        array<color> clusterColor = array.new<color>()
        array<color> clusterBg = array.new<color>()
        array<int> clusterSize = array.new<int>()
        array<string> clusterLevelName = array.new<string>()
        array<int> clusterDominantWidth = array.new<int>()
        array<int> clusterDominantRank = array.new<int>()
        array<int> clusterDominantOrder = array.new<int>()
        array<int> identityCluster = array.new<int>()
        array<string> identityName = array.new<string>()
        array<LabelIdentity> identityLabel = array.new<LabelIdentity>()
        array<int> identityPriority = array.new<int>()
        array<int> identityWidth = array.new<int>()
        array<int> identityRank = array.new<int>()
        array<int> identityOrder = array.new<int>()
        for reminderIndex = 0 to pendingCount - 1
            PendingAnchorReminder pending = array.get(pendingReminders, reminderIndex)
            int foundIndex = nearestLabelCluster(pending.price, dedupe, clusterPrice, config)
            if foundIndex >= 0
                array.set(clusterSize, foundIndex, largerTextSize(array.get(clusterSize, foundIndex), pending.textSize))
                if identityPrecedes(pending.effectiveLineWidth, pending.rank, reminderIndex, array.get(clusterDominantWidth, foundIndex), array.get(clusterDominantRank, foundIndex), array.get(clusterDominantOrder, foundIndex))
                    array.set(clusterPrice, foundIndex, pending.price)
                    array.set(clusterAnchorEndTime, foundIndex, pending.anchorEndTime)
                    array.set(clusterRunEndTime, foundIndex, pending.runEndTime)
                    array.set(clusterColor, foundIndex, pending.textColor)
                    array.set(clusterBg, foundIndex, pending.bgColor)
                    array.set(clusterLevelName, foundIndex, pending.levelName)
                    array.set(clusterDominantWidth, foundIndex, pending.effectiveLineWidth)
                    array.set(clusterDominantRank, foundIndex, pending.rank)
                    array.set(clusterDominantOrder, foundIndex, reminderIndex)
            else
                array.push(clusterPrice, pending.price)
                array.push(clusterAnchorEndTime, pending.anchorEndTime)
                array.push(clusterRunEndTime, pending.runEndTime)
                array.push(clusterColor, pending.textColor)
                array.push(clusterBg, pending.bgColor)
                array.push(clusterSize, pending.textSize)
                array.push(clusterLevelName, pending.levelName)
                array.push(clusterDominantWidth, pending.effectiveLineWidth)
                array.push(clusterDominantRank, pending.rank)
                array.push(clusterDominantOrder, reminderIndex)
                foundIndex := array.size(clusterPrice) - 1
            array.push(identityCluster, foundIndex)
            array.push(identityName, pending.labelIdentity.fullText)
            array.push(identityLabel, pending.labelIdentity)
            array.push(identityPriority, 0)
            array.push(identityWidth, pending.effectiveLineWidth)
            array.push(identityRank, pending.rank)
            array.push(identityOrder, reminderIndex)
        for clusterIndex = 0 to array.size(clusterPrice) - 1
            int reminderRunStart = array.get(clusterAnchorEndTime, clusterIndex) + config.anchorReminderSpacingMs
            int reminderRunEnd = math.min(array.get(clusterRunEndTime, clusterIndex), config.currentTime - config.anchorReminderSpacingMs)
            int eligibleRunMs = reminderRunEnd - reminderRunStart
            if eligibleRunMs > 0
                int reminderCount = reminderPlacements(eligibleRunMs, config.anchorReminderSpacingMs, config.anchorReminderMaxPerLevel)
                string levelName = array.get(clusterLevelName, clusterIndex)
                float levelFrac = levelName == config.valueAreaHighName ? 0.5 : levelName == config.valueAreaLowName ? 0.85 : 0.15
                string reminderText = composedClusterIdentities(shortenLabels, clusterIndex, config.nameSeparator, pendingCount, identityCluster, identityName, identityLabel, identityPriority, identityWidth, identityRank, identityOrder)
                for placement = 1 to reminderCount
                    int reminderTime = reminderRunStart + int(eligibleRunMs * (placement - 1 + levelFrac) / reminderCount)
                    trackLabel(drawnLabels, config.maxLabels, label.new(reminderTime, array.get(clusterPrice, clusterIndex), reminderText, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, textcolor=array.get(clusterColor, clusterIndex), size=array.get(clusterSize, clusterIndex), color=array.get(clusterBg, clusterIndex)))
        array.clear(pendingReminders)
    true

//@function Composes swept reminder labels.
export flushPendingReminders(array<PendingReminder> pendingReminders, bool dedupe, bool shortenLabels, array<label> drawnLabels, PresentationConfig config) =>
    int reminderCount = array.size(pendingReminders)
    if reminderCount > 0
        array<float> clusterPrice = array.new<float>()
        array<int> clusterEndTime = array.new<int>()
        array<color> clusterColor = array.new<color>()
        array<color> clusterBg = array.new<color>()
        array<int> clusterSize = array.new<int>()
        array<string> clusterLevelName = array.new<string>()
        array<int> clusterDominantWidth = array.new<int>()
        array<int> clusterDominantRank = array.new<int>()
        array<int> clusterDominantOrder = array.new<int>()
        array<int> identityCluster = array.new<int>()
        array<string> identityName = array.new<string>()
        array<LabelIdentity> identityLabel = array.new<LabelIdentity>()
        array<int> identityPriority = array.new<int>()
        array<int> identityWidth = array.new<int>()
        array<int> identityRank = array.new<int>()
        array<int> identityOrder = array.new<int>()
        for reminderIndex = 0 to reminderCount - 1
            PendingReminder pending = array.get(pendingReminders, reminderIndex)
            int foundIndex = nearestLabelCluster(pending.price, dedupe, clusterPrice, config)
            if foundIndex >= 0
                array.set(clusterEndTime, foundIndex, math.min(array.get(clusterEndTime, foundIndex), pending.endTime))
                array.set(clusterSize, foundIndex, largerTextSize(array.get(clusterSize, foundIndex), pending.textSize))
                if identityPrecedes(pending.effectiveLineWidth, pending.rank, reminderIndex, array.get(clusterDominantWidth, foundIndex), array.get(clusterDominantRank, foundIndex), array.get(clusterDominantOrder, foundIndex))
                    array.set(clusterColor, foundIndex, pending.textColor)
                    array.set(clusterBg, foundIndex, pending.bgColor)
                    array.set(clusterLevelName, foundIndex, pending.levelName)
                    array.set(clusterPrice, foundIndex, pending.price)
                    array.set(clusterDominantWidth, foundIndex, pending.effectiveLineWidth)
                    array.set(clusterDominantRank, foundIndex, pending.rank)
                    array.set(clusterDominantOrder, foundIndex, reminderIndex)
            else
                array.push(clusterPrice, pending.price)
                array.push(clusterEndTime, pending.endTime)
                array.push(clusterColor, pending.textColor)
                array.push(clusterBg, pending.bgColor)
                array.push(clusterSize, pending.textSize)
                array.push(clusterLevelName, pending.levelName)
                array.push(clusterDominantWidth, pending.effectiveLineWidth)
                array.push(clusterDominantRank, pending.rank)
                array.push(clusterDominantOrder, reminderIndex)
                foundIndex := array.size(clusterPrice) - 1
            array.push(identityCluster, foundIndex)
            array.push(identityName, pending.labelIdentity.fullText)
            array.push(identityLabel, pending.labelIdentity)
            array.push(identityPriority, 0)
            array.push(identityWidth, pending.effectiveLineWidth)
            array.push(identityRank, pending.rank)
            array.push(identityOrder, reminderIndex)
        for clusterIndex = 0 to array.size(clusterPrice) - 1
            int endTime = array.get(clusterEndTime, clusterIndex)
            int sweptRunMs = (config.currentTime - config.sweptReminderBaseMs) - endTime
            if sweptRunMs > 0
                int runReminderCount = reminderPlacements(sweptRunMs, config.sweptReminderBaseMs, config.sweptReminderMaxPerLine)
                string levelName = array.get(clusterLevelName, clusterIndex)
                float levelFrac = levelName == config.valueAreaHighName ? 0.4 : levelName == config.valueAreaLowName ? 0.6 : 0.2
                float price = array.get(clusterPrice, clusterIndex)
                string reminderText = composedClusterIdentities(shortenLabels, clusterIndex, config.nameSeparator, reminderCount, identityCluster, identityName, identityLabel, identityPriority, identityWidth, identityRank, identityOrder)
                color textColor = array.get(clusterColor, clusterIndex)
                color bgColor = array.get(clusterBg, clusterIndex)
                int textSize = array.get(clusterSize, clusterIndex)
                for placement = 1 to runReminderCount
                    int reminderTime = endTime + int(sweptRunMs * (placement - 1 + levelFrac) / runReminderCount)
                    trackLabel(drawnLabels, config.maxLabels, label.new(reminderTime, price, reminderText, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, textcolor=textColor, size=textSize, color=bgColor))
        array.clear(pendingReminders)
    true

//@function Removes expired or orphaned Touch Marker events.
export pruneLevelHitEvents(array<LevelHitEvent> events, map<string, bool> retainedSourceProfiles, PresentationConfig config, HitTracePolicy policy) =>
    if not policy.presentationActive
        array.clear(events)
    else if array.size(events) > 0
        for eventIndex = array.size(events) - 1 to 0
            LevelHitEvent hitEvent = array.get(events, eventIndex)
            bool sourceProfileRetained = map.contains(retainedSourceProfiles, hitEvent.sourceProfileKey)
            if not eventActive(hitEvent.hitTime, config, policy) or not sourceProfileRetained
                array.remove(events, eventIndex)
    true

//@function Registers archived hit levels that need a visible continuation.
export registerArchivedLevelHitKeys(array<LevelHitEvent> events, map<string, LevelHitPresentation> presentations, map<string, bool> archivedLevelHitKeys, PresentationConfig config) =>
    map.clear(archivedLevelHitKeys)
    if array.size(events) > 0
        for eventIndex = 0 to array.size(events) - 1
            LevelHitEvent hitEvent = array.get(events, eventIndex)
            if sameDate(hitEvent.hitTime, config.currentTime, config.newYorkTimezone) and map.contains(presentations, hitEvent.key) and levelHitArchivedSwept(hitEvent, map.get(presentations, hitEvent.key))
                map.put(archivedLevelHitKeys, hitEvent.key, true)
    true

//@function Assigns visible same-candle hits to shared marker groups.
export levelHitEventGroups(array<LevelHitEvent> events, map<string, bool> renderedLevelHitKeys, map<string, LevelHitPresentation> presentations, PresentationConfig config, HitTracePolicy policy) =>
    int eventCount = array.size(events)
    array<int> eventGroups = array.new<int>(eventCount, -1)
    array<int> groupBarTimes = array.new<int>()
    array<float> groupPrices = array.new<float>()
    if policy.presentationActive and eventCount > 0
        for eventIndex = 0 to eventCount - 1
            LevelHitEvent hitEvent = array.get(events, eventIndex)
            bool focusSourceVisible = not hitEvent.focusOnly or map.contains(renderedLevelHitKeys, hitEvent.key)
            if eventActive(hitEvent.hitTime, config, policy) and focusSourceVisible and map.contains(presentations, hitEvent.key)
                int groupIndex = -1
                float tolerance = labelMergeTolerance(hitEvent.price, config)
                if array.size(groupBarTimes) > 0
                    for candidateIndex = 0 to array.size(groupBarTimes) - 1
                        bool sameCandle = array.get(groupBarTimes, candidateIndex) == hitEvent.barTime
                        bool samePrice = math.abs(array.get(groupPrices, candidateIndex) - hitEvent.price) <= tolerance
                        if sameCandle and samePrice
                            groupIndex := candidateIndex
                            break
                if groupIndex < 0
                    array.push(groupBarTimes, hitEvent.barTime)
                    array.push(groupPrices, hitEvent.price)
                    groupIndex := array.size(groupBarTimes) - 1
                array.set(eventGroups, eventIndex, groupIndex)
    eventGroups

//@function Registers the approach direction of the earliest current-window Touch Marker cluster.
export registerFirstLevelHitDirections(array<LevelHitEvent> events, array<int> eventGroups, map<int, int> firstHitDirections, PresentationConfig config) =>
    map.clear(firstHitDirections)
    int eventCount = array.size(events)
    if eventCount > 0
        array<int> groupContactTimes = array.new<int>(eventCount, na)
        array<int> groupDirections = array.new<int>(eventCount, 0)
        int earliestContactTime = na
        for eventIndex = 0 to eventCount - 1
            int groupIndex = array.get(eventGroups, eventIndex)
            LevelHitEvent hitEvent = array.get(events, eventIndex)
            if groupIndex >= 0 and sameDate(hitEvent.contactTime, config.currentTime, config.newYorkTimezone)
                int groupContactTime = array.get(groupContactTimes, groupIndex)
                if na(groupContactTime) or hitEvent.contactTime < groupContactTime
                    array.set(groupContactTimes, groupIndex, hitEvent.contactTime)
                    array.set(groupDirections, groupIndex, hitEvent.approachDirection)
                else if hitEvent.contactTime == groupContactTime and hitEvent.approachDirection != array.get(groupDirections, groupIndex)
                    array.set(groupDirections, groupIndex, 0)
                earliestContactTime := na(earliestContactTime) ? hitEvent.contactTime : math.min(earliestContactTime, hitEvent.contactTime)
        if not na(earliestContactTime)
            for groupIndex = 0 to eventCount - 1
                if array.get(groupContactTimes, groupIndex) == earliestContactTime
                    map.put(firstHitDirections, groupIndex, array.get(groupDirections, groupIndex))
    true

//@function Maps each visible level identity to its shared marker group.
export registerLevelHitLabelClusters(array<LevelHitEvent> events, array<int> eventGroups, map<string, int> touchClusters) =>
    map.clear(touchClusters)
    if array.size(events) > 0
        for eventIndex = 0 to array.size(events) - 1
            int groupIndex = array.get(eventGroups, eventIndex)
            if groupIndex >= 0
                map.put(touchClusters, array.get(events, eventIndex).key, groupIndex)
    true

//@function Selects the winning Touch Marker presentation for each visible hit group.
export registerLevelHitGroupPresentations(array<LevelHitEvent> events, array<int> eventGroups, map<string, LevelHitPresentation> presentations, map<int, LevelHitPresentation> groupPresentations) =>
    map.clear(groupPresentations)
    map<int, int> groupDominantOrders = map.new<int, int>()
    int eventCount = array.size(events)
    if eventCount > 0
        for eventIndex = 0 to eventCount - 1
            int groupIndex = array.get(eventGroups, eventIndex)
            LevelHitEvent hitEvent = array.get(events, eventIndex)
            if groupIndex >= 0 and map.contains(presentations, hitEvent.key)
                LevelHitPresentation candidate = map.get(presentations, hitEvent.key)
                bool candidatePrecedes = not map.contains(groupPresentations, groupIndex)
                if not candidatePrecedes
                    LevelHitPresentation current = map.get(groupPresentations, groupIndex)
                    int currentOrder = map.get(groupDominantOrders, groupIndex)
                    candidatePrecedes := prioritizedIdentityPrecedes(candidate.anchorPriority, candidate.effectiveLineWidth, candidate.rank, eventIndex, current.anchorPriority, current.effectiveLineWidth, current.rank, currentOrder)
                if candidatePrecedes
                    map.put(groupPresentations, groupIndex, candidate)
                    map.put(groupDominantOrders, groupIndex, eventIndex)
    true

//@function Buffers labels for hit levels without a rendered carrier line.
export bufferLevelHitLabels(array<LevelHitEvent> events, bool labelsActive, map<string, bool> renderedLevelHitKeys, map<string, LevelHitPresentation> presentations, array<PendingLabel> pendingLabels, PresentationConfig config) =>
    if labelsActive and array.size(events) > 0
        map<string, bool> bufferedKeys = map.new<string, bool>()
        for eventIndex = array.size(events) - 1 to 0
            LevelHitEvent hitEvent = array.get(events, eventIndex)
            bool focusSourceVisible = not hitEvent.focusOnly or map.contains(renderedLevelHitKeys, hitEvent.key)
            bool presentationAvailable = map.contains(presentations, hitEvent.key)
            bool alreadyVisible = map.contains(renderedLevelHitKeys, hitEvent.key)
            bool alreadyBuffered = map.contains(bufferedKeys, hitEvent.key)
            if sameDate(hitEvent.hitTime, config.currentTime, config.newYorkTimezone) and focusSourceVisible and presentationAvailable and not alreadyVisible and not alreadyBuffered
                LevelHitPresentation presentation = map.get(presentations, hitEvent.key)
                bool archived = levelHitArchivedSwept(hitEvent, presentation)
                string priceText = str.tostring(hitEvent.price, format.mintick)
                string extraSuffix = (hitEvent.unselectedAnchor ? config.unselectedAnchorSymbol : "") + (archived ? config.archivedSymbol : "")
                LabelIdentity labelIdentity = labelIdentityWithSuffix(presentation.labelIdentity, extraSuffix)
                array.push(pendingLabels, PendingLabel.new(hitEvent.price, config.currentBarIndex + presentation.labelOffset, hitEvent.hitTime, hitEvent.key, labelIdentity, priceText, presentation.showPrice, true, presentation.labelColor, presentation.labelBgColor, presentation.labelSize, presentation.rank, presentation.effectiveLineWidth, na, na, na, na, na, na, na))
                map.put(bufferedKeys, hitEvent.key, true)
    true

twoDigitText(int value) =>
    (value < 10 ? "0" : "") + str.tostring(value)

levelHitTimeText(int hitTime, string newYorkTimezone) =>
    twoDigitText(hour(hitTime, newYorkTimezone)) + ":" + twoDigitText(minute(hitTime, newYorkTimezone)) + " NY"

//@function Renders one Touch Marker circle per visible same-candle hit cluster.
export renderLevelHitCircles(array<LevelHitEvent> events, array<int> eventGroups, map<string, LevelHitPresentation> presentations, map<int, LevelHitPresentation> groupPresentations, map<int, int> firstHitDirections, array<label> drawnLabels, PresentationConfig config) =>
    int eventCount = array.size(events)
    if eventCount > 0
        array<int> groupBarTimes = array.new<int>()
        array<int> groupHitTimes = array.new<int>()
        array<int> groupContactTimes = array.new<int>()
        array<float> groupPrices = array.new<float>()
        array<int> identityGroup = array.new<int>()
        array<string> identityName = array.new<string>()
        array<int> identityPriority = array.new<int>()
        array<int> identityWidth = array.new<int>()
        array<int> identityRank = array.new<int>()
        array<int> identityOrder = array.new<int>()
        for eventIndex = 0 to eventCount - 1
            int groupIndex = array.get(eventGroups, eventIndex)
            LevelHitEvent hitEvent = array.get(events, eventIndex)
            if groupIndex >= 0 and map.contains(presentations, hitEvent.key)
                LevelHitPresentation presentation = map.get(presentations, hitEvent.key)
                bool archived = levelHitArchivedSwept(hitEvent, presentation)
                if groupIndex < array.size(groupBarTimes)
                    if hitEvent.contactTime < array.get(groupContactTimes, groupIndex)
                        array.set(groupContactTimes, groupIndex, hitEvent.contactTime)
                else
                    array.push(groupBarTimes, hitEvent.barTime)
                    array.push(groupHitTimes, hitEvent.hitTime)
                    array.push(groupContactTimes, hitEvent.contactTime)
                    array.push(groupPrices, hitEvent.price)
                array.push(identityGroup, groupIndex)
                string annotatedIdentity = presentation.identity + (hitEvent.unselectedAnchor ? " " + config.unselectedAnchorSymbol : "") + (archived ? " " + config.archivedSymbol : "")
                array.push(identityName, annotatedIdentity)
                array.push(identityPriority, presentation.anchorPriority)
                array.push(identityWidth, presentation.effectiveLineWidth)
                array.push(identityRank, presentation.rank)
                array.push(identityOrder, eventIndex)
        if array.size(groupBarTimes) > 0
            for groupIndex = array.size(groupBarTimes) - 1 to 0
                int barTime = array.get(groupBarTimes, groupIndex)
                bool firstHit = map.contains(firstHitDirections, groupIndex)
                int hitTime = firstHit ? array.get(groupContactTimes, groupIndex) : array.get(groupHitTimes, groupIndex)
                float hitPrice = array.get(groupPrices, groupIndex)
                if map.contains(groupPresentations, groupIndex)
                    LevelHitPresentation groupPresentation = map.get(groupPresentations, groupIndex)
                    string identities = orderedClusterIdentities(groupIndex, "\n", eventCount, identityGroup, identityName, identityPriority, identityWidth, identityRank, identityOrder)
                    string hitTimeText = levelHitTimeText(hitTime, config.newYorkTimezone)
                    string tooltipFooter = "Hit " + hitTimeText
                    if firstHit
                        int firstHitDirection = map.get(firstHitDirections, groupIndex)
                        string directionText = firstHitDirection < 0 ? config.fromAboveText : firstHitDirection > 0 ? config.fromBelowText : ""
                        tooltipFooter := config.firstHitSymbol + " FIRST" + (directionText != "" ? " · " + directionText : "") + " · " + hitTimeText
                    string tooltipText = identities + "\n" + tooltipFooter
                    trackLabel(drawnLabels, config.maxLabels, label.new(barTime, hitPrice, "●", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_none, color=na, textcolor=color.new(groupPresentation.lineColor, 0), size=toLabelSize(groupPresentation.circleSize, config.sizeTiny, config.sizeNormal, config.sizeLarge, config.sizeHuge), tooltip=tooltipText))
    true
