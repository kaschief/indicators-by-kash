//@version=6

// ═══════════════════════════════════════════════════════════════════════════════
// INDICATOR SETUP
// ═══════════════════════════════════════════════════════════════════════════════
INDICATOR_MAX_LINES = 500
INDICATOR_TITLE = 'kash os •'

indicator(INDICATOR_TITLE, shorttitle=INDICATOR_TITLE, overlay=true, max_lines_count=INDICATOR_MAX_LINES)

// ═══════════════════════════════════════════════════════════════════════════════
// TYPES
// ═══════════════════════════════════════════════════════════════════════════════

enum WidgetPosition
    topLeft = "Top Left"
    topCenter = "Top Center"
    topRight = "Top Right"
    middleLeft = "Middle Left"
    middleCenter = "Middle Center"
    middleRight = "Middle Right"
    bottomLeft = "Bottom Left"
    bottomCenter = "Bottom Center"
    bottomRight = "Bottom Right"

enum WidgetSize
    tiny = "Tiny"
    small = "Small"
    normal = "Normal"
    large = "Large"

enum DividerStyle
    solid = "Solid"
    dashed = "Dashed"
    dotted = "Dotted"

enum DividerWidth
    w1 = "1"
    w2 = "2"
    w3 = "3"
    w4 = "4"
    w5 = "5"

enum DividerBoundary
    midnight = "00:00"
    sessionReopen = "18:00"

// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

NY_TIMEZONE = "America/New_York"

GROUP_INDICATOR_NAME = "📝 Indicator Name"
GROUP_SYMBOL_INFO = "ℹ️ Symbol Info"
GROUP_TIME_DIVIDERS_DAILY = "☀️ Time Dividers: Daily"
GROUP_TIME_DIVIDERS_WEEKLY = "📅 Time Dividers: Weekly"
GROUP_TIME_DIVIDERS_MONTHLY = "🗓️ Time Dividers: Monthly"
GROUP_TIME_DIVIDERS_LABELS = "🏷️ Time Dividers: Labels"
GROUP_COLOR_TABLE = "🎨 Color Reference"

DAY_MON = "MON"
DAY_TUE = "TUE"
DAY_WED = "WED"
DAY_THU = "THU"
DAY_FRI = "FRI"
DAY_SAT = "SAT"
DAY_SUN = "SUN"

UI_ON_OFF = "ON/OFF"
UI_TEXT = "Text"
UI_COLOR = "Color"
UI_BACKGROUND = "Background"
UI_BORDER = "Border"
UI_TRANSPARENT = "Transparent"
UI_SHOW_LAST = "Show Last"
UI_WIDTH = "Width"

BORDER_WIDTH_ON = 1
BORDER_WIDTH_OFF = 0
EXCHANGE_SESSION_START_HOUR = 18
SECONDS_PER_MINUTE = 60
MINUTES_PER_HOUR = 60
HOURS_PER_DAY = 24
HOURS_PER_HALF_DAY = 12
SECONDS_PER_DAY = HOURS_PER_DAY * MINUTES_PER_HOUR * SECONDS_PER_MINUTE
SHOW_LAST_MIN = 1
SHOW_LAST_MAX_DIVIDERS = 160
SHOW_LAST_DEFAULT_DAILY = 50
SHOW_LAST_DEFAULT_WEEKLY = 25
SHOW_LAST_DEFAULT_MONTHLY = 12
DAY_LABEL_MAX_SECONDS = 4 * MINUTES_PER_HOUR * SECONDS_PER_MINUTE
COLOR_TABLE_ROW_COUNT = 12

// ═══════════════════════════════════════════════════════════════════════════════
// COLOR CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

const color WIDGET_TEXT_COLOR = color.rgb(0, 0, 0)
const color WIDGET_BG_COLOR = color.rgb(255, 255, 255)
const color WIDGET_BORDER_COLOR = color.rgb(128, 128, 128)
const color DEFAULT_DAILY_DIVIDER_COLOR = color.new(color.rgb(184, 184, 184), 40)
const color DEFAULT_WEEKLY_DIVIDER_COLOR = color.new(color.rgb(248, 187, 208), 50)
const color DEFAULT_MONTHLY_DIVIDER_COLOR = color.rgb(184, 184, 184)
const color DEFAULT_DAY_LABEL_COLOR = color.new(color.rgb(184, 184, 184), 40)
const color DEFAULT_MONDAY_LABEL_COLOR = color.new(color.rgb(248, 187, 208), 60)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Indicator Name ───
showIndicatorName = input.bool(true, UI_ON_OFF, group=GROUP_INDICATOR_NAME, inline='name_options')
indicatorNamePosition = input.enum(WidgetPosition.topCenter, "", group=GROUP_INDICATOR_NAME, inline='name_options')
indicatorNameSize = input.enum(WidgetSize.tiny, "", group=GROUP_INDICATOR_NAME, inline='name_options')
indicatorNameShowBorder = input.bool(true, UI_BORDER, group=GROUP_INDICATOR_NAME, inline='name_options')
indicatorNameTransparent = input.bool(true, UI_TRANSPARENT, group=GROUP_INDICATOR_NAME, inline='name_options')
indicatorNameText = input.text_area("MY INDICATOR NAME", title="Name", group=GROUP_INDICATOR_NAME)
indicatorNameTextColor = input.color(WIDGET_TEXT_COLOR, UI_TEXT, group=GROUP_INDICATOR_NAME, inline='name_colors')
indicatorNameBgColor = input.color(WIDGET_BG_COLOR, UI_BACKGROUND, group=GROUP_INDICATOR_NAME, inline='name_colors')
indicatorNameBorderColor = input.color(WIDGET_BORDER_COLOR, UI_BORDER, group=GROUP_INDICATOR_NAME, inline='name_colors')

// ─── Symbol Info ───
showSymbolInfo = input.bool(true, UI_ON_OFF, group=GROUP_SYMBOL_INFO, inline='symbol_options')
symbolInfoPosition = input.enum(WidgetPosition.topRight, "", group=GROUP_SYMBOL_INFO, inline='symbol_options')
symbolInfoSize = input.enum(WidgetSize.small, "", group=GROUP_SYMBOL_INFO, inline='symbol_options')
symbolInfoShowBorder = input.bool(true, UI_BORDER, group=GROUP_SYMBOL_INFO, inline='symbol_options')
symbolInfoTransparent = input.bool(true, UI_TRANSPARENT, group=GROUP_SYMBOL_INFO, inline='symbol_options')
symbolInfoTextColor = input.color(WIDGET_TEXT_COLOR, UI_TEXT, group=GROUP_SYMBOL_INFO, inline='symbol_colors')
symbolInfoBgColor = input.color(WIDGET_BG_COLOR, UI_BACKGROUND, group=GROUP_SYMBOL_INFO, inline='symbol_colors')
symbolInfoBorderColor = input.color(WIDGET_BORDER_COLOR, UI_BORDER, group=GROUP_SYMBOL_INFO, inline='symbol_colors')

// ─── Time Dividers ───
showDailyDividers = input.bool(false, "Daily Dividers", group=GROUP_TIME_DIVIDERS_DAILY, inline='daily_divider_options')
dailyDividerShowLast = input.int(SHOW_LAST_DEFAULT_DAILY, UI_SHOW_LAST, minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX_DIVIDERS, group=GROUP_TIME_DIVIDERS_DAILY, inline='daily_divider_options')
dailyDividerBoundary = input.enum(DividerBoundary.midnight, "", group=GROUP_TIME_DIVIDERS_DAILY, inline='daily_divider_options', tooltip="00:00 starts each day at midnight New York time.\n18:00 starts it at the exchange session reopen.")
dailyDividerColor = input.color(DEFAULT_DAILY_DIVIDER_COLOR, UI_COLOR, group=GROUP_TIME_DIVIDERS_DAILY, inline='daily_divider_style')
dailyDividerStyle = input.enum(DividerStyle.dashed, "", group=GROUP_TIME_DIVIDERS_DAILY, inline='daily_divider_style')
dailyDividerWidth = input.enum(DividerWidth.w1, UI_WIDTH, group=GROUP_TIME_DIVIDERS_DAILY, inline='daily_divider_style')

showWeeklyDividers = input.bool(false, "Weekly Dividers", group=GROUP_TIME_DIVIDERS_WEEKLY, inline='weekly_divider_options')
weeklyDividerShowLast = input.int(SHOW_LAST_DEFAULT_WEEKLY, UI_SHOW_LAST, minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX_DIVIDERS, group=GROUP_TIME_DIVIDERS_WEEKLY, inline='weekly_divider_options')
weeklyDividerBoundary = input.enum(DividerBoundary.sessionReopen, "", group=GROUP_TIME_DIVIDERS_WEEKLY, inline='weekly_divider_options', tooltip="00:00 starts the week at Monday midnight New York time.\n18:00 starts it at the Sunday futures reopen.")
weeklyDividerColor = input.color(DEFAULT_WEEKLY_DIVIDER_COLOR, UI_COLOR, group=GROUP_TIME_DIVIDERS_WEEKLY, inline='weekly_divider_style')
weeklyDividerStyle = input.enum(DividerStyle.dashed, "", group=GROUP_TIME_DIVIDERS_WEEKLY, inline='weekly_divider_style')
weeklyDividerWidth = input.enum(DividerWidth.w2, UI_WIDTH, group=GROUP_TIME_DIVIDERS_WEEKLY, inline='weekly_divider_style')

showMonthlyDividers = input.bool(false, "Monthly Dividers", group=GROUP_TIME_DIVIDERS_MONTHLY, inline='monthly_divider_options')
monthlyDividerShowLast = input.int(SHOW_LAST_DEFAULT_MONTHLY, UI_SHOW_LAST, minval=SHOW_LAST_MIN, maxval=SHOW_LAST_MAX_DIVIDERS, group=GROUP_TIME_DIVIDERS_MONTHLY, inline='monthly_divider_options')
monthlyDividerBoundary = input.enum(DividerBoundary.sessionReopen, "", group=GROUP_TIME_DIVIDERS_MONTHLY, inline='monthly_divider_options', tooltip="00:00 starts the month at midnight New York time on the 1st.\n18:00 starts it at the session reopen on the last day of the previous month.")
monthlyDividerColor = input.color(DEFAULT_MONTHLY_DIVIDER_COLOR, UI_COLOR, group=GROUP_TIME_DIVIDERS_MONTHLY, inline='monthly_divider_style')
monthlyDividerStyle = input.enum(DividerStyle.dotted, "", group=GROUP_TIME_DIVIDERS_MONTHLY, inline='monthly_divider_style')
monthlyDividerWidth = input.enum(DividerWidth.w3, UI_WIDTH, group=GROUP_TIME_DIVIDERS_MONTHLY, inline='monthly_divider_style')

showDayLabels = input.bool(false, "Day Labels", group=GROUP_TIME_DIVIDERS_LABELS, inline='day_labels', tooltip="Placed halfway between consecutive daily boundaries — 12:00 for a 00:00 boundary, 06:00 for 18:00.")
dayLabelColor = input.color(DEFAULT_DAY_LABEL_COLOR, UI_COLOR, group=GROUP_TIME_DIVIDERS_LABELS, inline='day_labels')
mondayLabelColor = input.color(DEFAULT_MONDAY_LABEL_COLOR, "Monday", group=GROUP_TIME_DIVIDERS_LABELS, inline='day_labels')

// ─── Color Reference ───
showColorTable = input.bool(false, "Show Table", group=GROUP_COLOR_TABLE)

// ═══════════════════════════════════════════════════════════════════════════════
// FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

convert_position(WidgetPosition widgetPosition) =>
    switch widgetPosition
        WidgetPosition.topLeft => position.top_left
        WidgetPosition.topCenter => position.top_center
        WidgetPosition.topRight => position.top_right
        WidgetPosition.middleLeft => position.middle_left
        WidgetPosition.middleCenter => position.middle_center
        WidgetPosition.middleRight => position.middle_right
        WidgetPosition.bottomLeft => position.bottom_left
        WidgetPosition.bottomCenter => position.bottom_center
        => position.bottom_right

convert_size(WidgetSize widgetSize) =>
    switch widgetSize
        WidgetSize.small => size.small
        WidgetSize.normal => size.normal
        WidgetSize.large => size.large
        => size.tiny

convert_divider_style(DividerStyle dividerStyle) =>
    switch dividerStyle
        DividerStyle.solid => line.style_solid
        DividerStyle.dotted => line.style_dotted
        DividerStyle.dashed => line.style_dashed
        => line.style_dashed

convert_divider_width(DividerWidth dividerWidth) =>
    switch dividerWidth
        DividerWidth.w1 => 1
        DividerWidth.w2 => 2
        DividerWidth.w3 => 3
        DividerWidth.w4 => 4
        DividerWidth.w5 => 5
        => 1

divider_boundary_hour(DividerBoundary boundary) =>
    boundary == DividerBoundary.sessionReopen ? EXCHANGE_SESSION_START_HOUR : 0

// Range charts report their underlying 1-minute period, so they are labelled by chart type.
format_chart_timeframe() =>
    int chartMultiplier = timeframe.multiplier
    string result = timeframe.period

    if chart.is_range
        result := "R"
    else if timeframe.isseconds
        result := str.tostring(chartMultiplier) + "s"
    else if timeframe.isminutes
        bool wholeHours = chartMultiplier >= MINUTES_PER_HOUR and chartMultiplier % MINUTES_PER_HOUR == 0
        result := wholeHours ? str.tostring(chartMultiplier / MINUTES_PER_HOUR) + "H" : str.tostring(chartMultiplier) + "m"
    else if timeframe.isdaily
        result := str.tostring(chartMultiplier) + "D"
    else if timeframe.isweekly
        result := str.tostring(chartMultiplier) + "W"
    else if timeframe.ismonthly
        result := str.tostring(chartMultiplier) + "M"

    result

// A session opening at 18:00 belongs to the next calendar date. Day arithmetic goes through
// timestamp() so it normalises month ends and never crosses a DST offset change.
trading_date_ms(int boundaryHour) =>
    bool nextSession = boundaryHour > 0 and hour(time, NY_TIMEZONE) >= boundaryHour
    int dayNumber = dayofmonth(time, NY_TIMEZONE) + (nextSession ? 1 : 0)
    timestamp(NY_TIMEZONE, year(time, NY_TIMEZONE), month(time, NY_TIMEZONE), dayNumber, 0, 0)

week_start_ms(int dateMs) =>
    int weekday = dayofweek(dateMs, NY_TIMEZONE)
    int daysSinceMonday = weekday == dayofweek.sunday ? 6 : weekday - 2
    timestamp(NY_TIMEZONE, year(dateMs, NY_TIMEZONE), month(dateMs, NY_TIMEZONE), dayofmonth(dateMs, NY_TIMEZONE) - daysSinceMonday, 0, 0)

month_start_ms(int dateMs) =>
    timestamp(NY_TIMEZONE, year(dateMs, NY_TIMEZONE), month(dateMs, NY_TIMEZONE), 1, 0, 0)

// Called unconditionally every bar. `previousStartMs` is per call site, so the tiers stay
// independent only while each keeps its own textual call.
period_started(int periodStartMs) =>
    var int previousStartMs = na
    bool started = not na(previousStartMs) and periodStartMs != previousStartMs
    previousStartMs := periodStartMs
    started

// The Sunday evening reopen on futures never trades through the label hour.
label_hour_traded(int labelHour) =>
    int previousTime = time[1]
    bool result = false

    if not na(previousTime)
        bool isNewCalendarDay = dayofmonth(time, NY_TIMEZONE) != dayofmonth(previousTime, NY_TIMEZONE)
        result := not isNewCalendarDay and hour(time, NY_TIMEZONE) >= labelHour and hour(previousTime, NY_TIMEZONE) < labelHour

    result

// Realtime ticks re-run the open bar without rolling back collection contents, so the last
// drawn line is the only reliable dedup key. `dividerLines` is per call site, so the tiers must
// never be routed through a loop or shared wrapper or they collapse onto one collection.
draw_time_divider(int dividerTime, int showLast, color dividerColor, DividerWidth dividerWidth, DividerStyle dividerStyle) =>
    var array<line> dividerLines = array.new_line()
    bool alreadyDrawn = array.size(dividerLines) > 0 and line.get_x1(array.last(dividerLines)) == dividerTime
    // A vertical line needs distinct prices, which a flat bar would not provide
    float anchorLow = low == high ? low - syminfo.mintick : low

    if not alreadyDrawn
        array.push(dividerLines, line.new(dividerTime, high, dividerTime, anchorLow, xloc=xloc.bar_time, extend=extend.both, color=dividerColor, style=convert_divider_style(dividerStyle), width=convert_divider_width(dividerWidth)))

        if array.size(dividerLines) > showLast
            line.delete(array.shift(dividerLines))

draw_widget(string widgetText, WidgetPosition widgetPosition, WidgetSize widgetSize, bool showBorder, bool transparent, color textColor, color bgColor, color borderColor) =>
    var table widget = table.new(convert_position(widgetPosition), 1, 1, frame_color=borderColor, frame_width=showBorder ? BORDER_WIDTH_ON : BORDER_WIDTH_OFF)
    table.cell(widget, 0, 0, widgetText, text_color=textColor, text_size=convert_size(widgetSize), bgcolor=transparent ? color(na) : bgColor)

addColorRow(table tbl, int row, string name, color clr) =>
    table.cell(tbl, 0, row, name, text_size=size.small, text_color=color.black)
    table.cell(tbl, 1, row, str.format("R:{0} G:{1} B:{2}", int(color.r(clr)), int(color.g(clr)), int(color.b(clr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 2, row, str.tostring(int(color.t(clr))), text_size=size.small, text_color=color.black)

// ═══════════════════════════════════════════════════════════════════════════════
// TIME DIVIDERS
// ═══════════════════════════════════════════════════════════════════════════════

is247Market = syminfo.type == "crypto"
chartSeconds = timeframe.in_seconds()
dailyBoundaryHour = divider_boundary_hour(dailyDividerBoundary)
weeklyBoundaryHour = divider_boundary_hour(weeklyDividerBoundary)
monthlyBoundaryHour = divider_boundary_hour(monthlyDividerBoundary)

dailyPeriodStart = trading_date_ms(dailyBoundaryHour)
weeklyPeriodStart = week_start_ms(trading_date_ms(weeklyBoundaryHour))
monthlyPeriodStart = month_start_ms(trading_date_ms(monthlyBoundaryHour))

dailyStarted = period_started(dailyPeriodStart)
weeklyStarted = period_started(weeklyPeriodStart)
monthlyStarted = period_started(monthlyPeriodStart)

// A midnight boundary on Sunday falls inside the weekend gap for session-based assets
dailyInWeekendGap = dailyDividerBoundary == DividerBoundary.midnight and not is247Market and dayofweek(dailyPeriodStart, NY_TIMEZONE) == dayofweek.sunday

// Dividers anchor to the opening bar of the period so they always sit on a bar edge,
// holding the same position relative to the candles on every timeframe.
if showDailyDividers and chartSeconds < SECONDS_PER_DAY and dailyStarted and not dailyInWeekendGap
    draw_time_divider(time, dailyDividerShowLast, dailyDividerColor, dailyDividerWidth, dailyDividerStyle)

if showWeeklyDividers and not (timeframe.isweekly or timeframe.ismonthly) and weeklyStarted
    draw_time_divider(time, weeklyDividerShowLast, weeklyDividerColor, weeklyDividerWidth, weeklyDividerStyle)

if showMonthlyDividers and not timeframe.ismonthly and monthlyStarted
    draw_time_divider(time, monthlyDividerShowLast, monthlyDividerColor, monthlyDividerWidth, monthlyDividerStyle)

// ═══════════════════════════════════════════════════════════════════════════════
// DAY LABELS
// ═══════════════════════════════════════════════════════════════════════════════

currentDay = dayofweek(time, NY_TIMEZONE)
dayLabelHour = (dailyBoundaryHour + HOURS_PER_HALF_DAY) % HOURS_PER_DAY
dayLabelDue = showDayLabels and chartSeconds <= DAY_LABEL_MAX_SECONDS and label_hour_traded(dayLabelHour)

plotchar(dayLabelDue and currentDay == dayofweek.monday, title=DAY_MON, char=" ", text=DAY_MON, location=location.bottom, color=color.new(mondayLabelColor, 100), textcolor=mondayLabelColor, size=size.tiny, editable=false, display=display.pane)
plotchar(dayLabelDue and currentDay == dayofweek.tuesday, title=DAY_TUE, char=" ", text=DAY_TUE, location=location.bottom, color=color.new(dayLabelColor, 100), textcolor=dayLabelColor, size=size.tiny, editable=false, display=display.pane)
plotchar(dayLabelDue and currentDay == dayofweek.wednesday, title=DAY_WED, char=" ", text=DAY_WED, location=location.bottom, color=color.new(dayLabelColor, 100), textcolor=dayLabelColor, size=size.tiny, editable=false, display=display.pane)
plotchar(dayLabelDue and currentDay == dayofweek.thursday, title=DAY_THU, char=" ", text=DAY_THU, location=location.bottom, color=color.new(dayLabelColor, 100), textcolor=dayLabelColor, size=size.tiny, editable=false, display=display.pane)
plotchar(dayLabelDue and currentDay == dayofweek.friday, title=DAY_FRI, char=" ", text=DAY_FRI, location=location.bottom, color=color.new(dayLabelColor, 100), textcolor=dayLabelColor, size=size.tiny, editable=false, display=display.pane)
plotchar(dayLabelDue and currentDay == dayofweek.saturday, title=DAY_SAT, char=" ", text=DAY_SAT, location=location.bottom, color=color.new(dayLabelColor, 100), textcolor=dayLabelColor, size=size.tiny, editable=false, display=display.pane)
plotchar(dayLabelDue and currentDay == dayofweek.sunday, title=DAY_SUN, char=" ", text=DAY_SUN, location=location.bottom, color=color.new(dayLabelColor, 100), textcolor=dayLabelColor, size=size.tiny, editable=false, display=display.pane)

// ═══════════════════════════════════════════════════════════════════════════════
// RENDERING
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.islast
    if showIndicatorName and indicatorNameText != ""
        draw_widget(indicatorNameText, indicatorNamePosition, indicatorNameSize, indicatorNameShowBorder, indicatorNameTransparent, indicatorNameTextColor, indicatorNameBgColor, indicatorNameBorderColor)

    if showSymbolInfo
        draw_widget(syminfo.ticker + "\n\n" + format_chart_timeframe(), symbolInfoPosition, symbolInfoSize, symbolInfoShowBorder, symbolInfoTransparent, symbolInfoTextColor, symbolInfoBgColor, symbolInfoBorderColor)

    if showColorTable
        var table colorTable = table.new(position.top_right, 3, COLOR_TABLE_ROW_COUNT, bgcolor=color.white, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

        table.cell(colorTable, 0, 0, "Setting", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
        table.cell(colorTable, 1, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
        table.cell(colorTable, 2, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)

        int row = 1
        if showIndicatorName
            addColorRow(colorTable, row, "Indicator Name Text", indicatorNameTextColor)
            row += 1
            addColorRow(colorTable, row, "Indicator Name Background", indicatorNameBgColor)
            row += 1
            addColorRow(colorTable, row, "Indicator Name Border", indicatorNameBorderColor)
            row += 1
        if showSymbolInfo
            addColorRow(colorTable, row, "Symbol Info Text", symbolInfoTextColor)
            row += 1
            addColorRow(colorTable, row, "Symbol Info Background", symbolInfoBgColor)
            row += 1
            addColorRow(colorTable, row, "Symbol Info Border", symbolInfoBorderColor)
            row += 1
        if showDailyDividers
            addColorRow(colorTable, row, "Daily Divider", dailyDividerColor)
            row += 1
        if showWeeklyDividers
            addColorRow(colorTable, row, "Weekly Divider", weeklyDividerColor)
            row += 1
        if showMonthlyDividers
            addColorRow(colorTable, row, "Monthly Divider", monthlyDividerColor)
            row += 1
        if showDayLabels
            addColorRow(colorTable, row, "Day Label", dayLabelColor)
            row += 1
            addColorRow(colorTable, row, "Monday Label", mondayLabelColor)
