// ═══════════════════════════════════════════════════════════════════════════════
// FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

get_position(string pos) =>
    switch pos
        POS_TOP_LEFT => position.top_left
        POS_TOP_CENTER => position.top_center
        POS_TOP_RIGHT => position.top_right
        POS_MIDDLE_LEFT => position.middle_left
        POS_MIDDLE_CENTER => position.middle_center
        POS_MIDDLE_RIGHT => position.middle_right
        POS_BOTTOM_LEFT => position.bottom_left
        POS_BOTTOM_CENTER => position.bottom_center
        POS_BOTTOM_RIGHT => position.bottom_right
        => position.top_right

get_size(string sz) =>
    switch sz
        SIZE_TINY => size.tiny
        SIZE_SMALL => size.small
        SIZE_NORMAL => size.normal
        SIZE_LARGE => size.large
        => size.tiny

tf_to_minutes(tf_string) =>
    var result = 0.0
    if str.contains(tf_string, SUFFIX_S_DETECT)
        seconds = str.tonumber(str.replace(tf_string, SUFFIX_S_DETECT, STR_EMPTY))
        result := seconds / 60.0
    else if str.contains(tf_string, SUFFIX_H)
        hours = str.tonumber(str.replace(tf_string, SUFFIX_H, STR_EMPTY))
        result := hours * MINUTES_PER_HOUR
    else if str.contains(tf_string, SUFFIX_D)
        days = str.tonumber(str.replace(tf_string, SUFFIX_D, STR_EMPTY))
        result := days * MINUTES_PER_DAY
    else if str.contains(tf_string, SUFFIX_W)
        weeks = str.tonumber(str.replace(tf_string, SUFFIX_W, STR_EMPTY))
        result := weeks * MINUTES_PER_WEEK
    else if str.contains(tf_string, SUFFIX_MON)
        months = str.tonumber(str.replace(tf_string, SUFFIX_MON, STR_EMPTY))
        result := months * MINUTES_PER_MONTH
    else
        result := str.tonumber(tf_string)
    result

get_classification(tf_ratio) =>
    var result = STR_EMPTY
    if tf_ratio >= IDEAL_MIN_RATIO and tf_ratio <= IDEAL_MAX_RATIO
        result := IDEAL
    else if (tf_ratio >= EDGE_LOW_MIN_RATIO and tf_ratio <= EDGE_LOW_MAX_RATIO) or (tf_ratio >= EDGE_HIGH_MIN_RATIO and tf_ratio <= EDGE_HIGH_MAX_RATIO)
        result := EDGE
    result

format_tf(minutes_value) =>
    var result = STR_EMPTY
    if minutes_value >= MINUTES_PER_MONTH
        result := str.tostring(math.round(minutes_value / MINUTES_PER_MONTH)) + SUFFIX_MON
    else if minutes_value >= MINUTES_PER_WEEK
        result := str.tostring(math.round(minutes_value / MINUTES_PER_WEEK)) + SUFFIX_W
    else if minutes_value >= MINUTES_PER_DAY
        result := str.tostring(math.round(minutes_value / MINUTES_PER_DAY)) + SUFFIX_D
    else if minutes_value >= MINUTES_PER_HOUR
        result := str.tostring(math.round(minutes_value / MINUTES_PER_HOUR)) + SUFFIX_H
    else if minutes_value >= 1
        result := str.tostring(math.round(minutes_value)) + SUFFIX_M
    else
        result := str.tostring(math.round(minutes_value * 60)) + SUFFIX_S
    result

is_bridge_pair(curr_minutes, cand_minutes) =>
    curr_minutes == MINUTES_PER_WEEK and cand_minutes == MINUTES_PER_MONTH

array_contains_string(arr, value) =>
    sz = array.size(arr)
    found = false
    if sz > 0
        for i_check = 0 to sz - 1
            if array.get(arr, i_check) == value
                found := true
    found

push_unique(label_arr, ratio_arr, label, ratio_value) =>
    if not array_contains_string(label_arr, label)
        array.push(label_arr, label)
        array.push(ratio_arr, ratio_value)
        true
    else
        false

sort_pairs_by_ratio_desc(labels, ratios) =>
    count_labels = array.size(labels)
    count_ratios = array.size(ratios)
    count = math.min(count_labels, count_ratios)
    if count <= 1
        na
    else
        for i_sort = 0 to count - 2
            for j_sort = i_sort + 1 to count - 1
                if array.get(ratios, i_sort) < array.get(ratios, j_sort)
                    r_i = array.get(ratios, i_sort)
                    r_j = array.get(ratios, j_sort)
                    array.set(ratios, i_sort, r_j)
                    array.set(ratios, j_sort, r_i)
                    s_i = array.get(labels, i_sort)
                    s_j = array.get(labels, j_sort)
                    array.set(labels, i_sort, s_j)
                    array.set(labels, j_sort, s_i)
select_natural_and_backup(timeframe_labels, timeframe_ratios) =>
    count_timeframes = array.size(timeframe_labels)
    count_ratios = array.size(timeframe_ratios)
    if count_timeframes == 0 or count_ratios == 0
        [array.new<string>(), array.new<float>(), -1]
    else
        natural_source_index = 0
        natural_distance = HUGE_DISTANCE
        paired_count = math.min(count_timeframes, count_ratios)
        for idx = 0 to paired_count - 1
            ratio_value = array.get(timeframe_ratios, idx)
            distance_from_12 = math.abs(ratio_value - NATURAL_TARGET_RATIO)
            if distance_from_12 < natural_distance
                natural_distance := distance_from_12
                natural_source_index := idx
        backup_index = -1
        backup_distance = HUGE_DISTANCE
        for idx = 0 to paired_count - 1
            if idx != natural_source_index
                ratio_value = array.get(timeframe_ratios, idx)
                distance_from_12 = math.abs(ratio_value - NATURAL_TARGET_RATIO)
                if distance_from_12 < backup_distance
                    backup_distance := distance_from_12
                    backup_index := idx
        picked_timeframes = array.new<string>()
        picked_ratios = array.new<float>()
        new_natural_index = -1
        for idx_order = 0 to paired_count - 1
            is_pick = (idx_order == natural_source_index) or (idx_order == backup_index)
            if is_pick
                array.push(picked_timeframes, array.get(timeframe_labels, idx_order))
                array.push(picked_ratios, array.get(timeframe_ratios, idx_order))
                if idx_order == natural_source_index
                    new_natural_index := array.size(picked_timeframes) - 1
        new_natural_index := (new_natural_index == -1) ? 0 : new_natural_index
        if array.size(picked_ratios) == 2
            r0 = array.get(picked_ratios, 0)
            r1 = array.get(picked_ratios, 1)
            if r0 < r1
                t0 = array.get(picked_timeframes, 0)
                t1 = array.get(picked_timeframes, 1)
                array.set(picked_timeframes, 0, t1)
                array.set(picked_timeframes, 1, t0)
                array.set(picked_ratios, 0, r1)
                array.set(picked_ratios, 1, r0)
                new_natural_index := (new_natural_index == 0) ? 1 : (new_natural_index == 1 ? 0 : new_natural_index)
        [picked_timeframes, picked_ratios, new_natural_index]
format_ultra_compact(timeframe_labels, timeframe_ratios, natural_index) =>
    count_timeframes = array.size(timeframe_labels)
    if count_timeframes == 0
        STR_EMPTY
    else
        formatted_output = STR_EMPTY
        for idx_label = 0 to count_timeframes - 1
            if idx_label > 0
                formatted_output += STR_SPACE
            tf_label = array.get(timeframe_labels, idx_label)
            entry_text = tf_label
            if idx_label == natural_index
                entry_text += CHECK_MARK
            formatted_output += entry_text
        formatted_output

get_countdown(tf_string) =>
    bar_close_time = request.security(syminfo.tickerid, tf_string, time_close, lookahead=barmerge.lookahead_on)
    time_remaining = bar_close_time - timenow
    time_remaining_clamped = math.max(0, time_remaining)

    total_seconds = math.floor(time_remaining_clamped / 1000)
    hours = math.floor(total_seconds / 3600)
    remaining_after_hours = total_seconds % 3600
    minutes = math.floor(remaining_after_hours / 60)
    seconds = remaining_after_hours % 60

    hours_str = hours < 10 ? "0" + str.tostring(hours) : str.tostring(hours)
    minutes_str = minutes < 10 ? "0" + str.tostring(minutes) : str.tostring(minutes)
    seconds_str = seconds < 10 ? "0" + str.tostring(seconds) : str.tostring(seconds)

    hours_str + "∶" + minutes_str + "∶" + seconds_str

// ═══════════════════════════════════════════════════════════════════════════════
// MAIN LOGIC
// ═══════════════════════════════════════════════════════════════════════════════

if show_quickpair and barstate.islast
    current_tf_minutes = tf_to_minutes(timeframe.period)
    current_tf_display = format_tf(current_tf_minutes)

    tf_list = TF_LIST_MINUTES

    htf_ideal = array.new<string>()
    htf_edge = array.new<string>()
    htf_ideal_r = array.new<float>()
    htf_edge_r = array.new<float>()

    ltf_ideal = array.new<string>()
    ltf_edge = array.new<string>()
    ltf_ideal_r = array.new<float>()
    ltf_edge_r = array.new<float>()

    tf_list_count = array.size(tf_list)

    for i_ord = 0 to tf_list_count - 1
        idx_tf = tf_list_count - 1 - i_ord
        tf_minutes = array.get(tf_list, idx_tf)
        if tf_minutes > current_tf_minutes
            tf_ratio = tf_minutes / current_tf_minutes
            accept_pair = tf_ratio == math.floor(tf_ratio) or is_bridge_pair(current_tf_minutes, tf_minutes)
            if accept_pair
                classification = (tf_ratio == math.floor(tf_ratio)) ? get_classification(tf_ratio) : EDGE
                tf_label = format_tf(tf_minutes)
                if classification == IDEAL and array.size(htf_ideal) < MAX_RECOMMENDATIONS
                    push_unique(htf_ideal, htf_ideal_r, tf_label, tf_ratio)
                else if classification == EDGE and array.size(htf_edge) < MAX_RECOMMENDATIONS
                    push_unique(htf_edge, htf_edge_r, tf_label, tf_ratio)

    for i_ord = 0 to tf_list_count - 1
        idx_tf = i_ord
        tf_minutes = array.get(tf_list, idx_tf)
        if tf_minutes < current_tf_minutes
            tf_ratio = current_tf_minutes / tf_minutes
            accept_pair = tf_ratio == math.floor(tf_ratio) or is_bridge_pair(tf_minutes, current_tf_minutes)
            if accept_pair
                classification = (tf_ratio == math.floor(tf_ratio)) ? get_classification(tf_ratio) : EDGE
                tf_label = format_tf(tf_minutes)
                if classification == IDEAL and array.size(ltf_ideal) < MAX_RECOMMENDATIONS
                    push_unique(ltf_ideal, ltf_ideal_r, tf_label, tf_ratio)
                else if classification == EDGE and array.size(ltf_edge) < MAX_RECOMMENDATIONS
                    push_unique(ltf_edge, ltf_edge_r, tf_label, tf_ratio)

    if array.size(htf_ideal) > 0 or array.size(htf_edge) > 0 or array.size(ltf_ideal) > 0 or array.size(ltf_edge) > 0
        htf_candidate_timeframes = array.copy(htf_ideal)
        htf_candidate_ratios = array.copy(htf_ideal_r)
        htf_edge_count = array.size(htf_edge)
        if htf_edge_count > 0
            for idx_htf_edge = 0 to htf_edge_count - 1
                array.push(htf_candidate_timeframes, array.get(htf_edge, idx_htf_edge))
                array.push(htf_candidate_ratios, array.get(htf_edge_r, idx_htf_edge))
        ltf_candidate_timeframes = array.copy(ltf_ideal)
        ltf_candidate_ratios = array.copy(ltf_ideal_r)
        ltf_edge_count = array.size(ltf_edge)
        if ltf_edge_count > 0
            for idx_ltf_edge = 0 to ltf_edge_count - 1
                array.push(ltf_candidate_timeframes, array.get(ltf_edge, idx_ltf_edge))
                array.push(ltf_candidate_ratios, array.get(ltf_edge_r, idx_ltf_edge))

        [htf_picked_tfs, htf_picked_ratios, htf_natural_index] = select_natural_and_backup(htf_candidate_timeframes, htf_candidate_ratios)
        [ltf_picked_tfs, ltf_picked_ratios, ltf_natural_index] = select_natural_and_backup(ltf_candidate_timeframes, ltf_candidate_ratios)

        left_text = format_ultra_compact(htf_picked_tfs, htf_picked_ratios, htf_natural_index)
        right_text = format_ultra_compact(ltf_picked_tfs, ltf_picked_ratios, ltf_natural_index)

        qp_border_width = quickpair_show_border ? 1 : 0
        table quickpair_table = table.new(get_position(quickpair_position), 3, 1, bgcolor=quickpair_bg_color, frame_color=quickpair_frame_color, frame_width=1, border_color=quickpair_border_color, border_width=qp_border_width)
        table.cell(quickpair_table, 0, 0, left_text, text_color=quickpair_text_color, text_size=size.tiny)
        table.cell(quickpair_table, 1, 0, current_tf_display, text_color=quickpair_current_color, text_size=size.tiny)
        table.cell(quickpair_table, 2, 0, right_text, text_color=quickpair_text_color, text_size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// COUNTDOWN WIDGET
// ═══════════════════════════════════════════════════════════════════════════════

if show_countdown
    chart_tf_minutes = tf_to_minutes(timeframe.period)

    enabled_countdown_count = 0
    if show_countdown_3m and 3 >= chart_tf_minutes
        enabled_countdown_count += 1
    if show_countdown_5m and 5 >= chart_tf_minutes
        enabled_countdown_count += 1
    if show_countdown_15m and 15 >= chart_tf_minutes
        enabled_countdown_count += 1
    if show_countdown_1h and 60 >= chart_tf_minutes
        enabled_countdown_count += 1
    if show_countdown_4h and 240 >= chart_tf_minutes
        enabled_countdown_count += 1
    if show_countdown_7h and 420 >= chart_tf_minutes
        enabled_countdown_count += 1
    if show_countdown_1d and 1440 >= chart_tf_minutes
        enabled_countdown_count += 1

    if enabled_countdown_count > 0
        cd_border_width = countdown_show_border ? 1 : 0
        table countdown_table = table.new(get_position(countdown_position), 2, enabled_countdown_count, bgcolor=countdown_bg_color, frame_color=countdown_frame_color, frame_width=1, border_color=countdown_border_color, border_width=cd_border_width)

        row_index = 0

        if show_countdown_3m and 3 >= chart_tf_minutes
            countdown_3m = get_countdown("3")
            table.cell(countdown_table, 0, row_index, "3m", text_color=countdown_text_color, text_size=size.tiny)
            table.cell(countdown_table, 1, row_index, countdown_3m, text_color=countdown_text_color, text_size=size.tiny)
            row_index += 1

        if show_countdown_5m and 5 >= chart_tf_minutes
            countdown_5m = get_countdown("5")
            table.cell(countdown_table, 0, row_index, "5m", text_color=countdown_text_color, text_size=size.tiny)
            table.cell(countdown_table, 1, row_index, countdown_5m, text_color=countdown_text_color, text_size=size.tiny)
            row_index += 1

        if show_countdown_15m and 15 >= chart_tf_minutes
            countdown_15m = get_countdown("15")
            table.cell(countdown_table, 0, row_index, "15m", text_color=countdown_text_color, text_size=size.tiny)
            table.cell(countdown_table, 1, row_index, countdown_15m, text_color=countdown_text_color, text_size=size.tiny)
            row_index += 1

        if show_countdown_1h and 60 >= chart_tf_minutes
            countdown_1h = get_countdown("60")
            table.cell(countdown_table, 0, row_index, "1h", text_color=countdown_text_color, text_size=size.tiny)
            table.cell(countdown_table, 1, row_index, countdown_1h, text_color=countdown_text_color, text_size=size.tiny)
            row_index += 1

        if show_countdown_4h and 240 >= chart_tf_minutes
            countdown_4h = get_countdown("240")
            table.cell(countdown_table, 0, row_index, "4h", text_color=countdown_text_color, text_size=size.tiny)
            table.cell(countdown_table, 1, row_index, countdown_4h, text_color=countdown_text_color, text_size=size.tiny)
            row_index += 1

        if show_countdown_7h and 420 >= chart_tf_minutes
            countdown_7h = get_countdown("420")
            table.cell(countdown_table, 0, row_index, "7h", text_color=countdown_text_color, text_size=size.tiny)
            table.cell(countdown_table, 1, row_index, countdown_7h, text_color=countdown_text_color, text_size=size.tiny)
            row_index += 1

        if show_countdown_1d and 1440 >= chart_tf_minutes
            countdown_1d = get_countdown("D")
            table.cell(countdown_table, 0, row_index, "1D", text_color=countdown_text_color, text_size=size.tiny)
            table.cell(countdown_table, 1, row_index, countdown_1d, text_color=countdown_text_color, text_size=size.tiny)
            row_index += 1

// ═══════════════════════════════════════════════════════════════════════════════
// SYMBOL INFO WIDGET
// ═══════════════════════════════════════════════════════════════════════════════

if show_symbol_info
    si_frame_width = symbol_info_show_border ? 1 : 0
    si_bg = symbol_info_transparent ? color(na) : symbol_info_bg_color

    tf_display = timeframe.period
    if timeframe.isminutes
        tf_minutes = str.tonumber(timeframe.period)
        if tf_minutes >= 60
            tf_display := str.tostring(int(tf_minutes / 60)) + "H"
        else
            tf_display := timeframe.period + "m"
    else if timeframe.isdaily
        tf_display := "D"
    else if timeframe.isweekly
        tf_display := "W"
    else if timeframe.ismonthly
        tf_display := "M"

    symbol_text = syminfo.ticker + "\n\n" + tf_display
    table symbol_info_table = table.new(get_position(symbol_info_position), 1, 1, frame_color=symbol_info_border_color, frame_width=si_frame_width)
    table.cell(symbol_info_table, 0, 0, symbol_text, text_color=symbol_info_text_color, text_size=get_size(symbol_info_size), bgcolor=si_bg)

