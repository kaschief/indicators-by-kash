if show_color_table and barstate.islast
    var table colorTable = table.new(position.bottom_center, 3, 31, bgcolor=color.white, frame_color=color.gray, frame_width=1, border_color=color.gray, border_width=1)

    table.cell(colorTable, 0, 0, "Setting", text_color=color.black, text_size=size.tiny, bgcolor=color.new(color.gray, 50))
    table.cell(colorTable, 1, 0, "RGB", text_color=color.black, text_size=size.tiny, bgcolor=color.new(color.gray, 50))
