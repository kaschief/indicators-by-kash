//@version=6
indicator('LTF Algo Draw° [Pro+]', overlay=true, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// LTF ALGO DRAW° [PRO+] - LOWER TIMEFRAME ALGORITHMIC LIQUIDITY DETECTION
// ═══════════════════════════════════════════════════════════════════════════════
//
// ALGORITHM CONCEPT:
// • BSL (Buy-Side Liquidity): Failed break down → draw up to high
// • SSL (Sell-Side Liquidity): Failed break up → draw down to low
// • Real-time fill detection with instant visual feedback
// • Tick-based deduplication for all symbol types
// • Smart timeframe defaults for optimal performance
//
// BSL-FIRST DESIGN: All ordering prioritizes Buy-Side Liquidity throughout
// ═══════════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════════
// INPUT SETTINGS - PROFESSIONAL LAYOUT
// ═══════════════════════════════════════════════════════════════════════════════

// === 👁️ VISIBILITY ===
enable_buyside = input.bool(true, 'Enable Buy-Side Draws', group='👁️ Visibility', inline='sides', tooltip='Enable buy-side liquidity draws (BSL - failed break down → draw up to high)\nBSL draws appear when price fails to break below a level and closes back above it')
enable_sellside = input.bool(true, 'Enable Sell-Side Draws', group='👁️ Visibility', inline='sides', tooltip='Enable sell-side liquidity draws (SSL - failed break up → draw down to low)\nSSL draws appear when price fails to break above a level and closes back below it')
enable_open_lines = input.bool(true, 'Enable Open Lines', group='👁️ Visibility', inline='open', tooltip='Display active/unfilled draws that are still targeting their levels\nThese are the most important draws as they show current algorithmic targets')
open_lines_count = input.int(5, 'Max Open per Side', minval=0, maxval=100, group='👁️ Visibility', inline='open', tooltip='Maximum active draws to display per side (this setting applies separately to both BSL and SSL)\nFor example: setting of 5 means up to 5 BSL lines + 5 SSL lines = 10 total possible\nFilled draws are automatically limited to 10 per side for optimal chart clarity')
enable_filled_lines = input.bool(true, 'Enable Filled Lines', group='👁️ Visibility', inline='filled', tooltip='Display completed/filled draws (automatically capped at 10 per side)\nFilled draws show historical algorithm performance and successful target hits')

// === 🏷️ LABELS ===
enable_labels = input.bool(true, 'Enable', group='🏷️ Labels', inline='main', tooltip='Enable timeframe labels on lines showing current chart timeframe\nLabels help identify which timeframe generated each algorithmic draw')
label_view = input.string('All', 'View', options=['All', 'None', 'Custom'], group='🏷️ Labels', inline='main', tooltip='All: show labels on every open line\nNone: hide all labels for clean chart\nCustom: show labels only on N most recent open lines (recommended)')
custom_label_count = input.int(5, 'Count', minval=1, maxval=20, group='🏷️ Labels', inline='main', tooltip='Number of most recent open lines to label (applies only when View = Custom)\nMost recent draws are typically most relevant for active trading decisions')
label_text_size = input.string('Small', 'Size', options=['Tiny', 'Small', 'Normal', 'Large'], group='🏷️ Labels', inline='style', tooltip='Size of label text displayed on chart lines\nSmaller text reduces visual clutter while maintaining readability')
show_label_suffix = input.bool(false, '(b)/(s)', group='🏷️ Labels', inline='style', tooltip='Add (b) for BSL draws and (s) for SSL draws\nHelps quickly identify draw type at a glance')
suffix_position = input.string('Behind', 'Position', options=['Front', 'Behind'], group='🏷️ Labels', inline='style', tooltip='Position of (b)/(s) suffix:\n• Front: "(b) 5m algo draw"\n• Behind: "5m algo draw (b)"')

// === 🎨 COLORS ===
buyside_color = input.color(color.green, 'BSL Lines', group='🎨 Colors', inline='line_colors', tooltip='Color for buy-side liquidity draw lines\nBSL draws target upward movement when downside breakout attempts fail')
sellside_color = input.color(color.red, 'SSL Lines', group='🎨 Colors', inline='line_colors', tooltip='Color for sell-side liquidity draw lines\nSSL draws target downward movement when upside breakout attempts fail')
bsl_label_text_color = input.color(color.green, 'BSL Label', group='🎨 Colors', inline='label_colors', tooltip='Text color for BSL timeframe labels (independent of line color)\nAllows custom label styling - e.g., black text with yellow lines')
ssl_label_text_color = input.color(color.red, 'SSL Label', group='🎨 Colors', inline='label_colors', tooltip='Text color for SSL timeframe labels (independent of line color)\nAllows custom label styling - e.g., white text with red lines')

// === ✏️ LINE STYLES ===
open_style = input.string('Solid', 'Open Style', options=['Solid', 'Dashed', 'Dotted'], group='✏️ Line Styles', inline='open_style', tooltip='Visual style for active draws that have not yet reached their targets\nSolid lines provide maximum visibility for active algorithmic levels')
open_width = input.int(2, 'Open Width', minval=1, maxval=5, group='✏️ Line Styles', inline='open_style', tooltip='Line thickness for active draws\nThicker lines emphasize importance but may clutter busy timeframes')
filled_style = input.string('Dashed', 'Filled Style', options=['Solid', 'Dashed', 'Dotted'], group='✏️ Line Styles', inline='filled_style', tooltip='Visual style for completed draws that have successfully hit their targets\nDashed style differentiates from active draws while preserving performance history')
filled_width = input.int(1, 'Width', minval=1, maxval=5, group='✏️ Line Styles', inline='filled_style', tooltip='Line thickness for completed draws\nThinner lines keep filled draws subtle while maintaining visual context')
filled_opacity = input.int(70, 'Opacity %', minval=0, maxval=95, group='✏️ Line Styles', inline='filled_style', tooltip='Transparency level for completed draws (0=invisible, 95=nearly opaque)\nHigher opacity emphasizes historical performance, lower keeps focus on active draws')

// === 📊 DASHBOARD ===
dashboard_mode = input.string('Off', 'Mode', options=['Off', 'Standard', 'Compact'], group='📊 Dashboard', inline='pos1', tooltip='Dashboard display options:\n• Off: No dashboard\n• Standard: Full dashboard with all statistics\n• Compact: Minimal view showing only LTF, BSL count, SSL count')
table_position_h = input.string('Right', 'Position', options=['Left', 'Center', 'Right'], group='📊 Dashboard', inline='pos', tooltip='Horizontal table position on chart\nRight position typically avoids interference with price action and indicators')
table_position_v = input.string('Top', '', options=['Top', 'Middle', 'Bottom'], group='📊 Dashboard', inline='pos', tooltip='Vertical table position on chart\nTop position provides immediate reference without obscuring recent price movement')
table_text_size = input.string('Small', 'Text', options=['Tiny', 'Small', 'Normal', 'Large'], group='📊 Dashboard', inline='style', tooltip='Size of table text for optimal readability\nSmall text balances information density with chart space conservation')
table_bg_color = input.color(color.new(color.blue, 90), 'Background', group='📊 Dashboard', inline='style', tooltip='Table background color with transparency control\nSemi-transparent backgrounds maintain chart visibility while ensuring text legibility')
table_border_color = input.color(color.blue, 'Border', group='📊 Dashboard', inline='style', tooltip='Table border color for professional appearance\nMatching or complementary colors provide visual cohesion with your trading setup')
default_text_color = input.color(color.white, 'Text', group='📊 Dashboard', inline='style', tooltip='Default text color for table information\nWhite provides high contrast against most background colors')

// === 🔧 ALGORITHM ===
enable_smart_defaults = input.bool(true, 'Smart Timeframe Defaults', group='🔧 Algorithm', tooltip='Auto-adjusts Historical Scan Bars based on current timeframe:\n\n• 1m, 2m → 800 bars (ultra-short)\n• 3m, 5m → 600 bars (short-term)\n• 7-30m → 500 bars (medium-term)\n• 45m-1H → 400 bars (hourly)\n• 2H-4H → 300 bars (multi-hour)\n• 1D, 1W → 250 bars (daily/weekly)\n\nOptimizes algorithmic context vs computational performance automatically')
lookback_bars = input.int(1500, 'Historical Scan Bars', minval=50, maxval=5000, group='🔧 Algorithm', tooltip='Number of historical bars to analyze for liquidity level identification\n(Only used when Smart Timeframe Defaults is disabled)\nMore bars = better context but slower processing')
extend_bars = input.int(10, 'Extend Lines Beyond Current Price by X bars', minval=0, maxval=100, group='🔧 Algorithm', tooltip='Extend open lines forward by N bars beyond the current price')

// ═══════════════════════════════════════════════════════════════════════════════
// CORE DATA STRUCTURES - BSL FIRST ORDERING
// ═══════════════════════════════════════════════════════════════════════════════

// BUY-SIDE ALGO DRAWS (BSL) - PRIMARY
var array<int> buyside_failure_bars = array.new<int>()
var array<int> buyside_failure_times = array.new<int>()
var array<float> buyside_targets = array.new<float>()
var array<bool> buyside_open = array.new<bool>()
var array<int> buyside_fill_bars = array.new<int>()
var array<int> buyside_fill_times = array.new<int>()
var array<line> buyside_lines = array.new<line>()
var array<label> buyside_labels = array.new<label>()
var array<int> buyside_wick_times = array.new<int>()  // ✅ TOOLTIP: Track wick reference times

// SELL-SIDE ALGO DRAWS (SSL) - SECONDARY
var array<int> sellside_failure_bars = array.new<int>()
var array<int> sellside_failure_times = array.new<int>()
var array<float> sellside_targets = array.new<float>()
var array<bool> sellside_open = array.new<bool>()
var array<int> sellside_fill_bars = array.new<int>()
var array<int> sellside_fill_times = array.new<int>()
var array<line> sellside_lines = array.new<line>()
var array<label> sellside_labels = array.new<label>()
var array<int> sellside_wick_times = array.new<int>()  // ✅ TOOLTIP: Track wick reference times

// TICK-BASED LEVEL TRACKING - Universal symbol compatibility
var array<int> eligible_high_ticks = array.new<int>()
var array<int> eligible_low_ticks = array.new<int>()
var array<int> eligible_high_times = array.new<int>()  // ✅ TOOLTIP: Track when highs created
var array<int> eligible_low_times = array.new<int>()   // ✅ TOOLTIP: Track when lows created

// STATE MANAGEMENT
var string last_ticker = ticker.standard()
var string last_tf = timeframe.period
var bool initialized = false
var table info_table = na
var int bars_processed = 0

// CONSTANTS
filled_lines_count = 10  // Hardcoded for optimal chart clarity

// ═══════════════════════════════════════════════════════════════════════════════
// UTILITY FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// Convert price to tick for precise deduplication
to_tick(price) => math.round(price / syminfo.mintick)
from_tick(tick) => tick * syminfo.mintick

// Style conversions
get_line_style(style_string) =>
    switch style_string
        'Dashed' => line.style_dashed
        'Dotted' => line.style_dotted
        => line.style_solid

get_text_size(size_string) =>
    switch size_string
        'Tiny' => size.tiny
        'Small' => size.small
        'Normal' => size.normal
        'Large' => size.large
        => size.small

get_label_text_size() => get_text_size(label_text_size)
get_table_text_size() => get_text_size(table_text_size)

// Table positioning
get_table_position() =>
    if table_position_v == 'Top'
        if table_position_h == 'Left'
            position.top_left
        else if table_position_h == 'Center'
            position.top_center
        else
            position.top_right
    else if table_position_v == 'Middle'
        if table_position_h == 'Left'
            position.middle_left
        else if table_position_h == 'Center'
            position.middle_center
        else
            position.middle_right
    else  // Bottom
        if table_position_h == 'Left'
            position.bottom_left
        else if table_position_h == 'Center'
            position.bottom_center
        else
            position.bottom_right

// Timeframe formatting
get_tf_tag() =>
    if timeframe.isintraday
        m = timeframe.multiplier
        m % 60 == 0 ? str.tostring(m / 60) + "H" : str.tostring(m) + "m"
    else if timeframe.isdaily
        str.tostring(timeframe.multiplier) + "D"
    else if timeframe.isweekly
        str.tostring(timeframe.multiplier) + "W"
    else if timeframe.ismonthly
        str.tostring(timeframe.multiplier) + "M"
    else
        timeframe.period

get_timeframe_text() => get_tf_tag() + " algo draw"
get_timeframe_text_with_suffix(is_bsl) => 
    base_text = get_tf_tag() + " algo draw"
    if show_label_suffix
        suffix_text = is_bsl ? "(b)" : "(s)"
        if suffix_position == 'Front'
            suffix_text + " " + base_text
        else
            base_text + " " + suffix_text
    else
        base_text

// ✅ TOOLTIP: Format tooltip with wick reference timestamp
format_tooltip(is_bsl, wick_timestamp) =>
    type_text = is_bsl ? "BSL: Wick took LOW" : "SSL: Wick took HIGH"
    formatted_time = str.format_time(wick_timestamp, "MMM dd, yyyy HH:mm", syminfo.timezone)
    type_text + " • " + formatted_time + ", " + get_tf_tag()

// Label creation with independent text color and tooltip
bg_none() => color.new(color.white, 100)

// ✅ TOOLTIP: Modified to accept tooltip parameter
create_end_label(end_time, target_price, label_text_color, tooltip_text) =>
    lab = label.new(
         x=end_time,
         y=target_price,
         text=get_timeframe_text(),
         style=label.style_label_left,
         textcolor=label_text_color,
         size=get_label_text_size(),
         xloc=xloc.bar_time,
         tooltip=tooltip_text  // ✅ TOOLTIP: Add tooltip support
     )
    label.set_color(lab, bg_none())
    lab

// Smart timeframe-based level caps
get_reference_levels_cap() =>
    tf = timeframe.period
    if tf == '1' or tf == '2'
        80   // Ultra-short
    else if tf == '3' or tf == '5'
        100  // Short
    else if tf == '10' or tf == '15' or tf == '30'
        150  // Medium-short
    else if tf == '45' or tf == '60' or tf == '90'
        200  // Medium
    else if tf == '120' or tf == '180' or tf == '240'
        300  // Medium-long
    else if tf == '1D' or tf == '1W'
        400  // Long
    else
        200  // Default

// ✅ TOOLTIP: Modified to track timestamp when level created
add_eligible_high(price, timestamp) =>
    tick = to_tick(price)
    if array.indexof(eligible_high_ticks, tick) == -1
        array.push(eligible_high_ticks, tick)
        array.push(eligible_high_times, timestamp)  // Track when high was created
        while array.size(eligible_high_ticks) > get_reference_levels_cap()
            array.shift(eligible_high_ticks)
            array.shift(eligible_high_times)  // Keep arrays in sync

// ✅ TOOLTIP: Modified to track timestamp when level created
add_eligible_low(price, timestamp) =>
    tick = to_tick(price)
    if array.indexof(eligible_low_ticks, tick) == -1
        array.push(eligible_low_ticks, tick)
        array.push(eligible_low_times, timestamp)   // Track when low was created
        while array.size(eligible_low_ticks) > get_reference_levels_cap()
            array.shift(eligible_low_ticks)
            array.shift(eligible_low_times)   // Keep arrays in sync

// Smart backfill calculation
get_smart_backfill() =>
    if not enable_smart_defaults
        lookback_bars
    else
        tf = timeframe.period
        if tf == '1' or tf == '2'
            800  // Ultra-short
        else if tf == '3' or tf == '5'
            600  // Short
        else if tf == '10' or tf == '15' or tf == '30'
            500  // Medium-short
        else if tf == '45' or tf == '60' or tf == '90'
            400  // Medium
        else if tf == '120' or tf == '180' or tf == '240'
            300  // Medium-long
        else if tf == '1D' or tf == '1W'
            250  // Long
        else
            400  // Default

// ═══════════════════════════════════════════════════════════════════════════════
// STATE RESET FUNCTION
// ═══════════════════════════════════════════════════════════════════════════════

reset_all_state() =>
    // Clean up visual elements - BSL first
    if array.size(buyside_lines) > 0
        for i = 0 to array.size(buyside_lines) - 1
            if not na(array.get(buyside_lines, i))
                line.delete(array.get(buyside_lines, i))

    if array.size(buyside_labels) > 0
        for i = 0 to array.size(buyside_labels) - 1
            if not na(array.get(buyside_labels, i))
                label.delete(array.get(buyside_labels, i))

    if array.size(sellside_lines) > 0
        for i = 0 to array.size(sellside_lines) - 1
            if not na(array.get(sellside_lines, i))
                line.delete(array.get(sellside_lines, i))

    if array.size(sellside_labels) > 0
        for i = 0 to array.size(sellside_labels) - 1
            if not na(array.get(sellside_labels, i))
                label.delete(array.get(sellside_labels, i))

    // Clear all data arrays - BSL first
    array.clear(buyside_failure_bars)
    array.clear(buyside_failure_times)
    array.clear(buyside_targets)
    array.clear(buyside_open)
    array.clear(buyside_fill_bars)
    array.clear(buyside_fill_times)
    array.clear(buyside_lines)
    array.clear(buyside_labels)
    array.clear(buyside_wick_times)  // ✅ TOOLTIP: Clear wick times

    array.clear(sellside_failure_bars)
    array.clear(sellside_failure_times)
    array.clear(sellside_targets)
    array.clear(sellside_open)
    array.clear(sellside_fill_bars)
    array.clear(sellside_fill_times)
    array.clear(sellside_lines)
    array.clear(sellside_labels)
    array.clear(sellside_wick_times)  // ✅ TOOLTIP: Clear wick times

    array.clear(eligible_high_ticks)
    array.clear(eligible_low_ticks)
    array.clear(eligible_high_times)  // ✅ TOOLTIP: Clear level creation times
    array.clear(eligible_low_times)   // ✅ TOOLTIP: Clear level creation times

    true

// ═══════════════════════════════════════════════════════════════════════════════
// CORE ALGORITHM - LIQUIDITY FAILURE DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

process_bar(bar_high, bar_low, bar_close, bar_idx, bar_time) =>

    // STEP 1: Detect liquidity failures - BSL first
    buyside_detected = false
    sellside_detected = false

    // ✅ TOOLTIP: BSL Detection with wick timestamp tracking
    if array.size(eligible_low_ticks) > 0
        for i = 0 to array.size(eligible_low_ticks) - 1
            ref_low = from_tick(array.get(eligible_low_ticks, i))
            if bar_low < ref_low and bar_close >= ref_low
                wick_timestamp = array.get(eligible_low_times, i)  // Get when this low was created
                array.push(buyside_failure_bars, bar_idx)
                array.push(buyside_failure_times, bar_time)
                array.push(buyside_targets, bar_high)
                array.push(buyside_open, true)
                array.push(buyside_fill_bars, int(na))
                array.push(buyside_fill_times, int(na))
                array.push(buyside_lines, na)
                array.push(buyside_labels, na)
                array.push(buyside_wick_times, wick_timestamp)  // Store wick reference time
                buyside_detected := true
                break

    // ✅ TOOLTIP: SSL Detection with wick timestamp tracking
    if array.size(eligible_high_ticks) > 0
        for i = 0 to array.size(eligible_high_ticks) - 1
            ref_high = from_tick(array.get(eligible_high_ticks, i))
            if bar_high > ref_high and bar_close <= ref_high
                wick_timestamp = array.get(eligible_high_times, i)  // Get when this high was created
                array.push(sellside_failure_bars, bar_idx)
                array.push(sellside_failure_times, bar_time)
                array.push(sellside_targets, bar_low)
                array.push(sellside_open, true)
                array.push(sellside_fill_bars, int(na))
                array.push(sellside_fill_times, int(na))
                array.push(sellside_lines, na)
                array.push(sellside_labels, na)
                array.push(sellside_wick_times, wick_timestamp)  // Store wick reference time
                sellside_detected := true
                break

    // STEP 2: Remove broken levels (with timestamp sync)
    if array.size(eligible_high_ticks) > 0
        i = array.size(eligible_high_ticks) - 1
        while i >= 0
            if bar_high >= from_tick(array.get(eligible_high_ticks, i))
                array.remove(eligible_high_ticks, i)
                array.remove(eligible_high_times, i)  // Keep timestamps in sync
            i -= 1

    if array.size(eligible_low_ticks) > 0
        i = array.size(eligible_low_ticks) - 1
        while i >= 0
            if bar_low <= from_tick(array.get(eligible_low_ticks, i))
                array.remove(eligible_low_ticks, i)
                array.remove(eligible_low_times, i)   // Keep timestamps in sync
            i -= 1

    // STEP 3: Add current bar levels with timestamps
    add_eligible_high(bar_high, bar_time)
    add_eligible_low(bar_low, bar_time)

    // STEP 4: Update fills - BSL first
    if array.size(buyside_failure_bars) > 0
        for i = 0 to array.size(buyside_failure_bars) - 1
            if array.get(buyside_open, i) and bar_idx > array.get(buyside_failure_bars, i)
                if bar_high >= array.get(buyside_targets, i)
                    array.set(buyside_open, i, false)
                    array.set(buyside_fill_bars, i, bar_idx)
                    array.set(buyside_fill_times, i, bar_time)

    if array.size(sellside_failure_bars) > 0
        for i = 0 to array.size(sellside_failure_bars) - 1
            if array.get(sellside_open, i) and bar_idx > array.get(sellside_failure_bars, i)
                if bar_low <= array.get(sellside_targets, i)
                    array.set(sellside_open, i, false)
                    array.set(sellside_fill_bars, i, bar_idx)
                    array.set(sellside_fill_times, i, bar_time)

    [buyside_detected, sellside_detected]

// ═══════════════════════════════════════════════════════════════════════════════
// INITIALIZATION & REAL-TIME PROCESSING
// ═══════════════════════════════════════════════════════════════════════════════

// Handle symbol/timeframe changes
input_changed = ticker.standard() != last_ticker or timeframe.period != last_tf

if input_changed
    if reset_all_state()
        initialized := false
        bars_processed := 0
    last_ticker := ticker.standard()
    last_tf := timeframe.period

// Initialize with historical backfill
if not initialized and barstate.islastconfirmedhistory
    effective_lookback = get_smart_backfill()
    max_back = math.min(effective_lookback, bar_index)
    bars_processed := 0

    for i = max_back to 1
        if i <= bar_index
            hist_high = high[i]
            hist_low = low[i]
            hist_close = close[i]
            hist_idx = bar_index - i + 1
            hist_time = time[i]
            process_bar(hist_high, hist_low, hist_close, hist_idx, hist_time)
            bars_processed += 1
    initialized := true

// Process confirmed bars
buyside_created = false
sellside_created = false

if barstate.isconfirmed and initialized
    [buyside_det, sellside_det] = process_bar(high, low, close, bar_index, time)
    buyside_created := buyside_det
    sellside_created := sellside_det
    bars_processed += 1

// Real-time fill detection with instant visual feedback
bsl_draw_filled = false
ssl_draw_filled = false

if not barstate.isconfirmed and initialized
    // BSL fill detection
    if array.size(buyside_failure_bars) > 0
        for i = 0 to array.size(buyside_failure_bars) - 1
            if array.get(buyside_open, i) and bar_index > array.get(buyside_failure_bars, i)
                if high >= array.get(buyside_targets, i)
                    array.set(buyside_open, i, false)
                    array.set(buyside_fill_bars, i, bar_index)
                    array.set(buyside_fill_times, i, time)
                    bsl_draw_filled := true

                    // Instant visual update
                    current_line = array.get(buyside_lines, i)
                    failure_time = array.get(buyside_failure_times, i)
                    target = array.get(buyside_targets, i)

                    if na(current_line)
                        new_line = line.new(failure_time, target, time, target, xloc=xloc.bar_time)
                        array.set(buyside_lines, i, new_line)
                        current_line := new_line

                    line.set_color(current_line, color.new(buyside_color, filled_opacity))
                    line.set_style(current_line, get_line_style(filled_style))
                    line.set_width(current_line, filled_width)
                    line.set_xy2(current_line, time, target)

                    // Remove label on fill
                    current_label = array.get(buyside_labels, i)
                    if not na(current_label)
                        label.delete(current_label)
                        array.set(buyside_labels, i, na)

    // SSL fill detection
    if array.size(sellside_failure_bars) > 0
        for i = 0 to array.size(sellside_failure_bars) - 1
            if array.get(sellside_open, i) and bar_index > array.get(sellside_failure_bars, i)
                if low <= array.get(sellside_targets, i)
                    array.set(sellside_open, i, false)
                    array.set(sellside_fill_bars, i, bar_index)
                    array.set(sellside_fill_times, i, time)
                    ssl_draw_filled := true

                    // Instant visual update
                    current_line = array.get(sellside_lines, i)
                    failure_time = array.get(sellside_failure_times, i)
                    target = array.get(sellside_targets, i)

                    if na(current_line)
                        new_line = line.new(failure_time, target, time, target, xloc=xloc.bar_time)
                        array.set(sellside_lines, i, new_line)
                        current_line := new_line

                    line.set_color(current_line, color.new(sellside_color, filled_opacity))
                    line.set_style(current_line, get_line_style(filled_style))
                    line.set_width(current_line, filled_width)
                    line.set_xy2(current_line, time, target)

                    // Remove label on fill
                    current_label = array.get(sellside_labels, i)
                    if not na(current_label)
                        label.delete(current_label)
                        array.set(sellside_labels, i, na)

// ═══════════════════════════════════════════════════════════════════════════════
// VISUAL DISPLAY SYSTEM - BSL FIRST
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.isconfirmed or barstate.islast

    // BSL DISPLAY PROCESSING
    if enable_buyside and array.size(buyside_failure_bars) > 0
        open_lines_shown = 0
        filled_lines_shown = 0
        open_labels_created = 0

        for i = array.size(buyside_failure_bars) - 1 to 0  // Most recent first
            is_open = array.get(buyside_open, i)
            current_line = array.get(buyside_lines, i)
            current_label = array.get(buyside_labels, i)

            should_show = false

            if is_open and enable_open_lines and open_lines_shown < open_lines_count
                should_show := true
                open_lines_shown += 1
            else if not is_open and enable_filled_lines and filled_lines_shown < filled_lines_count
                should_show := true
                filled_lines_shown += 1

            if should_show
                failure_time = array.get(buyside_failure_times, i)
                target = array.get(buyside_targets, i)
                fill_time = array.get(buyside_fill_times, i)

                end_time = is_open ? time + (timeframe.in_seconds() * 1000 * extend_bars) : fill_time
                line_color = is_open ? buyside_color : color.new(buyside_color, filled_opacity)
                line_style = get_line_style(is_open ? open_style : filled_style)
                line_width_val = is_open ? open_width : filled_width

                if na(current_line)
                    new_line = line.new(failure_time, target, end_time, target, xloc=xloc.bar_time)
                    line.set_color(new_line, line_color)
                    line.set_style(new_line, line_style)
                    line.set_width(new_line, line_width_val)
                    array.set(buyside_lines, i, new_line)
                else
                    line.set_xy1(current_line, failure_time, target)
                    line.set_xy2(current_line, end_time, target)
                    line.set_color(current_line, line_color)
                    line.set_style(current_line, line_style)
                    line.set_width(current_line, line_width_val)

                // ✅ TOOLTIP: Label management with tooltip
                if enable_labels and is_open
                    should_show_label = label_view == 'All' or (label_view == 'Custom' and open_labels_created < custom_label_count)

                    if should_show_label
                        wick_timestamp = array.get(buyside_wick_times, i)
                        tooltip_text = format_tooltip(true, wick_timestamp)

                        if na(current_label)
                            new_label = label.new(
                                 x=end_time,
                                 y=target,
                                 text=get_timeframe_text_with_suffix(true),
                                 style=label.style_label_left,
                                 textcolor=bsl_label_text_color,
                                 size=get_label_text_size(),
                                 xloc=xloc.bar_time,
                                 tooltip=tooltip_text
                             )
                            label.set_color(new_label, bg_none())
                            array.set(buyside_labels, i, new_label)
                        else
                            label.set_xy(current_label, end_time, target)
                            label.set_text(current_label, get_timeframe_text_with_suffix(true))
                            label.set_textcolor(current_label, bsl_label_text_color)
                            label.set_size(current_label, get_label_text_size())
                            label.set_color(current_label, bg_none())
                            label.set_tooltip(current_label, tooltip_text)
                        open_labels_created += 1
                    else if not na(current_label)
                        label.delete(current_label)
                        array.set(buyside_labels, i, na)
                else if not na(current_label)
                    label.delete(current_label)
                    array.set(buyside_labels, i, na)
            else
                // Clean up non-displayed elements
                if not na(current_line)
                    line.delete(current_line)
                    array.set(buyside_lines, i, na)
                if not na(current_label)
                    label.delete(current_label)
                    array.set(buyside_labels, i, na)
    else
        // Clean up when disabled
        if array.size(buyside_lines) > 0
            for i = 0 to array.size(buyside_lines) - 1
                if not na(array.get(buyside_lines, i))
                    line.delete(array.get(buyside_lines, i))
                    array.set(buyside_lines, i, na)
        if array.size(buyside_labels) > 0
            for i = 0 to array.size(buyside_labels) - 1
                if not na(array.get(buyside_labels, i))
                    label.delete(array.get(buyside_labels, i))
                    array.set(buyside_labels, i, na)

    // SSL DISPLAY PROCESSING - Same logic as BSL
    if enable_sellside and array.size(sellside_failure_bars) > 0
        open_lines_shown = 0
        filled_lines_shown = 0
        open_labels_created = 0

        for i = array.size(sellside_failure_bars) - 1 to 0  // Most recent first
            is_open = array.get(sellside_open, i)
            current_line = array.get(sellside_lines, i)
            current_label = array.get(sellside_labels, i)

            should_show = false

            if is_open and enable_open_lines and open_lines_shown < open_lines_count
                should_show := true
                open_lines_shown += 1
            else if not is_open and enable_filled_lines and filled_lines_shown < filled_lines_count
                should_show := true
                filled_lines_shown += 1

            if should_show
                failure_time = array.get(sellside_failure_times, i)
                target = array.get(sellside_targets, i)
                fill_time = array.get(sellside_fill_times, i)

                end_time = is_open ? time + (timeframe.in_seconds() * 1000 * extend_bars) : fill_time
                line_color = is_open ? sellside_color : color.new(sellside_color, filled_opacity)
                line_style = get_line_style(is_open ? open_style : filled_style)
                line_width_val = is_open ? open_width : filled_width

                if na(current_line)
                    new_line = line.new(failure_time, target, end_time, target, xloc=xloc.bar_time)
                    line.set_color(new_line, line_color)
                    line.set_style(new_line, line_style)
                    line.set_width(new_line, line_width_val)
                    array.set(sellside_lines, i, new_line)
                else
                    line.set_xy1(current_line, failure_time, target)
                    line.set_xy2(current_line, end_time, target)
                    line.set_color(current_line, line_color)
                    line.set_style(current_line, line_style)
                    line.set_width(current_line, line_width_val)

                // ✅ TOOLTIP: Label management with tooltip
                if enable_labels and is_open
                    should_show_label = label_view == 'All' or (label_view == 'Custom' and open_labels_created < custom_label_count)

                    if should_show_label
                        wick_timestamp = array.get(sellside_wick_times, i)
                        tooltip_text = format_tooltip(false, wick_timestamp)

                        if na(current_label)
                            new_label = label.new(
                                 x=end_time,
                                 y=target,
                                 text=get_timeframe_text_with_suffix(false),
                                 style=label.style_label_left,
                                 textcolor=ssl_label_text_color,
                                 size=get_label_text_size(),
                                 xloc=xloc.bar_time,
                                 tooltip=tooltip_text
                             )
                            label.set_color(new_label, bg_none())
                            array.set(sellside_labels, i, new_label)
                        else
                            label.set_xy(current_label, end_time, target)
                            label.set_text(current_label, get_timeframe_text_with_suffix(false))
                            label.set_textcolor(current_label, ssl_label_text_color)
                            label.set_size(current_label, get_label_text_size())
                            label.set_color(current_label, bg_none())
                            label.set_tooltip(current_label, tooltip_text)
                        open_labels_created += 1
                    else if not na(current_label)
                        label.delete(current_label)
                        array.set(sellside_labels, i, na)
                else if not na(current_label)
                    label.delete(current_label)
                    array.set(sellside_labels, i, na)
            else
                // Clean up non-displayed elements
                if not na(current_line)
                    line.delete(current_line)
                    array.set(sellside_lines, i, na)
                if not na(current_label)
                    label.delete(current_label)
                    array.set(sellside_labels, i, na)
    else
        // Clean up when disabled
        if array.size(sellside_lines) > 0
            for i = 0 to array.size(sellside_lines) - 1
                if not na(array.get(sellside_lines, i))
                    line.delete(array.get(sellside_lines, i))
                    array.set(sellside_lines, i, na)
        if array.size(sellside_labels) > 0
            for i = 0 to array.size(sellside_labels) - 1
                if not na(array.get(sellside_labels, i))
                    label.delete(array.get(sellside_labels, i))
                    array.set(sellside_labels, i, na)

// ═══════════════════════════════════════════════════════════════════════════════
// PROFESSIONAL INFO TABLE
// ═══════════════════════════════════════════════════════════════════════════════

if dashboard_mode != 'Off'
    if not na(info_table)
        table.delete(info_table)

    // Calculate statistics
    bsl_total = array.size(buyside_targets)
    ssl_total = array.size(sellside_targets)
    bsl_open = 0
    ssl_open = 0

    if bsl_total > 0
        for i = 0 to bsl_total - 1
            if array.get(buyside_open, i)
                bsl_open += 1

    if ssl_total > 0
        for i = 0 to ssl_total - 1
            if array.get(sellside_open, i)
                ssl_open += 1

    // Build dashboard based on mode
    total_active = bsl_open + ssl_open

    if dashboard_mode == 'Compact'
        // Compact: Only LTF, BSL count, SSL count
        info_table := table.new(get_table_position(), 1, 3, bgcolor=table_bg_color, border_width=1, border_color=table_border_color)
        table.cell(info_table, 0, 0, "LTF", text_color=default_text_color, text_size=get_table_text_size())
        table.cell(info_table, 0, 1, "BSL: " + str.tostring(bsl_open), text_color=default_text_color, text_size=get_table_text_size())
        table.cell(info_table, 0, 2, "SSL: " + str.tostring(ssl_open), text_color=default_text_color, text_size=get_table_text_size())
    else
        // Standard: Full dashboard
        header_text = "LTF Dashboard"
        chart_htf_text = "LTF Dashboard"
        bsl_ssl_text = "BSL: " + str.tostring(bsl_open) + " • SSL: " + str.tostring(ssl_open)
        tracking_text = "Tracking: " + str.tostring(array.size(eligible_low_ticks)) + " lows, " + str.tostring(array.size(eligible_high_ticks)) + " highs"
        history_text = "History: " + str.tostring(bars_processed) + " bars"

        info_table := table.new(get_table_position(), 1, 4, bgcolor=table_bg_color, border_width=1, border_color=table_border_color)
        table.cell(info_table, 0, 0, chart_htf_text, text_color=default_text_color, text_size=get_table_text_size())
        table.cell(info_table, 0, 1, bsl_ssl_text, text_color=default_text_color, text_size=get_table_text_size())
        table.cell(info_table, 0, 2, tracking_text, text_color=default_text_color, text_size=get_table_text_size())
        table.cell(info_table, 0, 3, history_text, text_color=default_text_color, text_size=get_table_text_size())


// ═══════════════════════════════════════════════════════════════════════════════
// MEMORY MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.islast
    total_max = math.max(100, open_lines_count + filled_lines_count)

    // Clean BSL arrays
    while array.size(buyside_failure_bars) > (total_max * 8)
        if not na(array.shift(buyside_lines))
            line.delete(array.shift(buyside_lines))
        if not na(array.shift(buyside_labels))
            label.delete(array.shift(buyside_labels))
        array.shift(buyside_failure_bars)
        array.shift(buyside_failure_times)
        array.shift(buyside_targets)
        array.shift(buyside_open)
        array.shift(buyside_fill_bars)
        array.shift(buyside_fill_times)
        array.shift(buyside_wick_times)  // ✅ TOOLTIP: Clean wick times

    // Clean SSL arrays
    while array.size(sellside_failure_bars) > (total_max * 8)
        if not na(array.shift(sellside_lines))
            line.delete(array.shift(sellside_lines))
        if not na(array.shift(sellside_labels))
            label.delete(array.shift(sellside_labels))
        array.shift(sellside_failure_bars)
        array.shift(sellside_failure_times)
        array.shift(sellside_targets)
        array.shift(sellside_open)
        array.shift(sellside_fill_bars)
        array.shift(sellside_fill_times)
        array.shift(sellside_wick_times)  // ✅ TOOLTIP: Clean wick times

// ═══════════════════════════════════════════════════════════════════════════════
// ALERT SYSTEM - BSL FIRST
// ═══════════════════════════════════════════════════════════════════════════════

alertcondition(buyside_created, title='BSL Algo Draw', message='Detected at {{interval}} | BSL Algo Draw at {{close}}')
alertcondition(sellside_created, title='SSL Algo Draw', message='Detected at {{interval}} | SSL Algo Draw at {{close}}')
alertcondition(bsl_draw_filled, title='BSL Algo Draw Filled', message='Filled at {{interval}} | BSL Algo Draw hit target')
alertcondition(ssl_draw_filled, title='SSL Algo Draw Filled', message='Filled at {{interval}} | SSL Algo Draw hit target')

// LTF Algo Draw° [Pro+] v4.0 - Major UI overhaul with compact dashboard modes and label suffixes