//@version=6
indicator('dtt sub-minute •', overlay=true, max_lines_count=500, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ══════════════════════════════════════════════════════════════════════════════

const int SESSIONS_PER_CYCLE = 15
const int MILLISECONDS_PER_DAY = 86400000
const string TIMEZONE = "America/New_York"

// Default Colors and Widths
const color DEFAULT_BOUNDARY_COLOR = color.rgb(156, 156, 156)
const int DEFAULT_BOUNDARY_WIDTH = 1
const color DEFAULT_INTERVAL_COLOR = color.rgb(200, 200, 200)
const color DEFAULT_HIGH_LOW_COLOR = color.rgb(250, 161, 164)
const int DEFAULT_HIGH_LOW_WIDTH = 1

// Session Names
const string SESSION_DAMASU = "Damasu"
const string SESSION_OSAKA = "Osaka"
const string SESSION_KYOTO = "Kyoto"
const string SESSION_NAGASAKI = "Nagasaki"
const string SESSION_TURNCOAT = "Turncoat"
const string SESSION_BISHOP = "Bishop"
const string SESSION_KNIGHT = "Knight"
const string SESSION_BIGBEN = "Big Ben"
const string SESSION_NYOPEN = "NY Open"
const string SESSION_JUDAS = "Judas"
const string SESSION_MODEL11 = "Model 11"
const string SESSION_MODEL110 = "Model 110"
const string SESSION_LUNCH = "Lunch"
const string SESSION_MODEL1001 = "Model 1001"
const string SESSION_MODEL111 = "Model 111"

// Session Times (HHMM format)
const int TIME_DAMASU_START = 1800
const int TIME_DAMASU_END = 1901
const int TIME_OSAKA_START = 1901
const int TIME_OSAKA_END = 2114
const int TIME_KYOTO_START = 2114
const int TIME_KYOTO_END = 2304
const int TIME_NAGASAKI_START = 2304
const int TIME_NAGASAKI_END = 300
const int TIME_TURNCOAT_START = 300
const int TIME_TURNCOAT_END = 344
const int TIME_BISHOP_START = 344
const int TIME_BISHOP_END = 520
const int TIME_KNIGHT_START = 520
const int TIME_KNIGHT_END = 639
const int TIME_BIGBEN_START = 639
const int TIME_BIGBEN_END = 930
const int TIME_NYOPEN_START = 930
const int TIME_NYOPEN_END = 955
const int TIME_JUDAS_START = 955
const int TIME_JUDAS_END = 1020
const int TIME_MODEL11_START = 1020
const int TIME_MODEL11_END = 1110
const int TIME_MODEL110_START = 1110
const int TIME_MODEL110_END = 1149
const int TIME_LUNCH_START = 1149
const int TIME_LUNCH_END = 1235
const int TIME_MODEL1001_START = 1235
const int TIME_MODEL1001_END = 1409
const int TIME_MODEL111_START = 1409
const int TIME_MODEL111_END = 1800

// Interval Times (3 key times within each model session)
const int TIME_DAMASU_INTERVAL1 = 1807
const int TIME_DAMASU_INTERVAL2 = 1822
const int TIME_DAMASU_INTERVAL3 = 1834
const int TIME_OSAKA_INTERVAL1 = 1916
const int TIME_OSAKA_INTERVAL2 = 1949
const int TIME_OSAKA_INTERVAL3 = 2016
const int TIME_KYOTO_INTERVAL1 = 2126
const int TIME_KYOTO_INTERVAL2 = 2154
const int TIME_KYOTO_INTERVAL3 = 2216
const int TIME_NAGASAKI_INTERVAL1 = 2321
const int TIME_NAGASAKI_INTERVAL2 = 29
const int TIME_NAGASAKI_INTERVAL3 = 117
const int TIME_TURNCOAT_INTERVAL1 = 305
const int TIME_TURNCOAT_INTERVAL2 = 316
const int TIME_TURNCOAT_INTERVAL3 = 325
const int TIME_BISHOP_INTERVAL1 = 355
const int TIME_BISHOP_INTERVAL2 = 419
const int TIME_BISHOP_INTERVAL3 = 438
const int TIME_KNIGHT_INTERVAL1 = 529
const int TIME_KNIGHT_INTERVAL2 = 548
const int TIME_KNIGHT_INTERVAL3 = 604
const int TIME_BIGBEN_INTERVAL1 = 658
const int TIME_BIGBEN_INTERVAL2 = 741
const int TIME_BIGBEN_INTERVAL3 = 815
const int TIME_NYOPEN_INTERVAL1 = 936
const int TIME_NYOPEN_INTERVAL2 = 940
const int TIME_NYOPEN_INTERVAL3 = 948
const int TIME_JUDAS_INTERVAL1 = 1002
const int TIME_JUDAS_INTERVAL2 = 1007
const int TIME_JUDAS_INTERVAL3 = 1012
const int TIME_MODEL11_INTERVAL1 = 1034
const int TIME_MODEL11_INTERVAL2 = 1044
const int TIME_MODEL11_INTERVAL3 = 1055
const int TIME_MODEL110_INTERVAL1 = 1121
const int TIME_MODEL110_INTERVAL2 = 1129
const int TIME_MODEL110_INTERVAL3 = 1137
const int TIME_LUNCH_INTERVAL1 = 1202
const int TIME_LUNCH_INTERVAL2 = 1212
const int TIME_LUNCH_INTERVAL3 = 1221
const int TIME_MODEL1001_INTERVAL1 = 1300
const int TIME_MODEL1001_INTERVAL2 = 1320
const int TIME_MODEL1001_INTERVAL3 = 1330
const int TIME_MODEL1001_INTERVAL4 = 1340
const int TIME_MODEL111_INTERVAL1 = 1447
const int TIME_MODEL111_INTERVAL2 = 1514
const int TIME_MODEL111_INTERVAL3 = 1545

// ══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════════════════════

// ─── DISPLAY ───
show_last_n_days = input.int(1, "Show Last N Days", minval=1, maxval=10, group="Display")
show_session_labels = input.bool(true, "Session Labels", group="Display", inline="sess_label")
session_label_size = input.string(size.small, "Size", options=[size.tiny, size.small, size.normal, size.large, size.huge], group="Display", inline="sess_label")

// ─── SESSION BOUNDARIES ───
show_boundaries = input.bool(true, "Start/End?", group="Session Boundaries", inline="boundary1")
boundary_color = input.color(DEFAULT_BOUNDARY_COLOR, "", group="Session Boundaries", inline="boundary1")
boundary_style = input.string(line.style_solid, "Style", options=[line.style_solid, line.style_dashed, line.style_dotted], group="Session Boundaries", inline="boundary2")
boundary_width = input.int(DEFAULT_BOUNDARY_WIDTH, "Width", minval=1, maxval=5, group="Session Boundaries", inline="boundary2")

// ─── SESSION INTERVALS ───
show_intervals = input.bool(true, "Intervals?", group="Session Intervals", inline="interval1", tooltip="Show 3 inner interval markers within each model session")
interval_color = input.color(DEFAULT_INTERVAL_COLOR, "", group="Session Intervals", inline="interval1")
interval_style = input.string(line.style_dashed, "Style", options=[line.style_solid, line.style_dashed, line.style_dotted], group="Session Intervals", inline="interval2")

// ─── PREVIOUS SESSION HIGH & LOW ───
show_pool_lines = input.bool(true, "High & Low?", group="Previous Session High & Low", inline="pool1")
pool_color = input.color(DEFAULT_HIGH_LOW_COLOR, "", group="Previous Session High & Low", inline="pool1")
pool_style = input.string(line.style_solid, "Style", options=[line.style_solid, line.style_dashed, line.style_dotted], group="Previous Session High & Low", inline="pool2")
pool_width = input.int(DEFAULT_HIGH_LOW_WIDTH, "Width", minval=1, maxval=5, group="Previous Session High & Low", inline="pool2")

// ══════════════════════════════════════════════════════════════════════════════
// SESSION TYPE DEFINITIONS
// ══════════════════════════════════════════════════════════════════════════════

type DttSubMinuteSession
    int start_time
    int end_time
    string name
    string prev_session_name
    int start_bar
    int end_bar
    int start_timestamp            // Actual timestamp when session started
    int end_timestamp              // Calculated timestamp when session will end
    float session_high
    float session_low
    line pool_high_line
    line pool_low_line
    line start_boundary_line
    line end_boundary_line
    line interval_line1
    line interval_line2
    line interval_line3
    line interval_line4
    label session_label

type SessionTemplate
    int start_time
    int end_time
    string name
    string prev_session_name

// Get interval times for a session (returns 4 values, 4th is 0 except for Model 1001)
get_interval_times(session_name) =>
    interval1 = 0
    interval2 = 0
    interval3 = 0
    interval4 = 0
    switch session_name
        SESSION_DAMASU =>
            interval1 := TIME_DAMASU_INTERVAL1
            interval2 := TIME_DAMASU_INTERVAL2
            interval3 := TIME_DAMASU_INTERVAL3
        SESSION_OSAKA =>
            interval1 := TIME_OSAKA_INTERVAL1
            interval2 := TIME_OSAKA_INTERVAL2
            interval3 := TIME_OSAKA_INTERVAL3
        SESSION_KYOTO =>
            interval1 := TIME_KYOTO_INTERVAL1
            interval2 := TIME_KYOTO_INTERVAL2
            interval3 := TIME_KYOTO_INTERVAL3
        SESSION_NAGASAKI =>
            interval1 := TIME_NAGASAKI_INTERVAL1
            interval2 := TIME_NAGASAKI_INTERVAL2
            interval3 := TIME_NAGASAKI_INTERVAL3
        SESSION_TURNCOAT =>
            interval1 := TIME_TURNCOAT_INTERVAL1
            interval2 := TIME_TURNCOAT_INTERVAL2
            interval3 := TIME_TURNCOAT_INTERVAL3
        SESSION_BISHOP =>
            interval1 := TIME_BISHOP_INTERVAL1
            interval2 := TIME_BISHOP_INTERVAL2
            interval3 := TIME_BISHOP_INTERVAL3
        SESSION_KNIGHT =>
            interval1 := TIME_KNIGHT_INTERVAL1
            interval2 := TIME_KNIGHT_INTERVAL2
            interval3 := TIME_KNIGHT_INTERVAL3
        SESSION_BIGBEN =>
            interval1 := TIME_BIGBEN_INTERVAL1
            interval2 := TIME_BIGBEN_INTERVAL2
            interval3 := TIME_BIGBEN_INTERVAL3
        SESSION_NYOPEN =>
            interval1 := TIME_NYOPEN_INTERVAL1
            interval2 := TIME_NYOPEN_INTERVAL2
            interval3 := TIME_NYOPEN_INTERVAL3
        SESSION_JUDAS =>
            interval1 := TIME_JUDAS_INTERVAL1
            interval2 := TIME_JUDAS_INTERVAL2
            interval3 := TIME_JUDAS_INTERVAL3
        SESSION_MODEL11 =>
            interval1 := TIME_MODEL11_INTERVAL1
            interval2 := TIME_MODEL11_INTERVAL2
            interval3 := TIME_MODEL11_INTERVAL3
        SESSION_MODEL110 =>
            interval1 := TIME_MODEL110_INTERVAL1
            interval2 := TIME_MODEL110_INTERVAL2
            interval3 := TIME_MODEL110_INTERVAL3
        SESSION_LUNCH =>
            interval1 := TIME_LUNCH_INTERVAL1
            interval2 := TIME_LUNCH_INTERVAL2
            interval3 := TIME_LUNCH_INTERVAL3
        SESSION_MODEL1001 =>
            interval1 := TIME_MODEL1001_INTERVAL1
            interval2 := TIME_MODEL1001_INTERVAL2
            interval3 := TIME_MODEL1001_INTERVAL3
            interval4 := TIME_MODEL1001_INTERVAL4
        SESSION_MODEL111 =>
            interval1 := TIME_MODEL111_INTERVAL1
            interval2 := TIME_MODEL111_INTERVAL2
            interval3 := TIME_MODEL111_INTERVAL3
    [interval1, interval2, interval3, interval4]

// ══════════════════════════════════════════════════════════════════════════════
// INITIALIZATION
// ══════════════════════════════════════════════════════════════════════════════

// Track all session instances across days
var session_instances = array.new<DttSubMinuteSession>()

// Define session templates (in cascade order - 15 DTT sessions)
var session_templates = array.new<SessionTemplate>()
if barstate.isfirst
    array.push(session_templates, SessionTemplate.new(TIME_DAMASU_START, TIME_DAMASU_END, SESSION_DAMASU, SESSION_MODEL111))
    array.push(session_templates, SessionTemplate.new(TIME_OSAKA_START, TIME_OSAKA_END, SESSION_OSAKA, SESSION_DAMASU))
    array.push(session_templates, SessionTemplate.new(TIME_KYOTO_START, TIME_KYOTO_END, SESSION_KYOTO, SESSION_OSAKA))
    array.push(session_templates, SessionTemplate.new(TIME_NAGASAKI_START, TIME_NAGASAKI_END, SESSION_NAGASAKI, SESSION_KYOTO))
    array.push(session_templates, SessionTemplate.new(TIME_TURNCOAT_START, TIME_TURNCOAT_END, SESSION_TURNCOAT, SESSION_NAGASAKI))
    array.push(session_templates, SessionTemplate.new(TIME_BISHOP_START, TIME_BISHOP_END, SESSION_BISHOP, SESSION_TURNCOAT))
    array.push(session_templates, SessionTemplate.new(TIME_KNIGHT_START, TIME_KNIGHT_END, SESSION_KNIGHT, SESSION_BISHOP))
    array.push(session_templates, SessionTemplate.new(TIME_BIGBEN_START, TIME_BIGBEN_END, SESSION_BIGBEN, SESSION_KNIGHT))
    array.push(session_templates, SessionTemplate.new(TIME_NYOPEN_START, TIME_NYOPEN_END, SESSION_NYOPEN, SESSION_BIGBEN))
    array.push(session_templates, SessionTemplate.new(TIME_JUDAS_START, TIME_JUDAS_END, SESSION_JUDAS, SESSION_NYOPEN))
    array.push(session_templates, SessionTemplate.new(TIME_MODEL11_START, TIME_MODEL11_END, SESSION_MODEL11, SESSION_JUDAS))
    array.push(session_templates, SessionTemplate.new(TIME_MODEL110_START, TIME_MODEL110_END, SESSION_MODEL110, SESSION_MODEL11))
    array.push(session_templates, SessionTemplate.new(TIME_LUNCH_START, TIME_LUNCH_END, SESSION_LUNCH, SESSION_MODEL110))
    array.push(session_templates, SessionTemplate.new(TIME_MODEL1001_START, TIME_MODEL1001_END, SESSION_MODEL1001, SESSION_LUNCH))
    array.push(session_templates, SessionTemplate.new(TIME_MODEL111_START, TIME_MODEL111_END, SESSION_MODEL111, SESSION_MODEL1001))

// Get current time in HHMM format
current_hour = hour(time, TIMEZONE)
current_minute = minute(time, TIMEZONE)
current_time = current_hour * 100 + current_minute

// Always process sessions (works for crypto 24/7 and forex/stocks)
process_sessions = true

// ══════════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ══════════════════════════════════════════════════════════════════════════════

get_last_session_of_type(session_name) =>
    result = DttSubMinuteSession.new(0, 0, "", "", na, na, na, na, na, na, na, na, na, na, na, na, na, na, na)
    if array.size(session_instances) > 0
        for i = array.size(session_instances) - 1 to 0
            sess = array.get(session_instances, i)
            if sess.name == session_name and not na(sess.start_bar)
                result := sess
                break
    result

// ══════════════════════════════════════════════════════════════════════════════
// SESSION END DETECTION
// ══════════════════════════════════════════════════════════════════════════════

if array.size(session_instances) > 0
    for j = array.size(session_instances) - 1 to 0
        sess = array.get(session_instances, j)
        if not na(sess.start_bar) and na(sess.end_bar)
            // Check if we've passed the end time
            in_session = false
            if sess.end_time > sess.start_time
                in_session := current_time >= sess.start_time and current_time < sess.end_time
            else
                in_session := current_time >= sess.start_time or current_time < sess.end_time

            session_should_end = not in_session

            if session_should_end
                sess.end_bar := bar_index

                // End boundary was already drawn at session creation, no need to redraw

                array.set(session_instances, j, sess)

// ══════════════════════════════════════════════════════════════════════════════
// CLEAN UP OLD SESSIONS
// ══════════════════════════════════════════════════════════════════════════════

if array.size(session_instances) > 0
    sessions_to_keep = show_last_n_days * SESSIONS_PER_CYCLE
    total_sessions = array.size(session_instances)

    if total_sessions > sessions_to_keep
        sessions_to_delete = total_sessions - sessions_to_keep

        for i = 0 to sessions_to_delete - 1
            sess = array.get(session_instances, i)
            if not na(sess.start_boundary_line)
                line.delete(sess.start_boundary_line)
            if not na(sess.end_boundary_line)
                line.delete(sess.end_boundary_line)
            if not na(sess.interval_line1)
                line.delete(sess.interval_line1)
            if not na(sess.interval_line2)
                line.delete(sess.interval_line2)
            if not na(sess.interval_line3)
                line.delete(sess.interval_line3)
            if not na(sess.interval_line4)
                line.delete(sess.interval_line4)
            if not na(sess.pool_high_line)
                line.delete(sess.pool_high_line)
            if not na(sess.pool_low_line)
                line.delete(sess.pool_low_line)
            if not na(sess.session_label)
                label.delete(sess.session_label)

        for i = 0 to sessions_to_delete - 1
            array.shift(session_instances)

// ══════════════════════════════════════════════════════════════════════════════
// CREATE NEW SESSIONS
// ══════════════════════════════════════════════════════════════════════════════

if process_sessions
    for i = 0 to array.size(session_templates) - 1
        template = array.get(session_templates, i)

        // Check if we're in this session's time range
        in_session_time = false
        if template.end_time > template.start_time
            in_session_time := current_time >= template.start_time and current_time < template.end_time
        else
            in_session_time := current_time >= template.start_time or current_time < template.end_time

        // Check if this session type already has an active instance
        session_exists = false
        if array.size(session_instances) > 0
            for j = array.size(session_instances) - 1 to 0
                sess = array.get(session_instances, j)
                if sess.name == template.name and not na(sess.start_bar) and na(sess.end_bar)
                    session_exists := true
                    break

        // Create session if we're in its time range and it doesn't exist yet
        if in_session_time and not session_exists
            // Calculate end_timestamp for this session
            end_hour = math.floor(template.end_time / 100)
            end_minute = template.end_time % 100
            current_year = year(time, TIMEZONE)
            current_month = month(time, TIMEZONE)
            current_date = dayofmonth(time, TIMEZONE)
            calculated_end_timestamp = timestamp(TIMEZONE, current_year, current_month, current_date, end_hour, end_minute)

            // If session wraps midnight, add a day
            if template.end_time < template.start_time
                calculated_end_timestamp := calculated_end_timestamp + MILLISECONDS_PER_DAY

            new_sess = DttSubMinuteSession.new(template.start_time, template.end_time, template.name, template.prev_session_name, bar_index, na, time, calculated_end_timestamp, high, low, na, na, na, na, na, na, na, na, na)
            array.push(session_instances, new_sess)

            idx = array.size(session_instances) - 1
            curr_sess = array.get(session_instances, idx)

            // Delete previous session's end boundary (replaced by current session's start boundary)
            prev_session = get_last_session_of_type(template.prev_session_name)
            if not na(prev_session.end_boundary_line)
                line.delete(prev_session.end_boundary_line)
                // Update the previous session in the array
                if array.size(session_instances) > 1
                    for j = array.size(session_instances) - 2 to 0
                        check_sess = array.get(session_instances, j)
                        if check_sess.name == template.prev_session_name and not na(check_sess.start_bar)
                            check_sess.end_boundary_line := na
                            array.set(session_instances, j, check_sess)
                            break

            // Draw start boundary at current bar using bar time
            if show_boundaries
                curr_sess.start_boundary_line := line.new(time, 1e10, time, -1e6, xloc=xloc.bar_time, color=boundary_color, width=boundary_width, style=boundary_style)

            // Draw end boundary at calculated end time
            if show_boundaries
                curr_sess.end_boundary_line := line.new(calculated_end_timestamp, 1e10, calculated_end_timestamp, -1e6, xloc=xloc.bar_time, color=boundary_color, width=boundary_width, style=boundary_style)

            // Draw high/low lines from previous session (will be updated when session ends)
            if show_pool_lines and not na(prev_session.session_high) and not na(prev_session.session_low)
                curr_sess.pool_high_line := line.new(time, prev_session.session_high, calculated_end_timestamp, prev_session.session_high, xloc=xloc.bar_time, color=pool_color, width=pool_width, style=pool_style)
                curr_sess.pool_low_line := line.new(time, prev_session.session_low, calculated_end_timestamp, prev_session.session_low, xloc=xloc.bar_time, color=pool_color, width=pool_width, style=pool_style)

            // Draw session name label at midpoint
            if show_session_labels
                session_midpoint_timestamp = math.round((time + calculated_end_timestamp) / 2)
                curr_sess.session_label := label.new(session_midpoint_timestamp, high, text=template.name, xloc=xloc.bar_time, style=label.style_none, color=color.new(color.white, 100), textcolor=color.new(boundary_color, 50), size=session_label_size)

            // Draw interval lines
            if show_intervals
                [interval1_time, interval2_time, interval3_time, interval4_time] = get_interval_times(template.name)

                current_year = year(time, TIMEZONE)
                current_month = month(time, TIMEZONE)
                current_date = dayofmonth(time, TIMEZONE)

                // Interval 1
                interval1_hour = math.floor(interval1_time / 100)
                interval1_minute = interval1_time % 100
                interval1_timestamp = timestamp(TIMEZONE, current_year, current_month, current_date, interval1_hour, interval1_minute)
                if interval1_time < template.start_time and template.end_time < template.start_time
                    interval1_timestamp := interval1_timestamp + MILLISECONDS_PER_DAY
                curr_sess.interval_line1 := line.new(interval1_timestamp, 1e10, interval1_timestamp, -1e6, xloc=xloc.bar_time, color=interval_color, width=1, style=interval_style)

                // Interval 2
                interval2_hour = math.floor(interval2_time / 100)
                interval2_minute = interval2_time % 100
                interval2_timestamp = timestamp(TIMEZONE, current_year, current_month, current_date, interval2_hour, interval2_minute)
                if interval2_time < template.start_time and template.end_time < template.start_time
                    interval2_timestamp := interval2_timestamp + MILLISECONDS_PER_DAY
                curr_sess.interval_line2 := line.new(interval2_timestamp, 1e10, interval2_timestamp, -1e6, xloc=xloc.bar_time, color=interval_color, width=1, style=interval_style)

                // Interval 3
                interval3_hour = math.floor(interval3_time / 100)
                interval3_minute = interval3_time % 100
                interval3_timestamp = timestamp(TIMEZONE, current_year, current_month, current_date, interval3_hour, interval3_minute)
                if interval3_time < template.start_time and template.end_time < template.start_time
                    interval3_timestamp := interval3_timestamp + MILLISECONDS_PER_DAY
                curr_sess.interval_line3 := line.new(interval3_timestamp, 1e10, interval3_timestamp, -1e6, xloc=xloc.bar_time, color=interval_color, width=1, style=interval_style)

                // Interval 4 (Model 1001 only)
                if interval4_time > 0
                    interval4_hour = math.floor(interval4_time / 100)
                    interval4_minute = interval4_time % 100
                    interval4_timestamp = timestamp(TIMEZONE, current_year, current_month, current_date, interval4_hour, interval4_minute)
                    if interval4_time < template.start_time and template.end_time < template.start_time
                        interval4_timestamp := interval4_timestamp + MILLISECONDS_PER_DAY
                    curr_sess.interval_line4 := line.new(interval4_timestamp, 1e10, interval4_timestamp, -1e6, xloc=xloc.bar_time, color=interval_color, width=1, style=interval_style)

            array.set(session_instances, idx, curr_sess)

// ══════════════════════════════════════════════════════════════════════════════
// UPDATE SESSION HIGHS/LOWS
// ══════════════════════════════════════════════════════════════════════════════

if array.size(session_instances) > 0
    for i = 0 to array.size(session_instances) - 1
        sess = array.get(session_instances, i)
        if not na(sess.start_bar) and na(sess.end_bar)
            // Check if we're in session
            in_session = false
            if sess.start_time > sess.end_time
                in_session := (current_time >= sess.start_time or current_time < sess.end_time)
            else
                in_session := (current_time >= sess.start_time and current_time < sess.end_time)

            if in_session
                // Update high/low using native bar data
                if high > sess.session_high
                    sess.session_high := high
                if low < sess.session_low
                    sess.session_low := low

                array.set(session_instances, i, sess)

// dtt sub-minute •
