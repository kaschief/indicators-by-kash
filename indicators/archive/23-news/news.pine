//@version=6

import toodegrees/forex_factory_utility/17 as ffUtil
import toodegrees/forex_factory_decoding/44 as ffDec

// ═════════════════════════════════════════════════════════════════════════════
// INDICATOR SETUP
// ═════════════════════════════════════════════════════════════════════════════
INDICATOR_TITLE = "news •"
INDICATOR_MAX_LINES = 500
INDICATOR_MAX_LABELS = 500

indicator(INDICATOR_TITLE, shorttitle="news •", overlay=true, max_lines_count=INDICATOR_MAX_LINES, max_labels_count=INDICATOR_MAX_LABELS)

// ═════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ═════════════════════════════════════════════════════════════════════════════
NY_TIMEZONE = "America/New_York"
NEWS_TIMEZONE_HOUR_OFFSET = 0
NEWS_TIMEZONE_MINUTE_OFFSET = 0
SECONDS_PER_DAY = 24 * 60 * 60

HISTORY_TODAY = "Today"
HISTORY_THIS_WEEK = "This Week"
HISTORY_MANUAL = "Manual"

LABEL_POSITION_AUTO = "Auto"

SIZE_TINY = "Tiny"
SIZE_SMALL = "Small"
SIZE_NORMAL = "Normal"
SIZE_LARGE = "Large"
SIZE_HUGE = "Huge"

TABLE_HORIZONTAL_LEFT = "Left"
TABLE_HORIZONTAL_CENTER = "Center"
TABLE_HORIZONTAL_RIGHT = "Right"
TABLE_VERTICAL_TOP = "Top"
TABLE_VERTICAL_MIDDLE = "Middle"
TABLE_VERTICAL_BOTTOM = "Bottom"

GROUP_IMPACT = "⚡ Impact"
GROUP_CHART = "📍 Chart"
GROUP_DOTS = "Dots"
GROUP_TABLE = "📋 Table"

NEWS_TABLE_HEADER_TEXT_COLOR = color.rgb(255, 255, 255)
NEWS_TABLE_HEADER_BACKGROUND_COLOR = color.rgb(41, 98, 255)
NEWS_TABLE_PAST_TEXT_COLOR = color.rgb(120, 123, 134)
NEWS_TABLE_FUTURE_TEXT_COLOR = color.rgb(33, 33, 33)
NEWS_TABLE_ROW_BACKGROUND_COLOR = color.rgb(249, 248, 248)
NEWS_TABLE_BORDER_COLOR = color.rgb(144, 191, 249)

IMPACT_TOOLTIP = "Impact\n\n• 🔴 — High.\n• 🟠 — Medium.\n• 🟡 — Low.\n• ⚪ — Holiday."
CHART_HISTORY_TOOLTIP = "Chart history\n\n• Today — Keep the current day's drawings.\n• This Week — Keep the current week's drawings.\n• Manual — Retain the adjacent number of calendar days.\n\nDaily charts use This Week because intraday Today mode is unavailable there."
DOT_SIZE_TOOLTIP = "Dot size\n\n• 🔴 — High impact.\n• 🟠 — Medium impact.\n• 🟡 — Low impact.\n\nOnly enabled impacts are drawn. A candle with multiple events uses the size of its highest enabled impact."
DOT_OUTLINE_TOOLTIP = "Apply the library's outline to every dot."
CHART_LINE_TOOLTIP = "Draw enabled upcoming impacts as heavy dotted lines. Hover a line at the current-price level to see its events."
TABLE_CONTENT_TOOLTIP = "Show today's events or the current week. Daily charts use This Week. Times always use 24-hour format."
TABLE_POSITION_TOOLTIP = "Table position and text size."

// ═════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═════════════════════════════════════════════════════════════════════════════
showHighImpact = input.bool(true, "🔴", inline="impact", group=GROUP_IMPACT)
showMediumImpact = input.bool(true, "🟠", inline="impact", group=GROUP_IMPACT)
showLowImpact = input.bool(false, "🟡", inline="impact", group=GROUP_IMPACT)
showHoliday = input.bool(true, "⚪", inline="impact", group=GROUP_IMPACT, tooltip=IMPACT_TOOLTIP)

chartHistoryMode = input.string(HISTORY_TODAY, "History", options=[HISTORY_TODAY, HISTORY_THIS_WEEK, HISTORY_MANUAL], inline="chart_history", group=GROUP_CHART)
manualHistoryDays = input.int(30, "Days", minval=1, maxval=365, inline="chart_history", group=GROUP_CHART, active=chartHistoryMode == HISTORY_MANUAL, tooltip=CHART_HISTORY_TOOLTIP)
showChartLines = input.bool(true, "Lines", group=GROUP_CHART, tooltip=CHART_LINE_TOOLTIP)

highImpactDotSizeInput = input.string(SIZE_NORMAL, "🔴", options=[SIZE_TINY, SIZE_SMALL, SIZE_NORMAL, SIZE_LARGE, SIZE_HUGE], inline="dot_sizes", group=GROUP_DOTS)
mediumImpactDotSizeInput = input.string(SIZE_NORMAL, "🟠", options=[SIZE_TINY, SIZE_SMALL, SIZE_NORMAL, SIZE_LARGE, SIZE_HUGE], inline="dot_sizes", group=GROUP_DOTS)
lowImpactDotSizeInput = input.string(SIZE_NORMAL, "🟡", options=[SIZE_TINY, SIZE_SMALL, SIZE_NORMAL, SIZE_LARGE, SIZE_HUGE], inline="dot_sizes", group=GROUP_DOTS, tooltip=DOT_SIZE_TOOLTIP)
showDotOutline = input.bool(true, "Outline", group=GROUP_DOTS, tooltip=DOT_OUTLINE_TOOLTIP)

showNewsTable = input.bool(false, "Table", inline="table_content", group=GROUP_TABLE)
tablePeriod = input.string(HISTORY_THIS_WEEK, "", options=[HISTORY_TODAY, HISTORY_THIS_WEEK], inline="table_content", group=GROUP_TABLE, active=showNewsTable, tooltip=TABLE_CONTENT_TOOLTIP)
tableHorizontalPosition = input.string(TABLE_HORIZONTAL_CENTER, "", options=[TABLE_HORIZONTAL_LEFT, TABLE_HORIZONTAL_CENTER, TABLE_HORIZONTAL_RIGHT], inline="table_position", group=GROUP_TABLE, active=showNewsTable)
tableVerticalPosition = input.string(TABLE_VERTICAL_BOTTOM, "", options=[TABLE_VERTICAL_TOP, TABLE_VERTICAL_MIDDLE, TABLE_VERTICAL_BOTTOM], inline="table_position", group=GROUP_TABLE, active=showNewsTable)
tableSizeInput = input.string(SIZE_TINY, "", options=[SIZE_TINY, SIZE_SMALL, SIZE_NORMAL, SIZE_LARGE, SIZE_HUGE], inline="table_position", group=GROUP_TABLE, active=showNewsTable, tooltip=TABLE_POSITION_TOOLTIP)

// ═════════════════════════════════════════════════════════════════════════════
// HELPERS
// ═════════════════════════════════════════════════════════════════════════════
requestNewsData() =>
    string encodedBar = str.tostring(open) + "," + str.tostring(high) + "," + str.tostring(low) + "," + str.tostring(close) + "," + str.tostring(volume)
    [request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_1", encodedBar),
     request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_2", encodedBar),
     request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_3", encodedBar),
     request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_4", encodedBar),
     request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_5", encodedBar),
     request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_6", encodedBar),
     request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_7", encodedBar),
     request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_8", encodedBar),
     request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_9", encodedBar)]

decodeNewsData(array<ffUtil.News> target, string slot1, string slot2, string slot3, string slot4, string slot5, string slot6, string slot7, string slot8, string slot9) =>
    ffDec.readNews(target, slot1)
    ffDec.readNews(target, slot2)
    ffDec.readNews(target, slot3)
    ffDec.readNews(target, slot4)
    ffDec.readNews(target, slot5)
    ffDec.readNews(target, slot6)
    ffDec.readNews(target, slot7)
    ffDec.readNews(target, slot8)
    ffDec.readNews(target, slot9)

calendarDayStart(string timezone) =>
    ta.change(dayofmonth(time, timezone)) != 0

filterNews(array<ffUtil.News> source, array<string> symbolFilter, array<color> impactSelection) =>
    array<ffUtil.News> filtered = array.copy(source)
    ffUtil.weekNews(filtered, symbolFilter, impactSelection)

cloneNewsForTable(array<ffUtil.News> source) =>
    array<ffUtil.News> cloned = array.new<ffUtil.News>()
    int eventCount = array.size(source)
    if eventCount > 0
        for eventIndex = 0 to eventCount - 1
            ffUtil.News event = array.get(source, eventIndex)
            array.push(cloned, ffUtil.News.new(event.dow, event.dat, event._t, event.tod, event.cur, event.imp, event.ttl, event.tmst))
    cloned

drawFutureNewsLines(array<ffUtil.News> events) =>
    ffUtil.FF_OnChartLine(events, ffUtil.lineTrnsp("Heavy"), ffUtil.lineStyle("Dotted"))

drawImpactDots(array<ffUtil.News> events, string dotSize, bool outline) =>
    ffUtil.FF_OnChartLabel(events, LABEL_POSITION_AUTO, ffUtil.size(dotSize), outline)

eventsInTimeRange(array<ffUtil.News> events, int rangeStart, int rangeEnd) =>
    array<ffUtil.News> matchingEvents = array.new<ffUtil.News>()
    int eventCount = array.size(events)
    if eventCount > 0
        for eventIndex = 0 to eventCount - 1
            ffUtil.News event = array.get(events, eventIndex)
            if event.tmst >= rangeStart and event.tmst < rangeEnd
                array.push(matchingEvents, event)
    matchingEvents

hasEventInTimeRange(array<ffUtil.News> events, int rangeStart, int rangeEnd) =>
    bool found = false
    int eventCount = array.size(events)
    if eventCount > 0
        for eventIndex = 0 to eventCount - 1
            ffUtil.News event = array.get(events, eventIndex)
            int eventTime = event.tmst
            if eventTime >= rangeStart and eventTime < rangeEnd
                found := true
                break
    found

clearLabels(array<label> labels) =>
    while array.size(labels) > 0
        label.delete(array.pop(labels))

appendImpactEventsAtTime(string existingText, array<ffUtil.News> events, int eventTime, string impactSymbol) =>
    string tooltipText = existingText
    int eventCount = array.size(events)
    if eventCount > 0
        for eventIndex = 0 to eventCount - 1
            ffUtil.News event = array.get(events, eventIndex)
            if event.tmst == eventTime
                string separator = str.length(tooltipText) > 0 ? "\n" : ""
                tooltipText := tooltipText + separator + impactSymbol + " " + event.ttl + " (" + event.cur + ")"
    tooltipText

eventsAtTimeTooltip(array<ffUtil.News> highImpactEvents, array<ffUtil.News> mediumImpactEvents, array<ffUtil.News> lowImpactEvents, array<ffUtil.News> holidayEvents, int eventTime) =>
    string tooltipText = appendImpactEventsAtTime("", highImpactEvents, eventTime, "🔴")
    tooltipText := appendImpactEventsAtTime(tooltipText, mediumImpactEvents, eventTime, "🟠")
    tooltipText := appendImpactEventsAtTime(tooltipText, lowImpactEvents, eventTime, "🟡")
    appendImpactEventsAtTime(tooltipText, holidayEvents, eventTime, "⚪")

addLineHoverTarget(array<label> targets, int eventTime, float anchorPrice, string tooltipText) =>
    label target = label.new(x=eventTime, y=anchorPrice, text=" ", xloc=xloc.bar_time, yloc=yloc.price, color=color.new(color.white, 100), style=label.style_label_center, textcolor=color.new(color.white, 100), size=size.huge, tooltip=tooltipText)
    array.push(targets, target)

rebuildLineHoverTargets(array<label> targets, array<ffUtil.News> visibleEvents, array<ffUtil.News> highImpactEvents, array<ffUtil.News> mediumImpactEvents, array<ffUtil.News> lowImpactEvents, array<ffUtil.News> holidayEvents, float anchorPrice, int currentTime) =>
    clearLabels(targets)
    int groupedTime = na
    int eventCount = array.size(visibleEvents)
    if eventCount > 0
        for eventIndex = 0 to eventCount - 1
            ffUtil.News event = array.get(visibleEvents, eventIndex)
            if event.tmst >= currentTime
                if na(groupedTime)
                    groupedTime := event.tmst
                else if event.tmst != groupedTime
                    addLineHoverTarget(targets, groupedTime, anchorPrice, eventsAtTimeTooltip(highImpactEvents, mediumImpactEvents, lowImpactEvents, holidayEvents, groupedTime))
                    groupedTime := event.tmst
        if not na(groupedTime)
            addLineHoverTarget(targets, groupedTime, anchorPrice, eventsAtTimeTooltip(highImpactEvents, mediumImpactEvents, lowImpactEvents, holidayEvents, groupedTime))

moveLineHoverTargets(array<label> targets, float anchorPrice) =>
    int targetCount = array.size(targets)
    if targetCount > 0
        for targetIndex = 0 to targetCount - 1
            label.set_y(array.get(targets, targetIndex), anchorPrice)

// ═════════════════════════════════════════════════════════════════════════════
// SETTINGS
// ═════════════════════════════════════════════════════════════════════════════
float chartTimeframeSeconds = timeframe.in_seconds(timeframe.period)
if not na(chartTimeframeSeconds) and chartTimeframeSeconds > SECONDS_PER_DAY
    runtime.error("Use the Daily timeframe or lower.")
else if not na(chartTimeframeSeconds) and chartTimeframeSeconds < 30
    runtime.error("Use the 30-second timeframe or higher.")

string effectiveChartHistoryMode = timeframe.isdaily and chartHistoryMode == HISTORY_TODAY ? HISTORY_THIS_WEEK : chartHistoryMode
string effectiveTablePeriod = timeframe.isdaily ? HISTORY_THIS_WEEK : tablePeriod
tableLocation = ffUtil.boxLoc(tableHorizontalPosition, tableVerticalPosition)
impactFilter = ffUtil.impFilter(showHoliday, showLowImpact, showMediumImpact, showHighImpact)
dotImpactFilter = ffUtil.impFilter(false, showLowImpact, showMediumImpact, showHighImpact)
highImpactNewsFilter = ffUtil.impFilter(false, false, false, showHighImpact)
mediumImpactNewsFilter = ffUtil.impFilter(false, false, showMediumImpact, false)
lowImpactNewsFilter = ffUtil.impFilter(false, showLowImpact, false, false)
holidayNewsFilter = ffUtil.impFilter(showHoliday, false, false, false)
automaticSymbolFilter = ffUtil.curFilter(true, false, false, false, false, false, false, false, false, false)

bool newDay = calendarDayStart(NY_TIMEZONE)
var bool chartSwitchesAtNyMidnight = false
if newDay and hour(time, NY_TIMEZONE) == 0
    chartSwitchesAtNyMidnight := true

// ═════════════════════════════════════════════════════════════════════════════
// NEWS DATA
// ═════════════════════════════════════════════════════════════════════════════
var array<ffUtil.News> currentWeek = array.new<ffUtil.News>()
var array<ffUtil.News> currentDotWeek = array.new<ffUtil.News>()
var array<ffUtil.News> currentHighImpactNews = array.new<ffUtil.News>()
var array<ffUtil.News> currentMediumImpactNews = array.new<ffUtil.News>()
var array<ffUtil.News> currentLowImpactNews = array.new<ffUtil.News>()
var array<ffUtil.News> currentHolidayNews = array.new<ffUtil.News>()
var array<ffUtil.News> nextWeek = array.new<ffUtil.News>()
var array<ffUtil.News> currentDay = array.new<ffUtil.News>()
var array<ffUtil.News> tableEvents = array.new<ffUtil.News>()
var array<label> lineHoverTargets = array.new<label>()

[slot1, slot2, slot3, slot4, slot5, slot6, slot7, slot8, slot9] = requestNewsData()

if timeframe.change("W")
    nextWeek := ffUtil.bubbleSort_News(nextWeek)
    currentWeek := filterNews(nextWeek, automaticSymbolFilter, impactFilter)
    currentDotWeek := filterNews(nextWeek, automaticSymbolFilter, dotImpactFilter)
    currentHighImpactNews := filterNews(nextWeek, automaticSymbolFilter, highImpactNewsFilter)
    currentMediumImpactNews := filterNews(nextWeek, automaticSymbolFilter, mediumImpactNewsFilter)
    currentLowImpactNews := filterNews(nextWeek, automaticSymbolFilter, lowImpactNewsFilter)
    currentHolidayNews := filterNews(nextWeek, automaticSymbolFilter, holidayNewsFilter)
    array.clear(nextWeek)

if newDay
    array.clear(currentDay)
    currentDay := ffUtil.todayNews(currentWeek, currentDay, chartSwitchesAtNyMidnight)

decodeNewsData(nextWeek, slot1, slot2, slot3, slot4, slot5, slot6, slot7, slot8, slot9)

// ═════════════════════════════════════════════════════════════════════════════
// TABLE AND CHART DRAWINGS
// ═════════════════════════════════════════════════════════════════════════════
var table newsTable = ffUtil.newTable(tableLocation, NEWS_TABLE_BORDER_COLOR)

if array.size(currentWeek) > 0 and showNewsTable
    if effectiveTablePeriod == HISTORY_TODAY
        if newDay
            tableEvents := cloneNewsForTable(currentDay)
            newsTable := ffUtil.FF_Table(tableEvents, tableLocation, tableSizeInput, NEWS_TABLE_HEADER_TEXT_COLOR, NEWS_TABLE_HEADER_BACKGROUND_COLOR, NEWS_TABLE_FUTURE_TEXT_COLOR, NEWS_TABLE_ROW_BACKGROUND_COLOR, NEWS_TABLE_BORDER_COLOR)
        ffUtil.timeline(tableEvents, newsTable, NEWS_TABLE_PAST_TEXT_COLOR, NEWS_TIMEZONE_HOUR_OFFSET, NEWS_TIMEZONE_MINUTE_OFFSET, true)
    else
        if timeframe.change("W")
            tableEvents := cloneNewsForTable(currentWeek)
            newsTable := ffUtil.FF_Table(tableEvents, tableLocation, tableSizeInput, NEWS_TABLE_HEADER_TEXT_COLOR, NEWS_TABLE_HEADER_BACKGROUND_COLOR, NEWS_TABLE_FUTURE_TEXT_COLOR, NEWS_TABLE_ROW_BACKGROUND_COLOR, NEWS_TABLE_BORDER_COLOR)
        ffUtil.timeline(tableEvents, newsTable, NEWS_TABLE_PAST_TEXT_COLOR, NEWS_TIMEZONE_HOUR_OFFSET, NEWS_TIMEZONE_MINUTE_OFFSET)
else
    table.delete(newsTable)

if showChartLines
    if effectiveChartHistoryMode == HISTORY_TODAY and newDay
        drawFutureNewsLines(currentDay)
        rebuildLineHoverTargets(lineHoverTargets, currentDay, currentHighImpactNews, currentMediumImpactNews, currentLowImpactNews, currentHolidayNews, close, time)
    else if effectiveChartHistoryMode != HISTORY_TODAY and timeframe.change("W")
        drawFutureNewsLines(currentWeek)
        rebuildLineHoverTargets(lineHoverTargets, currentWeek, currentHighImpactNews, currentMediumImpactNews, currentLowImpactNews, currentHolidayNews, close, time)
    else if effectiveChartHistoryMode != HISTORY_TODAY and newDay
        rebuildLineHoverTargets(lineHoverTargets, currentWeek, currentHighImpactNews, currentMediumImpactNews, currentLowImpactNews, currentHolidayNews, close, time)

int dotBarEndTime = na(time_close) ? math.max(time + 1, timenow + 1) : time_close
array<ffUtil.News> dotEventsThisBar = eventsInTimeRange(currentDotWeek, time, dotBarEndTime)
if array.size(dotEventsThisBar) > 0
    bool barHasHighImpact = hasEventInTimeRange(currentHighImpactNews, time, dotBarEndTime)
    bool barHasMediumImpact = hasEventInTimeRange(currentMediumImpactNews, time, dotBarEndTime)
    string dotSize = barHasHighImpact ? highImpactDotSizeInput : barHasMediumImpact ? mediumImpactDotSizeInput : lowImpactDotSizeInput
    drawImpactDots(dotEventsThisBar, dotSize, showDotOutline)

ffUtil.historical(manualHistoryDays, effectiveChartHistoryMode == HISTORY_TODAY, effectiveChartHistoryMode == HISTORY_THIS_WEEK, "Future")

if barstate.islast
    if showChartLines
        moveLineHoverTargets(lineHoverTargets, close)
    else
        clearLabels(lineHoverTargets)

// Daily charts need a second weekly-boundary decode to preserve the library's feed buffer.
if timeframe.isdaily and timeframe.change("W")
    decodeNewsData(nextWeek, slot1, slot2, slot3, slot4, slot5, slot6, slot7, slot8, slot9)

// news •
