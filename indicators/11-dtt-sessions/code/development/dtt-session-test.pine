//@version=6
indicator("DTT Session Test", overlay=true, max_lines_count=500, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ══════════════════════════════════════════════════════════════════════════════

const int SESSIONS_PER_CYCLE = 15
const int MILLISECONDS_PER_DAY = 86400000
const int LOOKBACK_BARS = 500
const string TIMEZONE = "America/New_York"
const string ARROW_UP = "▲"
const string ARROW_DOWN = "▼"

// Pattern Labels
const string PATTERN_IMMEDIATE = "IMM"
const string PATTERN_STANDARD = "STD"
const string PATTERN_DELAYED = "DEL"

// Default Colors and Widths
const color DEFAULT_BOUNDARY_COLOR = color.rgb(156, 156, 156)  // #9c9c9c
const int DEFAULT_BOUNDARY_WIDTH = 1
const color DEFAULT_HIGH_LOW_COLOR = color.rgb(250, 161, 164)  // #faa1a4
const int DEFAULT_HIGH_LOW_WIDTH = 1
const color DEFAULT_ROOT_ZONE_COLOR = color.rgb(225, 190, 231)  // #e1bee7
const color DEFAULT_ROOT_LINE_COLOR = color.rgb(179, 157, 219)  // #b39ddb
const int DEFAULT_ROOT_LINE_WIDTH = 1
const color DEFAULT_ROOT_TIME_LABEL_COLOR = color.rgb(179, 157, 219)  // #b39ddb

// Session Names
const string SESSION_DAMASU = "Damasu"
const string SESSION_OSAKA = "Osaka"
const string SESSION_KYOTO = "Kyoto"
const string SESSION_NAGASAKI = "Nagasaki"
const string SESSION_TURNCOAT = "Turncoat"
const string SESSION_BISHOP = "Bishop"
const string SESSION_KNIGHT = "Knight"
const string SESSION_BIGBEN = "Big Ben"
const string SESSION_NYOPEN = "NY Open"
const string SESSION_JUDAS = "Judas"
const string SESSION_MODEL11 = "Model 11"
const string SESSION_MODEL110 = "Model 110"
const string SESSION_LUNCH = "Lunch"
const string SESSION_MODEL1001 = "Model 1001"
const string SESSION_MODEL111 = "Model 111"

// Session Names (lowercase for labels)
const string SESSION_DAMASU_LOWER = "damasu"
const string SESSION_OSAKA_LOWER = "osaka"
const string SESSION_KYOTO_LOWER = "kyoto"
const string SESSION_NAGASAKI_LOWER = "nagasaki"
const string SESSION_TURNCOAT_LOWER = "turncoat"
const string SESSION_BISHOP_LOWER = "bishop"
const string SESSION_KNIGHT_LOWER = "knight"
const string SESSION_BIGBEN_LOWER = "bigben"
const string SESSION_NYOPEN_LOWER = "ny open"
const string SESSION_JUDAS_LOWER = "judas"
const string SESSION_MODEL11_LOWER = "model 11"
const string SESSION_MODEL110_LOWER = "model 110"
const string SESSION_LUNCH_LOWER = "lunch"
const string SESSION_MODEL1001_LOWER = "model 1001"
const string SESSION_MODEL111_LOWER = "model 111"

// Session Times (HHMM format)
const int TIME_DAMASU_START = 1800
const int TIME_DAMASU_END = 1901
const int TIME_OSAKA_START = 1901
const int TIME_OSAKA_END = 2114
const int TIME_KYOTO_START = 2114
const int TIME_KYOTO_END = 2304
const int TIME_NAGASAKI_START = 2304
const int TIME_NAGASAKI_END = 300
const int TIME_TURNCOAT_START = 300
const int TIME_TURNCOAT_END = 344
const int TIME_BISHOP_START = 344
const int TIME_BISHOP_END = 520
const int TIME_KNIGHT_START = 520
const int TIME_KNIGHT_END = 639
const int TIME_BIGBEN_START = 639
const int TIME_BIGBEN_END = 930
const int TIME_NYOPEN_START = 930
const int TIME_NYOPEN_END = 955
const int TIME_JUDAS_START = 955
const int TIME_JUDAS_END = 1020
const int TIME_MODEL11_START = 1020
const int TIME_MODEL11_END = 1110
const int TIME_MODEL110_START = 1110
const int TIME_MODEL110_END = 1149
const int TIME_LUNCH_START = 1149
const int TIME_LUNCH_END = 1235
const int TIME_MODEL1001_START = 1235
const int TIME_MODEL1001_END = 1409
const int TIME_MODEL111_START = 1409
const int TIME_MODEL111_END = 1800

// Root Times (specific moments within each session for EQ capture)
const int TIME_DAMASU_ROOT = 1807
const int TIME_OSAKA_ROOT = 1937
const int TIME_KYOTO_ROOT = 2144
const int TIME_NAGASAKI_ROOT = 8
const int TIME_TURNCOAT_ROOT = 312
const int TIME_BISHOP_ROOT = 410
const int TIME_KNIGHT_ROOT = 529
const int TIME_BIGBEN_ROOT = 658
const int TIME_NYOPEN_ROOT = 930
const int TIME_JUDAS_ROOT = 955
const int TIME_MODEL11_ROOT = 1034
const int TIME_MODEL110_ROOT = 1110
const int TIME_LUNCH_ROOT = 1202
const int TIME_MODEL1001_ROOT = 1235
const int TIME_MODEL111_ROOT = 1330

// ══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════════════════════

// ─── DISPLAY ───
show_last_n_days = input.int(1, "Show Last N Days", minval=1, maxval=10, group="Display", tooltip="Number of 24-hour DTT cycles to display")
show_debug = input.bool(false, "Show Debug Table", group="Display")
show_session_labels = input.bool(true, "Session Labels", group="Display", inline="sess_label")
session_label_size = input.string(size.small, "Size", options=[size.tiny, size.small, size.normal, size.large], group="Display", inline="sess_label")
show_root_time_in_label = input.bool(false, "Show Root Time", group="Display", tooltip="Display root time below session name (e.g., 'Osaka\\n(19:37)')")

// ─── SESSION BOUNDARIES ───
show_boundaries = input.bool(true, "Start/End?", group="Session Boundaries", inline="boundary1")
boundary_color = input.color(DEFAULT_BOUNDARY_COLOR, "", group="Session Boundaries", inline="boundary1")
boundary_style = input.string(line.style_solid, "Style", options=[line.style_solid, line.style_dashed, line.style_dotted], group="Session Boundaries", inline="boundary2")
boundary_width = input.int(DEFAULT_BOUNDARY_WIDTH, "Width", minval=1, maxval=5, group="Session Boundaries", inline="boundary2")

// ─── PREVIOUS SESSION HIGH & LOW ───
show_pool_lines = input.bool(true, "High & Low?", group="Previous Session High & Low", inline="pool1")
pool_color = input.color(DEFAULT_HIGH_LOW_COLOR, "", group="Previous Session High & Low", inline="pool1")
pool_style = input.string(line.style_solid, "Style", options=[line.style_solid, line.style_dashed, line.style_dotted], group="Previous Session High & Low", inline="pool2")
pool_width = input.int(DEFAULT_HIGH_LOW_WIDTH, "Width", minval=1, maxval=5, group="Previous Session High & Low", inline="pool2")

// ─── ROOT PRICES ───
show_roots = input.bool(true, "ON/OFF", group="Root Prices", tooltip="Display root prices captured at specific moments within each session")
show_root_zone = input.bool(true, "Box?", group="Root Prices", inline="root_box", tooltip="Display shaded area between root high and root low")
root_zone_color = input.color(DEFAULT_ROOT_ZONE_COLOR, "", group="Root Prices", inline="root_box")
show_root_line = input.bool(true, "Line?", group="Root Prices", inline="root_line", tooltip="Display EQ line at midpoint of root zone")
root_line_color = input.color(DEFAULT_ROOT_LINE_COLOR, "", group="Root Prices", inline="root_line")
root_line_style = input.string(line.style_solid, "Style", options=[line.style_solid, line.style_dashed, line.style_dotted], group="Root Prices", inline="root_line2")
root_line_width = input.int(DEFAULT_ROOT_LINE_WIDTH, "Width", minval=1, maxval=5, group="Root Prices", inline="root_line2")
show_root_time_label = input.bool(true, "Time?", group="Root Prices", inline="root_time", tooltip="Display root time label at end of root zone")
root_time_label_color = input.color(DEFAULT_ROOT_TIME_LABEL_COLOR, "", group="Root Prices", inline="root_time")
root_label_size = input.string(size.tiny, "Size", options=[size.tiny, size.small, size.normal, size.large], group="Root Prices", inline="root_time")

// ─── PATTERN DETECTION ───
enable_pattern_detection = input.bool(false, "Enable Pattern Detection", group="Pattern Detection")

// IMMEDIATE
show_immediate = input.bool(true, "Show Immediate (IMM)", group="Pattern Detection", inline="imm")
immediate_label_color = input.color(color.red, "Label Color", group="Pattern Detection", inline="imm")
highlight_immediate = input.bool(true, "Highlight Candle", group="Pattern Detection", inline="imm_hl")
immediate_highlight_color = input.color(color.new(color.red, 70), "Candle Color", group="Pattern Detection", inline="imm_hl")

// STANDARD
show_standard = input.bool(true, "Show Standard (STD)", group="Pattern Detection", inline="std")
standard_label_color = input.color(color.red, "Label Color", group="Pattern Detection", inline="std")
highlight_standard = input.bool(true, "Highlight Candle", group="Pattern Detection", inline="std_hl")
standard_highlight_color = input.color(color.new(color.red, 70), "Candle Color", group="Pattern Detection", inline="std_hl")

// DELAYED
show_delayed = input.bool(true, "Show Delayed (DEL)", group="Pattern Detection", inline="del")
delayed_label_color = input.color(color.red, "Label Color", group="Pattern Detection", inline="del")
highlight_delayed = input.bool(true, "Highlight Candle", group="Pattern Detection", inline="del_hl")
delayed_highlight_color = input.color(color.new(color.red, 70), "Candle Color", group="Pattern Detection", inline="del_hl")

pattern_label_size = input.string(size.small, "Pattern Label Size", options=[size.tiny, size.small, size.normal, size.large], group="Pattern Detection")

// Verify DTT Sweeps
verify_dtt_sweeps = input.bool(false, "Verify DTT Sweeps", group="Pattern Detection", tooltip="Show the swept high/low level with session name label")
verify_line_color = input.color(color.new(color.orange, 30), "Verify Line Color", group="Pattern Detection", inline="verify")
verify_line_width = input.int(1, "Width", minval=1, maxval=5, group="Pattern Detection", inline="verify")
verify_label_size = input.string(size.tiny, "Label Size", options=[size.tiny, size.small, size.normal, size.large], group="Pattern Detection", inline="verify2")
verify_label_offset = input.float(0.5, "Label Offset (%)", minval=0.0, maxval=5.0, step=0.1, group="Pattern Detection", inline="verify2", tooltip="Vertical offset as percentage of price range")

// Session definitions
type DttSession
    int start_time
    int end_time
    string name
    string prev_session_name
    int start_bar
    int end_bar
    int session_day
    float session_high
    float session_low
    int session_high_bar                 // Bar index where session high was formed
    int session_low_bar                  // Bar index where session low was formed
    line pool_high_line
    line pool_low_line
    line start_boundary_line
    line end_boundary_line
    label session_label
    bool high_breached
    bool low_breached
    int high_breach_bar
    int low_breach_bar
    bool high_pattern_checked
    bool low_pattern_checked
    // Pattern events - multiple patterns can form per session
    array<bool> pattern_is_high          // true = high pattern, false = low pattern
    array<string> pattern_formation_rule // PATTERN_IMMEDIATE, PATTERN_STANDARD, PATTERN_DELAYED
    array<label> pattern_labels          // Label objects for each pattern
    string high_fail_reason
    string low_fail_reason
    // Verify DTT sweeps
    line verify_high_line                // Line from swept high to breach point
    line verify_low_line                 // Line from swept low to breach point
    label verify_high_label              // Label at swept high level
    label verify_low_label               // Label at swept low level
    // Root price capture
    int root_time                        // Root time in HHMM format
    int root_timestamp                   // ACTUAL timestamp when root was captured (from intrabar)
    float root_price                     // Captured equilibrium price (1min high+low)/2
    float root_high                      // Captured 1min high at root time
    float root_low                       // Captured 1min low at root time
    bool root_captured                   // Flag to prevent re-capture
    line root_line                       // Horizontal line at root price (EQ)
    label root_label                     // Label showing time + price
    box root_box                         // Shaded zone from root_low to root_high

// Session template
type SessionTemplate
    int start_time
    int end_time
    string name
    string prev_session_name
    int root_time

// Helper functions for pattern detection (match mbz-prime structure)
dtt_immediate_condition(is_bearish_pattern, level_value, a_high, a_low, a_close, b_open, b_close, b_high, b_low) =>
    if is_bearish_pattern
        previous_inside = a_high < level_value and a_close < level_value
        current_sweep = b_high > level_value and b_open < level_value
        is_bearish_candle = b_close < b_open
        previous_inside and current_sweep and is_bearish_candle
    else
        previous_inside = a_low > level_value and a_close > level_value
        current_sweep = b_low < level_value and b_open > level_value
        is_bullish_candle = b_close > b_open
        previous_inside and current_sweep and is_bullish_candle

dtt_standard_condition(is_bearish_pattern, level_value, a_open, a_close, a_high, a_low, b_open, b_close, b_high, b_low) =>
    if is_bearish_pattern
        wick_only_first_breach = a_open < level_value and a_high > level_value and a_close < level_value
        no_new_extreme = b_high < a_high
        is_bearish_candle = b_close < b_open
        wick_only_first_breach and b_open < level_value and no_new_extreme and is_bearish_candle
    else
        wick_only_first_breach = a_open > level_value and a_low < level_value and a_close > level_value
        no_new_extreme = b_low > a_low
        is_bullish_candle = b_close > b_open
        wick_only_first_breach and b_open > level_value and no_new_extreme and is_bullish_candle

dtt_delayed_condition(is_bearish_pattern, level_value, a_close, b_open, b_close) =>
    if is_bearish_pattern
        body_close_breach = a_close > level_value
        is_bearish_candle = b_close < b_open
        body_close_breach and b_open > level_value and is_bearish_candle
    else
        body_close_breach = a_close < level_value
        is_bullish_candle = b_close > b_open
        body_close_breach and b_open < level_value and is_bullish_candle

dtt_check_midpoint(is_bearish_pattern, close_price, midpoint) =>
    if is_bearish_pattern
        close_price < midpoint
    else
        close_price > midpoint

// Convert session name to lowercase for labels
get_session_name_lower(session_name) =>
    result = ""
    switch session_name
        SESSION_DAMASU => result := SESSION_DAMASU_LOWER
        SESSION_OSAKA => result := SESSION_OSAKA_LOWER
        SESSION_KYOTO => result := SESSION_KYOTO_LOWER
        SESSION_NAGASAKI => result := SESSION_NAGASAKI_LOWER
        SESSION_TURNCOAT => result := SESSION_TURNCOAT_LOWER
        SESSION_BISHOP => result := SESSION_BISHOP_LOWER
        SESSION_KNIGHT => result := SESSION_KNIGHT_LOWER
        SESSION_BIGBEN => result := SESSION_BIGBEN_LOWER
        SESSION_NYOPEN => result := SESSION_NYOPEN_LOWER
        SESSION_JUDAS => result := SESSION_JUDAS_LOWER
        SESSION_MODEL11 => result := SESSION_MODEL11_LOWER
        SESSION_MODEL110 => result := SESSION_MODEL110_LOWER
        SESSION_LUNCH => result := SESSION_LUNCH_LOWER
        SESSION_MODEL1001 => result := SESSION_MODEL1001_LOWER
        SESSION_MODEL111 => result := SESSION_MODEL111_LOWER
    result

// Track all session instances across days
var session_instances = array.new<DttSession>()

// Define session templates (in cascade order - 15 DTT sessions)
var session_templates = array.new<SessionTemplate>()
if barstate.isfirst
    array.push(session_templates, SessionTemplate.new(TIME_DAMASU_START, TIME_DAMASU_END, SESSION_DAMASU, SESSION_MODEL111, TIME_DAMASU_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_OSAKA_START, TIME_OSAKA_END, SESSION_OSAKA, SESSION_DAMASU, TIME_OSAKA_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_KYOTO_START, TIME_KYOTO_END, SESSION_KYOTO, SESSION_OSAKA, TIME_KYOTO_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_NAGASAKI_START, TIME_NAGASAKI_END, SESSION_NAGASAKI, SESSION_KYOTO, TIME_NAGASAKI_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_TURNCOAT_START, TIME_TURNCOAT_END, SESSION_TURNCOAT, SESSION_NAGASAKI, TIME_TURNCOAT_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_BISHOP_START, TIME_BISHOP_END, SESSION_BISHOP, SESSION_TURNCOAT, TIME_BISHOP_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_KNIGHT_START, TIME_KNIGHT_END, SESSION_KNIGHT, SESSION_BISHOP, TIME_KNIGHT_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_BIGBEN_START, TIME_BIGBEN_END, SESSION_BIGBEN, SESSION_KNIGHT, TIME_BIGBEN_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_NYOPEN_START, TIME_NYOPEN_END, SESSION_NYOPEN, SESSION_BIGBEN, TIME_NYOPEN_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_JUDAS_START, TIME_JUDAS_END, SESSION_JUDAS, SESSION_NYOPEN, TIME_JUDAS_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_MODEL11_START, TIME_MODEL11_END, SESSION_MODEL11, SESSION_JUDAS, TIME_MODEL11_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_MODEL110_START, TIME_MODEL110_END, SESSION_MODEL110, SESSION_MODEL11, TIME_MODEL110_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_LUNCH_START, TIME_LUNCH_END, SESSION_LUNCH, SESSION_MODEL110, TIME_LUNCH_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_MODEL1001_START, TIME_MODEL1001_END, SESSION_MODEL1001, SESSION_LUNCH, TIME_MODEL1001_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_MODEL111_START, TIME_MODEL111_END, SESSION_MODEL111, SESSION_MODEL1001, TIME_MODEL111_ROOT))

// Get current time in HHMM format (using TIMEZONE constant)
// Use bar time, not real-world time
current_hour = hour(time, TIMEZONE)
current_minute = minute(time, TIMEZONE)
current_time = current_hour * 100 + current_minute
current_day = dayofweek(time, TIMEZONE)

// Auto-detect if asset trades 24/7 by checking if there are weekend bars
var bool is_247_asset = false
if barstate.isfirst
    is_247_asset := false
    // Check last LOOKBACK_BARS for any weekend activity
    for i = 0 to math.min(LOOKBACK_BARS, bar_index)
        check_day = dayofweek(time[i], TIMEZONE)
        if check_day == dayofweek.saturday or check_day == dayofweek.sunday
            is_247_asset := true
            break

// Check if we should process sessions (always process if 24/7 asset detected, or on weekdays)
process_sessions = is_247_asset or (current_day != dayofweek.saturday and current_day != dayofweek.sunday)

// Helper function to get the last instance of a session type (completed or active)
get_last_session_of_type(session_name) =>
    result = DttSession.new(0, 0, "", "", na, na, na, na, na, na, na, na, na, na, na, na, false, false, na, na, false, false, array.new<bool>(), array.new<string>(), array.new<label>(), na, na, na, na, na, na, 0, na, na, na, na, false, na, na, na)
    if array.size(session_instances) > 0
        for i = array.size(session_instances) - 1 to 0
            sess = array.get(session_instances, i)
            if sess.name == session_name and not na(sess.start_bar)
                result := sess
                break
    result

// Get the count of completed Model 111 sessions (marks complete "days")
get_completed_model111_count() =>
    count = 0
    if array.size(session_instances) > 0
        for i = 0 to array.size(session_instances) - 1
            sess = array.get(session_instances, i)
            if sess.name == SESSION_MODEL111 and not na(sess.end_bar)
                count += 1
    count

// Mark sessions as ended and finalize them (using precise 1-minute timing)
if array.size(session_instances) > 0
    // Get all 1-minute timestamps within the current bar for precise session end detection
    one_min_times_end = request.security_lower_tf(syminfo.tickerid, "1", time)

    for j = array.size(session_instances) - 1 to 0
        sess = array.get(session_instances, j)
        if not na(sess.start_bar) and na(sess.end_bar)
            // Check if any 1-minute bar within the current bar matches the session end time
            session_should_end = false

            if array.size(one_min_times_end) > 0
                for k = 0 to array.size(one_min_times_end) - 1
                    bar_time = array.get(one_min_times_end, k)
                    bar_hour = hour(bar_time, TIMEZONE)
                    bar_minute = minute(bar_time, TIMEZONE)
                    bar_time_hhmm = bar_hour * 100 + bar_minute

                    // Check if this 1-minute bar's time matches the session end time exactly
                    if bar_time_hhmm == sess.end_time
                        session_should_end := true
                        break
            else
                // Fallback to chart timeframe check (for 1-minute charts or if lower_tf fails)
                in_session = false
                if sess.end_time > sess.start_time
                    // Normal session (doesn't wrap midnight)
                    in_session := current_time >= sess.start_time and current_time < sess.end_time
                else
                    // Wraps midnight (e.g., 23:04 to 03:00)
                    in_session := current_time >= sess.start_time or current_time < sess.end_time

                // If NOT in session and session has started, it must have ended
                session_should_end := not in_session

            // Mark session as ended if end time detected
            if session_should_end
                sess.end_bar := bar_index
                array.set(session_instances, j, sess)

// Clean up old sessions BEFORE creating new ones: keep only the last N "cycles"
if array.size(session_instances) > 0
    sessions_to_keep = show_last_n_days * SESSIONS_PER_CYCLE
    total_sessions = array.size(session_instances)

    if total_sessions > sessions_to_keep
        sessions_to_delete = total_sessions - sessions_to_keep

        for i = 0 to sessions_to_delete - 1
            sess = array.get(session_instances, i)
            if not na(sess.start_boundary_line)
                line.delete(sess.start_boundary_line)
            if not na(sess.end_boundary_line)
                line.delete(sess.end_boundary_line)
            if not na(sess.pool_high_line)
                line.delete(sess.pool_high_line)
            if not na(sess.pool_low_line)
                line.delete(sess.pool_low_line)
            if not na(sess.session_label)
                label.delete(sess.session_label)
            // Delete all pattern labels
            if array.size(sess.pattern_labels) > 0
                for j = 0 to array.size(sess.pattern_labels) - 1
                    lbl = array.get(sess.pattern_labels, j)
                    if not na(lbl)
                        label.delete(lbl)
            // Delete verify lines and labels
            if not na(sess.verify_high_line)
                line.delete(sess.verify_high_line)
            if not na(sess.verify_high_label)
                label.delete(sess.verify_high_label)
            if not na(sess.verify_low_line)
                line.delete(sess.verify_low_line)
            if not na(sess.verify_low_label)
                label.delete(sess.verify_low_label)
            // Delete root line, label, and zone box
            if not na(sess.root_line)
                line.delete(sess.root_line)
            if not na(sess.root_label)
                label.delete(sess.root_label)
            if not na(sess.root_box)
                box.delete(sess.root_box)

        for i = 0 to sessions_to_delete - 1
            array.shift(session_instances)

// Only CREATE new sessions if weekend is enabled OR it's a weekday (using precise 1-minute timing)
if process_sessions
    // Get all 1-minute timestamps within the current bar for precise session detection
    one_min_times = request.security_lower_tf(syminfo.tickerid, "1", time)

    // Process all session templates
    for i = 0 to array.size(session_templates) - 1
        template = array.get(session_templates, i)

        // Check if any 1-minute bar within the current bar matches the session start time
        session_should_start = false
        actual_start_timestamp = int(na)  // Capture the ACTUAL timestamp when session starts

        if array.size(one_min_times) > 0
            for j = 0 to array.size(one_min_times) - 1
                bar_time = array.get(one_min_times, j)
                bar_hour = hour(bar_time, TIMEZONE)
                bar_minute = minute(bar_time, TIMEZONE)
                bar_time_hhmm = bar_hour * 100 + bar_minute

                // Check if this 1-minute bar's time matches the session start time exactly
                if bar_time_hhmm == template.start_time
                    session_should_start := true
                    actual_start_timestamp := bar_time  // CAPTURE the actual timestamp!
                    break
        else
            // Fallback to chart timeframe check (for 1-minute charts or if lower_tf fails)
            if template.end_time > template.start_time
                session_should_start := current_time >= template.start_time and current_time < template.end_time
            else
                session_should_start := current_time >= template.start_time or current_time < template.end_time

        // Check if this session type already has an active instance for current bar
        session_exists = false
        if array.size(session_instances) > 0
            for j = array.size(session_instances) - 1 to 0
                sess = array.get(session_instances, j)
                if sess.name == template.name and not na(sess.start_bar) and na(sess.end_bar)
                    session_exists := true
                    break

        // Create session if it should start and doesn't exist yet
        if session_should_start and not session_exists
            // Count completed "days" (Model 111 sessions mark end of day)
            completed_days = get_completed_model111_count()

            // Assign day number: incomplete sessions are in "current day" = completed_days
            day_number = completed_days

            new_sess = DttSession.new(template.start_time, template.end_time, template.name, template.prev_session_name, bar_index, na, day_number, high, low, bar_index, bar_index, na, na, na, na, na, false, false, na, na, false, false, array.new<bool>(), array.new<string>(), array.new<label>(), na, na, na, na, na, na, template.root_time, na, na, na, na, false, na, na, na)
            array.push(session_instances, new_sess)

            // Draw boundaries
            idx = array.size(session_instances) - 1
            curr_sess = array.get(session_instances, idx)

            // Get previous session to delete its end boundary and replace with shared boundary
            prev_session = get_last_session_of_type(template.prev_session_name)
            if not na(prev_session.end_boundary_line)
                // Delete the previous session's end boundary
                line.delete(prev_session.end_boundary_line)
                // Update the previous session in the array
                if array.size(session_instances) > 1
                    for j = array.size(session_instances) - 2 to 0
                        check_sess = array.get(session_instances, j)
                        if check_sess.name == template.prev_session_name and not na(check_sess.start_bar)
                            check_sess.end_boundary_line := na
                            array.set(session_instances, j, check_sess)
                            break

            // Use the ACTUAL captured start timestamp (or reconstruct if fallback was used)
            start_timestamp = int(na)
            if not na(actual_start_timestamp)
                // Use the actual intrabar timestamp we captured
                start_timestamp := actual_start_timestamp
            else
                // Fallback: reconstruct from current bar (only for 1-minute charts)
                current_year = year(time, TIMEZONE)
                current_month = month(time, TIMEZONE)
                current_date = dayofmonth(time, TIMEZONE)
                start_hour = math.floor(template.start_time / 100)
                start_minute = template.start_time % 100
                start_timestamp := timestamp(TIMEZONE, current_year, current_month, current_date, start_hour, start_minute)
                if start_timestamp > time
                    start_timestamp := start_timestamp - MILLISECONDS_PER_DAY

            // Draw start boundary at the exact start time (matching end boundary logic)
            curr_sess.start_boundary_line := line.new(start_timestamp, 1e10, start_timestamp, -1e6, xloc=xloc.bar_time, color=boundary_color, width=boundary_width, style=boundary_style)

            // Calculate end timestamp from the actual start timestamp
            end_hour = math.floor(template.end_time / 100)
            end_minute = template.end_time % 100

            // Get date components from the actual start timestamp
            start_year = year(start_timestamp, TIMEZONE)
            start_month = month(start_timestamp, TIMEZONE)
            start_date = dayofmonth(start_timestamp, TIMEZONE)

            // Build end timestamp using same date as start
            end_timestamp = timestamp(TIMEZONE, start_year, start_month, start_date, end_hour, end_minute)

            // If end time wraps midnight, add a day
            if template.end_time < template.start_time
                end_timestamp := end_timestamp + MILLISECONDS_PER_DAY

            // Ensure end is after start
            if end_timestamp <= start_timestamp
                end_timestamp := end_timestamp + MILLISECONDS_PER_DAY

            // Draw end boundary at the exact end time
            curr_sess.end_boundary_line := line.new(end_timestamp, 1e10, end_timestamp, -1e6, xloc=xloc.bar_time, color=boundary_color, width=boundary_width, style=boundary_style)

            // Draw high/low lines from previous session extending to end timestamp
            if show_pool_lines and not na(prev_session.session_high) and not na(prev_session.session_low)
                curr_sess.pool_high_line := line.new(start_timestamp, prev_session.session_high, end_timestamp, prev_session.session_high, xloc=xloc.bar_time, color=pool_color, width=pool_width, style=pool_style)
                curr_sess.pool_low_line := line.new(start_timestamp, prev_session.session_low, end_timestamp, prev_session.session_low, xloc=xloc.bar_time, color=pool_color, width=pool_width, style=pool_style)

            // Draw session name label at midpoint between start and end time
            if show_session_labels
                midpoint_timestamp = math.round((time + end_timestamp) / 2)
                // Build label text - optionally include root time
                label_text = template.name
                if show_root_time_in_label
                    root_hour_str = str.tostring(math.floor(template.root_time / 100), "#00")
                    root_minute_str = str.tostring(template.root_time % 100, "#00")
                    label_text := template.name + "\n(" + root_hour_str + ":" + root_minute_str + ")"
                curr_sess.session_label := label.new(midpoint_timestamp, high, text=label_text, xloc=xloc.bar_time, style=label.style_none, color=color.new(color.white, 100), textcolor=color.new(boundary_color, 50), size=session_label_size)

            array.set(session_instances, idx, curr_sess)

// Update high/low for all active sessions and detect first touch (using 1-minute data)
if array.size(session_instances) > 0
    for i = 0 to array.size(session_instances) - 1
        sess = array.get(session_instances, i)
        if not na(sess.start_bar) and na(sess.end_bar)
            // Session is active, update high/low using 1-minute data
            in_session = false
            if sess.start_time > sess.end_time  // Wraps around midnight
                in_session := (current_time >= sess.start_time or current_time < sess.end_time)
            else
                in_session := (current_time >= sess.start_time and current_time < sess.end_time)

            if in_session
                // Get all 1-minute bars within the current bar using lower timeframe data
                [one_min_highs, one_min_lows] = request.security_lower_tf(syminfo.tickerid, "1", [high, low])

                // Process all 1-minute bars to find true session high/low
                if array.size(one_min_highs) > 0
                    for j = 0 to array.size(one_min_highs) - 1
                        one_min_high = array.get(one_min_highs, j)
                        one_min_low = array.get(one_min_lows, j)

                        // Track high and bar where it was formed (using 1-minute data)
                        if one_min_high > sess.session_high
                            sess.session_high := one_min_high
                            sess.session_high_bar := bar_index

                        // Track low and bar where it was formed (using 1-minute data)
                        if one_min_low < sess.session_low
                            sess.session_low := one_min_low
                            sess.session_low_bar := bar_index

                // Get previous session's high/low for comparison
                prev_session = get_last_session_of_type(sess.prev_session_name)
                prev_high = prev_session.session_high
                prev_low = prev_session.session_low

                // Check for FIRST breach of previous session's high (using current bar's extremes)
                if not sess.high_breached and not na(prev_high)
                    // STRICT BREACH: Must exceed level, not just touch (use > not >=)
                    if sess.session_high > prev_high
                        sess.high_breached := true
                        sess.high_breach_bar := bar_index  // SAVE BREACH BAR

                // Check for FIRST breach of previous session's low (using current bar's extremes)
                if not sess.low_breached and not na(prev_low)
                    // STRICT BREACH: Must exceed level, not just touch (use < not <=)
                    if sess.session_low < prev_low
                        sess.low_breached := true
                        sess.low_breach_bar := bar_index  // SAVE BREACH BAR

                array.set(session_instances, i, sess)

// ══════════════════════════════════════════════════════════════════════════════
// ROOT PRICE CAPTURE
// ══════════════════════════════════════════════════════════════════════════════

// Capture root prices for active sessions (using precise 1-minute intrabar data)
if show_roots and array.size(session_instances) > 0
    for i = 0 to array.size(session_instances) - 1
        sess = array.get(session_instances, i)

        // Only process active sessions that haven't captured root yet
        if not na(sess.start_bar) and na(sess.end_bar) and not sess.root_captured
            // Check if root time is reached (handle different timeframes)
            is_root_bar = false
            root_hour = math.floor(sess.root_time / 100)
            root_minute = sess.root_time % 100

            if timeframe.multiplier == 1
                // 1-minute: exact match
                is_root_bar := current_hour == root_hour and current_minute == root_minute
            else
                // Higher timeframes: check if root time falls within this bar
                if current_hour == root_hour
                    bar_start_minute = current_minute - (current_minute % timeframe.multiplier)
                    bar_end_minute = bar_start_minute + timeframe.multiplier - 1
                    is_root_bar := root_minute >= bar_start_minute and root_minute <= bar_end_minute

            // Capture root price using precise 1-minute intrabar data
            if is_root_bar
                // Get all 1-minute bars within the current bar (high, low, and time)
                [one_min_highs, one_min_lows, one_min_times] = request.security_lower_tf(syminfo.tickerid, "1", [high, low, time])

                // Find the exact 1-minute bar that matches the root time
                if array.size(one_min_times) > 0
                    for j = 0 to array.size(one_min_times) - 1
                        bar_time = array.get(one_min_times, j)
                        bar_hour = hour(bar_time, TIMEZONE)
                        bar_minute = minute(bar_time, TIMEZONE)
                        bar_time_hhmm = bar_hour * 100 + bar_minute

                        // Check if this 1-minute bar's time matches the root time exactly
                        if bar_time_hhmm == sess.root_time
                            sess.root_high := array.get(one_min_highs, j)
                            sess.root_low := array.get(one_min_lows, j)
                            sess.root_price := (sess.root_high + sess.root_low) / 2.0
                            sess.root_timestamp := bar_time  // CAPTURE the actual timestamp!
                            sess.root_captured := true
                            break

                array.set(session_instances, i, sess)

// ══════════════════════════════════════════════════════════════════════════════
// ROOT LINE & ZONE DRAWING
// ══════════════════════════════════════════════════════════════════════════════

// Helper function to get next session name in cascade
get_next_session_name(current_session_name) =>
    result = ""
    switch current_session_name
        SESSION_DAMASU => result := SESSION_OSAKA
        SESSION_OSAKA => result := SESSION_KYOTO
        SESSION_KYOTO => result := SESSION_NAGASAKI
        SESSION_NAGASAKI => result := SESSION_TURNCOAT
        SESSION_TURNCOAT => result := SESSION_BISHOP
        SESSION_BISHOP => result := SESSION_KNIGHT
        SESSION_KNIGHT => result := SESSION_BIGBEN
        SESSION_BIGBEN => result := SESSION_NYOPEN
        SESSION_NYOPEN => result := SESSION_JUDAS
        SESSION_JUDAS => result := SESSION_MODEL11
        SESSION_MODEL11 => result := SESSION_MODEL110
        SESSION_MODEL110 => result := SESSION_LUNCH
        SESSION_LUNCH => result := SESSION_MODEL1001
        SESSION_MODEL1001 => result := SESSION_MODEL111
        SESSION_MODEL111 => result := SESSION_DAMASU
    result

// Draw root lines and zones for sessions that have captured root price
if show_roots and array.size(session_instances) > 0
    for i = 0 to array.size(session_instances) - 1
        sess = array.get(session_instances, i)

        // Draw line/zone if root captured but not yet drawn
        if sess.root_captured and not na(sess.root_price) and na(sess.root_line) and not na(sess.root_timestamp)
            // Use the ACTUAL captured root timestamp
            root_timestamp = sess.root_timestamp
            root_hour = math.floor(sess.root_time / 100)
            root_minute = sess.root_time % 100

            // Get NEXT session in cascade to determine end boundary
            next_session_name = get_next_session_name(sess.name)
            next_session = get_last_session_of_type(next_session_name)

            // Calculate NEXT session's end timestamp from the root timestamp's date
            root_year = year(root_timestamp, TIMEZONE)
            root_month = month(root_timestamp, TIMEZONE)
            root_date = dayofmonth(root_timestamp, TIMEZONE)

            next_end_hour = math.floor(next_session.end_time / 100)
            next_end_minute = next_session.end_time % 100
            end_timestamp = timestamp(TIMEZONE, root_year, root_month, root_date, next_end_hour, next_end_minute)

            // If next session wraps midnight OR end is before root, add days as needed
            if next_session.end_time < next_session.start_time
                end_timestamp := end_timestamp + MILLISECONDS_PER_DAY

            // Ensure end_timestamp is after root_timestamp
            while end_timestamp <= root_timestamp
                end_timestamp := end_timestamp + MILLISECONDS_PER_DAY

            // Draw root zone (shaded box) if enabled
            if show_root_zone and not na(sess.root_high) and not na(sess.root_low)
                sess.root_box := box.new(root_timestamp, sess.root_high, end_timestamp, sess.root_low,
                                         xloc=xloc.bar_time, border_color=color.new(color.blue, 100),
                                         bgcolor=root_zone_color, border_width=0)

            // Draw horizontal EQ line from root time to next session end
            if show_root_line
                sess.root_line := line.new(root_timestamp, sess.root_price, end_timestamp, sess.root_price,
                                           xloc=xloc.bar_time, color=root_line_color, width=root_line_width, style=root_line_style)

            // Create time label at end of line (no price)
            if show_root_time_label
                root_hour_str = str.tostring(root_hour, "#00")
                root_minute_str = str.tostring(root_minute, "#00")
                label_text = root_hour_str + ":" + root_minute_str

                sess.root_label := label.new(end_timestamp, sess.root_price, text=label_text,
                                             xloc=xloc.bar_time, style=label.style_label_left,
                                             color=color.new(root_time_label_color, 70), textcolor=color.black, size=root_label_size)

            array.set(session_instances, i, sess)

// ══════════════════════════════════════════════════════════════════════════════
// PATTERN DETECTION (IMM/STD/DEL) - Matches mbz-prime structure
// ══════════════════════════════════════════════════════════════════════════════

// Pattern detection for DTT sessions
if enable_pattern_detection and array.size(session_instances) > 0

    for i = 0 to array.size(session_instances) - 1
        sess = array.get(session_instances, i)

        // Check both active AND ended sessions (but only once per session)
        if not na(sess.start_bar)
            prev_session = get_last_session_of_type(sess.prev_session_name)
            prev_high = prev_session.session_high
            prev_low = prev_session.session_low
            prev_high_bar = prev_session.session_high_bar
            prev_low_bar = prev_session.session_low_bar

            // ═══════════════════════════════════════════════════════════════
            // HIGH PATTERN DETECTION (Bearish)
            // ═══════════════════════════════════════════════════════════════

            high_ready = sess.high_breached and not sess.high_pattern_checked and not na(prev_high) and not na(sess.high_breach_bar)

            if high_ready
                breach_bar = sess.high_breach_bar
                bars_since_breach = bar_index - breach_bar

                // Determine breach timing (current or previous bar)
                breach_is_current_high = breach_bar == bar_index
                breach_is_previous_high = breach_bar == bar_index - 1

                breach_bar_offset = bar_index - breach_bar

                pattern_found = false
                imm_fail_reason = ""
                std_fail_reason = ""
                del_fail_reason = ""

                // ─────────────────────────────────────────────────────────────
                // IMMEDIATE: Check when breach happens (bars_since_breach >= 0)
                // ─────────────────────────────────────────────────────────────
                if show_immediate and breach_is_current_high
                    // For IMM: A = bar before breach, B = breach bar
                    if breach_bar_offset + 1 <= 500
                        a_imm_open = open[breach_bar_offset + 1]
                        a_imm_close = close[breach_bar_offset + 1]
                        a_imm_high = high[breach_bar_offset + 1]
                        a_imm_low = low[breach_bar_offset + 1]
                        a_imm_mid = (a_imm_open + a_imm_close) / 2.0

                        // B = current bar (breach bar)
                        b_open = open
                        b_close = close
                        b_high = high
                        b_low = low

                        // Check all conditions with explicit failure reasons
                        // A can touch the level with high but must not exceed it
                        a_stayed_inside = a_imm_high <= prev_high
                        b_swept = b_high > prev_high and b_open < prev_high
                        b_is_bearish = b_close < b_open
                        midpoint_passed = dtt_check_midpoint(true, b_close, a_imm_mid)

                        if not a_stayed_inside
                            imm_fail_reason := "IMM✗: A high exceeded the level"
                        else if not b_swept
                            imm_fail_reason := "IMM✗: B didn't sweep the high"
                        else if not b_is_bearish
                            imm_fail_reason := "IMM✗: B not bearish"
                        else if not midpoint_passed
                            imm_fail_reason := "IMM✗: B close above A midpoint"
                        else
                            array.push(sess.pattern_is_high, true)
                            array.push(sess.pattern_formation_rule, PATTERN_IMMEDIATE)
                            pattern_found := true

                            // Create label immediately
                            direction_suffix = b_close < b_open ? "⁻" : b_close > b_open ? "⁺" : ""
                            session_name_lower = get_session_name_lower(sess.name)
                            full_text = PATTERN_IMMEDIATE + direction_suffix + "\n(" + session_name_lower + ")"
                            price_range = b_high - b_low
                            offset = math.max(price_range, syminfo.mintick * 50) * 0.25
                            label_price = b_low - offset
                            new_label = label.new(bar_index, label_price, text=full_text, style=label.style_label_up, textcolor=immediate_label_color, size=pattern_label_size, color=color.new(color.white, 100))
                            array.push(sess.pattern_labels, new_label)

                            // Create verify line and label if enabled
                            if verify_dtt_sweeps and not na(prev_high_bar)
                                sess.verify_high_line := line.new(prev_high_bar, prev_high, bar_index, prev_high, color=verify_line_color, width=verify_line_width, style=line.style_solid)
                                midpoint_bar = math.round((prev_high_bar + bar_index) / 2)
                                label_offset = (high - low) * verify_label_offset / 100.0
                                sess.verify_high_label := label.new(midpoint_bar, prev_high + label_offset, text=session_name_lower, style=label.style_label_center, textcolor=color.black, size=verify_label_size, color=color.new(color.white, 100))

                // ─────────────────────────────────────────────────────────────
                // STANDARD/DELAYED: Check one bar after breach (bars_since_breach >= 1)
                // ─────────────────────────────────────────────────────────────
                if bars_since_breach >= 1
                    // A candle = breach bar
                    a_open = open[breach_bar_offset]
                    a_close = close[breach_bar_offset]
                    a_high = high[breach_bar_offset]
                    a_low = low[breach_bar_offset]
                    a_mid = (a_open + a_close) / 2.0

                    // B candle = current bar (bar after breach)
                    b_open = open
                    b_close = close
                    b_high = high
                    b_low = low

                    // Check STANDARD (breach on previous bar = A candle)
                    if show_standard and breach_is_previous_high
                        // Check all conditions with explicit failure reasons
                        wick_only = a_open < prev_high and a_high > prev_high and a_close < prev_high
                        b_started_below = b_open < prev_high
                        no_new_extreme = b_high < a_high
                        b_is_bearish = b_close < b_open
                        midpoint_passed = dtt_check_midpoint(true, b_close, a_mid)

                        if not wick_only
                            std_fail_reason := "STD✗: A body touched the high"
                        else if not b_started_below
                            std_fail_reason := "STD✗: B didn't start below the high"
                        else if not no_new_extreme
                            std_fail_reason := "STD✗: B made new extreme"
                        else if not b_is_bearish
                            std_fail_reason := "STD✗: B not bearish"
                        else if not midpoint_passed
                            std_fail_reason := "STD✗: B close above A midpoint"
                        else
                            array.push(sess.pattern_is_high, true)
                            array.push(sess.pattern_formation_rule, PATTERN_STANDARD)
                            pattern_found := true

                            // Create label immediately
                            direction_suffix = b_close < b_open ? "⁻" : b_close > b_open ? "⁺" : ""
                            session_name_lower = get_session_name_lower(sess.name)
                            full_text = PATTERN_STANDARD + direction_suffix + "\n(" + session_name_lower + ")"
                            price_range = b_high - b_low
                            offset = math.max(price_range, syminfo.mintick * 50) * 0.25
                            label_price = b_low - offset
                            new_label = label.new(bar_index, label_price, text=full_text, style=label.style_label_up, textcolor=standard_label_color, size=pattern_label_size, color=color.new(color.white, 100))
                            array.push(sess.pattern_labels, new_label)

                            // Create verify line and label if enabled (STD/DEL: breach at bar_index - 1)
                            if verify_dtt_sweeps and na(sess.verify_high_line) and not na(prev_high_bar)
                                breach_bar = bar_index - 1
                                sess.verify_high_line := line.new(prev_high_bar, prev_high, breach_bar, prev_high, color=verify_line_color, width=verify_line_width, style=line.style_solid)
                                midpoint_bar = math.round((prev_high_bar + breach_bar) / 2)
                                label_offset = (high - low) * verify_label_offset / 100.0
                                sess.verify_high_label := label.new(midpoint_bar, prev_high + label_offset, text=session_name_lower, style=label.style_label_center, textcolor=color.black, size=verify_label_size, color=color.new(color.white, 100))

                    // Check DELAYED (breach on previous bar = A candle)
                    if show_delayed and breach_is_previous_high
                        // Check all conditions with explicit failure reasons
                        body_closed_beyond = a_close > prev_high
                        b_started_above = b_open > prev_high
                        b_is_bearish = b_close < b_open
                        midpoint_passed = dtt_check_midpoint(true, b_close, a_mid)

                        if not body_closed_beyond
                            del_fail_reason := "DEL✗: A didn't close above the high"
                        else if not b_started_above
                            del_fail_reason := "DEL✗: B didn't start above the high"
                        else if not b_is_bearish
                            del_fail_reason := "DEL✗: B not bearish"
                        else if not midpoint_passed
                            del_fail_reason := "DEL✗: B close above A midpoint"
                        else
                            array.push(sess.pattern_is_high, true)
                            array.push(sess.pattern_formation_rule, PATTERN_DELAYED)
                            pattern_found := true

                            // Create label immediately
                            direction_suffix = b_close < b_open ? "⁻" : b_close > b_open ? "⁺" : ""
                            session_name_lower = get_session_name_lower(sess.name)
                            full_text = PATTERN_DELAYED + direction_suffix + "\n(" + session_name_lower + ")"
                            price_range = b_high - b_low
                            offset = math.max(price_range, syminfo.mintick * 50) * 0.25
                            label_price = b_low - offset
                            new_label = label.new(bar_index, label_price, text=full_text, style=label.style_label_up, textcolor=delayed_label_color, size=pattern_label_size, color=color.new(color.white, 100))
                            array.push(sess.pattern_labels, new_label)

                            // Create verify line and label if enabled (STD/DEL: breach at bar_index - 1)
                            if verify_dtt_sweeps and na(sess.verify_high_line) and not na(prev_high_bar)
                                breach_bar = bar_index - 1
                                sess.verify_high_line := line.new(prev_high_bar, prev_high, breach_bar, prev_high, color=verify_line_color, width=verify_line_width, style=line.style_solid)
                                midpoint_bar = math.round((prev_high_bar + breach_bar) / 2)
                                label_offset = (high - low) * verify_label_offset / 100.0
                                sess.verify_high_label := label.new(midpoint_bar, prev_high + label_offset, text=session_name_lower, style=label.style_label_center, textcolor=color.black, size=verify_label_size, color=color.new(color.white, 100))

                    // Mark as checked ONLY after checking all patterns (STD/DEL checked at bars_since_breach >= 1)
                    sess.high_pattern_checked := true

                    // If no pattern found, record PRIMARY failure reason
                    if not pattern_found
                        if imm_fail_reason != ""
                            sess.high_fail_reason := imm_fail_reason
                        else if std_fail_reason != ""
                            sess.high_fail_reason := std_fail_reason
                        else if del_fail_reason != ""
                            sess.high_fail_reason := del_fail_reason

            // ═══════════════════════════════════════════════════════════════
            // LOW PATTERN DETECTION (Bullish)
            // ═══════════════════════════════════════════════════════════════

            low_ready = sess.low_breached and not sess.low_pattern_checked and not na(prev_low) and not na(sess.low_breach_bar)

            if low_ready
                breach_bar = sess.low_breach_bar
                bars_since_breach = bar_index - breach_bar

                // Determine breach timing (current or previous bar)
                breach_is_current_low = breach_bar == bar_index
                breach_is_previous_low = breach_bar == bar_index - 1

                breach_bar_offset = bar_index - breach_bar

                pattern_found = false
                imm_fail_reason = ""
                std_fail_reason = ""
                del_fail_reason = ""

                // ─────────────────────────────────────────────────────────────
                // IMMEDIATE: Check when breach happens (bars_since_breach >= 0)
                // ─────────────────────────────────────────────────────────────
                if show_immediate and breach_is_current_low
                    // For IMM: A = bar before breach, B = breach bar
                    if breach_bar_offset + 1 <= 500
                        a_imm_open = open[breach_bar_offset + 1]
                        a_imm_close = close[breach_bar_offset + 1]
                        a_imm_high = high[breach_bar_offset + 1]
                        a_imm_low = low[breach_bar_offset + 1]
                        a_imm_mid = (a_imm_open + a_imm_close) / 2.0

                        // B = current bar (breach bar)
                        b_open = open
                        b_close = close
                        b_high = high
                        b_low = low

                        // Check all conditions with explicit failure reasons
                        // A can touch the level with low but must not exceed it
                        a_stayed_inside = a_imm_low >= prev_low
                        b_swept = b_low < prev_low and b_open > prev_low
                        b_is_bullish = b_close > b_open
                        midpoint_passed = dtt_check_midpoint(false, b_close, a_imm_mid)

                        if not a_stayed_inside
                            imm_fail_reason := "IMM✗: A low exceeded the level"
                        else if not b_swept
                            imm_fail_reason := "IMM✗: B didn't sweep the low"
                        else if not b_is_bullish
                            imm_fail_reason := "IMM✗: B not bullish"
                        else if not midpoint_passed
                            imm_fail_reason := "IMM✗: B close below A midpoint"
                        else
                            array.push(sess.pattern_is_high, false)
                            array.push(sess.pattern_formation_rule, PATTERN_IMMEDIATE)
                            pattern_found := true

                            // Create label immediately
                            direction_suffix = b_close < b_open ? "⁻" : b_close > b_open ? "⁺" : ""
                            session_name_lower = get_session_name_lower(sess.name)
                            full_text = PATTERN_IMMEDIATE + direction_suffix + "\n(" + session_name_lower + ")"
                            price_range = b_high - b_low
                            offset = math.max(price_range, syminfo.mintick * 50) * 0.25
                            label_price = b_high + offset
                            new_label = label.new(bar_index, label_price, text=full_text, style=label.style_label_down, textcolor=immediate_label_color, size=pattern_label_size, color=color.new(color.white, 100))
                            array.push(sess.pattern_labels, new_label)

                            // Create verify line and label if enabled
                            if verify_dtt_sweeps and not na(prev_low_bar)
                                sess.verify_low_line := line.new(prev_low_bar, prev_low, bar_index, prev_low, color=verify_line_color, width=verify_line_width, style=line.style_solid)
                                midpoint_bar = math.round((prev_low_bar + bar_index) / 2)
                                label_offset = (high - low) * verify_label_offset / 100.0
                                sess.verify_low_label := label.new(midpoint_bar, prev_low - label_offset, text=session_name_lower, style=label.style_label_center, textcolor=color.black, size=verify_label_size, color=color.new(color.white, 100))

                // ─────────────────────────────────────────────────────────────
                // STANDARD/DELAYED: Check one bar after breach (bars_since_breach >= 1)
                // ─────────────────────────────────────────────────────────────
                if bars_since_breach >= 1
                    // A candle = breach bar
                    a_open = open[breach_bar_offset]
                    a_close = close[breach_bar_offset]
                    a_high = high[breach_bar_offset]
                    a_low = low[breach_bar_offset]
                    a_mid = (a_open + a_close) / 2.0

                    // B candle = current bar (bar after breach)
                    b_open = open
                    b_close = close
                    b_high = high
                    b_low = low

                    // Check STANDARD (breach on previous bar = A candle)
                    if show_standard and breach_is_previous_low
                        // Check all conditions with explicit failure reasons
                        wick_only = a_open > prev_low and a_low < prev_low and a_close > prev_low
                        b_started_above = b_open > prev_low
                        no_new_extreme = b_low > a_low
                        b_is_bullish = b_close > b_open
                        midpoint_passed = dtt_check_midpoint(false, b_close, a_mid)

                        if not wick_only
                            std_fail_reason := "STD✗: A body touched the low"
                        else if not b_started_above
                            std_fail_reason := "STD✗: B didn't start above the low"
                        else if not no_new_extreme
                            std_fail_reason := "STD✗: B made new extreme"
                        else if not b_is_bullish
                            std_fail_reason := "STD✗: B not bullish"
                        else if not midpoint_passed
                            std_fail_reason := "STD✗: B close below A midpoint"
                        else
                            array.push(sess.pattern_is_high, false)
                            array.push(sess.pattern_formation_rule, PATTERN_STANDARD)
                            pattern_found := true

                            // Create label immediately
                            direction_suffix = b_close < b_open ? "⁻" : b_close > b_open ? "⁺" : ""
                            session_name_lower = get_session_name_lower(sess.name)
                            full_text = PATTERN_STANDARD + direction_suffix + "\n(" + session_name_lower + ")"
                            price_range = b_high - b_low
                            offset = math.max(price_range, syminfo.mintick * 50) * 0.25
                            label_price = b_high + offset
                            new_label = label.new(bar_index, label_price, text=full_text, style=label.style_label_down, textcolor=standard_label_color, size=pattern_label_size, color=color.new(color.white, 100))
                            array.push(sess.pattern_labels, new_label)

                            // Create verify line and label if enabled (STD/DEL: breach at bar_index - 1)
                            if verify_dtt_sweeps and na(sess.verify_low_line) and not na(prev_low_bar)
                                breach_bar = bar_index - 1
                                sess.verify_low_line := line.new(prev_low_bar, prev_low, breach_bar, prev_low, color=verify_line_color, width=verify_line_width, style=line.style_solid)
                                midpoint_bar = math.round((prev_low_bar + breach_bar) / 2)
                                label_offset = (high - low) * verify_label_offset / 100.0
                                sess.verify_low_label := label.new(midpoint_bar, prev_low - label_offset, text=session_name_lower, style=label.style_label_center, textcolor=color.black, size=verify_label_size, color=color.new(color.white, 100))

                    // Check DELAYED (breach on previous bar = A candle)
                    if show_delayed and breach_is_previous_low
                        // Check all conditions with explicit failure reasons
                        body_closed_beyond = a_close < prev_low
                        b_started_below = b_open < prev_low
                        b_is_bullish = b_close > b_open
                        midpoint_passed = dtt_check_midpoint(false, b_close, a_mid)

                        if not body_closed_beyond
                            del_fail_reason := "DEL✗: A didn't close below the low"
                        else if not b_started_below
                            del_fail_reason := "DEL✗: B didn't start below the low"
                        else if not b_is_bullish
                            del_fail_reason := "DEL✗: B not bullish"
                        else if not midpoint_passed
                            del_fail_reason := "DEL✗: B close below A midpoint"
                        else
                            array.push(sess.pattern_is_high, false)
                            array.push(sess.pattern_formation_rule, PATTERN_DELAYED)
                            pattern_found := true

                            // Create label immediately
                            direction_suffix = b_close < b_open ? "⁻" : b_close > b_open ? "⁺" : ""
                            session_name_lower = get_session_name_lower(sess.name)
                            full_text = PATTERN_DELAYED + direction_suffix + "\n(" + session_name_lower + ")"
                            price_range = b_high - b_low
                            offset = math.max(price_range, syminfo.mintick * 50) * 0.25
                            label_price = b_high + offset
                            new_label = label.new(bar_index, label_price, text=full_text, style=label.style_label_down, textcolor=delayed_label_color, size=pattern_label_size, color=color.new(color.white, 100))
                            array.push(sess.pattern_labels, new_label)

                            // Create verify line and label if enabled (STD/DEL: breach at bar_index - 1)
                            if verify_dtt_sweeps and na(sess.verify_low_line) and not na(prev_low_bar)
                                breach_bar = bar_index - 1
                                sess.verify_low_line := line.new(prev_low_bar, prev_low, breach_bar, prev_low, color=verify_line_color, width=verify_line_width, style=line.style_solid)
                                midpoint_bar = math.round((prev_low_bar + breach_bar) / 2)
                                label_offset = (high - low) * verify_label_offset / 100.0
                                sess.verify_low_label := label.new(midpoint_bar, prev_low - label_offset, text=session_name_lower, style=label.style_label_center, textcolor=color.black, size=verify_label_size, color=color.new(color.white, 100))

                    // Mark as checked ONLY after checking all patterns (STD/DEL checked at bars_since_breach >= 1)
                    sess.low_pattern_checked := true

                    // If no pattern found, record PRIMARY failure reason
                    if not pattern_found
                        if imm_fail_reason != ""
                            sess.low_fail_reason := imm_fail_reason
                        else if std_fail_reason != ""
                            sess.low_fail_reason := std_fail_reason
                        else if del_fail_reason != ""
                            sess.low_fail_reason := del_fail_reason

            // Labels are now created inline when patterns are detected
            array.set(session_instances, i, sess)


// ══════════════════════════════════════════════════════════════════════════════
// CANDLE HIGHLIGHTING
// ══════════════════════════════════════════════════════════════════════════════

// Check if current bar has a pattern formed (priority: DELAYED > STANDARD > IMMEDIATE)
color candle_color = na

if enable_pattern_detection and array.size(session_instances) > 0
    for i = 0 to array.size(session_instances) - 1
        sess = array.get(session_instances, i)

        // Check if pattern label was created on this bar
        if array.size(sess.pattern_labels) > 0
            for j = 0 to array.size(sess.pattern_labels) - 1
                pattern_label = array.get(sess.pattern_labels, j)
                if not na(pattern_label)
                    label_bar = label.get_x(pattern_label)
                    if label_bar == bar_index
                        // Pattern formed on this bar - check priority
                        has_delayed = false
                        has_standard = false
                        has_immediate = false

                        for k = 0 to array.size(sess.pattern_formation_rule) - 1
                            pattern_type = array.get(sess.pattern_formation_rule, k)
                            if pattern_type == PATTERN_DELAYED
                                has_delayed := true
                            else if pattern_type == PATTERN_STANDARD
                                has_standard := true
                            else if pattern_type == PATTERN_IMMEDIATE
                                has_immediate := true

                        // Apply color based on priority
                        if has_delayed
                            candle_color := highlight_delayed ? delayed_highlight_color : na
                        else if has_standard
                            candle_color := highlight_standard ? standard_highlight_color : na
                        else if has_immediate
                            candle_color := highlight_immediate ? immediate_highlight_color : na

barcolor(candle_color)


// ══════════════════════════════════════════════════════════════════════════════
// DEBUG TABLE
// ══════════════════════════════════════════════════════════════════════════════

if show_debug
    var debug_table = table.new(position.top_right, 6, 17, border_width=1)

    // Header
    table.cell(debug_table, 0, 0, "Session", text_color=color.white, bgcolor=color.blue, text_size=size.small)
    table.cell(debug_table, 1, 0, "Time", text_color=color.white, bgcolor=color.blue, text_size=size.small)
    table.cell(debug_table, 2, 0, "H", text_color=color.white, bgcolor=color.blue, text_size=size.small)
    table.cell(debug_table, 3, 0, "H Pattern", text_color=color.white, bgcolor=color.blue, text_size=size.small)
    table.cell(debug_table, 4, 0, "L", text_color=color.white, bgcolor=color.blue, text_size=size.small)
    table.cell(debug_table, 5, 0, "L Pattern", text_color=color.white, bgcolor=color.blue, text_size=size.small)

    // Show last 15 sessions only
    row = 1
    if array.size(session_instances) > 0
        start_idx = math.max(0, array.size(session_instances) - 15)
        for i = start_idx to array.size(session_instances) - 1
            if row < 16
                sess = array.get(session_instances, i)
                table.cell(debug_table, 0, row, sess.name, text_color=color.white, bgcolor=color.black, text_size=size.tiny)
                table.cell(debug_table, 1, row, str.tostring(sess.start_time) + "-" + str.tostring(sess.end_time), text_color=color.white, bgcolor=color.black, text_size=size.tiny)

                // H Breach column
                high_breach_display = sess.high_breached ? "✓" : "-"
                table.cell(debug_table, 2, row, high_breach_display, text_color=color.white, bgcolor=color.black, text_size=size.tiny)

                // H Pattern column - show all HIGH patterns detected
                high_pattern_display = ""
                high_pattern_color = color.black
                high_patterns = array.new_string()
                if array.size(sess.pattern_formation_rule) > 0
                    for k = 0 to array.size(sess.pattern_formation_rule) - 1
                        is_high = array.get(sess.pattern_is_high, k)
                        if is_high
                            array.push(high_patterns, array.get(sess.pattern_formation_rule, k))

                if array.size(high_patterns) > 0
                    high_pattern_display := array.join(high_patterns, "+")
                    high_pattern_color := color.new(color.green, 50)
                else if not na(sess.high_fail_reason)
                    high_pattern_display := sess.high_fail_reason
                    high_pattern_color := color.new(color.red, 50)
                else
                    high_pattern_display := "-"
                table.cell(debug_table, 3, row, high_pattern_display, text_color=color.white, bgcolor=high_pattern_color, text_size=size.tiny)

                // L Breach column
                low_breach_display = sess.low_breached ? "✓" : "-"
                table.cell(debug_table, 4, row, low_breach_display, text_color=color.white, bgcolor=color.black, text_size=size.tiny)

                // L Pattern column - show all LOW patterns detected
                low_pattern_display = ""
                low_pattern_color = color.black
                low_patterns = array.new_string()
                if array.size(sess.pattern_formation_rule) > 0
                    for k = 0 to array.size(sess.pattern_formation_rule) - 1
                        is_high = array.get(sess.pattern_is_high, k)
                        if not is_high
                            array.push(low_patterns, array.get(sess.pattern_formation_rule, k))

                if array.size(low_patterns) > 0
                    low_pattern_display := array.join(low_patterns, "+")
                    low_pattern_color := color.new(color.green, 50)
                else if not na(sess.low_fail_reason)
                    low_pattern_display := sess.low_fail_reason
                    low_pattern_color := color.new(color.red, 50)
                else
                    low_pattern_display := "-"
                table.cell(debug_table, 5, row, low_pattern_display, text_color=color.white, bgcolor=low_pattern_color, text_size=size.tiny)

                row += 1

    // Determine current session based on time
    current_session_name = "None"
    for j = 0 to array.size(session_templates) - 1
        tmpl = array.get(session_templates, j)
        is_in = false
        if tmpl.end_time > tmpl.start_time
            is_in := current_time >= tmpl.start_time and current_time < tmpl.end_time
        else
            is_in := current_time >= tmpl.start_time or current_time < tmpl.end_time
        if is_in
            current_session_name := tmpl.name
            break

    // Calculate pattern type counts separated by HIGH and LOW
    h_imm_count = 0
    h_std_count = 0
    h_del_count = 0
    l_imm_count = 0
    l_std_count = 0
    l_del_count = 0
    if array.size(session_instances) > 0
        for i = 0 to array.size(session_instances) - 1
            sess = array.get(session_instances, i)
            if array.size(sess.pattern_formation_rule) > 0
                for k = 0 to array.size(sess.pattern_formation_rule) - 1
                    is_high = array.get(sess.pattern_is_high, k)
                    pattern_type = array.get(sess.pattern_formation_rule, k)

                    if is_high
                        if pattern_type == PATTERN_IMMEDIATE
                            h_imm_count += 1
                        else if pattern_type == PATTERN_STANDARD
                            h_std_count += 1
                        else if pattern_type == PATTERN_DELAYED
                            h_del_count += 1
                    else
                        if pattern_type == PATTERN_IMMEDIATE
                            l_imm_count += 1
                        else if pattern_type == PATTERN_STANDARD
                            l_std_count += 1
                        else if pattern_type == PATTERN_DELAYED
                            l_del_count += 1

    // Add summary info
    day_names = array.from("", "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat")
    day_name = array.get(day_names, current_day)

    table.cell(debug_table, 0, row, "Time: " + str.tostring(current_time), text_color=color.yellow, bgcolor=color.navy, text_size=size.tiny)
    table.cell(debug_table, 1, row, day_name + " | " + current_session_name + " | Total: " + str.tostring(array.size(session_instances)), text_color=color.yellow, bgcolor=color.navy, text_size=size.tiny)
    table.cell(debug_table, 2, row, "24/7: " + (is_247_asset ? "Y" : "N"), text_color=color.yellow, bgcolor=color.navy, text_size=size.tiny)
    table.cell(debug_table, 3, row, "IMM:" + str.tostring(h_imm_count) + " STD:" + str.tostring(h_std_count) + " DEL:" + str.tostring(h_del_count), text_color=color.yellow, bgcolor=color.navy, text_size=size.tiny)
    table.cell(debug_table, 4, row, "", text_color=color.yellow, bgcolor=color.navy, text_size=size.tiny)
    table.cell(debug_table, 5, row, "IMM:" + str.tostring(l_imm_count) + " STD:" + str.tostring(l_std_count) + " DEL:" + str.tostring(l_del_count), text_color=color.yellow, bgcolor=color.navy, text_size=size.tiny)
