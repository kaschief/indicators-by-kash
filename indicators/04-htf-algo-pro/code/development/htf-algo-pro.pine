//@version=6
indicator('HTF Algo Draw° [Pro+]', overlay=true, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// HTF ALGO DRAW - HIGHER TIMEFRAME ALGORITHMIC LIQUIDITY DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

// Indicator meta
const string ALGO_DRAW_TEXT = " HTF algo draw"
const string SUFFIX_B = "(b)"
const string SUFFIX_S = "(s)"

// Magic numbers
const int MS_IN_SEC = 1000
const int FILLED_LINES_CAP = 10
const int MEMORY_MIN_TOTAL_MAX = 100
const int MEMORY_PRUNE_MULTIPLIER = 8
const int DASHBOARD_BASE_ROWS = 3
const int TABLE_SPACER_TRANSPARENCY = 100

// Style options
const string STYLE_SOLID = 'Solid'
const string STYLE_DASHED = 'Dashed'
const string STYLE_DOTTED = 'Dotted'

// Size options
const string SIZE_TINY = 'Tiny'
const string SIZE_SMALL = 'Small'
const string SIZE_NORMAL = 'Normal'
const string SIZE_LARGE = 'Large'

// Position options
const string POS_LEFT = 'Left'
const string POS_CENTER = 'Center'
const string POS_RIGHT = 'Right'
const string POSV_TOP = 'Top'
const string POSV_MIDDLE = 'Middle'
const string POSV_BOTTOM = 'Bottom'

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

// Display
open_lines_count = input.int(5, 'Max Active Lines', minval=0, maxval=100, group='Display', tooltip='Maximum active draws to display (per BSL/SSL). Filled draws capped at 10.')

// Colors
buyside_color = input.color(color.green, 'BSL Open', group='Colors', inline='bsl')
buyside_filled_color = input.color(color.green, 'Filled', group='Colors', inline='bsl')
bsl_label_text_color = input.color(color.green, 'Label', group='Colors', inline='bsl')
sellside_color = input.color(color.red, 'SSL Open', group='Colors', inline='ssl')
sellside_filled_color = input.color(color.red, 'Filled', group='Colors', inline='ssl')
ssl_label_text_color = input.color(color.red, 'Label', group='Colors', inline='ssl')

// Line Styles
open_style = input.string(STYLE_SOLID, 'Open Style', options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], group='Line Styles', inline='open')
open_width = input.int(2, 'Width', minval=1, maxval=5, group='Line Styles', inline='open')
filled_style = input.string(STYLE_DASHED, 'Filled Style', options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], group='Line Styles', inline='filled')
filled_width = input.int(1, 'Width', minval=1, maxval=5, group='Line Styles', inline='filled')
filled_opacity = input.int(70, 'Opacity', minval=0, maxval=95, group='Line Styles', inline='filled')

// Dashboard
show_dashboard = input.bool(true, 'Show', group='Dashboard', inline='show')
table_position_h = input.string(POS_RIGHT, 'H', options=[POS_LEFT, POS_CENTER, POS_RIGHT], group='Dashboard', inline='pos')
table_position_v = input.string(POSV_TOP, 'V', options=[POSV_TOP, POSV_MIDDLE, POSV_BOTTOM], group='Dashboard', inline='pos')
table_bg_color = input.color(color.new(color.blue, 90), 'BG', group='Dashboard', inline='style')
table_border_color = input.color(color.blue, 'Border', group='Dashboard', inline='style')
default_text_color = input.color(color.gray, 'Text', group='Dashboard', inline='style')

// Algorithm
auto_htf = input.bool(false, 'Auto HTF', group='Algorithm', inline='htf')
htf_timeframe = input.timeframe('60', 'HTF', group='Algorithm', inline='htf')
extend_bars = 8

// ═══════════════════════════════════════════════════════════════════════════════
// CHANGE DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

filled_lines_count = FILLED_LINES_CAP
var string last_ticker = ticker.standard()
var string last_chart_tf = timeframe.period
var string last_htf_tf = ""
var string last_limit_zone = ""

chart_tf_seconds = timeframe.in_seconds(timeframe.period)
chart_tf_minutes = chart_tf_seconds / 60

// ═══════════════════════════════════════════════════════════════════════════════
// HTF VALIDATION SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

get_chart_tf_minutes_cached() => chart_tf_minutes


get_limit_zone() =>
    chart_tf_min = get_chart_tf_minutes_cached()
    switch
        chart_tf_min <= 3  => "ultra_short"    // 1-3m → 15m limit
        chart_tf_min == 5  => "short"          // 5m → 1H limit
        chart_tf_min == 10 => "short_med"      // 10m → 2H limit
        chart_tf_min <= 30 => "medium"         // 15-30m → 4H limit
        chart_tf_min <= 60 => "medium_long"    // 45-60m → 1D limit
        chart_tf_min <= 240 => "long"          // 2H-4H → 1D limit
        chart_tf_min <= 1440 => "daily"        // 1D → 1W limit
        chart_tf_min <= 10080 => "weekly"      // 1W → 3M limit
        chart_tf_min >= 43800 => "monthly"     // 1M+ → 3M limit
        => "extended"                          // Quarterly+ → Yearly limit


get_max_allowed_htf() =>
    chart_tf_min = get_chart_tf_minutes_cached()
    switch
        chart_tf_min <= 3  => '15'      // 1-3m max 15m
        chart_tf_min == 5  => '60'      // 5m max 1H
        chart_tf_min == 10 => '120'     // 10m max 2H
        chart_tf_min == 15 => '240'     // 15m max 4H
        chart_tf_min == 30 => '240'     // 30m max 4H
        chart_tf_min <= 60 => '1D'      // 45-60m max 1D
        chart_tf_min <= 240 => '1D'     // 2H-4H max 1D
        chart_tf_min <= 1440 => '1W'    // Daily max Weekly
        chart_tf_min <= 10080 => '3M'   // Weekly max 3M (allows Quarterly!)
        chart_tf_min >= 43800 => '3M'   // Monthly max 3M (consistent)
        => '12M'                        // Quarterly+ max Yearly


get_auto_htf_preferred() =>
    chart_tf_min = get_chart_tf_minutes_cached()
    switch
        chart_tf_min <= 2  => '15'   // 1-2m → 15m preferred
        chart_tf_min <= 5  => '30'   // 3-5m → 30m preferred
        chart_tf_min <= 15 => '60'   // 10-15m → 1H preferred
        chart_tf_min <= 30 => '120'  // 20-30m → 2H preferred
        chart_tf_min <= 60 => '240'  // 45-60m → 4H preferred
        chart_tf_min <= 240 => '1D'  // 2H-4H → 1D preferred
        chart_tf_min <= 1440 => '1W' // Daily → 1W preferred
        chart_tf_min <= 10080 => '1M'// Weekly → 1M preferred
        chart_tf_min >= 43800 => '3M'// Monthly+ → 3M preferred
        => '12M'                     // Quarterly+ → Yearly preferred


validate_and_limit_htf() =>
    limit_tf = get_max_allowed_htf()
    limit_seconds = timeframe.in_seconds(limit_tf)

    // AUTO MODE: use preferred, MANUAL MODE: use user selection
    req_tf = auto_htf ? get_auto_htf_preferred() : htf_timeframe
    req_seconds = timeframe.in_seconds(req_tf)

    // Validate: Must be > chart TF and <= limit
    if req_seconds > chart_tf_seconds and req_seconds <= limit_seconds
        req_tf
    else
        limit_tf  // Fallback to limit if invalid


validated_htf_timeframe = validate_and_limit_htf()
htf_is_valid = timeframe.in_seconds(validated_htf_timeframe) > chart_tf_seconds


htf_seconds = timeframe.in_seconds(validated_htf_timeframe)



// ═══════════════════════════════════════════════════════════════════════════════
// DATA STRUCTURES
// ═══════════════════════════════════════════════════════════════════════════════


var array<int> buyside_failure_bars = array.new<int>()
var array<int> buyside_failure_times = array.new<int>()
var array<float> buyside_targets = array.new<float>()
var array<bool> buyside_open = array.new<bool>()
var array<int> buyside_fill_bars = array.new<int>()
var array<int> buyside_fill_times = array.new<int>()
var array<line> buyside_lines = array.new<line>()
var array<label> buyside_labels = array.new<label>()
var array<int> buyside_wick_times = array.new<int>()

var array<int> sellside_failure_bars = array.new<int>()
var array<int> sellside_failure_times = array.new<int>()
var array<float> sellside_targets = array.new<float>()
var array<bool> sellside_open = array.new<bool>()
var array<int> sellside_fill_bars = array.new<int>()
var array<int> sellside_fill_times = array.new<int>()
var array<line> sellside_lines = array.new<line>()
var array<label> sellside_labels = array.new<label>()
var array<int> sellside_wick_times = array.new<int>()

var array<int> eligible_high_ticks = array.new<int>()
var array<int> eligible_low_ticks = array.new<int>()
var array<int> eligible_high_times = array.new<int>()
var array<int> eligible_low_times = array.new<int>()


var int htf_bars_processed = 0
var int htf_unique_bars = 0
var bool initialized = false

var table htf_dashboard = na
var int cached_bsl_open = -1
var int cached_ssl_open = -1
var int cached_tracking_lows = -1
var int cached_tracking_highs = -1
var string cached_mode_text = ""
var string cached_htf_tag = ""

// ═══════════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

to_tick(price) => math.round(price / syminfo.mintick)
from_tick(tick) => tick * syminfo.mintick

get_line_style(style_string) =>
    switch style_string
        STYLE_DASHED => line.style_dashed
        STYLE_DOTTED => line.style_dotted
        => line.style_solid

get_label_text_size() => size.small

get_table_text_size() => size.tiny

bg_none() => color.new(color.white, 100)

get_htf_tag() =>
    htf_tf = validated_htf_timeframe
    local_htf_seconds = timeframe.in_seconds(htf_tf)
    local_htf_minutes = local_htf_seconds / 60

    if local_htf_minutes < 1440  // Less than 1 day (intraday)
        if local_htf_minutes % 60 == 0
            str.tostring(local_htf_minutes / 60) + "H"  // Hours: 1H, 4H, etc.
        else
            str.tostring(local_htf_minutes) + "m"       // Minutes: 15m, 30m, etc.
    else if local_htf_minutes == 1440
        "1D"  // Daily
    else if local_htf_minutes == 10080
        "1W"  // Weekly
    else if htf_tf == '1M'
        "1M"  // Monthly
    else if htf_tf == '3M'
        "3M"  // Quarterly
    else if htf_tf == '6M'
        "6M"  // Semiannual
    else if htf_tf == '12M'
        "12M" // Yearly
    else
        htf_tf  // Fallback

get_htf_tag_text() => get_htf_tag() + ALGO_DRAW_TEXT

get_timeframe_text_with_suffix(is_bsl) =>
    base_text = get_htf_tag_text()
    suffix_text = is_bsl ? SUFFIX_B : SUFFIX_S
    suffix_text + " " + base_text  // Always show (b)/(s) at front

create_end_label(end_time, target_price, label_text_color, is_bsl, tooltip_text) =>
    lab = label.new(
         x=end_time,
         y=target_price,
         text=get_timeframe_text_with_suffix(is_bsl),
         style=label.style_label_left,
         textcolor=label_text_color,
         size=get_label_text_size(),
         xloc=xloc.bar_time,
         tooltip=tooltip_text
     )
    label.set_color(lab, bg_none())
    lab

format_tooltip(is_bsl, wick_timestamp) =>
    type_text = is_bsl ? "BSL: Wick took LOW" : "SSL: Wick took HIGH"
    formatted_time = str.format_time(wick_timestamp, "MMM dd, yyyy HH:mm", syminfo.timezone)
    type_text + " • " + formatted_time + ", " + get_htf_tag()

// Convert timeframe to user-friendly display
get_user_friendly_timeframe(tf) =>
    switch tf
        '15' => '15m'
        '30' => '30m'
        '60' => '1H'
        '120' => '2H'
        '240' => '4H'
        '1D' => '1D'
        '1W' => '1W'
        '1M' => '1M'
        '3M' => '3M'
        '6M' => '6M'
        '12M' => '12M'
        => tf



// Dashboard positioning helpers
get_table_position() =>
    if table_position_v == POSV_TOP
        if table_position_h == POS_LEFT
            position.top_left
        else if table_position_h == POS_CENTER
            position.top_center
        else
            position.top_right
    else if table_position_v == POSV_MIDDLE
        if table_position_h == POS_LEFT
            position.middle_left
        else if table_position_h == POS_CENTER
            position.middle_center
        else
            position.middle_right
    else  // Bottom
        if table_position_h == POS_LEFT
            position.bottom_left
        else if table_position_h == POS_CENTER
            position.bottom_center
        else
            position.bottom_right

// Get current chart timeframe display
get_chart_tf_display() =>
    if timeframe.isintraday
        m = timeframe.multiplier
        m % 60 == 0 ? str.tostring(m / 60) + "H" : str.tostring(m) + "m"
    else if timeframe.isdaily
        str.tostring(timeframe.multiplier) + "D"
    else if timeframe.isweekly
        str.tostring(timeframe.multiplier) + "W"
    else if timeframe.ismonthly
        str.tostring(timeframe.multiplier) + "M"
    else
        timeframe.period

// Get allowed HTF preset list with cap - CLEAN FORMAT
get_allowed_htf_presets() =>
    chart_tf_min = get_chart_tf_minutes_cached()
    preset_list = array.new<string>()
    cap_display = ""

    if chart_tf_min <= 3  // 1-3m chart → cap: 15m
        array.push(preset_list, "15m")
        cap_display := "15m"
    else if chart_tf_min == 5  // 5m → cap: 1H
        array.push(preset_list, "15m")
        array.push(preset_list, "30m")
        array.push(preset_list, "1H")
        cap_display := "1H"
    else if chart_tf_min == 10  // 10m → cap: 2H
        array.push(preset_list, "15m")
        array.push(preset_list, "30m")
        array.push(preset_list, "1H")
        array.push(preset_list, "2H")
        cap_display := "2H"
    else if chart_tf_min == 15  // 15m → cap: 4H
        array.push(preset_list, "30m")
        array.push(preset_list, "1H")
        array.push(preset_list, "2H")
        array.push(preset_list, "4H")
        cap_display := "4H"
    else if chart_tf_min == 30  // 30m → cap: 4H
        array.push(preset_list, "1H")
        array.push(preset_list, "2H")
        array.push(preset_list, "4H")
        cap_display := "4H"
    else if chart_tf_min <= 60  // 45-60m → cap: 1D
        array.push(preset_list, "2H")
        array.push(preset_list, "4H")
        array.push(preset_list, "1D")
        cap_display := "1D"
    else if chart_tf_min <= 240  // 2H-4H-6H-7H etc → cap: 1D
        array.push(preset_list, "1D")
        cap_display := "1D"
    else if chart_tf_min <= 1440  // Daily → cap: 1W
        array.push(preset_list, "1W")
        cap_display := "1W"
    else if chart_tf_min <= 10080  // Weekly → cap: 3M
        array.push(preset_list, "1M")
        array.push(preset_list, "3M")
        cap_display := "3M"
    else if chart_tf_min >= 43800  // Monthly+ → cap: 3M
        array.push(preset_list, "3M")
        cap_display := "3M"

    // Convert array to comma-separated string with cap
    if array.size(preset_list) == 0
        "None"
    else
        preset_result = ""
        for i = 0 to array.size(preset_list) - 1
            if i > 0
                preset_result := preset_result + ", "
            preset_result := preset_result + array.get(preset_list, i)

        // Format: "Presets: 15m, 30m, 1H • Any up to 1H"
        "Presets: " + preset_result + " • Any up to " + cap_display

add_eligible_high(price, timestamp) =>
    tick = to_tick(price)
    if array.indexof(eligible_high_ticks, tick) == -1
        array.push(eligible_high_ticks, tick)
        array.push(eligible_high_times, timestamp)  // Track when high was created
        while array.size(eligible_high_ticks) > 500
            array.shift(eligible_high_ticks)
            array.shift(eligible_high_times)  // Keep arrays in sync

add_eligible_low(price, timestamp) =>
    tick = to_tick(price)
    if array.indexof(eligible_low_ticks, tick) == -1
        array.push(eligible_low_ticks, tick)
        array.push(eligible_low_times, timestamp)   // Track when low was created
        while array.size(eligible_low_ticks) > 500
            array.shift(eligible_low_ticks)
            array.shift(eligible_low_times)   // Keep arrays in sync

// OPTIMIZATION 6: Reset state function for TF/symbol changes
reset_state() =>
    // Clear all data arrays - BSL FIRST
    array.clear(buyside_failure_bars)
    array.clear(buyside_failure_times)
    array.clear(buyside_targets)
    array.clear(buyside_open)
    array.clear(buyside_fill_bars)
    array.clear(buyside_fill_times)

    array.clear(sellside_failure_bars)
    array.clear(sellside_failure_times)
    array.clear(sellside_targets)
    array.clear(sellside_open)
    array.clear(sellside_fill_bars)
    array.clear(sellside_fill_times)

    array.clear(eligible_high_ticks)
    array.clear(eligible_low_ticks)
    array.clear(eligible_high_times)
    array.clear(eligible_low_times)

    // Clean up visual elements
    if array.size(buyside_lines) > 0
        for i = 0 to array.size(buyside_lines) - 1
            if not na(array.get(buyside_lines, i))
                line.delete(array.get(buyside_lines, i))
    array.clear(buyside_lines)
    array.clear(buyside_wick_times)

    if array.size(buyside_labels) > 0
        for i = 0 to array.size(buyside_labels) - 1
            if not na(array.get(buyside_labels, i))
                label.delete(array.get(buyside_labels, i))
    array.clear(buyside_labels)

    if array.size(sellside_lines) > 0
        for i = 0 to array.size(sellside_lines) - 1
            if not na(array.get(sellside_lines, i))
                line.delete(array.get(sellside_lines, i))
    array.clear(sellside_lines)
    array.clear(sellside_wick_times)

    if array.size(sellside_labels) > 0
        for i = 0 to array.size(sellside_labels) - 1
            if not na(array.get(sellside_labels, i))
                label.delete(array.get(sellside_labels, i))
    array.clear(sellside_labels)



// ═══════════════════════════════════════════════════════════════════════════════
// CHANGE DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

current_ticker = ticker.standard()
current_chart_tf = timeframe.period
current_htf_tf = validated_htf_timeframe
current_limit_zone = get_limit_zone()


symbol_changed = current_ticker != last_ticker
chart_tf_changed = current_chart_tf != last_chart_tf
htf_tf_changed = current_htf_tf != last_htf_tf


limit_zone_changed = current_limit_zone != last_limit_zone
needs_reset = symbol_changed or chart_tf_changed or (auto_htf and limit_zone_changed) or (not auto_htf and htf_tf_changed)

if needs_reset
    reset_state()

    htf_bars_processed := 0
    htf_unique_bars := 0
    initialized := true


    cached_bsl_open := -1
    cached_ssl_open := -1
    cached_tracking_lows := -1
    cached_tracking_highs := -1
    cached_mode_text := ""
    cached_htf_tag := ""
    last_ticker := current_ticker
    last_chart_tf := current_chart_tf
    last_htf_tf := current_htf_tf
    last_limit_zone := current_limit_zone

// ═══════════════════════════════════════════════════════════════════════════════
// HISTORICAL BACKFILL
// ═══════════════════════════════════════════════════════════════════════════════


var float cached_htf_high = na
var float cached_htf_low = na
var float cached_htf_close = na
var int cached_htf_time = na

if htf_is_valid
    [htf_open, htf_high, htf_low, htf_close, htf_time] = request.security(syminfo.tickerid, validated_htf_timeframe, [open, high, low, close, time], lookahead=barmerge.lookahead_off)

    htf_time_changed = ta.change(htf_time) != 0


    if htf_time_changed
        cached_htf_high := htf_high
        cached_htf_low := htf_low
        cached_htf_close := htf_close
        cached_htf_time := htf_time


    if not initialized and barstate.islastconfirmedhistory and not needs_reset

        max_lookback = 0  // Skip historical backfill for instant loading

        if max_lookback > 0
            historical_htf_times = request.security(syminfo.tickerid, validated_htf_timeframe, time, lookahead=barmerge.lookahead_off)
            historical_htf_highs = request.security(syminfo.tickerid, validated_htf_timeframe, high, lookahead=barmerge.lookahead_off)
            historical_htf_lows = request.security(syminfo.tickerid, validated_htf_timeframe, low, lookahead=barmerge.lookahead_off)
            historical_htf_closes = request.security(syminfo.tickerid, validated_htf_timeframe, close, lookahead=barmerge.lookahead_off)


            for i = max_lookback to 1
                if i <= bar_index
                    hist_htf_time = historical_htf_times[i]
                    hist_htf_high = historical_htf_highs[i]
                    hist_htf_low = historical_htf_lows[i]
                    hist_htf_close = historical_htf_closes[i]

                    prev_hist_htf_time = historical_htf_times[i + 1]
                    hist_htf_time_changed = hist_htf_time != prev_hist_htf_time

                    if hist_htf_time_changed
                        htf_bars_processed += 1


                        local_sellside_detected = false
                        local_buyside_detected = false


                        if array.size(eligible_high_ticks) > 0 and not local_sellside_detected
                            for j = array.size(eligible_high_ticks) - 1 to 0
                                ref_high_tick = array.get(eligible_high_ticks, j)
                                ref_high = from_tick(ref_high_tick)

                                if hist_htf_high > ref_high and hist_htf_close < ref_high
                                    wick_timestamp = array.get(eligible_high_times, j)  // Get when this high was created
                                    array.push(sellside_failure_bars, bar_index - i)
                                    array.push(sellside_failure_times, int(time[bar_index - i]))
                                    array.push(sellside_targets, hist_htf_low)
                                    array.push(sellside_open, true)
                                    array.push(sellside_fill_bars, int(na))
                                    array.push(sellside_fill_times, int(na))
                                    array.push(sellside_lines, na)
                                    array.push(sellside_labels, na)
                                    array.push(sellside_wick_times, wick_timestamp)  // Store wick reference time

                                    local_sellside_detected := true
                                    break


                        if array.size(eligible_low_ticks) > 0 and not local_buyside_detected
                            for j = array.size(eligible_low_ticks) - 1 to 0
                                ref_low_tick = array.get(eligible_low_ticks, j)
                                ref_low = from_tick(ref_low_tick)

                                if hist_htf_low < ref_low and hist_htf_close > ref_low
                                    wick_timestamp = array.get(eligible_low_times, j)  // Get when this low was created
                                    array.push(buyside_failure_bars, bar_index - i)
                                    array.push(buyside_failure_times, int(time[bar_index - i]))
                                    array.push(buyside_targets, hist_htf_high)
                                    array.push(buyside_open, true)
                                    array.push(buyside_fill_bars, int(na))
                                    array.push(buyside_fill_times, int(na))
                                    array.push(buyside_lines, na)
                                    array.push(buyside_labels, na)
                                    array.push(buyside_wick_times, wick_timestamp)  // Store wick reference time

                                    local_buyside_detected := true
                                    break


                        if array.size(eligible_high_ticks) > 0
                            j = array.size(eligible_high_ticks) - 1
                            while j >= 0
                                if hist_htf_high >= from_tick(array.get(eligible_high_ticks, j))
                                    array.remove(eligible_high_ticks, j)
                                    array.remove(eligible_high_times, j)  // Keep timestamps in sync
                                j -= 1

                        if array.size(eligible_low_ticks) > 0
                            j = array.size(eligible_low_ticks) - 1
                            while j >= 0
                                if hist_htf_low <= from_tick(array.get(eligible_low_ticks, j))
                                    array.remove(eligible_low_ticks, j)
                                    array.remove(eligible_low_times, j)   // Keep timestamps in sync
                                j -= 1

                        add_eligible_high(hist_htf_high, hist_htf_time)
                        add_eligible_low(hist_htf_low, hist_htf_time)

        initialized := true


    if htf_time_changed
        htf_unique_bars := htf_unique_bars + 1
        htf_bars_processed := htf_bars_processed + 1


        local_sellside_detected = false
        local_buyside_detected = false


        if array.size(eligible_high_ticks) > 0 and not local_sellside_detected
            for i = array.size(eligible_high_ticks) - 1 to 0
                ref_high_tick = array.get(eligible_high_ticks, i)
                ref_high = from_tick(ref_high_tick)

                if htf_high > ref_high and htf_close < ref_high
                    wick_timestamp = array.get(eligible_high_times, i)  // Get when this high was created
                    array.push(sellside_failure_bars, bar_index)
                    array.push(sellside_failure_times, int(time))
                    array.push(sellside_targets, htf_low)
                    array.push(sellside_open, true)
                    array.push(sellside_fill_bars, int(na))
                    array.push(sellside_fill_times, int(na))
                    array.push(sellside_lines, na)
                    array.push(sellside_labels, na)
                    array.push(sellside_wick_times, wick_timestamp)

                    local_sellside_detected := true
                    break


        if array.size(eligible_low_ticks) > 0 and not local_buyside_detected
            for i = array.size(eligible_low_ticks) - 1 to 0
                ref_low_tick = array.get(eligible_low_ticks, i)
                ref_low = from_tick(ref_low_tick)

                if htf_low < ref_low and htf_close > ref_low
                    wick_timestamp = array.get(eligible_low_times, i)  // Get when this low was created
                    array.push(buyside_failure_bars, bar_index)
                    array.push(buyside_failure_times, int(time))
                    array.push(buyside_targets, htf_high)
                    array.push(buyside_open, true)
                    array.push(buyside_fill_bars, int(na))
                    array.push(buyside_fill_times, int(na))
                    array.push(buyside_lines, na)
                    array.push(buyside_labels, na)
                    array.push(buyside_wick_times, wick_timestamp)

                    local_buyside_detected := true
                    break


        if array.size(eligible_high_ticks) > 0
            i = array.size(eligible_high_ticks) - 1
            while i >= 0
                if htf_high >= from_tick(array.get(eligible_high_ticks, i))
                    array.remove(eligible_high_ticks, i)
                    array.remove(eligible_high_times, i)  // Keep timestamps in sync
                i -= 1

        if array.size(eligible_low_ticks) > 0
            i = array.size(eligible_low_ticks) - 1
            while i >= 0
                if htf_low <= from_tick(array.get(eligible_low_ticks, i))
                    array.remove(eligible_low_ticks, i)
                    array.remove(eligible_low_times, i)   // Keep timestamps in sync
                i -= 1

        add_eligible_high(htf_high, htf_time)
        add_eligible_low(htf_low, htf_time)

// ═══════════════════════════════════════════════════════════════════════════════
// FILL DETECTION
// ═══════════════════════════════════════════════════════════════════════════════


    // SSL fill detection with same-bar prevention
    if array.size(sellside_targets) > 0
        for i = 0 to array.size(sellside_targets) - 1
            if array.get(sellside_open, i)
                failure_bar = array.get(sellside_failure_bars, i)
                target_price = array.get(sellside_targets, i)

                if bar_index > failure_bar and low <= target_price
                    array.set(sellside_open, i, false)
                    array.set(sellside_fill_bars, i, bar_index)
                    array.set(sellside_fill_times, i, int(time))

    // BSL fill detection with same-bar prevention
    if array.size(buyside_targets) > 0
        for i = 0 to array.size(buyside_targets) - 1
            if array.get(buyside_open, i)
                failure_bar = array.get(buyside_failure_bars, i)
                target_price = array.get(buyside_targets, i)

                if bar_index > failure_bar and high >= target_price
                    array.set(buyside_open, i, false)
                    array.set(buyside_fill_bars, i, bar_index)
                    array.set(buyside_fill_times, i, int(time))

// ═══════════════════════════════════════════════════════════════════════════════
// DISPLAY SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

if (barstate.isconfirmed or barstate.islast)


    if array.size(buyside_failure_bars) > 0
        local_open_lines_shown = 0
        local_filled_lines_shown = 0

        for i = array.size(buyside_failure_bars) - 1 to 0
            local_is_open = array.get(buyside_open, i)
            local_current_line = array.get(buyside_lines, i)
            local_current_label = array.get(buyside_labels, i)

            local_should_show = false

            if local_is_open
                if local_open_lines_shown < open_lines_count
                    local_should_show := true
                    local_open_lines_shown += 1
            else
                if local_filled_lines_shown < filled_lines_count
                    local_should_show := true
                    local_filled_lines_shown += 1

            if local_should_show
                local_failure_time = array.get(buyside_failure_times, i)
                local_target = array.get(buyside_targets, i)
                local_fill_time = array.get(buyside_fill_times, i)

                local_end_time = local_is_open ? time + (chart_tf_seconds * 1000 * extend_bars) : local_fill_time

                local_line_color = local_is_open ? buyside_color : color.new(buyside_filled_color, filled_opacity)
                local_line_style = get_line_style(local_is_open ? open_style : filled_style)
                local_line_width_val = local_is_open ? open_width : filled_width

                if na(local_current_line)
                    local_new_line = line.new(local_failure_time, local_target, local_end_time, local_target, xloc=xloc.bar_time)
                    line.set_color(local_new_line, local_line_color)
                    line.set_style(local_new_line, local_line_style)
                    line.set_width(local_new_line, local_line_width_val)
                    array.set(buyside_lines, i, local_new_line)
                else
                    line.set_xy1(local_current_line, local_failure_time, local_target)
                    line.set_xy2(local_current_line, local_end_time, local_target)
                    line.set_color(local_current_line, local_line_color)
                    line.set_style(local_current_line, local_line_style)
                    line.set_width(local_current_line, local_line_width_val)

                // Label management with tooltip
                if local_is_open
                    wick_timestamp = array.get(buyside_wick_times, i)
                    tooltip_text = format_tooltip(true, wick_timestamp)

                    if na(local_current_label)
                        local_new_label = label.new(
                             x=local_end_time,
                             y=local_target,
                             text=get_timeframe_text_with_suffix(true),
                             style=label.style_label_left,
                             textcolor=bsl_label_text_color,
                             size=get_label_text_size(),
                             xloc=xloc.bar_time,
                             tooltip=tooltip_text
                         )
                        label.set_color(local_new_label, bg_none())
                        array.set(buyside_labels, i, local_new_label)
                    else
                        label.set_xy(local_current_label, local_end_time, local_target)
                        label.set_text(local_current_label, get_timeframe_text_with_suffix(true))
                        label.set_textcolor(local_current_label, bsl_label_text_color)
                        label.set_size(local_current_label, get_label_text_size())
                        label.set_color(local_current_label, bg_none())
                        label.set_tooltip(local_current_label, tooltip_text)
                else
                    if not na(local_current_label)
                        label.delete(local_current_label)
                        array.set(buyside_labels, i, na)
            else
                if not na(local_current_line)
                    line.delete(local_current_line)
                    array.set(buyside_lines, i, na)
                if not na(local_current_label)
                    label.delete(local_current_label)
                    array.set(buyside_labels, i, na)

    // SELL-SIDE HTF ALGO DRAWS - SSL SECOND
    if array.size(sellside_failure_bars) > 0
        local_open_lines_shown = 0
        local_filled_lines_shown = 0

        for i = array.size(sellside_failure_bars) - 1 to 0
            local_is_open = array.get(sellside_open, i)
            local_current_line = array.get(sellside_lines, i)
            local_current_label = array.get(sellside_labels, i)

            local_should_show = false

            if local_is_open
                if local_open_lines_shown < open_lines_count
                    local_should_show := true
                    local_open_lines_shown += 1
            else
                if local_filled_lines_shown < filled_lines_count
                    local_should_show := true
                    local_filled_lines_shown += 1

            if local_should_show
                local_failure_time = array.get(sellside_failure_times, i)
                local_target = array.get(sellside_targets, i)
                local_fill_time = array.get(sellside_fill_times, i)

                local_end_time = local_is_open ? time + (chart_tf_seconds * 1000 * extend_bars) : local_fill_time

                local_line_color = local_is_open ? sellside_color : color.new(sellside_filled_color, filled_opacity)
                local_line_style = get_line_style(local_is_open ? open_style : filled_style)
                local_line_width_val = local_is_open ? open_width : filled_width

                if na(local_current_line)
                    local_new_line = line.new(local_failure_time, local_target, local_end_time, local_target, xloc=xloc.bar_time)
                    line.set_color(local_new_line, local_line_color)
                    line.set_style(local_new_line, local_line_style)
                    line.set_width(local_new_line, local_line_width_val)
                    array.set(sellside_lines, i, local_new_line)
                else
                    line.set_xy1(local_current_line, local_failure_time, local_target)
                    line.set_xy2(local_current_line, local_end_time, local_target)
                    line.set_color(local_current_line, local_line_color)
                    line.set_style(local_current_line, local_line_style)
                    line.set_width(local_current_line, local_line_width_val)

                // Label management with tooltip
                if local_is_open
                    wick_timestamp = array.get(sellside_wick_times, i)
                    tooltip_text = format_tooltip(false, wick_timestamp)

                    if na(local_current_label)
                        local_new_label = label.new(
                             x=local_end_time,
                             y=local_target,
                             text=get_timeframe_text_with_suffix(false),
                             style=label.style_label_left,
                             textcolor=ssl_label_text_color,
                             size=get_label_text_size(),
                             xloc=xloc.bar_time,
                             tooltip=tooltip_text
                         )
                        label.set_color(local_new_label, bg_none())
                        array.set(sellside_labels, i, local_new_label)
                    else
                        label.set_xy(local_current_label, local_end_time, local_target)
                        label.set_text(local_current_label, get_timeframe_text_with_suffix(false))
                        label.set_textcolor(local_current_label, ssl_label_text_color)
                        label.set_size(local_current_label, get_label_text_size())
                        label.set_color(local_current_label, bg_none())
                        label.set_tooltip(local_current_label, tooltip_text)
                else
                    if not na(local_current_label)
                        label.delete(local_current_label)
                        array.set(sellside_labels, i, na)
            else
                if not na(local_current_line)
                    line.delete(local_current_line)
                    array.set(sellside_lines, i, na)
                if not na(local_current_label)
                    label.delete(local_current_label)
                    array.set(sellside_labels, i, na)



// ═══════════════════════════════════════════════════════════════════════════════
// DASHBOARD
// ═══════════════════════════════════════════════════════════════════════════════

if show_dashboard and initialized

    bsl_total = array.size(buyside_targets)
    ssl_total = array.size(sellside_targets)
    current_bsl_open = 0
    current_ssl_open = 0

    if bsl_total > 0
        for i = 0 to bsl_total - 1
            if array.get(buyside_open, i)
                current_bsl_open += 1

    if ssl_total > 0
        for i = 0 to ssl_total - 1
            if array.get(sellside_open, i)
                current_ssl_open += 1

    current_tracking_lows = array.size(eligible_low_ticks)
    current_tracking_highs = array.size(eligible_high_ticks)
    current_mode_text = "Mode: " + (auto_htf ? "Auto" : "Manual") + " • Limit: " + get_user_friendly_timeframe(get_max_allowed_htf())
    current_htf_tag = get_htf_tag()


    dashboard_needs_update = (current_bsl_open != cached_bsl_open or current_ssl_open != cached_ssl_open or current_tracking_lows != cached_tracking_lows or current_tracking_highs != cached_tracking_highs or current_mode_text != cached_mode_text or current_htf_tag != cached_htf_tag)

    if dashboard_needs_update
        if not na(htf_dashboard)
            table.delete(htf_dashboard)

        htf_dashboard := table.new(get_table_position(), 1, 4, bgcolor=table_bg_color, border_width=1, border_color=table_border_color)
        table.cell(htf_dashboard, 0, 0, current_htf_tag, text_color=default_text_color, text_size=get_table_text_size())
        table.cell(htf_dashboard, 0, 1, "BSL: " + str.tostring(current_bsl_open), text_color=default_text_color, text_size=get_table_text_size())
        table.cell(htf_dashboard, 0, 2, "SSL: " + str.tostring(current_ssl_open), text_color=default_text_color, text_size=get_table_text_size())
        table.cell(htf_dashboard, 0, 3, "Limit: " + get_user_friendly_timeframe(get_max_allowed_htf()), text_color=default_text_color, text_size=get_table_text_size())

        cached_bsl_open := current_bsl_open
        cached_ssl_open := current_ssl_open
        cached_tracking_lows := current_tracking_lows
        cached_tracking_highs := current_tracking_highs
        cached_mode_text := current_mode_text
        cached_htf_tag := current_htf_tag

// ═══════════════════════════════════════════════════════════════════════════════
// OPTIMIZATION 6: ENHANCED MEMORY CLEANUP - BSL FIRST
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.islast and initialized
    cleanup_max = math.max(100, (open_lines_count + filled_lines_count) * 2)

    // BSL-FIRST CLEANUP (LTF v3.0 PARITY) with enhanced memory management
    while array.size(buyside_failure_bars) > cleanup_max
        cleanup_old_line = array.shift(buyside_lines)
        cleanup_old_label = array.shift(buyside_labels)
        if not na(cleanup_old_line)
            line.delete(cleanup_old_line)
        if not na(cleanup_old_label)
            label.delete(cleanup_old_label)
        array.shift(buyside_failure_bars)
        array.shift(buyside_failure_times)
        array.shift(buyside_targets)
        array.shift(buyside_open)
        array.shift(buyside_fill_bars)
        array.shift(buyside_fill_times)
        array.shift(buyside_wick_times)

    while array.size(sellside_failure_bars) > cleanup_max
        cleanup_old_line = array.shift(sellside_lines)
        cleanup_old_label = array.shift(sellside_labels)
        if not na(cleanup_old_line)
            line.delete(cleanup_old_line)
        if not na(cleanup_old_label)
            label.delete(cleanup_old_label)
        array.shift(sellside_failure_bars)
        array.shift(sellside_failure_times)
        array.shift(sellside_targets)
        array.shift(sellside_open)
        array.shift(sellside_fill_bars)
        array.shift(sellside_fill_times)
        array.shift(sellside_wick_times)


// HTF Algo Draw° [Pro+]