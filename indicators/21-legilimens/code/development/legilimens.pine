outlierTier1SellZoneColor = input.color(color.new(color.rgb(128, 25, 34), 92), "", inline="delta_tier_1_colors", group=GROUP_DELTA_TIERS, active=quickOutlierZones and deltaTierCount >= 5, tooltip="Each color pair is ordered Buy then Sell. Tier 1 is zone-only. Delta marker size is set in Delta: Tiers.")

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — PROFILE APPEARANCE
// ═══════════════════════════════════════════════════════════════════════════════
showHistogram = input.bool(false, "Histogram", inline="appearance_histogram", group=GROUP_APPEARANCE)
histogramWidthPercent = input.int(20, "Width", minval=5, maxval=100, inline="appearance_histogram", group=GROUP_APPEARANCE, active=showHistogram)
histogramColor = input.color(color.new(color.rgb(120, 123, 134), 85), "", inline="appearance_histogram", group=GROUP_APPEARANCE, active=showHistogram, tooltip="Shows the total-volume histogram. This color is used when Color is off.")
useHistogramValueAreaColors = input.bool(true, "Color", inline="appearance_histogram_colors", group=GROUP_APPEARANCE, active=showHistogram)
histogramValueAreaInsideColor = input.color(color.new(color.rgb(187, 217, 251), 75), "Inside", inline="appearance_histogram_colors", group=GROUP_APPEARANCE, active=showHistogram and useHistogramValueAreaColors)
histogramValueAreaOutsideColor = input.color(color.new(color.rgb(184, 184, 184), 80), "Outside", inline="appearance_histogram_colors", group=GROUP_APPEARANCE, active=showHistogram and useHistogramValueAreaColors, tooltip="Color uses separate histogram fills inside and outside the fixed 70% value area.")
showProfileBox = input.bool(false, "Profile Box", inline="appearance_session", group=GROUP_APPEARANCE)
profileBoxColor = input.color(color.new(color.rgb(187, 217, 251), 90), "", inline="appearance_session", group=GROUP_APPEARANCE, tooltip="Shows the profile box background on Rolling and session profiles. Session outlines remain visible when off. Fixed Range is unaffected.")

