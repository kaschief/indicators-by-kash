placementMode = input.string(PLACEMENT_MAIN_CHART, "Placement", options=[PLACEMENT_MAIN_CHART, PLACEMENT_SECONDARY_PANE], group=GROUP_SECONDARY_PANE, tooltip="Main Chart: keep Legilimens on price.\n\nSecondary Pane: keep candle effects local to the indicator pane and disable main-chart candle effects.")
secondaryPaneMode = placementMode == PLACEMENT_SECONDARY_PANE
showPriceCandlesInPane = input.bool(true, "Show Price Candles in Pane", group=GROUP_SECONDARY_PANE, active=secondaryPaneMode, tooltip="Draw the chart's OHLC candles in the indicator pane.")
paneUpBodyColor = input.color(DEFAULT_PANE_UP_BODY_COLOR, "Candles", inline="pane_candles", group=GROUP_SECONDARY_PANE, active=secondaryPaneMode and showPriceCandlesInPane)
paneDownBodyColor = input.color(DEFAULT_PANE_DOWN_BODY_COLOR, "", inline="pane_candles", group=GROUP_SECONDARY_PANE, active=secondaryPaneMode and showPriceCandlesInPane)
paneUpBorderColor = input.color(DEFAULT_PANE_UP_BORDER_COLOR, "", inline="pane_candles", group=GROUP_SECONDARY_PANE, active=secondaryPaneMode and showPriceCandlesInPane)
paneDownBorderColor = input.color(DEFAULT_PANE_DOWN_BORDER_COLOR, "", inline="pane_candles", group=GROUP_SECONDARY_PANE, active=secondaryPaneMode and showPriceCandlesInPane)
paneUpWickColor = input.color(DEFAULT_PANE_WICK_COLOR, "", inline="pane_candles", group=GROUP_SECONDARY_PANE, active=secondaryPaneMode and showPriceCandlesInPane)
paneDownWickColor = input.color(DEFAULT_PANE_WICK_COLOR, "", inline="pane_candles", group=GROUP_SECONDARY_PANE, active=secondaryPaneMode and showPriceCandlesInPane, tooltip="Order: Up Body, Down Body, Up Border, Down Border, Up Wick, Down Wick.")

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — REFERENCE
// ═══════════════════════════════════════════════════════════════════════════════
showColorTable = input.bool(false, "Show Table", group=GROUP_UTILITY, tooltip="Displays every configured color and its associated width.")

fixedModeActive = anchorMode == MODE_FIXED
rollingModeActive = anchorMode == MODE_ROLLING
rangeModeActive = fixedModeActive or rollingModeActive
bool nyEarlyIvbModeSelected = anchorMode == MODE_NY_EARLY_IVB
bool nyIvbChartAllowed = chart.is_range or timeframe.in_seconds(timeframe.period) < NY_IVB_TIMEFRAME_LIMIT_SECONDS
nyEarlyIvbModeActive = nyEarlyIvbModeSelected and nyIvbChartAllowed
nyEarlyModeActive = (anchorMode == MODE_NY_EARLY or nyEarlyIvbModeSelected) and nyIvbChartAllowed
ivbModeActive = (anchorMode == MODE_IVB or nyEarlyIvbModeSelected) and nyIvbChartAllowed
rthModeActive = anchorMode == MODE_RTH
globexModeActive = anchorMode == MODE_GLOBEX
weeklyModeActive = anchorMode == MODE_WEEKLY
monthlyModeActive = anchorMode == MODE_MONTHLY

fixedRangeConfigured = fixedRangeStartInput > FIXED_RANGE_TIME_UNSET and fixedRangeEndInput > FIXED_RANGE_TIME_UNSET and fixedRangeStartInput != fixedRangeEndInput

// ═══════════════════════════════════════════════════════════════════════════════
// TYPES
// ═══════════════════════════════════════════════════════════════════════════════
type DeltaProfile
    int startTime
    int endTime
    float priceLow
    float priceHigh
    float rangeLow
    float rangeHigh
    int rowCount
    array<float> rowVolumes
    array<float> rowDeltas
    float maxRowVolume
    float maxAbsRowDelta
    bool isValid

type PendingOutlierLevel
    float price
    float zoneLow
    float zoneHigh
    float delta
    float strength
    bool buySide
    int leftTime
    int rightTime
    color levelColor
    int rowCount
    string sourceName

type LowVolumeCandidate
    float price
    float zoneLow
    float zoneHigh
    float strength
    bool isLvn

type PendingRightLabel
    float price
    string namePart
    string pricePart
    bool wantPrice
    color textColor
    color bgColor
    string sizeName
    int rank
    int xPos

type PendingRightLine
    float price
    int leftTime
    int rightTime
    color lineColor
    int lineWidth
    string styleName
    int rank
    string sourceName
    bool pocReminder

type ColorRow
    string name
    color swatchColor
    string widthText

// ═══════════════════════════════════════════════════════════════════════════════
// CALCULATION
// ═══════════════════════════════════════════════════════════════════════════════
autoIntrabarTimeframe() =>
    chartSeconds = timeframe.in_seconds(timeframe.period)
    chartSeconds <= 60 ? "1S" : chartSeconds <= 15 * 60 ? "1" : chartSeconds <= 60 * 60 ? "5" : chartSeconds <= 4 * 60 * 60 ? "15" : "60"

clampRow(float rawRow, int rowCount) =>
    math.max(0, math.min(rowCount - 1, int(math.floor(rawRow))))

sameCalendarDate(int firstTime, int secondTime, string timezone) =>
    year(firstTime, timezone) == year(secondTime, timezone) and month(firstTime, timezone) == month(secondTime, timezone) and dayofmonth(firstTime, timezone) == dayofmonth(secondTime, timezone)

toLineStyle(string styleName) =>
    styleName == STYLE_DASHED ? line.style_dashed : styleName == STYLE_DOTTED ? line.style_dotted : line.style_solid

toLabelSize(string sizeName) =>
    sizeName == LABEL_SIZE_TINY ? size.tiny : sizeName == LABEL_SIZE_NORMAL ? size.normal : sizeName == LABEL_SIZE_LARGE ? size.large : sizeName == LABEL_SIZE_HUGE ? size.huge : size.small

labelSizeRank(string sizeName) =>
    sizeName == LABEL_SIZE_TINY ? 0 : sizeName == LABEL_SIZE_SMALL ? 1 : sizeName == LABEL_SIZE_NORMAL ? 2 : sizeName == LABEL_SIZE_LARGE ? 3 : 4

largerLabelSize(string firstSize, string secondSize) =>
    labelSizeRank(firstSize) >= labelSizeRank(secondSize) ? firstSize : secondSize

formatLevelText(string name, float price, bool showPrice) =>
    showPrice ? name + " " + BRAND_BULLET + " " + str.tostring(price, format.mintick) : name

quarterDurationValue(float duration) =>
    duration > 0 ? math.max(0.25, math.round(duration * 4.0) / 4.0) : 0.0

formatQuarterDuration(float duration) =>
    str.tostring(quarterDurationValue(duration), "#.##")

formatFixedRangeDuration(int firstTime, int secondTime) =>
    int durationMs = math.abs(secondTime - firstTime)
    float durationMinutes = float(durationMs) / MS_PER_MINUTE
    float durationHours = float(durationMs) / MS_PER_HOUR
    float durationDays = durationHours / 24.0
    float roundedMinutes = quarterDurationValue(durationMinutes)
    float roundedHours = quarterDurationValue(durationHours)
    string durationTag = ""
    if roundedHours >= 24.0
        durationTag := formatQuarterDuration(durationDays) + "-Day"
    else if durationHours >= 1.0 or roundedMinutes >= 60.0
        durationTag := formatQuarterDuration(durationHours) + "-Hour"
    else
        durationTag := formatQuarterDuration(durationMinutes) + "-Minute"
    durationTag

activeAnchorName() =>
    anchorMode == MODE_ROLLING ? "Rolling" : anchorMode == MODE_NY_EARLY ? "NY Early" : anchorMode == MODE_IVB ? "IVB" : anchorMode == MODE_NY_EARLY_IVB ? "NY Early + IVB" : anchorMode == MODE_RTH ? "RTH" : anchorMode == MODE_GLOBEX ? "Globex" : anchorMode == MODE_WEEKLY ? "Weekly" : anchorMode == MODE_MONTHLY ? "Monthly" : "Fixed"

isTrueWeekendBar(int barTime) =>
    int barDay = dayofweek(barTime, NY_TIMEZONE)
    int barHour = hour(barTime, NY_TIMEZONE)
    barDay == dayofweek.saturday or (barDay == dayofweek.sunday and barHour < SUNDAY_REOPEN_START_HOUR)

calendarDayStart(string timezone) =>
    ta.change(dayofmonth(time, timezone)) != 0

shiftedCalendarDayStart(string timezone, int timeShiftMilliseconds) =>
    ta.change(dayofmonth(time + timeShiftMilliseconds, timezone)) != 0

shiftedCalendarMonthStart(string timezone, int timeShiftMilliseconds) =>
    ta.change(month(time + timeShiftMilliseconds, timezone)) != 0

weeklyBoundary(bool twentyFourSeven, bool utcBoundary, bool futuresBoundary, int barTime) =>
    twentyFourSeven ? utcBoundary and dayofweek(barTime, UTC_TIMEZONE) == dayofweek.monday : futuresBoundary and dayofweek(barTime, NY_TIMEZONE) == dayofweek.sunday

isNyWeekday(int barTime) =>
    int weekday = dayofweek(barTime, NY_TIMEZONE)
    weekday >= dayofweek.monday and weekday <= dayofweek.friday

inNyMinuteWindow(int barTime, int startMinute, int endMinute) =>
    int barMinute = hour(barTime, NY_TIMEZONE) * 60 + minute(barTime, NY_TIMEZONE)
    barMinute >= startMinute and barMinute < endMinute

nyMinuteBoundary(int referenceTime, int minuteOfDay) =>
    timestamp(NY_TIMEZONE, year(referenceTime, NY_TIMEZONE), month(referenceTime, NY_TIMEZONE), dayofmonth(referenceTime, NY_TIMEZONE), int(math.floor(minuteOfDay / 60)), minuteOfDay % 60)

previousNyCutoff(int cutoffTime, int cutoffHour, int cutoffMinute) =>
    int previousDateReference = cutoffTime - MS_PER_DAY
    timestamp(NY_TIMEZONE, year(previousDateReference, NY_TIMEZONE), month(previousDateReference, NY_TIMEZONE), dayofmonth(previousDateReference, NY_TIMEZONE), cutoffHour, cutoffMinute)

// Steps whole New York calendar days so the lookback holds its clock time across DST changes.
lookbackDaysStart(int endTime, int days, bool twentyFourSeven) =>
    int startTime = endTime
    int countedDays = 0
    if not na(endTime)
        int anchorHour = hour(endTime, NY_TIMEZONE)
        int anchorMinute = minute(endTime, NY_TIMEZONE)
        while countedDays < days
            startTime := previousNyCutoff(startTime, anchorHour, anchorMinute)
            int startDay = dayofweek(startTime, NY_TIMEZONE)
            if twentyFourSeven or (startDay != dayofweek.saturday and startDay != dayofweek.sunday)
                countedDays += 1
    startTime

rollingThroughTime(int referenceTime, string throughMode, bool twentyFourSeven) =>
    int endTime = referenceTime
    if (throughMode == ROLLING_THROUGH_LIVE_MINUS_2H or throughMode == ROLLING_THROUGH_LIVE_MINUS_4H) and not na(referenceTime)
        int liveOffsetHours = throughMode == ROLLING_THROUGH_LIVE_MINUS_2H ? 2 : 4
        endTime := referenceTime - liveOffsetHours * MS_PER_HOUR
    else if throughMode != ROLLING_THROUGH_LIVE and not na(referenceTime)
        int cutoffHour = throughMode == ROLLING_THROUGH_0000 ? 0 : throughMode == ROLLING_THROUGH_0500 ? 5 : throughMode == ROLLING_THROUGH_0830 ? 8 : throughMode == ROLLING_THROUGH_0930 ? 9 : 16
        int cutoffMinute = throughMode == ROLLING_THROUGH_0830 or throughMode == ROLLING_THROUGH_0930 ? 30 : 0
        endTime := timestamp(NY_TIMEZONE, year(referenceTime, NY_TIMEZONE), month(referenceTime, NY_TIMEZONE), dayofmonth(referenceTime, NY_TIMEZONE), cutoffHour, cutoffMinute)
        if endTime > referenceTime
            endTime := previousNyCutoff(endTime, cutoffHour, cutoffMinute)
        if not twentyFourSeven
            int cutoffDay = dayofweek(endTime, NY_TIMEZONE)
            while cutoffDay == dayofweek.saturday or cutoffDay == dayofweek.sunday
                endTime := previousNyCutoff(endTime, cutoffHour, cutoffMinute)
                cutoffDay := dayofweek(endTime, NY_TIMEZONE)
    endTime

formatMagnitude(float magnitude) =>
    magnitude >= 1e9 ? str.tostring(magnitude / 1e9, "#.#") + "B" : magnitude >= 1e6 ? str.tostring(magnitude / 1e6, "#.#") + "M" : magnitude >= 1e3 ? str.tostring(magnitude / 1e3, "#.#") + "K" : str.tostring(magnitude, "#.##")

formatDelta(float value) =>
    (value < 0 ? "−" : "+") + formatMagnitude(math.abs(value))

// Compaction bounds memory while retaining finer bins than the display grid.
compactSamples(array<float> highs, array<float> lows, array<float> volumes, array<float> deltas) =>
    int sampleCount = array.size(volumes)
    if sampleCount > 0
        float rawHigh = array.max(highs)
        float rawLow = array.min(lows)
        float priceSpan = math.max(rawHigh - rawLow, syminfo.mintick * SAMPLE_COMPACT_ROWS)
        float compactLow = rawHigh == rawLow ? rawLow - priceSpan * 0.5 : rawLow
        float rowHeight = priceSpan / SAMPLE_COMPACT_ROWS
        array<float> rowVolumes = array.new<float>(SAMPLE_COMPACT_ROWS, 0.0)
        array<float> rowDeltas = array.new<float>(SAMPLE_COMPACT_ROWS, 0.0)
        for sampleIndex = 0 to sampleCount - 1
            float sampleHigh = array.get(highs, sampleIndex)
            float sampleLow = array.get(lows, sampleIndex)
            float sampleVolume = array.get(volumes, sampleIndex)
            float sampleDelta = array.get(deltas, sampleIndex)
            int firstRow = clampRow((sampleLow - compactLow) / rowHeight, SAMPLE_COMPACT_ROWS)
            int lastRow = clampRow((sampleHigh - compactLow) / rowHeight, SAMPLE_COMPACT_ROWS)
            int rowsTouched = math.max(1, lastRow - firstRow + 1)
            float volumePerRow = sampleVolume / rowsTouched
            float deltaPerRow = sampleDelta / rowsTouched
            for rowIndex = firstRow to lastRow
                array.set(rowVolumes, rowIndex, array.get(rowVolumes, rowIndex) + volumePerRow)
                array.set(rowDeltas, rowIndex, array.get(rowDeltas, rowIndex) + deltaPerRow)
        array.clear(highs)
        array.clear(lows)
        array.clear(volumes)
        array.clear(deltas)
        for rowIndex = 0 to SAMPLE_COMPACT_ROWS - 1
            float rowVolume = array.get(rowVolumes, rowIndex)
            if rowVolume > 0
                float rowPrice = compactLow + (rowIndex + 0.5) * rowHeight
                array.push(highs, rowPrice)
                array.push(lows, rowPrice)
                array.push(volumes, rowVolume)
                array.push(deltas, array.get(rowDeltas, rowIndex))

compactIfNeeded(array<float> highs, array<float> lows, array<float> volumes, array<float> deltas) =>
    if array.size(volumes) > SAMPLE_COMPACT_THRESHOLD
        compactSamples(highs, lows, volumes, deltas)

appendSamples(array<float> destHighs, array<float> destLows, array<float> destVolumes, array<float> destDeltas, array<float> sourceHighs, array<float> sourceLows, array<float> sourceVolumes, array<float> sourceDeltas, bool compactAfter) =>
    int sampleCount = array.size(sourceVolumes)
    if sampleCount > 0
        for sampleIndex = 0 to sampleCount - 1
            array.push(destHighs, array.get(sourceHighs, sampleIndex))
            array.push(destLows, array.get(sourceLows, sampleIndex))
            array.push(destVolumes, array.get(sourceVolumes, sampleIndex))
            array.push(destDeltas, array.get(sourceDeltas, sampleIndex))
    if compactAfter
        compactIfNeeded(destHighs, destLows, destVolumes, destDeltas)

appendBarSample(array<float> highs, array<float> lows, array<float> volumes, array<float> deltas, float sampleHigh, float sampleLow, float sampleVolume, float sampleDelta) =>
    array.push(highs, sampleHigh)
    array.push(lows, sampleLow)
    array.push(volumes, sampleVolume)
    array.push(deltas, sampleDelta)

// Packs the New York date and cutoff segment into one integer so compaction compares keys, not timestamps.
rollingSegmentKey(int sampleTime) =>
    int nyMinutes = hour(sampleTime, NY_TIMEZONE) * 60 + minute(sampleTime, NY_TIMEZONE)
    int segment = nyMinutes < 5 * 60 ? 0 : nyMinutes < 8 * 60 + 30 ? 1 : nyMinutes < 9 * 60 + 30 ? 2 : nyMinutes < 16 * 60 ? 3 : 4
    (year(sampleTime, NY_TIMEZONE) * 10000 + month(sampleTime, NY_TIMEZONE) * 100 + dayofmonth(sampleTime, NY_TIMEZONE)) * 10 + segment

compactRollingSamples(array<int> startKeys, array<int> endKeys, array<int> startTimes, array<int> endTimes, array<float> highs, array<float> lows, array<float> volumes, array<float> deltas) =>
    int sampleCount = array.size(volumes)
    if sampleCount > ROLLING_SAMPLE_COMPACT_THRESHOLD
        int writeIndex = 0
        int readIndex = 0
        while readIndex < sampleCount
            int nextIndex = readIndex + 1
            bool mergeNext = nextIndex < sampleCount and array.get(endKeys, readIndex) == array.get(startKeys, nextIndex)
            array.set(startKeys, writeIndex, array.get(startKeys, readIndex))
            array.set(endKeys, writeIndex, mergeNext ? array.get(endKeys, nextIndex) : array.get(endKeys, readIndex))
            array.set(startTimes, writeIndex, array.get(startTimes, readIndex))
            array.set(endTimes, writeIndex, mergeNext ? array.get(endTimes, nextIndex) : array.get(endTimes, readIndex))
            array.set(highs, writeIndex, mergeNext ? math.max(array.get(highs, readIndex), array.get(highs, nextIndex)) : array.get(highs, readIndex))
            array.set(lows, writeIndex, mergeNext ? math.min(array.get(lows, readIndex), array.get(lows, nextIndex)) : array.get(lows, readIndex))
            array.set(volumes, writeIndex, array.get(volumes, readIndex) + (mergeNext ? array.get(volumes, nextIndex) : 0.0))
            array.set(deltas, writeIndex, array.get(deltas, readIndex) + (mergeNext ? array.get(deltas, nextIndex) : 0.0))
            writeIndex += 1
            readIndex += mergeNext ? 2 : 1
        while array.size(volumes) > writeIndex
            array.pop(startKeys)
            array.pop(endKeys)
            array.pop(startTimes)
            array.pop(endTimes)
            array.pop(highs)
            array.pop(lows)
            array.pop(volumes)
            array.pop(deltas)

appendRollingSamples(array<int> destStartKeys, array<int> destEndKeys, array<int> destStartTimes, array<int> destEndTimes, array<float> destHighs, array<float> destLows, array<float> destVolumes, array<float> destDeltas, int sampleTime, array<float> sourceHighs, array<float> sourceLows, array<float> sourceVolumes, array<float> sourceDeltas, bool compactAfter) =>
    int sampleCount = array.size(sourceVolumes)
    if sampleCount > 0
        // Every sample from this bar shares its timestamp, so the key is derived once.
        int sampleKey = rollingSegmentKey(sampleTime)
        for sampleIndex = 0 to sampleCount - 1
            array.push(destStartKeys, sampleKey)
            array.push(destEndKeys, sampleKey)
            array.push(destStartTimes, sampleTime)
            array.push(destEndTimes, sampleTime)
            array.push(destHighs, array.get(sourceHighs, sampleIndex))
            array.push(destLows, array.get(sourceLows, sampleIndex))
            array.push(destVolumes, array.get(sourceVolumes, sampleIndex))
            array.push(destDeltas, array.get(sourceDeltas, sampleIndex))
    if compactAfter
        compactRollingSamples(destStartKeys, destEndKeys, destStartTimes, destEndTimes, destHighs, destLows, destVolumes, destDeltas)

pruneRollingSamples(array<int> startKeys, array<int> endKeys, array<int> startTimes, array<int> endTimes, array<float> highs, array<float> lows, array<float> volumes, array<float> deltas, int cutoffTime) =>
    while array.size(volumes) > 0 and array.get(endTimes, 0) < cutoffTime
        array.shift(startKeys)
        array.shift(endKeys)
        array.shift(startTimes)
        array.shift(endTimes)
        array.shift(highs)
        array.shift(lows)
        array.shift(volumes)
        array.shift(deltas)

// Prefer one-tick rows; wider ranges must use evenly sized bins.
buildDeltaProfile(array<float> highs, array<float> lows, array<float> volumes, array<float> deltas, int requestedRows, int startTime, int endTime) =>
    int sampleCount = array.size(volumes)
    float tickSize = syminfo.mintick
    float rawHigh = sampleCount > 0 ? array.max(highs) : na
    float rawLow = sampleCount > 0 ? array.min(lows) : na
    int tickRows = sampleCount > 0 ? int(math.round((rawHigh - rawLow) / tickSize)) + 1 : 0
    bool tickGranular = tickRows >= 1 and tickRows <= requestedRows
    int rowCount = tickGranular ? tickRows : requestedRows
    DeltaProfile profile = DeltaProfile.new(startTime, endTime, na, na, rawLow, rawHigh, rowCount, array.new<float>(rowCount, 0.0), array.new<float>(rowCount, 0.0), 0.0, 0.0, false)
    if sampleCount > 0
        float profileLow = na
        float priceSpan = na
        float rowHeight = na
        if tickGranular
            profileLow := math.round(rawLow / tickSize) * tickSize - tickSize * 0.5
            priceSpan := rowCount * tickSize
            rowHeight := tickSize
        else
            priceSpan := math.max(rawHigh - rawLow, tickSize * rowCount)
            profileLow := rawHigh == rawLow ? rawLow - priceSpan * 0.5 : rawLow
            rowHeight := priceSpan / rowCount

        for sampleIndex = 0 to sampleCount - 1
            float sampleHigh = array.get(highs, sampleIndex)
            float sampleLow = array.get(lows, sampleIndex)
            float sampleVolume = array.get(volumes, sampleIndex)
            float sampleDelta = array.get(deltas, sampleIndex)
            int firstRow = clampRow((sampleLow - profileLow) / rowHeight, rowCount)
            int lastRow = clampRow((sampleHigh - profileLow) / rowHeight, rowCount)
            int rowsTouched = math.max(1, lastRow - firstRow + 1)
            float volumePerRow = sampleVolume / rowsTouched
            float deltaPerRow = sampleDelta / rowsTouched
            for rowIndex = firstRow to lastRow
                array.set(profile.rowVolumes, rowIndex, array.get(profile.rowVolumes, rowIndex) + volumePerRow)
                array.set(profile.rowDeltas, rowIndex, array.get(profile.rowDeltas, rowIndex) + deltaPerRow)

        float totalVolume = 0.0
        float maxRowVolume = 0.0
        float maxAbsRowDelta = 0.0
        for rowIndex = 0 to rowCount - 1
            float rowVolume = array.get(profile.rowVolumes, rowIndex)
            float rowDelta = array.get(profile.rowDeltas, rowIndex)
            totalVolume += rowVolume
            if rowVolume > 0
                maxRowVolume := math.max(maxRowVolume, rowVolume)
                maxAbsRowDelta := math.max(maxAbsRowDelta, math.abs(rowDelta))

        profile.priceLow := profileLow
        profile.priceHigh := profileLow + priceSpan
        profile.maxRowVolume := maxRowVolume
        profile.maxAbsRowDelta := maxAbsRowDelta
        profile.isValid := totalVolume > 0
    profile

buildRollingDeltaProfile(array<int> sampleStartTimes, array<int> sampleEndTimes, array<float> highs, array<float> lows, array<float> volumes, array<float> deltas, int requestedRows, int startTime, int endTime, bool includeEnd) =>
    array<float> selectedHighs = array.new<float>()
    array<float> selectedLows = array.new<float>()
    array<float> selectedVolumes = array.new<float>()
    array<float> selectedDeltas = array.new<float>()
    int sampleCount = array.size(volumes)
    if sampleCount > 0
        for sampleIndex = 0 to sampleCount - 1
            bool beginsBeforeEnd = includeEnd ? array.get(sampleStartTimes, sampleIndex) <= endTime : array.get(sampleStartTimes, sampleIndex) < endTime
            if array.get(sampleEndTimes, sampleIndex) >= startTime and beginsBeforeEnd
                array.push(selectedHighs, array.get(highs, sampleIndex))
                array.push(selectedLows, array.get(lows, sampleIndex))
                array.push(selectedVolumes, array.get(volumes, sampleIndex))
                array.push(selectedDeltas, array.get(deltas, sampleIndex))
    buildDeltaProfile(selectedHighs, selectedLows, selectedVolumes, selectedDeltas, requestedRows, startTime, endTime)

buildDevelopingDeltaProfile(array<float> barHighs, array<float> barLows, array<float> barVolumes, array<float> barDeltas, array<int> startRef, array<float> sampleHighs, array<float> sampleLows, array<float> sampleVolumes, array<float> sampleDeltas, int endTime) =>
    int originalSize = array.size(barVolumes)
    if not barstate.isconfirmed
        appendSamples(barHighs, barLows, barVolumes, barDeltas, sampleHighs, sampleLows, sampleVolumes, sampleDeltas, false)
    DeltaProfile profile = buildDeltaProfile(barHighs, barLows, barVolumes, barDeltas, PROFILE_ROWS, array.get(startRef, 0), endTime)
    while array.size(barVolumes) > originalSize
        array.pop(barHighs)
        array.pop(barLows)
        array.pop(barVolumes)
        array.pop(barDeltas)
    profile

// Expand from POC through the heavier adjacent row to match Revelio's value area.
profileValueLevels(DeltaProfile profile) =>
    int pocRow = 0
    float pocVolume = -1.0
    float totalVolume = 0.0
    for rowIndex = 0 to profile.rowCount - 1
        float rowVolume = array.get(profile.rowVolumes, rowIndex)
        totalVolume += rowVolume
        if rowVolume > pocVolume
            pocVolume := rowVolume
            pocRow := rowIndex
    int valueAreaLowRow = pocRow
    int valueAreaHighRow = pocRow
    float accumulatedVolume = math.max(0.0, pocVolume)
    float targetVolume = totalVolume * valueAreaPercent * 0.01
    while accumulatedVolume < targetVolume and (valueAreaLowRow > 0 or valueAreaHighRow < profile.rowCount - 1)
        float volumeBelow = valueAreaLowRow > 0 ? array.get(profile.rowVolumes, valueAreaLowRow - 1) : -1.0
        float volumeAbove = valueAreaHighRow < profile.rowCount - 1 ? array.get(profile.rowVolumes, valueAreaHighRow + 1) : -1.0
        if volumeAbove >= volumeBelow
            valueAreaHighRow += 1
            accumulatedVolume += math.max(0.0, volumeAbove)
        else
            valueAreaLowRow -= 1
            accumulatedVolume += math.max(0.0, volumeBelow)
    float rowHeight = (profile.priceHigh - profile.priceLow) / profile.rowCount
    float pocPrice = profile.priceLow + (pocRow + 0.5) * rowHeight
    float valueAreaHighPrice = profile.priceLow + (valueAreaHighRow + 1) * rowHeight
    float valueAreaLowPrice = profile.priceLow + valueAreaLowRow * rowHeight
    [pocRow, valueAreaLowRow, valueAreaHighRow, pocPrice, valueAreaLowPrice, valueAreaHighPrice]

// ═══════════════════════════════════════════════════════════════════════════════
// ANCHOR ENGINE
// ═══════════════════════════════════════════════════════════════════════════════
finalizePeriod(array<float> barHighs, array<float> barLows, array<float> barVolumes, array<float> barDeltas, int startTime, int endTime, int keepProfiles, array<DeltaProfile> profiles) =>
    if array.size(barVolumes) > 0
        DeltaProfile profile = buildDeltaProfile(barHighs, barLows, barVolumes, barDeltas, PROFILE_ROWS, startTime, endTime)
        if profile.isValid
            array.push(profiles, profile)
            while array.size(profiles) > keepProfiles
                array.shift(profiles)
        array.clear(barHighs)
        array.clear(barLows)
        array.clear(barVolumes)
        array.clear(barDeltas)

processAnchor(bool enabled, int keepProfiles, bool inWindow, bool periodStart, bool periodEnd, array<float> barHighs, array<float> barLows, array<float> barVolumes, array<float> barDeltas, array<DeltaProfile> profiles, array<int> periodStartRef, array<int> periodLastBarRef, array<float> sampleHighs, array<float> sampleLows, array<float> sampleVolumes, array<float> sampleDeltas, bool continuousBoundary) =>
    if enabled
        bool shouldStart = periodStart or (array.get(periodStartRef, 0) == START_TIME_UNSET and inWindow)

        if periodEnd and array.size(barVolumes) > 0
            // Avoid stretching early-close profiles across the post-session gap.
            finalizePeriod(barHighs, barLows, barVolumes, barDeltas, array.get(periodStartRef, 0), array.get(periodLastBarRef, 0), keepProfiles, profiles)

        if shouldStart
            if array.size(barVolumes) > 0
                int boundaryEnd = continuousBoundary ? time : time[1]
                finalizePeriod(barHighs, barLows, barVolumes, barDeltas, array.get(periodStartRef, 0), boundaryEnd, keepProfiles, profiles)
            array.set(periodStartRef, 0, time)

        if inWindow and barstate.isconfirmed
            appendSamples(barHighs, barLows, barVolumes, barDeltas, sampleHighs, sampleLows, sampleVolumes, sampleDeltas, true)
            array.set(periodLastBarRef, 0, time)

processBoundedNyAnchor(bool enabled, int keepProfiles, int startMinute, int endMinute, bool inWindow, bool periodStart, bool periodEnd, int firstSampleTime, int lastSampleEndTime, array<float> barHighs, array<float> barLows, array<float> barVolumes, array<float> barDeltas, array<DeltaProfile> profiles, array<int> periodStartRef, array<int> periodLastBarRef, array<float> sampleHighs, array<float> sampleLows, array<float> sampleVolumes, array<float> sampleDeltas) =>
    if enabled
        if periodEnd and array.size(barVolumes) > 0
            int completedEndTime = nyMinuteBoundary(array.get(periodStartRef, 0), endMinute)
            finalizePeriod(barHighs, barLows, barVolumes, barDeltas, array.get(periodStartRef, 0), completedEndTime, keepProfiles, profiles)

        bool shouldStart = periodStart or (array.get(periodStartRef, 0) == START_TIME_UNSET and inWindow)
        if shouldStart
            if array.size(barVolumes) > 0
                int previousEndTime = nyMinuteBoundary(array.get(periodStartRef, 0), endMinute)
                finalizePeriod(barHighs, barLows, barVolumes, barDeltas, array.get(periodStartRef, 0), previousEndTime, keepProfiles, profiles)
            array.set(periodStartRef, 0, nyMinuteBoundary(firstSampleTime, startMinute))

        if inWindow and barstate.isconfirmed
            appendSamples(barHighs, barLows, barVolumes, barDeltas, sampleHighs, sampleLows, sampleVolumes, sampleDeltas, true)
            int sessionEndTime = nyMinuteBoundary(array.get(periodStartRef, 0), endMinute)
            array.set(periodLastBarRef, 0, math.min(lastSampleEndTime, sessionEndTime))

// ═══════════════════════════════════════════════════════════════════════════════
// RENDERING
// ═══════════════════════════════════════════════════════════════════════════════
var array<box> drawnBoxes = array.new<box>()
var array<line> drawnLines = array.new<line>()
var array<linefill> drawnLineFills = array.new<linefill>()
var array<polyline> drawnPolylines = array.new<polyline>()
var array<label> drawnLabels = array.new<label>()
var array<PendingOutlierLevel> pendingOutlierLevels = array.new<PendingOutlierLevel>()
var array<PendingRightLabel> pendingRightLabels = array.new<PendingRightLabel>()
var array<PendingRightLine> pendingRightLines = array.new<PendingRightLine>()
var table colorTable = na
// The chart-time scale only changes when a new bar opens, not on realtime ticks.
var array<int> cachedChartTimes = array.new<int>()
var int chartTimesBuiltAtBar = -1

clearDrawings() =>
    if array.size(drawnBoxes) > 0
        for boxIndex = 0 to array.size(drawnBoxes) - 1
            box.delete(array.get(drawnBoxes, boxIndex))
        array.clear(drawnBoxes)
    if array.size(drawnLineFills) > 0
        for fillIndex = 0 to array.size(drawnLineFills) - 1
            linefill.delete(array.get(drawnLineFills, fillIndex))
        array.clear(drawnLineFills)
    if array.size(drawnLines) > 0
        for lineIndex = 0 to array.size(drawnLines) - 1
            line.delete(array.get(drawnLines, lineIndex))
        array.clear(drawnLines)
    if array.size(drawnPolylines) > 0
        for polylineIndex = 0 to array.size(drawnPolylines) - 1
            polyline.delete(array.get(drawnPolylines, polylineIndex))
        array.clear(drawnPolylines)
    if array.size(drawnLabels) > 0
        for labelIndex = 0 to array.size(drawnLabels) - 1
            label.delete(array.get(drawnLabels, labelIndex))
        array.clear(drawnLabels)
    array.clear(pendingOutlierLevels)
    array.clear(pendingRightLabels)
    array.clear(pendingRightLines)

queueRightLabel(float price, string namePart, bool showPrice, color textColor, string sizeName, int rank) =>
    array.push(pendingRightLabels, PendingRightLabel.new(price, namePart, str.tostring(price, format.mintick), showPrice, textColor, levelLabelBgColor, sizeName, rank, bar_index + levelLabelOffset))

queueRightLine(float price, int leftTime, int rightTime, color lineColor, int lineWidth, string styleName, int rank, string sourceName, bool pocReminder) =>
    array.push(pendingRightLines, PendingRightLine.new(price, leftTime, rightTime, lineColor, lineWidth, styleName, rank, sourceName, pocReminder))

renderZoneFill(int leftTime, int rightTime, float zoneLow, float zoneHigh, color zoneColor) =>
    color hiddenBoundaryColor = color.new(zoneColor, 100)
    line lowerBoundary = line.new(leftTime, zoneLow, rightTime, zoneLow, xloc=xloc.bar_time, extend=extend.right, color=hiddenBoundaryColor)
    line upperBoundary = line.new(leftTime, zoneHigh, rightTime, zoneHigh, xloc=xloc.bar_time, extend=extend.right, color=hiddenBoundaryColor)
    array.push(drawnLines, lowerBoundary)
    array.push(drawnLines, upperBoundary)
    array.push(drawnLineFills, linefill.new(lowerBoundary, upperBoundary, color.new(zoneColor, ZONE_FILL_TRANSPARENCY)))

reminderPlacements(int runMs, int spacingMs, int maxCount) =>
    math.min(maxCount, math.max(1, int(math.floor(math.sqrt(float(runMs) / math.max(1, spacingMs))))))

renderPocReminderLabels(float price, int leftTime, string sourceName) =>
    int runMs = time - leftTime
    if runMs > 0
        int reminderCount = reminderPlacements(runMs, POC_REMINDER_BASE_MS, POC_REMINDER_MAX_PER_LINE)
        for reminderIndex = 1 to reminderCount
            int reminderTime = leftTime + int(runMs * (reminderIndex - 0.5) / reminderCount)
            array.push(drawnLabels, label.new(reminderTime, price, sourceName + " POC", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_center, textcolor=pocLabelColor, size=toLabelSize(pocLabelSize), color=levelLabelBgColor))

flushPendingRightLines(bool merge) =>
    int pendingCount = array.size(pendingRightLines)
    if pendingCount > 0
        array<float> clusterPrices = array.new<float>()
        array<int> clusterLeftTimes = array.new<int>()
        array<int> clusterRightTimes = array.new<int>()
        array<color> clusterColors = array.new<color>()
        array<int> clusterWidths = array.new<int>()
        array<string> clusterStyles = array.new<string>()
        array<int> clusterRanks = array.new<int>()
        array<string> clusterSourceNames = array.new<string>()
        array<bool> clusterPocReminders = array.new<bool>()
        for pendingIndex = 0 to pendingCount - 1
            PendingRightLine pending = array.get(pendingRightLines, pendingIndex)
            float tolerance = math.max(syminfo.mintick, math.abs(pending.price) * mergeDistancePercent / 100.0)
            int foundIndex = -1
            float minimumDistance = tolerance + syminfo.mintick
            if merge and array.size(clusterPrices) > 0
                for clusterIndex = 0 to array.size(clusterPrices) - 1
                    float distance = math.abs(array.get(clusterPrices, clusterIndex) - pending.price)
                    bool sameSource = array.get(clusterSourceNames, clusterIndex) == pending.sourceName
                    if sameSource and distance <= tolerance and distance < minimumDistance
                        minimumDistance := distance
                        foundIndex := clusterIndex
            if foundIndex >= 0
                array.set(clusterLeftTimes, foundIndex, math.min(array.get(clusterLeftTimes, foundIndex), pending.leftTime))
                array.set(clusterRightTimes, foundIndex, math.max(array.get(clusterRightTimes, foundIndex), pending.rightTime))
                array.set(clusterPocReminders, foundIndex, array.get(clusterPocReminders, foundIndex) or pending.pocReminder)
                if pending.rank > array.get(clusterRanks, foundIndex)
                    array.set(clusterPrices, foundIndex, pending.price)
                    array.set(clusterColors, foundIndex, pending.lineColor)
                    array.set(clusterWidths, foundIndex, pending.lineWidth)
                    array.set(clusterStyles, foundIndex, pending.styleName)
                    array.set(clusterRanks, foundIndex, pending.rank)
            else
                array.push(clusterPrices, pending.price)
                array.push(clusterLeftTimes, pending.leftTime)
                array.push(clusterRightTimes, pending.rightTime)
                array.push(clusterColors, pending.lineColor)
                array.push(clusterWidths, pending.lineWidth)
                array.push(clusterStyles, pending.styleName)
                array.push(clusterRanks, pending.rank)
                array.push(clusterSourceNames, pending.sourceName)
                array.push(clusterPocReminders, pending.pocReminder)
        for clusterIndex = 0 to array.size(clusterPrices) - 1
            array.push(drawnLines, line.new(array.get(clusterLeftTimes, clusterIndex), array.get(clusterPrices, clusterIndex), array.get(clusterRightTimes, clusterIndex), array.get(clusterPrices, clusterIndex), xloc=xloc.bar_time, extend=extend.right, color=array.get(clusterColors, clusterIndex), style=toLineStyle(array.get(clusterStyles, clusterIndex)), width=array.get(clusterWidths, clusterIndex)))
            if showPocReminders and showLevelTags and array.get(clusterPocReminders, clusterIndex)
                renderPocReminderLabels(array.get(clusterPrices, clusterIndex), array.get(clusterLeftTimes, clusterIndex), array.get(clusterSourceNames, clusterIndex))
        array.clear(pendingRightLines)

flushPendingRightLabels(bool dedupe) =>
    int pendingCount = array.size(pendingRightLabels)
    if pendingCount > 0
        array<float> clusterPrices = array.new<float>()
        array<string> clusterNames = array.new<string>()
        array<bool> clusterWantPrices = array.new<bool>()
        array<string> clusterPriceTexts = array.new<string>()
        array<color> clusterTextColors = array.new<color>()
        array<color> clusterBgColors = array.new<color>()
        array<string> clusterSizes = array.new<string>()
        array<int> clusterRanks = array.new<int>()
        array<int> clusterXPositions = array.new<int>()
        for pendingIndex = 0 to pendingCount - 1
            PendingRightLabel pending = array.get(pendingRightLabels, pendingIndex)
            float tolerance = math.max(syminfo.mintick, math.abs(pending.price) * mergeDistancePercent / 100.0)
            int foundIndex = -1
            float minimumDistance = tolerance + syminfo.mintick
            if dedupe and array.size(clusterPrices) > 0
                for clusterIndex = 0 to array.size(clusterPrices) - 1
                    float distance = math.abs(array.get(clusterPrices, clusterIndex) - pending.price)
                    if distance <= tolerance and distance < minimumDistance
                        minimumDistance := distance
                        foundIndex := clusterIndex
            if foundIndex >= 0
                string existingNames = array.get(clusterNames, foundIndex)
                string paddedExistingNames = LABEL_NAME_SEPARATOR + existingNames + LABEL_NAME_SEPARATOR
                string paddedPendingName = LABEL_NAME_SEPARATOR + pending.namePart + LABEL_NAME_SEPARATOR
                if pending.namePart != "" and not str.contains(paddedExistingNames, paddedPendingName)
                    array.set(clusterNames, foundIndex, existingNames == "" ? pending.namePart : existingNames + LABEL_NAME_SEPARATOR + pending.namePart)
                array.set(clusterWantPrices, foundIndex, array.get(clusterWantPrices, foundIndex) or pending.wantPrice)
                array.set(clusterSizes, foundIndex, largerLabelSize(array.get(clusterSizes, foundIndex), pending.sizeName))
                if pending.rank > array.get(clusterRanks, foundIndex)
                    array.set(clusterPrices, foundIndex, pending.price)
                    array.set(clusterPriceTexts, foundIndex, pending.pricePart)
                    array.set(clusterTextColors, foundIndex, pending.textColor)
                    array.set(clusterBgColors, foundIndex, pending.bgColor)
                    array.set(clusterRanks, foundIndex, pending.rank)
                    array.set(clusterXPositions, foundIndex, pending.xPos)
            else
                array.push(clusterPrices, pending.price)
                array.push(clusterNames, pending.namePart)
                array.push(clusterWantPrices, pending.wantPrice)
                array.push(clusterPriceTexts, pending.pricePart)
                array.push(clusterTextColors, pending.textColor)
                array.push(clusterBgColors, pending.bgColor)
                array.push(clusterSizes, pending.sizeName)
                array.push(clusterRanks, pending.rank)
                array.push(clusterXPositions, pending.xPos)
        for clusterIndex = 0 to array.size(clusterPrices) - 1
            string body = array.get(clusterNames, clusterIndex)
            string finalText = array.get(clusterWantPrices, clusterIndex) ? (body == "" ? array.get(clusterPriceTexts, clusterIndex) : body + " " + BRAND_BULLET + " " + array.get(clusterPriceTexts, clusterIndex)) : body
            array.push(drawnLabels, label.new(array.get(clusterXPositions, clusterIndex), array.get(clusterPrices, clusterIndex), finalText, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, textcolor=array.get(clusterTextColors, clusterIndex), size=toLabelSize(array.get(clusterSizes, clusterIndex)), color=array.get(clusterBgColors, clusterIndex)))
        array.clear(pendingRightLabels)

// Bar-time indexing prevents overnight/weekend gaps from distorting profile width.
recentChartTimes() =>
    array<int> chartTimes = array.new<int>()
    int offset = math.min(bar_index, PROFILE_TIME_SCALE_MAX_LOOKBACK)
    while offset >= 0
        array.push(chartTimes, time[offset])
        offset -= 1
    chartTimes

nearestChartTimeIndex(array<int> chartTimes, int targetTime) =>
    int count = array.size(chartTimes)
    int result = -1
    bool insideScale = count > 0 and targetTime >= array.get(chartTimes, 0) and targetTime <= array.get(chartTimes, count - 1)
    if insideScale
        int lowIndex = 0
        int highIndex = count - 1
        while lowIndex <= highIndex
            int middleIndex = int(math.floor((lowIndex + highIndex) * 0.5))
            int middleTime = array.get(chartTimes, middleIndex)
            if middleTime < targetTime
                result := middleIndex
                lowIndex := middleIndex + 1
            else if middleTime > targetTime
                highIndex := middleIndex - 1
            else
                result := middleIndex
                lowIndex := highIndex + 1
        if result < 0
            result := 0
        if result < count - 1
            int nextIndex = result + 1
            if math.abs(array.get(chartTimes, nextIndex) - targetTime) < math.abs(array.get(chartTimes, result) - targetTime)
                result := nextIndex
    result

profileBaselineTime(DeltaProfile profile, array<int> chartTimes, int baselineIndex, bool attachRight) =>
    int count = array.size(chartTimes)
    baselineIndex >= 0 and baselineIndex < count ? array.get(chartTimes, baselineIndex) : (attachRight ? profile.endTime : profile.startTime)

profileOuterTime(DeltaProfile profile, array<int> chartTimes, int baselineIndex, int rangeSteps, float magnitudeRatio, int widthPercent, bool faceLeft, bool attachRight) =>
    int count = array.size(chartTimes)
    int outerTime = na
    float clampedRatio = math.max(0.0, math.min(1.0, magnitudeRatio))
    int baselineTime = profileBaselineTime(profile, chartTimes, baselineIndex, attachRight)
    if clampedRatio <= 0
        outerTime := baselineTime
    else if count > 1 and baselineIndex >= 0
        int maximumSteps = math.max(1, int(math.round(rangeSteps * widthPercent * 0.01)))
        int rowSteps = math.max(1, int(math.round(clampedRatio * maximumSteps)))
        int outerIndex = baselineIndex + (faceLeft ? -rowSteps : rowSteps)
        if outerIndex >= 0 and outerIndex < count
            outerTime := array.get(chartTimes, outerIndex)
        else
            int overflowSteps = outerIndex < 0 ? outerIndex : outerIndex - (count - 1)
            int edgeTime = outerIndex < 0 ? array.get(chartTimes, 0) : array.get(chartTimes, count - 1)
            int chartMilliseconds = math.max(1, int(timeframe.in_seconds(timeframe.period) * 1000))
            outerTime := edgeTime + overflowSteps * chartMilliseconds
    else
        int profileMilliseconds = math.max(1, profile.endTime - profile.startTime)
        int rowWidth = math.max(1, int(math.round(profileMilliseconds * widthPercent * 0.01 * clampedRatio)))
        outerTime := baselineTime + (faceLeft ? -rowWidth : rowWidth)
    outerTime

computeRowStrengths(DeltaProfile profile) =>
    array<float> strengths = array.new<float>(profile.rowCount, na)
    float absDeltaSum = 0.0
    int occupiedCount = 0
    for rowIndex = 0 to profile.rowCount - 1
        if array.get(profile.rowVolumes, rowIndex) > 0
            absDeltaSum += math.abs(array.get(profile.rowDeltas, rowIndex))
            occupiedCount += 1
    if occupiedCount > 2
        float averageAbsDelta = absDeltaSum / occupiedCount
        if averageAbsDelta > 0
            for rowIndex = 0 to profile.rowCount - 1
                if array.get(profile.rowVolumes, rowIndex) > 0
                    array.set(strengths, rowIndex, math.abs(array.get(profile.rowDeltas, rowIndex)) / averageAbsDelta)
    strengths

isOutlierStrength(float strength) =>
    not na(strength) and strength >= outlierMultiplier

rowPassesDeltaFilter(float rowDelta, float strength) =>
    bool isBuy = rowDelta > 0
    bool isSell = rowDelta < 0
    bool isOutlier = isOutlierStrength(strength)
    string rowsMode = quickOutliersOnly ? DELTA_ROWS_OUTLIERS : deltaRowsMode
    rowsMode == DELTA_ROWS_BUY ? isBuy : rowsMode == DELTA_ROWS_SELL ? isSell : rowsMode == DELTA_ROWS_OUTLIERS ? (isBuy or isSell) and isOutlier : rowsMode == DELTA_ROWS_BUY_OUTLIERS ? isBuy and isOutlier : rowsMode == DELTA_ROWS_SELL_OUTLIERS ? isSell and isOutlier : isBuy or isSell

appendDeltaRowPoints(array<chart.point> points, int baselineTime, int outerTime, float rowBottom, float rowTop) =>
    array.push(points, chart.point.from_time(baselineTime, rowBottom))
    array.push(points, chart.point.from_time(outerTime, rowBottom))
    array.push(points, chart.point.from_time(outerTime, rowTop))
    array.push(points, chart.point.from_time(baselineTime, rowTop))

renderDeltaLayer(array<chart.point> points, color fillColor) =>
    if array.size(points) >= 4
        array.push(drawnPolylines, polyline.new(points, curved=false, closed=true, xloc=xloc.bar_time, line_color=color.new(fillColor, 100), fill_color=fillColor))

renderDeltaPolylines(DeltaProfile profile, array<float> strengths, array<int> chartTimes, int startScaleIndex, int endScaleIndex) =>
    if profile.maxAbsRowDelta > 0
        array<chart.point> buyPoints = array.new<chart.point>()
        array<chart.point> sellPoints = array.new<chart.point>()
        array<chart.point> outlierBuyPoints = array.new<chart.point>()
        array<chart.point> outlierSellPoints = array.new<chart.point>()
        float rowHeight = (profile.priceHigh - profile.priceLow) / profile.rowCount
        bool attachRight = profileEdge == PROFILE_EDGE_RIGHT
        bool faceLeft = profileFacing == PROFILE_FACE_LEFT
        bool completeScale = startScaleIndex >= 0 and endScaleIndex >= 0
        int baselineIndex = completeScale ? (attachRight ? endScaleIndex : startScaleIndex) : -1
        int rangeSteps = completeScale ? math.max(1, math.abs(endScaleIndex - startScaleIndex)) : 1
        int baselineTime = profileBaselineTime(profile, chartTimes, baselineIndex, attachRight)
        for rowIndex = 0 to profile.rowCount - 1
            float rowVolume = array.get(profile.rowVolumes, rowIndex)
            if rowVolume > 0
                float strength = array.get(strengths, rowIndex)
                bool outlierRow = isOutlierStrength(strength)
                float rowDelta = array.get(profile.rowDeltas, rowIndex)
                float magnitude = math.abs(rowDelta)
                if magnitude > 0 and rowPassesDeltaFilter(rowDelta, strength)
                    float rowBottom = profile.priceLow + rowIndex * rowHeight
                    int outerTime = profileOuterTime(profile, chartTimes, baselineIndex, rangeSteps, magnitude / profile.maxAbsRowDelta, barWidthPercent, faceLeft, attachRight)
                    if rowDelta >= 0 and outlierRow
                        appendDeltaRowPoints(outlierBuyPoints, baselineTime, outerTime, rowBottom, rowBottom + rowHeight)
                    else if rowDelta >= 0
                        appendDeltaRowPoints(buyPoints, baselineTime, outerTime, rowBottom, rowBottom + rowHeight)
                    else if outlierRow
                        appendDeltaRowPoints(outlierSellPoints, baselineTime, outerTime, rowBottom, rowBottom + rowHeight)
                    else
                        appendDeltaRowPoints(sellPoints, baselineTime, outerTime, rowBottom, rowBottom + rowHeight)
        renderDeltaLayer(buyPoints, barBuyColor)
        renderDeltaLayer(sellPoints, barSellColor)
        renderDeltaLayer(outlierBuyPoints, outlierBuyColor)
        renderDeltaLayer(outlierSellPoints, outlierSellColor)

pushVolumeBackdropRun(array<chart.point> points, color fillColor) =>
    array.push(drawnPolylines, polyline.new(points, curved=false, closed=true, xloc=xloc.bar_time, line_color=color.new(fillColor, 100), fill_color=fillColor))

// Split only at value-area boundaries to stay within the polyline budget.
renderVolumeBackdrop(DeltaProfile profile, int valueAreaLowRow, int valueAreaHighRow, int maxPolylinesAllowed, array<int> chartTimes, int startScaleIndex, int endScaleIndex) =>
    int polylinesUsed = 0
    if profile.maxRowVolume > 0 and maxPolylinesAllowed > 0
        int rowCount = profile.rowCount
        float rowHeight = (profile.priceHigh - profile.priceLow) / rowCount
        bool attachRight = false
        bool faceLeft = false
        bool completeScale = startScaleIndex >= 0 and endScaleIndex >= 0
        int baselineIndex = completeScale ? (attachRight ? endScaleIndex : startScaleIndex) : -1
        int rangeSteps = completeScale ? math.max(1, math.abs(endScaleIndex - startScaleIndex)) : 1
        int baselineTime = profileBaselineTime(profile, chartTimes, baselineIndex, attachRight)
        if not backdropValueAreaColors
            array<chart.point> points = array.new<chart.point>()
            array.push(points, chart.point.from_time(baselineTime, profile.priceLow))
            for rowIndex = 0 to rowCount - 1
                float rowVolume = array.get(profile.rowVolumes, rowIndex)
                int outerTime = profileOuterTime(profile, chartTimes, baselineIndex, rangeSteps, rowVolume / profile.maxRowVolume, backdropWidthPercent, faceLeft, attachRight)
                array.push(points, chart.point.from_time(outerTime, profile.priceLow + (rowIndex + 0.5) * rowHeight))
            array.push(points, chart.point.from_time(baselineTime, profile.priceHigh))
            pushVolumeBackdropRun(points, backdropColor)
            polylinesUsed := 1
        else
            array<chart.point> points = array.new<chart.point>()
            bool runStarted = false
            bool runInsideValueArea = false
            for rowIndex = 0 to rowCount - 1
                bool insideValueArea = rowIndex >= valueAreaLowRow and rowIndex <= valueAreaHighRow
                float rowBottom = profile.priceLow + rowIndex * rowHeight
                float rowVolume = array.get(profile.rowVolumes, rowIndex)
                int outerTime = profileOuterTime(profile, chartTimes, baselineIndex, rangeSteps, rowVolume / profile.maxRowVolume, backdropWidthPercent, faceLeft, attachRight)
                if runStarted and insideValueArea != runInsideValueArea
                    array.push(points, chart.point.from_time(baselineTime, rowBottom))
                    if polylinesUsed < maxPolylinesAllowed
                        pushVolumeBackdropRun(points, runInsideValueArea ? backdropInsideColor : backdropOutsideColor)
                        polylinesUsed += 1
                    points := array.new<chart.point>()
                    runStarted := false
                if not runStarted
                    runStarted := true
                    runInsideValueArea := insideValueArea
                    array.push(points, chart.point.from_time(baselineTime, rowBottom))
                array.push(points, chart.point.from_time(outerTime, rowBottom + rowHeight * 0.5))
                if rowIndex == rowCount - 1
                    array.push(points, chart.point.from_time(baselineTime, rowBottom + rowHeight))
                    if polylinesUsed < maxPolylinesAllowed
                        pushVolumeBackdropRun(points, runInsideValueArea ? backdropInsideColor : backdropOutsideColor)
                        polylinesUsed += 1
    polylinesUsed

smoothProfileVolumes(DeltaProfile profile) =>
    array<float> smoothedVolumes = array.new<float>(profile.rowCount, 0.0)
    for rowIndex = 0 to profile.rowCount - 1
        int firstRow = math.max(0, rowIndex - LOW_VOLUME_SMOOTH_RADIUS)
        int lastRow = math.min(profile.rowCount - 1, rowIndex + LOW_VOLUME_SMOOTH_RADIUS)
        float volumeSum = 0.0
        for sampleRow = firstRow to lastRow
            volumeSum += array.get(profile.rowVolumes, sampleRow)
        array.set(smoothedVolumes, rowIndex, volumeSum / (lastRow - firstRow + 1))
    smoothedVolumes

volumeWindowAverage(array<float> volumes, int firstRow, int lastRow) =>
    float volumeSum = 0.0
    for rowIndex = firstRow to lastRow
        volumeSum += array.get(volumes, rowIndex)
    volumeSum / (lastRow - firstRow + 1)

collectLowVolumeCandidates(DeltaProfile profile) =>
    array<LowVolumeCandidate> candidates = array.new<LowVolumeCandidate>()
    bool detectLvns = lowVolumeMode == LOW_VOLUME_LVNS or lowVolumeMode == LOW_VOLUME_BOTH
    bool detectCliffs = lowVolumeMode == LOW_VOLUME_CLIFFS or lowVolumeMode == LOW_VOLUME_BOTH
    int rowCount = profile.rowCount
    float rowHeight = (profile.priceHigh - profile.priceLow) / rowCount
    int shoulderWindow = math.max(4, math.min(32, int(math.round(rowCount * LOW_VOLUME_SHOULDER_FRACTION))))
    if rowCount >= LOW_VOLUME_SMOOTH_RADIUS * 2 + 3
        array<float> smoothedVolumes = smoothProfileVolumes(profile)
        float maxSmoothedVolume = array.max(smoothedVolumes)
        float minimumShoulderVolume = maxSmoothedVolume * LOW_VOLUME_MIN_SHOULDER_SHARE
        float minimumDenominator = math.max(maxSmoothedVolume * 0.001, 0.0000001)
        if detectLvns and rowCount >= shoulderWindow * 2 + 3
            int maximumZoneRows = math.max(1, int(math.floor(rowCount * LOW_VOLUME_MAX_ZONE_FRACTION)))
            int firstLvnRow = shoulderWindow
            int lastLvnRow = rowCount - shoulderWindow - 1
            for rowIndex = firstLvnRow to lastLvnRow
                float valleyVolume = array.get(smoothedVolumes, rowIndex)
                float leftShoulderVolume = 0.0
                float rightShoulderVolume = 0.0
                for shoulderOffset = 1 to shoulderWindow
                    leftShoulderVolume := math.max(leftShoulderVolume, array.get(smoothedVolumes, rowIndex - shoulderOffset))
                    rightShoulderVolume := math.max(rightShoulderVolume, array.get(smoothedVolumes, rowIndex + shoulderOffset))
                float shoulderVolume = math.min(leftShoulderVolume, rightShoulderVolume)
                float strength = shoulderVolume / math.max(valleyVolume, minimumDenominator)
                bool boundedValley = valleyVolume < leftShoulderVolume and valleyVolume < rightShoulderVolume
                if boundedValley and shoulderVolume >= minimumShoulderVolume and strength >= lowVolumeSensitivity
                    float zoneThreshold = shoulderVolume / lowVolumeSensitivity
                    int firstZoneRow = rowIndex
                    int lastZoneRow = rowIndex
                    while firstZoneRow > 0 and lastZoneRow - firstZoneRow + 1 <= maximumZoneRows and array.get(smoothedVolumes, firstZoneRow - 1) <= zoneThreshold
                        firstZoneRow -= 1
                    while lastZoneRow < rowCount - 1 and lastZoneRow - firstZoneRow + 1 <= maximumZoneRows and array.get(smoothedVolumes, lastZoneRow + 1) <= zoneThreshold
                        lastZoneRow += 1
                    int zoneRows = lastZoneRow - firstZoneRow + 1
                    if zoneRows <= maximumZoneRows
                        float valleyPrice = profile.priceLow + (rowIndex + 0.5) * rowHeight
                        float zoneLow = profile.priceLow + firstZoneRow * rowHeight
                        float zoneHigh = profile.priceLow + (lastZoneRow + 1) * rowHeight
                        array.push(candidates, LowVolumeCandidate.new(valleyPrice, zoneLow, zoneHigh, strength, true))
        if detectCliffs
            int compareRows = LOW_VOLUME_SMOOTH_RADIUS + 1
            if rowCount >= compareRows * 2 + 1
                int firstCliffBoundary = compareRows
                int lastCliffBoundary = rowCount - compareRows
                for boundaryRow = firstCliffBoundary to lastCliffBoundary
                    int lowerFirstRow = boundaryRow - compareRows
                    int lowerLastRow = boundaryRow - 1
                    int upperFirstRow = boundaryRow
                    int upperLastRow = boundaryRow + compareRows - 1
                    float lowerVolume = volumeWindowAverage(smoothedVolumes, lowerFirstRow, lowerLastRow)
                    float upperVolume = volumeWindowAverage(smoothedVolumes, upperFirstRow, upperLastRow)
                    float highVolume = math.max(lowerVolume, upperVolume)
                    float lowVolume = math.min(lowerVolume, upperVolume)
                    float strength = highVolume / math.max(lowVolume, minimumDenominator)
                    if highVolume >= minimumShoulderVolume and strength >= lowVolumeSensitivity
                        float cliffPrice = profile.priceLow + boundaryRow * rowHeight
                        array.push(candidates, LowVolumeCandidate.new(cliffPrice, cliffPrice, cliffPrice, strength, false))
    candidates

lowVolumeCandidatesOverlap(LowVolumeCandidate first, LowVolumeCandidate second, float rowHeight) =>
    bool overlap = false
    if first.isLvn and second.isLvn
        overlap := first.zoneLow <= second.zoneHigh and second.zoneLow <= first.zoneHigh
    else if not first.isLvn and not second.isLvn
        overlap := math.abs(first.price - second.price) <= rowHeight * LOW_VOLUME_CLIFF_SEPARATION_ROWS
    else
        float lvnLow = first.isLvn ? first.zoneLow : second.zoneLow
        float lvnHigh = first.isLvn ? first.zoneHigh : second.zoneHigh
        float cliffPrice = first.isLvn ? second.price : first.price
        float cliffMargin = rowHeight * LOW_VOLUME_CLIFF_SEPARATION_ROWS
        overlap := cliffPrice >= lvnLow - cliffMargin and cliffPrice <= lvnHigh + cliffMargin
    overlap

renderLowVolumeBoundary(DeltaProfile profile, float price) =>
    line boundary = line.new(profile.startTime, price, profile.endTime, price, xloc=xloc.bar_time, extend=extend.right, color=lowVolumeColor, style=toLineStyle(lowVolumeLineStyle), width=lowVolumeLineWidth)
    array.push(drawnLines, boundary)
    boundary

renderLowVolumeZone(DeltaProfile profile, float zoneLow, float zoneHigh) =>
    line lowerBoundary = renderLowVolumeBoundary(profile, zoneLow)
    line upperBoundary = renderLowVolumeBoundary(profile, zoneHigh)
    if showLowVolumeFill
        array.push(drawnLineFills, linefill.new(lowerBoundary, upperBoundary, lowVolumeFillColor))

renderLowVolumeStructures(DeltaProfile profile, string sourceName) =>
    if quickLowVolumeStructures
        array<LowVolumeCandidate> candidates = collectLowVolumeCandidates(profile)
        int candidateCount = array.size(candidates)
        if candidateCount > 0
            array<bool> discarded = array.new<bool>(candidateCount, false)
            float rowHeight = (profile.priceHigh - profile.priceLow) / profile.rowCount
            int lvnRank = 0
            int cliffRank = 0
            for structureRank = 1 to lowVolumeMaxStructures
                int bestCandidateIndex = -1
                float bestStrength = -1.0
                for candidateIndex = 0 to candidateCount - 1
                    LowVolumeCandidate candidate = array.get(candidates, candidateIndex)
                    if not array.get(discarded, candidateIndex) and candidate.strength > bestStrength
                        bestCandidateIndex := candidateIndex
                        bestStrength := candidate.strength
                if bestCandidateIndex >= 0
                    LowVolumeCandidate selectedCandidate = array.get(candidates, bestCandidateIndex)
                    array.set(discarded, bestCandidateIndex, true)
                    string structureName = ""
                    string structureDetail = ""
                    int levelRank = LOW_VOLUME_LEVEL_RANK - structureRank
                    float labelPrice = selectedCandidate.isLvn ? (selectedCandidate.zoneLow + selectedCandidate.zoneHigh) * 0.5 : selectedCandidate.price
                    if selectedCandidate.isLvn
                        lvnRank += 1
                        structureName := "LVN " + str.tostring(lvnRank)
                        structureDetail := str.tostring(selectedCandidate.strength, "#.#") + "×"
                        renderLowVolumeZone(profile, selectedCandidate.zoneLow, selectedCandidate.zoneHigh)
                    else
                        cliffRank += 1
                        float dropPercent = (1.0 - 1.0 / selectedCandidate.strength) * 100.0
                        structureName := "Cliff " + str.tostring(cliffRank)
                        structureDetail := str.tostring(dropPercent, "#") + "% drop"
                        queueRightLine(selectedCandidate.price, profile.startTime, profile.endTime, lowVolumeColor, lowVolumeLineWidth, lowVolumeLineStyle, levelRank, sourceName, false)
                    if showLevelTags
                        string structureText = sourceName + " " + structureName + (levelTagsDetailed ? " " + BRAND_BULLET + " " + structureDetail : "")
                        queueRightLabel(labelPrice, structureText, levelTagsShowPrice, lowVolumeColor, levelsLabelSize, levelRank)
                    for candidateIndex = 0 to candidateCount - 1
                        if not array.get(discarded, candidateIndex) and lowVolumeCandidatesOverlap(selectedCandidate, array.get(candidates, candidateIndex), rowHeight)
                            array.set(discarded, candidateIndex, true)

queueOutlierPeak(DeltaProfile profile, string sourceName, bool buySide, int firstRow, int lastRow, int anchorRow, float peakDelta, float peakStrength, int peakRows) =>
    float rowHeight = (profile.priceHigh - profile.priceLow) / profile.rowCount
    float peakPrice = profile.priceLow + (anchorRow + 0.5) * rowHeight
    float zoneLow = profile.priceLow + firstRow * rowHeight
    float zoneHigh = profile.priceLow + (lastRow + 1) * rowHeight
    color peakColor = buySide ? outlierBuyColor : outlierSellColor
    array.push(pendingOutlierLevels, PendingOutlierLevel.new(peakPrice, zoneLow, zoneHigh, peakDelta, peakStrength, buySide, profile.startTime, profile.endTime, peakColor, peakRows, sourceName))

collectSideOutlierPeaks(DeltaProfile profile, array<float> strengths, string sourceName, bool buySide) =>
    int peaksFound = 0
    bool peakActive = false
    float peakDelta = 0.0
    float peakStrength = 0.0
    int peakFirstRow = -1
    int peakLastRow = -1
    int peakAnchorRow = -1
    int peakRows = 0
    int lastQualifiedRow = -100000
    for rowIndex = 0 to profile.rowCount - 1
        float rowDelta = array.get(profile.rowDeltas, rowIndex)
        float strength = array.get(strengths, rowIndex)
        bool correctSide = buySide ? rowDelta > 0 : rowDelta < 0
        bool qualifies = correctSide and isOutlierStrength(strength)
        if qualifies
            bool startsNewPeak = peakActive and rowIndex - lastQualifiedRow > OUTLIER_PEAK_GAP_ROWS + 1
            if startsNewPeak
                queueOutlierPeak(profile, sourceName, buySide, peakFirstRow, peakLastRow, peakAnchorRow, peakDelta, peakStrength, peakRows)
                peaksFound += 1
                peakActive := false
                peakDelta := 0.0
                peakStrength := 0.0
                peakFirstRow := -1
                peakLastRow := -1
                peakAnchorRow := -1
                peakRows := 0
            if not peakActive
                peakActive := true
                peakFirstRow := rowIndex
            peakDelta += rowDelta
            peakRows += 1
            peakLastRow := rowIndex
            if strength > peakStrength
                peakStrength := strength
                peakAnchorRow := rowIndex
            lastQualifiedRow := rowIndex
    if peakActive
        queueOutlierPeak(profile, sourceName, buySide, peakFirstRow, peakLastRow, peakAnchorRow, peakDelta, peakStrength, peakRows)
        peaksFound += 1
    peaksFound

collectOutlierPeaks(DeltaProfile profile, array<float> strengths, string sourceName) =>
    int peaksFound = 0
    if quickOutlierZones and (outlierFlagsMode == OUTLIER_FLAGS_BOTH or outlierFlagsMode == OUTLIER_FLAGS_BUY)
        peaksFound += collectSideOutlierPeaks(profile, strengths, sourceName, true)
    if quickOutlierZones and (outlierFlagsMode == OUTLIER_FLAGS_BOTH or outlierFlagsMode == OUTLIER_FLAGS_SELL)
        peaksFound += collectSideOutlierPeaks(profile, strengths, sourceName, false)
    peaksFound

flushPendingOutlierLevels(bool merge) =>
    int pendingCount = array.size(pendingOutlierLevels)
    if pendingCount > 0
        array<float> clusterPrices = array.new<float>()
        array<float> clusterZoneLows = array.new<float>()
        array<float> clusterZoneHighs = array.new<float>()
        array<float> clusterDeltas = array.new<float>()
        array<float> clusterStrengths = array.new<float>()
        array<bool> clusterBuySides = array.new<bool>()
        array<int> clusterLeftTimes = array.new<int>()
        array<int> clusterRightTimes = array.new<int>()
        array<color> clusterColors = array.new<color>()
        array<int> clusterRowCounts = array.new<int>()
        array<string> clusterSourceNames = array.new<string>()
        for pendingIndex = 0 to pendingCount - 1
            PendingOutlierLevel pending = array.get(pendingOutlierLevels, pendingIndex)
            float tolerance = math.max(syminfo.mintick, math.abs(pending.price) * mergeDistancePercent / 100.0)
            int foundIndex = -1
            float minimumDistance = tolerance + syminfo.mintick
            if merge and array.size(clusterPrices) > 0
                for clusterIndex = 0 to array.size(clusterPrices) - 1
                    float distance = math.abs(array.get(clusterPrices, clusterIndex) - pending.price)
                    bool sameSide = array.get(clusterBuySides, clusterIndex) == pending.buySide
                    bool sameSource = array.get(clusterSourceNames, clusterIndex) == pending.sourceName
                    if sameSide and sameSource and distance <= tolerance and distance < minimumDistance
                        minimumDistance := distance
                        foundIndex := clusterIndex
            if foundIndex >= 0
                array.set(clusterLeftTimes, foundIndex, math.min(array.get(clusterLeftTimes, foundIndex), pending.leftTime))
                array.set(clusterRightTimes, foundIndex, math.max(array.get(clusterRightTimes, foundIndex), pending.rightTime))
                array.set(clusterZoneLows, foundIndex, math.min(array.get(clusterZoneLows, foundIndex), pending.zoneLow))
                array.set(clusterZoneHighs, foundIndex, math.max(array.get(clusterZoneHighs, foundIndex), pending.zoneHigh))
                array.set(clusterDeltas, foundIndex, array.get(clusterDeltas, foundIndex) + pending.delta)
                array.set(clusterRowCounts, foundIndex, array.get(clusterRowCounts, foundIndex) + pending.rowCount)
                if pending.strength > array.get(clusterStrengths, foundIndex)
                    array.set(clusterPrices, foundIndex, pending.price)
                    array.set(clusterStrengths, foundIndex, pending.strength)
                    array.set(clusterColors, foundIndex, pending.levelColor)
            else
                array.push(clusterPrices, pending.price)
                array.push(clusterZoneLows, pending.zoneLow)
                array.push(clusterZoneHighs, pending.zoneHigh)
                array.push(clusterDeltas, pending.delta)
                array.push(clusterStrengths, pending.strength)
                array.push(clusterBuySides, pending.buySide)
                array.push(clusterLeftTimes, pending.leftTime)
                array.push(clusterRightTimes, pending.rightTime)
                array.push(clusterColors, pending.levelColor)
                array.push(clusterRowCounts, pending.rowCount)
                array.push(clusterSourceNames, pending.sourceName)
        array<string> sourceNames = array.new<string>()
        for clusterIndex = 0 to array.size(clusterSourceNames) - 1
            string sourceName = array.get(clusterSourceNames, clusterIndex)
            if not array.includes(sourceNames, sourceName)
                array.push(sourceNames, sourceName)
        array<bool> selectedClusters = array.new<bool>(array.size(clusterPrices), false)
        for sourceIndex = 0 to array.size(sourceNames) - 1
            string selectedSourceName = array.get(sourceNames, sourceIndex)
            for sideIndex = 0 to 1
                bool buySide = sideIndex == 0
                for sideRank = 1 to outlierMaxFlags
                    int bestCluster = -1
                    float bestMagnitude = -1.0
                    float bestStrength = -1.0
                    for clusterIndex = 0 to array.size(clusterPrices) - 1
                        bool eligible = not array.get(selectedClusters, clusterIndex) and array.get(clusterBuySides, clusterIndex) == buySide and array.get(clusterSourceNames, clusterIndex) == selectedSourceName
                        if eligible
                            float magnitude = math.abs(array.get(clusterDeltas, clusterIndex))
                            float strength = array.get(clusterStrengths, clusterIndex)
                            if magnitude > bestMagnitude or (magnitude == bestMagnitude and strength > bestStrength)
                                bestMagnitude := magnitude
                                bestStrength := strength
                                bestCluster := clusterIndex
                    if bestCluster >= 0
                        array.set(selectedClusters, bestCluster, true)
                        float price = array.get(clusterPrices, bestCluster)
                        float zoneLow = array.get(clusterZoneLows, bestCluster)
                        float zoneHigh = array.get(clusterZoneHighs, bestCluster)
                        float deltaSum = array.get(clusterDeltas, bestCluster)
                        float strength = array.get(clusterStrengths, bestCluster)
                        int rowCount = array.get(clusterRowCounts, bestCluster)
                        int leftTime = array.get(clusterLeftTimes, bestCluster)
                        int rightTime = array.get(clusterRightTimes, bestCluster)
                        color levelColor = array.get(clusterColors, bestCluster)
                        string sourceName = array.get(clusterSourceNames, bestCluster)
                        int dynamicLineWidth = sideRank == 1 ? strongestOutlierLineWidth : outlierLineWidth
                        string dynamicLineStyle = sideRank == 1 ? strongestOutlierLineStyle : outlierLineStyle
                        string deltaText = rowCount > 1 ? "ΣΔ " + formatDelta(deltaSum) : DELTA_PREFIX + formatDelta(deltaSum)
                        string strengthText = rowCount > 1 ? "max " + str.tostring(strength, "#.#") + "× " + BRAND_BULLET + " " + str.tostring(rowCount) + " rows" : str.tostring(strength, "#.#") + "×"
                        string rankText = (nyEarlyIvbModeActive ? sourceName + " " : "") + (buySide ? "Buy Zone " : "Sell Zone ") + str.tostring(sideRank)
                        string flagText = levelTagsDetailed ? rankText + " " + BRAND_BULLET + " " + deltaText + " " + BRAND_BULLET + " " + strengthText : rankText
                        int levelRank = 2000 - sideRank
                        if showZoneFill
                            renderZoneFill(leftTime, rightTime, zoneLow, zoneHigh, levelColor)
                        queueRightLine(price, leftTime, rightTime, color.new(levelColor, FLAG_LINE_TRANSPARENCY), dynamicLineWidth, dynamicLineStyle, levelRank, sourceName, false)
                        if showLevelTags
                            queueRightLabel(price, flagText, levelTagsShowPrice, levelColor, levelsLabelSize, levelRank)
        array.clear(pendingOutlierLevels)

renderProfileBox(DeltaProfile profile, bool drawBorder, color profileOutlineColor, int profileOutlineWidth) =>
    color borderColor = drawBorder ? profileOutlineColor : color.new(profileOutlineColor, 100)
    color fillColor = showProfileBox ? profileBoxColor : color.new(profileBoxColor, 100)
    array.push(drawnBoxes, box.new(left=profile.startTime, top=profile.rangeHigh, right=profile.endTime, bottom=profile.rangeLow, xloc=xloc.bar_time, border_color=borderColor, border_width=drawBorder ? profileOutlineWidth : 0, border_style=line.style_solid, bgcolor=fillColor))

renderReferenceLevel(DeltaProfile profile, string sourceName, float price, string levelName, color lineColor, int lineWidth, string lineStyle, color labelColor, string labelSize, int labelRank) =>
    queueRightLine(price, profile.startTime, profile.endTime, lineColor, lineWidth, lineStyle, labelRank, sourceName, levelName == "POC")
    if showLevelTags
        queueRightLabel(price, sourceName + " " + levelName, levelTagsShowPrice, labelColor, labelSize, labelRank)

renderProfileLevels(DeltaProfile profile, string sourceName, float pocPrice, float valueAreaLowPrice, float valueAreaHighPrice) =>
    if showValueAreaLevels
        renderReferenceLevel(profile, sourceName, valueAreaHighPrice, "VAH", valueAreaLevelColor, valueAreaLevelWidth, valueAreaLevelStyle, valueAreaLabelColor, valueAreaLabelSize, 200)
        renderReferenceLevel(profile, sourceName, valueAreaLowPrice, "VAL", valueAreaLevelColor, valueAreaLevelWidth, valueAreaLevelStyle, valueAreaLabelColor, valueAreaLabelSize, 200)
    if showPocLevel
        renderReferenceLevel(profile, sourceName, pocPrice, "POC", pocLevelColor, pocLevelWidth, pocLevelStyle, pocLabelColor, pocLabelSize, 300)

renderRangeOutline(DeltaProfile profile) =>
    array.push(drawnLines, line.new(profile.startTime, profile.rangeLow, profile.startTime, profile.rangeHigh, xloc=xloc.bar_time, color=outlineColor, style=line.style_solid, width=outlineWidth))
    array.push(drawnLines, line.new(profile.endTime, profile.rangeLow, profile.endTime, profile.rangeHigh, xloc=xloc.bar_time, color=outlineColor, style=line.style_solid, width=outlineWidth))
    array.push(drawnLines, line.new(profile.startTime, profile.rangeHigh, profile.endTime, profile.rangeHigh, xloc=xloc.bar_time, color=outlineColor, style=line.style_solid, width=outlineWidth))
    array.push(drawnLines, line.new(profile.startTime, profile.rangeLow, profile.endTime, profile.rangeLow, xloc=xloc.bar_time, color=outlineColor, style=line.style_solid, width=outlineWidth))

// Centers on the bar midpoint, not the time midpoint, so weekends and session gaps inside the range do not skew it.
rangeCenterTime(DeltaProfile profile, array<int> chartTimes, int startScaleIndex, int endScaleIndex) =>
    int centerTime = profile.startTime + int(math.round((profile.endTime - profile.startTime) * 0.5))
    if startScaleIndex >= 0 and endScaleIndex >= 0
        centerTime := array.get(chartTimes, int(math.round((startScaleIndex + endScaleIndex) * 0.5)))
    centerTime

// Start and End mark manual or rolling edges; every mode labels its range extremes.
renderRangeLabels(DeltaProfile profile, string sourceName, string profileRangeLabelSize, color profileRangeLabelColor, bool profileRangeShowPrice, array<int> chartTimes, int startScaleIndex, int endScaleIndex) =>
    int middleTime = rangeCenterTime(profile, chartTimes, startScaleIndex, endScaleIndex)
    string anchorName = sourceName
    string fixedRangeName = "🎯 " + formatFixedRangeDuration(fixedRangeStartInput, fixedRangeEndInput) + " Fixed"
    string rangeHighName = rollingModeActive ? "Rolling " + rollingLookbackTag + " Range High" : fixedModeActive ? fixedRangeName + " " + LABEL_RANGE_HIGH : anchorName + " " + LABEL_RANGE_HIGH
    string rangeLowName = rollingModeActive ? "Rolling " + rollingLookbackTag + " Range Low" : fixedModeActive ? fixedRangeName + " " + LABEL_RANGE_LOW : anchorName + " " + LABEL_RANGE_LOW
    if rangeModeActive
        array.push(drawnLabels, label.new(profile.startTime, profile.rangeHigh, anchorName + " Start", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=profileRangeLabelColor, size=toLabelSize(profileRangeLabelSize), color=levelLabelBgColor))
        array.push(drawnLabels, label.new(profile.endTime, profile.rangeHigh, anchorName + " End", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=profileRangeLabelColor, size=toLabelSize(profileRangeLabelSize), color=levelLabelBgColor))
    array.push(drawnLabels, label.new(middleTime, profile.rangeHigh, formatLevelText(rangeHighName, profile.rangeHigh, profileRangeShowPrice), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=profileRangeLabelColor, size=toLabelSize(profileRangeLabelSize), color=levelLabelBgColor))
    array.push(drawnLabels, label.new(middleTime, profile.rangeLow, formatLevelText(rangeLowName, profile.rangeLow, profileRangeShowPrice), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, textcolor=profileRangeLabelColor, size=toLabelSize(profileRangeLabelSize), color=levelLabelBgColor))

selectLatestCompletedProfile(array<DeltaProfile> profiles) =>
    DeltaProfile selected = na
    int profileCount = array.size(profiles)
    if profileCount > 0
        selected := array.get(profiles, profileCount - 1)
    selected

selectPreviousProfile(array<DeltaProfile> profiles, int offset, bool latestBelongsToCurrentSession) =>
    DeltaProfile selected = na
    int profileCount = array.size(profiles)
    if profileCount > 0
        int targetIndex = profileCount - offset - (latestBelongsToCurrentSession ? 1 : 0)
        selected := array.get(profiles, math.max(0, targetIndex))
    selected

selectSessionProfile(int previousOffset, bool currentPeriodActive, array<float> barHighs, array<float> barLows, array<float> barVolumes, array<float> barDeltas, array<DeltaProfile> profiles, array<int> startRef, array<float> sampleHighs, array<float> sampleLows, array<float> sampleVolumes, array<float> sampleDeltas, int developingEndTime) =>
    previousOffset > 0 ? selectPreviousProfile(profiles, previousOffset, not currentPeriodActive) : currentPeriodActive ? buildDevelopingDeltaProfile(barHighs, barLows, barVolumes, barDeltas, startRef, sampleHighs, sampleLows, sampleVolumes, sampleDeltas, developingEndTime) : selectLatestCompletedProfile(profiles)

renderSelectedProfile(DeltaProfile profile, string sourceName, bool showProfileBoxForSource, bool drawProfileBorder, color profileOutlineColor, int profileOutlineWidth, string profileRangeLabelSize, color profileRangeLabelColor, bool profileRangeShowPrice, array<int> chartTimes) =>
    [_, valueAreaLowRow, valueAreaHighRow, pocPrice, valueAreaLowPrice, valueAreaHighPrice] = profileValueLevels(profile)
    int startScaleIndex = nearestChartTimeIndex(chartTimes, profile.startTime)
    int endScaleIndex = nearestChartTimeIndex(chartTimes, profile.endTime)

    renderRangeLabels(profile, sourceName, profileRangeLabelSize, profileRangeLabelColor, profileRangeShowPrice, chartTimes, startScaleIndex, endScaleIndex)

    if showProfileBoxForSource
        renderProfileBox(profile, drawProfileBorder, profileOutlineColor, profileOutlineWidth)

    if showVolumeBackdrop
        int availablePolylines = math.max(0, INDICATOR_MAX_POLYLINES - array.size(drawnPolylines))
        renderVolumeBackdrop(profile, valueAreaLowRow, valueAreaHighRow, availablePolylines, chartTimes, startScaleIndex, endScaleIndex)

    array<float> strengths = computeRowStrengths(profile)
    renderDeltaPolylines(profile, strengths, chartTimes, startScaleIndex, endScaleIndex)
    renderProfileLevels(profile, sourceName, pocPrice, valueAreaLowPrice, valueAreaHighPrice)
    renderLowVolumeStructures(profile, sourceName)
    collectOutlierPeaks(profile, strengths, sourceName)

// ═══════════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE
// ═══════════════════════════════════════════════════════════════════════════════
addColorRow(array<ColorRow> rows, string name, color swatchColor, string widthText) =>
    array.push(rows, ColorRow.new(name, swatchColor, widthText))

writeColorRow(table referenceTable, int row, ColorRow entry) =>
    string rgbText = str.format("R:{0} G:{1} B:{2}", int(color.r(entry.swatchColor)), int(color.g(entry.swatchColor)), int(color.b(entry.swatchColor)))
    string transparencyText = str.tostring(int(color.t(entry.swatchColor)))
    table.cell(referenceTable, 0, row, entry.name, text_size=size.small, text_color=color.rgb(0, 0, 0))
    table.cell(referenceTable, 1, row, rgbText, text_size=size.small, text_color=color.rgb(0, 0, 0))
    table.cell(referenceTable, 2, row, transparencyText, text_size=size.small, text_color=color.rgb(0, 0, 0))
    table.cell(referenceTable, 3, row, entry.widthText, text_size=size.small, text_color=color.rgb(0, 0, 0))

// ═══════════════════════════════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════════════════════════════
var array<float> rangeBarHighs = array.new<float>()
var array<float> rangeBarLows = array.new<float>()
var array<float> rangeBarVolumes = array.new<float>()
var array<float> rangeBarDeltas = array.new<float>()
var array<int> rangeSampleStartKeys = array.new<int>()
var array<int> rangeSampleEndKeys = array.new<int>()
var array<int> rangeSampleStartTimes = array.new<int>()
var array<int> rangeSampleEndTimes = array.new<int>()

var array<float> rthBarHighs = array.new<float>()
var array<float> rthBarLows = array.new<float>()
var array<float> rthBarVolumes = array.new<float>()
var array<float> rthBarDeltas = array.new<float>()
var array<DeltaProfile> rthProfiles = array.new<DeltaProfile>()
var array<int> rthStartRef = array.new<int>(1, START_TIME_UNSET)
var array<int> rthLastBarRef = array.new<int>(1, START_TIME_UNSET)

var array<float> globexBarHighs = array.new<float>()
var array<float> globexBarLows = array.new<float>()
var array<float> globexBarVolumes = array.new<float>()
var array<float> globexBarDeltas = array.new<float>()
var array<DeltaProfile> globexProfiles = array.new<DeltaProfile>()
var array<int> globexStartRef = array.new<int>(1, START_TIME_UNSET)
var array<int> globexLastBarRef = array.new<int>(1, START_TIME_UNSET)

var array<float> nyEarlyBarHighs = array.new<float>()
var array<float> nyEarlyBarLows = array.new<float>()
var array<float> nyEarlyBarVolumes = array.new<float>()
var array<float> nyEarlyBarDeltas = array.new<float>()
var array<DeltaProfile> nyEarlyProfiles = array.new<DeltaProfile>()
var array<int> nyEarlyStartRef = array.new<int>(1, START_TIME_UNSET)
var array<int> nyEarlyLastBarRef = array.new<int>(1, START_TIME_UNSET)

var array<float> ivbBarHighs = array.new<float>()
var array<float> ivbBarLows = array.new<float>()
var array<float> ivbBarVolumes = array.new<float>()
var array<float> ivbBarDeltas = array.new<float>()
var array<DeltaProfile> ivbProfiles = array.new<DeltaProfile>()
var array<int> ivbStartRef = array.new<int>(1, START_TIME_UNSET)
var array<int> ivbLastBarRef = array.new<int>(1, START_TIME_UNSET)

var array<float> weeklyBarHighs = array.new<float>()
var array<float> weeklyBarLows = array.new<float>()
var array<float> weeklyBarVolumes = array.new<float>()
var array<float> weeklyBarDeltas = array.new<float>()
var array<DeltaProfile> weeklyProfiles = array.new<DeltaProfile>()
var array<int> weeklyStartRef = array.new<int>(1, START_TIME_UNSET)
var array<int> weeklyLastBarRef = array.new<int>(1, START_TIME_UNSET)

var array<float> monthlyBarHighs = array.new<float>()
var array<float> monthlyBarLows = array.new<float>()
var array<float> monthlyBarVolumes = array.new<float>()
var array<float> monthlyBarDeltas = array.new<float>()
var array<DeltaProfile> monthlyProfiles = array.new<DeltaProfile>()
var array<int> monthlyStartRef = array.new<int>(1, START_TIME_UNSET)
var array<int> monthlyLastBarRef = array.new<int>(1, START_TIME_UNSET)

var bool isTwentyFourSevenAsset = false
var bool assetClassificationReady = false
var int lastTickDirection = 1
var float previousTapeClose = na

// ═══════════════════════════════════════════════════════════════════════════════
// DATA & BOUNDARIES
// ═══════════════════════════════════════════════════════════════════════════════
intrabarTimeframe = autoIntrabarTimeframe()
[intrabarTimes, intrabarEndTimes, intrabarOpens, intrabarHighs, intrabarLows, intrabarCloses, intrabarVolumes] = request.security_lower_tf(syminfo.tickerid, intrabarTimeframe, [time, time_close, open, high, low, close, volume], ignore_invalid_timeframe=true)

// Sunday before the futures reopen distinguishes 24/7 trading from CME-style hours.
if not assetClassificationReady
    if syminfo.type == "crypto"
        isTwentyFourSevenAsset := true
        assetClassificationReady := true
    else if isTrueWeekendBar(time)
        isTwentyFourSevenAsset := true
        assetClassificationReady := true
    else
        int barsInWeek = math.max(1, int(math.ceil(SECONDS_PER_WEEK / timeframe.in_seconds(timeframe.period))))
        int observationWindow = math.min(ASSET_DETECTION_MAX_LOOKBACK, barsInWeek)
        if bar_index >= observationWindow
            isTwentyFourSevenAsset := false
            assetClassificationReady := true

rthInSessionWeekday = not na(time(timeframe.period, RTH_SESSION, NY_TIMEZONE))
rthInSessionAllDays = not na(time(timeframe.period, RTH_SESSION_ALL_DAYS, NY_TIMEZONE))
rthInSession = isTwentyFourSevenAsset ? rthInSessionAllDays : rthInSessionWeekday
rthSessionStart = rthInSession and not rthInSession[1]
rthSessionEnd = not rthInSession and rthInSession[1]

utcDayStart = calendarDayStart(UTC_TIMEZONE)
futuresGlobexStart = shiftedCalendarDayStart(NY_TIMEZONE, GLOBEX_REOPEN_SHIFT_MS)
globexDayStart = isTwentyFourSevenAsset ? utcDayStart : futuresGlobexStart
weeklyPeriodStart = weeklyBoundary(isTwentyFourSevenAsset, utcDayStart, futuresGlobexStart, time)
utcMonthStart = shiftedCalendarMonthStart(UTC_TIMEZONE, 0)
futuresMonthStart = shiftedCalendarMonthStart(NY_TIMEZONE, GLOBEX_REOPEN_SHIFT_MS)
monthlyPeriodStart = isTwentyFourSevenAsset ? utcMonthStart : futuresMonthStart

fixedRangeStart = math.min(fixedRangeStartInput, fixedRangeEndInput)
fixedRangeEnd = math.max(fixedRangeStartInput, fixedRangeEndInput)
rollingRangeEnd = rollingThroughTime(last_bar_time, rollingThrough, isTwentyFourSevenAsset)
rollingRangeStart = lookbackDaysStart(rollingRangeEnd, rollingLookbackDays, isTwentyFourSevenAsset)
activeRangeStart = rollingModeActive ? rollingRangeStart : fixedRangeStart
activeRangeEnd = rollingModeActive ? rollingRangeEnd : fixedRangeEnd
activeRangeConfigured = rollingModeActive ? not na(last_bar_time) : fixedRangeConfigured

array<float> barSampleHighs = array.new<float>()
array<float> barSampleLows = array.new<float>()
array<float> barSampleVolumes = array.new<float>()
array<float> barSampleDeltas = array.new<float>()
array<float> nyEarlySampleHighs = array.new<float>()
array<float> nyEarlySampleLows = array.new<float>()
array<float> nyEarlySampleVolumes = array.new<float>()
array<float> nyEarlySampleDeltas = array.new<float>()
array<float> ivbSampleHighs = array.new<float>()
array<float> ivbSampleLows = array.new<float>()
array<float> ivbSampleVolumes = array.new<float>()
array<float> ivbSampleDeltas = array.new<float>()
int nyEarlyFirstSampleTime = na
int nyEarlyLastSampleEndTime = na
int ivbFirstSampleTime = na
int ivbLastSampleEndTime = na
bool nyEarlyWindowObserved = false
bool ivbWindowObserved = false
bool boundedSessionSamplesRequired = nyEarlyModeActive or ivbModeActive
int subBarCount = array.size(intrabarVolumes)
if subBarCount > 0
    for subBarIndex = 0 to subBarCount - 1
        int subTime = array.get(intrabarTimes, subBarIndex)
        int subEndTime = array.get(intrabarEndTimes, subBarIndex)
        float subOpen = array.get(intrabarOpens, subBarIndex)
        float subHigh = array.get(intrabarHighs, subBarIndex)
        float subLow = array.get(intrabarLows, subBarIndex)
        float subClose = array.get(intrabarCloses, subBarIndex)
        float subVolume = array.get(intrabarVolumes, subBarIndex)
        bool boundedDayAllowed = boundedSessionSamplesRequired and (isTwentyFourSevenAsset or isNyWeekday(subTime))
        bool subInNyEarly = nyEarlyModeActive and boundedDayAllowed and inNyMinuteWindow(subTime, NY_EARLY_START_MINUTE, NY_EARLY_END_MINUTE)
        bool subInIvb = ivbModeActive and boundedDayAllowed and inNyMinuteWindow(subTime, IVB_START_MINUTE, IVB_END_MINUTE)
        if subInNyEarly
            nyEarlyWindowObserved := true
            nyEarlyFirstSampleTime := na(nyEarlyFirstSampleTime) ? subTime : nyEarlyFirstSampleTime
            nyEarlyLastSampleEndTime := na(subEndTime) ? subTime : subEndTime
        if subInIvb
            ivbWindowObserved := true
            ivbFirstSampleTime := na(ivbFirstSampleTime) ? subTime : ivbFirstSampleTime
            ivbLastSampleEndTime := na(subEndTime) ? subTime : subEndTime
        if not na(subVolume) and subVolume > 0 and not na(subHigh) and not na(subLow)
            int direction = na(subOpen) or na(subClose) ? lastTickDirection : subClose > subOpen ? 1 : subClose < subOpen ? -1 : not na(previousTapeClose) and subClose > previousTapeClose ? 1 : not na(previousTapeClose) and subClose < previousTapeClose ? -1 : lastTickDirection
            lastTickDirection := direction
            if not na(subClose)
                previousTapeClose := subClose
            float subDelta = subVolume * direction
            appendBarSample(barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, subHigh, subLow, subVolume, subDelta)
            if subInNyEarly
                appendBarSample(nyEarlySampleHighs, nyEarlySampleLows, nyEarlySampleVolumes, nyEarlySampleDeltas, subHigh, subLow, subVolume, subDelta)
            if subInIvb
                appendBarSample(ivbSampleHighs, ivbSampleLows, ivbSampleVolumes, ivbSampleDeltas, subHigh, subLow, subVolume, subDelta)
bool fallbackBarValid = not na(volume) and volume > 0 and not na(high) and not na(low)
bool barSampleFallbackRequired = fallbackBarValid and array.size(barSampleVolumes) == 0
bool fallbackDayAllowed = boundedSessionSamplesRequired and (isTwentyFourSevenAsset or isNyWeekday(time))
bool nyEarlySampleFallbackRequired = fallbackBarValid and nyEarlyModeActive and array.size(nyEarlySampleVolumes) == 0 and fallbackDayAllowed and inNyMinuteWindow(time, NY_EARLY_START_MINUTE, NY_EARLY_END_MINUTE)
bool ivbSampleFallbackRequired = fallbackBarValid and ivbModeActive and array.size(ivbSampleVolumes) == 0 and fallbackDayAllowed and inNyMinuteWindow(time, IVB_START_MINUTE, IVB_END_MINUTE)
if barSampleFallbackRequired or nyEarlySampleFallbackRequired or ivbSampleFallbackRequired
    int fallbackDirection = close > open ? 1 : close < open ? -1 : not na(previousTapeClose) and close > previousTapeClose ? 1 : not na(previousTapeClose) and close < previousTapeClose ? -1 : lastTickDirection
    float fallbackDelta = volume * fallbackDirection
    int fallbackEndTime = na(time_close) ? timenow : time_close
    if barSampleFallbackRequired
        lastTickDirection := fallbackDirection
        previousTapeClose := close
        appendBarSample(barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, high, low, volume, fallbackDelta)
    if nyEarlySampleFallbackRequired
        appendBarSample(nyEarlySampleHighs, nyEarlySampleLows, nyEarlySampleVolumes, nyEarlySampleDeltas, high, low, volume, fallbackDelta)
        nyEarlyWindowObserved := true
        nyEarlyFirstSampleTime := time
        nyEarlyLastSampleEndTime := fallbackEndTime
    if ivbSampleFallbackRequired
        appendBarSample(ivbSampleHighs, ivbSampleLows, ivbSampleVolumes, ivbSampleDeltas, high, low, volume, fallbackDelta)
        ivbWindowObserved := true
        ivbFirstSampleTime := time
        ivbLastSampleEndTime := fallbackEndTime

nyEarlyInSession = nyEarlyWindowObserved
nyEarlySessionStart = nyEarlyInSession and not nyEarlyInSession[1]
nyEarlySessionEnd = not nyEarlyInSession and nyEarlyInSession[1]
ivbInSession = ivbWindowObserved
ivbSessionStart = ivbInSession and not ivbInSession[1]
ivbSessionEnd = not ivbInSession and ivbInSession[1]

// ═══════════════════════════════════════════════════════════════════════════════
// PROCESS
// ═══════════════════════════════════════════════════════════════════════════════
processAnchor(rthModeActive, PREVIOUS_SESSION_RETENTION, rthInSession, rthSessionStart, rthSessionEnd, rthBarHighs, rthBarLows, rthBarVolumes, rthBarDeltas, rthProfiles, rthStartRef, rthLastBarRef, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, false)
processAnchor(globexModeActive, PREVIOUS_SESSION_RETENTION, true, globexDayStart, false, globexBarHighs, globexBarLows, globexBarVolumes, globexBarDeltas, globexProfiles, globexStartRef, globexLastBarRef, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, true)
processBoundedNyAnchor(nyEarlyModeActive, PREVIOUS_SESSION_RETENTION, NY_EARLY_START_MINUTE, NY_EARLY_END_MINUTE, nyEarlyInSession, nyEarlySessionStart, nyEarlySessionEnd, nyEarlyFirstSampleTime, nyEarlyLastSampleEndTime, nyEarlyBarHighs, nyEarlyBarLows, nyEarlyBarVolumes, nyEarlyBarDeltas, nyEarlyProfiles, nyEarlyStartRef, nyEarlyLastBarRef, nyEarlySampleHighs, nyEarlySampleLows, nyEarlySampleVolumes, nyEarlySampleDeltas)
processBoundedNyAnchor(ivbModeActive, PREVIOUS_SESSION_RETENTION, IVB_START_MINUTE, IVB_END_MINUTE, ivbInSession, ivbSessionStart, ivbSessionEnd, ivbFirstSampleTime, ivbLastSampleEndTime, ivbBarHighs, ivbBarLows, ivbBarVolumes, ivbBarDeltas, ivbProfiles, ivbStartRef, ivbLastBarRef, ivbSampleHighs, ivbSampleLows, ivbSampleVolumes, ivbSampleDeltas)
processAnchor(weeklyModeActive, PREVIOUS_SESSION_RETENTION, true, weeklyPeriodStart, false, weeklyBarHighs, weeklyBarLows, weeklyBarVolumes, weeklyBarDeltas, weeklyProfiles, weeklyStartRef, weeklyLastBarRef, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, true)
processAnchor(monthlyModeActive, PREVIOUS_SESSION_RETENTION, true, monthlyPeriodStart, false, monthlyBarHighs, monthlyBarLows, monthlyBarVolumes, monthlyBarDeltas, monthlyProfiles, monthlyStartRef, monthlyLastBarRef, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, true)

bool fixedRangeBarInRange = fixedModeActive and activeRangeConfigured and time >= activeRangeStart and time <= activeRangeEnd
bool rollingBarRetained = rollingModeActive and activeRangeConfigured and time >= activeRangeStart
if rollingModeActive
    pruneRollingSamples(rangeSampleStartKeys, rangeSampleEndKeys, rangeSampleStartTimes, rangeSampleEndTimes, rangeBarHighs, rangeBarLows, rangeBarVolumes, rangeBarDeltas, activeRangeStart)
if barstate.isconfirmed
    if rollingBarRetained
        appendRollingSamples(rangeSampleStartKeys, rangeSampleEndKeys, rangeSampleStartTimes, rangeSampleEndTimes, rangeBarHighs, rangeBarLows, rangeBarVolumes, rangeBarDeltas, time, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, true)
    else if fixedRangeBarInRange
        appendSamples(rangeBarHighs, rangeBarLows, rangeBarVolumes, rangeBarDeltas, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, true)

// ═══════════════════════════════════════════════════════════════════════════════
// SHOW ONLY
// ═══════════════════════════════════════════════════════════════════════════════
inVisibleOvernight = not na(time(timeframe.period, SESSION_WINDOW_OVERNIGHT, NY_TIMEZONE))
inVisibleFrom0500 = not na(time(timeframe.period, SESSION_WINDOW_FROM_0500, NY_TIMEZONE))
inVisibleFrom0830 = not na(time(timeframe.period, SESSION_WINDOW_FROM_0830, NY_TIMEZONE))
inVisibleRth = not na(time(timeframe.period, SESSION_WINDOW_RTH, NY_TIMEZONE))
inVisibleWindow = visibleWindow == WINDOW_LABEL_FROM_0500 ? inVisibleFrom0500 : visibleWindow == WINDOW_LABEL_FROM_0830 ? inVisibleFrom0830 : visibleWindow == WINDOW_LABEL_RTH ? inVisibleRth : inVisibleOvernight
inMostRecentDay = sameCalendarDate(time, timenow, NY_TIMEZONE)
hideThisBar = showOnlyEnabled and not (inVisibleWindow and (not showOnlyMostRecent or inMostRecentDay))

showPanePriceCandles = secondaryPaneMode and showPriceCandlesInPane
paneBodyColor = close >= open ? paneUpBodyColor : paneDownBodyColor
paneBorderColor = close >= open ? paneUpBorderColor : paneDownBorderColor
paneWickColor = close >= open ? paneUpWickColor : paneDownWickColor
hideMainChartCandle = not secondaryPaneMode and hideThisBar
hidePaneCandle = showPanePriceCandles and hideThisBar

plotcandle(showPanePriceCandles ? open : na, high, low, close, title="Pane Price Candles", color=paneBodyColor, bordercolor=paneBorderColor, wickcolor=paneWickColor, editable=false, display=display.pane)
plotcandle(hidePaneCandle ? open : na, high, low, close, title="Pane Hidden", color=hiddenCandleColor, bordercolor=hiddenCandleColor, wickcolor=hiddenCandleColor, editable=false, display=display.pane)
plotcandle(hideMainChartCandle ? open : na, high, low, close, title="Hidden", color=hiddenCandleColor, bordercolor=hiddenCandleColor, wickcolor=hiddenCandleColor, editable=false, display=display.pane, force_overlay=true)

// ═══════════════════════════════════════════════════════════════════════════════
// RENDER
// ═══════════════════════════════════════════════════════════════════════════════
if barstate.islast
    clearDrawings()

    // Temporarily include the open bar without persisting it twice.
    DeltaProfile rangeProfile = na
    if rangeModeActive and activeRangeConfigured
        int originalSize = array.size(rangeBarVolumes)
        if not barstate.isconfirmed
            if rollingBarRetained
                appendRollingSamples(rangeSampleStartKeys, rangeSampleEndKeys, rangeSampleStartTimes, rangeSampleEndTimes, rangeBarHighs, rangeBarLows, rangeBarVolumes, rangeBarDeltas, time, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, false)
            else if fixedRangeBarInRange
                appendSamples(rangeBarHighs, rangeBarLows, rangeBarVolumes, rangeBarDeltas, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, false)
        rangeProfile := rollingModeActive ? buildRollingDeltaProfile(rangeSampleStartTimes, rangeSampleEndTimes, rangeBarHighs, rangeBarLows, rangeBarVolumes, rangeBarDeltas, PROFILE_ROWS, activeRangeStart, activeRangeEnd, rollingThrough == ROLLING_THROUGH_LIVE) : buildDeltaProfile(rangeBarHighs, rangeBarLows, rangeBarVolumes, rangeBarDeltas, PROFILE_ROWS, activeRangeStart, math.min(activeRangeEnd, time))
        while array.size(rangeBarVolumes) > originalSize
            if rollingModeActive
                array.pop(rangeSampleStartKeys)
                array.pop(rangeSampleEndKeys)
                array.pop(rangeSampleStartTimes)
                array.pop(rangeSampleEndTimes)
            array.pop(rangeBarHighs)
            array.pop(rangeBarLows)
            array.pop(rangeBarVolumes)
            array.pop(rangeBarDeltas)

    int nyEarlyDevelopingEndTime = nyEarlyInSession ? math.min(nyEarlyLastSampleEndTime, nyMinuteBoundary(array.get(nyEarlyStartRef, 0), NY_EARLY_END_MINUTE)) : array.get(nyEarlyLastBarRef, 0)
    int ivbDevelopingEndTime = ivbInSession ? math.min(ivbLastSampleEndTime, nyMinuteBoundary(array.get(ivbStartRef, 0), IVB_END_MINUTE)) : array.get(ivbLastBarRef, 0)
    DeltaProfile selectedSessionProfile = na
    DeltaProfile selectedNyEarlyProfile = na
    DeltaProfile selectedIvbProfile = na
    if nyEarlyIvbModeActive
        selectedNyEarlyProfile := selectSessionProfile(previousSessionOffset, nyEarlyInSession, nyEarlyBarHighs, nyEarlyBarLows, nyEarlyBarVolumes, nyEarlyBarDeltas, nyEarlyProfiles, nyEarlyStartRef, nyEarlySampleHighs, nyEarlySampleLows, nyEarlySampleVolumes, nyEarlySampleDeltas, nyEarlyDevelopingEndTime)
        selectedIvbProfile := selectSessionProfile(previousSessionOffset, ivbInSession, ivbBarHighs, ivbBarLows, ivbBarVolumes, ivbBarDeltas, ivbProfiles, ivbStartRef, ivbSampleHighs, ivbSampleLows, ivbSampleVolumes, ivbSampleDeltas, ivbDevelopingEndTime)
    else if rthModeActive
        selectedSessionProfile := selectSessionProfile(previousSessionOffset, rthInSession, rthBarHighs, rthBarLows, rthBarVolumes, rthBarDeltas, rthProfiles, rthStartRef, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, time)
    else if globexModeActive
        selectedSessionProfile := selectSessionProfile(previousSessionOffset, true, globexBarHighs, globexBarLows, globexBarVolumes, globexBarDeltas, globexProfiles, globexStartRef, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, time)
    else if nyEarlyModeActive
        selectedSessionProfile := selectSessionProfile(previousSessionOffset, nyEarlyInSession, nyEarlyBarHighs, nyEarlyBarLows, nyEarlyBarVolumes, nyEarlyBarDeltas, nyEarlyProfiles, nyEarlyStartRef, nyEarlySampleHighs, nyEarlySampleLows, nyEarlySampleVolumes, nyEarlySampleDeltas, nyEarlyDevelopingEndTime)
    else if ivbModeActive
        selectedSessionProfile := selectSessionProfile(previousSessionOffset, ivbInSession, ivbBarHighs, ivbBarLows, ivbBarVolumes, ivbBarDeltas, ivbProfiles, ivbStartRef, ivbSampleHighs, ivbSampleLows, ivbSampleVolumes, ivbSampleDeltas, ivbDevelopingEndTime)
    else if weeklyModeActive
        selectedSessionProfile := selectSessionProfile(previousSessionOffset, true, weeklyBarHighs, weeklyBarLows, weeklyBarVolumes, weeklyBarDeltas, weeklyProfiles, weeklyStartRef, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, time)
    else if monthlyModeActive
        selectedSessionProfile := selectSessionProfile(previousSessionOffset, true, monthlyBarHighs, monthlyBarLows, monthlyBarVolumes, monthlyBarDeltas, monthlyProfiles, monthlyStartRef, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, time)

    if chartTimesBuiltAtBar != bar_index
        cachedChartTimes := recentChartTimes()
        chartTimesBuiltAtBar := bar_index
    array<int> chartTimes = cachedChartTimes
    if rangeModeActive and not na(rangeProfile) and rangeProfile.isValid
        renderRangeOutline(rangeProfile)
        renderSelectedProfile(rangeProfile, activeAnchorName(), rollingModeActive and showProfileBox, false, outlineColor, outlineWidth, rangeLabelSize, rangeLabelColor, rangeShowPrice, chartTimes)
    else if nyEarlyIvbModeActive
        if not na(selectedNyEarlyProfile) and selectedNyEarlyProfile.isValid
            renderSelectedProfile(selectedNyEarlyProfile, "NY Early", true, true, majorOutlineColor, majorOutlineWidth, majorRangeLabelSize, majorRangeLabelColor, majorRangeShowPrice, chartTimes)
        if not na(selectedIvbProfile) and selectedIvbProfile.isValid
            renderSelectedProfile(selectedIvbProfile, "IVB", true, true, minorOutlineColor, minorOutlineWidth, minorRangeLabelSize, minorRangeLabelColor, minorRangeShowPrice, chartTimes)
    else if not na(selectedSessionProfile) and selectedSessionProfile.isValid
        renderSelectedProfile(selectedSessionProfile, activeAnchorName(), true, true, outlineColor, outlineWidth, rangeLabelSize, rangeLabelColor, rangeShowPrice, chartTimes)
    flushPendingOutlierLevels(mergeOverlaps)
    flushPendingRightLines(mergeOverlaps)
    flushPendingRightLabels(mergeOverlaps)

    if showColorTable
        array<ColorRow> colorRows = array.new<ColorRow>()
        if nyEarlyIvbModeActive
            addColorRow(colorRows, "Major Outline", majorOutlineColor, str.tostring(majorOutlineWidth))
            addColorRow(colorRows, "Major Range Text", majorRangeLabelColor, "")
            addColorRow(colorRows, "Minor Outline", minorOutlineColor, str.tostring(minorOutlineWidth))
            addColorRow(colorRows, "Minor Range Text", minorRangeLabelColor, "")
            addColorRow(colorRows, "Major Hidden", majorHiddenCandleColor, "")
        else if outlineMode == OUTLINE_MODE_MAJOR
            addColorRow(colorRows, "Major Outline", majorOutlineColor, str.tostring(majorOutlineWidth))
            addColorRow(colorRows, "Major Range Text", majorRangeLabelColor, "")
            addColorRow(colorRows, "Major Hidden", majorHiddenCandleColor, "")
        else
            addColorRow(colorRows, "Minor Outline", minorOutlineColor, str.tostring(minorOutlineWidth))
            addColorRow(colorRows, "Minor Range Text", minorRangeLabelColor, "")
            addColorRow(colorRows, "Minor Hidden", minorHiddenCandleColor, "")
        addColorRow(colorRows, "Delta Buy Rows", barBuyColor, str.tostring(barWidthPercent) + "%")
        addColorRow(colorRows, "Delta Sell Rows", barSellColor, str.tostring(barWidthPercent) + "%")
        addColorRow(colorRows, "Volume Layer", backdropColor, str.tostring(backdropWidthPercent) + "%")
        addColorRow(colorRows, "Volume Value Area In", backdropInsideColor, str.tostring(backdropWidthPercent) + "%")
        addColorRow(colorRows, "Volume Value Area Out", backdropOutsideColor, str.tostring(backdropWidthPercent) + "%")
        addColorRow(colorRows, "Profile Box", profileBoxColor, "Fill")
        addColorRow(colorRows, "VAH/L Lines", valueAreaLevelColor, str.tostring(valueAreaLevelWidth))
        addColorRow(colorRows, "VAH/L Labels", valueAreaLabelColor, "")
        addColorRow(colorRows, "POC Line", pocLevelColor, str.tostring(pocLevelWidth))
        addColorRow(colorRows, "POC Label", pocLabelColor, "")
        addColorRow(colorRows, "Low Volume Lines + Labels", lowVolumeColor, str.tostring(lowVolumeLineWidth))
        addColorRow(colorRows, "Low Volume Fill", lowVolumeFillColor, "Fill")
        addColorRow(colorRows, "Outlier Buy Rows" + (showLevelTags ? " + Labels" : ""), outlierBuyColor, str.tostring(barWidthPercent) + "%")
        addColorRow(colorRows, "Outlier Sell Rows" + (showLevelTags ? " + Labels" : ""), outlierSellColor, str.tostring(barWidthPercent) + "%")
        string outlierWidthsText = str.tostring(outlierLineWidth) + " / " + str.tostring(strongestOutlierLineWidth) + " strongest"
        addColorRow(colorRows, "Outlier Buy Lines", color.new(outlierBuyColor, FLAG_LINE_TRANSPARENCY), outlierWidthsText)
        addColorRow(colorRows, "Outlier Sell Lines", color.new(outlierSellColor, FLAG_LINE_TRANSPARENCY), outlierWidthsText)
        addColorRow(colorRows, "Buy Zone Fill", color.new(outlierBuyColor, ZONE_FILL_TRANSPARENCY), "")
        addColorRow(colorRows, "Sell Zone Fill", color.new(outlierSellColor, ZONE_FILL_TRANSPARENCY), "")
        addColorRow(colorRows, "Price Label Background", levelLabelBgColor, "")
        if secondaryPaneMode and showPriceCandlesInPane
            addColorRow(colorRows, "Up Body", paneUpBodyColor, "")
            addColorRow(colorRows, "Down Body", paneDownBodyColor, "")
            addColorRow(colorRows, "Up Border", paneUpBorderColor, "")
            addColorRow(colorRows, "Down Border", paneDownBorderColor, "")
            addColorRow(colorRows, "Up Wick", paneUpWickColor, "")
            addColorRow(colorRows, "Down Wick", paneDownWickColor, "")
        if na(colorTable)
            colorTable := table.new(position.top_right, 4, array.size(colorRows) + 1, bgcolor=color.rgb(255, 255, 255), border_width=1, border_color=color.rgb(128, 128, 128), frame_width=1, frame_color=color.rgb(128, 128, 128))
        table.cell(colorTable, 0, 0, LABEL_TABLE_SETTING, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        table.cell(colorTable, 1, 0, LABEL_TABLE_RGB, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        table.cell(colorTable, 2, 0, LABEL_TABLE_TRANSPARENCY, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        table.cell(colorTable, 3, 0, LABEL_TABLE_WIDTH, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        for rowIndex = 0 to array.size(colorRows) - 1
            writeColorRow(colorTable, rowIndex + 1, array.get(colorRows, rowIndex))
    else if not na(colorTable)
        table.delete(colorTable)
        colorTable := na

// legilimens •
