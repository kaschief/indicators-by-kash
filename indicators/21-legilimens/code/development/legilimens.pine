outlierTier5BuyLineColor = input.color(color.new(color.rgb(0, 255, 0), 20), "Line", inline="delta_tier_5_colors", group=GROUP_DELTA_TIERS, active=quickOutlierZones and deltaTierCount >= 1)
outlierTier5SellLineColor = input.color(color.new(color.rgb(245, 65, 81), 18), "", inline="delta_tier_5_colors", group=GROUP_DELTA_TIERS, active=quickOutlierZones and deltaTierCount >= 1)
