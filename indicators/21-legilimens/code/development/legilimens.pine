weeklyExtensionMode = input.string(EXTENSION_TO_OFFSET, "Extension", options=[EXTENSION_TO_OFFSET, EXTENSION_TIMED], inline="weekly_extension", group=GROUP_WEEKLY, active=weeklySelected)
weeklyExtensionHours = input.float(6.0, "Hours", minval=0.0, step=0.5, inline="weekly_extension", group=GROUP_WEEKLY, active=weeklySelected and (weeklyExtensionMode == EXTENSION_TIMED), tooltip=TOOLTIP_EXTENSION_BASE + "weekly close.")
