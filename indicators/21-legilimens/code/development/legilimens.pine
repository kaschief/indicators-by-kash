sessionBoxColor = input.color(color.new(color.rgb(187, 217, 251), 90), "", inline="appearance_session", group=GROUP_APPEARANCE, tooltip="Adds a background fill to each visible profile independently of its border.")
showSessionBorder = input.bool(true, "Session Border", inline="appearance_border", group=GROUP_APPEARANCE)
sessionBoxBorderColor = input.color(color.new(color.rgb(73, 128, 216), 25), "", inline="appearance_border", group=GROUP_APPEARANCE)
sessionBoxBorderWidth = input.int(1, "", options=[1, 2, 3, 4, 5], inline="appearance_border", group=GROUP_APPEARANCE)
sessionBoxBorderStyle = input.string(STYLE_SOLID, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="appearance_border", group=GROUP_APPEARANCE, tooltip="Adds a border to each visible profile independently of its fill. Choose its color, thickness and style.")

