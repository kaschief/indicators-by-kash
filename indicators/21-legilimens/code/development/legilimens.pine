outlierMultiplier = input.float(1.5, "Outlier", minval=0.5, maxval=20.0, step=0.5, group=GROUP_OUTLIERS, tooltip="Controls how selective outlier highlighting is. Higher values identify fewer, stronger delta rows. This affects outlier colors, Outlier-only Show modes, and which rows can receive extended outlier levels.")
outlierFlagsMode = input.string(OUTLIER_FLAGS_BOTH, "Ranked Zones", options=[OUTLIER_FLAGS_BOTH, OUTLIER_FLAGS_BUY, OUTLIER_FLAGS_SELL, OUTLIER_FLAGS_OFF], inline="flag_count", group=GROUP_OUTLIERS)
