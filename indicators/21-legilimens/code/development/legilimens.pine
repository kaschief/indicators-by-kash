// ═══════════════════════════════════════════════════════════════════════════════
showColorTable = input.bool(false, "Show Table", group=GROUP_UTILITY, tooltip="Active colors only.")

fixedRangeConfigured = fixedRangeStartInput > FIXED_RANGE_TIME_UNSET and fixedRangeEndInput > FIXED_RANGE_TIME_UNSET and fixedRangeStartInput != fixedRangeEndInput

// ═══════════════════════════════════════════════════════════════════════════════
// TYPES
// ═══════════════════════════════════════════════════════════════════════════════
type DeltaProfile
    int startTime
    int endTime
    float priceLow
    float priceHigh
    float rangeLow
    float rangeHigh
    int rowCount
    array<float> rowVolumes
    array<float> rowDeltas
    float maxRowVolume
    float maxAbsRowDelta
    bool isValid

type ProfileSelection
    array<DeltaProfile> profiles
    int currentIndex
    bool currentDeveloping

type PendingOutlierLevel
    float price
    float zoneLow
    float zoneHigh
    float delta
    float strength
    bool buySide
    int lineStartTime
    int rightTime
    int markerTime
    string sourceName
    int tradingDayKey
    bool historical

type LowVolumeCandidate
    float price
    float zoneLow
    float zoneHigh
    float strength
    bool isLvn

type PendingRightLabel
    float price
    int markerTime
    color textColor
    int textSize

type PendingRightLine
    float price
    int leftTime
    int rightTime
    color lineColor
    int lineWidth
    string styleName
    int rank
    string sourceName
    int tradingDayKey
    bool historical
    int direction

type ColorRow
    string name
    color swatchColor
    string widthText

type DeltaTierAppearance
    bool hasLine
    color lineColor
    int lineWidth
    string lineStyle
    color textColor
    color zoneColor

appendDeltaTierPair(array<DeltaTierAppearance> appearances, bool hasLine, color buyLineColor, color sellLineColor, int lineWidth, string lineStyle, color buyTextColor, color sellTextColor, color buyZoneColor, color sellZoneColor) =>
    array.push(appearances, DeltaTierAppearance.new(hasLine, buyLineColor, lineWidth, lineStyle, buyTextColor, buyZoneColor))
    array.push(appearances, DeltaTierAppearance.new(hasLine, sellLineColor, lineWidth, lineStyle, sellTextColor, sellZoneColor))

var array<int> tierMarkerSizes = array.from(TIER_5_MARKER_SIZE, TIER_4_MARKER_SIZE, TIER_3_MARKER_SIZE, TIER_2_MARKER_SIZE, TIER_1_MARKER_SIZE)

var array<DeltaTierAppearance> deltaTierAppearances = array.new<DeltaTierAppearance>()
var array<DeltaTierAppearance> extendedAltDeltaTierAppearances = array.new<DeltaTierAppearance>()
if barstate.isfirst
    appendDeltaTierPair(deltaTierAppearances, true, deltaTier5BuyLineColor, deltaTier5SellLineColor, DELTA_TIER_5_LINE_WIDTH, STYLE_DASHED, deltaTier5BuyTextColor, deltaTier5SellTextColor, deltaTier5BuyZoneColor, deltaTier5SellZoneColor)
    appendDeltaTierPair(deltaTierAppearances, true, deltaTier4BuyLineColor, deltaTier4SellLineColor, DELTA_TIER_4_LINE_WIDTH, STYLE_DASHED, deltaTier4BuyTextColor, deltaTier4SellTextColor, deltaTier4BuyZoneColor, deltaTier4SellZoneColor)
    appendDeltaTierPair(deltaTierAppearances, false, color(na), color(na), 1, STYLE_SOLID, deltaTier3BuyTextColor, deltaTier3SellTextColor, deltaTier3BuyZoneColor, deltaTier3SellZoneColor)
    appendDeltaTierPair(deltaTierAppearances, false, color(na), color(na), 1, STYLE_SOLID, deltaTier2BuyTextColor, deltaTier2SellTextColor, deltaTier2BuyZoneColor, deltaTier2SellZoneColor)
    appendDeltaTierPair(deltaTierAppearances, false, color(na), color(na), 1, STYLE_SOLID, deltaTier1BuyTextColor, deltaTier1SellTextColor, deltaTier1BuyZoneColor, deltaTier1SellZoneColor)

    appendDeltaTierPair(extendedAltDeltaTierAppearances, true, extendedAltTier5BuyLineColor, extendedAltTier5SellLineColor, DELTA_TIER_5_LINE_WIDTH, STYLE_DASHED, extendedAltTier5BuyTextColor, extendedAltTier5SellTextColor, extendedAltTier5BuyZoneColor, extendedAltTier5SellZoneColor)
    appendDeltaTierPair(extendedAltDeltaTierAppearances, true, extendedAltTier4BuyLineColor, extendedAltTier4SellLineColor, DELTA_TIER_4_LINE_WIDTH, STYLE_DASHED, extendedAltTier4BuyTextColor, extendedAltTier4SellTextColor, extendedAltTier4BuyZoneColor, extendedAltTier4SellZoneColor)
    appendDeltaTierPair(extendedAltDeltaTierAppearances, false, color(na), color(na), 1, STYLE_SOLID, extendedAltTier3BuyTextColor, extendedAltTier3SellTextColor, extendedAltTier3BuyZoneColor, extendedAltTier3SellZoneColor)
    appendDeltaTierPair(extendedAltDeltaTierAppearances, false, color(na), color(na), 1, STYLE_SOLID, extendedAltTier2BuyTextColor, extendedAltTier2SellTextColor, extendedAltTier2BuyZoneColor, extendedAltTier2SellZoneColor)
    appendDeltaTierPair(extendedAltDeltaTierAppearances, false, color(na), color(na), 1, STYLE_SOLID, extendedAltTier1BuyTextColor, extendedAltTier1SellTextColor, extendedAltTier1BuyZoneColor, extendedAltTier1SellZoneColor)

// ═══════════════════════════════════════════════════════════════════════════════
// CALCULATION
// ═══════════════════════════════════════════════════════════════════════════════
deltaPolylineLayersPerProfile(string visibleRows, bool outliersOnly) =>
    int visibleSides = visibleRows == OPTION_OFF ? 0 : visibleRows == OPTION_ALL ? 2 : 1
    int layersPerSide = outliersOnly ? 1 : DELTA_POLYLINE_LAYER_COUNT_PER_SIDE
    visibleSides * layersPerSide

budgetedHistoricalDays(int requestedDays, int sourceCount, int deltaLayersPerProfile) =>
    int result = requestedDays
    if sourceCount > 0 and deltaLayersPerProfile > 0
        int profilesPerSource = int(math.floor(INDICATOR_MAX_POLYLINES / float(sourceCount * deltaLayersPerProfile)))
        result := math.min(requestedDays, math.max(0, profilesPerSource - 1))
    result

int activeProfileSourceCount = (nyEarlyModeActive ? 1 : 0) + (extendedNyEarlyModeActive ? 1 : 0) + (ivbModeActive ? 1 : 0) + (rthModeActive ? 1 : 0) + (globexSelected ? 1 : 0) + (weeklySelected ? 1 : 0) + (monthlySelected ? 1 : 0) + (rollingSelected ? 1 : 0) + (fixedSelected ? 1 : 0)
int activeDeltaPolylineLayers = deltaPolylineLayersPerProfile(deltaHistogramRows, showOutliersOnly)
int renderedHistoricalDays = budgetedHistoricalDays(historicalDaysToShow, activeProfileSourceCount, activeDeltaPolylineLayers)

autoIntrabarTimeframe() =>
    float chartSeconds = timeframe.in_seconds(timeframe.period)
    chart.is_range ? INTRABAR_TIMEFRAME_ONE_MINUTE : chartSeconds <= SECONDS_PER_MINUTE ? INTRABAR_TIMEFRAME_ONE_SECOND : chartSeconds <= 15 * SECONDS_PER_MINUTE ? INTRABAR_TIMEFRAME_ONE_MINUTE : chartSeconds <= 60 * SECONDS_PER_MINUTE ? INTRABAR_TIMEFRAME_FIVE_MINUTES : chartSeconds <= 4 * 60 * SECONDS_PER_MINUTE ? INTRABAR_TIMEFRAME_FIFTEEN_MINUTES : INTRABAR_TIMEFRAME_ONE_HOUR

clampRow(float rawRow, int rowCount) =>
    math.max(0, math.min(rowCount - 1, int(math.floor(rawRow))))

sameCalendarDate(int firstTime, int secondTime, string timezone) =>
    year(firstTime, timezone) == year(secondTime, timezone) and month(firstTime, timezone) == month(secondTime, timezone) and dayofmonth(firstTime, timezone) == dayofmonth(secondTime, timezone)

toLineStyle(string styleName) =>
    styleName == STYLE_DASHED ? line.style_dashed : styleName == STYLE_DOTTED ? line.style_dotted : line.style_solid

toLabelSize(string sizeName) =>
    sizeName == LABEL_SIZE_TINY ? size.tiny : sizeName == LABEL_SIZE_NORMAL ? size.normal : sizeName == LABEL_SIZE_LARGE ? size.large : sizeName == LABEL_SIZE_HUGE ? size.huge : size.small

labelPointSize(string sizeName) =>
    sizeName == LABEL_SIZE_TINY ? 7.0 : sizeName == LABEL_SIZE_SMALL ? 10.0 : sizeName == LABEL_SIZE_NORMAL ? 12.0 : sizeName == LABEL_SIZE_LARGE ? 18.0 : 24.0

rangeTitleLayout(DeltaProfile profile, string sizeName) =>
    float pricePerLayoutUnit = (profile.rangeHigh - profile.rangeLow) / profile.rowCount
    float titleClearance = pricePerLayoutUnit * (labelPointSize(sizeName) + RANGE_TITLE_CONTAINER_PADDING)
    [profile.rangeHigh, profile.rangeLow, titleClearance]

quarterDurationValue(float duration) =>
    duration > 0 ? math.max(0.25, math.round(duration * 4.0) / 4.0) : 0.0

formatQuarterDuration(float duration) =>
    str.tostring(quarterDurationValue(duration), "#.##")

formatFixedRangeDuration(int firstTime, int secondTime) =>
    int durationMs = math.abs(secondTime - firstTime)
    float durationMinutes = float(durationMs) / MS_PER_MINUTE
    float durationHours = float(durationMs) / MS_PER_HOUR
    float durationDays = durationHours / 24.0
    quarterDurationValue(durationHours) >= 24.0 ? formatQuarterDuration(durationDays) + "-Day" : durationHours >= 1.0 or quarterDurationValue(durationMinutes) >= 60.0 ? formatQuarterDuration(durationHours) + "-Hour" : formatQuarterDuration(durationMinutes) + "-Minute"

profileDisplayName(string sourceName) =>
    sourceName == SOURCE_FIXED ? PROFILE_EMOJI_FIXED + formatFixedRangeDuration(fixedRangeStartInput, fixedRangeEndInput) + " " + PROFILE_NAME_FIXED : sourceName == SOURCE_ROLLING ? "Rolling " + rollingLookbackTag + " Range" : sourceName

activeAnchorName() =>
    anchorMode == MODE_ROLLING ? SOURCE_ROLLING : anchorMode == MODE_NY_EARLY ? SOURCE_NY_EARLY : anchorMode == MODE_EXTENDED_NY_EARLY ? SOURCE_EXTENDED_NY_EARLY : anchorMode == MODE_IVB ? SOURCE_IVB : anchorMode == MODE_NY_EARLY_IVB ? SOURCE_NY_EARLY_IVB : anchorMode == MODE_NY_EARLY_IVB_RTH ? SOURCE_NY_EARLY_IVB_RTH : anchorMode == MODE_RTH ? SOURCE_RTH : anchorMode == MODE_GLOBEX ? SOURCE_GLOBEX : anchorMode == MODE_WEEKLY ? SOURCE_WEEKLY : anchorMode == MODE_MONTHLY ? SOURCE_MONTHLY : ""

isTrueWeekendBar(int barTime) =>
    int barDay = dayofweek(barTime, NY_TIMEZONE)
    int barHour = hour(barTime, NY_TIMEZONE)
    barDay == dayofweek.saturday or (barDay == dayofweek.sunday and barHour < SUNDAY_REOPEN_START_HOUR)

calendarDayStart(string timezone) =>
    ta.change(dayofmonth(time, timezone)) != 0

shiftedCalendarDayStart(string timezone, int timeShiftMilliseconds) =>
    ta.change(dayofmonth(time + timeShiftMilliseconds, timezone)) != 0

shiftedCalendarMonthStart(string timezone, int timeShiftMilliseconds) =>
    ta.change(month(time + timeShiftMilliseconds, timezone)) != 0

weeklyBoundary(bool twentyFourSeven, bool utcBoundary, bool futuresBoundary, int barTime) =>
    twentyFourSeven ? utcBoundary and dayofweek(barTime, UTC_TIMEZONE) == dayofweek.monday : futuresBoundary and dayofweek(barTime, NY_TIMEZONE) == dayofweek.sunday

isNyWeekday(int barTime) =>
    int weekday = dayofweek(barTime, NY_TIMEZONE)
    weekday >= dayofweek.monday and weekday <= dayofweek.friday

inNyMinuteWindow(int barTime, int startMinute, int endMinute) =>
    int barMinute = hour(barTime, NY_TIMEZONE) * 60 + minute(barTime, NY_TIMEZONE)
    barMinute >= startMinute and barMinute < endMinute

nyMinuteBoundary(int referenceTime, int minuteOfDay) =>
    timestamp(NY_TIMEZONE, year(referenceTime, NY_TIMEZONE), month(referenceTime, NY_TIMEZONE), dayofmonth(referenceTime, NY_TIMEZONE), int(math.floor(minuteOfDay / 60)), minuteOfDay % 60)

barFitsNyMinuteWindow(int barTime, int barEndTime, int startMinute, int endMinute) =>
    inNyMinuteWindow(barTime, startMinute, endMinute) and not na(barEndTime) and barEndTime <= nyMinuteBoundary(barTime, endMinute)

nextCalendarDayBoundary(int referenceTime, string timezone, int boundaryHour, int boundaryMinute) =>
    timestamp(timezone, year(referenceTime, timezone), month(referenceTime, timezone), dayofmonth(referenceTime, timezone) + 1, boundaryHour, boundaryMinute)

nextCalendarWeekBoundary(int referenceTime, string timezone, int boundaryHour, int boundaryMinute) =>
    timestamp(timezone, year(referenceTime, timezone), month(referenceTime, timezone), dayofmonth(referenceTime, timezone) + 7, boundaryHour, boundaryMinute)

nextShiftedMonthBoundary(int referenceTime, string timezone, int shiftMilliseconds) =>
    int shiftedReference = referenceTime + shiftMilliseconds
    int currentYear = year(shiftedReference, timezone)
    int currentMonth = month(shiftedReference, timezone)
    int nextYear = currentMonth == 12 ? currentYear + 1 : currentYear
    int nextMonth = currentMonth == 12 ? 1 : currentMonth + 1
    timestamp(timezone, nextYear, nextMonth, 1, 0, 0) - shiftMilliseconds

sessionOccurrenceClose(string sourceName, DeltaProfile profile, bool twentyFourSeven, bool developing) =>
    int closeTime = profile.endTime
    if sourceName == SOURCE_NY_EARLY
        closeTime := nyMinuteBoundary(profile.startTime, NY_EARLY_END_MINUTE)
    else if sourceName == SOURCE_EXTENDED_NY_EARLY
        int nominalCloseTime = nyMinuteBoundary(profile.startTime, IVB_START_MINUTE)
        closeTime := profile.endTime > nominalCloseTime ? nyMinuteBoundary(profile.startTime, EXTENDED_NY_EARLY_OPENING_END_MINUTE) : nominalCloseTime
    else if sourceName == SOURCE_IVB
        closeTime := nyMinuteBoundary(profile.startTime, IVB_END_MINUTE)
    else if sourceName == SOURCE_RTH
        closeTime := developing ? nyMinuteBoundary(profile.startTime, 16 * 60) : profile.endTime
    else if sourceName == SOURCE_GLOBEX
        closeTime := twentyFourSeven ? nextCalendarDayBoundary(profile.startTime, UTC_TIMEZONE, 0, 0) : nextCalendarDayBoundary(profile.startTime, NY_TIMEZONE, 18, 0)
    else if sourceName == SOURCE_WEEKLY
        closeTime := twentyFourSeven ? nextCalendarWeekBoundary(profile.startTime, UTC_TIMEZONE, 0, 0) : nextCalendarWeekBoundary(profile.startTime, NY_TIMEZONE, 18, 0)
    else if sourceName == SOURCE_MONTHLY
        closeTime := twentyFourSeven ? nextShiftedMonthBoundary(profile.startTime, UTC_TIMEZONE, 0) : nextShiftedMonthBoundary(profile.startTime, NY_TIMEZONE, GLOBEX_REOPEN_SHIFT_MS)
    closeTime

profileHours(string sourceName) =>
    sourceName == SOURCE_NY_EARLY ? nyEarlyHours : sourceName == SOURCE_EXTENDED_NY_EARLY ? extendedNyEarlyHours : sourceName == SOURCE_IVB ? ivbHours : sourceName == SOURCE_RTH ? rthHours : sourceName == SOURCE_GLOBEX ? globexHours : sourceName == SOURCE_WEEKLY ? weeklyHours : sourceName == SOURCE_MONTHLY ? monthlyHours : sourceName == SOURCE_ROLLING ? rollingHours : fixedHours

profileOuterColor(string sourceName) =>
    sourceName == SOURCE_NY_EARLY ? nyEarlyOuterColor : sourceName == SOURCE_EXTENDED_NY_EARLY ? extendedNyEarlyOuterColor : sourceName == SOURCE_IVB ? ivbOuterColor : sourceName == SOURCE_RTH ? rthOuterColor : sourceName == SOURCE_GLOBEX ? globexOuterColor : sourceName == SOURCE_WEEKLY ? weeklyOuterColor : sourceName == SOURCE_MONTHLY ? monthlyOuterColor : sourceName == SOURCE_ROLLING ? rollingOuterColor : fixedOuterColor

profileInnerColor(string sourceName) =>
    sourceName == SOURCE_NY_EARLY ? nyEarlyInnerColor : sourceName == SOURCE_EXTENDED_NY_EARLY ? extendedNyEarlyInnerColor : sourceName == SOURCE_IVB ? ivbInnerColor : sourceName == SOURCE_RTH ? rthInnerColor : sourceName == SOURCE_GLOBEX ? globexInnerColor : sourceName == SOURCE_WEEKLY ? weeklyInnerColor : sourceName == SOURCE_MONTHLY ? monthlyInnerColor : sourceName == SOURCE_ROLLING ? rollingInnerColor : fixedInnerColor

profileRangeLabelColor(string sourceName) =>
    sourceName == SOURCE_NY_EARLY ? nyEarlyRangeLabelColor : sourceName == SOURCE_EXTENDED_NY_EARLY ? extendedNyEarlyRangeLabelColor : sourceName == SOURCE_IVB ? ivbRangeLabelColor : sourceName == SOURCE_RTH ? rthRangeLabelColor : sourceName == SOURCE_GLOBEX ? globexRangeLabelColor : sourceName == SOURCE_WEEKLY ? weeklyRangeLabelColor : sourceName == SOURCE_MONTHLY ? monthlyRangeLabelColor : sourceName == SOURCE_ROLLING ? rollingRangeLabelColor : fixedRangeLabelColor

profileRangeLabelSize(string sourceName) =>
    sourceName == SOURCE_NY_EARLY ? nyEarlyRangeLabelSize : sourceName == SOURCE_EXTENDED_NY_EARLY ? extendedNyEarlyRangeLabelSize : sourceName == SOURCE_IVB ? ivbRangeLabelSize : sourceName == SOURCE_RTH ? rthRangeLabelSize : sourceName == SOURCE_GLOBEX ? globexRangeLabelSize : sourceName == SOURCE_WEEKLY ? weeklyRangeLabelSize : sourceName == SOURCE_MONTHLY ? monthlyRangeLabelSize : sourceName == SOURCE_ROLLING ? rollingRangeLabelSize : fixedRangeLabelSize

profilePosition(string sourceName) =>
    sourceName == SOURCE_NY_EARLY ? nyEarlyProfilePosition : sourceName == SOURCE_EXTENDED_NY_EARLY ? extendedNyEarlyProfilePosition : sourceName == SOURCE_IVB ? ivbProfilePosition : sourceName == SOURCE_RTH ? rthProfilePosition : sourceName == SOURCE_GLOBEX ? globexProfilePosition : sourceName == SOURCE_WEEKLY ? weeklyProfilePosition : sourceName == SOURCE_MONTHLY ? monthlyProfilePosition : sourceName == SOURCE_ROLLING ? rollingProfilePosition : fixedProfilePosition

usesExtendedAlternateStyles(string sourceName) =>
    sourceName == SOURCE_EXTENDED_NY_EARLY and useExtendedNyEarlyAlternateStyles

profileDeltaHistogramWidthPercent(string sourceName) =>
    if chart.is_range
        sourceName == SOURCE_NY_EARLY ? nyEarlyRangeDeltaHistogramWidthPercent : sourceName == SOURCE_EXTENDED_NY_EARLY ? extendedNyEarlyRangeDeltaHistogramWidthPercent : sourceName == SOURCE_IVB ? ivbRangeDeltaHistogramWidthPercent : sourceName == SOURCE_RTH ? rthRangeDeltaHistogramWidthPercent : sourceName == SOURCE_GLOBEX ? globexRangeDeltaHistogramWidthPercent : sourceName == SOURCE_WEEKLY ? weeklyRangeDeltaHistogramWidthPercent : sourceName == SOURCE_MONTHLY ? monthlyRangeDeltaHistogramWidthPercent : sourceName == SOURCE_ROLLING ? rollingRangeDeltaHistogramWidthPercent : fixedRangeDeltaHistogramWidthPercent
    else
        sourceName == SOURCE_NY_EARLY ? nyEarlyDeltaHistogramWidthPercent : sourceName == SOURCE_EXTENDED_NY_EARLY ? extendedNyEarlyDeltaHistogramWidthPercent : sourceName == SOURCE_IVB ? ivbDeltaHistogramWidthPercent : sourceName == SOURCE_RTH ? rthDeltaHistogramWidthPercent : sourceName == SOURCE_GLOBEX ? globexDeltaHistogramWidthPercent : sourceName == SOURCE_WEEKLY ? weeklyDeltaHistogramWidthPercent : sourceName == SOURCE_MONTHLY ? monthlyDeltaHistogramWidthPercent : sourceName == SOURCE_ROLLING ? rollingDeltaHistogramWidthPercent : fixedDeltaHistogramWidthPercent

profileDeltaPlusColor(string sourceName) =>
    usesExtendedAlternateStyles(sourceName) ? extendedAltDeltaPlusColor : deltaPlusColor

profileDeltaMinusColor(string sourceName) =>
    usesExtendedAlternateStyles(sourceName) ? extendedAltDeltaMinusColor : deltaMinusColor

profileDeltaPlusPlusColor(string sourceName) =>
    usesExtendedAlternateStyles(sourceName) ? extendedAltDeltaPlusPlusColor : deltaPlusPlusColor

profileDeltaMinusMinusColor(string sourceName) =>
    usesExtendedAlternateStyles(sourceName) ? extendedAltDeltaMinusMinusColor : deltaMinusMinusColor

profileValueAreaLevelColor(string sourceName) =>
    usesExtendedAlternateStyles(sourceName) ? extendedAltValueAreaLevelColor : valueAreaLevelColor

profilePocLevelColor(string sourceName) =>
    usesExtendedAlternateStyles(sourceName) ? extendedAltPocLevelColor : pocLevelColor

profilePocLabelColor(string sourceName) =>
    usesExtendedAlternateStyles(sourceName) ? extendedAltPocLabelColor : pocLabelColor

profileLowVolumeCliffLineColor(string sourceName) =>
    usesExtendedAlternateStyles(sourceName) ? extendedAltLowVolumeCliffLineColor : lowVolumeCliffLineColor

profileLowVolumeTextColor(string sourceName) =>
    usesExtendedAlternateStyles(sourceName) ? extendedAltLowVolumeTextColor : lowVolumeTextColor

profileLowVolumeZoneColor(string sourceName) =>
    usesExtendedAlternateStyles(sourceName) ? extendedAltLowVolumeZoneColor : lowVolumeZoneColor

profileTextBackgroundColor(string sourceName) =>
    usesExtendedAlternateStyles(sourceName) ? extendedAltTextBackgroundColor : textBackgroundColor

// Range/tick charts infer span from recent bars.
barSpanMs() =>
    int spanMs = nz(timeframe.in_seconds(timeframe.period)) * 1000
    if spanMs <= 0
        for lookback = 0 to OFFSET_SPAN_LOOKBACK - 1
            int gap = nz(time[lookback] - time[lookback + 1])
            if gap > 0 and (spanMs <= 0 or gap < spanMs)
                spanMs := gap
    math.max(1, spanMs)

labelClearanceMs() =>
    int(math.round(DOT_MARKER_OFFSET_BARS * barSpanMs()))

pocLabelOffsetMs() =>
    int(math.round(POC_LABEL_OFFSET_BARS * barSpanMs()))

sessionLevelEndpoint(string sourceName, int sessionCloseTime) =>
    sessionCloseTime + int(math.round(profileHours(sourceName) * MS_PER_HOUR))

// Bar midpoint ignores time gaps.
rangeCenterTime(DeltaProfile profile, array<int> chartTimes, int startScaleIndex, int endScaleIndex) =>
    int centerTime = profile.startTime + int(math.round((profile.endTime - profile.startTime) * 0.5))
    if startScaleIndex >= 0 and endScaleIndex >= 0
        centerTime := array.get(chartTimes, int(math.round((startScaleIndex + endScaleIndex) * 0.5)))
    centerTime

levelMarkerTime(int levelEndTime) =>
    levelEndTime + labelClearanceMs()

tradingDayKey(int sessionCloseTime) =>
    year(sessionCloseTime, NY_TIMEZONE) * 10000 + month(sessionCloseTime, NY_TIMEZONE) * 100 + dayofmonth(sessionCloseTime, NY_TIMEZONE)

previousNyCutoff(int cutoffTime, int cutoffHour, int cutoffMinute) =>
    int previousDateReference = cutoffTime - MS_PER_DAY
    timestamp(NY_TIMEZONE, year(previousDateReference, NY_TIMEZONE), month(previousDateReference, NY_TIMEZONE), dayofmonth(previousDateReference, NY_TIMEZONE), cutoffHour, cutoffMinute)

// Preserve NY clock time across DST.
lookbackDaysStart(int endTime, int days, bool twentyFourSeven) =>
    int startTime = endTime
    int countedDays = 0
    if not na(endTime)
        int anchorHour = hour(endTime, NY_TIMEZONE)
        int anchorMinute = minute(endTime, NY_TIMEZONE)
        while countedDays < days
            startTime := previousNyCutoff(startTime, anchorHour, anchorMinute)
            int startDay = dayofweek(startTime, NY_TIMEZONE)
            if twentyFourSeven or (startDay != dayofweek.saturday and startDay != dayofweek.sunday)
                countedDays += 1
    startTime

rollingThroughTime(int referenceTime, string throughMode, bool twentyFourSeven) =>
    int endTime = referenceTime
    if (throughMode == ROLLING_THROUGH_LIVE_MINUS_2H or throughMode == ROLLING_THROUGH_LIVE_MINUS_4H) and not na(referenceTime)
        int liveOffsetHours = throughMode == ROLLING_THROUGH_LIVE_MINUS_2H ? 2 : 4
        endTime := referenceTime - liveOffsetHours * MS_PER_HOUR
    else if throughMode != ROLLING_THROUGH_LIVE and not na(referenceTime)
        int cutoffHour = throughMode == ROLLING_THROUGH_0000 ? 0 : throughMode == ROLLING_THROUGH_0500 ? 5 : throughMode == ROLLING_THROUGH_0830 ? 8 : throughMode == ROLLING_THROUGH_0930 ? 9 : 16
        int cutoffMinute = throughMode == ROLLING_THROUGH_0830 or throughMode == ROLLING_THROUGH_0930 ? 30 : 0
        endTime := timestamp(NY_TIMEZONE, year(referenceTime, NY_TIMEZONE), month(referenceTime, NY_TIMEZONE), dayofmonth(referenceTime, NY_TIMEZONE), cutoffHour, cutoffMinute)
        if endTime > referenceTime
            endTime := previousNyCutoff(endTime, cutoffHour, cutoffMinute)
        if not twentyFourSeven
            int cutoffDay = dayofweek(endTime, NY_TIMEZONE)
            while cutoffDay == dayofweek.saturday or cutoffDay == dayofweek.sunday
                endTime := previousNyCutoff(endTime, cutoffHour, cutoffMinute)
                cutoffDay := dayofweek(endTime, NY_TIMEZONE)
    endTime

tierMarkerSize(array<int> markerSizes, int tier) =>
    array.get(markerSizes, math.max(0, math.min(4, 5 - tier)))

deltaTierAppearance(bool buySide, int tier, string sourceName) =>
    int tierIndex = math.max(0, math.min(4, 5 - tier))
    int appearanceIndex = tierIndex * 2 + (buySide ? 0 : 1)
    usesExtendedAlternateStyles(sourceName) ? array.get(extendedAltDeltaTierAppearances, appearanceIndex) : array.get(deltaTierAppearances, appearanceIndex)

deltaTierSideVisible(bool buySide) =>
    deltaTierSideVisibility != OPTION_OFF and (deltaTierSideVisibility == OPTION_ALL or (buySide and deltaTierSideVisibility == DELTA_TIER_VISIBILITY_BUY) or (not buySide and deltaTierSideVisibility == DELTA_TIER_VISIBILITY_SELL))

// Bound memory with finer-than-display bins.
compactSamples(array<float> highs, array<float> lows, array<float> volumes, array<float> deltas) =>
    int sampleCount = array.size(volumes)
    if sampleCount > 0
        float rawHigh = array.max(highs)
        float rawLow = array.min(lows)
        float priceSpan = math.max(rawHigh - rawLow, syminfo.mintick * SAMPLE_COMPACT_ROWS)
        float compactLow = rawHigh == rawLow ? rawLow - priceSpan * 0.5 : rawLow
        float rowHeight = priceSpan / SAMPLE_COMPACT_ROWS
        array<float> rowVolumes = array.new<float>(SAMPLE_COMPACT_ROWS, 0.0)
        array<float> rowDeltas = array.new<float>(SAMPLE_COMPACT_ROWS, 0.0)
        for sampleIndex = 0 to sampleCount - 1
            float sampleHigh = array.get(highs, sampleIndex)
            float sampleLow = array.get(lows, sampleIndex)
            float sampleVolume = array.get(volumes, sampleIndex)
            float sampleDelta = array.get(deltas, sampleIndex)
            int firstRow = clampRow((sampleLow - compactLow) / rowHeight, SAMPLE_COMPACT_ROWS)
            int lastRow = clampRow((sampleHigh - compactLow) / rowHeight, SAMPLE_COMPACT_ROWS)
            int coveredRows = math.max(1, lastRow - firstRow + 1)
            float volumePerRow = sampleVolume / coveredRows
            float deltaPerRow = sampleDelta / coveredRows
            for rowIndex = firstRow to lastRow
                array.set(rowVolumes, rowIndex, array.get(rowVolumes, rowIndex) + volumePerRow)
                array.set(rowDeltas, rowIndex, array.get(rowDeltas, rowIndex) + deltaPerRow)
        array.clear(highs)
        array.clear(lows)
        array.clear(volumes)
        array.clear(deltas)
        for rowIndex = 0 to SAMPLE_COMPACT_ROWS - 1
            float rowVolume = array.get(rowVolumes, rowIndex)
            if rowVolume > 0
                float rowPrice = compactLow + (rowIndex + 0.5) * rowHeight
                array.push(highs, rowPrice)
                array.push(lows, rowPrice)
                array.push(volumes, rowVolume)
                array.push(deltas, array.get(rowDeltas, rowIndex))

compactIfNeeded(array<float> highs, array<float> lows, array<float> volumes, array<float> deltas) =>
    if array.size(volumes) > SAMPLE_COMPACT_THRESHOLD
        compactSamples(highs, lows, volumes, deltas)

clearSamples(array<float> highs, array<float> lows, array<float> volumes, array<float> deltas) =>
    array.clear(highs)
    array.clear(lows)
    array.clear(volumes)
    array.clear(deltas)

appendSamples(array<float> destHighs, array<float> destLows, array<float> destVolumes, array<float> destDeltas, array<float> sourceHighs, array<float> sourceLows, array<float> sourceVolumes, array<float> sourceDeltas, bool compactAfter) =>
    int sampleCount = array.size(sourceVolumes)
    if sampleCount > 0
        for sampleIndex = 0 to sampleCount - 1
            array.push(destHighs, array.get(sourceHighs, sampleIndex))
            array.push(destLows, array.get(sourceLows, sampleIndex))
            array.push(destVolumes, array.get(sourceVolumes, sampleIndex))
            array.push(destDeltas, array.get(sourceDeltas, sampleIndex))
    if compactAfter
        compactIfNeeded(destHighs, destLows, destVolumes, destDeltas)

appendBarSample(array<float> highs, array<float> lows, array<float> volumes, array<float> deltas, float sampleHigh, float sampleLow, float sampleVolume, float sampleDelta) =>
    array.push(highs, sampleHigh)
    array.push(lows, sampleLow)
    array.push(volumes, sampleVolume)
    array.push(deltas, sampleDelta)

// NY date + cutoff segment key.
rollingSegmentKey(int sampleTime) =>
    int nyMinutes = hour(sampleTime, NY_TIMEZONE) * 60 + minute(sampleTime, NY_TIMEZONE)
    int segment = nyMinutes < 5 * 60 ? 0 : nyMinutes < 8 * 60 + 30 ? 1 : nyMinutes < 9 * 60 + 30 ? 2 : nyMinutes < 16 * 60 ? 3 : 4
    (year(sampleTime, NY_TIMEZONE) * 10000 + month(sampleTime, NY_TIMEZONE) * 100 + dayofmonth(sampleTime, NY_TIMEZONE)) * 10 + segment

compactRollingSamples(array<int> startKeys, array<int> endKeys, array<int> startTimes, array<int> endTimes, array<float> highs, array<float> lows, array<float> volumes, array<float> deltas) =>
    int sampleCount = array.size(volumes)
    if sampleCount > ROLLING_SAMPLE_COMPACT_THRESHOLD
        int writeIndex = 0
        int readIndex = 0
        while readIndex < sampleCount
            int nextIndex = readIndex + 1
            bool mergeNext = nextIndex < sampleCount and array.get(endKeys, readIndex) == array.get(startKeys, nextIndex)
            array.set(startKeys, writeIndex, array.get(startKeys, readIndex))
            array.set(endKeys, writeIndex, mergeNext ? array.get(endKeys, nextIndex) : array.get(endKeys, readIndex))
            array.set(startTimes, writeIndex, array.get(startTimes, readIndex))
            array.set(endTimes, writeIndex, mergeNext ? array.get(endTimes, nextIndex) : array.get(endTimes, readIndex))
            array.set(highs, writeIndex, mergeNext ? math.max(array.get(highs, readIndex), array.get(highs, nextIndex)) : array.get(highs, readIndex))
            array.set(lows, writeIndex, mergeNext ? math.min(array.get(lows, readIndex), array.get(lows, nextIndex)) : array.get(lows, readIndex))
            array.set(volumes, writeIndex, array.get(volumes, readIndex) + (mergeNext ? array.get(volumes, nextIndex) : 0.0))
            array.set(deltas, writeIndex, array.get(deltas, readIndex) + (mergeNext ? array.get(deltas, nextIndex) : 0.0))
            writeIndex += 1
            readIndex += mergeNext ? 2 : 1
        while array.size(volumes) > writeIndex
            array.pop(startKeys)
            array.pop(endKeys)
            array.pop(startTimes)
            array.pop(endTimes)
            array.pop(highs)
            array.pop(lows)
            array.pop(volumes)
            array.pop(deltas)

appendRollingSamples(array<int> destStartKeys, array<int> destEndKeys, array<int> destStartTimes, array<int> destEndTimes, array<float> destHighs, array<float> destLows, array<float> destVolumes, array<float> destDeltas, int sampleTime, array<float> sourceHighs, array<float> sourceLows, array<float> sourceVolumes, array<float> sourceDeltas, bool compactAfter) =>
    int sampleCount = array.size(sourceVolumes)
    if sampleCount > 0
        int sampleKey = rollingSegmentKey(sampleTime)
        for sampleIndex = 0 to sampleCount - 1
            array.push(destStartKeys, sampleKey)
            array.push(destEndKeys, sampleKey)
            array.push(destStartTimes, sampleTime)
            array.push(destEndTimes, sampleTime)
            array.push(destHighs, array.get(sourceHighs, sampleIndex))
            array.push(destLows, array.get(sourceLows, sampleIndex))
            array.push(destVolumes, array.get(sourceVolumes, sampleIndex))
            array.push(destDeltas, array.get(sourceDeltas, sampleIndex))
    if compactAfter
        compactRollingSamples(destStartKeys, destEndKeys, destStartTimes, destEndTimes, destHighs, destLows, destVolumes, destDeltas)

pruneRollingSamples(array<int> startKeys, array<int> endKeys, array<int> startTimes, array<int> endTimes, array<float> highs, array<float> lows, array<float> volumes, array<float> deltas, int cutoffTime) =>
    while array.size(volumes) > 0 and array.get(endTimes, 0) < cutoffTime
        array.shift(startKeys)
        array.shift(endKeys)
        array.shift(startTimes)
        array.shift(endTimes)
        array.shift(highs)
        array.shift(lows)
        array.shift(volumes)
        array.shift(deltas)

// Prefer one-tick rows; bin wider ranges.
buildDeltaProfile(array<float> highs, array<float> lows, array<float> volumes, array<float> deltas, int requestedRows, int startTime, int endTime) =>
    int sampleCount = array.size(volumes)
    float tickSize = syminfo.mintick
    float rawHigh = sampleCount > 0 ? array.max(highs) : na
    float rawLow = sampleCount > 0 ? array.min(lows) : na
    int tickRows = sampleCount > 0 ? int(math.round((rawHigh - rawLow) / tickSize)) + 1 : 0
    bool tickGranular = tickRows >= 1 and tickRows <= requestedRows
    int rowCount = tickGranular ? tickRows : requestedRows
    DeltaProfile profile = DeltaProfile.new(startTime, endTime, na, na, rawLow, rawHigh, rowCount, array.new<float>(rowCount, 0.0), array.new<float>(rowCount, 0.0), 0.0, 0.0, false)
    if sampleCount > 0
        float profileLow = na
        float priceSpan = na
        float rowHeight = na
        if tickGranular
            profileLow := math.round(rawLow / tickSize) * tickSize - tickSize * 0.5
            priceSpan := rowCount * tickSize
            rowHeight := tickSize
        else
            priceSpan := math.max(rawHigh - rawLow, tickSize * rowCount)
            profileLow := rawHigh == rawLow ? rawLow - priceSpan * 0.5 : rawLow
            rowHeight := priceSpan / rowCount

        for sampleIndex = 0 to sampleCount - 1
            float sampleHigh = array.get(highs, sampleIndex)
            float sampleLow = array.get(lows, sampleIndex)
            float sampleVolume = array.get(volumes, sampleIndex)
            float sampleDelta = array.get(deltas, sampleIndex)
            int firstRow = clampRow((sampleLow - profileLow) / rowHeight, rowCount)
            int lastRow = clampRow((sampleHigh - profileLow) / rowHeight, rowCount)
            int coveredRows = math.max(1, lastRow - firstRow + 1)
            float volumePerRow = sampleVolume / coveredRows
            float deltaPerRow = sampleDelta / coveredRows
            for rowIndex = firstRow to lastRow
                array.set(profile.rowVolumes, rowIndex, array.get(profile.rowVolumes, rowIndex) + volumePerRow)
                array.set(profile.rowDeltas, rowIndex, array.get(profile.rowDeltas, rowIndex) + deltaPerRow)

        float totalVolume = 0.0
        float maxRowVolume = 0.0
        float maxAbsRowDelta = 0.0
        for rowIndex = 0 to rowCount - 1
            float rowVolume = array.get(profile.rowVolumes, rowIndex)
            float rowDelta = array.get(profile.rowDeltas, rowIndex)
            totalVolume += rowVolume
            if rowVolume > 0
                maxRowVolume := math.max(maxRowVolume, rowVolume)
                maxAbsRowDelta := math.max(maxAbsRowDelta, math.abs(rowDelta))

        profile.priceLow := profileLow
        profile.priceHigh := profileLow + priceSpan
        profile.maxRowVolume := maxRowVolume
        profile.maxAbsRowDelta := maxAbsRowDelta
        profile.isValid := totalVolume > 0
    profile

buildRollingDeltaProfile(array<int> sampleStartTimes, array<int> sampleEndTimes, array<float> highs, array<float> lows, array<float> volumes, array<float> deltas, int requestedRows, int startTime, int endTime, bool includeEnd) =>
    array<float> selectedHighs = array.new<float>()
    array<float> selectedLows = array.new<float>()
    array<float> selectedVolumes = array.new<float>()
    array<float> selectedDeltas = array.new<float>()
    int sampleCount = array.size(volumes)
    if sampleCount > 0
        for sampleIndex = 0 to sampleCount - 1
            bool beginsBeforeEnd = includeEnd ? array.get(sampleStartTimes, sampleIndex) <= endTime : array.get(sampleStartTimes, sampleIndex) < endTime
            if array.get(sampleEndTimes, sampleIndex) >= startTime and beginsBeforeEnd
                array.push(selectedHighs, array.get(highs, sampleIndex))
                array.push(selectedLows, array.get(lows, sampleIndex))
                array.push(selectedVolumes, array.get(volumes, sampleIndex))
                array.push(selectedDeltas, array.get(deltas, sampleIndex))
    buildDeltaProfile(selectedHighs, selectedLows, selectedVolumes, selectedDeltas, requestedRows, startTime, endTime)

buildDevelopingDeltaProfile(array<float> barHighs, array<float> barLows, array<float> barVolumes, array<float> barDeltas, array<int> startRef, array<float> sampleHighs, array<float> sampleLows, array<float> sampleVolumes, array<float> sampleDeltas, int endTime) =>
    int originalSize = array.size(barVolumes)
    if not barstate.isconfirmed
        appendSamples(barHighs, barLows, barVolumes, barDeltas, sampleHighs, sampleLows, sampleVolumes, sampleDeltas, false)
    DeltaProfile profile = buildDeltaProfile(barHighs, barLows, barVolumes, barDeltas, PROFILE_ROWS, array.get(startRef, 0), endTime)
    while array.size(barVolumes) > originalSize
        array.pop(barHighs)
        array.pop(barLows)
        array.pop(barVolumes)
        array.pop(barDeltas)
    profile

// Expand from POC toward heavier rows.
profileValueLevels(DeltaProfile profile) =>
    int pocRow = 0
    float pocVolume = -1.0
    float totalVolume = 0.0
    for rowIndex = 0 to profile.rowCount - 1
        float rowVolume = array.get(profile.rowVolumes, rowIndex)
        totalVolume += rowVolume
        if rowVolume > pocVolume
            pocVolume := rowVolume
            pocRow := rowIndex
    int valueAreaLowRow = pocRow
    int valueAreaHighRow = pocRow
    float accumulatedVolume = math.max(0.0, pocVolume)
    float targetVolume = totalVolume * VALUE_AREA_PERCENT * 0.01
    while accumulatedVolume < targetVolume and (valueAreaLowRow > 0 or valueAreaHighRow < profile.rowCount - 1)
        float volumeBelow = valueAreaLowRow > 0 ? array.get(profile.rowVolumes, valueAreaLowRow - 1) : -1.0
        float volumeAbove = valueAreaHighRow < profile.rowCount - 1 ? array.get(profile.rowVolumes, valueAreaHighRow + 1) : -1.0
        if volumeAbove >= volumeBelow
            valueAreaHighRow += 1
            accumulatedVolume += math.max(0.0, volumeAbove)
        else
            valueAreaLowRow -= 1
            accumulatedVolume += math.max(0.0, volumeBelow)
    float rowHeight = (profile.priceHigh - profile.priceLow) / profile.rowCount
    float pocPrice = profile.priceLow + (pocRow + 0.5) * rowHeight
    float valueAreaHighPrice = profile.priceLow + (valueAreaHighRow + 1) * rowHeight
    float valueAreaLowPrice = profile.priceLow + valueAreaLowRow * rowHeight
    [pocRow, valueAreaLowRow, valueAreaHighRow, pocPrice, valueAreaLowPrice, valueAreaHighPrice]

// ═══════════════════════════════════════════════════════════════════════════════
// ANCHOR ENGINE
// ═══════════════════════════════════════════════════════════════════════════════
finalizePeriod(array<float> barHighs, array<float> barLows, array<float> barVolumes, array<float> barDeltas, int startTime, int endTime, int keepProfiles, array<DeltaProfile> profiles) =>
    if array.size(barVolumes) > 0
        DeltaProfile profile = buildDeltaProfile(barHighs, barLows, barVolumes, barDeltas, PROFILE_ROWS, startTime, endTime)
        if profile.isValid
            array.push(profiles, profile)
            while array.size(profiles) > keepProfiles
                array.shift(profiles)
        clearSamples(barHighs, barLows, barVolumes, barDeltas)

processAnchor(bool enabled, int keepProfiles, bool inWindow, bool periodStart, bool periodEnd, array<float> barHighs, array<float> barLows, array<float> barVolumes, array<float> barDeltas, array<DeltaProfile> profiles, array<int> periodStartRef, array<int> periodLastBarRef, array<float> sampleHighs, array<float> sampleLows, array<float> sampleVolumes, array<float> sampleDeltas, bool continuousBoundary) =>
    if enabled
        bool shouldStart = periodStart or (array.get(periodStartRef, 0) == START_TIME_UNSET and inWindow)

        if periodEnd and array.size(barVolumes) > 0
            // Stop early-close profiles at the last sample.
            finalizePeriod(barHighs, barLows, barVolumes, barDeltas, array.get(periodStartRef, 0), array.get(periodLastBarRef, 0), keepProfiles, profiles)

        if shouldStart
            if array.size(barVolumes) > 0
                int boundaryEnd = continuousBoundary ? time : time[1]
                finalizePeriod(barHighs, barLows, barVolumes, barDeltas, array.get(periodStartRef, 0), boundaryEnd, keepProfiles, profiles)
            array.set(periodStartRef, 0, time)

        if inWindow and barstate.isconfirmed and array.size(sampleVolumes) > 0
            appendSamples(barHighs, barLows, barVolumes, barDeltas, sampleHighs, sampleLows, sampleVolumes, sampleDeltas, true)
            array.set(periodLastBarRef, 0, time)

processBoundedNyAnchor(bool enabled, int keepProfiles, int startMinute, int endMinute, bool inWindow, bool periodStart, bool periodEnd, int firstSampleTime, int lastSampleEndTime, array<float> barHighs, array<float> barLows, array<float> barVolumes, array<float> barDeltas, array<DeltaProfile> profiles, array<int> periodStartRef, array<int> periodLastBarRef, array<float> sampleHighs, array<float> sampleLows, array<float> sampleVolumes, array<float> sampleDeltas) =>
    if enabled
        if periodEnd and array.size(barVolumes) > 0
            finalizePeriod(barHighs, barLows, barVolumes, barDeltas, array.get(periodStartRef, 0), array.get(periodLastBarRef, 0), keepProfiles, profiles)

        bool shouldStart = periodStart or (array.get(periodStartRef, 0) == START_TIME_UNSET and inWindow)
        if shouldStart
            if array.size(barVolumes) > 0
                finalizePeriod(barHighs, barLows, barVolumes, barDeltas, array.get(periodStartRef, 0), array.get(periodLastBarRef, 0), keepProfiles, profiles)
            array.set(periodStartRef, 0, nyMinuteBoundary(firstSampleTime, startMinute))

        if inWindow and barstate.isconfirmed and array.size(sampleVolumes) > 0
            appendSamples(barHighs, barLows, barVolumes, barDeltas, sampleHighs, sampleLows, sampleVolumes, sampleDeltas, true)
            int sessionEndTime = nyMinuteBoundary(array.get(periodStartRef, 0), endMinute)
            array.set(periodLastBarRef, 0, math.min(lastSampleEndTime, sessionEndTime))

// ═══════════════════════════════════════════════════════════════════════════════
// RENDER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════
var array<box> drawnBoxes = array.new<box>()
var array<line> drawnLines = array.new<line>()
var array<polyline> drawnPolylines = array.new<polyline>()
var array<label> drawnLabels = array.new<label>()
var array<PendingOutlierLevel> pendingOutlierLevels = array.new<PendingOutlierLevel>()
var array<PendingRightLabel> pendingRightLabels = array.new<PendingRightLabel>()
var array<PendingRightLine> pendingRightLines = array.new<PendingRightLine>()
var table colorTable = na
// Rebuild chart time once per bar.
var array<int> cachedChartTimes = array.new<int>()
var int chartTimesBuiltAtBar = -1

clearDrawings() =>
    if array.size(drawnBoxes) > 0
        for boxIndex = 0 to array.size(drawnBoxes) - 1
            box.delete(array.get(drawnBoxes, boxIndex))
        array.clear(drawnBoxes)
    if array.size(drawnLines) > 0
        for lineIndex = 0 to array.size(drawnLines) - 1
            line.delete(array.get(drawnLines, lineIndex))
        array.clear(drawnLines)
    if array.size(drawnPolylines) > 0
        for polylineIndex = 0 to array.size(drawnPolylines) - 1
            polyline.delete(array.get(drawnPolylines, polylineIndex))
        array.clear(drawnPolylines)
    if array.size(drawnLabels) > 0
        for labelIndex = 0 to array.size(drawnLabels) - 1
            label.delete(array.get(drawnLabels, labelIndex))
        array.clear(drawnLabels)
    array.clear(pendingOutlierLevels)
    array.clear(pendingRightLabels)
    array.clear(pendingRightLines)

queueLevelMarker(float price, int markerTime, color markerColor, int markerSize) =>
    if showDots
        array.push(pendingRightLabels, PendingRightLabel.new(price, markerTime, markerColor, markerSize))

queueRightLine(float price, int leftTime, int rightTime, color lineColor, int lineWidth, string styleName, int rank, string sourceName, int sessionTradingDayKey, bool historical, int direction) =>
    bool historicalMergeGroup = historical or sessionTradingDayKey != tradingDayKey(time)
    array.push(pendingRightLines, PendingRightLine.new(price, leftTime, rightTime, lineColor, lineWidth, styleName, rank, sourceName, sessionTradingDayKey, historicalMergeGroup, direction))

renderZoneFill(int leftTime, int rightTime, float zoneLow, float zoneHigh, color zoneFillColor) =>
    array.push(drawnBoxes, box.new(left=leftTime, top=zoneHigh, right=rightTime, bottom=zoneLow, xloc=xloc.bar_time, border_color=color.new(zoneFillColor, 100), border_width=0, bgcolor=zoneFillColor))

// Records keep cluster fields aligned.
flushPendingRightLines(bool merge) =>
    int pendingCount = array.size(pendingRightLines)
    if pendingCount > 0
        array<PendingRightLine> clusters = array.new<PendingRightLine>()
        for pendingIndex = 0 to pendingCount - 1
            PendingRightLine pending = array.get(pendingRightLines, pendingIndex)
            float tolerance = math.max(syminfo.mintick, math.abs(pending.price) * mergeDistancePercent / 100.0)
            int foundIndex = -1
            float minimumDistance = tolerance + syminfo.mintick
            int clusterCount = array.size(clusters)
            if merge and clusterCount > 0
                for clusterIndex = 0 to clusterCount - 1
                    PendingRightLine cluster = array.get(clusters, clusterIndex)
                    float distance = math.abs(cluster.price - pending.price)
                    bool sameSource = cluster.sourceName == pending.sourceName
                    bool sameOccurrence = cluster.tradingDayKey == pending.tradingDayKey and cluster.historical == pending.historical
                    bool sameEndpoint = cluster.rightTime == pending.rightTime
                    bool compatibleDirection = cluster.direction == 0 or pending.direction == 0 or cluster.direction == pending.direction
                    if sameSource and sameOccurrence and sameEndpoint and compatibleDirection and distance <= tolerance and distance < minimumDistance
                        minimumDistance := distance
                        foundIndex := clusterIndex
            if foundIndex >= 0
                PendingRightLine cluster = array.get(clusters, foundIndex)
                cluster.leftTime := math.min(cluster.leftTime, pending.leftTime)
                cluster.rightTime := math.max(cluster.rightTime, pending.rightTime)
                if cluster.direction == 0 and pending.direction != 0
                    cluster.direction := pending.direction
                if pending.rank > cluster.rank
                    cluster.price := pending.price
                    cluster.lineColor := pending.lineColor
                    cluster.lineWidth := pending.lineWidth
                    cluster.styleName := pending.styleName
                    cluster.rank := pending.rank
            else
                array.push(clusters, PendingRightLine.new(pending.price, pending.leftTime, pending.rightTime, pending.lineColor, pending.lineWidth, pending.styleName, pending.rank, pending.sourceName, pending.tradingDayKey, pending.historical, pending.direction))
        for clusterIndex = 0 to array.size(clusters) - 1
            PendingRightLine cluster = array.get(clusters, clusterIndex)
            array.push(drawnLines, line.new(cluster.leftTime, cluster.price, cluster.rightTime, cluster.price, xloc=xloc.bar_time, color=cluster.lineColor, style=toLineStyle(cluster.styleName), width=cluster.lineWidth))
        array.clear(pendingRightLines)

flushPendingRightLabels() =>
    int pendingCount = array.size(pendingRightLabels)
    if pendingCount > 0
        for pendingIndex = 0 to pendingCount - 1
            PendingRightLabel pending = array.get(pendingRightLabels, pendingIndex)
            array.push(drawnLabels, label.new(pending.markerTime, pending.price, LEVEL_MARKER_GLYPH, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_none, textcolor=pending.textColor, size=pending.textSize, color=color.new(color.white, 100), textalign=text.align_center))
        array.clear(pendingRightLabels)

// Bar indexing ignores time gaps.
recentChartTimes() =>
    array<int> chartTimes = array.new<int>()
    int offset = math.min(bar_index, PROFILE_TIME_SCALE_MAX_LOOKBACK)
    while offset >= 0
        array.push(chartTimes, time[offset])
        offset -= 1
    chartTimes

nearestChartTimeIndex(array<int> chartTimes, int targetTime) =>
    int count = array.size(chartTimes)
    int result = -1
    bool insideScale = count > 0 and targetTime >= array.get(chartTimes, 0) and targetTime <= array.get(chartTimes, count - 1)
    if insideScale
        int lowIndex = 0
        int highIndex = count - 1
        while lowIndex <= highIndex
            int middleIndex = int(math.floor((lowIndex + highIndex) * 0.5))
            int middleTime = array.get(chartTimes, middleIndex)
            if middleTime < targetTime
                result := middleIndex
                lowIndex := middleIndex + 1
            else if middleTime > targetTime
                highIndex := middleIndex - 1
            else
                result := middleIndex
                lowIndex := highIndex + 1
        if result < 0
            result := 0
        if result < count - 1
            int nextIndex = result + 1
            if math.abs(array.get(chartTimes, nextIndex) - targetTime) < math.abs(array.get(chartTimes, result) - targetTime)
                result := nextIndex
    result

profileBaselineTime(DeltaProfile profile, array<int> chartTimes, int baselineIndex, bool attachRight) =>
    int count = array.size(chartTimes)
    baselineIndex >= 0 and baselineIndex < count ? array.get(chartTimes, baselineIndex) : (attachRight ? profile.endTime : profile.startTime)

profileOuterTime(DeltaProfile profile, array<int> chartTimes, int baselineIndex, int rangeSteps, float magnitudeRatio, int widthPercent, bool faceLeft, bool attachRight) =>
    int count = array.size(chartTimes)
    int outerTime = na
    float clampedRatio = math.max(0.0, math.min(1.0, magnitudeRatio))
    int baselineTime = profileBaselineTime(profile, chartTimes, baselineIndex, attachRight)
    if clampedRatio <= 0
        outerTime := baselineTime
    else if count > 1 and baselineIndex >= 0
        int maximumSteps = math.max(1, int(math.round(rangeSteps * widthPercent * 0.01)))
        int rowSteps = math.max(1, int(math.round(clampedRatio * maximumSteps)))
        int outerIndex = baselineIndex + (faceLeft ? -rowSteps : rowSteps)
        if outerIndex >= 0 and outerIndex < count
            outerTime := array.get(chartTimes, outerIndex)
        else
            int overflowSteps = outerIndex < 0 ? outerIndex : outerIndex - (count - 1)
            int edgeTime = outerIndex < 0 ? array.get(chartTimes, 0) : array.get(chartTimes, count - 1)
            int chartMilliseconds = barSpanMs()
            outerTime := edgeTime + overflowSteps * chartMilliseconds
    else
        int profileMilliseconds = math.max(1, profile.endTime - profile.startTime)
        int rowWidth = math.max(1, int(math.round(profileMilliseconds * widthPercent * 0.01 * clampedRatio)))
        outerTime := baselineTime + (faceLeft ? -rowWidth : rowWidth)
    outerTime

deltaOuterTime(DeltaProfile profile, int baselineTime, float magnitudeRatio, int widthPercent, bool faceLeft) =>
    float clampedRatio = math.max(0.0, math.min(1.0, magnitudeRatio))
    int profileMilliseconds = math.max(1, profile.endTime - profile.startTime)
    int rowWidth = int(math.round(profileMilliseconds * widthPercent * 0.01 * clampedRatio))
    baselineTime + (faceLeft ? -rowWidth : rowWidth)

computeRowStrengths(DeltaProfile profile) =>
    array<float> strengths = array.new<float>(profile.rowCount, na)
    float absDeltaSum = 0.0
    int occupiedCount = 0
    for rowIndex = 0 to profile.rowCount - 1
        if array.get(profile.rowVolumes, rowIndex) > 0
            absDeltaSum += math.abs(array.get(profile.rowDeltas, rowIndex))
            occupiedCount += 1
    if occupiedCount > 2
        float averageAbsDelta = absDeltaSum / occupiedCount
        if averageAbsDelta > 0
            for rowIndex = 0 to profile.rowCount - 1
                if array.get(profile.rowVolumes, rowIndex) > 0
                    array.set(strengths, rowIndex, math.abs(array.get(profile.rowDeltas, rowIndex)) / averageAbsDelta)
    strengths

isOutlierStrength(float strength) =>
    not na(strength) and strength >= OUTLIER_MULTIPLIER

rowPassesDeltaFilter(float rowDelta, float strength) =>
    bool isBuy = rowDelta > 0
    bool isSell = rowDelta < 0
    bool isOutlier = isOutlierStrength(strength)
    bool directionVisible = deltaHistogramRows == OPTION_ALL ? isBuy or isSell : deltaHistogramRows == OPTION_OFF ? false : deltaHistogramRows == DELTA_ROWS_BUY ? isBuy : deltaHistogramRows == DELTA_ROWS_SELL ? isSell : false
    directionVisible and (not showOutliersOnly or isOutlier)

appendDeltaRowPoints(array<chart.point> points, int baselineTime, int outerTime, float rowBottom, float rowTop) =>
    array.push(points, chart.point.from_time(baselineTime, rowBottom))
    array.push(points, chart.point.from_time(outerTime, rowBottom))
    array.push(points, chart.point.from_time(outerTime, rowTop))
    array.push(points, chart.point.from_time(baselineTime, rowTop))

renderDeltaLayer(array<chart.point> points, color fillColor) =>
    if array.size(points) >= 4 and array.size(drawnPolylines) < INDICATOR_MAX_POLYLINES
        array.push(drawnPolylines, polyline.new(points, curved=false, closed=true, xloc=xloc.bar_time, line_color=color.new(fillColor, 100), fill_color=fillColor))

renderDeltaPolylines(DeltaProfile profile, string sourceName, array<float> strengths, array<int> chartTimes, int startScaleIndex, int endScaleIndex) =>
    if profile.maxAbsRowDelta > 0
        array<chart.point> buyPoints = array.new<chart.point>()
        array<chart.point> sellPoints = array.new<chart.point>()
        array<chart.point> deltaPlusPlusPoints = array.new<chart.point>()
        array<chart.point> deltaMinusMinusPoints = array.new<chart.point>()
        float rowHeight = (profile.priceHigh - profile.priceLow) / profile.rowCount
        string position = profilePosition(sourceName)
        bool attachRight = position == PROFILE_POSITION_RIGHT_LEFT or position == PROFILE_POSITION_RIGHT_RIGHT
        bool faceLeft = position == PROFILE_POSITION_LEFT_LEFT or position == PROFILE_POSITION_RIGHT_LEFT
        bool completeScale = startScaleIndex >= 0 and endScaleIndex >= 0
        int baselineIndex = completeScale ? (attachRight ? endScaleIndex : startScaleIndex) : -1
        int baselineTime = profileBaselineTime(profile, chartTimes, baselineIndex, attachRight)
        for rowIndex = 0 to profile.rowCount - 1
            float rowVolume = array.get(profile.rowVolumes, rowIndex)
            if rowVolume > 0
                float strength = array.get(strengths, rowIndex)
                bool outlierRow = isOutlierStrength(strength)
                float rowDelta = array.get(profile.rowDeltas, rowIndex)
                float magnitude = math.abs(rowDelta)
                if magnitude > 0 and rowPassesDeltaFilter(rowDelta, strength)
                    float rowBottom = profile.priceLow + rowIndex * rowHeight
                    int outerTime = deltaOuterTime(profile, baselineTime, magnitude / profile.maxAbsRowDelta, profileDeltaHistogramWidthPercent(sourceName), faceLeft)
                    if rowDelta >= 0 and outlierRow
                        appendDeltaRowPoints(deltaPlusPlusPoints, baselineTime, outerTime, rowBottom, rowBottom + rowHeight)
                    else if rowDelta >= 0
                        appendDeltaRowPoints(buyPoints, baselineTime, outerTime, rowBottom, rowBottom + rowHeight)
                    else if outlierRow
                        appendDeltaRowPoints(deltaMinusMinusPoints, baselineTime, outerTime, rowBottom, rowBottom + rowHeight)
                    else
                        appendDeltaRowPoints(sellPoints, baselineTime, outerTime, rowBottom, rowBottom + rowHeight)
        renderDeltaLayer(buyPoints, profileDeltaPlusColor(sourceName))
        renderDeltaLayer(sellPoints, profileDeltaMinusColor(sourceName))
        renderDeltaLayer(deltaPlusPlusPoints, profileDeltaPlusPlusColor(sourceName))
        renderDeltaLayer(deltaMinusMinusPoints, profileDeltaMinusMinusColor(sourceName))

pushHistogramRun(array<chart.point> points, color fillColor) =>
    if array.size(drawnPolylines) < INDICATOR_MAX_POLYLINES
        array.push(drawnPolylines, polyline.new(points, curved=false, closed=true, xloc=xloc.bar_time, line_color=color.new(fillColor, 100), fill_color=fillColor))

// Split only at value-area boundaries.
renderHistogram(DeltaProfile profile, int valueAreaLowRow, int valueAreaHighRow, int maxPolylinesAllowed, array<int> chartTimes, int startScaleIndex, int endScaleIndex) =>
    int polylinesUsed = 0
    if profile.maxRowVolume > 0 and maxPolylinesAllowed > 0
        int rowCount = profile.rowCount
        float rowHeight = (profile.priceHigh - profile.priceLow) / rowCount
        bool attachRight = false
        bool faceLeft = false
        bool completeScale = startScaleIndex >= 0 and endScaleIndex >= 0
        int baselineIndex = completeScale ? (attachRight ? endScaleIndex : startScaleIndex) : -1
        int rangeSteps = completeScale ? math.max(1, math.abs(endScaleIndex - startScaleIndex)) : 1
        int baselineTime = profileBaselineTime(profile, chartTimes, baselineIndex, attachRight)
        if not useHistogramValueAreaColors
            array<chart.point> points = array.new<chart.point>()
            array.push(points, chart.point.from_time(baselineTime, profile.priceLow))
            for rowIndex = 0 to rowCount - 1
                float rowVolume = array.get(profile.rowVolumes, rowIndex)
                int outerTime = profileOuterTime(profile, chartTimes, baselineIndex, rangeSteps, rowVolume / profile.maxRowVolume, histogramWidthPercent, faceLeft, attachRight)
                array.push(points, chart.point.from_time(outerTime, profile.priceLow + (rowIndex + 0.5) * rowHeight))
            array.push(points, chart.point.from_time(baselineTime, profile.priceHigh))
            pushHistogramRun(points, histogramColor)
            polylinesUsed := 1
        else
            array<chart.point> points = array.new<chart.point>()
            bool runStarted = false
            bool runInsideValueArea = false
            for rowIndex = 0 to rowCount - 1
                bool insideValueArea = rowIndex >= valueAreaLowRow and rowIndex <= valueAreaHighRow
                float rowBottom = profile.priceLow + rowIndex * rowHeight
                float rowVolume = array.get(profile.rowVolumes, rowIndex)
                int outerTime = profileOuterTime(profile, chartTimes, baselineIndex, rangeSteps, rowVolume / profile.maxRowVolume, histogramWidthPercent, faceLeft, attachRight)
                if runStarted and insideValueArea != runInsideValueArea
                    array.push(points, chart.point.from_time(baselineTime, rowBottom))
                    if polylinesUsed < maxPolylinesAllowed
                        pushHistogramRun(points, runInsideValueArea ? histogramValueAreaInsideColor : histogramValueAreaOutsideColor)
                        polylinesUsed += 1
                    points := array.new<chart.point>()
                    runStarted := false
                if not runStarted
                    runStarted := true
                    runInsideValueArea := insideValueArea
                    array.push(points, chart.point.from_time(baselineTime, rowBottom))
                array.push(points, chart.point.from_time(outerTime, rowBottom + rowHeight * 0.5))
                if rowIndex == rowCount - 1
                    array.push(points, chart.point.from_time(baselineTime, rowBottom + rowHeight))
                    if polylinesUsed < maxPolylinesAllowed
                        pushHistogramRun(points, runInsideValueArea ? histogramValueAreaInsideColor : histogramValueAreaOutsideColor)
                        polylinesUsed += 1
    polylinesUsed

smoothProfileVolumes(DeltaProfile profile) =>
    array<float> smoothedVolumes = array.new<float>(profile.rowCount, 0.0)
    for rowIndex = 0 to profile.rowCount - 1
        int firstRow = math.max(0, rowIndex - LOW_VOLUME_SMOOTH_RADIUS)
        int lastRow = math.min(profile.rowCount - 1, rowIndex + LOW_VOLUME_SMOOTH_RADIUS)
        float volumeSum = 0.0
        for sampleRow = firstRow to lastRow
            volumeSum += array.get(profile.rowVolumes, sampleRow)
        array.set(smoothedVolumes, rowIndex, volumeSum / (lastRow - firstRow + 1))
    smoothedVolumes

volumeWindowAverage(array<float> volumes, int firstRow, int lastRow) =>
    float volumeSum = 0.0
    for rowIndex = firstRow to lastRow
        volumeSum += array.get(volumes, rowIndex)
    volumeSum / (lastRow - firstRow + 1)

collectLowVolumeCandidates(DeltaProfile profile) =>
    array<LowVolumeCandidate> candidates = array.new<LowVolumeCandidate>()
    int rowCount = profile.rowCount
    float rowHeight = (profile.priceHigh - profile.priceLow) / rowCount
    int shoulderWindow = math.max(4, math.min(32, int(math.round(rowCount * LOW_VOLUME_SHOULDER_FRACTION))))
    if rowCount >= LOW_VOLUME_SMOOTH_RADIUS * 2 + 3
        array<float> smoothedVolumes = smoothProfileVolumes(profile)
        float maxSmoothedVolume = array.max(smoothedVolumes)
        float minimumShoulderVolume = maxSmoothedVolume * LOW_VOLUME_MIN_SHOULDER_SHARE
        float minimumDenominator = math.max(maxSmoothedVolume * 0.001, 0.0000001)
        if rowCount >= shoulderWindow * 2 + 3
            int maximumZoneRows = math.max(1, int(math.floor(rowCount * LOW_VOLUME_MAX_ZONE_FRACTION)))
            int firstLvnRow = shoulderWindow
            int lastLvnRow = rowCount - shoulderWindow - 1
            for rowIndex = firstLvnRow to lastLvnRow
                float valleyVolume = array.get(smoothedVolumes, rowIndex)
                float leftShoulderVolume = 0.0
                float rightShoulderVolume = 0.0
                for shoulderOffset = 1 to shoulderWindow
                    leftShoulderVolume := math.max(leftShoulderVolume, array.get(smoothedVolumes, rowIndex - shoulderOffset))
                    rightShoulderVolume := math.max(rightShoulderVolume, array.get(smoothedVolumes, rowIndex + shoulderOffset))
                float shoulderVolume = math.min(leftShoulderVolume, rightShoulderVolume)
                float strength = shoulderVolume / math.max(valleyVolume, minimumDenominator)
                bool boundedValley = valleyVolume < leftShoulderVolume and valleyVolume < rightShoulderVolume
                if boundedValley and shoulderVolume >= minimumShoulderVolume and strength >= LOW_VOLUME_SENSITIVITY
                    float zoneThreshold = shoulderVolume / LOW_VOLUME_SENSITIVITY
                    int firstZoneRow = rowIndex
                    int lastZoneRow = rowIndex
                    while firstZoneRow > 0 and lastZoneRow - firstZoneRow + 1 <= maximumZoneRows and array.get(smoothedVolumes, firstZoneRow - 1) <= zoneThreshold
                        firstZoneRow -= 1
                    while lastZoneRow < rowCount - 1 and lastZoneRow - firstZoneRow + 1 <= maximumZoneRows and array.get(smoothedVolumes, lastZoneRow + 1) <= zoneThreshold
                        lastZoneRow += 1
                    int zoneRows = lastZoneRow - firstZoneRow + 1
                    if zoneRows <= maximumZoneRows
                        float valleyPrice = profile.priceLow + (rowIndex + 0.5) * rowHeight
                        float zoneLow = profile.priceLow + firstZoneRow * rowHeight
                        float zoneHigh = profile.priceLow + (lastZoneRow + 1) * rowHeight
                        array.push(candidates, LowVolumeCandidate.new(valleyPrice, zoneLow, zoneHigh, strength, true))
        int compareRows = LOW_VOLUME_SMOOTH_RADIUS + 1
        if rowCount >= compareRows * 2 + 1
            int firstCliffBoundary = compareRows
            int lastCliffBoundary = rowCount - compareRows
            for boundaryRow = firstCliffBoundary to lastCliffBoundary
                int lowerFirstRow = boundaryRow - compareRows
                int lowerLastRow = boundaryRow - 1
                int upperFirstRow = boundaryRow
                int upperLastRow = boundaryRow + compareRows - 1
                float lowerVolume = volumeWindowAverage(smoothedVolumes, lowerFirstRow, lowerLastRow)
                float upperVolume = volumeWindowAverage(smoothedVolumes, upperFirstRow, upperLastRow)
                float highVolume = math.max(lowerVolume, upperVolume)
                float lowVolume = math.min(lowerVolume, upperVolume)
                float strength = highVolume / math.max(lowVolume, minimumDenominator)
                if highVolume >= minimumShoulderVolume and strength >= LOW_VOLUME_SENSITIVITY
                    float cliffPrice = profile.priceLow + boundaryRow * rowHeight
                    array.push(candidates, LowVolumeCandidate.new(cliffPrice, cliffPrice, cliffPrice, strength, false))
    candidates

lowVolumeCandidatesOverlap(LowVolumeCandidate first, LowVolumeCandidate second, float rowHeight) =>
    bool overlap = false
    if first.isLvn and second.isLvn
        overlap := first.zoneLow <= second.zoneHigh and second.zoneLow <= first.zoneHigh
    else if not first.isLvn and not second.isLvn
        overlap := math.abs(first.price - second.price) <= rowHeight * LOW_VOLUME_CLIFF_SEPARATION_ROWS
    else
        float lvnLow = first.isLvn ? first.zoneLow : second.zoneLow
        float lvnHigh = first.isLvn ? first.zoneHigh : second.zoneHigh
        float cliffPrice = first.isLvn ? second.price : first.price
        float cliffMargin = rowHeight * LOW_VOLUME_CLIFF_SEPARATION_ROWS
        overlap := cliffPrice >= lvnLow - cliffMargin and cliffPrice <= lvnHigh + cliffMargin
    overlap

renderLowVolumeZone(DeltaProfile profile, string sourceName, float zoneLow, float zoneHigh, int levelEndTime) =>
    renderZoneFill(profile.endTime, levelEndTime, zoneLow, zoneHigh, profileLowVolumeZoneColor(sourceName))

renderLowVolumeStructures(DeltaProfile profile, string sourceName, int sessionCloseTime, int sessionTradingDayKey, bool historical) =>
    if showMinimumLvnTiers
        array<LowVolumeCandidate> candidates = collectLowVolumeCandidates(profile)
        int candidateCount = array.size(candidates)
        if candidateCount > 0
            array<bool> discarded = array.new<bool>(candidateCount, false)
            float rowHeight = (profile.priceHigh - profile.priceLow) / profile.rowCount
            for structureRank = 1 to visibleLvnTierCount
                int structureTier = 6 - structureRank
                int bestCandidateIndex = -1
                float bestStrength = -1.0
                for candidateIndex = 0 to candidateCount - 1
                    LowVolumeCandidate candidate = array.get(candidates, candidateIndex)
                    if not array.get(discarded, candidateIndex) and candidate.strength > bestStrength
                        bestCandidateIndex := candidateIndex
                        bestStrength := candidate.strength
                if bestCandidateIndex >= 0
                    LowVolumeCandidate selectedCandidate = array.get(candidates, bestCandidateIndex)
                    array.set(discarded, bestCandidateIndex, true)
                    int levelRank = LOW_VOLUME_LEVEL_RANK - structureRank
                    float labelPrice = selectedCandidate.isLvn ? (selectedCandidate.zoneLow + selectedCandidate.zoneHigh) * 0.5 : selectedCandidate.price
                    int levelEndTime = sessionLevelEndpoint(sourceName, sessionCloseTime)
                    int markerTime = levelMarkerTime(levelEndTime)
                    if selectedCandidate.isLvn
                        renderLowVolumeZone(profile, sourceName, selectedCandidate.zoneLow, selectedCandidate.zoneHigh, levelEndTime)
                    else
                        queueRightLine(selectedCandidate.price, profile.endTime, levelEndTime, profileLowVolumeCliffLineColor(sourceName), LOW_VOLUME_LINE_WIDTH, STYLE_DOTTED, levelRank, sourceName, sessionTradingDayKey, historical, 0)
                    queueLevelMarker(labelPrice, markerTime, profileLowVolumeTextColor(sourceName), tierMarkerSize(tierMarkerSizes, structureTier))
                    for candidateIndex = 0 to candidateCount - 1
                        if not array.get(discarded, candidateIndex) and lowVolumeCandidatesOverlap(selectedCandidate, array.get(candidates, candidateIndex), rowHeight)
                            array.set(discarded, candidateIndex, true)

queueOutlierPeak(DeltaProfile profile, string sourceName, int sessionCloseTime, int sessionTradingDayKey, bool historical, bool buySide, int firstRow, int lastRow, int anchorRow, float peakDelta, float peakStrength, int markerTime) =>
    float rowHeight = (profile.priceHigh - profile.priceLow) / profile.rowCount
    float peakPrice = profile.priceLow + (anchorRow + 0.5) * rowHeight
    float zoneLow = profile.priceLow + firstRow * rowHeight
    float zoneHigh = profile.priceLow + (lastRow + 1) * rowHeight
    int levelEndTime = sessionLevelEndpoint(sourceName, sessionCloseTime)
    array.push(pendingOutlierLevels, PendingOutlierLevel.new(peakPrice, zoneLow, zoneHigh, peakDelta, peakStrength, buySide, profile.endTime, levelEndTime, markerTime, sourceName, sessionTradingDayKey, historical))

collectSideOutlierPeaks(DeltaProfile profile, array<float> strengths, string sourceName, int sessionCloseTime, int sessionTradingDayKey, bool historical, bool buySide, int markerTime) =>
    int peaksFound = 0
    bool peakActive = false
    float peakDelta = 0.0
    float peakStrength = 0.0
    int peakFirstRow = -1
    int peakLastRow = -1
    int peakAnchorRow = -1
    int lastQualifiedRow = -100000
    for rowIndex = 0 to profile.rowCount - 1
        float rowDelta = array.get(profile.rowDeltas, rowIndex)
        float strength = array.get(strengths, rowIndex)
        bool correctSide = buySide ? rowDelta > 0 : rowDelta < 0
        bool qualifies = correctSide and isOutlierStrength(strength)
        if qualifies
            bool startsNewPeak = peakActive and rowIndex - lastQualifiedRow > OUTLIER_PEAK_GAP_ROWS + 1
            if startsNewPeak
                queueOutlierPeak(profile, sourceName, sessionCloseTime, sessionTradingDayKey, historical, buySide, peakFirstRow, peakLastRow, peakAnchorRow, peakDelta, peakStrength, markerTime)
                peaksFound += 1
                peakActive := false
                peakDelta := 0.0
                peakStrength := 0.0
                peakFirstRow := -1
                peakLastRow := -1
                peakAnchorRow := -1
            if not peakActive
                peakActive := true
                peakFirstRow := rowIndex
            peakDelta += rowDelta
            peakLastRow := rowIndex
            if strength > peakStrength
                peakStrength := strength
                peakAnchorRow := rowIndex
            lastQualifiedRow := rowIndex
    if peakActive
        queueOutlierPeak(profile, sourceName, sessionCloseTime, sessionTradingDayKey, historical, buySide, peakFirstRow, peakLastRow, peakAnchorRow, peakDelta, peakStrength, markerTime)
        peaksFound += 1
    peaksFound

collectOutlierPeaks(DeltaProfile profile, array<float> strengths, string sourceName, int sessionCloseTime, int sessionTradingDayKey, bool historical) =>
    int peaksFound = 0
    if showDeltaTiers
        int levelEndTime = sessionLevelEndpoint(sourceName, sessionCloseTime)
        int markerTime = levelMarkerTime(levelEndTime)
        peaksFound += collectSideOutlierPeaks(profile, strengths, sourceName, sessionCloseTime, sessionTradingDayKey, historical, true, markerTime)
        peaksFound += collectSideOutlierPeaks(profile, strengths, sourceName, sessionCloseTime, sessionTradingDayKey, historical, false, markerTime)
    peaksFound

flushPendingOutlierLevels(bool merge) =>
    int pendingCount = array.size(pendingOutlierLevels)
    if pendingCount > 0
        array<float> clusterPrices = array.new<float>()
        array<float> clusterZoneLows = array.new<float>()
        array<float> clusterZoneHighs = array.new<float>()
        array<float> clusterDeltas = array.new<float>()
        array<float> clusterStrengths = array.new<float>()
        array<bool> clusterBuySides = array.new<bool>()
        array<int> clusterLineStartTimes = array.new<int>()
        array<int> clusterRightTimes = array.new<int>()
        array<int> clusterMarkerTimes = array.new<int>()
        array<string> clusterSourceNames = array.new<string>()
        array<int> clusterTradingDayKeys = array.new<int>()
        array<bool> clusterHistoricalFlags = array.new<bool>()
        for pendingIndex = 0 to pendingCount - 1
            PendingOutlierLevel pending = array.get(pendingOutlierLevels, pendingIndex)
            float tolerance = math.max(syminfo.mintick, math.abs(pending.price) * mergeDistancePercent / 100.0)
            int foundIndex = -1
            float minimumDistance = tolerance + syminfo.mintick
            int existingClusterCount = array.size(clusterPrices)
            if merge and existingClusterCount > 0
                for clusterIndex = 0 to existingClusterCount - 1
                    float distance = math.abs(array.get(clusterPrices, clusterIndex) - pending.price)
                    bool sameSide = array.get(clusterBuySides, clusterIndex) == pending.buySide
                    bool sameSource = array.get(clusterSourceNames, clusterIndex) == pending.sourceName
                    bool sameOccurrence = array.get(clusterTradingDayKeys, clusterIndex) == pending.tradingDayKey and array.get(clusterHistoricalFlags, clusterIndex) == pending.historical
                    if sameSide and sameSource and sameOccurrence and distance <= tolerance and distance < minimumDistance
                        minimumDistance := distance
                        foundIndex := clusterIndex
            if foundIndex >= 0
                array.set(clusterLineStartTimes, foundIndex, math.max(array.get(clusterLineStartTimes, foundIndex), pending.lineStartTime))
                array.set(clusterRightTimes, foundIndex, math.max(array.get(clusterRightTimes, foundIndex), pending.rightTime))
                if pending.strength > array.get(clusterStrengths, foundIndex)
                    array.set(clusterMarkerTimes, foundIndex, pending.markerTime)
                array.set(clusterZoneLows, foundIndex, math.min(array.get(clusterZoneLows, foundIndex), pending.zoneLow))
                array.set(clusterZoneHighs, foundIndex, math.max(array.get(clusterZoneHighs, foundIndex), pending.zoneHigh))
                array.set(clusterDeltas, foundIndex, array.get(clusterDeltas, foundIndex) + pending.delta)
                if pending.strength > array.get(clusterStrengths, foundIndex)
                    array.set(clusterPrices, foundIndex, pending.price)
                    array.set(clusterStrengths, foundIndex, pending.strength)
            else
                array.push(clusterPrices, pending.price)
                array.push(clusterZoneLows, pending.zoneLow)
                array.push(clusterZoneHighs, pending.zoneHigh)
                array.push(clusterDeltas, pending.delta)
                array.push(clusterStrengths, pending.strength)
                array.push(clusterBuySides, pending.buySide)
                array.push(clusterLineStartTimes, pending.lineStartTime)
                array.push(clusterRightTimes, pending.rightTime)
                array.push(clusterMarkerTimes, pending.markerTime)
                array.push(clusterSourceNames, pending.sourceName)
                array.push(clusterTradingDayKeys, pending.tradingDayKey)
                array.push(clusterHistoricalFlags, pending.historical)
        int clusterCount = array.size(clusterPrices)
        array<string> sourceNames = array.new<string>()
        for clusterIndex = 0 to clusterCount - 1
            string sourceName = array.get(clusterSourceNames, clusterIndex)
            if not array.includes(sourceNames, sourceName)
                array.push(sourceNames, sourceName)
        array<bool> selectedClusters = array.new<bool>(clusterCount, false)
        int sourceCount = array.size(sourceNames)
        for sourceIndex = 0 to sourceCount - 1
            string selectedSourceName = array.get(sourceNames, sourceIndex)
            for sideIndex = 0 to 1
                bool buySide = sideIndex == 0
                for strengthRank = 1 to visibleDeltaTierCount
                    int tier = 6 - strengthRank
                    int bestCluster = -1
                    float bestMagnitude = -1.0
                    float bestStrength = -1.0
                    for clusterIndex = 0 to clusterCount - 1
                        bool eligible = not array.get(selectedClusters, clusterIndex) and array.get(clusterBuySides, clusterIndex) == buySide and array.get(clusterSourceNames, clusterIndex) == selectedSourceName
                        if eligible
                            float magnitude = math.abs(array.get(clusterDeltas, clusterIndex))
                            float strength = array.get(clusterStrengths, clusterIndex)
                            if magnitude > bestMagnitude or (magnitude == bestMagnitude and strength > bestStrength)
                                bestMagnitude := magnitude
                                bestStrength := strength
                                bestCluster := clusterIndex
                    if bestCluster >= 0
                        array.set(selectedClusters, bestCluster, true)
                        float price = array.get(clusterPrices, bestCluster)
                        float zoneLow = array.get(clusterZoneLows, bestCluster)
                        float zoneHigh = array.get(clusterZoneHighs, bestCluster)
                        int lineStartTime = array.get(clusterLineStartTimes, bestCluster)
                        int rightTime = array.get(clusterRightTimes, bestCluster)
                        int markerTime = array.get(clusterMarkerTimes, bestCluster)
                        string sourceName = array.get(clusterSourceNames, bestCluster)
                        DeltaTierAppearance appearance = deltaTierAppearance(buySide, tier, sourceName)
                        bool sideVisible = deltaTierSideVisible(buySide)
                        int sessionTradingDayKey = array.get(clusterTradingDayKeys, bestCluster)
                        bool historical = array.get(clusterHistoricalFlags, bestCluster)
                        int levelRank = 2000 - strengthRank
                        if sideVisible
                            renderZoneFill(lineStartTime, rightTime, zoneLow, zoneHigh, appearance.zoneColor)
                        int direction = buySide ? 1 : -1
                        if sideVisible and appearance.hasLine
                            queueRightLine(price, lineStartTime, rightTime, appearance.lineColor, appearance.lineWidth, appearance.lineStyle, levelRank, sourceName, sessionTradingDayKey, historical, direction)
                        if sideVisible
                            queueLevelMarker(price, markerTime, appearance.textColor, tierMarkerSize(tierMarkerSizes, tier))
        array.clear(pendingOutlierLevels)

renderProfileBox(DeltaProfile profile, string sourceName) =>
    color innerColor = profileInnerColor(sourceName)
    array.push(drawnBoxes, box.new(left=profile.startTime, top=profile.rangeHigh, right=profile.endTime, bottom=profile.rangeLow, xloc=xloc.bar_time, border_color=innerColor, border_width=SESSION_OUTLINE_WIDTH, border_style=line.style_solid, bgcolor=color.new(color.white, 100)))

renderOuterSessionFrame(DeltaProfile profile, string sourceName, int sessionCloseTime, bool historical) =>
    if showOuterSessionFrame
        int frameEndTime = sessionLevelEndpoint(sourceName, sessionCloseTime)
        [rangeHighTitleY, rangeLowTitleY, titleClearance] = rangeTitleLayout(profile, profileRangeLabelSize(sourceName))
        color outerColor = profileOuterColor(sourceName)
        array.push(drawnBoxes, box.new(left=profile.startTime, top=rangeHighTitleY + titleClearance, right=frameEndTime, bottom=rangeLowTitleY - titleClearance, xloc=xloc.bar_time, border_color=outerColor, border_width=1, border_style=line.style_solid, bgcolor=color.new(outerColor, 100)))

renderReferenceLevel(DeltaProfile profile, string sourceName, int sessionCloseTime, bool historical, float price, string levelName, color lineColor) =>
    int levelEndTime = sessionLevelEndpoint(sourceName, sessionCloseTime)
    string labelText = profileDisplayName(sourceName) + " " + LEVEL_POC
    string lineStyle = levelName == LEVEL_POC ? STYLE_DASHED : STYLE_SOLID
    int effectiveWidth = levelName == LEVEL_POC ? POC_LEVEL_WIDTH : VALUE_AREA_LEVEL_WIDTH
    array.push(drawnLines, line.new(profile.startTime, price, levelEndTime, price, xloc=xloc.bar_time, color=lineColor, style=toLineStyle(lineStyle), width=effectiveWidth))
    if levelName == LEVEL_POC
        array.push(drawnLabels, label.new(levelEndTime + pocLabelOffsetMs(), price, labelText, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, textcolor=profilePocLabelColor(sourceName), size=POC_LABEL_SIZE, color=color.new(color.white, 100)))

renderProfileLevels(DeltaProfile profile, string sourceName, int sessionCloseTime, bool historical, float pocPrice, float valueAreaLowPrice, float valueAreaHighPrice) =>
    if showValueAreaLevels
        color levelColor = profileValueAreaLevelColor(sourceName)
        renderReferenceLevel(profile, sourceName, sessionCloseTime, historical, valueAreaHighPrice, LEVEL_VAH, levelColor)
        renderReferenceLevel(profile, sourceName, sessionCloseTime, historical, valueAreaLowPrice, LEVEL_VAL, levelColor)
    if showPocLevel
        renderReferenceLevel(profile, sourceName, sessionCloseTime, historical, pocPrice, LEVEL_POC, profilePocLevelColor(sourceName))

renderRangeLabels(DeltaProfile profile, string sourceName, array<int> chartTimes, int startScaleIndex, int endScaleIndex) =>
    string labelSize = profileRangeLabelSize(sourceName)
    color labelColor = profileRangeLabelColor(sourceName)
    int middleTime = rangeCenterTime(profile, chartTimes, startScaleIndex, endScaleIndex)
    [rangeHighTitleY, rangeLowTitleY, _] = rangeTitleLayout(profile, labelSize)
    string rangeLabel = profileDisplayName(sourceName)
    color labelBackgroundColor = profileTextBackgroundColor(sourceName)
    bool fixedSource = sourceName == SOURCE_FIXED
    if fixedSource
        array.push(drawnLabels, label.new(profile.startTime, rangeHighTitleY, "Fixed Start", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelColor, size=toLabelSize(labelSize), color=labelBackgroundColor))
        array.push(drawnLabels, label.new(profile.endTime, rangeHighTitleY, "Fixed End", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelColor, size=toLabelSize(labelSize), color=labelBackgroundColor))
    array.push(drawnLabels, label.new(middleTime, rangeHighTitleY, rangeLabel, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelColor, size=toLabelSize(labelSize), color=labelBackgroundColor))
    array.push(drawnLabels, label.new(middleTime, rangeLowTitleY, rangeLabel, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, textcolor=labelColor, size=toLabelSize(labelSize), color=labelBackgroundColor))

selectSessionProfiles(int historyCount, bool currentPeriodActive, bool hideDeveloping, array<float> barHighs, array<float> barLows, array<float> barVolumes, array<float> barDeltas, array<DeltaProfile> completedProfiles, array<int> startRef, array<float> sampleHighs, array<float> sampleLows, array<float> sampleVolumes, array<float> sampleDeltas, int developingEndTime) =>
    array<DeltaProfile> selectedProfiles = array.new<DeltaProfile>()
    int completedCount = array.size(completedProfiles)
    bool showDeveloping = currentPeriodActive and not hideDeveloping
    int currentCompletedIndex = currentPeriodActive ? -1 : completedCount - 1
    int historyEndIndex = currentPeriodActive ? completedCount - 1 : currentCompletedIndex - 1
    int availableHistoryCount = math.max(0, historyEndIndex + 1)
    int selectedHistoryCount = math.min(historyCount, availableHistoryCount)
    int historyStartIndex = historyEndIndex - selectedHistoryCount + 1
    if selectedHistoryCount > 0
        for profileIndex = historyStartIndex to historyEndIndex
            array.push(selectedProfiles, array.get(completedProfiles, profileIndex))
    int currentIndex = -1
    DeltaProfile currentProfile = na
    if showDeveloping
        currentProfile := buildDevelopingDeltaProfile(barHighs, barLows, barVolumes, barDeltas, startRef, sampleHighs, sampleLows, sampleVolumes, sampleDeltas, developingEndTime)
    else if currentCompletedIndex >= 0
        currentProfile := array.get(completedProfiles, currentCompletedIndex)
    if not na(currentProfile) and currentProfile.isValid
        currentIndex := array.size(selectedProfiles)
        array.push(selectedProfiles, currentProfile)
    ProfileSelection.new(selectedProfiles, currentIndex, showDeveloping and currentIndex >= 0)

renderSelectedProfile(DeltaProfile profile, string sourceName, bool historical, bool developing, bool twentyFourSeven, array<int> chartTimes, int deltaProfilesRemaining, int deltaLayersPerProfile) =>
    [_, valueAreaLowRow, valueAreaHighRow, pocPrice, valueAreaLowPrice, valueAreaHighPrice] = profileValueLevels(profile)
    int startScaleIndex = nearestChartTimeIndex(chartTimes, profile.startTime)
    int endScaleIndex = nearestChartTimeIndex(chartTimes, profile.endTime)
    int sessionCloseTime = sessionOccurrenceClose(sourceName, profile, twentyFourSeven, developing)
    int sessionTradingDayKey = tradingDayKey(sessionCloseTime)

    renderOuterSessionFrame(profile, sourceName, sessionCloseTime, historical)
    renderRangeLabels(profile, sourceName, chartTimes, startScaleIndex, endScaleIndex)
    renderProfileBox(profile, sourceName)

    if showHistogram
        int reservedDeltaPolylines = math.min(INDICATOR_MAX_POLYLINES, math.max(0, deltaProfilesRemaining) * deltaLayersPerProfile)
        int availablePolylines = math.max(0, INDICATOR_MAX_POLYLINES - array.size(drawnPolylines) - reservedDeltaPolylines)
        renderHistogram(profile, valueAreaLowRow, valueAreaHighRow, availablePolylines, chartTimes, startScaleIndex, endScaleIndex)

    array<float> strengths = computeRowStrengths(profile)
    renderDeltaPolylines(profile, sourceName, strengths, chartTimes, startScaleIndex, endScaleIndex)
    renderProfileLevels(profile, sourceName, sessionCloseTime, historical, pocPrice, valueAreaLowPrice, valueAreaHighPrice)
    renderLowVolumeStructures(profile, sourceName, sessionCloseTime, sessionTradingDayKey, historical)
    collectOutlierPeaks(profile, strengths, sourceName, sessionCloseTime, sessionTradingDayKey, historical)
    flushPendingOutlierLevels(mergeOverlaps)

renderProfileSelection(ProfileSelection selection, string sourceName, bool twentyFourSeven, array<int> chartTimes, int deltaProfilesRemaining, int deltaLayersPerProfile) =>
    int remainingProfiles = deltaProfilesRemaining
    int selectedCount = array.size(selection.profiles)
    if selectedCount > 0
        for selectedIndex = 0 to selectedCount - 1
            DeltaProfile profile = array.get(selection.profiles, selectedIndex)
            bool historical = selectedIndex != selection.currentIndex
            bool developing = selectedIndex == selection.currentIndex and selection.currentDeveloping
            renderSelectedProfile(profile, sourceName, historical, developing, twentyFourSeven, chartTimes, remainingProfiles, deltaLayersPerProfile)
            remainingProfiles := math.max(0, remainingProfiles - 1)
    remainingProfiles

// ═══════════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE
// ═══════════════════════════════════════════════════════════════════════════════
addColorRow(array<ColorRow> rows, string name, color swatchColor, string widthText) =>
    array.push(rows, ColorRow.new(name, swatchColor, widthText))

addProfileColorRows(array<ColorRow> rows, string sourceName, bool includeOuter) =>
    addColorRow(rows, sourceName + " Inner", profileInnerColor(sourceName), str.tostring(SESSION_OUTLINE_WIDTH))
    addColorRow(rows, sourceName + " Title", profileRangeLabelColor(sourceName), "")
    if includeOuter
        addColorRow(rows, sourceName + " Outer", profileOuterColor(sourceName), str.tostring(SESSION_OUTLINE_WIDTH))

addSharedDeltaColorRows(array<ColorRow> rows, string sourceName) =>
    string widthText = str.tostring(profileDeltaHistogramWidthPercent(sourceName)) + "%"
    if deltaHistogramRows == OPTION_ALL or deltaHistogramRows == DELTA_ROWS_BUY
        addColorRow(rows, sourceName + " " + DELTA_ROWS_BUY, deltaPlusColor, widthText)
        addColorRow(rows, sourceName + " " + DELTA_TIER_VISIBILITY_BUY, deltaPlusPlusColor, widthText)
    if deltaHistogramRows == OPTION_ALL or deltaHistogramRows == DELTA_ROWS_SELL
        addColorRow(rows, sourceName + " " + DELTA_ROWS_SELL, deltaMinusColor, widthText)
        addColorRow(rows, sourceName + " " + DELTA_TIER_VISIBILITY_SELL, deltaMinusMinusColor, widthText)

addTierSideAppearanceRows(array<ColorRow> rows, string rowPrefix, int tier, string sideName, bool includeLine, color lineColor, int lineWidth, bool includeMarker, color markerColor, bool includeZone, color zoneColor) =>
    string prefix = rowPrefix + "Tier " + str.tostring(tier) + " " + sideName
    if includeLine
        addColorRow(rows, prefix + " Line", lineColor, str.tostring(lineWidth))
    if includeMarker
        addColorRow(rows, prefix + " Marker", markerColor, "")
    if includeZone
        addColorRow(rows, prefix + " Zone", zoneColor, "Fill")

addExtendedAlternateStyleRows(array<ColorRow> rows) =>
    string prefix = SOURCE_EXTENDED_NY_EARLY + " Alt "
    bool buyDeltaActive = deltaHistogramRows == OPTION_ALL or deltaHistogramRows == DELTA_ROWS_BUY
    bool sellDeltaActive = deltaHistogramRows == OPTION_ALL or deltaHistogramRows == DELTA_ROWS_SELL
    if buyDeltaActive
        addColorRow(rows, prefix + DELTA_ROWS_BUY, extendedAltDeltaPlusColor, str.tostring(extendedNyEarlyDeltaHistogramWidthPercent) + "%")
        addColorRow(rows, prefix + DELTA_TIER_VISIBILITY_BUY, extendedAltDeltaPlusPlusColor, str.tostring(extendedNyEarlyDeltaHistogramWidthPercent) + "%")
    if sellDeltaActive
        addColorRow(rows, prefix + DELTA_ROWS_SELL, extendedAltDeltaMinusColor, str.tostring(extendedNyEarlyDeltaHistogramWidthPercent) + "%")
        addColorRow(rows, prefix + DELTA_TIER_VISIBILITY_SELL, extendedAltDeltaMinusMinusColor, str.tostring(extendedNyEarlyDeltaHistogramWidthPercent) + "%")
    bool tier5Active = showDeltaTiers and visibleDeltaTierCount >= 1
    bool tier4Active = showDeltaTiers and visibleDeltaTierCount >= 2
    bool tier3Active = showDeltaTiers and visibleDeltaTierCount >= 3
    bool tier2Active = showDeltaTiers and visibleDeltaTierCount >= 4
    bool tier1Active = showDeltaTiers and visibleDeltaTierCount >= 5
    addTierSideAppearanceRows(rows, prefix, 5, "Buy", tier5Active and deltaTierSideVisible(true), extendedAltTier5BuyLineColor, DELTA_TIER_5_LINE_WIDTH, tier5Active and deltaTierSideVisible(true) and showDots, extendedAltTier5BuyTextColor, tier5Active and deltaTierSideVisible(true), extendedAltTier5BuyZoneColor)
    addTierSideAppearanceRows(rows, prefix, 5, "Sell", tier5Active and deltaTierSideVisible(false), extendedAltTier5SellLineColor, DELTA_TIER_5_LINE_WIDTH, tier5Active and deltaTierSideVisible(false) and showDots, extendedAltTier5SellTextColor, tier5Active and deltaTierSideVisible(false), extendedAltTier5SellZoneColor)
    addTierSideAppearanceRows(rows, prefix, 4, "Buy", tier4Active and deltaTierSideVisible(true), extendedAltTier4BuyLineColor, DELTA_TIER_4_LINE_WIDTH, tier4Active and deltaTierSideVisible(true) and showDots, extendedAltTier4BuyTextColor, tier4Active and deltaTierSideVisible(true), extendedAltTier4BuyZoneColor)
    addTierSideAppearanceRows(rows, prefix, 4, "Sell", tier4Active and deltaTierSideVisible(false), extendedAltTier4SellLineColor, DELTA_TIER_4_LINE_WIDTH, tier4Active and deltaTierSideVisible(false) and showDots, extendedAltTier4SellTextColor, tier4Active and deltaTierSideVisible(false), extendedAltTier4SellZoneColor)
    addTierSideAppearanceRows(rows, prefix, 3, "Buy", false, na, 0, tier3Active and deltaTierSideVisible(true) and showDots, extendedAltTier3BuyTextColor, tier3Active and deltaTierSideVisible(true), extendedAltTier3BuyZoneColor)
    addTierSideAppearanceRows(rows, prefix, 3, "Sell", false, na, 0, tier3Active and deltaTierSideVisible(false) and showDots, extendedAltTier3SellTextColor, tier3Active and deltaTierSideVisible(false), extendedAltTier3SellZoneColor)
    addTierSideAppearanceRows(rows, prefix, 2, "Buy", false, na, 0, tier2Active and deltaTierSideVisible(true) and showDots, extendedAltTier2BuyTextColor, tier2Active and deltaTierSideVisible(true), extendedAltTier2BuyZoneColor)
    addTierSideAppearanceRows(rows, prefix, 2, "Sell", false, na, 0, tier2Active and deltaTierSideVisible(false) and showDots, extendedAltTier2SellTextColor, tier2Active and deltaTierSideVisible(false), extendedAltTier2SellZoneColor)
    addTierSideAppearanceRows(rows, prefix, 1, "Buy", false, na, 0, tier1Active and deltaTierSideVisible(true) and showDots, extendedAltTier1BuyTextColor, tier1Active and deltaTierSideVisible(true), extendedAltTier1BuyZoneColor)
    addTierSideAppearanceRows(rows, prefix, 1, "Sell", false, na, 0, tier1Active and deltaTierSideVisible(false) and showDots, extendedAltTier1SellTextColor, tier1Active and deltaTierSideVisible(false), extendedAltTier1SellZoneColor)
    if showValueAreaLevels
        addColorRow(rows, prefix + "VAH/L Lines", extendedAltValueAreaLevelColor, str.tostring(VALUE_AREA_LEVEL_WIDTH))
    if showPocLevel
        addColorRow(rows, prefix + "POC Line", extendedAltPocLevelColor, str.tostring(POC_LEVEL_WIDTH))
        addColorRow(rows, prefix + INPUT_LABEL_POC_LABEL, extendedAltPocLabelColor, "")
    if showMinimumLvnTiers
        addColorRow(rows, prefix + "Low Volume Cliff Line", extendedAltLowVolumeCliffLineColor, str.tostring(LOW_VOLUME_LINE_WIDTH))
        addColorRow(rows, prefix + "Low Volume Text", extendedAltLowVolumeTextColor, "")
        addColorRow(rows, prefix + "Low Volume Zone", extendedAltLowVolumeZoneColor, "Fill")
    addColorRow(rows, prefix + "Text Background", extendedAltTextBackgroundColor, "")

writeColorRow(table referenceTable, int row, ColorRow entry) =>
    string rgbText = str.format("R:{0} G:{1} B:{2}", int(color.r(entry.swatchColor)), int(color.g(entry.swatchColor)), int(color.b(entry.swatchColor)))
    string transparencyText = str.tostring(int(color.t(entry.swatchColor)))
    table.cell(referenceTable, 0, row, entry.name, text_size=size.small, text_color=color.rgb(0, 0, 0))
    table.cell(referenceTable, 1, row, rgbText, text_size=size.small, text_color=color.rgb(0, 0, 0))
    table.cell(referenceTable, 2, row, transparencyText, text_size=size.small, text_color=color.rgb(0, 0, 0))
    table.cell(referenceTable, 3, row, entry.widthText, text_size=size.small, text_color=color.rgb(0, 0, 0))

// ═══════════════════════════════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════════════════════════════
var array<float> fixedBarHighs = array.new<float>()
var array<float> fixedBarLows = array.new<float>()
var array<float> fixedBarVolumes = array.new<float>()
var array<float> fixedBarDeltas = array.new<float>()

var array<float> rollingBarHighs = array.new<float>()
var array<float> rollingBarLows = array.new<float>()
var array<float> rollingBarVolumes = array.new<float>()
var array<float> rollingBarDeltas = array.new<float>()
var array<int> rollingSampleStartKeys = array.new<int>()
var array<int> rollingSampleEndKeys = array.new<int>()
var array<int> rollingSampleStartTimes = array.new<int>()
var array<int> rollingSampleEndTimes = array.new<int>()

var array<float> rthBarHighs = array.new<float>()
var array<float> rthBarLows = array.new<float>()
var array<float> rthBarVolumes = array.new<float>()
var array<float> rthBarDeltas = array.new<float>()
var array<DeltaProfile> rthProfiles = array.new<DeltaProfile>()
var array<int> rthStartRef = array.new<int>(1, START_TIME_UNSET)
var array<int> rthLastBarRef = array.new<int>(1, START_TIME_UNSET)

var array<float> globexBarHighs = array.new<float>()
var array<float> globexBarLows = array.new<float>()
var array<float> globexBarVolumes = array.new<float>()
var array<float> globexBarDeltas = array.new<float>()
var array<DeltaProfile> globexProfiles = array.new<DeltaProfile>()
var array<int> globexStartRef = array.new<int>(1, START_TIME_UNSET)
var array<int> globexLastBarRef = array.new<int>(1, START_TIME_UNSET)

var array<float> nyEarlyBarHighs = array.new<float>()
var array<float> nyEarlyBarLows = array.new<float>()
var array<float> nyEarlyBarVolumes = array.new<float>()
var array<float> nyEarlyBarDeltas = array.new<float>()
var array<DeltaProfile> nyEarlyProfiles = array.new<DeltaProfile>()
var array<int> nyEarlyStartRef = array.new<int>(1, START_TIME_UNSET)
var array<int> nyEarlyLastBarRef = array.new<int>(1, START_TIME_UNSET)

// Simultaneous overlays require independent retained state.
var array<float> extendedNyEarlyBarHighs = array.new<float>()
var array<float> extendedNyEarlyBarLows = array.new<float>()
var array<float> extendedNyEarlyBarVolumes = array.new<float>()
var array<float> extendedNyEarlyBarDeltas = array.new<float>()
var array<DeltaProfile> extendedNyEarlyProfiles = array.new<DeltaProfile>()
var array<int> extendedNyEarlyStartRef = array.new<int>(1, START_TIME_UNSET)
var array<int> extendedNyEarlyLastBarRef = array.new<int>(1, START_TIME_UNSET)
var array<float> extendedOpeningPendingHighs = array.new<float>()
var array<float> extendedOpeningPendingLows = array.new<float>()
var array<float> extendedOpeningPendingVolumes = array.new<float>()
var array<float> extendedOpeningPendingDeltas = array.new<float>()
var bool extendedOpeningQualified = false

var array<float> ivbBarHighs = array.new<float>()
var array<float> ivbBarLows = array.new<float>()
var array<float> ivbBarVolumes = array.new<float>()
var array<float> ivbBarDeltas = array.new<float>()
var array<DeltaProfile> ivbProfiles = array.new<DeltaProfile>()
var array<int> ivbStartRef = array.new<int>(1, START_TIME_UNSET)
var array<int> ivbLastBarRef = array.new<int>(1, START_TIME_UNSET)

var array<float> weeklyBarHighs = array.new<float>()
var array<float> weeklyBarLows = array.new<float>()
var array<float> weeklyBarVolumes = array.new<float>()
var array<float> weeklyBarDeltas = array.new<float>()
var array<DeltaProfile> weeklyProfiles = array.new<DeltaProfile>()
var array<int> weeklyStartRef = array.new<int>(1, START_TIME_UNSET)
var array<int> weeklyLastBarRef = array.new<int>(1, START_TIME_UNSET)

var array<float> monthlyBarHighs = array.new<float>()
var array<float> monthlyBarLows = array.new<float>()
var array<float> monthlyBarVolumes = array.new<float>()
var array<float> monthlyBarDeltas = array.new<float>()
var array<DeltaProfile> monthlyProfiles = array.new<DeltaProfile>()
var array<int> monthlyStartRef = array.new<int>(1, START_TIME_UNSET)
var array<int> monthlyLastBarRef = array.new<int>(1, START_TIME_UNSET)

var bool isTwentyFourSevenAsset = false
var bool assetClassificationReady = false
var int lastTickDirection = 1
var float previousTapeClose = na
var int lastAcceptedRangeIntrabarTime = na

// ═══════════════════════════════════════════════════════════════════════════════
// DATA & BOUNDARIES
// ═══════════════════════════════════════════════════════════════════════════════
string intrabarTimeframe = autoIntrabarTimeframe()
string intrabarTickerId = chart.is_range ? ticker.new(syminfo.prefix, syminfo.ticker, syminfo.session) : syminfo.tickerid
[intrabarTimes, intrabarEndTimes, intrabarOpens, intrabarHighs, intrabarLows, intrabarCloses, intrabarVolumes] = request.security_lower_tf(intrabarTickerId, intrabarTimeframe, [time, time_close, open, high, low, close, volume], ignore_invalid_timeframe=true)

// Weekend bars identify 24/7 assets.
if not assetClassificationReady
    if syminfo.type == "crypto"
        isTwentyFourSevenAsset := true
        assetClassificationReady := true
    else if isTrueWeekendBar(time)
        isTwentyFourSevenAsset := true
        assetClassificationReady := true
    else
        int barsInWeek = math.max(1, int(math.ceil(SECONDS_PER_WEEK / timeframe.in_seconds(timeframe.period))))
        int observationWindow = math.min(ASSET_DETECTION_MAX_LOOKBACK, barsInWeek)
        if bar_index >= observationWindow
            isTwentyFourSevenAsset := false
            assetClassificationReady := true

rthInSessionWeekday = not na(time(timeframe.period, RTH_SESSION, NY_TIMEZONE))
rthInSessionAllDays = not na(time(timeframe.period, RTH_SESSION_ALL_DAYS, NY_TIMEZONE))
rthInSession = isTwentyFourSevenAsset ? rthInSessionAllDays : rthInSessionWeekday
rthSessionStart = rthInSession and not rthInSession[1]
rthSessionEnd = not rthInSession and rthInSession[1]

utcDayStart = calendarDayStart(UTC_TIMEZONE)
futuresGlobexStart = shiftedCalendarDayStart(NY_TIMEZONE, GLOBEX_REOPEN_SHIFT_MS)
globexDayStart = isTwentyFourSevenAsset ? utcDayStart : futuresGlobexStart
weeklyPeriodStart = weeklyBoundary(isTwentyFourSevenAsset, utcDayStart, futuresGlobexStart, time)
utcMonthStart = shiftedCalendarMonthStart(UTC_TIMEZONE, 0)
futuresMonthStart = shiftedCalendarMonthStart(NY_TIMEZONE, GLOBEX_REOPEN_SHIFT_MS)
monthlyPeriodStart = isTwentyFourSevenAsset ? utcMonthStart : futuresMonthStart

fixedRangeStart = math.min(fixedRangeStartInput, fixedRangeEndInput)
fixedRangeEnd = math.max(fixedRangeStartInput, fixedRangeEndInput)
rollingRangeEnd = rollingThroughTime(last_bar_time, rollingThrough, isTwentyFourSevenAsset)
rollingRangeStart = lookbackDaysStart(rollingRangeEnd, rollingLookbackDays, isTwentyFourSevenAsset)

array<float> barSampleHighs = array.new<float>()
array<float> barSampleLows = array.new<float>()
array<float> barSampleVolumes = array.new<float>()
array<float> barSampleDeltas = array.new<float>()
array<float> nyEarlySampleHighs = array.new<float>()
array<float> nyEarlySampleLows = array.new<float>()
array<float> nyEarlySampleVolumes = array.new<float>()
array<float> nyEarlySampleDeltas = array.new<float>()
array<float> extendedNyEarlySampleHighs = array.new<float>()
array<float> extendedNyEarlySampleLows = array.new<float>()
array<float> extendedNyEarlySampleVolumes = array.new<float>()
array<float> extendedNyEarlySampleDeltas = array.new<float>()
array<float> extendedOpeningSampleHighs = array.new<float>()
array<float> extendedOpeningSampleLows = array.new<float>()
array<float> extendedOpeningSampleVolumes = array.new<float>()
array<float> extendedOpeningSampleDeltas = array.new<float>()
array<float> ivbSampleHighs = array.new<float>()
array<float> ivbSampleLows = array.new<float>()
array<float> ivbSampleVolumes = array.new<float>()
array<float> ivbSampleDeltas = array.new<float>()
int nyEarlyFirstSampleTime = na
int nyEarlyLastSampleEndTime = na
int extendedNyEarlyFirstSampleTime = na
int extendedNyEarlyLastSampleEndTime = na
int ivbFirstSampleTime = na
int ivbLastSampleEndTime = na
bool nyEarlyWindowObserved = false
bool extendedNyEarlyWindowObserved = false
bool extendedOpeningWindowObserved = false
bool ivbWindowObserved = false
bool boundedSessionSamplesRequired = nyEarlyModeActive or extendedNyEarlyModeActive or ivbModeActive
int subBarCount = array.size(intrabarVolumes)
if subBarCount > 0
    for subBarIndex = 0 to subBarCount - 1
        int subTime = array.get(intrabarTimes, subBarIndex)
        int subEndTime = array.get(intrabarEndTimes, subBarIndex)
        float subOpen = array.get(intrabarOpens, subBarIndex)
        float subHigh = array.get(intrabarHighs, subBarIndex)
        float subLow = array.get(intrabarLows, subBarIndex)
        float subClose = array.get(intrabarCloses, subBarIndex)
        float subVolume = array.get(intrabarVolumes, subBarIndex)
        int rangeSampleCutoffTime = na(time_close) ? timenow : time_close
        bool rangeIntrabarClosed = not na(subEndTime) and subEndTime <= rangeSampleCutoffTime
        bool rangeIntrabarUsable = rangeIntrabarClosed or not barstate.isconfirmed
        bool acceptRangeSample = not chart.is_range or (rangeIntrabarUsable and (na(lastAcceptedRangeIntrabarTime) or subTime > lastAcceptedRangeIntrabarTime))
        bool boundedDayAllowed = boundedSessionSamplesRequired and (isTwentyFourSevenAsset or isNyWeekday(subTime))
        bool subInNyEarly = nyEarlyModeActive and boundedDayAllowed and inNyMinuteWindow(subTime, NY_EARLY_START_MINUTE, NY_EARLY_END_MINUTE)
        bool subInExtendedNyEarly = extendedNyEarlyModeActive and boundedDayAllowed and inNyMinuteWindow(subTime, NY_EARLY_START_MINUTE, IVB_START_MINUTE)
        bool subInExtendedOpening = extendedNyEarlyModeActive and extendedNyEarlyIncludeOpeningBreak and boundedDayAllowed and inNyMinuteWindow(subTime, IVB_START_MINUTE, EXTENDED_NY_EARLY_OPENING_END_MINUTE)
        bool subInIvb = ivbModeActive and boundedDayAllowed and inNyMinuteWindow(subTime, IVB_START_MINUTE, IVB_END_MINUTE)
        if subInNyEarly
            nyEarlyWindowObserved := true
            nyEarlyFirstSampleTime := na(nyEarlyFirstSampleTime) ? subTime : nyEarlyFirstSampleTime
            nyEarlyLastSampleEndTime := na(subEndTime) ? subTime : subEndTime
        if subInExtendedNyEarly
            extendedNyEarlyWindowObserved := true
            extendedNyEarlyFirstSampleTime := na(extendedNyEarlyFirstSampleTime) ? subTime : extendedNyEarlyFirstSampleTime
            extendedNyEarlyLastSampleEndTime := na(subEndTime) ? subTime : subEndTime
        if subInExtendedOpening
            extendedNyEarlyWindowObserved := true
            extendedOpeningWindowObserved := true
            extendedNyEarlyLastSampleEndTime := na(subEndTime) ? subTime : subEndTime
        if subInIvb
            ivbWindowObserved := true
            ivbFirstSampleTime := na(ivbFirstSampleTime) ? subTime : ivbFirstSampleTime
            ivbLastSampleEndTime := na(subEndTime) ? subTime : subEndTime
        if acceptRangeSample and not na(subVolume) and subVolume > 0 and not na(subHigh) and not na(subLow)
            int direction = na(subOpen) or na(subClose) ? lastTickDirection : subClose > subOpen ? 1 : subClose < subOpen ? -1 : not na(previousTapeClose) and subClose > previousTapeClose ? 1 : not na(previousTapeClose) and subClose < previousTapeClose ? -1 : lastTickDirection
            lastTickDirection := direction
            if not na(subClose)
                previousTapeClose := subClose
            if chart.is_range and rangeIntrabarClosed
                lastAcceptedRangeIntrabarTime := subTime
            float subDelta = subVolume * direction
            appendBarSample(barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, subHigh, subLow, subVolume, subDelta)
            if subInNyEarly
                appendBarSample(nyEarlySampleHighs, nyEarlySampleLows, nyEarlySampleVolumes, nyEarlySampleDeltas, subHigh, subLow, subVolume, subDelta)
            if subInExtendedNyEarly
                appendBarSample(extendedNyEarlySampleHighs, extendedNyEarlySampleLows, extendedNyEarlySampleVolumes, extendedNyEarlySampleDeltas, subHigh, subLow, subVolume, subDelta)
            if subInExtendedOpening
                appendBarSample(extendedOpeningSampleHighs, extendedOpeningSampleLows, extendedOpeningSampleVolumes, extendedOpeningSampleDeltas, subHigh, subLow, subVolume, subDelta)
            if subInIvb
                appendBarSample(ivbSampleHighs, ivbSampleLows, ivbSampleVolumes, ivbSampleDeltas, subHigh, subLow, subVolume, subDelta)
bool fallbackBarValid = not na(volume) and volume > 0 and not na(high) and not na(low)
bool barSampleFallbackRequired = fallbackBarValid and array.size(barSampleVolumes) == 0
bool fallbackDayAllowed = boundedSessionSamplesRequired and (isTwentyFourSevenAsset or isNyWeekday(time))
bool nyEarlySampleFallbackRequired = fallbackBarValid and nyEarlyModeActive and array.size(nyEarlySampleVolumes) == 0 and fallbackDayAllowed and barFitsNyMinuteWindow(time, time_close, NY_EARLY_START_MINUTE, NY_EARLY_END_MINUTE)
bool extendedNyEarlySampleFallbackRequired = fallbackBarValid and extendedNyEarlyModeActive and array.size(extendedNyEarlySampleVolumes) == 0 and fallbackDayAllowed and barFitsNyMinuteWindow(time, time_close, NY_EARLY_START_MINUTE, IVB_START_MINUTE)
bool extendedOpeningSampleFallbackRequired = fallbackBarValid and extendedNyEarlyModeActive and extendedNyEarlyIncludeOpeningBreak and array.size(extendedOpeningSampleVolumes) == 0 and fallbackDayAllowed and barFitsNyMinuteWindow(time, time_close, IVB_START_MINUTE, EXTENDED_NY_EARLY_OPENING_END_MINUTE)
bool ivbSampleFallbackRequired = fallbackBarValid and ivbModeActive and array.size(ivbSampleVolumes) == 0 and fallbackDayAllowed and barFitsNyMinuteWindow(time, time_close, IVB_START_MINUTE, IVB_END_MINUTE)
if barSampleFallbackRequired or nyEarlySampleFallbackRequired or extendedNyEarlySampleFallbackRequired or extendedOpeningSampleFallbackRequired or ivbSampleFallbackRequired
    int fallbackDirection = close > open ? 1 : close < open ? -1 : not na(previousTapeClose) and close > previousTapeClose ? 1 : not na(previousTapeClose) and close < previousTapeClose ? -1 : lastTickDirection
    float fallbackDelta = volume * fallbackDirection
    int fallbackEndTime = na(time_close) ? timenow : time_close
    if barSampleFallbackRequired
        lastTickDirection := fallbackDirection
        previousTapeClose := close
        appendBarSample(barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, high, low, volume, fallbackDelta)
    if nyEarlySampleFallbackRequired
        appendBarSample(nyEarlySampleHighs, nyEarlySampleLows, nyEarlySampleVolumes, nyEarlySampleDeltas, high, low, volume, fallbackDelta)
        nyEarlyWindowObserved := true
        nyEarlyFirstSampleTime := time
        nyEarlyLastSampleEndTime := fallbackEndTime
    if extendedNyEarlySampleFallbackRequired
        appendBarSample(extendedNyEarlySampleHighs, extendedNyEarlySampleLows, extendedNyEarlySampleVolumes, extendedNyEarlySampleDeltas, high, low, volume, fallbackDelta)
        extendedNyEarlyWindowObserved := true
        extendedNyEarlyFirstSampleTime := time
        extendedNyEarlyLastSampleEndTime := fallbackEndTime
    if extendedOpeningSampleFallbackRequired
        appendBarSample(extendedOpeningSampleHighs, extendedOpeningSampleLows, extendedOpeningSampleVolumes, extendedOpeningSampleDeltas, high, low, volume, fallbackDelta)
        extendedNyEarlyWindowObserved := true
        extendedOpeningWindowObserved := true
        extendedNyEarlyLastSampleEndTime := fallbackEndTime
    if ivbSampleFallbackRequired
        appendBarSample(ivbSampleHighs, ivbSampleLows, ivbSampleVolumes, ivbSampleDeltas, high, low, volume, fallbackDelta)
        ivbWindowObserved := true
        ivbFirstSampleTime := time
        ivbLastSampleEndTime := fallbackEndTime

int chartTimeframeSeconds = timeframe.in_seconds(timeframe.period)
bool openingChartBarContained = not na(chartTimeframeSeconds) and chartTimeframeSeconds <= EXTENDED_NY_EARLY_OPENING_DURATION_MINUTES * SECONDS_PER_MINUTE and inNyMinuteWindow(time, IVB_START_MINUTE, EXTENDED_NY_EARLY_OPENING_END_MINUTE) and time_close <= nyMinuteBoundary(time, EXTENDED_NY_EARLY_OPENING_END_MINUTE)
bool storedExtendedRangeReady = array.size(extendedNyEarlyBarHighs) > 0 and array.size(extendedNyEarlyBarLows) > 0
bool currentExtendedRangeReady = array.size(extendedNyEarlySampleHighs) > 0 and array.size(extendedNyEarlySampleLows) > 0
bool extendedRangeReady = extendedOpeningWindowObserved and (storedExtendedRangeReady or currentExtendedRangeReady)
float storedExtendedRangeHigh = storedExtendedRangeReady ? array.max(extendedNyEarlyBarHighs) : na
float storedExtendedRangeLow = storedExtendedRangeReady ? array.min(extendedNyEarlyBarLows) : na
float currentExtendedRangeHigh = currentExtendedRangeReady ? array.max(extendedNyEarlySampleHighs) : na
float currentExtendedRangeLow = currentExtendedRangeReady ? array.min(extendedNyEarlySampleLows) : na
float extendedRangeHigh = storedExtendedRangeReady and currentExtendedRangeReady ? math.max(storedExtendedRangeHigh, currentExtendedRangeHigh) : storedExtendedRangeReady ? storedExtendedRangeHigh : currentExtendedRangeHigh
float extendedRangeLow = storedExtendedRangeReady and currentExtendedRangeReady ? math.min(storedExtendedRangeLow, currentExtendedRangeLow) : storedExtendedRangeReady ? storedExtendedRangeLow : currentExtendedRangeLow
bool sampledOpeningBreak = extendedRangeReady and array.size(extendedOpeningSampleVolumes) > 0 and (array.max(extendedOpeningSampleHighs) > extendedRangeHigh or array.min(extendedOpeningSampleLows) < extendedRangeLow)
bool chartOpeningBreak = extendedRangeReady and openingChartBarContained and (high > extendedRangeHigh or low < extendedRangeLow)
bool extendedOpeningBreakThisBar = extendedOpeningWindowObserved and extendedRangeReady and (sampledOpeningBreak or chartOpeningBreak)
bool extendedOpeningQualifiedThisBar = extendedOpeningWindowObserved and (extendedOpeningQualified or extendedOpeningBreakThisBar)
if extendedOpeningQualifiedThisBar
    if not extendedOpeningQualified
        appendSamples(extendedNyEarlySampleHighs, extendedNyEarlySampleLows, extendedNyEarlySampleVolumes, extendedNyEarlySampleDeltas, extendedOpeningPendingHighs, extendedOpeningPendingLows, extendedOpeningPendingVolumes, extendedOpeningPendingDeltas, false)
    appendSamples(extendedNyEarlySampleHighs, extendedNyEarlySampleLows, extendedNyEarlySampleVolumes, extendedNyEarlySampleDeltas, extendedOpeningSampleHighs, extendedOpeningSampleLows, extendedOpeningSampleVolumes, extendedOpeningSampleDeltas, false)

nyEarlyInSession = nyEarlyWindowObserved
nyEarlySessionStart = nyEarlyInSession and not nyEarlyInSession[1]
nyEarlySessionEnd = not nyEarlyInSession and nyEarlyInSession[1]
extendedNyEarlyInSession = extendedNyEarlyWindowObserved
extendedNyEarlySessionStart = extendedNyEarlyInSession and not extendedNyEarlyInSession[1]
extendedNyEarlySessionEnd = not extendedNyEarlyInSession and extendedNyEarlyInSession[1]
ivbInSession = ivbWindowObserved
ivbSessionStart = ivbInSession and not ivbInSession[1]
ivbSessionEnd = not ivbInSession and ivbInSession[1]

// ═══════════════════════════════════════════════════════════════════════════════
// PROCESS
// ═══════════════════════════════════════════════════════════════════════════════
if extendedNyEarlySessionStart
    clearSamples(extendedOpeningPendingHighs, extendedOpeningPendingLows, extendedOpeningPendingVolumes, extendedOpeningPendingDeltas)
    extendedOpeningQualified := false

processAnchor(rthModeActive, SESSION_PROFILE_RETENTION, rthInSession, rthSessionStart, rthSessionEnd, rthBarHighs, rthBarLows, rthBarVolumes, rthBarDeltas, rthProfiles, rthStartRef, rthLastBarRef, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, false)
processAnchor(globexSelected, SESSION_PROFILE_RETENTION, true, globexDayStart, false, globexBarHighs, globexBarLows, globexBarVolumes, globexBarDeltas, globexProfiles, globexStartRef, globexLastBarRef, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, true)
processBoundedNyAnchor(nyEarlyModeActive, SESSION_PROFILE_RETENTION, NY_EARLY_START_MINUTE, NY_EARLY_END_MINUTE, nyEarlyInSession, nyEarlySessionStart, nyEarlySessionEnd, nyEarlyFirstSampleTime, nyEarlyLastSampleEndTime, nyEarlyBarHighs, nyEarlyBarLows, nyEarlyBarVolumes, nyEarlyBarDeltas, nyEarlyProfiles, nyEarlyStartRef, nyEarlyLastBarRef, nyEarlySampleHighs, nyEarlySampleLows, nyEarlySampleVolumes, nyEarlySampleDeltas)
processBoundedNyAnchor(extendedNyEarlyModeActive, SESSION_PROFILE_RETENTION, NY_EARLY_START_MINUTE, extendedOpeningQualifiedThisBar ? EXTENDED_NY_EARLY_OPENING_END_MINUTE : IVB_START_MINUTE, extendedNyEarlyInSession, extendedNyEarlySessionStart, extendedNyEarlySessionEnd, extendedNyEarlyFirstSampleTime, extendedNyEarlyLastSampleEndTime, extendedNyEarlyBarHighs, extendedNyEarlyBarLows, extendedNyEarlyBarVolumes, extendedNyEarlyBarDeltas, extendedNyEarlyProfiles, extendedNyEarlyStartRef, extendedNyEarlyLastBarRef, extendedNyEarlySampleHighs, extendedNyEarlySampleLows, extendedNyEarlySampleVolumes, extendedNyEarlySampleDeltas)
processBoundedNyAnchor(ivbModeActive, SESSION_PROFILE_RETENTION, IVB_START_MINUTE, IVB_END_MINUTE, ivbInSession, ivbSessionStart, ivbSessionEnd, ivbFirstSampleTime, ivbLastSampleEndTime, ivbBarHighs, ivbBarLows, ivbBarVolumes, ivbBarDeltas, ivbProfiles, ivbStartRef, ivbLastBarRef, ivbSampleHighs, ivbSampleLows, ivbSampleVolumes, ivbSampleDeltas)

if barstate.isconfirmed and extendedOpeningWindowObserved
    if extendedOpeningQualifiedThisBar
        clearSamples(extendedOpeningPendingHighs, extendedOpeningPendingLows, extendedOpeningPendingVolumes, extendedOpeningPendingDeltas)
        extendedOpeningQualified := true
    else
        appendSamples(extendedOpeningPendingHighs, extendedOpeningPendingLows, extendedOpeningPendingVolumes, extendedOpeningPendingDeltas, extendedOpeningSampleHighs, extendedOpeningSampleLows, extendedOpeningSampleVolumes, extendedOpeningSampleDeltas, false)
if extendedNyEarlySessionEnd
    clearSamples(extendedOpeningPendingHighs, extendedOpeningPendingLows, extendedOpeningPendingVolumes, extendedOpeningPendingDeltas)
    extendedOpeningQualified := false

processAnchor(weeklySelected, SESSION_PROFILE_RETENTION, true, weeklyPeriodStart, false, weeklyBarHighs, weeklyBarLows, weeklyBarVolumes, weeklyBarDeltas, weeklyProfiles, weeklyStartRef, weeklyLastBarRef, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, true)
processAnchor(monthlySelected, SESSION_PROFILE_RETENTION, true, monthlyPeriodStart, false, monthlyBarHighs, monthlyBarLows, monthlyBarVolumes, monthlyBarDeltas, monthlyProfiles, monthlyStartRef, monthlyLastBarRef, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, true)

bool fixedRangeBarInRange = fixedRangeEnabled and fixedRangeConfigured and time >= fixedRangeStart and time <= fixedRangeEnd
bool rollingRangeConfigured = rollingSelected and not na(last_bar_time)
bool rollingBarRetained = rollingRangeConfigured and time >= rollingRangeStart
if rollingSelected
    pruneRollingSamples(rollingSampleStartKeys, rollingSampleEndKeys, rollingSampleStartTimes, rollingSampleEndTimes, rollingBarHighs, rollingBarLows, rollingBarVolumes, rollingBarDeltas, rollingRangeStart)
if barstate.isconfirmed
    if rollingBarRetained
        appendRollingSamples(rollingSampleStartKeys, rollingSampleEndKeys, rollingSampleStartTimes, rollingSampleEndTimes, rollingBarHighs, rollingBarLows, rollingBarVolumes, rollingBarDeltas, time, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, true)
    if fixedRangeBarInRange
        appendSamples(fixedBarHighs, fixedBarLows, fixedBarVolumes, fixedBarDeltas, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, true)

// ═══════════════════════════════════════════════════════════════════════════════
// SHOW ONLY
// ═══════════════════════════════════════════════════════════════════════════════
inVisibleOvernight = not na(time(timeframe.period, SESSION_WINDOW_OVERNIGHT, NY_TIMEZONE))
inVisibleFrom0500 = not na(time(timeframe.period, SESSION_WINDOW_FROM_0500, NY_TIMEZONE))
inVisibleFrom0830 = not na(time(timeframe.period, SESSION_WINDOW_FROM_0830, NY_TIMEZONE))
inVisibleRth = not na(time(timeframe.period, SESSION_WINDOW_RTH, NY_TIMEZONE))
inVisibleWindow = visibleWindow == WINDOW_LABEL_FROM_0500 ? inVisibleFrom0500 : visibleWindow == WINDOW_LABEL_FROM_0830 ? inVisibleFrom0830 : visibleWindow == WINDOW_LABEL_RTH ? inVisibleRth : inVisibleOvernight
inMostRecentDay = sameCalendarDate(time, timenow, NY_TIMEZONE)
hideThisBar = showOnlyEnabled and not (inVisibleWindow and (not showOnlyMostRecent or inMostRecentDay))

showPanePriceCandles = secondaryPaneMode and showPriceCandlesInPane
paneBodyColor = close >= open ? paneUpBodyColor : paneDownBodyColor
paneBorderColor = close >= open ? paneUpBorderColor : paneDownBorderColor
paneWickColor = close >= open ? paneUpWickColor : paneDownWickColor
hideMainChartCandle = not secondaryPaneMode and hideThisBar
hidePaneCandle = showPanePriceCandles and hideThisBar

plotcandle(showPanePriceCandles ? open : na, high, low, close, title="Pane Price Candles", color=paneBodyColor, bordercolor=paneBorderColor, wickcolor=paneWickColor, editable=false, display=display.pane)
plotcandle(hidePaneCandle ? open : na, high, low, close, title="Pane Hidden", color=hiddenCandleColor, bordercolor=hiddenCandleColor, wickcolor=hiddenCandleColor, editable=false, display=display.pane)
plotcandle(hideMainChartCandle ? open : na, high, low, close, title="Hidden", color=hiddenCandleColor, bordercolor=hiddenCandleColor, wickcolor=hiddenCandleColor, editable=false, display=display.pane, force_overlay=true)

// ═══════════════════════════════════════════════════════════════════════════════
// RENDER
// ═══════════════════════════════════════════════════════════════════════════════
if barstate.islast
    clearDrawings()

    // Include the open bar once.
    DeltaProfile rollingProfile = na
    if rollingRangeConfigured
        int originalSize = array.size(rollingBarVolumes)
        if not barstate.isconfirmed
            if rollingBarRetained
                appendRollingSamples(rollingSampleStartKeys, rollingSampleEndKeys, rollingSampleStartTimes, rollingSampleEndTimes, rollingBarHighs, rollingBarLows, rollingBarVolumes, rollingBarDeltas, time, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, false)
        rollingProfile := buildRollingDeltaProfile(rollingSampleStartTimes, rollingSampleEndTimes, rollingBarHighs, rollingBarLows, rollingBarVolumes, rollingBarDeltas, PROFILE_ROWS, rollingRangeStart, rollingRangeEnd, rollingThrough == ROLLING_THROUGH_LIVE)
        while array.size(rollingBarVolumes) > originalSize
            array.pop(rollingSampleStartKeys)
            array.pop(rollingSampleEndKeys)
            array.pop(rollingSampleStartTimes)
            array.pop(rollingSampleEndTimes)
            array.pop(rollingBarHighs)
            array.pop(rollingBarLows)
            array.pop(rollingBarVolumes)
            array.pop(rollingBarDeltas)

    DeltaProfile fixedProfile = na
    if fixedRangeEnabled and fixedRangeConfigured
        int originalSize = array.size(fixedBarVolumes)
        if not barstate.isconfirmed and fixedRangeBarInRange
            appendSamples(fixedBarHighs, fixedBarLows, fixedBarVolumes, fixedBarDeltas, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, false)
        fixedProfile := buildDeltaProfile(fixedBarHighs, fixedBarLows, fixedBarVolumes, fixedBarDeltas, PROFILE_ROWS, fixedRangeStart, math.min(fixedRangeEnd, time))
        while array.size(fixedBarVolumes) > originalSize
            array.pop(fixedBarHighs)
            array.pop(fixedBarLows)
            array.pop(fixedBarVolumes)
            array.pop(fixedBarDeltas)

    int nyEarlyDevelopingEndTime = nyEarlyInSession ? math.min(nyEarlyLastSampleEndTime, nyMinuteBoundary(array.get(nyEarlyStartRef, 0), NY_EARLY_END_MINUTE)) : array.get(nyEarlyLastBarRef, 0)
    int extendedNyEarlyDevelopingEndTime = extendedNyEarlyInSession ? (extendedOpeningQualifiedThisBar ? math.min(extendedNyEarlyLastSampleEndTime, nyMinuteBoundary(array.get(extendedNyEarlyStartRef, 0), EXTENDED_NY_EARLY_OPENING_END_MINUTE)) : math.min(extendedNyEarlyLastSampleEndTime, nyMinuteBoundary(array.get(extendedNyEarlyStartRef, 0), IVB_START_MINUTE))) : array.get(extendedNyEarlyLastBarRef, 0)
    int ivbDevelopingEndTime = ivbInSession ? math.min(ivbLastSampleEndTime, nyMinuteBoundary(array.get(ivbStartRef, 0), IVB_END_MINUTE)) : array.get(ivbLastBarRef, 0)
    ProfileSelection selectedSessionProfiles = na
    ProfileSelection selectedNyEarlyProfiles = na
    ProfileSelection selectedExtendedNyEarlyProfiles = na
    ProfileSelection selectedIvbProfiles = na
    ProfileSelection selectedRthProfiles = na
    bool groupedNyProfilesActive = nyEarlyIvbModeActive or nyEarlyIvbRthModeActive or (nyEarlyModeActive and extendedNyEarlyModeActive)
    if groupedNyProfilesActive
        if nyEarlyModeActive
            selectedNyEarlyProfiles := selectSessionProfiles(renderedHistoricalDays, nyEarlyInSession, nyEarlyHideDeveloping, nyEarlyBarHighs, nyEarlyBarLows, nyEarlyBarVolumes, nyEarlyBarDeltas, nyEarlyProfiles, nyEarlyStartRef, nyEarlySampleHighs, nyEarlySampleLows, nyEarlySampleVolumes, nyEarlySampleDeltas, nyEarlyDevelopingEndTime)
        if extendedNyEarlyModeActive
            selectedExtendedNyEarlyProfiles := selectSessionProfiles(renderedHistoricalDays, extendedNyEarlyInSession, extendedNyEarlyHideDeveloping, extendedNyEarlyBarHighs, extendedNyEarlyBarLows, extendedNyEarlyBarVolumes, extendedNyEarlyBarDeltas, extendedNyEarlyProfiles, extendedNyEarlyStartRef, extendedNyEarlySampleHighs, extendedNyEarlySampleLows, extendedNyEarlySampleVolumes, extendedNyEarlySampleDeltas, extendedNyEarlyDevelopingEndTime)
        if ivbModeActive
            selectedIvbProfiles := selectSessionProfiles(renderedHistoricalDays, ivbInSession, ivbHideDeveloping, ivbBarHighs, ivbBarLows, ivbBarVolumes, ivbBarDeltas, ivbProfiles, ivbStartRef, ivbSampleHighs, ivbSampleLows, ivbSampleVolumes, ivbSampleDeltas, ivbDevelopingEndTime)
        if nyEarlyIvbRthModeActive
            selectedRthProfiles := selectSessionProfiles(renderedHistoricalDays, rthInSession, rthHideDeveloping, rthBarHighs, rthBarLows, rthBarVolumes, rthBarDeltas, rthProfiles, rthStartRef, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, time)
    else if rthModeActive
        selectedSessionProfiles := selectSessionProfiles(renderedHistoricalDays, rthInSession, rthHideDeveloping, rthBarHighs, rthBarLows, rthBarVolumes, rthBarDeltas, rthProfiles, rthStartRef, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, time)
    else if globexSelected
        selectedSessionProfiles := selectSessionProfiles(renderedHistoricalDays, true, false, globexBarHighs, globexBarLows, globexBarVolumes, globexBarDeltas, globexProfiles, globexStartRef, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, time)
    else if nyEarlyModeActive
        selectedSessionProfiles := selectSessionProfiles(renderedHistoricalDays, nyEarlyInSession, nyEarlyHideDeveloping, nyEarlyBarHighs, nyEarlyBarLows, nyEarlyBarVolumes, nyEarlyBarDeltas, nyEarlyProfiles, nyEarlyStartRef, nyEarlySampleHighs, nyEarlySampleLows, nyEarlySampleVolumes, nyEarlySampleDeltas, nyEarlyDevelopingEndTime)
    else if extendedNyEarlyModeActive
        selectedSessionProfiles := selectSessionProfiles(renderedHistoricalDays, extendedNyEarlyInSession, extendedNyEarlyHideDeveloping, extendedNyEarlyBarHighs, extendedNyEarlyBarLows, extendedNyEarlyBarVolumes, extendedNyEarlyBarDeltas, extendedNyEarlyProfiles, extendedNyEarlyStartRef, extendedNyEarlySampleHighs, extendedNyEarlySampleLows, extendedNyEarlySampleVolumes, extendedNyEarlySampleDeltas, extendedNyEarlyDevelopingEndTime)
    else if ivbModeActive
        selectedSessionProfiles := selectSessionProfiles(renderedHistoricalDays, ivbInSession, ivbHideDeveloping, ivbBarHighs, ivbBarLows, ivbBarVolumes, ivbBarDeltas, ivbProfiles, ivbStartRef, ivbSampleHighs, ivbSampleLows, ivbSampleVolumes, ivbSampleDeltas, ivbDevelopingEndTime)
    else if weeklySelected
        selectedSessionProfiles := selectSessionProfiles(renderedHistoricalDays, true, false, weeklyBarHighs, weeklyBarLows, weeklyBarVolumes, weeklyBarDeltas, weeklyProfiles, weeklyStartRef, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, time)
    else if monthlySelected
        selectedSessionProfiles := selectSessionProfiles(renderedHistoricalDays, true, false, monthlyBarHighs, monthlyBarLows, monthlyBarVolumes, monthlyBarDeltas, monthlyProfiles, monthlyStartRef, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, time)

    if chartTimesBuiltAtBar != bar_index
        cachedChartTimes := recentChartTimes()
        chartTimesBuiltAtBar := bar_index
    array<int> chartTimes = cachedChartTimes
    int remainingDeltaProfiles = 0
    if rollingSelected and not na(rollingProfile) and rollingProfile.isValid
        remainingDeltaProfiles := 1
    else if groupedNyProfilesActive
        if not na(selectedExtendedNyEarlyProfiles)
            remainingDeltaProfiles += array.size(selectedExtendedNyEarlyProfiles.profiles)
        if not na(selectedNyEarlyProfiles)
            remainingDeltaProfiles += array.size(selectedNyEarlyProfiles.profiles)
        if not na(selectedIvbProfiles)
            remainingDeltaProfiles += array.size(selectedIvbProfiles.profiles)
        if not na(selectedRthProfiles)
            remainingDeltaProfiles += array.size(selectedRthProfiles.profiles)
    else if not na(selectedSessionProfiles)
        remainingDeltaProfiles := array.size(selectedSessionProfiles.profiles)
    if rollingSelected and not na(rollingProfile) and rollingProfile.isValid
        renderSelectedProfile(rollingProfile, SOURCE_ROLLING, false, true, isTwentyFourSevenAsset, chartTimes, remainingDeltaProfiles, activeDeltaPolylineLayers)
    else if groupedNyProfilesActive
        // Draw the wider overlay first so original session boundaries remain visible.
        if not na(selectedExtendedNyEarlyProfiles)
            remainingDeltaProfiles := renderProfileSelection(selectedExtendedNyEarlyProfiles, SOURCE_EXTENDED_NY_EARLY, isTwentyFourSevenAsset, chartTimes, remainingDeltaProfiles, activeDeltaPolylineLayers)
        if not na(selectedNyEarlyProfiles)
            remainingDeltaProfiles := renderProfileSelection(selectedNyEarlyProfiles, SOURCE_NY_EARLY, isTwentyFourSevenAsset, chartTimes, remainingDeltaProfiles, activeDeltaPolylineLayers)
        if not na(selectedIvbProfiles)
            remainingDeltaProfiles := renderProfileSelection(selectedIvbProfiles, SOURCE_IVB, isTwentyFourSevenAsset, chartTimes, remainingDeltaProfiles, activeDeltaPolylineLayers)
        if not na(selectedRthProfiles)
            remainingDeltaProfiles := renderProfileSelection(selectedRthProfiles, SOURCE_RTH, isTwentyFourSevenAsset, chartTimes, remainingDeltaProfiles, activeDeltaPolylineLayers)
    else if anchorMode == MODE_NY_EARLY and not na(selectedSessionProfiles)
        remainingDeltaProfiles := renderProfileSelection(selectedSessionProfiles, SOURCE_NY_EARLY, isTwentyFourSevenAsset, chartTimes, remainingDeltaProfiles, activeDeltaPolylineLayers)
    else if anchorMode == MODE_EXTENDED_NY_EARLY and not na(selectedSessionProfiles)
        remainingDeltaProfiles := renderProfileSelection(selectedSessionProfiles, SOURCE_EXTENDED_NY_EARLY, isTwentyFourSevenAsset, chartTimes, remainingDeltaProfiles, activeDeltaPolylineLayers)
    else if anchorMode == MODE_IVB and not na(selectedSessionProfiles)
        remainingDeltaProfiles := renderProfileSelection(selectedSessionProfiles, SOURCE_IVB, isTwentyFourSevenAsset, chartTimes, remainingDeltaProfiles, activeDeltaPolylineLayers)
    else if anchorMode == MODE_RTH and not na(selectedSessionProfiles)
        remainingDeltaProfiles := renderProfileSelection(selectedSessionProfiles, SOURCE_RTH, isTwentyFourSevenAsset, chartTimes, remainingDeltaProfiles, activeDeltaPolylineLayers)
    else if not na(selectedSessionProfiles)
        remainingDeltaProfiles := renderProfileSelection(selectedSessionProfiles, activeAnchorName(), isTwentyFourSevenAsset, chartTimes, remainingDeltaProfiles, activeDeltaPolylineLayers)
    flushPendingRightLines(mergeOverlaps)
    flushPendingRightLabels()

    if fixedRangeEnabled and not na(fixedProfile) and fixedProfile.isValid
        renderSelectedProfile(fixedProfile, SOURCE_FIXED, false, true, isTwentyFourSevenAsset, chartTimes, 1, activeDeltaPolylineLayers)
        flushPendingRightLines(mergeOverlaps)
        flushPendingRightLabels()

    if showColorTable
        array<ColorRow> colorRows = array.new<ColorRow>()
        bool profileColorsActive = fixedSelected ? fixedRangeConfigured : rollingSelected or nyEarlyModeActive or extendedNyEarlyModeActive or ivbModeActive or rthModeActive or globexSelected or weeklySelected or monthlySelected
        bool extendedAlternatePaletteActive = profileColorsActive and extendedNyEarlyModeActive and useExtendedNyEarlyAlternateStyles
        bool standardPaletteActive = profileColorsActive and (not extendedAlternatePaletteActive or nyEarlyModeActive or ivbModeActive or rthModeActive or globexSelected or weeklySelected or monthlySelected or rollingSelected or fixedSelected)
        if profileColorsActive and extendedNyEarlyModeActive
            addProfileColorRows(colorRows, SOURCE_EXTENDED_NY_EARLY, showOuterSessionFrame)
        if profileColorsActive and nyEarlyModeActive
            addProfileColorRows(colorRows, SOURCE_NY_EARLY, showOuterSessionFrame)
        if profileColorsActive and ivbModeActive
            addProfileColorRows(colorRows, SOURCE_IVB, showOuterSessionFrame)
        if profileColorsActive and rthModeActive
            addProfileColorRows(colorRows, SOURCE_RTH, showOuterSessionFrame)
        if profileColorsActive and globexSelected
            addProfileColorRows(colorRows, SOURCE_GLOBEX, showOuterSessionFrame)
        if profileColorsActive and weeklySelected
            addProfileColorRows(colorRows, SOURCE_WEEKLY, showOuterSessionFrame)
        if profileColorsActive and monthlySelected
            addProfileColorRows(colorRows, SOURCE_MONTHLY, showOuterSessionFrame)
        if profileColorsActive and rollingSelected
            addProfileColorRows(colorRows, SOURCE_ROLLING, showOuterSessionFrame)
        if profileColorsActive and fixedSelected
            addProfileColorRows(colorRows, SOURCE_FIXED, showOuterSessionFrame)
        if extendedAlternatePaletteActive
            addExtendedAlternateStyleRows(colorRows)
        if profileColorsActive and extendedNyEarlyModeActive and not useExtendedNyEarlyAlternateStyles
            addSharedDeltaColorRows(colorRows, SOURCE_EXTENDED_NY_EARLY)
        if profileColorsActive and nyEarlyModeActive
            addSharedDeltaColorRows(colorRows, SOURCE_NY_EARLY)
        if profileColorsActive and ivbModeActive
            addSharedDeltaColorRows(colorRows, SOURCE_IVB)
        if profileColorsActive and rthModeActive
            addSharedDeltaColorRows(colorRows, SOURCE_RTH)
        if profileColorsActive and globexSelected
            addSharedDeltaColorRows(colorRows, SOURCE_GLOBEX)
        if profileColorsActive and weeklySelected
            addSharedDeltaColorRows(colorRows, SOURCE_WEEKLY)
        if profileColorsActive and monthlySelected
            addSharedDeltaColorRows(colorRows, SOURCE_MONTHLY)
        if profileColorsActive and rollingSelected
            addSharedDeltaColorRows(colorRows, SOURCE_ROLLING)
        if profileColorsActive and fixedSelected
            addSharedDeltaColorRows(colorRows, SOURCE_FIXED)
        if showOnlyEnabled
            addColorRow(colorRows, "Hidden", hiddenCandleColor, "")
        if profileColorsActive and showHistogram
            if useHistogramValueAreaColors
                addColorRow(colorRows, "Histogram Value Area In", histogramValueAreaInsideColor, str.tostring(histogramWidthPercent) + "%")
                addColorRow(colorRows, "Histogram Value Area Out", histogramValueAreaOutsideColor, str.tostring(histogramWidthPercent) + "%")
            else
                addColorRow(colorRows, "Histogram", histogramColor, str.tostring(histogramWidthPercent) + "%")
        if standardPaletteActive and showValueAreaLevels
            addColorRow(colorRows, "VAH/L Lines", valueAreaLevelColor, str.tostring(VALUE_AREA_LEVEL_WIDTH))
        if standardPaletteActive and showPocLevel
            addColorRow(colorRows, "POC Line", pocLevelColor, str.tostring(POC_LEVEL_WIDTH))
            addColorRow(colorRows, INPUT_LABEL_POC_LABEL, pocLabelColor, "")
        if standardPaletteActive and showMinimumLvnTiers
            addColorRow(colorRows, "Low Volume Cliff Line", lowVolumeCliffLineColor, str.tostring(LOW_VOLUME_LINE_WIDTH))
            addColorRow(colorRows, "Low Volume Text", lowVolumeTextColor, "")
            addColorRow(colorRows, "Low Volume Zone", lowVolumeZoneColor, "Fill")
        bool deltaTier5Active = standardPaletteActive and showDeltaTiers and visibleDeltaTierCount >= 1
        bool deltaTier4Active = standardPaletteActive and showDeltaTiers and visibleDeltaTierCount >= 2
        bool deltaTier3Active = standardPaletteActive and showDeltaTiers and visibleDeltaTierCount >= 3
        bool deltaTier2Active = standardPaletteActive and showDeltaTiers and visibleDeltaTierCount >= 4
        bool deltaTier1Active = standardPaletteActive and showDeltaTiers and visibleDeltaTierCount >= 5
        addTierSideAppearanceRows(colorRows, "", 5, "Buy", deltaTier5Active and deltaTierSideVisible(true), deltaTier5BuyLineColor, DELTA_TIER_5_LINE_WIDTH, deltaTier5Active and deltaTierSideVisible(true) and showDots, deltaTier5BuyTextColor, deltaTier5Active and deltaTierSideVisible(true), deltaTier5BuyZoneColor)
        addTierSideAppearanceRows(colorRows, "", 5, "Sell", deltaTier5Active and deltaTierSideVisible(false), deltaTier5SellLineColor, DELTA_TIER_5_LINE_WIDTH, deltaTier5Active and deltaTierSideVisible(false) and showDots, deltaTier5SellTextColor, deltaTier5Active and deltaTierSideVisible(false), deltaTier5SellZoneColor)
        addTierSideAppearanceRows(colorRows, "", 4, "Buy", deltaTier4Active and deltaTierSideVisible(true), deltaTier4BuyLineColor, DELTA_TIER_4_LINE_WIDTH, deltaTier4Active and deltaTierSideVisible(true) and showDots, deltaTier4BuyTextColor, deltaTier4Active and deltaTierSideVisible(true), deltaTier4BuyZoneColor)
        addTierSideAppearanceRows(colorRows, "", 4, "Sell", deltaTier4Active and deltaTierSideVisible(false), deltaTier4SellLineColor, DELTA_TIER_4_LINE_WIDTH, deltaTier4Active and deltaTierSideVisible(false) and showDots, deltaTier4SellTextColor, deltaTier4Active and deltaTierSideVisible(false), deltaTier4SellZoneColor)
        addTierSideAppearanceRows(colorRows, "", 3, "Buy", false, na, 0, deltaTier3Active and deltaTierSideVisible(true) and showDots, deltaTier3BuyTextColor, deltaTier3Active and deltaTierSideVisible(true), deltaTier3BuyZoneColor)
        addTierSideAppearanceRows(colorRows, "", 3, "Sell", false, na, 0, deltaTier3Active and deltaTierSideVisible(false) and showDots, deltaTier3SellTextColor, deltaTier3Active and deltaTierSideVisible(false), deltaTier3SellZoneColor)
        addTierSideAppearanceRows(colorRows, "", 2, "Buy", false, na, 0, deltaTier2Active and deltaTierSideVisible(true) and showDots, deltaTier2BuyTextColor, deltaTier2Active and deltaTierSideVisible(true), deltaTier2BuyZoneColor)
        addTierSideAppearanceRows(colorRows, "", 2, "Sell", false, na, 0, deltaTier2Active and deltaTierSideVisible(false) and showDots, deltaTier2SellTextColor, deltaTier2Active and deltaTierSideVisible(false), deltaTier2SellZoneColor)
        addTierSideAppearanceRows(colorRows, "", 1, "Buy", false, na, 0, deltaTier1Active and deltaTierSideVisible(true) and showDots, deltaTier1BuyTextColor, deltaTier1Active and deltaTierSideVisible(true), deltaTier1BuyZoneColor)
        addTierSideAppearanceRows(colorRows, "", 1, "Sell", false, na, 0, deltaTier1Active and deltaTierSideVisible(false) and showDots, deltaTier1SellTextColor, deltaTier1Active and deltaTierSideVisible(false), deltaTier1SellZoneColor)
        if standardPaletteActive
            addColorRow(colorRows, "Text Background", textBackgroundColor, "")
        if secondaryPaneMode and showPriceCandlesInPane
            addColorRow(colorRows, "Up Body", paneUpBodyColor, "")
            addColorRow(colorRows, "Down Body", paneDownBodyColor, "")
            addColorRow(colorRows, "Up Border", paneUpBorderColor, "")
            addColorRow(colorRows, "Down Border", paneDownBorderColor, "")
            addColorRow(colorRows, "Up Wick", paneUpWickColor, "")
            addColorRow(colorRows, "Down Wick", paneDownWickColor, "")
        if not na(colorTable)
            table.delete(colorTable)
        colorTable := table.new(position.top_right, 4, array.size(colorRows) + 1, bgcolor=color.rgb(255, 255, 255), border_width=1, border_color=color.rgb(128, 128, 128), frame_width=1, frame_color=color.rgb(128, 128, 128))
        table.cell(colorTable, 0, 0, LABEL_TABLE_SETTING, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        table.cell(colorTable, 1, 0, LABEL_TABLE_RGB, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        table.cell(colorTable, 2, 0, LABEL_TABLE_TRANSPARENCY, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        table.cell(colorTable, 3, 0, LABEL_TABLE_WIDTH, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        if array.size(colorRows) > 0
            for rowIndex = 0 to array.size(colorRows) - 1
                writeColorRow(colorTable, rowIndex + 1, array.get(colorRows, rowIndex))
    else if not na(colorTable)
        table.delete(colorTable)
        colorTable := na

// legilimens •
