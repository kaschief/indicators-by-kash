// ═══════════════════════════════════════════════════════════════════════════════
strongestOutlierLineWidth = input.int(3, "Width", options=[1, 2, 3, 4, 5], inline="strongest_outlier", group=GROUP_STRONGEST_OUTLIER, active=quickOutlierZones)
strongestOutlierLineStyle = input.string(STYLE_DASHED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="strongest_outlier", group=GROUP_STRONGEST_OUTLIER, active=quickOutlierZones, tooltip="Width and style control the first-ranked buying and selling zone. Colors and fill remain shared with Outlier Levels.")

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — PRICE LABELS
// ═══════════════════════════════════════════════════════════════════════════════
levelLabelOffset = input.int(150, "Offset", minval=0, maxval=500, inline="label_layout", group=GROUP_LABELS, tooltip="Shift every right-edge outlier, low-volume, VAH, VAL and POC tag this many bars beyond the latest chart bar.")
levelLabelBgColor = input.color(color.new(color.rgb(249, 248, 248), 25), "Background", inline="label_layout", group=GROUP_LABELS)
mergeOverlaps = input.bool(true, "Merge Overlaps", inline="label_merge", group=GROUP_LABELS)
mergeDistancePreset = input.string(LABEL_MERGE_WIDE, "", options=[LABEL_MERGE_STRICT, LABEL_MERGE_BALANCED, LABEL_MERGE_WIDE, LABEL_MERGE_EXTRA_WIDE, LABEL_MERGE_CUSTOM], inline="label_merge", group=GROUP_LABELS, active=mergeOverlaps)
customMergeDistancePercent = input.float(LABEL_MERGE_BALANCED_PERCENT, "%", minval=0.0, maxval=0.5, step=0.001, inline="label_merge", group=GROUP_LABELS, active=mergeOverlaps and mergeDistancePreset == LABEL_MERGE_CUSTOM, tooltip="One clutter control for all right-edge levels. It combines nearby same-side outlier values, then merges overlapping outlier, Cliff, value-area and POC lines and labels. LVN band boundaries remain exact.\n\n• Strict — 0.005%\n• Balanced — 0.010%\n• Wide — 0.025%; the default\n• Extra Wide — 0.050%\n• Custom — use the % field\n\nDistance is a percentage of price with a minimum of one tick. Turn Merge Overlaps off to keep every level separate.")
mergeDistancePercent = mergeDistancePreset == LABEL_MERGE_STRICT ? LABEL_MERGE_STRICT_PERCENT : mergeDistancePreset == LABEL_MERGE_WIDE ? LABEL_MERGE_WIDE_PERCENT : mergeDistancePreset == LABEL_MERGE_EXTRA_WIDE ? LABEL_MERGE_EXTRA_WIDE_PERCENT : mergeDistancePreset == LABEL_MERGE_CUSTOM ? customMergeDistancePercent : LABEL_MERGE_BALANCED_PERCENT
levelTagsMode = input.string(LEVEL_TAGS_DETAILS, "Level Tags", options=[LEVEL_TAGS_OFF, LEVEL_TAGS_LEVEL, LEVEL_TAGS_DETAILS, LEVEL_TAGS_DETAILS_PRICE], group=GROUP_LABELS, tooltip="Text on every right-edge outlier, LVN, Cliff, VAH, VAL and POC tag. Their lines, zone fills and colored rows stay.\n\n• Level — name only, e.g. 'Sell Zone 1' or 'Fixed LVN 2'\n• With Details — adds level metrics\n• Details + Price — adds metrics and the level price\n• Off — hides the tags")
showLevelTags = levelTagsMode != LEVEL_TAGS_OFF
levelTagsDetailed = levelTagsMode == LEVEL_TAGS_DETAILS or levelTagsMode == LEVEL_TAGS_DETAILS_PRICE
levelTagsShowPrice = levelTagsMode == LEVEL_TAGS_DETAILS_PRICE

levelsLabelSize = input.string(LABEL_SIZE_SMALL, "Levels Size", options=[LABEL_SIZE_TINY, LABEL_SIZE_SMALL, LABEL_SIZE_NORMAL, LABEL_SIZE_LARGE, LABEL_SIZE_HUGE], inline="label_levels", group=GROUP_LABELS, tooltip="Sizes outlier, LVN and Cliff tags. VAH/L and POC use their own size controls.")

