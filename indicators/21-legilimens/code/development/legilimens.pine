// INPUTS — ROLLING AND FIXED
// ═══════════════════════════════════════════════════════════════════════════════
rollingExtensionMode = input.string(EXTENSION_TO_OFFSET, "Extension", options=[EXTENSION_TO_OFFSET, EXTENSION_TIMED], inline="rolling_extension", group=GROUP_ROLLING, active=rollingSelected)
