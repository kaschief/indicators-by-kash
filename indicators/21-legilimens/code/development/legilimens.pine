//@version=6

// DELTA MODEL — IMPORTANT: Pine exposes no true historical bid/ask aggressor data.
// This indicator therefore approximates delta exactly from lower-timeframe candles:
// up candle = buy volume, down candle = sell volume; a doji compares its close with
// the prior intrabar close, then carries the last known tape polarity if still tied.
// Every sample's volume and signed delta are distributed across the same price rows.

// ═══════════════════════════════════════════════════════════════════════════════
// INDICATOR SETUP
// ═══════════════════════════════════════════════════════════════════════════════
INDICATOR_MAX_LINES = 500
INDICATOR_MAX_LABELS = 500
INDICATOR_MAX_BOXES = 500
INDICATOR_MAX_POLYLINES = 100
INDICATOR_TITLE = "legilimens • development"

indicator(INDICATOR_TITLE, overlay=true, max_lines_count=INDICATOR_MAX_LINES, max_labels_count=INDICATOR_MAX_LABELS, max_boxes_count=INDICATOR_MAX_BOXES, max_polylines_count=INDICATOR_MAX_POLYLINES, max_bars_back=5000)

// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════
NY_TIMEZONE = "America/New_York"
UTC_TIMEZONE = "GMT+0"

MS_PER_HOUR = 60 * 60 * 1000
GLOBEX_REOPEN_SHIFT_MS = 6 * MS_PER_HOUR
SUNDAY_REOPEN_START_HOUR = 18
SECONDS_PER_WEEK = 604800
ASSET_DETECTION_MAX_LOOKBACK = 4999
PROFILE_TIME_SCALE_MAX_LOOKBACK = 4999

RTH_SESSION = "0930-1600:23456"             // Regular cash session, Mon-Fri (session-based assets)
RTH_SESSION_ALL_DAYS = "0930-1600:1234567"  // Same 09:30-16:00 NY window every day (24/7 assets)

START_TIME_UNSET = -1

MODE_FIXED = "🎯 Fixed Range"
MODE_RTH = "🗽 RTH Sessions"
MODE_GLOBEX = "🌅 Globex Days"

DELTA_ROWS_ALL = "All Delta"
DELTA_ROWS_BUY = "Buying"
DELTA_ROWS_SELL = "Selling"
DELTA_ROWS_OUTLIERS = "All Outliers"
DELTA_ROWS_BUY_OUTLIERS = "Buying Outliers"
DELTA_ROWS_SELL_OUTLIERS = "Selling Outliers"

OUTLIER_FLAGS_BOTH = "Both Sides"
OUTLIER_FLAGS_BUY = "Buying"
OUTLIER_FLAGS_SELL = "Selling"
OUTLIER_FLAGS_OFF = "Off"

STYLE_SOLID = "Solid"
STYLE_DASHED = "Dashed"
STYLE_DOTTED = "Dotted"

PROFILE_EDGE_LEFT = "Left Edge"
PROFILE_EDGE_RIGHT = "Right Edge"
PROFILE_FACE_LEFT = "Left"
PROFILE_FACE_RIGHT = "Right"

// Four parallel arrays compact early enough to stay below Pine's collection limit.
SAMPLE_COMPACT_THRESHOLD = 10000
SAMPLE_COMPACT_ROWS = 3000

// Reserve minimum granularity for older profiles before newer ones consume the box budget.
DELTA_BAR_BOX_BUDGET = INDICATOR_MAX_BOXES
FAIR_SHARE_MIN_ROWS = 25
MIN_DRAWABLE_ROWS = 5

FLAG_LINE_TRANSPARENCY = 30
ZONE_FILL_TRANSPARENCY = 92
OUTLIER_MERGE_DEFAULT_PERCENT = 0.005
OUTLIER_PEAK_GAP_ROWS = 1

BRAND_BULLET = "•"
LABEL_NAME_SEPARATOR = " | "

LABEL_SIZE_TINY = "Tiny"
LABEL_SIZE_SMALL = "Small"
LABEL_SIZE_NORMAL = "Normal"
LABEL_SIZE_LARGE = "Large"
LABEL_SIZE_HUGE = "Huge"

DELTA_PREFIX = "Δ "
LABEL_FIXED_START = "Fixed Start"
LABEL_FIXED_END = "Fixed End"
LABEL_RANGE_HIGH = "Range High"
LABEL_RANGE_LOW = "Range Low"

GROUP_DISPLAY = "⚙️ Profile"
GROUP_FIXED = "🎯 Fixed Range"
GROUP_BARS = "📊 Delta Profile"
GROUP_APPEARANCE = "🖼️ Profile Appearance"
GROUP_VALUE_LEVELS = "🧭 Profile Levels"
GROUP_OUTLIERS = "🚩 Outlier Levels"
GROUP_LABELS = "🏷️ Price Labels"
GROUP_UTILITY = "🎨 Reference"

LABEL_TABLE_SETTING = "Setting"
LABEL_TABLE_RGB = "RGB"
LABEL_TABLE_TRANSPARENCY = "Trans"
LABEL_TABLE_WIDTH = "Width"

TOOLTIP_PROFILE_MODE = "One profile source at a time, so the entire drawing budget serves it and the bars stay as granular as possible:\n• 🎯 Fixed Range — one profile between your two placed points\n• 🗽 RTH Sessions — one profile per 09:30–16:00 New York cash session\n• 🌅 Globex Days — one profile per Globex trading day (18:00 NY open; 00:00 UTC for continuous assets)\n\nVisible Profiles is the total number shown. When Developing is on, the current live profile occupies one of those slots."

TOOLTIP_DELTA_SOURCE = "Lower timeframe pulled from inside each chart bar to build the delta profile. Smaller = more precise. 'Auto' picks a sensible sub-timeframe from the chart timeframe (1S on intraday charts up to 1 minute).\n\nPine has NO true bid/ask order-flow data, so delta is APPROXIMATED from sub-bar direction: up sub-bar = buy volume, down sub-bar = sell volume; an unchanged sub-bar compares its close with the previous sub-bar close and, if still tied, carries the persistent tape polarity. This mirrors TradingView Volume Delta's classification but is not exchange order flow.\n\nSub-bar history is limited, so the oldest portion of a very long range falls back to whole chart bars and reads coarser: prefer recent ranges and fine chart timeframes for the most accurate delta."

TOOLTIP_FIXED_RANGE = "Used when Profile Mode is 🎯 Fixed Range: one delta profile between two chart points, ATAS / DeepCharts fixed-volume-profile style. TradingView asks for the two clicks ONCE, when the indicator is first added; the clicks may land in either order.\n\nTo move the range later: click any of this indicator's drawings to select it, then drag the two anchor points on the chart — or edit the Range Start / Range End dates right here in Settings. Removing and re-adding the indicator re-asks for the clicks.\n\nA four-sided outline marks Start, End, Range High and Range Low so both the time selection and its calculated price zone remain visible."

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — PROFILE
// ═══════════════════════════════════════════════════════════════════════════════
anchorMode = input.string(MODE_FIXED, "Mode", options=[MODE_FIXED, MODE_RTH, MODE_GLOBEX], tooltip=TOOLTIP_PROFILE_MODE, group=GROUP_DISPLAY)
profilesToShow = input.int(1, "Visible Profiles", options=[1, 2, 3, 4, 5], inline="profile_history", group=GROUP_DISPLAY)
showDevelopingProfile = input.bool(true, "Developing", inline="profile_history", tooltip="For RTH and Globex, the current live profile occupies one visible slot. Fixed Range is unaffected.", group=GROUP_DISPLAY)
intrabarResolution = input.string("Auto", "Intrabars", options=["Auto", "1S", "5S", "15S", "1", "3", "5", "15"], tooltip=TOOLTIP_DELTA_SOURCE, group=GROUP_DISPLAY)
profileRows = input.int(400, "Granularity", minval=50, maxval=500, tooltip="Maximum price rows per profile. When a profile's range fits, rows snap to exact tradable ticks. Wider ranges divide into this many rows.\n\nWith one visible profile, delta may use all 500 boxes. Additional profiles share that drawing budget.", group=GROUP_DISPLAY)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — FIXED RANGE
// ═══════════════════════════════════════════════════════════════════════════════
fixedAnchorColor = input.color(color.new(color.rgb(120, 123, 134), 30), "Outline", inline="fixed_outline", group=GROUP_FIXED)
fixedOutlineWidth = input.int(1, "", options=[1, 2, 3, 4, 5], inline="fixed_outline", group=GROUP_FIXED)
fixedOutlineStyle = input.string(STYLE_DOTTED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="fixed_outline", group=GROUP_FIXED, tooltip=TOOLTIP_FIXED_RANGE)
fixedRangeStartInput = input.time(timestamp("2026-07-01T09:30:00-04:00"), "Range Start", confirm=true, group=GROUP_FIXED)
fixedRangeEndInput = input.time(timestamp("2026-07-02T16:00:00-04:00"), "Range End", confirm=true, group=GROUP_FIXED)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — DELTA PROFILE
// ═══════════════════════════════════════════════════════════════════════════════
deltaRowsMode = input.string(DELTA_ROWS_ALL, "Show", options=[DELTA_ROWS_ALL, DELTA_ROWS_BUY, DELTA_ROWS_SELL, DELTA_ROWS_OUTLIERS, DELTA_ROWS_BUY_OUTLIERS, DELTA_ROWS_SELL_OUTLIERS], inline="bar_display", group=GROUP_BARS, tooltip="Choose what the delta profile shows. Buying and Selling filter by direction. Outlier options show only rows identified by the Outlier setting.")
barWidthPercent = input.int(30, "Width", minval=5, maxval=100, inline="bar_display", group=GROUP_BARS, tooltip="Maximum delta-bar width as a percentage of the profile's time span. Each row's actual length follows its net-delta magnitude.")
deltaSmoothRows = input.int(0, "Smoothing", minval=0, maxval=10, inline="bar_detail", group=GROUP_BARS)
deltaTicksPerRow = input.int(1, "Row Size", minval=1, maxval=20, inline="bar_detail", group=GROUP_BARS, tooltip="Smoothing blends neighboring delta rows after the profile is built. Zero keeps the original values.\n\nRow Size groups this many tradable ticks into each price row. For example, four ticks on NQ produce one-point rows. It works independently of Smoothing.")
profileEdge = input.string(PROFILE_EDGE_LEFT, "Attach", options=[PROFILE_EDGE_LEFT, PROFILE_EDGE_RIGHT], inline="bar_orientation", group=GROUP_BARS)
profileFacing = input.string(PROFILE_FACE_RIGHT, "Direction", options=[PROFILE_FACE_LEFT, PROFILE_FACE_RIGHT], inline="bar_orientation", group=GROUP_BARS, tooltip="Attach chooses the profile edge used as the baseline. Direction chooses where the colored delta bars grow. The volume layer remains attached to the left edge and grows right.")
barBuyColor = input.color(color.new(color.rgb(38, 166, 154), 15), "+", inline="bar_colors", group=GROUP_BARS)
barSellColor = input.color(color.new(color.rgb(239, 83, 80), 15), "−", inline="bar_colors", group=GROUP_BARS, tooltip="+ colors rows where buying dominated, − where selling dominated. Rows that qualify as outliers use the Outliers group's colors instead so they pop.")

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — PROFILE APPEARANCE
