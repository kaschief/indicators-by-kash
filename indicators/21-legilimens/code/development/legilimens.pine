outlierTier5SellZoneColor = input.color(color.new(color.rgb(249, 121, 246), 91), "", inline="delta_tier_5_colors", group=GROUP_DELTA_TIERS, active=quickOutlierZones and deltaTierCount >= 1, tooltip="Each color pair is ordered Buy then Sell. Tier 5 is the strongest tier. Delta marker size is set in Delta: Tiers.")

