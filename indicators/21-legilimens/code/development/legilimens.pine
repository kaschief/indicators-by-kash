// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — DELTA: NORMAL
// ═══════════════════════════════════════════════════════════════════════════════
deltaRowsMode = input.string(DELTA_ROWS_ALL, "Rows", options=[DELTA_ROWS_ALL, DELTA_ROWS_BUY, DELTA_ROWS_SELL, DELTA_ROWS_DOMINANT, DELTA_ROWS_BUY_DOMINANT, DELTA_ROWS_SELL_DOMINANT], inline="bar_display", group=GROUP_DELTA_NORMAL, tooltip="Chooses which rows draw inside the profile. Buying and Selling filter by direction. Dominant options show only rows that clear the Dominant Threshold.")
barWidthPercent = input.int(45, "Width", minval=5, maxval=100, inline="bar_display", group=GROUP_DELTA_NORMAL)
profileEdge = input.string(PROFILE_EDGE_RIGHT, "Attach To", options=[PROFILE_EDGE_LEFT, PROFILE_EDGE_RIGHT], inline="bar_orientation", group=GROUP_DELTA_NORMAL)
profileFacing = input.string(PROFILE_FACE_LEFT, "Direction", options=[PROFILE_FACE_LEFT, PROFILE_FACE_RIGHT], inline="bar_orientation", group=GROUP_DELTA_NORMAL, tooltip="Attach chooses the profile baseline. Direction chooses where delta rows grow.")
barBuyColor = input.color(color.new(color.rgb(200, 230, 201), 20), "Buy", inline="normal_delta_colors", group=GROUP_DELTA_NORMAL)
barSellColor = input.color(color.new(color.rgb(247, 124, 128), 20), "Sell", inline="normal_delta_colors", group=GROUP_DELTA_NORMAL)
outlierFlagsMode = input.string(OUTLIER_FLAGS_BOTH, "Extend Zones", options=[OUTLIER_FLAGS_BOTH, OUTLIER_FLAGS_BUY, OUTLIER_FLAGS_SELL], inline="normal_delta_colors", group=GROUP_DELTA_NORMAL, active=quickOutlierZones, tooltip="Buy and Sell set ordinary delta-row colors. Extend Zones selects which dominant-zone directions may extend.")

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — DELTA: DOMINANT
// ═══════════════════════════════════════════════════════════════════════════════
outlierMultiplier = input.float(1.5, "Dominant Threshold", minval=0.5, maxval=20.0, step=0.5, group=GROUP_DELTA_DOMINANT, tooltip="Higher values identify fewer dominant delta rows. Apex Dominant is the single strongest Tier 5 value; Dominant Delta covers the remaining qualifying values.")
barOutlierBuyColor = input.color(color.new(color.rgb(102, 187, 106), 38), "Buy", inline="dominant_delta_colors", group=GROUP_DELTA_DOMINANT)
barOutlierSellColor = input.color(color.new(color.rgb(236, 64, 122), 50), "Sell", inline="dominant_delta_colors", group=GROUP_DELTA_DOMINANT, tooltip="Dominant Delta colors, ordered Buy then Sell. Apex Dominant retains the same profile-row rendering to avoid additional polylines; its Tier 5 line, text and zone use the Tier 5 colors below.")

