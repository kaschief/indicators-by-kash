weeklyRangeLabelColor = input.color(color.new(color.rgb(100, 7, 0), 30), "Title", inline="weekly_title", group=GROUP_WEEKLY, active=weeklySelected)
weeklyRangeLabelSize = input.string(LABEL_SIZE_SMALL, "", options=[LABEL_SIZE_TINY, LABEL_SIZE_SMALL, LABEL_SIZE_NORMAL, LABEL_SIZE_LARGE, LABEL_SIZE_HUGE], inline="weekly_title", group=GROUP_WEEKLY, active=weeklySelected)
weeklyRangeShowPrice = input.bool(false, "Price", inline="weekly_title", group=GROUP_WEEKLY, active=weeklySelected, tooltip=TOOLTIP_RANGE_TITLE)
weeklyOuterFrameColor = input.color(color.new(color.rgb(187, 217, 251), 60), "Outer Frame", group=GROUP_WEEKLY, active=weeklySelected and (showOuterSessionFrame), tooltip=TOOLTIP_OUTER_FRAME)

monthlyExtensionMode = input.string(EXTENSION_TO_OFFSET, "Extension", options=[EXTENSION_TO_OFFSET, EXTENSION_TIMED], inline="monthly_extension", group=GROUP_MONTHLY, active=monthlySelected)
monthlyExtensionHours = input.float(6.0, "Hours", minval=0.0, step=0.5, inline="monthly_extension", group=GROUP_MONTHLY, active=monthlySelected and (monthlyExtensionMode == EXTENSION_TIMED), tooltip=TOOLTIP_EXTENSION_BASE + "monthly close.")
monthlyOutlineColor = input.color(color.new(color.rgb(242, 54, 69), 20), "Outline", inline="monthly_outline", group=GROUP_MONTHLY, active=monthlySelected)
monthlyOutlineWidth = input.int(1, "Width", options=[1, 2, 3, 4, 5], inline="monthly_outline", group=GROUP_MONTHLY, active=monthlySelected)
monthlyRangeLabelColor = input.color(color.new(color.rgb(100, 7, 0), 30), "Title", inline="monthly_title", group=GROUP_MONTHLY, active=monthlySelected)
monthlyRangeLabelSize = input.string(LABEL_SIZE_SMALL, "", options=[LABEL_SIZE_TINY, LABEL_SIZE_SMALL, LABEL_SIZE_NORMAL, LABEL_SIZE_LARGE, LABEL_SIZE_HUGE], inline="monthly_title", group=GROUP_MONTHLY, active=monthlySelected)
monthlyRangeShowPrice = input.bool(false, "Price", inline="monthly_title", group=GROUP_MONTHLY, active=monthlySelected, tooltip=TOOLTIP_RANGE_TITLE)
monthlyOuterFrameColor = input.color(color.new(color.rgb(187, 217, 251), 60), "Outer Frame", group=GROUP_MONTHLY, active=monthlySelected and (showOuterSessionFrame), tooltip=TOOLTIP_OUTER_FRAME)

