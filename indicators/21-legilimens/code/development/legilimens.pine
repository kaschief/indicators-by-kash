backdropColor = input.color(color.new(color.rgb(120, 123, 134), 85), "", inline="appearance_volume", group=GROUP_APPEARANCE, tooltip="Shows total volume behind the delta profile. This layer stays attached to the left edge and grows right.")
backdropValueAreaColors = input.bool(false, "Value Area", inline="appearance_value_area", group=GROUP_APPEARANCE)
backdropInsideColor = input.color(color.new(color.rgb(91, 156, 246), 75), "Inside", inline="appearance_value_area", group=GROUP_APPEARANCE)
backdropOutsideColor = input.color(color.new(color.rgb(184, 184, 184), 80), "Outside", inline="appearance_value_area", group=GROUP_APPEARANCE, tooltip="Uses separate volume colors inside and outside the value area.")
