outlierTier4BuyLineColor = input.color(color.new(color.rgb(56, 142, 60), 30), "Line", inline="delta_tier_4_colors", group=GROUP_DELTA_TIERS, active=quickOutlierZones and deltaTierCount >= 2)
outlierTier4SellLineColor = input.color(color.new(color.rgb(178, 40, 51), 30), "", inline="delta_tier_4_colors", group=GROUP_DELTA_TIERS, active=quickOutlierZones and deltaTierCount >= 2)
outlierTier4BuyTextColor = input.color(color.new(color.rgb(77, 243, 8), 20), "Text", inline="delta_tier_4_colors", group=GROUP_DELTA_TIERS, active=quickOutlierZones and deltaTierCount >= 2)
outlierTier4SellTextColor = input.color(color.new(color.rgb(249, 121, 246), 50), "", inline="delta_tier_4_colors", group=GROUP_DELTA_TIERS, active=quickOutlierZones and deltaTierCount >= 2)
outlierTier4BuyZoneColor = input.color(color.new(color.rgb(114, 243, 114), 95), "Zone", inline="delta_tier_4_colors", group=GROUP_DELTA_TIERS, active=quickOutlierZones and deltaTierCount >= 2)
outlierTier4SellZoneColor = input.color(color.new(color.rgb(249, 121, 246), 93), "", inline="delta_tier_4_colors", group=GROUP_DELTA_TIERS, active=quickOutlierZones and deltaTierCount >= 2, tooltip="Each color pair is ordered Buy then Sell. Tier 4 is the second-strongest tier. Delta marker size is set in Delta: Tiers.")

tier3Enabled = input.bool(true, "Tier 3", inline="delta_tier_3", group=GROUP_DELTA_TIERS, active=quickOutlierZones and deltaTierCount >= 3)
deltaTier3MarkerSize = input.int(7, "Dot Size", minval=0, maxval=100, step=1, group=GROUP_DELTA_TIERS, active=quickOutlierZones and deltaTierCount >= 3)
outlierTier3BuyTextColor = input.color(color.new(color.rgb(163, 218, 165), 10), "Text", inline="delta_tier_3_colors", group=GROUP_DELTA_TIERS, active=quickOutlierZones and deltaTierCount >= 3)
outlierTier3SellTextColor = input.color(color.new(color.rgb(249, 121, 246), 30), "", inline="delta_tier_3_colors", group=GROUP_DELTA_TIERS, active=quickOutlierZones and deltaTierCount >= 3)
outlierTier3BuyZoneColor = input.color(color.new(color.rgb(114, 243, 114), 92), "Zone", inline="delta_tier_3_colors", group=GROUP_DELTA_TIERS, active=quickOutlierZones and deltaTierCount >= 3)
outlierTier3SellZoneColor = input.color(color.new(color.rgb(249, 121, 246), 94), "", inline="delta_tier_3_colors", group=GROUP_DELTA_TIERS, active=quickOutlierZones and deltaTierCount >= 3, tooltip="Each color pair is ordered Buy then Sell. Tier 3 is zone-only. Delta marker size is set in Delta: Tiers.")

tier2Enabled = input.bool(true, "Tier 2", inline="delta_tier_2", group=GROUP_DELTA_TIERS, active=quickOutlierZones and deltaTierCount >= 4)
deltaTier2MarkerSize = input.int(6, "Dot Size", minval=0, maxval=100, step=1, group=GROUP_DELTA_TIERS, active=quickOutlierZones and deltaTierCount >= 4)
outlierTier2BuyTextColor = input.color(color.new(color.rgb(114, 243, 114), 30), "Text", inline="delta_tier_2_colors", group=GROUP_DELTA_TIERS, active=quickOutlierZones and deltaTierCount >= 4)
outlierTier2SellTextColor = input.color(color.new(color.rgb(249, 121, 246), 30), "", inline="delta_tier_2_colors", group=GROUP_DELTA_TIERS, active=quickOutlierZones and deltaTierCount >= 4)
outlierTier2BuyZoneColor = input.color(color.new(color.rgb(114, 243, 114), 92), "Zone", inline="delta_tier_2_colors", group=GROUP_DELTA_TIERS, active=quickOutlierZones and deltaTierCount >= 4)
outlierTier2SellZoneColor = input.color(color.new(color.rgb(178, 40, 51), 96), "", inline="delta_tier_2_colors", group=GROUP_DELTA_TIERS, active=quickOutlierZones and deltaTierCount >= 4, tooltip="Each color pair is ordered Buy then Sell. Tier 2 is zone-only. Delta marker size is set in Delta: Tiers.")

tier1Enabled = input.bool(true, "Tier 1", inline="delta_tier_1", group=GROUP_DELTA_TIERS, active=quickOutlierZones and deltaTierCount >= 5)
