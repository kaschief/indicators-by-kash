var array<float> globexBarLows = array.new<float>()
var array<float> globexBarVolumes = array.new<float>()
var array<float> globexBarDeltas = array.new<float>()
var array<DeltaProfile> globexProfiles = array.new<DeltaProfile>()
var array<int> globexStartRef = array.new<int>(1, START_TIME_UNSET)
var array<int> globexLastBarRef = array.new<int>(1, START_TIME_UNSET)

var array<float> midnightBarHighs = array.new<float>()
var array<float> midnightBarLows = array.new<float>()
var array<float> midnightBarVolumes = array.new<float>()
var array<float> midnightBarDeltas = array.new<float>()
var array<DeltaProfile> midnightProfiles = array.new<DeltaProfile>()
var array<int> midnightStartRef = array.new<int>(1, START_TIME_UNSET)
var array<int> midnightLastBarRef = array.new<int>(1, START_TIME_UNSET)

