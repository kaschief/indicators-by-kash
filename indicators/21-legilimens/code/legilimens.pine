// ───────────────────────────────────────────────────────────────────────────────
// HELPERS — CHART COORDINATES
// ───────────────────────────────────────────────────────────────────────────────
// Range/tick charts infer span from recent bars.
barSpanMs() =>
    int spanMs = nz(timeframe.in_seconds(timeframe.period)) * 1000
    if spanMs <= 0
        for lookback = 0 to OFFSET_SPAN_LOOKBACK - 1
            int gap = nz(time[lookback] - time[lookback + 1])
            if gap > 0 and (spanMs <= 0 or gap < spanMs)
                spanMs := gap
    math.max(1, spanMs)

dotMarkerOffsetMs() =>
    int(math.round(DOT_MARKER_OFFSET_BARS * barSpanMs()))

pocLabelOffsetMs() =>
    int(math.round(POC_LABEL_OFFSET_BARS * barSpanMs()))

futuresExtensionEndpoint(int sessionCloseTime, int extensionMs) =>
    int endpoint = sessionCloseTime
    int remainingMs = extensionMs
    if remainingMs > 0
        int endpointDay = dayofweek(endpoint, NY_TIMEZONE)
        int endpointMinute = hour(endpoint, NY_TIMEZONE) * 60 + minute(endpoint, NY_TIMEZONE)
        bool fridayWeekend = endpointDay == dayofweek.friday and endpointMinute >= SUNDAY_REOPEN_START_HOUR * 60
        bool saturdayWeekend = endpointDay == dayofweek.saturday
        bool sundayWeekend = endpointDay == dayofweek.sunday and endpointMinute < SUNDAY_REOPEN_START_HOUR * 60
        if fridayWeekend or saturdayWeekend or sundayWeekend
            int daysUntilSunday = fridayWeekend ? 2 : saturdayWeekend ? 1 : 0
            endpoint := timestamp(NY_TIMEZONE, year(endpoint, NY_TIMEZONE), month(endpoint, NY_TIMEZONE), dayofmonth(endpoint, NY_TIMEZONE) + daysUntilSunday, SUNDAY_REOPEN_START_HOUR, 0)
        endpointDay := dayofweek(endpoint, NY_TIMEZONE)
        int daysUntilFriday = (dayofweek.friday - endpointDay + CALENDAR_DAYS_PER_WEEK) % CALENDAR_DAYS_PER_WEEK
        int weekendStart = timestamp(NY_TIMEZONE, year(endpoint, NY_TIMEZONE), month(endpoint, NY_TIMEZONE), dayofmonth(endpoint, NY_TIMEZONE) + daysUntilFriday, SUNDAY_REOPEN_START_HOUR, 0)
        int availableMs = weekendStart - endpoint
        if remainingMs < availableMs
            endpoint += remainingMs
        else
            remainingMs -= availableMs
            int weekendEnd = timestamp(NY_TIMEZONE, year(weekendStart, NY_TIMEZONE), month(weekendStart, NY_TIMEZONE), dayofmonth(weekendStart, NY_TIMEZONE) + 2, SUNDAY_REOPEN_START_HOUR, 0)
            int fullWeeks = int(math.floor(remainingMs / float(FUTURES_EXTENSION_WEEK_MS)))
            remainingMs -= fullWeeks * FUTURES_EXTENSION_WEEK_MS
            endpoint := timestamp(NY_TIMEZONE, year(weekendEnd, NY_TIMEZONE), month(weekendEnd, NY_TIMEZONE), dayofmonth(weekendEnd, NY_TIMEZONE) + fullWeeks * CALENDAR_DAYS_PER_WEEK, SUNDAY_REOPEN_START_HOUR, 0) + remainingMs
    endpoint

sessionLevelEndpoint(string sourceName, int sessionCloseTime, bool futuresAsset) =>
    int extensionMs = int(math.round(profileHours(sourceName) * MS_PER_HOUR))
    futuresAsset ? futuresExtensionEndpoint(sessionCloseTime, extensionMs) : sessionCloseTime + extensionMs

profileHeadingOffsetBars(string sourceName, bool pairedNyHeadings) =>
    pairedNyHeadings ? sourceName == SOURCE_NY_EARLY ? -NY_HEADING_SEPARATION_BARS : sourceName == SOURCE_EXTENDED_NY_EARLY ? NY_HEADING_SEPARATION_BARS : 0 : 0

// Chart-index positioning ignores time gaps.
rangeHeadingTime(DeltaProfile profile, array<int> chartTimes, int startScaleIndex, int endScaleIndex, int barOffset) =>
    int headingTime = profile.startTime + int(math.round((profile.endTime - profile.startTime) * 0.5))
    if startScaleIndex >= 0 and endScaleIndex >= 0
        int centerIndex = int(math.round((startScaleIndex + endScaleIndex) * 0.5))
        int headingIndex = centerIndex + barOffset
        int chartTimeCount = array.size(chartTimes)
        if headingIndex >= 0 and headingIndex < chartTimeCount
            headingTime := array.get(chartTimes, headingIndex)
        else
            int overflowSteps = headingIndex < 0 ? headingIndex : headingIndex - (chartTimeCount - 1)
            int edgeTime = headingIndex < 0 ? array.get(chartTimes, 0) : array.get(chartTimes, chartTimeCount - 1)
            headingTime := edgeTime + overflowSteps * barSpanMs()
    else
        headingTime += barOffset * barSpanMs()
    headingTime

levelMarkerTime(int levelEndTime) =>
    levelEndTime + dotMarkerOffsetMs()

tradingDayKey(int sessionCloseTime) =>
    legilimensOrchestration.tradingDayKey(sessionCloseTime)

// Preserve NY clock time across DST.
lookbackDaysStart(int endTime, int days, bool twentyFourSeven) =>
    legilimensOrchestration.lookbackDaysStart(endTime, days, twentyFourSeven)

rollingClockCutoffMinute(string throughMode) =>
    switch throughMode
        ROLLING_THROUGH_0000 => ROLLING_CUTOFF_0000_MINUTE
        ROLLING_THROUGH_0500 => ROLLING_CUTOFF_0500_MINUTE
        ROLLING_THROUGH_0830 => ROLLING_CUTOFF_0830_MINUTE
        ROLLING_THROUGH_0930 => ROLLING_CUTOFF_0930_MINUTE
        ROLLING_THROUGH_1600 => ROLLING_CUTOFF_1600_MINUTE
        ROLLING_THROUGH_1800 => ROLLING_CUTOFF_1800_MINUTE
        => na

rollingThroughTime(int referenceTime, string throughMode, bool twentyFourSeven) =>
    int endTime = referenceTime
    int cutoffMinuteOfDay = rollingClockCutoffMinute(throughMode)
    if (throughMode == ROLLING_THROUGH_LIVE_MINUS_2H or throughMode == ROLLING_THROUGH_LIVE_MINUS_4H) and not na(referenceTime)
        int liveOffsetHours = throughMode == ROLLING_THROUGH_LIVE_MINUS_2H ? 2 : 4
        endTime := referenceTime - liveOffsetHours * MS_PER_HOUR
    else if not na(cutoffMinuteOfDay) and not na(referenceTime)
        int cutoffHour = int(math.floor(cutoffMinuteOfDay / 60))
        int cutoffMinute = cutoffMinuteOfDay % 60
        endTime := timestamp(NY_TIMEZONE, year(referenceTime, NY_TIMEZONE), month(referenceTime, NY_TIMEZONE), dayofmonth(referenceTime, NY_TIMEZONE), cutoffHour, cutoffMinute)
        if endTime > referenceTime
            endTime := legilimensOrchestration.previousNyCutoff(endTime, cutoffHour, cutoffMinute)
        if not twentyFourSeven
            int cutoffDay = dayofweek(endTime, NY_TIMEZONE)
            while cutoffDay == dayofweek.saturday or cutoffDay == dayofweek.sunday
                endTime := legilimensOrchestration.previousNyCutoff(endTime, cutoffHour, cutoffMinute)
                cutoffDay := dayofweek(endTime, NY_TIMEZONE)
    endTime

rollingUsesClockCutoff(string throughMode) =>
    not na(rollingClockCutoffMinute(throughMode))

tierMarkerSize(array<int> markerSizes, int tier) =>
    array.get(markerSizes, math.max(0, math.min(4, 5 - tier)))

deltaTierAppearance(bool buySide, int tier, string sourceName) =>
    int tierIndex = math.max(0, math.min(4, 5 - tier))
    int appearanceIndex = tierIndex * 2 + (buySide ? 0 : 1)
    usesAlternateStyles(sourceName) ? array.get(alternateDeltaTierAppearances, appearanceIndex) : array.get(deltaTierAppearances, appearanceIndex)

deltaTierSideVisible(bool buySide) =>
    deltaTierSideVisibility != OPTION_OFF and (deltaTierSideVisibility == OPTION_ALL or (buySide and deltaTierSideVisibility == DELTA_TIER_VISIBILITY_BUY) or (not buySide and deltaTierSideVisibility == DELTA_TIER_VISIBILITY_SELL))

deltaTierFibLocationGrade(bool buySide, float tierPrice, float rangeLow, float rangeHigh) =>
    int grade = FIB_LOCATION_UNKNOWN
    float profileRange = rangeHigh - rangeLow
    if not na(tierPrice) and not na(rangeLow) and not na(rangeHigh) and profileRange > 0
        float fibPosition = (tierPrice - rangeLow) / profileRange
        bool veryStrong = buySide ? fibPosition < FIB_LOCATION_BUY_PREFERRED_LOW : fibPosition > FIB_LOCATION_SELL_PREFERRED_HIGH
        bool preferred = buySide ? fibPosition >= FIB_LOCATION_BUY_PREFERRED_LOW and fibPosition <= FIB_LOCATION_BUY_PREFERRED_HIGH : fibPosition >= FIB_LOCATION_SELL_PREFERRED_LOW and fibPosition <= FIB_LOCATION_SELL_PREFERRED_HIGH
        bool qualified = buySide ? fibPosition <= FIB_LOCATION_MIDPOINT : fibPosition >= FIB_LOCATION_MIDPOINT
        grade := veryStrong ? FIB_LOCATION_VERY_STRONG : preferred ? FIB_LOCATION_PREFERRED : qualified ? FIB_LOCATION_QUALIFIED : FIB_LOCATION_CONTRADICTORY
    grade

fibLocationMarkerGlyph(int fibLocationGrade) =>
    fibLocationGrade == FIB_LOCATION_VERY_STRONG ? FIB_LOCATION_VERY_STRONG_MARKER_GLYPH : fibLocationGrade == FIB_LOCATION_PREFERRED ? FIB_LOCATION_PREFERRED_MARKER_GLYPH : LEVEL_MARKER_GLYPH

contrastChannel(float channel, float ratio, bool darken) =>
    darken ? channel * (1.0 - ratio) : channel + (255.0 - channel) * ratio

contrastColor(color sourceColor, int percentage, bool darken) =>
    float ratio = percentage / 100.0
    color.rgb(int(math.round(contrastChannel(color.r(sourceColor), ratio, darken))), int(math.round(contrastChannel(color.g(sourceColor), ratio, darken))), int(math.round(contrastChannel(color.b(sourceColor), ratio, darken))), color.t(sourceColor))

fibQualificationColor(color sourceColor, bool qualified) =>
    contrastColor(sourceColor, qualified ? 15 : 5, qualified)

// ───────────────────────────────────────────────────────────────────────────────
// PROFILE DATA ADAPTERS
// ───────────────────────────────────────────────────────────────────────────────
compactIfNeeded(array<float> highs, array<float> lows, array<float> volumes, array<float> deltas) =>
    legilimensProfile.compactIfNeeded(highs, lows, volumes, deltas, syminfo.mintick)

clearSamples(array<float> highs, array<float> lows, array<float> volumes, array<float> deltas) =>
    legilimensProfile.clearSamples(highs, lows, volumes, deltas)

appendSamples(array<float> destHighs, array<float> destLows, array<float> destVolumes, array<float> destDeltas, array<float> sourceHighs, array<float> sourceLows, array<float> sourceVolumes, array<float> sourceDeltas, bool compactAfter) =>
    legilimensProfile.appendSamples(destHighs, destLows, destVolumes, destDeltas, sourceHighs, sourceLows, sourceVolumes, sourceDeltas, compactAfter, syminfo.mintick)

appendBarSample(array<float> highs, array<float> lows, array<float> volumes, array<float> deltas, float sampleHigh, float sampleLow, float sampleVolume, float sampleDelta) =>
    legilimensProfile.appendBarSample(highs, lows, volumes, deltas, sampleHigh, sampleLow, sampleVolume, sampleDelta)

// Prefer one-tick rows; bin wider ranges.
deltaProfileFromData(legilimensProfile.ProfileData profile, int startTime, int endTime) =>
    DeltaProfile.new(startTime, endTime, profile.priceLow, profile.priceHigh, profile.rangeLow, profile.rangeHigh, profile.rowCount, profile.rowVolumes, profile.rowDeltas, profile.maxRowVolume, profile.maxAbsRowDelta, profile.isValid)

profileDataFromDeltaProfile(DeltaProfile profile) =>
    legilimensProfile.ProfileData.new(profile.priceLow, profile.priceHigh, profile.rangeLow, profile.rangeHigh, profile.rowCount, profile.rowVolumes, profile.rowDeltas, profile.maxRowVolume, profile.maxAbsRowDelta, profile.isValid)

deltaProfileFromOrchestration(legilimensOrchestration.Profile profile) =>
    deltaProfileFromData(profile.data, profile.startTime, profile.endTime)

buildDeltaProfileFromSelection(array<float> highs, array<float> lows, array<float> volumes, array<float> deltas, array<int> selectedIndices, int requestedRows, int startTime, int endTime) =>
    legilimensProfile.ProfileData profile = legilimensProfile.buildProfile(highs, lows, volumes, deltas, selectedIndices, requestedRows, syminfo.mintick)
    deltaProfileFromData(profile, startTime, endTime)

buildDeltaProfile(array<float> highs, array<float> lows, array<float> volumes, array<float> deltas, int requestedRows, int startTime, int endTime) =>
    array<int> allSampleIndices = na
    buildDeltaProfileFromSelection(highs, lows, volumes, deltas, allSampleIndices, requestedRows, startTime, endTime)

buildCurrentRollingDeltaProfile(legilimensProfile.RollingSampleStore store, legilimensProfile.SampleBatch currentSamples, bool includeCurrentSamples, legilimensProfile.RollingProfileWindow window, int requestedRows) =>
    legilimensProfile.ProfileData profile = legilimensProfile.buildRollingProfile(store, currentSamples, includeCurrentSamples, window, requestedRows, syminfo.mintick)
    deltaProfileFromData(profile, window.startTime, window.endTime)

profileValueLevels(DeltaProfile profile) =>
    legilimensProfile.profileValueLevels(profile.rowVolumes, profile.rowCount, profile.priceLow, profile.priceHigh)

appendContainedSamples(array<float> destHighs, array<float> destLows, array<float> destVolumes, array<float> destDeltas, legilimensProfile.SampleBatch samples, int rangeStartTime, int rangeEndTime, bool compactAfter) =>
    int sampleCount = array.size(samples.volumes)
    if sampleCount > 0
        for sampleIndex = 0 to sampleCount - 1
            int sampleStartTime = array.get(samples.startTimes, sampleIndex)
            int sampleEndTime = array.get(samples.endTimes, sampleIndex)
            if sampleStartTime >= rangeStartTime and sampleEndTime <= rangeEndTime
                appendBarSample(destHighs, destLows, destVolumes, destDeltas, array.get(samples.highs, sampleIndex), array.get(samples.lows, sampleIndex), array.get(samples.volumes, sampleIndex), array.get(samples.deltas, sampleIndex))
    if compactAfter
        compactIfNeeded(destHighs, destLows, destVolumes, destDeltas)

// ═══════════════════════════════════════════════════════════════════════════════
// RENDER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

canDrawBox() =>
    array.size(drawnBoxes) < INDICATOR_MAX_BOXES

canDrawLine() =>
    array.size(drawnLines) < INDICATOR_MAX_LINES

canDrawLabel() =>
    array.size(drawnLabels) < INDICATOR_MAX_LABELS

canDrawPolyline() =>
    array.size(drawnPolylines) < INDICATOR_MAX_POLYLINES

clearDrawings() =>
    if array.size(drawnBoxes) > 0
        for boxIndex = 0 to array.size(drawnBoxes) - 1
            box.delete(array.get(drawnBoxes, boxIndex))
        array.clear(drawnBoxes)
    if array.size(drawnLines) > 0
        for lineIndex = 0 to array.size(drawnLines) - 1
            line.delete(array.get(drawnLines, lineIndex))
        array.clear(drawnLines)
    if array.size(drawnPolylines) > 0
        for polylineIndex = 0 to array.size(drawnPolylines) - 1
            polyline.delete(array.get(drawnPolylines, polylineIndex))
        array.clear(drawnPolylines)
    if array.size(drawnLabels) > 0
        for labelIndex = 0 to array.size(drawnLabels) - 1
            label.delete(array.get(drawnLabels, labelIndex))
        array.clear(drawnLabels)
    array.clear(pendingOutlierLevels)
    array.clear(pendingMitigatedZones)
    array.clear(pendingRightLabels)
    array.clear(pendingRightLines)

queueLevelMarker(float price, int markerTime, string markerGlyph, string markerLabel, color markerColor, int markerSize) =>
    if showDots
        array.push(pendingRightLabels, PendingRightLabel.new(price, markerTime, markerGlyph, markerColor, markerSize, false))
        if markerLabel != ""
            array.push(pendingRightLabels, PendingRightLabel.new(price, markerTime, markerLabel, markerColor, DOT_LABEL_SIZE, true))

queueRightLine(float price, int leftTime, int rightTime, color lineColor, int lineWidth, string styleName, int rank, string sourceName, int sessionTradingDayKey, bool historical, int direction) =>
    bool historicalMergeGroup = historical or sessionTradingDayKey != tradingDayKey(time)
    array.push(pendingRightLines, PendingRightLine.new(price, leftTime, rightTime, lineColor, lineWidth, styleName, rank, sourceName, sessionTradingDayKey, historicalMergeGroup, direction))

renderZoneFill(int leftTime, int rightTime, float zoneLow, float zoneHigh, color zoneFillColor, int zoneBorderWidth, color highlightColor) =>
    if canDrawBox()
        color borderColor = zoneBorderWidth > 0 ? highlightColor : color.new(zoneFillColor, 100)
        array.push(drawnBoxes, box.new(left=leftTime, top=zoneHigh, right=rightTime, bottom=zoneLow, xloc=xloc.bar_time, border_color=borderColor, border_width=zoneBorderWidth, bgcolor=zoneFillColor))

mitigatedZoneStateIndex(string sourceName, int profileStartTime, int eligibilityTime, float price) =>
    int foundIndex = -1
    int stateCount = array.size(mitigatedZoneStates)
    if stateCount > 0
        for stateIndex = 0 to stateCount - 1
            MitigatedZoneState state = array.get(mitigatedZoneStates, stateIndex)
            if state.sourceName == sourceName and state.profileStartTime == profileStartTime and state.eligibilityTime == eligibilityTime and state.price == price
                foundIndex := stateIndex
                break
    foundIndex

removeMitigatedProfile(string sourceName, int profileStartTime) =>
    int stateIndex = array.size(mitigatedZoneStates) - 1
    while stateIndex >= 0
        MitigatedZoneState state = array.get(mitigatedZoneStates, stateIndex)
        if state.sourceName == sourceName and state.profileStartTime == profileStartTime
            array.remove(mitigatedZoneStates, stateIndex)
        stateIndex -= 1

removeMitigatedSource(string sourceName) =>
    int stateIndex = array.size(mitigatedZoneStates) - 1
    while stateIndex >= 0
        MitigatedZoneState state = array.get(mitigatedZoneStates, stateIndex)
        if state.sourceName == sourceName
            array.remove(mitigatedZoneStates, stateIndex)
        stateIndex -= 1
    int profileIndex = array.size(mitigatedProfiles) - 1
    while profileIndex >= 0
        if array.get(mitigatedProfiles, profileIndex).sourceName == sourceName
            array.remove(mitigatedProfiles, profileIndex)
        profileIndex -= 1

registerZoneTrackingProfile(array<ZoneTrackingProfileKey> profileKeys, string sourceName, int profileStartTime) =>
    bool alreadyRegistered = false
    int profileCount = array.size(profileKeys)
    if profileCount > 0
        for profileIndex = 0 to profileCount - 1
            ZoneTrackingProfileKey profileKey = array.get(profileKeys, profileIndex)
            if profileKey.sourceName == sourceName and profileKey.startTime == profileStartTime
                alreadyRegistered := true
                break
    int expiredProfileStartTime = na
    if not alreadyRegistered
        array.push(profileKeys, ZoneTrackingProfileKey.new(sourceName, profileStartTime))
        int sourceProfileCount = 0
        for profileIndex = 0 to array.size(profileKeys) - 1
            if array.get(profileKeys, profileIndex).sourceName == sourceName
                sourceProfileCount += 1
        if sourceProfileCount > SESSION_PROFILE_RETENTION
            int oldestIndex = -1
            int oldestStartTime = na
            for profileIndex = 0 to array.size(profileKeys) - 1
                ZoneTrackingProfileKey profileKey = array.get(profileKeys, profileIndex)
                if profileKey.sourceName == sourceName
                    int candidateStartTime = profileKey.startTime
                    if oldestIndex < 0 or candidateStartTime < oldestStartTime
                        oldestIndex := profileIndex
                        oldestStartTime := candidateStartTime
            if oldestIndex >= 0
                expiredProfileStartTime := oldestStartTime
                array.remove(profileKeys, oldestIndex)
    expiredProfileStartTime

registerMitigatedZone(string sourceName, int profileStartTime, int eligibilityTime, float price) =>
    int expiredProfileStartTime = registerZoneTrackingProfile(mitigatedProfiles, sourceName, profileStartTime)
    if not na(expiredProfileStartTime)
        removeMitigatedProfile(sourceName, expiredProfileStartTime)
    if mitigatedZoneStateIndex(sourceName, profileStartTime, eligibilityTime, price) < 0
        array.push(mitigatedZoneStates, MitigatedZoneState.new(sourceName, profileStartTime, eligibilityTime, price, na, true))

roleReversalZoneStateIndex(string sourceName, int profileStartTime, float price, int originalDirection) =>
    int foundIndex = -1
    int stateCount = array.size(roleReversalZoneStates)
    if stateCount > 0
        for stateIndex = 0 to stateCount - 1
            RoleReversalZoneState state = array.get(roleReversalZoneStates, stateIndex)
            if state.sourceName == sourceName and state.profileStartTime == profileStartTime and state.price == price and state.originalDirection == originalDirection
                foundIndex := stateIndex
                break
    foundIndex

removeRoleReversalProfile(string sourceName, int profileStartTime) =>
    int stateIndex = array.size(roleReversalZoneStates) - 1
    while stateIndex >= 0
        RoleReversalZoneState state = array.get(roleReversalZoneStates, stateIndex)
        if state.sourceName == sourceName and state.profileStartTime == profileStartTime
            array.remove(roleReversalZoneStates, stateIndex)
        stateIndex -= 1

registerRoleReversalZone(string sourceName, int profileStartTime, int eligibilityTime, int expirationTime, float price, float zoneLow, float zoneHigh, int originalDirection, bool extendsUntilMitigated) =>
    int expiredProfileStartTime = registerZoneTrackingProfile(roleReversalProfiles, sourceName, profileStartTime)
    if not na(expiredProfileStartTime)
        removeRoleReversalProfile(sourceName, expiredProfileStartTime)
    int stateIndex = roleReversalZoneStateIndex(sourceName, profileStartTime, price, originalDirection)
    if stateIndex < 0
        array.push(roleReversalZoneStates, RoleReversalZoneState.new(sourceName, profileStartTime, eligibilityTime, expirationTime, price, zoneLow, zoneHigh, originalDirection, extendsUntilMitigated, false, false, false))
    else
        RoleReversalZoneState state = array.get(roleReversalZoneStates, stateIndex)
        state.eligibilityTime := eligibilityTime
        state.expirationTime := expirationTime
        state.zoneLow := zoneLow
        state.zoneHigh := zoneHigh
        state.extendsUntilMitigated := extendsUntilMitigated
        array.set(roleReversalZoneStates, stateIndex, state)

roleReversalZoneIsReversed(string sourceName, int profileStartTime, float price, int originalDirection) =>
    bool reversed = false
    int stateIndex = roleReversalZoneStateIndex(sourceName, profileStartTime, price, originalDirection)
    if stateIndex >= 0
        reversed := array.get(roleReversalZoneStates, stateIndex).reversed
    reversed

// Records keep cluster fields aligned.
flushPendingRightLines(bool merge) =>
    int pendingCount = array.size(pendingRightLines)
    if pendingCount > 0
        array<PendingRightLine> clusters = array.new<PendingRightLine>()
        for pendingIndex = 0 to pendingCount - 1
            PendingRightLine pending = array.get(pendingRightLines, pendingIndex)
            float tolerance = math.max(syminfo.mintick, math.abs(pending.price) * mergeDistancePercent / 100.0)
            int foundIndex = -1
            float minimumDistance = tolerance + syminfo.mintick
            int clusterCount = array.size(clusters)
            if merge and clusterCount > 0
                for clusterIndex = 0 to clusterCount - 1
                    PendingRightLine cluster = array.get(clusters, clusterIndex)
                    float distance = math.abs(cluster.price - pending.price)
                    bool sameSource = cluster.sourceName == pending.sourceName
                    bool sameOccurrence = cluster.tradingDayKey == pending.tradingDayKey and cluster.historical == pending.historical
                    bool sameEndpoint = cluster.rightTime == pending.rightTime
                    bool compatibleDirection = cluster.direction == 0 or pending.direction == 0 or cluster.direction == pending.direction
                    if sameSource and sameOccurrence and sameEndpoint and compatibleDirection and distance <= tolerance and distance < minimumDistance
                        minimumDistance := distance
                        foundIndex := clusterIndex
            if foundIndex >= 0
                PendingRightLine cluster = array.get(clusters, foundIndex)
                cluster.leftTime := math.min(cluster.leftTime, pending.leftTime)
                cluster.rightTime := math.max(cluster.rightTime, pending.rightTime)
                if cluster.direction == 0 and pending.direction != 0
                    cluster.direction := pending.direction
                if pending.rank > cluster.rank
                    cluster.price := pending.price
                    cluster.lineColor := pending.lineColor
                    cluster.lineWidth := pending.lineWidth
                    cluster.styleName := pending.styleName
                    cluster.rank := pending.rank
            else
                array.push(clusters, PendingRightLine.new(pending.price, pending.leftTime, pending.rightTime, pending.lineColor, pending.lineWidth, pending.styleName, pending.rank, pending.sourceName, pending.tradingDayKey, pending.historical, pending.direction))
        for clusterIndex = 0 to array.size(clusters) - 1
            PendingRightLine cluster = array.get(clusters, clusterIndex)
            if canDrawLine()
                array.push(drawnLines, line.new(cluster.leftTime, cluster.price, cluster.rightTime, cluster.price, xloc=xloc.bar_time, color=cluster.lineColor, style=toLineStyle(cluster.styleName), width=cluster.lineWidth))
        array.clear(pendingRightLines)

flushPendingRightLabels() =>
    int pendingCount = array.size(pendingRightLabels)
    if pendingCount > 0
        for pendingIndex = 0 to pendingCount - 1
            PendingRightLabel pending = array.get(pendingRightLabels, pendingIndex)
            string labelStyle = pending.sessionText ? label.style_label_left : label.style_none
            string textAlignment = pending.sessionText ? text.align_left : text.align_center
            if canDrawLabel()
                array.push(drawnLabels, label.new(pending.markerTime, pending.price, pending.labelText, xloc=xloc.bar_time, yloc=yloc.price, style=labelStyle, textcolor=pending.textColor, size=pending.textSize, color=color.new(color.white, 100), textalign=textAlignment))
        array.clear(pendingRightLabels)

// Bar indexing ignores time gaps.
recentChartTimes() =>
    array<int> chartTimes = array.new<int>()
    int offset = math.min(bar_index, PROFILE_TIME_SCALE_MAX_LOOKBACK)
    while offset >= 0
        array.push(chartTimes, time[offset])
        offset -= 1
    chartTimes

nearestChartTimeIndex(array<int> chartTimes, int targetTime) =>
    int count = array.size(chartTimes)
    int result = -1
    bool insideScale = count > 0 and targetTime >= array.get(chartTimes, 0) and targetTime <= array.get(chartTimes, count - 1)
    if insideScale
        int lowIndex = 0
        int highIndex = count - 1
        while lowIndex <= highIndex
            int middleIndex = int(math.floor((lowIndex + highIndex) * 0.5))
            int middleTime = array.get(chartTimes, middleIndex)
            if middleTime < targetTime
                result := middleIndex
                lowIndex := middleIndex + 1
            else if middleTime > targetTime
                highIndex := middleIndex - 1
            else
                result := middleIndex
                lowIndex := highIndex + 1
        if result < 0
            result := 0
        if result < count - 1
            int nextIndex = result + 1
            if math.abs(array.get(chartTimes, nextIndex) - targetTime) < math.abs(array.get(chartTimes, result) - targetTime)
                result := nextIndex
    result

profileBaselineTime(DeltaProfile profile, array<int> chartTimes, int baselineIndex, bool attachRight) =>
    int count = array.size(chartTimes)
    baselineIndex >= 0 and baselineIndex < count ? array.get(chartTimes, baselineIndex) : (attachRight ? profile.endTime : profile.startTime)

chartTimeAtOffset(array<int> chartTimes, int baselineIndex, int stepOffset) =>
    int count = array.size(chartTimes)
    int outerIndex = baselineIndex + stepOffset
    int outerTime = na
    if outerIndex >= 0 and outerIndex < count
        outerTime := array.get(chartTimes, outerIndex)
    else
        int overflowSteps = outerIndex < 0 ? outerIndex : outerIndex - (count - 1)
        int edgeTime = outerIndex < 0 ? array.get(chartTimes, 0) : array.get(chartTimes, count - 1)
        outerTime := edgeTime + overflowSteps * barSpanMs()
    outerTime

profileOuterTime(DeltaProfile profile, array<int> chartTimes, int baselineIndex, int rangeSteps, float magnitudeRatio, int widthPercent, bool faceLeft, bool attachRight) =>
    int count = array.size(chartTimes)
    int outerTime = na
    float clampedRatio = math.max(0.0, math.min(1.0, magnitudeRatio))
    int baselineTime = profileBaselineTime(profile, chartTimes, baselineIndex, attachRight)
    if clampedRatio <= 0
        outerTime := baselineTime
    else if count > 1 and baselineIndex >= 0
        int maximumSteps = math.max(1, int(math.round(rangeSteps * widthPercent * 0.01)))
        int rowSteps = math.max(1, int(math.round(clampedRatio * maximumSteps)))
        outerTime := chartTimeAtOffset(chartTimes, baselineIndex, faceLeft ? -rowSteps : rowSteps)
    else
        int profileMilliseconds = math.max(1, profile.endTime - profile.startTime)
        int rowWidth = math.max(1, int(math.round(profileMilliseconds * widthPercent * 0.01 * clampedRatio)))
        outerTime := baselineTime + (faceLeft ? -rowWidth : rowWidth)
    outerTime

deltaOuterTime(DeltaProfile profile, array<int> chartTimes, int startScaleIndex, int endScaleIndex, int baselineIndex, float magnitudeRatio, int widthBars, bool faceLeft, bool attachRight) =>
    int count = array.size(chartTimes)
    int baselineTime = profileBaselineTime(profile, chartTimes, baselineIndex, attachRight)
    float clampedRatio = math.max(0.0, math.min(1.0, magnitudeRatio))
    bool completeScale = startScaleIndex >= 0 and endScaleIndex >= 0
    int profileSteps = completeScale ? math.max(1, math.abs(endScaleIndex - startScaleIndex)) : widthBars
    int maximumSteps = math.min(widthBars, profileSteps)
    int rowSteps = math.max(1, int(math.round(clampedRatio * maximumSteps)))
    if count > 1 and baselineIndex >= 0
        chartTimeAtOffset(chartTimes, baselineIndex, faceLeft ? -rowSteps : rowSteps)
    else
        int profileMilliseconds = math.max(1, profile.endTime - profile.startTime)
        int maximumWidth = math.min(profileMilliseconds, barSpanMs() * widthBars)
        int rowWidth = math.max(1, int(math.round(maximumWidth * clampedRatio)))
        baselineTime + (faceLeft ? -rowWidth : rowWidth)

computeRowStrengths(DeltaProfile profile) =>
    legilimensProfile.computeRowStrengths(profileDataFromDeltaProfile(profile))

isOutlierStrength(float strength) =>
    legilimensProfile.isOutlierStrength(strength)

rowPassesDeltaFilter(float rowDelta, float strength, bool selectedOutlierRow) =>
    bool isBuy = rowDelta > 0
    bool isSell = rowDelta < 0
    bool directionVisible = deltaHistogramRows == OPTION_ALL ? isBuy or isSell : deltaHistogramRows == OPTION_OFF ? false : deltaHistogramRows == DELTA_ROWS_BUY ? isBuy : deltaHistogramRows == DELTA_ROWS_SELL ? isSell : false
    bool filterPassed = deltaRowFilter == OPTION_ALL ? true : deltaRowFilter == DELTA_ROW_FILTER_OUTLIERS ? isOutlierStrength(strength) : selectedOutlierRow
    directionVisible and filterPassed

appendDeltaRowPoints(array<chart.point> points, int baselineTime, int outerTime, float rowBottom, float rowTop) =>
    array.push(points, chart.point.from_time(baselineTime, rowBottom))
    array.push(points, chart.point.from_time(outerTime, rowBottom))
    array.push(points, chart.point.from_time(outerTime, rowTop))
    array.push(points, chart.point.from_time(baselineTime, rowTop))

renderDeltaLayer(array<chart.point> points, color fillColor) =>
    if array.size(points) >= 4 and canDrawPolyline()
        array.push(drawnPolylines, polyline.new(points, curved=false, closed=true, xloc=xloc.bar_time, line_color=color.new(fillColor, 100), fill_color=fillColor))

renderDeltaPolylines(DeltaProfile profile, string sourceName, array<float> strengths, array<bool> selectedOutlierRows, array<int> chartTimes, int startScaleIndex, int endScaleIndex) =>
    if profile.maxAbsRowDelta > 0
        array<chart.point> buyPoints = array.new<chart.point>()
        array<chart.point> sellPoints = array.new<chart.point>()
        array<chart.point> deltaPlusPlusPoints = array.new<chart.point>()
        array<chart.point> deltaMinusMinusPoints = array.new<chart.point>()
        float rowHeight = (profile.priceHigh - profile.priceLow) / profile.rowCount
        string position = profilePosition(sourceName)
        bool attachRight = position == PROFILE_POSITION_RIGHT_LEFT or position == PROFILE_POSITION_RIGHT_RIGHT
        bool faceLeft = position == PROFILE_POSITION_LEFT_LEFT or position == PROFILE_POSITION_RIGHT_LEFT
        int baselineIndex = attachRight ? endScaleIndex : startScaleIndex
        int baselineTime = profileBaselineTime(profile, chartTimes, baselineIndex, attachRight)
        for rowIndex = 0 to profile.rowCount - 1
            float rowVolume = array.get(profile.rowVolumes, rowIndex)
            if rowVolume > 0
                float strength = array.get(strengths, rowIndex)
                bool outlierRow = isOutlierStrength(strength)
                float rowDelta = array.get(profile.rowDeltas, rowIndex)
                float magnitude = math.abs(rowDelta)
                bool selectedOutlierRow = rowIndex < array.size(selectedOutlierRows) and array.get(selectedOutlierRows, rowIndex)
                if magnitude > 0 and rowPassesDeltaFilter(rowDelta, strength, selectedOutlierRow)
                    float rowBottom = profile.priceLow + rowIndex * rowHeight
                    int outerTime = deltaOuterTime(profile, chartTimes, startScaleIndex, endScaleIndex, baselineIndex, magnitude / profile.maxAbsRowDelta, profileDeltaWidthBars(sourceName), faceLeft, attachRight)
                    if rowDelta >= 0 and outlierRow
                        appendDeltaRowPoints(deltaPlusPlusPoints, baselineTime, outerTime, rowBottom, rowBottom + rowHeight)
                    else if rowDelta >= 0
                        appendDeltaRowPoints(buyPoints, baselineTime, outerTime, rowBottom, rowBottom + rowHeight)
                    else if outlierRow
                        appendDeltaRowPoints(deltaMinusMinusPoints, baselineTime, outerTime, rowBottom, rowBottom + rowHeight)
                    else
                        appendDeltaRowPoints(sellPoints, baselineTime, outerTime, rowBottom, rowBottom + rowHeight)
        renderDeltaLayer(buyPoints, profileDeltaPlusColor(sourceName))
        renderDeltaLayer(sellPoints, profileDeltaMinusColor(sourceName))
        renderDeltaLayer(deltaPlusPlusPoints, profileDeltaPlusPlusColor(sourceName))
        renderDeltaLayer(deltaMinusMinusPoints, profileDeltaMinusMinusColor(sourceName))

pushHistogramRun(array<chart.point> points, color fillColor) =>
    if canDrawPolyline()
        array.push(drawnPolylines, polyline.new(points, curved=false, closed=true, xloc=xloc.bar_time, line_color=color.new(fillColor, 100), fill_color=fillColor))

// Split only at value-area boundaries.
renderHistogram(DeltaProfile profile, int valueAreaLowRow, int valueAreaHighRow, int maxPolylinesAllowed, array<int> chartTimes, int startScaleIndex, int endScaleIndex) =>
    int polylinesUsed = 0
    if profile.maxRowVolume > 0 and maxPolylinesAllowed > 0
        int rowCount = profile.rowCount
        float rowHeight = (profile.priceHigh - profile.priceLow) / rowCount
        bool attachRight = false
        bool faceLeft = false
        bool completeScale = startScaleIndex >= 0 and endScaleIndex >= 0
        int baselineIndex = completeScale ? (attachRight ? endScaleIndex : startScaleIndex) : -1
        int rangeSteps = completeScale ? math.max(1, math.abs(endScaleIndex - startScaleIndex)) : 1
        int baselineTime = profileBaselineTime(profile, chartTimes, baselineIndex, attachRight)
        array<chart.point> points = array.new<chart.point>()
        bool runStarted = false
        bool runInsideValueArea = false
        for rowIndex = 0 to rowCount - 1
            bool insideValueArea = rowIndex >= valueAreaLowRow and rowIndex <= valueAreaHighRow
            float rowBottom = profile.priceLow + rowIndex * rowHeight
            float rowVolume = array.get(profile.rowVolumes, rowIndex)
            int outerTime = profileOuterTime(profile, chartTimes, baselineIndex, rangeSteps, rowVolume / profile.maxRowVolume, histogramWidthPercent, faceLeft, attachRight)
            if runStarted and insideValueArea != runInsideValueArea
                array.push(points, chart.point.from_time(baselineTime, rowBottom))
                if polylinesUsed < maxPolylinesAllowed
                    pushHistogramRun(points, runInsideValueArea ? color.new(color.rgb(187, 217, 251), 75) : color.new(color.rgb(184, 184, 184), 80))
                    polylinesUsed += 1
                points := array.new<chart.point>()
                runStarted := false
            if not runStarted
                runStarted := true
                runInsideValueArea := insideValueArea
                array.push(points, chart.point.from_time(baselineTime, rowBottom))
            array.push(points, chart.point.from_time(outerTime, rowBottom + rowHeight * 0.5))
            if rowIndex == rowCount - 1
                array.push(points, chart.point.from_time(baselineTime, rowBottom + rowHeight))
                if polylinesUsed < maxPolylinesAllowed
                    pushHistogramRun(points, runInsideValueArea ? color.new(color.rgb(187, 217, 251), 75) : color.new(color.rgb(184, 184, 184), 80))
                    polylinesUsed += 1
    polylinesUsed

renderLowVolumeZone(DeltaProfile profile, string sourceName, float price, float zoneLow, float zoneHigh, int levelEndTime, int levelRank, int sessionTradingDayKey, bool historical, string markerLabel, color markerColor, int markerSize, bool registrationOnly) =>
    color zoneColor = color.new(color.rgb(74, 74, 74), 95)
    bool markerDeferred = mitigatedZoneExtensionEnabled(sourceName)
    if registrationOnly
        if markerDeferred
            registerMitigatedZone(sourceName, profile.startTime, levelEndTime, price)
    else if markerDeferred
        array.push(pendingMitigatedZones, PendingMitigatedZone.new(price=price, zoneLow=zoneLow, zoneHigh=zoneHigh, profileStartTime=profile.startTime, leftTime=profile.endTime, eligibilityTime=levelEndTime, zoneColor=zoneColor, zoneBorderWidth=0, zoneBorderColor=markerColor, hasLine=false, lineColor=markerColor, lineWidth=LOW_VOLUME_LINE_WIDTH, lineStyle=STYLE_DOTTED, lineRank=levelRank, sourceName=sourceName, tradingDayKey=sessionTradingDayKey, historical=historical, direction=0, markerGlyph=LEVEL_MARKER_GLYPH, markerLabel=markerLabel, markerColor=markerColor, markerSize=markerSize))
    else
        renderZoneFill(profile.endTime, levelEndTime, zoneLow, zoneHigh, zoneColor, 0, markerColor)
    markerDeferred

renderLowVolumeStructures(DeltaProfile profile, string sourceName, string displayNameOverride, int levelEndTime, int sessionTradingDayKey, bool historical, bool registrationOnly) =>
    if showMinimumLvnTiers
        array<legilimensProfile.LowVolumeCandidate> candidates = legilimensProfile.selectLowVolumeCandidates(profileDataFromDeltaProfile(profile), visibleLvnTierCount)
        int candidateCount = array.size(candidates)
        if candidateCount > 0
            for candidateIndex = 0 to candidateCount - 1
                int structureRank = candidateIndex + 1
                int structureTier = 6 - structureRank
                legilimensProfile.LowVolumeCandidate selectedCandidate = array.get(candidates, candidateIndex)
                int levelRank = LOW_VOLUME_LEVEL_RANK - structureRank
                float labelPrice = selectedCandidate.isLvn ? (selectedCandidate.zoneLow + selectedCandidate.zoneHigh) * 0.5 : selectedCandidate.price
                int markerTime = levelMarkerTime(levelEndTime)
                string markerLabel = showDotLabels and structureRank == 1 ? profileSourceName(sourceName, displayNameOverride) : ""
                color markerColor = color.new(color.rgb(15, 15, 15), 75)
                int markerSize = tierMarkerSize(tierMarkerSizes, structureTier)
                bool markerDeferred = false
                if selectedCandidate.isLvn
                    markerDeferred := renderLowVolumeZone(profile, sourceName, labelPrice, selectedCandidate.zoneLow, selectedCandidate.zoneHigh, levelEndTime, levelRank, sessionTradingDayKey, historical, markerLabel, markerColor, markerSize, registrationOnly)
                else if not registrationOnly
                    queueRightLine(selectedCandidate.price, profile.endTime, levelEndTime, markerColor, LOW_VOLUME_LINE_WIDTH, STYLE_DOTTED, levelRank, sourceName, sessionTradingDayKey, historical, 0)
                if not registrationOnly and not markerDeferred
                    queueLevelMarker(labelPrice, markerTime, LEVEL_MARKER_GLYPH, markerLabel, markerColor, markerSize)

queueOutlierPeak(DeltaProfile profile, string sourceName, string displayNameOverride, int levelEndTime, int sessionTradingDayKey, bool historical, legilimensProfile.OutlierPeak peak, int markerTime) =>
    int fibLocationGrade = qualifyDeltaTiersByProfileFib ? deltaTierFibLocationGrade(peak.buySide, peak.price, profile.rangeLow, profile.rangeHigh) : FIB_LOCATION_UNKNOWN
    float fibMidpointPrice = qualifyDeltaTiersByProfileFib ? (profile.rangeLow + profile.rangeHigh) * FIB_LOCATION_MIDPOINT : na
    array.push(pendingOutlierLevels, PendingOutlierLevel.new(peak.price, peak.zoneLow, peak.zoneHigh, peak.delta, peak.strength, peak.buySide, profile.startTime, profile.endTime, levelEndTime, markerTime, sourceName, displayNameOverride, sessionTradingDayKey, historical, peak.firstRow, peak.lastRow, fibLocationGrade, fibMidpointPrice))

collectOutlierPeaks(DeltaProfile profile, array<float> strengths, string sourceName, string displayNameOverride, int levelEndTime, int sessionTradingDayKey, bool historical) =>
    int peaksFound = 0
    if showDeltaTiers
        int markerTime = levelMarkerTime(levelEndTime)
        array<legilimensProfile.OutlierPeak> peaks = legilimensProfile.collectOutlierPeaks(profileDataFromDeltaProfile(profile), strengths)
        peaksFound := array.size(peaks)
        if peaksFound > 0
            for peakIndex = 0 to peaksFound - 1
                queueOutlierPeak(profile, sourceName, displayNameOverride, levelEndTime, sessionTradingDayKey, historical, array.get(peaks, peakIndex), markerTime)
    peaksFound

rankPendingOutlierLevels(bool merge) =>
    array<RankedOutlierLevel> rankedLevels = array.new<RankedOutlierLevel>()
    array<legilimensProfile.RankedOutlierSelection> rankedSelections = array.new<legilimensProfile.RankedOutlierSelection>()
    int pendingCount = array.size(pendingOutlierLevels)
    if pendingCount > 0
        array<legilimensProfile.OutlierCandidate> candidates = array.new<legilimensProfile.OutlierCandidate>()
        for pendingIndex = 0 to pendingCount - 1
            PendingOutlierLevel pending = array.get(pendingOutlierLevels, pendingIndex)
            array.push(candidates, legilimensProfile.OutlierCandidate.new(pending.price, pending.zoneLow, pending.zoneHigh, pending.delta, pending.strength, pending.buySide, pending.sourceName, pending.tradingDayKey, pending.historical, pending.profileStartTime, pending.firstRow, pending.lastRow))
        rankedSelections := legilimensProfile.rankOutlierCandidates(candidates, merge, syminfo.mintick, mergeDistancePercent, visibleDeltaTierCount)
        int rankedCount = array.size(rankedSelections)
        if rankedCount > 0
            for rankedIndex = 0 to rankedCount - 1
                legilimensProfile.RankedOutlierSelection selection = array.get(rankedSelections, rankedIndex)
                int firstPendingIndex = array.get(selection.memberIndices, 0)
                PendingOutlierLevel firstPending = array.get(pendingOutlierLevels, firstPendingIndex)
                PendingOutlierLevel representativePending = array.get(pendingOutlierLevels, selection.representativeIndex)
                int lineStartTime = firstPending.lineStartTime
                int rightTime = firstPending.rightTime
                int memberCount = array.size(selection.memberIndices)
                if memberCount > 1
                    for memberIndex = 1 to memberCount - 1
                        PendingOutlierLevel member = array.get(pendingOutlierLevels, array.get(selection.memberIndices, memberIndex))
                        lineStartTime := math.max(lineStartTime, member.lineStartTime)
                        rightTime := math.max(rightTime, member.rightTime)
                array.push(rankedLevels, RankedOutlierLevel.new(selection.price, selection.zoneLow, selection.zoneHigh, selection.buySide, firstPending.profileStartTime, lineStartTime, rightTime, representativePending.markerTime, firstPending.sourceName, firstPending.displayNameOverride, firstPending.tradingDayKey, firstPending.historical, selection.firstRow, selection.lastRow, selection.strengthRank, representativePending.fibLocationGrade, representativePending.fibMidpointPrice))
        array.clear(pendingOutlierLevels)
    [rankedLevels, rankedSelections]

currentBarEndTime() =>
    na(time_close) ? timenow : time_close

selectedOutlierRowMask(DeltaProfile profile, array<float> strengths, array<legilimensProfile.RankedOutlierSelection> rankedSelections) =>
    bool enabled = selectedTierOutlierRowsOnly() and showDeltaTiers and deltaTierSideVisibility != OPTION_OFF
    legilimensProfile.selectedOutlierRowMask(profileDataFromDeltaProfile(profile), profile.startTime, strengths, rankedSelections, enabled, deltaTierSideVisible(true), deltaTierSideVisible(false))

renderRankedOutlierLevels(array<RankedOutlierLevel> rankedLevels, bool registrationOnly) =>
    int rankedCount = array.size(rankedLevels)
    if rankedCount > 0
        for rankedIndex = 0 to rankedCount - 1
            RankedOutlierLevel ranked = array.get(rankedLevels, rankedIndex)
            int tier = 6 - ranked.strengthRank
            DeltaTierAppearance tierAppearance = deltaTierAppearance(ranked.buySide, tier, ranked.sourceName)
            int levelRank = 2000 - ranked.strengthRank
            bool extendPriorityZone = extendsPriorityZoneUntilMitigated(ranked.sourceName, ranked.strengthRank)
            int direction = ranked.buySide ? 1 : -1
            string markerLabel = showDotLabels and ranked.strengthRank == 1 ? profileSourceName(ranked.sourceName, ranked.displayNameOverride) : ""
            int markerSize = tierMarkerSize(tierMarkerSizes, tier)
            bool borderedQualifiedFibLocation = qualifyDeltaTiersByProfileFib and ranked.fibLocationGrade == FIB_LOCATION_QUALIFIED and (ranked.buySide ? ranked.price < ranked.fibMidpointPrice : ranked.price > ranked.fibMidpointPrice)
            int fibZoneBorderWidth = qualifyDeltaTiersByProfileFib ? ranked.fibLocationGrade == FIB_LOCATION_VERY_STRONG ? 2 : ranked.fibLocationGrade == FIB_LOCATION_PREFERRED or borderedQualifiedFibLocation ? 1 : 0 : 0
            bool qualifiedFibLocation = qualifyDeltaTiersByProfileFib and ranked.fibLocationGrade >= FIB_LOCATION_QUALIFIED
            color zoneColor = qualifyDeltaTiersByProfileFib ? fibQualificationColor(appearanceZoneColor(tierAppearance), qualifiedFibLocation) : appearanceZoneColor(tierAppearance)
            color lineColor = qualifyDeltaTiersByProfileFib ? fibQualificationColor(appearanceLineColor(tierAppearance), qualifiedFibLocation) : appearanceLineColor(tierAppearance)
            color markerColor = qualifyDeltaTiersByProfileFib ? fibQualificationColor(appearanceTextColor(tierAppearance), qualifiedFibLocation) : appearanceTextColor(tierAppearance)
            string markerGlyph = qualifyDeltaTiersByProfileFib ? fibLocationMarkerGlyph(ranked.fibLocationGrade) : LEVEL_MARKER_GLYPH
            bool roleReversed = showZoneRoleReversal and roleReversalZoneIsReversed(ranked.sourceName, ranked.profileStartTime, ranked.price, direction)
            color zoneBorderColor = markerColor
            if roleReversed
                DeltaTierAppearance reversedRoleAppearance = deltaTierAppearance(not ranked.buySide, tier, ranked.sourceName)
                zoneBorderColor := appearanceTextColor(reversedRoleAppearance)
            int zoneBorderWidth = math.max(fibZoneBorderWidth, roleReversed ? 1 : 0)
            if deltaTierSideVisible(ranked.buySide)
                if registrationOnly
                    if extendPriorityZone
                        registerMitigatedZone(ranked.sourceName, ranked.profileStartTime, ranked.rightTime, ranked.price)
                    if roleReversalTrackingEnabled(ranked.sourceName)
                        registerRoleReversalZone(ranked.sourceName, ranked.profileStartTime, ranked.lineStartTime, ranked.rightTime, ranked.price, ranked.zoneLow, ranked.zoneHigh, direction, extendPriorityZone)
                else if extendPriorityZone
                    array.push(pendingMitigatedZones, PendingMitigatedZone.new(price=ranked.price, zoneLow=ranked.zoneLow, zoneHigh=ranked.zoneHigh, profileStartTime=ranked.profileStartTime, leftTime=ranked.lineStartTime, eligibilityTime=ranked.rightTime, zoneColor=zoneColor, zoneBorderWidth=zoneBorderWidth, zoneBorderColor=zoneBorderColor, hasLine=appearanceHasLine(tierAppearance), lineColor=lineColor, lineWidth=appearanceLineWidth(tierAppearance), lineStyle=deltaTierLineStyle(tierAppearance), lineRank=levelRank, sourceName=ranked.sourceName, tradingDayKey=ranked.tradingDayKey, historical=ranked.historical, direction=direction, markerGlyph=markerGlyph, markerLabel=markerLabel, markerColor=markerColor, markerSize=markerSize))
                else
                    renderZoneFill(ranked.lineStartTime, ranked.rightTime, ranked.zoneLow, ranked.zoneHigh, zoneColor, zoneBorderWidth, zoneBorderColor)
                    if appearanceHasLine(tierAppearance)
                        queueRightLine(ranked.price, ranked.lineStartTime, ranked.rightTime, lineColor, appearanceLineWidth(tierAppearance), deltaTierLineStyle(tierAppearance), levelRank, ranked.sourceName, ranked.tradingDayKey, ranked.historical, direction)
                    queueLevelMarker(ranked.price, ranked.markerTime, markerGlyph, markerLabel, markerColor, markerSize)

renderProfileBox(DeltaProfile profile, string sourceName) =>
    color innerColor = profileInnerColor(sourceName)
    if canDrawBox()
        array.push(drawnBoxes, box.new(left=profile.startTime, top=profile.rangeHigh, right=profile.endTime, bottom=profile.rangeLow, xloc=xloc.bar_time, border_color=innerColor, border_width=SESSION_OUTLINE_WIDTH, border_style=line.style_solid, bgcolor=color.new(color.white, 100)))

renderOuterSessionFrame(DeltaProfile profile, string sourceName, int levelEndTime) =>
    [rangeHighTitleY, rangeLowTitleY, titleClearance] = rangeTitleLayout(profile, profileRangeLabelSize(sourceName))
    color outerColor = profileOuterColor(sourceName)
    if canDrawBox()
        array.push(drawnBoxes, box.new(left=profile.startTime, top=rangeHighTitleY + titleClearance, right=levelEndTime, bottom=rangeLowTitleY - titleClearance, xloc=xloc.bar_time, border_color=outerColor, border_width=1, border_style=line.style_solid, bgcolor=color.new(outerColor, 100)))

renderReferenceLevel(DeltaProfile profile, string sourceName, string displayNameOverride, int levelEndTime, float price, string levelName, color lineColor, bool twentyFourSeven) =>
    string labelText = profileDisplayName(sourceName, displayNameOverride, twentyFourSeven) + " " + levelName
    bool pocLevel = levelName == LEVEL_POC
    string lineStyle = pocLevel ? STYLE_DASHED : STYLE_SOLID
    int effectiveWidth = pocLevel ? POC_LEVEL_WIDTH : VALUE_AREA_LEVEL_WIDTH
    if canDrawLine()
        array.push(drawnLines, line.new(profile.startTime, price, levelEndTime, price, xloc=xloc.bar_time, color=lineColor, style=toLineStyle(lineStyle), width=effectiveWidth))
    if pocLevel and canDrawLabel()
        array.push(drawnLabels, label.new(levelEndTime + pocLabelOffsetMs(), price, labelText, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, textcolor=color.rgb(49, 27, 146), size=POC_LABEL_SIZE, color=color.new(color.white, 100)))

renderProfileLevels(DeltaProfile profile, string sourceName, string displayNameOverride, int levelEndTime, float pocPrice, float valueAreaLowPrice, float valueAreaHighPrice, bool twentyFourSeven) =>
    if showValueAreaLevels
        color valueAreaColor = profileValueAreaLevelColor(sourceName)
        renderReferenceLevel(profile, sourceName, displayNameOverride, levelEndTime, valueAreaHighPrice, LEVEL_VAH, valueAreaColor, twentyFourSeven)
        renderReferenceLevel(profile, sourceName, displayNameOverride, levelEndTime, valueAreaLowPrice, LEVEL_VAL, valueAreaColor, twentyFourSeven)
    if showPocLevel
        renderReferenceLevel(profile, sourceName, displayNameOverride, levelEndTime, pocPrice, LEVEL_POC, color.rgb(49, 27, 146), twentyFourSeven)

renderProfileMidpointLine(DeltaProfile profile, int levelEndTime) =>
    if showProfileMidpointLine and canDrawLine()
        float midpointPrice = (profile.rangeLow + profile.rangeHigh) * FIB_LOCATION_MIDPOINT
        array.push(drawnLines, line.new(profile.endTime, midpointPrice, levelEndTime, midpointPrice, xloc=xloc.bar_time, color=color.new(#2962ff, 70), style=line.style_solid, width=2))

renderRangeLabels(DeltaProfile profile, string sourceName, string displayNameOverride, bool pairedNyHeadings, array<int> chartTimes, int startScaleIndex, int endScaleIndex, bool twentyFourSeven) =>
    string labelSize = profileRangeLabelSize(sourceName)
    color labelColor = profileRangeLabelColor(sourceName)
    int headingTime = rangeHeadingTime(profile, chartTimes, startScaleIndex, endScaleIndex, profileHeadingOffsetBars(sourceName, pairedNyHeadings))
    [rangeHighTitleY, rangeLowTitleY, _] = rangeTitleLayout(profile, labelSize)
    string rangeLabel = profileDisplayName(sourceName, displayNameOverride, twentyFourSeven)
    color labelBackgroundColor = profileTextBackgroundColor(sourceName)
    bool fixedSource = sourceName == SOURCE_FIXED
    if fixedSource and canDrawLabel()
        array.push(drawnLabels, label.new(profile.startTime, rangeHighTitleY, "Fixed Start", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelColor, size=toLabelSize(labelSize), color=labelBackgroundColor))
    if fixedSource and canDrawLabel()
        array.push(drawnLabels, label.new(profile.endTime, rangeHighTitleY, "Fixed End", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelColor, size=toLabelSize(labelSize), color=labelBackgroundColor))
    if canDrawLabel()
        array.push(drawnLabels, label.new(headingTime, rangeHighTitleY, rangeLabel, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelColor, size=toLabelSize(labelSize), color=labelBackgroundColor))
    if canDrawLabel()
        array.push(drawnLabels, label.new(headingTime, rangeLowTitleY, rangeLabel, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, textcolor=labelColor, size=toLabelSize(labelSize), color=labelBackgroundColor))

selectSessionProfiles(int historyCount, bool currentPeriodActive, bool showDevelopingProfile, legilimensOrchestration.AnchorState state, legilimensProfile.SampleBatch currentSamples, bool includeCurrentSamples, int developingEndTime) =>
    legilimensOrchestration.selectProfiles(historyCount, currentPeriodActive, not showDevelopingProfile, state, currentSamples, includeCurrentSamples, developingEndTime, PROFILE_ROWS, syminfo.mintick)

profileRenderDecision(legilimensOrchestration.Profile profile, string sourceName, legilimensOrchestration.ProfileSelection comparisonSelection, bool hideDevelopingExtendedCounterpart, int currentNyEarlyStartTime) =>
    legilimensOrchestration.RenderDecision decision = legilimensOrchestration.renderDecision(profile, sourceName, comparisonSelection, SOURCE_NY_EARLY, SOURCE_EXTENDED_NY_EARLY, NY_EARLY_END_MINUTE, extendedNyEarlyModeActive, DISPLAY_NY_EARLY_PLUS, syminfo.mintick)
    bool currentExtendedCounterpartHidden = sourceName == SOURCE_NY_EARLY and hideDevelopingExtendedCounterpart and profile.startTime == currentNyEarlyStartTime
    string displayNameOverride = currentExtendedCounterpartHidden ? "" : decision.displayNameOverride
    bool pairedHeadings = currentExtendedCounterpartHidden ? false : decision.pairedHeadings
    [decision.shouldRender, displayNameOverride, pairedHeadings]

renderableProfileCount(legilimensOrchestration.ProfileSelection selection, string sourceName, legilimensOrchestration.ProfileSelection comparisonSelection) =>
    legilimensOrchestration.renderableProfileCount(selection, sourceName, comparisonSelection, SOURCE_NY_EARLY, SOURCE_EXTENDED_NY_EARLY, NY_EARLY_END_MINUTE, extendedNyEarlyModeActive, DISPLAY_NY_EARLY_PLUS, syminfo.mintick)

renderableContentProfileCount(legilimensOrchestration.ProfileSelection selection, string sourceName, legilimensOrchestration.ProfileSelection comparisonSelection, bool hideDevelopingExtendedCounterpart, int currentNyEarlyStartTime) =>
    int count = renderableProfileCount(selection, sourceName, comparisonSelection)
    if count > 0 and selection.currentDeveloping and developingVisibilityControlled(sourceName) and not developingContentVisible(sourceName) and selection.currentIndex >= 0
        legilimensOrchestration.Profile currentProfile = array.get(selection.profiles, selection.currentIndex)
        [shouldRender, _, _] = profileRenderDecision(currentProfile, sourceName, comparisonSelection, hideDevelopingExtendedCounterpart, currentNyEarlyStartTime)
        if shouldRender
            count -= 1
    count

trimProfileSelectionsToCapacity(array<legilimensOrchestration.ProfileSelection> selections, array<string> sourceNames, int profileCapacity) =>
    legilimensOrchestration.trimProfileSelectionsToCapacity(selections, sourceNames, profileCapacity, SOURCE_NY_EARLY, SOURCE_EXTENDED_NY_EARLY, NY_EARLY_END_MINUTE, extendedNyEarlyModeActive, DISPLAY_NY_EARLY_PLUS, syminfo.mintick)

registerProfileZoneStates(DeltaProfile profile, string sourceName, bool twentyFourSeven) =>
    if profileZoneTrackingEnabled(sourceName)
        int sessionCloseTime = sessionOccurrenceClose(sourceName, profile, twentyFourSeven, false)
        int levelEndTime = sessionLevelEndpoint(sourceName, sessionCloseTime, syminfo.type == "futures")
        int sessionTradingDayKey = tradingDayKey(sessionCloseTime)
        if mitigatedZoneExtensionEnabled(sourceName)
            renderLowVolumeStructures(profile, sourceName, "", levelEndTime, sessionTradingDayKey, true, true)
        array<float> strengths = computeRowStrengths(profile)
        collectOutlierPeaks(profile, strengths, sourceName, "", levelEndTime, sessionTradingDayKey, true)
        [rankedOutlierLevels, _] = rankPendingOutlierLevels(mergeOverlaps)
        renderRankedOutlierLevels(rankedOutlierLevels, true)

registerFinalizedAnchorZones(legilimensOrchestration.AnchorState state, string sourceName, bool twentyFourSeven) =>
    int finalizedCount = legilimensOrchestration.finalizedProfileCount(state)
    if finalizedCount > 0
        if profileZoneTrackingEnabled(sourceName)
            for finalizedIndex = 0 to finalizedCount - 1
                DeltaProfile profile = deltaProfileFromOrchestration(legilimensOrchestration.finalizedProfileAt(state, finalizedIndex))
                registerProfileZoneStates(profile, sourceName, twentyFourSeven)
        legilimensOrchestration.clearFinalizedProfiles(state)

renderSelectedProfile(DeltaProfile profile, string sourceName, string displayNameOverride, bool pairedNyHeadings, bool historical, bool developing, bool twentyFourSeven, array<int> chartTimes, bool renderBudgetedHistogram, int histogramLayersPerProfile) =>
    int startScaleIndex = nearestChartTimeIndex(chartTimes, profile.startTime)
    int endScaleIndex = nearestChartTimeIndex(chartTimes, profile.endTime)
    int sessionCloseTime = sessionOccurrenceClose(sourceName, profile, twentyFourSeven, developing)
    int levelEndTime = sessionLevelEndpoint(sourceName, sessionCloseTime, syminfo.type == "futures")
    int sessionTradingDayKey = tradingDayKey(sessionCloseTime)

    if not developing or not developingVisibilityControlled(sourceName)
        renderOuterSessionFrame(profile, sourceName, levelEndTime)
    renderRangeLabels(profile, sourceName, displayNameOverride, pairedNyHeadings, chartTimes, startScaleIndex, endScaleIndex, twentyFourSeven)
    renderProfileBox(profile, sourceName)

    if not developing or not developingVisibilityControlled(sourceName) or developingContentVisible(sourceName)
        [_, valueAreaLowRow, valueAreaHighRow, pocPrice, valueAreaLowPrice, valueAreaHighPrice] = profileValueLevels(profile)
        if renderBudgetedHistogram
            renderHistogram(profile, valueAreaLowRow, valueAreaHighRow, histogramLayersPerProfile, chartTimes, startScaleIndex, endScaleIndex)
        renderProfileMidpointLine(profile, levelEndTime)

        array<float> strengths = computeRowStrengths(profile)
        collectOutlierPeaks(profile, strengths, sourceName, displayNameOverride, levelEndTime, sessionTradingDayKey, historical)
        [rankedOutlierLevels, rankedOutlierSelections] = rankPendingOutlierLevels(mergeOverlaps)
        array<bool> selectedOutlierRows = selectedOutlierRowMask(profile, strengths, rankedOutlierSelections)
        renderDeltaPolylines(profile, sourceName, strengths, selectedOutlierRows, chartTimes, startScaleIndex, endScaleIndex)
        renderProfileLevels(profile, sourceName, displayNameOverride, levelEndTime, pocPrice, valueAreaLowPrice, valueAreaHighPrice, twentyFourSeven)
        renderLowVolumeStructures(profile, sourceName, displayNameOverride, levelEndTime, sessionTradingDayKey, historical, false)
        renderRankedOutlierLevels(rankedOutlierLevels, false)

renderProfileSelection(legilimensOrchestration.ProfileSelection selection, string sourceName, legilimensOrchestration.ProfileSelection comparisonSelection, bool hideDevelopingExtendedCounterpart, int currentNyEarlyStartTime, bool twentyFourSeven, array<int> chartTimes, bool currentPass, bool renderBudgetedHistograms, int histogramLayersPerProfile) =>
    int selectedCount = array.size(selection.profiles)
    if selectedCount > 0
        for selectedIndex = 0 to selectedCount - 1
            bool currentProfile = selectedIndex == selection.currentIndex
            if currentProfile == currentPass
                legilimensOrchestration.Profile selectedProfile = array.get(selection.profiles, selectedIndex)
                [shouldRender, displayNameOverride, pairedNyHeadings] = profileRenderDecision(selectedProfile, sourceName, comparisonSelection, hideDevelopingExtendedCounterpart, currentNyEarlyStartTime)
                if shouldRender
                    bool developing = currentProfile and selection.currentDeveloping
                    DeltaProfile profile = deltaProfileFromOrchestration(selectedProfile)
                    renderSelectedProfile(profile, sourceName, displayNameOverride, pairedNyHeadings, not currentProfile, developing, twentyFourSeven, chartTimes, renderBudgetedHistograms, histogramLayersPerProfile)

// ═══════════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE
// ═══════════════════════════════════════════════════════════════════════════════
addColorRow(array<ColorRow> rows, string name, color swatchColor, string widthText) =>
    array.push(rows, ColorRow.new(name, swatchColor, widthText))

writeColorRow(table referenceTable, int row, ColorRow entry) =>
    string rgbText = str.format("R:{0} G:{1} B:{2}", int(color.r(entry.swatchColor)), int(color.g(entry.swatchColor)), int(color.b(entry.swatchColor)))
    string transparencyText = str.tostring(int(color.t(entry.swatchColor)))
    table.cell(referenceTable, 0, row, entry.name, text_size=size.small, text_color=color.rgb(0, 0, 0))
    table.cell(referenceTable, 1, row, rgbText, text_size=size.small, text_color=color.rgb(0, 0, 0))
    table.cell(referenceTable, 2, row, transparencyText, text_size=size.small, text_color=color.rgb(0, 0, 0))
    table.cell(referenceTable, 3, row, entry.widthText, text_size=size.small, text_color=color.rgb(0, 0, 0))

// ═══════════════════════════════════════════════════════════════════════════════
// DATA REQUESTS & SAMPLE ROUTING
// ═══════════════════════════════════════════════════════════════════════════════
string intrabarTimeframe = autoIntrabarTimeframe()
string intrabarTickerId = chart.is_range ? ticker.new(syminfo.prefix, syminfo.ticker, syminfo.session) : syminfo.tickerid
[intrabarTimes, intrabarEndTimes, intrabarOpens, intrabarHighs, intrabarLows, intrabarCloses, intrabarVolumes] = request.security_lower_tf(intrabarTickerId, intrabarTimeframe, [time, time_close, open, high, low, close, volume], ignore_invalid_timeframe=true)

zoneBoundarySamples(string requestedTimeframe) =>
    request.security_lower_tf(intrabarTickerId, requestedTimeframe, [time, time_close, open, high, low, close], ignore_invalid_timeframe=true)

if barstate.islastconfirmedhistory and ((extendUnmitigated and unmitigatedProfileSelected) or showZoneRoleReversal)
    if intrabarTimeframe != INTRABAR_TIMEFRAME_ONE_SECOND and intrabarTimeframe != INTRABAR_TIMEFRAME_ONE_MINUTE
        [_, _, _, _, _, _] = zoneBoundarySamples(INTRABAR_TIMEFRAME_ONE_MINUTE)
    if intrabarTimeframe != INTRABAR_TIMEFRAME_ONE_SECOND
        [_, _, _, _, _, _] = zoneBoundarySamples(INTRABAR_TIMEFRAME_ONE_SECOND)

mitigatedZoneEndTime(string sourceName, int profileStartTime, float price, int eligibilityTime) =>
    int zoneEndTime = na
    int stateIndex = mitigatedZoneStateIndex(sourceName, profileStartTime, eligibilityTime, price)
    if stateIndex >= 0
        MitigatedZoneState state = array.get(mitigatedZoneStates, stateIndex)
        zoneEndTime := state.available ? (na(state.mitigatedTime) ? math.max(eligibilityTime, currentBarEndTime()) : state.mitigatedTime) : eligibilityTime
    else
        zoneEndTime := eligibilityTime
    zoneEndTime

advanceRoleReversalState(RoleReversalZoneState state, float sampleOpen, float sampleHigh, float sampleLow, float sampleClose) =>
    if not state.reversed and not na(sampleOpen) and not na(sampleHigh) and not na(sampleLow) and not na(sampleClose)
        bool originalSideObserved = state.originalDirection < 0 ? sampleOpen <= state.zoneLow or sampleClose <= state.zoneLow : sampleOpen >= state.zoneHigh or sampleClose >= state.zoneHigh
        state.armed := state.armed or originalSideObserved
        bool zoneTouched = sampleHigh >= state.zoneLow and sampleLow <= state.zoneHigh
        state.interacted := state.interacted or (state.armed and zoneTouched)
        bool sellZoneBrokenAbove = state.originalDirection < 0 and sampleClose > state.zoneHigh
        bool buyZoneBrokenBelow = state.originalDirection > 0 and sampleClose < state.zoneLow
        state.reversed := state.interacted and (sellZoneBrokenAbove or buyZoneBrokenBelow)
    state

advanceRoleReversalFromSamples(RoleReversalZoneState state, array<int> sampleTimes, array<int> sampleEndTimes, array<float> sampleOpens, array<float> sampleHighs, array<float> sampleLows, array<float> sampleCloses, int activeEndTime) =>
    int sampleCount = math.min(math.min(math.min(array.size(sampleTimes), array.size(sampleEndTimes)), math.min(array.size(sampleOpens), array.size(sampleHighs))), math.min(array.size(sampleLows), array.size(sampleCloses)))
    if sampleCount > 0
        for sampleIndex = 0 to sampleCount - 1
            int sampleTime = array.get(sampleTimes, sampleIndex)
            int sampleEndTime = array.get(sampleEndTimes, sampleIndex)
            bool activeSample = sampleTime >= state.eligibilityTime and sampleEndTime <= activeEndTime
            if activeSample
                advanceRoleReversalState(state, array.get(sampleOpens, sampleIndex), array.get(sampleHighs, sampleIndex), array.get(sampleLows, sampleIndex), array.get(sampleCloses, sampleIndex))
    state

firstIntrabarTouchEnd(array<int> sampleTimes, array<int> sampleEndTimes, array<float> sampleHighs, array<float> sampleLows, int eligibilityTime, float price, string windowMode, bool twentyFourSeven) =>
    int touchEndTime = na
    int sampleCount = math.min(math.min(array.size(sampleTimes), array.size(sampleEndTimes)), math.min(array.size(sampleHighs), array.size(sampleLows)))
    if sampleCount > 0
        for sampleIndex = 0 to sampleCount - 1
            int sampleTime = array.get(sampleTimes, sampleIndex)
            int sampleEndTime = array.get(sampleEndTimes, sampleIndex)
            float sampleHigh = array.get(sampleHighs, sampleIndex)
            float sampleLow = array.get(sampleLows, sampleIndex)
            bool eligibleSample = sampleTime >= eligibilityTime and sampleEndTime > eligibilityTime and mitigationWindowAllowsSample(windowMode, sampleTime, sampleEndTime, twentyFourSeven)
            if na(touchEndTime) and eligibleSample and not na(sampleHigh) and not na(sampleLow) and sampleLow <= price and sampleHigh >= price
                touchEndTime := sampleEndTime
    touchEndTime

boundaryCoverageComplete(array<int> sampleTimes, array<int> sampleEndTimes, int eligibilityTime, int barEndTime) =>
    int firstEligibleTime = na
    int lastEligibleEndTime = na
    int sampleCount = math.min(array.size(sampleTimes), array.size(sampleEndTimes))
    if sampleCount > 0
        for sampleIndex = 0 to sampleCount - 1
            int sampleTime = array.get(sampleTimes, sampleIndex)
            int sampleEndTime = array.get(sampleEndTimes, sampleIndex)
            if sampleTime >= eligibilityTime and sampleEndTime > eligibilityTime
                firstEligibleTime := na(firstEligibleTime) ? sampleTime : math.min(firstEligibleTime, sampleTime)
                lastEligibleEndTime := na(lastEligibleEndTime) ? sampleEndTime : math.max(lastEligibleEndTime, sampleEndTime)
    not na(firstEligibleTime) and firstEligibleTime <= eligibilityTime and lastEligibleEndTime >= barEndTime

intrabarBoundaryIsPrecise(int boundaryTime) =>
    intrabarTimeframe == INTRABAR_TIMEFRAME_ONE_SECOND or (boundaryTime % MS_PER_MINUTE == 0 and intrabarTimeframe == INTRABAR_TIMEFRAME_ONE_MINUTE)

includeBoundaryRequest(string requestedTimeframe, int boundaryTime) =>
    boundaryTime % MS_PER_MINUTE == 0 and requestedTimeframe != INTRABAR_TIMEFRAME_ONE_SECOND ? INTRABAR_TIMEFRAME_ONE_MINUTE : INTRABAR_TIMEFRAME_ONE_SECOND

zoneBoundaryRequestTimeframe() =>
    string requestedTimeframe = ""
    int barEndTime = currentBarEndTime()
    int mitigatedStateCount = array.size(mitigatedZoneStates)
    if mitigatedStateCount > 0
        for stateIndex = 0 to mitigatedStateCount - 1
            MitigatedZoneState state = array.get(mitigatedZoneStates, stateIndex)
            bool chartBarTouches = not na(high) and not na(low) and low <= state.price and high >= state.price
            if state.available and na(state.mitigatedTime) and chartBarTouches and barEndTime > state.eligibilityTime
                array<int> activeWindowBounds = mitigationWindowBounds(unmitigatedWindow, math.max(time, state.eligibilityTime), barEndTime, isTwentyFourSevenAsset)
                int activeWindowStartTime = array.get(activeWindowBounds, MITIGATION_WINDOW_START_INDEX)
                int activeWindowEndTime = array.get(activeWindowBounds, MITIGATION_WINDOW_END_INDEX)
                if not na(activeWindowStartTime)
                    if activeWindowStartTime > time and not intrabarBoundaryIsPrecise(activeWindowStartTime)
                        requestedTimeframe := includeBoundaryRequest(requestedTimeframe, activeWindowStartTime)
                    if activeWindowEndTime < barEndTime and not intrabarBoundaryIsPrecise(activeWindowEndTime)
                        requestedTimeframe := includeBoundaryRequest(requestedTimeframe, activeWindowEndTime)
    int roleStateCount = array.size(roleReversalZoneStates)
    if showZoneRoleReversal and roleStateCount > 0
        for stateIndex = 0 to roleStateCount - 1
            RoleReversalZoneState state = array.get(roleReversalZoneStates, stateIndex)
            int activeEndTime = state.extendsUntilMitigated ? mitigatedZoneEndTime(state.sourceName, state.profileStartTime, state.price, state.expirationTime) : state.expirationTime
            bool activeWindowOverlapsBar = barEndTime > state.eligibilityTime and time < activeEndTime
            bool startBoundaryBar = time < state.eligibilityTime and barEndTime > state.eligibilityTime
            bool endBoundaryBar = time < activeEndTime and barEndTime > activeEndTime
            if not state.reversed and activeWindowOverlapsBar
                if startBoundaryBar and not intrabarBoundaryIsPrecise(state.eligibilityTime)
                    requestedTimeframe := includeBoundaryRequest(requestedTimeframe, state.eligibilityTime)
                if endBoundaryBar and not intrabarBoundaryIsPrecise(activeEndTime)
                    requestedTimeframe := includeBoundaryRequest(requestedTimeframe, activeEndTime)
    requestedTimeframe

updateRoleReversalZoneStates(array<int> boundaryTimes, array<int> boundaryEndTimes, array<float> boundaryOpens, array<float> boundaryHighs, array<float> boundaryLows, array<float> boundaryCloses) =>
    if showZoneRoleReversal and barstate.isconfirmed and not na(open) and not na(high) and not na(low) and not na(close)
        int barEndTime = currentBarEndTime()
        int stateCount = array.size(roleReversalZoneStates)
        if stateCount > 0
            for stateIndex = 0 to stateCount - 1
                RoleReversalZoneState state = array.get(roleReversalZoneStates, stateIndex)
                int activeEndTime = state.extendsUntilMitigated ? mitigatedZoneEndTime(state.sourceName, state.profileStartTime, state.price, state.expirationTime) : state.expirationTime
                bool activeWindowOverlapsBar = barEndTime > state.eligibilityTime and time < activeEndTime
                if not state.reversed and activeWindowOverlapsBar
                    bool startBoundaryBar = time < state.eligibilityTime and barEndTime > state.eligibilityTime
                    bool endBoundaryBar = time < activeEndTime and barEndTime > activeEndTime
                    if startBoundaryBar or endBoundaryBar
                        bool profileIntrabarsArePrecise = (not startBoundaryBar or intrabarBoundaryIsPrecise(state.eligibilityTime)) and (not endBoundaryBar or intrabarBoundaryIsPrecise(activeEndTime))
                        state := profileIntrabarsArePrecise ? advanceRoleReversalFromSamples(state, intrabarTimes, intrabarEndTimes, intrabarOpens, intrabarHighs, intrabarLows, intrabarCloses, activeEndTime) : advanceRoleReversalFromSamples(state, boundaryTimes, boundaryEndTimes, boundaryOpens, boundaryHighs, boundaryLows, boundaryCloses, activeEndTime)
                    else
                        state := advanceRoleReversalState(state, open, high, low, close)
                    array.set(roleReversalZoneStates, stateIndex, state)

updateMitigatedZoneStates(array<int> boundaryTimes, array<int> boundaryEndTimes, array<float> boundaryHighs, array<float> boundaryLows) =>
    int barEndTime = currentBarEndTime()
    int stateCount = array.size(mitigatedZoneStates)
    if stateCount > 0
        for stateIndex = 0 to stateCount - 1
            MitigatedZoneState state = array.get(mitigatedZoneStates, stateIndex)
            if state.available and na(state.mitigatedTime) and barEndTime > state.eligibilityTime
                float price = state.price
                bool chartBarTouches = not na(high) and not na(low) and low <= price and high >= price
                if chartBarTouches
                    array<int> activeWindowBounds = mitigationWindowBounds(unmitigatedWindow, math.max(time, state.eligibilityTime), barEndTime, isTwentyFourSevenAsset)
                    int activeWindowStartTime = array.get(activeWindowBounds, MITIGATION_WINDOW_START_INDEX)
                    int activeWindowEndTime = array.get(activeWindowBounds, MITIGATION_WINDOW_END_INDEX)
                    if not na(activeWindowStartTime)
                        bool useProfileIntrabars = (activeWindowStartTime == time or intrabarBoundaryIsPrecise(activeWindowStartTime)) and (activeWindowEndTime == barEndTime or intrabarBoundaryIsPrecise(activeWindowEndTime))
                        int intrabarTouchEnd = useProfileIntrabars ? firstIntrabarTouchEnd(intrabarTimes, intrabarEndTimes, intrabarHighs, intrabarLows, activeWindowStartTime, price, unmitigatedWindow, isTwentyFourSevenAsset) : firstIntrabarTouchEnd(boundaryTimes, boundaryEndTimes, boundaryHighs, boundaryLows, activeWindowStartTime, price, unmitigatedWindow, isTwentyFourSevenAsset)
                        bool wholeBarEligible = activeWindowStartTime == time and activeWindowEndTime == barEndTime and mitigationWindowAllowsSample(unmitigatedWindow, time, barEndTime, isTwentyFourSevenAsset)
                        if not na(intrabarTouchEnd)
                            state.mitigatedTime := intrabarTouchEnd
                        else if wholeBarEligible
                            state.mitigatedTime := barEndTime
                        else if barstate.isconfirmed
                            bool coverageComplete = useProfileIntrabars ? boundaryCoverageComplete(intrabarTimes, intrabarEndTimes, activeWindowStartTime, activeWindowEndTime) : boundaryCoverageComplete(boundaryTimes, boundaryEndTimes, activeWindowStartTime, activeWindowEndTime)
                            if not coverageComplete
                                state.available := false
                        array.set(mitigatedZoneStates, stateIndex, state)

flushPendingMitigatedZones() =>
    int pendingCount = array.size(pendingMitigatedZones)
    if pendingCount > 0
        for pendingIndex = 0 to pendingCount - 1
            PendingMitigatedZone pending = array.get(pendingMitigatedZones, pendingIndex)
            int rightTime = mitigatedZoneEndTime(pending.sourceName, pending.profileStartTime, pending.price, pending.eligibilityTime)
            if not na(rightTime)
                renderZoneFill(pending.leftTime, rightTime, pending.zoneLow, pending.zoneHigh, pending.zoneColor, pending.zoneBorderWidth, pending.zoneBorderColor)
                if pending.hasLine
                    queueRightLine(pending.price, pending.leftTime, rightTime, pending.lineColor, pending.lineWidth, pending.lineStyle, pending.lineRank, pending.sourceName, pending.tradingDayKey, pending.historical, pending.direction)
                queueLevelMarker(pending.price, levelMarkerTime(rightTime), pending.markerGlyph, pending.markerLabel, pending.markerColor, pending.markerSize)
        array.clear(pendingMitigatedZones)

// Resolve known market types immediately; scan weekend bars only for ambiguous types.
bool isKnown247Asset = syminfo.type == "crypto"
bool isKnownTraditionalAsset = syminfo.type == "futures" or syminfo.type == "forex" or syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "dr" or syminfo.type == "index" or syminfo.type == "option" or syminfo.type == "commodity" or syminfo.type == "bond" or syminfo.type == "spread"
if not assetClassificationReady
    if isKnown247Asset or isKnownTraditionalAsset
        isTwentyFourSevenAsset := isKnown247Asset
        assetClassificationReady := true
    else if isTrueWeekendBar(time)
        isTwentyFourSevenAsset := true
        assetClassificationReady := true
    else
        int barsInWeek = math.max(1, int(math.ceil(SECONDS_PER_WEEK / timeframe.in_seconds(timeframe.period))))
        int observationWindow = math.min(ASSET_DETECTION_MAX_LOOKBACK, barsInWeek)
        if bar_index >= observationWindow
            isTwentyFourSevenAsset := false
            assetClassificationReady := true

rthInSessionWeekday = not na(time(timeframe.period, RTH_SESSION, NY_TIMEZONE))
rthInSessionAllDays = not na(time(timeframe.period, RTH_SESSION_ALL_DAYS, NY_TIMEZONE))
rthInSession = isTwentyFourSevenAsset ? rthInSessionAllDays : rthInSessionWeekday
rthSessionStart = rthInSession and not rthInSession[1]
rthSessionEnd = not rthInSession and rthInSession[1]

utcDayStart = calendarDayStart(UTC_TIMEZONE)
futuresGlobexStart = shiftedCalendarDayStart(NY_TIMEZONE, GLOBEX_REOPEN_SHIFT_MS)
globexDayStart = isTwentyFourSevenAsset ? utcDayStart : futuresGlobexStart
weeklyPeriodStart = weeklyBoundary(isTwentyFourSevenAsset, utcDayStart, futuresGlobexStart, time)
utcMonthStart = shiftedCalendarMonthStart(UTC_TIMEZONE, 0)
futuresMonthStart = shiftedCalendarMonthStart(NY_TIMEZONE, GLOBEX_REOPEN_SHIFT_MS)
monthlyPeriodStart = isTwentyFourSevenAsset ? utcMonthStart : futuresMonthStart

fixedRangeStart = math.min(fixedRangeStartInput, fixedRangeEndInput)
fixedRangeEnd = math.max(fixedRangeStartInput, fixedRangeEndInput)
rollingRangeEnd = rollingThroughTime(last_bar_time, rollingWindowThrough, isTwentyFourSevenAsset)
rollingRangeStart = lookbackDaysStart(rollingRangeEnd, rollingWindowLookbackDays, isTwentyFourSevenAsset)
rollingPeriodOldestStart = lookbackDaysStart(rollingRangeEnd, rollingWindowLookbackDays * (rollingPeriodHistoryCount + 1), isTwentyFourSevenAsset)
legilimensProfile.RollingProfileWindow rollingProfileWindow = legilimensProfile.RollingProfileWindow.new(rollingRangeStart, rollingRangeEnd, rollingWindowThrough == ROLLING_THROUGH_LIVE, rollingUsesClockCutoff(rollingWindowThrough))

array<int> barSampleStartTimes = array.new<int>()
array<int> barSampleEndTimes = array.new<int>()
array<float> barSampleHighs = array.new<float>()
array<float> barSampleLows = array.new<float>()
array<float> barSampleVolumes = array.new<float>()
array<float> barSampleDeltas = array.new<float>()
legilimensProfile.SampleBatch barSamples = legilimensProfile.SampleBatch.new(barSampleStartTimes, barSampleEndTimes, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas)
array<int> boundedSampleStartTimes = array.new<int>()
array<int> boundedSampleEndTimes = array.new<int>()
array<float> asiaPremarketSampleHighs = array.new<float>()
array<float> asiaPremarketSampleLows = array.new<float>()
array<float> asiaPremarketSampleVolumes = array.new<float>()
array<float> asiaPremarketSampleDeltas = array.new<float>()
array<int> asiaPremarketSampleSessionStarts = array.new<int>()
array<int> asiaPremarketSampleEndTimes = array.new<int>()
array<float> nyEarlySampleHighs = array.new<float>()
array<float> nyEarlySampleLows = array.new<float>()
array<float> nyEarlySampleVolumes = array.new<float>()
array<float> nyEarlySampleDeltas = array.new<float>()
array<float> extendedNyEarlySampleHighs = array.new<float>()
array<float> extendedNyEarlySampleLows = array.new<float>()
array<float> extendedNyEarlySampleVolumes = array.new<float>()
array<float> extendedNyEarlySampleDeltas = array.new<float>()
array<float> extendedOpeningSampleHighs = array.new<float>()
array<float> extendedOpeningSampleLows = array.new<float>()
array<float> extendedOpeningSampleVolumes = array.new<float>()
array<float> extendedOpeningSampleDeltas = array.new<float>()
array<float> ivbSampleHighs = array.new<float>()
array<float> ivbSampleLows = array.new<float>()
array<float> ivbSampleVolumes = array.new<float>()
array<float> ivbSampleDeltas = array.new<float>()
legilimensProfile.SampleBatch asiaPremarketSamples = legilimensProfile.SampleBatch.new(boundedSampleStartTimes, boundedSampleEndTimes, asiaPremarketSampleHighs, asiaPremarketSampleLows, asiaPremarketSampleVolumes, asiaPremarketSampleDeltas)
legilimensProfile.SampleBatch nyEarlySamples = legilimensProfile.SampleBatch.new(boundedSampleStartTimes, boundedSampleEndTimes, nyEarlySampleHighs, nyEarlySampleLows, nyEarlySampleVolumes, nyEarlySampleDeltas)
legilimensProfile.SampleBatch extendedNyEarlySamples = legilimensProfile.SampleBatch.new(boundedSampleStartTimes, boundedSampleEndTimes, extendedNyEarlySampleHighs, extendedNyEarlySampleLows, extendedNyEarlySampleVolumes, extendedNyEarlySampleDeltas)
legilimensProfile.SampleBatch ivbSamples = legilimensProfile.SampleBatch.new(boundedSampleStartTimes, boundedSampleEndTimes, ivbSampleHighs, ivbSampleLows, ivbSampleVolumes, ivbSampleDeltas)
int nyEarlyFirstSampleTime = na
int nyEarlyLastSampleEndTime = na
int extendedNyEarlyFirstSampleTime = na
int extendedNyEarlyLastSampleEndTime = na
int ivbFirstSampleTime = na
int ivbLastSampleEndTime = na
bool nyEarlyWindowObserved = false
bool extendedNyEarlyWindowObserved = false
bool extendedOpeningWindowObserved = false
bool ivbWindowObserved = false
bool boundedSessionSamplesRequired = asiaPremarketModeActive or nyEarlyModeActive or extendedNyEarlyModeActive or ivbModeActive
int subBarCount = array.size(intrabarVolumes)
if subBarCount > 0
    for subBarIndex = 0 to subBarCount - 1
        int subTime = array.get(intrabarTimes, subBarIndex)
        int subEndTime = array.get(intrabarEndTimes, subBarIndex)
        float subOpen = array.get(intrabarOpens, subBarIndex)
        float subHigh = array.get(intrabarHighs, subBarIndex)
        float subLow = array.get(intrabarLows, subBarIndex)
        float subClose = array.get(intrabarCloses, subBarIndex)
        float subVolume = array.get(intrabarVolumes, subBarIndex)
        int rangeSampleCutoffTime = na(time_close) ? timenow : time_close
        bool rangeIntrabarClosed = not na(subEndTime) and subEndTime <= rangeSampleCutoffTime
        bool rangeIntrabarUsable = rangeIntrabarClosed or not barstate.isconfirmed
        bool acceptRangeSample = not chart.is_range or (rangeIntrabarUsable and (na(lastAcceptedRangeIntrabarTime) or subTime > lastAcceptedRangeIntrabarTime))
        bool boundedDayAllowed = boundedSessionSamplesRequired and (isTwentyFourSevenAsset or isNyWeekday(subTime))
        bool asiaPremarketDayAllowed = asiaPremarketModeActive and (isTwentyFourSevenAsset or isNySessionTradingDay(subTime, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE))
        bool subInAsiaPremarket = asiaPremarketDayAllowed and inNyMinuteWindow(subTime, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE)
        bool subInNyEarly = nyEarlyModeActive and boundedDayAllowed and inNyMinuteWindow(subTime, NY_EARLY_START_MINUTE, NY_EARLY_END_MINUTE)
        bool subInExtendedNyEarly = extendedNyEarlyModeActive and boundedDayAllowed and inNyMinuteWindow(subTime, NY_EARLY_START_MINUTE, IVB_START_MINUTE)
        bool subInExtendedOpening = extendedNyEarlyModeActive and boundedDayAllowed and inNyMinuteWindow(subTime, IVB_START_MINUTE, EXTENDED_NY_EARLY_OPENING_END_MINUTE)
        bool subInIvb = ivbModeActive and boundedDayAllowed and inNyMinuteWindow(subTime, IVB_START_MINUTE, IVB_END_MINUTE)
        if subInNyEarly
            nyEarlyWindowObserved := true
            nyEarlyFirstSampleTime := na(nyEarlyFirstSampleTime) ? subTime : nyEarlyFirstSampleTime
            nyEarlyLastSampleEndTime := na(subEndTime) ? subTime : subEndTime
        if subInExtendedNyEarly
            extendedNyEarlyWindowObserved := true
            extendedNyEarlyFirstSampleTime := na(extendedNyEarlyFirstSampleTime) ? subTime : extendedNyEarlyFirstSampleTime
            extendedNyEarlyLastSampleEndTime := na(subEndTime) ? subTime : subEndTime
        if subInExtendedOpening
            extendedNyEarlyWindowObserved := true
            extendedOpeningWindowObserved := true
            extendedNyEarlyLastSampleEndTime := na(subEndTime) ? subTime : subEndTime
        if subInIvb
            ivbWindowObserved := true
            ivbFirstSampleTime := na(ivbFirstSampleTime) ? subTime : ivbFirstSampleTime
            ivbLastSampleEndTime := na(subEndTime) ? subTime : subEndTime
        if acceptRangeSample and not na(subVolume) and subVolume > 0 and not na(subHigh) and not na(subLow)
            int direction = na(subOpen) or na(subClose) ? lastTickDirection : subClose > subOpen ? 1 : subClose < subOpen ? -1 : not na(previousTapeClose) and subClose > previousTapeClose ? 1 : not na(previousTapeClose) and subClose < previousTapeClose ? -1 : lastTickDirection
            lastTickDirection := direction
            if not na(subClose)
                previousTapeClose := subClose
            if chart.is_range and rangeIntrabarClosed
                lastAcceptedRangeIntrabarTime := subTime
            float subDelta = subVolume * direction
            array.push(barSampleStartTimes, subTime)
            array.push(barSampleEndTimes, na(subEndTime) ? subTime + 1 : subEndTime)
            appendBarSample(barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, subHigh, subLow, subVolume, subDelta)
            if subInAsiaPremarket
                appendBarSample(asiaPremarketSampleHighs, asiaPremarketSampleLows, asiaPremarketSampleVolumes, asiaPremarketSampleDeltas, subHigh, subLow, subVolume, subDelta)
                array.push(asiaPremarketSampleSessionStarts, nySessionStartBoundary(subTime, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE))
                array.push(asiaPremarketSampleEndTimes, na(subEndTime) ? subTime : subEndTime)
            if subInNyEarly
                appendBarSample(nyEarlySampleHighs, nyEarlySampleLows, nyEarlySampleVolumes, nyEarlySampleDeltas, subHigh, subLow, subVolume, subDelta)
            if subInExtendedNyEarly
                appendBarSample(extendedNyEarlySampleHighs, extendedNyEarlySampleLows, extendedNyEarlySampleVolumes, extendedNyEarlySampleDeltas, subHigh, subLow, subVolume, subDelta)
            if subInExtendedOpening
                appendBarSample(extendedOpeningSampleHighs, extendedOpeningSampleLows, extendedOpeningSampleVolumes, extendedOpeningSampleDeltas, subHigh, subLow, subVolume, subDelta)
            if subInIvb
                appendBarSample(ivbSampleHighs, ivbSampleLows, ivbSampleVolumes, ivbSampleDeltas, subHigh, subLow, subVolume, subDelta)
bool fallbackBarValid = not na(volume) and volume > 0 and not na(high) and not na(low)
bool barSampleFallbackRequired = fallbackBarValid and array.size(barSampleVolumes) == 0
bool fallbackDayAllowed = boundedSessionSamplesRequired and (isTwentyFourSevenAsset or isNyWeekday(time))
bool asiaPremarketFallbackDayAllowed = isTwentyFourSevenAsset or isNySessionTradingDay(time, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE)
bool asiaPremarketSampleFallbackRequired = fallbackBarValid and asiaPremarketModeActive and array.size(asiaPremarketSampleVolumes) == 0 and asiaPremarketFallbackDayAllowed and barFitsNyMinuteWindow(time, time_close, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE)
bool nyEarlySampleFallbackRequired = fallbackBarValid and nyEarlyModeActive and array.size(nyEarlySampleVolumes) == 0 and fallbackDayAllowed and barFitsNyMinuteWindow(time, time_close, NY_EARLY_START_MINUTE, NY_EARLY_END_MINUTE)
bool extendedNyEarlySampleFallbackRequired = fallbackBarValid and extendedNyEarlyModeActive and array.size(extendedNyEarlySampleVolumes) == 0 and fallbackDayAllowed and barFitsNyMinuteWindow(time, time_close, NY_EARLY_START_MINUTE, IVB_START_MINUTE)
bool extendedOpeningSampleFallbackRequired = fallbackBarValid and extendedNyEarlyModeActive and array.size(extendedOpeningSampleVolumes) == 0 and fallbackDayAllowed and barFitsNyMinuteWindow(time, time_close, IVB_START_MINUTE, EXTENDED_NY_EARLY_OPENING_END_MINUTE)
bool ivbSampleFallbackRequired = fallbackBarValid and ivbModeActive and array.size(ivbSampleVolumes) == 0 and fallbackDayAllowed and barFitsNyMinuteWindow(time, time_close, IVB_START_MINUTE, IVB_END_MINUTE)
if barSampleFallbackRequired or asiaPremarketSampleFallbackRequired or nyEarlySampleFallbackRequired or extendedNyEarlySampleFallbackRequired or extendedOpeningSampleFallbackRequired or ivbSampleFallbackRequired
    int fallbackDirection = close > open ? 1 : close < open ? -1 : not na(previousTapeClose) and close > previousTapeClose ? 1 : not na(previousTapeClose) and close < previousTapeClose ? -1 : lastTickDirection
    float fallbackDelta = volume * fallbackDirection
    int fallbackEndTime = na(time_close) ? timenow : time_close
    if barSampleFallbackRequired
        lastTickDirection := fallbackDirection
        previousTapeClose := close
        array.push(barSampleStartTimes, time)
        array.push(barSampleEndTimes, math.max(time + 1, fallbackEndTime))
        appendBarSample(barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, high, low, volume, fallbackDelta)
    if asiaPremarketSampleFallbackRequired
        appendBarSample(asiaPremarketSampleHighs, asiaPremarketSampleLows, asiaPremarketSampleVolumes, asiaPremarketSampleDeltas, high, low, volume, fallbackDelta)
        array.push(asiaPremarketSampleSessionStarts, nySessionStartBoundary(time, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE))
        array.push(asiaPremarketSampleEndTimes, fallbackEndTime)
    if nyEarlySampleFallbackRequired
        appendBarSample(nyEarlySampleHighs, nyEarlySampleLows, nyEarlySampleVolumes, nyEarlySampleDeltas, high, low, volume, fallbackDelta)
        nyEarlyWindowObserved := true
        nyEarlyFirstSampleTime := time
        nyEarlyLastSampleEndTime := fallbackEndTime
    if extendedNyEarlySampleFallbackRequired
        appendBarSample(extendedNyEarlySampleHighs, extendedNyEarlySampleLows, extendedNyEarlySampleVolumes, extendedNyEarlySampleDeltas, high, low, volume, fallbackDelta)
        extendedNyEarlyWindowObserved := true
        extendedNyEarlyFirstSampleTime := time
        extendedNyEarlyLastSampleEndTime := fallbackEndTime
    if extendedOpeningSampleFallbackRequired
        appendBarSample(extendedOpeningSampleHighs, extendedOpeningSampleLows, extendedOpeningSampleVolumes, extendedOpeningSampleDeltas, high, low, volume, fallbackDelta)
        extendedNyEarlyWindowObserved := true
        extendedOpeningWindowObserved := true
        extendedNyEarlyLastSampleEndTime := fallbackEndTime
    if ivbSampleFallbackRequired
        appendBarSample(ivbSampleHighs, ivbSampleLows, ivbSampleVolumes, ivbSampleDeltas, high, low, volume, fallbackDelta)
        ivbWindowObserved := true
        ivbFirstSampleTime := time
        ivbLastSampleEndTime := fallbackEndTime

array<int> midnightSampleSessionStarts = array.new<int>()
int midnightSampleCount = array.size(barSampleStartTimes)
if midnightModeActive and midnightSampleCount > 0
    for sampleIndex = 0 to midnightSampleCount - 1
        array.push(midnightSampleSessionStarts, nySessionStartBoundary(array.get(barSampleStartTimes, sampleIndex), NY_MIDNIGHT_MINUTE, NY_MIDNIGHT_MINUTE))
int midnightCurrentSessionStart = midnightModeActive ? (midnightSampleCount > 0 ? array.get(midnightSampleSessionStarts, midnightSampleCount - 1) : nySessionStartBoundary(time, NY_MIDNIGHT_MINUTE, NY_MIDNIGHT_MINUTE)) : START_TIME_UNSET

int chartTimeframeSeconds = timeframe.in_seconds(timeframe.period)
bool openingChartBarContained = not na(chartTimeframeSeconds) and chartTimeframeSeconds <= EXTENDED_NY_EARLY_OPENING_DURATION_MINUTES * SECONDS_PER_MINUTE and inNyMinuteWindow(time, IVB_START_MINUTE, EXTENDED_NY_EARLY_OPENING_END_MINUTE) and time_close <= nyMinuteBoundary(time, EXTENDED_NY_EARLY_OPENING_END_MINUTE)
bool storedExtendedRangeReady = array.size(extendedNyEarlyAnchor.highs) > 0 and array.size(extendedNyEarlyAnchor.lows) > 0
bool currentExtendedRangeReady = array.size(extendedNyEarlySampleHighs) > 0 and array.size(extendedNyEarlySampleLows) > 0
bool extendedRangeReady = extendedOpeningWindowObserved and (storedExtendedRangeReady or currentExtendedRangeReady)
float storedExtendedRangeHigh = storedExtendedRangeReady ? array.max(extendedNyEarlyAnchor.highs) : na
float storedExtendedRangeLow = storedExtendedRangeReady ? array.min(extendedNyEarlyAnchor.lows) : na
float currentExtendedRangeHigh = currentExtendedRangeReady ? array.max(extendedNyEarlySampleHighs) : na
float currentExtendedRangeLow = currentExtendedRangeReady ? array.min(extendedNyEarlySampleLows) : na
float extendedRangeHigh = storedExtendedRangeReady and currentExtendedRangeReady ? math.max(storedExtendedRangeHigh, currentExtendedRangeHigh) : storedExtendedRangeReady ? storedExtendedRangeHigh : currentExtendedRangeHigh
float extendedRangeLow = storedExtendedRangeReady and currentExtendedRangeReady ? math.min(storedExtendedRangeLow, currentExtendedRangeLow) : storedExtendedRangeReady ? storedExtendedRangeLow : currentExtendedRangeLow
bool sampledOpeningBreak = extendedRangeReady and array.size(extendedOpeningSampleVolumes) > 0 and (array.max(extendedOpeningSampleHighs) > extendedRangeHigh or array.min(extendedOpeningSampleLows) < extendedRangeLow)
bool chartOpeningBreak = extendedRangeReady and openingChartBarContained and (high > extendedRangeHigh or low < extendedRangeLow)
bool extendedOpeningBreakThisBar = extendedOpeningWindowObserved and extendedRangeReady and (sampledOpeningBreak or chartOpeningBreak)
bool extendedOpeningQualifiedThisBar = extendedOpeningWindowObserved and (extendedOpeningQualified or extendedOpeningBreakThisBar)
if extendedOpeningQualifiedThisBar
    if not extendedOpeningQualified
        appendSamples(extendedNyEarlySampleHighs, extendedNyEarlySampleLows, extendedNyEarlySampleVolumes, extendedNyEarlySampleDeltas, extendedOpeningPendingHighs, extendedOpeningPendingLows, extendedOpeningPendingVolumes, extendedOpeningPendingDeltas, false)
    appendSamples(extendedNyEarlySampleHighs, extendedNyEarlySampleLows, extendedNyEarlySampleVolumes, extendedNyEarlySampleDeltas, extendedOpeningSampleHighs, extendedOpeningSampleLows, extendedOpeningSampleVolumes, extendedOpeningSampleDeltas, false)

int asiaPremarketEvaluationTime = str.contains(syminfo.tickerid, "replay") ? time : barstate.isrealtime ? timenow : na(time_close) ? time : time_close
bool asiaPremarketEvaluationDayAllowed = isTwentyFourSevenAsset or isNySessionTradingDay(asiaPremarketEvaluationTime, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE)
bool asiaPremarketEvaluationInSession = asiaPremarketModeActive and asiaPremarketEvaluationDayAllowed and inNyMinuteWindow(asiaPremarketEvaluationTime, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE)
bool asiaPremarketInSession = asiaPremarketEvaluationInSession
int asiaPremarketCurrentSessionStart = asiaPremarketInSession ? nySessionStartBoundary(asiaPremarketEvaluationTime, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE) : START_TIME_UNSET
nyEarlyInSession = nyEarlyWindowObserved
nyEarlySessionStart = nyEarlyInSession and not nyEarlyInSession[1]
nyEarlySessionEnd = not nyEarlyInSession and nyEarlyInSession[1]
extendedNyEarlyInSession = extendedNyEarlyWindowObserved
extendedNyEarlySessionStart = extendedNyEarlyInSession and not extendedNyEarlyInSession[1]
extendedNyEarlySessionEnd = not extendedNyEarlyInSession and extendedNyEarlyInSession[1]
ivbInSession = ivbWindowObserved
ivbSessionStart = ivbInSession and not ivbInSession[1]
ivbSessionEnd = not ivbInSession and ivbInSession[1]

// ═══════════════════════════════════════════════════════════════════════════════
// PROFILE LIFECYCLE EXECUTION
// ═══════════════════════════════════════════════════════════════════════════════
if extendedNyEarlySessionStart
    clearSamples(extendedOpeningPendingHighs, extendedOpeningPendingLows, extendedOpeningPendingVolumes, extendedOpeningPendingDeltas)
    extendedOpeningQualified := false

legilimensOrchestration.processAnchor(rthAnchor, rthModeActive, SESSION_PROFILE_RETENTION, rthInSession, rthSessionStart, rthSessionEnd, time, time[1], barstate.isconfirmed, barSamples, false, PROFILE_ROWS, syminfo.mintick)
legilimensOrchestration.processAnchor(globexAnchor, globexModeActive, SESSION_PROFILE_RETENTION, true, globexDayStart, false, time, time[1], barstate.isconfirmed, barSamples, false, PROFILE_ROWS, syminfo.mintick)
legilimensOrchestration.processKeyedBoundedNyAnchor(midnightAnchor, midnightModeActive, SESSION_PROFILE_RETENTION, NY_MIDNIGHT_MINUTE, NY_MIDNIGHT_MINUTE, true, midnightCurrentSessionStart, midnightSampleSessionStarts, barSampleEndTimes, barSamples, PROFILE_ROWS, syminfo.mintick)
legilimensOrchestration.processKeyedBoundedNyAnchor(asiaPremarketAnchor, asiaPremarketModeActive, SESSION_PROFILE_RETENTION, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE, asiaPremarketInSession, asiaPremarketCurrentSessionStart, asiaPremarketSampleSessionStarts, asiaPremarketSampleEndTimes, asiaPremarketSamples, PROFILE_ROWS, syminfo.mintick)
legilimensOrchestration.processBoundedNyAnchor(nyEarlyAnchor, nyEarlyModeActive, SESSION_PROFILE_RETENTION, NY_EARLY_START_MINUTE, NY_EARLY_END_MINUTE, nyEarlyInSession, nyEarlySessionStart, nyEarlySessionEnd, nyEarlyFirstSampleTime, nyEarlyLastSampleEndTime, barstate.isconfirmed, nyEarlySamples, PROFILE_ROWS, syminfo.mintick)
legilimensOrchestration.processBoundedNyAnchor(extendedNyEarlyAnchor, extendedNyEarlyModeActive, SESSION_PROFILE_RETENTION, NY_EARLY_START_MINUTE, extendedOpeningQualifiedThisBar ? EXTENDED_NY_EARLY_OPENING_END_MINUTE : IVB_START_MINUTE, extendedNyEarlyInSession, extendedNyEarlySessionStart, extendedNyEarlySessionEnd, extendedNyEarlyFirstSampleTime, extendedNyEarlyLastSampleEndTime, barstate.isconfirmed, extendedNyEarlySamples, PROFILE_ROWS, syminfo.mintick)
legilimensOrchestration.processBoundedNyAnchor(ivbAnchor, ivbModeActive, SESSION_PROFILE_RETENTION, IVB_START_MINUTE, IVB_END_MINUTE, ivbInSession, ivbSessionStart, ivbSessionEnd, ivbFirstSampleTime, ivbLastSampleEndTime, barstate.isconfirmed, ivbSamples, PROFILE_ROWS, syminfo.mintick)

if barstate.isconfirmed and extendedOpeningWindowObserved
    if extendedOpeningQualifiedThisBar
        clearSamples(extendedOpeningPendingHighs, extendedOpeningPendingLows, extendedOpeningPendingVolumes, extendedOpeningPendingDeltas)
        extendedOpeningQualified := true
    else
        appendSamples(extendedOpeningPendingHighs, extendedOpeningPendingLows, extendedOpeningPendingVolumes, extendedOpeningPendingDeltas, extendedOpeningSampleHighs, extendedOpeningSampleLows, extendedOpeningSampleVolumes, extendedOpeningSampleDeltas, false)
if extendedNyEarlySessionEnd
    clearSamples(extendedOpeningPendingHighs, extendedOpeningPendingLows, extendedOpeningPendingVolumes, extendedOpeningPendingDeltas)
    extendedOpeningQualified := false

legilimensOrchestration.processAnchor(weeklyAnchor, calendarWeeklyModeActive, SESSION_PROFILE_RETENTION, true, weeklyPeriodStart, false, time, time[1], barstate.isconfirmed, barSamples, true, PROFILE_ROWS, syminfo.mintick)
legilimensOrchestration.processAnchor(monthlyAnchor, calendarMonthlyModeActive, SESSION_PROFILE_RETENTION, true, monthlyPeriodStart, false, time, time[1], barstate.isconfirmed, barSamples, false, PROFILE_ROWS, syminfo.mintick)
int rollingPeriodBarEndTime = na(time_close) ? time : time_close
legilimensOrchestration.processRollingPeriodAnchor(rollingPeriodAnchor, rollingPeriodSelected, rollingWindowLookbackDays, rollingPeriodOldestStart, rollingRangeEnd, isTwentyFourSevenAsset, barstate.isconfirmed, rollingPeriodBarEndTime, barSamples, SESSION_PROFILE_RETENTION, PROFILE_ROWS, syminfo.mintick)

bool fixedRangeBarMayOverlap = fixedRangeEnabled and fixedRangeConfigured and time < fixedRangeEnd and (na(time_close) or time_close > fixedRangeStart)
bool rollingRangeConfigured = rollingWindowModeActive and not na(last_bar_time)
bool rollingBarRetained = rollingSelected and rollingRangeConfigured and (na(time_close) ? time >= rollingRangeStart : time_close > rollingRangeStart)
bool includeCurrentRollingSamples = not barstate.isconfirmed and rollingBarRetained
if rollingSelected
    legilimensProfile.pruneRollingSamples(rollingSamples, rollingRangeStart)
if barstate.isconfirmed
    if rollingBarRetained
        legilimensProfile.appendRollingSamples(rollingSamples, barSamples, rollingLookbackDays)
    if fixedRangeBarMayOverlap
        appendContainedSamples(fixedBarHighs, fixedBarLows, fixedBarVolumes, fixedBarDeltas, barSamples, fixedRangeStart, fixedRangeEnd, true)

registerFinalizedAnchorZones(rthAnchor, SOURCE_RTH, isTwentyFourSevenAsset)
registerFinalizedAnchorZones(globexAnchor, SOURCE_GLOBEX, isTwentyFourSevenAsset)
registerFinalizedAnchorZones(midnightAnchor, SOURCE_MIDNIGHT, isTwentyFourSevenAsset)
registerFinalizedAnchorZones(asiaPremarketAnchor, SOURCE_ASIA_PREMARKET, isTwentyFourSevenAsset)
registerFinalizedAnchorZones(nyEarlyAnchor, SOURCE_NY_EARLY, isTwentyFourSevenAsset)
registerFinalizedAnchorZones(extendedNyEarlyAnchor, SOURCE_EXTENDED_NY_EARLY, isTwentyFourSevenAsset)
registerFinalizedAnchorZones(ivbAnchor, SOURCE_IVB, isTwentyFourSevenAsset)
registerFinalizedAnchorZones(weeklyAnchor, SOURCE_WEEKLY, isTwentyFourSevenAsset)
registerFinalizedAnchorZones(monthlyAnchor, SOURCE_MONTHLY, isTwentyFourSevenAsset)
registerFinalizedAnchorZones(rollingPeriodAnchor, rollingPeriodSourceName, isTwentyFourSevenAsset)

int zoneTrackingEvaluationTime = currentBarEndTime()
if profileZoneTrackingEnabled(SOURCE_FIXED) and fixedRangeEnabled and fixedRangeConfigured and not fixedZoneTrackingProfileRegistered and zoneTrackingEvaluationTime >= fixedRangeEnd and array.size(fixedBarVolumes) > 0
    DeltaProfile completedFixedProfile = buildDeltaProfile(fixedBarHighs, fixedBarLows, fixedBarVolumes, fixedBarDeltas, PROFILE_ROWS, fixedRangeStart, fixedRangeEnd)
    if completedFixedProfile.isValid
        registerProfileZoneStates(completedFixedProfile, SOURCE_FIXED, isTwentyFourSevenAsset)
        fixedZoneTrackingProfileRegistered := true
bool rollingZoneTrackingProfileChanged = na(registeredRollingZoneTrackingEndTime) or registeredRollingZoneTrackingEndTime != rollingRangeEnd
bool rollingLiveZoneTrackingRefresh = rollingWindowThrough == ROLLING_THROUGH_LIVE and not barstate.isconfirmed
bool rollingZoneTrackingSamplesAvailable = legilimensProfile.rollingSampleStoreSize(rollingSamples) > 0 or (includeCurrentRollingSamples and array.size(barSampleVolumes) > 0)
if profileZoneTrackingEnabled(SOURCE_ROLLING) and rollingSelected and rollingRangeConfigured and (rollingZoneTrackingProfileChanged or rollingLiveZoneTrackingRefresh) and zoneTrackingEvaluationTime >= rollingRangeEnd and rollingZoneTrackingSamplesAvailable
    DeltaProfile completedRollingProfile = buildCurrentRollingDeltaProfile(rollingSamples, barSamples, includeCurrentRollingSamples, rollingProfileWindow, PROFILE_ROWS)
    if completedRollingProfile.isValid
        removeMitigatedSource(SOURCE_ROLLING)
        registerProfileZoneStates(completedRollingProfile, SOURCE_ROLLING, isTwentyFourSevenAsset)
        registeredRollingZoneTrackingEndTime := rollingRangeEnd

array<int> zoneBoundaryTimes = array.new<int>()
array<int> zoneBoundaryEndTimes = array.new<int>()
array<float> zoneBoundaryOpens = array.new<float>()
array<float> zoneBoundaryHighs = array.new<float>()
array<float> zoneBoundaryLows = array.new<float>()
array<float> zoneBoundaryCloses = array.new<float>()
string requestedZoneBoundaryTimeframe = zoneBoundaryRequestTimeframe()
if requestedZoneBoundaryTimeframe != ""
    [requestedBoundaryTimes, requestedBoundaryEndTimes, requestedBoundaryOpens, requestedBoundaryHighs, requestedBoundaryLows, requestedBoundaryCloses] = zoneBoundarySamples(requestedZoneBoundaryTimeframe)
    zoneBoundaryTimes := requestedBoundaryTimes
    zoneBoundaryEndTimes := requestedBoundaryEndTimes
    zoneBoundaryOpens := requestedBoundaryOpens
    zoneBoundaryHighs := requestedBoundaryHighs
    zoneBoundaryLows := requestedBoundaryLows
    zoneBoundaryCloses := requestedBoundaryCloses
updateMitigatedZoneStates(zoneBoundaryTimes, zoneBoundaryEndTimes, zoneBoundaryHighs, zoneBoundaryLows)
updateRoleReversalZoneStates(zoneBoundaryTimes, zoneBoundaryEndTimes, zoneBoundaryOpens, zoneBoundaryHighs, zoneBoundaryLows, zoneBoundaryCloses)

// ═══════════════════════════════════════════════════════════════════════════════
// CHART VISIBILITY
// ═══════════════════════════════════════════════════════════════════════════════
inVisibleOvernight = not na(time(timeframe.period, SESSION_WINDOW_OVERNIGHT, NY_TIMEZONE))
inVisibleFrom0500 = not na(time(timeframe.period, SESSION_WINDOW_FROM_0500, NY_TIMEZONE))
inVisibleFrom0830 = not na(time(timeframe.period, SESSION_WINDOW_FROM_0830, NY_TIMEZONE))
inVisibleRth = not na(time(timeframe.period, SESSION_WINDOW_RTH, NY_TIMEZONE))
inVisibleWindow = visibleWindow == WINDOW_LABEL_FROM_0500 ? inVisibleFrom0500 : visibleWindow == WINDOW_LABEL_FROM_0830 ? inVisibleFrom0830 : visibleWindow == WINDOW_LABEL_RTH ? inVisibleRth : inVisibleOvernight
inMostRecentDay = sameCalendarDate(time, timenow, NY_TIMEZONE)
showOnlyTimeframeAllowed = chart.is_range or timeframe.in_seconds(timeframe.period) <= SHOW_ONLY_MAX_TIMEFRAME_SECONDS
hideThisBar = showOnlyEnabled and showOnlyTimeframeAllowed and not (inVisibleWindow and (not showOnlyMostRecent or inMostRecentDay))

plotcandle(hideThisBar ? open : na, high, low, close, title="Hidden Candles", color=hiddenCandleColor, bordercolor=hiddenCandleColor, wickcolor=hiddenCandleColor, editable=false, display=display.pane, force_overlay=true)

// ═══════════════════════════════════════════════════════════════════════════════
// FINAL RENDER PASS
// ═══════════════════════════════════════════════════════════════════════════════
if barstate.islast
    clearDrawings()

    // Include the open bar once.
    DeltaProfile rollingProfile = na
    if rollingSelected and rollingRangeConfigured
        rollingProfile := buildCurrentRollingDeltaProfile(rollingSamples, barSamples, includeCurrentRollingSamples, rollingProfileWindow, PROFILE_ROWS)

    DeltaProfile fixedProfile = na
    if fixedRangeEnabled and fixedRangeConfigured
        int originalSize = array.size(fixedBarVolumes)
        if not barstate.isconfirmed and fixedRangeBarMayOverlap
            appendContainedSamples(fixedBarHighs, fixedBarLows, fixedBarVolumes, fixedBarDeltas, barSamples, fixedRangeStart, fixedRangeEnd, false)
        fixedProfile := buildDeltaProfile(fixedBarHighs, fixedBarLows, fixedBarVolumes, fixedBarDeltas, PROFILE_ROWS, fixedRangeStart, math.min(fixedRangeEnd, time))
        while array.size(fixedBarVolumes) > originalSize
            array.pop(fixedBarHighs)
            array.pop(fixedBarLows)
            array.pop(fixedBarVolumes)
            array.pop(fixedBarDeltas)

    // The keyed processor already includes current samples on this execution.
    array<float> keyedNoSampleHighs = array.new<float>()
    array<float> keyedNoSampleLows = array.new<float>()
    array<float> keyedNoSampleVolumes = array.new<float>()
    array<float> keyedNoSampleDeltas = array.new<float>()
    legilimensProfile.SampleBatch keyedNoSamples = legilimensProfile.SampleBatch.new(boundedSampleStartTimes, boundedSampleEndTimes, keyedNoSampleHighs, keyedNoSampleLows, keyedNoSampleVolumes, keyedNoSampleDeltas)
    int midnightStoredEndTime = midnightAnchor.lastBarTime
    int midnightDevelopingSampleEndTime = midnightStoredEndTime == START_TIME_UNSET ? time : midnightStoredEndTime
    int midnightDevelopingEndTime = midnightCurrentSessionStart == START_TIME_UNSET ? midnightDevelopingSampleEndTime : math.min(midnightDevelopingSampleEndTime, nySessionEndBoundary(midnightCurrentSessionStart, NY_MIDNIGHT_MINUTE, NY_MIDNIGHT_MINUTE))
    int asiaPremarketStoredEndTime = asiaPremarketAnchor.lastBarTime
    int asiaPremarketDevelopingSampleEndTime = asiaPremarketStoredEndTime == START_TIME_UNSET ? asiaPremarketEvaluationTime : asiaPremarketStoredEndTime
    int asiaPremarketDevelopingEndTime = asiaPremarketInSession ? math.min(asiaPremarketDevelopingSampleEndTime, nySessionEndBoundary(asiaPremarketCurrentSessionStart, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE)) : asiaPremarketStoredEndTime
    int nyEarlyDevelopingEndTime = nyEarlyInSession ? math.min(nyEarlyLastSampleEndTime, nyMinuteBoundary(nyEarlyAnchor.startTime, NY_EARLY_END_MINUTE)) : nyEarlyAnchor.lastBarTime
    int extendedNyEarlyDevelopingEndTime = extendedNyEarlyInSession ? (extendedOpeningQualifiedThisBar ? math.min(extendedNyEarlyLastSampleEndTime, nyMinuteBoundary(extendedNyEarlyAnchor.startTime, EXTENDED_NY_EARLY_OPENING_END_MINUTE)) : math.min(extendedNyEarlyLastSampleEndTime, nyMinuteBoundary(extendedNyEarlyAnchor.startTime, IVB_START_MINUTE))) : extendedNyEarlyAnchor.lastBarTime
    int ivbDevelopingEndTime = ivbInSession ? math.min(ivbLastSampleEndTime, nyMinuteBoundary(ivbAnchor.startTime, IVB_END_MINUTE)) : ivbAnchor.lastBarTime
    legilimensOrchestration.ProfileSelection selectedSessionProfiles = na
    legilimensOrchestration.ProfileSelection selectedNyEarlyProfiles = na
    legilimensOrchestration.ProfileSelection selectedExtendedNyEarlyProfiles = na
    legilimensOrchestration.ProfileSelection selectedIvbProfiles = na
    bool groupedNyProfilesActive = nyEarlyModeActive and extendedNyEarlyModeActive
    if groupedNyProfilesActive
        if nyEarlyModeActive
            selectedNyEarlyProfiles := selectSessionProfiles(priorProfilesToShow, nyEarlyInSession, developingProfileVisible(SOURCE_NY_EARLY), nyEarlyAnchor, nyEarlySamples, not barstate.isconfirmed, nyEarlyDevelopingEndTime)
        if extendedNyEarlyModeActive
            selectedExtendedNyEarlyProfiles := selectSessionProfiles(priorProfilesToShow, extendedNyEarlyInSession, developingProfileVisible(SOURCE_EXTENDED_NY_EARLY), extendedNyEarlyAnchor, extendedNyEarlySamples, not barstate.isconfirmed, extendedNyEarlyDevelopingEndTime)
        if ivbModeActive
            selectedIvbProfiles := selectSessionProfiles(priorProfilesToShow, ivbInSession, developingProfileVisible(SOURCE_IVB), ivbAnchor, ivbSamples, not barstate.isconfirmed, ivbDevelopingEndTime)
    else if rthModeActive
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, rthInSession, developingProfileVisible(SOURCE_RTH), rthAnchor, barSamples, not barstate.isconfirmed, time)
    else if globexModeActive
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, true, developingProfileVisible(SOURCE_GLOBEX), globexAnchor, barSamples, not barstate.isconfirmed, time)
    else if midnightModeActive
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, true, developingProfileVisible(SOURCE_MIDNIGHT), midnightAnchor, keyedNoSamples, false, midnightDevelopingEndTime)
    else if asiaPremarketModeActive
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, asiaPremarketInSession, developingProfileVisible(SOURCE_ASIA_PREMARKET), asiaPremarketAnchor, keyedNoSamples, false, asiaPremarketDevelopingEndTime)
    else if nyEarlyModeActive
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, nyEarlyInSession, developingProfileVisible(SOURCE_NY_EARLY), nyEarlyAnchor, nyEarlySamples, not barstate.isconfirmed, nyEarlyDevelopingEndTime)
    else if extendedNyEarlyModeActive
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, extendedNyEarlyInSession, developingProfileVisible(SOURCE_EXTENDED_NY_EARLY), extendedNyEarlyAnchor, extendedNyEarlySamples, not barstate.isconfirmed, extendedNyEarlyDevelopingEndTime)
    else if ivbModeActive
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, ivbInSession, developingProfileVisible(SOURCE_IVB), ivbAnchor, ivbSamples, not barstate.isconfirmed, ivbDevelopingEndTime)
    else if rollingPeriodSelected
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, false, true, rollingPeriodAnchor, barSamples, false, rollingRangeEnd)
    else if calendarWeeklyModeActive
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, true, true, weeklyAnchor, barSamples, not barstate.isconfirmed, time)
    else if calendarMonthlyModeActive
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, true, true, monthlyAnchor, barSamples, not barstate.isconfirmed, time)

    array<legilimensOrchestration.ProfileSelection> budgetedProfileSelections = array.new<legilimensOrchestration.ProfileSelection>()
    array<string> budgetedProfileSourceNames = array.new<string>()
    if groupedNyProfilesActive
        if not na(selectedExtendedNyEarlyProfiles)
            array.push(budgetedProfileSelections, selectedExtendedNyEarlyProfiles)
            array.push(budgetedProfileSourceNames, SOURCE_EXTENDED_NY_EARLY)
        if not na(selectedNyEarlyProfiles)
            array.push(budgetedProfileSelections, selectedNyEarlyProfiles)
            array.push(budgetedProfileSourceNames, SOURCE_NY_EARLY)
        if not na(selectedIvbProfiles)
            array.push(budgetedProfileSelections, selectedIvbProfiles)
            array.push(budgetedProfileSourceNames, SOURCE_IVB)
    else if not na(selectedSessionProfiles)
        array.push(budgetedProfileSelections, selectedSessionProfiles)
        array.push(budgetedProfileSourceNames, activeAnchorName())
    trimProfileSelectionsToCapacity(budgetedProfileSelections, budgetedProfileSourceNames, activeCoreProfileCapacity)

    if chartTimesBuiltAtBar != bar_index
        cachedChartTimes := recentChartTimes()
        chartTimesBuiltAtBar := bar_index
    array<int> chartTimes = cachedChartTimes
    bool hideDevelopingExtendedCounterpart = groupedNyProfilesActive and extendedNyEarlyInSession and not developingProfileVisible(SOURCE_EXTENDED_NY_EARLY)
    int currentNyEarlyStartTime = nyEarlyAnchor.startTime
    int selectedContentProfileCount = rollingSelected and not na(rollingProfile) and rollingProfile.isValid ? 1 : 0
    int budgetedSelectionCount = array.size(budgetedProfileSelections)
    if budgetedSelectionCount > 0
        for selectionIndex = 0 to budgetedSelectionCount - 1
            legilimensOrchestration.ProfileSelection selection = array.get(budgetedProfileSelections, selectionIndex)
            string sourceName = array.get(budgetedProfileSourceNames, selectionIndex)
            legilimensOrchestration.ProfileSelection comparisonSelection = sourceName == SOURCE_EXTENDED_NY_EARLY ? selectedNyEarlyProfiles : sourceName == SOURCE_NY_EARLY ? selectedExtendedNyEarlyProfiles : na
            selectedContentProfileCount += renderableContentProfileCount(selection, sourceName, comparisonSelection, hideDevelopingExtendedCounterpart, currentNyEarlyStartTime)
    bool renderBudgetedHistograms = showHistogram and activeHistogramPolylineLayers > 0 and selectedContentProfileCount > 0 and selectedContentProfileCount * (activeDeltaPolylineLayers + activeHistogramPolylineLayers) <= INDICATOR_MAX_POLYLINES
    if rollingSelected and not na(rollingProfile) and rollingProfile.isValid
        renderSelectedProfile(rollingProfile, SOURCE_ROLLING, "", false, false, true, isTwentyFourSevenAsset, chartTimes, renderBudgetedHistograms, activeHistogramPolylineLayers)
    else if budgetedSelectionCount > 0
        for renderPass = 0 to 1
            bool currentPass = renderPass == 0
            for selectionIndex = 0 to budgetedSelectionCount - 1
                legilimensOrchestration.ProfileSelection selection = array.get(budgetedProfileSelections, selectionIndex)
                string sourceName = array.get(budgetedProfileSourceNames, selectionIndex)
                legilimensOrchestration.ProfileSelection comparisonSelection = sourceName == SOURCE_EXTENDED_NY_EARLY ? selectedNyEarlyProfiles : sourceName == SOURCE_NY_EARLY ? selectedExtendedNyEarlyProfiles : na
                renderProfileSelection(selection, sourceName, comparisonSelection, hideDevelopingExtendedCounterpart, currentNyEarlyStartTime, isTwentyFourSevenAsset, chartTimes, currentPass, renderBudgetedHistograms, activeHistogramPolylineLayers)
    flushPendingMitigatedZones()
    flushPendingRightLines(mergeOverlaps)
    flushPendingRightLabels()

    if fixedRangeEnabled and not na(fixedProfile) and fixedProfile.isValid
        bool renderFixedHistogram = showHistogram and activeHistogramPolylineLayers > 0 and activeDeltaPolylineLayers + activeHistogramPolylineLayers <= INDICATOR_MAX_POLYLINES
        renderSelectedProfile(fixedProfile, SOURCE_FIXED, "", false, false, true, isTwentyFourSevenAsset, chartTimes, renderFixedHistogram, activeHistogramPolylineLayers)
        flushPendingMitigatedZones()
        flushPendingRightLines(mergeOverlaps)
        flushPendingRightLabels()

    if showColorTable
        array<ColorRow> colorRows = array.new<ColorRow>()
        if showOnlyEnabled and showOnlyTimeframeAllowed
            addColorRow(colorRows, "Hidden Candles", hiddenCandleColor, "")
        if not na(colorTable)
            table.delete(colorTable)
        colorTable := table.new(position.top_right, 4, array.size(colorRows) + 1, bgcolor=color.rgb(255, 255, 255), border_width=1, border_color=color.rgb(128, 128, 128), frame_width=1, frame_color=color.rgb(128, 128, 128))
        table.cell(colorTable, 0, 0, LABEL_TABLE_SETTING, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        table.cell(colorTable, 1, 0, LABEL_TABLE_RGB, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        table.cell(colorTable, 2, 0, LABEL_TABLE_TRANSPARENCY, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        table.cell(colorTable, 3, 0, LABEL_TABLE_WIDTH, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        if array.size(colorRows) > 0
            for rowIndex = 0 to array.size(colorRows) - 1
                writeColorRow(colorTable, rowIndex + 1, array.get(colorRows, rowIndex))
    else if not na(colorTable)
        table.delete(colorTable)
        colorTable := na

// legilimens •
