midnightProfilePosition = input.string(PROFILE_POSITION_RIGHT_LEFT, INPUT_LABEL_POSITION, options=[PROFILE_POSITION_LEFT_LEFT, PROFILE_POSITION_LEFT_RIGHT, PROFILE_POSITION_RIGHT_LEFT, PROFILE_POSITION_RIGHT_RIGHT], inline="midnight_position", group=GROUP_MIDNIGHT, active=midnightSelected)
midnightHours = input.float(6.0, INPUT_LABEL_HOURS, minval=0.0, step=1.0, inline="midnight_position", group=GROUP_MIDNIGHT, active=midnightSelected, tooltip=TOOLTIP_PROFILE_HOURS)
midnightDeltaWidthBars = input.int(DELTA_WIDTH_DEFAULT_BARS, INPUT_LABEL_DELTA_WIDTH, minval=DELTA_WIDTH_MIN_BARS, maxval=DELTA_WIDTH_MAX_BARS, inline="midnight_delta_width", group=GROUP_MIDNIGHT, active=midnightSelected, tooltip=TOOLTIP_DELTA_WIDTH)

weeklyProfilePosition = input.string(PROFILE_POSITION_RIGHT_LEFT, INPUT_LABEL_POSITION, options=[PROFILE_POSITION_LEFT_LEFT, PROFILE_POSITION_LEFT_RIGHT, PROFILE_POSITION_RIGHT_LEFT, PROFILE_POSITION_RIGHT_RIGHT], inline="weekly_position", group=GROUP_WEEKLY, active=weeklySelected)
weeklyHours = input.float(6.0, INPUT_LABEL_HOURS, minval=0.0, step=1.0, inline="weekly_position", group=GROUP_WEEKLY, active=weeklySelected, tooltip=TOOLTIP_PROFILE_HOURS)
weeklyDeltaWidthBars = input.int(DELTA_WIDTH_DEFAULT_BARS, INPUT_LABEL_DELTA_WIDTH, minval=DELTA_WIDTH_MIN_BARS, maxval=DELTA_WIDTH_MAX_BARS, inline="weekly_delta_width", group=GROUP_WEEKLY, active=weeklySelected, tooltip=TOOLTIP_DELTA_WIDTH)

monthlyProfilePosition = input.string(PROFILE_POSITION_RIGHT_LEFT, INPUT_LABEL_POSITION, options=[PROFILE_POSITION_LEFT_LEFT, PROFILE_POSITION_LEFT_RIGHT, PROFILE_POSITION_RIGHT_LEFT, PROFILE_POSITION_RIGHT_RIGHT], inline="monthly_position", group=GROUP_MONTHLY, active=monthlySelected)
