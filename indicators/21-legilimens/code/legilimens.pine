// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — FIXED RANGE APPEARANCE
// ═══════════════════════════════════════════════════════════════════════════════
fixedProfilePosition = input.string(PROFILE_POSITION_RIGHT_LEFT, INPUT_LABEL_POSITION, options=[PROFILE_POSITION_LEFT_LEFT, PROFILE_POSITION_LEFT_RIGHT, PROFILE_POSITION_RIGHT_LEFT, PROFILE_POSITION_RIGHT_RIGHT], inline="fixed_position", group=GROUP_FIXED, active=fixedSelected)
fixedHours = input.float(6.0, INPUT_LABEL_HOURS, minval=0.0, step=1.0, inline="fixed_position", group=GROUP_FIXED, active=fixedSelected, tooltip=TOOLTIP_PROFILE_HOURS)
fixedDeltaWidthBars = input.int(DELTA_WIDTH_DEFAULT_BARS, INPUT_LABEL_DELTA_WIDTH, minval=DELTA_WIDTH_MIN_BARS, maxval=DELTA_WIDTH_MAX_BARS, inline="fixed_delta_width", group=GROUP_FIXED, active=fixedSelected, tooltip=TOOLTIP_DELTA_WIDTH)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — DELTA
// ═══════════════════════════════════════════════════════════════════════════════
deltaHistogramRows = input.string(OPTION_ALL, "Delta", options=[OPTION_OFF, OPTION_ALL, DELTA_ROWS_BUY, DELTA_ROWS_SELL], inline="delta_visibility", group=GROUP_DELTA)
deltaTierSideVisibility = input.string(OPTION_ALL, "Delta Dominant", options=[OPTION_OFF, OPTION_ALL, DELTA_TIER_VISIBILITY_BUY, DELTA_TIER_VISIBILITY_SELL], inline="delta_visibility", group=GROUP_DELTA, active=showDeltaTiers, tooltip="Delta — visible histogram side.\nDelta Dominant — visible dominant tier side.")
deltaTierLineStyleSetting = input.string(STYLE_DASHED, "Delta Tier Line Style", options=[STYLE_DASHED, STYLE_DOTTED], group=GROUP_DELTA, active=showDeltaTiers and deltaTierSideVisibility != OPTION_OFF, tooltip="Dashed — original full-row lines.\nDotted — same lines and widths, rendered dotted.")

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — PROFILE APPEARANCE: HISTOGRAM
// ═══════════════════════════════════════════════════════════════════════════════
showHistogram = input.bool(false, "Histogram", inline="appearance_histogram", group=GROUP_APPEARANCE)
histogramWidthPercent = input.int(20, LABEL_TABLE_WIDTH, minval=HISTOGRAM_WIDTH_MIN_PERCENT, maxval=HISTOGRAM_WIDTH_MAX_PERCENT, inline="appearance_histogram", group=GROUP_APPEARANCE, active=showHistogram)
// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — PROFILE APPEARANCE: LEVELS & LABELS
// ═══════════════════════════════════════════════════════════════════════════════
showValueAreaLevels = input.bool(false, "VAH/L", inline="profile_levels", group=GROUP_APPEARANCE)
showPocLevel = input.bool(false, "POC", inline="profile_levels", group=GROUP_APPEARANCE, tooltip="VAH/L — show paired levels through the profile extension endpoint.\nPOC — show point of control.")
showProfileMidpointLine = input.bool(true, "Midpoint Line", inline="profile_levels", group=GROUP_APPEARANCE)
mergeOverlaps = input.bool(true, "Merge Levels", inline="appearance_merge", group=GROUP_APPEARANCE)
mergeDistancePreset = input.string(LABEL_MERGE_STRICT, "", options=[LABEL_MERGE_STRICT, LABEL_MERGE_BALANCED, LABEL_MERGE_WIDE, LABEL_MERGE_EXTRA_WIDE, LABEL_MERGE_CUSTOM], inline="appearance_merge", group=GROUP_APPEARANCE, active=mergeOverlaps)
customMergeDistancePercent = input.float(LABEL_MERGE_BALANCED_PERCENT, "%", minval=0.0, maxval=0.5, step=0.001, inline="appearance_merge", group=GROUP_APPEARANCE, active=mergeOverlaps and mergeDistancePreset == LABEL_MERGE_CUSTOM, tooltip="Distance — preset / custom price %\nFloor — 1 tick")

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — FIXED RANGE POINTS
// ═══════════════════════════════════════════════════════════════════════════════
// Interactive points: TradingView builds the placement prompt from the title, and a tooltip would replace it.
fixedRangeStartInput = input.time(FIXED_RANGE_TIME_UNSET, "Start Time", group=GROUP_FIXED, active=fixedSelected)
fixedRangeEndInput = input.time(FIXED_RANGE_TIME_UNSET, "End Time", group=GROUP_FIXED, active=fixedSelected)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — REFERENCE
// ═══════════════════════════════════════════════════════════════════════════════
showColorTable = input.bool(false, "Show Table", group=GROUP_UTILITY, tooltip="Active editable colors only.")

// ═══════════════════════════════════════════════════════════════════════════════
// DERIVED CONFIGURATION
// ═══════════════════════════════════════════════════════════════════════════════
priorProfilesToShow = showPriorProfiles ? priorProfiles : 0
fixedRangeEnabled = fixedSelected
fixedRangeConfigured = fixedRangeStartInput > FIXED_RANGE_TIME_UNSET and fixedRangeEndInput > FIXED_RANGE_TIME_UNSET and fixedRangeStartInput != fixedRangeEndInput

bool profileChartAllowed = chart.is_range or timeframe.in_seconds(timeframe.period) <= PROFILE_TIMEFRAME_LIMIT_SECONDS
nyEarlyIvbModeActive = nyEarlyIvbSelected and profileChartAllowed
nyEarlyModeActive = nyEarlySelected and profileChartAllowed
extendedNyEarlyModeActive = extendedNyEarlySelected and profileChartAllowed
ivbModeActive = ivbSelected and profileChartAllowed
asiaPremarketModeActive = asiaPremarketSelected and profileChartAllowed
rthModeActive = rthSelected and profileChartAllowed
globexModeActive = globexSelected and profileChartAllowed
midnightModeActive = midnightSelected and profileChartAllowed
weeklyModeActive = weeklySelected and profileChartAllowed
monthlyModeActive = monthlySelected and profileChartAllowed

visibleDeltaTierCount = visibleTierCount(minimumDeltaTierStrength)
visibleLvnTierCount = visibleTierCount(minimumLvnTierStrength)
showDots = dotDisplay != DOT_DISPLAY_OFF
showDotLabels = dotDisplay == DOT_DISPLAY_DOTS_LABELS
mergeDistancePercent = mergeDistancePreset == LABEL_MERGE_STRICT ? LABEL_MERGE_STRICT_PERCENT : mergeDistancePreset == LABEL_MERGE_WIDE ? LABEL_MERGE_WIDE_PERCENT : mergeDistancePreset == LABEL_MERGE_EXTRA_WIDE ? LABEL_MERGE_EXTRA_WIDE_PERCENT : mergeDistancePreset == LABEL_MERGE_CUSTOM ? customMergeDistancePercent : LABEL_MERGE_BALANCED_PERCENT

rollingLookbackDays = rollingDaysPreset == ROLLING_DAYS_30 ? 30 : rollingDaysPreset == ROLLING_DAYS_60 ? 60 : rollingDaysPreset == ROLLING_DAYS_90 ? 90 : shortRollingLookbackDays
rollingLookbackTag = str.tostring(rollingLookbackDays) + "-Day"
weeklyRollingSelected = weeklyModeActive and useRollingWeeklyMonthly
monthlyRollingSelected = monthlyModeActive and useRollingWeeklyMonthly
calendarWeeklyModeActive = weeklyModeActive and not useRollingWeeklyMonthly
calendarMonthlyModeActive = monthlyModeActive and not useRollingWeeklyMonthly
rollingPeriodSelected = weeklyRollingSelected or monthlyRollingSelected
rollingPeriodSourceName = weeklyRollingSelected ? SOURCE_WEEKLY : monthlyRollingSelected ? SOURCE_MONTHLY : ""
rollingWindowModeActive = rollingSelected or rollingPeriodSelected
rollingWindowLookbackDays = weeklyRollingSelected ? ROLLING_WEEKLY_DAYS : monthlyRollingSelected ? ROLLING_MONTHLY_DAYS : rollingLookbackDays
rollingWindowThrough = rollingPeriodSelected ? ROLLING_THROUGH_1800 : rollingThrough
rollingPeriodHistoryCount = rollingPeriodSelected ? priorProfilesToShow : 0

// ═══════════════════════════════════════════════════════════════════════════════
// TYPES
// ═══════════════════════════════════════════════════════════════════════════════
type DeltaProfile
    int startTime
    int endTime
    float priceLow
    float priceHigh
    float rangeLow
    float rangeHigh
    int rowCount
    array<float> rowVolumes
    array<float> rowDeltas
    float maxRowVolume
    float maxAbsRowDelta
    bool isValid

type ZoneTrackingProfileKey
    string sourceName
    int startTime

type PendingOutlierLevel
    float price
    float zoneLow
    float zoneHigh
    float delta
    float strength
    bool buySide
    int profileStartTime
    int lineStartTime
    int rightTime
    int markerTime
    string sourceName
    string displayNameOverride
    int tradingDayKey
    bool historical
    int firstRow
    int lastRow
    int fibLocationGrade
    float fibMidpointPrice

type RankedOutlierLevel
    float price
    float zoneLow
    float zoneHigh
    bool buySide
    int profileStartTime
    int lineStartTime
    int rightTime
    int markerTime
    string sourceName
    string displayNameOverride
    int tradingDayKey
    bool historical
    int firstRow
    int lastRow
    int strengthRank
    int fibLocationGrade
    float fibMidpointPrice

type PendingMitigatedZone
    float price
    float zoneLow
    float zoneHigh
    int profileStartTime
    int leftTime
    int eligibilityTime
    color zoneColor
    int zoneBorderWidth
    color zoneBorderColor
    bool hasLine
    color lineColor
    int lineWidth
    string lineStyle
    int lineRank
    string sourceName
    int tradingDayKey
    bool historical
    int direction
    string markerGlyph
    string markerLabel
    color markerColor
    int markerSize

type MitigatedZoneState
    string sourceName
    int profileStartTime
    int eligibilityTime
    float price
    int mitigatedTime
    bool available

type RoleReversalZoneState
    string sourceName
    int profileStartTime
    int eligibilityTime
    int expirationTime
    float price
    float zoneLow
    float zoneHigh
    int originalDirection
    bool extendsUntilMitigated
    bool armed
    bool interacted
    bool reversed

type PendingRightLabel
    float price
    int markerTime
    string labelText
    color textColor
    int textSize
    bool sessionText

type PendingRightLine
    float price
    int leftTime
    int rightTime
    color lineColor
    int lineWidth
    string styleName
    int rank
    string sourceName
    int tradingDayKey
    bool historical
    int direction

type ColorRow
    string name
    color swatchColor
    string widthText

type DeltaTierAppearance
    bool hasLine
    color lineColor
    int lineWidth
    string lineStyle
    color textColor
    color zoneColor

appearanceHasLine(DeltaTierAppearance config) =>
    config.hasLine

appearanceLineColor(DeltaTierAppearance config) =>
    config.lineColor

appearanceLineWidth(DeltaTierAppearance config) =>
    config.lineWidth

appearanceLineStyle(DeltaTierAppearance config) =>
    config.lineStyle

appearanceTextColor(DeltaTierAppearance config) =>
    config.textColor

appearanceZoneColor(DeltaTierAppearance config) =>
    config.zoneColor

deltaTierLineStyle(DeltaTierAppearance config) =>
    deltaTierLineStyleSetting == STYLE_DOTTED ? STYLE_DOTTED : appearanceLineStyle(config)

// ═══════════════════════════════════════════════════════════════════════════════
// PRESENTATION CONFIGURATION
// ═══════════════════════════════════════════════════════════════════════════════
appendDeltaTierPair(array<DeltaTierAppearance> appearances, bool hasLine, color buyLineColor, color sellLineColor, int lineWidth, string lineStyle, color buyTextColor, color sellTextColor, color buyZoneColor, color sellZoneColor) =>
    array.push(appearances, DeltaTierAppearance.new(hasLine, buyLineColor, lineWidth, lineStyle, buyTextColor, buyZoneColor))
    array.push(appearances, DeltaTierAppearance.new(hasLine, sellLineColor, lineWidth, lineStyle, sellTextColor, sellZoneColor))

var array<int> tierMarkerSizes = array.from(DOMINANT_DOT_SIZE, STRONG_DOT_SIZE, MODERATE_DOT_SIZE, MINOR_DOT_SIZE, WEAK_DOT_SIZE)

var array<DeltaTierAppearance> deltaTierAppearances = array.new<DeltaTierAppearance>()
var array<DeltaTierAppearance> alternateDeltaTierAppearances = array.new<DeltaTierAppearance>()
if barstate.isfirst
    appendDeltaTierPair(deltaTierAppearances, true, color.new(color.rgb(0, 255, 0), 10), color.new(color.rgb(245, 65, 81), 10), DELTA_TIER_5_LINE_WIDTH, STYLE_DASHED, color.rgb(77, 243, 8), color.rgb(249, 121, 246), color.new(color.rgb(114, 243, 114), 85), color.new(color.rgb(249, 121, 246), 82))
    appendDeltaTierPair(deltaTierAppearances, true, color.new(color.rgb(56, 142, 60), 30), color.new(color.rgb(178, 40, 51), 30), DELTA_TIER_4_LINE_WIDTH, STYLE_DASHED, color.new(color.rgb(77, 243, 8), 10), color.new(color.rgb(249, 121, 246), 10), color.new(color.rgb(114, 243, 114), 88), color.new(color.rgb(249, 121, 246), 88))
    appendDeltaTierPair(deltaTierAppearances, false, color(na), color(na), 1, STYLE_SOLID, color.new(color.rgb(163, 218, 165), 10), color.new(color.rgb(249, 121, 246), 30), color.new(color.rgb(114, 243, 114), 90), color.new(color.rgb(249, 121, 246), 90))
    appendDeltaTierPair(deltaTierAppearances, false, color(na), color(na), 1, STYLE_SOLID, color.new(color.rgb(114, 243, 114), 30), color.new(color.rgb(249, 121, 246), 30), color.new(color.rgb(114, 243, 114), 90), color.new(color.rgb(249, 121, 246), 90))
    appendDeltaTierPair(deltaTierAppearances, false, color(na), color(na), 1, STYLE_SOLID, color.new(color.rgb(163, 218, 165), 20), color.new(color.rgb(128, 25, 34), 92), color.new(color.rgb(114, 243, 114), 90), color.new(color.rgb(249, 121, 246), 90))

    appendDeltaTierPair(alternateDeltaTierAppearances, true, color.new(color.rgb(56, 142, 60), 30), color.new(color.rgb(178, 40, 51), 30), DELTA_TIER_5_LINE_WIDTH, STYLE_DASHED, color.rgb(56, 142, 60), color.rgb(178, 40, 51), color.new(color.rgb(56, 142, 60), 92), color.new(color.rgb(178, 40, 51), 92))
    appendDeltaTierPair(alternateDeltaTierAppearances, true, color.new(color.rgb(56, 142, 60), 30), color.new(color.rgb(178, 40, 51), 30), DELTA_TIER_4_LINE_WIDTH, STYLE_DASHED, color.rgb(56, 142, 60), color.rgb(178, 40, 51), color.new(color.rgb(56, 142, 60), 92), color.new(color.rgb(178, 40, 51), 92))
    appendDeltaTierPair(alternateDeltaTierAppearances, false, color(na), color(na), 1, STYLE_SOLID, color.rgb(56, 142, 60), color.rgb(178, 40, 51), color.new(color.rgb(56, 142, 60), 92), color.new(color.rgb(178, 40, 51), 92))
    appendDeltaTierPair(alternateDeltaTierAppearances, false, color(na), color(na), 1, STYLE_SOLID, color.rgb(56, 142, 60), color.rgb(178, 40, 51), color.new(color.rgb(56, 142, 60), 92), color.new(color.rgb(178, 40, 51), 92))
    appendDeltaTierPair(alternateDeltaTierAppearances, false, color(na), color(na), 1, STYLE_SOLID, color.rgb(56, 142, 60), color.rgb(178, 40, 51), color.new(color.rgb(56, 142, 60), 92), color.new(color.rgb(178, 40, 51), 92))

// ═══════════════════════════════════════════════════════════════════════════════
// RUNTIME STATE
// ═══════════════════════════════════════════════════════════════════════════════
var array<box> drawnBoxes = array.new<box>()
var array<line> drawnLines = array.new<line>()
var array<polyline> drawnPolylines = array.new<polyline>()
var array<label> drawnLabels = array.new<label>()
var array<PendingOutlierLevel> pendingOutlierLevels = array.new<PendingOutlierLevel>()
var array<PendingMitigatedZone> pendingMitigatedZones = array.new<PendingMitigatedZone>()
var array<PendingRightLabel> pendingRightLabels = array.new<PendingRightLabel>()
var array<PendingRightLine> pendingRightLines = array.new<PendingRightLine>()
var array<MitigatedZoneState> mitigatedZoneStates = array.new<MitigatedZoneState>()
var array<ZoneTrackingProfileKey> mitigatedProfiles = array.new<ZoneTrackingProfileKey>()
var array<RoleReversalZoneState> roleReversalZoneStates = array.new<RoleReversalZoneState>()
var array<ZoneTrackingProfileKey> roleReversalProfiles = array.new<ZoneTrackingProfileKey>()
var table colorTable = na
var array<int> cachedChartTimes = array.new<int>()
var int chartTimesBuiltAtBar = -1

var array<float> fixedBarHighs = array.new<float>()
var array<float> fixedBarLows = array.new<float>()
var array<float> fixedBarVolumes = array.new<float>()
var array<float> fixedBarDeltas = array.new<float>()
var legilimensProfile.RollingSampleStore rollingSamples = legilimensProfile.newRollingSampleStore()

var legilimensOrchestration.AnchorState rollingPeriodAnchor = legilimensOrchestration.newAnchorState()
var legilimensOrchestration.AnchorState rthAnchor = legilimensOrchestration.newAnchorState()
var legilimensOrchestration.AnchorState globexAnchor = legilimensOrchestration.newAnchorState()
var legilimensOrchestration.AnchorState midnightAnchor = legilimensOrchestration.newAnchorState()
var legilimensOrchestration.AnchorState asiaPremarketAnchor = legilimensOrchestration.newAnchorState()
var legilimensOrchestration.AnchorState nyEarlyAnchor = legilimensOrchestration.newAnchorState()
// Simultaneous overlays require independent retained state.
var legilimensOrchestration.AnchorState extendedNyEarlyAnchor = legilimensOrchestration.newAnchorState()
var legilimensOrchestration.AnchorState ivbAnchor = legilimensOrchestration.newAnchorState()
var legilimensOrchestration.AnchorState weeklyAnchor = legilimensOrchestration.newAnchorState()
var legilimensOrchestration.AnchorState monthlyAnchor = legilimensOrchestration.newAnchorState()

var array<float> extendedOpeningPendingHighs = array.new<float>()
var array<float> extendedOpeningPendingLows = array.new<float>()
var array<float> extendedOpeningPendingVolumes = array.new<float>()
var array<float> extendedOpeningPendingDeltas = array.new<float>()
var bool extendedOpeningQualified = false

var bool isTwentyFourSevenAsset = false
var bool assetClassificationReady = false
var int lastTickDirection = 1
var float previousTapeClose = na
var int lastAcceptedRangeIntrabarTime = na
var bool fixedZoneTrackingProfileRegistered = false
var int registeredRollingZoneTrackingEndTime = na

// ═══════════════════════════════════════════════════════════════════════════════
// HELPERS — OBJECT BUDGETS
// ═══════════════════════════════════════════════════════════════════════════════
deltaPolylineLayersPerProfile(string visibleRows, bool outliersOnly) =>
    int visibleSides = visibleRows == OPTION_OFF ? 0 : visibleRows == OPTION_ALL ? 2 : 1
    int layersPerSide = outliersOnly ? 1 : DELTA_POLYLINE_LAYER_COUNT_PER_SIDE
    visibleSides * layersPerSide

filteredDeltaRowsOnly() =>
    deltaRowFilter != OPTION_ALL

selectedTierOutlierRowsOnly() =>
    deltaRowFilter == DELTA_ROW_FILTER_SELECTED_TIER_OUTLIERS

visibleDeltaTierSideCount() =>
    showDeltaTiers and deltaTierSideVisibility != OPTION_OFF ? deltaTierSideVisibility == OPTION_ALL ? 2 : 1 : 0

maximumDeltaTierLineCountPerSide() =>
    int lineCount = 0
    if showDeltaTiers
        for strengthRank = 1 to visibleDeltaTierCount
            int tierIndex = strengthRank - 1
            int buyAppearanceIndex = tierIndex * 2
            int sellAppearanceIndex = buyAppearanceIndex + 1
            bool standardHasLine = array.get(deltaTierAppearances, buyAppearanceIndex).hasLine or array.get(deltaTierAppearances, sellAppearanceIndex).hasLine
            bool alternateHasLine = array.get(alternateDeltaTierAppearances, buyAppearanceIndex).hasLine or array.get(alternateDeltaTierAppearances, sellAppearanceIndex).hasLine
            if standardHasLine or alternateHasLine
                lineCount += 1
    lineCount

maximumCoreObjectCostsPerProfile() =>
    int deltaTierSides = visibleDeltaTierSideCount()
    int lvnTierCount = showMinimumLvnTiers ? visibleLvnTierCount : 0
    int deltaTierCount = deltaTierSides * visibleDeltaTierCount
    int referenceLineCount = (showValueAreaLevels ? 2 : 0) + (showPocLevel ? 1 : 0) + (showProfileMidpointLine ? 1 : 0)
    int rightLineCount = lvnTierCount + deltaTierSides * maximumDeltaTierLineCountPerSide()
    int pocLabelCount = showPocLevel ? 1 : 0
    int lvnMarkerLabelCount = showDots ? lvnTierCount + (showDotLabels and lvnTierCount > 0 ? 1 : 0) : 0
    int deltaMarkerLabelCount = showDots ? deltaTierCount + (showDotLabels ? deltaTierSides : 0) : 0
    int zoneBoxCount = lvnTierCount + deltaTierCount
    [referenceLineCount + rightLineCount, PROFILE_HEADING_LABEL_COUNT + pocLabelCount + lvnMarkerLabelCount + deltaMarkerLabelCount, PROFILE_FRAME_BOX_COUNT + zoneBoxCount]

profileCapacityForObjectLimit(int objectLimit, int objectsPerProfile, int fallbackCapacity) =>
    objectsPerProfile > 0 ? int(math.floor(objectLimit / float(objectsPerProfile))) : fallbackCapacity

maximumCoreProfileCapacity(int sourceCount, int deltaLayersPerProfile, int linesPerProfile, int labelsPerProfile, int boxesPerProfile) =>
    int requestedCapacity = math.max(1, sourceCount) * SESSION_PROFILE_RETENTION
    int totalProfileCapacity = requestedCapacity
    totalProfileCapacity := math.min(totalProfileCapacity, profileCapacityForObjectLimit(INDICATOR_MAX_POLYLINES, deltaLayersPerProfile, requestedCapacity))
    totalProfileCapacity := math.min(totalProfileCapacity, profileCapacityForObjectLimit(INDICATOR_MAX_LINES, linesPerProfile, requestedCapacity))
    totalProfileCapacity := math.min(totalProfileCapacity, profileCapacityForObjectLimit(INDICATOR_MAX_LABELS, labelsPerProfile, requestedCapacity))
    totalProfileCapacity := math.min(totalProfileCapacity, profileCapacityForObjectLimit(INDICATOR_MAX_BOXES, boxesPerProfile, requestedCapacity))
    totalProfileCapacity

int activeProfileSourceCount = (nyEarlyModeActive ? 1 : 0) + (extendedNyEarlyModeActive ? 1 : 0) + (ivbModeActive ? 1 : 0) + (asiaPremarketModeActive ? 1 : 0) + (rthModeActive ? 1 : 0) + (globexModeActive ? 1 : 0) + (midnightModeActive ? 1 : 0) + (calendarWeeklyModeActive ? 1 : 0) + (calendarMonthlyModeActive ? 1 : 0) + (rollingWindowModeActive ? 1 : 0) + (fixedSelected ? 1 : 0)
int activeDeltaPolylineLayers = deltaPolylineLayersPerProfile(deltaHistogramRows, filteredDeltaRowsOnly())
int activeHistogramPolylineLayers = showHistogram ? HISTOGRAM_VALUE_AREA_POLYLINE_LAYER_COUNT : 0
[activeLinesPerProfile, activeLabelsPerProfile, activeBoxesPerProfile] = maximumCoreObjectCostsPerProfile()
int activeCoreProfileCapacity = maximumCoreProfileCapacity(activeProfileSourceCount, activeDeltaPolylineLayers, activeLinesPerProfile, activeLabelsPerProfile, activeBoxesPerProfile)

// ───────────────────────────────────────────────────────────────────────────────
// HELPERS — DATA ROUTING
// ───────────────────────────────────────────────────────────────────────────────
autoIntrabarTimeframe() =>
    float chartSeconds = timeframe.in_seconds(timeframe.period)
    chart.is_range ? INTRABAR_TIMEFRAME_ONE_MINUTE : chartSeconds <= SECONDS_PER_MINUTE ? INTRABAR_TIMEFRAME_ONE_SECOND : chartSeconds <= 15 * SECONDS_PER_MINUTE ? INTRABAR_TIMEFRAME_ONE_MINUTE : chartSeconds <= 60 * SECONDS_PER_MINUTE ? INTRABAR_TIMEFRAME_FIVE_MINUTES : chartSeconds <= 4 * 60 * SECONDS_PER_MINUTE ? INTRABAR_TIMEFRAME_FIFTEEN_MINUTES : INTRABAR_TIMEFRAME_ONE_HOUR

sameCalendarDate(int firstTime, int secondTime, string timezone) =>
    legilimensOrchestration.sameCalendarDate(firstTime, secondTime, timezone)

// ───────────────────────────────────────────────────────────────────────────────
// HELPERS — PRESENTATION & LABELS
// ───────────────────────────────────────────────────────────────────────────────
toLineStyle(string styleName) =>
    styleName == STYLE_DASHED ? line.style_dashed : styleName == STYLE_DOTTED ? line.style_dotted : line.style_solid

toLabelSize(string sizeName) =>
    sizeName == LABEL_SIZE_TINY ? size.tiny : size.small

labelPointSize(string sizeName) =>
    sizeName == LABEL_SIZE_TINY ? 7.0 : 10.0

rangeTitleLayout(DeltaProfile profile, string sizeName) =>
    float pricePerLayoutUnit = (profile.rangeHigh - profile.rangeLow) / profile.rowCount
    float titleClearance = pricePerLayoutUnit * (labelPointSize(sizeName) + RANGE_TITLE_CONTAINER_PADDING)
    [profile.rangeHigh, profile.rangeLow, titleClearance]

quarterDurationValue(float duration) =>
    duration > 0 ? math.max(0.25, math.round(duration * 4.0) / 4.0) : 0.0

formatQuarterDuration(float duration) =>
    str.tostring(quarterDurationValue(duration), "#.##")

fixedRangeTradingDayDuration(int firstTime, int secondTime) =>
    int shiftedStartTime = math.min(firstTime, secondTime) + GLOBEX_REOPEN_SHIFT_MS
    int shiftedEndTime = math.max(firstTime, secondTime) + GLOBEX_REOPEN_SHIFT_MS
    int cursorDate = timestamp(NY_TIMEZONE, year(shiftedStartTime, NY_TIMEZONE), month(shiftedStartTime, NY_TIMEZONE), dayofmonth(shiftedStartTime, NY_TIMEZONE), 0, 0)
    float tradingDays = 0.0
    while cursorDate < shiftedEndTime
        int nextDate = timestamp(NY_TIMEZONE, year(cursorDate, NY_TIMEZONE), month(cursorDate, NY_TIMEZONE), dayofmonth(cursorDate, NY_TIMEZONE) + 1, 0, 0)
        int weekday = dayofweek(cursorDate, NY_TIMEZONE)
        if weekday >= dayofweek.monday and weekday <= dayofweek.friday
            int overlapStart = math.max(shiftedStartTime, cursorDate)
            int overlapEnd = math.min(shiftedEndTime, nextDate)
            if overlapEnd > overlapStart
                tradingDays += float(overlapEnd - overlapStart) / float(nextDate - cursorDate)
        cursorDate := nextDate
    tradingDays

formatFixedRangeDuration(int firstTime, int secondTime, bool twentyFourSeven) =>
    int durationMs = math.abs(secondTime - firstTime)
    float durationMinutes = float(durationMs) / MS_PER_MINUTE
    float durationHours = float(durationMs) / MS_PER_HOUR
    float durationDays = durationHours / 24.0
    float displayedDays = twentyFourSeven ? durationDays : fixedRangeTradingDayDuration(firstTime, secondTime)
    quarterDurationValue(durationHours) >= 24.0 ? formatQuarterDuration(displayedDays) + "-Day" : durationHours >= 1.0 or quarterDurationValue(durationMinutes) >= 60.0 ? formatQuarterDuration(durationHours) + "-Hour" : formatQuarterDuration(durationMinutes) + "-Minute"

profileDisplayName(string sourceName, string displayNameOverride, bool twentyFourSeven) =>
    displayNameOverride != "" ? displayNameOverride : sourceName == SOURCE_FIXED ? PROFILE_EMOJI_FIXED + formatFixedRangeDuration(fixedRangeStartInput, fixedRangeEndInput, twentyFourSeven) + " " + PROFILE_NAME_FIXED : sourceName == SOURCE_ROLLING ? "Rolling " + rollingLookbackTag + " Range" : sourceName == SOURCE_WEEKLY and weeklyRollingSelected ? DISPLAY_ROLLING_WEEKLY : sourceName == SOURCE_MONTHLY and monthlyRollingSelected ? DISPLAY_ROLLING_MONTHLY : sourceName

profileSourceName(string sourceName, string displayNameOverride) =>
    displayNameOverride != "" ? displayNameOverride : sourceName == SOURCE_FIXED ? PROFILE_NAME_FIXED : sourceName == SOURCE_ROLLING ? PROFILE_NAME_ROLLING : sourceName == SOURCE_WEEKLY and weeklyRollingSelected ? DISPLAY_ROLLING_WEEKLY : sourceName == SOURCE_MONTHLY and monthlyRollingSelected ? DISPLAY_ROLLING_MONTHLY : sourceName

activeAnchorName() =>
    anchorMode == MODE_ROLLING ? SOURCE_ROLLING : anchorMode == MODE_NY_EARLY ? SOURCE_NY_EARLY : anchorMode == MODE_IVB ? SOURCE_IVB : anchorMode == MODE_NY_EARLY_IVB ? SOURCE_NY_EARLY_IVB : anchorMode == MODE_ASIA_PREMARKET ? SOURCE_ASIA_PREMARKET : anchorMode == MODE_RTH ? SOURCE_RTH : anchorMode == MODE_GLOBEX ? SOURCE_GLOBEX : anchorMode == MODE_MIDNIGHT ? SOURCE_MIDNIGHT : anchorMode == MODE_WEEKLY ? SOURCE_WEEKLY : anchorMode == MODE_MONTHLY ? SOURCE_MONTHLY : ""

