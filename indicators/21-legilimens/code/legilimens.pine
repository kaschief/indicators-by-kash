legilimensPresentation.SourceSpec weeklyPresentationSource = legilimensPresentation.SourceSpec.new(SOURCE_WEEKLY, weeklyRollingSelected ? DISPLAY_ROLLING_WEEKLY : SOURCE_WEEKLY, weeklyRollingSelected ? DISPLAY_ROLLING_WEEKLY : SOURCE_WEEKLY, weeklyHours, weeklyProfilePosition, weeklyDeltaWidthBars, weeklySelected, true, useWeeklyAlternateStyles, weeklyRollingSelected, frameTitlePrefix=PROFILE_EMOJI_WEEKLY)
legilimensPresentation.SourceSpec monthlyPresentationSource = legilimensPresentation.SourceSpec.new(SOURCE_MONTHLY, monthlyRollingSelected ? DISPLAY_ROLLING_MONTHLY : SOURCE_MONTHLY, monthlyRollingSelected ? DISPLAY_ROLLING_MONTHLY : SOURCE_MONTHLY, monthlyHours, monthlyProfilePosition, monthlyDeltaWidthBars, monthlySelected, true, useMonthlyAlternateStyles, monthlyRollingSelected, frameTitlePrefix=PROFILE_EMOJI_MONTHLY)
array<legilimensPresentation.SourceSpec> presentationSources = array.from(fixedPresentationSource, rollingPresentationSource, nyEarlyPresentationSource, extendedNyEarlyPresentationSource, ivbPresentationSource, asiaPremarketPresentationSource, fomcPresentationSource, overnightNinePresentationSource, rthPresentationSource, nyAfternoonPresentationSource, allDayToAfternoonPresentationSource, globexPresentationSource, midnightPresentationSource, weeklyPresentationSource, monthlyPresentationSource)

fixedRangeStart = math.min(fixedRangeStartInput, fixedRangeEndInput)
fixedRangeEnd = math.max(fixedRangeStartInput, fixedRangeEndInput)
rollingRangeEnd = rollingThroughTime(last_bar_time, rollingWindowThrough, isTwentyFourSevenAsset)
rollingRangeStart = lookbackDaysStart(rollingRangeEnd, rollingWindowLookbackDays, isTwentyFourSevenAsset)
if focusSearchActive and rollingPeriodSelected and (na(rollingFocusEndTime) or rollingFocusEndTime != rollingRangeEnd or rollingFocusTwentyFourSeven != isTwentyFourSevenAsset)
    int focusPeriodCount = rollingFocusPeriodCount(rollingRangeEnd, firstProfileChartTime, rollingWindowLookbackDays, rollingPeriodHistoryCount + 1, FOCUS_SEARCH_DEPTH)
    rollingFocusOldestStart := lookbackDaysStart(rollingRangeEnd, rollingWindowLookbackDays * focusPeriodCount, isTwentyFourSevenAsset)
    rollingFocusEndTime := rollingRangeEnd
    rollingFocusTwentyFourSeven := isTwentyFourSevenAsset
rollingPeriodOldestStart = focusSearchActive and rollingPeriodSelected ? rollingFocusOldestStart : lookbackDaysStart(rollingRangeEnd, rollingWindowLookbackDays * (rollingPeriodHistoryCount + 1), isTwentyFourSevenAsset)
legilimensProfile.RollingProfileWindow rollingProfileWindow = legilimensProfile.RollingProfileWindow.new(rollingRangeStart, rollingRangeEnd, rollingWindowThrough == ROLLING_THROUGH_LIVE, rollingUsesClockCutoff(rollingWindowThrough))

array<int> barSampleStartTimes = array.new<int>()
array<int> barSampleEndTimes = array.new<int>()
array<float> barSampleHighs = array.new<float>()
array<float> barSampleLows = array.new<float>()
array<float> barSampleVolumes = array.new<float>()
array<float> barSampleDeltas = array.new<float>()
legilimensProfile.SampleBatch barSamples = legilimensProfile.SampleBatch.new(barSampleStartTimes, barSampleEndTimes, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas)
array<int> boundedSampleStartTimes = array.new<int>()
array<int> boundedSampleEndTimes = array.new<int>()
array<float> asiaPremarketSampleHighs = array.new<float>()
array<float> asiaPremarketSampleLows = array.new<float>()
array<float> asiaPremarketSampleVolumes = array.new<float>()
array<float> asiaPremarketSampleDeltas = array.new<float>()
array<int> asiaPremarketSampleSessionStarts = array.new<int>()
array<int> asiaPremarketSampleEndTimes = array.new<int>()
array<float> nyEarlySampleHighs = array.new<float>()
array<float> nyEarlySampleLows = array.new<float>()
array<float> nyEarlySampleVolumes = array.new<float>()
array<float> nyEarlySampleDeltas = array.new<float>()
array<float> extendedNyEarlySampleHighs = array.new<float>()
array<float> extendedNyEarlySampleLows = array.new<float>()
array<float> extendedNyEarlySampleVolumes = array.new<float>()
array<float> extendedNyEarlySampleDeltas = array.new<float>()
array<float> extendedOpeningSampleHighs = array.new<float>()
array<float> extendedOpeningSampleLows = array.new<float>()
array<float> extendedOpeningSampleVolumes = array.new<float>()
array<float> extendedOpeningSampleDeltas = array.new<float>()
array<float> ivbSampleHighs = array.new<float>()
array<float> ivbSampleLows = array.new<float>()
array<float> ivbSampleVolumes = array.new<float>()
array<float> ivbSampleDeltas = array.new<float>()
legilimensProfile.SampleBatch asiaPremarketSamples = legilimensProfile.SampleBatch.new(boundedSampleStartTimes, boundedSampleEndTimes, asiaPremarketSampleHighs, asiaPremarketSampleLows, asiaPremarketSampleVolumes, asiaPremarketSampleDeltas)
legilimensProfile.SampleBatch nyEarlySamples = legilimensProfile.SampleBatch.new(boundedSampleStartTimes, boundedSampleEndTimes, nyEarlySampleHighs, nyEarlySampleLows, nyEarlySampleVolumes, nyEarlySampleDeltas)
legilimensProfile.SampleBatch extendedNyEarlySamples = legilimensProfile.SampleBatch.new(boundedSampleStartTimes, boundedSampleEndTimes, extendedNyEarlySampleHighs, extendedNyEarlySampleLows, extendedNyEarlySampleVolumes, extendedNyEarlySampleDeltas)
legilimensProfile.SampleBatch ivbSamples = legilimensProfile.SampleBatch.new(boundedSampleStartTimes, boundedSampleEndTimes, ivbSampleHighs, ivbSampleLows, ivbSampleVolumes, ivbSampleDeltas)
int nyEarlyFirstSampleTime = na
int nyEarlyLastSampleEndTime = na
int extendedNyEarlyFirstSampleTime = na
int extendedNyEarlyLastSampleEndTime = na
int ivbFirstSampleTime = na
int ivbLastSampleEndTime = na
bool nyEarlyWindowObserved = false
bool extendedNyEarlyWindowObserved = false
bool extendedOpeningWindowObserved = false
bool ivbWindowObserved = false
bool boundedSessionSamplesRequired = asiaPremarketModeActive or nyEarlyModeActive or extendedNyEarlyModeActive or ivbModeActive
int subBarCount = array.size(intrabarVolumes)
if subBarCount > 0
    for subBarIndex = 0 to subBarCount - 1
        int subTime = array.get(intrabarTimes, subBarIndex)
        int subEndTime = array.get(intrabarEndTimes, subBarIndex)
        float subOpen = array.get(intrabarOpens, subBarIndex)
        float subHigh = array.get(intrabarHighs, subBarIndex)
        float subLow = array.get(intrabarLows, subBarIndex)
        float subClose = array.get(intrabarCloses, subBarIndex)
        float subVolume = array.get(intrabarVolumes, subBarIndex)
        int rangeSampleCutoffTime = na(time_close) ? timenow : time_close
        bool rangeIntrabarClosed = not na(subEndTime) and subEndTime <= rangeSampleCutoffTime
        bool rangeIntrabarUsable = rangeIntrabarClosed or not barstate.isconfirmed
        bool acceptRangeSample = not chart.is_range or (rangeIntrabarUsable and (na(lastAcceptedRangeIntrabarTime) or subTime > lastAcceptedRangeIntrabarTime))
        bool boundedDayAllowed = boundedSessionSamplesRequired and (isTwentyFourSevenAsset or isNyWeekday(subTime))
        bool asiaPremarketDayAllowed = asiaPremarketModeActive and (isTwentyFourSevenAsset or isNySessionTradingDay(subTime, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE))
        bool subInAsiaPremarket = asiaPremarketDayAllowed and inNyMinuteWindow(subTime, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE)
        bool subInNyEarly = nyEarlyModeActive and boundedDayAllowed and inNyMinuteWindow(subTime, NY_EARLY_START_MINUTE, NY_EARLY_END_MINUTE)
        bool subInExtendedNyEarly = extendedNyEarlyModeActive and boundedDayAllowed and inNyMinuteWindow(subTime, NY_EARLY_START_MINUTE, IVB_START_MINUTE)
        bool subInExtendedOpening = extendedNyEarlyModeActive and boundedDayAllowed and inNyMinuteWindow(subTime, IVB_START_MINUTE, EXTENDED_NY_EARLY_OPENING_END_MINUTE)
        bool subInIvb = ivbModeActive and boundedDayAllowed and inNyMinuteWindow(subTime, IVB_START_MINUTE, IVB_END_MINUTE)
        if subInNyEarly
            nyEarlyWindowObserved := true
            nyEarlyFirstSampleTime := na(nyEarlyFirstSampleTime) ? subTime : nyEarlyFirstSampleTime
            nyEarlyLastSampleEndTime := na(subEndTime) ? subTime : subEndTime
        if subInExtendedNyEarly
            extendedNyEarlyWindowObserved := true
            extendedNyEarlyFirstSampleTime := na(extendedNyEarlyFirstSampleTime) ? subTime : extendedNyEarlyFirstSampleTime
            extendedNyEarlyLastSampleEndTime := na(subEndTime) ? subTime : subEndTime
        if subInExtendedOpening
            extendedNyEarlyWindowObserved := true
            extendedOpeningWindowObserved := true
            extendedNyEarlyLastSampleEndTime := na(subEndTime) ? subTime : subEndTime
        if subInIvb
            ivbWindowObserved := true
            ivbFirstSampleTime := na(ivbFirstSampleTime) ? subTime : ivbFirstSampleTime
            ivbLastSampleEndTime := na(subEndTime) ? subTime : subEndTime
        if acceptRangeSample and not na(subVolume) and subVolume > 0 and not na(subHigh) and not na(subLow)
            int direction = na(subOpen) or na(subClose) ? lastTickDirection : subClose > subOpen ? 1 : subClose < subOpen ? -1 : not na(previousTapeClose) and subClose > previousTapeClose ? 1 : not na(previousTapeClose) and subClose < previousTapeClose ? -1 : lastTickDirection
            lastTickDirection := direction
            if not na(subClose)
                previousTapeClose := subClose
            if chart.is_range and rangeIntrabarClosed
                lastAcceptedRangeIntrabarTime := subTime
            float subDelta = subVolume * direction
            array.push(barSampleStartTimes, subTime)
            array.push(barSampleEndTimes, na(subEndTime) ? subTime + 1 : subEndTime)
            appendBarSample(barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, subHigh, subLow, subVolume, subDelta)
            if subInAsiaPremarket
                appendBarSample(asiaPremarketSampleHighs, asiaPremarketSampleLows, asiaPremarketSampleVolumes, asiaPremarketSampleDeltas, subHigh, subLow, subVolume, subDelta)
                array.push(asiaPremarketSampleSessionStarts, nySessionStartBoundary(subTime, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE))
                array.push(asiaPremarketSampleEndTimes, na(subEndTime) ? subTime : subEndTime)
            if subInNyEarly
                appendBarSample(nyEarlySampleHighs, nyEarlySampleLows, nyEarlySampleVolumes, nyEarlySampleDeltas, subHigh, subLow, subVolume, subDelta)
            if subInExtendedNyEarly
                appendBarSample(extendedNyEarlySampleHighs, extendedNyEarlySampleLows, extendedNyEarlySampleVolumes, extendedNyEarlySampleDeltas, subHigh, subLow, subVolume, subDelta)
            if subInExtendedOpening
                appendBarSample(extendedOpeningSampleHighs, extendedOpeningSampleLows, extendedOpeningSampleVolumes, extendedOpeningSampleDeltas, subHigh, subLow, subVolume, subDelta)
            if subInIvb
                appendBarSample(ivbSampleHighs, ivbSampleLows, ivbSampleVolumes, ivbSampleDeltas, subHigh, subLow, subVolume, subDelta)
bool fallbackBarValid = not na(volume) and volume > 0 and not na(high) and not na(low)
bool barSampleFallbackRequired = fallbackBarValid and array.size(barSampleVolumes) == 0
bool fallbackDayAllowed = boundedSessionSamplesRequired and (isTwentyFourSevenAsset or isNyWeekday(time))
bool asiaPremarketFallbackDayAllowed = isTwentyFourSevenAsset or isNySessionTradingDay(time, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE)
bool asiaPremarketSampleFallbackRequired = fallbackBarValid and asiaPremarketModeActive and array.size(asiaPremarketSampleVolumes) == 0 and asiaPremarketFallbackDayAllowed and barFitsNyMinuteWindow(time, time_close, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE)
bool nyEarlySampleFallbackRequired = fallbackBarValid and nyEarlyModeActive and array.size(nyEarlySampleVolumes) == 0 and fallbackDayAllowed and barFitsNyMinuteWindow(time, time_close, NY_EARLY_START_MINUTE, NY_EARLY_END_MINUTE)
bool extendedNyEarlySampleFallbackRequired = fallbackBarValid and extendedNyEarlyModeActive and array.size(extendedNyEarlySampleVolumes) == 0 and fallbackDayAllowed and barFitsNyMinuteWindow(time, time_close, NY_EARLY_START_MINUTE, IVB_START_MINUTE)
bool extendedOpeningSampleFallbackRequired = fallbackBarValid and extendedNyEarlyModeActive and array.size(extendedOpeningSampleVolumes) == 0 and fallbackDayAllowed and barFitsNyMinuteWindow(time, time_close, IVB_START_MINUTE, EXTENDED_NY_EARLY_OPENING_END_MINUTE)
bool ivbSampleFallbackRequired = fallbackBarValid and ivbModeActive and array.size(ivbSampleVolumes) == 0 and fallbackDayAllowed and barFitsNyMinuteWindow(time, time_close, IVB_START_MINUTE, IVB_END_MINUTE)
if barSampleFallbackRequired or asiaPremarketSampleFallbackRequired or nyEarlySampleFallbackRequired or extendedNyEarlySampleFallbackRequired or extendedOpeningSampleFallbackRequired or ivbSampleFallbackRequired
    int fallbackDirection = close > open ? 1 : close < open ? -1 : not na(previousTapeClose) and close > previousTapeClose ? 1 : not na(previousTapeClose) and close < previousTapeClose ? -1 : lastTickDirection
    float fallbackDelta = volume * fallbackDirection
    int fallbackEndTime = na(time_close) ? timenow : time_close
    if barSampleFallbackRequired
        lastTickDirection := fallbackDirection
        previousTapeClose := close
        array.push(barSampleStartTimes, time)
        array.push(barSampleEndTimes, math.max(time + 1, fallbackEndTime))
        appendBarSample(barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, high, low, volume, fallbackDelta)
    if asiaPremarketSampleFallbackRequired
        appendBarSample(asiaPremarketSampleHighs, asiaPremarketSampleLows, asiaPremarketSampleVolumes, asiaPremarketSampleDeltas, high, low, volume, fallbackDelta)
        array.push(asiaPremarketSampleSessionStarts, nySessionStartBoundary(time, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE))
        array.push(asiaPremarketSampleEndTimes, fallbackEndTime)
    if nyEarlySampleFallbackRequired
        appendBarSample(nyEarlySampleHighs, nyEarlySampleLows, nyEarlySampleVolumes, nyEarlySampleDeltas, high, low, volume, fallbackDelta)
        nyEarlyWindowObserved := true
        nyEarlyFirstSampleTime := time
        nyEarlyLastSampleEndTime := fallbackEndTime
    if extendedNyEarlySampleFallbackRequired
        appendBarSample(extendedNyEarlySampleHighs, extendedNyEarlySampleLows, extendedNyEarlySampleVolumes, extendedNyEarlySampleDeltas, high, low, volume, fallbackDelta)
        extendedNyEarlyWindowObserved := true
        extendedNyEarlyFirstSampleTime := time
        extendedNyEarlyLastSampleEndTime := fallbackEndTime
    if extendedOpeningSampleFallbackRequired
        appendBarSample(extendedOpeningSampleHighs, extendedOpeningSampleLows, extendedOpeningSampleVolumes, extendedOpeningSampleDeltas, high, low, volume, fallbackDelta)
        extendedNyEarlyWindowObserved := true
        extendedOpeningWindowObserved := true
        extendedNyEarlyLastSampleEndTime := fallbackEndTime
    if ivbSampleFallbackRequired
        appendBarSample(ivbSampleHighs, ivbSampleLows, ivbSampleVolumes, ivbSampleDeltas, high, low, volume, fallbackDelta)
        ivbWindowObserved := true
        ivbFirstSampleTime := time
        ivbLastSampleEndTime := fallbackEndTime

array<int> fomcSampleSessionStarts = array.new<int>()
legilimensProfile.SampleBatch fomcSamples = selectNySessionSamples(barSamples, fomcModeActive, FOMC_START_MINUTE, fomcEndMinute, isTwentyFourSevenAsset, not fomcForceOn, fomcSampleSessionStarts)
array<int> overnightNineSampleSessionStarts = array.new<int>()
legilimensProfile.SampleBatch overnightNineSamples = selectNySessionSamples(barSamples, overnightNineModeActive, OVERNIGHT_NINE_START_MINUTE, OVERNIGHT_NINE_END_MINUTE, isTwentyFourSevenAsset, false, overnightNineSampleSessionStarts)
array<int> nyAfternoonSampleSessionStarts = array.new<int>()
array<int> allDayToAfternoonSampleSessionStarts = array.new<int>()
legilimensProfile.SampleBatch nyAfternoonSamples = selectNySessionSamples(barSamples, nyAfternoonModeActive, NY_AFTERNOON_START_MINUTE, AFTERNOON_END_MINUTE, isTwentyFourSevenAsset, false, nyAfternoonSampleSessionStarts)
legilimensProfile.SampleBatch allDayToAfternoonSamples = selectNySessionSamples(barSamples, allDayToAfternoonModeActive, ALL_DAY_TO_AFTERNOON_START_MINUTE, AFTERNOON_END_MINUTE, isTwentyFourSevenAsset, false, allDayToAfternoonSampleSessionStarts)

array<int> midnightSampleSessionStarts = array.new<int>()
int midnightSampleCount = array.size(barSampleStartTimes)
if midnightModeActive and midnightSampleCount > 0
    for sampleIndex = 0 to midnightSampleCount - 1
        array.push(midnightSampleSessionStarts, nySessionStartBoundary(array.get(barSampleStartTimes, sampleIndex), NY_MIDNIGHT_MINUTE, NY_MIDNIGHT_MINUTE))
int midnightCurrentSessionStart = midnightModeActive ? (midnightSampleCount > 0 ? array.get(midnightSampleSessionStarts, midnightSampleCount - 1) : nySessionStartBoundary(time, NY_MIDNIGHT_MINUTE, NY_MIDNIGHT_MINUTE)) : START_TIME_UNSET

int chartTimeframeSeconds = timeframe.in_seconds(timeframe.period)
bool openingChartBarContained = not na(chartTimeframeSeconds) and chartTimeframeSeconds <= EXTENDED_NY_EARLY_OPENING_DURATION_MINUTES * SECONDS_PER_MINUTE and inNyMinuteWindow(time, IVB_START_MINUTE, EXTENDED_NY_EARLY_OPENING_END_MINUTE) and time_close <= nyMinuteBoundary(time, EXTENDED_NY_EARLY_OPENING_END_MINUTE)
bool storedExtendedRangeReady = array.size(extendedNyEarlyAnchor.highs) > 0 and array.size(extendedNyEarlyAnchor.lows) > 0
bool currentExtendedRangeReady = array.size(extendedNyEarlySampleHighs) > 0 and array.size(extendedNyEarlySampleLows) > 0
bool extendedRangeReady = extendedOpeningWindowObserved and (storedExtendedRangeReady or currentExtendedRangeReady)
float storedExtendedRangeHigh = storedExtendedRangeReady ? array.max(extendedNyEarlyAnchor.highs) : na
float storedExtendedRangeLow = storedExtendedRangeReady ? array.min(extendedNyEarlyAnchor.lows) : na
float currentExtendedRangeHigh = currentExtendedRangeReady ? array.max(extendedNyEarlySampleHighs) : na
float currentExtendedRangeLow = currentExtendedRangeReady ? array.min(extendedNyEarlySampleLows) : na
float extendedRangeHigh = storedExtendedRangeReady and currentExtendedRangeReady ? math.max(storedExtendedRangeHigh, currentExtendedRangeHigh) : storedExtendedRangeReady ? storedExtendedRangeHigh : currentExtendedRangeHigh
float extendedRangeLow = storedExtendedRangeReady and currentExtendedRangeReady ? math.min(storedExtendedRangeLow, currentExtendedRangeLow) : storedExtendedRangeReady ? storedExtendedRangeLow : currentExtendedRangeLow
bool sampledOpeningBreak = extendedRangeReady and array.size(extendedOpeningSampleVolumes) > 0 and (array.max(extendedOpeningSampleHighs) > extendedRangeHigh or array.min(extendedOpeningSampleLows) < extendedRangeLow)
bool chartOpeningBreak = extendedRangeReady and openingChartBarContained and (high > extendedRangeHigh or low < extendedRangeLow)
bool extendedOpeningBreakThisBar = extendedOpeningWindowObserved and extendedRangeReady and (sampledOpeningBreak or chartOpeningBreak)
bool extendedOpeningQualifiedThisBar = extendedOpeningWindowObserved and (extendedOpeningQualified or extendedOpeningBreakThisBar)
if extendedOpeningQualifiedThisBar
    if not extendedOpeningQualified
        appendSamples(extendedNyEarlySampleHighs, extendedNyEarlySampleLows, extendedNyEarlySampleVolumes, extendedNyEarlySampleDeltas, extendedOpeningPendingHighs, extendedOpeningPendingLows, extendedOpeningPendingVolumes, extendedOpeningPendingDeltas, false)
    appendSamples(extendedNyEarlySampleHighs, extendedNyEarlySampleLows, extendedNyEarlySampleVolumes, extendedNyEarlySampleDeltas, extendedOpeningSampleHighs, extendedOpeningSampleLows, extendedOpeningSampleVolumes, extendedOpeningSampleDeltas, false)

int asiaPremarketEvaluationTime = str.contains(syminfo.tickerid, "replay") ? time : barstate.isrealtime ? timenow : na(time_close) ? time : time_close
bool asiaPremarketEvaluationDayAllowed = isTwentyFourSevenAsset or isNySessionTradingDay(asiaPremarketEvaluationTime, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE)
bool asiaPremarketEvaluationInSession = asiaPremarketModeActive and asiaPremarketEvaluationDayAllowed and inNyMinuteWindow(asiaPremarketEvaluationTime, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE)
bool asiaPremarketInSession = asiaPremarketEvaluationInSession
int asiaPremarketCurrentSessionStart = asiaPremarketInSession ? nySessionStartBoundary(asiaPremarketEvaluationTime, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE) : START_TIME_UNSET
int boundedSessionEvaluationTime = str.contains(syminfo.tickerid, "replay") ? time : barstate.isrealtime ? timenow : na(time_close) ? time : time_close
int fomcCurrentSessionStart = activeNySessionStart(boundedSessionEvaluationTime, fomcModeActive, FOMC_START_MINUTE, fomcEndMinute, isTwentyFourSevenAsset, not fomcForceOn)
bool fomcInSession = fomcCurrentSessionStart != START_TIME_UNSET
int overnightNineCurrentSessionStart = activeNySessionStart(boundedSessionEvaluationTime, overnightNineModeActive, OVERNIGHT_NINE_START_MINUTE, OVERNIGHT_NINE_END_MINUTE, isTwentyFourSevenAsset, false)
bool overnightNineInSession = overnightNineCurrentSessionStart != START_TIME_UNSET
int nyAfternoonCurrentSessionStart = activeNySessionStart(boundedSessionEvaluationTime, nyAfternoonModeActive, NY_AFTERNOON_START_MINUTE, AFTERNOON_END_MINUTE, isTwentyFourSevenAsset, false)
int allDayToAfternoonCurrentSessionStart = activeNySessionStart(boundedSessionEvaluationTime, allDayToAfternoonModeActive, ALL_DAY_TO_AFTERNOON_START_MINUTE, AFTERNOON_END_MINUTE, isTwentyFourSevenAsset, false)
bool nyAfternoonInSession = nyAfternoonCurrentSessionStart != START_TIME_UNSET
bool allDayToAfternoonInSession = allDayToAfternoonCurrentSessionStart != START_TIME_UNSET
int nyEarlyCurrentSessionStart = boundedNySessionStart(boundedSessionEvaluationTime, nyEarlyModeActive, nyEarlyWindowObserved, nyEarlyFirstSampleTime, NY_EARLY_START_MINUTE, NY_EARLY_END_MINUTE, isTwentyFourSevenAsset)
nyEarlyInSession = nyEarlyCurrentSessionStart != START_TIME_UNSET
nyEarlySessionStart = nyEarlyInSession and (na(nyEarlyCurrentSessionStart[1]) or nyEarlyCurrentSessionStart != nyEarlyCurrentSessionStart[1])
nyEarlySessionEnd = not nyEarlyInSession and nyEarlyInSession[1]
int extendedNyEarlyCurrentSessionStart = boundedNySessionStart(boundedSessionEvaluationTime, extendedNyEarlyModeActive, extendedNyEarlyWindowObserved, extendedNyEarlyFirstSampleTime, NY_EARLY_START_MINUTE, EXTENDED_NY_EARLY_OPENING_END_MINUTE, isTwentyFourSevenAsset)
extendedNyEarlyInSession = extendedNyEarlyCurrentSessionStart != START_TIME_UNSET
extendedNyEarlySessionStart = extendedNyEarlyInSession and (na(extendedNyEarlyCurrentSessionStart[1]) or extendedNyEarlyCurrentSessionStart != extendedNyEarlyCurrentSessionStart[1])
extendedNyEarlySessionEnd = not extendedNyEarlyInSession and extendedNyEarlyInSession[1]
int ivbCurrentSessionStart = boundedNySessionStart(boundedSessionEvaluationTime, ivbModeActive, ivbWindowObserved, ivbFirstSampleTime, IVB_START_MINUTE, IVB_END_MINUTE, isTwentyFourSevenAsset)
ivbInSession = ivbCurrentSessionStart != START_TIME_UNSET
ivbSessionStart = ivbInSession and (na(ivbCurrentSessionStart[1]) or ivbCurrentSessionStart != ivbCurrentSessionStart[1])
ivbSessionEnd = not ivbInSession and ivbInSession[1]

// ═══════════════════════════════════════════════════════════════════════════════
// PROFILE LIFECYCLE EXECUTION
// ═══════════════════════════════════════════════════════════════════════════════
if extendedNyEarlySessionStart
    clearSamples(extendedOpeningPendingHighs, extendedOpeningPendingLows, extendedOpeningPendingVolumes, extendedOpeningPendingDeltas)
    extendedOpeningQualified := false

legilimensOrchestration.processAnchor(rthAnchor, rthModeActive, sessionProfileRetention, rthInSession, rthSessionStart, rthSessionEnd, time, time[1], barstate.isconfirmed, barSamples, false, PROFILE_ROWS, syminfo.mintick)
legilimensOrchestration.processAnchor(globexAnchor, globexModeActive, sessionProfileRetention, true, globexDayStart, false, time, time[1], barstate.isconfirmed, barSamples, false, PROFILE_ROWS, syminfo.mintick)
legilimensOrchestration.processKeyedBoundedNyAnchor(midnightAnchor, midnightModeActive, sessionProfileRetention, NY_MIDNIGHT_MINUTE, NY_MIDNIGHT_MINUTE, true, midnightCurrentSessionStart, midnightSampleSessionStarts, barSampleEndTimes, barSamples, PROFILE_ROWS, syminfo.mintick)
legilimensOrchestration.processKeyedBoundedNyAnchor(asiaPremarketAnchor, asiaPremarketModeActive, sessionProfileRetention, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE, asiaPremarketInSession, asiaPremarketCurrentSessionStart, asiaPremarketSampleSessionStarts, asiaPremarketSampleEndTimes, asiaPremarketSamples, PROFILE_ROWS, syminfo.mintick)
legilimensOrchestration.processKeyedBoundedNyAnchor(fomcAnchor, fomcModeActive, sessionProfileRetention, FOMC_START_MINUTE, fomcEndMinute, fomcInSession, fomcCurrentSessionStart, fomcSampleSessionStarts, fomcSamples.endTimes, fomcSamples, PROFILE_ROWS, syminfo.mintick)
legilimensOrchestration.processKeyedBoundedNyAnchor(overnightNineAnchor, overnightNineModeActive, sessionProfileRetention, OVERNIGHT_NINE_START_MINUTE, OVERNIGHT_NINE_END_MINUTE, overnightNineInSession, overnightNineCurrentSessionStart, overnightNineSampleSessionStarts, overnightNineSamples.endTimes, overnightNineSamples, PROFILE_ROWS, syminfo.mintick)
legilimensOrchestration.processKeyedBoundedNyAnchor(nyAfternoonAnchor, nyAfternoonModeActive, sessionProfileRetention, NY_AFTERNOON_START_MINUTE, AFTERNOON_END_MINUTE, nyAfternoonInSession, nyAfternoonCurrentSessionStart, nyAfternoonSampleSessionStarts, nyAfternoonSamples.endTimes, nyAfternoonSamples, PROFILE_ROWS, syminfo.mintick)
legilimensOrchestration.processKeyedBoundedNyAnchor(allDayToAfternoonAnchor, allDayToAfternoonModeActive, sessionProfileRetention, ALL_DAY_TO_AFTERNOON_START_MINUTE, AFTERNOON_END_MINUTE, allDayToAfternoonInSession, allDayToAfternoonCurrentSessionStart, allDayToAfternoonSampleSessionStarts, allDayToAfternoonSamples.endTimes, allDayToAfternoonSamples, PROFILE_ROWS, syminfo.mintick)
legilimensOrchestration.processBoundedNyAnchor(nyEarlyAnchor, nyEarlyModeActive, sessionProfileRetention, NY_EARLY_START_MINUTE, NY_EARLY_END_MINUTE, nyEarlyInSession, nyEarlySessionStart, nyEarlySessionEnd, nyEarlyCurrentSessionStart, nyEarlyLastSampleEndTime, barstate.isconfirmed, nyEarlySamples, PROFILE_ROWS, syminfo.mintick)
legilimensOrchestration.processBoundedNyAnchor(extendedNyEarlyAnchor, extendedNyEarlyModeActive, sessionProfileRetention, NY_EARLY_START_MINUTE, extendedOpeningQualifiedThisBar ? EXTENDED_NY_EARLY_OPENING_END_MINUTE : IVB_START_MINUTE, extendedNyEarlyInSession, extendedNyEarlySessionStart, extendedNyEarlySessionEnd, extendedNyEarlyCurrentSessionStart, extendedNyEarlyLastSampleEndTime, barstate.isconfirmed, extendedNyEarlySamples, PROFILE_ROWS, syminfo.mintick)
legilimensOrchestration.processBoundedNyAnchor(ivbAnchor, ivbModeActive, sessionProfileRetention, IVB_START_MINUTE, IVB_END_MINUTE, ivbInSession, ivbSessionStart, ivbSessionEnd, ivbCurrentSessionStart, ivbLastSampleEndTime, barstate.isconfirmed, ivbSamples, PROFILE_ROWS, syminfo.mintick)

if barstate.isconfirmed and extendedOpeningWindowObserved
    if extendedOpeningQualifiedThisBar
        clearSamples(extendedOpeningPendingHighs, extendedOpeningPendingLows, extendedOpeningPendingVolumes, extendedOpeningPendingDeltas)
        extendedOpeningQualified := true
    else
        appendSamples(extendedOpeningPendingHighs, extendedOpeningPendingLows, extendedOpeningPendingVolumes, extendedOpeningPendingDeltas, extendedOpeningSampleHighs, extendedOpeningSampleLows, extendedOpeningSampleVolumes, extendedOpeningSampleDeltas, false)
if extendedNyEarlySessionEnd
    clearSamples(extendedOpeningPendingHighs, extendedOpeningPendingLows, extendedOpeningPendingVolumes, extendedOpeningPendingDeltas)
    extendedOpeningQualified := false

legilimensOrchestration.processAnchor(weeklyAnchor, calendarWeeklyModeActive, sessionProfileRetention, true, weeklyPeriodStart, false, time, time[1], barstate.isconfirmed, barSamples, true, PROFILE_ROWS, syminfo.mintick)
legilimensOrchestration.processAnchor(monthlyAnchor, calendarMonthlyModeActive, sessionProfileRetention, true, monthlyPeriodStart, false, time, time[1], barstate.isconfirmed, barSamples, false, PROFILE_ROWS, syminfo.mintick)
int rollingPeriodBarEndTime = na(time_close) ? time : time_close
legilimensOrchestration.processRollingPeriodAnchor(rollingPeriodAnchor, rollingPeriodSelected, rollingWindowLookbackDays, rollingPeriodOldestStart, rollingRangeEnd, isTwentyFourSevenAsset, barstate.isconfirmed, rollingPeriodBarEndTime, barSamples, sessionProfileRetention, PROFILE_ROWS, syminfo.mintick)

bool fixedRangeBarMayOverlap = fixedRangeEnabled and fixedRangeConfigured and time < fixedRangeEnd and (na(time_close) or time_close > fixedRangeStart)
bool rollingRangeConfigured = rollingWindowModeActive and not na(last_bar_time)
bool rollingBarRetained = rollingSelected and rollingRangeConfigured and (na(time_close) ? time >= rollingRangeStart : time_close > rollingRangeStart)
bool includeCurrentRollingSamples = not barstate.isconfirmed and rollingBarRetained
if rollingSelected
    legilimensProfile.pruneRollingSamples(rollingSamples, rollingRangeStart)
if barstate.isconfirmed
    if rollingBarRetained
        legilimensProfile.appendRollingSamples(rollingSamples, barSamples, rollingLookbackDays)
    if fixedRangeBarMayOverlap
        appendContainedSamples(fixedBarHighs, fixedBarLows, fixedBarVolumes, fixedBarDeltas, barSamples, fixedRangeStart, fixedRangeEnd, true)

legilimensPresentation.registerFinalizedProfiles(presentationState, rthAnchor, rthPresentationSource, presentationSources, presentationContext, presentationConfig)
legilimensPresentation.registerFinalizedProfiles(presentationState, nyAfternoonAnchor, nyAfternoonPresentationSource, presentationSources, presentationContext, presentationConfig)
legilimensPresentation.registerFinalizedProfiles(presentationState, allDayToAfternoonAnchor, allDayToAfternoonPresentationSource, presentationSources, presentationContext, presentationConfig)
legilimensPresentation.registerFinalizedProfiles(presentationState, globexAnchor, globexPresentationSource, presentationSources, presentationContext, presentationConfig)
legilimensPresentation.registerFinalizedProfiles(presentationState, midnightAnchor, midnightPresentationSource, presentationSources, presentationContext, presentationConfig)
legilimensPresentation.registerFinalizedProfiles(presentationState, asiaPremarketAnchor, asiaPremarketPresentationSource, presentationSources, presentationContext, presentationConfig)
legilimensPresentation.registerFinalizedProfiles(presentationState, fomcAnchor, fomcPresentationSource, presentationSources, presentationContext, presentationConfig)
legilimensPresentation.registerFinalizedProfiles(presentationState, overnightNineAnchor, overnightNinePresentationSource, presentationSources, presentationContext, presentationConfig)
legilimensPresentation.registerFinalizedProfiles(presentationState, nyEarlyAnchor, nyEarlyPresentationSource, presentationSources, presentationContext, presentationConfig)
legilimensPresentation.registerFinalizedProfiles(presentationState, extendedNyEarlyAnchor, extendedNyEarlyPresentationSource, presentationSources, presentationContext, presentationConfig)
legilimensPresentation.registerFinalizedProfiles(presentationState, ivbAnchor, ivbPresentationSource, presentationSources, presentationContext, presentationConfig)
legilimensPresentation.registerFinalizedProfiles(presentationState, weeklyAnchor, weeklyPresentationSource, presentationSources, presentationContext, presentationConfig)
legilimensPresentation.registerFinalizedProfiles(presentationState, monthlyAnchor, monthlyPresentationSource, presentationSources, presentationContext, presentationConfig)
if weeklyRollingSelected
    legilimensPresentation.registerFinalizedProfiles(presentationState, rollingPeriodAnchor, weeklyPresentationSource, presentationSources, presentationContext, presentationConfig)
else if monthlyRollingSelected
    legilimensPresentation.registerFinalizedProfiles(presentationState, rollingPeriodAnchor, monthlyPresentationSource, presentationSources, presentationContext, presentationConfig)

int zoneTrackingEvaluationTime = presentationContext.barEndTime
if extendUnmitigated and fixedRangeEnabled and fixedRangeConfigured and not fixedZoneTrackingProfileRegistered and zoneTrackingEvaluationTime >= fixedRangeEnd and array.size(fixedBarVolumes) > 0
    legilimensOrchestration.Profile completedFixedProfile = buildProfile(fixedBarHighs, fixedBarLows, fixedBarVolumes, fixedBarDeltas, PROFILE_ROWS, fixedRangeStart, fixedRangeEnd)
    if completedFixedProfile.data.isValid
        legilimensPresentation.registerProfileZones(presentationState, completedFixedProfile, fixedPresentationSource, presentationSources, presentationContext, presentationConfig)
        fixedZoneTrackingProfileRegistered := true
bool rollingZoneTrackingProfileChanged = na(registeredRollingZoneTrackingEndTime) or registeredRollingZoneTrackingEndTime != rollingRangeEnd
bool rollingLiveZoneTrackingRefresh = rollingWindowThrough == ROLLING_THROUGH_LIVE and not barstate.isconfirmed
bool rollingZoneTrackingSamplesAvailable = legilimensProfile.rollingSampleStoreSize(rollingSamples) > 0 or (includeCurrentRollingSamples and array.size(barSampleVolumes) > 0)
if extendUnmitigated and rollingSelected and rollingRangeConfigured and (rollingZoneTrackingProfileChanged or rollingLiveZoneTrackingRefresh) and zoneTrackingEvaluationTime >= rollingRangeEnd and rollingZoneTrackingSamplesAvailable
    legilimensOrchestration.Profile completedRollingProfile = buildCurrentRollingProfile(rollingSamples, barSamples, includeCurrentRollingSamples, rollingProfileWindow, PROFILE_ROWS)
    if completedRollingProfile.data.isValid
        legilimensPresentation.clearSourceInteractions(presentationState, SOURCE_ROLLING)
        legilimensPresentation.registerProfileZones(presentationState, completedRollingProfile, rollingPresentationSource, presentationSources, presentationContext, presentationConfig)
        registeredRollingZoneTrackingEndTime := rollingRangeEnd

array<int> zoneBoundaryTimes = array.new<int>()
array<int> zoneBoundaryEndTimes = array.new<int>()
array<float> zoneBoundaryHighs = array.new<float>()
array<float> zoneBoundaryLows = array.new<float>()
legilimensPresentation.PriceSamples profilePriceSamples = legilimensPresentation.PriceSamples.new(intrabarTimes, intrabarEndTimes, intrabarHighs, intrabarLows)
string requestedZoneBoundaryTimeframe = legilimensPresentation.requiredBoundaryTimeframe(presentationState, intrabarTimeframe, presentationContext, presentationConfig)
if requestedZoneBoundaryTimeframe != ""
    [requestedBoundaryTimes, requestedBoundaryEndTimes, requestedBoundaryHighs, requestedBoundaryLows] = zoneBoundarySamples(requestedZoneBoundaryTimeframe)
    zoneBoundaryTimes := requestedBoundaryTimes
    zoneBoundaryEndTimes := requestedBoundaryEndTimes
    zoneBoundaryHighs := requestedBoundaryHighs
    zoneBoundaryLows := requestedBoundaryLows
legilimensPresentation.PriceSamples boundaryPriceSamples = legilimensPresentation.PriceSamples.new(zoneBoundaryTimes, zoneBoundaryEndTimes, zoneBoundaryHighs, zoneBoundaryLows)
legilimensPresentation.updateInteractions(presentationState, profilePriceSamples, boundaryPriceSamples, intrabarTimeframe, presentationContext, presentationConfig)

// ═══════════════════════════════════════════════════════════════════════════════
// CHART VISIBILITY
// ═══════════════════════════════════════════════════════════════════════════════
inVisibleOvernight = not na(time(timeframe.period, SESSION_WINDOW_OVERNIGHT, NY_TIMEZONE))
inVisibleFrom0500 = not na(time(timeframe.period, SESSION_WINDOW_FROM_0500, NY_TIMEZONE))
inVisibleFrom0830 = not na(time(timeframe.period, SESSION_WINDOW_FROM_0830, NY_TIMEZONE))
inVisibleRth = not na(time(timeframe.period, SESSION_WINDOW_RTH, NY_TIMEZONE))
inVisibleWindow = visibleWindow == WINDOW_LABEL_FROM_0500 ? inVisibleFrom0500 : visibleWindow == WINDOW_LABEL_FROM_0830 ? inVisibleFrom0830 : visibleWindow == WINDOW_LABEL_RTH ? inVisibleRth : inVisibleOvernight
inMostRecentDay = sameCalendarDate(time, timenow, NY_TIMEZONE)
showOnlyTimeframeAllowed = chart.is_range or timeframe.in_seconds(timeframe.period) <= SHOW_ONLY_MAX_TIMEFRAME_SECONDS
hideThisBar = showOnlyEnabled and showOnlyTimeframeAllowed and not (inVisibleWindow and (not showOnlyMostRecent or inMostRecentDay))

plotcandle(hideThisBar ? open : na, high, low, close, title="Hidden Candles", color=hiddenCandleColor, bordercolor=hiddenCandleColor, wickcolor=hiddenCandleColor, editable=false, display=display.pane, force_overlay=true)

// ═══════════════════════════════════════════════════════════════════════════════
// FINAL RENDER PASS
// ═══════════════════════════════════════════════════════════════════════════════
if barstate.islast
    legilimensPresentation.beginFrame(presentationState)

    if showFocusAnchorGuide and focusSearchActive and not na(presentationFocusSettings.anchorPrice)
        string focusGuideSource = ""
        for profileSource in presentationSources
            if profileSource.selected and profileSource.key != SOURCE_FIXED and profileSource.key != SOURCE_ROLLING
                focusGuideSource := profileSource.key
                break
        color focusGuideLineColor = legilimensPresentation.profileOuterColor(focusGuideSource)
        color focusGuideLabelColor = legilimensPresentation.profileRangeLabelColor(focusGuideSource)
        string focusGuideLabelSize = legilimensPresentation.profileRangeLabelFontSize(focusGuideSource)
        if na(focusAnchorGuide)
            focusAnchorGuide := line.new(time, presentationFocusSettings.anchorPrice, time + 1, presentationFocusSettings.anchorPrice, xloc=xloc.bar_time, extend=extend.both, color=focusGuideLineColor, style=line.style_solid, width=1)
        else
            line.set_xy1(focusAnchorGuide, time, presentationFocusSettings.anchorPrice)
            line.set_xy2(focusAnchorGuide, time + 1, presentationFocusSettings.anchorPrice)
            line.set_color(focusAnchorGuide, focusGuideLineColor)
        string focusGuideMode = str.lower(str.tostring(focusDirection))
        string focusGuideCaption = "legilimens • focus • " + focusGuideMode + " " + str.tostring(presentationFocusSettings.anchorPrice, format.mintick)
        if na(focusAnchorLabel)
            focusAnchorLabel := label.new(time, presentationFocusSettings.anchorPrice, focusGuideCaption, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(color.rgb(120, 123, 134), 100), textcolor=focusGuideLabelColor, size=focusGuideLabelSize)
        else
            label.set_xy(focusAnchorLabel, time, presentationFocusSettings.anchorPrice)
            label.set_text(focusAnchorLabel, focusGuideCaption)
            label.set_textcolor(focusAnchorLabel, focusGuideLabelColor)
            label.set_size(focusAnchorLabel, focusGuideLabelSize)
    else
        if not na(focusAnchorGuide)
            line.delete(focusAnchorGuide)
            focusAnchorGuide := na
        if not na(focusAnchorLabel)
            label.delete(focusAnchorLabel)
            focusAnchorLabel := na

    legilimensOrchestration.Profile rollingProfile = na
    if rollingSelected and rollingRangeConfigured
        rollingProfile := buildCurrentRollingProfile(rollingSamples, barSamples, includeCurrentRollingSamples, rollingProfileWindow, PROFILE_ROWS)

    legilimensOrchestration.Profile fixedProfile = na
    if fixedRangeEnabled and fixedRangeConfigured
        int originalSize = array.size(fixedBarVolumes)
        if not barstate.isconfirmed and fixedRangeBarMayOverlap
            appendContainedSamples(fixedBarHighs, fixedBarLows, fixedBarVolumes, fixedBarDeltas, barSamples, fixedRangeStart, fixedRangeEnd, false)
        fixedProfile := buildProfile(fixedBarHighs, fixedBarLows, fixedBarVolumes, fixedBarDeltas, PROFILE_ROWS, fixedRangeStart, math.min(fixedRangeEnd, time))
        while array.size(fixedBarVolumes) > originalSize
            array.pop(fixedBarHighs)
            array.pop(fixedBarLows)
            array.pop(fixedBarVolumes)
            array.pop(fixedBarDeltas)

    array<float> keyedNoSampleHighs = array.new<float>()
    array<float> keyedNoSampleLows = array.new<float>()
    array<float> keyedNoSampleVolumes = array.new<float>()
    array<float> keyedNoSampleDeltas = array.new<float>()
    legilimensProfile.SampleBatch keyedNoSamples = legilimensProfile.SampleBatch.new(boundedSampleStartTimes, boundedSampleEndTimes, keyedNoSampleHighs, keyedNoSampleLows, keyedNoSampleVolumes, keyedNoSampleDeltas)
    int midnightStoredEndTime = midnightAnchor.lastBarTime
    int midnightDevelopingSampleEndTime = midnightStoredEndTime == START_TIME_UNSET ? time : midnightStoredEndTime
    int midnightDevelopingEndTime = midnightCurrentSessionStart == START_TIME_UNSET ? midnightDevelopingSampleEndTime : math.min(midnightDevelopingSampleEndTime, nySessionEndBoundary(midnightCurrentSessionStart, NY_MIDNIGHT_MINUTE, NY_MIDNIGHT_MINUTE))
    int asiaPremarketStoredEndTime = asiaPremarketAnchor.lastBarTime
    int asiaPremarketDevelopingSampleEndTime = asiaPremarketStoredEndTime == START_TIME_UNSET ? asiaPremarketEvaluationTime : asiaPremarketStoredEndTime
    int asiaPremarketDevelopingEndTime = asiaPremarketInSession ? math.min(asiaPremarketDevelopingSampleEndTime, nySessionEndBoundary(asiaPremarketCurrentSessionStart, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE)) : asiaPremarketStoredEndTime
    int nyEarlyDevelopingEndTime = boundedNyDevelopingEnd(nyEarlyLastSampleEndTime, nyEarlyAnchor.lastBarTime, nyEarlyAnchor.startTime, NY_EARLY_END_MINUTE)
    int extendedNyEarlyDevelopingEndTime = boundedNyDevelopingEnd(extendedNyEarlyLastSampleEndTime, extendedNyEarlyAnchor.lastBarTime, extendedNyEarlyAnchor.startTime, extendedOpeningQualifiedThisBar ? EXTENDED_NY_EARLY_OPENING_END_MINUTE : IVB_START_MINUTE)
    int ivbDevelopingEndTime = boundedNyDevelopingEnd(ivbLastSampleEndTime, ivbAnchor.lastBarTime, ivbAnchor.startTime, IVB_END_MINUTE)

    legilimensOrchestration.ProfileSelection selectedSessionProfiles = na
    legilimensOrchestration.ProfileSelection selectedNyEarlyProfiles = na
    legilimensOrchestration.ProfileSelection selectedExtendedNyEarlyProfiles = na
    legilimensOrchestration.ProfileSelection selectedIvbProfiles = na
    legilimensPresentation.SourceSpec selectedPresentationSource = na
    bool groupedNyProfilesActive = nyEarlyModeActive and (extendedNyEarlyModeActive or ivbModeActive)
    if groupedNyProfilesActive
        if nyEarlyModeActive
            selectedNyEarlyProfiles := selectSessionProfiles(priorProfilesToShow, nyEarlyInSession, legilimensPresentation.developingProfileVisible(nyEarlyPresentationSource, presentationConfig), nyEarlyAnchor, nyEarlySamples, not barstate.isconfirmed, nyEarlyDevelopingEndTime)
        if extendedNyEarlyModeActive
            selectedExtendedNyEarlyProfiles := selectSessionProfiles(priorProfilesToShow, extendedNyEarlyInSession, legilimensPresentation.developingProfileVisible(extendedNyEarlyPresentationSource, presentationConfig), extendedNyEarlyAnchor, extendedNyEarlySamples, not barstate.isconfirmed, extendedNyEarlyDevelopingEndTime)
        if ivbModeActive
            selectedIvbProfiles := selectSessionProfiles(priorProfilesToShow, ivbInSession, legilimensPresentation.developingProfileVisible(ivbPresentationSource, presentationConfig), ivbAnchor, ivbSamples, not barstate.isconfirmed, ivbDevelopingEndTime)
    else if nyAfternoonModeActive
        selectedPresentationSource := nyAfternoonPresentationSource
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, nyAfternoonInSession, legilimensPresentation.developingProfileVisible(nyAfternoonPresentationSource, presentationConfig), nyAfternoonAnchor, keyedNoSamples, false, nyAfternoonAnchor.lastBarTime)
    else if allDayToAfternoonModeActive
        selectedPresentationSource := allDayToAfternoonPresentationSource
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, allDayToAfternoonInSession, legilimensPresentation.developingProfileVisible(allDayToAfternoonPresentationSource, presentationConfig), allDayToAfternoonAnchor, keyedNoSamples, false, allDayToAfternoonAnchor.lastBarTime)
    else if rthModeActive
        selectedPresentationSource := rthPresentationSource
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, rthInSession, legilimensPresentation.developingProfileVisible(rthPresentationSource, presentationConfig), rthAnchor, barSamples, not barstate.isconfirmed, time)
    else if globexModeActive
        selectedPresentationSource := globexPresentationSource
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, true, legilimensPresentation.developingProfileVisible(globexPresentationSource, presentationConfig), globexAnchor, barSamples, not barstate.isconfirmed, time)
    else if midnightModeActive
        selectedPresentationSource := midnightPresentationSource
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, true, legilimensPresentation.developingProfileVisible(midnightPresentationSource, presentationConfig), midnightAnchor, keyedNoSamples, false, midnightDevelopingEndTime)
    else if asiaPremarketModeActive
        selectedPresentationSource := asiaPremarketPresentationSource
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, asiaPremarketInSession, legilimensPresentation.developingProfileVisible(asiaPremarketPresentationSource, presentationConfig), asiaPremarketAnchor, keyedNoSamples, false, asiaPremarketDevelopingEndTime)
    else if fomcModeActive
        selectedPresentationSource := fomcPresentationSource
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, fomcInSession, legilimensPresentation.developingProfileVisible(fomcPresentationSource, presentationConfig), fomcAnchor, keyedNoSamples, false, fomcAnchor.lastBarTime)
    else if overnightNineModeActive
        selectedPresentationSource := overnightNinePresentationSource
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, overnightNineInSession, legilimensPresentation.developingProfileVisible(overnightNinePresentationSource, presentationConfig), overnightNineAnchor, keyedNoSamples, false, overnightNineAnchor.lastBarTime)
    else if nyEarlyModeActive
        selectedPresentationSource := nyEarlyPresentationSource
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, nyEarlyInSession, legilimensPresentation.developingProfileVisible(nyEarlyPresentationSource, presentationConfig), nyEarlyAnchor, nyEarlySamples, not barstate.isconfirmed, nyEarlyDevelopingEndTime)
    else if extendedNyEarlyModeActive
        selectedPresentationSource := extendedNyEarlyPresentationSource
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, extendedNyEarlyInSession, legilimensPresentation.developingProfileVisible(extendedNyEarlyPresentationSource, presentationConfig), extendedNyEarlyAnchor, extendedNyEarlySamples, not barstate.isconfirmed, extendedNyEarlyDevelopingEndTime)
    else if ivbModeActive
        selectedPresentationSource := ivbPresentationSource
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, ivbInSession, legilimensPresentation.developingProfileVisible(ivbPresentationSource, presentationConfig), ivbAnchor, ivbSamples, not barstate.isconfirmed, ivbDevelopingEndTime)
    else if rollingPeriodSelected
        if weeklyRollingSelected
            selectedPresentationSource := weeklyPresentationSource
        else
            selectedPresentationSource := monthlyPresentationSource
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, false, true, rollingPeriodAnchor, barSamples, false, rollingRangeEnd)
    else if calendarWeeklyModeActive
        selectedPresentationSource := weeklyPresentationSource
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, true, true, weeklyAnchor, barSamples, not barstate.isconfirmed, time)
    else if calendarMonthlyModeActive
        selectedPresentationSource := monthlyPresentationSource
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, true, true, monthlyAnchor, barSamples, not barstate.isconfirmed, time)

    array<legilimensPresentation.SelectionBinding> presentationBindings = array.new<legilimensPresentation.SelectionBinding>()
    if groupedNyProfilesActive
        if not na(selectedExtendedNyEarlyProfiles)
            array.push(presentationBindings, legilimensPresentation.SelectionBinding.new(selectedExtendedNyEarlyProfiles, extendedNyEarlyPresentationSource))
        if not na(selectedNyEarlyProfiles)
            array.push(presentationBindings, legilimensPresentation.SelectionBinding.new(selectedNyEarlyProfiles, nyEarlyPresentationSource))
        if not na(selectedIvbProfiles)
            array.push(presentationBindings, legilimensPresentation.SelectionBinding.new(selectedIvbProfiles, ivbPresentationSource))
    else if not na(selectedSessionProfiles) and not na(selectedPresentationSource)
        array.push(presentationBindings, legilimensPresentation.SelectionBinding.new(selectedSessionProfiles, selectedPresentationSource))

    bool hideDevelopingExtendedCounterpart = groupedNyProfilesActive and extendedNyEarlyInSession and not legilimensPresentation.developingProfileVisible(extendedNyEarlyPresentationSource, presentationConfig)
    if rollingSelected and not na(rollingProfile) and rollingProfile.data.isValid
        legilimensPresentation.renderStandaloneProfile(presentationState, rollingProfile, not rollingUsesClockCutoff(rollingWindowThrough), rollingPresentationSource, presentationSources, presentationContext, presentationConfig)
    else
        legilimensPresentation.renderSelections(presentationState, presentationBindings, hideDevelopingExtendedCounterpart, nyEarlyAnchor.startTime, presentationSources, presentationContext, presentationConfig)
    legilimensPresentation.flushFrame(presentationState, presentationContext, presentationConfig)

    if fixedRangeEnabled and not na(fixedProfile) and fixedProfile.data.isValid
        legilimensPresentation.renderStandaloneProfile(presentationState, fixedProfile, time < fixedRangeEnd, fixedPresentationSource, presentationSources, presentationContext, presentationConfig)
        legilimensPresentation.flushFrame(presentationState, presentationContext, presentationConfig)
    if showColorTable
        array<ColorRow> colorRows = array.new<ColorRow>()
        if showOnlyEnabled and showOnlyTimeframeAllowed
            addColorRow(colorRows, "Hidden Candles", hiddenCandleColor, "")
        if not na(colorTable)
            table.delete(colorTable)
        colorTable := table.new(position.top_right, 4, array.size(colorRows) + 1, bgcolor=color.rgb(255, 255, 255), border_width=1, border_color=color.rgb(128, 128, 128), frame_width=1, frame_color=color.rgb(128, 128, 128))
        table.cell(colorTable, 0, 0, LABEL_TABLE_SETTING, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        table.cell(colorTable, 1, 0, LABEL_TABLE_RGB, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        table.cell(colorTable, 2, 0, LABEL_TABLE_TRANSPARENCY, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        table.cell(colorTable, 3, 0, LABEL_TABLE_WIDTH, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        if array.size(colorRows) > 0
            for rowIndex = 0 to array.size(colorRows) - 1
                writeColorRow(colorTable, rowIndex + 1, array.get(colorRows, rowIndex))
    else if not na(colorTable)
        table.delete(colorTable)
        colorTable := na

// legilimens •
