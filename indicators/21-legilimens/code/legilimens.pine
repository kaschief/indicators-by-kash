var bool fixedZoneTrackingProfileRegistered = false
var int registeredRollingZoneTrackingEndTime = na

// ───────────────────────────────────────────────────────────────────────────────
// HELPERS — DATA ROUTING
// ───────────────────────────────────────────────────────────────────────────────
autoIntrabarTimeframe() =>
    float chartSeconds = timeframe.in_seconds(timeframe.period)
    chart.is_range ? INTRABAR_TIMEFRAME_ONE_MINUTE : chartSeconds <= SECONDS_PER_MINUTE ? INTRABAR_TIMEFRAME_ONE_SECOND : chartSeconds <= 15 * SECONDS_PER_MINUTE ? INTRABAR_TIMEFRAME_ONE_MINUTE : chartSeconds <= 60 * SECONDS_PER_MINUTE ? INTRABAR_TIMEFRAME_FIVE_MINUTES : chartSeconds <= 4 * 60 * SECONDS_PER_MINUTE ? INTRABAR_TIMEFRAME_FIFTEEN_MINUTES : INTRABAR_TIMEFRAME_ONE_HOUR

sameCalendarDate(int firstTime, int secondTime, string timezone) =>
    legilimensOrchestration.sameCalendarDate(firstTime, secondTime, timezone)

// ───────────────────────────────────────────────────────────────────────────────
// HELPERS — SESSION BOUNDARIES
// ───────────────────────────────────────────────────────────────────────────────
isTrueWeekendBar(int barTime) =>
    legilimensOrchestration.isTrueWeekendBar(barTime, SUNDAY_REOPEN_START_HOUR)

calendarDayStart(string timezone) =>
    legilimensOrchestration.calendarDayStart(time, timezone)

shiftedCalendarDayStart(string timezone, int timeShiftMilliseconds) =>
    legilimensOrchestration.shiftedCalendarDayStart(time, timezone, timeShiftMilliseconds)

shiftedCalendarMonthStart(string timezone, int timeShiftMilliseconds) =>
    legilimensOrchestration.shiftedCalendarMonthStart(time, timezone, timeShiftMilliseconds)

weeklyBoundary(bool twentyFourSeven, bool utcBoundary, bool futuresBoundary, int barTime) =>
    legilimensOrchestration.weeklyBoundary(twentyFourSeven, utcBoundary, futuresBoundary, barTime)

isNyWeekday(int barTime) =>
    legilimensOrchestration.isNyWeekday(barTime)

inNyMinuteWindow(int barTime, int startMinute, int endMinute) =>
    legilimensOrchestration.inNyMinuteWindow(barTime, startMinute, endMinute)

nyMinuteBoundary(int referenceTime, int minuteOfDay) =>
    legilimensOrchestration.nyMinuteBoundary(referenceTime, minuteOfDay)

nySessionStartBoundary(int referenceTime, int startMinute, int endMinute) =>
    legilimensOrchestration.nySessionStartBoundary(referenceTime, startMinute, endMinute)

nySessionEndBoundary(int referenceTime, int startMinute, int endMinute) =>
    legilimensOrchestration.nySessionEndBoundary(referenceTime, startMinute, endMinute)

isNySessionTradingDay(int barTime, int startMinute, int endMinute) =>
    legilimensOrchestration.isNySessionTradingDay(barTime, startMinute, endMinute)

barFitsNyMinuteWindow(int barTime, int barEndTime, int startMinute, int endMinute) =>
    legilimensOrchestration.barFitsNyMinuteWindow(barTime, barEndTime, startMinute, endMinute)

// Preserve NY clock time across DST.
lookbackDaysStart(int endTime, int days, bool twentyFourSeven) =>
    legilimensOrchestration.lookbackDaysStart(endTime, days, twentyFourSeven)

rollingFocusPeriodCount(int endTime, int firstBarTime, int periodDays, int recentPeriodCount, int searchDepth) =>
    int availableCalendarDays = math.max(1, int(math.ceil((endTime - firstBarTime) / float(24 * MS_PER_HOUR))))
    math.min(searchDepth, math.max(recentPeriodCount, int(math.ceil(availableCalendarDays / float(periodDays))) + 1))

rollingClockCutoffMinute(string throughMode) =>
    switch throughMode
        ROLLING_THROUGH_0000 => ROLLING_CUTOFF_0000_MINUTE
        ROLLING_THROUGH_0500 => ROLLING_CUTOFF_0500_MINUTE
        ROLLING_THROUGH_0830 => ROLLING_CUTOFF_0830_MINUTE
        ROLLING_THROUGH_0930 => ROLLING_CUTOFF_0930_MINUTE
        ROLLING_THROUGH_1600 => ROLLING_CUTOFF_1600_MINUTE
        ROLLING_THROUGH_1800 => ROLLING_CUTOFF_1800_MINUTE
        => na

rollingThroughTime(int referenceTime, string throughMode, bool twentyFourSeven) =>
    int endTime = referenceTime
    int cutoffMinuteOfDay = rollingClockCutoffMinute(throughMode)
    if (throughMode == ROLLING_THROUGH_LIVE_MINUS_2H or throughMode == ROLLING_THROUGH_LIVE_MINUS_4H) and not na(referenceTime)
        int liveOffsetHours = throughMode == ROLLING_THROUGH_LIVE_MINUS_2H ? 2 : 4
        endTime := referenceTime - liveOffsetHours * MS_PER_HOUR
    else if not na(cutoffMinuteOfDay) and not na(referenceTime)
        int cutoffHour = int(math.floor(cutoffMinuteOfDay / 60))
        int cutoffMinute = cutoffMinuteOfDay % 60
        endTime := timestamp(NY_TIMEZONE, year(referenceTime, NY_TIMEZONE), month(referenceTime, NY_TIMEZONE), dayofmonth(referenceTime, NY_TIMEZONE), cutoffHour, cutoffMinute)
        if endTime > referenceTime
            endTime := legilimensOrchestration.previousNyCutoff(endTime, cutoffHour, cutoffMinute)
        if not twentyFourSeven
            int cutoffDay = dayofweek(endTime, NY_TIMEZONE)
            while cutoffDay == dayofweek.saturday or cutoffDay == dayofweek.sunday
                endTime := legilimensOrchestration.previousNyCutoff(endTime, cutoffHour, cutoffMinute)
                cutoffDay := dayofweek(endTime, NY_TIMEZONE)
    endTime

rollingUsesClockCutoff(string throughMode) =>
    not na(rollingClockCutoffMinute(throughMode))

// ───────────────────────────────────────────────────────────────────────────────
// PROFILE DATA ADAPTERS
// ───────────────────────────────────────────────────────────────────────────────
compactIfNeeded(array<float> highs, array<float> lows, array<float> volumes, array<float> deltas) =>
    legilimensProfile.compactIfNeeded(highs, lows, volumes, deltas, syminfo.mintick)

clearSamples(array<float> highs, array<float> lows, array<float> volumes, array<float> deltas) =>
    legilimensProfile.clearSamples(highs, lows, volumes, deltas)

appendSamples(array<float> destHighs, array<float> destLows, array<float> destVolumes, array<float> destDeltas, array<float> sourceHighs, array<float> sourceLows, array<float> sourceVolumes, array<float> sourceDeltas, bool compactAfter) =>
    legilimensProfile.appendSamples(destHighs, destLows, destVolumes, destDeltas, sourceHighs, sourceLows, sourceVolumes, sourceDeltas, compactAfter, syminfo.mintick)

appendBarSample(array<float> highs, array<float> lows, array<float> volumes, array<float> deltas, float sampleHigh, float sampleLow, float sampleVolume, float sampleDelta) =>
    legilimensProfile.appendBarSample(highs, lows, volumes, deltas, sampleHigh, sampleLow, sampleVolume, sampleDelta)

buildProfileFromSelection(array<float> highs, array<float> lows, array<float> volumes, array<float> deltas, array<int> selectedIndices, int requestedRows, int startTime, int endTime) =>
    legilimensProfile.ProfileData profile = legilimensProfile.buildProfile(highs, lows, volumes, deltas, selectedIndices, requestedRows, syminfo.mintick)
    legilimensOrchestration.Profile.new(startTime, endTime, profile)

buildProfile(array<float> highs, array<float> lows, array<float> volumes, array<float> deltas, int requestedRows, int startTime, int endTime) =>
    array<int> allSampleIndices = na
    buildProfileFromSelection(highs, lows, volumes, deltas, allSampleIndices, requestedRows, startTime, endTime)

buildCurrentRollingProfile(legilimensProfile.RollingSampleStore store, legilimensProfile.SampleBatch currentSamples, bool includeCurrentSamples, legilimensProfile.RollingProfileWindow window, int requestedRows) =>
    legilimensProfile.ProfileData profile = legilimensProfile.buildRollingProfile(store, currentSamples, includeCurrentSamples, window, requestedRows, syminfo.mintick)
    legilimensOrchestration.Profile.new(window.startTime, window.endTime, profile)

selectSessionProfiles(int historyCount, bool currentPeriodActive, bool showDevelopingProfile, legilimensOrchestration.AnchorState state, legilimensProfile.SampleBatch currentSamples, bool includeCurrentSamples, int developingEndTime) =>
    legilimensOrchestration.selectProfiles(historyCount, currentPeriodActive, not showDevelopingProfile, state, currentSamples, includeCurrentSamples, developingEndTime, PROFILE_ROWS, syminfo.mintick)

// Scheduled decision dates: https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm (2026-09-16).
fomcDecisionDateAllowed(int decisionTime) =>
    var array<int> decisionDates = array.from(
         20210127, 20210317, 20210428, 20210616, 20210728, 20210922, 20211103, 20211215,
         20220126, 20220316, 20220504, 20220615, 20220727, 20220921, 20221102, 20221214,
         20230201, 20230322, 20230503, 20230614, 20230726, 20230920, 20231101, 20231213,
         20240131, 20240320, 20240501, 20240612, 20240731, 20240918, 20241107, 20241218,
         20250129, 20250319, 20250507, 20250618, 20250730, 20250917, 20251029, 20251210,
         20260128, 20260318, 20260429, 20260617, 20260729, 20260916, 20261028, 20261209,
         20270127, 20270317, 20270428, 20270609, 20270728, 20270915, 20271027, 20271208,
         20280126)
    int decisionDateKey = year(decisionTime, NY_TIMEZONE) * 10000 + month(decisionTime, NY_TIMEZONE) * 100 + dayofmonth(decisionTime, NY_TIMEZONE)
    array.binary_search(decisionDates, decisionDateKey) >= 0

nySessionDayAllowed(int referenceTime, int startMinute, int endMinute, bool twentyFourSeven, bool fomcOnly) =>
    fomcOnly ? fomcDecisionDateAllowed(nySessionEndBoundary(referenceTime, startMinute, endMinute)) : twentyFourSeven or isNySessionTradingDay(referenceTime, startMinute, endMinute)

activeNySessionStart(int evaluationTime, bool enabled, int startMinute, int endMinute, bool twentyFourSeven, bool fomcOnly) =>
    bool tradingDayAllowed = nySessionDayAllowed(evaluationTime, startMinute, endMinute, twentyFourSeven, fomcOnly)
    enabled and tradingDayAllowed and inNyMinuteWindow(evaluationTime, startMinute, endMinute) ? nySessionStartBoundary(evaluationTime, startMinute, endMinute) : START_TIME_UNSET

boundedNySessionStart(int evaluationTime, bool enabled, bool windowObserved, int firstSampleTime, int startMinute, int endMinute, bool twentyFourSeven) =>
    int referenceTime = na(firstSampleTime) ? evaluationTime : firstSampleTime
    enabled and windowObserved ? nySessionStartBoundary(referenceTime, startMinute, endMinute) : activeNySessionStart(evaluationTime, enabled, startMinute, endMinute, twentyFourSeven, false)

boundedNyDevelopingEnd(int sampleEndTime, int storedEndTime, int sessionStartTime, int endMinute) =>
    na(sampleEndTime) ? storedEndTime : math.min(sampleEndTime, nyMinuteBoundary(sessionStartTime, endMinute))

selectNySessionSamples(legilimensProfile.SampleBatch samples, bool enabled, int startMinute, int endMinute, bool twentyFourSeven, bool fomcOnly, array<int> sessionStarts) =>
    legilimensProfile.SampleBatch selectedSamples = legilimensProfile.SampleBatch.new(array.new<int>(), array.new<int>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>())
    int sampleCount = array.size(samples.volumes)
    if enabled and sampleCount > 0
        for sampleIndex = 0 to sampleCount - 1
            int sampleStartTime = array.get(samples.startTimes, sampleIndex)
            int sampleEndTime = array.get(samples.endTimes, sampleIndex)
            bool tradingDayAllowed = nySessionDayAllowed(sampleStartTime, startMinute, endMinute, twentyFourSeven, fomcOnly)
            if tradingDayAllowed and barFitsNyMinuteWindow(sampleStartTime, sampleEndTime, startMinute, endMinute)
                array.push(sessionStarts, nySessionStartBoundary(sampleStartTime, startMinute, endMinute))
                array.push(selectedSamples.startTimes, sampleStartTime)
                array.push(selectedSamples.endTimes, sampleEndTime)
                appendBarSample(selectedSamples.highs, selectedSamples.lows, selectedSamples.volumes, selectedSamples.deltas, array.get(samples.highs, sampleIndex), array.get(samples.lows, sampleIndex), array.get(samples.volumes, sampleIndex), array.get(samples.deltas, sampleIndex))
    selectedSamples

appendContainedSamples(array<float> destHighs, array<float> destLows, array<float> destVolumes, array<float> destDeltas, legilimensProfile.SampleBatch samples, int rangeStartTime, int rangeEndTime, bool compactAfter) =>
    int sampleCount = array.size(samples.volumes)
    if sampleCount > 0
        for sampleIndex = 0 to sampleCount - 1
            int sampleStartTime = array.get(samples.startTimes, sampleIndex)
            int sampleEndTime = array.get(samples.endTimes, sampleIndex)
            if sampleStartTime >= rangeStartTime and sampleEndTime <= rangeEndTime
                appendBarSample(destHighs, destLows, destVolumes, destDeltas, array.get(samples.highs, sampleIndex), array.get(samples.lows, sampleIndex), array.get(samples.volumes, sampleIndex), array.get(samples.deltas, sampleIndex))
    if compactAfter
        compactIfNeeded(destHighs, destLows, destVolumes, destDeltas)

// ═══════════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE
// ═══════════════════════════════════════════════════════════════════════════════
addColorRow(array<ColorRow> rows, string name, color swatchColor, string widthText) =>
    array.push(rows, ColorRow.new(name, swatchColor, widthText))

writeColorRow(table referenceTable, int row, ColorRow entry) =>
    string rgbText = str.format("R:{0} G:{1} B:{2}", int(color.r(entry.swatchColor)), int(color.g(entry.swatchColor)), int(color.b(entry.swatchColor)))
    string transparencyText = str.tostring(int(color.t(entry.swatchColor)))
    table.cell(referenceTable, 0, row, entry.name, text_size=size.small, text_color=color.rgb(0, 0, 0))
    table.cell(referenceTable, 1, row, rgbText, text_size=size.small, text_color=color.rgb(0, 0, 0))
    table.cell(referenceTable, 2, row, transparencyText, text_size=size.small, text_color=color.rgb(0, 0, 0))
    table.cell(referenceTable, 3, row, entry.widthText, text_size=size.small, text_color=color.rgb(0, 0, 0))

// ═══════════════════════════════════════════════════════════════════════════════
// DATA REQUESTS & SAMPLE ROUTING
// ═══════════════════════════════════════════════════════════════════════════════
string intrabarTimeframe = autoIntrabarTimeframe()
string intrabarTickerId = chart.is_range ? ticker.new(syminfo.prefix, syminfo.ticker, syminfo.session) : syminfo.tickerid
[intrabarTimes, intrabarEndTimes, intrabarOpens, intrabarHighs, intrabarLows, intrabarCloses, intrabarVolumes] = request.security_lower_tf(intrabarTickerId, intrabarTimeframe, [time, time_close, open, high, low, close, volume], ignore_invalid_timeframe=true)

zoneBoundarySamples(string requestedTimeframe) =>
    request.security_lower_tf(intrabarTickerId, requestedTimeframe, [time, time_close, high, low], ignore_invalid_timeframe=true)

if barstate.islastconfirmedhistory and extendUnmitigated and unmitigatedProfileSelected
    if intrabarTimeframe != INTRABAR_TIMEFRAME_ONE_SECOND and intrabarTimeframe != INTRABAR_TIMEFRAME_ONE_MINUTE
        [_, _, _, _] = zoneBoundarySamples(INTRABAR_TIMEFRAME_ONE_MINUTE)
    if intrabarTimeframe != INTRABAR_TIMEFRAME_ONE_SECOND
        [_, _, _, _] = zoneBoundarySamples(INTRABAR_TIMEFRAME_ONE_SECOND)

// Resolve known market types immediately; scan weekend bars only for ambiguous types.
bool isKnown247Asset = syminfo.type == "crypto"
bool isKnownTraditionalAsset = syminfo.type == "futures" or syminfo.type == "forex" or syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "dr" or syminfo.type == "index" or syminfo.type == "option" or syminfo.type == "commodity" or syminfo.type == "bond" or syminfo.type == "spread"
if not assetClassificationReady
    if isKnown247Asset or isKnownTraditionalAsset
        isTwentyFourSevenAsset := isKnown247Asset
        assetClassificationReady := true
    else if isTrueWeekendBar(time)
        isTwentyFourSevenAsset := true
        assetClassificationReady := true
    else
        int barsInWeek = math.max(1, int(math.ceil(SECONDS_PER_WEEK / timeframe.in_seconds(timeframe.period))))
        int observationWindow = math.min(ASSET_DETECTION_MAX_LOOKBACK, barsInWeek)
        if bar_index >= observationWindow
            isTwentyFourSevenAsset := false
            assetClassificationReady := true

rthInSessionWeekday = not na(time(timeframe.period, RTH_SESSION, NY_TIMEZONE))
rthInSessionAllDays = not na(time(timeframe.period, RTH_SESSION_ALL_DAYS, NY_TIMEZONE))
rthInSession = isTwentyFourSevenAsset ? rthInSessionAllDays : rthInSessionWeekday
rthSessionStart = rthInSession and not rthInSession[1]
rthSessionEnd = not rthInSession and rthInSession[1]

utcDayStart = calendarDayStart(UTC_TIMEZONE)
futuresGlobexStart = shiftedCalendarDayStart(NY_TIMEZONE, GLOBEX_REOPEN_SHIFT_MS)
globexDayStart = isTwentyFourSevenAsset ? utcDayStart : futuresGlobexStart
weeklyPeriodStart = weeklyBoundary(isTwentyFourSevenAsset, utcDayStart, futuresGlobexStart, time)
utcMonthStart = shiftedCalendarMonthStart(UTC_TIMEZONE, 0)
futuresMonthStart = shiftedCalendarMonthStart(NY_TIMEZONE, GLOBEX_REOPEN_SHIFT_MS)
monthlyPeriodStart = isTwentyFourSevenAsset ? utcMonthStart : futuresMonthStart

string focusDateZone = isTwentyFourSevenAsset ? UTC_TIMEZONE : NY_TIMEZONE
bool focusSearchActive = focusSelected and focusDateInputsValid
int focusDateCandidate = focusSearchActive and focusUsesDate ? (focusBetweenDates ? focusTradingDateBoundary(focusYear, focusMonth, focusDay, isTwentyFourSevenAsset, true) - 1 : timestamp(focusDateZone, focusYear, focusMonth, focusDay, 12, 0)) : na
int focusStartDateCandidate = focusSearchActive and focusBetweenDates ? focusTradingDateBoundary(focusStartYear, focusStartMonth, focusStartDay, isTwentyFourSevenAsset, false) : na
legilimensPresentation.InteractionSettings presentationInteractionSettings = legilimensPresentation.InteractionSettings.new(extendUnmitigated, unmitigatedWindow, focusSearchActive ? math.max(sessionProfileRetention, FOCUS_SEARCH_DEPTH) : sessionProfileRetention)
legilimensPresentation.FocusSettings presentationFocusSettings = legilimensPresentation.FocusSettings.new(focusSearchActive ? focusMode : legilimensPresentation.FocusMode.off, focusUsesPrice ? focusDirection : legilimensPresentation.FocusDirection.off, focusAnchorMode == FOCUS_MANUAL_PRICE ? focusManualPrice : close, focusExtraProfiles, FOCUS_SEARCH_DEPTH, focusDateCandidate, focusStartDateCandidate, focusHideNonFocusProfiles)
legilimensPresentation.PresentationConfig presentationConfig = legilimensPresentation.PresentationConfig.new(presentationLimits, presentationDeltaSettings, presentationLevelSettings, presentationInteractionSettings, showDevelopingShell, extendedNyEarlyModeActive, PROFILE_ROWS, presentationFocusSettings)
legilimensPresentation.BarContext presentationContext = legilimensPresentation.BarContext.new(time, na(time_close) ? timenow : time_close, bar_index, high, low, syminfo.mintick, barstate.isconfirmed, isTwentyFourSevenAsset, syminfo.type == "futures")

