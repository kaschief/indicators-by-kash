// HELPERS — SESSION BOUNDARIES
// ───────────────────────────────────────────────────────────────────────────────
isTrueWeekendBar(int barTime) =>
    legilimensOrchestration.isTrueWeekendBar(barTime, SUNDAY_REOPEN_START_HOUR)

calendarDayStart(string timezone) =>
    legilimensOrchestration.calendarDayStart(time, timezone)

shiftedCalendarDayStart(string timezone, int timeShiftMilliseconds) =>
    legilimensOrchestration.shiftedCalendarDayStart(time, timezone, timeShiftMilliseconds)

shiftedCalendarMonthStart(string timezone, int timeShiftMilliseconds) =>
    legilimensOrchestration.shiftedCalendarMonthStart(time, timezone, timeShiftMilliseconds)

weeklyBoundary(bool twentyFourSeven, bool utcBoundary, bool futuresBoundary, int barTime) =>
    legilimensOrchestration.weeklyBoundary(twentyFourSeven, utcBoundary, futuresBoundary, barTime)

isNyWeekday(int barTime) =>
    legilimensOrchestration.isNyWeekday(barTime)

inNyMinuteWindow(int barTime, int startMinute, int endMinute) =>
    legilimensOrchestration.inNyMinuteWindow(barTime, startMinute, endMinute)

nyMinuteBoundary(int referenceTime, int minuteOfDay) =>
    legilimensOrchestration.nyMinuteBoundary(referenceTime, minuteOfDay)

nySessionStartBoundary(int referenceTime, int startMinute, int endMinute) =>
    legilimensOrchestration.nySessionStartBoundary(referenceTime, startMinute, endMinute)

nySessionEndBoundary(int referenceTime, int startMinute, int endMinute) =>
    legilimensOrchestration.nySessionEndBoundary(referenceTime, startMinute, endMinute)

isNySessionTradingDay(int barTime, int startMinute, int endMinute) =>
    legilimensOrchestration.isNySessionTradingDay(barTime, startMinute, endMinute)

barFitsNyMinuteWindow(int barTime, int barEndTime, int startMinute, int endMinute) =>
    legilimensOrchestration.barFitsNyMinuteWindow(barTime, barEndTime, startMinute, endMinute)

mitigationWindowStartMinute(string windowMode) =>
    windowMode == WINDOW_LABEL_FROM_0500 ? ROLLING_CUTOFF_0500_MINUTE : windowMode == WINDOW_LABEL_FROM_0830 ? ROLLING_CUTOFF_0830_MINUTE : ROLLING_CUTOFF_0930_MINUTE

mitigationWindowAllowsSample(string windowMode, int sampleTime, int sampleEndTime, bool twentyFourSeven) =>
    int startMinute = mitigationWindowStartMinute(windowMode)
    windowMode == MITIGATION_WINDOW_ANYTIME or ((twentyFourSeven or isNyWeekday(sampleTime)) and barFitsNyMinuteWindow(sampleTime, sampleEndTime, startMinute, ROLLING_CUTOFF_1600_MINUTE))

mitigationWindowBounds(string windowMode, int startTime, int endTime, bool twentyFourSeven) =>
    int activeStart = na
    int activeEnd = na
    if startTime < endTime
        if windowMode == MITIGATION_WINDOW_ANYTIME
            activeStart := startTime
            activeEnd := endTime
        else
            int cursorTime = startTime
            while cursorTime < endTime
                int sessionStart = nyMinuteBoundary(cursorTime, mitigationWindowStartMinute(windowMode))
                int sessionEnd = nyMinuteBoundary(cursorTime, ROLLING_CUTOFF_1600_MINUTE)
                int overlapStart = math.max(startTime, sessionStart)
                int overlapEnd = math.min(endTime, sessionEnd)
                if overlapStart < overlapEnd and (twentyFourSeven or isNyWeekday(cursorTime))
                    activeStart := na(activeStart) ? overlapStart : activeStart
                    activeEnd := overlapEnd
                cursorTime := timestamp(NY_TIMEZONE, year(cursorTime, NY_TIMEZONE), month(cursorTime, NY_TIMEZONE), dayofmonth(cursorTime, NY_TIMEZONE) + 1, 0, 0)
    array.from(activeStart, activeEnd)

nextCalendarWeekBoundary(int referenceTime, string timezone, int boundaryHour, int boundaryMinute) =>
    legilimensOrchestration.nextCalendarWeekBoundary(referenceTime, timezone, boundaryHour, boundaryMinute)

sessionOccurrenceClose(string sourceName, DeltaProfile profile, bool twentyFourSeven, bool developing) =>
    int closeTime = profile.endTime
    if sourceName == SOURCE_NY_EARLY
        closeTime := nyMinuteBoundary(profile.startTime, NY_EARLY_END_MINUTE)
    else if sourceName == SOURCE_EXTENDED_NY_EARLY
        int nominalCloseTime = nyMinuteBoundary(profile.startTime, IVB_START_MINUTE)
        closeTime := profile.endTime > nominalCloseTime ? nyMinuteBoundary(profile.startTime, EXTENDED_NY_EARLY_OPENING_END_MINUTE) : nominalCloseTime
    else if sourceName == SOURCE_IVB
        closeTime := nyMinuteBoundary(profile.startTime, IVB_END_MINUTE)
    else if sourceName == SOURCE_ASIA_PREMARKET
        closeTime := nySessionEndBoundary(profile.startTime, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE)
    else if sourceName == SOURCE_RTH
        closeTime := developing ? nyMinuteBoundary(profile.startTime, 16 * 60) : profile.endTime
    else if sourceName == SOURCE_WEEKLY
        closeTime := developing or weeklyRollingSelected ? profile.endTime : twentyFourSeven ? nextCalendarWeekBoundary(profile.startTime, UTC_TIMEZONE, 0, 0) : nextCalendarWeekBoundary(profile.startTime, NY_TIMEZONE, SUNDAY_REOPEN_START_HOUR, 0)
    closeTime

