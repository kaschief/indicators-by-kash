ivbDeltaWidthBars = input.int(INTRADAY_DELTA_WIDTH_DEFAULT_BARS, INPUT_LABEL_DELTA_WIDTH, minval=DELTA_WIDTH_MIN_BARS, maxval=DELTA_WIDTH_MAX_BARS, inline="ivb_delta_width", group=GROUP_IVB, active=ivbSelected, tooltip=TOOLTIP_DELTA_WIDTH)

