var array<int> weeklyLastBarRef = array.new<int>(1, START_TIME_UNSET)

var array<float> monthlyBarHighs = array.new<float>()
var array<float> monthlyBarLows = array.new<float>()
var array<float> monthlyBarVolumes = array.new<float>()
var array<float> monthlyBarDeltas = array.new<float>()
var array<DeltaProfile> monthlyProfiles = array.new<DeltaProfile>()
var array<int> monthlyStartRef = array.new<int>(1, START_TIME_UNSET)
var array<int> monthlyLastBarRef = array.new<int>(1, START_TIME_UNSET)

var bool isTwentyFourSevenAsset = false
var bool assetClassificationReady = false
var int lastTickDirection = 1
var float previousTapeClose = na
var int lastAcceptedRangeIntrabarTime = na
var bool fixedMitigationProfileRegistered = false
var int registeredRollingMitigationEndTime = na

// ═══════════════════════════════════════════════════════════════════════════════
// DATA & BOUNDARIES
// ═══════════════════════════════════════════════════════════════════════════════
string intrabarTimeframe = autoIntrabarTimeframe()
string intrabarTickerId = chart.is_range ? ticker.new(syminfo.prefix, syminfo.ticker, syminfo.session) : syminfo.tickerid
[intrabarTimes, intrabarEndTimes, intrabarOpens, intrabarHighs, intrabarLows, intrabarCloses, intrabarVolumes] = request.security_lower_tf(intrabarTickerId, intrabarTimeframe, [time, time_close, open, high, low, close, volume], ignore_invalid_timeframe=true)

mitigationBoundarySamples(string requestedTimeframe) =>
    request.security_lower_tf(intrabarTickerId, requestedTimeframe, [time, time_close, high, low], ignore_invalid_timeframe=true)

if barstate.islastconfirmedhistory and extendUnmitigated
    if intrabarTimeframe != INTRABAR_TIMEFRAME_ONE_SECOND and intrabarTimeframe != INTRABAR_TIMEFRAME_ONE_MINUTE
        [_, _, _, _] = mitigationBoundarySamples(INTRABAR_TIMEFRAME_ONE_MINUTE)
    if intrabarTimeframe != INTRABAR_TIMEFRAME_ONE_SECOND
        [_, _, _, _] = mitigationBoundarySamples(INTRABAR_TIMEFRAME_ONE_SECOND)

currentBarEndTime() =>
    na(time_close) ? timenow : time_close

firstIntrabarTouchEnd(array<int> sampleTimes, array<int> sampleEndTimes, array<float> sampleHighs, array<float> sampleLows, int eligibilityTime, float price) =>
    int touchEndTime = na
    int sampleCount = math.min(math.min(array.size(sampleTimes), array.size(sampleEndTimes)), math.min(array.size(sampleHighs), array.size(sampleLows)))
    if sampleCount > 0
        for sampleIndex = 0 to sampleCount - 1
            int sampleTime = array.get(sampleTimes, sampleIndex)
            int sampleEndTime = array.get(sampleEndTimes, sampleIndex)
            float sampleHigh = array.get(sampleHighs, sampleIndex)
            float sampleLow = array.get(sampleLows, sampleIndex)
            bool eligibleSample = sampleTime >= eligibilityTime and sampleEndTime > eligibilityTime
            if na(touchEndTime) and eligibleSample and not na(sampleHigh) and not na(sampleLow) and sampleLow <= price and sampleHigh >= price
                touchEndTime := sampleEndTime
    touchEndTime

boundaryCoverageComplete(array<int> sampleTimes, array<int> sampleEndTimes, int eligibilityTime, int barEndTime) =>
    int firstEligibleTime = na
    int lastEligibleEndTime = na
    int sampleCount = math.min(array.size(sampleTimes), array.size(sampleEndTimes))
    if sampleCount > 0
        for sampleIndex = 0 to sampleCount - 1
            int sampleTime = array.get(sampleTimes, sampleIndex)
            int sampleEndTime = array.get(sampleEndTimes, sampleIndex)
            if sampleTime >= eligibilityTime and sampleEndTime > eligibilityTime
                firstEligibleTime := na(firstEligibleTime) ? sampleTime : math.min(firstEligibleTime, sampleTime)
                lastEligibleEndTime := na(lastEligibleEndTime) ? sampleEndTime : math.max(lastEligibleEndTime, sampleEndTime)
    not na(firstEligibleTime) and firstEligibleTime <= eligibilityTime and lastEligibleEndTime >= barEndTime

profileIntrabarsArePrecise(int eligibilityTime) =>
    intrabarTimeframe == INTRABAR_TIMEFRAME_ONE_SECOND or (eligibilityTime % MS_PER_MINUTE == 0 and intrabarTimeframe == INTRABAR_TIMEFRAME_ONE_MINUTE)

mitigationBoundaryRequestTimeframe() =>
    string requestedTimeframe = ""
    int barEndTime = currentBarEndTime()
    int stateCount = array.size(mitigatedZoneStates)
    if stateCount > 0
        for stateIndex = 0 to stateCount - 1
            MitigatedZoneState state = array.get(mitigatedZoneStates, stateIndex)
            bool boundaryBar = time < state.eligibilityTime and barEndTime > state.eligibilityTime
            bool chartBarTouches = not na(high) and not na(low) and low <= state.price and high >= state.price
            bool minuteAlignedBoundary = state.eligibilityTime % MS_PER_MINUTE == 0
            if state.available and na(state.mitigatedTime) and boundaryBar and chartBarTouches and not profileIntrabarsArePrecise(state.eligibilityTime)
                requestedTimeframe := minuteAlignedBoundary and requestedTimeframe != INTRABAR_TIMEFRAME_ONE_SECOND ? INTRABAR_TIMEFRAME_ONE_MINUTE : INTRABAR_TIMEFRAME_ONE_SECOND
    requestedTimeframe

updateMitigatedZoneStates(array<int> boundaryTimes, array<int> boundaryEndTimes, array<float> boundaryHighs, array<float> boundaryLows) =>
    int barEndTime = currentBarEndTime()
    int stateCount = array.size(mitigatedZoneStates)
    if stateCount > 0
        for stateIndex = 0 to stateCount - 1
            MitigatedZoneState state = array.get(mitigatedZoneStates, stateIndex)
            if state.available and na(state.mitigatedTime) and barEndTime > state.eligibilityTime
                float price = state.price
                bool chartBarTouches = not na(high) and not na(low) and low <= price and high >= price
                if chartBarTouches
                    bool useProfileIntrabars = profileIntrabarsArePrecise(state.eligibilityTime)
                    int intrabarTouchEnd = useProfileIntrabars ? firstIntrabarTouchEnd(intrabarTimes, intrabarEndTimes, intrabarHighs, intrabarLows, state.eligibilityTime, price) : firstIntrabarTouchEnd(boundaryTimes, boundaryEndTimes, boundaryHighs, boundaryLows, state.eligibilityTime, price)
                    bool boundaryBar = time < state.eligibilityTime
                    if not na(intrabarTouchEnd)
                        state.mitigatedTime := intrabarTouchEnd
                    else if not boundaryBar
                        state.mitigatedTime := barEndTime
                    else if barstate.isconfirmed
                        bool coverageComplete = useProfileIntrabars ? boundaryCoverageComplete(intrabarTimes, intrabarEndTimes, state.eligibilityTime, barEndTime) : boundaryCoverageComplete(boundaryTimes, boundaryEndTimes, state.eligibilityTime, barEndTime)
                        if not coverageComplete
                            state.available := false
                    array.set(mitigatedZoneStates, stateIndex, state)

mitigatedZoneEndTime(string sourceName, int profileStartTime, float price, int eligibilityTime) =>
    int zoneEndTime = na
    int stateIndex = mitigatedZoneStateIndex(sourceName, profileStartTime, eligibilityTime, price)
    if stateIndex >= 0
        MitigatedZoneState state = array.get(mitigatedZoneStates, stateIndex)
        zoneEndTime := state.available ? (na(state.mitigatedTime) ? math.max(eligibilityTime, currentBarEndTime()) : state.mitigatedTime) : eligibilityTime
    else
        zoneEndTime := eligibilityTime
    zoneEndTime

flushPendingMitigatedZones() =>
    int pendingCount = array.size(pendingMitigatedZones)
    if pendingCount > 0
        for pendingIndex = 0 to pendingCount - 1
            PendingMitigatedZone pending = array.get(pendingMitigatedZones, pendingIndex)
            int rightTime = mitigatedZoneEndTime(pending.sourceName, pending.profileStartTime, pending.price, pending.eligibilityTime)
            if not na(rightTime)
                renderZoneFill(pending.leftTime, rightTime, pending.zoneLow, pending.zoneHigh, pending.zoneColor)
                if pending.hasLine
                    queueRightLine(pending.price, pending.leftTime, rightTime, pending.lineColor, pending.lineWidth, pending.lineStyle, pending.lineRank, pending.sourceName, pending.tradingDayKey, pending.historical, pending.direction)
                queueLevelMarker(pending.price, levelMarkerTime(rightTime), pending.markerLabel, pending.markerColor, pending.markerSize)
        array.clear(pendingMitigatedZones)

// Resolve known market types immediately; scan weekend bars only for ambiguous types.
bool isKnown247Asset = syminfo.type == "crypto"
bool isKnownTraditionalAsset = syminfo.type == "futures" or syminfo.type == "forex" or syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "dr" or syminfo.type == "index" or syminfo.type == "option" or syminfo.type == "commodity" or syminfo.type == "bond" or syminfo.type == "spread"
if not assetClassificationReady
    if isKnown247Asset or isKnownTraditionalAsset
        isTwentyFourSevenAsset := isKnown247Asset
        assetClassificationReady := true
    else if isTrueWeekendBar(time)
        isTwentyFourSevenAsset := true
        assetClassificationReady := true
    else
        int barsInWeek = math.max(1, int(math.ceil(SECONDS_PER_WEEK / timeframe.in_seconds(timeframe.period))))
        int observationWindow = math.min(ASSET_DETECTION_MAX_LOOKBACK, barsInWeek)
        if bar_index >= observationWindow
            isTwentyFourSevenAsset := false
            assetClassificationReady := true

rthInSessionWeekday = not na(time(timeframe.period, RTH_SESSION, NY_TIMEZONE))
rthInSessionAllDays = not na(time(timeframe.period, RTH_SESSION_ALL_DAYS, NY_TIMEZONE))
rthInSession = isTwentyFourSevenAsset ? rthInSessionAllDays : rthInSessionWeekday
rthSessionStart = rthInSession and not rthInSession[1]
rthSessionEnd = not rthInSession and rthInSession[1]

utcDayStart = calendarDayStart(UTC_TIMEZONE)
futuresGlobexStart = shiftedCalendarDayStart(NY_TIMEZONE, GLOBEX_REOPEN_SHIFT_MS)
globexDayStart = isTwentyFourSevenAsset ? utcDayStart : futuresGlobexStart
weeklyPeriodStart = weeklyBoundary(isTwentyFourSevenAsset, utcDayStart, futuresGlobexStart, time)
utcMonthStart = shiftedCalendarMonthStart(UTC_TIMEZONE, 0)
futuresMonthStart = shiftedCalendarMonthStart(NY_TIMEZONE, GLOBEX_REOPEN_SHIFT_MS)
monthlyPeriodStart = isTwentyFourSevenAsset ? utcMonthStart : futuresMonthStart

fixedRangeStart = math.min(fixedRangeStartInput, fixedRangeEndInput)
fixedRangeEnd = math.max(fixedRangeStartInput, fixedRangeEndInput)
rollingRangeEnd = rollingThroughTime(last_bar_time, rollingWindowThrough, isTwentyFourSevenAsset)
rollingRangeStart = lookbackDaysStart(rollingRangeEnd, rollingWindowLookbackDays, isTwentyFourSevenAsset)
rollingPeriodOldestStart = lookbackDaysStart(rollingRangeEnd, rollingWindowLookbackDays * (rollingPeriodHistoryCount + 1), isTwentyFourSevenAsset)

array<int> barSampleStartTimes = array.new<int>()
array<int> barSampleEndTimes = array.new<int>()
array<float> barSampleHighs = array.new<float>()
array<float> barSampleLows = array.new<float>()
array<float> barSampleVolumes = array.new<float>()
array<float> barSampleDeltas = array.new<float>()
array<float> asiaPremarketSampleHighs = array.new<float>()
array<float> asiaPremarketSampleLows = array.new<float>()
array<float> asiaPremarketSampleVolumes = array.new<float>()
array<float> asiaPremarketSampleDeltas = array.new<float>()
array<int> asiaPremarketSampleSessionStarts = array.new<int>()
array<int> asiaPremarketSampleEndTimes = array.new<int>()
array<float> nyEarlySampleHighs = array.new<float>()
array<float> nyEarlySampleLows = array.new<float>()
array<float> nyEarlySampleVolumes = array.new<float>()
array<float> nyEarlySampleDeltas = array.new<float>()
array<float> extendedNyEarlySampleHighs = array.new<float>()
array<float> extendedNyEarlySampleLows = array.new<float>()
array<float> extendedNyEarlySampleVolumes = array.new<float>()
array<float> extendedNyEarlySampleDeltas = array.new<float>()
array<float> extendedOpeningSampleHighs = array.new<float>()
array<float> extendedOpeningSampleLows = array.new<float>()
array<float> extendedOpeningSampleVolumes = array.new<float>()
array<float> extendedOpeningSampleDeltas = array.new<float>()
array<float> ivbSampleHighs = array.new<float>()
array<float> ivbSampleLows = array.new<float>()
array<float> ivbSampleVolumes = array.new<float>()
array<float> ivbSampleDeltas = array.new<float>()
int nyEarlyFirstSampleTime = na
int nyEarlyLastSampleEndTime = na
int extendedNyEarlyFirstSampleTime = na
int extendedNyEarlyLastSampleEndTime = na
int ivbFirstSampleTime = na
int ivbLastSampleEndTime = na
bool nyEarlyWindowObserved = false
bool extendedNyEarlyWindowObserved = false
bool extendedOpeningWindowObserved = false
bool ivbWindowObserved = false
bool boundedSessionSamplesRequired = asiaPremarketModeActive or nyEarlyModeActive or extendedNyEarlyModeActive or ivbModeActive
int subBarCount = array.size(intrabarVolumes)
if subBarCount > 0
    for subBarIndex = 0 to subBarCount - 1
        int subTime = array.get(intrabarTimes, subBarIndex)
        int subEndTime = array.get(intrabarEndTimes, subBarIndex)
        float subOpen = array.get(intrabarOpens, subBarIndex)
        float subHigh = array.get(intrabarHighs, subBarIndex)
        float subLow = array.get(intrabarLows, subBarIndex)
        float subClose = array.get(intrabarCloses, subBarIndex)
        float subVolume = array.get(intrabarVolumes, subBarIndex)
        int rangeSampleCutoffTime = na(time_close) ? timenow : time_close
        bool rangeIntrabarClosed = not na(subEndTime) and subEndTime <= rangeSampleCutoffTime
        bool rangeIntrabarUsable = rangeIntrabarClosed or not barstate.isconfirmed
        bool acceptRangeSample = not chart.is_range or (rangeIntrabarUsable and (na(lastAcceptedRangeIntrabarTime) or subTime > lastAcceptedRangeIntrabarTime))
        bool boundedDayAllowed = boundedSessionSamplesRequired and (isTwentyFourSevenAsset or isNyWeekday(subTime))
        bool asiaPremarketDayAllowed = asiaPremarketModeActive and (isTwentyFourSevenAsset or isNySessionTradingDay(subTime, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE))
        bool subInAsiaPremarket = asiaPremarketDayAllowed and inNyMinuteWindow(subTime, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE)
        bool subInNyEarly = nyEarlyModeActive and boundedDayAllowed and inNyMinuteWindow(subTime, NY_EARLY_START_MINUTE, NY_EARLY_END_MINUTE)
        bool subInExtendedNyEarly = extendedNyEarlyModeActive and boundedDayAllowed and inNyMinuteWindow(subTime, NY_EARLY_START_MINUTE, IVB_START_MINUTE)
        bool subInExtendedOpening = extendedNyEarlyModeActive and boundedDayAllowed and inNyMinuteWindow(subTime, IVB_START_MINUTE, EXTENDED_NY_EARLY_OPENING_END_MINUTE)
        bool subInIvb = ivbModeActive and boundedDayAllowed and inNyMinuteWindow(subTime, IVB_START_MINUTE, IVB_END_MINUTE)
        if subInNyEarly
            nyEarlyWindowObserved := true
            nyEarlyFirstSampleTime := na(nyEarlyFirstSampleTime) ? subTime : nyEarlyFirstSampleTime
            nyEarlyLastSampleEndTime := na(subEndTime) ? subTime : subEndTime
        if subInExtendedNyEarly
            extendedNyEarlyWindowObserved := true
            extendedNyEarlyFirstSampleTime := na(extendedNyEarlyFirstSampleTime) ? subTime : extendedNyEarlyFirstSampleTime
            extendedNyEarlyLastSampleEndTime := na(subEndTime) ? subTime : subEndTime
        if subInExtendedOpening
            extendedNyEarlyWindowObserved := true
            extendedOpeningWindowObserved := true
            extendedNyEarlyLastSampleEndTime := na(subEndTime) ? subTime : subEndTime
        if subInIvb
            ivbWindowObserved := true
            ivbFirstSampleTime := na(ivbFirstSampleTime) ? subTime : ivbFirstSampleTime
            ivbLastSampleEndTime := na(subEndTime) ? subTime : subEndTime
        if acceptRangeSample and not na(subVolume) and subVolume > 0 and not na(subHigh) and not na(subLow)
            int direction = na(subOpen) or na(subClose) ? lastTickDirection : subClose > subOpen ? 1 : subClose < subOpen ? -1 : not na(previousTapeClose) and subClose > previousTapeClose ? 1 : not na(previousTapeClose) and subClose < previousTapeClose ? -1 : lastTickDirection
            lastTickDirection := direction
            if not na(subClose)
                previousTapeClose := subClose
            if chart.is_range and rangeIntrabarClosed
                lastAcceptedRangeIntrabarTime := subTime
            float subDelta = subVolume * direction
            array.push(barSampleStartTimes, subTime)
            array.push(barSampleEndTimes, na(subEndTime) ? subTime + 1 : subEndTime)
            appendBarSample(barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, subHigh, subLow, subVolume, subDelta)
            if subInAsiaPremarket
                appendBarSample(asiaPremarketSampleHighs, asiaPremarketSampleLows, asiaPremarketSampleVolumes, asiaPremarketSampleDeltas, subHigh, subLow, subVolume, subDelta)
                array.push(asiaPremarketSampleSessionStarts, nySessionStartBoundary(subTime, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE))
                array.push(asiaPremarketSampleEndTimes, na(subEndTime) ? subTime : subEndTime)
            if subInNyEarly
                appendBarSample(nyEarlySampleHighs, nyEarlySampleLows, nyEarlySampleVolumes, nyEarlySampleDeltas, subHigh, subLow, subVolume, subDelta)
            if subInExtendedNyEarly
                appendBarSample(extendedNyEarlySampleHighs, extendedNyEarlySampleLows, extendedNyEarlySampleVolumes, extendedNyEarlySampleDeltas, subHigh, subLow, subVolume, subDelta)
            if subInExtendedOpening
                appendBarSample(extendedOpeningSampleHighs, extendedOpeningSampleLows, extendedOpeningSampleVolumes, extendedOpeningSampleDeltas, subHigh, subLow, subVolume, subDelta)
            if subInIvb
                appendBarSample(ivbSampleHighs, ivbSampleLows, ivbSampleVolumes, ivbSampleDeltas, subHigh, subLow, subVolume, subDelta)
bool fallbackBarValid = not na(volume) and volume > 0 and not na(high) and not na(low)
bool barSampleFallbackRequired = fallbackBarValid and array.size(barSampleVolumes) == 0
bool fallbackDayAllowed = boundedSessionSamplesRequired and (isTwentyFourSevenAsset or isNyWeekday(time))
bool asiaPremarketFallbackDayAllowed = isTwentyFourSevenAsset or isNySessionTradingDay(time, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE)
bool asiaPremarketSampleFallbackRequired = fallbackBarValid and asiaPremarketModeActive and array.size(asiaPremarketSampleVolumes) == 0 and asiaPremarketFallbackDayAllowed and barFitsNyMinuteWindow(time, time_close, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE)
bool nyEarlySampleFallbackRequired = fallbackBarValid and nyEarlyModeActive and array.size(nyEarlySampleVolumes) == 0 and fallbackDayAllowed and barFitsNyMinuteWindow(time, time_close, NY_EARLY_START_MINUTE, NY_EARLY_END_MINUTE)
bool extendedNyEarlySampleFallbackRequired = fallbackBarValid and extendedNyEarlyModeActive and array.size(extendedNyEarlySampleVolumes) == 0 and fallbackDayAllowed and barFitsNyMinuteWindow(time, time_close, NY_EARLY_START_MINUTE, IVB_START_MINUTE)
bool extendedOpeningSampleFallbackRequired = fallbackBarValid and extendedNyEarlyModeActive and array.size(extendedOpeningSampleVolumes) == 0 and fallbackDayAllowed and barFitsNyMinuteWindow(time, time_close, IVB_START_MINUTE, EXTENDED_NY_EARLY_OPENING_END_MINUTE)
bool ivbSampleFallbackRequired = fallbackBarValid and ivbModeActive and array.size(ivbSampleVolumes) == 0 and fallbackDayAllowed and barFitsNyMinuteWindow(time, time_close, IVB_START_MINUTE, IVB_END_MINUTE)
if barSampleFallbackRequired or asiaPremarketSampleFallbackRequired or nyEarlySampleFallbackRequired or extendedNyEarlySampleFallbackRequired or extendedOpeningSampleFallbackRequired or ivbSampleFallbackRequired
    int fallbackDirection = close > open ? 1 : close < open ? -1 : not na(previousTapeClose) and close > previousTapeClose ? 1 : not na(previousTapeClose) and close < previousTapeClose ? -1 : lastTickDirection
    float fallbackDelta = volume * fallbackDirection
    int fallbackEndTime = na(time_close) ? timenow : time_close
    if barSampleFallbackRequired
        lastTickDirection := fallbackDirection
        previousTapeClose := close
        array.push(barSampleStartTimes, time)
        array.push(barSampleEndTimes, math.max(time + 1, fallbackEndTime))
        appendBarSample(barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, high, low, volume, fallbackDelta)
    if asiaPremarketSampleFallbackRequired
        appendBarSample(asiaPremarketSampleHighs, asiaPremarketSampleLows, asiaPremarketSampleVolumes, asiaPremarketSampleDeltas, high, low, volume, fallbackDelta)
        array.push(asiaPremarketSampleSessionStarts, nySessionStartBoundary(time, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE))
        array.push(asiaPremarketSampleEndTimes, fallbackEndTime)
    if nyEarlySampleFallbackRequired
        appendBarSample(nyEarlySampleHighs, nyEarlySampleLows, nyEarlySampleVolumes, nyEarlySampleDeltas, high, low, volume, fallbackDelta)
        nyEarlyWindowObserved := true
        nyEarlyFirstSampleTime := time
        nyEarlyLastSampleEndTime := fallbackEndTime
    if extendedNyEarlySampleFallbackRequired
        appendBarSample(extendedNyEarlySampleHighs, extendedNyEarlySampleLows, extendedNyEarlySampleVolumes, extendedNyEarlySampleDeltas, high, low, volume, fallbackDelta)
        extendedNyEarlyWindowObserved := true
        extendedNyEarlyFirstSampleTime := time
        extendedNyEarlyLastSampleEndTime := fallbackEndTime
    if extendedOpeningSampleFallbackRequired
        appendBarSample(extendedOpeningSampleHighs, extendedOpeningSampleLows, extendedOpeningSampleVolumes, extendedOpeningSampleDeltas, high, low, volume, fallbackDelta)
        extendedNyEarlyWindowObserved := true
        extendedOpeningWindowObserved := true
        extendedNyEarlyLastSampleEndTime := fallbackEndTime
    if ivbSampleFallbackRequired
        appendBarSample(ivbSampleHighs, ivbSampleLows, ivbSampleVolumes, ivbSampleDeltas, high, low, volume, fallbackDelta)
        ivbWindowObserved := true
        ivbFirstSampleTime := time
        ivbLastSampleEndTime := fallbackEndTime

array<int> midnightSampleSessionStarts = array.new<int>()
int midnightSampleCount = array.size(barSampleStartTimes)
if midnightModeActive and midnightSampleCount > 0
    for sampleIndex = 0 to midnightSampleCount - 1
        array.push(midnightSampleSessionStarts, nySessionStartBoundary(array.get(barSampleStartTimes, sampleIndex), NY_MIDNIGHT_MINUTE, NY_MIDNIGHT_MINUTE))
int midnightCurrentSessionStart = midnightModeActive ? (midnightSampleCount > 0 ? array.get(midnightSampleSessionStarts, midnightSampleCount - 1) : nySessionStartBoundary(time, NY_MIDNIGHT_MINUTE, NY_MIDNIGHT_MINUTE)) : START_TIME_UNSET

int chartTimeframeSeconds = timeframe.in_seconds(timeframe.period)
bool openingChartBarContained = not na(chartTimeframeSeconds) and chartTimeframeSeconds <= EXTENDED_NY_EARLY_OPENING_DURATION_MINUTES * SECONDS_PER_MINUTE and inNyMinuteWindow(time, IVB_START_MINUTE, EXTENDED_NY_EARLY_OPENING_END_MINUTE) and time_close <= nyMinuteBoundary(time, EXTENDED_NY_EARLY_OPENING_END_MINUTE)
bool storedExtendedRangeReady = array.size(extendedNyEarlyBarHighs) > 0 and array.size(extendedNyEarlyBarLows) > 0
bool currentExtendedRangeReady = array.size(extendedNyEarlySampleHighs) > 0 and array.size(extendedNyEarlySampleLows) > 0
bool extendedRangeReady = extendedOpeningWindowObserved and (storedExtendedRangeReady or currentExtendedRangeReady)
float storedExtendedRangeHigh = storedExtendedRangeReady ? array.max(extendedNyEarlyBarHighs) : na
float storedExtendedRangeLow = storedExtendedRangeReady ? array.min(extendedNyEarlyBarLows) : na
float currentExtendedRangeHigh = currentExtendedRangeReady ? array.max(extendedNyEarlySampleHighs) : na
float currentExtendedRangeLow = currentExtendedRangeReady ? array.min(extendedNyEarlySampleLows) : na
float extendedRangeHigh = storedExtendedRangeReady and currentExtendedRangeReady ? math.max(storedExtendedRangeHigh, currentExtendedRangeHigh) : storedExtendedRangeReady ? storedExtendedRangeHigh : currentExtendedRangeHigh
float extendedRangeLow = storedExtendedRangeReady and currentExtendedRangeReady ? math.min(storedExtendedRangeLow, currentExtendedRangeLow) : storedExtendedRangeReady ? storedExtendedRangeLow : currentExtendedRangeLow
bool sampledOpeningBreak = extendedRangeReady and array.size(extendedOpeningSampleVolumes) > 0 and (array.max(extendedOpeningSampleHighs) > extendedRangeHigh or array.min(extendedOpeningSampleLows) < extendedRangeLow)
bool chartOpeningBreak = extendedRangeReady and openingChartBarContained and (high > extendedRangeHigh or low < extendedRangeLow)
bool extendedOpeningBreakThisBar = extendedOpeningWindowObserved and extendedRangeReady and (sampledOpeningBreak or chartOpeningBreak)
bool extendedOpeningQualifiedThisBar = extendedOpeningWindowObserved and (extendedOpeningQualified or extendedOpeningBreakThisBar)
if extendedOpeningQualifiedThisBar
    if not extendedOpeningQualified
        appendSamples(extendedNyEarlySampleHighs, extendedNyEarlySampleLows, extendedNyEarlySampleVolumes, extendedNyEarlySampleDeltas, extendedOpeningPendingHighs, extendedOpeningPendingLows, extendedOpeningPendingVolumes, extendedOpeningPendingDeltas, false)
    appendSamples(extendedNyEarlySampleHighs, extendedNyEarlySampleLows, extendedNyEarlySampleVolumes, extendedNyEarlySampleDeltas, extendedOpeningSampleHighs, extendedOpeningSampleLows, extendedOpeningSampleVolumes, extendedOpeningSampleDeltas, false)

int asiaPremarketEvaluationTime = str.contains(syminfo.tickerid, "replay") ? time : barstate.isrealtime ? timenow : na(time_close) ? time : time_close
bool asiaPremarketEvaluationDayAllowed = isTwentyFourSevenAsset or isNySessionTradingDay(asiaPremarketEvaluationTime, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE)
bool asiaPremarketEvaluationInSession = asiaPremarketModeActive and asiaPremarketEvaluationDayAllowed and inNyMinuteWindow(asiaPremarketEvaluationTime, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE)
bool asiaPremarketInSession = asiaPremarketEvaluationInSession
int asiaPremarketCurrentSessionStart = asiaPremarketInSession ? nySessionStartBoundary(asiaPremarketEvaluationTime, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE) : START_TIME_UNSET
nyEarlyInSession = nyEarlyWindowObserved
nyEarlySessionStart = nyEarlyInSession and not nyEarlyInSession[1]
nyEarlySessionEnd = not nyEarlyInSession and nyEarlyInSession[1]
extendedNyEarlyInSession = extendedNyEarlyWindowObserved
extendedNyEarlySessionStart = extendedNyEarlyInSession and not extendedNyEarlyInSession[1]
extendedNyEarlySessionEnd = not extendedNyEarlyInSession and extendedNyEarlyInSession[1]
ivbInSession = ivbWindowObserved
ivbSessionStart = ivbInSession and not ivbInSession[1]
ivbSessionEnd = not ivbInSession and ivbInSession[1]

// ═══════════════════════════════════════════════════════════════════════════════
// PROCESS
// ═══════════════════════════════════════════════════════════════════════════════
if extendedNyEarlySessionStart
    clearSamples(extendedOpeningPendingHighs, extendedOpeningPendingLows, extendedOpeningPendingVolumes, extendedOpeningPendingDeltas)
    extendedOpeningQualified := false

processAnchor(SOURCE_RTH, rthModeActive, SESSION_PROFILE_RETENTION, rthInSession, rthSessionStart, rthSessionEnd, rthBarHighs, rthBarLows, rthBarVolumes, rthBarDeltas, rthProfiles, rthStartRef, rthLastBarRef, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, false)
processAnchor(SOURCE_GLOBEX, globexModeActive, SESSION_PROFILE_RETENTION, true, globexDayStart, false, globexBarHighs, globexBarLows, globexBarVolumes, globexBarDeltas, globexProfiles, globexStartRef, globexLastBarRef, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, false)
processKeyedBoundedNyAnchor(SOURCE_MIDNIGHT, midnightModeActive, SESSION_PROFILE_RETENTION, NY_MIDNIGHT_MINUTE, NY_MIDNIGHT_MINUTE, true, midnightCurrentSessionStart, midnightBarHighs, midnightBarLows, midnightBarVolumes, midnightBarDeltas, midnightProfiles, midnightStartRef, midnightLastBarRef, midnightSampleSessionStarts, barSampleEndTimes, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas)
processKeyedBoundedNyAnchor(SOURCE_ASIA_PREMARKET, asiaPremarketModeActive, SESSION_PROFILE_RETENTION, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE, asiaPremarketInSession, asiaPremarketCurrentSessionStart, asiaPremarketBarHighs, asiaPremarketBarLows, asiaPremarketBarVolumes, asiaPremarketBarDeltas, asiaPremarketProfiles, asiaPremarketStartRef, asiaPremarketLastBarRef, asiaPremarketSampleSessionStarts, asiaPremarketSampleEndTimes, asiaPremarketSampleHighs, asiaPremarketSampleLows, asiaPremarketSampleVolumes, asiaPremarketSampleDeltas)
processBoundedNyAnchor(SOURCE_NY_EARLY, nyEarlyModeActive, SESSION_PROFILE_RETENTION, NY_EARLY_START_MINUTE, NY_EARLY_END_MINUTE, nyEarlyInSession, nyEarlySessionStart, nyEarlySessionEnd, nyEarlyFirstSampleTime, nyEarlyLastSampleEndTime, nyEarlyBarHighs, nyEarlyBarLows, nyEarlyBarVolumes, nyEarlyBarDeltas, nyEarlyProfiles, nyEarlyStartRef, nyEarlyLastBarRef, nyEarlySampleHighs, nyEarlySampleLows, nyEarlySampleVolumes, nyEarlySampleDeltas)
processBoundedNyAnchor(SOURCE_EXTENDED_NY_EARLY, extendedNyEarlyModeActive, SESSION_PROFILE_RETENTION, NY_EARLY_START_MINUTE, extendedOpeningQualifiedThisBar ? EXTENDED_NY_EARLY_OPENING_END_MINUTE : IVB_START_MINUTE, extendedNyEarlyInSession, extendedNyEarlySessionStart, extendedNyEarlySessionEnd, extendedNyEarlyFirstSampleTime, extendedNyEarlyLastSampleEndTime, extendedNyEarlyBarHighs, extendedNyEarlyBarLows, extendedNyEarlyBarVolumes, extendedNyEarlyBarDeltas, extendedNyEarlyProfiles, extendedNyEarlyStartRef, extendedNyEarlyLastBarRef, extendedNyEarlySampleHighs, extendedNyEarlySampleLows, extendedNyEarlySampleVolumes, extendedNyEarlySampleDeltas)
processBoundedNyAnchor(SOURCE_IVB, ivbModeActive, SESSION_PROFILE_RETENTION, IVB_START_MINUTE, IVB_END_MINUTE, ivbInSession, ivbSessionStart, ivbSessionEnd, ivbFirstSampleTime, ivbLastSampleEndTime, ivbBarHighs, ivbBarLows, ivbBarVolumes, ivbBarDeltas, ivbProfiles, ivbStartRef, ivbLastBarRef, ivbSampleHighs, ivbSampleLows, ivbSampleVolumes, ivbSampleDeltas)

if barstate.isconfirmed and extendedOpeningWindowObserved
    if extendedOpeningQualifiedThisBar
        clearSamples(extendedOpeningPendingHighs, extendedOpeningPendingLows, extendedOpeningPendingVolumes, extendedOpeningPendingDeltas)
        extendedOpeningQualified := true
    else
        appendSamples(extendedOpeningPendingHighs, extendedOpeningPendingLows, extendedOpeningPendingVolumes, extendedOpeningPendingDeltas, extendedOpeningSampleHighs, extendedOpeningSampleLows, extendedOpeningSampleVolumes, extendedOpeningSampleDeltas, false)
if extendedNyEarlySessionEnd
    clearSamples(extendedOpeningPendingHighs, extendedOpeningPendingLows, extendedOpeningPendingVolumes, extendedOpeningPendingDeltas)
    extendedOpeningQualified := false

processAnchor(SOURCE_WEEKLY, calendarWeeklyModeActive, SESSION_PROFILE_RETENTION, true, weeklyPeriodStart, false, weeklyBarHighs, weeklyBarLows, weeklyBarVolumes, weeklyBarDeltas, weeklyProfiles, weeklyStartRef, weeklyLastBarRef, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, true)
processAnchor(SOURCE_MONTHLY, calendarMonthlyModeActive, SESSION_PROFILE_RETENTION, true, monthlyPeriodStart, false, monthlyBarHighs, monthlyBarLows, monthlyBarVolumes, monthlyBarDeltas, monthlyProfiles, monthlyStartRef, monthlyLastBarRef, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, false)
processRollingPeriodAnchor(rollingPeriodSourceName, rollingPeriodSelected, rollingWindowLookbackDays, rollingPeriodOldestStart, rollingRangeEnd, isTwentyFourSevenAsset, rollingPeriodBarHighs, rollingPeriodBarLows, rollingPeriodBarVolumes, rollingPeriodBarDeltas, rollingPeriodProfiles, rollingPeriodStartRef, rollingPeriodEndRef, barSampleStartTimes, barSampleEndTimes, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas)

bool fixedRangeBarMayOverlap = fixedRangeEnabled and fixedRangeConfigured and time < fixedRangeEnd and (na(time_close) or time_close > fixedRangeStart)
bool rollingRangeConfigured = rollingWindowModeActive and not na(last_bar_time)
bool rollingBarRetained = rollingSelected and rollingRangeConfigured and (na(time_close) ? time >= rollingRangeStart : time_close > rollingRangeStart)
if rollingSelected
    pruneRollingSamples(rollingSamples, rollingRangeStart)
if barstate.isconfirmed
    if rollingBarRetained
        int rollingMergeThreshold = rollingLookbackDays <= 7 ? ROLLING_SHORT_WINDOW_COMPACT_THRESHOLD : ROLLING_SAMPLE_COMPACT_THRESHOLD
        appendRollingSamples(rollingSamples, barSampleStartTimes, barSampleEndTimes, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, true, rollingMergeThreshold)
    if fixedRangeBarMayOverlap
        appendContainedSamples(fixedBarHighs, fixedBarLows, fixedBarVolumes, fixedBarDeltas, barSampleStartTimes, barSampleEndTimes, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, fixedRangeStart, fixedRangeEnd, true)

int finalizedMitigationCount = array.size(finalizedMitigationProfiles)
if finalizedMitigationCount > 0
    for finalizedIndex = 0 to finalizedMitigationCount - 1
        FinalizedMitigationProfile finalizedProfile = array.get(finalizedMitigationProfiles, finalizedIndex)
        registerProfileMitigationLevels(finalizedProfile.profile, finalizedProfile.sourceName, isTwentyFourSevenAsset)
    array.clear(finalizedMitigationProfiles)

int mitigationEvaluationTime = currentBarEndTime()
if mitigatedZoneExtensionEnabled(SOURCE_FIXED) and fixedRangeEnabled and fixedRangeConfigured and not fixedMitigationProfileRegistered and mitigationEvaluationTime >= fixedRangeEnd and array.size(fixedBarVolumes) > 0
    DeltaProfile completedFixedProfile = buildDeltaProfile(fixedBarHighs, fixedBarLows, fixedBarVolumes, fixedBarDeltas, PROFILE_ROWS, fixedRangeStart, fixedRangeEnd)
    if completedFixedProfile.isValid
        registerProfileMitigationLevels(completedFixedProfile, SOURCE_FIXED, isTwentyFourSevenAsset)
        fixedMitigationProfileRegistered := true
bool rollingMitigationProfileChanged = na(registeredRollingMitigationEndTime) or registeredRollingMitigationEndTime != rollingRangeEnd
bool rollingLiveMitigationRefresh = rollingWindowThrough == ROLLING_THROUGH_LIVE and not barstate.isconfirmed
bool rollingMitigationSamplesAvailable = rollingSampleStoreSize(rollingSamples) > 0 or (not barstate.isconfirmed and rollingBarRetained and array.size(barSampleVolumes) > 0)
if mitigatedZoneExtensionEnabled(SOURCE_ROLLING) and rollingSelected and rollingRangeConfigured and (rollingMitigationProfileChanged or rollingLiveMitigationRefresh) and mitigationEvaluationTime >= rollingRangeEnd and rollingMitigationSamplesAvailable
    DeltaProfile completedRollingProfile = buildCurrentRollingDeltaProfile(rollingSamples, PROFILE_ROWS, rollingRangeStart, rollingRangeEnd, rollingWindowThrough == ROLLING_THROUGH_LIVE, rollingUsesClockCutoff(rollingWindowThrough), rollingBarRetained, barSampleStartTimes, barSampleEndTimes, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas)
    if completedRollingProfile.isValid
        removeMitigatedSource(SOURCE_ROLLING)
        registerProfileMitigationLevels(completedRollingProfile, SOURCE_ROLLING, isTwentyFourSevenAsset)
        registeredRollingMitigationEndTime := rollingRangeEnd

array<int> mitigationBoundaryTimes = array.new<int>()
array<int> mitigationBoundaryEndTimes = array.new<int>()
array<float> mitigationBoundaryHighs = array.new<float>()
array<float> mitigationBoundaryLows = array.new<float>()
string requestedMitigationTimeframe = mitigationBoundaryRequestTimeframe()
if requestedMitigationTimeframe != ""
    [requestedBoundaryTimes, requestedBoundaryEndTimes, requestedBoundaryHighs, requestedBoundaryLows] = mitigationBoundarySamples(requestedMitigationTimeframe)
    mitigationBoundaryTimes := requestedBoundaryTimes
    mitigationBoundaryEndTimes := requestedBoundaryEndTimes
    mitigationBoundaryHighs := requestedBoundaryHighs
    mitigationBoundaryLows := requestedBoundaryLows
updateMitigatedZoneStates(mitigationBoundaryTimes, mitigationBoundaryEndTimes, mitigationBoundaryHighs, mitigationBoundaryLows)

// ═══════════════════════════════════════════════════════════════════════════════
// SHOW ONLY
// ═══════════════════════════════════════════════════════════════════════════════
inVisibleOvernight = not na(time(timeframe.period, SESSION_WINDOW_OVERNIGHT, NY_TIMEZONE))
inVisibleFrom0500 = not na(time(timeframe.period, SESSION_WINDOW_FROM_0500, NY_TIMEZONE))
inVisibleFrom0830 = not na(time(timeframe.period, SESSION_WINDOW_FROM_0830, NY_TIMEZONE))
inVisibleRth = not na(time(timeframe.period, SESSION_WINDOW_RTH, NY_TIMEZONE))
inVisibleWindow = visibleWindow == WINDOW_LABEL_FROM_0500 ? inVisibleFrom0500 : visibleWindow == WINDOW_LABEL_FROM_0830 ? inVisibleFrom0830 : visibleWindow == WINDOW_LABEL_RTH ? inVisibleRth : inVisibleOvernight
inMostRecentDay = sameCalendarDate(time, timenow, NY_TIMEZONE)
hideThisBar = showOnlyEnabled and not (inVisibleWindow and (not showOnlyMostRecent or inMostRecentDay))

plotcandle(hideThisBar ? open : na, high, low, close, title="Hidden", color=hiddenCandleColor, bordercolor=hiddenCandleColor, wickcolor=hiddenCandleColor, editable=false, display=display.pane, force_overlay=true)

// ═══════════════════════════════════════════════════════════════════════════════
// RENDER
// ═══════════════════════════════════════════════════════════════════════════════
if barstate.islast
    clearDrawings()

    // Include the open bar once.
    DeltaProfile rollingProfile = na
    if rollingSelected and rollingRangeConfigured
        rollingProfile := buildCurrentRollingDeltaProfile(rollingSamples, PROFILE_ROWS, rollingRangeStart, rollingRangeEnd, rollingWindowThrough == ROLLING_THROUGH_LIVE, rollingUsesClockCutoff(rollingWindowThrough), rollingBarRetained, barSampleStartTimes, barSampleEndTimes, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas)

    DeltaProfile fixedProfile = na
    if fixedRangeEnabled and fixedRangeConfigured
        int originalSize = array.size(fixedBarVolumes)
        if not barstate.isconfirmed and fixedRangeBarMayOverlap
            appendContainedSamples(fixedBarHighs, fixedBarLows, fixedBarVolumes, fixedBarDeltas, barSampleStartTimes, barSampleEndTimes, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, fixedRangeStart, fixedRangeEnd, false)
        fixedProfile := buildDeltaProfile(fixedBarHighs, fixedBarLows, fixedBarVolumes, fixedBarDeltas, PROFILE_ROWS, fixedRangeStart, math.min(fixedRangeEnd, time))
        while array.size(fixedBarVolumes) > originalSize
            array.pop(fixedBarHighs)
            array.pop(fixedBarLows)
            array.pop(fixedBarVolumes)
            array.pop(fixedBarDeltas)

    // The keyed processor already includes current samples on this execution.
    array<float> keyedNoSampleHighs = array.new<float>()
    array<float> keyedNoSampleLows = array.new<float>()
    array<float> keyedNoSampleVolumes = array.new<float>()
    array<float> keyedNoSampleDeltas = array.new<float>()
    int midnightStoredEndTime = array.get(midnightLastBarRef, 0)
    int midnightDevelopingSampleEndTime = midnightStoredEndTime == START_TIME_UNSET ? time : midnightStoredEndTime
    int midnightDevelopingEndTime = midnightCurrentSessionStart == START_TIME_UNSET ? midnightDevelopingSampleEndTime : math.min(midnightDevelopingSampleEndTime, nySessionEndBoundary(midnightCurrentSessionStart, NY_MIDNIGHT_MINUTE, NY_MIDNIGHT_MINUTE))
    int asiaPremarketStoredEndTime = array.get(asiaPremarketLastBarRef, 0)
    int asiaPremarketDevelopingSampleEndTime = asiaPremarketStoredEndTime == START_TIME_UNSET ? asiaPremarketEvaluationTime : asiaPremarketStoredEndTime
    int asiaPremarketDevelopingEndTime = asiaPremarketInSession ? math.min(asiaPremarketDevelopingSampleEndTime, nySessionEndBoundary(asiaPremarketCurrentSessionStart, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE)) : asiaPremarketStoredEndTime
    int nyEarlyDevelopingEndTime = nyEarlyInSession ? math.min(nyEarlyLastSampleEndTime, nyMinuteBoundary(array.get(nyEarlyStartRef, 0), NY_EARLY_END_MINUTE)) : array.get(nyEarlyLastBarRef, 0)
    int extendedNyEarlyDevelopingEndTime = extendedNyEarlyInSession ? (extendedOpeningQualifiedThisBar ? math.min(extendedNyEarlyLastSampleEndTime, nyMinuteBoundary(array.get(extendedNyEarlyStartRef, 0), EXTENDED_NY_EARLY_OPENING_END_MINUTE)) : math.min(extendedNyEarlyLastSampleEndTime, nyMinuteBoundary(array.get(extendedNyEarlyStartRef, 0), IVB_START_MINUTE))) : array.get(extendedNyEarlyLastBarRef, 0)
    int ivbDevelopingEndTime = ivbInSession ? math.min(ivbLastSampleEndTime, nyMinuteBoundary(array.get(ivbStartRef, 0), IVB_END_MINUTE)) : array.get(ivbLastBarRef, 0)
    ProfileSelection selectedSessionProfiles = na
    ProfileSelection selectedNyEarlyProfiles = na
    ProfileSelection selectedExtendedNyEarlyProfiles = na
    ProfileSelection selectedIvbProfiles = na
    bool groupedNyProfilesActive = nyEarlyModeActive and extendedNyEarlyModeActive
    if groupedNyProfilesActive
        if nyEarlyModeActive
            selectedNyEarlyProfiles := selectSessionProfiles(priorProfilesToShow, nyEarlyInSession, hideDeveloping, nyEarlyBarHighs, nyEarlyBarLows, nyEarlyBarVolumes, nyEarlyBarDeltas, nyEarlyProfiles, nyEarlyStartRef, nyEarlySampleHighs, nyEarlySampleLows, nyEarlySampleVolumes, nyEarlySampleDeltas, nyEarlyDevelopingEndTime)
        if extendedNyEarlyModeActive
            selectedExtendedNyEarlyProfiles := selectSessionProfiles(priorProfilesToShow, extendedNyEarlyInSession, hideDeveloping, extendedNyEarlyBarHighs, extendedNyEarlyBarLows, extendedNyEarlyBarVolumes, extendedNyEarlyBarDeltas, extendedNyEarlyProfiles, extendedNyEarlyStartRef, extendedNyEarlySampleHighs, extendedNyEarlySampleLows, extendedNyEarlySampleVolumes, extendedNyEarlySampleDeltas, extendedNyEarlyDevelopingEndTime)
        if ivbModeActive
            selectedIvbProfiles := selectSessionProfiles(priorProfilesToShow, ivbInSession, hideDeveloping, ivbBarHighs, ivbBarLows, ivbBarVolumes, ivbBarDeltas, ivbProfiles, ivbStartRef, ivbSampleHighs, ivbSampleLows, ivbSampleVolumes, ivbSampleDeltas, ivbDevelopingEndTime)
    else if rthModeActive
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, rthInSession, hideDeveloping, rthBarHighs, rthBarLows, rthBarVolumes, rthBarDeltas, rthProfiles, rthStartRef, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, time)
    else if globexModeActive
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, true, hideDeveloping, globexBarHighs, globexBarLows, globexBarVolumes, globexBarDeltas, globexProfiles, globexStartRef, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, time)
    else if midnightModeActive
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, true, hideDeveloping, midnightBarHighs, midnightBarLows, midnightBarVolumes, midnightBarDeltas, midnightProfiles, midnightStartRef, keyedNoSampleHighs, keyedNoSampleLows, keyedNoSampleVolumes, keyedNoSampleDeltas, midnightDevelopingEndTime)
    else if asiaPremarketModeActive
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, asiaPremarketInSession, hideDeveloping, asiaPremarketBarHighs, asiaPremarketBarLows, asiaPremarketBarVolumes, asiaPremarketBarDeltas, asiaPremarketProfiles, asiaPremarketStartRef, keyedNoSampleHighs, keyedNoSampleLows, keyedNoSampleVolumes, keyedNoSampleDeltas, asiaPremarketDevelopingEndTime)
    else if nyEarlyModeActive
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, nyEarlyInSession, hideDeveloping, nyEarlyBarHighs, nyEarlyBarLows, nyEarlyBarVolumes, nyEarlyBarDeltas, nyEarlyProfiles, nyEarlyStartRef, nyEarlySampleHighs, nyEarlySampleLows, nyEarlySampleVolumes, nyEarlySampleDeltas, nyEarlyDevelopingEndTime)
    else if extendedNyEarlyModeActive
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, extendedNyEarlyInSession, hideDeveloping, extendedNyEarlyBarHighs, extendedNyEarlyBarLows, extendedNyEarlyBarVolumes, extendedNyEarlyBarDeltas, extendedNyEarlyProfiles, extendedNyEarlyStartRef, extendedNyEarlySampleHighs, extendedNyEarlySampleLows, extendedNyEarlySampleVolumes, extendedNyEarlySampleDeltas, extendedNyEarlyDevelopingEndTime)
    else if ivbModeActive
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, ivbInSession, hideDeveloping, ivbBarHighs, ivbBarLows, ivbBarVolumes, ivbBarDeltas, ivbProfiles, ivbStartRef, ivbSampleHighs, ivbSampleLows, ivbSampleVolumes, ivbSampleDeltas, ivbDevelopingEndTime)
    else if rollingPeriodSelected
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, false, false, rollingPeriodBarHighs, rollingPeriodBarLows, rollingPeriodBarVolumes, rollingPeriodBarDeltas, rollingPeriodProfiles, rollingPeriodStartRef, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, rollingRangeEnd)
    else if calendarWeeklyModeActive
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, true, false, weeklyBarHighs, weeklyBarLows, weeklyBarVolumes, weeklyBarDeltas, weeklyProfiles, weeklyStartRef, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, time)
    else if calendarMonthlyModeActive
        selectedSessionProfiles := selectSessionProfiles(priorProfilesToShow, true, false, monthlyBarHighs, monthlyBarLows, monthlyBarVolumes, monthlyBarDeltas, monthlyProfiles, monthlyStartRef, barSampleHighs, barSampleLows, barSampleVolumes, barSampleDeltas, time)

    array<ProfileSelection> budgetedProfileSelections = array.new<ProfileSelection>()
    array<string> budgetedProfileSourceNames = array.new<string>()
    if groupedNyProfilesActive
        if not na(selectedExtendedNyEarlyProfiles)
            array.push(budgetedProfileSelections, selectedExtendedNyEarlyProfiles)
            array.push(budgetedProfileSourceNames, SOURCE_EXTENDED_NY_EARLY)
        if not na(selectedNyEarlyProfiles)
            array.push(budgetedProfileSelections, selectedNyEarlyProfiles)
            array.push(budgetedProfileSourceNames, SOURCE_NY_EARLY)
        if not na(selectedIvbProfiles)
            array.push(budgetedProfileSelections, selectedIvbProfiles)
            array.push(budgetedProfileSourceNames, SOURCE_IVB)
    else if not na(selectedSessionProfiles)
        array.push(budgetedProfileSelections, selectedSessionProfiles)
        array.push(budgetedProfileSourceNames, activeAnchorName())
    trimProfileSelectionsToCapacity(budgetedProfileSelections, budgetedProfileSourceNames, activeCoreProfileCapacity)

    if chartTimesBuiltAtBar != bar_index
        cachedChartTimes := recentChartTimes()
        chartTimesBuiltAtBar := bar_index
    array<int> chartTimes = cachedChartTimes
    int selectedProfileCount = rollingSelected and not na(rollingProfile) and rollingProfile.isValid ? 1 : 0
    int budgetedSelectionCount = array.size(budgetedProfileSelections)
    if budgetedSelectionCount > 0
        for selectionIndex = 0 to budgetedSelectionCount - 1
            ProfileSelection selection = array.get(budgetedProfileSelections, selectionIndex)
            string sourceName = array.get(budgetedProfileSourceNames, selectionIndex)
            ProfileSelection comparisonSelection = sourceName == SOURCE_EXTENDED_NY_EARLY ? selectedNyEarlyProfiles : sourceName == SOURCE_NY_EARLY ? selectedExtendedNyEarlyProfiles : na
            selectedProfileCount += renderableProfileCount(selection, sourceName, comparisonSelection)
    bool renderBudgetedHistograms = showHistogram and activeHistogramPolylineLayers > 0 and selectedProfileCount > 0 and selectedProfileCount * (activeDeltaPolylineLayers + activeHistogramPolylineLayers) <= INDICATOR_MAX_POLYLINES
    if rollingSelected and not na(rollingProfile) and rollingProfile.isValid
        renderSelectedProfile(rollingProfile, SOURCE_ROLLING, "", false, false, true, isTwentyFourSevenAsset, chartTimes, renderBudgetedHistograms, activeHistogramPolylineLayers)
    else if budgetedSelectionCount > 0
        for renderPass = 0 to 1
            bool currentPass = renderPass == 0
            for selectionIndex = 0 to budgetedSelectionCount - 1
                ProfileSelection selection = array.get(budgetedProfileSelections, selectionIndex)
                string sourceName = array.get(budgetedProfileSourceNames, selectionIndex)
                ProfileSelection comparisonSelection = sourceName == SOURCE_EXTENDED_NY_EARLY ? selectedNyEarlyProfiles : sourceName == SOURCE_NY_EARLY ? selectedExtendedNyEarlyProfiles : na
                renderProfileSelection(selection, sourceName, comparisonSelection, isTwentyFourSevenAsset, chartTimes, currentPass, renderBudgetedHistograms, activeHistogramPolylineLayers)
    flushPendingMitigatedZones()
    flushPendingRightLines(mergeOverlaps)
    flushPendingRightLabels()

    if fixedRangeEnabled and not na(fixedProfile) and fixedProfile.isValid
        bool renderFixedHistogram = showHistogram and activeHistogramPolylineLayers > 0 and activeDeltaPolylineLayers + activeHistogramPolylineLayers <= INDICATOR_MAX_POLYLINES
        renderSelectedProfile(fixedProfile, SOURCE_FIXED, "", false, false, true, isTwentyFourSevenAsset, chartTimes, renderFixedHistogram, activeHistogramPolylineLayers)
        flushPendingMitigatedZones()
        flushPendingRightLines(mergeOverlaps)
        flushPendingRightLabels()

    if showColorTable
        array<ColorRow> colorRows = array.new<ColorRow>()
        if showOnlyEnabled
            addColorRow(colorRows, "Hidden", hiddenCandleColor, "")
        if not na(colorTable)
            table.delete(colorTable)
        colorTable := table.new(position.top_right, 4, array.size(colorRows) + 1, bgcolor=color.rgb(255, 255, 255), border_width=1, border_color=color.rgb(128, 128, 128), frame_width=1, frame_color=color.rgb(128, 128, 128))
        table.cell(colorTable, 0, 0, LABEL_TABLE_SETTING, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        table.cell(colorTable, 1, 0, LABEL_TABLE_RGB, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        table.cell(colorTable, 2, 0, LABEL_TABLE_TRANSPARENCY, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        table.cell(colorTable, 3, 0, LABEL_TABLE_WIDTH, bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
        if array.size(colorRows) > 0
            for rowIndex = 0 to array.size(colorRows) - 1
                writeColorRow(colorTable, rowIndex + 1, array.get(colorRows, rowIndex))
    else if not na(colorTable)
        table.delete(colorTable)
        colorTable := na

// legilimens •
