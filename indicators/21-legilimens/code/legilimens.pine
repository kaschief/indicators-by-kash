type DeltaTierAppearance
    bool hasLine
    color lineColor
    int lineWidth
    string lineStyle
    color textColor
    color zoneColor

appendDeltaTierPair(array<DeltaTierAppearance> appearances, bool hasLine, color buyLineColor, color sellLineColor, int lineWidth, string lineStyle, color buyTextColor, color sellTextColor, color buyZoneColor, color sellZoneColor) =>
    array.push(appearances, DeltaTierAppearance.new(hasLine, buyLineColor, lineWidth, lineStyle, buyTextColor, buyZoneColor))
    array.push(appearances, DeltaTierAppearance.new(hasLine, sellLineColor, lineWidth, lineStyle, sellTextColor, sellZoneColor))

var array<int> tierMarkerSizes = array.from(DOMINANT_DOT_SIZE, STRONG_DOT_SIZE, MODERATE_DOT_SIZE, MINOR_DOT_SIZE, WEAK_DOT_SIZE)

var array<DeltaTierAppearance> deltaTierAppearances = array.new<DeltaTierAppearance>()
var array<DeltaTierAppearance> alternateDeltaTierAppearances = array.new<DeltaTierAppearance>()
if barstate.isfirst
    appendDeltaTierPair(deltaTierAppearances, true, color.new(color.rgb(0, 255, 0), 10), color.new(color.rgb(245, 65, 81), 10), DELTA_TIER_5_LINE_WIDTH, STYLE_DASHED, color.rgb(77, 243, 8), color.rgb(249, 121, 246), color.new(color.rgb(114, 243, 114), 85), color.new(color.rgb(249, 121, 246), 82))
    appendDeltaTierPair(deltaTierAppearances, true, color.new(color.rgb(56, 142, 60), 30), color.new(color.rgb(178, 40, 51), 30), DELTA_TIER_4_LINE_WIDTH, STYLE_DASHED, color.new(color.rgb(77, 243, 8), 10), color.new(color.rgb(249, 121, 246), 10), color.new(color.rgb(114, 243, 114), 88), color.new(color.rgb(249, 121, 246), 88))
    appendDeltaTierPair(deltaTierAppearances, false, color(na), color(na), 1, STYLE_SOLID, color.new(color.rgb(163, 218, 165), 10), color.new(color.rgb(249, 121, 246), 30), color.new(color.rgb(114, 243, 114), 90), color.new(color.rgb(249, 121, 246), 90))
    appendDeltaTierPair(deltaTierAppearances, false, color(na), color(na), 1, STYLE_SOLID, color.new(color.rgb(114, 243, 114), 30), color.new(color.rgb(249, 121, 246), 30), color.new(color.rgb(114, 243, 114), 90), color.new(color.rgb(249, 121, 246), 90))
    appendDeltaTierPair(deltaTierAppearances, false, color(na), color(na), 1, STYLE_SOLID, color.new(color.rgb(163, 218, 165), 20), color.new(color.rgb(128, 25, 34), 92), color.new(color.rgb(114, 243, 114), 90), color.new(color.rgb(249, 121, 246), 90))

    appendDeltaTierPair(alternateDeltaTierAppearances, true, color.new(color.rgb(56, 142, 60), 30), color.new(color.rgb(178, 40, 51), 30), DELTA_TIER_5_LINE_WIDTH, STYLE_DASHED, color.rgb(56, 142, 60), color.rgb(178, 40, 51), color.new(color.rgb(56, 142, 60), 92), color.new(color.rgb(178, 40, 51), 92))
    appendDeltaTierPair(alternateDeltaTierAppearances, true, color.new(color.rgb(56, 142, 60), 30), color.new(color.rgb(178, 40, 51), 30), DELTA_TIER_4_LINE_WIDTH, STYLE_DASHED, color.rgb(56, 142, 60), color.rgb(178, 40, 51), color.new(color.rgb(56, 142, 60), 92), color.new(color.rgb(178, 40, 51), 92))
    appendDeltaTierPair(alternateDeltaTierAppearances, false, color(na), color(na), 1, STYLE_SOLID, color.rgb(56, 142, 60), color.rgb(178, 40, 51), color.new(color.rgb(56, 142, 60), 92), color.new(color.rgb(178, 40, 51), 92))
    appendDeltaTierPair(alternateDeltaTierAppearances, false, color(na), color(na), 1, STYLE_SOLID, color.rgb(56, 142, 60), color.rgb(178, 40, 51), color.new(color.rgb(56, 142, 60), 92), color.new(color.rgb(178, 40, 51), 92))
    appendDeltaTierPair(alternateDeltaTierAppearances, false, color(na), color(na), 1, STYLE_SOLID, color.rgb(56, 142, 60), color.rgb(178, 40, 51), color.new(color.rgb(56, 142, 60), 92), color.new(color.rgb(178, 40, 51), 92))

// ═══════════════════════════════════════════════════════════════════════════════
// CALCULATION
// ═══════════════════════════════════════════════════════════════════════════════
deltaPolylineLayersPerProfile(string visibleRows, bool outliersOnly) =>
    int visibleSides = visibleRows == OPTION_OFF ? 0 : visibleRows == OPTION_ALL ? 2 : 1
    int layersPerSide = outliersOnly ? 1 : DELTA_POLYLINE_LAYER_COUNT_PER_SIDE
    visibleSides * layersPerSide

filteredDeltaRowsOnly() =>
    deltaRowFilter != OPTION_ALL

selectedTierOutlierRowsOnly() =>
    deltaRowFilter == DELTA_ROW_FILTER_SELECTED_TIER_OUTLIERS

histogramPolylineLayersPerProfile(bool enabled, bool useValueAreaColors) =>
    enabled ? useValueAreaColors ? HISTOGRAM_VALUE_AREA_POLYLINE_LAYER_COUNT : HISTOGRAM_POLYLINE_LAYER_COUNT : 0

visibleDeltaTierSideCount() =>
    showDeltaTiers and not enableQuickCheck and deltaTierSideVisibility != OPTION_OFF ? deltaTierSideVisibility == OPTION_ALL ? 2 : 1 : 0

maximumDeltaTierLineCountPerSide() =>
    int lineCount = 0
    if showDeltaTiers and not enableQuickCheck
        for strengthRank = 1 to visibleDeltaTierCount
            int tierIndex = strengthRank - 1
            int buyAppearanceIndex = tierIndex * 2
            int sellAppearanceIndex = buyAppearanceIndex + 1
            bool standardHasLine = array.get(deltaTierAppearances, buyAppearanceIndex).hasLine or array.get(deltaTierAppearances, sellAppearanceIndex).hasLine
            bool alternateHasLine = array.get(alternateDeltaTierAppearances, buyAppearanceIndex).hasLine or array.get(alternateDeltaTierAppearances, sellAppearanceIndex).hasLine
            if standardHasLine or alternateHasLine
                lineCount += 1
    lineCount

maximumCoreObjectCostsPerProfile() =>
    int deltaTierSides = visibleDeltaTierSideCount()
    int lvnTierCount = showMinimumLvnTiers and not enableQuickCheck ? visibleLvnTierCount : 0
    int deltaTierCount = deltaTierSides * visibleDeltaTierCount
    int referenceLineCount = (showValueAreaLevels or enableQuickCheck ? 2 : 0) + (showPocLevel or enableQuickCheck ? 1 : 0)
    int rightLineCount = lvnTierCount + deltaTierSides * maximumDeltaTierLineCountPerSide()
    int pocLabelCount = showPocLevel or enableQuickCheck ? 1 : 0
    int lvnMarkerLabelCount = showDots ? lvnTierCount + (showDotLabels and lvnTierCount > 0 ? 1 : 0) : 0
    int deltaMarkerLabelCount = showDots ? deltaTierCount + (showDotLabels ? deltaTierSides : 0) : 0
    int zoneBoxCount = lvnTierCount + deltaTierCount
    [referenceLineCount + rightLineCount, PROFILE_HEADING_LABEL_COUNT + pocLabelCount + lvnMarkerLabelCount + deltaMarkerLabelCount, PROFILE_FRAME_BOX_COUNT + zoneBoxCount]

profileCapacityForObjectLimit(int objectLimit, int objectsPerProfile, int fallbackCapacity) =>
    objectsPerProfile > 0 ? int(math.floor(objectLimit / float(objectsPerProfile))) : fallbackCapacity

maximumCoreProfileCapacity(int sourceCount, int deltaLayersPerProfile, int linesPerProfile, int labelsPerProfile, int boxesPerProfile) =>
    int requestedCapacity = math.max(1, sourceCount) * SESSION_PROFILE_RETENTION
    int totalProfileCapacity = requestedCapacity
    totalProfileCapacity := math.min(totalProfileCapacity, profileCapacityForObjectLimit(INDICATOR_MAX_POLYLINES, deltaLayersPerProfile, requestedCapacity))
    totalProfileCapacity := math.min(totalProfileCapacity, profileCapacityForObjectLimit(INDICATOR_MAX_LINES, linesPerProfile, requestedCapacity))
    totalProfileCapacity := math.min(totalProfileCapacity, profileCapacityForObjectLimit(INDICATOR_MAX_LABELS, labelsPerProfile, requestedCapacity))
    totalProfileCapacity := math.min(totalProfileCapacity, profileCapacityForObjectLimit(INDICATOR_MAX_BOXES, boxesPerProfile, requestedCapacity))
    totalProfileCapacity

int activeProfileSourceCount = (nyEarlyModeActive ? 1 : 0) + (extendedNyEarlyModeActive ? 1 : 0) + (ivbModeActive ? 1 : 0) + (asiaPremarketModeActive ? 1 : 0) + (rthModeActive ? 1 : 0) + (globexModeActive ? 1 : 0) + (midnightModeActive ? 1 : 0) + (calendarWeeklyModeActive ? 1 : 0) + (calendarMonthlyModeActive ? 1 : 0) + (rollingWindowModeActive ? 1 : 0) + (fixedSelected ? 1 : 0)
int activeDeltaPolylineLayers = deltaPolylineLayersPerProfile(deltaHistogramRows, filteredDeltaRowsOnly())
int activeHistogramPolylineLayers = histogramPolylineLayersPerProfile(showHistogram, useHistogramValueAreaColors)
[activeLinesPerProfile, activeLabelsPerProfile, activeBoxesPerProfile] = maximumCoreObjectCostsPerProfile()
int activeCoreProfileCapacity = maximumCoreProfileCapacity(activeProfileSourceCount, activeDeltaPolylineLayers, activeLinesPerProfile, activeLabelsPerProfile, activeBoxesPerProfile)

autoIntrabarTimeframe() =>
    float chartSeconds = timeframe.in_seconds(timeframe.period)
    chart.is_range ? INTRABAR_TIMEFRAME_ONE_MINUTE : chartSeconds <= SECONDS_PER_MINUTE ? INTRABAR_TIMEFRAME_ONE_SECOND : chartSeconds <= 15 * SECONDS_PER_MINUTE ? INTRABAR_TIMEFRAME_ONE_MINUTE : chartSeconds <= 60 * SECONDS_PER_MINUTE ? INTRABAR_TIMEFRAME_FIVE_MINUTES : chartSeconds <= 4 * 60 * SECONDS_PER_MINUTE ? INTRABAR_TIMEFRAME_FIFTEEN_MINUTES : INTRABAR_TIMEFRAME_ONE_HOUR

sameCalendarDate(int firstTime, int secondTime, string timezone) =>
    year(firstTime, timezone) == year(secondTime, timezone) and month(firstTime, timezone) == month(secondTime, timezone) and dayofmonth(firstTime, timezone) == dayofmonth(secondTime, timezone)

toLineStyle(string styleName) =>
    styleName == STYLE_DASHED ? line.style_dashed : styleName == STYLE_DOTTED ? line.style_dotted : line.style_solid

toLabelSize(string sizeName) =>
    sizeName == LABEL_SIZE_TINY ? size.tiny : size.small

labelPointSize(string sizeName) =>
    sizeName == LABEL_SIZE_TINY ? 7.0 : 10.0

rangeTitleLayout(DeltaProfile profile, string sizeName) =>
    float pricePerLayoutUnit = (profile.rangeHigh - profile.rangeLow) / profile.rowCount
    float titleClearance = pricePerLayoutUnit * (labelPointSize(sizeName) + RANGE_TITLE_CONTAINER_PADDING)
    [profile.rangeHigh, profile.rangeLow, titleClearance]

quarterDurationValue(float duration) =>
    duration > 0 ? math.max(0.25, math.round(duration * 4.0) / 4.0) : 0.0

formatQuarterDuration(float duration) =>
    str.tostring(quarterDurationValue(duration), "#.##")

fixedRangeTradingDayDuration(int firstTime, int secondTime) =>
    int shiftedStartTime = math.min(firstTime, secondTime) + GLOBEX_REOPEN_SHIFT_MS
    int shiftedEndTime = math.max(firstTime, secondTime) + GLOBEX_REOPEN_SHIFT_MS
    int cursorDate = timestamp(NY_TIMEZONE, year(shiftedStartTime, NY_TIMEZONE), month(shiftedStartTime, NY_TIMEZONE), dayofmonth(shiftedStartTime, NY_TIMEZONE), 0, 0)
    float tradingDays = 0.0
    while cursorDate < shiftedEndTime
        int nextDate = timestamp(NY_TIMEZONE, year(cursorDate, NY_TIMEZONE), month(cursorDate, NY_TIMEZONE), dayofmonth(cursorDate, NY_TIMEZONE) + 1, 0, 0)
        int weekday = dayofweek(cursorDate, NY_TIMEZONE)
        if weekday >= dayofweek.monday and weekday <= dayofweek.friday
            int overlapStart = math.max(shiftedStartTime, cursorDate)
            int overlapEnd = math.min(shiftedEndTime, nextDate)
            if overlapEnd > overlapStart
                tradingDays += float(overlapEnd - overlapStart) / float(nextDate - cursorDate)
        cursorDate := nextDate
    tradingDays

formatFixedRangeDuration(int firstTime, int secondTime, bool twentyFourSeven) =>
    int durationMs = math.abs(secondTime - firstTime)
    float durationMinutes = float(durationMs) / MS_PER_MINUTE
    float durationHours = float(durationMs) / MS_PER_HOUR
    float durationDays = durationHours / 24.0
    float displayedDays = twentyFourSeven ? durationDays : fixedRangeTradingDayDuration(firstTime, secondTime)
    quarterDurationValue(durationHours) >= 24.0 ? formatQuarterDuration(displayedDays) + "-Day" : durationHours >= 1.0 or quarterDurationValue(durationMinutes) >= 60.0 ? formatQuarterDuration(durationHours) + "-Hour" : formatQuarterDuration(durationMinutes) + "-Minute"

profileDisplayName(string sourceName, string displayNameOverride, bool twentyFourSeven) =>
    displayNameOverride != "" ? displayNameOverride : sourceName == SOURCE_FIXED ? PROFILE_EMOJI_FIXED + formatFixedRangeDuration(fixedRangeStartInput, fixedRangeEndInput, twentyFourSeven) + " " + PROFILE_NAME_FIXED : sourceName == SOURCE_ROLLING ? "Rolling " + rollingLookbackTag + " Range" : sourceName == SOURCE_WEEKLY and weeklyRollingSelected ? DISPLAY_ROLLING_WEEKLY : sourceName == SOURCE_MONTHLY and monthlyRollingSelected ? DISPLAY_ROLLING_MONTHLY : sourceName

profileSourceName(string sourceName, string displayNameOverride) =>
    displayNameOverride != "" ? displayNameOverride : sourceName == SOURCE_FIXED ? PROFILE_NAME_FIXED : sourceName == SOURCE_ROLLING ? PROFILE_NAME_ROLLING : sourceName == SOURCE_WEEKLY and weeklyRollingSelected ? DISPLAY_ROLLING_WEEKLY : sourceName == SOURCE_MONTHLY and monthlyRollingSelected ? DISPLAY_ROLLING_MONTHLY : sourceName

activeAnchorName() =>
    anchorMode == MODE_ROLLING ? SOURCE_ROLLING : anchorMode == MODE_NY_EARLY ? SOURCE_NY_EARLY : anchorMode == MODE_EXTENDED_NY_EARLY ? SOURCE_EXTENDED_NY_EARLY : anchorMode == MODE_IVB ? SOURCE_IVB : anchorMode == MODE_NY_EARLY_IVB ? SOURCE_NY_EARLY_IVB : anchorMode == MODE_ASIA_PREMARKET ? SOURCE_ASIA_PREMARKET : anchorMode == MODE_RTH ? SOURCE_RTH : anchorMode == MODE_GLOBEX ? SOURCE_GLOBEX : anchorMode == MODE_MIDNIGHT ? SOURCE_MIDNIGHT : anchorMode == MODE_WEEKLY ? SOURCE_WEEKLY : anchorMode == MODE_MONTHLY ? SOURCE_MONTHLY : ""

isTrueWeekendBar(int barTime) =>
    int barDay = dayofweek(barTime, NY_TIMEZONE)
    int barHour = hour(barTime, NY_TIMEZONE)
    barDay == dayofweek.saturday or (barDay == dayofweek.sunday and barHour < SUNDAY_REOPEN_START_HOUR)

calendarDayStart(string timezone) =>
    ta.change(dayofmonth(time, timezone)) != 0

shiftedCalendarDayStart(string timezone, int timeShiftMilliseconds) =>
    ta.change(dayofmonth(time + timeShiftMilliseconds, timezone)) != 0

shiftedCalendarMonthStart(string timezone, int timeShiftMilliseconds) =>
    ta.change(month(time + timeShiftMilliseconds, timezone)) != 0

weeklyBoundary(bool twentyFourSeven, bool utcBoundary, bool futuresBoundary, int barTime) =>
    twentyFourSeven ? utcBoundary and dayofweek(barTime, UTC_TIMEZONE) == dayofweek.monday : futuresBoundary and dayofweek(barTime, NY_TIMEZONE) == dayofweek.sunday

isNyWeekday(int barTime) =>
    int weekday = dayofweek(barTime, NY_TIMEZONE)
    weekday >= dayofweek.monday and weekday <= dayofweek.friday

inNyMinuteWindow(int barTime, int startMinute, int endMinute) =>
    int barMinute = hour(barTime, NY_TIMEZONE) * 60 + minute(barTime, NY_TIMEZONE)
    startMinute <= endMinute ? barMinute >= startMinute and barMinute < endMinute : barMinute >= startMinute or barMinute < endMinute

nyMinuteBoundary(int referenceTime, int minuteOfDay) =>
    timestamp(NY_TIMEZONE, year(referenceTime, NY_TIMEZONE), month(referenceTime, NY_TIMEZONE), dayofmonth(referenceTime, NY_TIMEZONE), int(math.floor(minuteOfDay / 60)), minuteOfDay % 60)

nySessionStartBoundary(int referenceTime, int startMinute, int endMinute) =>
    int referenceMinute = hour(referenceTime, NY_TIMEZONE) * 60 + minute(referenceTime, NY_TIMEZONE)
    int startDayOffset = startMinute > endMinute and referenceMinute < endMinute ? -1 : 0
    timestamp(NY_TIMEZONE, year(referenceTime, NY_TIMEZONE), month(referenceTime, NY_TIMEZONE), dayofmonth(referenceTime, NY_TIMEZONE) + startDayOffset, int(math.floor(startMinute / 60)), startMinute % 60)

nySessionEndBoundary(int referenceTime, int startMinute, int endMinute) =>
    int startTime = nySessionStartBoundary(referenceTime, startMinute, endMinute)
    int endDayOffset = startMinute >= endMinute ? 1 : 0
    timestamp(NY_TIMEZONE, year(startTime, NY_TIMEZONE), month(startTime, NY_TIMEZONE), dayofmonth(startTime, NY_TIMEZONE) + endDayOffset, int(math.floor(endMinute / 60)), endMinute % 60)

isNySessionTradingDay(int barTime, int startMinute, int endMinute) =>
    int referenceMinute = hour(barTime, NY_TIMEZONE) * 60 + minute(barTime, NY_TIMEZONE)
    int closeDayOffset = startMinute > endMinute and referenceMinute >= startMinute ? 1 : 0
    int closeDayReference = timestamp(NY_TIMEZONE, year(barTime, NY_TIMEZONE), month(barTime, NY_TIMEZONE), dayofmonth(barTime, NY_TIMEZONE) + closeDayOffset, 12, 0)
    isNyWeekday(closeDayReference)

barFitsNyMinuteWindow(int barTime, int barEndTime, int startMinute, int endMinute) =>
    inNyMinuteWindow(barTime, startMinute, endMinute) and not na(barEndTime) and barEndTime <= nySessionEndBoundary(barTime, startMinute, endMinute)

nextCalendarWeekBoundary(int referenceTime, string timezone, int boundaryHour, int boundaryMinute) =>
    timestamp(timezone, year(referenceTime, timezone), month(referenceTime, timezone), dayofmonth(referenceTime, timezone) + 7, boundaryHour, boundaryMinute)

sessionOccurrenceClose(string sourceName, DeltaProfile profile, bool twentyFourSeven, bool developing) =>
    int closeTime = profile.endTime
    if sourceName == SOURCE_NY_EARLY
        closeTime := nyMinuteBoundary(profile.startTime, NY_EARLY_END_MINUTE)
    else if sourceName == SOURCE_EXTENDED_NY_EARLY
        int nominalCloseTime = nyMinuteBoundary(profile.startTime, IVB_START_MINUTE)
        closeTime := profile.endTime > nominalCloseTime ? nyMinuteBoundary(profile.startTime, EXTENDED_NY_EARLY_OPENING_END_MINUTE) : nominalCloseTime
    else if sourceName == SOURCE_IVB
        closeTime := nyMinuteBoundary(profile.startTime, IVB_END_MINUTE)
    else if sourceName == SOURCE_ASIA_PREMARKET
        closeTime := nySessionEndBoundary(profile.startTime, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE)
    else if sourceName == SOURCE_RTH
        closeTime := developing ? nyMinuteBoundary(profile.startTime, 16 * 60) : profile.endTime
    else if sourceName == SOURCE_WEEKLY
        closeTime := developing or weeklyRollingSelected ? profile.endTime : twentyFourSeven ? nextCalendarWeekBoundary(profile.startTime, UTC_TIMEZONE, 0, 0) : nextCalendarWeekBoundary(profile.startTime, NY_TIMEZONE, SUNDAY_REOPEN_START_HOUR, 0)
    closeTime

profileHours(string sourceName) =>
    sourceName == SOURCE_NY_EARLY ? nyEarlyHours : sourceName == SOURCE_EXTENDED_NY_EARLY ? extendedNyEarlyHours : sourceName == SOURCE_IVB ? ivbHours : sourceName == SOURCE_ASIA_PREMARKET ? asiaPremarketHours : sourceName == SOURCE_RTH ? rthHours : sourceName == SOURCE_GLOBEX ? globexHours : sourceName == SOURCE_MIDNIGHT ? midnightHours : sourceName == SOURCE_WEEKLY ? weeklyHours : sourceName == SOURCE_MONTHLY ? monthlyHours : sourceName == SOURCE_ROLLING ? rollingHours : fixedHours

profileSourceSelected(string sourceName) =>
    switch sourceName
        SOURCE_FIXED => fixedSelected
        SOURCE_ROLLING => rollingSelected
        SOURCE_NY_EARLY => nyEarlySelected
        SOURCE_EXTENDED_NY_EARLY => extendedNyEarlySelected
        SOURCE_IVB => ivbSelected
        SOURCE_ASIA_PREMARKET => asiaPremarketSelected
        SOURCE_RTH => rthSelected
        SOURCE_GLOBEX => globexSelected
        SOURCE_MIDNIGHT => midnightSelected
        SOURCE_WEEKLY => weeklySelected
        SOURCE_MONTHLY => monthlySelected
        => false

mitigatedZoneExtensionEnabled(string sourceName) =>
    extendUnmitigated and profileSourceSelected(sourceName)

extendsPriorityZoneUntilMitigated(string sourceName, int strengthRank) =>
    strengthRank <= 2 and mitigatedZoneExtensionEnabled(sourceName)

priceTickIndex(float price) =>
    int(math.round(price / syminfo.mintick))

usesAlternateStyles(string sourceName) =>
    (sourceName == SOURCE_EXTENDED_NY_EARLY and useExtendedNyEarlyAlternateStyles) or (sourceName == SOURCE_ASIA_PREMARKET and useAsiaPremarketAlternateStyles)

usesGlobexPalette(string sourceName) =>
    sourceName == SOURCE_GLOBEX or sourceName == SOURCE_MIDNIGHT

profileOuterColor(string sourceName) =>
    sourceName == SOURCE_NY_EARLY ? color.new(color.rgb(128, 222, 234), 94) : sourceName == SOURCE_EXTENDED_NY_EARLY ? color.new(color.rgb(76, 65, 245), 94) : sourceName == SOURCE_IVB ? color.new(color.rgb(245, 65, 240), 95) : sourceName == SOURCE_ASIA_PREMARKET ? color.new(color.rgb(165, 214, 167), 70) : sourceName == SOURCE_RTH ? color.new(color.rgb(41, 98, 255), 90) : usesGlobexPalette(sourceName) ? color.new(color.rgb(233, 30, 99), 90) : sourceName == SOURCE_WEEKLY ? color.new(color.rgb(156, 39, 176), 90) : sourceName == SOURCE_MONTHLY ? color.new(color.rgb(223, 107, 12), 85) : sourceName == SOURCE_ROLLING ? color.new(color.rgb(248, 187, 208), 75) : color.new(color.rgb(187, 217, 251), 70)

profileInnerColor(string sourceName) =>
    sourceName == SOURCE_NY_EARLY ? color.new(color.rgb(128, 222, 234), 50) : sourceName == SOURCE_EXTENDED_NY_EARLY ? color.new(color.rgb(76, 65, 245), 88) : sourceName == SOURCE_IVB ? color.new(color.rgb(249, 121, 246), 55) : sourceName == SOURCE_ASIA_PREMARKET ? color.new(color.rgb(56, 142, 60), 88) : sourceName == SOURCE_RTH ? color.new(color.rgb(144, 191, 249), 30) : usesGlobexPalette(sourceName) ? color.new(color.rgb(248, 187, 208), 30) : sourceName == SOURCE_WEEKLY ? color.new(color.rgb(156, 39, 176), 88) : sourceName == SOURCE_MONTHLY ? color.new(color.rgb(255, 152, 0), 20) : sourceName == SOURCE_ROLLING ? color.new(color.rgb(248, 187, 208), 30) : color.new(color.rgb(187, 217, 251), 30)

profileRangeLabelColor(string sourceName) =>
    sourceName == SOURCE_NY_EARLY ? color.new(color.rgb(0, 188, 212), 9) : sourceName == SOURCE_EXTENDED_NY_EARLY ? color.new(color.rgb(76, 65, 245), 9) : sourceName == SOURCE_IVB ? color.new(color.rgb(245, 65, 240), 20) : sourceName == SOURCE_ASIA_PREMARKET ? color.new(color.rgb(56, 142, 60), 5) : sourceName == SOURCE_RTH ? color.new(color.rgb(48, 79, 254), 30) : usesGlobexPalette(sourceName) ? color.new(color.rgb(211, 47, 47), 30) : sourceName == SOURCE_WEEKLY ? color.new(color.rgb(123, 31, 162), 30) : sourceName == SOURCE_MONTHLY ? color.new(color.rgb(239, 108, 0), 30) : sourceName == SOURCE_ROLLING ? color.new(color.rgb(173, 20, 87), 30) : color.new(color.rgb(41, 98, 255), 30)

profileRangeLabelSize(string sourceName) =>
    sourceName == SOURCE_NY_EARLY or sourceName == SOURCE_EXTENDED_NY_EARLY or sourceName == SOURCE_IVB or sourceName == SOURCE_ASIA_PREMARKET or sourceName == SOURCE_RTH ? LABEL_SIZE_TINY : LABEL_SIZE_SMALL

profilePosition(string sourceName) =>
    sourceName == SOURCE_NY_EARLY ? nyEarlyProfilePosition : sourceName == SOURCE_EXTENDED_NY_EARLY ? extendedNyEarlyProfilePosition : sourceName == SOURCE_IVB ? ivbProfilePosition : sourceName == SOURCE_ASIA_PREMARKET ? asiaPremarketProfilePosition : sourceName == SOURCE_RTH ? rthProfilePosition : sourceName == SOURCE_GLOBEX ? globexProfilePosition : sourceName == SOURCE_MIDNIGHT ? midnightProfilePosition : sourceName == SOURCE_WEEKLY ? weeklyProfilePosition : sourceName == SOURCE_MONTHLY ? monthlyProfilePosition : sourceName == SOURCE_ROLLING ? rollingProfilePosition : fixedProfilePosition

profileDeltaWidthBars(string sourceName) =>
    sourceName == SOURCE_NY_EARLY ? nyEarlyDeltaWidthBars : sourceName == SOURCE_EXTENDED_NY_EARLY ? extendedNyEarlyDeltaWidthBars : sourceName == SOURCE_IVB ? ivbDeltaWidthBars : sourceName == SOURCE_ASIA_PREMARKET ? asiaPremarketDeltaWidthBars : sourceName == SOURCE_RTH ? rthDeltaWidthBars : sourceName == SOURCE_GLOBEX ? globexDeltaWidthBars : sourceName == SOURCE_MIDNIGHT ? midnightDeltaWidthBars : sourceName == SOURCE_WEEKLY ? weeklyDeltaWidthBars : sourceName == SOURCE_MONTHLY ? monthlyDeltaWidthBars : sourceName == SOURCE_ROLLING ? rollingDeltaWidthBars : fixedDeltaWidthBars

profileDeltaPlusColor(string sourceName) =>
    usesAlternateStyles(sourceName) ? color.new(color.rgb(76, 175, 80), 15) : color.new(#43c59e, 62)

profileDeltaMinusColor(string sourceName) =>
    usesAlternateStyles(sourceName) ? color.new(color.rgb(242, 54, 69), 15) : color.new(#e86b78, 62)

profileDeltaPlusPlusColor(string sourceName) =>
    usesAlternateStyles(sourceName) ? color.rgb(56, 142, 60) : color.new(#0f9e6e, 30)

profileDeltaMinusMinusColor(string sourceName) =>
    usesAlternateStyles(sourceName) ? color.rgb(178, 40, 51) : color.new(#d61f4a, 30)

profileValueAreaLevelColor(string sourceName) =>
    sourceName == SOURCE_NY_EARLY ? color.new(color.rgb(38, 198, 218), 55) : sourceName == SOURCE_EXTENDED_NY_EARLY ? color.new(color.rgb(76, 65, 245), 70) : sourceName == SOURCE_IVB ? color.new(color.rgb(233, 30, 99), 45) : sourceName == SOURCE_ASIA_PREMARKET ? color.new(color.rgb(255, 183, 77), 60) : sourceName == SOURCE_RTH ? color.new(color.rgb(144, 191, 249), 55) : usesGlobexPalette(sourceName) ? color.new(color.rgb(255, 235, 59), 20) : sourceName == SOURCE_WEEKLY ? color.new(color.rgb(186, 104, 200), 55) : sourceName == SOURCE_MONTHLY ? color.new(color.rgb(255, 152, 0), 55) : color.new(color.rgb(255, 235, 59), 20)

profileTextBackgroundColor(string sourceName) =>
    usesAlternateStyles(sourceName) ? color.new(color.rgb(249, 248, 248), 25) : color.new(color.rgb(249, 248, 248), 20)

// Range/tick charts infer span from recent bars.
barSpanMs() =>
    int spanMs = nz(timeframe.in_seconds(timeframe.period)) * 1000
    if spanMs <= 0
        for lookback = 0 to OFFSET_SPAN_LOOKBACK - 1
            int gap = nz(time[lookback] - time[lookback + 1])
            if gap > 0 and (spanMs <= 0 or gap < spanMs)
                spanMs := gap
    math.max(1, spanMs)

dotMarkerOffsetMs() =>
    int(math.round(DOT_MARKER_OFFSET_BARS * barSpanMs()))

pocLabelOffsetMs() =>
    int(math.round(POC_LABEL_OFFSET_BARS * barSpanMs()))

futuresExtensionEndpoint(int sessionCloseTime, int extensionMs) =>
    int endpoint = sessionCloseTime
    int remainingMs = extensionMs
    if remainingMs > 0
        int endpointDay = dayofweek(endpoint, NY_TIMEZONE)
        int endpointMinute = hour(endpoint, NY_TIMEZONE) * 60 + minute(endpoint, NY_TIMEZONE)
        bool fridayWeekend = endpointDay == dayofweek.friday and endpointMinute >= SUNDAY_REOPEN_START_HOUR * 60
        bool saturdayWeekend = endpointDay == dayofweek.saturday
        bool sundayWeekend = endpointDay == dayofweek.sunday and endpointMinute < SUNDAY_REOPEN_START_HOUR * 60
        if fridayWeekend or saturdayWeekend or sundayWeekend
            int daysUntilSunday = fridayWeekend ? 2 : saturdayWeekend ? 1 : 0
            endpoint := timestamp(NY_TIMEZONE, year(endpoint, NY_TIMEZONE), month(endpoint, NY_TIMEZONE), dayofmonth(endpoint, NY_TIMEZONE) + daysUntilSunday, SUNDAY_REOPEN_START_HOUR, 0)
        endpointDay := dayofweek(endpoint, NY_TIMEZONE)
        int daysUntilFriday = (dayofweek.friday - endpointDay + CALENDAR_DAYS_PER_WEEK) % CALENDAR_DAYS_PER_WEEK
        int weekendStart = timestamp(NY_TIMEZONE, year(endpoint, NY_TIMEZONE), month(endpoint, NY_TIMEZONE), dayofmonth(endpoint, NY_TIMEZONE) + daysUntilFriday, SUNDAY_REOPEN_START_HOUR, 0)
        int availableMs = weekendStart - endpoint
        if remainingMs < availableMs
            endpoint += remainingMs
        else
            remainingMs -= availableMs
            int weekendEnd = timestamp(NY_TIMEZONE, year(weekendStart, NY_TIMEZONE), month(weekendStart, NY_TIMEZONE), dayofmonth(weekendStart, NY_TIMEZONE) + 2, SUNDAY_REOPEN_START_HOUR, 0)
            int fullWeeks = int(math.floor(remainingMs / float(FUTURES_EXTENSION_WEEK_MS)))
            remainingMs -= fullWeeks * FUTURES_EXTENSION_WEEK_MS
            endpoint := timestamp(NY_TIMEZONE, year(weekendEnd, NY_TIMEZONE), month(weekendEnd, NY_TIMEZONE), dayofmonth(weekendEnd, NY_TIMEZONE) + fullWeeks * CALENDAR_DAYS_PER_WEEK, SUNDAY_REOPEN_START_HOUR, 0) + remainingMs
    endpoint

sessionLevelEndpoint(string sourceName, int sessionCloseTime, bool futuresAsset) =>
    int extensionMs = int(math.round(profileHours(sourceName) * MS_PER_HOUR))
    futuresAsset ? futuresExtensionEndpoint(sessionCloseTime, extensionMs) : sessionCloseTime + extensionMs

profileHeadingOffsetBars(string sourceName, bool pairedNyHeadings) =>
    pairedNyHeadings ? sourceName == SOURCE_NY_EARLY ? -NY_HEADING_SEPARATION_BARS : sourceName == SOURCE_EXTENDED_NY_EARLY ? NY_HEADING_SEPARATION_BARS : 0 : 0

// Chart-index positioning ignores time gaps.
rangeHeadingTime(DeltaProfile profile, array<int> chartTimes, int startScaleIndex, int endScaleIndex, int barOffset) =>
    int headingTime = profile.startTime + int(math.round((profile.endTime - profile.startTime) * 0.5))
    if startScaleIndex >= 0 and endScaleIndex >= 0
        int centerIndex = int(math.round((startScaleIndex + endScaleIndex) * 0.5))
        int headingIndex = centerIndex + barOffset
        int chartTimeCount = array.size(chartTimes)
        if headingIndex >= 0 and headingIndex < chartTimeCount
            headingTime := array.get(chartTimes, headingIndex)
        else
            int overflowSteps = headingIndex < 0 ? headingIndex : headingIndex - (chartTimeCount - 1)
            int edgeTime = headingIndex < 0 ? array.get(chartTimes, 0) : array.get(chartTimes, chartTimeCount - 1)
            headingTime := edgeTime + overflowSteps * barSpanMs()
    else
        headingTime += barOffset * barSpanMs()
    headingTime

levelMarkerTime(int levelEndTime) =>
    levelEndTime + dotMarkerOffsetMs()

tradingDayKey(int sessionCloseTime) =>
    year(sessionCloseTime, NY_TIMEZONE) * 10000 + month(sessionCloseTime, NY_TIMEZONE) * 100 + dayofmonth(sessionCloseTime, NY_TIMEZONE)

previousNyCutoff(int cutoffTime, int cutoffHour, int cutoffMinute) =>
    int previousDateReference = cutoffTime - MS_PER_DAY
    timestamp(NY_TIMEZONE, year(previousDateReference, NY_TIMEZONE), month(previousDateReference, NY_TIMEZONE), dayofmonth(previousDateReference, NY_TIMEZONE), cutoffHour, cutoffMinute)

nextNyCutoff(int cutoffTime, int cutoffHour, int cutoffMinute) =>
    timestamp(NY_TIMEZONE, year(cutoffTime, NY_TIMEZONE), month(cutoffTime, NY_TIMEZONE), dayofmonth(cutoffTime, NY_TIMEZONE) + 1, cutoffHour, cutoffMinute)

// Preserve NY clock time across DST.
lookbackDaysStart(int endTime, int days, bool twentyFourSeven) =>
    int startTime = endTime
    int countedDays = 0
    if not na(endTime)
        int anchorHour = hour(endTime, NY_TIMEZONE)
        int anchorMinute = minute(endTime, NY_TIMEZONE)
        while countedDays < days
            startTime := previousNyCutoff(startTime, anchorHour, anchorMinute)
            int startDay = dayofweek(startTime, NY_TIMEZONE)
            if twentyFourSeven or (startDay != dayofweek.saturday and startDay != dayofweek.sunday)
                countedDays += 1
    startTime

lookforwardDaysEnd(int startTime, int days, bool twentyFourSeven) =>
    int endTime = startTime
    int countedDays = 0
    if not na(startTime)
        int anchorHour = hour(startTime, NY_TIMEZONE)
        int anchorMinute = minute(startTime, NY_TIMEZONE)
        while countedDays < days
            endTime := nextNyCutoff(endTime, anchorHour, anchorMinute)
            int endDay = dayofweek(endTime, NY_TIMEZONE)
            if twentyFourSeven or (endDay != dayofweek.saturday and endDay != dayofweek.sunday)
                countedDays += 1
    endTime

rollingClockCutoffMinute(string throughMode) =>
    switch throughMode
        ROLLING_THROUGH_0000 => ROLLING_CUTOFF_0000_MINUTE
        ROLLING_THROUGH_0500 => ROLLING_CUTOFF_0500_MINUTE
        ROLLING_THROUGH_0830 => ROLLING_CUTOFF_0830_MINUTE
        ROLLING_THROUGH_0930 => ROLLING_CUTOFF_0930_MINUTE
        ROLLING_THROUGH_1600 => ROLLING_CUTOFF_1600_MINUTE
        ROLLING_THROUGH_1800 => ROLLING_CUTOFF_1800_MINUTE
        => na

rollingThroughTime(int referenceTime, string throughMode, bool twentyFourSeven) =>
    int endTime = referenceTime
    int cutoffMinuteOfDay = rollingClockCutoffMinute(throughMode)
    if (throughMode == ROLLING_THROUGH_LIVE_MINUS_2H or throughMode == ROLLING_THROUGH_LIVE_MINUS_4H) and not na(referenceTime)
        int liveOffsetHours = throughMode == ROLLING_THROUGH_LIVE_MINUS_2H ? 2 : 4
        endTime := referenceTime - liveOffsetHours * MS_PER_HOUR
    else if not na(cutoffMinuteOfDay) and not na(referenceTime)
        int cutoffHour = int(math.floor(cutoffMinuteOfDay / 60))
        int cutoffMinute = cutoffMinuteOfDay % 60
        endTime := timestamp(NY_TIMEZONE, year(referenceTime, NY_TIMEZONE), month(referenceTime, NY_TIMEZONE), dayofmonth(referenceTime, NY_TIMEZONE), cutoffHour, cutoffMinute)
        if endTime > referenceTime
            endTime := previousNyCutoff(endTime, cutoffHour, cutoffMinute)
        if not twentyFourSeven
            int cutoffDay = dayofweek(endTime, NY_TIMEZONE)
            while cutoffDay == dayofweek.saturday or cutoffDay == dayofweek.sunday
                endTime := previousNyCutoff(endTime, cutoffHour, cutoffMinute)
                cutoffDay := dayofweek(endTime, NY_TIMEZONE)
    endTime

rollingUsesClockCutoff(string throughMode) =>
    not na(rollingClockCutoffMinute(throughMode))

tierMarkerSize(array<int> markerSizes, int tier) =>
    array.get(markerSizes, math.max(0, math.min(4, 5 - tier)))

deltaTierAppearance(bool buySide, int tier, string sourceName) =>
    int tierIndex = math.max(0, math.min(4, 5 - tier))
    int appearanceIndex = tierIndex * 2 + (buySide ? 0 : 1)
    usesAlternateStyles(sourceName) ? array.get(alternateDeltaTierAppearances, appearanceIndex) : array.get(deltaTierAppearances, appearanceIndex)

deltaTierSideVisible(bool buySide) =>
    deltaTierSideVisibility != OPTION_OFF and (deltaTierSideVisibility == OPTION_ALL or (buySide and deltaTierSideVisibility == DELTA_TIER_VISIBILITY_BUY) or (not buySide and deltaTierSideVisibility == DELTA_TIER_VISIBILITY_SELL))

clusterOutranks(float magnitude, float strength, float bestMagnitude, float bestStrength) =>
    magnitude > bestMagnitude or (magnitude == bestMagnitude and strength > bestStrength)

compactIfNeeded(array<float> highs, array<float> lows, array<float> volumes, array<float> deltas) =>
    legilimensProfile.compactIfNeeded(highs, lows, volumes, deltas, syminfo.mintick)

clearSamples(array<float> highs, array<float> lows, array<float> volumes, array<float> deltas) =>
    legilimensProfile.clearSamples(highs, lows, volumes, deltas)

appendSamples(array<float> destHighs, array<float> destLows, array<float> destVolumes, array<float> destDeltas, array<float> sourceHighs, array<float> sourceLows, array<float> sourceVolumes, array<float> sourceDeltas, bool compactAfter) =>
    legilimensProfile.appendSamples(destHighs, destLows, destVolumes, destDeltas, sourceHighs, sourceLows, sourceVolumes, sourceDeltas, compactAfter, syminfo.mintick)

appendBarSample(array<float> highs, array<float> lows, array<float> volumes, array<float> deltas, float sampleHigh, float sampleLow, float sampleVolume, float sampleDelta) =>
    legilimensProfile.appendBarSample(highs, lows, volumes, deltas, sampleHigh, sampleLow, sampleVolume, sampleDelta)

// NY date + cutoff segment key.
rollingSegmentIndex(int nyMinutes) =>
    switch
        nyMinutes < ROLLING_CUTOFF_0500_MINUTE => 0
        nyMinutes < ROLLING_CUTOFF_0830_MINUTE => 1
        nyMinutes < ROLLING_CUTOFF_0930_MINUTE => 2
        nyMinutes < ROLLING_CUTOFF_1600_MINUTE => 3
        nyMinutes < ROLLING_CUTOFF_1800_MINUTE => 4
        => 5

rollingSegmentKey(int sampleTime) =>
    int nyMinutes = hour(sampleTime, NY_TIMEZONE) * 60 + minute(sampleTime, NY_TIMEZONE)
    int segment = rollingSegmentIndex(nyMinutes)
    (year(sampleTime, NY_TIMEZONE) * 10000 + month(sampleTime, NY_TIMEZONE) * 100 + dayofmonth(sampleTime, NY_TIMEZONE)) * 10 + segment

newRollingSampleStore() =>
    RollingSampleStore.new(0, array.new<int>(), array.new<int>(), array.new<int>(), array.new<int>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<int>())

rollingSampleStoreSize(RollingSampleStore store) =>
    array.size(store.volumes)

rollingSampleStoreAligned(RollingSampleStore store) =>
    int sampleCount = rollingSampleStoreSize(store)
    bool keysAligned = array.size(store.startKeys) == sampleCount and array.size(store.endKeys) == sampleCount
    bool timesAligned = array.size(store.startTimes) == sampleCount and array.size(store.endTimes) == sampleCount
    bool valuesAligned = array.size(store.highs) == sampleCount and array.size(store.lows) == sampleCount and array.size(store.deltas) == sampleCount
    store.headIndex >= 0 and store.headIndex <= sampleCount and keysAligned and timesAligned and valuesAligned

requireRollingSampleStoreAligned(RollingSampleStore store) =>
    bool aligned = rollingSampleStoreAligned(store)
    if not aligned
        runtime.error("Rolling sample storage is misaligned.")
    aligned

popRollingSample(RollingSampleStore store) =>
    array.pop(store.startKeys)
    array.pop(store.endKeys)
    array.pop(store.startTimes)
    array.pop(store.endTimes)
    array.pop(store.highs)
    array.pop(store.lows)
    array.pop(store.volumes)
    array.pop(store.deltas)

truncateRollingSamples(RollingSampleStore store, int retainedSize) =>
    while rollingSampleStoreSize(store) > retainedSize
        popRollingSample(store)
    rollingSampleStoreSize(store)

clearRollingSamples(RollingSampleStore store) =>
    array.clear(store.startKeys)
    array.clear(store.endKeys)
    array.clear(store.startTimes)
    array.clear(store.endTimes)
    array.clear(store.highs)
    array.clear(store.lows)
    array.clear(store.volumes)
    array.clear(store.deltas)
    store.headIndex := 0
    store.headIndex

compactRollingSamples(RollingSampleStore store, int mergeThreshold) =>
    requireRollingSampleStoreAligned(store)
    int sampleCount = rollingSampleStoreSize(store)
    int activeSampleCount = sampleCount - store.headIndex
    if store.headIndex > ROLLING_SAMPLE_COMPACT_THRESHOLD or activeSampleCount > mergeThreshold
        bool mergeActiveSamples = activeSampleCount > mergeThreshold
        int writeIndex = 0
        int readIndex = store.headIndex
        while readIndex < sampleCount
            int nextIndex = readIndex + 1
            bool currentWithinSegment = array.get(store.startKeys, readIndex) == array.get(store.endKeys, readIndex)
            bool nextWithinSegment = nextIndex < sampleCount and array.get(store.startKeys, nextIndex) == array.get(store.endKeys, nextIndex)
            bool mergeNext = mergeActiveSamples and currentWithinSegment and nextWithinSegment and array.get(store.endKeys, readIndex) == array.get(store.startKeys, nextIndex)
            array.set(store.startKeys, writeIndex, array.get(store.startKeys, readIndex))
            array.set(store.endKeys, writeIndex, mergeNext ? array.get(store.endKeys, nextIndex) : array.get(store.endKeys, readIndex))
            array.set(store.startTimes, writeIndex, array.get(store.startTimes, readIndex))
            array.set(store.endTimes, writeIndex, mergeNext ? array.get(store.endTimes, nextIndex) : array.get(store.endTimes, readIndex))
            array.set(store.highs, writeIndex, mergeNext ? math.max(array.get(store.highs, readIndex), array.get(store.highs, nextIndex)) : array.get(store.highs, readIndex))
            array.set(store.lows, writeIndex, mergeNext ? math.min(array.get(store.lows, readIndex), array.get(store.lows, nextIndex)) : array.get(store.lows, readIndex))
            array.set(store.volumes, writeIndex, array.get(store.volumes, readIndex) + (mergeNext ? array.get(store.volumes, nextIndex) : 0.0))
            array.set(store.deltas, writeIndex, array.get(store.deltas, readIndex) + (mergeNext ? array.get(store.deltas, nextIndex) : 0.0))
            writeIndex += 1
            readIndex += mergeNext ? 2 : 1
        truncateRollingSamples(store, writeIndex)
        store.headIndex := 0
    requireRollingSampleStoreAligned(store)
    rollingSampleStoreSize(store)

appendRollingSample(RollingSampleStore store, int sampleStartTime, int sampleEndTime, float sampleHigh, float sampleLow, float sampleVolume, float sampleDelta) =>
    array.push(store.startKeys, rollingSegmentKey(sampleStartTime))
    array.push(store.endKeys, rollingSegmentKey(math.max(sampleStartTime, sampleEndTime - 1)))
    array.push(store.startTimes, sampleStartTime)
    array.push(store.endTimes, sampleEndTime)
    array.push(store.highs, sampleHigh)
    array.push(store.lows, sampleLow)
    array.push(store.volumes, sampleVolume)
    array.push(store.deltas, sampleDelta)

appendRollingSamples(RollingSampleStore store, array<int> sourceStartTimes, array<int> sourceEndTimes, array<float> sourceHighs, array<float> sourceLows, array<float> sourceVolumes, array<float> sourceDeltas, bool compactAfter, int mergeThreshold) =>
    requireRollingSampleStoreAligned(store)
    int sampleCount = array.size(sourceVolumes)
    bool sourceTimesAligned = array.size(sourceStartTimes) == sampleCount and array.size(sourceEndTimes) == sampleCount
    bool sourceValuesAligned = array.size(sourceHighs) == sampleCount and array.size(sourceLows) == sampleCount and array.size(sourceDeltas) == sampleCount
    bool sourceAligned = sourceTimesAligned and sourceValuesAligned
    if not sourceAligned
        runtime.error("Rolling source samples are misaligned.")
    if sampleCount > 0
        for sampleIndex = 0 to sampleCount - 1
            appendRollingSample(store, array.get(sourceStartTimes, sampleIndex), array.get(sourceEndTimes, sampleIndex), array.get(sourceHighs, sampleIndex), array.get(sourceLows, sampleIndex), array.get(sourceVolumes, sampleIndex), array.get(sourceDeltas, sampleIndex))
    if compactAfter
        compactRollingSamples(store, mergeThreshold)
    requireRollingSampleStoreAligned(store)
    rollingSampleStoreSize(store)

pruneRollingSamples(RollingSampleStore store, int cutoffTime) =>
    requireRollingSampleStoreAligned(store)
    int sampleCount = rollingSampleStoreSize(store)
    while store.headIndex < sampleCount and array.get(store.endTimes, store.headIndex) <= cutoffTime
        store.headIndex += 1
    if store.headIndex == sampleCount and sampleCount > 0
        clearRollingSamples(store)
    requireRollingSampleStoreAligned(store)
    store.headIndex

// Prefer one-tick rows; bin wider ranges.
buildDeltaProfileFromSelection(array<float> highs, array<float> lows, array<float> volumes, array<float> deltas, array<int> selectedIndices, int requestedRows, int startTime, int endTime) =>
    legilimensProfile.ProfileData profile = legilimensProfile.buildProfile(highs, lows, volumes, deltas, selectedIndices, requestedRows, syminfo.mintick)
    DeltaProfile.new(startTime, endTime, profile.priceLow, profile.priceHigh, profile.rangeLow, profile.rangeHigh, profile.rowCount, profile.rowVolumes, profile.rowDeltas, profile.maxRowVolume, profile.maxAbsRowDelta, profile.isValid)

buildDeltaProfile(array<float> highs, array<float> lows, array<float> volumes, array<float> deltas, int requestedRows, int startTime, int endTime) =>
    array<int> allSampleIndices = na
    buildDeltaProfileFromSelection(highs, lows, volumes, deltas, allSampleIndices, requestedRows, startTime, endTime)

buildRollingDeltaProfile(RollingSampleStore store, int requestedRows, int startTime, int endTime, bool includeEnd, bool requireFullContainment) =>
    requireRollingSampleStoreAligned(store)
    array.clear(store.selectedIndices)
    int sampleCount = rollingSampleStoreSize(store)
    if store.headIndex < sampleCount
        for sampleIndex = store.headIndex to sampleCount - 1
            int sampleStartTime = array.get(store.startTimes, sampleIndex)
            int sampleEndTime = array.get(store.endTimes, sampleIndex)
            bool sampleInsideRange = includeEnd ? sampleEndTime > startTime : requireFullContainment ? sampleStartTime >= startTime and sampleEndTime <= endTime : sampleEndTime >= startTime and sampleStartTime < endTime
            if sampleInsideRange
                array.push(store.selectedIndices, sampleIndex)
    buildDeltaProfileFromSelection(store.highs, store.lows, store.volumes, store.deltas, store.selectedIndices, requestedRows, startTime, endTime)

buildCurrentRollingDeltaProfile(RollingSampleStore store, int requestedRows, int startTime, int endTime, bool includeEnd, bool requireFullContainment, bool currentBarRetained, array<int> sampleStartTimes, array<int> sampleEndTimes, array<float> sampleHighs, array<float> sampleLows, array<float> sampleVolumes, array<float> sampleDeltas) =>
    int originalSize = rollingSampleStoreSize(store)
    if not barstate.isconfirmed and currentBarRetained
        appendRollingSamples(store, sampleStartTimes, sampleEndTimes, sampleHighs, sampleLows, sampleVolumes, sampleDeltas, false, ROLLING_SAMPLE_COMPACT_THRESHOLD)
    DeltaProfile profile = buildRollingDeltaProfile(store, requestedRows, startTime, endTime, includeEnd, requireFullContainment)
    truncateRollingSamples(store, originalSize)
    profile

buildDevelopingDeltaProfile(array<float> barHighs, array<float> barLows, array<float> barVolumes, array<float> barDeltas, array<int> startRef, array<float> sampleHighs, array<float> sampleLows, array<float> sampleVolumes, array<float> sampleDeltas, int endTime) =>
    int originalSize = array.size(barVolumes)
    if not barstate.isconfirmed
        appendSamples(barHighs, barLows, barVolumes, barDeltas, sampleHighs, sampleLows, sampleVolumes, sampleDeltas, false)
    DeltaProfile profile = buildDeltaProfile(barHighs, barLows, barVolumes, barDeltas, PROFILE_ROWS, array.get(startRef, 0), endTime)
    while array.size(barVolumes) > originalSize
        array.pop(barHighs)
        array.pop(barLows)
        array.pop(barVolumes)
        array.pop(barDeltas)
    profile

profileValueLevels(DeltaProfile profile) =>
    legilimensProfile.profileValueLevels(profile.rowVolumes, profile.rowCount, profile.priceLow, profile.priceHigh)

// ═══════════════════════════════════════════════════════════════════════════════
// ANCHOR ENGINE
// ═══════════════════════════════════════════════════════════════════════════════
var array<FinalizedMitigationProfile> finalizedMitigationProfiles = array.new<FinalizedMitigationProfile>()

finalizePeriod(string sourceName, array<float> barHighs, array<float> barLows, array<float> barVolumes, array<float> barDeltas, int startTime, int endTime, int keepProfiles, array<DeltaProfile> profiles) =>
    if array.size(barVolumes) > 0
        DeltaProfile profile = buildDeltaProfile(barHighs, barLows, barVolumes, barDeltas, PROFILE_ROWS, startTime, endTime)
        if profile.isValid
            array.push(profiles, profile)
            if mitigatedZoneExtensionEnabled(sourceName)
                array.push(finalizedMitigationProfiles, FinalizedMitigationProfile.new(profile, sourceName))
            while array.size(profiles) > keepProfiles
                array.shift(profiles)
        clearSamples(barHighs, barLows, barVolumes, barDeltas)

processRollingPeriodAnchor(string sourceName, bool enabled, int periodDays, int oldestStartTime, int finalEndTime, bool twentyFourSeven, array<float> barHighs, array<float> barLows, array<float> barVolumes, array<float> barDeltas, array<DeltaProfile> profiles, array<int> startRef, array<int> endRef, array<int> sampleStartTimes, array<int> sampleEndTimes, array<float> sampleHighs, array<float> sampleLows, array<float> sampleVolumes, array<float> sampleDeltas) =>
    if enabled and barstate.isconfirmed
        int activeStartTime = array.get(startRef, 0)
        int activeEndTime = array.get(endRef, 0)
        if activeStartTime == START_TIME_UNSET
            activeStartTime := oldestStartTime
            activeEndTime := lookforwardDaysEnd(activeStartTime, periodDays, twentyFourSeven)
        int sampleCount = array.size(sampleVolumes)
        if sampleCount > 0
            for sampleIndex = 0 to sampleCount - 1
                int sampleStartTime = array.get(sampleStartTimes, sampleIndex)
                int sampleEndTime = array.get(sampleEndTimes, sampleIndex)
                if sampleEndTime > oldestStartTime and sampleStartTime < finalEndTime
                    while sampleStartTime >= activeEndTime and activeEndTime <= finalEndTime
                        finalizePeriod(sourceName, barHighs, barLows, barVolumes, barDeltas, activeStartTime, activeEndTime, SESSION_PROFILE_RETENTION, profiles)
                        activeStartTime := activeEndTime
                        activeEndTime := lookforwardDaysEnd(activeStartTime, periodDays, twentyFourSeven)
                    if sampleStartTime >= activeStartTime and sampleEndTime <= activeEndTime
                        appendBarSample(barHighs, barLows, barVolumes, barDeltas, array.get(sampleHighs, sampleIndex), array.get(sampleLows, sampleIndex), array.get(sampleVolumes, sampleIndex), array.get(sampleDeltas, sampleIndex))
        compactIfNeeded(barHighs, barLows, barVolumes, barDeltas)
        int barEndTime = na(time_close) ? time : time_close
        while barEndTime >= activeEndTime and activeEndTime <= finalEndTime
            finalizePeriod(sourceName, barHighs, barLows, barVolumes, barDeltas, activeStartTime, activeEndTime, SESSION_PROFILE_RETENTION, profiles)
            activeStartTime := activeEndTime
            activeEndTime := lookforwardDaysEnd(activeStartTime, periodDays, twentyFourSeven)
        array.set(startRef, 0, activeStartTime)
        array.set(endRef, 0, activeEndTime)

appendContainedSamples(array<float> destHighs, array<float> destLows, array<float> destVolumes, array<float> destDeltas, array<int> sourceStartTimes, array<int> sourceEndTimes, array<float> sourceHighs, array<float> sourceLows, array<float> sourceVolumes, array<float> sourceDeltas, int rangeStartTime, int rangeEndTime, bool compactAfter) =>
    int sampleCount = array.size(sourceVolumes)
    if sampleCount > 0
        for sampleIndex = 0 to sampleCount - 1
            int sampleStartTime = array.get(sourceStartTimes, sampleIndex)
            int sampleEndTime = array.get(sourceEndTimes, sampleIndex)
            if sampleStartTime >= rangeStartTime and sampleEndTime <= rangeEndTime
                appendBarSample(destHighs, destLows, destVolumes, destDeltas, array.get(sourceHighs, sampleIndex), array.get(sourceLows, sampleIndex), array.get(sourceVolumes, sampleIndex), array.get(sourceDeltas, sampleIndex))
    if compactAfter
        compactIfNeeded(destHighs, destLows, destVolumes, destDeltas)

processAnchor(string sourceName, bool enabled, int keepProfiles, bool inWindow, bool periodStart, bool periodEnd, array<float> barHighs, array<float> barLows, array<float> barVolumes, array<float> barDeltas, array<DeltaProfile> profiles, array<int> periodStartRef, array<int> periodLastBarRef, array<float> sampleHighs, array<float> sampleLows, array<float> sampleVolumes, array<float> sampleDeltas, bool continuousBoundary) =>
    if enabled
        bool shouldStart = periodStart or (array.get(periodStartRef, 0) == START_TIME_UNSET and inWindow)

        if periodEnd and array.size(barVolumes) > 0
            // Stop early-close profiles at the last sample.
            finalizePeriod(sourceName, barHighs, barLows, barVolumes, barDeltas, array.get(periodStartRef, 0), array.get(periodLastBarRef, 0), keepProfiles, profiles)

        if shouldStart
            if array.size(barVolumes) > 0
                int boundaryEnd = continuousBoundary ? time : time[1]
                finalizePeriod(sourceName, barHighs, barLows, barVolumes, barDeltas, array.get(periodStartRef, 0), boundaryEnd, keepProfiles, profiles)
            array.set(periodStartRef, 0, time)

        if inWindow and barstate.isconfirmed and array.size(sampleVolumes) > 0
            appendSamples(barHighs, barLows, barVolumes, barDeltas, sampleHighs, sampleLows, sampleVolumes, sampleDeltas, true)
            array.set(periodLastBarRef, 0, time)

processBoundedNyAnchor(string sourceName, bool enabled, int keepProfiles, int startMinute, int endMinute, bool inWindow, bool periodStart, bool periodEnd, int firstSampleTime, int lastSampleEndTime, array<float> barHighs, array<float> barLows, array<float> barVolumes, array<float> barDeltas, array<DeltaProfile> profiles, array<int> periodStartRef, array<int> periodLastBarRef, array<float> sampleHighs, array<float> sampleLows, array<float> sampleVolumes, array<float> sampleDeltas) =>
    if enabled
        if periodEnd and array.size(barVolumes) > 0
            finalizePeriod(sourceName, barHighs, barLows, barVolumes, barDeltas, array.get(periodStartRef, 0), array.get(periodLastBarRef, 0), keepProfiles, profiles)

        bool shouldStart = periodStart or (array.get(periodStartRef, 0) == START_TIME_UNSET and inWindow)
        if shouldStart
            if array.size(barVolumes) > 0
                finalizePeriod(sourceName, barHighs, barLows, barVolumes, barDeltas, array.get(periodStartRef, 0), array.get(periodLastBarRef, 0), keepProfiles, profiles)
            array.set(periodStartRef, 0, nySessionStartBoundary(firstSampleTime, startMinute, endMinute))

        if inWindow and barstate.isconfirmed and array.size(sampleVolumes) > 0
            appendSamples(barHighs, barLows, barVolumes, barDeltas, sampleHighs, sampleLows, sampleVolumes, sampleDeltas, true)
            int sessionEndTime = nySessionEndBoundary(array.get(periodStartRef, 0), startMinute, endMinute)
            array.set(periodLastBarRef, 0, math.min(lastSampleEndTime, sessionEndTime))

// Session keys rotate inside one chart bar; realtime mutations roll back before the next update.
processKeyedBoundedNyAnchor(string sourceName, bool enabled, int keepProfiles, int startMinute, int endMinute, bool currentWindowActive, int currentSessionStart, array<float> barHighs, array<float> barLows, array<float> barVolumes, array<float> barDeltas, array<DeltaProfile> profiles, array<int> periodStartRef, array<int> periodLastBarRef, array<int> sampleSessionStarts, array<int> sampleEndTimes, array<float> sampleHighs, array<float> sampleLows, array<float> sampleVolumes, array<float> sampleDeltas) =>
    if enabled
        int sampleCount = array.size(sampleVolumes)
        if sampleCount > 0
            for sampleIndex = 0 to sampleCount - 1
                int sampleSessionStart = array.get(sampleSessionStarts, sampleIndex)
                int activeSessionStart = array.get(periodStartRef, 0)
                if activeSessionStart != sampleSessionStart
                    if array.size(barVolumes) > 0
                        compactIfNeeded(barHighs, barLows, barVolumes, barDeltas)
                        finalizePeriod(sourceName, barHighs, barLows, barVolumes, barDeltas, activeSessionStart, array.get(periodLastBarRef, 0), keepProfiles, profiles)
                    array.set(periodStartRef, 0, sampleSessionStart)
                appendBarSample(barHighs, barLows, barVolumes, barDeltas, array.get(sampleHighs, sampleIndex), array.get(sampleLows, sampleIndex), array.get(sampleVolumes, sampleIndex), array.get(sampleDeltas, sampleIndex))
                int sessionEndTime = nySessionEndBoundary(sampleSessionStart, startMinute, endMinute)
                array.set(periodLastBarRef, 0, math.min(array.get(sampleEndTimes, sampleIndex), sessionEndTime))
            compactIfNeeded(barHighs, barLows, barVolumes, barDeltas)
        if not currentWindowActive and array.size(barVolumes) > 0
            finalizePeriod(sourceName, barHighs, barLows, barVolumes, barDeltas, array.get(periodStartRef, 0), array.get(periodLastBarRef, 0), keepProfiles, profiles)
        else if currentWindowActive and currentSessionStart != START_TIME_UNSET and array.get(periodStartRef, 0) != currentSessionStart
            if array.size(barVolumes) > 0
                finalizePeriod(sourceName, barHighs, barLows, barVolumes, barDeltas, array.get(periodStartRef, 0), array.get(periodLastBarRef, 0), keepProfiles, profiles)
            array.set(periodStartRef, 0, currentSessionStart)

// ═══════════════════════════════════════════════════════════════════════════════
// RENDER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════
var array<box> drawnBoxes = array.new<box>()
var array<line> drawnLines = array.new<line>()
var array<polyline> drawnPolylines = array.new<polyline>()
var array<label> drawnLabels = array.new<label>()
var array<PendingOutlierLevel> pendingOutlierLevels = array.new<PendingOutlierLevel>()
var array<PendingMitigatedZone> pendingMitigatedZones = array.new<PendingMitigatedZone>()
var array<PendingRightLabel> pendingRightLabels = array.new<PendingRightLabel>()
var array<PendingRightLine> pendingRightLines = array.new<PendingRightLine>()
var array<MitigatedZoneState> mitigatedZoneStates = array.new<MitigatedZoneState>()
var array<MitigatedProfileKey> mitigatedProfiles = array.new<MitigatedProfileKey>()
var table colorTable = na
// Rebuild chart time once per bar.
var array<int> cachedChartTimes = array.new<int>()
var int chartTimesBuiltAtBar = -1

canDrawBox() =>
    array.size(drawnBoxes) < INDICATOR_MAX_BOXES

canDrawLine() =>
    array.size(drawnLines) < INDICATOR_MAX_LINES

canDrawLabel() =>
    array.size(drawnLabels) < INDICATOR_MAX_LABELS

canDrawPolyline() =>
    array.size(drawnPolylines) < INDICATOR_MAX_POLYLINES

clearDrawings() =>
    if array.size(drawnBoxes) > 0
        for boxIndex = 0 to array.size(drawnBoxes) - 1
            box.delete(array.get(drawnBoxes, boxIndex))
        array.clear(drawnBoxes)
    if array.size(drawnLines) > 0
        for lineIndex = 0 to array.size(drawnLines) - 1
            line.delete(array.get(drawnLines, lineIndex))
        array.clear(drawnLines)
    if array.size(drawnPolylines) > 0
        for polylineIndex = 0 to array.size(drawnPolylines) - 1
            polyline.delete(array.get(drawnPolylines, polylineIndex))
        array.clear(drawnPolylines)
    if array.size(drawnLabels) > 0
        for labelIndex = 0 to array.size(drawnLabels) - 1
            label.delete(array.get(drawnLabels, labelIndex))
        array.clear(drawnLabels)
    array.clear(pendingOutlierLevels)
    array.clear(pendingMitigatedZones)
    array.clear(pendingRightLabels)
    array.clear(pendingRightLines)

queueLevelMarker(float price, int markerTime, string markerLabel, color markerColor, int markerSize) =>
    if showDots
        array.push(pendingRightLabels, PendingRightLabel.new(price, markerTime, LEVEL_MARKER_GLYPH, markerColor, markerSize, false))
        if markerLabel != ""
            array.push(pendingRightLabels, PendingRightLabel.new(price, markerTime, markerLabel, markerColor, DOT_LABEL_SIZE, true))

queueRightLine(float price, int leftTime, int rightTime, color lineColor, int lineWidth, string styleName, int rank, string sourceName, int sessionTradingDayKey, bool historical, int direction) =>
    bool historicalMergeGroup = historical or sessionTradingDayKey != tradingDayKey(time)
    array.push(pendingRightLines, PendingRightLine.new(price, leftTime, rightTime, lineColor, lineWidth, styleName, rank, sourceName, sessionTradingDayKey, historicalMergeGroup, direction))

renderZoneFill(int leftTime, int rightTime, float zoneLow, float zoneHigh, color zoneFillColor) =>
    if canDrawBox()
        array.push(drawnBoxes, box.new(left=leftTime, top=zoneHigh, right=rightTime, bottom=zoneLow, xloc=xloc.bar_time, border_color=color.new(zoneFillColor, 100), border_width=0, bgcolor=zoneFillColor))

mitigatedZoneStateIndex(string sourceName, int profileStartTime, int eligibilityTime, float price) =>
    int foundIndex = -1
    int stateCount = array.size(mitigatedZoneStates)
    if stateCount > 0
        for stateIndex = 0 to stateCount - 1
            MitigatedZoneState state = array.get(mitigatedZoneStates, stateIndex)
            if state.sourceName == sourceName and state.profileStartTime == profileStartTime and state.eligibilityTime == eligibilityTime and state.price == price
                foundIndex := stateIndex
                break
    foundIndex

removeMitigatedProfile(string sourceName, int profileStartTime) =>
    int stateIndex = array.size(mitigatedZoneStates) - 1
    while stateIndex >= 0
        MitigatedZoneState state = array.get(mitigatedZoneStates, stateIndex)
        if state.sourceName == sourceName and state.profileStartTime == profileStartTime
            array.remove(mitigatedZoneStates, stateIndex)
        stateIndex -= 1

removeMitigatedSource(string sourceName) =>
    int stateIndex = array.size(mitigatedZoneStates) - 1
    while stateIndex >= 0
        MitigatedZoneState state = array.get(mitigatedZoneStates, stateIndex)
        if state.sourceName == sourceName
            array.remove(mitigatedZoneStates, stateIndex)
        stateIndex -= 1
    int profileIndex = array.size(mitigatedProfiles) - 1
    while profileIndex >= 0
        if array.get(mitigatedProfiles, profileIndex).sourceName == sourceName
            array.remove(mitigatedProfiles, profileIndex)
        profileIndex -= 1

registerMitigatedProfile(string sourceName, int profileStartTime) =>
    bool alreadyRegistered = false
    int profileCount = array.size(mitigatedProfiles)
    if profileCount > 0
        for profileIndex = 0 to profileCount - 1
            MitigatedProfileKey profileKey = array.get(mitigatedProfiles, profileIndex)
            if profileKey.sourceName == sourceName and profileKey.startTime == profileStartTime
                alreadyRegistered := true
                break
    if not alreadyRegistered
        array.push(mitigatedProfiles, MitigatedProfileKey.new(sourceName, profileStartTime))
        int sourceProfileCount = 0
        for profileIndex = 0 to array.size(mitigatedProfiles) - 1
            if array.get(mitigatedProfiles, profileIndex).sourceName == sourceName
                sourceProfileCount += 1
        if sourceProfileCount > SESSION_PROFILE_RETENTION
            int oldestIndex = -1
            int oldestStartTime = na
            for profileIndex = 0 to array.size(mitigatedProfiles) - 1
                MitigatedProfileKey profileKey = array.get(mitigatedProfiles, profileIndex)
                if profileKey.sourceName == sourceName
                    int candidateStartTime = profileKey.startTime
                    if oldestIndex < 0 or candidateStartTime < oldestStartTime
                        oldestIndex := profileIndex
                        oldestStartTime := candidateStartTime
            if oldestIndex >= 0
                removeMitigatedProfile(sourceName, oldestStartTime)
                array.remove(mitigatedProfiles, oldestIndex)

registerMitigatedZone(string sourceName, int profileStartTime, int eligibilityTime, float price) =>
    registerMitigatedProfile(sourceName, profileStartTime)
    if mitigatedZoneStateIndex(sourceName, profileStartTime, eligibilityTime, price) < 0
        array.push(mitigatedZoneStates, MitigatedZoneState.new(sourceName, profileStartTime, eligibilityTime, price, na, true))

queueMitigatedZone(float price, float zoneLow, float zoneHigh, int profileStartTime, int leftTime, int eligibilityTime, color zoneColor, bool hasLine, color lineColor, int lineWidth, string lineStyle, int lineRank, string sourceName, int tradingDayKey, bool historical, int direction, string markerLabel, color markerColor, int markerSize) =>
    array.push(pendingMitigatedZones, PendingMitigatedZone.new(price, zoneLow, zoneHigh, profileStartTime, leftTime, eligibilityTime, zoneColor, hasLine, lineColor, lineWidth, lineStyle, lineRank, sourceName, tradingDayKey, historical, direction, markerLabel, markerColor, markerSize))

// Records keep cluster fields aligned.
flushPendingRightLines(bool merge) =>
    int pendingCount = array.size(pendingRightLines)
    if pendingCount > 0
        array<PendingRightLine> clusters = array.new<PendingRightLine>()
        for pendingIndex = 0 to pendingCount - 1
            PendingRightLine pending = array.get(pendingRightLines, pendingIndex)
            float tolerance = math.max(syminfo.mintick, math.abs(pending.price) * mergeDistancePercent / 100.0)
            int foundIndex = -1
            float minimumDistance = tolerance + syminfo.mintick
            int clusterCount = array.size(clusters)
            if merge and clusterCount > 0
                for clusterIndex = 0 to clusterCount - 1
                    PendingRightLine cluster = array.get(clusters, clusterIndex)
                    float distance = math.abs(cluster.price - pending.price)
                    bool sameSource = cluster.sourceName == pending.sourceName
                    bool sameOccurrence = cluster.tradingDayKey == pending.tradingDayKey and cluster.historical == pending.historical
                    bool sameEndpoint = cluster.rightTime == pending.rightTime
                    bool compatibleDirection = cluster.direction == 0 or pending.direction == 0 or cluster.direction == pending.direction
                    if sameSource and sameOccurrence and sameEndpoint and compatibleDirection and distance <= tolerance and distance < minimumDistance
                        minimumDistance := distance
                        foundIndex := clusterIndex
            if foundIndex >= 0
                PendingRightLine cluster = array.get(clusters, foundIndex)
                cluster.leftTime := math.min(cluster.leftTime, pending.leftTime)
                cluster.rightTime := math.max(cluster.rightTime, pending.rightTime)
                if cluster.direction == 0 and pending.direction != 0
                    cluster.direction := pending.direction
                if pending.rank > cluster.rank
                    cluster.price := pending.price
                    cluster.lineColor := pending.lineColor
                    cluster.lineWidth := pending.lineWidth
                    cluster.styleName := pending.styleName
                    cluster.rank := pending.rank
            else
                array.push(clusters, PendingRightLine.new(pending.price, pending.leftTime, pending.rightTime, pending.lineColor, pending.lineWidth, pending.styleName, pending.rank, pending.sourceName, pending.tradingDayKey, pending.historical, pending.direction))
        for clusterIndex = 0 to array.size(clusters) - 1
            PendingRightLine cluster = array.get(clusters, clusterIndex)
            if canDrawLine()
                array.push(drawnLines, line.new(cluster.leftTime, cluster.price, cluster.rightTime, cluster.price, xloc=xloc.bar_time, color=cluster.lineColor, style=toLineStyle(cluster.styleName), width=cluster.lineWidth))
        array.clear(pendingRightLines)

flushPendingRightLabels() =>
    int pendingCount = array.size(pendingRightLabels)
    if pendingCount > 0
        for pendingIndex = 0 to pendingCount - 1
            PendingRightLabel pending = array.get(pendingRightLabels, pendingIndex)
            string labelStyle = pending.sessionText ? label.style_label_left : label.style_none
            string textAlignment = pending.sessionText ? text.align_left : text.align_center
            if canDrawLabel()
                array.push(drawnLabels, label.new(pending.markerTime, pending.price, pending.labelText, xloc=xloc.bar_time, yloc=yloc.price, style=labelStyle, textcolor=pending.textColor, size=pending.textSize, color=color.new(color.white, 100), textalign=textAlignment))
        array.clear(pendingRightLabels)

// Bar indexing ignores time gaps.
recentChartTimes() =>
    array<int> chartTimes = array.new<int>()
    int offset = math.min(bar_index, PROFILE_TIME_SCALE_MAX_LOOKBACK)
    while offset >= 0
        array.push(chartTimes, time[offset])
        offset -= 1
    chartTimes

nearestChartTimeIndex(array<int> chartTimes, int targetTime) =>
    int count = array.size(chartTimes)
    int result = -1
    bool insideScale = count > 0 and targetTime >= array.get(chartTimes, 0) and targetTime <= array.get(chartTimes, count - 1)
    if insideScale
        int lowIndex = 0
        int highIndex = count - 1
        while lowIndex <= highIndex
            int middleIndex = int(math.floor((lowIndex + highIndex) * 0.5))
            int middleTime = array.get(chartTimes, middleIndex)
            if middleTime < targetTime
                result := middleIndex
                lowIndex := middleIndex + 1
            else if middleTime > targetTime
                highIndex := middleIndex - 1
            else
                result := middleIndex
                lowIndex := highIndex + 1
        if result < 0
            result := 0
        if result < count - 1
            int nextIndex = result + 1
            if math.abs(array.get(chartTimes, nextIndex) - targetTime) < math.abs(array.get(chartTimes, result) - targetTime)
                result := nextIndex
    result

profileBaselineTime(DeltaProfile profile, array<int> chartTimes, int baselineIndex, bool attachRight) =>
    int count = array.size(chartTimes)
    baselineIndex >= 0 and baselineIndex < count ? array.get(chartTimes, baselineIndex) : (attachRight ? profile.endTime : profile.startTime)

chartTimeAtOffset(array<int> chartTimes, int baselineIndex, int stepOffset) =>
    int count = array.size(chartTimes)
    int outerIndex = baselineIndex + stepOffset
    int outerTime = na
    if outerIndex >= 0 and outerIndex < count
        outerTime := array.get(chartTimes, outerIndex)
    else
        int overflowSteps = outerIndex < 0 ? outerIndex : outerIndex - (count - 1)
        int edgeTime = outerIndex < 0 ? array.get(chartTimes, 0) : array.get(chartTimes, count - 1)
        outerTime := edgeTime + overflowSteps * barSpanMs()
    outerTime

profileOuterTime(DeltaProfile profile, array<int> chartTimes, int baselineIndex, int rangeSteps, float magnitudeRatio, int widthPercent, bool faceLeft, bool attachRight) =>
    int count = array.size(chartTimes)
    int outerTime = na
    float clampedRatio = math.max(0.0, math.min(1.0, magnitudeRatio))
    int baselineTime = profileBaselineTime(profile, chartTimes, baselineIndex, attachRight)
    if clampedRatio <= 0
        outerTime := baselineTime
    else if count > 1 and baselineIndex >= 0
        int maximumSteps = math.max(1, int(math.round(rangeSteps * widthPercent * 0.01)))
        int rowSteps = math.max(1, int(math.round(clampedRatio * maximumSteps)))
        outerTime := chartTimeAtOffset(chartTimes, baselineIndex, faceLeft ? -rowSteps : rowSteps)
    else
        int profileMilliseconds = math.max(1, profile.endTime - profile.startTime)
        int rowWidth = math.max(1, int(math.round(profileMilliseconds * widthPercent * 0.01 * clampedRatio)))
        outerTime := baselineTime + (faceLeft ? -rowWidth : rowWidth)
    outerTime

deltaOuterTime(DeltaProfile profile, array<int> chartTimes, int startScaleIndex, int endScaleIndex, int baselineIndex, float magnitudeRatio, int widthBars, bool faceLeft, bool attachRight) =>
    int count = array.size(chartTimes)
    int baselineTime = profileBaselineTime(profile, chartTimes, baselineIndex, attachRight)
    float clampedRatio = math.max(0.0, math.min(1.0, magnitudeRatio))
    bool completeScale = startScaleIndex >= 0 and endScaleIndex >= 0
    int profileSteps = completeScale ? math.max(1, math.abs(endScaleIndex - startScaleIndex)) : widthBars
    int maximumSteps = math.min(widthBars, profileSteps)
    int rowSteps = math.max(1, int(math.round(clampedRatio * maximumSteps)))
    if count > 1 and baselineIndex >= 0
        chartTimeAtOffset(chartTimes, baselineIndex, faceLeft ? -rowSteps : rowSteps)
    else
        int profileMilliseconds = math.max(1, profile.endTime - profile.startTime)
        int maximumWidth = math.min(profileMilliseconds, barSpanMs() * widthBars)
        int rowWidth = math.max(1, int(math.round(maximumWidth * clampedRatio)))
        baselineTime + (faceLeft ? -rowWidth : rowWidth)

computeRowStrengths(DeltaProfile profile) =>
    array<float> strengths = array.new<float>(profile.rowCount, na)
    float absDeltaSum = 0.0
    int occupiedCount = 0
    for rowIndex = 0 to profile.rowCount - 1
        if array.get(profile.rowVolumes, rowIndex) > 0
            absDeltaSum += math.abs(array.get(profile.rowDeltas, rowIndex))
            occupiedCount += 1
    if occupiedCount > 2
        float averageAbsDelta = absDeltaSum / occupiedCount
        if averageAbsDelta > 0
            for rowIndex = 0 to profile.rowCount - 1
                if array.get(profile.rowVolumes, rowIndex) > 0
                    array.set(strengths, rowIndex, math.abs(array.get(profile.rowDeltas, rowIndex)) / averageAbsDelta)
    strengths

isOutlierStrength(float strength) =>
    not na(strength) and strength >= OUTLIER_MULTIPLIER

rowPassesDeltaFilter(float rowDelta, float strength, bool selectedOutlierRow) =>
    bool isBuy = rowDelta > 0
    bool isSell = rowDelta < 0
    bool directionVisible = deltaHistogramRows == OPTION_ALL ? isBuy or isSell : deltaHistogramRows == OPTION_OFF ? false : deltaHistogramRows == DELTA_ROWS_BUY ? isBuy : deltaHistogramRows == DELTA_ROWS_SELL ? isSell : false
    bool filterPassed = deltaRowFilter == OPTION_ALL ? true : deltaRowFilter == DELTA_ROW_FILTER_OUTLIERS ? isOutlierStrength(strength) : selectedOutlierRow
    directionVisible and filterPassed

appendDeltaRowPoints(array<chart.point> points, int baselineTime, int outerTime, float rowBottom, float rowTop) =>
    array.push(points, chart.point.from_time(baselineTime, rowBottom))
    array.push(points, chart.point.from_time(outerTime, rowBottom))
    array.push(points, chart.point.from_time(outerTime, rowTop))
    array.push(points, chart.point.from_time(baselineTime, rowTop))

renderDeltaLayer(array<chart.point> points, color fillColor) =>
    if array.size(points) >= 4 and canDrawPolyline()
        array.push(drawnPolylines, polyline.new(points, curved=false, closed=true, xloc=xloc.bar_time, line_color=color.new(fillColor, 100), fill_color=fillColor))

renderDeltaPolylines(DeltaProfile profile, string sourceName, array<float> strengths, array<bool> selectedOutlierRows, array<int> chartTimes, int startScaleIndex, int endScaleIndex) =>
    if profile.maxAbsRowDelta > 0
        array<chart.point> buyPoints = array.new<chart.point>()
        array<chart.point> sellPoints = array.new<chart.point>()
        array<chart.point> deltaPlusPlusPoints = array.new<chart.point>()
        array<chart.point> deltaMinusMinusPoints = array.new<chart.point>()
        float rowHeight = (profile.priceHigh - profile.priceLow) / profile.rowCount
        string position = profilePosition(sourceName)
        bool attachRight = position == PROFILE_POSITION_RIGHT_LEFT or position == PROFILE_POSITION_RIGHT_RIGHT
        bool faceLeft = position == PROFILE_POSITION_LEFT_LEFT or position == PROFILE_POSITION_RIGHT_LEFT
        int baselineIndex = attachRight ? endScaleIndex : startScaleIndex
        int baselineTime = profileBaselineTime(profile, chartTimes, baselineIndex, attachRight)
        for rowIndex = 0 to profile.rowCount - 1
            float rowVolume = array.get(profile.rowVolumes, rowIndex)
            if rowVolume > 0
                float strength = array.get(strengths, rowIndex)
                bool outlierRow = isOutlierStrength(strength)
                float rowDelta = array.get(profile.rowDeltas, rowIndex)
                float magnitude = math.abs(rowDelta)
                bool selectedOutlierRow = rowIndex < array.size(selectedOutlierRows) and array.get(selectedOutlierRows, rowIndex)
                if magnitude > 0 and rowPassesDeltaFilter(rowDelta, strength, selectedOutlierRow)
                    float rowBottom = profile.priceLow + rowIndex * rowHeight
                    int outerTime = deltaOuterTime(profile, chartTimes, startScaleIndex, endScaleIndex, baselineIndex, magnitude / profile.maxAbsRowDelta, profileDeltaWidthBars(sourceName), faceLeft, attachRight)
                    if rowDelta >= 0 and outlierRow
                        appendDeltaRowPoints(deltaPlusPlusPoints, baselineTime, outerTime, rowBottom, rowBottom + rowHeight)
                    else if rowDelta >= 0
                        appendDeltaRowPoints(buyPoints, baselineTime, outerTime, rowBottom, rowBottom + rowHeight)
                    else if outlierRow
                        appendDeltaRowPoints(deltaMinusMinusPoints, baselineTime, outerTime, rowBottom, rowBottom + rowHeight)
                    else
                        appendDeltaRowPoints(sellPoints, baselineTime, outerTime, rowBottom, rowBottom + rowHeight)
        renderDeltaLayer(buyPoints, profileDeltaPlusColor(sourceName))
        renderDeltaLayer(sellPoints, profileDeltaMinusColor(sourceName))
        renderDeltaLayer(deltaPlusPlusPoints, profileDeltaPlusPlusColor(sourceName))
        renderDeltaLayer(deltaMinusMinusPoints, profileDeltaMinusMinusColor(sourceName))

pushHistogramRun(array<chart.point> points, color fillColor) =>
    if canDrawPolyline()
        array.push(drawnPolylines, polyline.new(points, curved=false, closed=true, xloc=xloc.bar_time, line_color=color.new(fillColor, 100), fill_color=fillColor))

// Split only at value-area boundaries.
renderHistogram(DeltaProfile profile, int valueAreaLowRow, int valueAreaHighRow, int maxPolylinesAllowed, array<int> chartTimes, int startScaleIndex, int endScaleIndex) =>
    int polylinesUsed = 0
    if profile.maxRowVolume > 0 and maxPolylinesAllowed > 0
        int rowCount = profile.rowCount
        float rowHeight = (profile.priceHigh - profile.priceLow) / rowCount
        bool attachRight = false
        bool faceLeft = false
        bool completeScale = startScaleIndex >= 0 and endScaleIndex >= 0
        int baselineIndex = completeScale ? (attachRight ? endScaleIndex : startScaleIndex) : -1
        int rangeSteps = completeScale ? math.max(1, math.abs(endScaleIndex - startScaleIndex)) : 1
        int baselineTime = profileBaselineTime(profile, chartTimes, baselineIndex, attachRight)
        if not useHistogramValueAreaColors
            array<chart.point> points = array.new<chart.point>()
            array.push(points, chart.point.from_time(baselineTime, profile.priceLow))
            for rowIndex = 0 to rowCount - 1
                float rowVolume = array.get(profile.rowVolumes, rowIndex)
                int outerTime = profileOuterTime(profile, chartTimes, baselineIndex, rangeSteps, rowVolume / profile.maxRowVolume, histogramWidthPercent, faceLeft, attachRight)
                array.push(points, chart.point.from_time(outerTime, profile.priceLow + (rowIndex + 0.5) * rowHeight))
            array.push(points, chart.point.from_time(baselineTime, profile.priceHigh))
            pushHistogramRun(points, color.new(color.rgb(120, 123, 134), 85))
            polylinesUsed := 1
        else
            array<chart.point> points = array.new<chart.point>()
            bool runStarted = false
            bool runInsideValueArea = false
            for rowIndex = 0 to rowCount - 1
                bool insideValueArea = rowIndex >= valueAreaLowRow and rowIndex <= valueAreaHighRow
                float rowBottom = profile.priceLow + rowIndex * rowHeight
                float rowVolume = array.get(profile.rowVolumes, rowIndex)
                int outerTime = profileOuterTime(profile, chartTimes, baselineIndex, rangeSteps, rowVolume / profile.maxRowVolume, histogramWidthPercent, faceLeft, attachRight)
                if runStarted and insideValueArea != runInsideValueArea
                    array.push(points, chart.point.from_time(baselineTime, rowBottom))
                    if polylinesUsed < maxPolylinesAllowed
                        pushHistogramRun(points, runInsideValueArea ? color.new(color.rgb(187, 217, 251), 75) : color.new(color.rgb(184, 184, 184), 80))
                        polylinesUsed += 1
                    points := array.new<chart.point>()
                    runStarted := false
                if not runStarted
                    runStarted := true
                    runInsideValueArea := insideValueArea
                    array.push(points, chart.point.from_time(baselineTime, rowBottom))
                array.push(points, chart.point.from_time(outerTime, rowBottom + rowHeight * 0.5))
                if rowIndex == rowCount - 1
                    array.push(points, chart.point.from_time(baselineTime, rowBottom + rowHeight))
                    if polylinesUsed < maxPolylinesAllowed
                        pushHistogramRun(points, runInsideValueArea ? color.new(color.rgb(187, 217, 251), 75) : color.new(color.rgb(184, 184, 184), 80))
                        polylinesUsed += 1
    polylinesUsed

smoothProfileVolumes(DeltaProfile profile) =>
    array<float> smoothedVolumes = array.new<float>(profile.rowCount, 0.0)
    for rowIndex = 0 to profile.rowCount - 1
        int firstRow = math.max(0, rowIndex - LOW_VOLUME_SMOOTH_RADIUS)
        int lastRow = math.min(profile.rowCount - 1, rowIndex + LOW_VOLUME_SMOOTH_RADIUS)
        float volumeSum = 0.0
        for sampleRow = firstRow to lastRow
            volumeSum += array.get(profile.rowVolumes, sampleRow)
        array.set(smoothedVolumes, rowIndex, volumeSum / (lastRow - firstRow + 1))
    smoothedVolumes

volumeWindowAverage(array<float> volumes, int firstRow, int lastRow) =>
    float volumeSum = 0.0
    for rowIndex = firstRow to lastRow
        volumeSum += array.get(volumes, rowIndex)
    volumeSum / (lastRow - firstRow + 1)

collectLowVolumeCandidates(DeltaProfile profile) =>
    array<LowVolumeCandidate> candidates = array.new<LowVolumeCandidate>()
    int rowCount = profile.rowCount
    float rowHeight = (profile.priceHigh - profile.priceLow) / rowCount
    int shoulderWindow = math.max(4, math.min(32, int(math.round(rowCount * LOW_VOLUME_SHOULDER_FRACTION))))
    if rowCount >= LOW_VOLUME_SMOOTH_RADIUS * 2 + 3
        array<float> smoothedVolumes = smoothProfileVolumes(profile)
        float maxSmoothedVolume = array.max(smoothedVolumes)
        float minimumShoulderVolume = maxSmoothedVolume * LOW_VOLUME_MIN_SHOULDER_SHARE
        float minimumDenominator = math.max(maxSmoothedVolume * 0.001, 0.0000001)
        if rowCount >= shoulderWindow * 2 + 3
            int maximumZoneRows = math.max(1, int(math.floor(rowCount * LOW_VOLUME_MAX_ZONE_FRACTION)))
            int firstLvnRow = shoulderWindow
            int lastLvnRow = rowCount - shoulderWindow - 1
            for rowIndex = firstLvnRow to lastLvnRow
                float valleyVolume = array.get(smoothedVolumes, rowIndex)
                float leftShoulderVolume = 0.0
                float rightShoulderVolume = 0.0
                for shoulderOffset = 1 to shoulderWindow
                    leftShoulderVolume := math.max(leftShoulderVolume, array.get(smoothedVolumes, rowIndex - shoulderOffset))
                    rightShoulderVolume := math.max(rightShoulderVolume, array.get(smoothedVolumes, rowIndex + shoulderOffset))
                float shoulderVolume = math.min(leftShoulderVolume, rightShoulderVolume)
                float strength = shoulderVolume / math.max(valleyVolume, minimumDenominator)
                bool boundedValley = valleyVolume < leftShoulderVolume and valleyVolume < rightShoulderVolume
                if boundedValley and shoulderVolume >= minimumShoulderVolume and strength >= LOW_VOLUME_SENSITIVITY
                    float zoneThreshold = shoulderVolume / LOW_VOLUME_SENSITIVITY
                    int firstZoneRow = rowIndex
                    int lastZoneRow = rowIndex
                    while firstZoneRow > 0 and lastZoneRow - firstZoneRow + 1 <= maximumZoneRows and array.get(smoothedVolumes, firstZoneRow - 1) <= zoneThreshold
                        firstZoneRow -= 1
                    while lastZoneRow < rowCount - 1 and lastZoneRow - firstZoneRow + 1 <= maximumZoneRows and array.get(smoothedVolumes, lastZoneRow + 1) <= zoneThreshold
                        lastZoneRow += 1
                    int zoneRows = lastZoneRow - firstZoneRow + 1
                    if zoneRows <= maximumZoneRows
                        float valleyPrice = profile.priceLow + (rowIndex + 0.5) * rowHeight
                        float zoneLow = profile.priceLow + firstZoneRow * rowHeight
                        float zoneHigh = profile.priceLow + (lastZoneRow + 1) * rowHeight
                        array.push(candidates, LowVolumeCandidate.new(valleyPrice, zoneLow, zoneHigh, strength, true))
        int compareRows = LOW_VOLUME_SMOOTH_RADIUS + 1
        if rowCount >= compareRows * 2 + 1
            int firstCliffBoundary = compareRows
            int lastCliffBoundary = rowCount - compareRows
            for boundaryRow = firstCliffBoundary to lastCliffBoundary
                int lowerFirstRow = boundaryRow - compareRows
                int lowerLastRow = boundaryRow - 1
                int upperFirstRow = boundaryRow
                int upperLastRow = boundaryRow + compareRows - 1
                float lowerVolume = volumeWindowAverage(smoothedVolumes, lowerFirstRow, lowerLastRow)
                float upperVolume = volumeWindowAverage(smoothedVolumes, upperFirstRow, upperLastRow)
                float highVolume = math.max(lowerVolume, upperVolume)
                float lowVolume = math.min(lowerVolume, upperVolume)
                float strength = highVolume / math.max(lowVolume, minimumDenominator)
                if highVolume >= minimumShoulderVolume and strength >= LOW_VOLUME_SENSITIVITY
                    float cliffPrice = profile.priceLow + boundaryRow * rowHeight
                    array.push(candidates, LowVolumeCandidate.new(cliffPrice, cliffPrice, cliffPrice, strength, false))
    candidates

lowVolumeCandidatesOverlap(LowVolumeCandidate first, LowVolumeCandidate second, float rowHeight) =>
    bool overlap = false
    if first.isLvn and second.isLvn
        overlap := first.zoneLow <= second.zoneHigh and second.zoneLow <= first.zoneHigh
    else if not first.isLvn and not second.isLvn
        overlap := math.abs(first.price - second.price) <= rowHeight * LOW_VOLUME_CLIFF_SEPARATION_ROWS
    else
        float lvnLow = first.isLvn ? first.zoneLow : second.zoneLow
        float lvnHigh = first.isLvn ? first.zoneHigh : second.zoneHigh
        float cliffPrice = first.isLvn ? second.price : first.price
        float cliffMargin = rowHeight * LOW_VOLUME_CLIFF_SEPARATION_ROWS
        overlap := cliffPrice >= lvnLow - cliffMargin and cliffPrice <= lvnHigh + cliffMargin
    overlap

renderLowVolumeZone(DeltaProfile profile, string sourceName, float price, float zoneLow, float zoneHigh, int levelEndTime, int levelRank, int sessionTradingDayKey, bool historical, string markerLabel, color markerColor, int markerSize, bool registrationOnly) =>
    color zoneColor = color.new(color.rgb(74, 74, 74), 95)
    bool markerDeferred = mitigatedZoneExtensionEnabled(sourceName)
    if registrationOnly
        if markerDeferred
            registerMitigatedZone(sourceName, profile.startTime, levelEndTime, price)
    else if markerDeferred
        queueMitigatedZone(price, zoneLow, zoneHigh, profile.startTime, profile.endTime, levelEndTime, zoneColor, false, markerColor, LOW_VOLUME_LINE_WIDTH, STYLE_DOTTED, levelRank, sourceName, sessionTradingDayKey, historical, 0, markerLabel, markerColor, markerSize)
    else
        renderZoneFill(profile.endTime, levelEndTime, zoneLow, zoneHigh, zoneColor)
    markerDeferred

renderLowVolumeStructures(DeltaProfile profile, string sourceName, string displayNameOverride, int levelEndTime, int sessionTradingDayKey, bool historical, bool registrationOnly) =>
    if showMinimumLvnTiers and not enableQuickCheck
        array<LowVolumeCandidate> candidates = collectLowVolumeCandidates(profile)
        int candidateCount = array.size(candidates)
        if candidateCount > 0
            array<bool> discarded = array.new<bool>(candidateCount, false)
            float rowHeight = (profile.priceHigh - profile.priceLow) / profile.rowCount
            for structureRank = 1 to visibleLvnTierCount
                int structureTier = 6 - structureRank
                int bestCandidateIndex = -1
                float bestStrength = -1.0
                for candidateIndex = 0 to candidateCount - 1
                    LowVolumeCandidate candidate = array.get(candidates, candidateIndex)
                    if not array.get(discarded, candidateIndex) and candidate.strength > bestStrength
                        bestCandidateIndex := candidateIndex
                        bestStrength := candidate.strength
                if bestCandidateIndex >= 0
                    LowVolumeCandidate selectedCandidate = array.get(candidates, bestCandidateIndex)
                    array.set(discarded, bestCandidateIndex, true)
                    int levelRank = LOW_VOLUME_LEVEL_RANK - structureRank
                    float labelPrice = selectedCandidate.isLvn ? (selectedCandidate.zoneLow + selectedCandidate.zoneHigh) * 0.5 : selectedCandidate.price
                    int markerTime = levelMarkerTime(levelEndTime)
                    string markerLabel = showDotLabels and structureRank == 1 ? profileSourceName(sourceName, displayNameOverride) : ""
                    color markerColor = color.new(color.rgb(15, 15, 15), 75)
                    int markerSize = tierMarkerSize(tierMarkerSizes, structureTier)
                    bool markerDeferred = false
                    if selectedCandidate.isLvn
                        markerDeferred := renderLowVolumeZone(profile, sourceName, labelPrice, selectedCandidate.zoneLow, selectedCandidate.zoneHigh, levelEndTime, levelRank, sessionTradingDayKey, historical, markerLabel, markerColor, markerSize, registrationOnly)
                    else if not registrationOnly
                        queueRightLine(selectedCandidate.price, profile.endTime, levelEndTime, markerColor, LOW_VOLUME_LINE_WIDTH, STYLE_DOTTED, levelRank, sourceName, sessionTradingDayKey, historical, 0)
                    if not registrationOnly and not markerDeferred
                        queueLevelMarker(labelPrice, markerTime, markerLabel, markerColor, markerSize)
                    for candidateIndex = 0 to candidateCount - 1
                        if not array.get(discarded, candidateIndex) and lowVolumeCandidatesOverlap(selectedCandidate, array.get(candidates, candidateIndex), rowHeight)
                            array.set(discarded, candidateIndex, true)

queueOutlierPeak(DeltaProfile profile, string sourceName, string displayNameOverride, int levelEndTime, int sessionTradingDayKey, bool historical, bool buySide, int firstRow, int lastRow, int anchorRow, float peakDelta, float peakStrength, int markerTime) =>
    float rowHeight = (profile.priceHigh - profile.priceLow) / profile.rowCount
    float peakPrice = profile.priceLow + (anchorRow + 0.5) * rowHeight
    float zoneLow = profile.priceLow + firstRow * rowHeight
    float zoneHigh = profile.priceLow + (lastRow + 1) * rowHeight
    array.push(pendingOutlierLevels, PendingOutlierLevel.new(peakPrice, zoneLow, zoneHigh, peakDelta, peakStrength, buySide, profile.startTime, profile.endTime, levelEndTime, markerTime, sourceName, displayNameOverride, sessionTradingDayKey, historical, firstRow, lastRow))

collectSideOutlierPeaks(DeltaProfile profile, array<float> strengths, string sourceName, string displayNameOverride, int levelEndTime, int sessionTradingDayKey, bool historical, bool buySide, int markerTime) =>
    int peaksFound = 0
    bool peakActive = false
    float peakDelta = 0.0
    float peakStrength = 0.0
    int peakFirstRow = -1
    int peakLastRow = -1
    int peakAnchorRow = -1
    int lastQualifiedRow = -100000
    for rowIndex = 0 to profile.rowCount - 1
        float rowDelta = array.get(profile.rowDeltas, rowIndex)
        float strength = array.get(strengths, rowIndex)
        bool correctSide = buySide ? rowDelta > 0 : rowDelta < 0
        bool qualifies = correctSide and isOutlierStrength(strength)
        if qualifies
            bool startsNewPeak = peakActive and rowIndex - lastQualifiedRow > OUTLIER_PEAK_GAP_ROWS + 1
            if startsNewPeak
                queueOutlierPeak(profile, sourceName, displayNameOverride, levelEndTime, sessionTradingDayKey, historical, buySide, peakFirstRow, peakLastRow, peakAnchorRow, peakDelta, peakStrength, markerTime)
                peaksFound += 1
                peakActive := false
                peakDelta := 0.0
                peakStrength := 0.0
                peakFirstRow := -1
                peakLastRow := -1
                peakAnchorRow := -1
            if not peakActive
                peakActive := true
                peakFirstRow := rowIndex
            peakDelta += rowDelta
            peakLastRow := rowIndex
            if strength > peakStrength
                peakStrength := strength
                peakAnchorRow := rowIndex
            lastQualifiedRow := rowIndex
    if peakActive
        queueOutlierPeak(profile, sourceName, displayNameOverride, levelEndTime, sessionTradingDayKey, historical, buySide, peakFirstRow, peakLastRow, peakAnchorRow, peakDelta, peakStrength, markerTime)
        peaksFound += 1
    peaksFound

collectOutlierPeaks(DeltaProfile profile, array<float> strengths, string sourceName, string displayNameOverride, int levelEndTime, int sessionTradingDayKey, bool historical) =>
    int peaksFound = 0
    if showDeltaTiers and not enableQuickCheck
        int markerTime = levelMarkerTime(levelEndTime)
        peaksFound += collectSideOutlierPeaks(profile, strengths, sourceName, displayNameOverride, levelEndTime, sessionTradingDayKey, historical, true, markerTime)
        peaksFound += collectSideOutlierPeaks(profile, strengths, sourceName, displayNameOverride, levelEndTime, sessionTradingDayKey, historical, false, markerTime)
    peaksFound

rankPendingOutlierLevels(bool merge) =>
    array<RankedOutlierLevel> rankedLevels = array.new<RankedOutlierLevel>()
    int pendingCount = array.size(pendingOutlierLevels)
    if pendingCount > 0
        array<float> clusterPrices = array.new<float>()
        array<float> clusterZoneLows = array.new<float>()
        array<float> clusterZoneHighs = array.new<float>()
        array<float> clusterDeltas = array.new<float>()
        array<float> clusterStrengths = array.new<float>()
        array<bool> clusterBuySides = array.new<bool>()
        array<int> clusterProfileStartTimes = array.new<int>()
        array<int> clusterLineStartTimes = array.new<int>()
        array<int> clusterRightTimes = array.new<int>()
        array<int> clusterMarkerTimes = array.new<int>()
        array<string> clusterSourceNames = array.new<string>()
        array<string> clusterDisplayNameOverrides = array.new<string>()
        array<int> clusterTradingDayKeys = array.new<int>()
        array<bool> clusterHistoricalFlags = array.new<bool>()
        array<int> clusterFirstRows = array.new<int>()
        array<int> clusterLastRows = array.new<int>()
        for pendingIndex = 0 to pendingCount - 1
            PendingOutlierLevel pending = array.get(pendingOutlierLevels, pendingIndex)
            float tolerance = math.max(syminfo.mintick, math.abs(pending.price) * mergeDistancePercent / 100.0)
            int foundIndex = -1
            float minimumDistance = tolerance + syminfo.mintick
            int existingClusterCount = array.size(clusterPrices)
            if merge and existingClusterCount > 0
                for clusterIndex = 0 to existingClusterCount - 1
                    float distance = math.abs(array.get(clusterPrices, clusterIndex) - pending.price)
                    bool sameSide = array.get(clusterBuySides, clusterIndex) == pending.buySide
                    bool sameSource = array.get(clusterSourceNames, clusterIndex) == pending.sourceName
                    bool sameOccurrence = array.get(clusterTradingDayKeys, clusterIndex) == pending.tradingDayKey and array.get(clusterHistoricalFlags, clusterIndex) == pending.historical
                    if sameSide and sameSource and sameOccurrence and distance <= tolerance and distance < minimumDistance
                        minimumDistance := distance
                        foundIndex := clusterIndex
            if foundIndex >= 0
                array.set(clusterLineStartTimes, foundIndex, math.max(array.get(clusterLineStartTimes, foundIndex), pending.lineStartTime))
                array.set(clusterRightTimes, foundIndex, math.max(array.get(clusterRightTimes, foundIndex), pending.rightTime))
                if pending.strength > array.get(clusterStrengths, foundIndex)
                    array.set(clusterMarkerTimes, foundIndex, pending.markerTime)
                array.set(clusterZoneLows, foundIndex, math.min(array.get(clusterZoneLows, foundIndex), pending.zoneLow))
                array.set(clusterZoneHighs, foundIndex, math.max(array.get(clusterZoneHighs, foundIndex), pending.zoneHigh))
                array.set(clusterDeltas, foundIndex, array.get(clusterDeltas, foundIndex) + pending.delta)
                array.set(clusterFirstRows, foundIndex, math.min(array.get(clusterFirstRows, foundIndex), pending.firstRow))
                array.set(clusterLastRows, foundIndex, math.max(array.get(clusterLastRows, foundIndex), pending.lastRow))
                if pending.strength > array.get(clusterStrengths, foundIndex)
                    array.set(clusterPrices, foundIndex, pending.price)
                    array.set(clusterStrengths, foundIndex, pending.strength)
            else
                array.push(clusterPrices, pending.price)
                array.push(clusterZoneLows, pending.zoneLow)
                array.push(clusterZoneHighs, pending.zoneHigh)
                array.push(clusterDeltas, pending.delta)
                array.push(clusterStrengths, pending.strength)
                array.push(clusterBuySides, pending.buySide)
                array.push(clusterProfileStartTimes, pending.profileStartTime)
                array.push(clusterLineStartTimes, pending.lineStartTime)
                array.push(clusterRightTimes, pending.rightTime)
                array.push(clusterMarkerTimes, pending.markerTime)
                array.push(clusterSourceNames, pending.sourceName)
                array.push(clusterDisplayNameOverrides, pending.displayNameOverride)
                array.push(clusterTradingDayKeys, pending.tradingDayKey)
                array.push(clusterHistoricalFlags, pending.historical)
                array.push(clusterFirstRows, pending.firstRow)
                array.push(clusterLastRows, pending.lastRow)
        int clusterCount = array.size(clusterPrices)
        array<string> sourceNames = array.new<string>()
        for clusterIndex = 0 to clusterCount - 1
            string sourceName = array.get(clusterSourceNames, clusterIndex)
            if not array.includes(sourceNames, sourceName)
                array.push(sourceNames, sourceName)
        array<bool> selectedClusters = array.new<bool>(clusterCount, false)
        int sourceCount = array.size(sourceNames)
        for sourceIndex = 0 to sourceCount - 1
            string selectedSourceName = array.get(sourceNames, sourceIndex)
            for sideIndex = 0 to 1
                bool buySide = sideIndex == 0
                for strengthRank = 1 to visibleDeltaTierCount
                    int bestCluster = -1
                    float bestMagnitude = -1.0
                    float bestStrength = -1.0
                    for clusterIndex = 0 to clusterCount - 1
                        bool eligible = not array.get(selectedClusters, clusterIndex) and array.get(clusterBuySides, clusterIndex) == buySide and array.get(clusterSourceNames, clusterIndex) == selectedSourceName
                        if eligible
                            float magnitude = math.abs(array.get(clusterDeltas, clusterIndex))
                            float strength = array.get(clusterStrengths, clusterIndex)
                            if clusterOutranks(magnitude, strength, bestMagnitude, bestStrength)
                                bestMagnitude := magnitude
                                bestStrength := strength
                                bestCluster := clusterIndex
                    if bestCluster >= 0
                        array.set(selectedClusters, bestCluster, true)
                        array.push(rankedLevels, RankedOutlierLevel.new(array.get(clusterPrices, bestCluster), array.get(clusterZoneLows, bestCluster), array.get(clusterZoneHighs, bestCluster), buySide, array.get(clusterProfileStartTimes, bestCluster), array.get(clusterLineStartTimes, bestCluster), array.get(clusterRightTimes, bestCluster), array.get(clusterMarkerTimes, bestCluster), array.get(clusterSourceNames, bestCluster), array.get(clusterDisplayNameOverrides, bestCluster), array.get(clusterTradingDayKeys, bestCluster), array.get(clusterHistoricalFlags, bestCluster), array.get(clusterFirstRows, bestCluster), array.get(clusterLastRows, bestCluster), strengthRank))
        array.clear(pendingOutlierLevels)
    rankedLevels

selectedOutlierRowMask(DeltaProfile profile, array<float> strengths, array<RankedOutlierLevel> rankedLevels) =>
    array<bool> selectedRows = array.new<bool>(profile.rowCount, false)
    int rankedCount = array.size(rankedLevels)
    if selectedTierOutlierRowsOnly() and showDeltaTiers and not enableQuickCheck and deltaTierSideVisibility != OPTION_OFF and rankedCount > 0
        for rankedIndex = 0 to rankedCount - 1
            RankedOutlierLevel ranked = array.get(rankedLevels, rankedIndex)
            if ranked.profileStartTime == profile.startTime and deltaTierSideVisible(ranked.buySide)
                int firstRow = math.max(0, ranked.firstRow)
                int lastRow = math.min(profile.rowCount - 1, ranked.lastRow)
                if firstRow <= lastRow
                    for rowIndex = firstRow to lastRow
                        float rowDelta = array.get(profile.rowDeltas, rowIndex)
                        float strength = array.get(strengths, rowIndex)
                        bool correctSide = ranked.buySide ? rowDelta > 0 : rowDelta < 0
                        if correctSide and isOutlierStrength(strength)
                            array.set(selectedRows, rowIndex, true)
    selectedRows

renderRankedOutlierLevels(array<RankedOutlierLevel> rankedLevels, bool registrationOnly) =>
    int rankedCount = array.size(rankedLevels)
    if rankedCount > 0
        for rankedIndex = 0 to rankedCount - 1
            RankedOutlierLevel ranked = array.get(rankedLevels, rankedIndex)
            int tier = 6 - ranked.strengthRank
            DeltaTierAppearance appearance = deltaTierAppearance(ranked.buySide, tier, ranked.sourceName)
            int levelRank = 2000 - ranked.strengthRank
            bool extendPriorityZone = extendsPriorityZoneUntilMitigated(ranked.sourceName, ranked.strengthRank)
            int direction = ranked.buySide ? 1 : -1
            string markerLabel = showDotLabels and ranked.strengthRank == 1 ? profileSourceName(ranked.sourceName, ranked.displayNameOverride) : ""
            int markerSize = tierMarkerSize(tierMarkerSizes, tier)
            if deltaTierSideVisible(ranked.buySide)
                if registrationOnly
                    if extendPriorityZone
                        registerMitigatedZone(ranked.sourceName, ranked.profileStartTime, ranked.rightTime, ranked.price)
                else if extendPriorityZone
                    queueMitigatedZone(ranked.price, ranked.zoneLow, ranked.zoneHigh, ranked.profileStartTime, ranked.lineStartTime, ranked.rightTime, appearance.zoneColor, appearance.hasLine, appearance.lineColor, appearance.lineWidth, appearance.lineStyle, levelRank, ranked.sourceName, ranked.tradingDayKey, ranked.historical, direction, markerLabel, appearance.textColor, markerSize)
                else
                    renderZoneFill(ranked.lineStartTime, ranked.rightTime, ranked.zoneLow, ranked.zoneHigh, appearance.zoneColor)
                    if appearance.hasLine
                        queueRightLine(ranked.price, ranked.lineStartTime, ranked.rightTime, appearance.lineColor, appearance.lineWidth, appearance.lineStyle, levelRank, ranked.sourceName, ranked.tradingDayKey, ranked.historical, direction)
                    queueLevelMarker(ranked.price, ranked.markerTime, markerLabel, appearance.textColor, markerSize)

renderProfileBox(DeltaProfile profile, string sourceName) =>
    color innerColor = profileInnerColor(sourceName)
    if canDrawBox()
        array.push(drawnBoxes, box.new(left=profile.startTime, top=profile.rangeHigh, right=profile.endTime, bottom=profile.rangeLow, xloc=xloc.bar_time, border_color=innerColor, border_width=SESSION_OUTLINE_WIDTH, border_style=line.style_solid, bgcolor=color.new(color.white, 100)))

renderOuterSessionFrame(DeltaProfile profile, string sourceName, int levelEndTime) =>
    [rangeHighTitleY, rangeLowTitleY, titleClearance] = rangeTitleLayout(profile, profileRangeLabelSize(sourceName))
    color outerColor = profileOuterColor(sourceName)
    if canDrawBox()
        array.push(drawnBoxes, box.new(left=profile.startTime, top=rangeHighTitleY + titleClearance, right=levelEndTime, bottom=rangeLowTitleY - titleClearance, xloc=xloc.bar_time, border_color=outerColor, border_width=1, border_style=line.style_solid, bgcolor=color.new(outerColor, 100)))

renderReferenceLevel(DeltaProfile profile, string sourceName, string displayNameOverride, int levelEndTime, float price, string levelName, color lineColor, bool twentyFourSeven) =>
    string labelText = profileDisplayName(sourceName, displayNameOverride, twentyFourSeven) + " " + levelName
    bool pocLevel = levelName == LEVEL_POC
    string lineStyle = pocLevel ? STYLE_DASHED : STYLE_SOLID
    int effectiveWidth = pocLevel ? POC_LEVEL_WIDTH : VALUE_AREA_LEVEL_WIDTH
    if canDrawLine()
        array.push(drawnLines, line.new(profile.startTime, price, levelEndTime, price, xloc=xloc.bar_time, color=lineColor, style=toLineStyle(lineStyle), width=effectiveWidth))
    if pocLevel and canDrawLabel()
        color labelColor = enableQuickCheck ? lineColor : color.rgb(49, 27, 146)
        array.push(drawnLabels, label.new(levelEndTime + pocLabelOffsetMs(), price, labelText, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, textcolor=labelColor, size=POC_LABEL_SIZE, color=color.new(color.white, 100)))

renderProfileLevels(DeltaProfile profile, string sourceName, string displayNameOverride, int levelEndTime, float pocPrice, float valueAreaLowPrice, float valueAreaHighPrice, bool twentyFourSeven) =>
    color quickCheckLevelColor = profileRangeLabelColor(sourceName)
    if showValueAreaLevels or enableQuickCheck
        color valueAreaColor = profileValueAreaLevelColor(sourceName)
        renderReferenceLevel(profile, sourceName, displayNameOverride, levelEndTime, valueAreaHighPrice, LEVEL_VAH, valueAreaColor, twentyFourSeven)
        renderReferenceLevel(profile, sourceName, displayNameOverride, levelEndTime, valueAreaLowPrice, LEVEL_VAL, valueAreaColor, twentyFourSeven)
    if showPocLevel or enableQuickCheck
        color pocColor = enableQuickCheck ? quickCheckLevelColor : color.rgb(49, 27, 146)
        renderReferenceLevel(profile, sourceName, displayNameOverride, levelEndTime, pocPrice, LEVEL_POC, pocColor, twentyFourSeven)

renderRangeLabels(DeltaProfile profile, string sourceName, string displayNameOverride, bool pairedNyHeadings, array<int> chartTimes, int startScaleIndex, int endScaleIndex, bool twentyFourSeven) =>
    string labelSize = profileRangeLabelSize(sourceName)
    color labelColor = profileRangeLabelColor(sourceName)
    int headingTime = rangeHeadingTime(profile, chartTimes, startScaleIndex, endScaleIndex, profileHeadingOffsetBars(sourceName, pairedNyHeadings))
    [rangeHighTitleY, rangeLowTitleY, _] = rangeTitleLayout(profile, labelSize)
    string rangeLabel = profileDisplayName(sourceName, displayNameOverride, twentyFourSeven)
    color labelBackgroundColor = profileTextBackgroundColor(sourceName)
    bool fixedSource = sourceName == SOURCE_FIXED
    if fixedSource and canDrawLabel()
        array.push(drawnLabels, label.new(profile.startTime, rangeHighTitleY, "Fixed Start", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelColor, size=toLabelSize(labelSize), color=labelBackgroundColor))
    if fixedSource and canDrawLabel()
        array.push(drawnLabels, label.new(profile.endTime, rangeHighTitleY, "Fixed End", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelColor, size=toLabelSize(labelSize), color=labelBackgroundColor))
    if canDrawLabel()
        array.push(drawnLabels, label.new(headingTime, rangeHighTitleY, rangeLabel, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelColor, size=toLabelSize(labelSize), color=labelBackgroundColor))
    if canDrawLabel()
        array.push(drawnLabels, label.new(headingTime, rangeLowTitleY, rangeLabel, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, textcolor=labelColor, size=toLabelSize(labelSize), color=labelBackgroundColor))

selectSessionProfiles(int historyCount, bool currentPeriodActive, bool hideDeveloping, array<float> barHighs, array<float> barLows, array<float> barVolumes, array<float> barDeltas, array<DeltaProfile> completedProfiles, array<int> startRef, array<float> sampleHighs, array<float> sampleLows, array<float> sampleVolumes, array<float> sampleDeltas, int developingEndTime) =>
    array<DeltaProfile> selectedProfiles = array.new<DeltaProfile>()
    int completedCount = array.size(completedProfiles)
    bool showDeveloping = currentPeriodActive and not hideDeveloping
    int currentCompletedIndex = currentPeriodActive ? -1 : completedCount - 1
    int historyEndIndex = currentPeriodActive ? completedCount - 1 : currentCompletedIndex - 1
    int availableHistoryCount = math.max(0, historyEndIndex + 1)
    int selectedHistoryCount = math.min(historyCount, availableHistoryCount)
    int historyStartIndex = historyEndIndex - selectedHistoryCount + 1
    if selectedHistoryCount > 0
        for profileIndex = historyStartIndex to historyEndIndex
            array.push(selectedProfiles, array.get(completedProfiles, profileIndex))
    int currentIndex = -1
    DeltaProfile currentProfile = na
    if showDeveloping
        currentProfile := buildDevelopingDeltaProfile(barHighs, barLows, barVolumes, barDeltas, startRef, sampleHighs, sampleLows, sampleVolumes, sampleDeltas, developingEndTime)
    else if currentCompletedIndex >= 0
        currentProfile := array.get(completedProfiles, currentCompletedIndex)
    if not na(currentProfile) and currentProfile.isValid
        currentIndex := array.size(selectedProfiles)
        array.push(selectedProfiles, currentProfile)
    ProfileSelection.new(selectedProfiles, currentIndex, showDeveloping and currentIndex >= 0)

nyProfileOccurrenceKey(DeltaProfile profile) =>
    tradingDayKey(nyMinuteBoundary(profile.startTime, NY_EARLY_END_MINUTE))

matchingNyProfile(ProfileSelection selection, DeltaProfile referenceProfile) =>
    DeltaProfile matchedProfile = na
    if not na(selection)
        int referenceKey = nyProfileOccurrenceKey(referenceProfile)
        int profileCount = array.size(selection.profiles)
        if profileCount > 0
            for profileIndex = 0 to profileCount - 1
                DeltaProfile candidate = array.get(selection.profiles, profileIndex)
                if na(matchedProfile) and nyProfileOccurrenceKey(candidate) == referenceKey
                    matchedProfile := candidate
    matchedProfile

extendedNyHasPostNySamples(DeltaProfile extendedProfile) =>
    extendedProfile.endTime > nyMinuteBoundary(extendedProfile.startTime, NY_EARLY_END_MINUTE)

nyRangeMatchesExtended(DeltaProfile nyProfile, DeltaProfile extendedProfile) =>
    not na(nyProfile) and priceTickIndex(nyProfile.rangeHigh) == priceTickIndex(extendedProfile.rangeHigh) and priceTickIndex(nyProfile.rangeLow) == priceTickIndex(extendedProfile.rangeLow)

profileRenderDecision(DeltaProfile profile, string sourceName, ProfileSelection comparisonSelection) =>
    bool shouldRender = true
    bool pairedNyHeadings = false
    string displayNameOverride = ""
    if sourceName == SOURCE_EXTENDED_NY_EARLY
        DeltaProfile nyProfile = matchingNyProfile(comparisonSelection, profile)
        bool postNyStart = extendedNyHasPostNySamples(profile)
        bool matchingRange = nyRangeMatchesExtended(nyProfile, profile)
        shouldRender := postNyStart and not na(nyProfile) and not matchingRange
        pairedNyHeadings := shouldRender
    else if sourceName == SOURCE_NY_EARLY
        DeltaProfile extendedProfile = matchingNyProfile(comparisonSelection, profile)
        bool extendedProfileVisible = false
        if not na(extendedProfile) and extendedNyHasPostNySamples(extendedProfile)
            bool matchingRange = nyRangeMatchesExtended(profile, extendedProfile)
            extendedProfileVisible := not matchingRange
        pairedNyHeadings := extendedProfileVisible
        displayNameOverride := extendedNyEarlyModeActive and not extendedProfileVisible ? DISPLAY_NY_EARLY_PLUS : ""
    [shouldRender, displayNameOverride, pairedNyHeadings]

renderableProfileCount(ProfileSelection selection, string sourceName, ProfileSelection comparisonSelection) =>
    int renderableCount = 0
    int profileCount = array.size(selection.profiles)
    if profileCount > 0
        for profileIndex = 0 to profileCount - 1
            DeltaProfile profile = array.get(selection.profiles, profileIndex)
            [shouldRender, _, _] = profileRenderDecision(profile, sourceName, comparisonSelection)
            if shouldRender
                renderableCount += 1
    renderableCount

comparisonSelectionForSource(array<ProfileSelection> selections, array<string> sourceNames, string sourceName) =>
    string comparisonSourceName = sourceName == SOURCE_EXTENDED_NY_EARLY ? SOURCE_NY_EARLY : sourceName == SOURCE_NY_EARLY ? SOURCE_EXTENDED_NY_EARLY : ""
    ProfileSelection comparisonSelection = na
    int selectionCount = array.size(selections)
    if comparisonSourceName != "" and selectionCount > 0
        for selectionIndex = 0 to selectionCount - 1
            if na(comparisonSelection) and array.get(sourceNames, selectionIndex) == comparisonSourceName
                comparisonSelection := array.get(selections, selectionIndex)
    comparisonSelection

totalRenderableProfileCount(array<ProfileSelection> selections, array<string> sourceNames) =>
    int totalCount = 0
    int selectionCount = array.size(selections)
    if selectionCount > 0
        for selectionIndex = 0 to selectionCount - 1
            ProfileSelection selection = array.get(selections, selectionIndex)
            string sourceName = array.get(sourceNames, selectionIndex)
            ProfileSelection comparisonSelection = comparisonSelectionForSource(selections, sourceNames, sourceName)
            totalCount += renderableProfileCount(selection, sourceName, comparisonSelection)
    totalCount

trimProfileSelectionsToCapacity(array<ProfileSelection> selections, array<string> sourceNames, int profileCapacity) =>
    int selectionCount = array.size(selections)
    int selectedCount = totalRenderableProfileCount(selections, sourceNames)
    while selectedCount > profileCapacity
        int oldestSelectionIndex = -1
        int oldestProfileIndex = -1
        int oldestProfileEndTime = na
        for selectionIndex = 0 to selectionCount - 1
            ProfileSelection selection = array.get(selections, selectionIndex)
            string sourceName = array.get(sourceNames, selectionIndex)
            ProfileSelection comparisonSelection = comparisonSelectionForSource(selections, sourceNames, sourceName)
            int profileCount = array.size(selection.profiles)
            if profileCount > 0
                for profileIndex = 0 to profileCount - 1
                    bool currentProfile = profileIndex == selection.currentIndex
                    DeltaProfile candidate = array.get(selection.profiles, profileIndex)
                    [shouldRender, _, _] = profileRenderDecision(candidate, sourceName, comparisonSelection)
                    if not currentProfile and shouldRender and (oldestSelectionIndex < 0 or candidate.endTime < oldestProfileEndTime)
                        oldestSelectionIndex := selectionIndex
                        oldestProfileIndex := profileIndex
                        oldestProfileEndTime := candidate.endTime
        if oldestSelectionIndex < 0
            break
        ProfileSelection oldestSelection = array.get(selections, oldestSelectionIndex)
        array.remove(oldestSelection.profiles, oldestProfileIndex)
        if oldestSelection.currentIndex > oldestProfileIndex
            oldestSelection.currentIndex := oldestSelection.currentIndex - 1
        selectedCount := totalRenderableProfileCount(selections, sourceNames)
    selectedCount

registerProfileMitigationLevels(DeltaProfile profile, string sourceName, bool twentyFourSeven) =>
    if mitigatedZoneExtensionEnabled(sourceName)
        int sessionCloseTime = sessionOccurrenceClose(sourceName, profile, twentyFourSeven, false)
        int levelEndTime = sessionLevelEndpoint(sourceName, sessionCloseTime, syminfo.type == "futures")
        int sessionTradingDayKey = tradingDayKey(sessionCloseTime)
        renderLowVolumeStructures(profile, sourceName, "", levelEndTime, sessionTradingDayKey, true, true)
        array<float> strengths = computeRowStrengths(profile)
        collectOutlierPeaks(profile, strengths, sourceName, "", levelEndTime, sessionTradingDayKey, true)
        array<RankedOutlierLevel> rankedOutlierLevels = rankPendingOutlierLevels(mergeOverlaps)
        renderRankedOutlierLevels(rankedOutlierLevels, true)

renderSelectedProfile(DeltaProfile profile, string sourceName, string displayNameOverride, bool pairedNyHeadings, bool historical, bool developing, bool twentyFourSeven, array<int> chartTimes, bool renderBudgetedHistogram, int histogramLayersPerProfile) =>
    [_, valueAreaLowRow, valueAreaHighRow, pocPrice, valueAreaLowPrice, valueAreaHighPrice] = profileValueLevels(profile)
    int startScaleIndex = nearestChartTimeIndex(chartTimes, profile.startTime)
    int endScaleIndex = nearestChartTimeIndex(chartTimes, profile.endTime)
    int sessionCloseTime = sessionOccurrenceClose(sourceName, profile, twentyFourSeven, developing)
    int levelEndTime = sessionLevelEndpoint(sourceName, sessionCloseTime, syminfo.type == "futures")
    int sessionTradingDayKey = tradingDayKey(sessionCloseTime)

    renderOuterSessionFrame(profile, sourceName, levelEndTime)
    renderRangeLabels(profile, sourceName, displayNameOverride, pairedNyHeadings, chartTimes, startScaleIndex, endScaleIndex, twentyFourSeven)
    renderProfileBox(profile, sourceName)

    if renderBudgetedHistogram
        renderHistogram(profile, valueAreaLowRow, valueAreaHighRow, histogramLayersPerProfile, chartTimes, startScaleIndex, endScaleIndex)

    array<float> strengths = computeRowStrengths(profile)
    collectOutlierPeaks(profile, strengths, sourceName, displayNameOverride, levelEndTime, sessionTradingDayKey, historical)
    array<RankedOutlierLevel> rankedOutlierLevels = rankPendingOutlierLevels(mergeOverlaps)
    array<bool> selectedOutlierRows = selectedOutlierRowMask(profile, strengths, rankedOutlierLevels)
    renderDeltaPolylines(profile, sourceName, strengths, selectedOutlierRows, chartTimes, startScaleIndex, endScaleIndex)
    renderProfileLevels(profile, sourceName, displayNameOverride, levelEndTime, pocPrice, valueAreaLowPrice, valueAreaHighPrice, twentyFourSeven)
    renderLowVolumeStructures(profile, sourceName, displayNameOverride, levelEndTime, sessionTradingDayKey, historical, false)
    renderRankedOutlierLevels(rankedOutlierLevels, false)

renderProfileSelection(ProfileSelection selection, string sourceName, ProfileSelection comparisonSelection, bool twentyFourSeven, array<int> chartTimes, bool currentPass, bool renderBudgetedHistograms, int histogramLayersPerProfile) =>
    int selectedCount = array.size(selection.profiles)
    if selectedCount > 0
        for selectedIndex = 0 to selectedCount - 1
            bool currentProfile = selectedIndex == selection.currentIndex
            if currentProfile == currentPass
                DeltaProfile profile = array.get(selection.profiles, selectedIndex)
                [shouldRender, displayNameOverride, pairedNyHeadings] = profileRenderDecision(profile, sourceName, comparisonSelection)
                if shouldRender
                    bool developing = currentProfile and selection.currentDeveloping
                    renderSelectedProfile(profile, sourceName, displayNameOverride, pairedNyHeadings, not currentProfile, developing, twentyFourSeven, chartTimes, renderBudgetedHistograms, histogramLayersPerProfile)

// ═══════════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE
// ═══════════════════════════════════════════════════════════════════════════════
addColorRow(array<ColorRow> rows, string name, color swatchColor, string widthText) =>
    array.push(rows, ColorRow.new(name, swatchColor, widthText))

writeColorRow(table referenceTable, int row, ColorRow entry) =>
    string rgbText = str.format("R:{0} G:{1} B:{2}", int(color.r(entry.swatchColor)), int(color.g(entry.swatchColor)), int(color.b(entry.swatchColor)))
    string transparencyText = str.tostring(int(color.t(entry.swatchColor)))
    table.cell(referenceTable, 0, row, entry.name, text_size=size.small, text_color=color.rgb(0, 0, 0))
    table.cell(referenceTable, 1, row, rgbText, text_size=size.small, text_color=color.rgb(0, 0, 0))
    table.cell(referenceTable, 2, row, transparencyText, text_size=size.small, text_color=color.rgb(0, 0, 0))
    table.cell(referenceTable, 3, row, entry.widthText, text_size=size.small, text_color=color.rgb(0, 0, 0))

