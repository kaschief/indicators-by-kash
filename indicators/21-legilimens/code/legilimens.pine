ivbProfilePosition = input.string(PROFILE_POSITION_RIGHT_RIGHT, INPUT_LABEL_POSITION, options=[PROFILE_POSITION_LEFT_LEFT, PROFILE_POSITION_LEFT_RIGHT, PROFILE_POSITION_RIGHT_LEFT, PROFILE_POSITION_RIGHT_RIGHT], inline="ivb_position", group=GROUP_IVB, active=ivbSelected)
