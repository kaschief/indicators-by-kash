var legilimensOrchestration.AnchorState rthAnchor = legilimensOrchestration.newAnchorState()
var legilimensOrchestration.AnchorState nyAfternoonAnchor = legilimensOrchestration.newAnchorState()
var legilimensOrchestration.AnchorState allDayToAfternoonAnchor = legilimensOrchestration.newAnchorState()
var legilimensOrchestration.AnchorState globexAnchor = legilimensOrchestration.newAnchorState()
