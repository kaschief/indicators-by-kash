// ═══════════════════════════════════════════════════════════════════════════════
// TYPES
// ═══════════════════════════════════════════════════════════════════════════════
type DeltaProfile
    int startTime
    int endTime
    float priceLow
    float priceHigh
    float rangeLow
    float rangeHigh
    int rowCount
    array<float> rowVolumes
    array<float> rowDeltas
    float maxRowVolume
    float maxAbsRowDelta
    bool isValid

type FinalizedMitigationProfile
    DeltaProfile profile
    string sourceName

type MitigatedProfileKey
    string sourceName
    int startTime

type RollingSampleStore
    int headIndex
    array<int> startKeys
    array<int> endKeys
    array<int> startTimes
    array<int> endTimes
    array<float> highs
    array<float> lows
    array<float> volumes
    array<float> deltas
    array<int> selectedIndices

type ProfileSelection
    array<DeltaProfile> profiles
    int currentIndex
    bool currentDeveloping

type PendingOutlierLevel
    float price
    float zoneLow
    float zoneHigh
    float delta
    float strength
    bool buySide
    int profileStartTime
    int lineStartTime
    int rightTime
    int markerTime
    string sourceName
    string displayNameOverride
    int tradingDayKey
    bool historical
    int firstRow
    int lastRow

type RankedOutlierLevel
    float price
    float zoneLow
    float zoneHigh
    bool buySide
    int profileStartTime
    int lineStartTime
    int rightTime
    int markerTime
    string sourceName
    string displayNameOverride
    int tradingDayKey
    bool historical
    int firstRow
    int lastRow
    int strengthRank

type PendingMitigatedZone
    float price
    float zoneLow
    float zoneHigh
    int profileStartTime
    int leftTime
    int eligibilityTime
    color zoneColor
    bool hasLine
    color lineColor
    int lineWidth
    string lineStyle
    int lineRank
    string sourceName
    int tradingDayKey
    bool historical
    int direction
    string markerLabel
    color markerColor
    int markerSize

type MitigatedZoneState
    string sourceName
    int profileStartTime
    int eligibilityTime
    float price
    int mitigatedTime
    bool available

type LowVolumeCandidate
    float price
    float zoneLow
    float zoneHigh
    float strength
    bool isLvn

type PendingRightLabel
    float price
    int markerTime
    string labelText
