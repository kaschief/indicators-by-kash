export newRenderState() =>
    RenderState.new(array.new<box>(), array.new<line>(), array.new<polyline>(), array.new<label>(), array.new<PendingOutlierLevel>(), array.new<PendingMitigatedZone>(), array.new<PendingRightLabel>(), array.new<PendingRightLine>(), array.new<MitigatedZoneState>(), array.new<ZoneTrackingProfileKey>(), array.new<int>(), -1, array.new<FocusProfile>(), array.new<ProfileAnalysis>(), na)

sourceSpec(array<SourceSpec> sources, string sourceName) =>
    SourceSpec found = na
    int count = array.size(sources)
    if count > 0
        for sourceIndex = 0 to count - 1
            SourceSpec candidate = array.get(sources, sourceIndex)
            if na(found) and candidate.key == sourceName
                found := candidate
    found

developingControlled(SourceSpec source) =>
    source.key == SOURCE_NY_EARLY or source.key == SOURCE_EXTENDED_NY_EARLY or source.key == SOURCE_IVB or source.key == SOURCE_ASIA_PREMARKET or source.key == SOURCE_FOMC or source.key == SOURCE_OVERNIGHT_NINE or source.key == SOURCE_NY_AFTERNOON or source.key == SOURCE_ALL_DAY_TO_AFTERNOON or source.key == SOURCE_RTH or source.key == SOURCE_GLOBEX or source.key == SOURCE_MIDNIGHT

export developingProfileVisible(SourceSpec source, PresentationConfig config) =>
    not developingControlled(source) or source.developingContentVisible or config.showDevelopingShell

unmitigatedEligible(string sourceName) =>
    sourceName == SOURCE_FIXED or sourceName == SOURCE_ROLLING or sourceName == SOURCE_ASIA_PREMARKET or sourceName == SOURCE_GLOBEX or sourceName == SOURCE_MIDNIGHT or sourceName == SOURCE_WEEKLY or sourceName == SOURCE_MONTHLY

sourceSelected(array<SourceSpec> sources, string sourceName) =>
    SourceSpec source = sourceSpec(sources, sourceName)
    not na(source) and source.selected

mitigationEnabled(array<SourceSpec> sources, string sourceName, PresentationConfig config) =>
    config.interactions.extendUnmitigated and unmitigatedEligible(sourceName) and sourceSelected(sources, sourceName)

toLineStyle(string styleName) =>
    styleName == STYLE_DASHED ? line.style_dashed : styleName == STYLE_DOTTED ? line.style_dotted : line.style_solid

toLabelSize(string sizeName) =>
    sizeName == LABEL_SIZE_TINY ? size.tiny : size.small

labelPointSize(string sizeName) =>
    sizeName == LABEL_SIZE_TINY ? 7.0 : 10.0

quarterDurationValue(float duration) =>
    duration > 0 ? math.max(0.25, math.round(duration * 4.0) / 4.0) : 0.0

formatQuarterDuration(float duration) =>
    str.tostring(quarterDurationValue(duration), "#.##")

fixedRangeTradingDayDuration(int firstTime, int secondTime) =>
    int shiftedStartTime = math.min(firstTime, secondTime) + GLOBEX_REOPEN_SHIFT_MS
    int shiftedEndTime = math.max(firstTime, secondTime) + GLOBEX_REOPEN_SHIFT_MS
    int cursorDate = timestamp(NY_TIMEZONE, year(shiftedStartTime, NY_TIMEZONE), month(shiftedStartTime, NY_TIMEZONE), dayofmonth(shiftedStartTime, NY_TIMEZONE), 0, 0)
    float tradingDays = 0.0
    while cursorDate < shiftedEndTime
        int nextDate = timestamp(NY_TIMEZONE, year(cursorDate, NY_TIMEZONE), month(cursorDate, NY_TIMEZONE), dayofmonth(cursorDate, NY_TIMEZONE) + 1, 0, 0)
        int weekday = dayofweek(cursorDate, NY_TIMEZONE)
        if weekday >= dayofweek.monday and weekday <= dayofweek.friday
            int overlapStart = math.max(shiftedStartTime, cursorDate)
            int overlapEnd = math.min(shiftedEndTime, nextDate)
            if overlapEnd > overlapStart
                tradingDays += float(overlapEnd - overlapStart) / float(nextDate - cursorDate)
        cursorDate := nextDate
    tradingDays

export fixedRangeDisplayName(int firstTime, int secondTime, bool twentyFourSeven) =>
    int durationMs = math.abs(secondTime - firstTime)
    float durationMinutes = float(durationMs) / MS_PER_MINUTE
    float durationHours = float(durationMs) / MS_PER_HOUR
    float durationDays = durationHours / 24.0
    float displayedDays = twentyFourSeven ? durationDays : fixedRangeTradingDayDuration(firstTime, secondTime)
    string durationText = quarterDurationValue(durationHours) >= 24.0 ? formatQuarterDuration(displayedDays) + "-Day" : durationHours >= 1.0 or quarterDurationValue(durationMinutes) >= 60.0 ? formatQuarterDuration(durationHours) + "-Hour" : formatQuarterDuration(durationMinutes) + "-Minute"
    "🎯 " + durationText + " Fixed Range"

visibleDeltaTierSideCount(DeltaSettings delta) =>
    delta.showTiers and delta.visibleTierSides != OPTION_OFF ? delta.visibleTierSides == OPTION_ALL ? 2 : 1 : 0

maximumCoreObjectCostsPerProfile(DeltaSettings delta, LevelSettings levels) =>
    int deltaTierSides = visibleDeltaTierSideCount(delta)
    int lvnTierCount = delta.showLvnTiers ? delta.visibleLvnTierCount : 0
    int deltaTierCount = deltaTierSides * delta.visibleTierCount
    int highestDeltaBoxCount = delta.showHighestDeltaLevels ? 2 : 0
    int referenceLineCount = (levels.showValueArea ? 2 : 0) + (levels.showPoc ? 1 : 0) + (levels.showMidpoint ? 1 : 0)
    int rightLineCount = lvnTierCount + deltaTierSides * math.min(2, delta.visibleTierCount)
    int pocLabelCount = levels.showPoc ? 1 : 0
    int midpointLabelCount = levels.showMidpoint ? 1 : 0
    int lvnMarkerLabelCount = lvnTierCount * 2
    int deltaMarkerLabelCount = deltaTierCount * 2
    int zoneBoxCount = lvnTierCount + deltaTierCount + highestDeltaBoxCount
    [referenceLineCount + rightLineCount, PROFILE_HEADING_LABEL_COUNT + pocLabelCount + midpointLabelCount + lvnMarkerLabelCount + deltaMarkerLabelCount, PROFILE_FRAME_BOX_COUNT + zoneBoxCount]

profileCapacityForObjectLimit(int objectLimit, int objectsPerProfile, int fallbackCapacity) =>
    objectsPerProfile > 0 ? int(math.floor(objectLimit / float(objectsPerProfile))) : fallbackCapacity

export maximumProfileCapacity(ObjectLimits limits, DeltaSettings delta, LevelSettings levels) =>
    [linesPerProfile, labelsPerProfile, boxesPerProfile] = maximumCoreObjectCostsPerProfile(delta, levels)
    int capacity = limits.boxes
    capacity := math.min(capacity, profileCapacityForObjectLimit(limits.lines, linesPerProfile, limits.boxes))
    capacity := math.min(capacity, profileCapacityForObjectLimit(limits.labels, labelsPerProfile, limits.boxes))
    capacity := math.min(capacity, profileCapacityForObjectLimit(limits.boxes, boxesPerProfile, limits.boxes))
    capacity

canDrawBox(RenderState state, PresentationConfig config) =>
    array.size(state.drawnBoxes) < config.limits.boxes

canDrawLine(RenderState state, PresentationConfig config) =>
    array.size(state.drawnLines) < config.limits.lines

canDrawLabel(RenderState state, PresentationConfig config) =>
    array.size(state.drawnLabels) < config.limits.labels

canDrawPolyline(RenderState state, PresentationConfig config) =>
    array.size(state.drawnPolylines) < config.limits.polylines

export beginFrame(RenderState state) =>
    if array.size(state.drawnBoxes) > 0
        for drawingIndex = 0 to array.size(state.drawnBoxes) - 1
            box.delete(array.get(state.drawnBoxes, drawingIndex))
        array.clear(state.drawnBoxes)
    if array.size(state.drawnLines) > 0
        for drawingIndex = 0 to array.size(state.drawnLines) - 1
            line.delete(array.get(state.drawnLines, drawingIndex))
        array.clear(state.drawnLines)
    if array.size(state.drawnPolylines) > 0
        for drawingIndex = 0 to array.size(state.drawnPolylines) - 1
            polyline.delete(array.get(state.drawnPolylines, drawingIndex))
        array.clear(state.drawnPolylines)
    if array.size(state.drawnLabels) > 0
        for drawingIndex = 0 to array.size(state.drawnLabels) - 1
            label.delete(array.get(state.drawnLabels, drawingIndex))
        array.clear(state.drawnLabels)
    array.clear(state.pendingOutlierLevels)
    array.clear(state.pendingMitigatedZones)
    array.clear(state.pendingRightLabels)
    array.clear(state.pendingRightLines)
    true

levelMarkerText(float price, string markerLabel, DeltaSettings delta) =>
    markerLabel + (delta.showPrice ? " · " + str.tostring(price, format.mintick) : "")

queueLevelMarker(RenderState state, float price, int markerTime, string markerGlyph, string markerLabel, color markerColor, int markerSize, PresentationConfig config) =>
    array.push(state.pendingRightLabels, PendingRightLabel.new(price, markerTime, markerGlyph, markerColor, markerSize, label.style_none))
    array.push(state.pendingRightLabels, PendingRightLabel.new(price, markerTime, levelMarkerText(price, markerLabel, config.delta), markerColor, DOT_LABEL_SIZE, label.style_label_left))

queueRightLine(RenderState state, float price, int leftTime, int rightTime, color lineColor, int lineWidth, string styleName, int rank, string sourceName, int sessionTradingDayKey, bool historical, int direction, BarContext context) =>
    bool historicalMergeGroup = historical or sessionTradingDayKey != legilimensOrchestration.tradingDayKey(context.barTime)
    array.push(state.pendingRightLines, PendingRightLine.new(price, leftTime, rightTime, lineColor, lineWidth, styleName, rank, sourceName, sessionTradingDayKey, historicalMergeGroup, direction))

renderZoneFill(RenderState state, int leftTime, int rightTime, float zoneLow, float zoneHigh, color zoneFillColor, int zoneBorderWidth, color highlightColor, PresentationConfig config) =>
    if canDrawBox(state, config)
        color borderColor = zoneBorderWidth > 0 ? highlightColor : color.new(zoneFillColor, 100)
        array.push(state.drawnBoxes, box.new(left=leftTime, top=zoneHigh, right=rightTime, bottom=zoneLow, xloc=xloc.bar_time, border_color=borderColor, border_width=zoneBorderWidth, bgcolor=zoneFillColor))

mitigatedZoneStateIndex(RenderState state, string sourceName, int profileStartTime, int eligibilityTime, float price) =>
    int foundIndex = -1
    int count = array.size(state.mitigatedZoneStates)
    if count > 0
        for stateIndex = 0 to count - 1
            MitigatedZoneState zoneState = array.get(state.mitigatedZoneStates, stateIndex)
            if zoneState.sourceName == sourceName and zoneState.profileStartTime == profileStartTime and zoneState.eligibilityTime == eligibilityTime and zoneState.price == price
                foundIndex := stateIndex
                break
    foundIndex

removeMitigatedProfile(RenderState state, string sourceName, int profileStartTime) =>
    int stateIndex = array.size(state.mitigatedZoneStates) - 1
    while stateIndex >= 0
        MitigatedZoneState zoneState = array.get(state.mitigatedZoneStates, stateIndex)
        if zoneState.sourceName == sourceName and zoneState.profileStartTime == profileStartTime
            array.remove(state.mitigatedZoneStates, stateIndex)
        stateIndex -= 1

export clearSourceInteractions(RenderState state, string sourceName) =>
    int stateIndex = array.size(state.mitigatedZoneStates) - 1
    while stateIndex >= 0
        if array.get(state.mitigatedZoneStates, stateIndex).sourceName == sourceName
            array.remove(state.mitigatedZoneStates, stateIndex)
        stateIndex -= 1
    int profileIndex = array.size(state.mitigatedProfiles) - 1
    while profileIndex >= 0
        if array.get(state.mitigatedProfiles, profileIndex).sourceName == sourceName
            array.remove(state.mitigatedProfiles, profileIndex)
        profileIndex -= 1
    true

registerZoneTrackingProfile(array<ZoneTrackingProfileKey> profileKeys, string sourceName, int profileStartTime, int retention) =>
    bool registered = false
    int count = array.size(profileKeys)
    if count > 0
        for profileIndex = 0 to count - 1
            ZoneTrackingProfileKey profileKey = array.get(profileKeys, profileIndex)
            if profileKey.sourceName == sourceName and profileKey.startTime == profileStartTime
                registered := true
                break
    int expiredProfileStartTime = na
    if not registered
        array.push(profileKeys, ZoneTrackingProfileKey.new(sourceName, profileStartTime))
        int sourceCount = 0
        for profileIndex = 0 to array.size(profileKeys) - 1
            if array.get(profileKeys, profileIndex).sourceName == sourceName
                sourceCount += 1
        if sourceCount > retention
            int oldestIndex = -1
            int oldestStartTime = na
            for profileIndex = 0 to array.size(profileKeys) - 1
                ZoneTrackingProfileKey profileKey = array.get(profileKeys, profileIndex)
                if profileKey.sourceName == sourceName and (oldestIndex < 0 or profileKey.startTime < oldestStartTime)
                    oldestIndex := profileIndex
                    oldestStartTime := profileKey.startTime
            if oldestIndex >= 0
                expiredProfileStartTime := oldestStartTime
                array.remove(profileKeys, oldestIndex)
    expiredProfileStartTime

registerMitigatedZone(RenderState state, string sourceName, int profileStartTime, int eligibilityTime, float price, PresentationConfig config) =>
    int expiredProfileStartTime = registerZoneTrackingProfile(state.mitigatedProfiles, sourceName, profileStartTime, config.interactions.retainedProfiles)
    if not na(expiredProfileStartTime)
        removeMitigatedProfile(state, sourceName, expiredProfileStartTime)
    if mitigatedZoneStateIndex(state, sourceName, profileStartTime, eligibilityTime, price) < 0
        array.push(state.mitigatedZoneStates, MitigatedZoneState.new(sourceName, profileStartTime, eligibilityTime, price, na, true))

flushPendingRightLines(RenderState state, PresentationConfig config, BarContext context) =>
    int pendingCount = array.size(state.pendingRightLines)
    if pendingCount > 0
        array<PendingRightLine> clusters = array.new<PendingRightLine>()
        for pendingIndex = 0 to pendingCount - 1
            PendingRightLine pending = array.get(state.pendingRightLines, pendingIndex)
            float tolerance = math.max(context.tickSize, math.abs(pending.price) * config.levels.mergeDistancePercent / 100.0)
            int foundIndex = -1
            float minimumDistance = tolerance + context.tickSize
            int clusterCount = array.size(clusters)
            if config.levels.mergeOverlaps and clusterCount > 0
                for clusterIndex = 0 to clusterCount - 1
                    PendingRightLine cluster = array.get(clusters, clusterIndex)
                    float distance = math.abs(cluster.price - pending.price)
                    bool sameSource = cluster.sourceName == pending.sourceName
                    bool sameOccurrence = cluster.tradingDayKey == pending.tradingDayKey and cluster.historical == pending.historical
                    bool sameEndpoint = cluster.rightTime == pending.rightTime
                    bool compatibleDirection = cluster.direction == 0 or pending.direction == 0 or cluster.direction == pending.direction
                    if sameSource and sameOccurrence and sameEndpoint and compatibleDirection and distance <= tolerance and distance < minimumDistance
                        minimumDistance := distance
                        foundIndex := clusterIndex
            if foundIndex >= 0
                PendingRightLine cluster = array.get(clusters, foundIndex)
                cluster.leftTime := math.min(cluster.leftTime, pending.leftTime)
                cluster.rightTime := math.max(cluster.rightTime, pending.rightTime)
                if cluster.direction == 0 and pending.direction != 0
                    cluster.direction := pending.direction
                if pending.rank > cluster.rank
                    cluster.price := pending.price
                    cluster.lineColor := pending.lineColor
                    cluster.lineWidth := pending.lineWidth
                    cluster.styleName := pending.styleName
                    cluster.rank := pending.rank
            else
                array.push(clusters, PendingRightLine.new(pending.price, pending.leftTime, pending.rightTime, pending.lineColor, pending.lineWidth, pending.styleName, pending.rank, pending.sourceName, pending.tradingDayKey, pending.historical, pending.direction))
        for clusterIndex = 0 to array.size(clusters) - 1
            PendingRightLine cluster = array.get(clusters, clusterIndex)
            if canDrawLine(state, config)
                array.push(state.drawnLines, line.new(cluster.leftTime, cluster.price, cluster.rightTime, cluster.price, xloc=xloc.bar_time, color=cluster.lineColor, style=toLineStyle(cluster.styleName), width=cluster.lineWidth))
        array.clear(state.pendingRightLines)

flushPendingRightLabels(RenderState state, PresentationConfig config) =>
    int pendingCount = array.size(state.pendingRightLabels)
    if pendingCount > 0
        for pendingIndex = 0 to pendingCount - 1
            PendingRightLabel pending = array.get(state.pendingRightLabels, pendingIndex)
            string textAlignment = pending.labelStyle == label.style_none ? text.align_center : text.align_left
            if canDrawLabel(state, config)
                array.push(state.drawnLabels, label.new(pending.markerTime, pending.price, pending.labelText, xloc=xloc.bar_time, yloc=yloc.price, style=pending.labelStyle, textcolor=pending.textColor, size=pending.textSize, color=color.new(color.white, 100), textalign=textAlignment))
        array.clear(state.pendingRightLabels)

usesGlobexPalette(string sourceName) =>
    sourceName == SOURCE_GLOBEX or sourceName == SOURCE_MIDNIGHT

usesRthPalette(string sourceName) =>
    sourceName == SOURCE_RTH or sourceName == SOURCE_NY_AFTERNOON or sourceName == SOURCE_ALL_DAY_TO_AFTERNOON

export profileOuterColor(string sourceName) =>
    sourceName == SOURCE_NY_EARLY ? color.new(color.rgb(128, 222, 234), 94) : sourceName == SOURCE_EXTENDED_NY_EARLY ? color.new(color.rgb(76, 65, 245), 94) : sourceName == SOURCE_IVB ? color.new(color.rgb(245, 65, 240), 95) : sourceName == SOURCE_ASIA_PREMARKET ? color.new(color.rgb(165, 214, 167), 70) : usesRthPalette(sourceName) ? color.new(color.rgb(41, 98, 255), 90) : usesGlobexPalette(sourceName) ? color.new(color.rgb(233, 30, 99), 90) : sourceName == SOURCE_WEEKLY ? color.new(color.rgb(156, 39, 176), 90) : sourceName == SOURCE_MONTHLY ? color.new(color.rgb(223, 107, 12), 85) : sourceName == SOURCE_ROLLING ? color.new(color.rgb(248, 187, 208), 75) : color.new(color.rgb(187, 217, 251), 70)

profileInnerColor(string sourceName) =>
    sourceName == SOURCE_NY_EARLY ? color.new(color.rgb(128, 222, 234), 50) : sourceName == SOURCE_EXTENDED_NY_EARLY ? color.new(color.rgb(76, 65, 245), 88) : sourceName == SOURCE_IVB ? color.new(color.rgb(249, 121, 246), 55) : sourceName == SOURCE_ASIA_PREMARKET ? color.new(color.rgb(56, 142, 60), 82) : usesRthPalette(sourceName) ? color.new(color.rgb(144, 191, 249), 30) : usesGlobexPalette(sourceName) ? color.new(color.rgb(248, 187, 208), 30) : sourceName == SOURCE_WEEKLY ? color.new(color.rgb(156, 39, 176), 88) : sourceName == SOURCE_MONTHLY ? color.new(color.rgb(255, 152, 0), 20) : sourceName == SOURCE_ROLLING ? color.new(color.rgb(248, 187, 208), 30) : color.new(color.rgb(187, 217, 251), 30)

export profileRangeLabelColor(string sourceName) =>
    sourceName == SOURCE_NY_EARLY ? color.new(color.rgb(0, 188, 212), 9) : sourceName == SOURCE_EXTENDED_NY_EARLY ? color.new(color.rgb(76, 65, 245), 9) : sourceName == SOURCE_IVB ? color.new(color.rgb(245, 65, 240), 20) : sourceName == SOURCE_ASIA_PREMARKET ? color.new(color.rgb(56, 142, 60), 5) : usesRthPalette(sourceName) ? color.new(color.rgb(48, 79, 254), 30) : usesGlobexPalette(sourceName) ? color.new(color.rgb(211, 47, 47), 30) : sourceName == SOURCE_WEEKLY ? color.new(color.rgb(123, 31, 162), 30) : sourceName == SOURCE_MONTHLY ? color.new(color.rgb(239, 108, 0), 30) : sourceName == SOURCE_ROLLING ? color.new(color.rgb(173, 20, 87), 30) : color.new(color.rgb(41, 98, 255), 30)

profileRangeLabelSize(string sourceName) =>
    sourceName == SOURCE_NY_EARLY or sourceName == SOURCE_EXTENDED_NY_EARLY or sourceName == SOURCE_IVB or sourceName == SOURCE_ASIA_PREMARKET or usesRthPalette(sourceName) ? LABEL_SIZE_TINY : LABEL_SIZE_SMALL

export profileRangeLabelFontSize(string sourceName) =>
    toLabelSize(profileRangeLabelSize(sourceName))

profileDeltaPlusColor(SourceSpec source) =>
    source.alternateStyles ? color.new(color.rgb(76, 175, 80), 15) : color.new(#43c59e, 62)

profileDeltaMinusColor(SourceSpec source) =>
    source.alternateStyles ? color.new(color.rgb(242, 54, 69), 15) : color.new(#e86b78, 62)

profileDeltaPlusPlusColor(SourceSpec source) =>
    source.alternateStyles ? color.rgb(56, 142, 60) : color.new(#0f9e6e, 30)

profileDeltaMinusMinusColor(SourceSpec source) =>
    source.alternateStyles ? color.rgb(178, 40, 51) : color.new(#d61f4a, 30)

profileValueAreaLevelColor(string sourceName) =>
    sourceName == SOURCE_NY_EARLY ? color.new(color.rgb(38, 198, 218), 55) : sourceName == SOURCE_EXTENDED_NY_EARLY ? color.new(color.rgb(76, 65, 245), 70) : sourceName == SOURCE_IVB ? color.new(color.rgb(233, 30, 99), 45) : sourceName == SOURCE_ASIA_PREMARKET ? color.new(color.rgb(255, 183, 77), 60) : usesRthPalette(sourceName) ? color.new(color.rgb(144, 191, 249), 55) : usesGlobexPalette(sourceName) ? color.new(color.rgb(255, 235, 59), 20) : sourceName == SOURCE_WEEKLY ? color.new(color.rgb(186, 104, 200), 55) : sourceName == SOURCE_MONTHLY ? color.new(color.rgb(255, 152, 0), 55) : color.new(color.rgb(255, 235, 59), 20)

profileTextBackgroundColor(SourceSpec source) =>
    source.alternateStyles ? color.new(color.rgb(249, 248, 248), 25) : color.new(color.rgb(249, 248, 248), 20)

deltaTierAppearance(bool buySide, int tier, SourceSpec source) =>
    int tierIndex = math.max(0, math.min(4, 5 - tier))
    bool dominant = tierIndex == 0
    bool strong = tierIndex == 1
    bool hasLine = dominant or strong
    int lineWidth = dominant ? DELTA_TIER_5_LINE_WIDTH : strong ? DELTA_TIER_4_LINE_WIDTH : 1
    string lineStyle = hasLine ? STYLE_DASHED : STYLE_SOLID
    color lineColor = color(na)
    color textColor = color(na)
    color zoneColor = color(na)
    if source.alternateStyles
        color baseColor = buySide ? color.rgb(56, 142, 60) : color.rgb(178, 40, 51)
        lineColor := hasLine ? color.new(baseColor, 30) : color(na)
        textColor := baseColor
        zoneColor := color.new(baseColor, 92)
    else if buySide
        lineColor := dominant ? color.new(color.rgb(0, 255, 0), 10) : strong ? color.new(color.rgb(56, 142, 60), 30) : color(na)
        textColor := dominant ? color.rgb(77, 243, 8) : strong ? color.new(color.rgb(77, 243, 8), 10) : tierIndex == 3 ? color.new(color.rgb(114, 243, 114), 30) : tierIndex == 4 ? color.new(color.rgb(163, 218, 165), 20) : color.new(color.rgb(163, 218, 165), 10)
        zoneColor := color.new(color.rgb(114, 243, 114), dominant ? 85 : strong ? 88 : 90)
    else
        lineColor := dominant ? color.new(color.rgb(245, 65, 81), 10) : strong ? color.new(color.rgb(178, 40, 51), 30) : color(na)
        textColor := dominant ? color.rgb(249, 121, 246) : strong ? color.new(color.rgb(249, 121, 246), 10) : tierIndex == 4 ? color.new(color.rgb(128, 25, 34), 92) : color.new(color.rgb(249, 121, 246), 30)
        zoneColor := color.new(color.rgb(249, 121, 246), dominant ? 82 : strong ? 88 : 90)
    DeltaTierAppearance.new(hasLine, lineColor, lineWidth, lineStyle, textColor, zoneColor)

tierMarkerSize(int tier) =>
    tier == 5 ? 12 : tier == 4 ? 9 : tier == 3 ? 7 : tier == 2 ? 6 : 5

deltaTierSideVisible(bool buySide, PresentationConfig config) =>
    config.delta.visibleTierSides != OPTION_OFF and (config.delta.visibleTierSides == OPTION_ALL or (buySide and config.delta.visibleTierSides == DELTA_TIER_VISIBILITY_BUY) or (not buySide and config.delta.visibleTierSides == DELTA_TIER_VISIBILITY_SELL))

deltaTierFibLocationGrade(bool buySide, float tierPrice, float rangeLow, float rangeHigh) =>
    int grade = FIB_LOCATION_UNKNOWN
    float profileRange = rangeHigh - rangeLow
    if not na(tierPrice) and not na(rangeLow) and not na(rangeHigh) and profileRange > 0
        float fibPosition = (tierPrice - rangeLow) / profileRange
        bool veryStrong = buySide ? fibPosition < FIB_LOCATION_BUY_PREFERRED_LOW : fibPosition > FIB_LOCATION_SELL_PREFERRED_HIGH
        bool preferred = buySide ? fibPosition >= FIB_LOCATION_BUY_PREFERRED_LOW and fibPosition <= FIB_LOCATION_BUY_PREFERRED_HIGH : fibPosition >= FIB_LOCATION_SELL_PREFERRED_LOW and fibPosition <= FIB_LOCATION_SELL_PREFERRED_HIGH
        bool qualified = buySide ? fibPosition <= FIB_LOCATION_MIDPOINT : fibPosition >= FIB_LOCATION_MIDPOINT
        grade := veryStrong ? FIB_LOCATION_VERY_STRONG : preferred ? FIB_LOCATION_PREFERRED : qualified ? FIB_LOCATION_QUALIFIED : FIB_LOCATION_CONTRADICTORY
    grade

fibLocationMarkerGlyph(int grade) =>
    grade == FIB_LOCATION_VERY_STRONG ? FIB_LOCATION_VERY_STRONG_MARKER_GLYPH : grade == FIB_LOCATION_PREFERRED ? FIB_LOCATION_PREFERRED_MARKER_GLYPH : LEVEL_MARKER_GLYPH

fibLocationBorderWidth(int grade, bool buySide, float price, float midpointPrice) =>
    bool borderedQualified = grade == FIB_LOCATION_QUALIFIED and (buySide ? price < midpointPrice : price > midpointPrice)
    grade == FIB_LOCATION_VERY_STRONG ? 2 : grade == FIB_LOCATION_PREFERRED or borderedQualified ? 1 : 0

contrastChannel(float channel, float ratio, bool darken) =>
    darken ? channel * (1.0 - ratio) : channel + (255.0 - channel) * ratio

fibQualificationColor(color sourceColor, bool qualified) =>
    float ratio = (qualified ? 15 : 5) / 100.0
    bool darken = qualified
    color.rgb(int(math.round(contrastChannel(color.r(sourceColor), ratio, darken))), int(math.round(contrastChannel(color.g(sourceColor), ratio, darken))), int(math.round(contrastChannel(color.b(sourceColor), ratio, darken))), color.t(sourceColor))

barSpanMs() =>
    int spanMs = nz(timeframe.in_seconds(timeframe.period)) * 1000
    if spanMs <= 0
        for lookback = 0 to OFFSET_SPAN_LOOKBACK - 1
            int gap = nz(time[lookback] - time[lookback + 1])
            if gap > 0 and (spanMs <= 0 or gap < spanMs)
                spanMs := gap
    math.max(1, spanMs)

recentChartTimes(int currentBarIndex) =>
    array<int> chartTimes = array.new<int>()
    int offset = math.min(currentBarIndex, PROFILE_TIME_SCALE_MAX_LOOKBACK)
    while offset >= 0
        array.push(chartTimes, time[offset])
        offset -= 1
    chartTimes

nearestChartTimeIndex(array<int> chartTimes, int targetTime) =>
    int count = array.size(chartTimes)
    int result = -1
    if count > 0 and targetTime >= array.get(chartTimes, 0) and targetTime <= array.get(chartTimes, count - 1)
        int lowIndex = 0
        int highIndex = count - 1
        while lowIndex <= highIndex
            int middleIndex = int(math.floor((lowIndex + highIndex) * 0.5))
            int middleTime = array.get(chartTimes, middleIndex)
            if middleTime < targetTime
                result := middleIndex
                lowIndex := middleIndex + 1
            else if middleTime > targetTime
                highIndex := middleIndex - 1
            else
                result := middleIndex
                lowIndex := highIndex + 1
        if result < 0
            result := 0
        if result < count - 1 and math.abs(array.get(chartTimes, result + 1) - targetTime) < math.abs(array.get(chartTimes, result) - targetTime)
            result += 1
    result

chartTimeAtOffset(array<int> chartTimes, int baselineIndex, int stepOffset) =>
    int count = array.size(chartTimes)
    int outerIndex = baselineIndex + stepOffset
    int outerTime = na
    if outerIndex >= 0 and outerIndex < count
        outerTime := array.get(chartTimes, outerIndex)
    else
        int overflowSteps = outerIndex < 0 ? outerIndex : outerIndex - (count - 1)
        int edgeTime = outerIndex < 0 ? array.get(chartTimes, 0) : array.get(chartTimes, count - 1)
        outerTime := edgeTime + overflowSteps * barSpanMs()
    outerTime

profileBaselineTime(legilimensOrchestration.Profile profile, array<int> chartTimes, int baselineIndex, bool attachRight) =>
    int count = array.size(chartTimes)
    baselineIndex >= 0 and baselineIndex < count ? array.get(chartTimes, baselineIndex) : attachRight ? profile.endTime : profile.startTime

profileOuterTime(legilimensOrchestration.Profile profile, array<int> chartTimes, int baselineIndex, int rangeSteps, float magnitudeRatio, int widthPercent, bool faceLeft, bool attachRight) =>
    float ratio = math.max(0.0, math.min(1.0, magnitudeRatio))
    int baselineTime = profileBaselineTime(profile, chartTimes, baselineIndex, attachRight)
    int outerTime = baselineTime
    if ratio > 0
        if array.size(chartTimes) > 1 and baselineIndex >= 0
            int maximumSteps = math.max(1, int(math.round(rangeSteps * widthPercent * 0.01)))
            outerTime := chartTimeAtOffset(chartTimes, baselineIndex, faceLeft ? -math.max(1, int(math.round(ratio * maximumSteps))) : math.max(1, int(math.round(ratio * maximumSteps))))
        else
            int widthMs = math.max(1, int(math.round(math.max(1, profile.endTime - profile.startTime) * widthPercent * 0.01 * ratio)))
            outerTime := baselineTime + (faceLeft ? -widthMs : widthMs)
    outerTime

deltaOuterTime(legilimensOrchestration.Profile profile, array<int> chartTimes, int startScaleIndex, int endScaleIndex, int baselineIndex, float magnitudeRatio, int widthBars, bool faceLeft, bool attachRight) =>
    int baselineTime = profileBaselineTime(profile, chartTimes, baselineIndex, attachRight)
    float ratio = math.max(0.0, math.min(1.0, magnitudeRatio))
    bool completeScale = startScaleIndex >= 0 and endScaleIndex >= 0
    int profileSteps = completeScale ? math.max(1, math.abs(endScaleIndex - startScaleIndex)) : widthBars
    int rowSteps = math.max(1, int(math.round(ratio * math.min(widthBars, profileSteps))))
    if array.size(chartTimes) > 1 and baselineIndex >= 0
        chartTimeAtOffset(chartTimes, baselineIndex, faceLeft ? -rowSteps : rowSteps)
    else
        int maximumWidth = math.min(math.max(1, profile.endTime - profile.startTime), barSpanMs() * widthBars)
        baselineTime + (faceLeft ? -math.max(1, int(math.round(maximumWidth * ratio))) : math.max(1, int(math.round(maximumWidth * ratio))))

mitigationWindowStartMinute(string windowMode) =>
    windowMode == WINDOW_LABEL_FROM_0500 ? ROLLING_CUTOFF_0500_MINUTE : windowMode == WINDOW_LABEL_FROM_0830 ? ROLLING_CUTOFF_0830_MINUTE : ROLLING_CUTOFF_0930_MINUTE

mitigationWindowAllowsSample(string windowMode, int sampleTime, int sampleEndTime, bool twentyFourSeven) =>
    int startMinute = mitigationWindowStartMinute(windowMode)
    windowMode == MITIGATION_WINDOW_ANYTIME or ((twentyFourSeven or legilimensOrchestration.isNyWeekday(sampleTime)) and legilimensOrchestration.barFitsNyMinuteWindow(sampleTime, sampleEndTime, startMinute, ROLLING_CUTOFF_1600_MINUTE))

mitigationWindowBounds(string windowMode, int startTime, int endTime, bool twentyFourSeven) =>
    int activeStart = na
    int activeEnd = na
    if startTime < endTime
        if windowMode == MITIGATION_WINDOW_ANYTIME
            activeStart := startTime
            activeEnd := endTime
        else
            int cursorTime = startTime
            while cursorTime < endTime
                int sessionStart = legilimensOrchestration.nyMinuteBoundary(cursorTime, mitigationWindowStartMinute(windowMode))
                int sessionEnd = legilimensOrchestration.nyMinuteBoundary(cursorTime, ROLLING_CUTOFF_1600_MINUTE)
                int overlapStart = math.max(startTime, sessionStart)
                int overlapEnd = math.min(endTime, sessionEnd)
                if overlapStart < overlapEnd and (twentyFourSeven or legilimensOrchestration.isNyWeekday(cursorTime))
                    activeStart := na(activeStart) ? overlapStart : activeStart
                    activeEnd := overlapEnd
                cursorTime := timestamp(NY_TIMEZONE, year(cursorTime, NY_TIMEZONE), month(cursorTime, NY_TIMEZONE), dayofmonth(cursorTime, NY_TIMEZONE) + 1, 0, 0)
    array.from(activeStart, activeEnd)

mitigatedZoneEndTime(RenderState state, string sourceName, int profileStartTime, float price, int eligibilityTime, BarContext context) =>
    int zoneEndTime = eligibilityTime
    int stateIndex = mitigatedZoneStateIndex(state, sourceName, profileStartTime, eligibilityTime, price)
    if stateIndex >= 0
        MitigatedZoneState zoneState = array.get(state.mitigatedZoneStates, stateIndex)
        zoneEndTime := zoneState.available ? na(zoneState.mitigatedTime) ? math.max(eligibilityTime, context.barEndTime) : zoneState.mitigatedTime : eligibilityTime
    zoneEndTime

firstIntrabarTouchEnd(PriceSamples samples, int eligibilityTime, float price, string windowMode, bool twentyFourSeven) =>
    int touchEndTime = na
    int sampleCount = math.min(math.min(array.size(samples.startTimes), array.size(samples.endTimes)), math.min(array.size(samples.highs), array.size(samples.lows)))
    if sampleCount > 0
        for sampleIndex = 0 to sampleCount - 1
            int sampleTime = array.get(samples.startTimes, sampleIndex)
            int sampleEndTime = array.get(samples.endTimes, sampleIndex)
            float sampleHigh = array.get(samples.highs, sampleIndex)
            float sampleLow = array.get(samples.lows, sampleIndex)
            bool eligible = sampleTime >= eligibilityTime and sampleEndTime > eligibilityTime and mitigationWindowAllowsSample(windowMode, sampleTime, sampleEndTime, twentyFourSeven)
            if na(touchEndTime) and eligible and not na(sampleHigh) and not na(sampleLow) and sampleLow <= price and sampleHigh >= price
                touchEndTime := sampleEndTime
    touchEndTime

boundaryCoverageComplete(PriceSamples samples, int eligibilityTime, int barEndTime) =>
    int firstEligibleTime = na
    int lastEligibleEndTime = na
    int sampleCount = math.min(array.size(samples.startTimes), array.size(samples.endTimes))
    if sampleCount > 0
        for sampleIndex = 0 to sampleCount - 1
            int sampleTime = array.get(samples.startTimes, sampleIndex)
            int sampleEndTime = array.get(samples.endTimes, sampleIndex)
            if sampleTime >= eligibilityTime and sampleEndTime > eligibilityTime
                firstEligibleTime := na(firstEligibleTime) ? sampleTime : math.min(firstEligibleTime, sampleTime)
                lastEligibleEndTime := na(lastEligibleEndTime) ? sampleEndTime : math.max(lastEligibleEndTime, sampleEndTime)
    not na(firstEligibleTime) and firstEligibleTime <= eligibilityTime and lastEligibleEndTime >= barEndTime

intrabarBoundaryIsPrecise(string intrabarTimeframe, int boundaryTime) =>
    intrabarTimeframe == "1S" or boundaryTime % MS_PER_MINUTE == 0 and intrabarTimeframe == "1"

includeBoundaryRequest(string requestedTimeframe, int boundaryTime) =>
    boundaryTime % MS_PER_MINUTE == 0 and requestedTimeframe != "1S" ? "1" : "1S"

export requiredBoundaryTimeframe(RenderState state, string intrabarTimeframe, BarContext context, PresentationConfig config) =>
    string requestedTimeframe = ""
    int mitigatedCount = array.size(state.mitigatedZoneStates)
    if mitigatedCount > 0
        for stateIndex = 0 to mitigatedCount - 1
            MitigatedZoneState zoneState = array.get(state.mitigatedZoneStates, stateIndex)
            bool chartBarTouches = not na(context.barHigh) and not na(context.barLow) and context.barLow <= zoneState.price and context.barHigh >= zoneState.price
            if zoneState.available and na(zoneState.mitigatedTime) and chartBarTouches and context.barEndTime > zoneState.eligibilityTime
                array<int> activeBounds = mitigationWindowBounds(config.interactions.mitigationWindow, math.max(context.barTime, zoneState.eligibilityTime), context.barEndTime, context.twentyFourSeven)
                int activeStartTime = array.get(activeBounds, MITIGATION_WINDOW_START_INDEX)
                int activeEndTime = array.get(activeBounds, MITIGATION_WINDOW_END_INDEX)
                if not na(activeStartTime)
                    if activeStartTime > context.barTime and not intrabarBoundaryIsPrecise(intrabarTimeframe, activeStartTime)
                        requestedTimeframe := includeBoundaryRequest(requestedTimeframe, activeStartTime)
                    if activeEndTime < context.barEndTime and not intrabarBoundaryIsPrecise(intrabarTimeframe, activeEndTime)
                        requestedTimeframe := includeBoundaryRequest(requestedTimeframe, activeEndTime)
    requestedTimeframe

export updateInteractions(RenderState state, PriceSamples profileSamples, PriceSamples boundarySamples, string intrabarTimeframe, BarContext context, PresentationConfig config) =>
    int mitigatedCount = array.size(state.mitigatedZoneStates)
    if mitigatedCount > 0
        for stateIndex = 0 to mitigatedCount - 1
            MitigatedZoneState zoneState = array.get(state.mitigatedZoneStates, stateIndex)
            if zoneState.available and na(zoneState.mitigatedTime) and context.barEndTime > zoneState.eligibilityTime
                bool chartBarTouches = not na(context.barHigh) and not na(context.barLow) and context.barLow <= zoneState.price and context.barHigh >= zoneState.price
                if chartBarTouches
                    array<int> activeBounds = mitigationWindowBounds(config.interactions.mitigationWindow, math.max(context.barTime, zoneState.eligibilityTime), context.barEndTime, context.twentyFourSeven)
                    int activeStartTime = array.get(activeBounds, MITIGATION_WINDOW_START_INDEX)
                    int activeEndTime = array.get(activeBounds, MITIGATION_WINDOW_END_INDEX)
                    if not na(activeStartTime)
                        bool useProfileIntrabars = (activeStartTime == context.barTime or intrabarBoundaryIsPrecise(intrabarTimeframe, activeStartTime)) and (activeEndTime == context.barEndTime or intrabarBoundaryIsPrecise(intrabarTimeframe, activeEndTime))
                        int intrabarTouchEnd = useProfileIntrabars ? firstIntrabarTouchEnd(profileSamples, activeStartTime, zoneState.price, config.interactions.mitigationWindow, context.twentyFourSeven) : firstIntrabarTouchEnd(boundarySamples, activeStartTime, zoneState.price, config.interactions.mitigationWindow, context.twentyFourSeven)
                        bool wholeBarEligible = activeStartTime == context.barTime and activeEndTime == context.barEndTime and mitigationWindowAllowsSample(config.interactions.mitigationWindow, context.barTime, context.barEndTime, context.twentyFourSeven)
                        if not na(intrabarTouchEnd)
                            zoneState.mitigatedTime := intrabarTouchEnd
                        else if wholeBarEligible
                            zoneState.mitigatedTime := context.barEndTime
                        else if context.confirmed
                            bool coverageComplete = useProfileIntrabars ? boundaryCoverageComplete(profileSamples, activeStartTime, activeEndTime) : boundaryCoverageComplete(boundarySamples, activeStartTime, activeEndTime)
                            if not coverageComplete
                                zoneState.available := false
                        array.set(state.mitigatedZoneStates, stateIndex, zoneState)
    true

futuresExtensionEndpoint(int sessionCloseTime, int extensionMs) =>
    int endpoint = sessionCloseTime
    int remainingMs = extensionMs
    if remainingMs > 0
        int endpointDay = dayofweek(endpoint, NY_TIMEZONE)
        int endpointMinute = hour(endpoint, NY_TIMEZONE) * 60 + minute(endpoint, NY_TIMEZONE)
        bool fridayWeekend = endpointDay == dayofweek.friday and endpointMinute >= SUNDAY_REOPEN_START_HOUR * 60
        bool saturdayWeekend = endpointDay == dayofweek.saturday
        bool sundayWeekend = endpointDay == dayofweek.sunday and endpointMinute < SUNDAY_REOPEN_START_HOUR * 60
        if fridayWeekend or saturdayWeekend or sundayWeekend
            int daysUntilSunday = fridayWeekend ? 2 : saturdayWeekend ? 1 : 0
            endpoint := timestamp(NY_TIMEZONE, year(endpoint, NY_TIMEZONE), month(endpoint, NY_TIMEZONE), dayofmonth(endpoint, NY_TIMEZONE) + daysUntilSunday, SUNDAY_REOPEN_START_HOUR, 0)
        endpointDay := dayofweek(endpoint, NY_TIMEZONE)
        int daysUntilFriday = (dayofweek.friday - endpointDay + CALENDAR_DAYS_PER_WEEK) % CALENDAR_DAYS_PER_WEEK
        int weekendStart = timestamp(NY_TIMEZONE, year(endpoint, NY_TIMEZONE), month(endpoint, NY_TIMEZONE), dayofmonth(endpoint, NY_TIMEZONE) + daysUntilFriday, SUNDAY_REOPEN_START_HOUR, 0)
        int availableMs = weekendStart - endpoint
        if remainingMs < availableMs
            endpoint += remainingMs
        else
            remainingMs -= availableMs
            int weekendEnd = timestamp(NY_TIMEZONE, year(weekendStart, NY_TIMEZONE), month(weekendStart, NY_TIMEZONE), dayofmonth(weekendStart, NY_TIMEZONE) + 2, SUNDAY_REOPEN_START_HOUR, 0)
            int fullWeeks = int(math.floor(remainingMs / float(FUTURES_EXTENSION_WEEK_MS)))
            remainingMs -= fullWeeks * FUTURES_EXTENSION_WEEK_MS
            endpoint := timestamp(NY_TIMEZONE, year(weekendEnd, NY_TIMEZONE), month(weekendEnd, NY_TIMEZONE), dayofmonth(weekendEnd, NY_TIMEZONE) + fullWeeks * CALENDAR_DAYS_PER_WEEK, SUNDAY_REOPEN_START_HOUR, 0) + remainingMs
    endpoint

sessionOccurrenceClose(SourceSpec source, legilimensOrchestration.Profile profile, bool developing, BarContext context) =>
    int closeTime = profile.endTime
    if source.key == SOURCE_NY_EARLY
        closeTime := legilimensOrchestration.nyMinuteBoundary(profile.startTime, NY_EARLY_END_MINUTE)
    else if source.key == SOURCE_EXTENDED_NY_EARLY
        int nominalCloseTime = legilimensOrchestration.nyMinuteBoundary(profile.startTime, IVB_START_MINUTE)
        closeTime := profile.endTime > nominalCloseTime ? legilimensOrchestration.nyMinuteBoundary(profile.startTime, EXTENDED_NY_EARLY_OPENING_END_MINUTE) : nominalCloseTime
    else if source.key == SOURCE_IVB
        closeTime := legilimensOrchestration.nyMinuteBoundary(profile.startTime, IVB_END_MINUTE)
    else if source.key == SOURCE_ASIA_PREMARKET
        closeTime := legilimensOrchestration.nySessionEndBoundary(profile.startTime, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE)
    else if source.key == SOURCE_NY_AFTERNOON or source.key == SOURCE_ALL_DAY_TO_AFTERNOON
        closeTime := legilimensOrchestration.nyMinuteBoundary(profile.startTime, AFTERNOON_END_MINUTE)
    else if source.key == SOURCE_RTH
        closeTime := developing ? legilimensOrchestration.nyMinuteBoundary(profile.startTime, 16 * 60) : profile.endTime
    else if source.key == SOURCE_WEEKLY and not source.rollingPeriod
        closeTime := developing ? profile.endTime : context.twentyFourSeven ? legilimensOrchestration.nextCalendarWeekBoundary(profile.startTime, UTC_TIMEZONE, 0, 0) : legilimensOrchestration.nextCalendarWeekBoundary(profile.startTime, NY_TIMEZONE, SUNDAY_REOPEN_START_HOUR, 0)
    closeTime

sessionLevelEndpoint(SourceSpec source, int sessionCloseTime, BarContext context) =>
    int extensionMs = int(math.round(source.extensionHours * MS_PER_HOUR))
    context.futuresAsset ? futuresExtensionEndpoint(sessionCloseTime, extensionMs) : sessionCloseTime + extensionMs

rangeTitleLayout(legilimensOrchestration.Profile profile, string sizeName) =>
    float pricePerLayoutUnit = (profile.data.rangeHigh - profile.data.rangeLow) / profile.data.rowCount
    float titleClearance = pricePerLayoutUnit * (labelPointSize(sizeName) + RANGE_TITLE_CONTAINER_PADDING)
    [profile.data.rangeHigh, profile.data.rangeLow, titleClearance]

rangeHeadingTime(legilimensOrchestration.Profile profile, array<int> chartTimes, int startScaleIndex, int endScaleIndex, int barOffset) =>
    int headingTime = profile.startTime + int(math.round((profile.endTime - profile.startTime) * 0.5))
    if startScaleIndex >= 0 and endScaleIndex >= 0
        int headingIndex = int(math.round((startScaleIndex + endScaleIndex) * 0.5)) + barOffset
        int count = array.size(chartTimes)
        if headingIndex >= 0 and headingIndex < count
            headingTime := array.get(chartTimes, headingIndex)
        else
            int overflowSteps = headingIndex < 0 ? headingIndex : headingIndex - (count - 1)
            int edgeTime = headingIndex < 0 ? array.get(chartTimes, 0) : array.get(chartTimes, count - 1)
            headingTime := edgeTime + overflowSteps * barSpanMs()
    else
        headingTime += barOffset * barSpanMs()
    headingTime

levelMarkerTime(int levelEndTime) =>
    levelEndTime + int(math.round(DOT_MARKER_OFFSET_BARS * barSpanMs()))

rowPassesDeltaFilter(float rowDelta, float strength, bool selectedOutlierRow, PresentationConfig config) =>
    bool isBuy = rowDelta > 0
    bool isSell = rowDelta < 0
    bool directionVisible = config.delta.visibleRows == OPTION_ALL ? isBuy or isSell : config.delta.visibleRows == OPTION_OFF ? false : config.delta.visibleRows == DELTA_ROWS_BUY ? isBuy : config.delta.visibleRows == DELTA_ROWS_SELL ? isSell : false
    bool filterPassed = config.delta.rowFilter == OPTION_ALL ? true : config.delta.rowFilter == DELTA_ROW_FILTER_OUTLIERS ? legilimensProfile.isOutlierStrength(strength) : selectedOutlierRow
    directionVisible and filterPassed

appendDeltaRowPoints(array<chart.point> points, int baselineTime, int outerTime, float rowBottom, float rowTop) =>
    array.push(points, chart.point.from_time(baselineTime, rowBottom))
    array.push(points, chart.point.from_time(outerTime, rowBottom))
    array.push(points, chart.point.from_time(outerTime, rowTop))
    array.push(points, chart.point.from_time(baselineTime, rowTop))

deltaLayerIndex(float rowDelta, bool outlierRow) =>
    outlierRow ? rowDelta >= 0 ? 4 : 5 : rowDelta >= 0 ? 2 : 3

histogramRegionRows(ProfilePolylineLayout geometry, int regionIndex) =>
    int firstRow = regionIndex == 0 ? 0 : regionIndex == 1 ? geometry.analysis.valueAreaLowRow : geometry.analysis.valueAreaHighRow + 1
    int lastRow = regionIndex == 0 ? geometry.analysis.valueAreaLowRow - 1 : regionIndex == 1 ? geometry.analysis.valueAreaHighRow : geometry.profile.data.rowCount - 1
    [firstRow, lastRow]

prepareProfileAnalysisCache(RenderState state, int barTime) =>
    if not na(state.analysisBarTime) and barTime < state.analysisBarTime
        array.clear(state.completedAnalyses)
    state.analysisBarTime := barTime
    true

profileAnalysis(RenderState state, legilimensOrchestration.Profile profile, SourceSpec source, bool completed) =>
    ProfileAnalysis analysis = na
    // Completed session data is immutable; input changes restart the script.
    if completed
        for cached in state.completedAnalyses
            if cached.sourceName == source.key and cached.startTime == profile.startTime and cached.endTime == profile.endTime
                analysis := cached
                break
    if na(analysis)
        [_, valueAreaLowRow, valueAreaHighRow, pocPrice, valueAreaLowPrice, valueAreaHighPrice] = legilimensProfile.profileValueLevels(profile.data.rowVolumes, profile.data.rowCount, profile.data.priceLow, profile.data.priceHigh)
        array<float> strengths = legilimensProfile.computeRowStrengths(profile.data)
        analysis := ProfileAnalysis.new(source.key, profile.startTime, profile.endTime, strengths, valueAreaLowRow, valueAreaHighRow, pocPrice, valueAreaLowPrice, valueAreaHighPrice, na, na)
    analysis

profileOutlierPeaks(ProfileAnalysis analysis, legilimensOrchestration.Profile profile, PresentationConfig config) =>
    if na(analysis.outlierPeaks) and (config.delta.showTiers or config.delta.showHighestDeltaLevels)
        analysis.outlierPeaks := legilimensProfile.collectOutlierPeaks(profile.data, analysis.strengths)
    analysis.outlierPeaks

profileLowVolumeCandidates(ProfileAnalysis analysis, legilimensOrchestration.Profile profile, PresentationConfig config) =>
    if na(analysis.lowVolumeCandidates) and config.delta.showLvnTiers
        analysis.lowVolumeCandidates := legilimensProfile.selectLowVolumeCandidates(profile.data, config.delta.visibleLvnTierCount)
    analysis.lowVolumeCandidates

profilePolylineLayout(legilimensOrchestration.Profile profile, SourceSpec source, ProfileAnalysis analysis, array<int> chartTimes, PresentationConfig config) =>
    int startScaleIndex = nearestChartTimeIndex(chartTimes, profile.startTime)
    int endScaleIndex = nearestChartTimeIndex(chartTimes, profile.endTime)
    array<float> strengths = analysis.strengths
    ProfilePolylineLayout geometry = ProfilePolylineLayout.new(profile, source, analysis, array.new<int>(PROFILE_POLYLINE_LAYER_COUNT, 0), startScaleIndex, endScaleIndex, na, na, na, na)
    float maximumMagnitude = 0.0
    if profile.data.maxAbsRowDelta > 0 and config.delta.visibleRows != OPTION_OFF
        for rowIndex = 0 to profile.data.rowCount - 1
            float rowDelta = array.get(profile.data.rowDeltas, rowIndex)
            float strength = array.get(strengths, rowIndex)
            bool outlierRow = legilimensProfile.isOutlierStrength(strength)
            // Selected-tier rows are a subset of outliers; reserve their superset without reranking.
            if array.get(profile.data.rowVolumes, rowIndex) > 0 and math.abs(rowDelta) > 0 and rowPassesDeltaFilter(rowDelta, strength, outlierRow, config)
                int layerIndex = deltaLayerIndex(rowDelta, outlierRow)
                array.set(geometry.pointCounts, layerIndex, array.get(geometry.pointCounts, layerIndex) + 4)
                maximumMagnitude := math.max(maximumMagnitude, math.abs(rowDelta))
        for layerIndex = 2 to PROFILE_POLYLINE_LAYER_COUNT - 1
            int pointCount = array.get(geometry.pointCounts, layerIndex)
            if pointCount > 0
                array.set(geometry.pointCounts, layerIndex, pointCount + 3)
        if maximumMagnitude > 0
            bool attachRight = source.profilePosition == PROFILE_POSITION_RIGHT_LEFT or source.profilePosition == PROFILE_POSITION_RIGHT_RIGHT
            bool faceLeft = source.profilePosition == PROFILE_POSITION_LEFT_LEFT or source.profilePosition == PROFILE_POSITION_RIGHT_LEFT
            int baselineIndex = attachRight ? endScaleIndex : startScaleIndex
            int baselineTime = profileBaselineTime(profile, chartTimes, baselineIndex, attachRight)
            int outerTime = deltaOuterTime(profile, chartTimes, startScaleIndex, endScaleIndex, baselineIndex, maximumMagnitude / profile.data.maxAbsRowDelta, source.deltaWidthBars, faceLeft, attachRight)
            geometry.deltaLeftTime := math.min(baselineTime, outerTime)
            geometry.deltaRightTime := math.max(baselineTime, outerTime)
    if config.delta.showHistogram and profile.data.maxRowVolume > 0
        bool completeScale = startScaleIndex >= 0 and endScaleIndex >= 0
        int baselineIndex = completeScale ? startScaleIndex : -1
        int rangeSteps = completeScale ? math.max(1, math.abs(endScaleIndex - startScaleIndex)) : 1
        int baselineTime = profileBaselineTime(profile, chartTimes, baselineIndex, false)
        int outerTime = profileOuterTime(profile, chartTimes, baselineIndex, rangeSteps, 1.0, config.delta.histogramWidthPercent, false, false)
        geometry.histogramLeftTime := math.min(baselineTime, outerTime)
        geometry.histogramRightTime := math.max(baselineTime, outerTime)
        for regionIndex = 0 to 2
            [firstRow, lastRow] = histogramRegionRows(geometry, regionIndex)
            if firstRow <= lastRow
                int layerIndex = regionIndex == 1 ? 1 : 0
                array.set(geometry.pointCounts, layerIndex, array.get(geometry.pointCounts, layerIndex) + lastRow - firstRow + 6)
    geometry

profilePolylineRegions(ProfilePolylineLayout geometry, array<bool> selectedRows, bool includeHistogram, array<int> chartTimes, PresentationConfig config) =>
    legilimensOrchestration.Profile profile = geometry.profile
    SourceSpec source = geometry.source
    array<ProfilePolylineRegion> regions = array.new<ProfilePolylineRegion>()
    float rowHeight = (profile.data.priceHigh - profile.data.priceLow) / profile.data.rowCount
    if includeHistogram and profile.data.maxRowVolume > 0
        bool completeScale = geometry.startScaleIndex >= 0 and geometry.endScaleIndex >= 0
        int baselineIndex = completeScale ? geometry.startScaleIndex : -1
        int rangeSteps = completeScale ? math.max(1, math.abs(geometry.endScaleIndex - geometry.startScaleIndex)) : 1
        int baselineTime = profileBaselineTime(profile, chartTimes, baselineIndex, false)
        for regionIndex = 0 to 2
            [firstRow, lastRow] = histogramRegionRows(geometry, regionIndex)
            if firstRow <= lastRow
                array<chart.point> points = array.new<chart.point>()
                array.push(points, chart.point.from_time(baselineTime, profile.data.priceLow + firstRow * rowHeight))
                for rowIndex = firstRow to lastRow
                    float rowVolume = array.get(profile.data.rowVolumes, rowIndex)
                    int outerTime = profileOuterTime(profile, chartTimes, baselineIndex, rangeSteps, rowVolume / profile.data.maxRowVolume, config.delta.histogramWidthPercent, false, false)
                    array.push(points, chart.point.from_time(outerTime, profile.data.priceLow + (rowIndex + 0.5) * rowHeight))
                array.push(points, chart.point.from_time(baselineTime, profile.data.priceLow + (lastRow + 1) * rowHeight))
                array.push(regions, ProfilePolylineRegion.new(regionIndex == 1 ? 1 : 0, points))
    if profile.data.maxAbsRowDelta > 0 and config.delta.visibleRows != OPTION_OFF
        array<ProfilePolylineRegion> deltaRegions = array.new<ProfilePolylineRegion>()
        for layerIndex = 2 to PROFILE_POLYLINE_LAYER_COUNT - 1
            array.push(deltaRegions, ProfilePolylineRegion.new(layerIndex, array.new<chart.point>()))
        bool attachRight = source.profilePosition == PROFILE_POSITION_RIGHT_LEFT or source.profilePosition == PROFILE_POSITION_RIGHT_RIGHT
        bool faceLeft = source.profilePosition == PROFILE_POSITION_LEFT_LEFT or source.profilePosition == PROFILE_POSITION_RIGHT_LEFT
        int baselineIndex = attachRight ? geometry.endScaleIndex : geometry.startScaleIndex
        int baselineTime = profileBaselineTime(profile, chartTimes, baselineIndex, attachRight)
        for rowIndex = 0 to profile.data.rowCount - 1
            float rowDelta = array.get(profile.data.rowDeltas, rowIndex)
            float strength = array.get(geometry.analysis.strengths, rowIndex)
            bool selectedRow = rowIndex < array.size(selectedRows) and array.get(selectedRows, rowIndex)
            if array.get(profile.data.rowVolumes, rowIndex) > 0 and math.abs(rowDelta) > 0 and rowPassesDeltaFilter(rowDelta, strength, selectedRow, config)
                int layerIndex = deltaLayerIndex(rowDelta, legilimensProfile.isOutlierStrength(strength))
                ProfilePolylineRegion region = array.get(deltaRegions, layerIndex - 2)
                int outerTime = deltaOuterTime(profile, chartTimes, geometry.startScaleIndex, geometry.endScaleIndex, baselineIndex, math.abs(rowDelta) / profile.data.maxAbsRowDelta, source.deltaWidthBars, faceLeft, attachRight)
                float rowBottom = profile.data.priceLow + rowIndex * rowHeight
                appendDeltaRowPoints(region.points, baselineTime, outerTime, rowBottom, rowBottom + rowHeight)
        for region in deltaRegions
            if array.size(region.points) > 0
                array.push(regions, region)
    regions

newProfilePolylineBatch() =>
    array<ProfilePolylineLayer> layers = array.new<ProfilePolylineLayer>()
    for layerIndex = 0 to PROFILE_POLYLINE_LAYER_COUNT - 1
        array.push(layers, ProfilePolylineLayer.new(array.new<chart.point>()))
    ProfilePolylineBatch.new(layers)

profilePolylineColor(SourceSpec source, int layerIndex) =>
    layerIndex == 0 ? color.new(color.rgb(184, 184, 184), 80) : layerIndex == 1 ? color.new(color.rgb(187, 217, 251), 75) : layerIndex == 2 ? profileDeltaPlusColor(source) : layerIndex == 3 ? profileDeltaMinusColor(source) : layerIndex == 4 ? profileDeltaPlusPlusColor(source) : profileDeltaMinusMinusColor(source)

flushProfilePolylineLayer(RenderState state, ProfilePolylineBatch batch, ProfilePolylineLayer layer, bool draw, PresentationConfig config) =>
    if layer.reservedPoints > 0
        if draw and array.size(layer.points) >= 3 and canDrawPolyline(state, config)
            array.push(state.drawnPolylines, polyline.new(layer.points, curved=false, closed=true, xloc=xloc.bar_time, line_color=color.new(layer.fillColor, 100), fill_color=layer.fillColor))
        array.clear(layer.points)
        layer.reservedPoints := 0
        batch.completedCount += 1
    true

flushProfilePolylineBatch(RenderState state, ProfilePolylineBatch batch, bool draw, PresentationConfig config) =>
    for layer in batch.layers
        flushProfilePolylineLayer(state, batch, layer, draw, config)
    batch.leftTime := na
    batch.rightTime := na
    batch.spinePrice := na
    batch.sourceKey := ""
    batch.shareable := false
    true

profilePolylineBounds(ProfilePolylineLayout geometry, bool includeHistogram) =>
    int leftTime = geometry.deltaLeftTime
    int rightTime = geometry.deltaRightTime
    if includeHistogram and not na(geometry.histogramLeftTime)
        leftTime := na(leftTime) ? geometry.histogramLeftTime : math.min(leftTime, geometry.histogramLeftTime)
        rightTime := na(rightTime) ? geometry.histogramRightTime : math.max(rightTime, geometry.histogramRightTime)
    [leftTime, rightTime]

profilePolylineBatchCompatible(ProfilePolylineBatch batch, ProfilePolylineLayout geometry, bool shareable, int leftTime, int rightTime) =>
    bool disjoint = rightTime < batch.leftTime or leftTime > batch.rightTime
    bool commonPrice = batch.spinePrice >= geometry.profile.data.priceLow and batch.spinePrice <= geometry.profile.data.priceHigh
    batch.shareable and shareable and batch.sourceKey == geometry.source.key and disjoint and commonPrice

appendProfilePolylineRegion(array<chart.point> points, array<chart.point> regionPoints, float spinePrice) =>
    chart.point firstPoint = array.first(regionPoints)
    // Closed branches and the return along the shared spine add no filled area.
    array.push(points, chart.point.from_time(firstPoint.time, spinePrice))
    array.concat(points, regionPoints)
    array.push(points, firstPoint)
    array.push(points, chart.point.from_time(firstPoint.time, spinePrice))
    true

processProfilePolylineBatch(RenderState state, ProfilePolylineBatch batch, ProfilePolylineLayout geometry, bool shareable, bool includeHistogram, array<ProfilePolylineRegion> regions, bool draw, PresentationConfig config) =>
    [leftTime, rightTime] = profilePolylineBounds(geometry, includeHistogram)
    if not na(leftTime)
        if not na(batch.leftTime) and not profilePolylineBatchCompatible(batch, geometry, shareable, leftTime, rightTime)
            flushProfilePolylineBatch(state, batch, draw, config)
        batch.leftTime := na(batch.leftTime) ? leftTime : math.min(batch.leftTime, leftTime)
        batch.rightTime := na(batch.rightTime) ? rightTime : math.max(batch.rightTime, rightTime)
        batch.spinePrice := na(batch.spinePrice) ? geometry.profile.data.priceLow : batch.spinePrice
        batch.sourceKey := geometry.source.key
        batch.shareable := shareable
        for layerIndex = (includeHistogram ? 0 : 2) to PROFILE_POLYLINE_LAYER_COUNT - 1
            ProfilePolylineLayer layer = array.get(batch.layers, layerIndex)
            int addedPoints = array.get(geometry.pointCounts, layerIndex)
            if layer.reservedPoints + addedPoints > PROFILE_POLYLINE_POINT_LIMIT
                flushProfilePolylineLayer(state, batch, layer, draw, config)
            layer.fillColor := profilePolylineColor(geometry.source, layerIndex)
            layer.reservedPoints += addedPoints
        if draw
            for region in regions
                ProfilePolylineLayer layer = array.get(batch.layers, region.layerIndex)
                appendProfilePolylineRegion(layer.points, region.points, batch.spinePrice)
    true

formationTimeSuffix(int formedTime, bool enabled) =>
    enabled and not na(formedTime) ? " @" + str.format_time(formedTime, "HH:mm", NY_TIMEZONE) : ""

priceFormationTime(legilimensProfile.ProfileData data, float price) =>
    float rowHeight = (data.priceHigh - data.priceLow) / data.rowCount
    int rowIndex = math.max(0, math.min(data.rowCount - 1, int(math.floor((price - data.priceLow) / rowHeight))))
    bool buyDominant = array.get(data.rowDeltas, rowIndex) >= 0
    int dominantTime = buyDominant ? array.get(data.rowBuyTimes, rowIndex) : array.get(data.rowSellTimes, rowIndex)
    int oppositeTime = buyDominant ? array.get(data.rowSellTimes, rowIndex) : array.get(data.rowBuyTimes, rowIndex)
    na(dominantTime) ? oppositeTime : dominantTime

renderLowVolumeZone(RenderState state, legilimensOrchestration.Profile profile, SourceSpec source, float price, float zoneLow, float zoneHigh, int levelEndTime, int levelRank, int sessionTradingDayKey, bool historical, int borderWidth, color borderColor, color markerColor, string markerGlyph, string markerLabel, int markerSize, bool registrationOnly, array<SourceSpec> sources, PresentationConfig config) =>
    color zoneColor = color.new(color.rgb(74, 74, 74), 95)
    bool markerDeferred = mitigationEnabled(sources, source.key, config)
    if registrationOnly
        if markerDeferred
            registerMitigatedZone(state, source.key, profile.startTime, levelEndTime, price, config)
    else if markerDeferred
        array.push(state.pendingMitigatedZones, PendingMitigatedZone.new(price, zoneLow, zoneHigh, profile.startTime, profile.endTime, levelEndTime, zoneColor, borderWidth, borderColor, false, markerColor, LOW_VOLUME_LINE_WIDTH, STYLE_DOTTED, levelRank, source.key, sessionTradingDayKey, historical, 0, markerGlyph, markerLabel, markerColor, markerSize))
    else
        renderZoneFill(state, profile.endTime, levelEndTime, zoneLow, zoneHigh, zoneColor, borderWidth, borderColor, config)
    markerDeferred

renderLowVolumeStructures(RenderState state, legilimensOrchestration.Profile profile, SourceSpec source, array<legilimensProfile.LowVolumeCandidate> candidates, string displayNameOverride, int levelEndTime, int sessionTradingDayKey, bool historical, bool registrationOnly, array<SourceSpec> sources, BarContext context, PresentationConfig config) =>
    if config.delta.showLvnTiers
        int count = array.size(candidates)
        if count > 0
            for candidateIndex = 0 to count - 1
                int structureRank = candidateIndex + 1
                legilimensProfile.LowVolumeCandidate candidate = array.get(candidates, candidateIndex)
                int levelRank = LOW_VOLUME_LEVEL_RANK - structureRank
                float labelPrice = candidate.isLvn ? (candidate.zoneLow + candidate.zoneHigh) * 0.5 : candidate.price
                string markerLabel = (displayNameOverride != "" ? displayNameOverride : source.labelName) + formationTimeSuffix(config.delta.showLvnFormationTime ? priceFormationTime(profile.data, labelPrice) : na, config.delta.showLvnFormationTime)
                color markerColor = color.new(color.rgb(15, 15, 15), 75)
                color borderColor = markerColor
                string markerGlyph = LEVEL_MARKER_GLYPH
                int fibBorderWidth = 0
                float fibMidpointPrice = (profile.data.rangeLow + profile.data.rangeHigh) * FIB_LOCATION_MIDPOINT
                bool buySide = labelPrice < fibMidpointPrice
                bool sellSide = labelPrice > fibMidpointPrice
                if (candidate.isLvn or config.delta.matchLowVolumeFibStyling) and (buySide or sellSide)
                    int fibGrade = deltaTierFibLocationGrade(buySide, labelPrice, profile.data.rangeLow, profile.data.rangeHigh)
                    color directionalColor = buySide ? profileDeltaPlusPlusColor(source) : profileDeltaMinusMinusColor(source)
                    markerColor := color.new(fibQualificationColor(directionalColor, fibGrade >= FIB_LOCATION_QUALIFIED), config.delta.lvnFibMarkerTransparency)
                    borderColor := color.new(directionalColor, config.delta.lvnFibBorderTransparency)
                    markerGlyph := fibLocationMarkerGlyph(fibGrade)
                    fibBorderWidth := config.delta.matchLowVolumeFibStyling ? fibLocationBorderWidth(fibGrade, buySide, labelPrice, fibMidpointPrice) : 1
                bool markerDeferred = false
                if candidate.isLvn
                    markerDeferred := renderLowVolumeZone(state, profile, source, labelPrice, candidate.zoneLow, candidate.zoneHigh, levelEndTime, levelRank, sessionTradingDayKey, historical, fibBorderWidth, borderColor, markerColor, markerGlyph, markerLabel, tierMarkerSize(6 - structureRank), registrationOnly, sources, config)
                else if not registrationOnly
                    queueRightLine(state, candidate.price, profile.endTime, levelEndTime, markerColor, LOW_VOLUME_LINE_WIDTH, STYLE_DOTTED, levelRank, source.key, sessionTradingDayKey, historical, 0, context)
                if not registrationOnly and not markerDeferred
                    queueLevelMarker(state, labelPrice, levelMarkerTime(levelEndTime), markerGlyph, markerLabel, markerColor, tierMarkerSize(6 - structureRank), config)

highestDeltaRow(legilimensOrchestration.Profile profile, bool buySide) =>
    int strongestRow = -1
    float strongestMagnitude = 0.0
    for rowIndex = 0 to profile.data.rowCount - 1
        float rowDelta = array.get(profile.data.rowDeltas, rowIndex)
        bool correctSide = buySide ? rowDelta > 0 : rowDelta < 0
        float magnitude = math.abs(rowDelta)
        if correctSide and magnitude > strongestMagnitude
            strongestMagnitude := magnitude
            strongestRow := rowIndex
    strongestRow

queueOutlierPeaks(RenderState state, legilimensOrchestration.Profile profile, SourceSpec source, array<legilimensProfile.OutlierPeak> peaks, string displayNameOverride, int levelEndTime, int sessionTradingDayKey, bool historical, PresentationConfig config) =>
    if config.delta.showTiers
        int markerTime = levelMarkerTime(levelEndTime)
        int count = array.size(peaks)
        if count > 0
            int highestBuyRow = config.delta.showHighestDeltaLevels ? highestDeltaRow(profile, true) : -1
            int highestSellRow = config.delta.showHighestDeltaLevels ? highestDeltaRow(profile, false) : -1
            for peakIndex = 0 to count - 1
                legilimensProfile.OutlierPeak peak = array.get(peaks, peakIndex)
                int highestRow = peak.buySide ? highestBuyRow : highestSellRow
                bool containsHighestDeltaRow = highestRow >= 0 and highestRow >= peak.firstRow and highestRow <= peak.lastRow
                int fibGrade = deltaTierFibLocationGrade(peak.buySide, peak.price, profile.data.rangeLow, profile.data.rangeHigh)
                float fibMidpoint = (profile.data.rangeLow + profile.data.rangeHigh) * FIB_LOCATION_MIDPOINT
                array.push(state.pendingOutlierLevels, PendingOutlierLevel.new(peak.price, peak.zoneLow, peak.zoneHigh, peak.delta, peak.strength, peak.buySide, profile.startTime, profile.endTime, levelEndTime, markerTime, source.key, displayNameOverride, sessionTradingDayKey, historical, peak.firstRow, peak.lastRow, fibGrade, fibMidpoint, containsHighestDeltaRow, peak.formedTime))

rankPendingOutlierLevels(RenderState state, BarContext context, PresentationConfig config) =>
    array<RankedOutlierLevel> rankedLevels = array.new<RankedOutlierLevel>()
    array<legilimensProfile.RankedOutlierSelection> rankedSelections = array.new<legilimensProfile.RankedOutlierSelection>()
    int pendingCount = array.size(state.pendingOutlierLevels)
    if pendingCount > 0
        array<legilimensProfile.OutlierCandidate> candidates = array.new<legilimensProfile.OutlierCandidate>()
        for pendingIndex = 0 to pendingCount - 1
            PendingOutlierLevel pending = array.get(state.pendingOutlierLevels, pendingIndex)
            array.push(candidates, legilimensProfile.OutlierCandidate.new(pending.price, pending.zoneLow, pending.zoneHigh, pending.delta, pending.strength, pending.buySide, pending.sourceName, pending.tradingDayKey, pending.historical, pending.profileStartTime, pending.firstRow, pending.lastRow))
        rankedSelections := legilimensProfile.rankOutlierCandidates(candidates, config.levels.mergeOverlaps, context.tickSize, config.levels.mergeDistancePercent, config.delta.visibleTierCount)
        int count = array.size(rankedSelections)
        if count > 0
            for rankedIndex = 0 to count - 1
                legilimensProfile.RankedOutlierSelection selection = array.get(rankedSelections, rankedIndex)
                PendingOutlierLevel firstPending = array.get(state.pendingOutlierLevels, array.get(selection.memberIndices, 0))
                PendingOutlierLevel representative = array.get(state.pendingOutlierLevels, selection.representativeIndex)
                int lineStartTime = firstPending.lineStartTime
                int rightTime = firstPending.rightTime
                bool containsHighestDeltaRow = firstPending.containsHighestDeltaRow
                if array.size(selection.memberIndices) > 1
                    for memberIndex = 1 to array.size(selection.memberIndices) - 1
                        PendingOutlierLevel member = array.get(state.pendingOutlierLevels, array.get(selection.memberIndices, memberIndex))
                        lineStartTime := math.max(lineStartTime, member.lineStartTime)
                        rightTime := math.max(rightTime, member.rightTime)
                        containsHighestDeltaRow := containsHighestDeltaRow or member.containsHighestDeltaRow
                array.push(rankedLevels, RankedOutlierLevel.new(selection.price, selection.zoneLow, selection.zoneHigh, selection.buySide, firstPending.profileStartTime, lineStartTime, rightTime, representative.markerTime, firstPending.sourceName, firstPending.displayNameOverride, firstPending.tradingDayKey, firstPending.historical, selection.firstRow, selection.lastRow, selection.strengthRank, representative.fibLocationGrade, representative.fibMidpointPrice, containsHighestDeltaRow, representative.formedTime))
        array.clear(state.pendingOutlierLevels)
    [rankedLevels, rankedSelections]

deltaTierLineStyle(PresentationConfig config, string defaultStyle) =>
    config.interactions.extendUnmitigated or config.delta.tierLineStyle == STYLE_DOTTED ? STYLE_DOTTED : defaultStyle

highestDeltaMarkerGlyph(string markerGlyph, bool containsHighestDeltaRow, bool buySide) =>
    containsHighestDeltaRow ? markerGlyph + (buySide ? "⁺" : "⁻") : markerGlyph

renderRankedOutlierLevels(RenderState state, array<RankedOutlierLevel> rankedLevels, bool registrationOnly, array<SourceSpec> sources, BarContext context, PresentationConfig config) =>
    int count = array.size(rankedLevels)
    if count > 0
        for rankedIndex = 0 to count - 1
            RankedOutlierLevel ranked = array.get(rankedLevels, rankedIndex)
            SourceSpec source = sourceSpec(sources, ranked.sourceName)
            int tier = 6 - ranked.strengthRank
            DeltaTierAppearance appearance = deltaTierAppearance(ranked.buySide, tier, source)
            string lineStyle = deltaTierLineStyle(config, appearanceLineStyle(appearance))
            int levelRank = 2000 - ranked.strengthRank
            bool extendPriorityZone = ranked.strengthRank <= 2 and mitigationEnabled(sources, ranked.sourceName, config)
            int direction = ranked.buySide ? 1 : -1
            string markerLabel = (ranked.displayNameOverride != "" ? ranked.displayNameOverride : source.labelName) + formationTimeSuffix(ranked.formedTime, config.delta.showFormationTime)
            int fibBorderWidth = fibLocationBorderWidth(ranked.fibLocationGrade, ranked.buySide, ranked.price, ranked.fibMidpointPrice)
            bool qualified = ranked.fibLocationGrade >= FIB_LOCATION_QUALIFIED
            color zoneColor = fibQualificationColor(appearanceZoneColor(appearance), qualified)
            color lineColor = fibQualificationColor(appearanceLineColor(appearance), qualified)
            color markerColor = fibQualificationColor(appearanceTextColor(appearance), qualified)
            string baseMarkerGlyph = fibLocationMarkerGlyph(ranked.fibLocationGrade)
            string markerGlyph = highestDeltaMarkerGlyph(baseMarkerGlyph, ranked.containsHighestDeltaRow, ranked.buySide)
            if deltaTierSideVisible(ranked.buySide, config)
                if registrationOnly
                    if extendPriorityZone
                        registerMitigatedZone(state, ranked.sourceName, ranked.profileStartTime, ranked.rightTime, ranked.price, config)
                else if extendPriorityZone
                    array.push(state.pendingMitigatedZones, PendingMitigatedZone.new(ranked.price, ranked.zoneLow, ranked.zoneHigh, ranked.profileStartTime, ranked.lineStartTime, ranked.rightTime, zoneColor, fibBorderWidth, markerColor, appearanceHasLine(appearance), lineColor, appearanceLineWidth(appearance), lineStyle, levelRank, ranked.sourceName, ranked.tradingDayKey, ranked.historical, direction, markerGlyph, markerLabel, markerColor, tierMarkerSize(tier)))
                else
                    renderZoneFill(state, ranked.lineStartTime, ranked.rightTime, ranked.zoneLow, ranked.zoneHigh, zoneColor, fibBorderWidth, markerColor, config)
                    if appearanceHasLine(appearance)
                        queueRightLine(state, ranked.price, ranked.lineStartTime, ranked.rightTime, lineColor, appearanceLineWidth(appearance), lineStyle, levelRank, ranked.sourceName, ranked.tradingDayKey, ranked.historical, direction, context)
                    queueLevelMarker(state, ranked.price, ranked.markerTime, markerGlyph, markerLabel, markerColor, tierMarkerSize(tier), config)

rowIncludedInVisibleOutlier(int rowIndex, bool buySide, int profileStartTime, array<legilimensProfile.RankedOutlierSelection> selections, PresentationConfig config) =>
    bool included = false
    if config.delta.showTiers and deltaTierSideVisible(buySide, config)
        int selectionCount = array.size(selections)
        if selectionCount > 0
            for selectionIndex = 0 to selectionCount - 1
                legilimensProfile.RankedOutlierSelection selection = array.get(selections, selectionIndex)
                if selection.profileKey == profileStartTime and selection.buySide == buySide and rowIndex >= selection.firstRow and rowIndex <= selection.lastRow
                    included := true
                    break
    included

strongestDeltaZone(legilimensOrchestration.Profile profile, bool buySide, array<legilimensProfile.OutlierPeak> peaks) =>
    int rowIndex = highestDeltaRow(profile, buySide)
    float rowHeight = (profile.data.priceHigh - profile.data.priceLow) / profile.data.rowCount
    float zoneLow = rowIndex >= 0 ? profile.data.priceLow + rowIndex * rowHeight : na
    float zoneHigh = rowIndex >= 0 ? zoneLow + rowHeight : na
    int peakCount = array.size(peaks)
    if rowIndex >= 0 and peakCount > 0
        for peakIndex = 0 to peakCount - 1
            legilimensProfile.OutlierPeak peak = array.get(peaks, peakIndex)
            if peak.buySide == buySide and rowIndex >= peak.firstRow and rowIndex <= peak.lastRow
                zoneLow := peak.zoneLow
                zoneHigh := peak.zoneHigh
                break
    [rowIndex, zoneLow, zoneHigh]

renderHighestDeltaLevels(RenderState state, legilimensOrchestration.Profile profile, SourceSpec source, int levelEndTime, array<legilimensProfile.OutlierPeak> peaks, array<legilimensProfile.RankedOutlierSelection> rankedSelections, PresentationConfig config) =>
    if config.delta.showHighestDeltaLevels
        for sideIndex = 0 to 1
            bool buySide = sideIndex == 0
            [rowIndex, zoneLow, zoneHigh] = strongestDeltaZone(profile, buySide, peaks)
            if rowIndex >= 0 and not rowIncludedInVisibleOutlier(rowIndex, buySide, profile.startTime, rankedSelections, config) and canDrawBox(state, config)
                DeltaTierAppearance appearance = deltaTierAppearance(buySide, 5, source)
                color outlineColor = appearanceZoneColor(appearance)
                array.push(state.drawnBoxes, box.new(left=profile.endTime, top=zoneHigh, right=levelEndTime, bottom=zoneLow, xloc=xloc.bar_time, border_color=outlineColor, border_width=config.delta.highestDeltaBorderWidth, border_style=line.style_solid, bgcolor=color.new(outlineColor, 100)))

renderProfileBox(RenderState state, legilimensOrchestration.Profile profile, SourceSpec source, PresentationConfig config) =>
    if canDrawBox(state, config)
        color innerColor = profileInnerColor(source.key)
        array.push(state.drawnBoxes, box.new(left=profile.startTime, top=profile.data.rangeHigh, right=profile.endTime, bottom=profile.data.rangeLow, xloc=xloc.bar_time, border_color=innerColor, border_width=SESSION_OUTLINE_WIDTH, border_style=line.style_solid, bgcolor=color.new(color.white, 100)))

renderOuterSessionFrame(RenderState state, legilimensOrchestration.Profile profile, SourceSpec source, int levelEndTime, PresentationConfig config) =>
    [rangeHighTitleY, rangeLowTitleY, titleClearance] = rangeTitleLayout(profile, profileRangeLabelSize(source.key))
    color outerColor = profileOuterColor(source.key)
    if canDrawBox(state, config)
        array.push(state.drawnBoxes, box.new(left=profile.startTime, top=rangeHighTitleY + titleClearance, right=levelEndTime, bottom=rangeLowTitleY - titleClearance, xloc=xloc.bar_time, border_color=outerColor, border_width=1, border_style=line.style_solid, bgcolor=color.new(outerColor, 100)))

profileTitle(string name, bool primaryPlus) =>
    name + (primaryPlus ? PRIMARY_PLUS_MARKER : "")

developingLevelLabel(string labelText, bool developing) =>
    labelText + (developing ? " (dev)" : "")

renderReferenceLevel(RenderState state, legilimensOrchestration.Profile profile, SourceSpec source, bool primaryPlus, bool developing, int levelEndTime, float price, string levelName, color lineColor, PresentationConfig config) =>
    bool pocLevel = levelName == LEVEL_POC
    if canDrawLine(state, config)
        array.push(state.drawnLines, line.new(profile.startTime, price, levelEndTime, price, xloc=xloc.bar_time, color=lineColor, style=toLineStyle(pocLevel ? STYLE_DASHED : STYLE_SOLID), width=pocLevel ? POC_LEVEL_WIDTH : VALUE_AREA_LEVEL_WIDTH))
    if pocLevel and canDrawLabel(state, config)
        string labelText = developingLevelLabel(profileTitle(source.displayName, primaryPlus) + " " + levelName, developing)
        array.push(state.drawnLabels, label.new(levelEndTime + int(math.round(POC_LABEL_OFFSET_BARS * barSpanMs())), price, labelText, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, textcolor=color.rgb(49, 27, 146), size=POC_LABEL_SIZE, color=color.new(color.white, 100)))

renderRangeLabels(RenderState state, legilimensOrchestration.Profile profile, SourceSpec source, bool primaryPlus, bool pairedNyHeadings, array<int> chartTimes, int startScaleIndex, int endScaleIndex, PresentationConfig config) =>
    string labelSize = profileRangeLabelSize(source.key)
    color labelColor = profileRangeLabelColor(source.key)
    int barOffset = pairedNyHeadings ? source.key == SOURCE_NY_EARLY ? -NY_HEADING_SEPARATION_BARS : source.key == SOURCE_EXTENDED_NY_EARLY ? NY_HEADING_SEPARATION_BARS : 0 : 0
    int headingTime = rangeHeadingTime(profile, chartTimes, startScaleIndex, endScaleIndex, barOffset)
    [rangeHighTitleY, rangeLowTitleY, _] = rangeTitleLayout(profile, labelSize)
    string rangeLabel = source.frameTitlePrefix + profileTitle(source.displayName, primaryPlus)
    color backgroundColor = profileTextBackgroundColor(source)
    if source.key == SOURCE_FIXED and canDrawLabel(state, config)
        array.push(state.drawnLabels, label.new(profile.startTime, rangeHighTitleY, "Fixed Start", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelColor, size=toLabelSize(labelSize), color=backgroundColor))
    if source.key == SOURCE_FIXED and canDrawLabel(state, config)
        array.push(state.drawnLabels, label.new(profile.endTime, rangeHighTitleY, "Fixed End", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelColor, size=toLabelSize(labelSize), color=backgroundColor))
    if canDrawLabel(state, config)
        array.push(state.drawnLabels, label.new(headingTime, rangeHighTitleY, rangeLabel, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelColor, size=toLabelSize(labelSize), color=backgroundColor))
    if canDrawLabel(state, config)
        array.push(state.drawnLabels, label.new(headingTime, rangeLowTitleY, rangeLabel, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, textcolor=labelColor, size=toLabelSize(labelSize), color=backgroundColor))

profileMidpointLabelTime(int profileEndTime, int levelEndTime, array<int> chartTimes, bool labelAtRight) =>
    int labelTime = levelMarkerTime(levelEndTime)
    if not labelAtRight
        labelTime := profileEndTime + int(math.round((levelEndTime - profileEndTime) * 0.5))
        int startIndex = nearestChartTimeIndex(chartTimes, profileEndTime)
        int endIndex = nearestChartTimeIndex(chartTimes, levelEndTime)
        if startIndex >= 0 and endIndex >= 0
            labelTime := array.get(chartTimes, int(math.round((startIndex + endIndex) * 0.5)))
    labelTime

renderProfileMidpointLine(RenderState state, legilimensOrchestration.Profile profile, SourceSpec source, bool developing, int levelEndTime, array<int> chartTimes, PresentationConfig config) =>
    if config.levels.showMidpoint and canDrawLine(state, config)
        float midpointPrice = (profile.data.rangeLow + profile.data.rangeHigh) * FIB_LOCATION_MIDPOINT
        array.push(state.drawnLines, line.new(profile.endTime, midpointPrice, levelEndTime, midpointPrice, xloc=xloc.bar_time, color=color.new(#2962ff, 70), style=line.style_solid, width=3))
        if canDrawLabel(state, config)
            bool labelAtRight = config.levels.midpointLabelAtRight
            int labelTime = profileMidpointLabelTime(profile.endTime, levelEndTime, chartTimes, labelAtRight)
            array.push(state.drawnLabels, label.new(labelTime, midpointPrice, developingLevelLabel(str.lower(source.key) + " 0.5", developing), xloc=xloc.bar_time, yloc=yloc.price, style=labelAtRight ? label.style_label_left : label.style_label_center, textcolor=color.new(#2962ff, 45), size=5, color=color.new(color.white, 50), textalign=labelAtRight ? text.align_left : text.align_center))

selectedOutlierRowMask(legilimensOrchestration.Profile profile, array<float> strengths, array<legilimensProfile.RankedOutlierSelection> selections, PresentationConfig config) =>
    bool enabled = config.delta.rowFilter == DELTA_ROW_FILTER_SELECTED_TIER_OUTLIERS and config.delta.showTiers and config.delta.visibleTierSides != OPTION_OFF
    legilimensProfile.selectedOutlierRowMask(profile.data, profile.startTime, strengths, selections, enabled, deltaTierSideVisible(true, config), deltaTierSideVisible(false, config))

renderSelectedProfile(RenderState state, ProfilePolylineLayout geometry, ProfilePolylineBatch batch, bool primaryPlus, bool pairedNyHeadings, bool historical, bool developing, bool renderBudgetedHistogram, array<int> chartTimes, array<SourceSpec> sources, BarContext context, PresentationConfig config) =>
    legilimensOrchestration.Profile profile = geometry.profile
    SourceSpec source = geometry.source
    int startScaleIndex = geometry.startScaleIndex
    int endScaleIndex = geometry.endScaleIndex
    int sessionCloseTime = sessionOccurrenceClose(source, profile, developing, context)
    int levelEndTime = sessionLevelEndpoint(source, sessionCloseTime, context)
    int sessionTradingDayKey = legilimensOrchestration.tradingDayKey(sessionCloseTime)
    if not developing or not developingControlled(source)
        renderOuterSessionFrame(state, profile, source, levelEndTime, config)
    renderRangeLabels(state, profile, source, primaryPlus, pairedNyHeadings, chartTimes, startScaleIndex, endScaleIndex, config)
    renderProfileBox(state, profile, source, config)
    if not developing or not developingControlled(source) or source.developingContentVisible
        renderProfileMidpointLine(state, profile, source, developing, levelEndTime, chartTimes, config)
        string levelDisplayName = developingLevelLabel(profileTitle(source.labelName, primaryPlus), developing)
        array<float> strengths = geometry.analysis.strengths
        array<legilimensProfile.OutlierPeak> outlierPeaks = profileOutlierPeaks(geometry.analysis, profile, config)
        queueOutlierPeaks(state, profile, source, outlierPeaks, levelDisplayName, levelEndTime, sessionTradingDayKey, historical, config)
        [rankedOutlierLevels, rankedOutlierSelections] = rankPendingOutlierLevels(state, context, config)
        array<bool> selectedRows = selectedOutlierRowMask(profile, strengths, rankedOutlierSelections, config)
        array<ProfilePolylineRegion> regions = profilePolylineRegions(geometry, selectedRows, renderBudgetedHistogram, chartTimes, config)
        processProfilePolylineBatch(state, batch, geometry, historical and not developing, renderBudgetedHistogram, regions, true, config)
        if config.levels.showValueArea
            color valueAreaColor = profileValueAreaLevelColor(source.key)
            renderReferenceLevel(state, profile, source, primaryPlus, developing, levelEndTime, geometry.analysis.valueAreaHighPrice, LEVEL_VAH, valueAreaColor, config)
            renderReferenceLevel(state, profile, source, primaryPlus, developing, levelEndTime, geometry.analysis.valueAreaLowPrice, LEVEL_VAL, valueAreaColor, config)
        if config.levels.showPoc
            renderReferenceLevel(state, profile, source, primaryPlus, developing, levelEndTime, geometry.analysis.pocPrice, LEVEL_POC, color.rgb(49, 27, 146), config)
        renderLowVolumeStructures(state, profile, source, profileLowVolumeCandidates(geometry.analysis, profile, config), levelDisplayName, levelEndTime, sessionTradingDayKey, historical, false, sources, context, config)
        renderRankedOutlierLevels(state, rankedOutlierLevels, false, sources, context, config)
        renderHighestDeltaLevels(state, profile, source, levelEndTime, outlierPeaks, rankedOutlierSelections, config)

renderDecision(legilimensOrchestration.Profile profile, SourceSpec source, legilimensOrchestration.ProfileSelection comparisonSelection, BarContext context, PresentationConfig config) =>
    legilimensOrchestration.renderDecision(profile, source.key, comparisonSelection, SOURCE_NY_EARLY, SOURCE_EXTENDED_NY_EARLY, NY_EARLY_END_MINUTE, config.extendedNyModeActive, context.tickSize)

comparisonSelection(array<SelectionBinding> bindings, string sourceName) =>
    string comparisonName = sourceName == SOURCE_EXTENDED_NY_EARLY ? SOURCE_NY_EARLY : sourceName == SOURCE_NY_EARLY ? SOURCE_EXTENDED_NY_EARLY : ""
    legilimensOrchestration.ProfileSelection comparison = na
    if comparisonName != ""
        int count = array.size(bindings)
        if count > 0
            for bindingIndex = 0 to count - 1
                SelectionBinding binding = array.get(bindings, bindingIndex)
                if na(comparison) and binding.source.key == comparisonName
                    comparison := binding.selection
    comparison

trimBindings(array<SelectionBinding> bindings, int capacity, PresentationConfig config, BarContext context) =>
    array<legilimensOrchestration.ProfileSelection> selections = array.new<legilimensOrchestration.ProfileSelection>()
    array<string> sourceNames = array.new<string>()
    for binding in bindings
        array.push(selections, binding.selection)
        array.push(sourceNames, binding.source.key)
    legilimensOrchestration.trimProfileSelectionsToCapacity(selections, sourceNames, capacity, SOURCE_NY_EARLY, SOURCE_EXTENDED_NY_EARLY, NY_EARLY_END_MINUTE, config.extendedNyModeActive, context.tickSize)

findProfilePolylineLayout(RenderState state, array<ProfilePolylineLayout> layouts, legilimensOrchestration.Profile profile, SourceSpec source, bool developing, array<int> chartTimes, PresentationConfig config) =>
    ProfilePolylineLayout found = na
    for geometry in layouts
        if geometry.source.key == source.key and geometry.profile.startTime == profile.startTime and geometry.profile.endTime == profile.endTime
            found := geometry
            break
    if na(found)
        found := profilePolylineLayout(profile, source, profileAnalysis(state, profile, source, not developing), chartTimes, config)
        array.push(layouts, found)
    found

profileRenderItems(RenderState state, array<SelectionBinding> bindings, array<ProfilePolylineLayout> layouts, bool hideDevelopingExtendedCounterpart, int currentNyEarlyStartTime, array<int> chartTimes, BarContext context, PresentationConfig config) =>
    array<ProfileRenderItem> items = array.new<ProfileRenderItem>()
    for renderPass = 0 to 1
        bool currentPass = renderPass == 0
        for binding in bindings
            legilimensOrchestration.ProfileSelection comparison = comparisonSelection(bindings, binding.source.key)
            int selectedCount = array.size(binding.selection.profiles)
            if selectedCount > 0
                for selectedIndex = 0 to selectedCount - 1
                    bool currentProfile = selectedIndex == binding.selection.currentIndex
                    if currentProfile == currentPass
                        legilimensOrchestration.Profile profile = array.get(binding.selection.profiles, selectedIndex)
                        legilimensOrchestration.RenderDecision decision = renderDecision(profile, binding.source, comparison, context, config)
                        if decision.shouldRender
                            bool hiddenCounterpart = binding.source.key == SOURCE_NY_EARLY and hideDevelopingExtendedCounterpart and profile.startTime == currentNyEarlyStartTime
                            bool developing = currentProfile and binding.selection.currentDeveloping
                            bool contentVisible = not developing or not developingControlled(binding.source) or binding.source.developingContentVisible
                            ProfilePolylineLayout geometry = findProfilePolylineLayout(state, layouts, profile, binding.source, developing, chartTimes, config)
                            array.push(items, ProfileRenderItem.new(geometry, hiddenCounterpart ? false : decision.primaryPlus, hiddenCounterpart ? false : decision.pairedHeadings, not currentProfile, developing, contentVisible))
    items

profilePolylineCost(RenderState state, array<ProfileRenderItem> items, bool includeHistogram, PresentationConfig config) =>
    ProfilePolylineBatch batch = newProfilePolylineBatch()
    for item in items
        if item.contentVisible
            processProfilePolylineBatch(state, batch, item.geometry, item.historical and not item.developing, includeHistogram, na, false, config)
    flushProfilePolylineBatch(state, batch, false, config)
    batch.completedCount

retainCompletedAnalyses(RenderState state, array<ProfileRenderItem> items) =>
    array<ProfileAnalysis> retained = array.new<ProfileAnalysis>()
    for item in items
        if not item.developing and item.contentVisible and item.geometry.source.key != SOURCE_FIXED and item.geometry.source.key != SOURCE_ROLLING
            array.push(retained, item.geometry.analysis)
    state.completedAnalyses := retained
    true

renderProfileItems(RenderState state, array<ProfileRenderItem> items, bool includeHistogram, array<SourceSpec> sources, BarContext context, PresentationConfig config) =>
    ProfilePolylineBatch batch = newProfilePolylineBatch()
    for item in items
        renderSelectedProfile(state, item.geometry, batch, item.primaryPlus, item.pairedHeadings, item.historical, item.developing, includeHistogram, state.cachedChartTimes, sources, context, config)
    flushProfilePolylineBatch(state, batch, true, config)
    retainCompletedAnalyses(state, items)
    true

focusSourceAllowed(string sourceName) =>
    sourceName != SOURCE_FIXED and sourceName != SOURCE_ROLLING

focusDateAllowsProfile(legilimensOrchestration.Profile profile, FocusSettings focus) =>
    bool dateBounded = focus.mode == FocusMode.date or focus.mode == FocusMode.priceAndDate
    not dateBounded or (not na(focus.dateTime) and profile.startTime <= focus.dateTime and (na(focus.startDateTime) or (focus.startDateTime <= focus.dateTime and profile.endTime > focus.startDateTime)))

focusPriceDistance(array<float> prices, FocusSettings focus) =>
    float nearest = na
    if not na(focus.anchorPrice)
        for levelPrice in prices
            bool directionMatches = focus.direction == FocusDirection.above ? levelPrice > focus.anchorPrice : focus.direction == FocusDirection.below ? levelPrice < focus.anchorPrice : focus.direction == FocusDirection.around
            if not na(levelPrice) and directionMatches
                float distance = math.abs(levelPrice - focus.anchorPrice)
                nearest := na(nearest) ? distance : math.min(nearest, distance)
    nearest

focusHistoryCutoff(array<SelectionBinding> bindings, string sourceName, int fallbackTime) =>
    int cutoffTime = na
    for binding in bindings
        if binding.source.key == sourceName
            cutoffTime := fallbackTime
            for profile in binding.selection.profiles
                cutoffTime := math.min(cutoffTime, profile.startTime)
    cutoffTime

focusCandidateOutranks(FocusCandidate candidate, FocusCandidate other) =>
    candidate.distance != other.distance ? candidate.distance < other.distance : candidate.archived.profile.endTime > other.archived.profile.endTime

retainFocusCandidate(array<FocusCandidate> ranked, FocusCandidate candidate, int capacity) =>
    int count = array.size(ranked)
    bool admitted = count < capacity
    if not admitted and count > 0
        admitted := focusCandidateOutranks(candidate, array.last(ranked))
    if admitted
        int insertAt = count
        if count > 0
            for candidateIndex = 0 to count - 1
                if focusCandidateOutranks(candidate, array.get(ranked, candidateIndex))
                    insertAt := candidateIndex
                    break
        array.insert(ranked, insertAt, candidate)
        if array.size(ranked) > capacity
            array.pop(ranked)
    admitted

focusOccurrenceKey(legilimensOrchestration.Profile profile, string sourceName) =>
    sourceName + ":" + str.tostring(legilimensOrchestration.tradingDayKey(legilimensOrchestration.nyMinuteBoundary(profile.startTime, NY_EARLY_END_MINUTE)))

focusComparisonIndices(array<FocusProfile> archive, bool extendedNyModeActive) =>
    map<string, int> indices = map.new<string, int>()
    if extendedNyModeActive and array.size(archive) > 0
        for archiveIndex = 0 to array.size(archive) - 1
            FocusProfile archived = array.get(archive, archiveIndex)
            if archived.sourceName == SOURCE_NY_EARLY or archived.sourceName == SOURCE_EXTENDED_NY_EARLY
                map.put(indices, focusOccurrenceKey(archived.profile, archived.sourceName), archiveIndex)
    indices

focusRenderDecision(FocusProfile archived, array<FocusProfile> archive, map<string, int> comparisonIndices, bool extendedNyModeActive, float tickSize) =>
    string counterpartName = archived.sourceName == SOURCE_NY_EARLY ? SOURCE_EXTENDED_NY_EARLY : archived.sourceName == SOURCE_EXTENDED_NY_EARLY ? SOURCE_NY_EARLY : ""
    array<legilimensOrchestration.Profile> comparisonProfiles = array.new<legilimensOrchestration.Profile>()
    if extendedNyModeActive and counterpartName != ""
        int counterpartIndex = map.get(comparisonIndices, focusOccurrenceKey(archived.profile, counterpartName))
        if not na(counterpartIndex)
            array.push(comparisonProfiles, array.get(archive, counterpartIndex).profile)
    legilimensOrchestration.ProfileSelection comparison = legilimensOrchestration.ProfileSelection.new(comparisonProfiles, -1, false)
    legilimensOrchestration.renderDecision(archived.profile, archived.sourceName, comparison, SOURCE_NY_EARLY, SOURCE_EXTENDED_NY_EARLY, NY_EARLY_END_MINUTE, extendedNyModeActive, tickSize)

focusedCandidates(array<FocusProfile> archive, array<SelectionBinding> bindings, int fallbackTime, FocusSettings focus, bool extendedNyModeActive, float tickSize) =>
    array<FocusCandidate> ranked = array.new<FocusCandidate>()
    if focus.mode != FocusMode.off and focus.extraProfiles > 0
        map<string, int> comparisonIndices = focusComparisonIndices(archive, extendedNyModeActive)
        bool dateFocusWithoutBase = focus.hideNonFocusProfiles and (focus.mode == FocusMode.date or focus.mode == FocusMode.priceAndDate)
        for archived in archive
            int cutoffTime = focusHistoryCutoff(bindings, archived.sourceName, fallbackTime)
            if dateFocusWithoutBase and not na(cutoffTime)
                cutoffTime := fallbackTime
            if focusSourceAllowed(archived.sourceName) and not na(cutoffTime) and archived.profile.startTime < cutoffTime and focusDateAllowsProfile(archived.profile, focus)
                float distance = focus.mode == FocusMode.date ? float(focus.dateTime - archived.profile.startTime) : focusPriceDistance(archived.prices, focus)
                if not na(distance)
                    legilimensOrchestration.RenderDecision decision = focusRenderDecision(archived, archive, comparisonIndices, extendedNyModeActive, tickSize)
                    if decision.shouldRender
                        retainFocusCandidate(ranked, FocusCandidate.new(archived, distance, decision.primaryPlus, decision.pairedHeadings), focus.extraProfiles)
    ranked

appendFocusedItems(RenderState state, array<ProfileRenderItem> items, array<FocusCandidate> candidates, array<SourceSpec> sources, int availablePolylines, bool preserveHistograms, PresentationConfig config) =>
    int capacity = maximumProfileCapacity(config.limits, config.delta, config.levels)
    for candidate in candidates
        if array.size(items) >= capacity
            break
        SourceSpec source = sourceSpec(sources, candidate.archived.sourceName)
        ProfilePolylineLayout geometry = profilePolylineLayout(candidate.archived.profile, source, profileAnalysis(state, candidate.archived.profile, source, true), state.cachedChartTimes, config)
        array.push(items, ProfileRenderItem.new(geometry, candidate.primaryPlus, candidate.pairedHeadings, true, false, true))
        if profilePolylineCost(state, items, preserveHistograms, config) > availablePolylines
            array.pop(items)
            break
    true

export renderSelections(RenderState state, array<SelectionBinding> bindings, bool hideDevelopingExtendedCounterpart, int currentNyEarlyStartTime, array<SourceSpec> sources, BarContext context, PresentationConfig config) =>
    prepareProfileAnalysisCache(state, context.barTime)
    array<FocusCandidate> candidates = focusedCandidates(state.focusProfiles, bindings, context.barTime, config.focus, config.extendedNyModeActive, context.tickSize)
    bool showRecentProfiles = config.focus.mode == FocusMode.off or not config.focus.hideNonFocusProfiles
    if showRecentProfiles
        trimBindings(bindings, maximumProfileCapacity(config.limits, config.delta, config.levels), config, context)
    if state.chartTimesBuiltAtBar != context.barIndex
        state.cachedChartTimes := recentChartTimes(context.barIndex)
        state.chartTimesBuiltAtBar := context.barIndex
    array<ProfilePolylineLayout> layouts = array.new<ProfilePolylineLayout>()
    array<ProfileRenderItem> items = array.new<ProfileRenderItem>()
    if showRecentProfiles
        items := profileRenderItems(state, bindings, layouts, hideDevelopingExtendedCounterpart, currentNyEarlyStartTime, state.cachedChartTimes, context, config)
    int availablePolylines = config.limits.polylines - array.size(state.drawnPolylines)
    while array.size(items) > 0 and profilePolylineCost(state, items, false, config) > availablePolylines
        int previousCount = array.size(items)
        trimBindings(bindings, previousCount - 1, config, context)
        items := profileRenderItems(state, bindings, layouts, hideDevelopingExtendedCounterpart, currentNyEarlyStartTime, state.cachedChartTimes, context, config)
        if array.size(items) >= previousCount
            break
    bool renderHistograms = config.delta.showHistogram and profilePolylineCost(state, items, true, config) <= availablePolylines
    if array.size(candidates) > 0
        appendFocusedItems(state, items, candidates, sources, availablePolylines, showRecentProfiles and renderHistograms, config)
        if not showRecentProfiles
            renderHistograms := config.delta.showHistogram and profilePolylineCost(state, items, true, config) <= availablePolylines
    renderProfileItems(state, items, renderHistograms, sources, context, config)
    true

export renderStandaloneProfile(RenderState state, legilimensOrchestration.Profile profile, bool developing, SourceSpec source, array<SourceSpec> sources, BarContext context, PresentationConfig config) =>
    if state.chartTimesBuiltAtBar != context.barIndex
        state.cachedChartTimes := recentChartTimes(context.barIndex)
        state.chartTimesBuiltAtBar := context.barIndex
    ProfilePolylineLayout geometry = profilePolylineLayout(profile, source, profileAnalysis(state, profile, source, false), state.cachedChartTimes, config)
    bool contentVisible = not developingControlled(source) or source.developingContentVisible
    array<ProfileRenderItem> items = array.from(ProfileRenderItem.new(geometry, false, false, false, developing, contentVisible))
    int availablePolylines = config.limits.polylines - array.size(state.drawnPolylines)
    bool renderHistogramAllowed = config.delta.showHistogram and profilePolylineCost(state, items, true, config) <= availablePolylines
    renderProfileItems(state, items, renderHistogramAllowed, sources, context, config)
    true

export registerProfileZones(RenderState state, legilimensOrchestration.Profile profile, SourceSpec source, array<SourceSpec> sources, BarContext context, PresentationConfig config) =>
    if mitigationEnabled(sources, source.key, config)
        int sessionCloseTime = sessionOccurrenceClose(source, profile, false, context)
        int levelEndTime = sessionLevelEndpoint(source, sessionCloseTime, context)
        int sessionTradingDayKey = legilimensOrchestration.tradingDayKey(sessionCloseTime)
        array<legilimensProfile.LowVolumeCandidate> candidates = config.delta.showLvnTiers ? legilimensProfile.selectLowVolumeCandidates(profile.data, config.delta.visibleLvnTierCount) : na
        renderLowVolumeStructures(state, profile, source, candidates, "", levelEndTime, sessionTradingDayKey, true, true, sources, context, config)
        if config.delta.showTiers
            array<float> strengths = legilimensProfile.computeRowStrengths(profile.data)
            array<legilimensProfile.OutlierPeak> outlierPeaks = legilimensProfile.collectOutlierPeaks(profile.data, strengths)
            queueOutlierPeaks(state, profile, source, outlierPeaks, "", levelEndTime, sessionTradingDayKey, true, config)
            [rankedLevels, _] = rankPendingOutlierLevels(state, context, config)
            renderRankedOutlierLevels(state, rankedLevels, true, sources, context, config)
    true

profileFocusPrices(legilimensOrchestration.Profile profile, SourceSpec source, BarContext context, PresentationConfig config) =>
    array<float> prices = array.new<float>()
    if config.delta.showTiers
        RenderState scratch = newRenderState()
        array<float> strengths = legilimensProfile.computeRowStrengths(profile.data)
        array<legilimensProfile.OutlierPeak> peaks = legilimensProfile.collectOutlierPeaks(profile.data, strengths)
        queueOutlierPeaks(scratch, profile, source, peaks, "", profile.endTime, legilimensOrchestration.tradingDayKey(profile.endTime), true, config)
        [rankedLevels, _] = rankPendingOutlierLevels(scratch, context, config)
        for ranked in rankedLevels
            if deltaTierSideVisible(ranked.buySide, config)
                array.push(prices, ranked.price)
    if config.delta.showLvnTiers
        array<legilimensProfile.LowVolumeCandidate> candidates = legilimensProfile.selectLowVolumeCandidates(profile.data, config.delta.visibleLvnTierCount)
        for candidate in candidates
            array.push(prices, candidate.isLvn ? (candidate.zoneLow + candidate.zoneHigh) * 0.5 : candidate.price)
    prices

cacheFocusProfile(RenderState state, legilimensOrchestration.Profile profile, SourceSpec source, BarContext context, PresentationConfig config) =>
    if focusDateAllowsProfile(profile, config.focus)
        array<float> prices = config.focus.mode == FocusMode.date ? array.new<float>() : profileFocusPrices(profile, source, context, config)
        array.push(state.focusProfiles, FocusProfile.new(profile, source.key, prices))
        int sourceCount = 0
        int oldestIndex = -1
        int count = array.size(state.focusProfiles)
        for profileIndex = 0 to count - 1
            if array.get(state.focusProfiles, profileIndex).sourceName == source.key
                sourceCount += 1
                if oldestIndex < 0
                    oldestIndex := profileIndex
        if sourceCount > config.focus.searchDepth
            FocusProfile expired = array.remove(state.focusProfiles, oldestIndex)
            removeMitigatedProfile(state, expired.sourceName, expired.profile.startTime)
            int keyIndex = array.size(state.mitigatedProfiles) - 1
            while keyIndex >= 0
                ZoneTrackingProfileKey profileKey = array.get(state.mitigatedProfiles, keyIndex)
                if profileKey.sourceName == expired.sourceName and profileKey.startTime == expired.profile.startTime
                    array.remove(state.mitigatedProfiles, keyIndex)
                keyIndex -= 1
    true

export registerFinalizedProfiles(RenderState state, legilimensOrchestration.AnchorState anchor, SourceSpec source, array<SourceSpec> sources, BarContext context, PresentationConfig config) =>
    int count = legilimensOrchestration.finalizedProfileCount(anchor)
    if count > 0
        bool collectFocus = config.focus.mode != FocusMode.off and focusSourceAllowed(source.key)
        bool collectZones = mitigationEnabled(sources, source.key, config)
        if collectFocus or collectZones
            for profileIndex = 0 to count - 1
                legilimensOrchestration.Profile profile = legilimensOrchestration.finalizedProfileAt(anchor, profileIndex)
                if collectFocus
                    cacheFocusProfile(state, profile, source, context, config)
                if collectZones
                    registerProfileZones(state, profile, source, sources, context, config)
        legilimensOrchestration.clearFinalizedProfiles(anchor)
    true

flushPendingMitigatedZones(RenderState state, BarContext context, PresentationConfig config) =>
    int count = array.size(state.pendingMitigatedZones)
    if count > 0
        for pendingIndex = 0 to count - 1
            PendingMitigatedZone pending = array.get(state.pendingMitigatedZones, pendingIndex)
            int rightTime = mitigatedZoneEndTime(state, pending.sourceName, pending.profileStartTime, pending.price, pending.eligibilityTime, context)
            if not na(rightTime)
                renderZoneFill(state, pending.leftTime, rightTime, pending.zoneLow, pending.zoneHigh, pending.zoneColor, pending.zoneBorderWidth, pending.zoneBorderColor, config)
                if pending.hasLine
                    queueRightLine(state, pending.price, pending.leftTime, rightTime, pending.lineColor, pending.lineWidth, pending.lineStyle, pending.lineRank, pending.sourceName, pending.tradingDayKey, pending.historical, pending.direction, context)
                queueLevelMarker(state, pending.price, levelMarkerTime(rightTime), pending.markerGlyph, pending.markerLabel, pending.markerColor, pending.markerSize, config)
        array.clear(state.pendingMitigatedZones)

export flushFrame(RenderState state, BarContext context, PresentationConfig config) =>
    flushPendingMitigatedZones(state, context, config)
    flushPendingRightLines(state, config, context)
    flushPendingRightLabels(state, config)
    true
