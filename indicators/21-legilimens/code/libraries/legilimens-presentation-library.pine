appearanceZoneColor(DeltaTierAppearance config) =>
    config.zoneColor

export type RenderState
    array<box> drawnBoxes
    array<line> drawnLines
    array<polyline> drawnPolylines
    array<label> drawnLabels
    array<PendingOutlierLevel> pendingOutlierLevels
    array<PendingMitigatedZone> pendingMitigatedZones
    array<PendingRightLabel> pendingRightLabels
    array<PendingRightLine> pendingRightLines
    array<MitigatedZoneState> mitigatedZoneStates
    array<ZoneTrackingProfileKey> mitigatedProfiles
    array<RoleReversalZoneState> roleReversalZoneStates
    array<ZoneTrackingProfileKey> roleReversalProfiles
    array<int> cachedChartTimes
    int chartTimesBuiltAtBar

export newRenderState() =>
    RenderState.new(array.new<box>(), array.new<line>(), array.new<polyline>(), array.new<label>(), array.new<PendingOutlierLevel>(), array.new<PendingMitigatedZone>(), array.new<PendingRightLabel>(), array.new<PendingRightLine>(), array.new<MitigatedZoneState>(), array.new<ZoneTrackingProfileKey>(), array.new<RoleReversalZoneState>(), array.new<ZoneTrackingProfileKey>(), array.new<int>(), -1)

sourceSpec(array<SourceSpec> sources, string sourceName) =>
    SourceSpec found = na
    int count = array.size(sources)
    if count > 0
        for sourceIndex = 0 to count - 1
            SourceSpec candidate = array.get(sources, sourceIndex)
            if na(found) and candidate.key == sourceName
                found := candidate
    found

developingControlled(SourceSpec source) =>
    source.key == SOURCE_NY_EARLY or source.key == SOURCE_EXTENDED_NY_EARLY or source.key == SOURCE_IVB or source.key == SOURCE_ASIA_PREMARKET or source.key == SOURCE_RTH or source.key == SOURCE_GLOBEX or source.key == SOURCE_MIDNIGHT

export developingProfileVisible(SourceSpec source, PresentationConfig config) =>
    not developingControlled(source) or source.developingContentVisible or config.showDevelopingShell

unmitigatedEligible(string sourceName) =>
    sourceName == SOURCE_FIXED or sourceName == SOURCE_ROLLING or sourceName == SOURCE_ASIA_PREMARKET or sourceName == SOURCE_GLOBEX or sourceName == SOURCE_MIDNIGHT or sourceName == SOURCE_WEEKLY or sourceName == SOURCE_MONTHLY

sourceSelected(array<SourceSpec> sources, string sourceName) =>
    SourceSpec source = sourceSpec(sources, sourceName)
    not na(source) and source.selected

mitigationEnabled(array<SourceSpec> sources, string sourceName, PresentationConfig config) =>
    config.interactions.extendUnmitigated and unmitigatedEligible(sourceName) and sourceSelected(sources, sourceName)

roleReversalEnabled(array<SourceSpec> sources, string sourceName, PresentationConfig config) =>
    config.interactions.showRoleReversal and sourceName != SOURCE_ROLLING and sourceSelected(sources, sourceName)

zoneTrackingEnabled(array<SourceSpec> sources, string sourceName, PresentationConfig config) =>
    mitigationEnabled(sources, sourceName, config) or roleReversalEnabled(sources, sourceName, config)

toLineStyle(string styleName) =>
    styleName == STYLE_DASHED ? line.style_dashed : styleName == STYLE_DOTTED ? line.style_dotted : line.style_solid

toLabelSize(string sizeName) =>
    sizeName == LABEL_SIZE_TINY ? size.tiny : size.small

labelPointSize(string sizeName) =>
    sizeName == LABEL_SIZE_TINY ? 7.0 : 10.0

quarterDurationValue(float duration) =>
    duration > 0 ? math.max(0.25, math.round(duration * 4.0) / 4.0) : 0.0

formatQuarterDuration(float duration) =>
    str.tostring(quarterDurationValue(duration), "#.##")

fixedRangeTradingDayDuration(int firstTime, int secondTime) =>
    int shiftedStartTime = math.min(firstTime, secondTime) + GLOBEX_REOPEN_SHIFT_MS
    int shiftedEndTime = math.max(firstTime, secondTime) + GLOBEX_REOPEN_SHIFT_MS
    int cursorDate = timestamp(NY_TIMEZONE, year(shiftedStartTime, NY_TIMEZONE), month(shiftedStartTime, NY_TIMEZONE), dayofmonth(shiftedStartTime, NY_TIMEZONE), 0, 0)
    float tradingDays = 0.0
    while cursorDate < shiftedEndTime
        int nextDate = timestamp(NY_TIMEZONE, year(cursorDate, NY_TIMEZONE), month(cursorDate, NY_TIMEZONE), dayofmonth(cursorDate, NY_TIMEZONE) + 1, 0, 0)
        int weekday = dayofweek(cursorDate, NY_TIMEZONE)
        if weekday >= dayofweek.monday and weekday <= dayofweek.friday
            int overlapStart = math.max(shiftedStartTime, cursorDate)
            int overlapEnd = math.min(shiftedEndTime, nextDate)
            if overlapEnd > overlapStart
                tradingDays += float(overlapEnd - overlapStart) / float(nextDate - cursorDate)
        cursorDate := nextDate
    tradingDays

export fixedRangeDisplayName(int firstTime, int secondTime, bool twentyFourSeven) =>
    int durationMs = math.abs(secondTime - firstTime)
    float durationMinutes = float(durationMs) / MS_PER_MINUTE
    float durationHours = float(durationMs) / MS_PER_HOUR
    float durationDays = durationHours / 24.0
    float displayedDays = twentyFourSeven ? durationDays : fixedRangeTradingDayDuration(firstTime, secondTime)
    string durationText = quarterDurationValue(durationHours) >= 24.0 ? formatQuarterDuration(displayedDays) + "-Day" : durationHours >= 1.0 or quarterDurationValue(durationMinutes) >= 60.0 ? formatQuarterDuration(durationHours) + "-Hour" : formatQuarterDuration(durationMinutes) + "-Minute"
    "🎯 " + durationText + " Fixed Range"

deltaPolylineLayersPerProfile(PresentationConfig config) =>
    int visibleSides = config.delta.visibleRows == OPTION_OFF ? 0 : config.delta.visibleRows == OPTION_ALL ? 2 : 1
    int layersPerSide = config.delta.rowFilter == OPTION_ALL ? DELTA_POLYLINE_LAYER_COUNT_PER_SIDE : 1
    visibleSides * layersPerSide

visibleDeltaTierSideCount(PresentationConfig config) =>
    config.delta.showTiers and config.delta.visibleTierSides != OPTION_OFF ? config.delta.visibleTierSides == OPTION_ALL ? 2 : 1 : 0

maximumCoreObjectCostsPerProfile(PresentationConfig config) =>
    int deltaTierSides = visibleDeltaTierSideCount(config)
    int lvnTierCount = config.delta.showLvnTiers ? config.delta.visibleLvnTierCount : 0
    int deltaTierCount = deltaTierSides * config.delta.visibleTierCount
    int referenceLineCount = (config.levels.showValueArea ? 2 : 0) + (config.levels.showPoc ? 1 : 0) + (config.levels.showMidpoint ? 1 : 0)
    int rightLineCount = lvnTierCount + deltaTierSides * math.min(2, config.delta.visibleTierCount)
    int pocLabelCount = config.levels.showPoc ? 1 : 0
    int midpointLabelCount = config.levels.showMidpoint ? 1 : 0
    int lvnMarkerLabelCount = config.delta.showDots ? lvnTierCount + (config.delta.showDotLabels and lvnTierCount > 0 ? 1 : 0) : 0
    int deltaMarkerLabelCount = config.delta.showDots ? deltaTierCount + (config.delta.showDotLabels ? deltaTierSides : 0) : 0
    int zoneBoxCount = lvnTierCount + deltaTierCount
    [referenceLineCount + rightLineCount, PROFILE_HEADING_LABEL_COUNT + pocLabelCount + midpointLabelCount + lvnMarkerLabelCount + deltaMarkerLabelCount, PROFILE_FRAME_BOX_COUNT + zoneBoxCount]

profileCapacityForObjectLimit(int objectLimit, int objectsPerProfile, int fallbackCapacity) =>
    objectsPerProfile > 0 ? int(math.floor(objectLimit / float(objectsPerProfile))) : fallbackCapacity

profileCapacity(int sourceCount, PresentationConfig config) =>
    int requestedCapacity = math.max(1, sourceCount) * config.interactions.retainedProfiles
    int deltaLayers = deltaPolylineLayersPerProfile(config)
    [linesPerProfile, labelsPerProfile, boxesPerProfile] = maximumCoreObjectCostsPerProfile(config)
    int capacity = requestedCapacity
    capacity := math.min(capacity, profileCapacityForObjectLimit(config.limits.polylines, deltaLayers, requestedCapacity))
    capacity := math.min(capacity, profileCapacityForObjectLimit(config.limits.lines, linesPerProfile, requestedCapacity))
    capacity := math.min(capacity, profileCapacityForObjectLimit(config.limits.labels, labelsPerProfile, requestedCapacity))
    capacity := math.min(capacity, profileCapacityForObjectLimit(config.limits.boxes, boxesPerProfile, requestedCapacity))
    capacity

canDrawBox(RenderState state, PresentationConfig config) =>
    array.size(state.drawnBoxes) < config.limits.boxes

canDrawLine(RenderState state, PresentationConfig config) =>
    array.size(state.drawnLines) < config.limits.lines

canDrawLabel(RenderState state, PresentationConfig config) =>
    array.size(state.drawnLabels) < config.limits.labels

canDrawPolyline(RenderState state, PresentationConfig config) =>
    array.size(state.drawnPolylines) < config.limits.polylines

export beginFrame(RenderState state) =>
    if array.size(state.drawnBoxes) > 0
        for drawingIndex = 0 to array.size(state.drawnBoxes) - 1
            box.delete(array.get(state.drawnBoxes, drawingIndex))
        array.clear(state.drawnBoxes)
    if array.size(state.drawnLines) > 0
        for drawingIndex = 0 to array.size(state.drawnLines) - 1
            line.delete(array.get(state.drawnLines, drawingIndex))
        array.clear(state.drawnLines)
    if array.size(state.drawnPolylines) > 0
        for drawingIndex = 0 to array.size(state.drawnPolylines) - 1
            polyline.delete(array.get(state.drawnPolylines, drawingIndex))
        array.clear(state.drawnPolylines)
    if array.size(state.drawnLabels) > 0
        for drawingIndex = 0 to array.size(state.drawnLabels) - 1
            label.delete(array.get(state.drawnLabels, drawingIndex))
        array.clear(state.drawnLabels)
    array.clear(state.pendingOutlierLevels)
    array.clear(state.pendingMitigatedZones)
    array.clear(state.pendingRightLabels)
    array.clear(state.pendingRightLines)
    true

queueLevelMarker(RenderState state, float price, int markerTime, string markerGlyph, string markerLabel, color markerColor, int markerSize, PresentationConfig config) =>
    if config.delta.showDots
        array.push(state.pendingRightLabels, PendingRightLabel.new(price, markerTime, markerGlyph, markerColor, markerSize, false))
        if markerLabel != ""
            array.push(state.pendingRightLabels, PendingRightLabel.new(price, markerTime, markerLabel, markerColor, DOT_LABEL_SIZE, true))

queueRightLine(RenderState state, float price, int leftTime, int rightTime, color lineColor, int lineWidth, string styleName, int rank, string sourceName, int sessionTradingDayKey, bool historical, int direction, BarContext context) =>
    bool historicalMergeGroup = historical or sessionTradingDayKey != legilimensOrchestration.tradingDayKey(context.barTime)
    array.push(state.pendingRightLines, PendingRightLine.new(price, leftTime, rightTime, lineColor, lineWidth, styleName, rank, sourceName, sessionTradingDayKey, historicalMergeGroup, direction))

renderZoneFill(RenderState state, int leftTime, int rightTime, float zoneLow, float zoneHigh, color zoneFillColor, int zoneBorderWidth, color highlightColor, PresentationConfig config) =>
    if canDrawBox(state, config)
        color borderColor = zoneBorderWidth > 0 ? highlightColor : color.new(zoneFillColor, 100)
        array.push(state.drawnBoxes, box.new(left=leftTime, top=zoneHigh, right=rightTime, bottom=zoneLow, xloc=xloc.bar_time, border_color=borderColor, border_width=zoneBorderWidth, bgcolor=zoneFillColor))

mitigatedZoneStateIndex(RenderState state, string sourceName, int profileStartTime, int eligibilityTime, float price) =>
    int foundIndex = -1
    int count = array.size(state.mitigatedZoneStates)
    if count > 0
        for stateIndex = 0 to count - 1
            MitigatedZoneState zoneState = array.get(state.mitigatedZoneStates, stateIndex)
            if zoneState.sourceName == sourceName and zoneState.profileStartTime == profileStartTime and zoneState.eligibilityTime == eligibilityTime and zoneState.price == price
                foundIndex := stateIndex
                break
    foundIndex

removeMitigatedProfile(RenderState state, string sourceName, int profileStartTime) =>
    int stateIndex = array.size(state.mitigatedZoneStates) - 1
    while stateIndex >= 0
        MitigatedZoneState zoneState = array.get(state.mitigatedZoneStates, stateIndex)
        if zoneState.sourceName == sourceName and zoneState.profileStartTime == profileStartTime
            array.remove(state.mitigatedZoneStates, stateIndex)
        stateIndex -= 1

export clearSourceInteractions(RenderState state, string sourceName) =>
    int stateIndex = array.size(state.mitigatedZoneStates) - 1
    while stateIndex >= 0
        if array.get(state.mitigatedZoneStates, stateIndex).sourceName == sourceName
            array.remove(state.mitigatedZoneStates, stateIndex)
        stateIndex -= 1
    int profileIndex = array.size(state.mitigatedProfiles) - 1
    while profileIndex >= 0
        if array.get(state.mitigatedProfiles, profileIndex).sourceName == sourceName
            array.remove(state.mitigatedProfiles, profileIndex)
        profileIndex -= 1
    true

registerZoneTrackingProfile(array<ZoneTrackingProfileKey> profileKeys, string sourceName, int profileStartTime, int retention) =>
    bool registered = false
    int count = array.size(profileKeys)
    if count > 0
        for profileIndex = 0 to count - 1
            ZoneTrackingProfileKey profileKey = array.get(profileKeys, profileIndex)
            if profileKey.sourceName == sourceName and profileKey.startTime == profileStartTime
                registered := true
                break
    int expiredProfileStartTime = na
    if not registered
        array.push(profileKeys, ZoneTrackingProfileKey.new(sourceName, profileStartTime))
        int sourceCount = 0
        for profileIndex = 0 to array.size(profileKeys) - 1
            if array.get(profileKeys, profileIndex).sourceName == sourceName
                sourceCount += 1
        if sourceCount > retention
            int oldestIndex = -1
            int oldestStartTime = na
            for profileIndex = 0 to array.size(profileKeys) - 1
                ZoneTrackingProfileKey profileKey = array.get(profileKeys, profileIndex)
                if profileKey.sourceName == sourceName and (oldestIndex < 0 or profileKey.startTime < oldestStartTime)
                    oldestIndex := profileIndex
                    oldestStartTime := profileKey.startTime
            if oldestIndex >= 0
                expiredProfileStartTime := oldestStartTime
                array.remove(profileKeys, oldestIndex)
    expiredProfileStartTime

registerMitigatedZone(RenderState state, string sourceName, int profileStartTime, int eligibilityTime, float price, PresentationConfig config) =>
    int expiredProfileStartTime = registerZoneTrackingProfile(state.mitigatedProfiles, sourceName, profileStartTime, config.interactions.retainedProfiles)
    if not na(expiredProfileStartTime)
        removeMitigatedProfile(state, sourceName, expiredProfileStartTime)
    if mitigatedZoneStateIndex(state, sourceName, profileStartTime, eligibilityTime, price) < 0
        array.push(state.mitigatedZoneStates, MitigatedZoneState.new(sourceName, profileStartTime, eligibilityTime, price, na, true))

roleReversalZoneStateIndex(RenderState state, string sourceName, int profileStartTime, float price, int originalDirection) =>
    int foundIndex = -1
    int count = array.size(state.roleReversalZoneStates)
    if count > 0
        for stateIndex = 0 to count - 1
            RoleReversalZoneState zoneState = array.get(state.roleReversalZoneStates, stateIndex)
            if zoneState.sourceName == sourceName and zoneState.profileStartTime == profileStartTime and zoneState.price == price and zoneState.originalDirection == originalDirection
                foundIndex := stateIndex
                break
    foundIndex

removeRoleReversalProfile(RenderState state, string sourceName, int profileStartTime) =>
    int stateIndex = array.size(state.roleReversalZoneStates) - 1
    while stateIndex >= 0
        RoleReversalZoneState zoneState = array.get(state.roleReversalZoneStates, stateIndex)
        if zoneState.sourceName == sourceName and zoneState.profileStartTime == profileStartTime
            array.remove(state.roleReversalZoneStates, stateIndex)
        stateIndex -= 1

registerRoleReversalZone(RenderState state, string sourceName, int profileStartTime, int eligibilityTime, int expirationTime, float price, float zoneLow, float zoneHigh, int originalDirection, bool extendsUntilMitigated, PresentationConfig config) =>
    int expiredProfileStartTime = registerZoneTrackingProfile(state.roleReversalProfiles, sourceName, profileStartTime, config.interactions.retainedProfiles)
    if not na(expiredProfileStartTime)
        removeRoleReversalProfile(state, sourceName, expiredProfileStartTime)
    int stateIndex = roleReversalZoneStateIndex(state, sourceName, profileStartTime, price, originalDirection)
    if stateIndex < 0
        array.push(state.roleReversalZoneStates, RoleReversalZoneState.new(sourceName, profileStartTime, eligibilityTime, expirationTime, price, zoneLow, zoneHigh, originalDirection, extendsUntilMitigated, false, false, false))
    else
        RoleReversalZoneState zoneState = array.get(state.roleReversalZoneStates, stateIndex)
        zoneState.eligibilityTime := eligibilityTime
        zoneState.expirationTime := expirationTime
        zoneState.zoneLow := zoneLow
        zoneState.zoneHigh := zoneHigh
        zoneState.extendsUntilMitigated := extendsUntilMitigated
        array.set(state.roleReversalZoneStates, stateIndex, zoneState)

roleReversalZoneIsReversed(RenderState state, string sourceName, int profileStartTime, float price, int originalDirection) =>
    int stateIndex = roleReversalZoneStateIndex(state, sourceName, profileStartTime, price, originalDirection)
    stateIndex >= 0 and array.get(state.roleReversalZoneStates, stateIndex).reversed

flushPendingRightLines(RenderState state, PresentationConfig config, BarContext context) =>
    int pendingCount = array.size(state.pendingRightLines)
    if pendingCount > 0
        array<PendingRightLine> clusters = array.new<PendingRightLine>()
        for pendingIndex = 0 to pendingCount - 1
            PendingRightLine pending = array.get(state.pendingRightLines, pendingIndex)
            float tolerance = math.max(context.tickSize, math.abs(pending.price) * config.levels.mergeDistancePercent / 100.0)
            int foundIndex = -1
            float minimumDistance = tolerance + context.tickSize
            int clusterCount = array.size(clusters)
            if config.levels.mergeOverlaps and clusterCount > 0
                for clusterIndex = 0 to clusterCount - 1
                    PendingRightLine cluster = array.get(clusters, clusterIndex)
                    float distance = math.abs(cluster.price - pending.price)
                    bool sameSource = cluster.sourceName == pending.sourceName
                    bool sameOccurrence = cluster.tradingDayKey == pending.tradingDayKey and cluster.historical == pending.historical
                    bool sameEndpoint = cluster.rightTime == pending.rightTime
                    bool compatibleDirection = cluster.direction == 0 or pending.direction == 0 or cluster.direction == pending.direction
                    if sameSource and sameOccurrence and sameEndpoint and compatibleDirection and distance <= tolerance and distance < minimumDistance
                        minimumDistance := distance
                        foundIndex := clusterIndex
            if foundIndex >= 0
                PendingRightLine cluster = array.get(clusters, foundIndex)
                cluster.leftTime := math.min(cluster.leftTime, pending.leftTime)
                cluster.rightTime := math.max(cluster.rightTime, pending.rightTime)
                if cluster.direction == 0 and pending.direction != 0
                    cluster.direction := pending.direction
                if pending.rank > cluster.rank
                    cluster.price := pending.price
                    cluster.lineColor := pending.lineColor
                    cluster.lineWidth := pending.lineWidth
                    cluster.styleName := pending.styleName
                    cluster.rank := pending.rank
            else
                array.push(clusters, PendingRightLine.new(pending.price, pending.leftTime, pending.rightTime, pending.lineColor, pending.lineWidth, pending.styleName, pending.rank, pending.sourceName, pending.tradingDayKey, pending.historical, pending.direction))
        for clusterIndex = 0 to array.size(clusters) - 1
            PendingRightLine cluster = array.get(clusters, clusterIndex)
            if canDrawLine(state, config)
                array.push(state.drawnLines, line.new(cluster.leftTime, cluster.price, cluster.rightTime, cluster.price, xloc=xloc.bar_time, color=cluster.lineColor, style=toLineStyle(cluster.styleName), width=cluster.lineWidth))
        array.clear(state.pendingRightLines)

flushPendingRightLabels(RenderState state, PresentationConfig config) =>
    int pendingCount = array.size(state.pendingRightLabels)
    if pendingCount > 0
        for pendingIndex = 0 to pendingCount - 1
            PendingRightLabel pending = array.get(state.pendingRightLabels, pendingIndex)
            string labelStyle = pending.sessionText ? label.style_label_left : label.style_none
            string textAlignment = pending.sessionText ? text.align_left : text.align_center
            if canDrawLabel(state, config)
                array.push(state.drawnLabels, label.new(pending.markerTime, pending.price, pending.labelText, xloc=xloc.bar_time, yloc=yloc.price, style=labelStyle, textcolor=pending.textColor, size=pending.textSize, color=color.new(color.white, 100), textalign=textAlignment))
        array.clear(state.pendingRightLabels)

usesGlobexPalette(string sourceName) =>
    sourceName == SOURCE_GLOBEX or sourceName == SOURCE_MIDNIGHT

profileOuterColor(string sourceName) =>
    sourceName == SOURCE_NY_EARLY ? color.new(color.rgb(128, 222, 234), 94) : sourceName == SOURCE_EXTENDED_NY_EARLY ? color.new(color.rgb(76, 65, 245), 94) : sourceName == SOURCE_IVB ? color.new(color.rgb(245, 65, 240), 95) : sourceName == SOURCE_ASIA_PREMARKET ? color.new(color.rgb(165, 214, 167), 70) : sourceName == SOURCE_RTH ? color.new(color.rgb(41, 98, 255), 90) : usesGlobexPalette(sourceName) ? color.new(color.rgb(233, 30, 99), 90) : sourceName == SOURCE_WEEKLY ? color.new(color.rgb(156, 39, 176), 90) : sourceName == SOURCE_MONTHLY ? color.new(color.rgb(223, 107, 12), 85) : sourceName == SOURCE_ROLLING ? color.new(color.rgb(248, 187, 208), 75) : color.new(color.rgb(187, 217, 251), 70)

profileInnerColor(string sourceName) =>
    sourceName == SOURCE_NY_EARLY ? color.new(color.rgb(128, 222, 234), 50) : sourceName == SOURCE_EXTENDED_NY_EARLY ? color.new(color.rgb(76, 65, 245), 88) : sourceName == SOURCE_IVB ? color.new(color.rgb(249, 121, 246), 55) : sourceName == SOURCE_ASIA_PREMARKET ? color.new(color.rgb(56, 142, 60), 82) : sourceName == SOURCE_RTH ? color.new(color.rgb(144, 191, 249), 30) : usesGlobexPalette(sourceName) ? color.new(color.rgb(248, 187, 208), 30) : sourceName == SOURCE_WEEKLY ? color.new(color.rgb(156, 39, 176), 88) : sourceName == SOURCE_MONTHLY ? color.new(color.rgb(255, 152, 0), 20) : sourceName == SOURCE_ROLLING ? color.new(color.rgb(248, 187, 208), 30) : color.new(color.rgb(187, 217, 251), 30)

profileRangeLabelColor(string sourceName) =>
    sourceName == SOURCE_NY_EARLY ? color.new(color.rgb(0, 188, 212), 9) : sourceName == SOURCE_EXTENDED_NY_EARLY ? color.new(color.rgb(76, 65, 245), 9) : sourceName == SOURCE_IVB ? color.new(color.rgb(245, 65, 240), 20) : sourceName == SOURCE_ASIA_PREMARKET ? color.new(color.rgb(56, 142, 60), 5) : sourceName == SOURCE_RTH ? color.new(color.rgb(48, 79, 254), 30) : usesGlobexPalette(sourceName) ? color.new(color.rgb(211, 47, 47), 30) : sourceName == SOURCE_WEEKLY ? color.new(color.rgb(123, 31, 162), 30) : sourceName == SOURCE_MONTHLY ? color.new(color.rgb(239, 108, 0), 30) : sourceName == SOURCE_ROLLING ? color.new(color.rgb(173, 20, 87), 30) : color.new(color.rgb(41, 98, 255), 30)

profileRangeLabelSize(string sourceName) =>
    sourceName == SOURCE_NY_EARLY or sourceName == SOURCE_EXTENDED_NY_EARLY or sourceName == SOURCE_IVB or sourceName == SOURCE_ASIA_PREMARKET or sourceName == SOURCE_RTH ? LABEL_SIZE_TINY : LABEL_SIZE_SMALL

profileDeltaPlusColor(SourceSpec source) =>
    source.alternateStyles ? color.new(color.rgb(76, 175, 80), 15) : color.new(#43c59e, 62)

profileDeltaMinusColor(SourceSpec source) =>
    source.alternateStyles ? color.new(color.rgb(242, 54, 69), 15) : color.new(#e86b78, 62)

profileDeltaPlusPlusColor(SourceSpec source) =>
    source.alternateStyles ? color.rgb(56, 142, 60) : color.new(#0f9e6e, 30)

profileDeltaMinusMinusColor(SourceSpec source) =>
    source.alternateStyles ? color.rgb(178, 40, 51) : color.new(#d61f4a, 30)

profileValueAreaLevelColor(string sourceName) =>
    sourceName == SOURCE_NY_EARLY ? color.new(color.rgb(38, 198, 218), 55) : sourceName == SOURCE_EXTENDED_NY_EARLY ? color.new(color.rgb(76, 65, 245), 70) : sourceName == SOURCE_IVB ? color.new(color.rgb(233, 30, 99), 45) : sourceName == SOURCE_ASIA_PREMARKET ? color.new(color.rgb(255, 183, 77), 60) : sourceName == SOURCE_RTH ? color.new(color.rgb(144, 191, 249), 55) : usesGlobexPalette(sourceName) ? color.new(color.rgb(255, 235, 59), 20) : sourceName == SOURCE_WEEKLY ? color.new(color.rgb(186, 104, 200), 55) : sourceName == SOURCE_MONTHLY ? color.new(color.rgb(255, 152, 0), 55) : color.new(color.rgb(255, 235, 59), 20)

profileTextBackgroundColor(SourceSpec source) =>
    source.alternateStyles ? color.new(color.rgb(249, 248, 248), 25) : color.new(color.rgb(249, 248, 248), 20)

deltaTierAppearance(bool buySide, int tier, SourceSpec source) =>
    int tierIndex = math.max(0, math.min(4, 5 - tier))
    bool dominant = tierIndex == 0
    bool strong = tierIndex == 1
    bool hasLine = dominant or strong
    int lineWidth = dominant ? DELTA_TIER_5_LINE_WIDTH : strong ? DELTA_TIER_4_LINE_WIDTH : 1
    string lineStyle = hasLine ? STYLE_DASHED : STYLE_SOLID
    color lineColor = color(na)
    color textColor = color(na)
    color zoneColor = color(na)
    if source.alternateStyles
        color baseColor = buySide ? color.rgb(56, 142, 60) : color.rgb(178, 40, 51)
        lineColor := hasLine ? color.new(baseColor, 30) : color(na)
        textColor := baseColor
        zoneColor := color.new(baseColor, 92)
    else if buySide
        lineColor := dominant ? color.new(color.rgb(0, 255, 0), 10) : strong ? color.new(color.rgb(56, 142, 60), 30) : color(na)
        textColor := dominant ? color.rgb(77, 243, 8) : strong ? color.new(color.rgb(77, 243, 8), 10) : tierIndex == 3 ? color.new(color.rgb(114, 243, 114), 30) : tierIndex == 4 ? color.new(color.rgb(163, 218, 165), 20) : color.new(color.rgb(163, 218, 165), 10)
        zoneColor := color.new(color.rgb(114, 243, 114), dominant ? 85 : strong ? 88 : 90)
    else
        lineColor := dominant ? color.new(color.rgb(245, 65, 81), 10) : strong ? color.new(color.rgb(178, 40, 51), 30) : color(na)
        textColor := dominant ? color.rgb(249, 121, 246) : strong ? color.new(color.rgb(249, 121, 246), 10) : tierIndex == 4 ? color.new(color.rgb(128, 25, 34), 92) : color.new(color.rgb(249, 121, 246), 30)
        zoneColor := color.new(color.rgb(249, 121, 246), dominant ? 82 : strong ? 88 : 90)
    DeltaTierAppearance.new(hasLine, lineColor, lineWidth, lineStyle, textColor, zoneColor)

tierMarkerSize(int tier) =>
    tier == 5 ? 12 : tier == 4 ? 9 : tier == 3 ? 7 : tier == 2 ? 6 : 5

deltaTierSideVisible(bool buySide, PresentationConfig config) =>
    config.delta.visibleTierSides != OPTION_OFF and (config.delta.visibleTierSides == OPTION_ALL or (buySide and config.delta.visibleTierSides == DELTA_TIER_VISIBILITY_BUY) or (not buySide and config.delta.visibleTierSides == DELTA_TIER_VISIBILITY_SELL))

deltaTierFibLocationGrade(bool buySide, float tierPrice, float rangeLow, float rangeHigh) =>
    int grade = FIB_LOCATION_UNKNOWN
    float profileRange = rangeHigh - rangeLow
    if not na(tierPrice) and not na(rangeLow) and not na(rangeHigh) and profileRange > 0
        float fibPosition = (tierPrice - rangeLow) / profileRange
        bool veryStrong = buySide ? fibPosition < FIB_LOCATION_BUY_PREFERRED_LOW : fibPosition > FIB_LOCATION_SELL_PREFERRED_HIGH
        bool preferred = buySide ? fibPosition >= FIB_LOCATION_BUY_PREFERRED_LOW and fibPosition <= FIB_LOCATION_BUY_PREFERRED_HIGH : fibPosition >= FIB_LOCATION_SELL_PREFERRED_LOW and fibPosition <= FIB_LOCATION_SELL_PREFERRED_HIGH
        bool qualified = buySide ? fibPosition <= FIB_LOCATION_MIDPOINT : fibPosition >= FIB_LOCATION_MIDPOINT
        grade := veryStrong ? FIB_LOCATION_VERY_STRONG : preferred ? FIB_LOCATION_PREFERRED : qualified ? FIB_LOCATION_QUALIFIED : FIB_LOCATION_CONTRADICTORY
    grade

fibLocationMarkerGlyph(int grade) =>
    grade == FIB_LOCATION_VERY_STRONG ? FIB_LOCATION_VERY_STRONG_MARKER_GLYPH : grade == FIB_LOCATION_PREFERRED ? FIB_LOCATION_PREFERRED_MARKER_GLYPH : LEVEL_MARKER_GLYPH

contrastChannel(float channel, float ratio, bool darken) =>
    darken ? channel * (1.0 - ratio) : channel + (255.0 - channel) * ratio

fibQualificationColor(color sourceColor, bool qualified) =>
    float ratio = (qualified ? 15 : 5) / 100.0
    bool darken = qualified
    color.rgb(int(math.round(contrastChannel(color.r(sourceColor), ratio, darken))), int(math.round(contrastChannel(color.g(sourceColor), ratio, darken))), int(math.round(contrastChannel(color.b(sourceColor), ratio, darken))), color.t(sourceColor))

barSpanMs() =>
    int spanMs = nz(timeframe.in_seconds(timeframe.period)) * 1000
    if spanMs <= 0
        for lookback = 0 to OFFSET_SPAN_LOOKBACK - 1
            int gap = nz(time[lookback] - time[lookback + 1])
            if gap > 0 and (spanMs <= 0 or gap < spanMs)
                spanMs := gap
    math.max(1, spanMs)

recentChartTimes(int currentBarIndex) =>
    array<int> chartTimes = array.new<int>()
    int offset = math.min(currentBarIndex, PROFILE_TIME_SCALE_MAX_LOOKBACK)
    while offset >= 0
        array.push(chartTimes, time[offset])
        offset -= 1
    chartTimes

nearestChartTimeIndex(array<int> chartTimes, int targetTime) =>
    int count = array.size(chartTimes)
    int result = -1
    if count > 0 and targetTime >= array.get(chartTimes, 0) and targetTime <= array.get(chartTimes, count - 1)
        int lowIndex = 0
        int highIndex = count - 1
        while lowIndex <= highIndex
            int middleIndex = int(math.floor((lowIndex + highIndex) * 0.5))
            int middleTime = array.get(chartTimes, middleIndex)
            if middleTime < targetTime
                result := middleIndex
                lowIndex := middleIndex + 1
            else if middleTime > targetTime
                highIndex := middleIndex - 1
            else
                result := middleIndex
                lowIndex := highIndex + 1
        if result < 0
            result := 0
        if result < count - 1 and math.abs(array.get(chartTimes, result + 1) - targetTime) < math.abs(array.get(chartTimes, result) - targetTime)
            result += 1
    result

chartTimeAtOffset(array<int> chartTimes, int baselineIndex, int stepOffset) =>
    int count = array.size(chartTimes)
    int outerIndex = baselineIndex + stepOffset
    int outerTime = na
    if outerIndex >= 0 and outerIndex < count
        outerTime := array.get(chartTimes, outerIndex)
    else
        int overflowSteps = outerIndex < 0 ? outerIndex : outerIndex - (count - 1)
        int edgeTime = outerIndex < 0 ? array.get(chartTimes, 0) : array.get(chartTimes, count - 1)
        outerTime := edgeTime + overflowSteps * barSpanMs()
    outerTime

profileBaselineTime(legilimensOrchestration.Profile profile, array<int> chartTimes, int baselineIndex, bool attachRight) =>
    int count = array.size(chartTimes)
    baselineIndex >= 0 and baselineIndex < count ? array.get(chartTimes, baselineIndex) : attachRight ? profile.endTime : profile.startTime

profileOuterTime(legilimensOrchestration.Profile profile, array<int> chartTimes, int baselineIndex, int rangeSteps, float magnitudeRatio, int widthPercent, bool faceLeft, bool attachRight) =>
    float ratio = math.max(0.0, math.min(1.0, magnitudeRatio))
    int baselineTime = profileBaselineTime(profile, chartTimes, baselineIndex, attachRight)
    int outerTime = baselineTime
    if ratio > 0
        if array.size(chartTimes) > 1 and baselineIndex >= 0
            int maximumSteps = math.max(1, int(math.round(rangeSteps * widthPercent * 0.01)))
            outerTime := chartTimeAtOffset(chartTimes, baselineIndex, faceLeft ? -math.max(1, int(math.round(ratio * maximumSteps))) : math.max(1, int(math.round(ratio * maximumSteps))))
        else
            int widthMs = math.max(1, int(math.round(math.max(1, profile.endTime - profile.startTime) * widthPercent * 0.01 * ratio)))
            outerTime := baselineTime + (faceLeft ? -widthMs : widthMs)
    outerTime

deltaOuterTime(legilimensOrchestration.Profile profile, array<int> chartTimes, int startScaleIndex, int endScaleIndex, int baselineIndex, float magnitudeRatio, int widthBars, bool faceLeft, bool attachRight) =>
    int baselineTime = profileBaselineTime(profile, chartTimes, baselineIndex, attachRight)
    float ratio = math.max(0.0, math.min(1.0, magnitudeRatio))
    bool completeScale = startScaleIndex >= 0 and endScaleIndex >= 0
    int profileSteps = completeScale ? math.max(1, math.abs(endScaleIndex - startScaleIndex)) : widthBars
    int rowSteps = math.max(1, int(math.round(ratio * math.min(widthBars, profileSteps))))
    if array.size(chartTimes) > 1 and baselineIndex >= 0
        chartTimeAtOffset(chartTimes, baselineIndex, faceLeft ? -rowSteps : rowSteps)
    else
        int maximumWidth = math.min(math.max(1, profile.endTime - profile.startTime), barSpanMs() * widthBars)
        baselineTime + (faceLeft ? -math.max(1, int(math.round(maximumWidth * ratio))) : math.max(1, int(math.round(maximumWidth * ratio))))

mitigationWindowStartMinute(string windowMode) =>
    windowMode == WINDOW_LABEL_FROM_0500 ? ROLLING_CUTOFF_0500_MINUTE : windowMode == WINDOW_LABEL_FROM_0830 ? ROLLING_CUTOFF_0830_MINUTE : ROLLING_CUTOFF_0930_MINUTE

mitigationWindowAllowsSample(string windowMode, int sampleTime, int sampleEndTime, bool twentyFourSeven) =>
    int startMinute = mitigationWindowStartMinute(windowMode)
    windowMode == MITIGATION_WINDOW_ANYTIME or ((twentyFourSeven or legilimensOrchestration.isNyWeekday(sampleTime)) and legilimensOrchestration.barFitsNyMinuteWindow(sampleTime, sampleEndTime, startMinute, ROLLING_CUTOFF_1600_MINUTE))

mitigationWindowBounds(string windowMode, int startTime, int endTime, bool twentyFourSeven) =>
    int activeStart = na
    int activeEnd = na
    if startTime < endTime
        if windowMode == MITIGATION_WINDOW_ANYTIME
            activeStart := startTime
            activeEnd := endTime
        else
            int cursorTime = startTime
            while cursorTime < endTime
                int sessionStart = legilimensOrchestration.nyMinuteBoundary(cursorTime, mitigationWindowStartMinute(windowMode))
                int sessionEnd = legilimensOrchestration.nyMinuteBoundary(cursorTime, ROLLING_CUTOFF_1600_MINUTE)
                int overlapStart = math.max(startTime, sessionStart)
                int overlapEnd = math.min(endTime, sessionEnd)
                if overlapStart < overlapEnd and (twentyFourSeven or legilimensOrchestration.isNyWeekday(cursorTime))
                    activeStart := na(activeStart) ? overlapStart : activeStart
                    activeEnd := overlapEnd
                cursorTime := timestamp(NY_TIMEZONE, year(cursorTime, NY_TIMEZONE), month(cursorTime, NY_TIMEZONE), dayofmonth(cursorTime, NY_TIMEZONE) + 1, 0, 0)
    array.from(activeStart, activeEnd)

mitigatedZoneEndTime(RenderState state, string sourceName, int profileStartTime, float price, int eligibilityTime, BarContext context) =>
    int zoneEndTime = eligibilityTime
    int stateIndex = mitigatedZoneStateIndex(state, sourceName, profileStartTime, eligibilityTime, price)
    if stateIndex >= 0
        MitigatedZoneState zoneState = array.get(state.mitigatedZoneStates, stateIndex)
        zoneEndTime := zoneState.available ? na(zoneState.mitigatedTime) ? math.max(eligibilityTime, context.barEndTime) : zoneState.mitigatedTime : eligibilityTime
    zoneEndTime

advanceRoleReversalState(RoleReversalZoneState zoneState, float sampleOpen, float sampleHigh, float sampleLow, float sampleClose) =>
    if not zoneState.reversed and not na(sampleOpen) and not na(sampleHigh) and not na(sampleLow) and not na(sampleClose)
        bool originalSideObserved = zoneState.originalDirection < 0 ? sampleOpen <= zoneState.zoneLow or sampleClose <= zoneState.zoneLow : sampleOpen >= zoneState.zoneHigh or sampleClose >= zoneState.zoneHigh
        zoneState.armed := zoneState.armed or originalSideObserved
        bool zoneTouched = sampleHigh >= zoneState.zoneLow and sampleLow <= zoneState.zoneHigh
        zoneState.interacted := zoneState.interacted or zoneState.armed and zoneTouched
        bool broken = zoneState.originalDirection < 0 ? sampleClose > zoneState.zoneHigh : sampleClose < zoneState.zoneLow
        zoneState.reversed := zoneState.interacted and broken
    zoneState

advanceRoleReversalFromSamples(RoleReversalZoneState zoneState, PriceSamples samples, int activeEndTime) =>
    int sampleCount = math.min(math.min(math.min(array.size(samples.startTimes), array.size(samples.endTimes)), math.min(array.size(samples.opens), array.size(samples.highs))), math.min(array.size(samples.lows), array.size(samples.closes)))
    if sampleCount > 0
        for sampleIndex = 0 to sampleCount - 1
            int sampleTime = array.get(samples.startTimes, sampleIndex)
            int sampleEndTime = array.get(samples.endTimes, sampleIndex)
            if sampleTime >= zoneState.eligibilityTime and sampleEndTime <= activeEndTime
                advanceRoleReversalState(zoneState, array.get(samples.opens, sampleIndex), array.get(samples.highs, sampleIndex), array.get(samples.lows, sampleIndex), array.get(samples.closes, sampleIndex))
    zoneState

firstIntrabarTouchEnd(PriceSamples samples, int eligibilityTime, float price, string windowMode, bool twentyFourSeven) =>
    int touchEndTime = na
    int sampleCount = math.min(math.min(array.size(samples.startTimes), array.size(samples.endTimes)), math.min(array.size(samples.highs), array.size(samples.lows)))
    if sampleCount > 0
        for sampleIndex = 0 to sampleCount - 1
            int sampleTime = array.get(samples.startTimes, sampleIndex)
            int sampleEndTime = array.get(samples.endTimes, sampleIndex)
            float sampleHigh = array.get(samples.highs, sampleIndex)
            float sampleLow = array.get(samples.lows, sampleIndex)
            bool eligible = sampleTime >= eligibilityTime and sampleEndTime > eligibilityTime and mitigationWindowAllowsSample(windowMode, sampleTime, sampleEndTime, twentyFourSeven)
            if na(touchEndTime) and eligible and not na(sampleHigh) and not na(sampleLow) and sampleLow <= price and sampleHigh >= price
                touchEndTime := sampleEndTime
    touchEndTime

boundaryCoverageComplete(PriceSamples samples, int eligibilityTime, int barEndTime) =>
    int firstEligibleTime = na
    int lastEligibleEndTime = na
    int sampleCount = math.min(array.size(samples.startTimes), array.size(samples.endTimes))
    if sampleCount > 0
        for sampleIndex = 0 to sampleCount - 1
            int sampleTime = array.get(samples.startTimes, sampleIndex)
            int sampleEndTime = array.get(samples.endTimes, sampleIndex)
            if sampleTime >= eligibilityTime and sampleEndTime > eligibilityTime
                firstEligibleTime := na(firstEligibleTime) ? sampleTime : math.min(firstEligibleTime, sampleTime)
                lastEligibleEndTime := na(lastEligibleEndTime) ? sampleEndTime : math.max(lastEligibleEndTime, sampleEndTime)
    not na(firstEligibleTime) and firstEligibleTime <= eligibilityTime and lastEligibleEndTime >= barEndTime

intrabarBoundaryIsPrecise(string intrabarTimeframe, int boundaryTime) =>
    intrabarTimeframe == "1S" or boundaryTime % MS_PER_MINUTE == 0 and intrabarTimeframe == "1"

includeBoundaryRequest(string requestedTimeframe, int boundaryTime) =>
    boundaryTime % MS_PER_MINUTE == 0 and requestedTimeframe != "1S" ? "1" : "1S"

export requiredBoundaryTimeframe(RenderState state, string intrabarTimeframe, BarContext context, PresentationConfig config) =>
    string requestedTimeframe = ""
    int mitigatedCount = array.size(state.mitigatedZoneStates)
    if mitigatedCount > 0
        for stateIndex = 0 to mitigatedCount - 1
            MitigatedZoneState zoneState = array.get(state.mitigatedZoneStates, stateIndex)
            bool chartBarTouches = not na(context.barHigh) and not na(context.barLow) and context.barLow <= zoneState.price and context.barHigh >= zoneState.price
            if zoneState.available and na(zoneState.mitigatedTime) and chartBarTouches and context.barEndTime > zoneState.eligibilityTime
                array<int> activeBounds = mitigationWindowBounds(config.interactions.mitigationWindow, math.max(context.barTime, zoneState.eligibilityTime), context.barEndTime, context.twentyFourSeven)
                int activeStartTime = array.get(activeBounds, MITIGATION_WINDOW_START_INDEX)
                int activeEndTime = array.get(activeBounds, MITIGATION_WINDOW_END_INDEX)
                if not na(activeStartTime)
                    if activeStartTime > context.barTime and not intrabarBoundaryIsPrecise(intrabarTimeframe, activeStartTime)
                        requestedTimeframe := includeBoundaryRequest(requestedTimeframe, activeStartTime)
                    if activeEndTime < context.barEndTime and not intrabarBoundaryIsPrecise(intrabarTimeframe, activeEndTime)
                        requestedTimeframe := includeBoundaryRequest(requestedTimeframe, activeEndTime)
    int roleCount = array.size(state.roleReversalZoneStates)
    if config.interactions.showRoleReversal and roleCount > 0
        for stateIndex = 0 to roleCount - 1
            RoleReversalZoneState zoneState = array.get(state.roleReversalZoneStates, stateIndex)
            int activeEndTime = zoneState.extendsUntilMitigated ? mitigatedZoneEndTime(state, zoneState.sourceName, zoneState.profileStartTime, zoneState.price, zoneState.expirationTime, context) : zoneState.expirationTime
            bool overlaps = context.barEndTime > zoneState.eligibilityTime and context.barTime < activeEndTime
            if not zoneState.reversed and overlaps
                if context.barTime < zoneState.eligibilityTime and context.barEndTime > zoneState.eligibilityTime and not intrabarBoundaryIsPrecise(intrabarTimeframe, zoneState.eligibilityTime)
                    requestedTimeframe := includeBoundaryRequest(requestedTimeframe, zoneState.eligibilityTime)
                if context.barTime < activeEndTime and context.barEndTime > activeEndTime and not intrabarBoundaryIsPrecise(intrabarTimeframe, activeEndTime)
                    requestedTimeframe := includeBoundaryRequest(requestedTimeframe, activeEndTime)
    requestedTimeframe

export updateInteractions(RenderState state, PriceSamples profileSamples, PriceSamples boundarySamples, string intrabarTimeframe, BarContext context, PresentationConfig config) =>
    if config.interactions.showRoleReversal and context.confirmed and not na(context.barOpen) and not na(context.barHigh) and not na(context.barLow) and not na(context.barClose)
        int count = array.size(state.roleReversalZoneStates)
        if count > 0
            for stateIndex = 0 to count - 1
                RoleReversalZoneState zoneState = array.get(state.roleReversalZoneStates, stateIndex)
                int activeEndTime = zoneState.extendsUntilMitigated ? mitigatedZoneEndTime(state, zoneState.sourceName, zoneState.profileStartTime, zoneState.price, zoneState.expirationTime, context) : zoneState.expirationTime
                bool overlaps = context.barEndTime > zoneState.eligibilityTime and context.barTime < activeEndTime
                if not zoneState.reversed and overlaps
                    bool startBoundaryBar = context.barTime < zoneState.eligibilityTime and context.barEndTime > zoneState.eligibilityTime
                    bool endBoundaryBar = context.barTime < activeEndTime and context.barEndTime > activeEndTime
                    if startBoundaryBar or endBoundaryBar
                        bool profilePrecise = (not startBoundaryBar or intrabarBoundaryIsPrecise(intrabarTimeframe, zoneState.eligibilityTime)) and (not endBoundaryBar or intrabarBoundaryIsPrecise(intrabarTimeframe, activeEndTime))
                        if profilePrecise
                            zoneState := advanceRoleReversalFromSamples(zoneState, profileSamples, activeEndTime)
                        else
                            zoneState := advanceRoleReversalFromSamples(zoneState, boundarySamples, activeEndTime)
                    else
                        zoneState := advanceRoleReversalState(zoneState, context.barOpen, context.barHigh, context.barLow, context.barClose)
                    array.set(state.roleReversalZoneStates, stateIndex, zoneState)
    int mitigatedCount = array.size(state.mitigatedZoneStates)
    if mitigatedCount > 0
        for stateIndex = 0 to mitigatedCount - 1
            MitigatedZoneState zoneState = array.get(state.mitigatedZoneStates, stateIndex)
            if zoneState.available and na(zoneState.mitigatedTime) and context.barEndTime > zoneState.eligibilityTime
                bool chartBarTouches = not na(context.barHigh) and not na(context.barLow) and context.barLow <= zoneState.price and context.barHigh >= zoneState.price
                if chartBarTouches
                    array<int> activeBounds = mitigationWindowBounds(config.interactions.mitigationWindow, math.max(context.barTime, zoneState.eligibilityTime), context.barEndTime, context.twentyFourSeven)
                    int activeStartTime = array.get(activeBounds, MITIGATION_WINDOW_START_INDEX)
                    int activeEndTime = array.get(activeBounds, MITIGATION_WINDOW_END_INDEX)
                    if not na(activeStartTime)
                        bool useProfileIntrabars = (activeStartTime == context.barTime or intrabarBoundaryIsPrecise(intrabarTimeframe, activeStartTime)) and (activeEndTime == context.barEndTime or intrabarBoundaryIsPrecise(intrabarTimeframe, activeEndTime))
                        int intrabarTouchEnd = useProfileIntrabars ? firstIntrabarTouchEnd(profileSamples, activeStartTime, zoneState.price, config.interactions.mitigationWindow, context.twentyFourSeven) : firstIntrabarTouchEnd(boundarySamples, activeStartTime, zoneState.price, config.interactions.mitigationWindow, context.twentyFourSeven)
                        bool wholeBarEligible = activeStartTime == context.barTime and activeEndTime == context.barEndTime and mitigationWindowAllowsSample(config.interactions.mitigationWindow, context.barTime, context.barEndTime, context.twentyFourSeven)
                        if not na(intrabarTouchEnd)
                            zoneState.mitigatedTime := intrabarTouchEnd
                        else if wholeBarEligible
                            zoneState.mitigatedTime := context.barEndTime
                        else if context.confirmed
                            bool coverageComplete = useProfileIntrabars ? boundaryCoverageComplete(profileSamples, activeStartTime, activeEndTime) : boundaryCoverageComplete(boundarySamples, activeStartTime, activeEndTime)
                            if not coverageComplete
                                zoneState.available := false
                        array.set(state.mitigatedZoneStates, stateIndex, zoneState)
    true

futuresExtensionEndpoint(int sessionCloseTime, int extensionMs) =>
    int endpoint = sessionCloseTime
    int remainingMs = extensionMs
    if remainingMs > 0
        int endpointDay = dayofweek(endpoint, NY_TIMEZONE)
        int endpointMinute = hour(endpoint, NY_TIMEZONE) * 60 + minute(endpoint, NY_TIMEZONE)
        bool fridayWeekend = endpointDay == dayofweek.friday and endpointMinute >= SUNDAY_REOPEN_START_HOUR * 60
        bool saturdayWeekend = endpointDay == dayofweek.saturday
        bool sundayWeekend = endpointDay == dayofweek.sunday and endpointMinute < SUNDAY_REOPEN_START_HOUR * 60
        if fridayWeekend or saturdayWeekend or sundayWeekend
            int daysUntilSunday = fridayWeekend ? 2 : saturdayWeekend ? 1 : 0
            endpoint := timestamp(NY_TIMEZONE, year(endpoint, NY_TIMEZONE), month(endpoint, NY_TIMEZONE), dayofmonth(endpoint, NY_TIMEZONE) + daysUntilSunday, SUNDAY_REOPEN_START_HOUR, 0)
        endpointDay := dayofweek(endpoint, NY_TIMEZONE)
        int daysUntilFriday = (dayofweek.friday - endpointDay + CALENDAR_DAYS_PER_WEEK) % CALENDAR_DAYS_PER_WEEK
        int weekendStart = timestamp(NY_TIMEZONE, year(endpoint, NY_TIMEZONE), month(endpoint, NY_TIMEZONE), dayofmonth(endpoint, NY_TIMEZONE) + daysUntilFriday, SUNDAY_REOPEN_START_HOUR, 0)
        int availableMs = weekendStart - endpoint
        if remainingMs < availableMs
            endpoint += remainingMs
        else
            remainingMs -= availableMs
            int weekendEnd = timestamp(NY_TIMEZONE, year(weekendStart, NY_TIMEZONE), month(weekendStart, NY_TIMEZONE), dayofmonth(weekendStart, NY_TIMEZONE) + 2, SUNDAY_REOPEN_START_HOUR, 0)
            int fullWeeks = int(math.floor(remainingMs / float(FUTURES_EXTENSION_WEEK_MS)))
            remainingMs -= fullWeeks * FUTURES_EXTENSION_WEEK_MS
            endpoint := timestamp(NY_TIMEZONE, year(weekendEnd, NY_TIMEZONE), month(weekendEnd, NY_TIMEZONE), dayofmonth(weekendEnd, NY_TIMEZONE) + fullWeeks * CALENDAR_DAYS_PER_WEEK, SUNDAY_REOPEN_START_HOUR, 0) + remainingMs
    endpoint

sessionOccurrenceClose(SourceSpec source, legilimensOrchestration.Profile profile, bool developing, BarContext context) =>
    int closeTime = profile.endTime
    if source.key == SOURCE_NY_EARLY
        closeTime := legilimensOrchestration.nyMinuteBoundary(profile.startTime, NY_EARLY_END_MINUTE)
    else if source.key == SOURCE_EXTENDED_NY_EARLY
        int nominalCloseTime = legilimensOrchestration.nyMinuteBoundary(profile.startTime, IVB_START_MINUTE)
        closeTime := profile.endTime > nominalCloseTime ? legilimensOrchestration.nyMinuteBoundary(profile.startTime, EXTENDED_NY_EARLY_OPENING_END_MINUTE) : nominalCloseTime
    else if source.key == SOURCE_IVB
        closeTime := legilimensOrchestration.nyMinuteBoundary(profile.startTime, IVB_END_MINUTE)
    else if source.key == SOURCE_ASIA_PREMARKET
        closeTime := legilimensOrchestration.nySessionEndBoundary(profile.startTime, ASIA_PREMARKET_START_MINUTE, ASIA_PREMARKET_END_MINUTE)
    else if source.key == SOURCE_RTH
        closeTime := developing ? legilimensOrchestration.nyMinuteBoundary(profile.startTime, 16 * 60) : profile.endTime
    else if source.key == SOURCE_WEEKLY and not source.rollingPeriod
        closeTime := developing ? profile.endTime : context.twentyFourSeven ? legilimensOrchestration.nextCalendarWeekBoundary(profile.startTime, UTC_TIMEZONE, 0, 0) : legilimensOrchestration.nextCalendarWeekBoundary(profile.startTime, NY_TIMEZONE, SUNDAY_REOPEN_START_HOUR, 0)
    closeTime

sessionLevelEndpoint(SourceSpec source, int sessionCloseTime, BarContext context) =>
    int extensionMs = int(math.round(source.extensionHours * MS_PER_HOUR))
    context.futuresAsset ? futuresExtensionEndpoint(sessionCloseTime, extensionMs) : sessionCloseTime + extensionMs

rangeTitleLayout(legilimensOrchestration.Profile profile, string sizeName) =>
    float pricePerLayoutUnit = (profile.data.rangeHigh - profile.data.rangeLow) / profile.data.rowCount
    float titleClearance = pricePerLayoutUnit * (labelPointSize(sizeName) + RANGE_TITLE_CONTAINER_PADDING)
    [profile.data.rangeHigh, profile.data.rangeLow, titleClearance]

rangeHeadingTime(legilimensOrchestration.Profile profile, array<int> chartTimes, int startScaleIndex, int endScaleIndex, int barOffset) =>
    int headingTime = profile.startTime + int(math.round((profile.endTime - profile.startTime) * 0.5))
    if startScaleIndex >= 0 and endScaleIndex >= 0
        int headingIndex = int(math.round((startScaleIndex + endScaleIndex) * 0.5)) + barOffset
        int count = array.size(chartTimes)
        if headingIndex >= 0 and headingIndex < count
            headingTime := array.get(chartTimes, headingIndex)
        else
            int overflowSteps = headingIndex < 0 ? headingIndex : headingIndex - (count - 1)
            int edgeTime = headingIndex < 0 ? array.get(chartTimes, 0) : array.get(chartTimes, count - 1)
            headingTime := edgeTime + overflowSteps * barSpanMs()
    else
        headingTime += barOffset * barSpanMs()
    headingTime

levelMarkerTime(int levelEndTime) =>
    levelEndTime + int(math.round(DOT_MARKER_OFFSET_BARS * barSpanMs()))

rowPassesDeltaFilter(float rowDelta, float strength, bool selectedOutlierRow, PresentationConfig config) =>
    bool isBuy = rowDelta > 0
    bool isSell = rowDelta < 0
    bool directionVisible = config.delta.visibleRows == OPTION_ALL ? isBuy or isSell : config.delta.visibleRows == OPTION_OFF ? false : config.delta.visibleRows == DELTA_ROWS_BUY ? isBuy : config.delta.visibleRows == DELTA_ROWS_SELL ? isSell : false
    bool filterPassed = config.delta.rowFilter == OPTION_ALL ? true : config.delta.rowFilter == DELTA_ROW_FILTER_OUTLIERS ? legilimensProfile.isOutlierStrength(strength) : selectedOutlierRow
    directionVisible and filterPassed

appendDeltaRowPoints(array<chart.point> points, int baselineTime, int outerTime, float rowBottom, float rowTop) =>
    array.push(points, chart.point.from_time(baselineTime, rowBottom))
    array.push(points, chart.point.from_time(outerTime, rowBottom))
    array.push(points, chart.point.from_time(outerTime, rowTop))
    array.push(points, chart.point.from_time(baselineTime, rowTop))

renderDeltaLayer(RenderState state, array<chart.point> points, color fillColor, PresentationConfig config) =>
    if array.size(points) >= 4 and canDrawPolyline(state, config)
        array.push(state.drawnPolylines, polyline.new(points, curved=false, closed=true, xloc=xloc.bar_time, line_color=color.new(fillColor, 100), fill_color=fillColor))

renderDeltaPolylines(RenderState state, legilimensOrchestration.Profile profile, SourceSpec source, array<float> strengths, array<bool> selectedRows, array<int> chartTimes, int startScaleIndex, int endScaleIndex, PresentationConfig config) =>
    if profile.data.maxAbsRowDelta > 0
        array<chart.point> buyPoints = array.new<chart.point>()
        array<chart.point> sellPoints = array.new<chart.point>()
        array<chart.point> deltaPlusPlusPoints = array.new<chart.point>()
        array<chart.point> deltaMinusMinusPoints = array.new<chart.point>()
        float rowHeight = (profile.data.priceHigh - profile.data.priceLow) / profile.data.rowCount
        bool attachRight = source.profilePosition == PROFILE_POSITION_RIGHT_LEFT or source.profilePosition == PROFILE_POSITION_RIGHT_RIGHT
        bool faceLeft = source.profilePosition == PROFILE_POSITION_LEFT_LEFT or source.profilePosition == PROFILE_POSITION_RIGHT_LEFT
        int baselineIndex = attachRight ? endScaleIndex : startScaleIndex
        int baselineTime = profileBaselineTime(profile, chartTimes, baselineIndex, attachRight)
        for rowIndex = 0 to profile.data.rowCount - 1
            float rowVolume = array.get(profile.data.rowVolumes, rowIndex)
            if rowVolume > 0
                float strength = array.get(strengths, rowIndex)
                bool outlierRow = legilimensProfile.isOutlierStrength(strength)
                float rowDelta = array.get(profile.data.rowDeltas, rowIndex)
                float magnitude = math.abs(rowDelta)
                bool selectedRow = rowIndex < array.size(selectedRows) and array.get(selectedRows, rowIndex)
                if magnitude > 0 and rowPassesDeltaFilter(rowDelta, strength, selectedRow, config)
                    float rowBottom = profile.data.priceLow + rowIndex * rowHeight
                    int outerTime = deltaOuterTime(profile, chartTimes, startScaleIndex, endScaleIndex, baselineIndex, magnitude / profile.data.maxAbsRowDelta, source.deltaWidthBars, faceLeft, attachRight)
                    if rowDelta >= 0 and outlierRow
                        appendDeltaRowPoints(deltaPlusPlusPoints, baselineTime, outerTime, rowBottom, rowBottom + rowHeight)
                    else if rowDelta >= 0
                        appendDeltaRowPoints(buyPoints, baselineTime, outerTime, rowBottom, rowBottom + rowHeight)
                    else if outlierRow
                        appendDeltaRowPoints(deltaMinusMinusPoints, baselineTime, outerTime, rowBottom, rowBottom + rowHeight)
                    else
                        appendDeltaRowPoints(sellPoints, baselineTime, outerTime, rowBottom, rowBottom + rowHeight)
        renderDeltaLayer(state, buyPoints, profileDeltaPlusColor(source), config)
        renderDeltaLayer(state, sellPoints, profileDeltaMinusColor(source), config)
        renderDeltaLayer(state, deltaPlusPlusPoints, profileDeltaPlusPlusColor(source), config)
        renderDeltaLayer(state, deltaMinusMinusPoints, profileDeltaMinusMinusColor(source), config)

pushHistogramRun(RenderState state, array<chart.point> points, color fillColor, PresentationConfig config) =>
    if canDrawPolyline(state, config)
        array.push(state.drawnPolylines, polyline.new(points, curved=false, closed=true, xloc=xloc.bar_time, line_color=color.new(fillColor, 100), fill_color=fillColor))

renderHistogram(RenderState state, legilimensOrchestration.Profile profile, int valueAreaLowRow, int valueAreaHighRow, int maxPolylinesAllowed, array<int> chartTimes, int startScaleIndex, int endScaleIndex, PresentationConfig config) =>
    int polylinesUsed = 0
    if profile.data.maxRowVolume > 0 and maxPolylinesAllowed > 0
        int rowCount = profile.data.rowCount
        float rowHeight = (profile.data.priceHigh - profile.data.priceLow) / rowCount
        bool completeScale = startScaleIndex >= 0 and endScaleIndex >= 0
        int baselineIndex = completeScale ? startScaleIndex : -1
        int rangeSteps = completeScale ? math.max(1, math.abs(endScaleIndex - startScaleIndex)) : 1
        int baselineTime = profileBaselineTime(profile, chartTimes, baselineIndex, false)
        array<chart.point> points = array.new<chart.point>()
        bool runStarted = false
        bool runInsideValueArea = false
        for rowIndex = 0 to rowCount - 1
            bool insideValueArea = rowIndex >= valueAreaLowRow and rowIndex <= valueAreaHighRow
            float rowBottom = profile.data.priceLow + rowIndex * rowHeight
            float rowVolume = array.get(profile.data.rowVolumes, rowIndex)
            int outerTime = profileOuterTime(profile, chartTimes, baselineIndex, rangeSteps, rowVolume / profile.data.maxRowVolume, config.delta.histogramWidthPercent, false, false)
            if runStarted and insideValueArea != runInsideValueArea
                array.push(points, chart.point.from_time(baselineTime, rowBottom))
                if polylinesUsed < maxPolylinesAllowed
                    pushHistogramRun(state, points, runInsideValueArea ? color.new(color.rgb(187, 217, 251), 75) : color.new(color.rgb(184, 184, 184), 80), config)
                    polylinesUsed += 1
                points := array.new<chart.point>()
                runStarted := false
            if not runStarted
                runStarted := true
                runInsideValueArea := insideValueArea
                array.push(points, chart.point.from_time(baselineTime, rowBottom))
            array.push(points, chart.point.from_time(outerTime, rowBottom + rowHeight * 0.5))
            if rowIndex == rowCount - 1
                array.push(points, chart.point.from_time(baselineTime, rowBottom + rowHeight))
                if polylinesUsed < maxPolylinesAllowed
                    pushHistogramRun(state, points, runInsideValueArea ? color.new(color.rgb(187, 217, 251), 75) : color.new(color.rgb(184, 184, 184), 80), config)
                    polylinesUsed += 1
    polylinesUsed

renderLowVolumeZone(RenderState state, legilimensOrchestration.Profile profile, SourceSpec source, float price, float zoneLow, float zoneHigh, int levelEndTime, int levelRank, int sessionTradingDayKey, bool historical, string markerLabel, color markerColor, int markerSize, bool registrationOnly, array<SourceSpec> sources, PresentationConfig config) =>
    color zoneColor = color.new(color.rgb(74, 74, 74), 95)
    bool markerDeferred = mitigationEnabled(sources, source.key, config)
    if registrationOnly
        if markerDeferred
            registerMitigatedZone(state, source.key, profile.startTime, levelEndTime, price, config)
    else if markerDeferred
        array.push(state.pendingMitigatedZones, PendingMitigatedZone.new(price, zoneLow, zoneHigh, profile.startTime, profile.endTime, levelEndTime, zoneColor, 0, markerColor, false, markerColor, LOW_VOLUME_LINE_WIDTH, STYLE_DOTTED, levelRank, source.key, sessionTradingDayKey, historical, 0, LEVEL_MARKER_GLYPH, markerLabel, markerColor, markerSize))
    else
        renderZoneFill(state, profile.endTime, levelEndTime, zoneLow, zoneHigh, zoneColor, 0, markerColor, config)
    markerDeferred

renderLowVolumeStructures(RenderState state, legilimensOrchestration.Profile profile, SourceSpec source, string displayNameOverride, int levelEndTime, int sessionTradingDayKey, bool historical, bool registrationOnly, array<SourceSpec> sources, BarContext context, PresentationConfig config) =>
    if config.delta.showLvnTiers
        array<legilimensProfile.LowVolumeCandidate> candidates = legilimensProfile.selectLowVolumeCandidates(profile.data, config.delta.visibleLvnTierCount)
        int count = array.size(candidates)
        if count > 0
            for candidateIndex = 0 to count - 1
                int structureRank = candidateIndex + 1
                legilimensProfile.LowVolumeCandidate candidate = array.get(candidates, candidateIndex)
                int levelRank = LOW_VOLUME_LEVEL_RANK - structureRank
                float labelPrice = candidate.isLvn ? (candidate.zoneLow + candidate.zoneHigh) * 0.5 : candidate.price
                string markerLabel = config.delta.showDotLabels and structureRank == 1 ? displayNameOverride != "" ? displayNameOverride : source.labelName : ""
                color markerColor = color.new(color.rgb(15, 15, 15), 75)
                bool markerDeferred = false
                if candidate.isLvn
                    markerDeferred := renderLowVolumeZone(state, profile, source, labelPrice, candidate.zoneLow, candidate.zoneHigh, levelEndTime, levelRank, sessionTradingDayKey, historical, markerLabel, markerColor, tierMarkerSize(6 - structureRank), registrationOnly, sources, config)
                else if not registrationOnly
                    queueRightLine(state, candidate.price, profile.endTime, levelEndTime, markerColor, LOW_VOLUME_LINE_WIDTH, STYLE_DOTTED, levelRank, source.key, sessionTradingDayKey, historical, 0, context)
                if not registrationOnly and not markerDeferred
                    queueLevelMarker(state, labelPrice, levelMarkerTime(levelEndTime), LEVEL_MARKER_GLYPH, markerLabel, markerColor, tierMarkerSize(6 - structureRank), config)

collectOutlierPeaks(RenderState state, legilimensOrchestration.Profile profile, SourceSpec source, array<float> strengths, string displayNameOverride, int levelEndTime, int sessionTradingDayKey, bool historical, PresentationConfig config) =>
    if config.delta.showTiers
        int markerTime = levelMarkerTime(levelEndTime)
        array<legilimensProfile.OutlierPeak> peaks = legilimensProfile.collectOutlierPeaks(profile.data, strengths)
        int count = array.size(peaks)
        if count > 0
            for peakIndex = 0 to count - 1
                legilimensProfile.OutlierPeak peak = array.get(peaks, peakIndex)
                int fibGrade = config.delta.qualifyByFib ? deltaTierFibLocationGrade(peak.buySide, peak.price, profile.data.rangeLow, profile.data.rangeHigh) : FIB_LOCATION_UNKNOWN
                float fibMidpoint = config.delta.qualifyByFib ? (profile.data.rangeLow + profile.data.rangeHigh) * FIB_LOCATION_MIDPOINT : na
                array.push(state.pendingOutlierLevels, PendingOutlierLevel.new(peak.price, peak.zoneLow, peak.zoneHigh, peak.delta, peak.strength, peak.buySide, profile.startTime, profile.endTime, levelEndTime, markerTime, source.key, displayNameOverride, sessionTradingDayKey, historical, peak.firstRow, peak.lastRow, fibGrade, fibMidpoint))

rankPendingOutlierLevels(RenderState state, BarContext context, PresentationConfig config) =>
    array<RankedOutlierLevel> rankedLevels = array.new<RankedOutlierLevel>()
    array<legilimensProfile.RankedOutlierSelection> rankedSelections = array.new<legilimensProfile.RankedOutlierSelection>()
    int pendingCount = array.size(state.pendingOutlierLevels)
    if pendingCount > 0
        array<legilimensProfile.OutlierCandidate> candidates = array.new<legilimensProfile.OutlierCandidate>()
        for pendingIndex = 0 to pendingCount - 1
            PendingOutlierLevel pending = array.get(state.pendingOutlierLevels, pendingIndex)
            array.push(candidates, legilimensProfile.OutlierCandidate.new(pending.price, pending.zoneLow, pending.zoneHigh, pending.delta, pending.strength, pending.buySide, pending.sourceName, pending.tradingDayKey, pending.historical, pending.profileStartTime, pending.firstRow, pending.lastRow))
        rankedSelections := legilimensProfile.rankOutlierCandidates(candidates, config.levels.mergeOverlaps, context.tickSize, config.levels.mergeDistancePercent, config.delta.visibleTierCount)
        int count = array.size(rankedSelections)
        if count > 0
            for rankedIndex = 0 to count - 1
                legilimensProfile.RankedOutlierSelection selection = array.get(rankedSelections, rankedIndex)
                PendingOutlierLevel firstPending = array.get(state.pendingOutlierLevels, array.get(selection.memberIndices, 0))
                PendingOutlierLevel representative = array.get(state.pendingOutlierLevels, selection.representativeIndex)
                int lineStartTime = firstPending.lineStartTime
                int rightTime = firstPending.rightTime
                if array.size(selection.memberIndices) > 1
                    for memberIndex = 1 to array.size(selection.memberIndices) - 1
                        PendingOutlierLevel member = array.get(state.pendingOutlierLevels, array.get(selection.memberIndices, memberIndex))
                        lineStartTime := math.max(lineStartTime, member.lineStartTime)
                        rightTime := math.max(rightTime, member.rightTime)
                array.push(rankedLevels, RankedOutlierLevel.new(selection.price, selection.zoneLow, selection.zoneHigh, selection.buySide, firstPending.profileStartTime, lineStartTime, rightTime, representative.markerTime, firstPending.sourceName, firstPending.displayNameOverride, firstPending.tradingDayKey, firstPending.historical, selection.firstRow, selection.lastRow, selection.strengthRank, representative.fibLocationGrade, representative.fibMidpointPrice))
        array.clear(state.pendingOutlierLevels)
    [rankedLevels, rankedSelections]

renderRankedOutlierLevels(RenderState state, array<RankedOutlierLevel> rankedLevels, bool registrationOnly, array<SourceSpec> sources, BarContext context, PresentationConfig config) =>
    int count = array.size(rankedLevels)
    if count > 0
        for rankedIndex = 0 to count - 1
            RankedOutlierLevel ranked = array.get(rankedLevels, rankedIndex)
            SourceSpec source = sourceSpec(sources, ranked.sourceName)
            int tier = 6 - ranked.strengthRank
            DeltaTierAppearance appearance = deltaTierAppearance(ranked.buySide, tier, source)
            int levelRank = 2000 - ranked.strengthRank
            bool extendPriorityZone = ranked.strengthRank <= 2 and mitigationEnabled(sources, ranked.sourceName, config)
            int direction = ranked.buySide ? 1 : -1
            string markerLabel = config.delta.showDotLabels and ranked.strengthRank == 1 ? ranked.displayNameOverride != "" ? ranked.displayNameOverride : source.labelName : ""
            bool borderedQualified = config.delta.qualifyByFib and ranked.fibLocationGrade == FIB_LOCATION_QUALIFIED and (ranked.buySide ? ranked.price < ranked.fibMidpointPrice : ranked.price > ranked.fibMidpointPrice)
            int fibBorderWidth = config.delta.qualifyByFib ? ranked.fibLocationGrade == FIB_LOCATION_VERY_STRONG ? 2 : ranked.fibLocationGrade == FIB_LOCATION_PREFERRED or borderedQualified ? 1 : 0 : 0
            bool qualified = config.delta.qualifyByFib and ranked.fibLocationGrade >= FIB_LOCATION_QUALIFIED
            color zoneColor = config.delta.qualifyByFib ? fibQualificationColor(appearanceZoneColor(appearance), qualified) : appearanceZoneColor(appearance)
            color lineColor = config.delta.qualifyByFib ? fibQualificationColor(appearanceLineColor(appearance), qualified) : appearanceLineColor(appearance)
            color markerColor = config.delta.qualifyByFib ? fibQualificationColor(appearanceTextColor(appearance), qualified) : appearanceTextColor(appearance)
            string markerGlyph = config.delta.qualifyByFib ? fibLocationMarkerGlyph(ranked.fibLocationGrade) : LEVEL_MARKER_GLYPH
            bool roleReversed = config.interactions.showRoleReversal and roleReversalZoneIsReversed(state, ranked.sourceName, ranked.profileStartTime, ranked.price, direction)
            color borderColor = markerColor
            if roleReversed
                DeltaTierAppearance reversedAppearance = deltaTierAppearance(not ranked.buySide, tier, source)
                borderColor := appearanceTextColor(reversedAppearance)
            int borderWidth = math.max(fibBorderWidth, roleReversed ? 1 : 0)
            if deltaTierSideVisible(ranked.buySide, config)
                if registrationOnly
                    if extendPriorityZone
                        registerMitigatedZone(state, ranked.sourceName, ranked.profileStartTime, ranked.rightTime, ranked.price, config)
                    if roleReversalEnabled(sources, ranked.sourceName, config)
                        registerRoleReversalZone(state, ranked.sourceName, ranked.profileStartTime, ranked.lineStartTime, ranked.rightTime, ranked.price, ranked.zoneLow, ranked.zoneHigh, direction, extendPriorityZone, config)
                else if extendPriorityZone
                    string lineStyle = config.delta.tierLineStyle == STYLE_DOTTED ? STYLE_DOTTED : appearanceLineStyle(appearance)
                    array.push(state.pendingMitigatedZones, PendingMitigatedZone.new(ranked.price, ranked.zoneLow, ranked.zoneHigh, ranked.profileStartTime, ranked.lineStartTime, ranked.rightTime, zoneColor, borderWidth, borderColor, appearanceHasLine(appearance), lineColor, appearanceLineWidth(appearance), lineStyle, levelRank, ranked.sourceName, ranked.tradingDayKey, ranked.historical, direction, markerGlyph, markerLabel, markerColor, tierMarkerSize(tier)))
                else
                    renderZoneFill(state, ranked.lineStartTime, ranked.rightTime, ranked.zoneLow, ranked.zoneHigh, zoneColor, borderWidth, borderColor, config)
                    if appearanceHasLine(appearance)
                        queueRightLine(state, ranked.price, ranked.lineStartTime, ranked.rightTime, lineColor, appearanceLineWidth(appearance), config.delta.tierLineStyle == STYLE_DOTTED ? STYLE_DOTTED : appearanceLineStyle(appearance), levelRank, ranked.sourceName, ranked.tradingDayKey, ranked.historical, direction, context)
                    queueLevelMarker(state, ranked.price, ranked.markerTime, markerGlyph, markerLabel, markerColor, tierMarkerSize(tier), config)

renderProfileBox(RenderState state, legilimensOrchestration.Profile profile, SourceSpec source, PresentationConfig config) =>
    if canDrawBox(state, config)
        color innerColor = profileInnerColor(source.key)
        array.push(state.drawnBoxes, box.new(left=profile.startTime, top=profile.data.rangeHigh, right=profile.endTime, bottom=profile.data.rangeLow, xloc=xloc.bar_time, border_color=innerColor, border_width=SESSION_OUTLINE_WIDTH, border_style=line.style_solid, bgcolor=color.new(color.white, 100)))

renderOuterSessionFrame(RenderState state, legilimensOrchestration.Profile profile, SourceSpec source, int levelEndTime, PresentationConfig config) =>
    [rangeHighTitleY, rangeLowTitleY, titleClearance] = rangeTitleLayout(profile, profileRangeLabelSize(source.key))
    color outerColor = profileOuterColor(source.key)
    if canDrawBox(state, config)
        array.push(state.drawnBoxes, box.new(left=profile.startTime, top=rangeHighTitleY + titleClearance, right=levelEndTime, bottom=rangeLowTitleY - titleClearance, xloc=xloc.bar_time, border_color=outerColor, border_width=1, border_style=line.style_solid, bgcolor=color.new(outerColor, 100)))

renderReferenceLevel(RenderState state, legilimensOrchestration.Profile profile, SourceSpec source, string displayNameOverride, int levelEndTime, float price, string levelName, color lineColor, PresentationConfig config) =>
    bool pocLevel = levelName == LEVEL_POC
    if canDrawLine(state, config)
        array.push(state.drawnLines, line.new(profile.startTime, price, levelEndTime, price, xloc=xloc.bar_time, color=lineColor, style=toLineStyle(pocLevel ? STYLE_DASHED : STYLE_SOLID), width=pocLevel ? POC_LEVEL_WIDTH : VALUE_AREA_LEVEL_WIDTH))
    if pocLevel and canDrawLabel(state, config)
        string labelText = (displayNameOverride != "" ? displayNameOverride : source.displayName) + " " + levelName
        array.push(state.drawnLabels, label.new(levelEndTime + int(math.round(POC_LABEL_OFFSET_BARS * barSpanMs())), price, labelText, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, textcolor=color.rgb(49, 27, 146), size=POC_LABEL_SIZE, color=color.new(color.white, 100)))

renderRangeLabels(RenderState state, legilimensOrchestration.Profile profile, SourceSpec source, string displayNameOverride, bool pairedNyHeadings, array<int> chartTimes, int startScaleIndex, int endScaleIndex, PresentationConfig config) =>
    string labelSize = profileRangeLabelSize(source.key)
    color labelColor = profileRangeLabelColor(source.key)
    int barOffset = pairedNyHeadings ? source.key == SOURCE_NY_EARLY ? -NY_HEADING_SEPARATION_BARS : source.key == SOURCE_EXTENDED_NY_EARLY ? NY_HEADING_SEPARATION_BARS : 0 : 0
    int headingTime = rangeHeadingTime(profile, chartTimes, startScaleIndex, endScaleIndex, barOffset)
    [rangeHighTitleY, rangeLowTitleY, _] = rangeTitleLayout(profile, labelSize)
    string rangeLabel = displayNameOverride != "" ? displayNameOverride : source.displayName
    color backgroundColor = profileTextBackgroundColor(source)
    if source.key == SOURCE_FIXED and canDrawLabel(state, config)
        array.push(state.drawnLabels, label.new(profile.startTime, rangeHighTitleY, "Fixed Start", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelColor, size=toLabelSize(labelSize), color=backgroundColor))
    if source.key == SOURCE_FIXED and canDrawLabel(state, config)
        array.push(state.drawnLabels, label.new(profile.endTime, rangeHighTitleY, "Fixed End", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelColor, size=toLabelSize(labelSize), color=backgroundColor))
    if canDrawLabel(state, config)
        array.push(state.drawnLabels, label.new(headingTime, rangeHighTitleY, rangeLabel, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, textcolor=labelColor, size=toLabelSize(labelSize), color=backgroundColor))
    if canDrawLabel(state, config)
        array.push(state.drawnLabels, label.new(headingTime, rangeLowTitleY, rangeLabel, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, textcolor=labelColor, size=toLabelSize(labelSize), color=backgroundColor))

renderProfileMidpointLine(RenderState state, legilimensOrchestration.Profile profile, SourceSpec source, int levelEndTime, array<int> chartTimes, PresentationConfig config) =>
    if config.levels.showMidpoint and canDrawLine(state, config)
        float midpointPrice = (profile.data.rangeLow + profile.data.rangeHigh) * FIB_LOCATION_MIDPOINT
        array.push(state.drawnLines, line.new(profile.endTime, midpointPrice, levelEndTime, midpointPrice, xloc=xloc.bar_time, color=color.new(#2962ff, 70), style=line.style_solid, width=2))
        if canDrawLabel(state, config)
            int midpointTime = profile.endTime + int(math.round((levelEndTime - profile.endTime) * 0.5))
            int startIndex = nearestChartTimeIndex(chartTimes, profile.endTime)
            int endIndex = nearestChartTimeIndex(chartTimes, levelEndTime)
            if startIndex >= 0 and endIndex >= 0
                midpointTime := array.get(chartTimes, int(math.round((startIndex + endIndex) * 0.5)))
            array.push(state.drawnLabels, label.new(midpointTime, midpointPrice, str.lower(source.key) + " 0.5", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_center, textcolor=color.new(#2962ff, 45), size=5, color=color.new(color.white, 50), textalign=text.align_center))

selectedOutlierRowMask(legilimensOrchestration.Profile profile, array<float> strengths, array<legilimensProfile.RankedOutlierSelection> selections, PresentationConfig config) =>
    bool enabled = config.delta.rowFilter == DELTA_ROW_FILTER_SELECTED_TIER_OUTLIERS and config.delta.showTiers and config.delta.visibleTierSides != OPTION_OFF
    legilimensProfile.selectedOutlierRowMask(profile.data, profile.startTime, strengths, selections, enabled, deltaTierSideVisible(true, config), deltaTierSideVisible(false, config))

renderSelectedProfile(RenderState state, legilimensOrchestration.Profile profile, SourceSpec source, string displayNameOverride, bool pairedNyHeadings, bool historical, bool developing, bool renderBudgetedHistogram, int histogramLayersPerProfile, array<int> chartTimes, array<SourceSpec> sources, BarContext context, PresentationConfig config) =>
    int startScaleIndex = nearestChartTimeIndex(chartTimes, profile.startTime)
    int endScaleIndex = nearestChartTimeIndex(chartTimes, profile.endTime)
    int sessionCloseTime = sessionOccurrenceClose(source, profile, developing, context)
    int levelEndTime = sessionLevelEndpoint(source, sessionCloseTime, context)
    int sessionTradingDayKey = legilimensOrchestration.tradingDayKey(sessionCloseTime)
    if not developing or not developingControlled(source)
        renderOuterSessionFrame(state, profile, source, levelEndTime, config)
    renderRangeLabels(state, profile, source, displayNameOverride, pairedNyHeadings, chartTimes, startScaleIndex, endScaleIndex, config)
    renderProfileBox(state, profile, source, config)
    if not developing or not developingControlled(source) or source.developingContentVisible
        [_, valueAreaLowRow, valueAreaHighRow, pocPrice, valueAreaLowPrice, valueAreaHighPrice] = legilimensProfile.profileValueLevels(profile.data.rowVolumes, profile.data.rowCount, profile.data.priceLow, profile.data.priceHigh)
        if renderBudgetedHistogram
            renderHistogram(state, profile, valueAreaLowRow, valueAreaHighRow, histogramLayersPerProfile, chartTimes, startScaleIndex, endScaleIndex, config)
        renderProfileMidpointLine(state, profile, source, levelEndTime, chartTimes, config)
        array<float> strengths = legilimensProfile.computeRowStrengths(profile.data)
        collectOutlierPeaks(state, profile, source, strengths, displayNameOverride, levelEndTime, sessionTradingDayKey, historical, config)
        [rankedOutlierLevels, rankedOutlierSelections] = rankPendingOutlierLevels(state, context, config)
        array<bool> selectedRows = selectedOutlierRowMask(profile, strengths, rankedOutlierSelections, config)
        renderDeltaPolylines(state, profile, source, strengths, selectedRows, chartTimes, startScaleIndex, endScaleIndex, config)
        if config.levels.showValueArea
            color valueAreaColor = profileValueAreaLevelColor(source.key)
            renderReferenceLevel(state, profile, source, displayNameOverride, levelEndTime, valueAreaHighPrice, LEVEL_VAH, valueAreaColor, config)
            renderReferenceLevel(state, profile, source, displayNameOverride, levelEndTime, valueAreaLowPrice, LEVEL_VAL, valueAreaColor, config)
        if config.levels.showPoc
            renderReferenceLevel(state, profile, source, displayNameOverride, levelEndTime, pocPrice, LEVEL_POC, color.rgb(49, 27, 146), config)
        renderLowVolumeStructures(state, profile, source, displayNameOverride, levelEndTime, sessionTradingDayKey, historical, false, sources, context, config)
        renderRankedOutlierLevels(state, rankedOutlierLevels, false, sources, context, config)

renderDecision(legilimensOrchestration.Profile profile, SourceSpec source, legilimensOrchestration.ProfileSelection comparisonSelection, BarContext context, PresentationConfig config) =>
    legilimensOrchestration.renderDecision(profile, source.key, comparisonSelection, SOURCE_NY_EARLY, SOURCE_EXTENDED_NY_EARLY, NY_EARLY_END_MINUTE, config.extendedNyModeActive, DISPLAY_NY_EARLY_PLUS, context.tickSize)

comparisonSelection(array<SelectionBinding> bindings, string sourceName) =>
    string comparisonName = sourceName == SOURCE_EXTENDED_NY_EARLY ? SOURCE_NY_EARLY : sourceName == SOURCE_NY_EARLY ? SOURCE_EXTENDED_NY_EARLY : ""
    legilimensOrchestration.ProfileSelection comparison = na
    if comparisonName != ""
        int count = array.size(bindings)
        if count > 0
            for bindingIndex = 0 to count - 1
                SelectionBinding binding = array.get(bindings, bindingIndex)
                if na(comparison) and binding.source.key == comparisonName
                    comparison := binding.selection
    comparison

renderableContentProfileCount(SelectionBinding binding, legilimensOrchestration.ProfileSelection comparison, bool hideDevelopingExtendedCounterpart, int currentNyEarlyStartTime, BarContext context, PresentationConfig config) =>
    int count = legilimensOrchestration.renderableProfileCount(binding.selection, binding.source.key, comparison, SOURCE_NY_EARLY, SOURCE_EXTENDED_NY_EARLY, NY_EARLY_END_MINUTE, config.extendedNyModeActive, DISPLAY_NY_EARLY_PLUS, context.tickSize)
    if count > 0 and binding.selection.currentDeveloping and developingControlled(binding.source) and not binding.source.developingContentVisible and binding.selection.currentIndex >= 0
        legilimensOrchestration.Profile currentProfile = array.get(binding.selection.profiles, binding.selection.currentIndex)
        legilimensOrchestration.RenderDecision decision = renderDecision(currentProfile, binding.source, comparison, context, config)
        if decision.shouldRender
            count -= 1
    count

trimBindings(array<SelectionBinding> bindings, PresentationConfig config, BarContext context) =>
    array<legilimensOrchestration.ProfileSelection> selections = array.new<legilimensOrchestration.ProfileSelection>()
    array<string> sourceNames = array.new<string>()
    int count = array.size(bindings)
    if count > 0
        for bindingIndex = 0 to count - 1
            SelectionBinding binding = array.get(bindings, bindingIndex)
            array.push(selections, binding.selection)
            array.push(sourceNames, binding.source.key)
    legilimensOrchestration.trimProfileSelectionsToCapacity(selections, sourceNames, profileCapacity(count, config), SOURCE_NY_EARLY, SOURCE_EXTENDED_NY_EARLY, NY_EARLY_END_MINUTE, config.extendedNyModeActive, DISPLAY_NY_EARLY_PLUS, context.tickSize)

export renderSelections(RenderState state, array<SelectionBinding> bindings, bool hideDevelopingExtendedCounterpart, int currentNyEarlyStartTime, array<SourceSpec> sources, BarContext context, PresentationConfig config) =>
    trimBindings(bindings, config, context)
    if state.chartTimesBuiltAtBar != context.barIndex
        state.cachedChartTimes := recentChartTimes(context.barIndex)
        state.chartTimesBuiltAtBar := context.barIndex
    int contentCount = 0
    int count = array.size(bindings)
    if count > 0
        for bindingIndex = 0 to count - 1
            SelectionBinding binding = array.get(bindings, bindingIndex)
            contentCount += renderableContentProfileCount(binding, comparisonSelection(bindings, binding.source.key), hideDevelopingExtendedCounterpart, currentNyEarlyStartTime, context, config)
    int deltaLayers = deltaPolylineLayersPerProfile(config)
    int histogramLayers = config.delta.showHistogram ? HISTOGRAM_VALUE_AREA_POLYLINE_LAYER_COUNT : 0
    bool renderHistograms = config.delta.showHistogram and histogramLayers > 0 and contentCount > 0 and contentCount * (deltaLayers + histogramLayers) <= config.limits.polylines
    if count > 0
        for renderPass = 0 to 1
            bool currentPass = renderPass == 0
            for bindingIndex = 0 to count - 1
                SelectionBinding binding = array.get(bindings, bindingIndex)
                legilimensOrchestration.ProfileSelection comparison = comparisonSelection(bindings, binding.source.key)
                int selectedCount = array.size(binding.selection.profiles)
                if selectedCount > 0
                    for selectedIndex = 0 to selectedCount - 1
                        bool currentProfile = selectedIndex == binding.selection.currentIndex
                        if currentProfile == currentPass
                            legilimensOrchestration.Profile selectedProfile = array.get(binding.selection.profiles, selectedIndex)
                            legilimensOrchestration.RenderDecision decision = renderDecision(selectedProfile, binding.source, comparison, context, config)
                            bool hiddenCounterpart = binding.source.key == SOURCE_NY_EARLY and hideDevelopingExtendedCounterpart and selectedProfile.startTime == currentNyEarlyStartTime
                            string displayNameOverride = hiddenCounterpart ? "" : decision.displayNameOverride
                            bool pairedHeadings = hiddenCounterpart ? false : decision.pairedHeadings
                            if decision.shouldRender
                                bool developing = currentProfile and binding.selection.currentDeveloping
                                renderSelectedProfile(state, selectedProfile, binding.source, displayNameOverride, pairedHeadings, not currentProfile, developing, renderHistograms, histogramLayers, state.cachedChartTimes, sources, context, config)
    true

export renderStandaloneProfile(RenderState state, legilimensOrchestration.Profile profile, SourceSpec source, array<SourceSpec> sources, BarContext context, PresentationConfig config) =>
    if state.chartTimesBuiltAtBar != context.barIndex
        state.cachedChartTimes := recentChartTimes(context.barIndex)
        state.chartTimesBuiltAtBar := context.barIndex
    int deltaLayers = deltaPolylineLayersPerProfile(config)
    int histogramLayers = config.delta.showHistogram ? HISTOGRAM_VALUE_AREA_POLYLINE_LAYER_COUNT : 0
    bool renderHistogramAllowed = config.delta.showHistogram and histogramLayers > 0 and deltaLayers + histogramLayers <= config.limits.polylines
    renderSelectedProfile(state, profile, source, "", false, false, true, renderHistogramAllowed, histogramLayers, state.cachedChartTimes, sources, context, config)
    true

export registerProfileZones(RenderState state, legilimensOrchestration.Profile profile, SourceSpec source, array<SourceSpec> sources, BarContext context, PresentationConfig config) =>
    if zoneTrackingEnabled(sources, source.key, config)
        int sessionCloseTime = sessionOccurrenceClose(source, profile, false, context)
        int levelEndTime = sessionLevelEndpoint(source, sessionCloseTime, context)
        int sessionTradingDayKey = legilimensOrchestration.tradingDayKey(sessionCloseTime)
        if mitigationEnabled(sources, source.key, config)
            renderLowVolumeStructures(state, profile, source, "", levelEndTime, sessionTradingDayKey, true, true, sources, context, config)
        array<float> strengths = legilimensProfile.computeRowStrengths(profile.data)
        collectOutlierPeaks(state, profile, source, strengths, "", levelEndTime, sessionTradingDayKey, true, config)
        [rankedLevels, _] = rankPendingOutlierLevels(state, context, config)
        renderRankedOutlierLevels(state, rankedLevels, true, sources, context, config)
    true

export registerFinalizedProfiles(RenderState state, legilimensOrchestration.AnchorState anchor, SourceSpec source, array<SourceSpec> sources, BarContext context, PresentationConfig config) =>
    int count = legilimensOrchestration.finalizedProfileCount(anchor)
    if count > 0
        if zoneTrackingEnabled(sources, source.key, config)
            for profileIndex = 0 to count - 1
                registerProfileZones(state, legilimensOrchestration.finalizedProfileAt(anchor, profileIndex), source, sources, context, config)
        legilimensOrchestration.clearFinalizedProfiles(anchor)
    true

flushPendingMitigatedZones(RenderState state, BarContext context, PresentationConfig config) =>
    int count = array.size(state.pendingMitigatedZones)
    if count > 0
        for pendingIndex = 0 to count - 1
            PendingMitigatedZone pending = array.get(state.pendingMitigatedZones, pendingIndex)
            int rightTime = mitigatedZoneEndTime(state, pending.sourceName, pending.profileStartTime, pending.price, pending.eligibilityTime, context)
            if not na(rightTime)
                renderZoneFill(state, pending.leftTime, rightTime, pending.zoneLow, pending.zoneHigh, pending.zoneColor, pending.zoneBorderWidth, pending.zoneBorderColor, config)
                if pending.hasLine
                    queueRightLine(state, pending.price, pending.leftTime, rightTime, pending.lineColor, pending.lineWidth, pending.lineStyle, pending.lineRank, pending.sourceName, pending.tradingDayKey, pending.historical, pending.direction, context)
                queueLevelMarker(state, pending.price, levelMarkerTime(rightTime), pending.markerGlyph, pending.markerLabel, pending.markerColor, pending.markerSize, config)
        array.clear(state.pendingMitigatedZones)

export flushFrame(RenderState state, BarContext context, PresentationConfig config) =>
    flushPendingMitigatedZones(state, context, config)
    flushPendingRightLines(state, config, context)
    flushPendingRightLabels(state, config)
    true
