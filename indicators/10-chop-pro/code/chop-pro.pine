//@version=6
indicator('Chop° [Pro+]', shorttitle='Chop° [Pro+]', format=format.price, precision=2)

string GROUP_CALC = 'Calculation'
string GROUP_LEVELS = 'Levels'
string GROUP_STYLE = 'Visuals'

length = input.int(14, 'Length', minval=1, group=GROUP_CALC)
offset = input.int(0, 'Offset', minval=-500, maxval=500, group=GROUP_CALC)
float upperLevel = input.float(61.8, 'Upper Level', minval=0.0, maxval=100.0, group=GROUP_LEVELS)
float middleLevel = input.float(50.0, 'Middle Level', minval=0.0, maxval=100.0, group=GROUP_LEVELS)
float lowerLevel = input.float(38.2, 'Lower Level', minval=0.0, maxval=100.0, group=GROUP_LEVELS)

color lineColor = input.color(color.rgb(41, 98, 255), 'Line Color', group=GROUP_STYLE)

bool showChannelFill = input.bool(true, 'Show Channel Fill', group=GROUP_STYLE)
color channelFillColor = input.color(color.new(color.rgb(33, 150, 243), 90), 'Channel Fill Color', group=GROUP_STYLE)
color bandLineColor = input.color(color.new(color.gray, 0), 'Band Line Color', group=GROUP_STYLE)
string bandLineStyleOpt = input.string('Dashed', 'Band Line Style', options=['Solid', 'Dashed'], group=GROUP_STYLE)
int bandLineWidth = input.int(1, 'Band Line Width', minval=1, maxval=4, group=GROUP_STYLE)

bool showUpperGradient = input.bool(true, 'Show Upper Gradient', group=GROUP_STYLE)
color upperGradientTop = input.color(color.new(color.rgb(244, 67, 54), 40), 'Upper Gradient Top', group=GROUP_STYLE)
color upperGradientBottom = input.color(color.new(color.rgb(244, 67, 54), 85), 'Upper Gradient Bottom', group=GROUP_STYLE)

bool showLowerGradient = input.bool(true, 'Show Lower Gradient', group=GROUP_STYLE)
color lowerGradientTop = input.color(color.new(color.rgb(76, 175, 80), 85), 'Lower Gradient Top', group=GROUP_STYLE)
color lowerGradientBottom = input.color(color.new(color.rgb(76, 175, 80), 40), 'Lower Gradient Bottom', group=GROUP_STYLE)

color upperBandColor = bandLineColor
color middleBandColor = bandLineColor
color lowerBandColor = bandLineColor
color upperGradientTopActive = showUpperGradient ? upperGradientTop : na
color upperGradientBottomActive = showUpperGradient ? upperGradientBottom : na
color lowerGradientTopActive = showLowerGradient ? lowerGradientTop : na
color lowerGradientBottomActive = showLowerGradient ? lowerGradientBottom : na

float highestHigh = ta.highest(high, length)
float lowestLow = ta.lowest(low, length)
float priceRange = highestHigh - lowestLow
float logLength = length > 1 ? math.log10(length) : na
float numerator = math.sum(ta.atr(1), length)
float denominator = priceRange == 0.0 or na(logLength) or na(numerator) ? na : numerator / priceRange
float ci = na(denominator) ? na : 100.0 * math.log10(denominator) / logLength

ciPlot = plot(ci, 'Choppiness', color=lineColor, offset=offset)

float upperFillValue = showUpperGradient ? math.max(ci, upperLevel) : na
float lowerFillValue = showLowerGradient ? math.min(ci, lowerLevel) : na

upperPlot = plot(upperLevel, 'Upper Level Plot', color=upperBandColor, display=display.none, editable=false, offset=offset)
lowerPlot = plot(lowerLevel, 'Lower Level Plot', color=lowerBandColor, display=display.none, editable=false, offset=offset)
upperOverflowPlot = plot(upperFillValue, 'Upper Overflow Plot', color=color.new(upperGradientTop, 0), display=display.none, editable=false, offset=offset)
lowerOverflowPlot = plot(lowerFillValue, 'Lower Overflow Plot', color=color.new(lowerGradientBottom, 0), display=display.none, editable=false, offset=offset)

var line upperChannelLine = na
var line lowerChannelLine = na
var linefill channelFill = na
var line upperBandGuide = na
var line middleBandGuide = na
var line lowerBandGuide = na

if barstate.isfirst
    upperChannelLine := line.new(bar_index, upperLevel, bar_index + 1, upperLevel, xloc=xloc.bar_index, extend=extend.both, color=color.new(color.white, 100))
    lowerChannelLine := line.new(bar_index, lowerLevel, bar_index + 1, lowerLevel, xloc=xloc.bar_index, extend=extend.both, color=color.new(color.white, 100))
    channelFill := linefill.new(upperChannelLine, lowerChannelLine, showChannelFill ? channelFillColor : na)
    upperBandGuide := line.new(bar_index, upperLevel, bar_index + 1, upperLevel, xloc=xloc.bar_index, extend=extend.both, color=upperBandColor, width=bandLineWidth, style=bandLineStyleOpt == 'Solid' ? line.style_solid : line.style_dashed)
    middleBandGuide := line.new(bar_index, middleLevel, bar_index + 1, middleLevel, xloc=xloc.bar_index, extend=extend.both, color=middleBandColor, width=bandLineWidth, style=bandLineStyleOpt == 'Solid' ? line.style_solid : line.style_dashed)
    lowerBandGuide := line.new(bar_index, lowerLevel, bar_index + 1, lowerLevel, xloc=xloc.bar_index, extend=extend.both, color=lowerBandColor, width=bandLineWidth, style=bandLineStyleOpt == 'Solid' ? line.style_solid : line.style_dashed)
else
    line.set_xy1(upperChannelLine, bar_index - 1, upperLevel)
    line.set_xy2(upperChannelLine, bar_index, upperLevel)
    line.set_extend(upperChannelLine, extend.both)
    line.set_xy1(lowerChannelLine, bar_index - 1, lowerLevel)
    line.set_xy2(lowerChannelLine, bar_index, lowerLevel)
    line.set_extend(lowerChannelLine, extend.both)
    line.set_xy1(upperBandGuide, bar_index - 1, upperLevel)
    line.set_xy2(upperBandGuide, bar_index, upperLevel)
    line.set_extend(upperBandGuide, extend.both)
    line.set_color(upperBandGuide, upperBandColor)
    line.set_style(upperBandGuide, bandLineStyleOpt == 'Solid' ? line.style_solid : line.style_dashed)
    line.set_width(upperBandGuide, bandLineWidth)
    line.set_xy1(middleBandGuide, bar_index - 1, middleLevel)
    line.set_xy2(middleBandGuide, bar_index, middleLevel)
    line.set_extend(middleBandGuide, extend.both)
    line.set_color(middleBandGuide, middleBandColor)
    line.set_style(middleBandGuide, bandLineStyleOpt == 'Solid' ? line.style_solid : line.style_dashed)
    line.set_width(middleBandGuide, bandLineWidth)
    line.set_xy1(lowerBandGuide, bar_index - 1, lowerLevel)
    line.set_xy2(lowerBandGuide, bar_index, lowerLevel)
    line.set_extend(lowerBandGuide, extend.both)
    line.set_color(lowerBandGuide, lowerBandColor)
    line.set_style(lowerBandGuide, bandLineStyleOpt == 'Solid' ? line.style_solid : line.style_dashed)
    line.set_width(lowerBandGuide, bandLineWidth)

linefill.set_color(channelFill, showChannelFill ? channelFillColor : na)

fill(upperOverflowPlot, upperPlot, 100.0, upperLevel, top_color=upperGradientTopActive, bottom_color=upperGradientBottomActive, title='Upper Zone Gradient', editable=false)
fill(lowerOverflowPlot, lowerPlot, lowerLevel, 0.0, top_color=lowerGradientTopActive, bottom_color=lowerGradientBottomActive, title='Lower Zone Gradient', editable=false)
