get_label_size(string s) =>
    s == LBL_TINY   ? size.tiny   :
     s == LBL_NORMAL ? size.normal :
     s == LBL_LARGE  ? size.large  :
     s == LBL_HUGE   ? size.huge   :
                       size.small

named_slot_duration_minutes(NamedSlotConfig config) =>
    int rawDuration = config.endMinute - config.startMinute
    rawDuration > 0 ? rawDuration : rawDuration + MINUTES_PER_DAY

named_slot_source_aligned(NamedSlotConfig config) =>
    int sourceMinutes = int(sessionSourceSeconds / SECS_MIN)
    config.startMinute % sourceMinutes == 0 and config.endMinute % sourceMinutes == 0

validate_named_slot_config(NamedSlotConfig config) =>
    bool validBoundaries = config.startMinute >= 0 and config.startMinute < MINUTES_PER_DAY and config.endMinute >= 0 and config.endMinute < MINUTES_PER_DAY and config.startMinute != config.endMinute
    if not validBoundaries
        runtime.error(config.sourceLabel + " session boundaries must be distinct minutes within one NY day.")
    if not named_slot_source_aligned(config)
        runtime.error(config.sourceLabel + " session boundaries must align with the session source timeframe.")
    if config.sampleLookback < 1 or config.historyLimit < 1 or config.forecastLeadMinutes < 0
        runtime.error(config.sourceLabel + " lookbacks must be positive and forecast lead cannot be negative.")

named_slot_timestamp(int referenceTime, int minuteOfDay, int dayOffset) =>
    int sessionHour = int(minuteOfDay / MINUTES_PER_HOUR)
    int sessionMinute = minuteOfDay % MINUTES_PER_HOUR
    timestamp(NY_TIMEZONE, year(referenceTime, NY_TIMEZONE), month(referenceTime, NY_TIMEZONE), dayofmonth(referenceTime, NY_TIMEZONE) + dayOffset, sessionHour, sessionMinute)

named_slot_bounds(int referenceTime, int startMinute, int endMinute) =>
    int currentMinute = hour(referenceTime, NY_TIMEZONE) * MINUTES_PER_HOUR + minute(referenceTime, NY_TIMEZONE)
    bool wrapsMidnight = endMinute <= startMinute
    bool inWindow = wrapsMidnight ? currentMinute >= startMinute or currentMinute < endMinute : currentMinute >= startMinute and currentMinute < endMinute
    int startDayOffset = wrapsMidnight and currentMinute < endMinute ? -1 : 0
    int endDayOffset = startDayOffset + (wrapsMidnight ? 1 : 0)
    [inWindow, named_slot_timestamp(referenceTime, startMinute, startDayOffset), named_slot_timestamp(referenceTime, endMinute, endDayOffset)]

next_named_slot_bounds(int referenceTime, NamedSlotConfig config) =>
    int todayStart = named_slot_timestamp(referenceTime, config.startMinute, 0)
    int dayOffset = referenceTime < todayStart ? 0 : 1
    int nextStart = named_slot_timestamp(referenceTime, config.startMinute, dayOffset)
    if config.forecastWeekdaysOnly
        while dayofweek(nextStart, NY_TIMEZONE) == dayofweek.saturday or dayofweek(nextStart, NY_TIMEZONE) == dayofweek.sunday
            dayOffset += 1
            nextStart := named_slot_timestamp(referenceTime, config.startMinute, dayOffset)
    int endDayOffset = dayOffset + (config.endMinute <= config.startMinute ? 1 : 0)
    [nextStart, named_slot_timestamp(referenceTime, config.endMinute, endDayOffset)]

named_slot_valid(NamedSlotConfig config) =>
    int durationSeconds = named_slot_duration_minutes(config) * SECS_MIN
    config.enabled and (chart.is_range or timeframe.in_seconds(timeframe.period) < durationSeconds)

named_slot_forecast_visible(NamedSlotConfig config, bool valid, int referenceTime, int forecastStart) =>
    int leadMilliseconds = config.forecastLeadMinutes * SECS_MIN * MS_PER_SEC
    showNextRangeForecast and config.forecastEnabled and valid and referenceTime >= forecastStart - leadMilliseconds and referenceTime < forecastStart

validate_named_slot_config(overnightConfig)
validate_named_slot_config(nyEarlyConfig)
validate_named_slot_config(nyAmConfig)
validate_named_slot_config(ivbConfig)
validate_named_slot_config(ivbPlusConfig)

// HTF RESOLUTION

get_resolved_tf_label(string tf) =>
    int tfSeconds = timeframe.in_seconds(tf)
    tfSeconds == SECS_DAY and midnightDailyEnabled ? "Mn • 1D" : get_tf_display_label(tf)

string CHART_TF = timeframe.period
[s1AutoValid, s1AutoTF, s1AutoLabel] = get_tf_pairing(CHART_TF, 1)
[s2AutoValid, s2AutoTF, s2AutoLabel] = get_tf_pairing(CHART_TF, 2)
[s3AutoValid, s3AutoTF, s3AutoLabel] = get_tf_pairing(CHART_TF, 3)
[s4AutoValid, s4AutoTF, s4AutoLabel] = get_tf_pairing(CHART_TF, 4)

string s1TF    = (slot1Manual or chart.is_range) ? slot1TFIn : (s1AutoValid ? s1AutoTF : "1D")
bool   s1Valid = slot1Show and (slot1Manual or chart.is_range or s1AutoValid) and (chart.is_range or timeframe.in_seconds(s1TF) > timeframe.in_seconds())
string s1Safe  = s1Valid ? s1TF : "1D"
string s1Label = get_resolved_tf_label(s1TF)
string s1IdentifierText = s1Label + " ¹"

string s2TF    = (slot2Manual or chart.is_range) ? slot2TFIn : (s2AutoValid ? s2AutoTF : "1D")
bool   s2Valid = slot2Show and (slot2Manual or chart.is_range or s2AutoValid) and (chart.is_range or timeframe.in_seconds(s2TF) > timeframe.in_seconds())
string s2Safe  = s2Valid ? s2TF : "1D"
string s2Label = get_resolved_tf_label(s2TF)
string s2IdentifierText = s2Label + " ²"

string s3TF    = (slot3Manual or chart.is_range) ? slot3TFIn : (s3AutoValid ? s3AutoTF : "1D")
bool   s3Valid = slot3Show and (slot3Manual or chart.is_range or s3AutoValid) and (chart.is_range or timeframe.in_seconds(s3TF) > timeframe.in_seconds())
string s3Safe  = s3Valid ? s3TF : "1D"
string s3Label = get_resolved_tf_label(s3TF)
string s3IdentifierText = s3Label + " ³"

string s4TF    = (slot4Manual or chart.is_range) ? slot4TFIn : (s4AutoValid ? s4AutoTF : "1D")
bool   s4Valid = slot4Show and (slot4Manual or chart.is_range or s4AutoValid) and (chart.is_range or timeframe.in_seconds(s4TF) > timeframe.in_seconds())
string s4Safe  = s4Valid ? s4TF : "1D"
string s4Label = get_resolved_tf_label(s4TF)
string s4IdentifierText = s4Label + " ⁴"

bool overnightValid = named_slot_valid(overnightConfig)
bool nyEarlyValid = named_slot_valid(nyEarlyConfig)
bool nyAmValid = named_slot_valid(nyAmConfig)
bool ivbValid = named_slot_valid(ivbConfig)
bool ivbPlusValid = named_slot_valid(ivbPlusConfig)
string overnightIdentifierText = overnightConfig.sourceLabel
string nyEarlyIdentifierText = nyEarlyConfig.sourceLabel
string nyAmIdentifierText = nyAmConfig.sourceLabel
string ivbIdentifierText = ivbConfig.sourceLabel
string ivbPlusIdentifierText = ivbPlusConfig.sourceLabel

next_forecast_visible(bool slotEnabled, bool valid) =>
    showNextRangeForecast and slotEnabled and valid

// HTF DATA — normal running high/low are tracked chart-side. Wall-clock sessions use
// a 30-minute context so their boundaries remain independent of chart bars.
string htfTickerId = chart.is_range ? ticker.standard(syminfo.tickerid) : syminfo.tickerid

fetch_htf_open(string tickerId, string tf) =>
    request.security(tickerId, tf, open, lookahead=barmerge.lookahead_on)

fetch_htf_stats(string tickerId, string tf) =>
    request.security(tickerId, tf,
         [ta.median(high - open, htfSlotLookback), ta.sma(high - open, htfSlotLookback),
          ta.median(open - low,  htfSlotLookback), ta.sma(open - low,  htfSlotLookback)],
         lookahead=barmerge.lookahead_off)

sample_stats(array<float> samples) =>
    int sampleCount = array.size(samples)
    [sampleCount > 0 ? array.median(samples) : na,
     sampleCount > 0 ? array.avg(samples) : na]

record_excursion_sample(array<float> highOpenSamples, array<float> openLowSamples, float sessionOpen, float sessionHigh, float sessionLow, int sampleLimit) =>
    array.push(highOpenSamples, sessionHigh - sessionOpen)
    array.push(openLowSamples, sessionOpen - sessionLow)
    while array.size(highOpenSamples) > sampleLimit
        array.shift(highOpenSamples)
    while array.size(openLowSamples) > sampleLimit
        array.shift(openLowSamples)

next_ny_midnight(int dayStart) =>
    int nextDayProbe = dayStart + 36 * SECS_HOUR * MS_PER_SEC
    timestamp(NY_TIMEZONE, year(nextDayProbe, NY_TIMEZONE), month(nextDayProbe, NY_TIMEZONE), dayofmonth(nextDayProbe, NY_TIMEZONE), 0, 0)

fetch_midnight_daily_data(bool enabled, int sampleLimit) =>
    var array<float> highOpenSamples = array.new<float>()
    var array<float> openLowSamples = array.new<float>()
    var int observedDayStart = na
    var int sessionStartTime = na
    var int sessionEndTime = na
    var bool sessionStartedAtBoundary = false
    var float sessionOpen = na
    var float sessionHigh = na
    var float sessionLow = na
    var float completedSessionHigh = na
    var float completedSessionLow = na
    var float projectedMedHO = na
    var float projectedMeanHO = na
    var float projectedMedOL = na
    var float projectedMeanOL = na

    if enabled
        int currentDayStart = timestamp(NY_TIMEZONE, year(time, NY_TIMEZONE), month(time, NY_TIMEZONE), dayofmonth(time, NY_TIMEZONE), 0, 0)
        bool periodChanged = not na(observedDayStart) and currentDayStart != observedDayStart
        bool sundayReopen = periodChanged and syminfo.type == "futures" and dayofweek(time, NY_TIMEZONE) == dayofweek.sunday
        bool periodRolled = periodChanged and not sundayReopen

        if na(sessionStartTime)
            sessionStartTime := currentDayStart
            sessionOpen := open
            sessionHigh := high
            sessionLow := low
        else if periodRolled
            completedSessionHigh := sessionHigh
            completedSessionLow := sessionLow
            if sessionStartedAtBoundary
                record_excursion_sample(highOpenSamples, openLowSamples, sessionOpen, sessionHigh, sessionLow, sampleLimit)
                [nextMedHO, nextMeanHO] = sample_stats(highOpenSamples)
                [nextMedOL, nextMeanOL] = sample_stats(openLowSamples)
                projectedMedHO := nextMedHO
                projectedMeanHO := nextMeanHO
                projectedMedOL := nextMedOL
                projectedMeanOL := nextMeanOL
            sessionStartTime := currentDayStart
            sessionOpen := open
            sessionHigh := high
            sessionLow := low
            sessionStartedAtBoundary := true
        else
            sessionHigh := math.max(sessionHigh, high)
            sessionLow := math.min(sessionLow, low)

        observedDayStart := currentDayStart
        sessionEndTime := next_ny_midnight(currentDayStart)

    [sessionStartTime, sessionEndTime, sessionOpen, sessionHigh, sessionLow, completedSessionHigh, completedSessionLow,
     projectedMedHO, projectedMeanHO,
     projectedMedOL, projectedMeanOL]

fetch_named_slot_data(bool enabled, int sampleLimit, int startMinute, int endMinute, bool weekdaysOnly) =>
    var array<float> highOpenSamples = array.new<float>()
    var array<float> openLowSamples = array.new<float>()
    var bool collecting = false
    var int sessionStartTime = na
    var int sessionEndTime = na
    var int lastSessionBarTime = na
    var int lastSessionBarCloseTime = na
    var float sessionOpen = na
    var float sessionHigh = na
    var float sessionLow = na
    var float projectedMedHO = na
    var float projectedMeanHO = na
    var float projectedMedOL = na
    var float projectedMeanOL = na

    if enabled
        [inWindow, currentSessionStart, currentSessionEnd] = named_slot_bounds(time, startMinute, endMinute)
        int sessionDay = dayofweek(currentSessionStart, NY_TIMEZONE)
        bool eligibleSession = not weekdaysOnly or sessionDay >= dayofweek.monday and sessionDay <= dayofweek.friday
        bool collectThisBar = inWindow and eligibleSession
        bool finalizePrevious = collecting and (not collectThisBar or currentSessionStart != sessionStartTime)

        if finalizePrevious
            bool sessionComplete = lastSessionBarTime == sessionEndTime - sessionSourceSeconds * MS_PER_SEC and lastSessionBarCloseTime >= sessionEndTime
            if sessionComplete
                record_excursion_sample(highOpenSamples, openLowSamples, sessionOpen, sessionHigh, sessionLow, sampleLimit)
            collecting := false

        bool startsNow = collectThisBar and time == currentSessionStart and not collecting
        if startsNow
            [nextMedHO, nextMeanHO] = sample_stats(highOpenSamples)
            [nextMedOL, nextMeanOL] = sample_stats(openLowSamples)
            projectedMedHO := nextMedHO
            projectedMeanHO := nextMeanHO
            projectedMedOL := nextMedOL
            projectedMeanOL := nextMeanOL
            sessionStartTime := currentSessionStart
            sessionEndTime := currentSessionEnd
            sessionOpen := open
            sessionHigh := high
            sessionLow := low
            lastSessionBarTime := time
            lastSessionBarCloseTime := time_close
            collecting := true
        else if collectThisBar and collecting and currentSessionStart == sessionStartTime
            sessionHigh := math.max(sessionHigh, high)
            sessionLow := math.min(sessionLow, low)
            lastSessionBarTime := time
            lastSessionBarCloseTime := time_close

    [sessionStartTime, sessionEndTime, sessionOpen, sessionHigh, sessionLow,
     projectedMedHO, projectedMeanHO,
     projectedMedOL, projectedMeanOL]

resolve_named_slot_chart_state(NamedSlotChartState chartState, bool trackOnChart,
                                  int sessionStartTime, int sessionEndTime,
                                  float requestedRunHigh, float requestedRunLow) =>
    bool rangeBarInWindow = chart.is_range and not na(sessionStartTime) and time < sessionEndTime and (time >= sessionStartTime or (not na(time_close) and time_close > sessionStartTime))
    bool rangeSessionStart = rangeBarInWindow and (not rangeBarInWindow[1] or sessionStartTime != sessionStartTime[1])
    int startTimeChange = ta.change(sessionStartTime)
    bool requestedTransition = not na(sessionStartTime) and startTimeChange != 0
    bool transition = chart.is_range ? rangeSessionStart : requestedTransition
    int startIndex = nz(ta.valuewhen(transition, bar_index, 0), 0)
    int capturedStartTime = ta.valuewhen(rangeBarInWindow, sessionStartTime, 0)
    int rangeEndIndex = ta.valuewhen(rangeBarInWindow, bar_index + 1, 0)
    int endIndex = capturedStartTime == sessionStartTime ? rangeEndIndex : na

    bool chartBarInWindow = trackOnChart and (chart.is_range ? rangeBarInWindow : not na(sessionStartTime) and time >= sessionStartTime and time < sessionEndTime)
    bool chartSessionStart = chartBarInWindow and (not chartBarInWindow[1] or sessionStartTime != sessionStartTime[1])
    if chartSessionStart
        chartState.runHigh := high
        chartState.runLow := low
    else if chartBarInWindow
        chartState.runHigh := math.max(chartState.runHigh, high)
        chartState.runLow := math.min(chartState.runLow, low)

    float effectiveRunHigh = trackOnChart ? chartState.runHigh : requestedRunHigh
    float effectiveRunLow = trackOnChart ? chartState.runLow : requestedRunLow
    [transition, startIndex, endIndex, effectiveRunHigh, effectiveRunLow]

s1O = fetch_htf_open(htfTickerId, s1Safe)
s2O = fetch_htf_open(htfTickerId, s2Safe)
s3O = fetch_htf_open(htfTickerId, s3Safe)
s4O = fetch_htf_open(htfTickerId, s4Safe)

[s1NormMedHO, s1NormMeanHO, s1NormMedOL, s1NormMeanOL] = fetch_htf_stats(htfTickerId, s1Safe)
[s2NormMedHO, s2NormMeanHO, s2NormMedOL, s2NormMeanOL] = fetch_htf_stats(htfTickerId, s2Safe)
[s3NormMedHO, s3NormMeanHO, s3NormMedOL, s3NormMeanOL] = fetch_htf_stats(htfTickerId, s3Safe)
[s4NormMedHO, s4NormMeanHO, s4NormMedOL, s4NormMeanOL] = fetch_htf_stats(htfTickerId, s4Safe)

bool midnightDailyTrackOnChart = chart.is_range or timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds(SESSION_SOURCE_TIMEFRAME)
[midnightDayStart, midnightDayEnd, midnightOpen, midnightRunHigh, midnightRunLow, midnightCompletedRunHigh, midnightCompletedRunLow,
 midnightMedHO, midnightMeanHO,
 midnightMedOL, midnightMeanOL] = request.security(htfTickerId, SESSION_SOURCE_TIMEFRAME, fetch_midnight_daily_data(midnightDailyEnabled, htfSlotLookback),
     lookahead=midnightDailyTrackOnChart ? barmerge.lookahead_on : barmerge.lookahead_off, calc_bars_count=SESSION_REQUEST_BARS)
bool midnightChartBarInDay = midnightDailyTrackOnChart and not na(midnightDayStart) and time < midnightDayEnd and (time >= midnightDayStart or (not na(time_close) and time_close > midnightDayStart))
bool midnightChartNewDay = midnightChartBarInDay and not na(midnightDayStart[1]) and (not midnightChartBarInDay[1] or midnightDayStart != midnightDayStart[1])
int midnightDayStartChange = ta.change(midnightDayStart)
bool midnightRequestedNewDay = not na(midnightDayStart) and midnightDayStartChange != 0
bool midnightNewDay = midnightDailyTrackOnChart ? midnightChartNewDay : midnightRequestedNewDay
int midnightDayStartIndex = nz(ta.valuewhen(midnightNewDay, bar_index, 0), 0)
var float midnightChartRunHigh = na
var float midnightChartRunLow = na
if midnightChartBarInDay
    if midnightChartNewDay or na(midnightChartRunHigh)
        midnightChartRunHigh := high
        midnightChartRunLow := low
    else
        midnightChartRunHigh := math.max(midnightChartRunHigh, high)
        midnightChartRunLow := math.min(midnightChartRunLow, low)
float midnightEffectiveRunHigh = midnightDailyTrackOnChart ? midnightChartRunHigh : midnightRunHigh
float midnightEffectiveRunLow = midnightDailyTrackOnChart ? midnightChartRunLow : midnightRunLow

bool namedSlotTrackOnChart = chart.is_range or timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds(SESSION_SOURCE_TIMEFRAME)
[overnightStartT, overnightEndT, overnightOpen, overnightRunHigh, overnightRunLow,
 overnightMedHO, overnightMeanHO,
 overnightMedOL, overnightMeanOL] = request.security(htfTickerId, SESSION_SOURCE_TIMEFRAME, fetch_named_slot_data(overnightValid, overnightConfig.sampleLookback, overnightConfig.startMinute, overnightConfig.endMinute, overnightConfig.samplingWeekdaysOnly),
     lookahead=namedSlotTrackOnChart ? barmerge.lookahead_on : barmerge.lookahead_off, calc_bars_count=SESSION_REQUEST_BARS)
var NamedSlotChartState overnightChartState = NamedSlotChartState.new()
[overnightTransition, overnightStartIndex, overnightEndIndex, overnightEffectiveRunHigh, overnightEffectiveRunLow] = resolve_named_slot_chart_state(
     overnightChartState, namedSlotTrackOnChart, overnightStartT, overnightEndT, overnightRunHigh, overnightRunLow)

[nyEarlyStartT, nyEarlyEndT, nyEarlyOpen, nyEarlyRunHigh, nyEarlyRunLow,
 nyEarlyMedHO, nyEarlyMeanHO,
 nyEarlyMedOL, nyEarlyMeanOL] = request.security(htfTickerId, SESSION_SOURCE_TIMEFRAME, fetch_named_slot_data(nyEarlyValid, nyEarlyConfig.sampleLookback, nyEarlyConfig.startMinute, nyEarlyConfig.endMinute, nyEarlyConfig.samplingWeekdaysOnly),
     lookahead=namedSlotTrackOnChart ? barmerge.lookahead_on : barmerge.lookahead_off, calc_bars_count=SESSION_REQUEST_BARS)
var NamedSlotChartState nyEarlyChartState = NamedSlotChartState.new()
[nyEarlyTransition, nyEarlyStartIndex, nyEarlyEndIndex, nyEarlyEffectiveRunHigh, nyEarlyEffectiveRunLow] = resolve_named_slot_chart_state(
     nyEarlyChartState, namedSlotTrackOnChart, nyEarlyStartT, nyEarlyEndT, nyEarlyRunHigh, nyEarlyRunLow)

[nyAmStartT, nyAmEndT, nyAmOpen, nyAmRunHigh, nyAmRunLow,
 nyAmMedHO, nyAmMeanHO,
 nyAmMedOL, nyAmMeanOL] = request.security(htfTickerId, SESSION_SOURCE_TIMEFRAME, fetch_named_slot_data(nyAmValid, nyAmConfig.sampleLookback, nyAmConfig.startMinute, nyAmConfig.endMinute, nyAmConfig.samplingWeekdaysOnly),
     lookahead=namedSlotTrackOnChart ? barmerge.lookahead_on : barmerge.lookahead_off, calc_bars_count=SESSION_REQUEST_BARS)
var NamedSlotChartState nyAmChartState = NamedSlotChartState.new()
[nyAmTransition, nyAmStartIndex, nyAmEndIndex, nyAmEffectiveRunHigh, nyAmEffectiveRunLow] = resolve_named_slot_chart_state(
     nyAmChartState, namedSlotTrackOnChart, nyAmStartT, nyAmEndT, nyAmRunHigh, nyAmRunLow)

[ivbStartT, ivbEndT, ivbOpen, ivbRunHigh, ivbRunLow,
 ivbMedHO, ivbMeanHO,
 ivbMedOL, ivbMeanOL] = request.security(htfTickerId, SESSION_SOURCE_TIMEFRAME, fetch_named_slot_data(ivbValid, ivbConfig.sampleLookback, ivbConfig.startMinute, ivbConfig.endMinute, ivbConfig.samplingWeekdaysOnly),
     lookahead=namedSlotTrackOnChart ? barmerge.lookahead_on : barmerge.lookahead_off, calc_bars_count=SESSION_REQUEST_BARS)
var NamedSlotChartState ivbChartState = NamedSlotChartState.new()
[ivbTransition, ivbStartIndex, ivbEndIndex, ivbEffectiveRunHigh, ivbEffectiveRunLow] = resolve_named_slot_chart_state(
     ivbChartState, namedSlotTrackOnChart, ivbStartT, ivbEndT, ivbRunHigh, ivbRunLow)

[ivbPlusStartT, ivbPlusEndT, ivbPlusOpen, ivbPlusRunHigh, ivbPlusRunLow,
 ivbPlusMedHO, ivbPlusMeanHO,
 ivbPlusMedOL, ivbPlusMeanOL] = request.security(htfTickerId, SESSION_SOURCE_TIMEFRAME, fetch_named_slot_data(ivbPlusValid, ivbPlusConfig.sampleLookback, ivbPlusConfig.startMinute, ivbPlusConfig.endMinute, ivbPlusConfig.samplingWeekdaysOnly),
     lookahead=namedSlotTrackOnChart ? barmerge.lookahead_on : barmerge.lookahead_off, calc_bars_count=SESSION_REQUEST_BARS)
var NamedSlotChartState ivbPlusChartState = NamedSlotChartState.new()
[ivbPlusTransition, ivbPlusStartIndex, ivbPlusEndIndex, ivbPlusEffectiveRunHigh, ivbPlusEffectiveRunLow] = resolve_named_slot_chart_state(
     ivbPlusChartState, namedSlotTrackOnChart, ivbPlusStartT, ivbPlusEndT, ivbPlusRunHigh, ivbPlusRunLow)

var float s1RunHigh = na
var float s1RunLow  = na
var float s2RunHigh = na
var float s2RunLow  = na
var float s3RunHigh = na
var float s3RunLow  = na
var float s4RunHigh = na
var float s4RunLow  = na
int s1PeriodChange = ta.change(time(s1Safe))
int s2PeriodChange = ta.change(time(s2Safe))
int s3PeriodChange = ta.change(time(s3Safe))
int s4PeriodChange = ta.change(time(s4Safe))

if s1Valid
    if na(s1RunHigh) or s1PeriodChange != 0
        s1RunHigh := high
        s1RunLow  := low
    else
        s1RunHigh := math.max(s1RunHigh, high)
        s1RunLow  := math.min(s1RunLow,  low)

if s2Valid
    if na(s2RunHigh) or s2PeriodChange != 0
        s2RunHigh := high
        s2RunLow  := low
    else
        s2RunHigh := math.max(s2RunHigh, high)
        s2RunLow  := math.min(s2RunLow,  low)

if s3Valid
    if na(s3RunHigh) or s3PeriodChange != 0
        s3RunHigh := high
        s3RunLow  := low
    else
        s3RunHigh := math.max(s3RunHigh, high)
        s3RunLow  := math.min(s3RunLow,  low)

if s4Valid
    if na(s4RunHigh) or s4PeriodChange != 0
        s4RunHigh := high
        s4RunLow  := low
    else
        s4RunHigh := math.max(s4RunHigh, high)
        s4RunLow  := math.min(s4RunLow,  low)

// NATIVE DAILY SESSION — rolls at the 18:00 ET reopen regardless of TradingView's
// holiday-merged "D" bar. Shifting +6h maps 18:00 ET to the next NY calendar date.
int  nativeShifted = time + NATIVE_SHIFT_MS
int  nativeTradeId = year(nativeShifted, NY_TIMEZONE) * 10000 + month(nativeShifted, NY_TIMEZONE) * 100 + dayofmonth(nativeShifted, NY_TIMEZONE)
bool nativeNewDay  = ta.change(nativeTradeId) != 0
var int   nativeDayStart = na
var int   nativeDayStartIndex = na
var float nativeOpen     = na
var float nativeRunHigh  = na
var float nativeRunLow   = na
if nativeNewDay or na(nativeDayStart)
    nativeDayStart := time
    nativeDayStartIndex := bar_index
    nativeOpen     := open
    nativeRunHigh  := high
    nativeRunLow   := low
else
    nativeRunHigh := math.max(nativeRunHigh, high)
    nativeRunLow  := math.min(nativeRunLow,  low)

// NATIVE WEEKLY SESSION — rolls at the Sunday 18:00 ET reopen, ignoring TradingView's
// holiday-shifted "W" bar (e.g. a Friday Juneteenth would otherwise break the week early).
bool nativeNewWeek = nativeNewDay and dayofweek(time, NY_TIMEZONE) == dayofweek.sunday
var int   nativeWeekStartT  = na
var int   nativeWeekStartIndex = na
var float nativeWeekOpen    = na
var float nativeWeekRunHigh = na
var float nativeWeekRunLow  = na
if nativeNewWeek or na(nativeWeekStartT)
    nativeWeekStartT  := time
    nativeWeekStartIndex := bar_index
    nativeWeekOpen    := open
    nativeWeekRunHigh := high
    nativeWeekRunLow  := low
else
    nativeWeekRunHigh := math.max(nativeWeekRunHigh, high)
    nativeWeekRunLow  := math.min(nativeWeekRunLow,  low)

// SLOT STATE INSTANCES

new_slot() =>
    SlotState.new(histBoxes=array.new<box>(), fibLines=array.new<line>(), histFibLines=array.new<line>(), fibLabels=array.new<label>(), histFibLabels=array.new<label>())

var SlotState slot1 = new_slot()
var SlotState slot2 = new_slot()
var SlotState slot3 = new_slot()
var SlotState slot4 = new_slot()
var SlotState overnightSlot = new_slot()
var SlotState nyEarlySlot = new_slot()
var SlotState nyAmSlot = new_slot()
var SlotState ivbSlot = new_slot()
var SlotState ivbPlusSlot = new_slot()

// DRAWING HELPERS

zone_fill_color(color slotColor) =>
    color.new(slotColor, 85)

forecast_zone_fill_color(color slotColor) =>
    color.new(slotColor, math.min(85 + FORECAST_FILL_TRANSPARENCY_BOOST, 100))

forecast_border_color(color slotColor) =>
    color.new(slotColor, int(math.max(color.t(slotColor), FORECAST_BORDER_MIN_TRANSPARENCY)))

drawing_x(int timeX, int indexX, bool timeBased) =>
    (timeBased or not chart.is_range) ? timeX : math.min(math.max(na(indexX) ? bar_index : indexX, bar_index - BAR_INDEX_DRAWING_LOOKBACK), bar_index + BAR_INDEX_DRAWING_LOOKAHEAD)

drawing_xloc(bool timeBased) =>
    (timeBased or not chart.is_range) ? xloc.bar_time : xloc.bar_index

make_zone_box(bool timeBased, int leftT, int leftIndex, float top, int rightT, int rightIndex, float bottom, color fillClr, color slotColor, string txt, string slotLabelSize, int textTransparency) =>
    box.new(drawing_x(leftT, leftIndex, timeBased), top, drawing_x(rightT, rightIndex, timeBased), bottom,
         bgcolor=fillClr, border_color=na, xloc=drawing_xloc(timeBased),
         text=txt, text_color=color.new(slotColor, textTransparency),
         text_size=get_label_size(slotLabelSize),
         text_halign=text.align_center, text_valign=text.align_center)

make_horizontal_line(bool timeBased, int leftT, int leftIndex, int rightT, int rightIndex, float price, color lineColor, string lineStyle, int lineWidth) =>
    line.new(drawing_x(leftT, leftIndex, timeBased), price, drawing_x(rightT, rightIndex, timeBased), price,
         color=lineColor, style=lineStyle, width=lineWidth, xloc=drawing_xloc(timeBased))

make_fib_label(int anchorT, int anchorIndex, float price, string txt, string labelStyle, color textColor, string labelSize) =>
    label.new(drawing_x(anchorT, anchorIndex, false), price, txt, xloc=drawing_xloc(false), style=labelStyle,
         color=color.new(color.white, 100), textcolor=textColor, size=labelSize)

compute_levels(float htfO, float medHO, float meanHO, float medOL, float meanOL) =>
    [htfO + medHO, htfO + meanHO,
     htfO - medOL, htfO - meanOL]

// Pushes one line per visible fib level into `target`. Anchors define 0% / 100% of the fib range.
push_fib_lines(array<line> target, bool timeBasedLines, int leftT, int leftIndex, int rightT, int rightIndex, float anchorHigh, float anchorLow, int transparencyBoost,
               array<label> labelTarget, string tfLabel, bool drawLabels, string labelSize, string labelPos, int labelOffsetMs, int labelOffsetBars) =>
    if not na(anchorHigh) and not na(anchorLow)
        float fibRange = anchorHigh - anchorLow

        shows      = array.from(showFib100, showFib786, showFib705, showFib618, showFib50, showFib382, showFib295, showFib214, showFib0)
        levels     = array.from(FIB_LEVEL_100, FIB_LEVEL_786, FIB_LEVEL_705, FIB_LEVEL_618, FIB_LEVEL_50, FIB_LEVEL_382, FIB_LEVEL_295, FIB_LEVEL_214, FIB_LEVEL_0)
        colors     = array.from(fibColor100, fibColor786, fibColor705, fibColor618, fibColor50, fibColor382, fibColor295, fibColor214, fibColor0)
        widths     = array.from(fibWidth100, fibWidth786, fibWidth705, fibWidth618, fibWidth50, fibWidth382, fibWidth295, fibWidth214, fibWidth0)
        ratioTexts = array.from("1.0", "0.786", "0.705", "0.618", "0.5", "0.382", "0.295", "0.214", "0")
        isKeyLevel = array.from(fibKey100, fibKey786, fibKey705, fibKey618, fibKey50, fibKey382, fibKey295, fibKey214, fibKey0)

        bool keyOnly = fibLabelLevels == FL_KEY

        for i = 0 to 8
            if array.get(shows, i)
                float price   = anchorLow + fibRange * array.get(levels, i)
                color baseClr = array.get(colors, i)
                // Clamp at 95 so higher-tier slots never become fully invisible.
                color clr     = color.new(baseClr, math.min(int(color.t(baseClr)) + transparencyBoost, 95))
                line fibLine = make_horizontal_line(timeBasedLines, leftT, leftIndex, rightT, rightIndex, price, clr, line.style_dotted, array.get(widths, i))
                array.push(target, fibLine)

                if drawLabels and (not keyOnly or array.get(isKeyLevel, i))
                    // Tint label text to match its line, but pull transparency down so faint levels stay legible.
                    color  txtClr  = color.new(baseClr, math.min(FIB_LABEL_TRANSPARENCY_MAX, math.max(0.0, color.t(baseClr) - FIB_LABEL_TRANSPARENCY_REDUCTION)))
                    string lblText = tfLabel + " • " + array.get(ratioTexts, i)
                    // Offset pushes each tag outward from its anchor edge (right tags later, left tags earlier)
                    // so slots whose zones end on the same bar don't stack their tags on one x-coordinate.
                    if labelPos == POS_RIGHT or labelPos == POS_BOTH
                        array.push(labelTarget, make_fib_label(rightT + labelOffsetMs, rightIndex + labelOffsetBars, price, lblText, label.style_label_left, txtClr, labelSize))
                    if labelPos == POS_LEFT or labelPos == POS_BOTH
                        array.push(labelTarget, make_fib_label(leftT - labelOffsetMs, leftIndex - labelOffsetBars, price, lblText, label.style_label_right, txtClr, labelSize))

draw_slot_fib(SlotState s, int leftT, int leftIndex, int rightT, int rightIndex, float anchorHigh, float anchorLow, int transparencyBoost, string tfLabel, bool drawLabels, string labelSize, string labelPos, int labelOffsetMs, int labelOffsetBars) =>
    push_fib_lines(s.fibLines, true, leftT, leftIndex, rightT, rightIndex, anchorHigh, anchorLow, transparencyBoost, s.fibLabels, tfLabel, drawLabels, labelSize, labelPos, labelOffsetMs, labelOffsetBars)

// Resolves a slot's rollover, dual-coordinate anchors, and effective open/run-high/low.
resolve_slot_timing(string safe, float normOpen, float normRunHigh, float normRunLow,
                    bool nNewDay, int nDayStart, int nDayStartIndex, int nDayEnd, float nOpen, float nRunHigh, float nRunLow,
                    bool nNewWeek, int nWeekStart, int nWeekStartIndex, float nwOpen, float nwRunHigh, float nwRunLow) =>
    bool isDaily   = timeframe.in_seconds(safe) == SECS_DAY
    bool isWeekly  = timeframe.in_seconds(safe) == SECS_WEEK
    int  normStart = time(safe)
    int  normRight = normStart + timeframe.in_seconds(safe) * MS_PER_SEC
    bool normTrans = ta.change(time(safe)) != 0
    int  normStartIndex = nz(ta.valuewhen(normTrans, bar_index, 0), 0)
    if isDaily and holidayMode == HOLIDAY_NATIVE
        [nNewDay, nDayStart, nDayStartIndex, nDayEnd, nOpen, nRunHigh, nRunLow]
    else if isWeekly and holidayMode == HOLIDAY_NATIVE
        [nNewWeek, nWeekStart, nWeekStartIndex, nWeekStart + SECS_WEEK * MS_PER_SEC, nwOpen, nwRunHigh, nwRunLow]
    else if isDaily and holidayMode == HOLIDAY_EXTEND
        [normTrans, normStart, normStartIndex, (normRight > time ? normRight : time), normOpen, normRunHigh, normRunLow]
    else
        [normTrans, normStart, normStartIndex, normRight, normOpen, normRunHigh, normRunLow]

resolve_slot_stats(string safe,
                   float normMedHO, float normMeanHO, float normMedOL, float normMeanOL,
                   float dailyMedHO, float dailyMeanHO, float dailyMedOL, float dailyMeanOL) =>
    bool useMidnightStats = timeframe.in_seconds(safe) == SECS_DAY and midnightDailyEnabled
    if useMidnightStats
        [dailyMedHO, dailyMeanHO, dailyMedOL, dailyMeanOL]
    else
        [normMedHO, normMeanHO, normMedOL, normMeanOL]

resolve_archived_extrema(string safe, float runHigh, float runLow, float completedMidnightHigh, float completedMidnightLow) =>
    bool useCompletedMidnight = timeframe.in_seconds(safe) == SECS_DAY and midnightDailyEnabled and not na(completedMidnightHigh) and not na(completedMidnightLow)
    [useCompletedMidnight ? completedMidnightHigh : runHigh[1], useCompletedMidnight ? completedMidnightLow : runLow[1]]

current_line_request(bool valid, bool fibEnabled, int fibLinesPerZone) =>
    valid ? 4 + (fibEnabled ? fibLinesPerZone : 0) : 0

history_zone_request(bool latestOnlyEnabled, int historyN) =>
    latestOnlyEnabled ? 0 : math.max(0, historyN - 1)

fib_history_zone_request(bool latestOnlyEnabled, int historyN, int fibHistoryN) =>
    math.min(history_zone_request(latestOnlyEnabled, historyN), fibHistoryN)

allocate_history_zone_caps(int availableZones, array<bool> validSlots, array<int> zoneRequests, int ordinarySlotCount, int maxHistoryZones) =>
    int slotCount = array.size(validSlots)
    array<int> zoneCaps = array.new<int>(slotCount, 0)
    int remaining = availableZones
    for layer = 1 to maxHistoryZones
        for slotIndex = 0 to ordinarySlotCount - 1
            if array.get(validSlots, slotIndex) and layer <= array.get(zoneRequests, slotIndex) and remaining > 0
                array.set(zoneCaps, slotIndex, array.get(zoneCaps, slotIndex) + 1)
                remaining -= 1
    for layer = 1 to maxHistoryZones
        for slotIndex = ordinarySlotCount to slotCount - 1
            if array.get(validSlots, slotIndex) and layer <= array.get(zoneRequests, slotIndex) and remaining > 0
                array.set(zoneCaps, slotIndex, array.get(zoneCaps, slotIndex) + 1)
                remaining -= 1
    zoneCaps

allocate_history_fib_caps(int availableLines, int availableLabels, array<bool> validSlots, array<int> fibZoneRequests,
                          array<bool> fibSlots, array<bool> labelSlots, array<int> labelsPerZone,
                          int ordinarySlotCount, int fibLinesPerZone, int maxHistoryZones) =>
    int slotCount = array.size(validSlots)
    array<int> fibCaps = array.new<int>(slotCount, 0)
    array<int> labelCaps = array.new<int>(slotCount, 0)
    int remainingLines = availableLines
    int remainingLabels = availableLabels
    for layer = 1 to maxHistoryZones
        for slotIndex = 0 to ordinarySlotCount - 1
            if array.get(validSlots, slotIndex)
                bool fibEnabled = array.get(fibSlots, slotIndex)
                int zoneLabels = array.get(labelSlots, slotIndex) ? array.get(labelsPerZone, slotIndex) : 0
                bool labelBudgetAvailable = zoneLabels == 0 or remainingLabels >= zoneLabels
                if fibEnabled and fibLinesPerZone > 0 and layer <= array.get(fibZoneRequests, slotIndex) and remainingLines >= fibLinesPerZone and labelBudgetAvailable
                    array.set(fibCaps, slotIndex, array.get(fibCaps, slotIndex) + fibLinesPerZone)
                    remainingLines -= fibLinesPerZone
                    if zoneLabels > 0
                        array.set(labelCaps, slotIndex, array.get(labelCaps, slotIndex) + zoneLabels)
                        remainingLabels -= zoneLabels
    for layer = 1 to maxHistoryZones
        for slotIndex = ordinarySlotCount to slotCount - 1
            if array.get(validSlots, slotIndex)
                bool fibEnabled = array.get(fibSlots, slotIndex)
                int zoneLabels = array.get(labelSlots, slotIndex) ? array.get(labelsPerZone, slotIndex) : 0
                bool labelBudgetAvailable = zoneLabels == 0 or remainingLabels >= zoneLabels
                if fibEnabled and fibLinesPerZone > 0 and layer <= array.get(fibZoneRequests, slotIndex) and remainingLines >= fibLinesPerZone and labelBudgetAvailable
                    array.set(fibCaps, slotIndex, array.get(fibCaps, slotIndex) + fibLinesPerZone)
                    remainingLines -= fibLinesPerZone
                    if zoneLabels > 0
                        array.set(labelCaps, slotIndex, array.get(labelCaps, slotIndex) + zoneLabels)
                        remainingLabels -= zoneLabels
    [fibCaps, labelCaps]

// On transition, [1] reads give us the just-closed period values used for its live projection.
update_slot(SlotState s, bool valid, bool transitionNow, int zoneStartT, int zoneStartIndex, bool fixedEnd, int zoneEndT, int zoneEndIndex,
             float htfO, float archivedRunHigh, float archivedRunLow, color slotColor, string htfLabel,
             float medHO, float meanHO, float medOL, float meanOL,
             int boxHistZoneCap, string slotLabelSize,
             int fibFade, int fibLinesPerZone, int fibHistCap,
             bool histLabelsEnabled, int histLabelCap, int histLabelsPerZone, string histLabelSize, string histLabelPos, int histLabelOffsetMs, int histLabelOffsetBars) =>
    int boxHistCap = valid ? boxHistZoneCap * 2 : 0
    while array.size(s.histBoxes) > boxHistCap
        box.delete(array.shift(s.histBoxes))
    while array.size(s.histFibLines) > fibHistCap
        line.delete(array.shift(s.histFibLines))
    while array.size(s.histFibLabels) > histLabelCap
        label.delete(array.shift(s.histFibLabels))

    if valid and transitionNow
        float prevO = htfO[1]
        float prevMedHO = medHO[1]
        float prevMeanHO = meanHO[1]
        float prevMedOL = medOL[1]
        float prevMeanOL = meanOL[1]

        if not na(prevO) and not na(prevMedHO) and not na(prevMedOL)
            [historyInnerHigh, historyOuterHigh, historyInnerLow, historyOuterLow] = compute_levels(prevO, prevMedHO, prevMeanHO, prevMedOL, prevMeanOL)
            int historyLeftTime = zoneStartT[1]
            int historyRightTime = fixedEnd ? zoneEndT[1] : zoneStartT
            int historyLeftIndex = zoneStartIndex[1]
            int historyRightIndex = fixedEnd ? zoneEndIndex[1] : zoneStartIndex

            if boxHistCap > 0
                color fillColor = zone_fill_color(slotColor)
                while array.size(s.histBoxes) > boxHistCap - 2
                    box.delete(array.shift(s.histBoxes))
                array.push(s.histBoxes, make_zone_box(false, historyLeftTime, historyLeftIndex, historyOuterHigh, historyRightTime, historyRightIndex, historyInnerHigh, fillColor, slotColor, "", slotLabelSize, LABEL_TEXT_TRANSPARENCY))
                array.push(s.histBoxes, make_zone_box(false, historyLeftTime, historyLeftIndex, historyInnerLow, historyRightTime, historyRightIndex, historyOuterLow, fillColor, slotColor, "", slotLabelSize, LABEL_TEXT_TRANSPARENCY))

            if fibHistCap >= fibLinesPerZone and fibLinesPerZone > 0
                while array.size(s.histFibLines) > fibHistCap - fibLinesPerZone
                    line.delete(array.shift(s.histFibLines))
                float historyAnchorHigh = fibTrailing ? math.max(historyOuterHigh, archivedRunHigh) : historyOuterHigh
                float historyAnchorLow = fibTrailing ? math.min(historyOuterLow, archivedRunLow) : historyOuterLow
                if histLabelsEnabled and histLabelsPerZone > 0 and histLabelCap >= histLabelsPerZone
                    while array.size(s.histFibLabels) > histLabelCap - histLabelsPerZone
                        label.delete(array.shift(s.histFibLabels))
                push_fib_lines(s.histFibLines, false, historyLeftTime, historyLeftIndex, historyRightTime, historyRightIndex, historyAnchorHigh, historyAnchorLow, fibFade, s.histFibLabels, htfLabel, histLabelsEnabled and histLabelCap >= histLabelsPerZone, histLabelSize, histLabelPos, histLabelOffsetMs, histLabelOffsetBars)

draw_slot_current(SlotState s, bool valid, int curLeftT, int curLeftIndex, int curRightT, int curRightIndex, float htfO, float htfH, float htfL, color slotColor, string identifierText, string fibLabelPrefix,
                   float medHO, float meanHO, float medOL, float meanOL,
                   string slotLabelSize, bool fibEnabled, int fibTransparencyBoost, bool labelSlotEnabled, string fibLabelSize, string fibLabelPos, int fibLabelOffsetMs, int fibLabelOffsetBars) =>
    // Null after delete so toggling a feature off mid-period leaves no dangling handle.
    if not na(s.fillUp)
        box.delete(s.fillUp)
        s.fillUp := na
    if not na(s.fillLo)
        box.delete(s.fillLo)
        s.fillLo := na
    if not na(s.innH)
        line.delete(s.innH)
        s.innH := na
    if not na(s.innL)
        line.delete(s.innL)
        s.innL := na
    if not na(s.outH)
        line.delete(s.outH)
        s.outH := na
    if not na(s.outL)
        line.delete(s.outL)
        s.outL := na
    while array.size(s.fibLines) > 0
        line.delete(array.pop(s.fibLines))
    while array.size(s.fibLabels) > 0
        label.delete(array.pop(s.fibLabels))

    if valid and not na(medHO) and not na(medOL)
        [innerHigh, outerHigh, innerLow, outerLow] = compute_levels(htfO, medHO, meanHO, medOL, meanOL)

        color fillClr = zone_fill_color(slotColor)
        s.fillUp := make_zone_box(true, curLeftT, curLeftIndex, outerHigh, curRightT, curRightIndex, innerHigh, fillClr, slotColor, identifierText, slotLabelSize, LABEL_TEXT_TRANSPARENCY)
        s.fillLo := make_zone_box(true, curLeftT, curLeftIndex, innerLow, curRightT, curRightIndex, outerLow, fillClr, slotColor, identifierText, slotLabelSize, LABEL_TEXT_TRANSPARENCY)

        s.innH := make_horizontal_line(true, curLeftT, curLeftIndex, curRightT, curRightIndex, innerHigh, slotColor, line.style_solid, 1)
        s.innL := make_horizontal_line(true, curLeftT, curLeftIndex, curRightT, curRightIndex, innerLow, slotColor, line.style_solid, 1)
        s.outH := make_horizontal_line(true, curLeftT, curLeftIndex, curRightT, curRightIndex, outerHigh, slotColor, line.style_solid, 1)
        s.outL := make_horizontal_line(true, curLeftT, curLeftIndex, curRightT, curRightIndex, outerLow, slotColor, line.style_solid, 1)

        if fibEnabled
            float fibAnchorHigh = fibTrailing ? math.max(outerHigh, htfH) : outerHigh
            float fibAnchorLow  = fibTrailing ? math.min(outerLow,  htfL) : outerLow
            draw_slot_fib(s, curLeftT, curLeftIndex, curRightT, curRightIndex, fibAnchorHigh, fibAnchorLow, fibTransparencyBoost, fibLabelPrefix, labelSlotEnabled, fibLabelSize, fibLabelPos, fibLabelOffsetMs, fibLabelOffsetBars)

draw_slot_forecast(SlotState s, bool valid, int forecastLeftT, int forecastRightT,
                   float htfO, float htfH, float htfL, color slotColor, string identifierText, string slotLabelSize,
                   float medHO, float meanHO, float medOL, float meanOL) =>
    if not na(s.forecastFillUp)
        box.delete(s.forecastFillUp)
        s.forecastFillUp := na
    if not na(s.forecastFillLo)
        box.delete(s.forecastFillLo)
        s.forecastFillLo := na
    if not na(s.forecastInnH)
        line.delete(s.forecastInnH)
        s.forecastInnH := na
    if not na(s.forecastInnL)
        line.delete(s.forecastInnL)
        s.forecastInnL := na
    if not na(s.forecastOutH)
        line.delete(s.forecastOutH)
        s.forecastOutH := na
    if not na(s.forecastOutL)
        line.delete(s.forecastOutL)
        s.forecastOutL := na

    if valid and not na(htfO) and not na(medHO) and not na(meanHO) and not na(medOL) and not na(meanOL)
        [referenceInnerHigh, referenceOuterHigh, referenceInnerLow, referenceOuterLow] = compute_levels(htfO, medHO, meanHO, medOL, meanOL)
        float highestExit = math.max(referenceInnerHigh, referenceOuterHigh)
        float lowestExit = math.min(referenceInnerLow, referenceOuterLow)
        if not na(htfH)
            highestExit := math.max(highestExit, htfH)
        if not na(htfL)
            lowestExit := math.min(lowestExit, htfL)

        float forecastInnerHigh = highestExit + math.min(medHO, meanHO)
        float forecastOuterHigh = highestExit + math.max(medHO, meanHO)
        float forecastInnerLow = lowestExit - math.min(medOL, meanOL)
        float forecastOuterLow = lowestExit - math.max(medOL, meanOL)
        color fillColor = forecast_zone_fill_color(slotColor)
        color borderColor = forecast_border_color(slotColor)

        s.forecastFillUp := make_zone_box(true, forecastLeftT, na, forecastOuterHigh, forecastRightT, na, forecastInnerHigh, fillColor, slotColor, identifierText, slotLabelSize, FORECAST_LABEL_TEXT_TRANSPARENCY)
        s.forecastFillLo := make_zone_box(true, forecastLeftT, na, forecastInnerLow, forecastRightT, na, forecastOuterLow, fillColor, slotColor, identifierText, slotLabelSize, FORECAST_LABEL_TEXT_TRANSPARENCY)

        s.forecastInnH := make_horizontal_line(true, forecastLeftT, na, forecastRightT, na, forecastInnerHigh, borderColor, line.style_dashed, 1)
        s.forecastInnL := make_horizontal_line(true, forecastLeftT, na, forecastRightT, na, forecastInnerLow, borderColor, line.style_dashed, 1)
        s.forecastOutH := make_horizontal_line(true, forecastLeftT, na, forecastRightT, na, forecastOuterHigh, borderColor, line.style_dashed, 1)
        s.forecastOutL := make_horizontal_line(true, forecastLeftT, na, forecastRightT, na, forecastOuterLow, borderColor, line.style_dashed, 1)

update_named_slot(SlotState slot, NamedSlotConfig namedSlotConfig, NamedSlotRuntime namedSlotRuntime,
                     int boxHistoryCap, int fibLinesPerZone, int fibHistoryCap,
                     bool historyLabelsEnabled, int historyLabelCap, int labelsPerZone,
                     int labelOffsetMilliseconds, int labelOffsetBars) =>
    update_slot(slot, namedSlotRuntime.valid, namedSlotRuntime.transition,
         namedSlotRuntime.startTime, namedSlotRuntime.startIndex, true, namedSlotRuntime.endTime, namedSlotRuntime.endIndex,
         namedSlotRuntime.sessionOpen, namedSlotRuntime.completedHigh, namedSlotRuntime.completedLow,
         namedSlotConfig.slotColor, namedSlotConfig.sourceLabel,
         namedSlotRuntime.medianHighOpen, namedSlotRuntime.meanHighOpen, namedSlotRuntime.medianOpenLow, namedSlotRuntime.meanOpenLow,
         boxHistoryCap, namedSlotConfig.slotLabelSize,
         namedSlotConfig.fibFade, fibLinesPerZone, fibHistoryCap,
         historyLabelsEnabled, historyLabelCap, labelsPerZone, get_label_size(namedSlotConfig.fibLabelSize),
         namedSlotConfig.fibLabelPosition, labelOffsetMilliseconds, labelOffsetBars)

draw_named_slot_current(SlotState slot, NamedSlotConfig namedSlotConfig, NamedSlotRuntime namedSlotRuntime,
                           string identifierText, int currentRightIndex,
                           bool fibLabelsEnabled, int labelOffsetMilliseconds, int labelOffsetBars) =>
    int sessionRightIndex = not na(namedSlotRuntime.endIndex) ? namedSlotRuntime.endIndex : currentRightIndex
    draw_slot_current(slot, namedSlotRuntime.valid,
         namedSlotRuntime.startTime, namedSlotRuntime.startIndex, namedSlotRuntime.endTime, sessionRightIndex,
         namedSlotRuntime.sessionOpen, namedSlotRuntime.currentHigh, namedSlotRuntime.currentLow,
         namedSlotConfig.slotColor, identifierText, namedSlotConfig.sourceLabel,
         namedSlotRuntime.medianHighOpen, namedSlotRuntime.meanHighOpen, namedSlotRuntime.medianOpenLow, namedSlotRuntime.meanOpenLow,
         namedSlotConfig.slotLabelSize, namedSlotConfig.fibEnabled, namedSlotConfig.fibFade,
         fibLabelsEnabled, get_label_size(namedSlotConfig.fibLabelSize), namedSlotConfig.fibLabelPosition,
         labelOffsetMilliseconds, labelOffsetBars)

draw_named_slot_forecast(SlotState slot, NamedSlotConfig namedSlotConfig, NamedSlotRuntime namedSlotRuntime, string identifierText) =>
    draw_slot_forecast(slot, namedSlotRuntime.forecastVisible,
         namedSlotRuntime.forecastStartTime, namedSlotRuntime.forecastEndTime,
         namedSlotRuntime.sessionOpen, namedSlotRuntime.currentHigh, namedSlotRuntime.currentLow,
         namedSlotConfig.slotColor, identifierText, namedSlotConfig.slotLabelSize,
         namedSlotRuntime.medianHighOpen, namedSlotRuntime.meanHighOpen, namedSlotRuntime.medianOpenLow, namedSlotRuntime.meanOpenLow)


// DISPATCH — every bar maintains state per slot

bool selectedDailyTransition = midnightDailyEnabled ? midnightNewDay : nativeNewDay
int selectedDailyStart = midnightDailyEnabled ? midnightDayStart : nativeDayStart
int selectedDailyStartIndex = midnightDailyEnabled ? midnightDayStartIndex : nativeDayStartIndex
int selectedDailyEnd = midnightDailyEnabled ? midnightDayEnd : nativeDayStart + SECS_DAY * MS_PER_SEC
float selectedDailyOpen = midnightDailyEnabled ? midnightOpen : nativeOpen
float selectedDailyRunHigh = midnightDailyEnabled ? midnightEffectiveRunHigh : nativeRunHigh
float selectedDailyRunLow = midnightDailyEnabled ? midnightEffectiveRunLow : nativeRunLow

[s1MedHO, s1MeanHO, s1MedOL, s1MeanOL] = resolve_slot_stats(s1Safe, s1NormMedHO, s1NormMeanHO, s1NormMedOL, s1NormMeanOL, midnightMedHO, midnightMeanHO, midnightMedOL, midnightMeanOL)
[s2MedHO, s2MeanHO, s2MedOL, s2MeanOL] = resolve_slot_stats(s2Safe, s2NormMedHO, s2NormMeanHO, s2NormMedOL, s2NormMeanOL, midnightMedHO, midnightMeanHO, midnightMedOL, midnightMeanOL)
[s3MedHO, s3MeanHO, s3MedOL, s3MeanOL] = resolve_slot_stats(s3Safe, s3NormMedHO, s3NormMeanHO, s3NormMedOL, s3NormMeanOL, midnightMedHO, midnightMeanHO, midnightMedOL, midnightMeanOL)
[s4MedHO, s4MeanHO, s4MedOL, s4MeanOL] = resolve_slot_stats(s4Safe, s4NormMedHO, s4NormMeanHO, s4NormMedOL, s4NormMeanOL, midnightMedHO, midnightMeanHO, midnightMedOL, midnightMeanOL)

[s1Trans, s1StartT, s1StartIndex, s1CurRightT, s1OEff, s1RHi, s1RLo] = resolve_slot_timing(s1Safe, s1O, s1RunHigh, s1RunLow, selectedDailyTransition, selectedDailyStart, selectedDailyStartIndex, selectedDailyEnd, selectedDailyOpen, selectedDailyRunHigh, selectedDailyRunLow, nativeNewWeek, nativeWeekStartT, nativeWeekStartIndex, nativeWeekOpen, nativeWeekRunHigh, nativeWeekRunLow)
[s2Trans, s2StartT, s2StartIndex, s2CurRightT, s2OEff, s2RHi, s2RLo] = resolve_slot_timing(s2Safe, s2O, s2RunHigh, s2RunLow, selectedDailyTransition, selectedDailyStart, selectedDailyStartIndex, selectedDailyEnd, selectedDailyOpen, selectedDailyRunHigh, selectedDailyRunLow, nativeNewWeek, nativeWeekStartT, nativeWeekStartIndex, nativeWeekOpen, nativeWeekRunHigh, nativeWeekRunLow)
[s3Trans, s3StartT, s3StartIndex, s3CurRightT, s3OEff, s3RHi, s3RLo] = resolve_slot_timing(s3Safe, s3O, s3RunHigh, s3RunLow, selectedDailyTransition, selectedDailyStart, selectedDailyStartIndex, selectedDailyEnd, selectedDailyOpen, selectedDailyRunHigh, selectedDailyRunLow, nativeNewWeek, nativeWeekStartT, nativeWeekStartIndex, nativeWeekOpen, nativeWeekRunHigh, nativeWeekRunLow)
[s4Trans, s4StartT, s4StartIndex, s4CurRightT, s4OEff, s4RHi, s4RLo] = resolve_slot_timing(s4Safe, s4O, s4RunHigh, s4RunLow, selectedDailyTransition, selectedDailyStart, selectedDailyStartIndex, selectedDailyEnd, selectedDailyOpen, selectedDailyRunHigh, selectedDailyRunLow, nativeNewWeek, nativeWeekStartT, nativeWeekStartIndex, nativeWeekOpen, nativeWeekRunHigh, nativeWeekRunLow)

string s1ForecastLabel = get_resolved_tf_label(s1Safe)
string s2ForecastLabel = get_resolved_tf_label(s2Safe)
string s3ForecastLabel = get_resolved_tf_label(s3Safe)
string s4ForecastLabel = get_resolved_tf_label(s4Safe)
string s1ForecastIdentifierText = s1ForecastLabel + " ¹"
string s2ForecastIdentifierText = s2ForecastLabel + " ²"
string s3ForecastIdentifierText = s3ForecastLabel + " ³"
string s4ForecastIdentifierText = s4ForecastLabel + " ⁴"

[s1ArchivedRunHigh, s1ArchivedRunLow] = resolve_archived_extrema(s1Safe, s1RHi, s1RLo, midnightCompletedRunHigh, midnightCompletedRunLow)
[s2ArchivedRunHigh, s2ArchivedRunLow] = resolve_archived_extrema(s2Safe, s2RHi, s2RLo, midnightCompletedRunHigh, midnightCompletedRunLow)
[s3ArchivedRunHigh, s3ArchivedRunLow] = resolve_archived_extrema(s3Safe, s3RHi, s3RLo, midnightCompletedRunHigh, midnightCompletedRunLow)
[s4ArchivedRunHigh, s4ArchivedRunLow] = resolve_archived_extrema(s4Safe, s4RHi, s4RLo, midnightCompletedRunHigh, midnightCompletedRunLow)

bool s1BudgetVisible = s1Valid or (s1Trans and s1Valid[1])
bool s2BudgetVisible = s2Valid or (s2Trans and s2Valid[1])
bool s3BudgetVisible = s3Valid or (s3Trans and s3Valid[1])
bool s4BudgetVisible = s4Valid or (s4Trans and s4Valid[1])
bool s1ForecastVisible = next_forecast_visible(forecastSlot1, s1Valid)
bool s2ForecastVisible = next_forecast_visible(forecastSlot2, s2Valid)
bool s3ForecastVisible = next_forecast_visible(forecastSlot3, s3Valid)
bool s4ForecastVisible = next_forecast_visible(forecastSlot4, s4Valid)
[overnightForecastStartT, overnightForecastEndT] = next_named_slot_bounds(time, overnightConfig)
bool overnightForecastVisible = named_slot_forecast_visible(overnightConfig, overnightValid, time, overnightForecastStartT)
var NamedSlotRuntime overnightRuntime = NamedSlotRuntime.new()
overnightRuntime.valid := overnightValid
overnightRuntime.transition := overnightTransition
overnightRuntime.startTime := overnightStartT
overnightRuntime.startIndex := overnightStartIndex
overnightRuntime.endTime := overnightEndT
overnightRuntime.endIndex := overnightEndIndex
overnightRuntime.sessionOpen := overnightOpen
overnightRuntime.currentHigh := overnightEffectiveRunHigh
overnightRuntime.currentLow := overnightEffectiveRunLow
overnightRuntime.completedHigh := overnightEffectiveRunHigh[1]
overnightRuntime.completedLow := overnightEffectiveRunLow[1]
overnightRuntime.medianHighOpen := overnightMedHO
overnightRuntime.meanHighOpen := overnightMeanHO
overnightRuntime.medianOpenLow := overnightMedOL
overnightRuntime.meanOpenLow := overnightMeanOL
overnightRuntime.forecastStartTime := overnightForecastStartT
overnightRuntime.forecastEndTime := overnightForecastEndT
overnightRuntime.forecastVisible := overnightForecastVisible
var NamedSlot overnightNamedSlot = NamedSlot.new(config=overnightConfig, runtimeState=overnightRuntime, drawingState=overnightSlot, identifierText=overnightIdentifierText)

[nyEarlyForecastStartT, nyEarlyForecastEndT] = next_named_slot_bounds(time, nyEarlyConfig)
bool nyEarlyForecastVisible = named_slot_forecast_visible(nyEarlyConfig, nyEarlyValid, time, nyEarlyForecastStartT)
var NamedSlotRuntime nyEarlyRuntime = NamedSlotRuntime.new()
nyEarlyRuntime.valid := nyEarlyValid
nyEarlyRuntime.transition := nyEarlyTransition
nyEarlyRuntime.startTime := nyEarlyStartT
nyEarlyRuntime.startIndex := nyEarlyStartIndex
nyEarlyRuntime.endTime := nyEarlyEndT
nyEarlyRuntime.endIndex := nyEarlyEndIndex
nyEarlyRuntime.sessionOpen := nyEarlyOpen
nyEarlyRuntime.currentHigh := nyEarlyEffectiveRunHigh
nyEarlyRuntime.currentLow := nyEarlyEffectiveRunLow
nyEarlyRuntime.completedHigh := nyEarlyEffectiveRunHigh[1]
nyEarlyRuntime.completedLow := nyEarlyEffectiveRunLow[1]
nyEarlyRuntime.medianHighOpen := nyEarlyMedHO
nyEarlyRuntime.meanHighOpen := nyEarlyMeanHO
nyEarlyRuntime.medianOpenLow := nyEarlyMedOL
nyEarlyRuntime.meanOpenLow := nyEarlyMeanOL
nyEarlyRuntime.forecastStartTime := nyEarlyForecastStartT
nyEarlyRuntime.forecastEndTime := nyEarlyForecastEndT
nyEarlyRuntime.forecastVisible := nyEarlyForecastVisible
var NamedSlot nyEarlyNamedSlot = NamedSlot.new(config=nyEarlyConfig, runtimeState=nyEarlyRuntime, drawingState=nyEarlySlot, identifierText=nyEarlyIdentifierText)

[nyAmForecastStartT, nyAmForecastEndT] = next_named_slot_bounds(time, nyAmConfig)
bool nyAmForecastVisible = named_slot_forecast_visible(nyAmConfig, nyAmValid, time, nyAmForecastStartT)
var NamedSlotRuntime nyAmRuntime = NamedSlotRuntime.new()
nyAmRuntime.valid := nyAmValid
nyAmRuntime.transition := nyAmTransition
nyAmRuntime.startTime := nyAmStartT
nyAmRuntime.startIndex := nyAmStartIndex
nyAmRuntime.endTime := nyAmEndT
nyAmRuntime.endIndex := nyAmEndIndex
nyAmRuntime.sessionOpen := nyAmOpen
nyAmRuntime.currentHigh := nyAmEffectiveRunHigh
nyAmRuntime.currentLow := nyAmEffectiveRunLow
nyAmRuntime.completedHigh := nyAmEffectiveRunHigh[1]
nyAmRuntime.completedLow := nyAmEffectiveRunLow[1]
nyAmRuntime.medianHighOpen := nyAmMedHO
nyAmRuntime.meanHighOpen := nyAmMeanHO
nyAmRuntime.medianOpenLow := nyAmMedOL
nyAmRuntime.meanOpenLow := nyAmMeanOL
nyAmRuntime.forecastStartTime := nyAmForecastStartT
nyAmRuntime.forecastEndTime := nyAmForecastEndT
nyAmRuntime.forecastVisible := nyAmForecastVisible
var NamedSlot nyAmNamedSlot = NamedSlot.new(config=nyAmConfig, runtimeState=nyAmRuntime, drawingState=nyAmSlot, identifierText=nyAmIdentifierText)

[ivbForecastStartT, ivbForecastEndT] = next_named_slot_bounds(time, ivbConfig)
bool ivbForecastVisible = named_slot_forecast_visible(ivbConfig, ivbValid, time, ivbForecastStartT)
var NamedSlotRuntime ivbRuntime = NamedSlotRuntime.new()
ivbRuntime.valid := ivbValid
ivbRuntime.transition := ivbTransition
ivbRuntime.startTime := ivbStartT
ivbRuntime.startIndex := ivbStartIndex
ivbRuntime.endTime := ivbEndT
ivbRuntime.endIndex := ivbEndIndex
ivbRuntime.sessionOpen := ivbOpen
ivbRuntime.currentHigh := ivbEffectiveRunHigh
ivbRuntime.currentLow := ivbEffectiveRunLow
ivbRuntime.completedHigh := ivbEffectiveRunHigh[1]
ivbRuntime.completedLow := ivbEffectiveRunLow[1]
ivbRuntime.medianHighOpen := ivbMedHO
ivbRuntime.meanHighOpen := ivbMeanHO
ivbRuntime.medianOpenLow := ivbMedOL
ivbRuntime.meanOpenLow := ivbMeanOL
ivbRuntime.forecastStartTime := ivbForecastStartT
ivbRuntime.forecastEndTime := ivbForecastEndT
ivbRuntime.forecastVisible := ivbForecastVisible
var NamedSlot ivbNamedSlot = NamedSlot.new(config=ivbConfig, runtimeState=ivbRuntime, drawingState=ivbSlot, identifierText=ivbIdentifierText)

[ivbPlusForecastStartT, ivbPlusForecastEndT] = next_named_slot_bounds(time, ivbPlusConfig)
bool ivbPlusForecastVisible = named_slot_forecast_visible(ivbPlusConfig, ivbPlusValid, time, ivbPlusForecastStartT)
var NamedSlotRuntime ivbPlusRuntime = NamedSlotRuntime.new()
ivbPlusRuntime.valid := ivbPlusValid
ivbPlusRuntime.transition := ivbPlusTransition
ivbPlusRuntime.startTime := ivbPlusStartT
ivbPlusRuntime.startIndex := ivbPlusStartIndex
ivbPlusRuntime.endTime := ivbPlusEndT
ivbPlusRuntime.endIndex := ivbPlusEndIndex
ivbPlusRuntime.sessionOpen := ivbPlusOpen
ivbPlusRuntime.currentHigh := ivbPlusEffectiveRunHigh
ivbPlusRuntime.currentLow := ivbPlusEffectiveRunLow
ivbPlusRuntime.completedHigh := ivbPlusEffectiveRunHigh[1]
ivbPlusRuntime.completedLow := ivbPlusEffectiveRunLow[1]
ivbPlusRuntime.medianHighOpen := ivbPlusMedHO
ivbPlusRuntime.meanHighOpen := ivbPlusMeanHO
ivbPlusRuntime.medianOpenLow := ivbPlusMedOL
ivbPlusRuntime.meanOpenLow := ivbPlusMeanOL
ivbPlusRuntime.forecastStartTime := ivbPlusForecastStartT
ivbPlusRuntime.forecastEndTime := ivbPlusForecastEndT
ivbPlusRuntime.forecastVisible := ivbPlusForecastVisible
var NamedSlot ivbPlusNamedSlot = NamedSlot.new(config=ivbPlusConfig, runtimeState=ivbPlusRuntime, drawingState=ivbPlusSlot, identifierText=ivbPlusIdentifierText)
array<NamedSlot> namedSlots = array.from(overnightNamedSlot, nyEarlyNamedSlot, nyAmNamedSlot, ivbNamedSlot, ivbPlusNamedSlot)

int fibLinesPerZone = (showFib100 ? 1 : 0) + (showFib786 ? 1 : 0) + (showFib705 ? 1 : 0) + (showFib618 ? 1 : 0) + (showFib50 ? 1 : 0) + (showFib382 ? 1 : 0) + (showFib295 ? 1 : 0) + (showFib214 ? 1 : 0) + (showFib0 ? 1 : 0)
bool fibLabelsOn = fibLabelLevels != FL_OFF
bool fibKeyLabelsOnly = fibLabelLevels == FL_KEY
int fibLabelsPerSide = fibLabelsOn ? ((showFib100 and (not fibKeyLabelsOnly or fibKey100) ? 1 : 0) + (showFib786 and (not fibKeyLabelsOnly or fibKey786) ? 1 : 0) + (showFib705 and (not fibKeyLabelsOnly or fibKey705) ? 1 : 0) + (showFib618 and (not fibKeyLabelsOnly or fibKey618) ? 1 : 0) + (showFib50 and (not fibKeyLabelsOnly or fibKey50) ? 1 : 0) + (showFib382 and (not fibKeyLabelsOnly or fibKey382) ? 1 : 0) + (showFib295 and (not fibKeyLabelsOnly or fibKey295) ? 1 : 0) + (showFib214 and (not fibKeyLabelsOnly or fibKey214) ? 1 : 0) + (showFib0 and (not fibKeyLabelsOnly or fibKey0) ? 1 : 0)) : 0
bool fibLabel1On = fibLabelsOn and fibLabelSlot1
bool fibLabel2On = fibLabelsOn and fibLabelSlot2
bool fibLabel3On = fibLabelsOn and fibLabelSlot3
bool fibLabel4On = fibLabelsOn and fibLabelSlot4
int s1LabelsPerZone = slot1Fib and fibLabel1On ? fibLabelsPerSide * (fibLabelPos1 == POS_BOTH ? 2 : 1) : 0
int s2LabelsPerZone = slot2Fib and fibLabel2On ? fibLabelsPerSide * (fibLabelPos2 == POS_BOTH ? 2 : 1) : 0
int s3LabelsPerZone = slot3Fib and fibLabel3On ? fibLabelsPerSide * (fibLabelPos3 == POS_BOTH ? 2 : 1) : 0
int s4LabelsPerZone = slot4Fib and fibLabel4On ? fibLabelsPerSide * (fibLabelPos4 == POS_BOTH ? 2 : 1) : 0

int s1HistoryZoneRequest = history_zone_request(latestOnly, slot1History)
int s2HistoryZoneRequest = history_zone_request(latestOnly, slot2History)
int s3HistoryZoneRequest = history_zone_request(latestOnly, slot3History)
int s4HistoryZoneRequest = history_zone_request(latestOnly, slot4History)
int s1FibHistoryZoneRequest = fib_history_zone_request(latestOnly, slot1History, fibHistory)
int s2FibHistoryZoneRequest = fib_history_zone_request(latestOnly, slot2History, fibHistory)
int s3FibHistoryZoneRequest = fib_history_zone_request(latestOnly, slot3History, fibHistory)
int s4FibHistoryZoneRequest = fib_history_zone_request(latestOnly, slot4History, fibHistory)

array<bool> historyBudgetValids = array.from(s1Valid, s2Valid, s3Valid, s4Valid)
array<int> boxHistoryZoneRequests = array.from(s1HistoryZoneRequest, s2HistoryZoneRequest, s3HistoryZoneRequest, s4HistoryZoneRequest)
array<int> namedSlotHistoryRequests = array.new<int>()
array<int> namedSlotLabelsPerZone = array.new<int>()

int currentBoxZoneCount = (s1BudgetVisible ? 1 : 0) + (s2BudgetVisible ? 1 : 0) + (s3BudgetVisible ? 1 : 0) + (s4BudgetVisible ? 1 : 0)
int forecastZoneCount = (s1ForecastVisible ? 1 : 0) + (s2ForecastVisible ? 1 : 0) + (s3ForecastVisible ? 1 : 0) + (s4ForecastVisible ? 1 : 0)
// Stable worst-case reserves prevent named-slot toggles from trimming ordinary history.
int namedSlotCurrentLineReserve = 0
int namedSlotCurrentLabelReserve = 0
for namedSlotIndex = 0 to array.size(namedSlots) - 1
    NamedSlot namedSlot = array.get(namedSlots, namedSlotIndex)
    NamedSlotConfig namedSlotConfig = namedSlot.config
    NamedSlotRuntime namedSlotRuntime = namedSlot.runtimeState
    int historyRequest = latestOnly ? 0 : namedSlotConfig.historyLimit - 1
    bool labelEnabled = fibLabelsOn and namedSlotConfig.fibLabelsEnabled
    int labelsPerZone = namedSlotConfig.fibEnabled and labelEnabled ? fibLabelsPerSide * (namedSlotConfig.fibLabelPosition == POS_BOTH ? 2 : 1) : 0
    array.push(namedSlotHistoryRequests, historyRequest)
    array.push(namedSlotLabelsPerZone, labelsPerZone)
    array.push(historyBudgetValids, namedSlotRuntime.valid)
    array.push(boxHistoryZoneRequests, historyRequest)
    currentBoxZoneCount += namedSlotRuntime.valid ? 1 : 0
    forecastZoneCount += namedSlotRuntime.forecastVisible ? 1 : 0
    namedSlotCurrentLineReserve += current_line_request(true, true, fibLinesPerZone)
    namedSlotCurrentLabelReserve += namedSlotRuntime.valid ? labelsPerZone : 0
int currentBoxReserve = (currentBoxZoneCount + forecastZoneCount) * 2
int availableHistoryBoxZones = int(math.max(0, INDICATOR_MAX_BOXES - currentBoxReserve) / 2)
array<int> boxHistZoneCaps = allocate_history_zone_caps(availableHistoryBoxZones, historyBudgetValids, boxHistoryZoneRequests, ORDINARY_SLOT_COUNT, SLOT_HISTORY_MAX)
int s1BoxHistZoneCap = array.get(boxHistZoneCaps, 0)
int s2BoxHistZoneCap = array.get(boxHistZoneCaps, 1)
int s3BoxHistZoneCap = array.get(boxHistZoneCaps, 2)
int s4BoxHistZoneCap = array.get(boxHistZoneCaps, 3)
int s1RetainedHistoryZoneCap = s1BoxHistZoneCap
int s2RetainedHistoryZoneCap = s2BoxHistZoneCap
int s3RetainedHistoryZoneCap = s3BoxHistZoneCap
int s4RetainedHistoryZoneCap = s4BoxHistZoneCap

int ordinaryCurrentLineReserve = current_line_request(s1BudgetVisible, slot1Fib, fibLinesPerZone) + current_line_request(s2BudgetVisible, slot2Fib, fibLinesPerZone) + current_line_request(s3BudgetVisible, slot3Fib, fibLinesPerZone) + current_line_request(s4BudgetVisible, slot4Fib, fibLinesPerZone)
int forecastLineReserve = forecastZoneCount * 4
int currentLineReserve = ordinaryCurrentLineReserve + namedSlotCurrentLineReserve + forecastLineReserve
int availableHistoryLines = math.max(0, INDICATOR_MAX_LINES - currentLineReserve)

// Standard charts convert bar offsets to time; Range charts use the offsets directly.
int chartBarMs = chart.is_range ? 0 : int(timeframe.in_seconds(timeframe.period) * MS_PER_SEC)
int currentLabelReserve = (s1BudgetVisible ? s1LabelsPerZone : 0) + (s2BudgetVisible ? s2LabelsPerZone : 0) + (s3BudgetVisible ? s3LabelsPerZone : 0) + (s4BudgetVisible ? s4LabelsPerZone : 0) + namedSlotCurrentLabelReserve
int availableHistoryLabels = math.max(0, INDICATOR_MAX_LABELS - currentLabelReserve)
array<int> historyLabelsPerZone = array.from(s1LabelsPerZone, s2LabelsPerZone, s3LabelsPerZone, s4LabelsPerZone)
array<bool> historyLabelSlots = array.from(fibLabelHistory and fibLabel1On, fibLabelHistory and fibLabel2On, fibLabelHistory and fibLabel3On, fibLabelHistory and fibLabel4On)
array<int> fibHistoryZoneRequests = array.from(math.min(s1FibHistoryZoneRequest, s1RetainedHistoryZoneCap), math.min(s2FibHistoryZoneRequest, s2RetainedHistoryZoneCap), math.min(s3FibHistoryZoneRequest, s3RetainedHistoryZoneCap), math.min(s4FibHistoryZoneRequest, s4RetainedHistoryZoneCap))
array<bool> lineBudgetFibs = array.from(slot1Fib, slot2Fib, slot3Fib, slot4Fib)
for namedSlotIndex = 0 to array.size(namedSlots) - 1
    int budgetIndex = ORDINARY_SLOT_COUNT + namedSlotIndex
    NamedSlot namedSlot = array.get(namedSlots, namedSlotIndex)
    NamedSlotConfig namedSlotConfig = namedSlot.config
    int historyRequest = array.get(namedSlotHistoryRequests, namedSlotIndex)
    int retainedHistory = array.get(boxHistZoneCaps, budgetIndex)
    int fibHistoryRequest = math.min(historyRequest, math.min(math.max(0, namedSlotConfig.historyLimit - 1), fibHistory))
    array.push(historyLabelsPerZone, array.get(namedSlotLabelsPerZone, namedSlotIndex))
    array.push(historyLabelSlots, fibLabelHistory and fibLabelsOn and namedSlotConfig.fibLabelsEnabled)
    array.push(fibHistoryZoneRequests, math.min(fibHistoryRequest, retainedHistory))
    array.push(lineBudgetFibs, namedSlotConfig.fibEnabled)
[fibHistCaps, histFibLabelCaps] = allocate_history_fib_caps(availableHistoryLines, availableHistoryLabels, historyBudgetValids, fibHistoryZoneRequests, lineBudgetFibs, historyLabelSlots, historyLabelsPerZone, ORDINARY_SLOT_COUNT, fibLinesPerZone, SLOT_HISTORY_MAX)
int s1FibHistCap = array.get(fibHistCaps, 0)
int s2FibHistCap = array.get(fibHistCaps, 1)
int s3FibHistCap = array.get(fibHistCaps, 2)
int s4FibHistCap = array.get(fibHistCaps, 3)
int s1HistFibLabelCap = array.get(histFibLabelCaps, 0)
int s2HistFibLabelCap = array.get(histFibLabelCaps, 1)
int s3HistFibLabelCap = array.get(histFibLabelCaps, 2)
int s4HistFibLabelCap = array.get(histFibLabelCaps, 3)

update_slot(slot1, s1Valid, s1Trans, s1StartT, s1StartIndex, false, s1CurRightT, bar_index, s1OEff, s1ArchivedRunHigh, s1ArchivedRunLow, slot1Color, s1Label, s1MedHO, s1MeanHO, s1MedOL, s1MeanOL, s1BoxHistZoneCap, SLOT1_LABEL_SIZE, SLOT1_FIB_FADE, fibLinesPerZone, s1FibHistCap, fibLabelHistory and fibLabel1On, s1HistFibLabelCap, s1LabelsPerZone, get_label_size(fibLabelSize1), fibLabelPos1, fibLabelOff1 * chartBarMs, fibLabelOff1)
update_slot(slot2, s2Valid, s2Trans, s2StartT, s2StartIndex, false, s2CurRightT, bar_index, s2OEff, s2ArchivedRunHigh, s2ArchivedRunLow, slot2Color, s2Label, s2MedHO, s2MeanHO, s2MedOL, s2MeanOL, s2BoxHistZoneCap, SLOT2_LABEL_SIZE, SLOT2_FIB_FADE, fibLinesPerZone, s2FibHistCap, fibLabelHistory and fibLabel2On, s2HistFibLabelCap, s2LabelsPerZone, get_label_size(fibLabelSize2), fibLabelPos2, fibLabelOff2 * chartBarMs, fibLabelOff2)
update_slot(slot3, s3Valid, s3Trans, s3StartT, s3StartIndex, false, s3CurRightT, bar_index, s3OEff, s3ArchivedRunHigh, s3ArchivedRunLow, slot3Color, s3Label, s3MedHO, s3MeanHO, s3MedOL, s3MeanOL, s3BoxHistZoneCap, SLOT3_LABEL_SIZE, SLOT3_FIB_FADE, fibLinesPerZone, s3FibHistCap, fibLabelHistory and fibLabel3On, s3HistFibLabelCap, s3LabelsPerZone, get_label_size(fibLabelSize3), fibLabelPos3, fibLabelOff3 * chartBarMs, fibLabelOff3)
update_slot(slot4, s4Valid, s4Trans, s4StartT, s4StartIndex, false, s4CurRightT, bar_index, s4OEff, s4ArchivedRunHigh, s4ArchivedRunLow, slot4Color, s4Label, s4MedHO, s4MeanHO, s4MedOL, s4MeanOL, s4BoxHistZoneCap, SLOT4_LABEL_SIZE, SLOT4_FIB_FADE, fibLinesPerZone, s4FibHistCap, fibLabelHistory and fibLabel4On, s4HistFibLabelCap, s4LabelsPerZone, get_label_size(fibLabelSize4), fibLabelPos4, fibLabelOff4 * chartBarMs, fibLabelOff4)

// Each written call keeps independent Pine history for update_slot()'s [1] snapshots.
int overnightBudgetIndex = ORDINARY_SLOT_COUNT + OVERNIGHT_NAMED_SLOT_INDEX
update_named_slot(overnightSlot, overnightConfig, overnightRuntime,
     array.get(boxHistZoneCaps, overnightBudgetIndex), fibLinesPerZone, array.get(fibHistCaps, overnightBudgetIndex),
     array.get(historyLabelSlots, overnightBudgetIndex), array.get(histFibLabelCaps, overnightBudgetIndex), array.get(historyLabelsPerZone, overnightBudgetIndex),
     overnightConfig.fibLabelOffset * chartBarMs, overnightConfig.fibLabelOffset)

int nyEarlyBudgetIndex = ORDINARY_SLOT_COUNT + NY_EARLY_NAMED_SLOT_INDEX
update_named_slot(nyEarlySlot, nyEarlyConfig, nyEarlyRuntime,
     array.get(boxHistZoneCaps, nyEarlyBudgetIndex), fibLinesPerZone, array.get(fibHistCaps, nyEarlyBudgetIndex),
     array.get(historyLabelSlots, nyEarlyBudgetIndex), array.get(histFibLabelCaps, nyEarlyBudgetIndex), array.get(historyLabelsPerZone, nyEarlyBudgetIndex),
     nyEarlyConfig.fibLabelOffset * chartBarMs, nyEarlyConfig.fibLabelOffset)

int nyAmBudgetIndex = ORDINARY_SLOT_COUNT + NY_AM_NAMED_SLOT_INDEX
update_named_slot(nyAmSlot, nyAmConfig, nyAmRuntime,
     array.get(boxHistZoneCaps, nyAmBudgetIndex), fibLinesPerZone, array.get(fibHistCaps, nyAmBudgetIndex),
     array.get(historyLabelSlots, nyAmBudgetIndex), array.get(histFibLabelCaps, nyAmBudgetIndex), array.get(historyLabelsPerZone, nyAmBudgetIndex),
     nyAmConfig.fibLabelOffset * chartBarMs, nyAmConfig.fibLabelOffset)

int ivbBudgetIndex = ORDINARY_SLOT_COUNT + IVB_NAMED_SLOT_INDEX
update_named_slot(ivbSlot, ivbConfig, ivbRuntime,
     array.get(boxHistZoneCaps, ivbBudgetIndex), fibLinesPerZone, array.get(fibHistCaps, ivbBudgetIndex),
     array.get(historyLabelSlots, ivbBudgetIndex), array.get(histFibLabelCaps, ivbBudgetIndex), array.get(historyLabelsPerZone, ivbBudgetIndex),
     ivbConfig.fibLabelOffset * chartBarMs, ivbConfig.fibLabelOffset)

int ivbPlusBudgetIndex = ORDINARY_SLOT_COUNT + IVB_PLUS_NAMED_SLOT_INDEX
update_named_slot(ivbPlusSlot, ivbPlusConfig, ivbPlusRuntime,
     array.get(boxHistZoneCaps, ivbPlusBudgetIndex), fibLinesPerZone, array.get(fibHistCaps, ivbPlusBudgetIndex),
     array.get(historyLabelSlots, ivbPlusBudgetIndex), array.get(histFibLabelCaps, ivbPlusBudgetIndex), array.get(historyLabelsPerZone, ivbPlusBudgetIndex),
     ivbPlusConfig.fibLabelOffset * chartBarMs, ivbPlusConfig.fibLabelOffset)

int currentRightIndex = chart.is_range ? bar_index + 1 : bar_index

if barstate.islast
    draw_slot_current(slot1, s1Valid, s1StartT, s1StartIndex, s1CurRightT, currentRightIndex, s1OEff, s1RHi, s1RLo, slot1Color, s1IdentifierText, s1Label, s1MedHO, s1MeanHO, s1MedOL, s1MeanOL, SLOT1_LABEL_SIZE, slot1Fib, SLOT1_FIB_FADE, fibLabel1On, get_label_size(fibLabelSize1), fibLabelPos1, fibLabelOff1 * chartBarMs, fibLabelOff1)
    draw_slot_current(slot2, s2Valid, s2StartT, s2StartIndex, s2CurRightT, currentRightIndex, s2OEff, s2RHi, s2RLo, slot2Color, s2IdentifierText, s2Label, s2MedHO, s2MeanHO, s2MedOL, s2MeanOL, SLOT2_LABEL_SIZE, slot2Fib, SLOT2_FIB_FADE, fibLabel2On, get_label_size(fibLabelSize2), fibLabelPos2, fibLabelOff2 * chartBarMs, fibLabelOff2)
    draw_slot_current(slot3, s3Valid, s3StartT, s3StartIndex, s3CurRightT, currentRightIndex, s3OEff, s3RHi, s3RLo, slot3Color, s3IdentifierText, s3Label, s3MedHO, s3MeanHO, s3MedOL, s3MeanOL, SLOT3_LABEL_SIZE, slot3Fib, SLOT3_FIB_FADE, fibLabel3On, get_label_size(fibLabelSize3), fibLabelPos3, fibLabelOff3 * chartBarMs, fibLabelOff3)
    draw_slot_current(slot4, s4Valid, s4StartT, s4StartIndex, s4CurRightT, currentRightIndex, s4OEff, s4RHi, s4RLo, slot4Color, s4IdentifierText, s4Label, s4MedHO, s4MeanHO, s4MedOL, s4MeanOL, SLOT4_LABEL_SIZE, slot4Fib, SLOT4_FIB_FADE, fibLabel4On, get_label_size(fibLabelSize4), fibLabelPos4, fibLabelOff4 * chartBarMs, fibLabelOff4)
    for namedSlotIndex = 0 to array.size(namedSlots) - 1
        NamedSlot namedSlot = array.get(namedSlots, namedSlotIndex)
        NamedSlotConfig namedSlotConfig = namedSlot.config
        NamedSlotRuntime namedSlotRuntime = namedSlot.runtimeState
        SlotState slotState = namedSlot.drawingState
        bool fibLabelsEnabled = fibLabelsOn and namedSlotConfig.fibLabelsEnabled
        int labelOffsetBars = namedSlotConfig.fibLabelOffset
        draw_named_slot_current(slotState, namedSlotConfig, namedSlotRuntime, namedSlot.identifierText, currentRightIndex,
             fibLabelsEnabled, labelOffsetBars * chartBarMs, labelOffsetBars)
    draw_slot_forecast(slot1, s1ForecastVisible, s1CurRightT, s1CurRightT + timeframe.in_seconds(s1Safe) * MS_PER_SEC, s1OEff, s1RHi, s1RLo, slot1Color, s1ForecastIdentifierText, SLOT1_LABEL_SIZE, s1MedHO, s1MeanHO, s1MedOL, s1MeanOL)
    draw_slot_forecast(slot2, s2ForecastVisible, s2CurRightT, s2CurRightT + timeframe.in_seconds(s2Safe) * MS_PER_SEC, s2OEff, s2RHi, s2RLo, slot2Color, s2ForecastIdentifierText, SLOT2_LABEL_SIZE, s2MedHO, s2MeanHO, s2MedOL, s2MeanOL)
    draw_slot_forecast(slot3, s3ForecastVisible, s3CurRightT, s3CurRightT + timeframe.in_seconds(s3Safe) * MS_PER_SEC, s3OEff, s3RHi, s3RLo, slot3Color, s3ForecastIdentifierText, SLOT3_LABEL_SIZE, s3MedHO, s3MeanHO, s3MedOL, s3MeanOL)
    draw_slot_forecast(slot4, s4ForecastVisible, s4CurRightT, s4CurRightT + timeframe.in_seconds(s4Safe) * MS_PER_SEC, s4OEff, s4RHi, s4RLo, slot4Color, s4ForecastIdentifierText, SLOT4_LABEL_SIZE, s4MedHO, s4MeanHO, s4MedOL, s4MeanOL)
    for namedSlotIndex = 0 to array.size(namedSlots) - 1
        NamedSlot namedSlot = array.get(namedSlots, namedSlotIndex)
        draw_named_slot_forecast(namedSlot.drawingState, namedSlot.config, namedSlot.runtimeState, namedSlot.identifierText)

showOnlyTimeframeAllowed = chart.is_range or timeframe.in_seconds(timeframe.period) <= SHOW_ONLY_MAX_TIMEFRAME_SECONDS
activeShowOnlySession = visibleWindow == WINDOW_LABEL_FROM_0500 ? SESSION_WINDOW_FROM_0500 : visibleWindow == WINDOW_LABEL_FROM_0830 ? SESSION_WINDOW_FROM_0830 : visibleWindow == WINDOW_LABEL_RTH ? SESSION_WINDOW_RTH : SESSION_WINDOW_OVERNIGHT
showOnlyInVisibleWindow = not na(time(timeframe.period, activeShowOnlySession, NY_TIMEZONE))
bool showOnlyInMostRecentDay = true
if showOnlyMostRecent
    showOnlyInMostRecentDay := year(time, NY_TIMEZONE) == year(timenow, NY_TIMEZONE) and month(time, NY_TIMEZONE) == month(timenow, NY_TIMEZONE) and dayofmonth(time, NY_TIMEZONE) == dayofmonth(timenow, NY_TIMEZONE)
hideThisBar = showOnlyEnabled and showOnlyTimeframeAllowed and not (showOnlyInVisibleWindow and (not showOnlyMostRecent or showOnlyInMostRecentDay))

plotcandle(hideThisBar ? open : na, high, low, close, title="Hidden Candles", color=hiddenCandleColor, bordercolor=hiddenCandleColor, wickcolor=hiddenCandleColor, editable=false, display=display.pane, force_overlay=true)

// COLOR REFERENCE TABLE

addRow(table tbl, int row, string name, color clr) =>
    table.cell(tbl, 0, row, name, text_size=size.small, text_color=color.black)
    table.cell(tbl, 1, row, str.format("R:{0} G:{1} B:{2}", int(color.r(clr)), int(color.g(clr)), int(color.b(clr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 2, row, str.tostring(int(color.t(clr))), text_size=size.small, text_color=color.black)

if showTable and barstate.islast
    int colorTableRowCount = 1 + ORDINARY_SLOT_COUNT + array.size(namedSlots) + 9 + 1
    var table colorTable = table.new(position.top_right, 3, colorTableRowCount, bgcolor=color.white, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)
    table.cell(colorTable, 0, 0, "Setting", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 1, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 2, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    int row = 1
    addRow(colorTable, row, "Slot 1", slot1Color)
    row += 1
    addRow(colorTable, row, "Slot 2", slot2Color)
    row += 1
    addRow(colorTable, row, "Slot 3", slot3Color)
    row += 1
    addRow(colorTable, row, "Slot 4", slot4Color)
    row += 1
    for namedSlotIndex = 0 to array.size(namedSlots) - 1
        NamedSlot namedSlot = array.get(namedSlots, namedSlotIndex)
        NamedSlotConfig namedSlotConfig = namedSlot.config
        addRow(colorTable, row, namedSlotConfig.sourceLabel, namedSlotConfig.slotColor)
        row += 1

    bool anyFib = slot1Fib or slot2Fib or slot3Fib or slot4Fib
    for namedSlotIndex = 0 to array.size(namedSlots) - 1
        NamedSlot namedSlot = array.get(namedSlots, namedSlotIndex)
        NamedSlotConfig namedSlotConfig = namedSlot.config
        anyFib := anyFib or namedSlotConfig.fibEnabled
    if anyFib
        if showFib100
            addRow(colorTable, row, "Fib 1.0", fibColor100)
            row += 1
        if showFib786
            addRow(colorTable, row, "Fib 0.786", fibColor786)
            row += 1
        if showFib705
            addRow(colorTable, row, "Fib 0.705", fibColor705)
            row += 1
        if showFib618
            addRow(colorTable, row, "Fib 0.618", fibColor618)
            row += 1
        if showFib50
            addRow(colorTable, row, "Fib 0.5", fibColor50)
            row += 1
        if showFib382
            addRow(colorTable, row, "Fib 0.382", fibColor382)
            row += 1
        if showFib295
            addRow(colorTable, row, "Fib 0.295", fibColor295)
            row += 1
        if showFib214
            addRow(colorTable, row, "Fib 0.214", fibColor214)
            row += 1
        if showFib0
            addRow(colorTable, row, "Fib 0", fibColor0)
            row += 1

    if showOnlyEnabled and showOnlyTimeframeAllowed
        addRow(colorTable, row, "Hidden Candles", hiddenCandleColor)
        row += 1

// parallax •
