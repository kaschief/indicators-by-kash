// TYPES

type FibLevelSet
    array<bool> visibleLevels
    array<int> lineWidths
    int lineCount

type FibPalette
    array<float> ratios
    array<string> ratioTexts
    array<color> levelColors
    array<bool> keyLevels

type AssetFamily
    array<string> identifiers
    float dailyLiquidityDepthDistance

type LiquidityDepthSideState
    bool activated
    int activationTime
    int activationIndex
    array<bool> mitigated
    array<int> endTimes
    array<int> endIndices

type LiquidityDepthSessionState
    int sessionStartTime
    int sessionStartIndex
    int sessionEndTime
    float highAnchor
    float lowAnchor
    int cutoffTime
    int lastEligibleTime
    int lastEligibleIndex
    LiquidityDepthSideState highSide
    LiquidityDepthSideState lowSide

type LiquidityDepthProfileState
    LiquidityDepthSessionState currentSession
    array<LiquidityDepthSessionState> history

type ScheduledProfileConfig
    string sourceLabel
    int startMinute
    int endMinute
    bool fullPeriod
    int forecastLeadMinutes
    string samplingSchedule
    string forecastSchedule
    bool enabled
    color slotColor
    int sampleLookback
    int historyLimit
    bool liquidityDepthEnabled
    FibLevelSet fibLevelSet
    bool forecastEnabled
    bool fibLabelsEnabled
    string fibLabelSize
    string fibLabelPosition
    int fibLabelOffset
    string slotLabelSize
    int fibFade

type ScheduledProfileChartState
    float runHigh
    float runLow

type SlotState
    array<box> histBoxes
    box fillUp
    box fillLo
    line innH
    line innL
    line outH
    line outL
    box forecastFillUp
    box forecastFillLo
    line forecastInnH
    line forecastInnL
    line forecastOutH
    line forecastOutL
    array<line> fibLines
    array<line> histFibLines
    array<label> fibLabels
    array<label> histFibLabels
    array<line> liquidityDepthLines
    array<label> liquidityDepthLabels

type ScheduledProfileRuntime
    bool valid
    bool transition
    int startTime
    int startIndex
    int endTime
    int endIndex
    float sessionOpen
    float currentHigh
    float currentLow
    float completedHigh
    float completedLow
    float medianHighOpen
    float meanHighOpen
    float medianOpenLow
    float meanOpenLow
    int forecastStartTime
    int forecastEndTime
    bool forecastVisible

type ScheduledProfile
    ScheduledProfileConfig config
    ScheduledProfileRuntime runtimeState
    SlotState drawingState
    LiquidityDepthProfileState liquidityDepthState
    string identifierText

fib_width_value(string widthSetting) =>
    widthSetting == FIB_WIDTH_OFF ? 0 : int(str.tonumber(widthSetting))

make_fib_level_set(string width100, string width786, string width705, string width618, string width50, string width382, string width295, string width214, string width0) =>
    array<int> lineWidths = array.from(fib_width_value(width100), fib_width_value(width786), fib_width_value(width705), fib_width_value(width618), fib_width_value(width50), fib_width_value(width382), fib_width_value(width295), fib_width_value(width214), fib_width_value(width0))
    array<bool> visibleLevels = array.new<bool>()
    int lineCount = 0
    for levelIndex = 0 to array.size(lineWidths) - 1
        bool levelVisible = array.get(lineWidths, levelIndex) > 0
        array.push(visibleLevels, levelVisible)
        lineCount += levelVisible ? 1 : 0
    FibLevelSet.new(visibleLevels=visibleLevels, lineWidths=lineWidths, lineCount=lineCount)

resolve_fib_level_set(string presetName, FibLevelSet disabledSet, FibLevelSet defaultSet, FibLevelSet alternativeSet) =>
    presetName == FIB_PRESET_DEFAULT ? defaultSet : presetName == FIB_PRESET_ALTERNATIVE ? alternativeSet : disabledSet

// TIMEFRAME HELPERS

get_tf_display_label(string tf) =>
    int secs = timeframe.in_seconds(tf)
    if secs < SECS_MIN
        str.tostring(secs) + "s"
    else if secs < SECS_HOUR
        str.tostring(int(math.round(secs / float(SECS_MIN)))) + "m"
    else if secs < SECS_DAY
        str.tostring(int(math.round(secs / float(SECS_HOUR)))) + "H"
    else if secs < SECS_WEEK
        str.tostring(int(math.round(secs / float(SECS_DAY)))) + "D"
    else if secs < SECS_4_WEEKS
        str.tostring(int(math.round(secs / float(SECS_WEEK)))) + "W"
    else
        str.tostring(int(math.round(secs / float(SECS_MONTH_AVG)))) + "Mo"

// Per-slot LTF→HTF auto-pairing. Slot N resolves to N tiers above chart.
get_tf_pairing(string chart_tf, int slot) =>
    if slot == 1
        switch chart_tf
            "30S" => [true, "5",   "5m"]
            "1"   => [true, "15",  "15m"]
            "2"   => [true, "30",  "30m"]
            "3"   => [true, "60",  "1H"]
            "4"   => [true, "30",  "30m"]
            "5"   => [true, "60",  "1H"]
            "10"  => [true, "60",  "1H"]
            "15"  => [true, "240", "4H"]
            "30"  => [true, "240", "4H"]
            "45"  => [true, "240", "4H"]
            "60"  => [true, "D",   "D"]
            "120" => [true, "D",   "D"]
            "180" => [true, "D",   "D"]
            "240" => [true, "D",   "D"]
            "1D"  => [true, "W",   "W"]
            "1W"  => [true, "M",   "1Mo"]
            =>       [false, "",   ""]
    else if slot == 2
        switch chart_tf
            "30S" => [true, "15",  "15m"]
            "1"   => [true, "60",  "1H"]
            "2"   => [true, "60",  "1H"]
            "3"   => [true, "240", "4H"]
            "4"   => [true, "60",  "1H"]
            "5"   => [true, "240", "4H"]
            "10"  => [true, "240", "4H"]
            "15"  => [true, "D",   "D"]
            "30"  => [true, "D",   "D"]
            "45"  => [true, "D",   "D"]
            "60"  => [true, "W",   "W"]
            "120" => [true, "W",   "W"]
            "180" => [true, "W",   "W"]
            "240" => [true, "W",   "W"]
            "1D"  => [true, "M",   "1Mo"]
            =>       [false, "",   ""]
    else
        [false, "", ""]

