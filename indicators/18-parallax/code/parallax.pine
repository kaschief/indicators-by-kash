fibLabelOffNyBlock  = input.int(0, "", inline="fl_ny_block", group=GROUP_FIB_LABELS, minval=FIB_LABEL_OFFSET_MIN, maxval=FIB_LABEL_OFFSET_MAX, active=nyBlockShow, tooltip=FL_ROW_TOOLTIP)

showZoneFill         = input.bool(true, "Fill", inline="zone", group=GROUP_ZONE,
     tooltip="Fill between Inner and Outer.")
zoneFillTransparency = input.int(85, "Transparency", inline="zone", group=GROUP_ZONE, minval=0, maxval=100)

const string NY_4H_MODE_AUTO = "Auto"
const string NY_4H_MODE_ON   = "On"
const string NY_4H_MODE_OFF  = "Off"
const string LATEST_ROW_TOOLTIP = "Auto — NY 06–14.\nOn — always 06–10 + 10–14.\nOff — ordinary 4H."
latestOnly = input.bool(true, "Latest Only", inline="latest", group=GROUP_GENERAL)
ny4hOnlyMode = input.string(NY_4H_MODE_AUTO, "NY 4H Only", options=[NY_4H_MODE_AUTO, NY_4H_MODE_ON, NY_4H_MODE_OFF], inline="latest", group=GROUP_GENERAL,
     tooltip=LATEST_ROW_TOOLTIP)
int latestNyHour = hour(last_bar_time, NY_TIMEZONE)
bool ny4hAutoWindowActive = latestNyHour >= 6 and latestNyHour < 14
bool ny4hOnlyEnabled = ny4hOnlyMode == NY_4H_MODE_ON or (ny4hOnlyMode == NY_4H_MODE_AUTO and ny4hAutoWindowActive)

const string HOLIDAY_OFF    = "Off"
const string HOLIDAY_EXTEND = "Extend"
const string HOLIDAY_NATIVE = "Native"
const string DAILY_SESSION_TOOLTIP = "Holiday Mode — Off: TradingView; Extend: merged Daily; Native: custom Daily/Weekly.\n1D from NY Midnight — On: 00:00 ET; Off: Globex 18:00 ET. Weekly stays Sunday 18:00 ET."
holidayMode = input.string(HOLIDAY_NATIVE, "Holiday Mode", options=[HOLIDAY_OFF, HOLIDAY_EXTEND, HOLIDAY_NATIVE], inline="daily_session", group=GROUP_GENERAL)
useNyMidnightDaily = input.bool(false, "1D from NY Midnight", inline="daily_session", group=GROUP_GENERAL, active=holidayMode == HOLIDAY_NATIVE,
     tooltip=DAILY_SESSION_TOOLTIP)
bool midnightDailyEnabled = holidayMode == HOLIDAY_NATIVE and useNyMidnightDaily

const string IDENTIFIER_TEXT_OFF    = "Off"
const string IDENTIFIER_TEXT_PLAIN  = "Show"
const string IDENTIFIER_TEXT_SOURCE = "Show w/ source"

identifierTextMode = input.string(IDENTIFIER_TEXT_SOURCE, "Identifier Text", options=[IDENTIFIER_TEXT_OFF, IDENTIFIER_TEXT_PLAIN, IDENTIFIER_TEXT_SOURCE], group=GROUP_DISPLAY,
     tooltip="Off • TF • TF + source.")

const string SLOT1_LABEL_SIZE = LBL_SMALL
const string SLOT2_LABEL_SIZE = LBL_NORMAL
const string SLOT3_LABEL_SIZE = LBL_LARGE
const string SLOT4_LABEL_SIZE = LBL_HUGE
const string NY_BLOCK_LABEL_SIZE = LBL_NORMAL

// Fib label legibility: pull the line's transparency down so a faint level still gets a readable tag.
const float FIB_LABEL_TRANSPARENCY_REDUCTION = 55.0
const float FIB_LABEL_TRANSPARENCY_MAX       = 12.0


get_label_size(string s) =>
    s == LBL_TINY   ? size.tiny   :
     s == LBL_NORMAL ? size.normal :
     s == LBL_LARGE  ? size.large  :
     s == LBL_HUGE   ? size.huge   :
                       size.small

// COLOR REFERENCE TABLE

showTable = input.bool(false, "Show", group=GROUP_TABLE,
     tooltip="RGB and transparency table.")

// HTF RESOLUTION

get_resolved_tf_label(string tf) =>
    int tfSeconds = timeframe.in_seconds(tf)
    if tfSeconds == SECS_DAY and midnightDailyEnabled
        "Mn • 1D"
    else if tfSeconds == 4 * SECS_HOUR and ny4hOnlyEnabled
        "NY • 4H"
    else
        get_tf_display_label(tf)

string CHART_TF = timeframe.period
[s1AutoValid, s1AutoTF, s1AutoLabel] = get_tf_pairing(CHART_TF, 1)
[s2AutoValid, s2AutoTF, s2AutoLabel] = get_tf_pairing(CHART_TF, 2)
[s3AutoValid, s3AutoTF, s3AutoLabel] = get_tf_pairing(CHART_TF, 3)
[s4AutoValid, s4AutoTF, s4AutoLabel] = get_tf_pairing(CHART_TF, 4)

string s1TF    = (slot1Manual or chart.is_range) ? slot1TFIn : (s1AutoValid ? s1AutoTF : "1D")
bool   s1Valid = slot1Show and (slot1Manual or chart.is_range or s1AutoValid) and (chart.is_range or timeframe.in_seconds(s1TF) > timeframe.in_seconds())
string s1Safe  = s1Valid ? s1TF : "1D"
string s1Label = get_resolved_tf_label(s1TF)
string s1IdentifierText = identifierTextMode == IDENTIFIER_TEXT_SOURCE ? s1Label + " ¹" : s1Label

string s2TF    = (slot2Manual or chart.is_range) ? slot2TFIn : (s2AutoValid ? s2AutoTF : "1D")
bool   s2Valid = slot2Show and (slot2Manual or chart.is_range or s2AutoValid) and (chart.is_range or timeframe.in_seconds(s2TF) > timeframe.in_seconds())
string s2Safe  = s2Valid ? s2TF : "1D"
string s2Label = get_resolved_tf_label(s2TF)
string s2IdentifierText = identifierTextMode == IDENTIFIER_TEXT_SOURCE ? s2Label + " ²" : s2Label

string s3TF    = (slot3Manual or chart.is_range) ? slot3TFIn : (s3AutoValid ? s3AutoTF : "1D")
bool   s3Valid = slot3Show and (slot3Manual or chart.is_range or s3AutoValid) and (chart.is_range or timeframe.in_seconds(s3TF) > timeframe.in_seconds())
string s3Safe  = s3Valid ? s3TF : "1D"
string s3Label = get_resolved_tf_label(s3TF)
string s3IdentifierText = identifierTextMode == IDENTIFIER_TEXT_SOURCE ? s3Label + " ³" : s3Label

string s4TF    = (slot4Manual or chart.is_range) ? slot4TFIn : (s4AutoValid ? s4AutoTF : "1D")
bool   s4Valid = slot4Show and (slot4Manual or chart.is_range or s4AutoValid) and (chart.is_range or timeframe.in_seconds(s4TF) > timeframe.in_seconds())
string s4Safe  = s4Valid ? s4TF : "1D"
string s4Label = get_resolved_tf_label(s4TF)
string s4IdentifierText = identifierTextMode == IDENTIFIER_TEXT_SOURCE ? s4Label + " ⁴" : s4Label

bool nyBlockValid = nyBlockShow and (chart.is_range or timeframe.in_seconds(timeframe.period) < 4 * SECS_HOUR)
string nyBlockIdentifierText = identifierTextMode == IDENTIFIER_TEXT_SOURCE ? "NY AM" : "4H"

ordinary_period_visible(string tf, int startTime, bool keyWindowsOnly) =>
    bool isFourHour = timeframe.in_seconds(tf) == 4 * SECS_HOUR
    int startHour = hour(startTime, NY_TIMEZONE)
    int startMinute = minute(startTime, NY_TIMEZONE)
    bool selectedWindow = not na(startTime) and startMinute == 0 and (startHour == 6 or startHour == 10)
    not keyWindowsOnly or not isFourHour or selectedWindow

next_forecast_visible(bool slotEnabled, bool valid, string tf, int nextStartTime, bool keyWindowsOnly) =>
    showNextRangeForecast and slotEnabled and not chart.is_range and valid and ordinary_period_visible(tf, nextStartTime, keyWindowsOnly)

keyed_4h(bool keyWindowsOnly, string tf) =>
    keyWindowsOnly and timeframe.in_seconds(tf) == 4 * SECS_HOUR

key_4h_window_id(bool enabled, int startTime) =>
    int startHour = hour(startTime, NY_TIMEZONE)
    int startMinute = minute(startTime, NY_TIMEZONE)
    enabled and not na(startTime) and startMinute == 0 and (startHour == 6 or startHour == 10) ? startTime : na

// HTF DATA — normal running high/low are tracked chart-side. Wall-clock sessions use
// a 30-minute context so their boundaries remain independent of chart bars.
string htfTickerId = chart.is_range ? ticker.standard(syminfo.tickerid) : syminfo.tickerid

fetch_htf_open(string tickerId, string tf) =>
    request.security(tickerId, tf, open, lookahead=barmerge.lookahead_on)

fetch_htf_stats(string tickerId, string tf) =>
    request.security(tickerId, tf,
         [ta.median(high - open, lookbackN), ta.sma(high - open, lookbackN),
          ta.median(open - low,  lookbackN), ta.sma(open - low,  lookbackN)],
         lookahead=barmerge.lookahead_off)

sample_stats(array<float> samples) =>
    int sampleCount = array.size(samples)
    [sampleCount > 0 ? array.median(samples) : na,
     sampleCount > 0 ? array.avg(samples) : na]

record_excursion_sample(array<float> highOpenSamples, array<float> openLowSamples, float sessionOpen, float sessionHigh, float sessionLow, int sampleLimit) =>
    array.push(highOpenSamples, sessionHigh - sessionOpen)
    array.push(openLowSamples, sessionOpen - sessionLow)
    while array.size(highOpenSamples) > sampleLimit
        array.shift(highOpenSamples)
    while array.size(openLowSamples) > sampleLimit
        array.shift(openLowSamples)

next_ny_midnight(int dayStart) =>
    int nextDayProbe = dayStart + 36 * SECS_HOUR * MS_PER_SEC
    timestamp(NY_TIMEZONE, year(nextDayProbe, NY_TIMEZONE), month(nextDayProbe, NY_TIMEZONE), dayofmonth(nextDayProbe, NY_TIMEZONE), 0, 0)

fetch_midnight_daily_data(bool enabled, int sampleLimit) =>
    var array<float> highOpenSamples = array.new<float>()
    var array<float> openLowSamples = array.new<float>()
    var int observedDayStart = na
    var int sessionStartTime = na
    var int sessionEndTime = na
    var bool sessionStartedAtBoundary = false
    var float sessionOpen = na
    var float sessionHigh = na
    var float sessionLow = na
    var float completedSessionHigh = na
    var float completedSessionLow = na
    var float projectedMedHO = na
    var float projectedMeanHO = na
    var float projectedMedOL = na
    var float projectedMeanOL = na

    if enabled
        int currentDayStart = timestamp(NY_TIMEZONE, year(time, NY_TIMEZONE), month(time, NY_TIMEZONE), dayofmonth(time, NY_TIMEZONE), 0, 0)
        bool periodChanged = not na(observedDayStart) and currentDayStart != observedDayStart
        bool sundayReopen = periodChanged and syminfo.type == "futures" and dayofweek(time, NY_TIMEZONE) == dayofweek.sunday
        bool periodRolled = periodChanged and not sundayReopen

        if na(sessionStartTime)
            sessionStartTime := currentDayStart
            sessionOpen := open
            sessionHigh := high
            sessionLow := low
        else if periodRolled
            completedSessionHigh := sessionHigh
            completedSessionLow := sessionLow
            if sessionStartedAtBoundary
                record_excursion_sample(highOpenSamples, openLowSamples, sessionOpen, sessionHigh, sessionLow, sampleLimit)
                [nextMedHO, nextMeanHO] = sample_stats(highOpenSamples)
                [nextMedOL, nextMeanOL] = sample_stats(openLowSamples)
                projectedMedHO := nextMedHO
                projectedMeanHO := nextMeanHO
                projectedMedOL := nextMedOL
                projectedMeanOL := nextMeanOL
            sessionStartTime := currentDayStart
            sessionOpen := open
            sessionHigh := high
            sessionLow := low
            sessionStartedAtBoundary := true
        else
            sessionHigh := math.max(sessionHigh, high)
            sessionLow := math.min(sessionLow, low)

        observedDayStart := currentDayStart
        sessionEndTime := next_ny_midnight(currentDayStart)

    [sessionStartTime, sessionEndTime, sessionOpen, sessionHigh, sessionLow, completedSessionHigh, completedSessionLow,
     projectedMedHO, projectedMeanHO,
     projectedMedOL, projectedMeanOL]

fetch_ny_block_data(bool enabled, int sampleLimit, int startHour, int endHour) =>
    var array<float> highOpenSamples = array.new<float>()
    var array<float> openLowSamples = array.new<float>()
    var bool collecting = false
    var int sessionDayKey = na
    var int sessionStartTime = na
    var int sessionEndTime = na
    var int lastSessionBarTime = na
    var int lastSessionBarCloseTime = na
    var float sessionOpen = na
    var float sessionHigh = na
    var float sessionLow = na
    var float projectedMedHO = na
    var float projectedMeanHO = na
    var float projectedMedOL = na
    var float projectedMeanOL = na

    if enabled
        int currentMinutes = hour(time, NY_TIMEZONE) * 60 + minute(time, NY_TIMEZONE)
        int currentDayKey = year(time, NY_TIMEZONE) * 10000 + month(time, NY_TIMEZONE) * 100 + dayofmonth(time, NY_TIMEZONE)
        int startMinute = startHour * SECS_MIN
        int endMinute = endHour * SECS_MIN
        bool inWindow = currentMinutes >= startMinute and currentMinutes < endMinute
        bool finalizePrevious = collecting and (not inWindow or currentDayKey != sessionDayKey)

        if finalizePrevious
            bool sessionComplete = lastSessionBarTime == sessionEndTime - 30 * SECS_MIN * MS_PER_SEC and lastSessionBarCloseTime >= sessionEndTime
            if sessionComplete
                record_excursion_sample(highOpenSamples, openLowSamples, sessionOpen, sessionHigh, sessionLow, sampleLimit)
            collecting := false

        bool startsNow = inWindow and currentMinutes == startMinute and not collecting
        if startsNow
            [nextMedHO, nextMeanHO] = sample_stats(highOpenSamples)
            [nextMedOL, nextMeanOL] = sample_stats(openLowSamples)
            projectedMedHO := nextMedHO
            projectedMeanHO := nextMeanHO
            projectedMedOL := nextMedOL
            projectedMeanOL := nextMeanOL
            sessionDayKey := currentDayKey
            sessionStartTime := timestamp(NY_TIMEZONE, year(time, NY_TIMEZONE), month(time, NY_TIMEZONE), dayofmonth(time, NY_TIMEZONE), startHour, 0)
            sessionEndTime := timestamp(NY_TIMEZONE, year(time, NY_TIMEZONE), month(time, NY_TIMEZONE), dayofmonth(time, NY_TIMEZONE), endHour, 0)
            sessionOpen := open
            sessionHigh := high
            sessionLow := low
            lastSessionBarTime := time
            lastSessionBarCloseTime := time_close
            collecting := true
        else if inWindow and collecting and currentDayKey == sessionDayKey
            sessionHigh := math.max(sessionHigh, high)
            sessionLow := math.min(sessionLow, low)
            lastSessionBarTime := time
            lastSessionBarCloseTime := time_close

    [sessionStartTime, sessionEndTime, sessionOpen, sessionHigh, sessionLow,
     projectedMedHO, projectedMeanHO,
     projectedMedOL, projectedMeanOL]

s1O = fetch_htf_open(htfTickerId, s1Safe)
s2O = fetch_htf_open(htfTickerId, s2Safe)
s3O = fetch_htf_open(htfTickerId, s3Safe)
s4O = fetch_htf_open(htfTickerId, s4Safe)

[s1NormMedHO, s1NormMeanHO, s1NormMedOL, s1NormMeanOL] = fetch_htf_stats(htfTickerId, s1Safe)
[s2NormMedHO, s2NormMeanHO, s2NormMedOL, s2NormMeanOL] = fetch_htf_stats(htfTickerId, s2Safe)
[s3NormMedHO, s3NormMeanHO, s3NormMedOL, s3NormMeanOL] = fetch_htf_stats(htfTickerId, s3Safe)
[s4NormMedHO, s4NormMeanHO, s4NormMedOL, s4NormMeanOL] = fetch_htf_stats(htfTickerId, s4Safe)

bool midnightDailyTrackOnChart = chart.is_range or timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds(SESSION_SOURCE_TIMEFRAME)
[midnightDayStart, midnightDayEnd, midnightOpen, midnightRunHigh, midnightRunLow, midnightCompletedRunHigh, midnightCompletedRunLow,
 midnightMedHO, midnightMeanHO,
 midnightMedOL, midnightMeanOL] = request.security(htfTickerId, SESSION_SOURCE_TIMEFRAME, fetch_midnight_daily_data(midnightDailyEnabled, lookbackN),
     lookahead=midnightDailyTrackOnChart ? barmerge.lookahead_on : barmerge.lookahead_off, calc_bars_count=SESSION_REQUEST_BARS)
bool midnightChartBarInDay = midnightDailyTrackOnChart and not na(midnightDayStart) and time < midnightDayEnd and (time >= midnightDayStart or (not na(time_close) and time_close > midnightDayStart))
bool midnightChartNewDay = midnightChartBarInDay and not na(midnightDayStart[1]) and (not midnightChartBarInDay[1] or midnightDayStart != midnightDayStart[1])
bool midnightRequestedNewDay = not na(midnightDayStart) and ta.change(midnightDayStart) != 0
bool midnightNewDay = midnightDailyTrackOnChart ? midnightChartNewDay : midnightRequestedNewDay
int midnightDayStartIndex = nz(ta.valuewhen(midnightNewDay, bar_index, 0), 0)
var float midnightChartRunHigh = na
var float midnightChartRunLow = na
if midnightChartBarInDay
    if midnightChartNewDay or na(midnightChartRunHigh)
        midnightChartRunHigh := high
        midnightChartRunLow := low
    else
        midnightChartRunHigh := math.max(midnightChartRunHigh, high)
        midnightChartRunLow := math.min(midnightChartRunLow, low)
float midnightEffectiveRunHigh = midnightDailyTrackOnChart ? midnightChartRunHigh : midnightRunHigh
float midnightEffectiveRunLow = midnightDailyTrackOnChart ? midnightChartRunLow : midnightRunLow

bool nyBlockTrackOnChart = chart.is_range or timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds(SESSION_SOURCE_TIMEFRAME)
[nyBlockStartT, nyBlockEndT, nyBlockO, nyBlockRunHigh, nyBlockRunLow,
 nyBlockMedHO, nyBlockMeanHO,
 nyBlockMedOL, nyBlockMeanOL] = request.security(htfTickerId, SESSION_SOURCE_TIMEFRAME, fetch_ny_block_data(nyBlockValid, nyBlockLookback, NY_BLOCK_START_HOUR, NY_BLOCK_END_HOUR),
     lookahead=nyBlockTrackOnChart ? barmerge.lookahead_on : barmerge.lookahead_off, calc_bars_count=SESSION_REQUEST_BARS)

bool nyBlockRangeBarInWindow = chart.is_range and not na(nyBlockStartT) and time < nyBlockEndT and (time >= nyBlockStartT or (not na(time_close) and time_close > nyBlockStartT))
bool nyBlockRangeSessionStart = nyBlockRangeBarInWindow and (not nyBlockRangeBarInWindow[1] or nyBlockStartT != nyBlockStartT[1])
bool nyBlockRequestedTransition = not na(nyBlockStartT) and ta.change(nyBlockStartT) != 0
bool nyBlockTransition = chart.is_range ? nyBlockRangeSessionStart : nyBlockRequestedTransition
int nyBlockStartIndex = nz(ta.valuewhen(nyBlockTransition, bar_index, 0), 0)
int nyBlockCapturedStartT = ta.valuewhen(nyBlockRangeBarInWindow, nyBlockStartT, 0)
int nyBlockEndIndex = nyBlockCapturedStartT == nyBlockStartT ? ta.valuewhen(nyBlockRangeBarInWindow, bar_index + 1, 0) : na

bool nyBlockChartBarInWindow = nyBlockTrackOnChart and (chart.is_range ? nyBlockRangeBarInWindow : not na(nyBlockStartT) and time >= nyBlockStartT and time < nyBlockEndT)
bool nyBlockChartSessionStart = nyBlockChartBarInWindow and (not nyBlockChartBarInWindow[1] or nyBlockStartT != nyBlockStartT[1])
var float nyBlockChartRunHigh = na
var float nyBlockChartRunLow = na
if nyBlockChartSessionStart
    nyBlockChartRunHigh := high
    nyBlockChartRunLow := low
else if nyBlockChartBarInWindow
    nyBlockChartRunHigh := math.max(nyBlockChartRunHigh, high)
    nyBlockChartRunLow := math.min(nyBlockChartRunLow, low)
float nyBlockEffectiveRunHigh = nyBlockTrackOnChart ? nyBlockChartRunHigh : nyBlockRunHigh
float nyBlockEffectiveRunLow = nyBlockTrackOnChart ? nyBlockChartRunLow : nyBlockRunLow

var float s1RunHigh = na
var float s1RunLow  = na
var float s2RunHigh = na
var float s2RunLow  = na
var float s3RunHigh = na
var float s3RunLow  = na
var float s4RunHigh = na
var float s4RunLow  = na

if s1Valid
    if na(s1RunHigh) or ta.change(time(s1Safe)) != 0
        s1RunHigh := high
        s1RunLow  := low
    else
        s1RunHigh := math.max(s1RunHigh, high)
        s1RunLow  := math.min(s1RunLow,  low)

if s2Valid
    if na(s2RunHigh) or ta.change(time(s2Safe)) != 0
        s2RunHigh := high
        s2RunLow  := low
    else
        s2RunHigh := math.max(s2RunHigh, high)
        s2RunLow  := math.min(s2RunLow,  low)

if s3Valid
    if na(s3RunHigh) or ta.change(time(s3Safe)) != 0
        s3RunHigh := high
        s3RunLow  := low
    else
        s3RunHigh := math.max(s3RunHigh, high)
        s3RunLow  := math.min(s3RunLow,  low)

if s4Valid
    if na(s4RunHigh) or ta.change(time(s4Safe)) != 0
        s4RunHigh := high
        s4RunLow  := low
    else
        s4RunHigh := math.max(s4RunHigh, high)
        s4RunLow  := math.min(s4RunLow,  low)

// NATIVE DAILY SESSION — rolls at the 18:00 ET reopen regardless of TradingView's
// holiday-merged "D" bar. Shifting +6h maps 18:00 ET to the next NY calendar date.
const int NATIVE_SHIFT_MS = 6 * SECS_HOUR * MS_PER_SEC
const string NATIVE_TZ    = "America/New_York"
int  nativeShifted = time + NATIVE_SHIFT_MS
int  nativeTradeId = year(nativeShifted, NATIVE_TZ) * 10000 + month(nativeShifted, NATIVE_TZ) * 100 + dayofmonth(nativeShifted, NATIVE_TZ)
bool nativeNewDay  = ta.change(nativeTradeId) != 0
var int   nativeDayStart = na
var int   nativeDayStartIndex = na
var float nativeOpen     = na
var float nativeRunHigh  = na
var float nativeRunLow   = na
if nativeNewDay or na(nativeDayStart)
    nativeDayStart := time
    nativeDayStartIndex := bar_index
    nativeOpen     := open
    nativeRunHigh  := high
    nativeRunLow   := low
else
    nativeRunHigh := math.max(nativeRunHigh, high)
    nativeRunLow  := math.min(nativeRunLow,  low)

// NATIVE WEEKLY SESSION — rolls at the Sunday 18:00 ET reopen, ignoring TradingView's
// holiday-shifted "W" bar (e.g. a Friday Juneteenth would otherwise break the week early).
bool nativeNewWeek = nativeNewDay and dayofweek(time, NATIVE_TZ) == dayofweek.sunday
var int   nativeWeekStartT  = na
var int   nativeWeekStartIndex = na
var float nativeWeekOpen    = na
var float nativeWeekRunHigh = na
var float nativeWeekRunLow  = na
if nativeNewWeek or na(nativeWeekStartT)
    nativeWeekStartT  := time
    nativeWeekStartIndex := bar_index
    nativeWeekOpen    := open
    nativeWeekRunHigh := high
    nativeWeekRunLow  := low
else
    nativeWeekRunHigh := math.max(nativeWeekRunHigh, high)
    nativeWeekRunLow  := math.min(nativeWeekRunLow,  low)

// SLOT STATE

type SlotState
    array<box>   histBoxes
    array<int>   histBoxKeys
    array<line>  histBorderLines
    array<int>   histBorderKeys
    box   fillUp
    box   fillLo
    line  innH
    line  innL
    line  outH
    line  outL
    box   forecastFillUp
    box   forecastFillLo
    line  forecastInnH
    line  forecastInnL
    line  forecastOutH
    line  forecastOutL
    array<line>  fibLines      // current-zone fib level lines (up to 9)
    array<line>  histFibLines  // Historical fib lines capped by the shared line budget.
    array<int>   histFibKeys
    array<label> fibLabels
    array<label> histFibLabels
    array<int>   histFibLabelKeys

new_slot() =>
    SlotState.new(histBoxes=array.new<box>(), histBoxKeys=array.new<int>(), histBorderLines=array.new<line>(), histBorderKeys=array.new<int>(),
         fibLines=array.new<line>(), histFibLines=array.new<line>(), histFibKeys=array.new<int>(), fibLabels=array.new<label>(), histFibLabels=array.new<label>(), histFibLabelKeys=array.new<int>())

var SlotState slot1 = new_slot()
var SlotState slot2 = new_slot()
var SlotState slot3 = new_slot()
var SlotState slot4 = new_slot()
var SlotState nyBlockSlot = new_slot()

// DRAWING HELPERS

zone_fill_color(color slotColor) =>
    showZoneFill ? color.new(slotColor, zoneFillTransparency) : color.new(color.white, 100)

forecast_zone_fill_color(color slotColor) =>
    showZoneFill ? color.new(slotColor, math.min(zoneFillTransparency + FORECAST_FILL_TRANSPARENCY_BOOST, 100)) : color.new(color.white, 100)

forecast_border_color(color slotColor) =>
    color.new(slotColor, int(math.max(color.t(slotColor), FORECAST_BORDER_MIN_TRANSPARENCY)))

drawing_x(int timeX, int indexX) =>
    chart.is_range ? math.min(math.max(na(indexX) ? bar_index : indexX, bar_index - BAR_INDEX_DRAWING_LOOKBACK), bar_index + BAR_INDEX_DRAWING_LOOKAHEAD) : timeX

drawing_xloc() =>
    chart.is_range ? xloc.bar_index : xloc.bar_time

make_zone_box(int leftT, int leftIndex, float top, int rightT, int rightIndex, float bottom, color fillClr, color slotColor, string txt, string slotLabelSize, int textTransparency) =>
    box.new(drawing_x(leftT, leftIndex), top, drawing_x(rightT, rightIndex), bottom,
         bgcolor=fillClr, border_color=na, xloc=drawing_xloc(),
         text=txt, text_color=color.new(slotColor, textTransparency),
         text_size=get_label_size(slotLabelSize),
         text_halign=text.align_center, text_valign=text.align_center)

make_horizontal_line(int leftT, int leftIndex, int rightT, int rightIndex, float price, color lineColor, string lineStyle, int lineWidth) =>
    line.new(drawing_x(leftT, leftIndex), price, drawing_x(rightT, rightIndex), price,
         color=lineColor, style=lineStyle, width=lineWidth, xloc=drawing_xloc())

push_keyed_history_borders(array<line> lines, array<int> keys, int key, int leftT, int leftIndex, int rightT, int rightIndex,
                           float outerHigh, float innerHigh, float innerLow, float outerLow, color lineColor) =>
    array.push(lines, make_horizontal_line(leftT, leftIndex, rightT, rightIndex, outerHigh, lineColor, line.style_solid, 1))
    array.push(keys, key)
    array.push(lines, make_horizontal_line(leftT, leftIndex, rightT, rightIndex, innerHigh, lineColor, line.style_solid, 1))
    array.push(keys, key)
    array.push(lines, make_horizontal_line(leftT, leftIndex, rightT, rightIndex, innerLow, lineColor, line.style_solid, 1))
    array.push(keys, key)
    array.push(lines, make_horizontal_line(leftT, leftIndex, rightT, rightIndex, outerLow, lineColor, line.style_solid, 1))
    array.push(keys, key)

make_fib_label(int anchorT, int anchorIndex, float price, string txt, string labelStyle, color textColor, string labelSize) =>
    label.new(drawing_x(anchorT, anchorIndex), price, txt, xloc=drawing_xloc(), style=labelStyle,
         color=color.new(color.white, 100), textcolor=textColor, size=labelSize)

compute_levels(float htfO, float medHO, float meanHO, float medOL, float meanOL) =>
    [htfO + medHO, htfO + meanHO,
     htfO - medOL, htfO - meanOL]

// Pushes one line per visible fib level into `target`. Anchors define 0% / 100% of the fib range.
push_fib_lines(array<line> target, int leftT, int leftIndex, int rightT, int rightIndex, float anchorHigh, float anchorLow, int transparencyBoost,
               array<label> labelTarget, string tfLabel, bool drawLabels, string labelSize, string labelPos, int labelOffsetMs, int labelOffsetBars) =>
    if not na(anchorHigh) and not na(anchorLow)
        float fibRange = anchorHigh - anchorLow

        shows      = array.from(showFib100, showFib786, showFib705, showFib618, showFib50, showFib382, showFib295, showFib214, showFib0)
        levels     = array.from(FIB_LEVEL_100, FIB_LEVEL_786, FIB_LEVEL_705, FIB_LEVEL_618, FIB_LEVEL_50, FIB_LEVEL_382, FIB_LEVEL_295, FIB_LEVEL_214, FIB_LEVEL_0)
        colors     = array.from(fibColor100, fibColor786, fibColor705, fibColor618, fibColor50, fibColor382, fibColor295, fibColor214, fibColor0)
        widths     = array.from(fibWidth100, fibWidth786, fibWidth705, fibWidth618, fibWidth50, fibWidth382, fibWidth295, fibWidth214, fibWidth0)
        ratioTexts = array.from("1.0", "0.786", "0.705", "0.618", "0.5", "0.382", "0.295", "0.214", "0")
        isKeyLevel = array.from(fibKey100, fibKey786, fibKey705, fibKey618, fibKey50, fibKey382, fibKey295, fibKey214, fibKey0)

        bool keyOnly = fibLabelLevels == FL_KEY

        for i = 0 to 8
            if array.get(shows, i)
                float price   = anchorLow + fibRange * array.get(levels, i)
                color baseClr = array.get(colors, i)
                // Clamp at 95 so higher-tier slots never become fully invisible.
                color clr     = color.new(baseClr, math.min(int(color.t(baseClr)) + transparencyBoost, 95))
                array.push(target, make_horizontal_line(leftT, leftIndex, rightT, rightIndex, price, clr, line.style_dotted, array.get(widths, i)))

                if drawLabels and (not keyOnly or array.get(isKeyLevel, i))
                    // Tint label text to match its line, but pull transparency down so faint levels stay legible.
                    color  txtClr  = color.new(baseClr, math.min(FIB_LABEL_TRANSPARENCY_MAX, math.max(0.0, color.t(baseClr) - FIB_LABEL_TRANSPARENCY_REDUCTION)))
                    string lblText = tfLabel + " • " + array.get(ratioTexts, i)
                    // Offset pushes each tag outward from its anchor edge (right tags later, left tags earlier)
                    // so slots whose zones end on the same bar don't stack their tags on one x-coordinate.
                    if labelPos == POS_RIGHT or labelPos == POS_BOTH
                        array.push(labelTarget, make_fib_label(rightT + labelOffsetMs, rightIndex + labelOffsetBars, price, lblText, label.style_label_left, txtClr, labelSize))
                    if labelPos == POS_LEFT or labelPos == POS_BOTH
                        array.push(labelTarget, make_fib_label(leftT - labelOffsetMs, leftIndex - labelOffsetBars, price, lblText, label.style_label_right, txtClr, labelSize))

draw_slot_fib(SlotState s, int leftT, int leftIndex, int rightT, int rightIndex, float anchorHigh, float anchorLow, int transparencyBoost, string tfLabel, bool drawLabels, string labelSize, string labelPos, int labelOffsetMs, int labelOffsetBars) =>
    push_fib_lines(s.fibLines, leftT, leftIndex, rightT, rightIndex, anchorHigh, anchorLow, transparencyBoost, s.fibLabels, tfLabel, drawLabels, labelSize, labelPos, labelOffsetMs, labelOffsetBars)

// Resolves a slot's rollover, dual-coordinate anchors, and effective open/run-high/low.
resolve_slot_timing(string safe, float normOpen, float normRunHigh, float normRunLow,
                    bool nNewDay, int nDayStart, int nDayStartIndex, int nDayEnd, float nOpen, float nRunHigh, float nRunLow,
                    bool nNewWeek, int nWeekStart, int nWeekStartIndex, float nwOpen, float nwRunHigh, float nwRunLow) =>
    bool isDaily   = timeframe.in_seconds(safe) == SECS_DAY
    bool isWeekly  = timeframe.in_seconds(safe) == SECS_WEEK
    int  normStart = time(safe)
    int  normRight = normStart + timeframe.in_seconds(safe) * MS_PER_SEC
    bool normTrans = ta.change(time(safe)) != 0
    int  normStartIndex = nz(ta.valuewhen(normTrans, bar_index, 0), 0)
    if isDaily and holidayMode == HOLIDAY_NATIVE
        [nNewDay, nDayStart, nDayStartIndex, nDayEnd, nOpen, nRunHigh, nRunLow]
    else if isWeekly and holidayMode == HOLIDAY_NATIVE
        [nNewWeek, nWeekStart, nWeekStartIndex, nWeekStart + SECS_WEEK * MS_PER_SEC, nwOpen, nwRunHigh, nwRunLow]
    else if isDaily and holidayMode == HOLIDAY_EXTEND
        [normTrans, normStart, normStartIndex, (normRight > time ? normRight : time), normOpen, normRunHigh, normRunLow]
    else
        [normTrans, normStart, normStartIndex, normRight, normOpen, normRunHigh, normRunLow]

resolve_slot_stats(string safe,
                   float normMedHO, float normMeanHO, float normMedOL, float normMeanOL,
                   float dailyMedHO, float dailyMeanHO, float dailyMedOL, float dailyMeanOL) =>
    bool useMidnightStats = timeframe.in_seconds(safe) == SECS_DAY and midnightDailyEnabled
    if useMidnightStats
        [dailyMedHO, dailyMeanHO, dailyMedOL, dailyMeanOL]
    else
        [normMedHO, normMeanHO, normMedOL, normMeanOL]

resolve_archived_extrema(string safe, float runHigh, float runLow, float completedMidnightHigh, float completedMidnightLow) =>
    bool useCompletedMidnight = timeframe.in_seconds(safe) == SECS_DAY and midnightDailyEnabled and not na(completedMidnightHigh) and not na(completedMidnightLow)
    [useCompletedMidnight ? completedMidnightHigh : runHigh[1], useCompletedMidnight ? completedMidnightLow : runLow[1]]

current_line_request(bool valid, bool fibEnabled, int fibLinesPerZone) =>
    valid ? 4 + (fibEnabled ? fibLinesPerZone : 0) : 0

keyed_pair_border_line_request(bool valid, bool keyed4h, bool currentVisible) =>
    valid and keyed4h ? (currentVisible ? 4 : 8) : 0

history_zone_request(bool latestOnlyEnabled, bool keyWindowsOnly, string tf, bool currentVisible, int historyN) =>
    bool keyedWindows = keyed_4h(keyWindowsOnly, tf)
    int keyedPairCount = latestOnlyEnabled ? 1 : historyN
    int keyedHistory = keyedPairCount * KEY_4H_WINDOW_COUNT - (currentVisible ? 1 : 0)
    math.max(0, keyedWindows ? keyedHistory : latestOnlyEnabled ? 0 : historyN - 1)

fib_history_zone_request(bool latestOnlyEnabled, bool keyWindowsOnly, string tf, bool currentVisible, int historyN, int fibHistoryN) =>
    int displayedHistory = history_zone_request(latestOnlyEnabled, keyWindowsOnly, tf, currentVisible, historyN)
    int retainedHistory = math.min(math.max(0, historyN - 1), fibHistoryN)
    bool keyedWindows = keyed_4h(keyWindowsOnly, tf)
    int keyedPairCount = latestOnlyEnabled ? 1 : math.min(historyN, fibHistoryN + 1)
    int retainedKeyHistory = keyedPairCount * KEY_4H_WINDOW_COUNT - (currentVisible ? 1 : 0)
    math.min(displayedHistory, math.max(0, keyedWindows ? retainedKeyHistory : retainedHistory))

allocate_history_zone_caps(int availableZones, array<bool> validSlots, array<int> zoneRequests, int ordinarySlotCount, int maxHistoryZones) =>
    int slotCount = array.size(validSlots)
    array<int> zoneCaps = array.new<int>(slotCount, 0)
    int remaining = availableZones
    for layer = 1 to maxHistoryZones
        for slotIndex = 0 to ordinarySlotCount - 1
            if array.get(validSlots, slotIndex) and layer <= array.get(zoneRequests, slotIndex) and remaining > 0
                array.set(zoneCaps, slotIndex, array.get(zoneCaps, slotIndex) + 1)
                remaining -= 1
    for layer = 1 to maxHistoryZones
        for slotIndex = ordinarySlotCount to slotCount - 1
            if array.get(validSlots, slotIndex) and layer <= array.get(zoneRequests, slotIndex) and remaining > 0
                array.set(zoneCaps, slotIndex, array.get(zoneCaps, slotIndex) + 1)
                remaining -= 1
    zoneCaps

allocate_history_fib_caps(int availableLines, int availableLabels, array<bool> validSlots, array<int> fibZoneRequests,
                          array<bool> fibSlots, array<bool> labelSlots, array<int> labelsPerZone,
                          int ordinarySlotCount, int fibLinesPerZone, int maxHistoryZones) =>
    int slotCount = array.size(validSlots)
    array<int> fibCaps = array.new<int>(slotCount, 0)
    array<int> labelCaps = array.new<int>(slotCount, 0)
    int remainingLines = availableLines
    int remainingLabels = availableLabels
    for layer = 1 to maxHistoryZones
        for slotIndex = 0 to ordinarySlotCount - 1
            if array.get(validSlots, slotIndex)
                bool fibEnabled = array.get(fibSlots, slotIndex)
                int zoneLabels = array.get(labelSlots, slotIndex) ? array.get(labelsPerZone, slotIndex) : 0
                bool labelBudgetAvailable = zoneLabels == 0 or remainingLabels >= zoneLabels
                if fibEnabled and fibLinesPerZone > 0 and layer <= array.get(fibZoneRequests, slotIndex) and remainingLines >= fibLinesPerZone and labelBudgetAvailable
                    array.set(fibCaps, slotIndex, array.get(fibCaps, slotIndex) + fibLinesPerZone)
                    remainingLines -= fibLinesPerZone
                    if zoneLabels > 0
                        array.set(labelCaps, slotIndex, array.get(labelCaps, slotIndex) + zoneLabels)
                        remainingLabels -= zoneLabels
    for layer = 1 to maxHistoryZones
        for slotIndex = ordinarySlotCount to slotCount - 1
            if array.get(validSlots, slotIndex)
                bool fibEnabled = array.get(fibSlots, slotIndex)
                int zoneLabels = array.get(labelSlots, slotIndex) ? array.get(labelsPerZone, slotIndex) : 0
                bool labelBudgetAvailable = zoneLabels == 0 or remainingLabels >= zoneLabels
                if fibEnabled and fibLinesPerZone > 0 and layer <= array.get(fibZoneRequests, slotIndex) and remainingLines >= fibLinesPerZone and labelBudgetAvailable
                    array.set(fibCaps, slotIndex, array.get(fibCaps, slotIndex) + fibLinesPerZone)
                    remainingLines -= fibLinesPerZone
                    if zoneLabels > 0
                        array.set(labelCaps, slotIndex, array.get(labelCaps, slotIndex) + zoneLabels)
                        remainingLabels -= zoneLabels
    [fibCaps, labelCaps]

remove_box_history_key(array<box> objects, array<int> keys, int targetKey) =>
    if not na(targetKey)
        int i = array.size(objects) - 1
        while i >= 0
            if array.get(keys, i) == targetKey
                box.delete(array.remove(objects, i))
                array.remove(keys, i)
            i -= 1

remove_line_history_key(array<line> objects, array<int> keys, int targetKey) =>
    if not na(targetKey)
        int i = array.size(objects) - 1
        while i >= 0
            if array.get(keys, i) == targetKey
                line.delete(array.remove(objects, i))
                array.remove(keys, i)
            i -= 1

remove_label_history_key(array<label> objects, array<int> keys, int targetKey) =>
    if not na(targetKey)
        int i = array.size(objects) - 1
        while i >= 0
            if array.get(keys, i) == targetKey
                label.delete(array.remove(objects, i))
                array.remove(keys, i)
            i -= 1

key_4h_window_identity(int occurrenceKey) =>
    not na(occurrenceKey) ? hour(occurrenceKey, NY_TIMEZONE) : na

history_occurrence_count(array<int> keys, int windowIdentity) =>
    int count = 0
    int previousKey = na
    if array.size(keys) > 0
        for i = 0 to array.size(keys) - 1
            int occurrenceKey = array.get(keys, i)
            bool newOccurrence = na(previousKey) or occurrenceKey != previousKey
            if newOccurrence and key_4h_window_identity(occurrenceKey) == windowIdentity
                count += 1
            previousKey := occurrenceKey
    count

oldest_history_occurrence(array<int> keys, int windowIdentity) =>
    int occurrenceKey = na
    int i = 0
    while i < array.size(keys) and na(occurrenceKey)
        int candidate = array.get(keys, i)
        if key_4h_window_identity(candidate) == windowIdentity
            occurrenceKey := candidate
        i += 1
    occurrenceKey

keyed_history_identity_cap(int totalZoneCap, int currentHistoryKey, int windowIdentity, bool currentObjectVisible) =>
    int currentIdentity = currentObjectVisible ? key_4h_window_identity(currentHistoryKey) : na
    int currentCount = not na(currentIdentity) ? 1 : 0
    int pairCap = int((totalZoneCap + currentCount) / KEY_4H_WINDOW_COUNT)
    bool currentMatchesIdentity = not na(currentIdentity) and currentIdentity == windowIdentity
    math.max(0, pairCap - (currentMatchesIdentity ? 1 : 0))

trim_keyed_box_history(array<box> objects, array<int> keys, int totalZoneCap, int currentHistoryKey, bool currentObjectVisible) =>
    for windowIdentity = 6 to 10 by 4
        int identityCap = keyed_history_identity_cap(totalZoneCap, currentHistoryKey, windowIdentity, currentObjectVisible)
        while history_occurrence_count(keys, windowIdentity) > identityCap
            remove_box_history_key(objects, keys, oldest_history_occurrence(keys, windowIdentity))

trim_keyed_line_history(array<line> objects, array<int> keys, int totalZoneCap, int currentHistoryKey, bool currentObjectVisible) =>
    for windowIdentity = 6 to 10 by 4
        int identityCap = keyed_history_identity_cap(totalZoneCap, currentHistoryKey, windowIdentity, currentObjectVisible)
        while history_occurrence_count(keys, windowIdentity) > identityCap
            remove_line_history_key(objects, keys, oldest_history_occurrence(keys, windowIdentity))

trim_keyed_label_history(array<label> objects, array<int> keys, int totalZoneCap, int currentHistoryKey, bool currentObjectVisible) =>
    for windowIdentity = 6 to 10 by 4
        int identityCap = keyed_history_identity_cap(totalZoneCap, currentHistoryKey, windowIdentity, currentObjectVisible)
        while history_occurrence_count(keys, windowIdentity) > identityCap
            remove_label_history_key(objects, keys, oldest_history_occurrence(keys, windowIdentity))

trim_keyed_slot_history(SlotState s, bool keyed4h, int currentHistoryKey, int boxZoneCap, int fibZoneCap, int labelZoneCap,
                        bool fibCurrentVisible, bool labelCurrentVisible) =>
    if keyed4h
        trim_keyed_box_history(s.histBoxes, s.histBoxKeys, boxZoneCap, currentHistoryKey, not na(currentHistoryKey))
        trim_keyed_line_history(s.histFibLines, s.histFibKeys, fibZoneCap, currentHistoryKey, fibCurrentVisible)
        trim_keyed_label_history(s.histFibLabels, s.histFibLabelKeys, labelZoneCap, currentHistoryKey, labelCurrentVisible)

// On HTF transition, [1] reads give us the just-closed bar's open + the stats as of its
// start (i.e. excluding it) — exactly what was used to project that bar in real time.
update_slot(SlotState s, bool valid, bool transitionNow, bool archivePrevious, bool keyed4h, int currentHistoryKey, int previousHistoryKey, int zoneStartT, int zoneStartIndex, bool fixedEnd, int zoneEndT, int zoneEndIndex,
             float htfO, float archivedRunHigh, float archivedRunLow, color slotColor, string htfLabel,
             float medHO, float meanHO, float medOL, float meanOL,
             int boxHistZoneCap, string slotLabelSize,
             bool fibEnabled, int fibFade, int fibLinesPerZone, int fibHistCap,
             bool histLabelsEnabled, int histLabelCap, int histLabelsPerZone, string histLabelSize, string histLabelPos, int histLabelOffsetMs, int histLabelOffsetBars) =>
    int borderZoneCap = not na(currentHistoryKey) ? 1 : KEY_4H_WINDOW_COUNT
    if valid and keyed4h and transitionNow
        remove_box_history_key(s.histBoxes, s.histBoxKeys, currentHistoryKey)
        remove_line_history_key(s.histBorderLines, s.histBorderKeys, currentHistoryKey)
        remove_line_history_key(s.histFibLines, s.histFibKeys, currentHistoryKey)
        remove_label_history_key(s.histFibLabels, s.histFibLabelKeys, currentHistoryKey)
        trim_keyed_line_history(s.histBorderLines, s.histBorderKeys, borderZoneCap, currentHistoryKey, not na(currentHistoryKey))

    // Standard histories trim every bar; keyed histories rebalance on each 4H transition.
    int boxHistCap = valid ? boxHistZoneCap * 2 : 0
    int fibHistZoneCap = fibLinesPerZone > 0 ? int(fibHistCap / fibLinesPerZone) : 0
    int histLabelZoneCap = histLabelsPerZone > 0 ? int(histLabelCap / histLabelsPerZone) : 0
    if keyed4h
        if transitionNow
            trim_keyed_slot_history(s, true, currentHistoryKey, boxHistZoneCap, fibHistZoneCap, histLabelZoneCap,
                 fibEnabled and not na(currentHistoryKey), histLabelsEnabled and not na(currentHistoryKey))
    else
        while array.size(s.histBorderLines) > 0
            line.delete(array.shift(s.histBorderLines))
            array.shift(s.histBorderKeys)
        while array.size(s.histBoxes) > boxHistCap
            box.delete(array.shift(s.histBoxes))
            array.shift(s.histBoxKeys)
        while array.size(s.histFibLines) > fibHistCap
            line.delete(array.shift(s.histFibLines))
            array.shift(s.histFibKeys)
        while array.size(s.histFibLabels) > histLabelCap
            label.delete(array.shift(s.histFibLabels))
            array.shift(s.histFibLabelKeys)

    bool archiveDistinctKey = not keyed4h or na(currentHistoryKey) or previousHistoryKey != currentHistoryKey
    if valid and transitionNow and archivePrevious and archiveDistinctKey
        prevO      = htfO[1]
        prevMedHO  = medHO[1]
        prevMeanHO = meanHO[1]
        prevMedOL  = medOL[1]
        prevMeanOL = meanOL[1]

        if not na(prevO) and not na(prevMedHO) and not na(prevMedOL)
            if keyed4h
                remove_box_history_key(s.histBoxes, s.histBoxKeys, previousHistoryKey)
                remove_line_history_key(s.histBorderLines, s.histBorderKeys, previousHistoryKey)
                remove_line_history_key(s.histFibLines, s.histFibKeys, previousHistoryKey)
                remove_label_history_key(s.histFibLabels, s.histFibLabelKeys, previousHistoryKey)

            [h_innH, h_outH, h_innL, h_outL] = compute_levels(prevO, prevMedHO, prevMeanHO, prevMedOL, prevMeanOL)
            bar_l_t = zoneStartT[1]
            bar_r_t = fixedEnd ? zoneEndT[1] : zoneStartT
            bar_l_index = zoneStartIndex[1]
            bar_r_index = fixedEnd ? zoneEndIndex[1] : zoneStartIndex

            if keyed4h
                push_keyed_history_borders(s.histBorderLines, s.histBorderKeys, previousHistoryKey, bar_l_t, bar_l_index, bar_r_t, bar_r_index,
                     h_outH, h_innH, h_innL, h_outL, slotColor)

            if boxHistCap > 0
                if showZoneFill
                    color fillClr = zone_fill_color(slotColor)
                    if not keyed4h
                        while array.size(s.histBoxes) > boxHistCap - 2
                            box.delete(array.shift(s.histBoxes))
                            array.shift(s.histBoxKeys)
                    array.push(s.histBoxes, make_zone_box(bar_l_t, bar_l_index, h_outH, bar_r_t, bar_r_index, h_innH, fillClr, slotColor, "", slotLabelSize, LABEL_TEXT_TRANSPARENCY))
                    array.push(s.histBoxKeys, previousHistoryKey)
                    array.push(s.histBoxes, make_zone_box(bar_l_t, bar_l_index, h_innL, bar_r_t, bar_r_index, h_outL, fillClr, slotColor, "", slotLabelSize, LABEL_TEXT_TRANSPARENCY))
                    array.push(s.histBoxKeys, previousHistoryKey)

            if fibHistCap >= fibLinesPerZone and fibLinesPerZone > 0
                if not keyed4h
                    while array.size(s.histFibLines) > fibHistCap - fibLinesPerZone
                        line.delete(array.shift(s.histFibLines))
                        array.shift(s.histFibKeys)
                float histAnchorHigh = fibTrailing ? math.max(h_outH, archivedRunHigh) : h_outH
                float histAnchorLow  = fibTrailing ? math.min(h_outL, archivedRunLow)  : h_outL
                if histLabelsEnabled and histLabelsPerZone > 0 and histLabelCap >= histLabelsPerZone
                    if not keyed4h
                        while array.size(s.histFibLabels) > histLabelCap - histLabelsPerZone
                            label.delete(array.shift(s.histFibLabels))
                            array.shift(s.histFibLabelKeys)
                push_fib_lines(s.histFibLines, bar_l_t, bar_l_index, bar_r_t, bar_r_index, histAnchorHigh, histAnchorLow, fibFade, s.histFibLabels, htfLabel, histLabelsEnabled and histLabelCap >= histLabelsPerZone, histLabelSize, histLabelPos, histLabelOffsetMs, histLabelOffsetBars)
                while array.size(s.histFibKeys) < array.size(s.histFibLines)
                    array.push(s.histFibKeys, previousHistoryKey)
                while array.size(s.histFibLabelKeys) < array.size(s.histFibLabels)
                    array.push(s.histFibLabelKeys, previousHistoryKey)

    if keyed4h and transitionNow
        trim_keyed_slot_history(s, true, currentHistoryKey, boxHistZoneCap, fibHistZoneCap, histLabelZoneCap,
             fibEnabled and not na(currentHistoryKey), histLabelsEnabled and not na(currentHistoryKey))
        trim_keyed_line_history(s.histBorderLines, s.histBorderKeys, borderZoneCap, currentHistoryKey, not na(currentHistoryKey))

draw_slot_current(SlotState s, bool valid, bool promoteLatestHistory, int curLeftT, int curLeftIndex, int curRightT, int curRightIndex, float htfO, float htfH, float htfL, color slotColor, string identifierText, string fibLabelPrefix,
                   float medHO, float meanHO, float medOL, float meanOL,
                   string slotLabelSize, bool fibEnabled, int fibTransparencyBoost, bool labelSlotEnabled, string fibLabelSize, string fibLabelPos, int fibLabelOffsetMs, int fibLabelOffsetBars) =>
    // Null after delete so toggling a feature off mid-session leaves no dangling handle.
    if not na(s.fillUp)
        box.delete(s.fillUp)
        s.fillUp := na
    if not na(s.fillLo)
        box.delete(s.fillLo)
        s.fillLo := na
    if not na(s.innH)
        line.delete(s.innH)
        s.innH := na
    if not na(s.innL)
        line.delete(s.innL)
        s.innL := na
    if not na(s.outH)
        line.delete(s.outH)
        s.outH := na
    if not na(s.outL)
        line.delete(s.outL)
        s.outL := na
    while array.size(s.fibLines) > 0
        line.delete(array.pop(s.fibLines))
    while array.size(s.fibLabels) > 0
        label.delete(array.pop(s.fibLabels))

    int latestHistoryKey = na
    box latestHistoryBoxA = na
    box latestHistoryBoxB = na
    if array.size(s.histBoxes) > 0
        for i = 0 to array.size(s.histBoxes) - 1
            box historyBox = array.get(s.histBoxes, i)
            box.set_text(historyBox, "")
            int historyKey = array.get(s.histBoxKeys, i)
            if promoteLatestHistory and not na(historyKey) and (na(latestHistoryKey) or historyKey > latestHistoryKey)
                latestHistoryKey := historyKey
        if promoteLatestHistory and not na(latestHistoryKey)
            for i = 0 to array.size(s.histBoxes) - 1
                if array.get(s.histBoxKeys, i) == latestHistoryKey
                    if na(latestHistoryBoxA)
                        latestHistoryBoxA := array.get(s.histBoxes, i)
                    else if na(latestHistoryBoxB)
                        latestHistoryBoxB := array.get(s.histBoxes, i)

    if not valid and promoteLatestHistory and not na(latestHistoryBoxA) and not na(latestHistoryBoxB)
        bool historyBoxAIsUpper = box.get_top(latestHistoryBoxA) >= box.get_top(latestHistoryBoxB)
        box upperHistoryBox = historyBoxAIsUpper ? latestHistoryBoxA : latestHistoryBoxB
        box lowerHistoryBox = historyBoxAIsUpper ? latestHistoryBoxB : latestHistoryBoxA
        string promotedIdentifierText = identifierTextMode != IDENTIFIER_TEXT_OFF ? identifierText : ""
        box.set_text(upperHistoryBox, promotedIdentifierText)
        box.set_text(lowerHistoryBox, promotedIdentifierText)

    if valid and not na(medHO) and not na(medOL)
        [innerHigh, outerHigh, innerLow, outerLow] = compute_levels(htfO, medHO, meanHO, medOL, meanOL)

        bool showCurrentIdentifierText = identifierTextMode != IDENTIFIER_TEXT_OFF
        string currentIdentifierText = showCurrentIdentifierText ? identifierText : ""
        color  fillClr    = zone_fill_color(slotColor)
        if showZoneFill or showCurrentIdentifierText
            s.fillUp := make_zone_box(curLeftT, curLeftIndex, outerHigh, curRightT, curRightIndex, innerHigh, fillClr, slotColor, currentIdentifierText, slotLabelSize, LABEL_TEXT_TRANSPARENCY)
            s.fillLo := make_zone_box(curLeftT, curLeftIndex, innerLow, curRightT, curRightIndex, outerLow, fillClr, slotColor, currentIdentifierText, slotLabelSize, LABEL_TEXT_TRANSPARENCY)

        s.innH := make_horizontal_line(curLeftT, curLeftIndex, curRightT, curRightIndex, innerHigh, slotColor, line.style_solid, 1)
        s.innL := make_horizontal_line(curLeftT, curLeftIndex, curRightT, curRightIndex, innerLow, slotColor, line.style_solid, 1)
        s.outH := make_horizontal_line(curLeftT, curLeftIndex, curRightT, curRightIndex, outerHigh, slotColor, line.style_solid, 1)
        s.outL := make_horizontal_line(curLeftT, curLeftIndex, curRightT, curRightIndex, outerLow, slotColor, line.style_solid, 1)

        if fibEnabled
            float fibAnchorHigh = fibTrailing ? math.max(outerHigh, htfH) : outerHigh
            float fibAnchorLow  = fibTrailing ? math.min(outerLow,  htfL) : outerLow
            draw_slot_fib(s, curLeftT, curLeftIndex, curRightT, curRightIndex, fibAnchorHigh, fibAnchorLow, fibTransparencyBoost, fibLabelPrefix, labelSlotEnabled, fibLabelSize, fibLabelPos, fibLabelOffsetMs, fibLabelOffsetBars)

draw_slot_forecast(SlotState s, bool valid, int forecastLeftT, int forecastLeftIndex, int forecastRightT, int forecastRightIndex,
                   float htfO, float htfH, float htfL, color slotColor, string identifierText, string slotLabelSize,
                   float medHO, float meanHO, float medOL, float meanOL) =>
    if not na(s.forecastFillUp)
        box.delete(s.forecastFillUp)
        s.forecastFillUp := na
    if not na(s.forecastFillLo)
        box.delete(s.forecastFillLo)
        s.forecastFillLo := na
    if not na(s.forecastInnH)
        line.delete(s.forecastInnH)
        s.forecastInnH := na
    if not na(s.forecastInnL)
        line.delete(s.forecastInnL)
        s.forecastInnL := na
    if not na(s.forecastOutH)
        line.delete(s.forecastOutH)
        s.forecastOutH := na
    if not na(s.forecastOutL)
        line.delete(s.forecastOutL)
        s.forecastOutL := na

    if valid and not na(htfO) and not na(medHO) and not na(meanHO) and not na(medOL) and not na(meanOL)
        [referenceInnerHigh, referenceOuterHigh, referenceInnerLow, referenceOuterLow] = compute_levels(htfO, medHO, meanHO, medOL, meanOL)
        float highestExit = math.max(referenceInnerHigh, referenceOuterHigh)
        float lowestExit = math.min(referenceInnerLow, referenceOuterLow)
        if not na(htfH)
            highestExit := math.max(highestExit, htfH)
        if not na(htfL)
            lowestExit := math.min(lowestExit, htfL)

        float forecastInnerHigh = highestExit + math.min(medHO, meanHO)
        float forecastOuterHigh = highestExit + math.max(medHO, meanHO)
        float forecastInnerLow = lowestExit - math.min(medOL, meanOL)
        float forecastOuterLow = lowestExit - math.max(medOL, meanOL)
        color fillColor = forecast_zone_fill_color(slotColor)
        color borderColor = forecast_border_color(slotColor)
        bool showForecastIdentifierText = identifierTextMode != IDENTIFIER_TEXT_OFF
        string forecastIdentifierText = showForecastIdentifierText ? identifierText : ""

        if showZoneFill or showForecastIdentifierText
            s.forecastFillUp := make_zone_box(forecastLeftT, forecastLeftIndex, forecastOuterHigh, forecastRightT, forecastRightIndex, forecastInnerHigh, fillColor, slotColor, forecastIdentifierText, slotLabelSize, FORECAST_LABEL_TEXT_TRANSPARENCY)
            s.forecastFillLo := make_zone_box(forecastLeftT, forecastLeftIndex, forecastInnerLow, forecastRightT, forecastRightIndex, forecastOuterLow, fillColor, slotColor, forecastIdentifierText, slotLabelSize, FORECAST_LABEL_TEXT_TRANSPARENCY)

        s.forecastInnH := make_horizontal_line(forecastLeftT, forecastLeftIndex, forecastRightT, forecastRightIndex, forecastInnerHigh, borderColor, line.style_dashed, 1)
        s.forecastInnL := make_horizontal_line(forecastLeftT, forecastLeftIndex, forecastRightT, forecastRightIndex, forecastInnerLow, borderColor, line.style_dashed, 1)
        s.forecastOutH := make_horizontal_line(forecastLeftT, forecastLeftIndex, forecastRightT, forecastRightIndex, forecastOuterHigh, borderColor, line.style_dashed, 1)
        s.forecastOutL := make_horizontal_line(forecastLeftT, forecastLeftIndex, forecastRightT, forecastRightIndex, forecastOuterLow, borderColor, line.style_dashed, 1)


// DISPATCH — every bar maintains state per slot

bool selectedDailyTransition = midnightDailyEnabled ? midnightNewDay : nativeNewDay
int selectedDailyStart = midnightDailyEnabled ? midnightDayStart : nativeDayStart
int selectedDailyStartIndex = midnightDailyEnabled ? midnightDayStartIndex : nativeDayStartIndex
int selectedDailyEnd = midnightDailyEnabled ? midnightDayEnd : nativeDayStart + SECS_DAY * MS_PER_SEC
float selectedDailyOpen = midnightDailyEnabled ? midnightOpen : nativeOpen
float selectedDailyRunHigh = midnightDailyEnabled ? midnightEffectiveRunHigh : nativeRunHigh
float selectedDailyRunLow = midnightDailyEnabled ? midnightEffectiveRunLow : nativeRunLow

[s1MedHO, s1MeanHO, s1MedOL, s1MeanOL] = resolve_slot_stats(s1Safe, s1NormMedHO, s1NormMeanHO, s1NormMedOL, s1NormMeanOL, midnightMedHO, midnightMeanHO, midnightMedOL, midnightMeanOL)
[s2MedHO, s2MeanHO, s2MedOL, s2MeanOL] = resolve_slot_stats(s2Safe, s2NormMedHO, s2NormMeanHO, s2NormMedOL, s2NormMeanOL, midnightMedHO, midnightMeanHO, midnightMedOL, midnightMeanOL)
[s3MedHO, s3MeanHO, s3MedOL, s3MeanOL] = resolve_slot_stats(s3Safe, s3NormMedHO, s3NormMeanHO, s3NormMedOL, s3NormMeanOL, midnightMedHO, midnightMeanHO, midnightMedOL, midnightMeanOL)
[s4MedHO, s4MeanHO, s4MedOL, s4MeanOL] = resolve_slot_stats(s4Safe, s4NormMedHO, s4NormMeanHO, s4NormMedOL, s4NormMeanOL, midnightMedHO, midnightMeanHO, midnightMedOL, midnightMeanOL)

[s1Trans, s1StartT, s1StartIndex, s1CurRightT, s1OEff, s1RHi, s1RLo] = resolve_slot_timing(s1Safe, s1O, s1RunHigh, s1RunLow, selectedDailyTransition, selectedDailyStart, selectedDailyStartIndex, selectedDailyEnd, selectedDailyOpen, selectedDailyRunHigh, selectedDailyRunLow, nativeNewWeek, nativeWeekStartT, nativeWeekStartIndex, nativeWeekOpen, nativeWeekRunHigh, nativeWeekRunLow)
[s2Trans, s2StartT, s2StartIndex, s2CurRightT, s2OEff, s2RHi, s2RLo] = resolve_slot_timing(s2Safe, s2O, s2RunHigh, s2RunLow, selectedDailyTransition, selectedDailyStart, selectedDailyStartIndex, selectedDailyEnd, selectedDailyOpen, selectedDailyRunHigh, selectedDailyRunLow, nativeNewWeek, nativeWeekStartT, nativeWeekStartIndex, nativeWeekOpen, nativeWeekRunHigh, nativeWeekRunLow)
[s3Trans, s3StartT, s3StartIndex, s3CurRightT, s3OEff, s3RHi, s3RLo] = resolve_slot_timing(s3Safe, s3O, s3RunHigh, s3RunLow, selectedDailyTransition, selectedDailyStart, selectedDailyStartIndex, selectedDailyEnd, selectedDailyOpen, selectedDailyRunHigh, selectedDailyRunLow, nativeNewWeek, nativeWeekStartT, nativeWeekStartIndex, nativeWeekOpen, nativeWeekRunHigh, nativeWeekRunLow)
[s4Trans, s4StartT, s4StartIndex, s4CurRightT, s4OEff, s4RHi, s4RLo] = resolve_slot_timing(s4Safe, s4O, s4RunHigh, s4RunLow, selectedDailyTransition, selectedDailyStart, selectedDailyStartIndex, selectedDailyEnd, selectedDailyOpen, selectedDailyRunHigh, selectedDailyRunLow, nativeNewWeek, nativeWeekStartT, nativeWeekStartIndex, nativeWeekOpen, nativeWeekRunHigh, nativeWeekRunLow)

[s1ArchivedRunHigh, s1ArchivedRunLow] = resolve_archived_extrema(s1Safe, s1RHi, s1RLo, midnightCompletedRunHigh, midnightCompletedRunLow)
[s2ArchivedRunHigh, s2ArchivedRunLow] = resolve_archived_extrema(s2Safe, s2RHi, s2RLo, midnightCompletedRunHigh, midnightCompletedRunLow)
[s3ArchivedRunHigh, s3ArchivedRunLow] = resolve_archived_extrema(s3Safe, s3RHi, s3RLo, midnightCompletedRunHigh, midnightCompletedRunLow)
[s4ArchivedRunHigh, s4ArchivedRunLow] = resolve_archived_extrema(s4Safe, s4RHi, s4RLo, midnightCompletedRunHigh, midnightCompletedRunLow)

bool s1CurrentVisible = s1Valid and ordinary_period_visible(s1Safe, s1StartT, ny4hOnlyEnabled)
bool s2CurrentVisible = s2Valid and ordinary_period_visible(s2Safe, s2StartT, ny4hOnlyEnabled)
bool s3CurrentVisible = s3Valid and ordinary_period_visible(s3Safe, s3StartT, ny4hOnlyEnabled)
bool s4CurrentVisible = s4Valid and ordinary_period_visible(s4Safe, s4StartT, ny4hOnlyEnabled)
bool s1ArchivePrevious = ordinary_period_visible(s1Safe, s1StartT[1], ny4hOnlyEnabled)
bool s2ArchivePrevious = ordinary_period_visible(s2Safe, s2StartT[1], ny4hOnlyEnabled)
bool s3ArchivePrevious = ordinary_period_visible(s3Safe, s3StartT[1], ny4hOnlyEnabled)
bool s4ArchivePrevious = ordinary_period_visible(s4Safe, s4StartT[1], ny4hOnlyEnabled)
bool s1Keyed4h = keyed_4h(ny4hOnlyEnabled, s1Safe)
bool s2Keyed4h = keyed_4h(ny4hOnlyEnabled, s2Safe)
bool s3Keyed4h = keyed_4h(ny4hOnlyEnabled, s3Safe)
bool s4Keyed4h = keyed_4h(ny4hOnlyEnabled, s4Safe)
int s1CurrentHistoryKey = key_4h_window_id(s1Keyed4h, s1StartT)
int s2CurrentHistoryKey = key_4h_window_id(s2Keyed4h, s2StartT)
int s3CurrentHistoryKey = key_4h_window_id(s3Keyed4h, s3StartT)
int s4CurrentHistoryKey = key_4h_window_id(s4Keyed4h, s4StartT)
int s1PreviousHistoryKey = key_4h_window_id(s1Keyed4h, s1StartT[1])
int s2PreviousHistoryKey = key_4h_window_id(s2Keyed4h, s2StartT[1])
int s3PreviousHistoryKey = key_4h_window_id(s3Keyed4h, s3StartT[1])
int s4PreviousHistoryKey = key_4h_window_id(s4Keyed4h, s4StartT[1])
bool s1BudgetVisible = s1CurrentVisible or (s1Trans and s1CurrentVisible[1])
bool s2BudgetVisible = s2CurrentVisible or (s2Trans and s2CurrentVisible[1])
bool s3BudgetVisible = s3CurrentVisible or (s3Trans and s3CurrentVisible[1])
bool s4BudgetVisible = s4CurrentVisible or (s4Trans and s4CurrentVisible[1])
bool s1ForecastVisible = next_forecast_visible(forecastSlot1, s1Valid, s1Safe, s1CurRightT, ny4hOnlyEnabled)
bool s2ForecastVisible = next_forecast_visible(forecastSlot2, s2Valid, s2Safe, s2CurRightT, ny4hOnlyEnabled)
bool s3ForecastVisible = next_forecast_visible(forecastSlot3, s3Valid, s3Safe, s3CurRightT, ny4hOnlyEnabled)
bool s4ForecastVisible = next_forecast_visible(forecastSlot4, s4Valid, s4Safe, s4CurRightT, ny4hOnlyEnabled)
int nyBlockForecastStartT = timestamp(NY_TIMEZONE, year(time, NY_TIMEZONE), month(time, NY_TIMEZONE), dayofmonth(time, NY_TIMEZONE), NY_BLOCK_START_HOUR, 0)
int nyBlockForecastEndT = timestamp(NY_TIMEZONE, year(time, NY_TIMEZONE), month(time, NY_TIMEZONE), dayofmonth(time, NY_TIMEZONE), NY_BLOCK_END_HOUR, 0)
bool nyBlockForecastWeekday = dayofweek(nyBlockForecastStartT, NY_TIMEZONE) >= dayofweek.monday and dayofweek(nyBlockForecastStartT, NY_TIMEZONE) <= dayofweek.friday
bool nyBlockForecastVisible = showNextRangeForecast and forecastNyBlock and not chart.is_range and nyBlockValid and nyBlockForecastWeekday and time >= nyBlockForecastStartT - (NY_BLOCK_END_HOUR - NY_BLOCK_START_HOUR) * SECS_HOUR * MS_PER_SEC and time < nyBlockForecastStartT

int fibLinesPerZone = (showFib100 ? 1 : 0) + (showFib786 ? 1 : 0) + (showFib705 ? 1 : 0) + (showFib618 ? 1 : 0) + (showFib50 ? 1 : 0) + (showFib382 ? 1 : 0) + (showFib295 ? 1 : 0) + (showFib214 ? 1 : 0) + (showFib0 ? 1 : 0)
bool fibLabelsOn = fibLabelLevels != FL_OFF
bool fibKeyLabelsOnly = fibLabelLevels == FL_KEY
int fibLabelsPerSide = fibLabelsOn ? ((showFib100 and (not fibKeyLabelsOnly or fibKey100) ? 1 : 0) + (showFib786 and (not fibKeyLabelsOnly or fibKey786) ? 1 : 0) + (showFib705 and (not fibKeyLabelsOnly or fibKey705) ? 1 : 0) + (showFib618 and (not fibKeyLabelsOnly or fibKey618) ? 1 : 0) + (showFib50 and (not fibKeyLabelsOnly or fibKey50) ? 1 : 0) + (showFib382 and (not fibKeyLabelsOnly or fibKey382) ? 1 : 0) + (showFib295 and (not fibKeyLabelsOnly or fibKey295) ? 1 : 0) + (showFib214 and (not fibKeyLabelsOnly or fibKey214) ? 1 : 0) + (showFib0 and (not fibKeyLabelsOnly or fibKey0) ? 1 : 0)) : 0
bool fibLabel1On = fibLabelsOn and fibLabelSlot1
bool fibLabel2On = fibLabelsOn and fibLabelSlot2
bool fibLabel3On = fibLabelsOn and fibLabelSlot3
bool fibLabel4On = fibLabelsOn and fibLabelSlot4
bool fibLabelNyBlockOn = fibLabelsOn and fibLabelNyBlock
int s1LabelsPerZone = slot1Fib and fibLabel1On ? fibLabelsPerSide * (fibLabelPos1 == POS_BOTH ? 2 : 1) : 0
int s2LabelsPerZone = slot2Fib and fibLabel2On ? fibLabelsPerSide * (fibLabelPos2 == POS_BOTH ? 2 : 1) : 0
int s3LabelsPerZone = slot3Fib and fibLabel3On ? fibLabelsPerSide * (fibLabelPos3 == POS_BOTH ? 2 : 1) : 0
int s4LabelsPerZone = slot4Fib and fibLabel4On ? fibLabelsPerSide * (fibLabelPos4 == POS_BOTH ? 2 : 1) : 0
int nyBlockLabelsPerZone = nyBlockFib and fibLabelNyBlockOn ? fibLabelsPerSide * (fibLabelPosNyBlock == POS_BOTH ? 2 : 1) : 0

int s1HistoryZoneRequest = history_zone_request(latestOnly, ny4hOnlyEnabled, s1Safe, s1CurrentVisible, slot1History)
int s2HistoryZoneRequest = history_zone_request(latestOnly, ny4hOnlyEnabled, s2Safe, s2CurrentVisible, slot2History)
int s3HistoryZoneRequest = history_zone_request(latestOnly, ny4hOnlyEnabled, s3Safe, s3CurrentVisible, slot3History)
int s4HistoryZoneRequest = history_zone_request(latestOnly, ny4hOnlyEnabled, s4Safe, s4CurrentVisible, slot4History)
int nyBlockHistoryZoneRequest = latestOnly ? 0 : nyBlockHistory - 1
int s1FibHistoryZoneRequest = fib_history_zone_request(latestOnly, ny4hOnlyEnabled, s1Safe, s1CurrentVisible, slot1History, fibHistory)
int s2FibHistoryZoneRequest = fib_history_zone_request(latestOnly, ny4hOnlyEnabled, s2Safe, s2CurrentVisible, slot2History, fibHistory)
int s3FibHistoryZoneRequest = fib_history_zone_request(latestOnly, ny4hOnlyEnabled, s3Safe, s3CurrentVisible, slot3History, fibHistory)
int s4FibHistoryZoneRequest = fib_history_zone_request(latestOnly, ny4hOnlyEnabled, s4Safe, s4CurrentVisible, slot4History, fibHistory)
int nyBlockFibHistoryZoneRequest = math.min(nyBlockHistoryZoneRequest, math.min(math.max(0, nyBlockHistory - 1), fibHistory))

array<bool> historyBudgetValids = array.from(s1Valid, s2Valid, s3Valid, s4Valid, nyBlockValid)
array<int> historyZoneRequests = array.from(s1HistoryZoneRequest, s2HistoryZoneRequest, s3HistoryZoneRequest, s4HistoryZoneRequest, nyBlockHistoryZoneRequest)

bool currentBoxesEnabled = showZoneFill or identifierTextMode != IDENTIFIER_TEXT_OFF
int currentBoxZoneCount = (s1BudgetVisible ? 1 : 0) + (s2BudgetVisible ? 1 : 0) + (s3BudgetVisible ? 1 : 0) + (s4BudgetVisible ? 1 : 0) + (nyBlockValid ? 1 : 0)
int forecastZoneCount = (s1ForecastVisible ? 1 : 0) + (s2ForecastVisible ? 1 : 0) + (s3ForecastVisible ? 1 : 0) + (s4ForecastVisible ? 1 : 0) + (nyBlockForecastVisible ? 1 : 0)
int currentBoxReserve = currentBoxesEnabled ? (currentBoxZoneCount + forecastZoneCount) * 2 : 0
int availableHistoryBoxZones = showZoneFill ? int(math.max(0, INDICATOR_MAX_BOXES - currentBoxReserve) / 2) : 0
array<int> boxHistZoneCaps = allocate_history_zone_caps(availableHistoryBoxZones, historyBudgetValids, historyZoneRequests, ORDINARY_SLOT_COUNT, KEY_4H_HISTORY_ZONE_MAX)
int s1BoxHistZoneCap = array.get(boxHistZoneCaps, 0)
int s2BoxHistZoneCap = array.get(boxHistZoneCaps, 1)
int s3BoxHistZoneCap = array.get(boxHistZoneCaps, 2)
int s4BoxHistZoneCap = array.get(boxHistZoneCaps, 3)
int nyBlockBoxHistZoneCap = array.get(boxHistZoneCaps, 4)
int s1RetainedHistoryZoneCap = showZoneFill ? s1BoxHistZoneCap : s1HistoryZoneRequest
int s2RetainedHistoryZoneCap = showZoneFill ? s2BoxHistZoneCap : s2HistoryZoneRequest
int s3RetainedHistoryZoneCap = showZoneFill ? s3BoxHistZoneCap : s3HistoryZoneRequest
int s4RetainedHistoryZoneCap = showZoneFill ? s4BoxHistZoneCap : s4HistoryZoneRequest
int nyBlockRetainedHistoryZoneCap = showZoneFill ? nyBlockBoxHistZoneCap : nyBlockHistoryZoneRequest

int ordinaryCurrentLineReserve = current_line_request(s1BudgetVisible, slot1Fib, fibLinesPerZone) + keyed_pair_border_line_request(s1Valid, s1Keyed4h, s1CurrentVisible) + current_line_request(s2BudgetVisible, slot2Fib, fibLinesPerZone) + keyed_pair_border_line_request(s2Valid, s2Keyed4h, s2CurrentVisible) + current_line_request(s3BudgetVisible, slot3Fib, fibLinesPerZone) + keyed_pair_border_line_request(s3Valid, s3Keyed4h, s3CurrentVisible) + current_line_request(s4BudgetVisible, slot4Fib, fibLinesPerZone) + keyed_pair_border_line_request(s4Valid, s4Keyed4h, s4CurrentVisible)
// Keep this reserve stable so enabling the NY slot cannot trim ordinary-slot history.
int nyBlockCurrentLineReserve = current_line_request(true, true, fibLinesPerZone)
int forecastLineReserve = forecastZoneCount * 4
int currentLineReserve = ordinaryCurrentLineReserve + nyBlockCurrentLineReserve + forecastLineReserve
int availableHistoryLines = math.max(0, INDICATOR_MAX_LINES - currentLineReserve)

// Standard charts convert bar offsets to time; Range charts use the offsets directly.
int chartBarMs = chart.is_range ? 0 : int(timeframe.in_seconds(timeframe.period) * MS_PER_SEC)
int currentLabelReserve = (s1BudgetVisible ? s1LabelsPerZone : 0) + (s2BudgetVisible ? s2LabelsPerZone : 0) + (s3BudgetVisible ? s3LabelsPerZone : 0) + (s4BudgetVisible ? s4LabelsPerZone : 0) + (nyBlockValid ? nyBlockLabelsPerZone : 0)
int availableHistoryLabels = math.max(0, INDICATOR_MAX_LABELS - currentLabelReserve)
array<int> historyLabelsPerZone = array.from(s1LabelsPerZone, s2LabelsPerZone, s3LabelsPerZone, s4LabelsPerZone, nyBlockLabelsPerZone)
array<bool> historyLabelSlots = array.from((fibLabelHistory or s1Keyed4h) and fibLabel1On, (fibLabelHistory or s2Keyed4h) and fibLabel2On, (fibLabelHistory or s3Keyed4h) and fibLabel3On, (fibLabelHistory or s4Keyed4h) and fibLabel4On, fibLabelHistory and fibLabelNyBlockOn)
array<int> fibHistoryZoneRequests = array.from(math.min(s1FibHistoryZoneRequest, s1RetainedHistoryZoneCap), math.min(s2FibHistoryZoneRequest, s2RetainedHistoryZoneCap), math.min(s3FibHistoryZoneRequest, s3RetainedHistoryZoneCap), math.min(s4FibHistoryZoneRequest, s4RetainedHistoryZoneCap), math.min(nyBlockFibHistoryZoneRequest, nyBlockRetainedHistoryZoneCap))
array<bool> lineBudgetFibs = array.from(slot1Fib, slot2Fib, slot3Fib, slot4Fib, nyBlockFib)
[fibHistCaps, histFibLabelCaps] = allocate_history_fib_caps(availableHistoryLines, availableHistoryLabels, historyBudgetValids, fibHistoryZoneRequests, lineBudgetFibs, historyLabelSlots, historyLabelsPerZone, ORDINARY_SLOT_COUNT, fibLinesPerZone, KEY_4H_HISTORY_ZONE_MAX)
int s1FibHistCap = array.get(fibHistCaps, 0)
int s2FibHistCap = array.get(fibHistCaps, 1)
int s3FibHistCap = array.get(fibHistCaps, 2)
int s4FibHistCap = array.get(fibHistCaps, 3)
int nyBlockFibHistCap = array.get(fibHistCaps, 4)
int s1HistFibLabelCap = array.get(histFibLabelCaps, 0)
int s2HistFibLabelCap = array.get(histFibLabelCaps, 1)
int s3HistFibLabelCap = array.get(histFibLabelCaps, 2)
int s4HistFibLabelCap = array.get(histFibLabelCaps, 3)
int nyBlockHistFibLabelCap = array.get(histFibLabelCaps, 4)

update_slot(slot1, s1Valid, s1Trans, s1ArchivePrevious, s1Keyed4h, s1CurrentHistoryKey, s1PreviousHistoryKey, s1StartT, s1StartIndex, false, s1CurRightT, bar_index, s1OEff, s1ArchivedRunHigh, s1ArchivedRunLow, slot1Color, s1Label, s1MedHO, s1MeanHO, s1MedOL, s1MeanOL, s1BoxHistZoneCap, SLOT1_LABEL_SIZE, slot1Fib, SLOT1_FIB_FADE, fibLinesPerZone, s1FibHistCap, (fibLabelHistory or s1Keyed4h) and fibLabel1On, s1HistFibLabelCap, s1LabelsPerZone, get_label_size(fibLabelSize1), fibLabelPos1, fibLabelOff1 * chartBarMs, fibLabelOff1)
update_slot(slot2, s2Valid, s2Trans, s2ArchivePrevious, s2Keyed4h, s2CurrentHistoryKey, s2PreviousHistoryKey, s2StartT, s2StartIndex, false, s2CurRightT, bar_index, s2OEff, s2ArchivedRunHigh, s2ArchivedRunLow, slot2Color, s2Label, s2MedHO, s2MeanHO, s2MedOL, s2MeanOL, s2BoxHistZoneCap, SLOT2_LABEL_SIZE, slot2Fib, SLOT2_FIB_FADE, fibLinesPerZone, s2FibHistCap, (fibLabelHistory or s2Keyed4h) and fibLabel2On, s2HistFibLabelCap, s2LabelsPerZone, get_label_size(fibLabelSize2), fibLabelPos2, fibLabelOff2 * chartBarMs, fibLabelOff2)
update_slot(slot3, s3Valid, s3Trans, s3ArchivePrevious, s3Keyed4h, s3CurrentHistoryKey, s3PreviousHistoryKey, s3StartT, s3StartIndex, false, s3CurRightT, bar_index, s3OEff, s3ArchivedRunHigh, s3ArchivedRunLow, slot3Color, s3Label, s3MedHO, s3MeanHO, s3MedOL, s3MeanOL, s3BoxHistZoneCap, SLOT3_LABEL_SIZE, slot3Fib, SLOT3_FIB_FADE, fibLinesPerZone, s3FibHistCap, (fibLabelHistory or s3Keyed4h) and fibLabel3On, s3HistFibLabelCap, s3LabelsPerZone, get_label_size(fibLabelSize3), fibLabelPos3, fibLabelOff3 * chartBarMs, fibLabelOff3)
update_slot(slot4, s4Valid, s4Trans, s4ArchivePrevious, s4Keyed4h, s4CurrentHistoryKey, s4PreviousHistoryKey, s4StartT, s4StartIndex, false, s4CurRightT, bar_index, s4OEff, s4ArchivedRunHigh, s4ArchivedRunLow, slot4Color, s4Label, s4MedHO, s4MeanHO, s4MedOL, s4MeanOL, s4BoxHistZoneCap, SLOT4_LABEL_SIZE, slot4Fib, SLOT4_FIB_FADE, fibLinesPerZone, s4FibHistCap, (fibLabelHistory or s4Keyed4h) and fibLabel4On, s4HistFibLabelCap, s4LabelsPerZone, get_label_size(fibLabelSize4), fibLabelPos4, fibLabelOff4 * chartBarMs, fibLabelOff4)
update_slot(nyBlockSlot, nyBlockValid, nyBlockTransition, true, false, na, na, nyBlockStartT, nyBlockStartIndex, true, nyBlockEndT, nyBlockEndIndex, nyBlockO, nyBlockEffectiveRunHigh[1], nyBlockEffectiveRunLow[1], nyBlockColor, "NY AM", nyBlockMedHO, nyBlockMeanHO, nyBlockMedOL, nyBlockMeanOL, nyBlockBoxHistZoneCap, NY_BLOCK_LABEL_SIZE, nyBlockFib, NY_BLOCK_FIB_FADE, fibLinesPerZone, nyBlockFibHistCap, fibLabelHistory and fibLabelNyBlockOn, nyBlockHistFibLabelCap, nyBlockLabelsPerZone, get_label_size(fibLabelSizeNyBlock), fibLabelPosNyBlock, fibLabelOffNyBlock * chartBarMs, fibLabelOffNyBlock)

int currentRightIndex = chart.is_range ? bar_index + 1 : bar_index
int nyBlockRightIndex = not na(nyBlockEndIndex) ? nyBlockEndIndex : currentRightIndex

if barstate.islast
    draw_slot_current(slot1, s1CurrentVisible, s1Keyed4h, s1StartT, s1StartIndex, s1CurRightT, currentRightIndex, s1OEff, s1RHi, s1RLo, slot1Color, s1IdentifierText, s1Label, s1MedHO, s1MeanHO, s1MedOL, s1MeanOL, SLOT1_LABEL_SIZE, slot1Fib, SLOT1_FIB_FADE, fibLabel1On, get_label_size(fibLabelSize1), fibLabelPos1, fibLabelOff1 * chartBarMs, fibLabelOff1)
    draw_slot_current(slot2, s2CurrentVisible, s2Keyed4h, s2StartT, s2StartIndex, s2CurRightT, currentRightIndex, s2OEff, s2RHi, s2RLo, slot2Color, s2IdentifierText, s2Label, s2MedHO, s2MeanHO, s2MedOL, s2MeanOL, SLOT2_LABEL_SIZE, slot2Fib, SLOT2_FIB_FADE, fibLabel2On, get_label_size(fibLabelSize2), fibLabelPos2, fibLabelOff2 * chartBarMs, fibLabelOff2)
    draw_slot_current(slot3, s3CurrentVisible, s3Keyed4h, s3StartT, s3StartIndex, s3CurRightT, currentRightIndex, s3OEff, s3RHi, s3RLo, slot3Color, s3IdentifierText, s3Label, s3MedHO, s3MeanHO, s3MedOL, s3MeanOL, SLOT3_LABEL_SIZE, slot3Fib, SLOT3_FIB_FADE, fibLabel3On, get_label_size(fibLabelSize3), fibLabelPos3, fibLabelOff3 * chartBarMs, fibLabelOff3)
    draw_slot_current(slot4, s4CurrentVisible, s4Keyed4h, s4StartT, s4StartIndex, s4CurRightT, currentRightIndex, s4OEff, s4RHi, s4RLo, slot4Color, s4IdentifierText, s4Label, s4MedHO, s4MeanHO, s4MedOL, s4MeanOL, SLOT4_LABEL_SIZE, slot4Fib, SLOT4_FIB_FADE, fibLabel4On, get_label_size(fibLabelSize4), fibLabelPos4, fibLabelOff4 * chartBarMs, fibLabelOff4)
    draw_slot_current(nyBlockSlot, nyBlockValid, false, nyBlockStartT, nyBlockStartIndex, nyBlockEndT, nyBlockRightIndex, nyBlockO, nyBlockEffectiveRunHigh, nyBlockEffectiveRunLow, nyBlockColor, nyBlockIdentifierText, "NY AM", nyBlockMedHO, nyBlockMeanHO, nyBlockMedOL, nyBlockMeanOL, NY_BLOCK_LABEL_SIZE, nyBlockFib, NY_BLOCK_FIB_FADE, fibLabelNyBlockOn, get_label_size(fibLabelSizeNyBlock), fibLabelPosNyBlock, fibLabelOffNyBlock * chartBarMs, fibLabelOffNyBlock)
    draw_slot_forecast(slot1, s1ForecastVisible, s1CurRightT, currentRightIndex, s1CurRightT + timeframe.in_seconds(s1Safe) * MS_PER_SEC, currentRightIndex, s1OEff, s1RHi, s1RLo, slot1Color, s1IdentifierText, SLOT1_LABEL_SIZE, s1MedHO, s1MeanHO, s1MedOL, s1MeanOL)
    draw_slot_forecast(slot2, s2ForecastVisible, s2CurRightT, currentRightIndex, s2CurRightT + timeframe.in_seconds(s2Safe) * MS_PER_SEC, currentRightIndex, s2OEff, s2RHi, s2RLo, slot2Color, s2IdentifierText, SLOT2_LABEL_SIZE, s2MedHO, s2MeanHO, s2MedOL, s2MeanOL)
    draw_slot_forecast(slot3, s3ForecastVisible, s3CurRightT, currentRightIndex, s3CurRightT + timeframe.in_seconds(s3Safe) * MS_PER_SEC, currentRightIndex, s3OEff, s3RHi, s3RLo, slot3Color, s3IdentifierText, SLOT3_LABEL_SIZE, s3MedHO, s3MeanHO, s3MedOL, s3MeanOL)
    draw_slot_forecast(slot4, s4ForecastVisible, s4CurRightT, currentRightIndex, s4CurRightT + timeframe.in_seconds(s4Safe) * MS_PER_SEC, currentRightIndex, s4OEff, s4RHi, s4RLo, slot4Color, s4IdentifierText, SLOT4_LABEL_SIZE, s4MedHO, s4MeanHO, s4MedOL, s4MeanOL)
    draw_slot_forecast(nyBlockSlot, nyBlockForecastVisible, nyBlockForecastStartT, currentRightIndex, nyBlockForecastEndT, currentRightIndex, nyBlockO, nyBlockEffectiveRunHigh, nyBlockEffectiveRunLow, nyBlockColor, nyBlockIdentifierText, NY_BLOCK_LABEL_SIZE, nyBlockMedHO, nyBlockMeanHO, nyBlockMedOL, nyBlockMeanOL)

showOnlyTimeframeAllowed = chart.is_range or timeframe.in_seconds(timeframe.period) <= SHOW_ONLY_MAX_TIMEFRAME_SECONDS
activeShowOnlySession = visibleWindow == WINDOW_LABEL_FROM_0500 ? SESSION_WINDOW_FROM_0500 : visibleWindow == WINDOW_LABEL_FROM_0830 ? SESSION_WINDOW_FROM_0830 : visibleWindow == WINDOW_LABEL_RTH ? SESSION_WINDOW_RTH : SESSION_WINDOW_OVERNIGHT
showOnlyInVisibleWindow = not na(time(timeframe.period, activeShowOnlySession, NY_TIMEZONE))
bool showOnlyInMostRecentDay = true
if showOnlyMostRecent
    showOnlyInMostRecentDay := year(time, NY_TIMEZONE) == year(timenow, NY_TIMEZONE) and month(time, NY_TIMEZONE) == month(timenow, NY_TIMEZONE) and dayofmonth(time, NY_TIMEZONE) == dayofmonth(timenow, NY_TIMEZONE)
hideThisBar = showOnlyEnabled and showOnlyTimeframeAllowed and not (showOnlyInVisibleWindow and (not showOnlyMostRecent or showOnlyInMostRecentDay))

plotcandle(hideThisBar ? open : na, high, low, close, title="Hidden Candles", color=hiddenCandleColor, bordercolor=hiddenCandleColor, wickcolor=hiddenCandleColor, editable=false, display=display.pane, force_overlay=true)

// COLOR REFERENCE TABLE

addRow(table tbl, int row, string name, color clr) =>
    table.cell(tbl, 0, row, name, text_size=size.small, text_color=color.black)
    table.cell(tbl, 1, row, str.format("R:{0} G:{1} B:{2}", int(color.r(clr)), int(color.g(clr)), int(color.b(clr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 2, row, str.tostring(int(color.t(clr))), text_size=size.small, text_color=color.black)

if showTable and barstate.islast
    var table colorTable = table.new(position.top_right, 3, 16, bgcolor=color.white, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)
    table.cell(colorTable, 0, 0, "Setting", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 1, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 2, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    int row = 1
    addRow(colorTable, row, "Slot 1", slot1Color)
    row += 1
    addRow(colorTable, row, "Slot 2", slot2Color)
    row += 1
    addRow(colorTable, row, "Slot 3", slot3Color)
    row += 1
    addRow(colorTable, row, "Slot 4", slot4Color)
    row += 1
    addRow(colorTable, row, "NY AM", nyBlockColor)
    row += 1

    bool anyFib = slot1Fib or slot2Fib or slot3Fib or slot4Fib or nyBlockFib
    if anyFib
        if showFib100
            addRow(colorTable, row, "Fib 1.0", fibColor100)
            row += 1
        if showFib786
            addRow(colorTable, row, "Fib 0.786", fibColor786)
            row += 1
        if showFib705
            addRow(colorTable, row, "Fib 0.705", fibColor705)
            row += 1
        if showFib618
            addRow(colorTable, row, "Fib 0.618", fibColor618)
            row += 1
        if showFib50
            addRow(colorTable, row, "Fib 0.5", fibColor50)
            row += 1
        if showFib382
            addRow(colorTable, row, "Fib 0.382", fibColor382)
            row += 1
        if showFib295
            addRow(colorTable, row, "Fib 0.295", fibColor295)
            row += 1
        if showFib214
            addRow(colorTable, row, "Fib 0.214", fibColor214)
            row += 1
        if showFib0
            addRow(colorTable, row, "Fib 0", fibColor0)
            row += 1

    if showOnlyEnabled and showOnlyTimeframeAllowed
        addRow(colorTable, row, "Hidden Candles", hiddenCandleColor)
        row += 1

// parallax •
