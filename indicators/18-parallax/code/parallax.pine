nyEarlyHistory  = input.int(SLOT_HISTORY_DEFAULT, "", inline="ny_early", group=GROUP_INTRADAY_PROFILES, minval=SLOT_HISTORY_MIN, maxval=SLOT_HISTORY_MAX, active=nyEarlyShow)
nyEarlyFibPreset = input.string(FIB_PRESET_DEFAULT, SLOT_LABEL_FIB, inline="ny_early", group=GROUP_INTRADAY_PROFILES, active=nyEarlyShow, options=[FIB_PRESET_OFF, FIB_PRESET_DEFAULT, FIB_PRESET_ALTERNATIVE], tooltip=NY_EARLY_SLOT_TOOLTIP)

nyAmShow     = input.bool(false, NY_AM_SLOT_NAME, inline="ny_am", group=GROUP_INTRADAY_PROFILES)
nyAmColor    = input.color(NY_AM_COLOR, "", inline="ny_am", group=GROUP_INTRADAY_PROFILES, active=nyAmShow)
nyAmHistory  = input.int(SLOT_HISTORY_DEFAULT, "", inline="ny_am", group=GROUP_INTRADAY_PROFILES, minval=SLOT_HISTORY_MIN, maxval=SLOT_HISTORY_MAX, active=nyAmShow)
nyAmFibPreset = input.string(FIB_PRESET_DEFAULT, SLOT_LABEL_FIB, inline="ny_am", group=GROUP_INTRADAY_PROFILES, active=nyAmShow, options=[FIB_PRESET_OFF, FIB_PRESET_DEFAULT, FIB_PRESET_ALTERNATIVE], tooltip=NY_AM_SLOT_TOOLTIP)

nyPmShow     = input.bool(false, NY_PM_SLOT_NAME, inline="ny_pm", group=GROUP_INTRADAY_PROFILES)
nyPmColor    = input.color(NY_PM_COLOR, "", inline="ny_pm", group=GROUP_INTRADAY_PROFILES, active=nyPmShow)
nyPmHistory  = input.int(SLOT_HISTORY_DEFAULT, "", inline="ny_pm", group=GROUP_INTRADAY_PROFILES, minval=SLOT_HISTORY_MIN, maxval=SLOT_HISTORY_MAX, active=nyPmShow)
nyPmFibPreset = input.string(FIB_PRESET_DEFAULT, SLOT_LABEL_FIB, inline="ny_pm", group=GROUP_INTRADAY_PROFILES, active=nyPmShow, options=[FIB_PRESET_OFF, FIB_PRESET_DEFAULT, FIB_PRESET_ALTERNATIVE], tooltip=NY_PM_SLOT_TOOLTIP)

ivbShow     = input.bool(false, IVB_SLOT_NAME, inline="ivb", group=GROUP_INTRADAY_PROFILES)
ivbColor    = input.color(IVB_COLOR, "", inline="ivb", group=GROUP_INTRADAY_PROFILES, active=ivbShow)
ivbHistory  = input.int(SLOT_HISTORY_DEFAULT, "", inline="ivb", group=GROUP_INTRADAY_PROFILES, minval=SLOT_HISTORY_MIN, maxval=SLOT_HISTORY_MAX, active=ivbShow)
ivbFibPreset = input.string(FIB_PRESET_DEFAULT, SLOT_LABEL_FIB, inline="ivb", group=GROUP_INTRADAY_PROFILES, active=ivbShow, options=[FIB_PRESET_OFF, FIB_PRESET_DEFAULT, FIB_PRESET_ALTERNATIVE], tooltip=IVB_SLOT_TOOLTIP)

ivbPlusShow     = input.bool(false, IVB_PLUS_SLOT_NAME, inline="ivb_plus", group=GROUP_INTRADAY_PROFILES)
ivbPlusColor    = input.color(IVB_PLUS_COLOR, "", inline="ivb_plus", group=GROUP_INTRADAY_PROFILES, active=ivbPlusShow)
ivbPlusHistory  = input.int(SLOT_HISTORY_DEFAULT, "", inline="ivb_plus", group=GROUP_INTRADAY_PROFILES, minval=SLOT_HISTORY_MIN, maxval=SLOT_HISTORY_MAX, active=ivbPlusShow)
ivbPlusFibPreset = input.string(FIB_PRESET_DEFAULT, SLOT_LABEL_FIB, inline="ivb_plus", group=GROUP_INTRADAY_PROFILES, active=ivbPlusShow, options=[FIB_PRESET_OFF, FIB_PRESET_DEFAULT, FIB_PRESET_ALTERNATIVE], tooltip=IVB_PLUS_SLOT_TOOLTIP)

bool fibInputsActive = (slot1Show and slot1FibPreset != FIB_PRESET_OFF) or (slot2Show and slot2FibPreset != FIB_PRESET_OFF) or (weeklyProfileShow and weeklyProfileFibPreset != FIB_PRESET_OFF) or (monthlyProfileShow and monthlyProfileFibPreset != FIB_PRESET_OFF) or (dailyProfileShow and dailyProfileFibPreset != FIB_PRESET_OFF) or (overnightShow and overnightFibPreset != FIB_PRESET_OFF) or (nyEarlyShow and nyEarlyFibPreset != FIB_PRESET_OFF) or (nyAmShow and nyAmFibPreset != FIB_PRESET_OFF) or (nyPmShow and nyPmFibPreset != FIB_PRESET_OFF) or (ivbShow and ivbFibPreset != FIB_PRESET_OFF) or (ivbPlusShow and ivbPlusFibPreset != FIB_PRESET_OFF)

// LIQUIDITY DEPTH

forecastLiquidityDepth = input.bool(false, "Forecast LD", inline="liquidity_depth_options", group=GROUP_LIQUIDITY_DEPTH)
showLiquidityDepthProfileNames = input.bool(true, "Profile Names on LD", inline="liquidity_depth_options", group=GROUP_LIQUIDITY_DEPTH)
matchLiquidityDepthProfileColor = input.bool(true, "Match LD to Profile Color", group=GROUP_LIQUIDITY_DEPTH, tooltip="L1–L3 use their parent profile's color, including forecast LD.")
dailyLiquidityDepth = input.bool(false, DAILY_PROFILE_NAME, group=GROUP_LIQUIDITY_DEPTH, active=dailyProfileShow)
overnightLiquidityDepth = input.bool(true, OVERNIGHT_SLOT_NAME, inline="liquidity_depth_profiles", group=GROUP_LIQUIDITY_DEPTH, active=overnightShow)
nyEarlyLiquidityDepth = input.bool(true, NY_EARLY_SLOT_NAME, inline="liquidity_depth_profiles", group=GROUP_LIQUIDITY_DEPTH, active=nyEarlyShow)
