forecastDaily = input.bool(true, DAILY_PROFILE_NAME, inline="forecast_slots", group=GROUP_FORECAST, active=showNextRangeForecast and dailyProfileShow, tooltip=FORECAST_SLOT_TOOLTIP)
forecastOvernight = input.bool(true, OVERNIGHT_SLOT_NAME, inline="forecast_intraday_profiles", group=GROUP_FORECAST, active=showNextRangeForecast and overnightShow)
