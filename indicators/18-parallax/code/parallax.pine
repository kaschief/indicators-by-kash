int sessionSourceSeconds = timeframe.in_seconds(SESSION_SOURCE_TIMEFRAME)
int fibHistory = fibHistoryInput == FIB_HISTORY_OFF ? 0 : int(str.tonumber(fibHistoryInput))
var FibLevelSet disabledFibLevelSet = make_fib_level_set(FIB_WIDTH_OFF, FIB_WIDTH_OFF, FIB_WIDTH_OFF, FIB_WIDTH_OFF, FIB_WIDTH_OFF, FIB_WIDTH_OFF, FIB_WIDTH_OFF, FIB_WIDTH_OFF, FIB_WIDTH_OFF)
var FibLevelSet defaultFibLevelSet = make_fib_level_set(fibDefault100, fibDefault786, fibDefault705, fibDefault618, fibDefault50, fibDefault382, fibDefault295, fibDefault214, fibDefault0)
var FibLevelSet alternativeFibLevelSet = make_fib_level_set(fibAlternative100, fibAlternative786, fibAlternative705, fibAlternative618, fibAlternative50, fibAlternative382, fibAlternative295, fibAlternative214, fibAlternative0)
var FibPalette fibPalette = FibPalette.new(
     ratios=array.from(FIB_LEVEL_100, FIB_LEVEL_786, FIB_LEVEL_705, FIB_LEVEL_618, FIB_LEVEL_50, FIB_LEVEL_382, FIB_LEVEL_295, FIB_LEVEL_214, FIB_LEVEL_0),
     ratioTexts=array.from("1.0", "0.786", "0.705", "0.618", "0.5", "0.382", "0.295", "0.214", "0"),
     levelColors=array.from(fibColor100, fibColor786, fibColor705, fibColor618, fibColor50, fibColor382, fibColor295, fibColor214, fibColor0),
     keyLevels=array.from(fibKey100, fibKey786, fibKey705, fibKey618, fibKey50, fibKey382, fibKey295, fibKey214, fibKey0))
var FibLevelSet slot1FibLevelSet = resolve_fib_level_set(slot1FibPreset, disabledFibLevelSet, defaultFibLevelSet, alternativeFibLevelSet)
var FibLevelSet slot2FibLevelSet = resolve_fib_level_set(slot2FibPreset, disabledFibLevelSet, defaultFibLevelSet, alternativeFibLevelSet)
var FibLevelSet weeklyProfileFibLevelSet = resolve_fib_level_set(weeklyProfileFibPreset, disabledFibLevelSet, defaultFibLevelSet, alternativeFibLevelSet)
var FibLevelSet monthlyProfileFibLevelSet = resolve_fib_level_set(monthlyProfileFibPreset, disabledFibLevelSet, defaultFibLevelSet, alternativeFibLevelSet)
var FibLevelSet dailyProfileFibLevelSet = resolve_fib_level_set(dailyProfileFibPreset, disabledFibLevelSet, defaultFibLevelSet, alternativeFibLevelSet)
var FibLevelSet overnightFibLevelSet = resolve_fib_level_set(overnightFibPreset, disabledFibLevelSet, defaultFibLevelSet, alternativeFibLevelSet)
var FibLevelSet nyEarlyFibLevelSet = resolve_fib_level_set(nyEarlyFibPreset, disabledFibLevelSet, defaultFibLevelSet, alternativeFibLevelSet)
var FibLevelSet nyAmFibLevelSet = resolve_fib_level_set(nyAmFibPreset, disabledFibLevelSet, defaultFibLevelSet, alternativeFibLevelSet)
var FibLevelSet ivbFibLevelSet = resolve_fib_level_set(ivbFibPreset, disabledFibLevelSet, defaultFibLevelSet, alternativeFibLevelSet)
var FibLevelSet ivbPlusFibLevelSet = resolve_fib_level_set(ivbPlusFibPreset, disabledFibLevelSet, defaultFibLevelSet, alternativeFibLevelSet)
bool isKnown247Asset = syminfo.type == "crypto"
bool isKnownTraditionalAsset = syminfo.type == "futures" or syminfo.type == "forex" or syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "dr" or syminfo.type == "index" or syminfo.type == "option" or syminfo.type == "commodity" or syminfo.type == "bond" or syminfo.type == "spread"
var bool isTwentyFourSevenAsset = isKnown247Asset or not isKnownTraditionalAsset
var bool assetClassificationReady = isKnown247Asset or isKnownTraditionalAsset
var int assetObservationStartTime = na
if not assetClassificationReady
    if na(assetObservationStartTime)
        assetObservationStartTime := time
    int currentNyDay = dayofweek(time, NY_TIMEZONE)
    bool trueWeekendBar = currentNyDay == dayofweek.saturday or currentNyDay == dayofweek.sunday and hour(time, NY_TIMEZONE) < 18
    if trueWeekendBar
        isTwentyFourSevenAsset := true
        assetClassificationReady := true
    else if time - assetObservationStartTime >= SECS_WEEK * MS_PER_SEC
        isTwentyFourSevenAsset := false
        assetClassificationReady := true
int dailyProfileStartMinute = useMidnight ? MIDNIGHT_START_MINUTE : GLOBEX_START_MINUTE
string dailyProfileLabel = useMidnight ? MIDNIGHT_CHART_LABEL : GLOBEX_CHART_LABEL
string effectiveDailySchedule = isTwentyFourSevenAsset ? SCHEDULED_PROFILE_SCHEDULE_ALL_DAYS : useMidnight ? SCHEDULED_PROFILE_SCHEDULE_WEEKDAYS : SCHEDULED_PROFILE_SCHEDULE_GLOBEX
bool intradayLiquidityDepthTimeframeAllowed = chart.is_range or timeframe.in_seconds(timeframe.period) <= INTRADAY_LIQUIDITY_DEPTH_MAX_TIMEFRAME

// LIQUIDITY DEPTH ASSETS

var array<AssetFamily> assetFamilies = array.new<AssetFamily>()
if barstate.isfirst
    array.push(assetFamilies, AssetFamily.new(array.from("NQ", "MNQ"), 27))
    array.push(assetFamilies, AssetFamily.new(array.from("ES", "MES"), 9))
    array.push(assetFamilies, AssetFamily.new(array.from("YM", "MYM"), 27))
    array.push(assetFamilies, AssetFamily.new(array.from("RTY", "M2K"), 4))
    array.push(assetFamilies, AssetFamily.new(array.from("GC", "MGC"), 3))
    array.push(assetFamilies, AssetFamily.new(array.from("CL", "MCL", "QM"), 0.125))
    array.push(assetFamilies, AssetFamily.new(array.from("BTC", "MBT"), 100))
    array.push(assetFamilies, AssetFamily.new(array.from("ETH", "MET"), 10))

symbol_matches_asset_family(string symbolRoot, array<string> identifiers) =>
    bool matched = false
    for identifier in identifiers
        if str.contains(symbolRoot, identifier)
            matched := true
            break
    matched

find_asset_family() =>
    string symbolRoot = syminfo.root != "" ? syminfo.root : syminfo.ticker
    AssetFamily matchedAssetFamily = na
    for assetFamily in assetFamilies
        if symbol_matches_asset_family(symbolRoot, assetFamily.identifiers)
            matchedAssetFamily := assetFamily
            break
    matchedAssetFamily

var AssetFamily cachedAssetFamily = na
if barstate.isfirst
    cachedAssetFamily := find_asset_family()

get_daily_liquidity_depth_distance() =>
    na(cachedAssetFamily) ? 0.0 : cachedAssetFamily.dailyLiquidityDepthDistance

float dailyLiquidityDepthDistance = get_daily_liquidity_depth_distance()
bool liquidityDepthAssetSupported = dailyLiquidityDepthDistance > 0

// SCHEDULED PROFILE CONFIGURATION

