var ScheduledProfile ivbPlusScheduledProfile = ScheduledProfile.new(config=ivbPlusConfig, runtimeState=ivbPlusRuntime, drawingState=ivbPlusSlot, identifierText=ivbPlusIdentifierText)
array<ScheduledProfile> scheduledProfiles = array.from(dailyScheduledProfile, overnightScheduledProfile, nyEarlyScheduledProfile, nyAmScheduledProfile, ivbScheduledProfile, ivbPlusScheduledProfile)

int fibLinesPerZone = (showFib100 ? 1 : 0) + (showFib786 ? 1 : 0) + (showFib705 ? 1 : 0) + (showFib618 ? 1 : 0) + (showFib50 ? 1 : 0) + (showFib382 ? 1 : 0) + (showFib295 ? 1 : 0) + (showFib214 ? 1 : 0) + (showFib0 ? 1 : 0)
bool fibLabelsOn = fibLabelLevels != FL_OFF
bool fibKeyLabelsOnly = fibLabelLevels == FL_KEY
int fibLabelsPerSide = fibLabelsOn ? ((showFib100 and (not fibKeyLabelsOnly or fibKey100) ? 1 : 0) + (showFib786 and (not fibKeyLabelsOnly or fibKey786) ? 1 : 0) + (showFib705 and (not fibKeyLabelsOnly or fibKey705) ? 1 : 0) + (showFib618 and (not fibKeyLabelsOnly or fibKey618) ? 1 : 0) + (showFib50 and (not fibKeyLabelsOnly or fibKey50) ? 1 : 0) + (showFib382 and (not fibKeyLabelsOnly or fibKey382) ? 1 : 0) + (showFib295 and (not fibKeyLabelsOnly or fibKey295) ? 1 : 0) + (showFib214 and (not fibKeyLabelsOnly or fibKey214) ? 1 : 0) + (showFib0 and (not fibKeyLabelsOnly or fibKey0) ? 1 : 0)) : 0
bool fibLabel1On = fibLabelsOn and fibLabelSlot1
bool fibLabel2On = fibLabelsOn and fibLabelSlot2
bool fibLabel3On = fibLabelsOn and fibLabelSlot3
bool fibLabel4On = fibLabelsOn and fibLabelSlot4
int s1LabelsPerZone = slot1Fib and fibLabel1On ? fibLabelsPerSide * (fibLabelPos1 == POS_BOTH ? 2 : 1) : 0
int s2LabelsPerZone = slot2Fib and fibLabel2On ? fibLabelsPerSide * (fibLabelPos2 == POS_BOTH ? 2 : 1) : 0
int s3LabelsPerZone = slot3Fib and fibLabel3On ? fibLabelsPerSide * (fibLabelPos3 == POS_BOTH ? 2 : 1) : 0
int s4LabelsPerZone = slot4Fib and fibLabel4On ? fibLabelsPerSide * (fibLabelPos4 == POS_BOTH ? 2 : 1) : 0

int s1HistoryZoneRequest = history_zone_request(latestOnly, slot1History)
int s2HistoryZoneRequest = history_zone_request(latestOnly, slot2History)
int s3HistoryZoneRequest = history_zone_request(latestOnly, slot3History)
int s4HistoryZoneRequest = history_zone_request(latestOnly, slot4History)
int s1FibHistoryZoneRequest = fib_history_zone_request(latestOnly, slot1History, fibHistory)
int s2FibHistoryZoneRequest = fib_history_zone_request(latestOnly, slot2History, fibHistory)
int s3FibHistoryZoneRequest = fib_history_zone_request(latestOnly, slot3History, fibHistory)
int s4FibHistoryZoneRequest = fib_history_zone_request(latestOnly, slot4History, fibHistory)

array<bool> historyBudgetValids = array.from(s1Valid, s2Valid, s3Valid, s4Valid)
array<int> boxHistoryZoneRequests = array.from(s1HistoryZoneRequest, s2HistoryZoneRequest, s3HistoryZoneRequest, s4HistoryZoneRequest)
array<int> scheduledProfileHistoryRequests = array.new<int>()
array<int> scheduledProfileLabelsPerZone = array.new<int>()

int currentBoxZoneCount = (s1BudgetVisible ? 1 : 0) + (s2BudgetVisible ? 1 : 0) + (s3BudgetVisible ? 1 : 0) + (s4BudgetVisible ? 1 : 0)
int forecastZoneCount = (s1ForecastVisible ? 1 : 0) + (s2ForecastVisible ? 1 : 0) + (s3ForecastVisible ? 1 : 0) + (s4ForecastVisible ? 1 : 0)
// Stable worst-case reserves prevent scheduled profile toggles from trimming ordinary history.
int scheduledProfileCurrentLineReserve = 0
int scheduledProfileCurrentLabelReserve = 0
for profileIndex = 0 to array.size(scheduledProfiles) - 1
    ScheduledProfile profile = array.get(scheduledProfiles, profileIndex)
    ScheduledProfileConfig profileConfig = profile.config
    ScheduledProfileRuntime profileRuntime = profile.runtimeState
    int historyRequest = latestOnly ? 0 : profileConfig.historyLimit - 1
    bool labelEnabled = fibLabelsOn and profileConfig.fibLabelsEnabled
    int labelsPerZone = profileConfig.fibEnabled and labelEnabled ? fibLabelsPerSide * (profileConfig.fibLabelPosition == POS_BOTH ? 2 : 1) : 0
    array.push(scheduledProfileHistoryRequests, historyRequest)
    array.push(scheduledProfileLabelsPerZone, labelsPerZone)
    array.push(historyBudgetValids, profileRuntime.valid)
    array.push(boxHistoryZoneRequests, historyRequest)
    currentBoxZoneCount += profileRuntime.valid ? 1 : 0
    forecastZoneCount += profileRuntime.forecastVisible ? 1 : 0
    scheduledProfileCurrentLineReserve += current_line_request(true, true, fibLinesPerZone)
    scheduledProfileCurrentLabelReserve += profileRuntime.valid ? labelsPerZone : 0
int currentBoxReserve = (currentBoxZoneCount + forecastZoneCount) * 2
int availableHistoryBoxZones = int(math.max(0, INDICATOR_MAX_BOXES - currentBoxReserve) / 2)
array<int> boxHistZoneCaps = allocate_history_zone_caps(availableHistoryBoxZones, historyBudgetValids, boxHistoryZoneRequests, ORDINARY_SLOT_COUNT, SLOT_HISTORY_MAX)
int s1BoxHistZoneCap = array.get(boxHistZoneCaps, 0)
int s2BoxHistZoneCap = array.get(boxHistZoneCaps, 1)
int s3BoxHistZoneCap = array.get(boxHistZoneCaps, 2)
int s4BoxHistZoneCap = array.get(boxHistZoneCaps, 3)
int s1RetainedHistoryZoneCap = s1BoxHistZoneCap
int s2RetainedHistoryZoneCap = s2BoxHistZoneCap
int s3RetainedHistoryZoneCap = s3BoxHistZoneCap
int s4RetainedHistoryZoneCap = s4BoxHistZoneCap

int ordinaryCurrentLineReserve = current_line_request(s1BudgetVisible, slot1Fib, fibLinesPerZone) + current_line_request(s2BudgetVisible, slot2Fib, fibLinesPerZone) + current_line_request(s3BudgetVisible, slot3Fib, fibLinesPerZone) + current_line_request(s4BudgetVisible, slot4Fib, fibLinesPerZone)
int forecastLineReserve = forecastZoneCount * 4
int currentLineReserve = ordinaryCurrentLineReserve + scheduledProfileCurrentLineReserve + forecastLineReserve
int availableHistoryLines = math.max(0, INDICATOR_MAX_LINES - currentLineReserve)

// Standard charts convert bar offsets to time; Range charts use the offsets directly.
int chartBarMs = chart.is_range ? 0 : int(timeframe.in_seconds(timeframe.period) * MS_PER_SEC)
int currentLabelReserve = (s1BudgetVisible ? s1LabelsPerZone : 0) + (s2BudgetVisible ? s2LabelsPerZone : 0) + (s3BudgetVisible ? s3LabelsPerZone : 0) + (s4BudgetVisible ? s4LabelsPerZone : 0) + scheduledProfileCurrentLabelReserve
int availableHistoryLabels = math.max(0, INDICATOR_MAX_LABELS - currentLabelReserve)
array<int> historyLabelsPerZone = array.from(s1LabelsPerZone, s2LabelsPerZone, s3LabelsPerZone, s4LabelsPerZone)
array<bool> historyLabelSlots = array.from(fibLabelHistory and fibLabel1On, fibLabelHistory and fibLabel2On, fibLabelHistory and fibLabel3On, fibLabelHistory and fibLabel4On)
array<int> fibHistoryZoneRequests = array.from(math.min(s1FibHistoryZoneRequest, s1RetainedHistoryZoneCap), math.min(s2FibHistoryZoneRequest, s2RetainedHistoryZoneCap), math.min(s3FibHistoryZoneRequest, s3RetainedHistoryZoneCap), math.min(s4FibHistoryZoneRequest, s4RetainedHistoryZoneCap))
array<bool> lineBudgetFibs = array.from(slot1Fib, slot2Fib, slot3Fib, slot4Fib)
for profileIndex = 0 to array.size(scheduledProfiles) - 1
    int budgetIndex = ORDINARY_SLOT_COUNT + profileIndex
    ScheduledProfile profile = array.get(scheduledProfiles, profileIndex)
    ScheduledProfileConfig profileConfig = profile.config
    int historyRequest = array.get(scheduledProfileHistoryRequests, profileIndex)
    int retainedHistory = array.get(boxHistZoneCaps, budgetIndex)
    int fibHistoryRequest = math.min(historyRequest, math.min(math.max(0, profileConfig.historyLimit - 1), fibHistory))
    array.push(historyLabelsPerZone, array.get(scheduledProfileLabelsPerZone, profileIndex))
    array.push(historyLabelSlots, fibLabelHistory and fibLabelsOn and profileConfig.fibLabelsEnabled)
    array.push(fibHistoryZoneRequests, math.min(fibHistoryRequest, retainedHistory))
    array.push(lineBudgetFibs, profileConfig.fibEnabled)
[fibHistCaps, histFibLabelCaps] = allocate_history_fib_caps(availableHistoryLines, availableHistoryLabels, historyBudgetValids, fibHistoryZoneRequests, lineBudgetFibs, historyLabelSlots, historyLabelsPerZone, ORDINARY_SLOT_COUNT, fibLinesPerZone, SLOT_HISTORY_MAX)
int s1FibHistCap = array.get(fibHistCaps, 0)
int s2FibHistCap = array.get(fibHistCaps, 1)
int s3FibHistCap = array.get(fibHistCaps, 2)
int s4FibHistCap = array.get(fibHistCaps, 3)
int s1HistFibLabelCap = array.get(histFibLabelCaps, 0)
int s2HistFibLabelCap = array.get(histFibLabelCaps, 1)
int s3HistFibLabelCap = array.get(histFibLabelCaps, 2)
int s4HistFibLabelCap = array.get(histFibLabelCaps, 3)

update_slot(slot1, s1Valid, s1Trans, s1StartT, s1StartIndex, false, s1CurRightT, bar_index, s1OEff, s1RHi[1], s1RLo[1], slot1Color, s1Label, s1NormMedHO, s1NormMeanHO, s1NormMedOL, s1NormMeanOL, s1BoxHistZoneCap, SLOT1_LABEL_SIZE, SLOT1_FIB_FADE, fibLinesPerZone, s1FibHistCap, fibLabelHistory and fibLabel1On, s1HistFibLabelCap, s1LabelsPerZone, fibLabelSize1, fibLabelPos1, fibLabelOff1 * chartBarMs, fibLabelOff1)
update_slot(slot2, s2Valid, s2Trans, s2StartT, s2StartIndex, false, s2CurRightT, bar_index, s2OEff, s2RHi[1], s2RLo[1], slot2Color, s2Label, s2NormMedHO, s2NormMeanHO, s2NormMedOL, s2NormMeanOL, s2BoxHistZoneCap, SLOT2_LABEL_SIZE, SLOT2_FIB_FADE, fibLinesPerZone, s2FibHistCap, fibLabelHistory and fibLabel2On, s2HistFibLabelCap, s2LabelsPerZone, fibLabelSize2, fibLabelPos2, fibLabelOff2 * chartBarMs, fibLabelOff2)
update_slot(slot3, s3Valid, s3Trans, s3StartT, s3StartIndex, false, s3CurRightT, bar_index, s3OEff, s3RHi[1], s3RLo[1], slot3Color, s3Label, s3NormMedHO, s3NormMeanHO, s3NormMedOL, s3NormMeanOL, s3BoxHistZoneCap, SLOT3_LABEL_SIZE, SLOT3_FIB_FADE, fibLinesPerZone, s3FibHistCap, fibLabelHistory and fibLabel3On, s3HistFibLabelCap, s3LabelsPerZone, fibLabelSize3, fibLabelPos3, fibLabelOff3 * chartBarMs, fibLabelOff3)
update_slot(slot4, s4Valid, s4Trans, s4StartT, s4StartIndex, false, s4CurRightT, bar_index, s4OEff, s4RHi[1], s4RLo[1], slot4Color, s4Label, s4NormMedHO, s4NormMeanHO, s4NormMedOL, s4NormMeanOL, s4BoxHistZoneCap, SLOT4_LABEL_SIZE, SLOT4_FIB_FADE, fibLinesPerZone, s4FibHistCap, fibLabelHistory and fibLabel4On, s4HistFibLabelCap, s4LabelsPerZone, fibLabelSize4, fibLabelPos4, fibLabelOff4 * chartBarMs, fibLabelOff4)

// Each written call keeps independent Pine history for update_slot()'s [1] snapshots.
int dailyProfileBudgetIndex = ORDINARY_SLOT_COUNT + DAILY_PROFILE_INDEX
update_scheduled_profile(dailyProfileSlot, dailyProfileConfig, dailyProfileRuntime,
     array.get(boxHistZoneCaps, dailyProfileBudgetIndex), fibLinesPerZone, array.get(fibHistCaps, dailyProfileBudgetIndex),
     array.get(historyLabelSlots, dailyProfileBudgetIndex), array.get(histFibLabelCaps, dailyProfileBudgetIndex), array.get(historyLabelsPerZone, dailyProfileBudgetIndex),
     dailyProfileConfig.fibLabelOffset * chartBarMs, dailyProfileConfig.fibLabelOffset)

int overnightBudgetIndex = ORDINARY_SLOT_COUNT + OVERNIGHT_PROFILE_INDEX
update_scheduled_profile(overnightSlot, overnightConfig, overnightRuntime,
     array.get(boxHistZoneCaps, overnightBudgetIndex), fibLinesPerZone, array.get(fibHistCaps, overnightBudgetIndex),
     array.get(historyLabelSlots, overnightBudgetIndex), array.get(histFibLabelCaps, overnightBudgetIndex), array.get(historyLabelsPerZone, overnightBudgetIndex),
     overnightConfig.fibLabelOffset * chartBarMs, overnightConfig.fibLabelOffset)

int nyEarlyBudgetIndex = ORDINARY_SLOT_COUNT + NY_EARLY_PROFILE_INDEX
update_scheduled_profile(nyEarlySlot, nyEarlyConfig, nyEarlyRuntime,
     array.get(boxHistZoneCaps, nyEarlyBudgetIndex), fibLinesPerZone, array.get(fibHistCaps, nyEarlyBudgetIndex),
     array.get(historyLabelSlots, nyEarlyBudgetIndex), array.get(histFibLabelCaps, nyEarlyBudgetIndex), array.get(historyLabelsPerZone, nyEarlyBudgetIndex),
     nyEarlyConfig.fibLabelOffset * chartBarMs, nyEarlyConfig.fibLabelOffset)

int nyAmBudgetIndex = ORDINARY_SLOT_COUNT + NY_AM_PROFILE_INDEX
update_scheduled_profile(nyAmSlot, nyAmConfig, nyAmRuntime,
     array.get(boxHistZoneCaps, nyAmBudgetIndex), fibLinesPerZone, array.get(fibHistCaps, nyAmBudgetIndex),
     array.get(historyLabelSlots, nyAmBudgetIndex), array.get(histFibLabelCaps, nyAmBudgetIndex), array.get(historyLabelsPerZone, nyAmBudgetIndex),
     nyAmConfig.fibLabelOffset * chartBarMs, nyAmConfig.fibLabelOffset)

int ivbBudgetIndex = ORDINARY_SLOT_COUNT + IVB_PROFILE_INDEX
update_scheduled_profile(ivbSlot, ivbConfig, ivbRuntime,
     array.get(boxHistZoneCaps, ivbBudgetIndex), fibLinesPerZone, array.get(fibHistCaps, ivbBudgetIndex),
     array.get(historyLabelSlots, ivbBudgetIndex), array.get(histFibLabelCaps, ivbBudgetIndex), array.get(historyLabelsPerZone, ivbBudgetIndex),
     ivbConfig.fibLabelOffset * chartBarMs, ivbConfig.fibLabelOffset)

int ivbPlusBudgetIndex = ORDINARY_SLOT_COUNT + IVB_PLUS_PROFILE_INDEX
update_scheduled_profile(ivbPlusSlot, ivbPlusConfig, ivbPlusRuntime,
     array.get(boxHistZoneCaps, ivbPlusBudgetIndex), fibLinesPerZone, array.get(fibHistCaps, ivbPlusBudgetIndex),
     array.get(historyLabelSlots, ivbPlusBudgetIndex), array.get(histFibLabelCaps, ivbPlusBudgetIndex), array.get(historyLabelsPerZone, ivbPlusBudgetIndex),
     ivbPlusConfig.fibLabelOffset * chartBarMs, ivbPlusConfig.fibLabelOffset)

int currentRightIndex = chart.is_range ? bar_index + 1 : bar_index

if barstate.islast
    draw_slot_current(slot1, s1Valid, s1StartT, s1StartIndex, s1CurRightT, currentRightIndex, s1OEff, s1RHi, s1RLo, slot1Color, s1IdentifierText, s1Label, s1NormMedHO, s1NormMeanHO, s1NormMedOL, s1NormMeanOL, SLOT1_LABEL_SIZE, slot1Fib, SLOT1_FIB_FADE, fibLabel1On, fibLabelSize1, fibLabelPos1, fibLabelOff1 * chartBarMs, fibLabelOff1)
    draw_slot_current(slot2, s2Valid, s2StartT, s2StartIndex, s2CurRightT, currentRightIndex, s2OEff, s2RHi, s2RLo, slot2Color, s2IdentifierText, s2Label, s2NormMedHO, s2NormMeanHO, s2NormMedOL, s2NormMeanOL, SLOT2_LABEL_SIZE, slot2Fib, SLOT2_FIB_FADE, fibLabel2On, fibLabelSize2, fibLabelPos2, fibLabelOff2 * chartBarMs, fibLabelOff2)
    draw_slot_current(slot3, s3Valid, s3StartT, s3StartIndex, s3CurRightT, currentRightIndex, s3OEff, s3RHi, s3RLo, slot3Color, s3IdentifierText, s3Label, s3NormMedHO, s3NormMeanHO, s3NormMedOL, s3NormMeanOL, SLOT3_LABEL_SIZE, slot3Fib, SLOT3_FIB_FADE, fibLabel3On, fibLabelSize3, fibLabelPos3, fibLabelOff3 * chartBarMs, fibLabelOff3)
    draw_slot_current(slot4, s4Valid, s4StartT, s4StartIndex, s4CurRightT, currentRightIndex, s4OEff, s4RHi, s4RLo, slot4Color, s4IdentifierText, s4Label, s4NormMedHO, s4NormMeanHO, s4NormMedOL, s4NormMeanOL, SLOT4_LABEL_SIZE, slot4Fib, SLOT4_FIB_FADE, fibLabel4On, fibLabelSize4, fibLabelPos4, fibLabelOff4 * chartBarMs, fibLabelOff4)
    for profileIndex = 0 to array.size(scheduledProfiles) - 1
        ScheduledProfile profile = array.get(scheduledProfiles, profileIndex)
        ScheduledProfileConfig profileConfig = profile.config
        ScheduledProfileRuntime profileRuntime = profile.runtimeState
        SlotState slotState = profile.drawingState
        bool fibLabelsEnabled = fibLabelsOn and profileConfig.fibLabelsEnabled
        int labelOffsetBars = profileConfig.fibLabelOffset
        draw_scheduled_profile_current(slotState, profileConfig, profileRuntime, profile.identifierText, currentRightIndex,
             fibLabelsEnabled, labelOffsetBars * chartBarMs, labelOffsetBars)
    draw_slot_forecast(slot1, s1ForecastVisible, s1CurRightT, s1CurRightT + timeframe.in_seconds(s1Safe) * MS_PER_SEC, s1OEff, s1RHi, s1RLo, slot1Color, s1ForecastIdentifierText, SLOT1_LABEL_SIZE, s1NormMedHO, s1NormMeanHO, s1NormMedOL, s1NormMeanOL)
    draw_slot_forecast(slot2, s2ForecastVisible, s2CurRightT, s2CurRightT + timeframe.in_seconds(s2Safe) * MS_PER_SEC, s2OEff, s2RHi, s2RLo, slot2Color, s2ForecastIdentifierText, SLOT2_LABEL_SIZE, s2NormMedHO, s2NormMeanHO, s2NormMedOL, s2NormMeanOL)
    draw_slot_forecast(slot3, s3ForecastVisible, s3CurRightT, s3CurRightT + timeframe.in_seconds(s3Safe) * MS_PER_SEC, s3OEff, s3RHi, s3RLo, slot3Color, s3ForecastIdentifierText, SLOT3_LABEL_SIZE, s3NormMedHO, s3NormMeanHO, s3NormMedOL, s3NormMeanOL)
    draw_slot_forecast(slot4, s4ForecastVisible, s4CurRightT, s4CurRightT + timeframe.in_seconds(s4Safe) * MS_PER_SEC, s4OEff, s4RHi, s4RLo, slot4Color, s4ForecastIdentifierText, SLOT4_LABEL_SIZE, s4NormMedHO, s4NormMeanHO, s4NormMedOL, s4NormMeanOL)
    for profileIndex = 0 to array.size(scheduledProfiles) - 1
        ScheduledProfile profile = array.get(scheduledProfiles, profileIndex)
        draw_scheduled_profile_forecast(profile.drawingState, profile.config, profile.runtimeState, profile.identifierText)

showOnlyTimeframeAllowed = chart.is_range or timeframe.in_seconds(timeframe.period) <= SHOW_ONLY_MAX_TIMEFRAME_SECONDS
activeShowOnlySession = visibleWindow == WINDOW_LABEL_FROM_0500 ? SESSION_WINDOW_FROM_0500 : visibleWindow == WINDOW_LABEL_FROM_0830 ? SESSION_WINDOW_FROM_0830 : visibleWindow == WINDOW_LABEL_RTH ? SESSION_WINDOW_RTH : SESSION_WINDOW_OVERNIGHT
showOnlyInVisibleWindow = not na(time(timeframe.period, activeShowOnlySession, NY_TIMEZONE))
bool showOnlyInMostRecentDay = true
if showOnlyMostRecent
    showOnlyInMostRecentDay := year(time, NY_TIMEZONE) == year(timenow, NY_TIMEZONE) and month(time, NY_TIMEZONE) == month(timenow, NY_TIMEZONE) and dayofmonth(time, NY_TIMEZONE) == dayofmonth(timenow, NY_TIMEZONE)
hideThisBar = showOnlyEnabled and showOnlyTimeframeAllowed and not (showOnlyInVisibleWindow and (not showOnlyMostRecent or showOnlyInMostRecentDay))

plotcandle(hideThisBar ? open : na, high, low, close, title="Hidden Candles", color=hiddenCandleColor, bordercolor=hiddenCandleColor, wickcolor=hiddenCandleColor, editable=false, display=display.pane, force_overlay=true)

// COLOR REFERENCE TABLE

addRow(table tbl, int row, string name, color clr) =>
    table.cell(tbl, 0, row, name, text_size=size.small, text_color=color.black)
    table.cell(tbl, 1, row, str.format("R:{0} G:{1} B:{2}", int(color.r(clr)), int(color.g(clr)), int(color.b(clr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 2, row, str.tostring(int(color.t(clr))), text_size=size.small, text_color=color.black)

if showTable and barstate.islast
    int colorTableRowCount = 1 + ORDINARY_SLOT_COUNT + array.size(scheduledProfiles) + 9 + 1
    var table colorTable = table.new(position.top_right, 3, colorTableRowCount, bgcolor=color.white, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)
    table.cell(colorTable, 0, 0, "Setting", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 1, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 2, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    int row = 1
    addRow(colorTable, row, "Slot 1", slot1Color)
    row += 1
    addRow(colorTable, row, "Slot 2", slot2Color)
    row += 1
    addRow(colorTable, row, "Slot 3", slot3Color)
    row += 1
    addRow(colorTable, row, "Slot 4", slot4Color)
    row += 1
    for profileIndex = 0 to array.size(scheduledProfiles) - 1
        ScheduledProfile profile = array.get(scheduledProfiles, profileIndex)
        ScheduledProfileConfig profileConfig = profile.config
        addRow(colorTable, row, profileConfig.sourceLabel, profileConfig.slotColor)
        row += 1

    bool anyFib = slot1Fib or slot2Fib or slot3Fib or slot4Fib
    for profileIndex = 0 to array.size(scheduledProfiles) - 1
        ScheduledProfile profile = array.get(scheduledProfiles, profileIndex)
        ScheduledProfileConfig profileConfig = profile.config
        anyFib := anyFib or profileConfig.fibEnabled
    if anyFib
        if showFib100
            addRow(colorTable, row, "Fib 1.0", fibColor100)
            row += 1
        if showFib786
            addRow(colorTable, row, "Fib 0.786", fibColor786)
            row += 1
        if showFib705
            addRow(colorTable, row, "Fib 0.705", fibColor705)
            row += 1
        if showFib618
            addRow(colorTable, row, "Fib 0.618", fibColor618)
            row += 1
        if showFib50
            addRow(colorTable, row, "Fib 0.5", fibColor50)
            row += 1
        if showFib382
            addRow(colorTable, row, "Fib 0.382", fibColor382)
            row += 1
        if showFib295
            addRow(colorTable, row, "Fib 0.295", fibColor295)
            row += 1
        if showFib214
            addRow(colorTable, row, "Fib 0.214", fibColor214)
            row += 1
        if showFib0
            addRow(colorTable, row, "Fib 0", fibColor0)
            row += 1

    if showOnlyEnabled and showOnlyTimeframeAllowed
        addRow(colorTable, row, "Hidden Candles", hiddenCandleColor)
        row += 1

// parallax •
