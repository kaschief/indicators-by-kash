// TYPES

type FibLevelSet
    array<bool> visibleLevels
    array<int> lineWidths
    int lineCount

type FibPalette
    array<float> ratios
    array<string> ratioTexts
    array<color> levelColors
    array<bool> keyLevels

type AssetFamily
    array<string> identifiers
    float dailyLiquidityDepthDistance

type LiquidityDepthSideState
    bool activated
    int activationTime
    int activationIndex
    array<bool> mitigated
    array<int> endTimes
    array<int> endIndices

type LiquidityDepthSessionState
    int sessionStartTime
    int sessionStartIndex
    int sessionEndTime
    float highAnchor
    float lowAnchor
    int lastEligibleIndex
    LiquidityDepthSideState highSide
    LiquidityDepthSideState lowSide

type LiquidityDepthProfileState
    LiquidityDepthSessionState currentSession
    array<LiquidityDepthSessionState> history

type ProfileEdgeQualificationConfig
    bool enabled
    bool historyEnabled
    int cutoffMinute
    color outlineColor
    int outlineWidth

type ProfileEdgeQualificationSnapshot
    int profileStartTime
    int profileStartIndex
    int profileEndTime
    int profileEndIndex
    float outerHigh
    float outerLow
    bool qualified

type ProfileEdgeQualificationState
    ProfileEdgeQualificationSnapshot currentSnapshot
    array<ProfileEdgeQualificationSnapshot> history
    box currentOutline
    array<box> historyOutlines
    bool currentDirty
    bool historyDirty

type ProfileEdgeQualification
    ProfileEdgeQualificationConfig config
    ProfileEdgeQualificationState state

type ScheduledProfileForecastData
    float referenceOpen
    float referenceHigh
    float referenceLow
    float medianHighOpen
    float meanHighOpen
    float medianOpenLow
    float meanOpenLow

type ScheduledProfileData
    int startTime
    int endTime
    float profileOpen
    float profileHigh
    float profileLow
    float medianHighOpen
    float meanHighOpen
    float medianOpenLow
    float meanOpenLow
    ScheduledProfileForecastData forecast

type ScheduledProfileConfig
    string sourceLabel
    int startMinute
    int endMinute
    bool fullPeriod
    int forecastLeadMinutes
    string samplingSchedule
    string forecastSchedule
    bool enabled
    color slotColor
    int sampleLookback
    int historyLimit
    int fibHistoryLimit
    bool liquidityDepthEnabled
    FibLevelSet fibLevelSet
    bool forecastEnabled
    bool fibLabelsEnabled
    string fibLabelSize
    string fibLabelPosition
    int fibLabelOffset
    string slotLabelSize
    int fibFade
    bool ringVisible = false
    bool ringOnly = false
    color ringColor
    int ringWidth

type ScheduledProfileChartState
    float runHigh
    float runLow

type SlotState
    array<box> histBoxes
    box ringOutline
    box fillUp
    box fillLo
    line innH
    line innL
    line outH
    line outL
    box forecastFillUp
    box forecastFillLo
    line forecastInnH
    line forecastInnL
    line forecastOutH
    line forecastOutL
    array<line> fibLines
    array<line> histFibLines
    array<label> fibLabels
    array<label> histFibLabels
    array<line> liquidityDepthLines
    array<label> liquidityDepthLabels

type ScheduledProfileRuntime
    bool valid
    bool transition
    int startTime
    int startIndex
    int endTime
    int endIndex
    float sessionOpen
    float currentHigh
    float currentLow
    float completedHigh
    float completedLow
    float medianHighOpen
    float meanHighOpen
    float medianOpenLow
    float meanOpenLow
    ScheduledProfileForecastData forecast
    int forecastStartTime
    int forecastEndTime
    bool forecastVisible

type ScheduledProfile
    ScheduledProfileConfig config
    ScheduledProfileRuntime runtimeState
    SlotState drawingState
    LiquidityDepthProfileState liquidityDepthState
    ProfileEdgeQualification edgeQualification
    string identifierText

fib_width_value(string widthSetting) =>
    widthSetting == FIB_WIDTH_OFF ? 0 : int(str.tonumber(widthSetting))

make_fib_level_set(string width100, string width786, string width705, string width618, string width50, string width382, string width295, string width214, string width0) =>
    array<int> lineWidths = array.from(fib_width_value(width100), fib_width_value(width786), fib_width_value(width705), fib_width_value(width618), fib_width_value(width50), fib_width_value(width382), fib_width_value(width295), fib_width_value(width214), fib_width_value(width0))
    array<bool> visibleLevels = array.new<bool>()
    int lineCount = 0
    for levelIndex = 0 to array.size(lineWidths) - 1
        bool levelVisible = array.get(lineWidths, levelIndex) > 0
        array.push(visibleLevels, levelVisible)
        lineCount += levelVisible ? 1 : 0
    FibLevelSet.new(visibleLevels=visibleLevels, lineWidths=lineWidths, lineCount=lineCount)

resolve_fib_level_set(string presetName, FibLevelSet disabledSet, FibLevelSet defaultSet, FibLevelSet alternativeSet) =>
    presetName == FIB_PRESET_DEFAULT ? defaultSet : presetName == FIB_PRESET_ALTERNATIVE ? alternativeSet : disabledSet

// TIMEFRAME HELPERS

get_tf_display_label(string tf) =>
    int secs = timeframe.in_seconds(tf)
    if secs < SECS_MIN
        str.tostring(secs) + "s"
    else if secs < SECS_HOUR
        str.tostring(int(math.round(secs / float(SECS_MIN)))) + "m"
    else if secs < SECS_DAY
        str.tostring(int(math.round(secs / float(SECS_HOUR)))) + "H"
    else if secs < SECS_WEEK
        str.tostring(int(math.round(secs / float(SECS_DAY)))) + "D"
    else if secs < SECS_4_WEEKS
        str.tostring(int(math.round(secs / float(SECS_WEEK)))) + "W"
    else
        str.tostring(int(math.round(secs / float(SECS_MONTH_AVG)))) + "Mo"

// Per-slot LTF→HTF auto-pairing. Slot N resolves to N tiers above chart.
get_tf_pairing(string chart_tf, int slot) =>
    if slot == 1
        switch chart_tf
            "30S" => [true, "5",   "5m"]
            "1"   => [true, "15",  "15m"]
            "2"   => [true, "30",  "30m"]
            "3"   => [true, "60",  "1H"]
            "4"   => [true, "30",  "30m"]
            "5"   => [true, "60",  "1H"]
            "10"  => [true, "60",  "1H"]
            "15"  => [true, "240", "4H"]
            "30"  => [true, "240", "4H"]
            "45"  => [true, "240", "4H"]
            "60"  => [true, "D",   "D"]
            "120" => [true, "D",   "D"]
            "180" => [true, "D",   "D"]
            "240" => [true, "D",   "D"]
            "1D"  => [true, "W",   "W"]
            "1W"  => [true, "M",   "1Mo"]
            =>       [false, "",   ""]
    else if slot == 2
        switch chart_tf
            "30S" => [true, "15",  "15m"]
            "1"   => [true, "60",  "1H"]
            "2"   => [true, "60",  "1H"]
            "3"   => [true, "240", "4H"]
            "4"   => [true, "60",  "1H"]
            "5"   => [true, "240", "4H"]
            "10"  => [true, "240", "4H"]
            "15"  => [true, "D",   "D"]
            "30"  => [true, "D",   "D"]
            "45"  => [true, "D",   "D"]
            "60"  => [true, "W",   "W"]
            "120" => [true, "W",   "W"]
            "180" => [true, "W",   "W"]
            "240" => [true, "W",   "W"]
            "1D"  => [true, "M",   "1Mo"]
            =>       [false, "",   ""]
    else
        [false, "", ""]

// INPUTS

// GENERAL

latestOnly = input.bool(true, "Latest Only", group=GROUP_GENERAL)

// LOOKBACK

htfSlotLookback = input.int(100, "HTF Profiles", inline="lookback_samples", group=GROUP_LOOKBACK, minval=1, maxval=500)
intradayProfileLookback = input.int(20, "Intraday Profiles", inline="lookback_samples", group=GROUP_LOOKBACK, minval=1, maxval=500,
     tooltip="HTF Profiles\nSlots 1–2, Weekly, Monthly and Daily.\n\nIntraday Profiles\nOvernight, NYE, NYAM, NYPM, IVB and IVB+.")

// QUICK FILTER

hideCompleted = input.bool(true, "Hide Completed", group=GROUP_QUICK_FILTER_SETTINGS, tooltip="Hides intraday profiles once their NY window ends, until the next window starts.")
showOnlyEnabled = input.bool(false, "Show Only", inline="show_only", group=GROUP_QUICK_FILTER_SETTINGS)
hiddenCandleColor = input.color(DEFAULT_HIDDEN_CANDLE_COLOR, "", inline="show_only", group=GROUP_QUICK_FILTER_SETTINGS, active=showOnlyEnabled)
visibleWindow = input.string(WINDOW_LABEL_RTH, "", options=[WINDOW_LABEL_OVERNIGHT, WINDOW_LABEL_FROM_0500, WINDOW_LABEL_FROM_0830, WINDOW_LABEL_RTH], inline="show_only", group=GROUP_QUICK_FILTER_SETTINGS, active=showOnlyEnabled)
showOnlyMostRecent = input.bool(false, "Most Recent Only", inline="show_only", group=GROUP_QUICK_FILTER_SETTINGS, active=showOnlyEnabled, tooltip="Dims outside the selected NY window. ≤1H and Range.\nMost Recent Only — current NY date only.")

// ALL-TIME HIGH

allTimeHighShow = input.bool(true, "Enable", inline="ath_display", group=GROUP_ALL_TIME_HIGH)
allTimeHighColor = input.color(DEFAULT_ALL_TIME_HIGH_COLOR, "", inline="ath_display", group=GROUP_ALL_TIME_HIGH, active=allTimeHighShow)
allTimeHighBufferPercent = input.int(20, "Buffer %", minval=0, maxval=500, inline="ath_display", group=GROUP_ALL_TIME_HIGH, active=allTimeHighShow,
     tooltip="ATH Marker\nA quiet fading line at the left edge of today's Daily profile.\n\nShown when\n• the ATH is inside today's Daily profile range, or\n• it is no further above today's high than Buffer % of today's high-to-low range.\n\nThe New All-Time High alert works regardless of this toggle.")

// HTF PROFILES

slot1Show    = input.bool(false, "1", inline="s1", group=GROUP_HTF_PROFILES)
slot1Manual  = input.bool(false, "", inline="s1", group=GROUP_HTF_PROFILES, active=slot1Show)
slot1TFIn    = input.timeframe("60", "", inline="s1", group=GROUP_HTF_PROFILES, active=slot1Show)
slot1Color   = input.color(SLOT1_COLOR, "", inline="s1", group=GROUP_HTF_PROFILES, active=slot1Show)
slot1History = input.int(SLOT_HISTORY_DEFAULT, "", inline="s1", group=GROUP_HTF_PROFILES, active=slot1Show, minval=SLOT_HISTORY_MIN, maxval=SLOT_HISTORY_MAX)
slot1FibPreset = input.string(FIB_PRESET_OFF, "", inline="s1", group=GROUP_HTF_PROFILES, active=slot1Show, options=[FIB_PRESET_OFF, FIB_PRESET_DEFAULT, FIB_PRESET_ALTERNATIVE])

slot2Show    = input.bool(false, "2", inline="s2", group=GROUP_HTF_PROFILES)
slot2Manual  = input.bool(true, "", inline="s2", group=GROUP_HTF_PROFILES, active=slot2Show)
slot2TFIn    = input.timeframe("240", "", inline="s2", group=GROUP_HTF_PROFILES, active=slot2Show)
slot2Color   = input.color(SLOT2_COLOR, "", inline="s2", group=GROUP_HTF_PROFILES, active=slot2Show)
slot2History = input.int(SLOT_HISTORY_DEFAULT, "", inline="s2", group=GROUP_HTF_PROFILES, active=slot2Show, minval=SLOT_HISTORY_MIN, maxval=SLOT_HISTORY_MAX)
slot2FibPreset = input.string(FIB_PRESET_OFF, "", inline="s2", group=GROUP_HTF_PROFILES, active=slot2Show, options=[FIB_PRESET_OFF, FIB_PRESET_DEFAULT, FIB_PRESET_ALTERNATIVE])

weeklyProfileShow = input.bool(false, WEEKLY_PROFILE_NAME, inline="weekly_profile", group=GROUP_HTF_PROFILES)
weeklyProfileColor = input.color(WEEKLY_PROFILE_COLOR, "", inline="weekly_profile", group=GROUP_HTF_PROFILES, active=weeklyProfileShow)
weeklyProfileHistory = input.int(SLOT_HISTORY_DEFAULT, "", inline="weekly_profile", group=GROUP_HTF_PROFILES, active=weeklyProfileShow, minval=SLOT_HISTORY_MIN, maxval=SLOT_HISTORY_MAX)
weeklyProfileFibPreset = input.string(FIB_PRESET_ALTERNATIVE, "", inline="weekly_profile", group=GROUP_HTF_PROFILES, active=weeklyProfileShow, options=[FIB_PRESET_OFF, FIB_PRESET_DEFAULT, FIB_PRESET_ALTERNATIVE])

monthlyProfileShow = input.bool(false, MONTHLY_PROFILE_NAME, inline="monthly_profile", group=GROUP_HTF_PROFILES)
monthlyProfileColor = input.color(MONTHLY_PROFILE_COLOR, "", inline="monthly_profile", group=GROUP_HTF_PROFILES, active=monthlyProfileShow)
monthlyProfileHistory = input.int(SLOT_HISTORY_DEFAULT, "", inline="monthly_profile", group=GROUP_HTF_PROFILES, active=monthlyProfileShow, minval=SLOT_HISTORY_MIN, maxval=SLOT_HISTORY_MAX)
monthlyProfileFibPreset = input.string(FIB_PRESET_ALTERNATIVE, "", inline="monthly_profile", group=GROUP_HTF_PROFILES, active=monthlyProfileShow, options=[FIB_PRESET_OFF, FIB_PRESET_DEFAULT, FIB_PRESET_ALTERNATIVE])

dailyProfileShow = input.bool(true, DAILY_PROFILE_NAME, inline="daily_profile", group=GROUP_HTF_PROFILES)
useMidnight = input.bool(false, "", inline="daily_profile", group=GROUP_HTF_PROFILES, active=dailyProfileShow)
dailyProfileColor = input.color(DAILY_PROFILE_COLOR, "", inline="daily_profile", group=GROUP_HTF_PROFILES, active=dailyProfileShow)
dailyProfileHistory = input.int(DAILY_PROFILE_HISTORY_DEFAULT, "", inline="daily_profile", group=GROUP_HTF_PROFILES, minval=SLOT_HISTORY_MIN, maxval=SLOT_HISTORY_MAX, active=dailyProfileShow)
dailyProfileFibPreset = input.string(FIB_PRESET_OFF, "", inline="daily_profile", group=GROUP_HTF_PROFILES, active=dailyProfileShow, options=[FIB_PRESET_OFF, FIB_PRESET_DEFAULT, FIB_PRESET_ALTERNATIVE])

// DAILY RING

dailyRingMode = input.string(DAILY_RING_OFF, "", options=[DAILY_RING_OFF, DAILY_RING_WITH_PROFILE, DAILY_RING_ONLY], inline="daily_ring", group=GROUP_DAILY_RING, active=dailyProfileShow)
bool dailyRingVisible = dailyRingMode != DAILY_RING_OFF
bool dailyProfileRingOnly = dailyRingMode == DAILY_RING_ONLY
dailyRingColor = input.color(DAILY_RING_COLOR, "", inline="daily_ring", group=GROUP_DAILY_RING, active=dailyProfileShow and dailyRingVisible)
dailyRingWidth = input.int(DAILY_RING_DEFAULT_WIDTH, "", options=[1, 2, 3, 4], inline="daily_ring", group=GROUP_DAILY_RING, active=dailyProfileShow and dailyRingVisible)
dailyRingFib = input.bool(false, "Fib", inline="daily_ring", group=GROUP_DAILY_RING, active=dailyProfileShow and dailyProfileRingOnly and dailyProfileFibPreset != FIB_PRESET_OFF, tooltip=DAILY_RING_TOOLTIP)

// DAILY BOUNDARY EXCEEDED

dailyBoundaryExceededEnabled = input.bool(true, "Enable", inline="daily_boundary_exceeded", group=GROUP_DAILY_BOUNDARY_EXCEEDED, active=dailyProfileShow)
dailyBoundaryExceededCutoff = input.string("08:00", "", options=[
     "00:00", "00:15", "00:30", "00:45", "01:00", "01:15", "01:30", "01:45", "02:00", "02:15", "02:30", "02:45",
     "03:00", "03:15", "03:30", "03:45", "04:00", "04:15", "04:30", "04:45", "05:00", "05:15", "05:30", "05:45",
     "06:00", "06:15", "06:30", "06:45", "07:00", "07:15", "07:30", "07:45", "08:00", "08:15", "08:30", "08:45",
     "09:00", "09:15", "09:30", "09:45", "10:00", "10:15", "10:30", "10:45", "11:00", "11:15", "11:30", "11:45",
     "12:00", "12:15", "12:30", "12:45", "13:00", "13:15", "13:30", "13:45", "14:00", "14:15", "14:30", "14:45",
     "15:00", "15:15", "15:30", "15:45", "16:00", "16:15", "16:30", "16:45", "17:00", "17:15", "17:30", "17:45",
     "18:00", "18:15", "18:30", "18:45", "19:00", "19:15", "19:30", "19:45", "20:00", "20:15", "20:30", "20:45",
     "21:00", "21:15", "21:30", "21:45", "22:00", "22:15", "22:30", "22:45", "23:00", "23:15", "23:30", "23:45"],
     inline="daily_boundary_exceeded", group=GROUP_DAILY_BOUNDARY_EXCEEDED, active=dailyProfileShow and dailyBoundaryExceededEnabled,
     tooltip="Marks the complete Daily profile when either outer edge is reached or price comes within one minimum tick before the selected New York cutoff. Uses the same outer boundaries as Daily LD.")
dailyBoundaryExceededHistory = input.bool(false, "History", inline="daily_boundary_exceeded", group=GROUP_DAILY_BOUNDARY_EXCEEDED, active=dailyProfileShow and dailyBoundaryExceededEnabled)

// INTRADAY PROFILES

overnightShow     = input.bool(false, OVERNIGHT_SLOT_NAME, inline="overnight", group=GROUP_INTRADAY_PROFILES)
overnightColor    = input.color(OVERNIGHT_COLOR, "", inline="overnight", group=GROUP_INTRADAY_PROFILES, active=overnightShow)
overnightHistory  = input.int(SLOT_HISTORY_DEFAULT, "", inline="overnight", group=GROUP_INTRADAY_PROFILES, minval=SLOT_HISTORY_MIN, maxval=SLOT_HISTORY_MAX, active=overnightShow)
overnightFibPreset = input.string(FIB_PRESET_DEFAULT, SLOT_LABEL_FIB, inline="overnight", group=GROUP_INTRADAY_PROFILES, active=overnightShow, options=[FIB_PRESET_OFF, FIB_PRESET_DEFAULT, FIB_PRESET_ALTERNATIVE], tooltip=OVERNIGHT_SLOT_TOOLTIP)

nyEarlyShow     = input.bool(false, NY_EARLY_SLOT_NAME, inline="ny_early", group=GROUP_INTRADAY_PROFILES)
