     forecastLeadMinutes=IVB_DURATION_MINUTES, samplingSchedule=INTRADAY_SAMPLING_SCHEDULE, forecastSchedule=INTRADAY_FORECAST_SCHEDULE,
     enabled=ivbShow, slotColor=ivbColor, sampleLookback=intradayProfileLookback, historyLimit=ivbHistory, liquidityDepthEnabled=ivbLiquidityDepth,
