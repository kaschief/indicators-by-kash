forecastNyAm = input.bool(true, NY_AM_SLOT_NAME, inline="forecast_intraday_profiles", group=GROUP_FORECAST, active=showNextRangeForecast and nyAmShow)
forecastNyPm = input.bool(true, NY_PM_SLOT_NAME, inline="forecast_intraday_profiles", group=GROUP_FORECAST, active=showNextRangeForecast and nyPmShow)
forecastIvb = input.bool(true, IVB_SLOT_NAME, inline="forecast_intraday_profiles", group=GROUP_FORECAST, active=showNextRangeForecast and ivbShow)
forecastIvbPlus = input.bool(true, IVB_PLUS_SLOT_NAME, inline="forecast_intraday_profiles", group=GROUP_FORECAST, active=showNextRangeForecast and ivbPlusShow, tooltip=FORECAST_SLOT_TOOLTIP)

// FIBONACCI

fibHistoryAmount = input.int(1, "History", inline="fib_history_options", group=GROUP_FIB_HISTORY, active=fibInputsActive, minval=1, maxval=FIB_HISTORY_MAX)
fibTrailing = input.bool(false, "Trailing", inline="fib_history_options", group=GROUP_FIB_HISTORY, active=fibInputsActive, tooltip=FIB_HISTORY_TOOLTIP)
slot1FibHistory = input.bool(false, "1", inline="fib_history_profiles", group=GROUP_FIB_HISTORY, active=slot1Show and slot1FibPreset != FIB_PRESET_OFF)
slot2FibHistory = input.bool(false, "2", inline="fib_history_profiles", group=GROUP_FIB_HISTORY, active=slot2Show and slot2FibPreset != FIB_PRESET_OFF)
weeklyProfileFibHistory = input.bool(false, WEEKLY_PROFILE_NAME, inline="fib_history_profiles", group=GROUP_FIB_HISTORY, active=weeklyProfileShow and weeklyProfileFibPreset != FIB_PRESET_OFF)
monthlyProfileFibHistory = input.bool(false, MONTHLY_PROFILE_NAME, inline="fib_history_profiles", group=GROUP_FIB_HISTORY, active=monthlyProfileShow and monthlyProfileFibPreset != FIB_PRESET_OFF)
dailyProfileFibHistory = input.bool(false, DAILY_PROFILE_NAME, inline="fib_history_profiles", group=GROUP_FIB_HISTORY, active=dailyProfileShow and dailyProfileFibPreset != FIB_PRESET_OFF, tooltip=FIB_HISTORY_TOOLTIP)
overnightFibHistory = input.bool(false, OVERNIGHT_SLOT_NAME, inline="fib_history_intraday_profiles", group=GROUP_FIB_HISTORY, active=overnightShow and overnightFibPreset != FIB_PRESET_OFF)
nyEarlyFibHistory = input.bool(false, NY_EARLY_SLOT_NAME, inline="fib_history_intraday_profiles", group=GROUP_FIB_HISTORY, active=nyEarlyShow and nyEarlyFibPreset != FIB_PRESET_OFF)
nyAmFibHistory = input.bool(false, NY_AM_SLOT_NAME, inline="fib_history_intraday_profiles", group=GROUP_FIB_HISTORY, active=nyAmShow and nyAmFibPreset != FIB_PRESET_OFF)
nyPmFibHistory = input.bool(false, NY_PM_SLOT_NAME, inline="fib_history_intraday_profiles", group=GROUP_FIB_HISTORY, active=nyPmShow and nyPmFibPreset != FIB_PRESET_OFF)
ivbFibHistory = input.bool(false, IVB_SLOT_NAME, inline="fib_history_intraday_profiles", group=GROUP_FIB_HISTORY, active=ivbShow and ivbFibPreset != FIB_PRESET_OFF)
ivbPlusFibHistory = input.bool(false, IVB_PLUS_SLOT_NAME, inline="fib_history_intraday_profiles", group=GROUP_FIB_HISTORY, active=ivbPlusShow and ivbPlusFibPreset != FIB_PRESET_OFF, tooltip=FIB_HISTORY_TOOLTIP)

