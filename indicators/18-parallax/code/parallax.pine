// TYPES

type NamedSlotConfig
    string sourceLabel
    int startMinute
    int endMinute
    int forecastLeadMinutes
    bool samplingWeekdaysOnly
    bool forecastWeekdaysOnly
    bool enabled
    color slotColor
    int sampleLookback
    int historyLimit
    bool fibEnabled
    bool forecastEnabled
    bool fibLabelsEnabled
    string fibLabelSize
    string fibLabelPosition
    int fibLabelOffset
    string slotLabelSize
    int fibFade

type NamedSlotChartState
    float runHigh
    float runLow

type SlotState
    array<box> histBoxes
    box fillUp
    box fillLo
    line innH
    line innL
    line outH
    line outL
    box forecastFillUp
    box forecastFillLo
    line forecastInnH
    line forecastInnL
    line forecastOutH
    line forecastOutL
    array<line> fibLines
    array<line> histFibLines
    array<label> fibLabels
    array<label> histFibLabels

type NamedSlotRuntime
    bool valid
    bool transition
    int startTime
    int startIndex
    int endTime
    int endIndex
    float sessionOpen
    float currentHigh
    float currentLow
    float completedHigh
    float completedLow
    float medianHighOpen
    float meanHighOpen
    float medianOpenLow
    float meanOpenLow
    int forecastStartTime
    int forecastEndTime
    bool forecastVisible

type NamedSlot
    NamedSlotConfig config
    NamedSlotRuntime runtimeState
    SlotState drawingState
    string identifierText

// TIMEFRAME HELPERS

get_tf_display_label(string tf) =>
    int secs = timeframe.in_seconds(tf)
    if secs < SECS_MIN
        str.tostring(secs) + "s"
    else if secs < SECS_HOUR
        str.tostring(int(math.round(secs / float(SECS_MIN)))) + "m"
    else if secs < SECS_DAY
        str.tostring(int(math.round(secs / float(SECS_HOUR)))) + "H"
    else if secs < SECS_WEEK
        str.tostring(int(math.round(secs / float(SECS_DAY)))) + "D"
    else if secs < SECS_4_WEEKS
        str.tostring(int(math.round(secs / float(SECS_WEEK)))) + "W"
    else
        str.tostring(int(math.round(secs / float(SECS_MONTH_AVG)))) + "Mo"

// Per-slot LTF→HTF auto-pairing. Slot N resolves to N tiers above chart.
get_tf_pairing(string chart_tf, int slot) =>
    if slot == 1
        switch chart_tf
            "30S" => [true, "5",   "5m"]
            "1"   => [true, "15",  "15m"]
            "2"   => [true, "30",  "30m"]
            "3"   => [true, "60",  "1H"]
            "4"   => [true, "30",  "30m"]
            "5"   => [true, "60",  "1H"]
            "10"  => [true, "60",  "1H"]
            "15"  => [true, "240", "4H"]
            "30"  => [true, "240", "4H"]
            "45"  => [true, "240", "4H"]
            "60"  => [true, "D",   "D"]
            "120" => [true, "D",   "D"]
            "180" => [true, "D",   "D"]
            "240" => [true, "D",   "D"]
            "1D"  => [true, "W",   "W"]
            "1W"  => [true, "M",   "1Mo"]
            =>       [false, "",   ""]
    else if slot == 2
        switch chart_tf
            "30S" => [true, "15",  "15m"]
            "1"   => [true, "60",  "1H"]
            "2"   => [true, "60",  "1H"]
            "3"   => [true, "240", "4H"]
            "4"   => [true, "60",  "1H"]
            "5"   => [true, "240", "4H"]
            "10"  => [true, "240", "4H"]
            "15"  => [true, "D",   "D"]
            "30"  => [true, "D",   "D"]
            "45"  => [true, "D",   "D"]
            "60"  => [true, "W",   "W"]
            "120" => [true, "W",   "W"]
            "180" => [true, "W",   "W"]
            "240" => [true, "W",   "W"]
            "1D"  => [true, "M",   "1Mo"]
            =>       [false, "",   ""]
    else if slot == 3
        switch chart_tf
            "30S" => [true, "60",  "1H"]
            "1"   => [true, "240", "4H"]
            "2"   => [true, "240", "4H"]
            "3"   => [true, "D",   "D"]
            "4"   => [true, "240", "4H"]
            "5"   => [true, "D",   "D"]
            "10"  => [true, "D",   "D"]
            "15"  => [true, "W",   "W"]
            "30"  => [true, "W",   "W"]
            "45"  => [true, "W",   "W"]
            "60"  => [true, "M",   "1Mo"]
            "120" => [true, "M",   "1Mo"]
            "180" => [true, "M",   "1Mo"]
            "240" => [true, "M",   "1Mo"]
            =>       [false, "",   ""]
    else if slot == 4
        switch chart_tf
            "30S" => [true, "240", "4H"]
            "1"   => [true, "D",   "D"]
            "2"   => [true, "D",   "D"]
            "3"   => [true, "W",   "W"]
            "4"   => [true, "D",   "D"]
            "5"   => [true, "W",   "W"]
            "10"  => [true, "W",   "W"]
            "15"  => [true, "M",   "1Mo"]
            "30"  => [true, "M",   "1Mo"]
            "45"  => [true, "M",   "1Mo"]
            "60"  => [true, "3M",  "3Mo"]
            "120" => [true, "3M",  "3Mo"]
            "180" => [true, "3M",  "3Mo"]
            "240" => [true, "3M",  "3Mo"]
            =>       [false, "",   ""]
    else
        [false, "", ""]

