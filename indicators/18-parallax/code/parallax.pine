     enabled=ivbPlusShow, slotColor=ivbPlusColor, sampleLookback=intradayProfileLookback, historyLimit=ivbPlusHistory, liquidityDepthEnabled=ivbPlusLiquidityDepth,
     fibLevelSet=ivbPlusFibLevelSet, forecastEnabled=forecastIvbPlus,
     fibLabelsEnabled=fibLabelIvbPlus, fibLabelSize=fibLabelSizeIvbPlus,
     fibLabelPosition=fibLabelPosIvbPlus, fibLabelOffset=fibLabelOffIvbPlus,
     slotLabelSize=INTRADAY_PROFILE_LABEL_SIZE, fibFade=SCHEDULED_PROFILE_FIB_FADE)

get_label_size(string s) =>
    s == LBL_TINY   ? size.tiny   :
     s == LBL_NORMAL ? size.normal :
     s == LBL_LARGE  ? size.large  :
     s == LBL_HUGE   ? size.huge   :
                       size.small

scheduled_profile_duration_minutes(ScheduledProfileConfig config) =>
    if config.fullPeriod
        MINUTES_PER_DAY
    else
        int rawDuration = config.endMinute - config.startMinute
        rawDuration > 0 ? rawDuration : rawDuration + MINUTES_PER_DAY

scheduled_profile_source_aligned(ScheduledProfileConfig config) =>
    int sourceMinutes = int(sessionSourceSeconds / SECS_MIN)
    config.startMinute % sourceMinutes == 0 and config.endMinute % sourceMinutes == 0

validate_scheduled_profile_config(ScheduledProfileConfig config) =>
    bool minutesInRange = config.startMinute >= 0 and config.startMinute < MINUTES_PER_DAY and config.endMinute >= 0 and config.endMinute < MINUTES_PER_DAY
    bool validPeriodContract = config.fullPeriod ? config.startMinute == config.endMinute : config.startMinute != config.endMinute
    bool validBoundaries = minutesInRange and validPeriodContract
    if not validBoundaries
        runtime.error(config.sourceLabel + " session boundaries do not match its period contract.")
    if not scheduled_profile_source_aligned(config)
        runtime.error(config.sourceLabel + " session boundaries must align with the session source timeframe.")
    if config.sampleLookback < 1 or config.historyLimit < 1 or config.forecastLeadMinutes < 0
        runtime.error(config.sourceLabel + " lookbacks must be positive and forecast lead cannot be negative.")
    bool validSamplingSchedule = config.samplingSchedule == SCHEDULED_PROFILE_SCHEDULE_ALL_DAYS or config.samplingSchedule == SCHEDULED_PROFILE_SCHEDULE_WEEKDAYS or config.samplingSchedule == SCHEDULED_PROFILE_SCHEDULE_GLOBEX
    bool validForecastSchedule = config.forecastSchedule == SCHEDULED_PROFILE_SCHEDULE_ALL_DAYS or config.forecastSchedule == SCHEDULED_PROFILE_SCHEDULE_WEEKDAYS or config.forecastSchedule == SCHEDULED_PROFILE_SCHEDULE_GLOBEX
    if not validSamplingSchedule or not validForecastSchedule
        runtime.error(config.sourceLabel + " uses an unsupported session schedule.")

scheduled_profile_timestamp(int referenceTime, int minuteOfDay, int dayOffset) =>
    int sessionHour = int(minuteOfDay / MINUTES_PER_HOUR)
    int sessionMinute = minuteOfDay % MINUTES_PER_HOUR
    timestamp(NY_TIMEZONE, year(referenceTime, NY_TIMEZONE), month(referenceTime, NY_TIMEZONE), dayofmonth(referenceTime, NY_TIMEZONE) + dayOffset, sessionHour, sessionMinute)

scheduled_profile_start_allowed(int sessionStart, string scheduleMode) =>
    int startDay = dayofweek(sessionStart, NY_TIMEZONE)
    scheduleMode == SCHEDULED_PROFILE_SCHEDULE_ALL_DAYS or
         (scheduleMode == SCHEDULED_PROFILE_SCHEDULE_WEEKDAYS and startDay >= dayofweek.monday and startDay <= dayofweek.friday) or
         (scheduleMode == SCHEDULED_PROFILE_SCHEDULE_GLOBEX and (startDay == dayofweek.sunday or startDay >= dayofweek.monday and startDay <= dayofweek.thursday))

scheduled_profile_bounds(int referenceTime, int startMinute, int endMinute, bool fullPeriod) =>
    int currentMinute = hour(referenceTime, NY_TIMEZONE) * MINUTES_PER_HOUR + minute(referenceTime, NY_TIMEZONE)
    bool wrapsMidnight = fullPeriod or endMinute <= startMinute
    bool inWindow = fullPeriod or (wrapsMidnight ? currentMinute >= startMinute or currentMinute < endMinute : currentMinute >= startMinute and currentMinute < endMinute)
    int startDayOffset = wrapsMidnight and currentMinute < endMinute ? -1 : 0
    int endDayOffset = startDayOffset + (wrapsMidnight ? 1 : 0)
    [inWindow, scheduled_profile_timestamp(referenceTime, startMinute, startDayOffset), scheduled_profile_timestamp(referenceTime, endMinute, endDayOffset)]

next_scheduled_profile_bounds(int referenceTime, ScheduledProfileConfig config) =>
    int todayStart = scheduled_profile_timestamp(referenceTime, config.startMinute, 0)
    int dayOffset = referenceTime < todayStart ? 0 : 1
    int nextStart = scheduled_profile_timestamp(referenceTime, config.startMinute, dayOffset)
    while not scheduled_profile_start_allowed(nextStart, config.forecastSchedule)
        dayOffset += 1
        nextStart := scheduled_profile_timestamp(referenceTime, config.startMinute, dayOffset)
    int endDayOffset = dayOffset + (config.fullPeriod or config.endMinute <= config.startMinute ? 1 : 0)
    [nextStart, scheduled_profile_timestamp(referenceTime, config.endMinute, endDayOffset)]

scheduled_profile_valid(ScheduledProfileConfig config) =>
    int durationSeconds = scheduled_profile_duration_minutes(config) * SECS_MIN
    config.enabled and (chart.is_range or timeframe.in_seconds(timeframe.period) < durationSeconds)

same_ny_date(int firstTime, int secondTime) =>
    year(firstTime, NY_TIMEZONE) == year(secondTime, NY_TIMEZONE) and
         month(firstTime, NY_TIMEZONE) == month(secondTime, NY_TIMEZONE) and
         dayofmonth(firstTime, NY_TIMEZONE) == dayofmonth(secondTime, NY_TIMEZONE)

scheduled_profile_current_visible(ScheduledProfileConfig config, ScheduledProfileRuntime profileRuntime, bool hideCompletedToday, int referenceTime) =>
    bool completedToday = not config.fullPeriod and not na(profileRuntime.endTime) and referenceTime >= profileRuntime.endTime and same_ny_date(profileRuntime.endTime, referenceTime)
    profileRuntime.valid and not (hideCompletedToday and completedToday)

scheduled_profile_liquidity_depth_active(ScheduledProfileConfig config, ScheduledProfileRuntime profileRuntime) =>
    config.liquidityDepthEnabled and profileRuntime.valid and intradayLiquidityDepthTimeframeAllowed and liquidityDepthAssetSupported

scheduled_profile_forecast_visible(ScheduledProfileConfig config, bool valid, int referenceTime, int forecastStart) =>
    int leadMilliseconds = config.forecastLeadMinutes * SECS_MIN * MS_PER_SEC
    showNextRangeForecast and config.forecastEnabled and valid and referenceTime >= forecastStart - leadMilliseconds and referenceTime < forecastStart

full_period_forecast_visible(ScheduledProfileConfig config, bool valid, int sessionStart) =>
    showNextRangeForecast and config.forecastEnabled and config.fullPeriod and valid and not na(sessionStart)

validate_scheduled_profile_config(dailyProfileConfig)
validate_scheduled_profile_config(overnightConfig)
validate_scheduled_profile_config(nyEarlyConfig)
validate_scheduled_profile_config(nyAmConfig)
validate_scheduled_profile_config(ivbConfig)
validate_scheduled_profile_config(ivbPlusConfig)

// HTF RESOLUTION

string CHART_TF = timeframe.period
[s1AutoValid, s1AutoTF, s1AutoLabel] = get_tf_pairing(CHART_TF, 1)
[s2AutoValid, s2AutoTF, s2AutoLabel] = get_tf_pairing(CHART_TF, 2)

string s1TF    = (slot1Manual or chart.is_range) ? slot1TFIn : (s1AutoValid ? s1AutoTF : "1D")
bool   s1Valid = slot1Show and (slot1Manual or chart.is_range or s1AutoValid) and (chart.is_range or timeframe.in_seconds(s1TF) > timeframe.in_seconds())
string s1Safe  = s1Valid ? s1TF : "1D"
string s1Label = get_tf_display_label(s1TF)
string s1IdentifierText = s1Label + " ¹"

string s2TF    = (slot2Manual or chart.is_range) ? slot2TFIn : (s2AutoValid ? s2AutoTF : "1D")
bool   s2Valid = slot2Show and (slot2Manual or chart.is_range or s2AutoValid) and (chart.is_range or timeframe.in_seconds(s2TF) > timeframe.in_seconds())
string s2Safe  = s2Valid ? s2TF : "1D"
string s2Label = get_tf_display_label(s2TF)
string s2IdentifierText = s2Label + " ²"

bool weeklyProfileValid = weeklyProfileShow and (chart.is_range or timeframe.in_seconds(WEEKLY_TIMEFRAME) > timeframe.in_seconds())
string weeklyProfileSafe = weeklyProfileValid ? WEEKLY_TIMEFRAME : "1D"
string weeklyProfileIdentifierText = WEEKLY_PROFILE_NAME

bool monthlyProfileValid = monthlyProfileShow and (chart.is_range or timeframe.in_seconds(MONTHLY_TIMEFRAME) > timeframe.in_seconds())
string monthlyProfileSafe = monthlyProfileValid ? MONTHLY_TIMEFRAME : "1D"
string monthlyProfileIdentifierText = MONTHLY_PROFILE_NAME

bool dailyProfileValid = scheduled_profile_valid(dailyProfileConfig)
bool overnightValid = scheduled_profile_valid(overnightConfig)
bool nyEarlyValid = scheduled_profile_valid(nyEarlyConfig)
bool nyAmValid = scheduled_profile_valid(nyAmConfig)
bool ivbValid = scheduled_profile_valid(ivbConfig)
bool ivbPlusValid = scheduled_profile_valid(ivbPlusConfig)
string dailyProfileIdentifierText = dailyProfileConfig.sourceLabel
string overnightIdentifierText = overnightConfig.sourceLabel
string nyEarlyIdentifierText = nyEarlyConfig.sourceLabel
string nyAmIdentifierText = nyAmConfig.sourceLabel
string ivbIdentifierText = ivbConfig.sourceLabel
string ivbPlusIdentifierText = ivbPlusConfig.sourceLabel

next_forecast_visible(bool slotEnabled, bool valid) =>
    showNextRangeForecast and slotEnabled and valid

scheduled_profile_request_bars(simple bool enabled, simple int sampleLookback, simple int historyLimit) =>
    int requestedSessions = sampleLookback + historyLimit + SCHEDULED_PROFILE_REQUEST_SESSION_BUFFER
    int requestedSourceBars = int(math.ceil(requestedSessions * SESSION_SOURCE_BARS_PER_DAY * CALENDAR_DAYS_PER_WEEK / float(TRADING_DAYS_PER_WEEK)))
    enabled ? math.min(SCHEDULED_PROFILE_REQUEST_BARS, requestedSourceBars) : DISABLED_PROFILE_REQUEST_BARS

scheduled_intraday_request_bars(simple int overnightRequestBars, simple int nyEarlyRequestBars,
                                simple int nyAmRequestBars, simple int ivbRequestBars,
                                simple int ivbPlusRequestBars) =>
    int requestBars = overnightRequestBars
    requestBars := math.max(requestBars, nyEarlyRequestBars)
    requestBars := math.max(requestBars, nyAmRequestBars)
    requestBars := math.max(requestBars, ivbRequestBars)
    requestBars := math.max(requestBars, ivbPlusRequestBars)
    requestBars

profile_request_history_limit(simple bool latestOnlyEnabled, simple int historyLimit) =>
    latestOnlyEnabled ? 1 : historyLimit

scheduled_profile_tail_enabled(bool enabled, simple int requestBars) =>
    enabled and bar_index >= last_bar_index - requestBars + 1

// HTF DATA — normal running high/low are tracked chart-side. Wall-clock sessions use
// a 30-minute context so their boundaries remain independent of chart bars.
string htfTickerId = chart.is_range ? ticker.standard(syminfo.tickerid) : syminfo.tickerid

fetch_htf_open(string tickerId, string tf, simple bool enabled, simple int historyLimit) =>
    if enabled
        request.security(tickerId, tf, open, lookahead=barmerge.lookahead_on, calc_bars_count=historyLimit + 2)

calculate_htf_stats(int historyOffset, int sampleLookback) =>
    [ta.median(high - open, sampleLookback)[historyOffset], ta.sma(high - open, sampleLookback)[historyOffset],
     ta.median(open - low, sampleLookback)[historyOffset], ta.sma(open - low, sampleLookback)[historyOffset]]

fetch_htf_stats(string tickerId, string tf, simple bool enabled, simple int sampleLookback) =>
    bool useConfirmedWeeklyStats = timeframe.in_seconds(tf) == SECS_WEEK
    if enabled and useConfirmedWeeklyStats
        request.security(tickerId, tf,
             calculate_htf_stats(1, sampleLookback), lookahead=barmerge.lookahead_on,
             calc_bars_count=sampleLookback + SLOT_HISTORY_MAX + 2)
    else if enabled
        request.security(tickerId, tf,
             calculate_htf_stats(0, sampleLookback), lookahead=barmerge.lookahead_off,
             calc_bars_count=sampleLookback + SLOT_HISTORY_MAX + 2)

sample_stats(array<float> samples) =>
    int sampleCount = array.size(samples)
    [sampleCount > 0 ? array.median(samples) : na,
     sampleCount > 0 ? array.avg(samples) : na]

record_excursion_sample(array<float> highOpenSamples, array<float> openLowSamples, float sessionOpen, float sessionHigh, float sessionLow, int sampleLimit) =>
    array.push(highOpenSamples, sessionHigh - sessionOpen)
    array.push(openLowSamples, sessionOpen - sessionLow)
    while array.size(highOpenSamples) > sampleLimit
        array.shift(highOpenSamples)
    while array.size(openLowSamples) > sampleLimit
        array.shift(openLowSamples)

collect_scheduled_profile_data(bool enabled, int startMinute, int endMinute, string samplingSchedule, bool fullPeriod) =>
    var bool collecting = false
    var int sessionStartTime = na
    var int sessionEndTime = na
    var int lastSessionBarTime = na
    var int lastSessionBarCloseTime = na
    var float sessionOpen = na
    var float sessionHigh = na
    var float sessionLow = na
    bool completedNow = false
    float completedOpen = na
    float completedHigh = na
    float completedLow = na
    bool startsNow = false

    if enabled
        [inWindow, currentSessionStart, currentSessionEnd] = scheduled_profile_bounds(time, startMinute, endMinute, fullPeriod)
        bool eligibleSession = scheduled_profile_start_allowed(currentSessionStart, samplingSchedule)
        bool collectThisBar = inWindow and eligibleSession
        bool finalizePrevious = collecting and (not collectThisBar or currentSessionStart != sessionStartTime)

        if finalizePrevious
            bool sessionComplete = fullPeriod or lastSessionBarTime == sessionEndTime - sessionSourceSeconds * MS_PER_SEC and lastSessionBarCloseTime >= sessionEndTime
            if sessionComplete
                completedNow := true
                completedOpen := sessionOpen
                completedHigh := sessionHigh
                completedLow := sessionLow
            collecting := false

        startsNow := collectThisBar and not collecting and (fullPeriod or time == currentSessionStart)
        if startsNow
            sessionStartTime := currentSessionStart
            sessionEndTime := currentSessionEnd
            sessionOpen := open
            sessionHigh := high
            sessionLow := low
            lastSessionBarTime := time
            lastSessionBarCloseTime := time_close
            collecting := true
        else if collectThisBar and collecting and currentSessionStart == sessionStartTime
            sessionHigh := math.max(sessionHigh, high)
            sessionLow := math.min(sessionLow, low)
            lastSessionBarTime := time
            lastSessionBarCloseTime := time_close

    [sessionStartTime, sessionEndTime, sessionOpen, sessionHigh, sessionLow,
     completedNow, completedOpen, completedHigh, completedLow, startsNow]

fetch_scheduled_profile_data(bool enabled, int sampleLimit, int startMinute, int endMinute, string samplingSchedule, bool fullPeriod) =>
    var array<float> highOpenSamples = array.new<float>()
    var array<float> openLowSamples = array.new<float>()
    var float projectedMedHO = na
    var float projectedMeanHO = na
    var float projectedMedOL = na
    var float projectedMeanOL = na

    [sessionStartTime, sessionEndTime, sessionOpen, sessionHigh, sessionLow,
     completedNow, completedOpen, completedHigh, completedLow, startsNow] = collect_scheduled_profile_data(enabled, startMinute, endMinute, samplingSchedule, fullPeriod)
    if completedNow
        record_excursion_sample(highOpenSamples, openLowSamples, completedOpen, completedHigh, completedLow, sampleLimit)
    if startsNow
        [nextMedHO, nextMeanHO] = sample_stats(highOpenSamples)
        [nextMedOL, nextMeanOL] = sample_stats(openLowSamples)
        projectedMedHO := nextMedHO
        projectedMeanHO := nextMeanHO
        projectedMedOL := nextMedOL
        projectedMeanOL := nextMeanOL

    [sessionStartTime, sessionEndTime, sessionOpen, sessionHigh, sessionLow,
     projectedMedHO, projectedMeanHO,
     projectedMedOL, projectedMeanOL]

fetch_intraday_profiles_data(bool overnightEnabled, simple int overnightRequestBars,
                             bool nyEarlyEnabled, simple int nyEarlyRequestBars,
                             bool nyAmEnabled, simple int nyAmRequestBars,
                             bool ivbEnabled, simple int ivbRequestBars,
                             bool ivbPlusEnabled, simple int ivbPlusRequestBars,
                             int intradaySampleLimit) =>
    [overnightStartTime, overnightEndTime, overnightOpenValue, overnightHigh, overnightLow,
     overnightMedHOValue, overnightMeanHOValue, overnightMedOLValue, overnightMeanOLValue] = fetch_scheduled_profile_data(
         scheduled_profile_tail_enabled(overnightEnabled, overnightRequestBars), intradaySampleLimit, OVERNIGHT_START_MINUTE, OVERNIGHT_END_MINUTE, INTRADAY_SAMPLING_SCHEDULE, false)
    [nyEarlyStartTime, nyEarlyEndTime, nyEarlyOpenValue, nyEarlyHigh, nyEarlyLow,
     nyEarlyMedHOValue, nyEarlyMeanHOValue, nyEarlyMedOLValue, nyEarlyMeanOLValue] = fetch_scheduled_profile_data(
         scheduled_profile_tail_enabled(nyEarlyEnabled, nyEarlyRequestBars), intradaySampleLimit, NY_EARLY_START_MINUTE, NY_EARLY_END_MINUTE, INTRADAY_SAMPLING_SCHEDULE, false)
    [nyAmStartTime, nyAmEndTime, nyAmOpenValue, nyAmHigh, nyAmLow,
     nyAmMedHOValue, nyAmMeanHOValue, nyAmMedOLValue, nyAmMeanOLValue] = fetch_scheduled_profile_data(
         scheduled_profile_tail_enabled(nyAmEnabled, nyAmRequestBars), intradaySampleLimit, NY_AM_START_MINUTE, NY_AM_END_MINUTE, INTRADAY_SAMPLING_SCHEDULE, false)
    [ivbStartTime, ivbEndTime, ivbOpenValue, ivbHigh, ivbLow,
     ivbMedHOValue, ivbMeanHOValue, ivbMedOLValue, ivbMeanOLValue] = fetch_scheduled_profile_data(
         scheduled_profile_tail_enabled(ivbEnabled, ivbRequestBars), intradaySampleLimit, IVB_START_MINUTE, IVB_END_MINUTE, INTRADAY_SAMPLING_SCHEDULE, false)
    [ivbPlusStartTime, ivbPlusEndTime, ivbPlusOpenValue, ivbPlusHigh, ivbPlusLow,
     ivbPlusMedHOValue, ivbPlusMeanHOValue, ivbPlusMedOLValue, ivbPlusMeanOLValue] = fetch_scheduled_profile_data(
         scheduled_profile_tail_enabled(ivbPlusEnabled, ivbPlusRequestBars), intradaySampleLimit, IVB_PLUS_START_MINUTE, IVB_PLUS_END_MINUTE, INTRADAY_SAMPLING_SCHEDULE, false)

    [overnightStartTime, overnightEndTime, overnightOpenValue, overnightHigh, overnightLow, overnightMedHOValue, overnightMeanHOValue, overnightMedOLValue, overnightMeanOLValue,
     nyEarlyStartTime, nyEarlyEndTime, nyEarlyOpenValue, nyEarlyHigh, nyEarlyLow, nyEarlyMedHOValue, nyEarlyMeanHOValue, nyEarlyMedOLValue, nyEarlyMeanOLValue,
     nyAmStartTime, nyAmEndTime, nyAmOpenValue, nyAmHigh, nyAmLow, nyAmMedHOValue, nyAmMeanHOValue, nyAmMedOLValue, nyAmMeanOLValue,
     ivbStartTime, ivbEndTime, ivbOpenValue, ivbHigh, ivbLow, ivbMedHOValue, ivbMeanHOValue, ivbMedOLValue, ivbMeanOLValue,
     ivbPlusStartTime, ivbPlusEndTime, ivbPlusOpenValue, ivbPlusHigh, ivbPlusLow, ivbPlusMedHOValue, ivbPlusMeanHOValue, ivbPlusMedOLValue, ivbPlusMeanOLValue]

resolve_scheduled_profile_chart_state(ScheduledProfileChartState chartState, bool trackOnChart,
                                  int sessionStartTime, int sessionEndTime,
                                  float requestedRunHigh, float requestedRunLow) =>
    bool rangeBarInWindow = chart.is_range and not na(sessionStartTime) and time < sessionEndTime and (time >= sessionStartTime or (not na(time_close) and time_close > sessionStartTime))
    bool rangeSessionStart = rangeBarInWindow and (not rangeBarInWindow[1] or sessionStartTime != sessionStartTime[1])
    int startTimeChange = ta.change(sessionStartTime)
    bool requestedTransition = not na(sessionStartTime) and startTimeChange != 0
    bool transition = chart.is_range ? rangeSessionStart : requestedTransition
    int startIndex = nz(ta.valuewhen(transition, bar_index, 0), 0)
    int capturedStartTime = ta.valuewhen(rangeBarInWindow, sessionStartTime, 0)
    int rangeEndIndex = ta.valuewhen(rangeBarInWindow, bar_index + 1, 0)
    int endIndex = capturedStartTime == sessionStartTime ? rangeEndIndex : na

    bool chartBarInWindow = trackOnChart and (chart.is_range ? rangeBarInWindow : not na(sessionStartTime) and time >= sessionStartTime and time < sessionEndTime)
    bool chartSessionStart = chartBarInWindow and (not chartBarInWindow[1] or sessionStartTime != sessionStartTime[1])
    if chartSessionStart
        chartState.runHigh := high
        chartState.runLow := low
    else if chartBarInWindow
        chartState.runHigh := math.max(chartState.runHigh, high)
        chartState.runLow := math.min(chartState.runLow, low)

    float effectiveRunHigh = trackOnChart ? chartState.runHigh : requestedRunHigh
    float effectiveRunLow = trackOnChart ? chartState.runLow : requestedRunLow
    [transition, startIndex, endIndex, effectiveRunHigh, effectiveRunLow]

simple int slot1RequestHistory = profile_request_history_limit(latestOnly, slot1History)
simple int slot2RequestHistory = profile_request_history_limit(latestOnly, slot2History)
simple int weeklyProfileRequestHistory = profile_request_history_limit(latestOnly, weeklyProfileHistory)
simple int monthlyProfileRequestHistory = profile_request_history_limit(latestOnly, monthlyProfileHistory)
// Identical request contexts reuse the first call's bar count, so enabled slots share the deepest open history.
simple int htfOpenRequestHistory = math.max(slot1Show ? slot1RequestHistory : 0, slot2Show ? slot2RequestHistory : 0,
     weeklyProfileShow ? weeklyProfileRequestHistory : 0, monthlyProfileShow ? monthlyProfileRequestHistory : 0)
simple int dailyProfileRequestHistory = profile_request_history_limit(latestOnly, dailyProfileHistory)
simple int overnightRequestHistory = profile_request_history_limit(latestOnly, overnightHistory)
simple int nyEarlyRequestHistory = profile_request_history_limit(latestOnly, nyEarlyHistory)
simple int nyAmRequestHistory = profile_request_history_limit(latestOnly, nyAmHistory)
simple int ivbRequestHistory = profile_request_history_limit(latestOnly, ivbHistory)
simple int ivbPlusRequestHistory = profile_request_history_limit(latestOnly, ivbPlusHistory)
simple int overnightSourceRequestBars = scheduled_profile_request_bars(overnightShow, intradayProfileLookback, overnightRequestHistory)
simple int nyEarlySourceRequestBars = scheduled_profile_request_bars(nyEarlyShow, intradayProfileLookback, nyEarlyRequestHistory)
simple int nyAmSourceRequestBars = scheduled_profile_request_bars(nyAmShow, intradayProfileLookback, nyAmRequestHistory)
simple int ivbSourceRequestBars = scheduled_profile_request_bars(ivbShow, intradayProfileLookback, ivbRequestHistory)
simple int ivbPlusSourceRequestBars = scheduled_profile_request_bars(ivbPlusShow, intradayProfileLookback, ivbPlusRequestHistory)

s1O = fetch_htf_open(htfTickerId, s1Safe, slot1Show, htfOpenRequestHistory)
s2O = fetch_htf_open(htfTickerId, s2Safe, slot2Show, htfOpenRequestHistory)
weeklyProfileOpen = fetch_htf_open(htfTickerId, weeklyProfileSafe, weeklyProfileShow, htfOpenRequestHistory)
monthlyProfileOpen = fetch_htf_open(htfTickerId, monthlyProfileSafe, monthlyProfileShow, htfOpenRequestHistory)

[s1NormMedHO, s1NormMeanHO, s1NormMedOL, s1NormMeanOL] = fetch_htf_stats(htfTickerId, s1Safe, slot1Show, htfSlotLookback)
[s2NormMedHO, s2NormMeanHO, s2NormMedOL, s2NormMeanOL] = fetch_htf_stats(htfTickerId, s2Safe, slot2Show, htfSlotLookback)
[weeklyProfileMedHO, weeklyProfileMeanHO, weeklyProfileMedOL, weeklyProfileMeanOL] = fetch_htf_stats(htfTickerId, weeklyProfileSafe, weeklyProfileShow, htfSlotLookback)
[monthlyProfileMedHO, monthlyProfileMeanHO, monthlyProfileMedOL, monthlyProfileMeanOL] = fetch_htf_stats(htfTickerId, monthlyProfileSafe, monthlyProfileShow, htfSlotLookback)
[dailyNativeMedHO, dailyNativeMeanHO, dailyNativeMedOL, dailyNativeMeanOL] = fetch_htf_stats(htfTickerId, "D", dailyProfileShow and not useMidnight, htfSlotLookback)

bool scheduledProfileTrackOnChart = chart.is_range or timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds(SESSION_SOURCE_TIMEFRAME)
[dailyProfileStartT, dailyProfileEndT, dailyProfileOpen, dailyProfileRunHigh, dailyProfileRunLow,
 dailyProfileSessionMedHO, dailyProfileSessionMeanHO,
 dailyProfileSessionMedOL, dailyProfileSessionMeanOL] = request.security(
     htfTickerId, SESSION_SOURCE_TIMEFRAME,
     fetch_scheduled_profile_data(dailyProfileValid, htfSlotLookback, dailyProfileConfig.startMinute, dailyProfileConfig.endMinute, dailyProfileConfig.samplingSchedule, dailyProfileConfig.fullPeriod),
     lookahead=scheduledProfileTrackOnChart ? barmerge.lookahead_on : barmerge.lookahead_off,
     calc_bars_count=scheduled_profile_request_bars(dailyProfileShow, htfSlotLookback, dailyProfileRequestHistory))
var ScheduledProfileChartState dailyProfileChartState = ScheduledProfileChartState.new()
[dailyProfileTransition, dailyProfileStartIndex, dailyProfileEndIndex, dailyProfileEffectiveRunHigh, dailyProfileEffectiveRunLow] = resolve_scheduled_profile_chart_state(
     dailyProfileChartState, scheduledProfileTrackOnChart, dailyProfileStartT, dailyProfileEndT, dailyProfileRunHigh, dailyProfileRunLow)
float dailyProfileMedHO = useMidnight ? dailyProfileSessionMedHO : dailyNativeMedHO
float dailyProfileMeanHO = useMidnight ? dailyProfileSessionMeanHO : dailyNativeMeanHO
float dailyProfileMedOL = useMidnight ? dailyProfileSessionMedOL : dailyNativeMedOL
float dailyProfileMeanOL = useMidnight ? dailyProfileSessionMeanOL : dailyNativeMeanOL

[overnightStartT, overnightEndT, overnightOpen, overnightRunHigh, overnightRunLow,
 overnightMedHO, overnightMeanHO, overnightMedOL, overnightMeanOL,
 nyEarlyStartT, nyEarlyEndT, nyEarlyOpen, nyEarlyRunHigh, nyEarlyRunLow,
 nyEarlyMedHO, nyEarlyMeanHO, nyEarlyMedOL, nyEarlyMeanOL,
 nyAmStartT, nyAmEndT, nyAmOpen, nyAmRunHigh, nyAmRunLow,
 nyAmMedHO, nyAmMeanHO, nyAmMedOL, nyAmMeanOL,
 ivbStartT, ivbEndT, ivbOpen, ivbRunHigh, ivbRunLow,
 ivbMedHO, ivbMeanHO, ivbMedOL, ivbMeanOL,
 ivbPlusStartT, ivbPlusEndT, ivbPlusOpen, ivbPlusRunHigh, ivbPlusRunLow,
 ivbPlusMedHO, ivbPlusMeanHO, ivbPlusMedOL, ivbPlusMeanOL] = request.security(
     htfTickerId, SESSION_SOURCE_TIMEFRAME,
     fetch_intraday_profiles_data(
         overnightValid, overnightSourceRequestBars,
         nyEarlyValid, nyEarlySourceRequestBars,
         nyAmValid, nyAmSourceRequestBars,
         ivbValid, ivbSourceRequestBars,
         ivbPlusValid, ivbPlusSourceRequestBars,
         intradayProfileLookback),
     lookahead=scheduledProfileTrackOnChart ? barmerge.lookahead_on : barmerge.lookahead_off,
     calc_bars_count=scheduled_intraday_request_bars(
         overnightSourceRequestBars, nyEarlySourceRequestBars,
         nyAmSourceRequestBars, ivbSourceRequestBars,
         ivbPlusSourceRequestBars))

var ScheduledProfileChartState overnightChartState = ScheduledProfileChartState.new()
[overnightTransition, overnightStartIndex, overnightEndIndex, overnightEffectiveRunHigh, overnightEffectiveRunLow] = resolve_scheduled_profile_chart_state(
     overnightChartState, scheduledProfileTrackOnChart, overnightStartT, overnightEndT, overnightRunHigh, overnightRunLow)

var ScheduledProfileChartState nyEarlyChartState = ScheduledProfileChartState.new()
[nyEarlyTransition, nyEarlyStartIndex, nyEarlyEndIndex, nyEarlyEffectiveRunHigh, nyEarlyEffectiveRunLow] = resolve_scheduled_profile_chart_state(
     nyEarlyChartState, scheduledProfileTrackOnChart, nyEarlyStartT, nyEarlyEndT, nyEarlyRunHigh, nyEarlyRunLow)

var ScheduledProfileChartState nyAmChartState = ScheduledProfileChartState.new()
[nyAmTransition, nyAmStartIndex, nyAmEndIndex, nyAmEffectiveRunHigh, nyAmEffectiveRunLow] = resolve_scheduled_profile_chart_state(
     nyAmChartState, scheduledProfileTrackOnChart, nyAmStartT, nyAmEndT, nyAmRunHigh, nyAmRunLow)

var ScheduledProfileChartState ivbChartState = ScheduledProfileChartState.new()
[ivbTransition, ivbStartIndex, ivbEndIndex, ivbEffectiveRunHigh, ivbEffectiveRunLow] = resolve_scheduled_profile_chart_state(
     ivbChartState, scheduledProfileTrackOnChart, ivbStartT, ivbEndT, ivbRunHigh, ivbRunLow)

var ScheduledProfileChartState ivbPlusChartState = ScheduledProfileChartState.new()
[ivbPlusTransition, ivbPlusStartIndex, ivbPlusEndIndex, ivbPlusEffectiveRunHigh, ivbPlusEffectiveRunLow] = resolve_scheduled_profile_chart_state(
     ivbPlusChartState, scheduledProfileTrackOnChart, ivbPlusStartT, ivbPlusEndT, ivbPlusRunHigh, ivbPlusRunLow)

var float s1RunHigh = na
var float s1RunLow  = na
var float s2RunHigh = na
var float s2RunLow  = na
var float weeklyProfileRunHigh = na
var float weeklyProfileRunLow = na
var float monthlyProfileRunHigh = na
var float monthlyProfileRunLow = na
int s1PeriodChange = ta.change(time(s1Safe))
int s2PeriodChange = ta.change(time(s2Safe))
int weeklyProfilePeriodChange = ta.change(time(weeklyProfileSafe))
int monthlyProfilePeriodChange = ta.change(time(monthlyProfileSafe))

if s1Valid
    if na(s1RunHigh) or s1PeriodChange != 0
        s1RunHigh := high
        s1RunLow  := low
    else
        s1RunHigh := math.max(s1RunHigh, high)
        s1RunLow  := math.min(s1RunLow,  low)

if s2Valid
    if na(s2RunHigh) or s2PeriodChange != 0
        s2RunHigh := high
        s2RunLow  := low
    else
        s2RunHigh := math.max(s2RunHigh, high)
        s2RunLow  := math.min(s2RunLow,  low)

if weeklyProfileValid
    if na(weeklyProfileRunHigh) or weeklyProfilePeriodChange != 0
        weeklyProfileRunHigh := high
        weeklyProfileRunLow := low
    else
        weeklyProfileRunHigh := math.max(weeklyProfileRunHigh, high)
        weeklyProfileRunLow := math.min(weeklyProfileRunLow, low)

if monthlyProfileValid
    if na(monthlyProfileRunHigh) or monthlyProfilePeriodChange != 0
        monthlyProfileRunHigh := high
        monthlyProfileRunLow := low
    else
        monthlyProfileRunHigh := math.max(monthlyProfileRunHigh, high)
        monthlyProfileRunLow := math.min(monthlyProfileRunLow, low)

// NATIVE DAILY SESSION — rolls at the 18:00 ET reopen regardless of TradingView's
// holiday-merged "D" bar. Shifting +6h maps 18:00 ET to the next NY calendar date.
int  nativeShifted = time + NATIVE_SHIFT_MS
int  nativeTradeId = year(nativeShifted, NY_TIMEZONE) * 10000 + month(nativeShifted, NY_TIMEZONE) * 100 + dayofmonth(nativeShifted, NY_TIMEZONE)
bool nativeNewDay  = ta.change(nativeTradeId) != 0
var int   nativeDayStart = na
var int   nativeDayStartIndex = na
var float nativeOpen     = na
var float nativeRunHigh  = na
var float nativeRunLow   = na
if nativeNewDay or na(nativeDayStart)
    nativeDayStart := time
    nativeDayStartIndex := bar_index
    nativeOpen     := open
    nativeRunHigh  := high
    nativeRunLow   := low
else
    nativeRunHigh := math.max(nativeRunHigh, high)
    nativeRunLow  := math.min(nativeRunLow,  low)

// NATIVE WEEKLY SESSION — rolls at the Sunday 18:00 ET reopen, ignoring TradingView's
// holiday-shifted "W" bar (e.g. a Friday Juneteenth would otherwise break the week early).
bool nativeNewWeek = nativeNewDay and dayofweek(time, NY_TIMEZONE) == dayofweek.sunday
var int   nativeWeekStartT  = na
var int   nativeWeekStartIndex = na
var float nativeWeekOpen    = na
var float nativeWeekRunHigh = na
var float nativeWeekRunLow  = na
if nativeNewWeek or na(nativeWeekStartT)
    nativeWeekStartT  := time
    nativeWeekStartIndex := bar_index
    nativeWeekOpen    := open
    nativeWeekRunHigh := high
    nativeWeekRunLow  := low
else
    nativeWeekRunHigh := math.max(nativeWeekRunHigh, high)
    nativeWeekRunLow  := math.min(nativeWeekRunLow,  low)

// SLOT STATE INSTANCES

new_slot() =>
    SlotState.new(histBoxes=array.new<box>(), fibLines=array.new<line>(), histFibLines=array.new<line>(), fibLabels=array.new<label>(), histFibLabels=array.new<label>(), liquidityDepthLines=array.new<line>(), liquidityDepthLabels=array.new<label>())

new_liquidity_depth_side() =>
    LiquidityDepthSideState.new(activated=false, mitigated=array.new_bool(NUM_LIQUIDITY_DEPTH_LEVELS, false), endTimes=array.new_int(NUM_LIQUIDITY_DEPTH_LEVELS, na), endIndices=array.new_int(NUM_LIQUIDITY_DEPTH_LEVELS, na))

new_liquidity_depth_profile() =>
    LiquidityDepthProfileState.new(history=array.new<LiquidityDepthSessionState>())

var SlotState slot1 = new_slot()
var SlotState slot2 = new_slot()
var SlotState weeklyProfileSlot = new_slot()
var SlotState monthlyProfileSlot = new_slot()
var SlotState dailyProfileSlot = new_slot()
var SlotState overnightSlot = new_slot()
var SlotState nyEarlySlot = new_slot()
var SlotState nyAmSlot = new_slot()
var SlotState ivbSlot = new_slot()
var SlotState ivbPlusSlot = new_slot()
var LiquidityDepthProfileState dailyProfileLiquidityDepthState = new_liquidity_depth_profile()
var LiquidityDepthProfileState overnightLiquidityDepthState = new_liquidity_depth_profile()
var LiquidityDepthProfileState nyEarlyLiquidityDepthState = new_liquidity_depth_profile()
var LiquidityDepthProfileState nyAmLiquidityDepthState = new_liquidity_depth_profile()
var LiquidityDepthProfileState ivbLiquidityDepthState = new_liquidity_depth_profile()
var LiquidityDepthProfileState ivbPlusLiquidityDepthState = new_liquidity_depth_profile()

// DRAWING HELPERS

zone_fill_color(color slotColor) =>
    color.new(slotColor, 85)

forecast_zone_fill_color(color slotColor) =>
    color.new(slotColor, math.min(85 + FORECAST_FILL_TRANSPARENCY_BOOST, 100))

forecast_border_color(color slotColor) =>
    color.new(slotColor, int(math.max(color.t(slotColor), FORECAST_BORDER_MIN_TRANSPARENCY)))

drawing_x(int timeX, int indexX, bool timeBased) =>
    (timeBased or not chart.is_range) ? timeX : math.min(math.max(na(indexX) ? bar_index : indexX, bar_index - BAR_INDEX_DRAWING_LOOKBACK), bar_index + BAR_INDEX_DRAWING_LOOKAHEAD)

drawing_xloc(bool timeBased) =>
    (timeBased or not chart.is_range) ? xloc.bar_time : xloc.bar_index

make_zone_box(bool timeBased, int leftT, int leftIndex, float top, int rightT, int rightIndex, float bottom, color fillClr, color slotColor, string txt, string slotLabelSize, int textTransparency) =>
    box.new(drawing_x(leftT, leftIndex, timeBased), top, drawing_x(rightT, rightIndex, timeBased), bottom,
         bgcolor=fillClr, border_color=na, xloc=drawing_xloc(timeBased),
         text=txt, text_color=color.new(slotColor, textTransparency),
         text_size=get_label_size(slotLabelSize),
         text_halign=text.align_center, text_valign=text.align_center)

make_horizontal_line(bool timeBased, int leftT, int leftIndex, int rightT, int rightIndex, float price, color lineColor, string lineStyle, int lineWidth) =>
    line.new(drawing_x(leftT, leftIndex, timeBased), price, drawing_x(rightT, rightIndex, timeBased), price,
         color=lineColor, style=lineStyle, width=lineWidth, xloc=drawing_xloc(timeBased))

make_fib_label(int anchorT, int anchorIndex, float price, string txt, string labelStyle, color textColor, string labelSize, bool timeBased = false) =>
    label drawing = label.new(drawing_x(anchorT, anchorIndex, timeBased), price, txt, xloc=drawing_xloc(timeBased), style=labelStyle,
         color=color.new(color.white, 100), textcolor=textColor, size=get_label_size(labelSize))
    if labelSize == LBL_EXTRA_TINY
        label.set_size(drawing, 6)
    drawing

// Offsets a label by actual chart bars. This keeps both sides visually symmetric
// across scheduled breaks and weekends where fixed milliseconds drift.
offset_fib_label_time(int anchorT, int anchorIndex, int direction, int offsetBars, int fallbackOffsetMs) =>
    int result = anchorT + direction * fallbackOffsetMs
    if offsetBars > 0
        if anchorT > time and direction > 0
            int anchorBars = na
            for futureBars = 1 to BAR_INDEX_DRAWING_LOOKAHEAD
                int expectedTime = time("", bars_back=-futureBars)
                if na(anchorBars) and not na(expectedTime) and expectedTime >= anchorT
                    anchorBars := futureBars
                if not na(anchorBars) and futureBars == anchorBars + offsetBars
                    result := expectedTime
                    break
        else if not na(anchorIndex)
            int targetIndex = anchorIndex + direction * offsetBars
            int barsBack = bar_index - targetIndex
            if barsBack >= -BAR_INDEX_DRAWING_LOOKAHEAD and barsBack <= BAR_INDEX_DRAWING_LOOKBACK
                int chartTime = time("", bars_back=barsBack)
                if not na(chartTime)
                    result := chartTime
    result

resolve_fib_label_edge(bool rangeChart, bool timeBasedLines, int anchorTime, int anchorIndex, int direction, int offsetBars, int fallbackOffsetMs, int referenceTime) =>
    int labelTime = anchorTime
    int labelIndex = anchorIndex
    bool labelTimeBased = timeBasedLines
    if rangeChart
        bool futureRightEdge = timeBasedLines and direction > 0 and anchorTime > referenceTime
        labelTimeBased := timeBasedLines and (offsetBars == 0 or na(anchorIndex) or futureRightEdge)
        if not labelTimeBased
            labelIndex := anchorIndex + direction * offsetBars
    else
        labelTime := offset_fib_label_time(anchorTime, anchorIndex, direction, offsetBars, fallbackOffsetMs)
    [labelTime, labelIndex, labelTimeBased]

compute_levels(float htfO, float medHO, float meanHO, float medOL, float meanOL) =>
    [htfO + medHO, htfO + meanHO,
     htfO - medOL, htfO - meanOL]

// LIQUIDITY DEPTH CALCULATION

liquidity_depth_anchors(float profileOpen, float medianHighOpen, float meanHighOpen, float medianOpenLow, float meanOpenLow) =>
    float medianUpper = profileOpen + medianHighOpen
    float meanUpper = profileOpen + meanHighOpen
    float medianLower = profileOpen - medianOpenLow
    float meanLower = profileOpen - meanOpenLow
    [math.max(medianUpper, meanUpper), math.min(medianLower, meanLower)]

liquidity_depth_price(float anchorPrice, bool isHigh, int levelIndex, float depthStep) =>
    float depthOffset = (levelIndex + 1) * depthStep
    isHigh ? anchorPrice + depthOffset : anchorPrice - depthOffset

liquidity_depth_cutoff_time(int sessionStartTime) =>
    int cutoffDayOffset = hour(sessionStartTime, NY_TIMEZONE) >= MARKET_CLOSE_HOUR ? 1 : 0
    timestamp(NY_TIMEZONE, year(sessionStartTime, NY_TIMEZONE), month(sessionStartTime, NY_TIMEZONE), dayofmonth(sessionStartTime, NY_TIMEZONE) + cutoffDayOffset, MARKET_CLOSE_HOUR, 0, 0)

liquidity_depth_end_time(int sessionEndTime, int storedEndTime) =>
    na(storedEndTime) ? sessionEndTime : storedEndTime

// LIQUIDITY DEPTH STATE

new_liquidity_depth_session(int sessionStartTime, int sessionStartIndex, int sessionEndTime, float highAnchor, float lowAnchor) =>
    LiquidityDepthSessionState.new(
         sessionStartTime=sessionStartTime,
         sessionStartIndex=sessionStartIndex,
         sessionEndTime=sessionEndTime,
         highAnchor=highAnchor,
         lowAnchor=lowAnchor,
         cutoffTime=liquidity_depth_cutoff_time(sessionStartTime),
         highSide=new_liquidity_depth_side(),
         lowSide=new_liquidity_depth_side())

update_liquidity_depth_side(LiquidityDepthSideState sideState, float anchorPrice, bool isHigh, float barExtreme, bool activationAllowed, int eventTime, int eventIndex, float depthStep) =>
    bool boundaryReached = isHigh ? barExtreme >= anchorPrice : barExtreme <= anchorPrice
    if activationAllowed and not sideState.activated and boundaryReached
        sideState.activated := true
        sideState.activationTime := eventTime
        sideState.activationIndex := eventIndex
    if sideState.activated
        for levelIndex = 0 to NUM_LIQUIDITY_DEPTH_LEVELS - 1
            if not array.get(sideState.mitigated, levelIndex)
                float levelPrice = liquidity_depth_price(anchorPrice, isHigh, levelIndex, depthStep)
                bool levelReached = isHigh ? barExtreme >= levelPrice : barExtreme <= levelPrice
                if levelReached
                    array.set(sideState.mitigated, levelIndex, true)
                    array.set(sideState.endTimes, levelIndex, eventTime)
                    array.set(sideState.endIndices, levelIndex, eventIndex)

finalize_liquidity_depth_side(LiquidityDepthSideState sideState, LiquidityDepthSessionState sessionState) =>
    if sideState.activated
        int finalTime = chart.is_range ? nz(sessionState.lastEligibleTime, sideState.activationTime) : sessionState.cutoffTime
        int finalIndex = nz(sessionState.lastEligibleIndex, sideState.activationIndex)
        for levelIndex = 0 to NUM_LIQUIDITY_DEPTH_LEVELS - 1
            if na(array.get(sideState.endTimes, levelIndex))
                array.set(sideState.endTimes, levelIndex, finalTime)
                array.set(sideState.endIndices, levelIndex, finalIndex)

finalize_liquidity_depth_session(LiquidityDepthSessionState sessionState) =>
    finalize_liquidity_depth_side(sessionState.highSide, sessionState)
    finalize_liquidity_depth_side(sessionState.lowSide, sessionState)

update_liquidity_depth_profile(LiquidityDepthProfileState profileState, ScheduledProfileRuntime profileRuntime, int historyLimit, bool depthActive, float depthStep) =>
    bool anchorsReady = not na(profileRuntime.sessionOpen) and not na(profileRuntime.medianHighOpen) and not na(profileRuntime.meanHighOpen) and not na(profileRuntime.medianOpenLow) and not na(profileRuntime.meanOpenLow)
    if depthActive and anchorsReady and not na(profileRuntime.startTime)
        bool newSession = na(profileState.currentSession) or profileState.currentSession.sessionStartTime != profileRuntime.startTime
        if newSession
            if not na(profileState.currentSession)
                finalize_liquidity_depth_session(profileState.currentSession)
                array.push(profileState.history, profileState.currentSession)
            [highAnchor, lowAnchor] = liquidity_depth_anchors(profileRuntime.sessionOpen, profileRuntime.medianHighOpen, profileRuntime.meanHighOpen, profileRuntime.medianOpenLow, profileRuntime.meanOpenLow)
            profileState.currentSession := new_liquidity_depth_session(profileRuntime.startTime, profileRuntime.startIndex, profileRuntime.endTime, highAnchor, lowAnchor)
            while array.size(profileState.history) > math.max(0, historyLimit - 1)
                array.shift(profileState.history)

        LiquidityDepthSessionState currentSession = profileState.currentSession
        if time <= currentSession.cutoffTime
            currentSession.lastEligibleTime := time
            currentSession.lastEligibleIndex := bar_index
        bool profileStarted = time >= currentSession.sessionStartTime or (chart.is_range and not na(time_close) and time_close > currentSession.sessionStartTime)
        bool trackingWindowOpen = profileStarted and time < currentSession.cutoffTime
        bool activationWindowOpen = trackingWindowOpen and time < profileRuntime.endTime
        if trackingWindowOpen
            update_liquidity_depth_side(currentSession.highSide, currentSession.highAnchor, true, high, activationWindowOpen, time, bar_index, depthStep)
            update_liquidity_depth_side(currentSession.lowSide, currentSession.lowAnchor, false, low, activationWindowOpen, time, bar_index, depthStep)
        if time >= currentSession.cutoffTime
            finalize_liquidity_depth_session(currentSession)

liquidity_depth_level_color(int levelIndex, color profileColor) =>
    levelIndex == 0 ? profileColor : DEFAULT_LIQUIDITY_DEPTH_EXTENSION_COLOR

liquidity_depth_level_width(int levelIndex) =>
    levelIndex == 0 ? 2 : levelIndex == 2 ? 3 : 1

liquidity_depth_level_style(int levelIndex) =>
    levelIndex == 0 ? line.style_dashed : line.style_dotted

// LIQUIDITY DEPTH RENDERING

liquidity_depth_label_text(int levelIndex, string profileName) =>
    string levelText = "L" + str.tostring(levelIndex + 1)
    showLiquidityDepthProfileNames ? levelText + " " + profileName : levelText

liquidity_depth_profile_name(string sourceLabel) =>
    sourceLabel == OVERNIGHT_CHART_LABEL ? OVERNIGHT_SLOT_NAME : sourceLabel

make_liquidity_depth_connector(bool timeBased, int anchorTime, int anchorIndex, float anchorPrice, float levelPrice, color profileColor) =>
    int safeIndex = math.max(anchorIndex, bar_index - BAR_INDEX_DRAWING_LOOKBACK)
    line.new(drawing_x(anchorTime, safeIndex, timeBased), anchorPrice, drawing_x(anchorTime, safeIndex, timeBased), levelPrice,
         xloc=drawing_xloc(timeBased), color=color.new(profileColor, 80), width=1, style=line.style_dashed)

make_liquidity_depth_label(bool timeBased, int startTime, int startIndex, int endTime, int endIndex, float levelPrice, string labelText) =>
    int labelTime = startTime + int((endTime - startTime) / 2)
    int labelIndex = startIndex + int((endIndex - startIndex) / 2)
    label.new(drawing_x(labelTime, labelIndex, timeBased), levelPrice, labelText,
         xloc=drawing_xloc(timeBased), yloc=yloc.price, style=label.style_label_center,
         textcolor=DEFAULT_LIQUIDITY_DEPTH_LABEL_TEXT, size=6, color=DEFAULT_LIQUIDITY_DEPTH_LABEL_BACKGROUND)

draw_liquidity_depth_side(SlotState slotState, LiquidityDepthSessionState sessionState, LiquidityDepthSideState sideState, bool isHigh, float depthStep, color profileColor, string profileName, bool forecastEnabled) =>
    if sideState.activated or forecastEnabled
        int startTime = sessionState.sessionStartTime
        int startIndex = sessionState.sessionStartIndex
        float anchorPrice = isHigh ? sessionState.highAnchor : sessionState.lowAnchor
        for levelIndex = 0 to NUM_LIQUIDITY_DEPTH_LEVELS - 1
            int storedEndTime = array.get(sideState.endTimes, levelIndex)
            int storedEndIndex = array.get(sideState.endIndices, levelIndex)
            bool projectToSessionEnd = na(storedEndTime)
            int endTime = liquidity_depth_end_time(sessionState.sessionEndTime, storedEndTime)
            int liveEndIndex = sessionState.cutoffTime <= time ? nz(sessionState.lastEligibleIndex, bar_index) : bar_index
            int endIndex = na(storedEndIndex) ? liveEndIndex : storedEndIndex
            float levelPrice = liquidity_depth_price(anchorPrice, isHigh, levelIndex, depthStep)
            color levelColor = liquidity_depth_level_color(levelIndex, profileColor)
            array.push(slotState.liquidityDepthLines, make_horizontal_line(projectToSessionEnd, startTime, startIndex, endTime, endIndex, levelPrice, levelColor, liquidity_depth_level_style(levelIndex), liquidity_depth_level_width(levelIndex)))
            array.push(slotState.liquidityDepthLines, make_liquidity_depth_connector(projectToSessionEnd, startTime, startIndex, anchorPrice, levelPrice, profileColor))
            array.push(slotState.liquidityDepthLabels, make_liquidity_depth_label(projectToSessionEnd, startTime, startIndex, endTime, endIndex, levelPrice, liquidity_depth_label_text(levelIndex, profileName)))

draw_liquidity_depth_profile(SlotState slotState, LiquidityDepthProfileState profileState, ScheduledProfileConfig profileConfig, bool depthActive, bool currentVisible, float depthStep, int historyCap, bool forecastEnabled) =>
    while array.size(slotState.liquidityDepthLines) > 0
        line.delete(array.pop(slotState.liquidityDepthLines))
    while array.size(slotState.liquidityDepthLabels) > 0
        label.delete(array.pop(slotState.liquidityDepthLabels))
    if depthActive
        string profileName = liquidity_depth_profile_name(profileConfig.sourceLabel)
        if currentVisible and not na(profileState.currentSession)
            draw_liquidity_depth_side(slotState, profileState.currentSession, profileState.currentSession.highSide, true, depthStep, profileConfig.slotColor, profileName, forecastEnabled)
            draw_liquidity_depth_side(slotState, profileState.currentSession, profileState.currentSession.lowSide, false, depthStep, profileConfig.slotColor, profileName, forecastEnabled)
        int count = math.min(historyCap, array.size(profileState.history))
        if count > 0
            for historyOffset = 0 to count - 1
                int historyIndex = array.size(profileState.history) - 1 - historyOffset
                LiquidityDepthSessionState historySession = array.get(profileState.history, historyIndex)
                draw_liquidity_depth_side(slotState, historySession, historySession.highSide, true, depthStep, profileConfig.slotColor, profileName, forecastEnabled)
                draw_liquidity_depth_side(slotState, historySession, historySession.lowSide, false, depthStep, profileConfig.slotColor, profileName, forecastEnabled)

format_fib_ratio(string ratioText, bool superscript) =>
    string formatted = ratioText
    if superscript
        array<string> digits = array.from("⁰", "¹", "²", "³", "⁴", "⁵", "⁶", "⁷", "⁸", "⁹")
        for digit = 0 to 9
            formatted := str.replace_all(formatted, str.tostring(digit), array.get(digits, digit))
        formatted := str.replace_all(formatted, ".", "·")
    formatted

// Pushes one line per visible fib level into `target`. Anchors define 0% / 100% of the fib range.
push_fib_lines(array<line> target, bool timeBasedLines, int leftT, int leftIndex, int rightT, int rightIndex, float anchorHigh, float anchorLow, int transparencyBoost,
               FibLevelSet fibLevelSet, FibPalette fibPalette, array<label> labelTarget, string tfLabel, bool drawLabels, string labelSize, string labelPos, int labelOffsetMs, int labelOffsetBars) =>
    if not na(anchorHigh) and not na(anchorLow)
        float fibRange = anchorHigh - anchorLow
        bool keyOnly = fibLabelLevels == FL_KEY
        [rightLabelTime, rightLabelIndex, rightLabelTimeBased] = resolve_fib_label_edge(chart.is_range, timeBasedLines, rightT, rightIndex, 1, labelOffsetBars, labelOffsetMs, time)
        [leftLabelTime, leftLabelIndex, leftLabelTimeBased] = resolve_fib_label_edge(chart.is_range, timeBasedLines, leftT, leftIndex, -1, labelOffsetBars, labelOffsetMs, time)

        for levelIndex = 0 to array.size(fibPalette.ratios) - 1
            if array.get(fibLevelSet.visibleLevels, levelIndex)
                float ratio = array.get(fibPalette.ratios, levelIndex)
                float price = anchorLow + fibRange * ratio
                color baseClr = array.get(fibPalette.levelColors, levelIndex)
                // Clamp at 95 so higher-tier slots never become fully invisible.
                color clr     = color.new(baseClr, math.min(int(color.t(baseClr)) + transparencyBoost, 95))
                line fibLine = make_horizontal_line(timeBasedLines, leftT, leftIndex, rightT, rightIndex, price, clr, line.style_dotted, array.get(fibLevelSet.lineWidths, levelIndex))
                array.push(target, fibLine)

                if drawLabels and (not keyOnly or array.get(fibPalette.keyLevels, levelIndex)) and (labelPos != POS_CENTER or (ratio != FIB_LEVEL_0 and ratio != FIB_LEVEL_100))
                    // Tint label text to match its line, but pull transparency down so faint levels stay legible.
                    color  txtClr  = color.new(baseClr, math.min(FIB_LABEL_TRANSPARENCY_MAX, math.max(0.0, color.t(baseClr) - FIB_LABEL_TRANSPARENCY_REDUCTION)))
                    string lblText = tfLabel + " • " + format_fib_ratio(array.get(fibPalette.ratioTexts, levelIndex), fibLabelSuperscript)
                    // Offset pushes each tag outward from its anchor edge (right tags later, left tags earlier)
                    // so slots whose zones end on the same bar don't stack their tags on one x-coordinate.
                    if labelPos == POS_RIGHT or labelPos == POS_BOTH
                        array.push(labelTarget, make_fib_label(rightLabelTime, rightLabelIndex, price, lblText, label.style_label_left, txtClr, labelSize, rightLabelTimeBased))
                    if labelPos == POS_LEFT or labelPos == POS_BOTH
                        array.push(labelTarget, make_fib_label(leftLabelTime, leftLabelIndex, price, lblText, label.style_label_right, txtClr, labelSize, leftLabelTimeBased))
                    if labelPos == POS_CENTER
                        int centerX = line.get_x1(fibLine) + int((line.get_x2(fibLine) - line.get_x1(fibLine)) / 2)
                        array.push(labelTarget, make_fib_label(centerX, centerX, price, lblText, label.style_none, txtClr, labelSize, timeBasedLines))

draw_slot_fib(SlotState s, int leftT, int leftIndex, int rightT, int rightIndex, float anchorHigh, float anchorLow, int transparencyBoost, FibLevelSet fibLevelSet, FibPalette fibPalette, string tfLabel, bool drawLabels, string labelSize, string labelPos, int labelOffsetMs, int labelOffsetBars) =>
    push_fib_lines(s.fibLines, true, leftT, leftIndex, rightT, rightIndex, anchorHigh, anchorLow, transparencyBoost, fibLevelSet, fibPalette, s.fibLabels, tfLabel, drawLabels, labelSize, labelPos, labelOffsetMs, labelOffsetBars)

slot_forecast_right_time(string safe, int currentRightTime) =>
    int fixedDurationRightTime = currentRightTime + timeframe.in_seconds(safe) * MS_PER_SEC
    int calendarRightTime = timeframe.in_seconds(safe) >= SECS_4_WEEKS ? time_close(timeframe=safe, timeframe_bars_back=-1) : na
    nz(calendarRightTime, fixedDurationRightTime)

// Resolves a slot's rollover, dual-coordinate anchors, and effective open/run-high/low.
resolve_slot_timing(string safe, float normOpen, float normRunHigh, float normRunLow,
                    bool nNewDay, int nDayStart, int nDayStartIndex, int nDayEnd, float nOpen, float nRunHigh, float nRunLow,
                    bool nNewWeek, int nWeekStart, int nWeekStartIndex, float nwOpen, float nwRunHigh, float nwRunLow) =>
    bool isDaily   = timeframe.in_seconds(safe) == SECS_DAY
    bool isWeekly  = timeframe.in_seconds(safe) == SECS_WEEK
    int  normStart = time(safe)
    int  fixedDurationRight = normStart + timeframe.in_seconds(safe) * MS_PER_SEC
    int  calendarRight = timeframe.in_seconds(safe) >= SECS_4_WEEKS ? time_close(timeframe=safe) : na
    int  normRight = nz(calendarRight, fixedDurationRight)
    bool normTrans = ta.change(time(safe)) != 0
    int  normStartIndex = nz(ta.valuewhen(normTrans, bar_index, 0), 0)
    if isDaily and holidayMode == HOLIDAY_NATIVE
        [nNewDay, nDayStart, nDayStartIndex, nDayEnd, nOpen, nRunHigh, nRunLow]
    else if isWeekly and holidayMode == HOLIDAY_NATIVE
        [nNewWeek, nWeekStart, nWeekStartIndex, nWeekStart + SECS_WEEK * MS_PER_SEC, nwOpen, nwRunHigh, nwRunLow]
    else if isDaily and holidayMode == HOLIDAY_EXTEND
        [normTrans, normStart, normStartIndex, (normRight > time ? normRight : time), normOpen, normRunHigh, normRunLow]
    else
        [normTrans, normStart, normStartIndex, normRight, normOpen, normRunHigh, normRunLow]

fib_label_count_per_zone(FibLevelSet fibLevelSet, FibPalette fibPalette, bool labelsEnabled, string labelPosition) =>
    int labelCount = 0
    bool keyOnly = fibLabelLevels == FL_KEY
    if labelsEnabled and fibLabelLevels != FL_OFF
        for levelIndex = 0 to array.size(fibPalette.ratios) - 1
            float ratio = array.get(fibPalette.ratios, levelIndex)
            bool levelEligible = array.get(fibLevelSet.visibleLevels, levelIndex) and (not keyOnly or array.get(fibPalette.keyLevels, levelIndex)) and (labelPosition != POS_CENTER or (ratio != FIB_LEVEL_0 and ratio != FIB_LEVEL_100))
            labelCount += levelEligible ? (labelPosition == POS_BOTH ? 2 : 1) : 0
    labelCount

current_line_request(bool valid, int fibLinesPerZone) =>
    valid ? 4 + fibLinesPerZone : 0

history_zone_request(bool latestOnlyEnabled, int historyN) =>
    latestOnlyEnabled ? 0 : math.max(0, historyN - 1)

fib_history_zone_request(bool latestOnlyEnabled, int historyN, int fibHistoryN) =>
    math.min(history_zone_request(latestOnlyEnabled, historyN), fibHistoryN)

max_requested_history_layers(array<int> historyRequests, int historyLimit) =>
    int requestedLayers = 0
    int requestCount = array.size(historyRequests)
    if requestCount > 0
        for requestIndex = 0 to requestCount - 1
            requestedLayers := math.max(requestedLayers, array.get(historyRequests, requestIndex))
    math.min(historyLimit, requestedLayers)

allocate_history_zone_caps(int availableZones, array<bool> validSlots, array<int> zoneRequests, int ordinarySlotCount, int maxHistoryZones) =>
    int slotCount = array.size(validSlots)
    array<int> zoneCaps = array.new<int>(slotCount, 0)
    int remaining = availableZones
    int requestedLayers = max_requested_history_layers(zoneRequests, maxHistoryZones)
    if requestedLayers > 0
        for layer = 1 to requestedLayers
            for slotIndex = 0 to ordinarySlotCount - 1
                if array.get(validSlots, slotIndex) and layer <= array.get(zoneRequests, slotIndex) and remaining > 0
                    array.set(zoneCaps, slotIndex, array.get(zoneCaps, slotIndex) + 1)
                    remaining -= 1
        for layer = 1 to requestedLayers
            for slotIndex = ordinarySlotCount to slotCount - 1
                if array.get(validSlots, slotIndex) and layer <= array.get(zoneRequests, slotIndex) and remaining > 0
                    array.set(zoneCaps, slotIndex, array.get(zoneCaps, slotIndex) + 1)
                    remaining -= 1
    zoneCaps

allocate_history_fib_caps(int availableLines, int availableLabels, array<bool> validSlots, array<int> fibZoneRequests,
                          array<int> fibLinesPerZoneBySlot, array<bool> labelSlots, array<int> labelsPerZone,
                          int ordinarySlotCount, int maxHistoryZones) =>
    int slotCount = array.size(validSlots)
    array<int> fibCaps = array.new<int>(slotCount, 0)
    array<int> labelCaps = array.new<int>(slotCount, 0)
    int remainingLines = availableLines
    int remainingLabels = availableLabels
    int requestedLayers = max_requested_history_layers(fibZoneRequests, maxHistoryZones)
    if requestedLayers > 0
        for layer = 1 to requestedLayers
            for slotIndex = 0 to ordinarySlotCount - 1
                if array.get(validSlots, slotIndex)
                    int fibLinesPerZone = array.get(fibLinesPerZoneBySlot, slotIndex)
                    int zoneLabels = array.get(labelSlots, slotIndex) ? array.get(labelsPerZone, slotIndex) : 0
                    bool labelBudgetAvailable = zoneLabels == 0 or remainingLabels >= zoneLabels
                    if fibLinesPerZone > 0 and layer <= array.get(fibZoneRequests, slotIndex) and remainingLines >= fibLinesPerZone and labelBudgetAvailable
                        array.set(fibCaps, slotIndex, array.get(fibCaps, slotIndex) + fibLinesPerZone)
                        remainingLines -= fibLinesPerZone
                        if zoneLabels > 0
                            array.set(labelCaps, slotIndex, array.get(labelCaps, slotIndex) + zoneLabels)
                            remainingLabels -= zoneLabels
        for layer = 1 to requestedLayers
            for slotIndex = ordinarySlotCount to slotCount - 1
                if array.get(validSlots, slotIndex)
                    int fibLinesPerZone = array.get(fibLinesPerZoneBySlot, slotIndex)
                    int zoneLabels = array.get(labelSlots, slotIndex) ? array.get(labelsPerZone, slotIndex) : 0
                    bool labelBudgetAvailable = zoneLabels == 0 or remainingLabels >= zoneLabels
                    if fibLinesPerZone > 0 and layer <= array.get(fibZoneRequests, slotIndex) and remainingLines >= fibLinesPerZone and labelBudgetAvailable
                        array.set(fibCaps, slotIndex, array.get(fibCaps, slotIndex) + fibLinesPerZone)
                        remainingLines -= fibLinesPerZone
                        if zoneLabels > 0
                            array.set(labelCaps, slotIndex, array.get(labelCaps, slotIndex) + zoneLabels)
                            remainingLabels -= zoneLabels
    [fibCaps, labelCaps]

allocate_history_liquidity_depth_caps(int availableLines, int availableLabels, array<bool> depthValids, array<int> historyRequests) =>
    int profileCount = array.size(depthValids)
    array<int> historyCaps = array.new<int>(profileCount, 0)
    int remainingLines = availableLines
    int remainingLabels = availableLabels
    int requestedLayers = max_requested_history_layers(historyRequests, SLOT_HISTORY_MAX)
    if requestedLayers > 0
        for layer = 1 to requestedLayers
            for profileIndex = 0 to profileCount - 1
                bool canAllocate = array.get(depthValids, profileIndex) and layer <= array.get(historyRequests, profileIndex) and remainingLines >= LIQUIDITY_DEPTH_LINES_PER_SESSION and remainingLabels >= LIQUIDITY_DEPTH_LABELS_PER_SESSION
                if canAllocate
                    array.set(historyCaps, profileIndex, array.get(historyCaps, profileIndex) + 1)
                    remainingLines -= LIQUIDITY_DEPTH_LINES_PER_SESSION
                    remainingLabels -= LIQUIDITY_DEPTH_LABELS_PER_SESSION
    [historyCaps, availableLines - remainingLines, availableLabels - remainingLabels]

// On transition, [1] reads give us the just-closed period values used for its live projection.
update_slot(SlotState s, bool valid, bool transitionNow, int zoneStartT, int zoneStartIndex, bool fixedEnd, int zoneEndT, int zoneEndIndex,
             float htfO, float archivedRunHigh, float archivedRunLow, color slotColor, string htfLabel,
             float medHO, float meanHO, float medOL, float meanOL,
             int boxHistZoneCap, string slotLabelSize,
             int fibFade, FibLevelSet fibLevelSet, FibPalette fibPalette, int fibHistCap,
             bool histLabelsEnabled, int histLabelCap, int histLabelsPerZone, string histLabelSize, string histLabelPos, int histLabelOffsetMs, int histLabelOffsetBars) =>
    int fibLinesPerZone = fibLevelSet.lineCount
    int boxHistCap = valid ? boxHistZoneCap * 2 : 0
    while array.size(s.histBoxes) > boxHistCap
        box.delete(array.shift(s.histBoxes))
    while array.size(s.histFibLines) > fibHistCap
        line.delete(array.shift(s.histFibLines))
    while array.size(s.histFibLabels) > histLabelCap
        label.delete(array.shift(s.histFibLabels))

    if valid and transitionNow
        float prevO = htfO[1]
        float prevMedHO = medHO[1]
        float prevMeanHO = meanHO[1]
        float prevMedOL = medOL[1]
        float prevMeanOL = meanOL[1]

        if not na(prevO) and not na(prevMedHO) and not na(prevMedOL)
            [historyInnerHigh, historyOuterHigh, historyInnerLow, historyOuterLow] = compute_levels(prevO, prevMedHO, prevMeanHO, prevMedOL, prevMeanOL)
            int historyLeftTime = zoneStartT[1]
            int historyRightTime = fixedEnd ? zoneEndT[1] : zoneStartT
            int historyLeftIndex = zoneStartIndex[1]
            int historyRightIndex = fixedEnd ? zoneEndIndex[1] : zoneStartIndex

            if boxHistCap > 0
                color fillColor = zone_fill_color(slotColor)
                while array.size(s.histBoxes) > boxHistCap - 2
                    box.delete(array.shift(s.histBoxes))
                array.push(s.histBoxes, make_zone_box(false, historyLeftTime, historyLeftIndex, historyOuterHigh, historyRightTime, historyRightIndex, historyInnerHigh, fillColor, slotColor, "", slotLabelSize, LABEL_TEXT_TRANSPARENCY))
                array.push(s.histBoxes, make_zone_box(false, historyLeftTime, historyLeftIndex, historyInnerLow, historyRightTime, historyRightIndex, historyOuterLow, fillColor, slotColor, "", slotLabelSize, LABEL_TEXT_TRANSPARENCY))

            if fibHistCap >= fibLinesPerZone and fibLinesPerZone > 0
                while array.size(s.histFibLines) > fibHistCap - fibLinesPerZone
                    line.delete(array.shift(s.histFibLines))
                float historyAnchorHigh = fibTrailing ? math.max(historyOuterHigh, archivedRunHigh) : historyOuterHigh
                float historyAnchorLow = fibTrailing ? math.min(historyOuterLow, archivedRunLow) : historyOuterLow
                if histLabelsEnabled and histLabelsPerZone > 0 and histLabelCap >= histLabelsPerZone
                    while array.size(s.histFibLabels) > histLabelCap - histLabelsPerZone
                        label.delete(array.shift(s.histFibLabels))
                push_fib_lines(s.histFibLines, false, historyLeftTime, historyLeftIndex, historyRightTime, historyRightIndex, historyAnchorHigh, historyAnchorLow, fibFade, fibLevelSet, fibPalette, s.histFibLabels, htfLabel, histLabelsEnabled and histLabelCap >= histLabelsPerZone, histLabelSize, histLabelPos, histLabelOffsetMs, histLabelOffsetBars)

draw_slot_current(SlotState s, bool valid, int curLeftT, int curLeftIndex, int curRightT, int curRightIndex, float htfO, float htfH, float htfL, color slotColor, string identifierText, string fibLabelPrefix,
                   float medHO, float meanHO, float medOL, float meanOL,
                   string slotLabelSize, FibLevelSet fibLevelSet, FibPalette fibPalette, int fibTransparencyBoost, bool labelSlotEnabled, string fibLabelSize, string fibLabelPos, int fibLabelOffsetMs, int fibLabelOffsetBars) =>
    // Null after delete so toggling a feature off mid-period leaves no dangling handle.
    if not na(s.fillUp)
        box.delete(s.fillUp)
        s.fillUp := na
    if not na(s.fillLo)
        box.delete(s.fillLo)
        s.fillLo := na
    if not na(s.innH)
        line.delete(s.innH)
        s.innH := na
    if not na(s.innL)
        line.delete(s.innL)
        s.innL := na
    if not na(s.outH)
        line.delete(s.outH)
        s.outH := na
    if not na(s.outL)
        line.delete(s.outL)
        s.outL := na
    while array.size(s.fibLines) > 0
        line.delete(array.pop(s.fibLines))
    while array.size(s.fibLabels) > 0
        label.delete(array.pop(s.fibLabels))

    if valid and not na(medHO) and not na(medOL)
        [innerHigh, outerHigh, innerLow, outerLow] = compute_levels(htfO, medHO, meanHO, medOL, meanOL)

        color fillClr = zone_fill_color(slotColor)
        s.fillUp := make_zone_box(true, curLeftT, curLeftIndex, outerHigh, curRightT, curRightIndex, innerHigh, fillClr, slotColor, identifierText, slotLabelSize, LABEL_TEXT_TRANSPARENCY)
        s.fillLo := make_zone_box(true, curLeftT, curLeftIndex, innerLow, curRightT, curRightIndex, outerLow, fillClr, slotColor, identifierText, slotLabelSize, LABEL_TEXT_TRANSPARENCY)

        s.innH := make_horizontal_line(true, curLeftT, curLeftIndex, curRightT, curRightIndex, innerHigh, slotColor, line.style_solid, 1)
        s.innL := make_horizontal_line(true, curLeftT, curLeftIndex, curRightT, curRightIndex, innerLow, slotColor, line.style_solid, 1)
        s.outH := make_horizontal_line(true, curLeftT, curLeftIndex, curRightT, curRightIndex, outerHigh, slotColor, line.style_solid, 1)
        s.outL := make_horizontal_line(true, curLeftT, curLeftIndex, curRightT, curRightIndex, outerLow, slotColor, line.style_solid, 1)

        if fibLevelSet.lineCount > 0
            float fibAnchorHigh = fibTrailing ? math.max(outerHigh, htfH) : outerHigh
            float fibAnchorLow  = fibTrailing ? math.min(outerLow,  htfL) : outerLow
            draw_slot_fib(s, curLeftT, curLeftIndex, curRightT, curRightIndex, fibAnchorHigh, fibAnchorLow, fibTransparencyBoost, fibLevelSet, fibPalette, fibLabelPrefix, labelSlotEnabled, fibLabelSize, fibLabelPos, fibLabelOffsetMs, fibLabelOffsetBars)

draw_slot_forecast(SlotState s, bool valid, int forecastLeftT, int forecastRightT,
                   float htfO, float htfH, float htfL, color slotColor, string identifierText, string slotLabelSize,
                   float medHO, float meanHO, float medOL, float meanOL) =>
    if not na(s.forecastFillUp)
        box.delete(s.forecastFillUp)
        s.forecastFillUp := na
    if not na(s.forecastFillLo)
        box.delete(s.forecastFillLo)
        s.forecastFillLo := na
    if not na(s.forecastInnH)
        line.delete(s.forecastInnH)
        s.forecastInnH := na
    if not na(s.forecastInnL)
        line.delete(s.forecastInnL)
        s.forecastInnL := na
    if not na(s.forecastOutH)
        line.delete(s.forecastOutH)
        s.forecastOutH := na
    if not na(s.forecastOutL)
        line.delete(s.forecastOutL)
        s.forecastOutL := na

    if valid and not na(htfO) and not na(medHO) and not na(meanHO) and not na(medOL) and not na(meanOL)
        [referenceInnerHigh, referenceOuterHigh, referenceInnerLow, referenceOuterLow] = compute_levels(htfO, medHO, meanHO, medOL, meanOL)
        float highestExit = math.max(referenceInnerHigh, referenceOuterHigh)
        float lowestExit = math.min(referenceInnerLow, referenceOuterLow)
        if not na(htfH)
            highestExit := math.max(highestExit, htfH)
        if not na(htfL)
            lowestExit := math.min(lowestExit, htfL)

        float forecastInnerHigh = highestExit + math.min(medHO, meanHO)
        float forecastOuterHigh = highestExit + math.max(medHO, meanHO)
        float forecastInnerLow = lowestExit - math.min(medOL, meanOL)
        float forecastOuterLow = lowestExit - math.max(medOL, meanOL)
        color fillColor = forecast_zone_fill_color(slotColor)
        color borderColor = forecast_border_color(slotColor)

        s.forecastFillUp := make_zone_box(true, forecastLeftT, na, forecastOuterHigh, forecastRightT, na, forecastInnerHigh, fillColor, slotColor, identifierText, slotLabelSize, FORECAST_LABEL_TEXT_TRANSPARENCY)
        s.forecastFillLo := make_zone_box(true, forecastLeftT, na, forecastInnerLow, forecastRightT, na, forecastOuterLow, fillColor, slotColor, identifierText, slotLabelSize, FORECAST_LABEL_TEXT_TRANSPARENCY)

        s.forecastInnH := make_horizontal_line(true, forecastLeftT, na, forecastRightT, na, forecastInnerHigh, borderColor, line.style_dashed, 1)
        s.forecastInnL := make_horizontal_line(true, forecastLeftT, na, forecastRightT, na, forecastInnerLow, borderColor, line.style_dashed, 1)
        s.forecastOutH := make_horizontal_line(true, forecastLeftT, na, forecastRightT, na, forecastOuterHigh, borderColor, line.style_dashed, 1)
        s.forecastOutL := make_horizontal_line(true, forecastLeftT, na, forecastRightT, na, forecastOuterLow, borderColor, line.style_dashed, 1)

update_scheduled_profile(SlotState slot, ScheduledProfileConfig profileConfig, ScheduledProfileRuntime profileRuntime,
                     FibPalette fibPalette, int boxHistoryCap, int fibHistoryCap,
                     bool historyLabelsEnabled, int historyLabelCap, int labelsPerZone,
                     int labelOffsetMilliseconds, int labelOffsetBars) =>
    update_slot(slot, profileRuntime.valid, profileRuntime.transition,
         profileRuntime.startTime, profileRuntime.startIndex, true, profileRuntime.endTime, profileRuntime.endIndex,
         profileRuntime.sessionOpen, profileRuntime.completedHigh, profileRuntime.completedLow,
         profileConfig.slotColor, profileConfig.sourceLabel,
         profileRuntime.medianHighOpen, profileRuntime.meanHighOpen, profileRuntime.medianOpenLow, profileRuntime.meanOpenLow,
         boxHistoryCap, profileConfig.slotLabelSize,
         profileConfig.fibFade, profileConfig.fibLevelSet, fibPalette, fibHistoryCap,
         historyLabelsEnabled, historyLabelCap, labelsPerZone, profileConfig.fibLabelSize,
         profileConfig.fibLabelPosition, labelOffsetMilliseconds, labelOffsetBars)

draw_scheduled_profile_current(SlotState slot, ScheduledProfileConfig profileConfig, ScheduledProfileRuntime profileRuntime, bool currentVisible,
                           string identifierText, int currentRightIndex,
                           FibPalette fibPalette, bool fibLabelsEnabled, int labelOffsetMilliseconds, int labelOffsetBars) =>
    int sessionRightIndex = not na(profileRuntime.endIndex) ? profileRuntime.endIndex : currentRightIndex
    draw_slot_current(slot, currentVisible,
         profileRuntime.startTime, profileRuntime.startIndex, profileRuntime.endTime, sessionRightIndex,
         profileRuntime.sessionOpen, profileRuntime.currentHigh, profileRuntime.currentLow,
         profileConfig.slotColor, identifierText, profileConfig.sourceLabel,
         profileRuntime.medianHighOpen, profileRuntime.meanHighOpen, profileRuntime.medianOpenLow, profileRuntime.meanOpenLow,
         profileConfig.slotLabelSize, profileConfig.fibLevelSet, fibPalette, profileConfig.fibFade,
         fibLabelsEnabled, profileConfig.fibLabelSize, profileConfig.fibLabelPosition,
         labelOffsetMilliseconds, labelOffsetBars)

draw_scheduled_profile_forecast(SlotState slot, ScheduledProfileConfig profileConfig, ScheduledProfileRuntime profileRuntime, string identifierText) =>
    draw_slot_forecast(slot, profileRuntime.forecastVisible,
         profileRuntime.forecastStartTime, profileRuntime.forecastEndTime,
         profileRuntime.sessionOpen, profileRuntime.currentHigh, profileRuntime.currentLow,
         profileConfig.slotColor, identifierText, profileConfig.slotLabelSize,
         profileRuntime.medianHighOpen, profileRuntime.meanHighOpen, profileRuntime.medianOpenLow, profileRuntime.meanOpenLow)


// DISPATCH — every bar maintains state per slot

[s1Trans, s1StartT, s1StartIndex, s1CurRightT, s1OEff, s1RHi, s1RLo] = resolve_slot_timing(s1Safe, s1O, s1RunHigh, s1RunLow, nativeNewDay, nativeDayStart, nativeDayStartIndex, nativeDayStart + SECS_DAY * MS_PER_SEC, nativeOpen, nativeRunHigh, nativeRunLow, nativeNewWeek, nativeWeekStartT, nativeWeekStartIndex, nativeWeekOpen, nativeWeekRunHigh, nativeWeekRunLow)
[s2Trans, s2StartT, s2StartIndex, s2CurRightT, s2OEff, s2RHi, s2RLo] = resolve_slot_timing(s2Safe, s2O, s2RunHigh, s2RunLow, nativeNewDay, nativeDayStart, nativeDayStartIndex, nativeDayStart + SECS_DAY * MS_PER_SEC, nativeOpen, nativeRunHigh, nativeRunLow, nativeNewWeek, nativeWeekStartT, nativeWeekStartIndex, nativeWeekOpen, nativeWeekRunHigh, nativeWeekRunLow)
[weeklyProfileTransition, weeklyProfileStartTime, weeklyProfileStartIndex, weeklyProfileRightTime, weeklyProfileEffectiveOpen, weeklyProfileHigh, weeklyProfileLow] = resolve_slot_timing(weeklyProfileSafe, weeklyProfileOpen, weeklyProfileRunHigh, weeklyProfileRunLow, nativeNewDay, nativeDayStart, nativeDayStartIndex, nativeDayStart + SECS_DAY * MS_PER_SEC, nativeOpen, nativeRunHigh, nativeRunLow, nativeNewWeek, nativeWeekStartT, nativeWeekStartIndex, nativeWeekOpen, nativeWeekRunHigh, nativeWeekRunLow)
[monthlyProfileTransition, monthlyProfileStartTime, monthlyProfileStartIndex, monthlyProfileRightTime, monthlyProfileEffectiveOpen, monthlyProfileHigh, monthlyProfileLow] = resolve_slot_timing(monthlyProfileSafe, monthlyProfileOpen, monthlyProfileRunHigh, monthlyProfileRunLow, nativeNewDay, nativeDayStart, nativeDayStartIndex, nativeDayStart + SECS_DAY * MS_PER_SEC, nativeOpen, nativeRunHigh, nativeRunLow, nativeNewWeek, nativeWeekStartT, nativeWeekStartIndex, nativeWeekOpen, nativeWeekRunHigh, nativeWeekRunLow)

string s1ForecastLabel = get_tf_display_label(s1Safe)
string s2ForecastLabel = get_tf_display_label(s2Safe)
string s1ForecastIdentifierText = s1ForecastLabel + " ¹"
string s2ForecastIdentifierText = s2ForecastLabel + " ²"

bool s1BudgetVisible = s1Valid or (s1Trans and s1Valid[1])
bool s2BudgetVisible = s2Valid or (s2Trans and s2Valid[1])
bool weeklyProfileBudgetVisible = weeklyProfileValid or (weeklyProfileTransition and weeklyProfileValid[1])
bool monthlyProfileBudgetVisible = monthlyProfileValid or (monthlyProfileTransition and monthlyProfileValid[1])
bool s1ForecastVisible = next_forecast_visible(forecastSlot1, s1Valid)
bool s2ForecastVisible = next_forecast_visible(forecastSlot2, s2Valid)
bool weeklyProfileForecastVisible = next_forecast_visible(forecastWeekly, weeklyProfileValid)
bool monthlyProfileForecastVisible = next_forecast_visible(forecastMonthly, monthlyProfileValid)
[dailyProfileForecastStartT, dailyProfileForecastEndT] = next_scheduled_profile_bounds(time, dailyProfileConfig)
bool dailyProfileForecastVisible = full_period_forecast_visible(dailyProfileConfig, dailyProfileValid, dailyProfileStartT)
var ScheduledProfileRuntime dailyProfileRuntime = ScheduledProfileRuntime.new()
dailyProfileRuntime.valid := dailyProfileValid
dailyProfileRuntime.transition := dailyProfileTransition
dailyProfileRuntime.startTime := dailyProfileStartT
dailyProfileRuntime.startIndex := dailyProfileStartIndex
dailyProfileRuntime.endTime := dailyProfileEndT
dailyProfileRuntime.endIndex := dailyProfileEndIndex
dailyProfileRuntime.sessionOpen := dailyProfileOpen
dailyProfileRuntime.currentHigh := dailyProfileEffectiveRunHigh
dailyProfileRuntime.currentLow := dailyProfileEffectiveRunLow
dailyProfileRuntime.completedHigh := dailyProfileEffectiveRunHigh[1]
dailyProfileRuntime.completedLow := dailyProfileEffectiveRunLow[1]
dailyProfileRuntime.medianHighOpen := dailyProfileMedHO
dailyProfileRuntime.meanHighOpen := dailyProfileMeanHO
dailyProfileRuntime.medianOpenLow := dailyProfileMedOL
dailyProfileRuntime.meanOpenLow := dailyProfileMeanOL
dailyProfileRuntime.forecastStartTime := dailyProfileForecastStartT
dailyProfileRuntime.forecastEndTime := dailyProfileForecastEndT
dailyProfileRuntime.forecastVisible := dailyProfileForecastVisible
var ScheduledProfile dailyScheduledProfile = ScheduledProfile.new(config=dailyProfileConfig, runtimeState=dailyProfileRuntime, drawingState=dailyProfileSlot, liquidityDepthState=dailyProfileLiquidityDepthState, identifierText=dailyProfileIdentifierText)

[overnightForecastStartT, overnightForecastEndT] = next_scheduled_profile_bounds(time, overnightConfig)
bool overnightForecastVisible = scheduled_profile_forecast_visible(overnightConfig, overnightValid, time, overnightForecastStartT)
var ScheduledProfileRuntime overnightRuntime = ScheduledProfileRuntime.new()
overnightRuntime.valid := overnightValid
overnightRuntime.transition := overnightTransition
overnightRuntime.startTime := overnightStartT
overnightRuntime.startIndex := overnightStartIndex
overnightRuntime.endTime := overnightEndT
overnightRuntime.endIndex := overnightEndIndex
overnightRuntime.sessionOpen := overnightOpen
overnightRuntime.currentHigh := overnightEffectiveRunHigh
overnightRuntime.currentLow := overnightEffectiveRunLow
overnightRuntime.completedHigh := overnightEffectiveRunHigh[1]
overnightRuntime.completedLow := overnightEffectiveRunLow[1]
overnightRuntime.medianHighOpen := overnightMedHO
overnightRuntime.meanHighOpen := overnightMeanHO
overnightRuntime.medianOpenLow := overnightMedOL
overnightRuntime.meanOpenLow := overnightMeanOL
overnightRuntime.forecastStartTime := overnightForecastStartT
overnightRuntime.forecastEndTime := overnightForecastEndT
overnightRuntime.forecastVisible := overnightForecastVisible
var ScheduledProfile overnightScheduledProfile = ScheduledProfile.new(config=overnightConfig, runtimeState=overnightRuntime, drawingState=overnightSlot, liquidityDepthState=overnightLiquidityDepthState, identifierText=overnightIdentifierText)

[nyEarlyForecastStartT, nyEarlyForecastEndT] = next_scheduled_profile_bounds(time, nyEarlyConfig)
bool nyEarlyForecastVisible = scheduled_profile_forecast_visible(nyEarlyConfig, nyEarlyValid, time, nyEarlyForecastStartT)
var ScheduledProfileRuntime nyEarlyRuntime = ScheduledProfileRuntime.new()
nyEarlyRuntime.valid := nyEarlyValid
nyEarlyRuntime.transition := nyEarlyTransition
nyEarlyRuntime.startTime := nyEarlyStartT
nyEarlyRuntime.startIndex := nyEarlyStartIndex
nyEarlyRuntime.endTime := nyEarlyEndT
nyEarlyRuntime.endIndex := nyEarlyEndIndex
nyEarlyRuntime.sessionOpen := nyEarlyOpen
nyEarlyRuntime.currentHigh := nyEarlyEffectiveRunHigh
nyEarlyRuntime.currentLow := nyEarlyEffectiveRunLow
nyEarlyRuntime.completedHigh := nyEarlyEffectiveRunHigh[1]
nyEarlyRuntime.completedLow := nyEarlyEffectiveRunLow[1]
nyEarlyRuntime.medianHighOpen := nyEarlyMedHO
nyEarlyRuntime.meanHighOpen := nyEarlyMeanHO
nyEarlyRuntime.medianOpenLow := nyEarlyMedOL
nyEarlyRuntime.meanOpenLow := nyEarlyMeanOL
nyEarlyRuntime.forecastStartTime := nyEarlyForecastStartT
nyEarlyRuntime.forecastEndTime := nyEarlyForecastEndT
nyEarlyRuntime.forecastVisible := nyEarlyForecastVisible
var ScheduledProfile nyEarlyScheduledProfile = ScheduledProfile.new(config=nyEarlyConfig, runtimeState=nyEarlyRuntime, drawingState=nyEarlySlot, liquidityDepthState=nyEarlyLiquidityDepthState, identifierText=nyEarlyIdentifierText)

[nyAmForecastStartT, nyAmForecastEndT] = next_scheduled_profile_bounds(time, nyAmConfig)
bool nyAmForecastVisible = scheduled_profile_forecast_visible(nyAmConfig, nyAmValid, time, nyAmForecastStartT)
var ScheduledProfileRuntime nyAmRuntime = ScheduledProfileRuntime.new()
nyAmRuntime.valid := nyAmValid
nyAmRuntime.transition := nyAmTransition
nyAmRuntime.startTime := nyAmStartT
nyAmRuntime.startIndex := nyAmStartIndex
nyAmRuntime.endTime := nyAmEndT
nyAmRuntime.endIndex := nyAmEndIndex
nyAmRuntime.sessionOpen := nyAmOpen
nyAmRuntime.currentHigh := nyAmEffectiveRunHigh
nyAmRuntime.currentLow := nyAmEffectiveRunLow
nyAmRuntime.completedHigh := nyAmEffectiveRunHigh[1]
nyAmRuntime.completedLow := nyAmEffectiveRunLow[1]
nyAmRuntime.medianHighOpen := nyAmMedHO
nyAmRuntime.meanHighOpen := nyAmMeanHO
nyAmRuntime.medianOpenLow := nyAmMedOL
nyAmRuntime.meanOpenLow := nyAmMeanOL
nyAmRuntime.forecastStartTime := nyAmForecastStartT
nyAmRuntime.forecastEndTime := nyAmForecastEndT
nyAmRuntime.forecastVisible := nyAmForecastVisible
var ScheduledProfile nyAmScheduledProfile = ScheduledProfile.new(config=nyAmConfig, runtimeState=nyAmRuntime, drawingState=nyAmSlot, liquidityDepthState=nyAmLiquidityDepthState, identifierText=nyAmIdentifierText)

[ivbForecastStartT, ivbForecastEndT] = next_scheduled_profile_bounds(time, ivbConfig)
bool ivbForecastVisible = scheduled_profile_forecast_visible(ivbConfig, ivbValid, time, ivbForecastStartT)
var ScheduledProfileRuntime ivbRuntime = ScheduledProfileRuntime.new()
ivbRuntime.valid := ivbValid
ivbRuntime.transition := ivbTransition
ivbRuntime.startTime := ivbStartT
ivbRuntime.startIndex := ivbStartIndex
ivbRuntime.endTime := ivbEndT
ivbRuntime.endIndex := ivbEndIndex
ivbRuntime.sessionOpen := ivbOpen
ivbRuntime.currentHigh := ivbEffectiveRunHigh
ivbRuntime.currentLow := ivbEffectiveRunLow
ivbRuntime.completedHigh := ivbEffectiveRunHigh[1]
ivbRuntime.completedLow := ivbEffectiveRunLow[1]
ivbRuntime.medianHighOpen := ivbMedHO
ivbRuntime.meanHighOpen := ivbMeanHO
ivbRuntime.medianOpenLow := ivbMedOL
ivbRuntime.meanOpenLow := ivbMeanOL
ivbRuntime.forecastStartTime := ivbForecastStartT
ivbRuntime.forecastEndTime := ivbForecastEndT
ivbRuntime.forecastVisible := ivbForecastVisible
var ScheduledProfile ivbScheduledProfile = ScheduledProfile.new(config=ivbConfig, runtimeState=ivbRuntime, drawingState=ivbSlot, liquidityDepthState=ivbLiquidityDepthState, identifierText=ivbIdentifierText)

[ivbPlusForecastStartT, ivbPlusForecastEndT] = next_scheduled_profile_bounds(time, ivbPlusConfig)
bool ivbPlusForecastVisible = scheduled_profile_forecast_visible(ivbPlusConfig, ivbPlusValid, time, ivbPlusForecastStartT)
var ScheduledProfileRuntime ivbPlusRuntime = ScheduledProfileRuntime.new()
ivbPlusRuntime.valid := ivbPlusValid
ivbPlusRuntime.transition := ivbPlusTransition
ivbPlusRuntime.startTime := ivbPlusStartT
ivbPlusRuntime.startIndex := ivbPlusStartIndex
ivbPlusRuntime.endTime := ivbPlusEndT
ivbPlusRuntime.endIndex := ivbPlusEndIndex
ivbPlusRuntime.sessionOpen := ivbPlusOpen
ivbPlusRuntime.currentHigh := ivbPlusEffectiveRunHigh
ivbPlusRuntime.currentLow := ivbPlusEffectiveRunLow
ivbPlusRuntime.completedHigh := ivbPlusEffectiveRunHigh[1]
ivbPlusRuntime.completedLow := ivbPlusEffectiveRunLow[1]
ivbPlusRuntime.medianHighOpen := ivbPlusMedHO
ivbPlusRuntime.meanHighOpen := ivbPlusMeanHO
ivbPlusRuntime.medianOpenLow := ivbPlusMedOL
ivbPlusRuntime.meanOpenLow := ivbPlusMeanOL
ivbPlusRuntime.forecastStartTime := ivbPlusForecastStartT
ivbPlusRuntime.forecastEndTime := ivbPlusForecastEndT
ivbPlusRuntime.forecastVisible := ivbPlusForecastVisible
var ScheduledProfile ivbPlusScheduledProfile = ScheduledProfile.new(config=ivbPlusConfig, runtimeState=ivbPlusRuntime, drawingState=ivbPlusSlot, liquidityDepthState=ivbPlusLiquidityDepthState, identifierText=ivbPlusIdentifierText)
array<ScheduledProfile> scheduledProfiles = array.from(dailyScheduledProfile, overnightScheduledProfile, nyEarlyScheduledProfile, nyAmScheduledProfile, ivbScheduledProfile, ivbPlusScheduledProfile)

for profileIndex = 0 to array.size(scheduledProfiles) - 1
    ScheduledProfile profile = array.get(scheduledProfiles, profileIndex)
    bool depthActive = scheduled_profile_liquidity_depth_active(profile.config, profile.runtimeState)
    update_liquidity_depth_profile(profile.liquidityDepthState, profile.runtimeState, profile.config.historyLimit, depthActive, dailyLiquidityDepthDistance)

bool fibLabelsOn = fibLabelLevels != FL_OFF
bool fibLabel1On = fibLabelsOn and fibLabelSlot1
bool fibLabel2On = fibLabelsOn and fibLabelSlot2
bool fibLabelWeeklyOn = fibLabelsOn and fibLabelWeekly
bool fibLabelMonthlyOn = fibLabelsOn and fibLabelMonthly
int s1LabelsPerZone = fib_label_count_per_zone(slot1FibLevelSet, fibPalette, fibLabel1On, fibLabelPos1)
int s2LabelsPerZone = fib_label_count_per_zone(slot2FibLevelSet, fibPalette, fibLabel2On, fibLabelPos2)
int weeklyProfileLabelsPerZone = fib_label_count_per_zone(weeklyProfileFibLevelSet, fibPalette, fibLabelWeeklyOn, fibLabelPosWeekly)
int monthlyProfileLabelsPerZone = fib_label_count_per_zone(monthlyProfileFibLevelSet, fibPalette, fibLabelMonthlyOn, fibLabelPosMonthly)
int profileVisibilityTime = barstate.isrealtime ? timenow : nz(time_close, time)

int s1HistoryZoneRequest = history_zone_request(latestOnly, slot1History)
int s2HistoryZoneRequest = history_zone_request(latestOnly, slot2History)
int weeklyProfileHistoryZoneRequest = history_zone_request(latestOnly, weeklyProfileHistory)
int monthlyProfileHistoryZoneRequest = history_zone_request(latestOnly, monthlyProfileHistory)
int s1FibHistoryZoneRequest = fib_history_zone_request(latestOnly, slot1History, fibHistory)
int s2FibHistoryZoneRequest = fib_history_zone_request(latestOnly, slot2History, fibHistory)
int weeklyProfileFibHistoryZoneRequest = fib_history_zone_request(latestOnly, weeklyProfileHistory, fibHistory)
int monthlyProfileFibHistoryZoneRequest = fib_history_zone_request(latestOnly, monthlyProfileHistory, fibHistory)

array<bool> historyBudgetValids = array.from(s1Valid, s2Valid, weeklyProfileValid, monthlyProfileValid)
array<int> boxHistoryZoneRequests = array.from(s1HistoryZoneRequest, s2HistoryZoneRequest, weeklyProfileHistoryZoneRequest, monthlyProfileHistoryZoneRequest)
array<int> scheduledProfileHistoryRequests = array.new<int>()
array<int> scheduledProfileLabelsPerZone = array.new<int>()
array<bool> scheduledProfileDepthValids = array.new<bool>()

int currentBoxZoneCount = (s1BudgetVisible ? 1 : 0) + (s2BudgetVisible ? 1 : 0) + (weeklyProfileBudgetVisible ? 1 : 0) + (monthlyProfileBudgetVisible ? 1 : 0)
int forecastZoneCount = (s1ForecastVisible ? 1 : 0) + (s2ForecastVisible ? 1 : 0) + (weeklyProfileForecastVisible ? 1 : 0) + (monthlyProfileForecastVisible ? 1 : 0)
// Stable worst-case reserves prevent scheduled profile toggles from trimming ordinary history.
int scheduledProfileCurrentLineReserve = 0
int scheduledProfileCurrentLabelReserve = 0
for profileIndex = 0 to array.size(scheduledProfiles) - 1
    ScheduledProfile profile = array.get(scheduledProfiles, profileIndex)
    ScheduledProfileConfig profileConfig = profile.config
    ScheduledProfileRuntime profileRuntime = profile.runtimeState
    int historyRequest = latestOnly ? 0 : profileConfig.historyLimit - 1
    bool labelEnabled = fibLabelsOn and profileConfig.fibLabelsEnabled
    bool depthActive = scheduled_profile_liquidity_depth_active(profileConfig, profileRuntime)
    int labelsPerZone = fib_label_count_per_zone(profileConfig.fibLevelSet, fibPalette, labelEnabled, profileConfig.fibLabelPosition)
    array.push(scheduledProfileHistoryRequests, historyRequest)
    array.push(scheduledProfileLabelsPerZone, labelsPerZone)
    array.push(scheduledProfileDepthValids, depthActive)
    array.push(historyBudgetValids, profileRuntime.valid)
    array.push(boxHistoryZoneRequests, historyRequest)
    currentBoxZoneCount += profileRuntime.valid ? 1 : 0
    forecastZoneCount += profileRuntime.forecastVisible ? 1 : 0
    scheduledProfileCurrentLineReserve += current_line_request(true, profileConfig.fibLevelSet.lineCount)
    scheduledProfileCurrentLineReserve += depthActive ? LIQUIDITY_DEPTH_LINES_PER_SESSION : 0
    scheduledProfileCurrentLabelReserve += profileRuntime.valid ? labelsPerZone : 0
    scheduledProfileCurrentLabelReserve += depthActive ? LIQUIDITY_DEPTH_LABELS_PER_SESSION : 0
int currentBoxReserve = (currentBoxZoneCount + forecastZoneCount) * 2
int availableHistoryBoxZones = int(math.max(0, INDICATOR_MAX_BOXES - currentBoxReserve) / 2)
array<int> boxHistZoneCaps = allocate_history_zone_caps(availableHistoryBoxZones, historyBudgetValids, boxHistoryZoneRequests, HTF_PROFILE_COUNT, SLOT_HISTORY_MAX)
int s1BoxHistZoneCap = array.get(boxHistZoneCaps, 0)
int s2BoxHistZoneCap = array.get(boxHistZoneCaps, 1)
int weeklyProfileBoxHistZoneCap = array.get(boxHistZoneCaps, 2)
int monthlyProfileBoxHistZoneCap = array.get(boxHistZoneCaps, 3)
int s1RetainedHistoryZoneCap = s1BoxHistZoneCap
int s2RetainedHistoryZoneCap = s2BoxHistZoneCap
int weeklyProfileRetainedHistoryZoneCap = weeklyProfileBoxHistZoneCap
int monthlyProfileRetainedHistoryZoneCap = monthlyProfileBoxHistZoneCap

int htfCurrentLineReserve = current_line_request(s1BudgetVisible, slot1FibLevelSet.lineCount) + current_line_request(s2BudgetVisible, slot2FibLevelSet.lineCount) + current_line_request(weeklyProfileBudgetVisible, weeklyProfileFibLevelSet.lineCount) + current_line_request(monthlyProfileBudgetVisible, monthlyProfileFibLevelSet.lineCount)
int forecastLineReserve = forecastZoneCount * 4
int currentLineReserve = htfCurrentLineReserve + scheduledProfileCurrentLineReserve + forecastLineReserve
int availableHistoryLinesBeforeDepth = math.max(0, INDICATOR_MAX_LINES - currentLineReserve)

// Standard charts convert bar offsets to time; Range charts use the offsets directly.
int chartBarMs = chart.is_range ? 0 : int(timeframe.in_seconds(timeframe.period) * MS_PER_SEC)
int currentLabelReserve = (s1BudgetVisible ? s1LabelsPerZone : 0) + (s2BudgetVisible ? s2LabelsPerZone : 0) + (weeklyProfileBudgetVisible ? weeklyProfileLabelsPerZone : 0) + (monthlyProfileBudgetVisible ? monthlyProfileLabelsPerZone : 0) + scheduledProfileCurrentLabelReserve
int availableHistoryLabelsBeforeDepth = math.max(0, INDICATOR_MAX_LABELS - currentLabelReserve)
array<int> scheduledProfileDepthHistoryRequests = array.new<int>()
for profileIndex = 0 to array.size(scheduledProfiles) - 1
    int budgetIndex = HTF_PROFILE_COUNT + profileIndex
    int retainedHistory = array.get(boxHistZoneCaps, budgetIndex)
    int depthHistoryRequest = array.get(scheduledProfileDepthValids, profileIndex) ? math.min(array.get(scheduledProfileHistoryRequests, profileIndex), retainedHistory) : 0
    array.push(scheduledProfileDepthHistoryRequests, depthHistoryRequest)
[scheduledProfileDepthHistoryCaps, depthHistoryLinesUsed, depthHistoryLabelsUsed] = allocate_history_liquidity_depth_caps(availableHistoryLinesBeforeDepth, availableHistoryLabelsBeforeDepth, scheduledProfileDepthValids, scheduledProfileDepthHistoryRequests)
int availableHistoryLines = availableHistoryLinesBeforeDepth - depthHistoryLinesUsed
int availableHistoryLabels = availableHistoryLabelsBeforeDepth - depthHistoryLabelsUsed
array<int> historyLabelsPerZone = array.from(s1LabelsPerZone, s2LabelsPerZone, weeklyProfileLabelsPerZone, monthlyProfileLabelsPerZone)
array<bool> historyLabelSlots = array.from(fibLabelHistory and fibLabel1On, fibLabelHistory and fibLabel2On, fibLabelHistory and fibLabelWeeklyOn, fibLabelHistory and fibLabelMonthlyOn)
array<int> fibHistoryZoneRequests = array.from(math.min(s1FibHistoryZoneRequest, s1RetainedHistoryZoneCap), math.min(s2FibHistoryZoneRequest, s2RetainedHistoryZoneCap), math.min(weeklyProfileFibHistoryZoneRequest, weeklyProfileRetainedHistoryZoneCap), math.min(monthlyProfileFibHistoryZoneRequest, monthlyProfileRetainedHistoryZoneCap))
array<int> fibLinesPerZoneBySlot = array.from(slot1FibLevelSet.lineCount, slot2FibLevelSet.lineCount, weeklyProfileFibLevelSet.lineCount, monthlyProfileFibLevelSet.lineCount)
for profileIndex = 0 to array.size(scheduledProfiles) - 1
    int budgetIndex = HTF_PROFILE_COUNT + profileIndex
    ScheduledProfile profile = array.get(scheduledProfiles, profileIndex)
    ScheduledProfileConfig profileConfig = profile.config
    int historyRequest = array.get(scheduledProfileHistoryRequests, profileIndex)
    int retainedHistory = array.get(boxHistZoneCaps, budgetIndex)
    int fibHistoryRequest = math.min(historyRequest, math.min(math.max(0, profileConfig.historyLimit - 1), fibHistory))
    array.push(historyLabelsPerZone, array.get(scheduledProfileLabelsPerZone, profileIndex))
    array.push(historyLabelSlots, fibLabelHistory and fibLabelsOn and profileConfig.fibLabelsEnabled)
    array.push(fibHistoryZoneRequests, math.min(fibHistoryRequest, retainedHistory))
    array.push(fibLinesPerZoneBySlot, profileConfig.fibLevelSet.lineCount)
[fibHistCaps, histFibLabelCaps] = allocate_history_fib_caps(availableHistoryLines, availableHistoryLabels, historyBudgetValids, fibHistoryZoneRequests, fibLinesPerZoneBySlot, historyLabelSlots, historyLabelsPerZone, HTF_PROFILE_COUNT, SLOT_HISTORY_MAX)
int s1FibHistCap = array.get(fibHistCaps, 0)
int s2FibHistCap = array.get(fibHistCaps, 1)
int weeklyProfileFibHistCap = array.get(fibHistCaps, 2)
int monthlyProfileFibHistCap = array.get(fibHistCaps, 3)
int s1HistFibLabelCap = array.get(histFibLabelCaps, 0)
int s2HistFibLabelCap = array.get(histFibLabelCaps, 1)
int weeklyProfileHistFibLabelCap = array.get(histFibLabelCaps, 2)
int monthlyProfileHistFibLabelCap = array.get(histFibLabelCaps, 3)

update_slot(slot1, s1Valid, s1Trans, s1StartT, s1StartIndex, false, s1CurRightT, bar_index, s1OEff, s1RHi[1], s1RLo[1], slot1Color, s1Label, s1NormMedHO, s1NormMeanHO, s1NormMedOL, s1NormMeanOL, s1BoxHistZoneCap, SLOT1_LABEL_SIZE, SLOT1_FIB_FADE, slot1FibLevelSet, fibPalette, s1FibHistCap, fibLabelHistory and fibLabel1On, s1HistFibLabelCap, s1LabelsPerZone, fibLabelSize1, fibLabelPos1, fibLabelOff1 * chartBarMs, fibLabelOff1)
update_slot(slot2, s2Valid, s2Trans, s2StartT, s2StartIndex, false, s2CurRightT, bar_index, s2OEff, s2RHi[1], s2RLo[1], slot2Color, s2Label, s2NormMedHO, s2NormMeanHO, s2NormMedOL, s2NormMeanOL, s2BoxHistZoneCap, SLOT2_LABEL_SIZE, SLOT2_FIB_FADE, slot2FibLevelSet, fibPalette, s2FibHistCap, fibLabelHistory and fibLabel2On, s2HistFibLabelCap, s2LabelsPerZone, fibLabelSize2, fibLabelPos2, fibLabelOff2 * chartBarMs, fibLabelOff2)
update_slot(weeklyProfileSlot, weeklyProfileValid, weeklyProfileTransition, weeklyProfileStartTime, weeklyProfileStartIndex, false, weeklyProfileRightTime, bar_index, weeklyProfileEffectiveOpen, weeklyProfileHigh[1], weeklyProfileLow[1], weeklyProfileColor, WEEKLY_PROFILE_NAME, weeklyProfileMedHO, weeklyProfileMeanHO, weeklyProfileMedOL, weeklyProfileMeanOL, weeklyProfileBoxHistZoneCap, WEEKLY_PROFILE_LABEL_SIZE, WEEKLY_PROFILE_FIB_FADE, weeklyProfileFibLevelSet, fibPalette, weeklyProfileFibHistCap, fibLabelHistory and fibLabelWeeklyOn, weeklyProfileHistFibLabelCap, weeklyProfileLabelsPerZone, fibLabelSizeWeekly, fibLabelPosWeekly, fibLabelOffWeekly * chartBarMs, fibLabelOffWeekly)
update_slot(monthlyProfileSlot, monthlyProfileValid, monthlyProfileTransition, monthlyProfileStartTime, monthlyProfileStartIndex, false, monthlyProfileRightTime, bar_index, monthlyProfileEffectiveOpen, monthlyProfileHigh[1], monthlyProfileLow[1], monthlyProfileColor, MONTHLY_PROFILE_NAME, monthlyProfileMedHO, monthlyProfileMeanHO, monthlyProfileMedOL, monthlyProfileMeanOL, monthlyProfileBoxHistZoneCap, MONTHLY_PROFILE_LABEL_SIZE, MONTHLY_PROFILE_FIB_FADE, monthlyProfileFibLevelSet, fibPalette, monthlyProfileFibHistCap, fibLabelHistory and fibLabelMonthlyOn, monthlyProfileHistFibLabelCap, monthlyProfileLabelsPerZone, fibLabelSizeMonthly, fibLabelPosMonthly, fibLabelOffMonthly * chartBarMs, fibLabelOffMonthly)

// Each written call keeps independent Pine history for update_slot()'s [1] snapshots.
int dailyProfileBudgetIndex = HTF_PROFILE_COUNT + DAILY_PROFILE_INDEX
update_scheduled_profile(dailyProfileSlot, dailyProfileConfig, dailyProfileRuntime,
     fibPalette, array.get(boxHistZoneCaps, dailyProfileBudgetIndex), array.get(fibHistCaps, dailyProfileBudgetIndex),
     array.get(historyLabelSlots, dailyProfileBudgetIndex), array.get(histFibLabelCaps, dailyProfileBudgetIndex), array.get(historyLabelsPerZone, dailyProfileBudgetIndex),
     dailyProfileConfig.fibLabelOffset * chartBarMs, dailyProfileConfig.fibLabelOffset)

int overnightBudgetIndex = HTF_PROFILE_COUNT + OVERNIGHT_PROFILE_INDEX
update_scheduled_profile(overnightSlot, overnightConfig, overnightRuntime,
     fibPalette, array.get(boxHistZoneCaps, overnightBudgetIndex), array.get(fibHistCaps, overnightBudgetIndex),
     array.get(historyLabelSlots, overnightBudgetIndex), array.get(histFibLabelCaps, overnightBudgetIndex), array.get(historyLabelsPerZone, overnightBudgetIndex),
     overnightConfig.fibLabelOffset * chartBarMs, overnightConfig.fibLabelOffset)

int nyEarlyBudgetIndex = HTF_PROFILE_COUNT + NY_EARLY_PROFILE_INDEX
update_scheduled_profile(nyEarlySlot, nyEarlyConfig, nyEarlyRuntime,
     fibPalette, array.get(boxHistZoneCaps, nyEarlyBudgetIndex), array.get(fibHistCaps, nyEarlyBudgetIndex),
     array.get(historyLabelSlots, nyEarlyBudgetIndex), array.get(histFibLabelCaps, nyEarlyBudgetIndex), array.get(historyLabelsPerZone, nyEarlyBudgetIndex),
     nyEarlyConfig.fibLabelOffset * chartBarMs, nyEarlyConfig.fibLabelOffset)

int nyAmBudgetIndex = HTF_PROFILE_COUNT + NY_AM_PROFILE_INDEX
update_scheduled_profile(nyAmSlot, nyAmConfig, nyAmRuntime,
     fibPalette, array.get(boxHistZoneCaps, nyAmBudgetIndex), array.get(fibHistCaps, nyAmBudgetIndex),
     array.get(historyLabelSlots, nyAmBudgetIndex), array.get(histFibLabelCaps, nyAmBudgetIndex), array.get(historyLabelsPerZone, nyAmBudgetIndex),
     nyAmConfig.fibLabelOffset * chartBarMs, nyAmConfig.fibLabelOffset)

int ivbBudgetIndex = HTF_PROFILE_COUNT + IVB_PROFILE_INDEX
update_scheduled_profile(ivbSlot, ivbConfig, ivbRuntime,
     fibPalette, array.get(boxHistZoneCaps, ivbBudgetIndex), array.get(fibHistCaps, ivbBudgetIndex),
     array.get(historyLabelSlots, ivbBudgetIndex), array.get(histFibLabelCaps, ivbBudgetIndex), array.get(historyLabelsPerZone, ivbBudgetIndex),
     ivbConfig.fibLabelOffset * chartBarMs, ivbConfig.fibLabelOffset)

int ivbPlusBudgetIndex = HTF_PROFILE_COUNT + IVB_PLUS_PROFILE_INDEX
update_scheduled_profile(ivbPlusSlot, ivbPlusConfig, ivbPlusRuntime,
     fibPalette, array.get(boxHistZoneCaps, ivbPlusBudgetIndex), array.get(fibHistCaps, ivbPlusBudgetIndex),
     array.get(historyLabelSlots, ivbPlusBudgetIndex), array.get(histFibLabelCaps, ivbPlusBudgetIndex), array.get(historyLabelsPerZone, ivbPlusBudgetIndex),
     ivbPlusConfig.fibLabelOffset * chartBarMs, ivbPlusConfig.fibLabelOffset)

int currentRightIndex = chart.is_range ? bar_index + 1 : bar_index

if barstate.islast
    draw_slot_current(slot1, s1Valid, s1StartT, s1StartIndex, s1CurRightT, currentRightIndex, s1OEff, s1RHi, s1RLo, slot1Color, s1IdentifierText, s1Label, s1NormMedHO, s1NormMeanHO, s1NormMedOL, s1NormMeanOL, SLOT1_LABEL_SIZE, slot1FibLevelSet, fibPalette, SLOT1_FIB_FADE, fibLabel1On, fibLabelSize1, fibLabelPos1, fibLabelOff1 * chartBarMs, fibLabelOff1)
    draw_slot_current(slot2, s2Valid, s2StartT, s2StartIndex, s2CurRightT, currentRightIndex, s2OEff, s2RHi, s2RLo, slot2Color, s2IdentifierText, s2Label, s2NormMedHO, s2NormMeanHO, s2NormMedOL, s2NormMeanOL, SLOT2_LABEL_SIZE, slot2FibLevelSet, fibPalette, SLOT2_FIB_FADE, fibLabel2On, fibLabelSize2, fibLabelPos2, fibLabelOff2 * chartBarMs, fibLabelOff2)
    draw_slot_current(weeklyProfileSlot, weeklyProfileValid, weeklyProfileStartTime, weeklyProfileStartIndex, weeklyProfileRightTime, currentRightIndex, weeklyProfileEffectiveOpen, weeklyProfileHigh, weeklyProfileLow, weeklyProfileColor, weeklyProfileIdentifierText, WEEKLY_PROFILE_NAME, weeklyProfileMedHO, weeklyProfileMeanHO, weeklyProfileMedOL, weeklyProfileMeanOL, WEEKLY_PROFILE_LABEL_SIZE, weeklyProfileFibLevelSet, fibPalette, WEEKLY_PROFILE_FIB_FADE, fibLabelWeeklyOn, fibLabelSizeWeekly, fibLabelPosWeekly, fibLabelOffWeekly * chartBarMs, fibLabelOffWeekly)
    draw_slot_current(monthlyProfileSlot, monthlyProfileValid, monthlyProfileStartTime, monthlyProfileStartIndex, monthlyProfileRightTime, currentRightIndex, monthlyProfileEffectiveOpen, monthlyProfileHigh, monthlyProfileLow, monthlyProfileColor, monthlyProfileIdentifierText, MONTHLY_PROFILE_NAME, monthlyProfileMedHO, monthlyProfileMeanHO, monthlyProfileMedOL, monthlyProfileMeanOL, MONTHLY_PROFILE_LABEL_SIZE, monthlyProfileFibLevelSet, fibPalette, MONTHLY_PROFILE_FIB_FADE, fibLabelMonthlyOn, fibLabelSizeMonthly, fibLabelPosMonthly, fibLabelOffMonthly * chartBarMs, fibLabelOffMonthly)
    for profileIndex = 0 to array.size(scheduledProfiles) - 1
        ScheduledProfile profile = array.get(scheduledProfiles, profileIndex)
        ScheduledProfileConfig profileConfig = profile.config
        ScheduledProfileRuntime profileRuntime = profile.runtimeState
        SlotState slotState = profile.drawingState
        bool currentVisible = scheduled_profile_current_visible(profileConfig, profileRuntime, hideTodaysCompleted, profileVisibilityTime)
        bool fibLabelsEnabled = fibLabelsOn and profileConfig.fibLabelsEnabled
        bool depthActive = scheduled_profile_liquidity_depth_active(profileConfig, profileRuntime)
        int labelOffsetBars = profileConfig.fibLabelOffset
        draw_scheduled_profile_current(slotState, profileConfig, profileRuntime, currentVisible, profile.identifierText, currentRightIndex,
             fibPalette, fibLabelsEnabled, labelOffsetBars * chartBarMs, labelOffsetBars)
        draw_liquidity_depth_profile(slotState, profile.liquidityDepthState, profileConfig, depthActive, currentVisible, dailyLiquidityDepthDistance, array.get(scheduledProfileDepthHistoryCaps, profileIndex), forecastLiquidityDepth)
    draw_slot_forecast(slot1, s1ForecastVisible, s1CurRightT, slot_forecast_right_time(s1Safe, s1CurRightT), s1OEff, s1RHi, s1RLo, slot1Color, s1ForecastIdentifierText, SLOT1_LABEL_SIZE, s1NormMedHO, s1NormMeanHO, s1NormMedOL, s1NormMeanOL)
    draw_slot_forecast(slot2, s2ForecastVisible, s2CurRightT, slot_forecast_right_time(s2Safe, s2CurRightT), s2OEff, s2RHi, s2RLo, slot2Color, s2ForecastIdentifierText, SLOT2_LABEL_SIZE, s2NormMedHO, s2NormMeanHO, s2NormMedOL, s2NormMeanOL)
    draw_slot_forecast(weeklyProfileSlot, weeklyProfileForecastVisible, weeklyProfileRightTime, slot_forecast_right_time(WEEKLY_TIMEFRAME, weeklyProfileRightTime), weeklyProfileEffectiveOpen, weeklyProfileHigh, weeklyProfileLow, weeklyProfileColor, WEEKLY_PROFILE_NAME, WEEKLY_PROFILE_LABEL_SIZE, weeklyProfileMedHO, weeklyProfileMeanHO, weeklyProfileMedOL, weeklyProfileMeanOL)
    draw_slot_forecast(monthlyProfileSlot, monthlyProfileForecastVisible, monthlyProfileRightTime, slot_forecast_right_time(MONTHLY_TIMEFRAME, monthlyProfileRightTime), monthlyProfileEffectiveOpen, monthlyProfileHigh, monthlyProfileLow, monthlyProfileColor, MONTHLY_PROFILE_NAME, MONTHLY_PROFILE_LABEL_SIZE, monthlyProfileMedHO, monthlyProfileMeanHO, monthlyProfileMedOL, monthlyProfileMeanOL)
    for profileIndex = 0 to array.size(scheduledProfiles) - 1
        ScheduledProfile profile = array.get(scheduledProfiles, profileIndex)
        draw_scheduled_profile_forecast(profile.drawingState, profile.config, profile.runtimeState, profile.identifierText)

showOnlyTimeframeAllowed = chart.is_range or timeframe.in_seconds(timeframe.period) <= SHOW_ONLY_MAX_TIMEFRAME_SECONDS
activeShowOnlySession = visibleWindow == WINDOW_LABEL_FROM_0500 ? SESSION_WINDOW_FROM_0500 : visibleWindow == WINDOW_LABEL_FROM_0830 ? SESSION_WINDOW_FROM_0830 : visibleWindow == WINDOW_LABEL_RTH ? SESSION_WINDOW_RTH : SESSION_WINDOW_OVERNIGHT
showOnlyInVisibleWindow = not na(time(timeframe.period, activeShowOnlySession, NY_TIMEZONE))
bool showOnlyInMostRecentDay = true
if showOnlyMostRecent
    showOnlyInMostRecentDay := year(time, NY_TIMEZONE) == year(timenow, NY_TIMEZONE) and month(time, NY_TIMEZONE) == month(timenow, NY_TIMEZONE) and dayofmonth(time, NY_TIMEZONE) == dayofmonth(timenow, NY_TIMEZONE)
hideThisBar = showOnlyEnabled and showOnlyTimeframeAllowed and not (showOnlyInVisibleWindow and (not showOnlyMostRecent or showOnlyInMostRecentDay))

plotcandle(hideThisBar ? open : na, high, low, close, title="Hidden Candles", color=hiddenCandleColor, bordercolor=hiddenCandleColor, wickcolor=hiddenCandleColor, editable=false, display=display.pane, force_overlay=true)

// COLOR REFERENCE TABLE

addRow(table tbl, int row, string name, color clr) =>
    table.cell(tbl, 0, row, name, text_size=size.small, text_color=color.black)
    table.cell(tbl, 1, row, str.format("R:{0} G:{1} B:{2}", int(color.r(clr)), int(color.g(clr)), int(color.b(clr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 2, row, str.tostring(int(color.t(clr))), text_size=size.small, text_color=color.black)

if showTable and barstate.islast
    int colorTableRowCount = 1 + HTF_PROFILE_COUNT + array.size(scheduledProfiles) + 9 + 1
    var table colorTable = table.new(position.top_right, 3, colorTableRowCount, bgcolor=color.white, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)
    table.cell(colorTable, 0, 0, "Setting", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 1, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 2, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    int row = 1
    addRow(colorTable, row, "Slot 1", slot1Color)
    row += 1
    addRow(colorTable, row, "Slot 2", slot2Color)
    row += 1
    addRow(colorTable, row, WEEKLY_PROFILE_NAME, weeklyProfileColor)
    row += 1
    addRow(colorTable, row, MONTHLY_PROFILE_NAME, monthlyProfileColor)
    row += 1
    for profileIndex = 0 to array.size(scheduledProfiles) - 1
        ScheduledProfile profile = array.get(scheduledProfiles, profileIndex)
        ScheduledProfileConfig profileConfig = profile.config
        addRow(colorTable, row, profileConfig.sourceLabel, profileConfig.slotColor)
        row += 1

    addRow(colorTable, row, "Fib 1.0", fibColor100)
    row += 1
    addRow(colorTable, row, "Fib 0.786", fibColor786)
    row += 1
    addRow(colorTable, row, "Fib 0.705", fibColor705)
    row += 1
    addRow(colorTable, row, "Fib 0.618", fibColor618)
    row += 1
    addRow(colorTable, row, "Fib 0.5", fibColor50)
    row += 1
    addRow(colorTable, row, "Fib 0.382", fibColor382)
    row += 1
    addRow(colorTable, row, "Fib 0.295", fibColor295)
    row += 1
    addRow(colorTable, row, "Fib 0.214", fibColor214)
    row += 1
    addRow(colorTable, row, "Fib 0", fibColor0)
    row += 1

    if showOnlyEnabled and showOnlyTimeframeAllowed
        addRow(colorTable, row, "Hidden Candles", hiddenCandleColor)
        row += 1

// parallax •
