ivbLiquidityDepth = input.bool(false, IVB_SLOT_NAME, inline="liquidity_depth_profiles", group=GROUP_LIQUIDITY_DEPTH, active=ivbShow)
ivbPlusLiquidityDepth = input.bool(false, IVB_PLUS_SLOT_NAME, inline="liquidity_depth_profiles", group=GROUP_LIQUIDITY_DEPTH, active=ivbPlusShow, tooltip=LIQUIDITY_DEPTH_TOOLTIP)

