//@version=6
indicator("parallax •", overlay=true,
     max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// Multi-HTF statistical expansion zones.
// Up to 4 HTF slots, each projecting Inner/Outer/Distribution levels from its own open.
// Inner = median of (H−O)/(O−L) over last N HTF candles. Outer = mean. Distribution = Outer ± k·σ.

// CONSTANTS

const string GROUP_GENERAL    = "General"
const string GROUP_SLOTS      = "HTF Slots"
const string GROUP_DISPLAY    = "Display"
const string GROUP_ZONE       = "Zone Fill"
const string GROUP_FIB        = "Fibonacci"
const string GROUP_FIB_LEVELS = "Fibonacci Levels"
const string GROUP_FIB_LABELS = "Fibonacci Labels"
const string GROUP_TABLE      = "Color Reference Table"

const float FIB_LEVEL_0   = 0.0
const float FIB_LEVEL_214 = 0.214
const float FIB_LEVEL_295 = 0.295
const float FIB_LEVEL_382 = 0.382
const float FIB_LEVEL_50  = 0.5
const float FIB_LEVEL_618 = 0.618
const float FIB_LEVEL_705 = 0.705
const float FIB_LEVEL_786 = 0.786
const float FIB_LEVEL_100 = 1.0

const int   FIB_DEFAULT_WIDTH = 2
const int   FIB_MIN_WIDTH     = 1
const int   FIB_MAX_WIDTH     = 3

const color DEFAULT_FIB_100_COLOR = color.new(color.rgb(46,  46,  46),  65)
const color DEFAULT_FIB_786_COLOR = color.new(color.rgb(236, 64,  122), 40)
const color DEFAULT_FIB_705_COLOR = color.new(color.rgb(244, 143, 177), 15)
const color DEFAULT_FIB_618_COLOR = color.new(color.rgb(240, 98,  146), 45)
const color DEFAULT_FIB_50_COLOR  = color.new(color.rgb(49,  121, 245), 65)
const color DEFAULT_FIB_382_COLOR = color.new(color.rgb(102, 187, 106), 45)
const color DEFAULT_FIB_295_COLOR = color.new(color.rgb(102, 187, 106), 15)
const color DEFAULT_FIB_214_COLOR = color.new(color.rgb(102, 187, 106), 15)
const color DEFAULT_FIB_0_COLOR   = color.new(color.rgb(74,  74,  74),  65)

// Grayscale tier palette: dark = closest, light = farthest.
const color SLOT1_COLOR = color.rgb(74,  74,  74)
const color SLOT2_COLOR = color.rgb(128, 128, 128)
const color SLOT3_COLOR = color.new(color.rgb(206, 147, 216), 90)
const color SLOT4_COLOR = color.rgb(219, 219, 219)
const int   LABEL_TEXT_TRANSPARENCY = 50

const int SECS_MIN       = 60
const int SECS_HOUR      = 3600
const int SECS_DAY       = 86400
const int SECS_WEEK      = 604800
const int SECS_MONTH_AVG = 2629800
const int SECS_4_WEEKS   = 2419200
const int MS_PER_SEC     = 1000

const string LBL_TINY   = "Tiny"
const string LBL_SMALL  = "Small"
const string LBL_NORMAL = "Normal"
const string LBL_LARGE  = "Large"
const string LBL_HUGE   = "Huge"

const string LS_SOLID  = "⎯⎯⎯"
const string LS_DASHED = "----"
const string LS_DOTTED = "····"
get_line_style(string s) =>
    s == LS_DASHED ? line.style_dashed : s == LS_DOTTED ? line.style_dotted : line.style_solid

get_tf_display_label(string tf) =>
    int secs = timeframe.in_seconds(tf)
    if secs < SECS_MIN
        str.tostring(secs) + "s"
    else if secs < SECS_HOUR
        str.tostring(int(math.round(secs / float(SECS_MIN)))) + "m"
    else if secs < SECS_DAY
        str.tostring(int(math.round(secs / float(SECS_HOUR)))) + "H"
    else if secs < SECS_WEEK
        str.tostring(int(math.round(secs / float(SECS_DAY)))) + "D"
    else if secs < SECS_4_WEEKS
        str.tostring(int(math.round(secs / float(SECS_WEEK)))) + "W"
    else
        str.tostring(int(math.round(secs / float(SECS_MONTH_AVG)))) + "Mo"

// Per-slot LTF→HTF auto-pairing. Slot N resolves to N tiers above chart.
get_tf_pairing(string chart_tf, int slot) =>
    if slot == 1
        switch chart_tf
            "30S" => [true, "5",   "5m"]
            "1"   => [true, "15",  "15m"]
            "2"   => [true, "30",  "30m"]
            "3"   => [true, "60",  "1H"]
            "4"   => [true, "30",  "30m"]
            "5"   => [true, "60",  "1H"]
            "10"  => [true, "60",  "1H"]
            "15"  => [true, "240", "4H"]
            "30"  => [true, "240", "4H"]
            "45"  => [true, "240", "4H"]
            "60"  => [true, "D",   "D"]
            "120" => [true, "D",   "D"]
            "180" => [true, "D",   "D"]
            "240" => [true, "D",   "D"]
            "1D"  => [true, "W",   "W"]
            "1W"  => [true, "M",   "1Mo"]
            =>       [false, "",   ""]
    else if slot == 2
        switch chart_tf
            "30S" => [true, "15",  "15m"]
            "1"   => [true, "60",  "1H"]
            "2"   => [true, "60",  "1H"]
            "3"   => [true, "240", "4H"]
            "4"   => [true, "60",  "1H"]
            "5"   => [true, "240", "4H"]
            "10"  => [true, "240", "4H"]
            "15"  => [true, "D",   "D"]
            "30"  => [true, "D",   "D"]
            "45"  => [true, "D",   "D"]
            "60"  => [true, "W",   "W"]
            "120" => [true, "W",   "W"]
            "180" => [true, "W",   "W"]
            "240" => [true, "W",   "W"]
            "1D"  => [true, "M",   "1Mo"]
            =>       [false, "",   ""]
    else if slot == 3
        switch chart_tf
            "30S" => [true, "60",  "1H"]
            "1"   => [true, "240", "4H"]
            "2"   => [true, "240", "4H"]
            "3"   => [true, "D",   "D"]
            "4"   => [true, "240", "4H"]
            "5"   => [true, "D",   "D"]
            "10"  => [true, "D",   "D"]
            "15"  => [true, "W",   "W"]
            "30"  => [true, "W",   "W"]
            "45"  => [true, "W",   "W"]
            "60"  => [true, "M",   "1Mo"]
            "120" => [true, "M",   "1Mo"]
            "180" => [true, "M",   "1Mo"]
            "240" => [true, "M",   "1Mo"]
            =>       [false, "",   ""]
    else if slot == 4
        switch chart_tf
            "30S" => [true, "240", "4H"]
            "1"   => [true, "D",   "D"]
            "2"   => [true, "D",   "D"]
            "3"   => [true, "W",   "W"]
            "4"   => [true, "D",   "D"]
            "5"   => [true, "W",   "W"]
            "10"  => [true, "W",   "W"]
            "15"  => [true, "M",   "1Mo"]
            "30"  => [true, "M",   "1Mo"]
            "45"  => [true, "M",   "1Mo"]
            "60"  => [true, "3M",  "3Mo"]
            "120" => [true, "3M",  "3Mo"]
            "180" => [true, "3M",  "3Mo"]
            "240" => [true, "3M",  "3Mo"]
            =>       [false, "",   ""]
    else
        [false, "", ""]

// INPUTS

lookbackN  = input.int(100, "Lookback", group=GROUP_GENERAL, minval=10, maxval=500,
     tooltip="Maximum HTF candles for the expansion stats. Effective N is min(this, available HTF bars).")

// Consolidated row tooltip — Pine only renders the tooltip on the last inline input.
const string SLOT_ROW_TOOLTIP = "Slot row controls (left → right):\n\n• Enable — toggle this slot on/off\n• Manual — use the TF picker beside it (otherwise auto-pairs to N tiers above chart)\n• TF — manual timeframe (only applied when Manual is on)\n• Color — slot identity color\n• History — total visible zones (1 = current only, N = current + N−1 past)\n• Fib — draw fib levels for this slot (count comes from the global Fib History in the Fibonacci group)"

const string SLOT_LABEL_MANUAL    = "Manual"
const string SLOT_LABEL_FIB       = "Fib"
const int    SLOT_HISTORY_MIN     = 1
const int    SLOT_HISTORY_MAX     = 50
const int    SLOT_HISTORY_DEFAULT = 2

slot1Show    = input.bool(true, "1", inline="s1", group=GROUP_SLOTS)
slot1Manual  = input.bool(false, SLOT_LABEL_MANUAL, inline="s1", group=GROUP_SLOTS)
slot1TFIn    = input.timeframe("60", "", inline="s1", group=GROUP_SLOTS)
slot1Color   = input.color(SLOT1_COLOR, "", inline="s1", group=GROUP_SLOTS)
slot1History = input.int(SLOT_HISTORY_DEFAULT, "", inline="s1", group=GROUP_SLOTS, minval=SLOT_HISTORY_MIN, maxval=SLOT_HISTORY_MAX)
slot1Fib     = input.bool(false, SLOT_LABEL_FIB, inline="s1", group=GROUP_SLOTS, tooltip=SLOT_ROW_TOOLTIP)

slot2Show    = input.bool(true, "2", inline="s2", group=GROUP_SLOTS)
slot2Manual  = input.bool(false, SLOT_LABEL_MANUAL, inline="s2", group=GROUP_SLOTS)
slot2TFIn    = input.timeframe("240", "", inline="s2", group=GROUP_SLOTS)
slot2Color   = input.color(SLOT2_COLOR, "", inline="s2", group=GROUP_SLOTS)
slot2History = input.int(SLOT_HISTORY_DEFAULT, "", inline="s2", group=GROUP_SLOTS, minval=SLOT_HISTORY_MIN, maxval=SLOT_HISTORY_MAX)
slot2Fib     = input.bool(false, SLOT_LABEL_FIB, inline="s2", group=GROUP_SLOTS, tooltip=SLOT_ROW_TOOLTIP)

slot3Show    = input.bool(true, "3", inline="s3", group=GROUP_SLOTS)
slot3Manual  = input.bool(false, SLOT_LABEL_MANUAL, inline="s3", group=GROUP_SLOTS)
slot3TFIn    = input.timeframe("D", "", inline="s3", group=GROUP_SLOTS)
slot3Color   = input.color(SLOT3_COLOR, "", inline="s3", group=GROUP_SLOTS)
slot3History = input.int(SLOT_HISTORY_DEFAULT, "", inline="s3", group=GROUP_SLOTS, minval=SLOT_HISTORY_MIN, maxval=SLOT_HISTORY_MAX)
slot3Fib     = input.bool(true, SLOT_LABEL_FIB, inline="s3", group=GROUP_SLOTS, tooltip=SLOT_ROW_TOOLTIP)

slot4Show    = input.bool(true, "4", inline="s4", group=GROUP_SLOTS)
slot4Manual  = input.bool(false, SLOT_LABEL_MANUAL, inline="s4", group=GROUP_SLOTS)
slot4TFIn    = input.timeframe("W", "", inline="s4", group=GROUP_SLOTS)
slot4Color   = input.color(SLOT4_COLOR, "", inline="s4", group=GROUP_SLOTS)
slot4History = input.int(SLOT_HISTORY_DEFAULT, "", inline="s4", group=GROUP_SLOTS, minval=SLOT_HISTORY_MIN, maxval=SLOT_HISTORY_MAX)
slot4Fib     = input.bool(true, SLOT_LABEL_FIB, inline="s4", group=GROUP_SLOTS, tooltip=SLOT_ROW_TOOLTIP)

// ─── Fibonacci ───

const string FIB_TRAILING_TOOLTIP = "Off — anchors locked at Outer High / Outer Low for the life of each HTF candle.\nOn — anchors expand outward when the HTF candle's running high/low breaches the Outer band (DTT-style)."

fibTrailing = input.bool(false, "Trailing", inline="fib_h", group=GROUP_FIB, tooltip=FIB_TRAILING_TOOLTIP)
fibHistory  = input.int(1, "History", inline="fib_h", group=GROUP_FIB, minval=1, maxval=SLOT_HISTORY_MAX,
     tooltip="Number of fib zones drawn per Fib-enabled slot (current + past). Clamped to each slot's zone history.\n  1 = current HTF candle only\n  2+ = current + (N−1) past")

const int SLOT1_FIB_FADE = 0
const int SLOT2_FIB_FADE = 5
const int SLOT3_FIB_FADE = 5
const int SLOT4_FIB_FADE = 30

// Tooltip on the last inline input only — Pine drops tooltips on earlier inputs in a row.
const string FIB_ROW_TOOLTIP = "Per level: show • line color • line width • Key (labelled when Fibonacci Labels ▸ Levels = Key)."

showFib100 = input.bool(true, "1.000",   inline="fib_100", group=GROUP_FIB_LEVELS)
fibColor100= input.color(DEFAULT_FIB_100_COLOR, "", inline="fib_100", group=GROUP_FIB_LEVELS)
fibWidth100= input.int(FIB_DEFAULT_WIDTH, "", minval=FIB_MIN_WIDTH, maxval=FIB_MAX_WIDTH, inline="fib_100", group=GROUP_FIB_LEVELS)
fibKey100  = input.bool(false, "Key", inline="fib_100", group=GROUP_FIB_LEVELS, tooltip=FIB_ROW_TOOLTIP)

showFib786 = input.bool(true, "0.786", inline="fib_786", group=GROUP_FIB_LEVELS)
fibColor786= input.color(DEFAULT_FIB_786_COLOR, "", inline="fib_786", group=GROUP_FIB_LEVELS)
fibWidth786= input.int(FIB_DEFAULT_WIDTH, "", minval=FIB_MIN_WIDTH, maxval=FIB_MAX_WIDTH, inline="fib_786", group=GROUP_FIB_LEVELS)
fibKey786  = input.bool(true, "Key", inline="fib_786", group=GROUP_FIB_LEVELS, tooltip=FIB_ROW_TOOLTIP)

showFib705 = input.bool(true, "0.705", inline="fib_705", group=GROUP_FIB_LEVELS)
fibColor705= input.color(DEFAULT_FIB_705_COLOR, "", inline="fib_705", group=GROUP_FIB_LEVELS)
fibWidth705= input.int(FIB_DEFAULT_WIDTH, "", minval=FIB_MIN_WIDTH, maxval=FIB_MAX_WIDTH, inline="fib_705", group=GROUP_FIB_LEVELS)
fibKey705  = input.bool(false, "Key", inline="fib_705", group=GROUP_FIB_LEVELS, tooltip=FIB_ROW_TOOLTIP)

showFib618 = input.bool(true, "0.618", inline="fib_618", group=GROUP_FIB_LEVELS)
fibColor618= input.color(DEFAULT_FIB_618_COLOR, "", inline="fib_618", group=GROUP_FIB_LEVELS)
fibWidth618= input.int(FIB_DEFAULT_WIDTH, "", minval=FIB_MIN_WIDTH, maxval=FIB_MAX_WIDTH, inline="fib_618", group=GROUP_FIB_LEVELS)
fibKey618  = input.bool(false, "Key", inline="fib_618", group=GROUP_FIB_LEVELS, tooltip=FIB_ROW_TOOLTIP)

showFib50  = input.bool(true, "0.500",   inline="fib_50",  group=GROUP_FIB_LEVELS)
fibColor50 = input.color(DEFAULT_FIB_50_COLOR,  "", inline="fib_50",  group=GROUP_FIB_LEVELS)
fibWidth50 = input.int(FIB_DEFAULT_WIDTH, "", minval=FIB_MIN_WIDTH, maxval=FIB_MAX_WIDTH, inline="fib_50",  group=GROUP_FIB_LEVELS)
fibKey50   = input.bool(false, "Key", inline="fib_50",  group=GROUP_FIB_LEVELS, tooltip=FIB_ROW_TOOLTIP)

showFib382 = input.bool(true, "0.382", inline="fib_382", group=GROUP_FIB_LEVELS)
fibColor382= input.color(DEFAULT_FIB_382_COLOR, "", inline="fib_382", group=GROUP_FIB_LEVELS)
fibWidth382= input.int(FIB_DEFAULT_WIDTH, "", minval=FIB_MIN_WIDTH, maxval=FIB_MAX_WIDTH, inline="fib_382", group=GROUP_FIB_LEVELS)
fibKey382  = input.bool(false, "Key", inline="fib_382", group=GROUP_FIB_LEVELS, tooltip=FIB_ROW_TOOLTIP)

showFib295 = input.bool(true, "0.295", inline="fib_295", group=GROUP_FIB_LEVELS)
fibColor295= input.color(DEFAULT_FIB_295_COLOR, "", inline="fib_295", group=GROUP_FIB_LEVELS)
fibWidth295= input.int(FIB_DEFAULT_WIDTH, "", minval=FIB_MIN_WIDTH, maxval=FIB_MAX_WIDTH, inline="fib_295", group=GROUP_FIB_LEVELS)
fibKey295  = input.bool(true, "Key", inline="fib_295", group=GROUP_FIB_LEVELS, tooltip=FIB_ROW_TOOLTIP)

showFib214 = input.bool(true, "0.214", inline="fib_214", group=GROUP_FIB_LEVELS)
fibColor214= input.color(DEFAULT_FIB_214_COLOR, "", inline="fib_214", group=GROUP_FIB_LEVELS)
fibWidth214= input.int(FIB_DEFAULT_WIDTH, "", minval=FIB_MIN_WIDTH, maxval=FIB_MAX_WIDTH, inline="fib_214", group=GROUP_FIB_LEVELS)
fibKey214  = input.bool(false, "Key", inline="fib_214", group=GROUP_FIB_LEVELS, tooltip=FIB_ROW_TOOLTIP)

showFib0   = input.bool(true, "0.000",     inline="fib_0",   group=GROUP_FIB_LEVELS)
fibColor0  = input.color(DEFAULT_FIB_0_COLOR,   "", inline="fib_0",   group=GROUP_FIB_LEVELS)
fibWidth0  = input.int(FIB_DEFAULT_WIDTH, "", minval=FIB_MIN_WIDTH, maxval=FIB_MAX_WIDTH, inline="fib_0",   group=GROUP_FIB_LEVELS)
fibKey0    = input.bool(false, "Key", inline="fib_0",   group=GROUP_FIB_LEVELS, tooltip=FIB_ROW_TOOLTIP)

// ─── Fibonacci Labels ───

const string FL_OFF = "Off"
const string FL_KEY = "Key"
const string FL_ALL = "All"

const string POS_LEFT  = "Left"
const string POS_RIGHT = "Right"
const string POS_BOTH  = "Both"

const int    FIB_LABEL_OFFSET_MIN = 0
const int    FIB_LABEL_OFFSET_MAX = 500

const string FL_ROW_TOOLTIP = "Per slot: enable labels • text size • position • offset.\nPosition — Left = zone start edge, Right = live/right edge, Both = a tag at each end.\nOffset — chart bars to push tags outward (Right tags further right, Left tags further left) so stacked slots that end on the same bar don't collide."

fibLabelLevels   = input.string(FL_ALL, "Levels", options=[FL_OFF, FL_KEY, FL_ALL], inline="fl_head", group=GROUP_FIB_LABELS,
     tooltip="Tags each fib line so you can tell which line is which slot/level. Each label is prefixed with its timeframe, e.g. \"1W • 0.5\".\n\nLevels — Off · Key (only levels ticked 'Key' in Fibonacci Levels) · All (every visible level).\n\nPer-slot rows below: enable • text size • position • offset.")

fibLabelSlot1 = input.bool(false, "1", inline="fl_s1", group=GROUP_FIB_LABELS)
fibLabelSize1 = input.string(LBL_TINY,  "", options=[LBL_TINY, LBL_SMALL, LBL_NORMAL, LBL_LARGE, LBL_HUGE], inline="fl_s1", group=GROUP_FIB_LABELS)
fibLabelPos1  = input.string(POS_RIGHT, "", options=[POS_LEFT, POS_RIGHT, POS_BOTH], inline="fl_s1", group=GROUP_FIB_LABELS)
fibLabelOff1  = input.int(0, "", inline="fl_s1", group=GROUP_FIB_LABELS, minval=FIB_LABEL_OFFSET_MIN, maxval=FIB_LABEL_OFFSET_MAX, tooltip=FL_ROW_TOOLTIP)

fibLabelSlot2 = input.bool(false, "2", inline="fl_s2", group=GROUP_FIB_LABELS)
fibLabelSize2 = input.string(LBL_TINY,  "", options=[LBL_TINY, LBL_SMALL, LBL_NORMAL, LBL_LARGE, LBL_HUGE], inline="fl_s2", group=GROUP_FIB_LABELS)
fibLabelPos2  = input.string(POS_RIGHT, "", options=[POS_LEFT, POS_RIGHT, POS_BOTH], inline="fl_s2", group=GROUP_FIB_LABELS)
fibLabelOff2  = input.int(0, "", inline="fl_s2", group=GROUP_FIB_LABELS, minval=FIB_LABEL_OFFSET_MIN, maxval=FIB_LABEL_OFFSET_MAX, tooltip=FL_ROW_TOOLTIP)

fibLabelSlot3 = input.bool(true,  "3", inline="fl_s3", group=GROUP_FIB_LABELS)
fibLabelSize3 = input.string(LBL_SMALL, "", options=[LBL_TINY, LBL_SMALL, LBL_NORMAL, LBL_LARGE, LBL_HUGE], inline="fl_s3", group=GROUP_FIB_LABELS)
fibLabelPos3  = input.string(POS_BOTH, "", options=[POS_LEFT, POS_RIGHT, POS_BOTH], inline="fl_s3", group=GROUP_FIB_LABELS)
fibLabelOff3  = input.int(0, "", inline="fl_s3", group=GROUP_FIB_LABELS, minval=FIB_LABEL_OFFSET_MIN, maxval=FIB_LABEL_OFFSET_MAX, tooltip=FL_ROW_TOOLTIP)

fibLabelSlot4 = input.bool(true,  "4", inline="fl_s4", group=GROUP_FIB_LABELS)
fibLabelSize4 = input.string(LBL_SMALL, "", options=[LBL_TINY, LBL_SMALL, LBL_NORMAL, LBL_LARGE, LBL_HUGE], inline="fl_s4", group=GROUP_FIB_LABELS)
fibLabelPos4  = input.string(POS_BOTH, "", options=[POS_LEFT, POS_RIGHT, POS_BOTH], inline="fl_s4", group=GROUP_FIB_LABELS)
fibLabelOff4  = input.int(0, "", inline="fl_s4", group=GROUP_FIB_LABELS, minval=FIB_LABEL_OFFSET_MIN, maxval=FIB_LABEL_OFFSET_MAX, tooltip=FL_ROW_TOOLTIP)

showMidline  = input.bool(false, "Midline", inline="lvl_m", group=GROUP_DISPLAY,
     tooltip="50% line through each zone — midpoint between Inner and Outer on the upper side, and again on the lower side. Two lines per slot. Color is independent so the midline can be visually distinct from slot identity.")
midlineColor = input.color(color.new(color.rgb(99, 99, 99), 70), "", inline="lvl_m", group=GROUP_DISPLAY)

showDist     = input.bool(false, "Distribution", inline="lvl_d", group=GROUP_DISPLAY,
     tooltip="Distribution band at Outer ± k·σ.")
distStyle    = input.string(LS_DASHED, "", inline="lvl_d", group=GROUP_DISPLAY, options=[LS_SOLID, LS_DASHED, LS_DOTTED])
distSigmaK   = input.float(1.5, "σ", inline="lvl_d", group=GROUP_DISPLAY, minval=0.1, maxval=4.0, step=0.1,
     tooltip="Distribution± = Outer± ± k·σ.")

showZoneFill         = input.bool(true, "Fill", inline="zone", group=GROUP_ZONE,
     tooltip="Shaded box between Inner and Outer. Independent transparency below — slot color hue is used, opacity is controlled here.")
zoneFillTransparency = input.int(85, "Transparency", inline="zone", group=GROUP_ZONE, minval=0, maxval=100)

latestOnly = input.bool(true, "Latest Only", group=GROUP_GENERAL,
     tooltip="Master override — when on, draw only the most recent (in-progress) HTF zone per slot. Ignores each slot's Past-zones setting.")

const string HOLIDAY_OFF    = "Off"
const string HOLIDAY_EXTEND = "Extend"
const string HOLIDAY_NATIVE = "Native"
holidayMode = input.string(HOLIDAY_NATIVE, "Holiday Mode", options=[HOLIDAY_OFF, HOLIDAY_EXTEND, HOLIDAY_NATIVE], group=GROUP_GENERAL,
     tooltip="Handles the daily zone when TradingView merges a holiday session into one 'D' bar (e.g. Memorial Day), which otherwise leaves the day after with no range. Daily slots only.\n  Off — TradingView's merged bar.\n  Extend — stretch the merged zone to the live edge so there's no gap (keeps the merged range).\n  Native — force a fresh daily zone at the 18:00 ET reopen; open is read from the chart, band widths reuse the latest daily stats.")

const string TAG_OFF    = "Off"
const string TAG_PLAIN  = "Show"
const string TAG_SOURCE = "Show w/ source"

zoneLabelMode = input.string(TAG_SOURCE, "Zone Label", options=[TAG_OFF, TAG_PLAIN, TAG_SOURCE], group=GROUP_DISPLAY,
     tooltip="HTF identifier drawn in the center of the current zone. 'Show' = TF only (e.g. 4H). 'Show w/ source' = TF + slot superscript (e.g. 4H ¹). Size scales by slot tier.")

const string SLOT1_LABEL_SIZE = LBL_SMALL
const string SLOT2_LABEL_SIZE = LBL_NORMAL
const string SLOT3_LABEL_SIZE = LBL_LARGE
const string SLOT4_LABEL_SIZE = LBL_HUGE

// Fib label legibility: pull the line's transparency down so a faint level still gets a readable tag.
const float FIB_LABEL_TRANSPARENCY_REDUCTION = 55.0
const float FIB_LABEL_TRANSPARENCY_MAX       = 12.0


get_label_size(string s) =>
    s == LBL_TINY   ? size.tiny   :
     s == LBL_NORMAL ? size.normal :
     s == LBL_LARGE  ? size.large  :
     s == LBL_HUGE   ? size.huge   :
                       size.small

showTable = input.bool(false, "Show", group=GROUP_TABLE,
     tooltip="RGB cheat-sheet for slot colors, top-right.")

// HTF RESOLUTION

string CHART_TF = timeframe.period
[s1AutoValid, s1AutoTF, s1AutoLabel] = get_tf_pairing(CHART_TF, 1)
[s2AutoValid, s2AutoTF, s2AutoLabel] = get_tf_pairing(CHART_TF, 2)
[s3AutoValid, s3AutoTF, s3AutoLabel] = get_tf_pairing(CHART_TF, 3)
[s4AutoValid, s4AutoTF, s4AutoLabel] = get_tf_pairing(CHART_TF, 4)

string s1TF    = slot1Manual ? slot1TFIn : (s1AutoValid ? s1AutoTF : "1D")
bool   s1Valid = slot1Show and (slot1Manual or s1AutoValid) and timeframe.in_seconds(s1TF) > timeframe.in_seconds()
string s1Safe  = s1Valid ? s1TF : "1D"
string s1Label = get_tf_display_label(s1TF)
string s1ZoneLabel = zoneLabelMode == TAG_SOURCE ? s1Label + " ¹" : s1Label

string s2TF    = slot2Manual ? slot2TFIn : (s2AutoValid ? s2AutoTF : "1D")
bool   s2Valid = slot2Show and (slot2Manual or s2AutoValid) and timeframe.in_seconds(s2TF) > timeframe.in_seconds()
string s2Safe  = s2Valid ? s2TF : "1D"
string s2Label = get_tf_display_label(s2TF)
string s2ZoneLabel = zoneLabelMode == TAG_SOURCE ? s2Label + " ²" : s2Label

string s3TF    = slot3Manual ? slot3TFIn : (s3AutoValid ? s3AutoTF : "1D")
bool   s3Valid = slot3Show and (slot3Manual or s3AutoValid) and timeframe.in_seconds(s3TF) > timeframe.in_seconds()
string s3Safe  = s3Valid ? s3TF : "1D"
string s3Label = get_tf_display_label(s3TF)
string s3ZoneLabel = zoneLabelMode == TAG_SOURCE ? s3Label + " ³" : s3Label

string s4TF    = slot4Manual ? slot4TFIn : (s4AutoValid ? s4AutoTF : "1D")
bool   s4Valid = slot4Show and (slot4Manual or s4AutoValid) and timeframe.in_seconds(s4TF) > timeframe.in_seconds()
string s4Safe  = s4Valid ? s4TF : "1D"
string s4Label = get_tf_display_label(s4TF)
string s4ZoneLabel = zoneLabelMode == TAG_SOURCE ? s4Label + " ⁴" : s4Label

// HTF DATA — running high/low are tracked chart-side; request.security with lookahead_on
// for high/low on an in-progress HTF bar is unreliable in Pine v6 with tuple returns.
fetch_htf_open(string tf) =>
    request.security(syminfo.tickerid, tf, open, lookahead=barmerge.lookahead_on)

fetch_htf_stats(string tf) =>
    request.security(syminfo.tickerid, tf,
         [ta.median(high - open, lookbackN), ta.sma(high - open, lookbackN), ta.stdev(high - open, lookbackN),
          ta.median(open - low,  lookbackN), ta.sma(open - low,  lookbackN), ta.stdev(open - low,  lookbackN)],
         lookahead=barmerge.lookahead_off)

s1O = fetch_htf_open(s1Safe)
s2O = fetch_htf_open(s2Safe)
s3O = fetch_htf_open(s3Safe)
s4O = fetch_htf_open(s4Safe)

[s1MedHO, s1MeanHO, s1StdHO, s1MedOL, s1MeanOL, s1StdOL] = fetch_htf_stats(s1Safe)
[s2MedHO, s2MeanHO, s2StdHO, s2MedOL, s2MeanOL, s2StdOL] = fetch_htf_stats(s2Safe)
[s3MedHO, s3MeanHO, s3StdHO, s3MedOL, s3MeanOL, s3StdOL] = fetch_htf_stats(s3Safe)
[s4MedHO, s4MeanHO, s4StdHO, s4MedOL, s4MeanOL, s4StdOL] = fetch_htf_stats(s4Safe)

var float s1RunHigh = na
var float s1RunLow  = na
var float s2RunHigh = na
var float s2RunLow  = na
var float s3RunHigh = na
var float s3RunLow  = na
var float s4RunHigh = na
var float s4RunLow  = na

if s1Valid
    if na(s1RunHigh) or ta.change(time(s1Safe)) != 0
        s1RunHigh := high
        s1RunLow  := low
    else
        s1RunHigh := math.max(s1RunHigh, high)
        s1RunLow  := math.min(s1RunLow,  low)

if s2Valid
    if na(s2RunHigh) or ta.change(time(s2Safe)) != 0
        s2RunHigh := high
        s2RunLow  := low
    else
        s2RunHigh := math.max(s2RunHigh, high)
        s2RunLow  := math.min(s2RunLow,  low)

if s3Valid
    if na(s3RunHigh) or ta.change(time(s3Safe)) != 0
        s3RunHigh := high
        s3RunLow  := low
    else
        s3RunHigh := math.max(s3RunHigh, high)
        s3RunLow  := math.min(s3RunLow,  low)

if s4Valid
    if na(s4RunHigh) or ta.change(time(s4Safe)) != 0
        s4RunHigh := high
        s4RunLow  := low
    else
        s4RunHigh := math.max(s4RunHigh, high)
        s4RunLow  := math.min(s4RunLow,  low)

// NATIVE DAILY SESSION — rolls at the 18:00 ET reopen regardless of TradingView's
// holiday-merged "D" bar. Shifting +6h maps 18:00 ET to the next NY calendar date.
const int NATIVE_SHIFT_MS = 6 * SECS_HOUR * MS_PER_SEC
const string NATIVE_TZ    = "America/New_York"
int  nativeShifted = time + NATIVE_SHIFT_MS
int  nativeTradeId = year(nativeShifted, NATIVE_TZ) * 10000 + month(nativeShifted, NATIVE_TZ) * 100 + dayofmonth(nativeShifted, NATIVE_TZ)
bool nativeNewDay  = ta.change(nativeTradeId) != 0
var int   nativeDayStart = na
var float nativeOpen     = na
var float nativeRunHigh  = na
var float nativeRunLow   = na
if nativeNewDay or na(nativeDayStart)
    nativeDayStart := time
    nativeOpen     := open
    nativeRunHigh  := high
    nativeRunLow   := low
else
    nativeRunHigh := math.max(nativeRunHigh, high)
    nativeRunLow  := math.min(nativeRunLow,  low)



// SLOT STATE

type SlotState
    array<box>   histBoxes
    array<line>  histDistLines
    box   fillUp
    box   fillLo
    line  innH
    line  innL
    line  outH
    line  outL
    line  midUp
    line  midDn
    line  distP
    line  distM
    array<line>  fibLines      // current-zone fib level lines (up to 9)
    array<line>  histFibLines  // historical fib level lines, capped at (fibHistory - 1) × 9 per slot
    array<label> fibLabels     // current-zone right-edge fib labels (up to 9)

new_slot() =>
    SlotState.new(histBoxes=array.new<box>(), histDistLines=array.new<line>(),
         fibLines=array.new<line>(), histFibLines=array.new<line>(), fibLabels=array.new<label>())

var SlotState slot1 = new_slot()
var SlotState slot2 = new_slot()
var SlotState slot3 = new_slot()
var SlotState slot4 = new_slot()

// DRAWING HELPERS

zone_fill_color(color slotColor) =>
    showZoneFill ? color.new(slotColor, zoneFillTransparency) : color.new(color.white, 100)

make_zone_box(int leftT, float top, int rightT, float bottom, color fillClr, color slotColor, string txt, string slotLabelSize) =>
    box.new(leftT, top, rightT, bottom,
         bgcolor=fillClr, border_color=na, xloc=xloc.bar_time,
         text=txt, text_color=color.new(slotColor, LABEL_TEXT_TRANSPARENCY),
         text_size=get_label_size(slotLabelSize),
         text_halign=text.align_center, text_valign=text.align_center)

// Returns [innerHigh, outerHigh, innerLow, outerLow, distPlus, distMinus]
compute_levels(float htfO, float medHO, float meanHO, float stdHO, float medOL, float meanOL, float stdOL, float k) =>
    [htfO + medHO, htfO + meanHO,
     htfO - medOL, htfO - meanOL,
     htfO + meanHO + k * stdHO,
     htfO - meanOL - k * stdOL]

// Pushes one line per visible fib level into `target`. Anchors define 0% / 100% of the fib range.
push_fib_lines(array<line> target, int leftT, int rightT, float anchorHigh, float anchorLow, int transparencyBoost,
               array<label> labelTarget, string tfLabel, bool drawLabels, string labelSize, string labelPos, int labelOffsetMs) =>
    if not na(anchorHigh) and not na(anchorLow)
        float fibRange = anchorHigh - anchorLow

        shows      = array.from(showFib100, showFib786, showFib705, showFib618, showFib50, showFib382, showFib295, showFib214, showFib0)
        levels     = array.from(FIB_LEVEL_100, FIB_LEVEL_786, FIB_LEVEL_705, FIB_LEVEL_618, FIB_LEVEL_50, FIB_LEVEL_382, FIB_LEVEL_295, FIB_LEVEL_214, FIB_LEVEL_0)
        colors     = array.from(fibColor100, fibColor786, fibColor705, fibColor618, fibColor50, fibColor382, fibColor295, fibColor214, fibColor0)
        widths     = array.from(fibWidth100, fibWidth786, fibWidth705, fibWidth618, fibWidth50, fibWidth382, fibWidth295, fibWidth214, fibWidth0)
        ratioTexts = array.from("1.0", "0.786", "0.705", "0.618", "0.5", "0.382", "0.295", "0.214", "0")
        isKeyLevel = array.from(fibKey100, fibKey786, fibKey705, fibKey618, fibKey50, fibKey382, fibKey295, fibKey214, fibKey0)

        bool keyOnly = fibLabelLevels == FL_KEY

        for i = 0 to 8
            if array.get(shows, i)
                float price   = anchorLow + fibRange * array.get(levels, i)
                color baseClr = array.get(colors, i)
                // Clamp at 95 so higher-tier slots never become fully invisible.
                color clr     = color.new(baseClr, math.min(int(color.t(baseClr)) + transparencyBoost, 95))
                array.push(target, line.new(leftT, price, rightT, price, color=clr, style=line.style_dotted, width=array.get(widths, i), xloc=xloc.bar_time))

                if drawLabels and (not keyOnly or array.get(isKeyLevel, i))
                    // Tint label text to match its line, but pull transparency down so faint levels stay legible.
                    color  txtClr  = color.new(baseClr, math.min(FIB_LABEL_TRANSPARENCY_MAX, math.max(0.0, color.t(baseClr) - FIB_LABEL_TRANSPARENCY_REDUCTION)))
                    string lblText = tfLabel + " • " + array.get(ratioTexts, i)
                    // Offset pushes each tag outward from its anchor edge (right tags later, left tags earlier)
                    // so slots whose zones end on the same bar don't stack their tags on one x-coordinate.
                    if labelPos == POS_RIGHT or labelPos == POS_BOTH
                        array.push(labelTarget, label.new(rightT + labelOffsetMs, price, lblText, xloc=xloc.bar_time, style=label.style_label_left,  color=color.new(color.white, 100), textcolor=txtClr, size=labelSize))
                    if labelPos == POS_LEFT or labelPos == POS_BOTH
                        array.push(labelTarget, label.new(leftT - labelOffsetMs,  price, lblText, xloc=xloc.bar_time, style=label.style_label_right, color=color.new(color.white, 100), textcolor=txtClr, size=labelSize))

draw_slot_fib(SlotState s, int leftT, int rightT, float anchorHigh, float anchorLow, int transparencyBoost, string tfLabel, bool drawLabels, string labelSize, string labelPos, int labelOffsetMs) =>
    push_fib_lines(s.fibLines, leftT, rightT, anchorHigh, anchorLow, transparencyBoost, s.fibLabels, tfLabel, drawLabels, labelSize, labelPos, labelOffsetMs)

// Resolves a slot's rollover signal + zone anchors + effective open/run-high/low, applying the
// daily holiday override. Returns [transitionNow, zoneStart, curLeft, curRight, open, runHigh, runLow].
resolve_slot_timing(string safe, float normOpen, float normRunHigh, float normRunLow,
                    bool nNewDay, int nDayStart, float nOpen, float nRunHigh, float nRunLow) =>
    bool isDaily   = timeframe.in_seconds(safe) == SECS_DAY
    int  normStart = time(safe)
    int  normRight = normStart + timeframe.in_seconds(safe) * MS_PER_SEC
    bool normTrans = ta.change(time(safe)) != 0
    if isDaily and holidayMode == HOLIDAY_NATIVE
        [nNewDay, nDayStart, nDayStart, nDayStart + SECS_DAY * MS_PER_SEC, nOpen, nRunHigh, nRunLow]
    else if isDaily and holidayMode == HOLIDAY_EXTEND
        [normTrans, normStart, normStart, (normRight > time ? normRight : time), normOpen, normRunHigh, normRunLow]
    else
        [normTrans, normStart, normStart, normRight, normOpen, normRunHigh, normRunLow]

// On HTF transition, [1] reads give us the just-closed bar's open + the stats as of its
// start (i.e. excluding it) — exactly what was used to project that bar in real time.
update_slot(SlotState s, bool valid, bool transitionNow, int zoneStart, float htfO, float runHigh, float runLow, color slotColor, string htfLabel,
             float medHO, float meanHO, float stdHO, float medOL, float meanOL, float stdOL,
             int historyN, string slotLabelSize,
             bool fibEnabled, int fibFade) =>
    // Cap is enforced every bar so input changes trim immediately, not on next HTF transition.
    int effectiveCap = latestOnly ? 0 : (historyN - 1) * 2
    while array.size(s.histBoxes) > effectiveCap
        box.delete(array.shift(s.histBoxes))
    while array.size(s.histDistLines) > effectiveCap
        line.delete(array.shift(s.histDistLines))

    // Clamp fib history to the slot's zone history so fib lines never outlive their zone.
    int effectiveFibHistory = math.min(fibHistory, historyN)
    int fibHistCap = (not fibEnabled or latestOnly) ? 0 : (effectiveFibHistory - 1) * 9
    while array.size(s.histFibLines) > fibHistCap
        line.delete(array.shift(s.histFibLines))

    if valid and transitionNow
        prevO      = htfO[1]
        prevMedHO  = medHO[1]
        prevMeanHO = meanHO[1]
        prevStdHO  = stdHO[1]
        prevMedOL  = medOL[1]
        prevMeanOL = meanOL[1]
        prevStdOL  = stdOL[1]

        if not na(prevO) and not na(prevMedHO) and not na(prevMedOL)
            [h_innH, h_outH, h_innL, h_outL, h_distP, h_distM] = compute_levels(prevO, prevMedHO, prevMeanHO, prevStdHO, prevMedOL, prevMeanOL, prevStdOL, distSigmaK)
            bar_l = zoneStart[1]
            bar_r = zoneStart

            if effectiveCap > 0
                if showZoneFill
                    color fillClr = zone_fill_color(slotColor)
                    array.push(s.histBoxes, make_zone_box(bar_l, h_outH, bar_r, h_innH, fillClr, slotColor, "", slotLabelSize))
                    array.push(s.histBoxes, make_zone_box(bar_l, h_innL, bar_r, h_outL, fillClr, slotColor, "", slotLabelSize))
                    while array.size(s.histBoxes) > effectiveCap
                        box.delete(array.shift(s.histBoxes))

                if showDist and not na(prevStdHO) and not na(prevStdOL)
                    array.push(s.histDistLines, line.new(bar_l, h_distP, bar_r, h_distP, color=slotColor, style=get_line_style(distStyle), width=1, xloc=xloc.bar_time))
                    array.push(s.histDistLines, line.new(bar_l, h_distM, bar_r, h_distM, color=slotColor, style=get_line_style(distStyle), width=1, xloc=xloc.bar_time))
                    while array.size(s.histDistLines) > effectiveCap
                        line.delete(array.shift(s.histDistLines))

            if fibHistCap > 0
                float prevRunHigh   = runHigh[1]
                float prevRunLow    = runLow[1]
                float histAnchorHigh = fibTrailing ? math.max(h_outH, prevRunHigh) : h_outH
                float histAnchorLow  = fibTrailing ? math.min(h_outL, prevRunLow)  : h_outL
                push_fib_lines(s.histFibLines, bar_l, bar_r, histAnchorHigh, histAnchorLow, fibFade, s.fibLabels, htfLabel, false, slotLabelSize, POS_RIGHT, 0)
                while array.size(s.histFibLines) > fibHistCap
                    line.delete(array.shift(s.histFibLines))

draw_slot_current(SlotState s, bool valid, string htfSafe, int curLeft, int curRight, float htfO, float htfH, float htfL, color slotColor, string htfLabel,
                   float medHO, float meanHO, float stdHO, float medOL, float meanOL, float stdOL,
                   string slotLabelSize, bool fibEnabled, int fibTransparencyBoost, bool labelSlotEnabled, string fibLabelSize, string fibLabelPos, int fibLabelOffsetMs) =>
    // Null after delete so toggling a feature off mid-session leaves no dangling handle.
    if not na(s.fillUp)
        box.delete(s.fillUp)
        s.fillUp := na
    if not na(s.fillLo)
        box.delete(s.fillLo)
        s.fillLo := na
    if not na(s.innH)
        line.delete(s.innH)
        s.innH := na
    if not na(s.innL)
        line.delete(s.innL)
        s.innL := na
    if not na(s.outH)
        line.delete(s.outH)
        s.outH := na
    if not na(s.outL)
        line.delete(s.outL)
        s.outL := na
    if not na(s.midUp)
        line.delete(s.midUp)
        s.midUp := na
    if not na(s.midDn)
        line.delete(s.midDn)
        s.midDn := na
    if not na(s.distP)
        line.delete(s.distP)
        s.distP := na
    if not na(s.distM)
        line.delete(s.distM)
        s.distM := na
    while array.size(s.fibLines) > 0
        line.delete(array.pop(s.fibLines))
    while array.size(s.fibLabels) > 0
        label.delete(array.pop(s.fibLabels))

    if valid and not na(medHO) and not na(medOL)
        [innerHigh, outerHigh, innerLow, outerLow, distPlus, distMinus] = compute_levels(htfO, medHO, meanHO, stdHO, medOL, meanOL, stdOL, distSigmaK)

        leftT  = curLeft
        rightT = curRight

        bool   tagCurrent = zoneLabelMode != TAG_OFF
        string boxText    = tagCurrent ? htfLabel : ""
        color  fillClr    = zone_fill_color(slotColor)
        if showZoneFill or tagCurrent
            s.fillUp := make_zone_box(leftT, outerHigh, rightT, innerHigh, fillClr, slotColor, boxText, slotLabelSize)
            s.fillLo := make_zone_box(leftT, innerLow,  rightT, outerLow,  fillClr, slotColor, boxText, slotLabelSize)

        s.innH := line.new(leftT, innerHigh, rightT, innerHigh, color=slotColor, style=line.style_solid, width=1, xloc=xloc.bar_time)
        s.innL := line.new(leftT, innerLow,  rightT, innerLow,  color=slotColor, style=line.style_solid, width=1, xloc=xloc.bar_time)
        s.outH := line.new(leftT, outerHigh, rightT, outerHigh, color=slotColor, style=line.style_solid, width=1, xloc=xloc.bar_time)
        s.outL := line.new(leftT, outerLow,  rightT, outerLow,  color=slotColor, style=line.style_solid, width=1, xloc=xloc.bar_time)

        if showMidline
            float midUpY = (innerHigh + outerHigh) / 2
            float midDnY = (innerLow  + outerLow)  / 2
            s.midUp := line.new(leftT, midUpY, rightT, midUpY, color=midlineColor, style=line.style_dashed, width=1, xloc=xloc.bar_time)
            s.midDn := line.new(leftT, midDnY, rightT, midDnY, color=midlineColor, style=line.style_dashed, width=1, xloc=xloc.bar_time)

        if showDist
            s.distP := line.new(leftT, distPlus,  rightT, distPlus,  color=slotColor, style=get_line_style(distStyle), width=1, xloc=xloc.bar_time)
            s.distM := line.new(leftT, distMinus, rightT, distMinus, color=slotColor, style=get_line_style(distStyle), width=1, xloc=xloc.bar_time)

        if fibEnabled
            float fibAnchorHigh = fibTrailing ? math.max(outerHigh, htfH) : outerHigh
            float fibAnchorLow  = fibTrailing ? math.min(outerLow,  htfL) : outerLow
            draw_slot_fib(s, leftT, rightT, fibAnchorHigh, fibAnchorLow, fibTransparencyBoost, get_tf_display_label(htfSafe), labelSlotEnabled, fibLabelSize, fibLabelPos, fibLabelOffsetMs)


// DISPATCH — every bar maintains state per slot

[s1Trans, s1Start, s1CurL, s1CurR, s1OEff, s1RHi, s1RLo] = resolve_slot_timing(s1Safe, s1O, s1RunHigh, s1RunLow, nativeNewDay, nativeDayStart, nativeOpen, nativeRunHigh, nativeRunLow)
[s2Trans, s2Start, s2CurL, s2CurR, s2OEff, s2RHi, s2RLo] = resolve_slot_timing(s2Safe, s2O, s2RunHigh, s2RunLow, nativeNewDay, nativeDayStart, nativeOpen, nativeRunHigh, nativeRunLow)
[s3Trans, s3Start, s3CurL, s3CurR, s3OEff, s3RHi, s3RLo] = resolve_slot_timing(s3Safe, s3O, s3RunHigh, s3RunLow, nativeNewDay, nativeDayStart, nativeOpen, nativeRunHigh, nativeRunLow)
[s4Trans, s4Start, s4CurL, s4CurR, s4OEff, s4RHi, s4RLo] = resolve_slot_timing(s4Safe, s4O, s4RunHigh, s4RunLow, nativeNewDay, nativeDayStart, nativeOpen, nativeRunHigh, nativeRunLow)

update_slot(slot1, s1Valid, s1Trans, s1Start, s1OEff, s1RHi, s1RLo, slot1Color, s1ZoneLabel, s1MedHO, s1MeanHO, s1StdHO, s1MedOL, s1MeanOL, s1StdOL, slot1History, SLOT1_LABEL_SIZE, slot1Fib, SLOT1_FIB_FADE)
update_slot(slot2, s2Valid, s2Trans, s2Start, s2OEff, s2RHi, s2RLo, slot2Color, s2ZoneLabel, s2MedHO, s2MeanHO, s2StdHO, s2MedOL, s2MeanOL, s2StdOL, slot2History, SLOT2_LABEL_SIZE, slot2Fib, SLOT2_FIB_FADE)
update_slot(slot3, s3Valid, s3Trans, s3Start, s3OEff, s3RHi, s3RLo, slot3Color, s3ZoneLabel, s3MedHO, s3MeanHO, s3StdHO, s3MedOL, s3MeanOL, s3StdOL, slot3History, SLOT3_LABEL_SIZE, slot3Fib, SLOT3_FIB_FADE)
update_slot(slot4, s4Valid, s4Trans, s4Start, s4OEff, s4RHi, s4RLo, slot4Color, s4ZoneLabel, s4MedHO, s4MeanHO, s4StdHO, s4MedOL, s4MeanOL, s4StdOL, slot4History, SLOT4_LABEL_SIZE, slot4Fib, SLOT4_FIB_FADE)

bool fibLabelsOn = fibLabelLevels != FL_OFF
bool fibLabel1On = fibLabelsOn and fibLabelSlot1
bool fibLabel2On = fibLabelsOn and fibLabelSlot2
bool fibLabel3On = fibLabelsOn and fibLabelSlot3
bool fibLabel4On = fibLabelsOn and fibLabelSlot4

// Offset inputs are in chart bars; convert to the bar_time delta the labels are placed against.
int chartBarMs = timeframe.in_seconds(timeframe.period) * MS_PER_SEC

if barstate.islast
    draw_slot_current(slot1, s1Valid, s1Safe, s1CurL, s1CurR, s1OEff, s1RHi, s1RLo, slot1Color, s1ZoneLabel, s1MedHO, s1MeanHO, s1StdHO, s1MedOL, s1MeanOL, s1StdOL, SLOT1_LABEL_SIZE, slot1Fib, SLOT1_FIB_FADE, fibLabel1On, get_label_size(fibLabelSize1), fibLabelPos1, fibLabelOff1 * chartBarMs)
    draw_slot_current(slot2, s2Valid, s2Safe, s2CurL, s2CurR, s2OEff, s2RHi, s2RLo, slot2Color, s2ZoneLabel, s2MedHO, s2MeanHO, s2StdHO, s2MedOL, s2MeanOL, s2StdOL, SLOT2_LABEL_SIZE, slot2Fib, SLOT2_FIB_FADE, fibLabel2On, get_label_size(fibLabelSize2), fibLabelPos2, fibLabelOff2 * chartBarMs)
    draw_slot_current(slot3, s3Valid, s3Safe, s3CurL, s3CurR, s3OEff, s3RHi, s3RLo, slot3Color, s3ZoneLabel, s3MedHO, s3MeanHO, s3StdHO, s3MedOL, s3MeanOL, s3StdOL, SLOT3_LABEL_SIZE, slot3Fib, SLOT3_FIB_FADE, fibLabel3On, get_label_size(fibLabelSize3), fibLabelPos3, fibLabelOff3 * chartBarMs)
    draw_slot_current(slot4, s4Valid, s4Safe, s4CurL, s4CurR, s4OEff, s4RHi, s4RLo, slot4Color, s4ZoneLabel, s4MedHO, s4MeanHO, s4StdHO, s4MedOL, s4MeanOL, s4StdOL, SLOT4_LABEL_SIZE, slot4Fib, SLOT4_FIB_FADE, fibLabel4On, get_label_size(fibLabelSize4), fibLabelPos4, fibLabelOff4 * chartBarMs)

// COLOR REFERENCE TABLE

addRow(table tbl, int row, string name, color clr) =>
    table.cell(tbl, 0, row, name, text_size=size.small, text_color=color.black)
    table.cell(tbl, 1, row, str.format("R:{0} G:{1} B:{2}", int(color.r(clr)), int(color.g(clr)), int(color.b(clr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 2, row, str.tostring(int(color.t(clr))), text_size=size.small, text_color=color.black)

if showTable and barstate.islast
    var table colorTable = table.new(position.top_right, 3, 15, bgcolor=color.white, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)
    table.cell(colorTable, 0, 0, "Setting", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 1, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 2, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    int row = 1
    addRow(colorTable, row, "Slot 1", slot1Color)
    row += 1
    addRow(colorTable, row, "Slot 2", slot2Color)
    row += 1
    addRow(colorTable, row, "Slot 3", slot3Color)
    row += 1
    addRow(colorTable, row, "Slot 4", slot4Color)
    row += 1
    addRow(colorTable, row, "Midline", midlineColor)
    row += 1

    bool anyFib = slot1Fib or slot2Fib or slot3Fib or slot4Fib
    if anyFib
        if showFib100
            addRow(colorTable, row, "Fib 1.0", fibColor100)
            row += 1
        if showFib786
            addRow(colorTable, row, "Fib 0.786", fibColor786)
            row += 1
        if showFib705
            addRow(colorTable, row, "Fib 0.705", fibColor705)
            row += 1
        if showFib618
            addRow(colorTable, row, "Fib 0.618", fibColor618)
            row += 1
        if showFib50
            addRow(colorTable, row, "Fib 0.5", fibColor50)
            row += 1
        if showFib382
            addRow(colorTable, row, "Fib 0.382", fibColor382)
            row += 1
        if showFib295
            addRow(colorTable, row, "Fib 0.295", fibColor295)
            row += 1
        if showFib214
            addRow(colorTable, row, "Fib 0.214", fibColor214)
            row += 1
        if showFib0
            addRow(colorTable, row, "Fib 0", fibColor0)
            row += 1
