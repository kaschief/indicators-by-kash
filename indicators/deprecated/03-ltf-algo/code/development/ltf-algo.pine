//@version=6

// Indicator meta constants
const string INDICATOR_TITLE = 'ltf algo •'
const string SHORT_INDICATOR_TITLE = 'ltf algo •'
const bool   OVERLAY_ENABLED = true
const int    IND_MAX_LINES   = 500
const int    IND_MAX_LABELS  = 500

indicator(INDICATOR_TITLE, shorttitle=SHORT_INDICATOR_TITLE, overlay=OVERLAY_ENABLED, max_lines_count=IND_MAX_LINES, max_labels_count=IND_MAX_LABELS)

// ═══════════════════════════════════════════════════════════════════════════════
// LTF ALGO DRAW° [PRO+] - LOWER TIMEFRAME ALGORITHMIC LIQUIDITY DETECTION
// ═══════════════════════════════════════════════════════════════════════════════
//
// ALGORITHM CONCEPT:
// • BSL (Buy-Side Liquidity): Failed break down → draw up to high
// • SSL (Sell-Side Liquidity): Failed break up → draw down to low
// • Real-time fill detection with instant visual feedback
// • Tick-based deduplication for all symbol types
// • Smart timeframe defaults for optimal performance
//
// BSL-FIRST DESIGN: All ordering prioritizes Buy-Side Liquidity throughout
// ═══════════════════════════════════════════════════════════════════════════════

// Magic numbers
const int MS_IN_SEC = 1000
const int FILLED_LINES_CAP = 10
const int MEMORY_MIN_TOTAL_MAX = 100
const int MEMORY_PRUNE_MULTIPLIER = 8
const int DASHBOARD_BASE_ROWS = 3
const int TABLE_SPACER_TRANSPARENCY = 100

// Reused text
const string ALGO_DRAW_TEXT = " algo draw"
const string SUFFIX_B = "(b)"
const string SUFFIX_S = "(s)"
const string SUFFIX_FILLED = " Filled"
const string TOOLTIP_TIME_FORMAT = "MMM dd, yyyy HH:mm"
const string TOOLTIP_BSL_PREFIX = "BSL: Wick took LOW"
const string TOOLTIP_SSL_PREFIX = "SSL: Wick took HIGH"
const string DASH_TEXT_LTF = "LTF"
const string DASH_PREFIX_BSL = "BSL: "
const string DASH_PREFIX_SSL = "SSL: "

// Style options
const string STYLE_SOLID = 'Solid'
const string STYLE_DASHED = 'Dashed'
const string STYLE_DOTTED = 'Dotted'

// Size options
const string SIZE_TINY = 'Tiny'
const string SIZE_SMALL = 'Small'
const string SIZE_NORMAL = 'Normal'
const string SIZE_LARGE = 'Large'

// Position options
const string POS_TOP_LEFT = 'Top Left'
const string POS_TOP_CENTER = 'Top Center'
const string POS_TOP_RIGHT = 'Top Right'
const string POS_MIDDLE_LEFT = 'Middle Left'
const string POS_MIDDLE_CENTER = 'Middle Center'
const string POS_MIDDLE_RIGHT = 'Middle Right'
const string POS_BOTTOM_LEFT = 'Bottom Left'
const string POS_BOTTOM_CENTER = 'Bottom Center'
const string POS_BOTTOM_RIGHT = 'Bottom Right'

// Timeframe suffixes
const string TF_SUFFIX_HOURS = 'H'
const string TF_SUFFIX_MINUTES = 'm'
const string TF_SUFFIX_DAYS = 'D'
const string TF_SUFFIX_WEEKS = 'W'
const string TF_SUFFIX_MONTHS = 'M'

// Timeframe periods
const string TF_1MIN = '1'
const string TF_2MIN = '2'
const string TF_3MIN = '3'
const string TF_5MIN = '5'
const string TF_10MIN = '10'
const string TF_15MIN = '15'
const string TF_30MIN = '30'
const string TF_45MIN = '45'
const string TF_60MIN = '60'
const string TF_90MIN = '90'
const string TF_120MIN = '120'
const string TF_180MIN = '180'
const string TF_240MIN = '240'
const string TF_1DAY = '1D'
const string TF_1WEEK = '1W'

// Reference level caps per TF bucket
CAP_ULTRA_SHORT = 80
CAP_SHORT = 100
CAP_MEDIUM_SHORT = 150
CAP_MEDIUM = 200
CAP_MEDIUM_LONG = 300
CAP_LONG = 400
CAP_DEFAULT = 200

// Smart backfill bars per TF bucket
BACKFILL_ULTRA_SHORT = 800
BACKFILL_SHORT = 600
BACKFILL_MEDIUM_SHORT = 500
BACKFILL_MEDIUM = 400
BACKFILL_MEDIUM_LONG = 300
BACKFILL_LONG = 250
BACKFILL_DEFAULT = 400

// ═══════════════════════════════════════════════════════════════════════════════
// INPUT SETTINGS - PROFESSIONAL LAYOUT (after constants)
// ═══════════════════════════════════════════════════════════════════════════════

// Inputs
open_lines_count = input.int(2, 'Max Active Lines', minval=0, maxval=100, group='Display', tooltip='Maximum active draws to display (per BSL/SSL). Filled draws capped at 10.')
show_filled = input.bool(true, 'Show Filled', group='Display', inline='display_opts', tooltip='Show filled levels')
show_price_on_label = input.bool(true, 'Price', group='Display', inline='display_opts', tooltip='Append price to label')

buyside_color = input.color(color.rgb(104, 247, 27), 'BSL Open', group='Colors', inline='bsl')
buyside_filled_color = input.color(color.rgb(249, 121, 246), 'Filled', group='Colors', inline='bsl')
bsl_label_text_color = input.color(color.rgb(242, 54, 69), 'Label', group='Colors', inline='bsl')
sellside_color = input.color(color.rgb(104, 247, 27), 'SSL Open', group='Colors', inline='ssl')
sellside_filled_color = input.color(color.rgb(249, 121, 246), 'Filled', group='Colors', inline='ssl')
ssl_label_text_color = input.color(color.rgb(49, 121, 245), 'Label', group='Colors', inline='ssl')

open_style = input.string(STYLE_SOLID, 'Open Style', options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], group='Line Styles', inline='open')
open_width = input.int(3, 'Width', minval=1, maxval=5, group='Line Styles', inline='open')
filled_style = input.string(STYLE_DASHED, 'Filled Style', options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], group='Line Styles', inline='filled')
filled_width = input.int(2, 'Width', minval=1, maxval=5, group='Line Styles', inline='filled')
filled_opacity = input.int(70, 'Opacity', minval=0, maxval=95, group='Line Styles', inline='filled')

show_dashboard = input.bool(false, 'Show', group='Dashboard', inline='show')
table_position = input.string(POS_MIDDLE_RIGHT, 'Position', options=[POS_TOP_LEFT, POS_TOP_CENTER, POS_TOP_RIGHT, POS_MIDDLE_LEFT, POS_MIDDLE_CENTER, POS_MIDDLE_RIGHT, POS_BOTTOM_LEFT, POS_BOTTOM_CENTER, POS_BOTTOM_RIGHT], group='Dashboard', inline='show')
table_bg_color = input.color(color.new(color.rgb(41, 98, 255), 90), 'Background', group='Dashboard', inline='style')
default_text_color = input.color(color.rgb(120, 123, 134), 'Label', group='Dashboard', inline='style')
table_y_offset = input.int(12, 'Y Offset', minval=0, maxval=50, group='Dashboard', inline='style')
show_color_table = input.bool(false, 'Color Reference Table', group='Dashboard')

enable_smart_defaults = true
lookback_bars = 1500
extend_bars = 1

// ═══════════════════════════════════════════════════════════════════════════════
// CORE DATA STRUCTURES - BSL FIRST ORDERING
// ═══════════════════════════════════════════════════════════════════════════════

// BUY-SIDE ALGO DRAWS (BSL) - PRIMARY
var array<int> buyside_failure_bars = array.new<int>()
var array<int> buyside_failure_times = array.new<int>()
var array<float> buyside_targets = array.new<float>()
var array<bool> buyside_open = array.new<bool>()
var array<int> buyside_fill_bars = array.new<int>()
var array<int> buyside_fill_times = array.new<int>()
var array<line> buyside_lines = array.new<line>()
var array<label> buyside_labels = array.new<label>()
var array<int> buyside_wick_times = array.new<int>()

// SELL-SIDE ALGO DRAWS (SSL) - SECONDARY
var array<int> sellside_failure_bars = array.new<int>()
var array<int> sellside_failure_times = array.new<int>()
var array<float> sellside_targets = array.new<float>()
var array<bool> sellside_open = array.new<bool>()
var array<int> sellside_fill_bars = array.new<int>()
var array<int> sellside_fill_times = array.new<int>()
var array<line> sellside_lines = array.new<line>()
var array<label> sellside_labels = array.new<label>()
var array<int> sellside_wick_times = array.new<int>()

// TICK-BASED LEVEL TRACKING
var array<int> eligible_high_ticks = array.new<int>()
var array<int> eligible_low_ticks = array.new<int>()
var array<int> eligible_high_times = array.new<int>()
var array<int> eligible_low_times = array.new<int>()

// STATE MANAGEMENT
var string last_ticker = ticker.standard()
var string last_tf = timeframe.period
var bool initialized = false
var table info_table = na
var int bars_processed = 0
var int cached_bsl_open = -1
var int cached_ssl_open = -1

filled_lines_count = FILLED_LINES_CAP

// ═══════════════════════════════════════════════════════════════════════════════
// INPUT CHANGE DETECTION SYSTEM - FIX FOR VISUAL DUPLICATION
// ═══════════════════════════════════════════════════════════════════════════════

var string last_ltf_settings_hash = ""
var bool ltf_inputs_changed = false

// Helper: stringify a color as RGBA parts for stable hashing (single-line to avoid line-continuation issues)
// Note: Pine uses transparency (0-100) instead of alpha; use color.t() not color.a()
color_key(col) => str.tostring(color.r(col)) + "," + str.tostring(color.g(col)) + "," + str.tostring(color.b(col)) + "," + str.tostring(color.t(col))

// Create settings fingerprint to detect ANY input change that affects visuals
create_ltf_settings_hash() =>
    hash_text = str.tostring(open_lines_count)
    hash_text := hash_text + "|" + str.tostring(filled_opacity)
    hash_text := hash_text + "|" + str.tostring(open_width)
    hash_text := hash_text + "|" + str.tostring(filled_width)
    hash_text := hash_text + "|" + open_style
    hash_text := hash_text + "|" + filled_style
    hash_text := hash_text + "|" + color_key(buyside_color)
    hash_text := hash_text + "|" + color_key(sellside_color)
    hash_text := hash_text + "|" + color_key(buyside_filled_color)
    hash_text := hash_text + "|" + color_key(sellside_filled_color)
    hash_text := hash_text + "|" + color_key(bsl_label_text_color)
    hash_text := hash_text + "|" + color_key(ssl_label_text_color)
    hash_text := hash_text + "|" + str.tostring(show_dashboard)
    hash_text := hash_text + "|" + table_position
    hash_text := hash_text + "|" + color_key(table_bg_color)
    hash_text := hash_text + "|" + color_key(default_text_color)
    hash_text := hash_text + "|" + str.tostring(table_y_offset)
    hash_text := hash_text + "|" + str.tostring(enable_smart_defaults)
    hash_text := hash_text + "|" + str.tostring(lookback_bars)
    hash_text := hash_text + "|" + str.tostring(show_price_on_label)
    hash_text

// ═══════════════════════════════════════════════════════════════════════════════
// UTILITY FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// Convert price to tick for precise deduplication
to_tick(price) => math.round(price / syminfo.mintick)
from_tick(tick) => tick * syminfo.mintick

// Style conversions
get_line_style(style_string) =>
    switch style_string
        STYLE_DASHED => line.style_dashed
        STYLE_DOTTED => line.style_dotted
        => line.style_solid

get_label_text_size() => size.tiny
get_table_text_size() => size.tiny

// Table positioning
get_table_position() =>
    switch table_position
        POS_TOP_LEFT => position.top_left
        POS_TOP_CENTER => position.top_center
        POS_TOP_RIGHT => position.top_right
        POS_MIDDLE_LEFT => position.middle_left
        POS_MIDDLE_CENTER => position.middle_center
        POS_MIDDLE_RIGHT => position.middle_right
        POS_BOTTOM_LEFT => position.bottom_left
        POS_BOTTOM_CENTER => position.bottom_center
        POS_BOTTOM_RIGHT => position.bottom_right
        => position.middle_right

// Timeframe formatting
get_tf_tag() =>
    if timeframe.isintraday
        m = timeframe.multiplier
        m % 60 == 0 ? str.tostring(m / 60) + TF_SUFFIX_HOURS : str.tostring(m) + TF_SUFFIX_MINUTES
    else if timeframe.isdaily
        str.tostring(timeframe.multiplier) + TF_SUFFIX_DAYS
    else if timeframe.isweekly
        str.tostring(timeframe.multiplier) + TF_SUFFIX_WEEKS
    else if timeframe.ismonthly
        str.tostring(timeframe.multiplier) + TF_SUFFIX_MONTHS
    else
        timeframe.period

get_timeframe_text() => get_tf_tag() + ALGO_DRAW_TEXT
get_timeframe_text_with_suffix(is_bsl, price) =>
    base_text = get_tf_tag() + ALGO_DRAW_TEXT
    suffix_text = is_bsl ? SUFFIX_B : SUFFIX_S
    label_text = suffix_text + " " + base_text
    show_price_on_label ? label_text + " • " + str.tostring(price, format.mintick) : label_text

format_tooltip(is_bsl, wick_timestamp) =>
    type_text = is_bsl ? TOOLTIP_BSL_PREFIX : TOOLTIP_SSL_PREFIX
    formatted_time = str.format_time(wick_timestamp, TOOLTIP_TIME_FORMAT, syminfo.timezone)
    type_text + " • " + formatted_time + ", " + get_tf_tag()

bg_none() => color.new(color.white, 100)

create_end_label(end_time, target_price, label_text_color, tooltip_text) =>
    lab = label.new(
         x=end_time,
         y=target_price,
         text=get_timeframe_text(),
         style=label.style_label_left,
         textcolor=label_text_color,
         size=get_label_text_size(),
         xloc=xloc.bar_time,
         tooltip=tooltip_text
     )
    label.set_color(lab, bg_none())
    lab

// Smart timeframe-based level caps
get_reference_levels_cap() =>
    tf = timeframe.period
    if tf == TF_1MIN or tf == TF_2MIN
        CAP_ULTRA_SHORT
    else if tf == TF_3MIN or tf == TF_5MIN
        CAP_SHORT
    else if tf == TF_10MIN or tf == TF_15MIN or tf == TF_30MIN
        CAP_MEDIUM_SHORT
    else if tf == TF_45MIN or tf == TF_60MIN or tf == TF_90MIN
        CAP_MEDIUM
    else if tf == TF_120MIN or tf == TF_180MIN or tf == TF_240MIN
        CAP_MEDIUM_LONG
    else if tf == TF_1DAY or tf == TF_1WEEK
        CAP_LONG
    else
        CAP_DEFAULT

add_eligible_high(price, timestamp) =>
    tick = to_tick(price)
    if array.indexof(eligible_high_ticks, tick) == -1
        array.push(eligible_high_ticks, tick)
        array.push(eligible_high_times, timestamp)
        while array.size(eligible_high_ticks) > get_reference_levels_cap()
            array.shift(eligible_high_ticks)
            array.shift(eligible_high_times)

add_eligible_low(price, timestamp) =>
    tick = to_tick(price)
    if array.indexof(eligible_low_ticks, tick) == -1
        array.push(eligible_low_ticks, tick)
        array.push(eligible_low_times, timestamp)
        while array.size(eligible_low_ticks) > get_reference_levels_cap()
            array.shift(eligible_low_ticks)
            array.shift(eligible_low_times)

// Smart backfill calculation
get_smart_backfill() =>
    if not enable_smart_defaults
        lookback_bars
    else
        tf = timeframe.period
        if tf == TF_1MIN or tf == TF_2MIN
            BACKFILL_ULTRA_SHORT
        else if tf == TF_3MIN or tf == TF_5MIN
            BACKFILL_SHORT
        else if tf == TF_10MIN or tf == TF_15MIN or tf == TF_30MIN
            BACKFILL_MEDIUM_SHORT
        else if tf == TF_45MIN or tf == TF_60MIN or tf == TF_90MIN
            BACKFILL_MEDIUM
        else if tf == TF_120MIN or tf == TF_180MIN or tf == TF_240MIN
            BACKFILL_MEDIUM_LONG
        else if tf == TF_1DAY or tf == TF_1WEEK
            BACKFILL_LONG
        else
            BACKFILL_DEFAULT

// ═══════════════════════════════════════════════════════════════════════════════
// STATE RESET FUNCTION
// ═══════════════════════════════════════════════════════════════════════════════

reset_all_state() =>
    // Clean up visual elements - BSL first
    if array.size(buyside_lines) > 0
        for i = 0 to array.size(buyside_lines) - 1
            if not na(array.get(buyside_lines, i))
                line.delete(array.get(buyside_lines, i))

    if array.size(buyside_labels) > 0
        for i = 0 to array.size(buyside_labels) - 1
            if not na(array.get(buyside_labels, i))
                label.delete(array.get(buyside_labels, i))

    if array.size(sellside_lines) > 0
        for i = 0 to array.size(sellside_lines) - 1
            if not na(array.get(sellside_lines, i))
                line.delete(array.get(sellside_lines, i))

    if array.size(sellside_labels) > 0
        for i = 0 to array.size(sellside_labels) - 1
            if not na(array.get(sellside_labels, i))
                label.delete(array.get(sellside_labels, i))

    // Clear all data arrays - BSL first
    array.clear(buyside_failure_bars)
    array.clear(buyside_failure_times)
    array.clear(buyside_targets)
    array.clear(buyside_open)
    array.clear(buyside_fill_bars)
    array.clear(buyside_fill_times)
    array.clear(buyside_lines)
    array.clear(buyside_labels)
    array.clear(buyside_wick_times)

    array.clear(sellside_failure_bars)
    array.clear(sellside_failure_times)
    array.clear(sellside_targets)
    array.clear(sellside_open)
    array.clear(sellside_fill_bars)
    array.clear(sellside_fill_times)
    array.clear(sellside_lines)
    array.clear(sellside_labels)
    array.clear(sellside_wick_times)

    array.clear(eligible_high_ticks)
    array.clear(eligible_low_ticks)
    array.clear(eligible_high_times)
    array.clear(eligible_low_times)

    true

// ═══════════════════════════════════════════════════════════════════════════════
// CORE ALGORITHM - LIQUIDITY FAILURE DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

process_bar(bar_high, bar_low, bar_close, bar_idx, bar_time) =>

    // Detect liquidity failures - BSL first
    buyside_detected = false
    sellside_detected = false

    // BSL Detection
    if array.size(eligible_low_ticks) > 0
        for i = 0 to array.size(eligible_low_ticks) - 1
            ref_low = from_tick(array.get(eligible_low_ticks, i))
            if bar_low < ref_low and bar_close >= ref_low
                wick_timestamp = array.get(eligible_low_times, i)
                array.push(buyside_failure_bars, bar_idx)
                array.push(buyside_failure_times, bar_time)
                array.push(buyside_targets, bar_high)
                array.push(buyside_open, true)
                array.push(buyside_fill_bars, int(na))
                array.push(buyside_fill_times, int(na))
                array.push(buyside_lines, na)
                array.push(buyside_labels, na)
                array.push(buyside_wick_times, wick_timestamp)
                buyside_detected := true
                break

    // SSL Detection
    if array.size(eligible_high_ticks) > 0
        for i = 0 to array.size(eligible_high_ticks) - 1
            ref_high = from_tick(array.get(eligible_high_ticks, i))
            if bar_high > ref_high and bar_close <= ref_high
                wick_timestamp = array.get(eligible_high_times, i)
                array.push(sellside_failure_bars, bar_idx)
                array.push(sellside_failure_times, bar_time)
                array.push(sellside_targets, bar_low)
                array.push(sellside_open, true)
                array.push(sellside_fill_bars, int(na))
                array.push(sellside_fill_times, int(na))
                array.push(sellside_lines, na)
                array.push(sellside_labels, na)
                array.push(sellside_wick_times, wick_timestamp)
                sellside_detected := true
                break

    // Remove broken levels
    if array.size(eligible_high_ticks) > 0
        i = array.size(eligible_high_ticks) - 1
        while i >= 0
            if bar_high >= from_tick(array.get(eligible_high_ticks, i))
                array.remove(eligible_high_ticks, i)
                array.remove(eligible_high_times, i)
            i -= 1

    if array.size(eligible_low_ticks) > 0
        i = array.size(eligible_low_ticks) - 1
        while i >= 0
            if bar_low <= from_tick(array.get(eligible_low_ticks, i))
                array.remove(eligible_low_ticks, i)
                array.remove(eligible_low_times, i)
            i -= 1

    // Add current bar levels
    add_eligible_high(bar_high, bar_time)
    add_eligible_low(bar_low, bar_time)

    // STEP 4: Update fills - BSL first
    if array.size(buyside_failure_bars) > 0
        for i = 0 to array.size(buyside_failure_bars) - 1
            if array.get(buyside_open, i) and bar_idx > array.get(buyside_failure_bars, i)
                if bar_high >= array.get(buyside_targets, i)
                    array.set(buyside_open, i, false)
                    array.set(buyside_fill_bars, i, bar_idx)
                    array.set(buyside_fill_times, i, bar_time)

    if array.size(sellside_failure_bars) > 0
        for i = 0 to array.size(sellside_failure_bars) - 1
            if array.get(sellside_open, i) and bar_idx > array.get(sellside_failure_bars, i)
                if bar_low <= array.get(sellside_targets, i)
                    array.set(sellside_open, i, false)
                    array.set(sellside_fill_bars, i, bar_idx)
                    array.set(sellside_fill_times, i, bar_time)

    [buyside_detected, sellside_detected]

// ═══════════════════════════════════════════════════════════════════════════════
// INITIALIZATION & REAL-TIME PROCESSING
// ═══════════════════════════════════════════════════════════════════════════════

// Handle symbol/timeframe changes AND input changes
input_changed = ticker.standard() != last_ticker or timeframe.period != last_tf
ltf_settings_changed = false

// LTF input change detection and handling
current_ltf_hash = create_ltf_settings_hash()
if current_ltf_hash != last_ltf_settings_hash
    ltf_inputs_changed := true
    ltf_settings_changed := true
    last_ltf_settings_hash := current_ltf_hash
else
    ltf_inputs_changed := false

// Reset state for symbol/timeframe changes OR input changes
if input_changed or ltf_settings_changed
    if reset_all_state()
        initialized := false
        bars_processed := 0
        cached_bsl_open := -1
        cached_ssl_open := -1
    last_ticker := ticker.standard()
    last_tf := timeframe.period

// Initialize with historical backfill
if not initialized and barstate.islastconfirmedhistory
    effective_lookback = get_smart_backfill()
    max_back = math.min(effective_lookback, bar_index)
    bars_processed := 0

    for i = max_back to 1
        if i <= bar_index
            hist_high = high[i]
            hist_low = low[i]
            hist_close = close[i]
            hist_idx = bar_index - i
            hist_time = time[i]
            process_bar(hist_high, hist_low, hist_close, hist_idx, hist_time)
            bars_processed += 1
    initialized := true

// Process confirmed bars
if barstate.isconfirmed and initialized
    process_bar(high, low, close, bar_index, time)
    bars_processed += 1

// Real-time fill detection with instant visual feedback
if not barstate.isconfirmed and initialized
    // BSL fill detection
    if array.size(buyside_failure_bars) > 0
        for i = 0 to array.size(buyside_failure_bars) - 1
            if array.get(buyside_open, i) and bar_index > array.get(buyside_failure_bars, i)
                if high >= array.get(buyside_targets, i)
                    array.set(buyside_open, i, false)
                    array.set(buyside_fill_bars, i, bar_index)
                    array.set(buyside_fill_times, i, time)

                    // Instant visual update
                    current_line = array.get(buyside_lines, i)
                    failure_time = array.get(buyside_failure_times, i)
                    target = array.get(buyside_targets, i)

                    if na(current_line)
                        new_line = line.new(failure_time, target, time, target, xloc=xloc.bar_time)
                        array.set(buyside_lines, i, new_line)
                        current_line := new_line

                    line.set_color(current_line, color.new(buyside_filled_color, filled_opacity))
                    line.set_style(current_line, get_line_style(filled_style))
                    line.set_width(current_line, filled_width)
                    line.set_xy2(current_line, time, target)

                    // Remove label on fill
                    current_label = array.get(buyside_labels, i)
                    if not na(current_label)
                        label.delete(current_label)
                        array.set(buyside_labels, i, na)

    // SSL fill detection
    if array.size(sellside_failure_bars) > 0
        for i = 0 to array.size(sellside_failure_bars) - 1
            if array.get(sellside_open, i) and bar_index > array.get(sellside_failure_bars, i)
                if low <= array.get(sellside_targets, i)
                    array.set(sellside_open, i, false)
                    array.set(sellside_fill_bars, i, bar_index)
                    array.set(sellside_fill_times, i, time)

                    // Instant visual update
                    current_line = array.get(sellside_lines, i)
                    failure_time = array.get(sellside_failure_times, i)
                    target = array.get(sellside_targets, i)

                    if na(current_line)
                        new_line = line.new(failure_time, target, time, target, xloc=xloc.bar_time)
                        array.set(sellside_lines, i, new_line)
                        current_line := new_line

                    line.set_color(current_line, color.new(sellside_filled_color, filled_opacity))
                    line.set_style(current_line, get_line_style(filled_style))
                    line.set_width(current_line, filled_width)
                    line.set_xy2(current_line, time, target)

                    // Remove label on fill
                    current_label = array.get(sellside_labels, i)
                    if not na(current_label)
                        label.delete(current_label)
                        array.set(sellside_labels, i, na)

// ═══════════════════════════════════════════════════════════════════════════════
// VISUAL DISPLAY SYSTEM - BSL FIRST
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.isconfirmed or barstate.islast

    // BSL DISPLAY PROCESSING
    if array.size(buyside_failure_bars) > 0
        open_lines_shown = 0
        filled_lines_shown = 0

        for i = array.size(buyside_failure_bars) - 1 to 0
            is_open = array.get(buyside_open, i)
            current_line = array.get(buyside_lines, i)
            current_label = array.get(buyside_labels, i)

            should_show = false

            if is_open and open_lines_shown < open_lines_count
                should_show := true
                open_lines_shown += 1
            else if show_filled and not is_open and filled_lines_shown < filled_lines_count
                should_show := true
                filled_lines_shown += 1

            if should_show
                failure_time = array.get(buyside_failure_times, i)
                target = array.get(buyside_targets, i)
                fill_time = array.get(buyside_fill_times, i)

                end_time = is_open ? time + (timeframe.in_seconds() * MS_IN_SEC * extend_bars) : fill_time
                line_color = is_open ? buyside_color : color.new(buyside_filled_color, filled_opacity)
                line_style = get_line_style(is_open ? open_style : filled_style)
                line_width_val = is_open ? open_width : filled_width

                if na(current_line)
                    new_line = line.new(failure_time, target, end_time, target, xloc=xloc.bar_time)
                    line.set_color(new_line, line_color)
                    line.set_style(new_line, line_style)
                    line.set_width(new_line, line_width_val)
                    array.set(buyside_lines, i, new_line)
                else
                    line.set_xy1(current_line, failure_time, target)
                    line.set_xy2(current_line, end_time, target)
                    line.set_color(current_line, line_color)
                    line.set_style(current_line, line_style)
                    line.set_width(current_line, line_width_val)

                // Label management - always show on open lines
                if is_open
                    wick_timestamp = array.get(buyside_wick_times, i)
                    tooltip_text = format_tooltip(true, wick_timestamp)

                    if na(current_label)
                        new_label = label.new(
                             x=end_time,
                             y=target,
                             text=get_timeframe_text_with_suffix(true, target),
                             style=label.style_label_left,
                             textcolor=bsl_label_text_color,
                             size=get_label_text_size(),
                             xloc=xloc.bar_time,
                             tooltip=tooltip_text
                         )
                        label.set_color(new_label, bg_none())
                        array.set(buyside_labels, i, new_label)
                    else
                        label.set_xy(current_label, end_time, target)
                        label.set_text(current_label, get_timeframe_text_with_suffix(true, target))
                        label.set_textcolor(current_label, bsl_label_text_color)
                        label.set_size(current_label, get_label_text_size())
                        label.set_color(current_label, bg_none())
                        label.set_tooltip(current_label, tooltip_text)
                else if not na(current_label)
                    label.delete(current_label)
                    array.set(buyside_labels, i, na)
            else
                // Clean up non-displayed elements
                if not na(current_line)
                    line.delete(current_line)
                    array.set(buyside_lines, i, na)
                if not na(current_label)
                    label.delete(current_label)
                    array.set(buyside_labels, i, na)

    // SSL DISPLAY PROCESSING - Same logic as BSL
    if array.size(sellside_failure_bars) > 0
        open_lines_shown = 0
        filled_lines_shown = 0

        for i = array.size(sellside_failure_bars) - 1 to 0
            is_open = array.get(sellside_open, i)
            current_line = array.get(sellside_lines, i)
            current_label = array.get(sellside_labels, i)

            should_show = false

            if is_open and open_lines_shown < open_lines_count
                should_show := true
                open_lines_shown += 1
            else if show_filled and not is_open and filled_lines_shown < filled_lines_count
                should_show := true
                filled_lines_shown += 1

            if should_show
                failure_time = array.get(sellside_failure_times, i)
                target = array.get(sellside_targets, i)
                fill_time = array.get(sellside_fill_times, i)

                end_time = is_open ? time + (timeframe.in_seconds() * MS_IN_SEC * extend_bars) : fill_time
                line_color = is_open ? sellside_color : color.new(sellside_filled_color, filled_opacity)
                line_style = get_line_style(is_open ? open_style : filled_style)
                line_width_val = is_open ? open_width : filled_width

                if na(current_line)
                    new_line = line.new(failure_time, target, end_time, target, xloc=xloc.bar_time)
                    line.set_color(new_line, line_color)
                    line.set_style(new_line, line_style)
                    line.set_width(new_line, line_width_val)
                    array.set(sellside_lines, i, new_line)
                else
                    line.set_xy1(current_line, failure_time, target)
                    line.set_xy2(current_line, end_time, target)
                    line.set_color(current_line, line_color)
                    line.set_style(current_line, line_style)
                    line.set_width(current_line, line_width_val)

                // Label management - always show on open lines
                if is_open
                    wick_timestamp = array.get(sellside_wick_times, i)
                    tooltip_text = format_tooltip(false, wick_timestamp)

                    if na(current_label)
                        new_label = label.new(
                             x=end_time,
                             y=target,
                             text=get_timeframe_text_with_suffix(false, target),
                             style=label.style_label_left,
                             textcolor=ssl_label_text_color,
                             size=get_label_text_size(),
                             xloc=xloc.bar_time,
                             tooltip=tooltip_text
                         )
                        label.set_color(new_label, bg_none())
                        array.set(sellside_labels, i, new_label)
                    else
                        label.set_xy(current_label, end_time, target)
                        label.set_text(current_label, get_timeframe_text_with_suffix(false, target))
                        label.set_textcolor(current_label, ssl_label_text_color)
                        label.set_size(current_label, get_label_text_size())
                        label.set_color(current_label, bg_none())
                        label.set_tooltip(current_label, tooltip_text)
                else if not na(current_label)
                    label.delete(current_label)
                    array.set(sellside_labels, i, na)
            else
                // Clean up non-displayed elements
                if not na(current_line)
                    line.delete(current_line)
                    array.set(sellside_lines, i, na)
                if not na(current_label)
                    label.delete(current_label)
                    array.set(sellside_labels, i, na)

// ═══════════════════════════════════════════════════════════════════════════════
// PROFESSIONAL INFO TABLE
// ═══════════════════════════════════════════════════════════════════════════════

if show_dashboard
    // Calculate statistics
    bsl_total = array.size(buyside_targets)
    ssl_total = array.size(sellside_targets)
    bsl_open = 0
    ssl_open = 0

    if bsl_total > 0
        for draw_index = 0 to bsl_total - 1
            if array.get(buyside_open, draw_index)
                bsl_open += 1

    if ssl_total > 0
        for draw_index = 0 to ssl_total - 1
            if array.get(sellside_open, draw_index)
                ssl_open += 1

    // Only rebuild if values changed
    if bsl_open != cached_bsl_open or ssl_open != cached_ssl_open
        if not na(info_table)
            table.delete(info_table)

        // Borderless table with single column
        required_rows = DASHBOARD_BASE_ROWS + table_y_offset
        info_table := table.new(get_table_position(), 1, required_rows, bgcolor=na, frame_color=na, frame_width=0, border_color=na, border_width=0)
        // Spacer rows for vertical offset (fully transparent)
        if table_y_offset > 0
            for offset_row = 0 to table_y_offset - 1
                table.cell(info_table, 0, offset_row, ' ', text_color=color.new(color.black, TABLE_SPACER_TRANSPARENCY), text_size=get_table_text_size(), bgcolor=na)
        // Content rows
        table.cell(info_table, 0, 0 + table_y_offset, DASH_TEXT_LTF, text_color=default_text_color, text_size=get_table_text_size(), bgcolor=table_bg_color)
        table.cell(info_table, 0, 1 + table_y_offset, DASH_PREFIX_BSL + str.tostring(bsl_open), text_color=default_text_color, text_size=get_table_text_size(), bgcolor=table_bg_color)
        table.cell(info_table, 0, 2 + table_y_offset, DASH_PREFIX_SSL + str.tostring(ssl_open), text_color=default_text_color, text_size=get_table_text_size(), bgcolor=table_bg_color)

        cached_bsl_open := bsl_open
        cached_ssl_open := ssl_open


// ═══════════════════════════════════════════════════════════════════════════════
// MEMORY MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.islast
    total_max = math.max(MEMORY_MIN_TOTAL_MAX, open_lines_count + filled_lines_count)

    // Clean BSL arrays
    while array.size(buyside_failure_bars) > (total_max * MEMORY_PRUNE_MULTIPLIER)
        if not na(array.shift(buyside_lines))
            line.delete(array.shift(buyside_lines))
        if not na(array.shift(buyside_labels))
            label.delete(array.shift(buyside_labels))
        array.shift(buyside_failure_bars)
        array.shift(buyside_failure_times)
        array.shift(buyside_targets)
        array.shift(buyside_open)
        array.shift(buyside_fill_bars)
        array.shift(buyside_fill_times)
        array.shift(buyside_wick_times)

    // Clean SSL arrays
    while array.size(sellside_failure_bars) > (total_max * MEMORY_PRUNE_MULTIPLIER)
        if not na(array.shift(sellside_lines))
            line.delete(array.shift(sellside_lines))
        if not na(array.shift(sellside_labels))
            label.delete(array.shift(sellside_labels))
        array.shift(sellside_failure_bars)
        array.shift(sellside_failure_times)
        array.shift(sellside_targets)
        array.shift(sellside_open)
        array.shift(sellside_fill_bars)
        array.shift(sellside_fill_times)
        array.shift(sellside_wick_times)

// ═══════════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE
// ═══════════════════════════════════════════════════════════════════════════════

if show_color_table and barstate.islast
    var table colorTable = table.new(position.top_right, 3, 9, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

    // Header
    table.cell(colorTable, 0, 0, "Color", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 1, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 2, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)

    // BSL Colors
    table.cell(colorTable, 0, 1, "BSL Open", text_size=size.small)
    table.cell(colorTable, 1, 1, str.format("R:{0} G:{1} B:{2}", color.r(buyside_color), color.g(buyside_color), color.b(buyside_color)), text_size=size.small)
    table.cell(colorTable, 2, 1, str.tostring(color.t(buyside_color)), text_size=size.small)

    table.cell(colorTable, 0, 2, "BSL Filled", text_size=size.small)
    table.cell(colorTable, 1, 2, str.format("R:{0} G:{1} B:{2}", color.r(buyside_filled_color), color.g(buyside_filled_color), color.b(buyside_filled_color)), text_size=size.small)
    table.cell(colorTable, 2, 2, str.tostring(color.t(buyside_filled_color)), text_size=size.small)

    table.cell(colorTable, 0, 3, "BSL Label", text_size=size.small)
    table.cell(colorTable, 1, 3, str.format("R:{0} G:{1} B:{2}", color.r(bsl_label_text_color), color.g(bsl_label_text_color), color.b(bsl_label_text_color)), text_size=size.small)
    table.cell(colorTable, 2, 3, str.tostring(color.t(bsl_label_text_color)), text_size=size.small)

    // SSL Colors
    table.cell(colorTable, 0, 4, "SSL Open", text_size=size.small)
    table.cell(colorTable, 1, 4, str.format("R:{0} G:{1} B:{2}", color.r(sellside_color), color.g(sellside_color), color.b(sellside_color)), text_size=size.small)
    table.cell(colorTable, 2, 4, str.tostring(color.t(sellside_color)), text_size=size.small)

    table.cell(colorTable, 0, 5, "SSL Filled", text_size=size.small)
    table.cell(colorTable, 1, 5, str.format("R:{0} G:{1} B:{2}", color.r(sellside_filled_color), color.g(sellside_filled_color), color.b(sellside_filled_color)), text_size=size.small)
    table.cell(colorTable, 2, 5, str.tostring(color.t(sellside_filled_color)), text_size=size.small)

    table.cell(colorTable, 0, 6, "SSL Label", text_size=size.small)
    table.cell(colorTable, 1, 6, str.format("R:{0} G:{1} B:{2}", color.r(ssl_label_text_color), color.g(ssl_label_text_color), color.b(ssl_label_text_color)), text_size=size.small)
    table.cell(colorTable, 2, 6, str.tostring(color.t(ssl_label_text_color)), text_size=size.small)

    // Dashboard Colors
    table.cell(colorTable, 0, 7, "Dash BG", text_size=size.small)
    table.cell(colorTable, 1, 7, str.format("R:{0} G:{1} B:{2}", color.r(table_bg_color), color.g(table_bg_color), color.b(table_bg_color)), text_size=size.small)
    table.cell(colorTable, 2, 7, str.tostring(color.t(table_bg_color)), text_size=size.small)

    table.cell(colorTable, 0, 8, "Dash Text", text_size=size.small)
    table.cell(colorTable, 1, 8, str.format("R:{0} G:{1} B:{2}", color.r(default_text_color), color.g(default_text_color), color.b(default_text_color)), text_size=size.small)
    table.cell(colorTable, 2, 8, str.tostring(color.t(default_text_color)), text_size=size.small)

// ltf algo •