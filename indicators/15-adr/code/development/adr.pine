//@version=6
indicator("adr •", overlay=true, max_lines_count=500, max_labels_count=50, max_boxes_count=50)

// ═══════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════

// Calculation type options
CALC_NY_MIDNIGHT = "NY Midnight"
CALC_DAILY_CANDLE = "Daily Candle"
NY_TIMEZONE = "America/New_York"

// Judas condition options
JUDAS_THIRD = "1/3 ADR"
JUDAS_80PCT = "80% ADR"

// Style options
STYLE_SOLID = "Solid"
STYLE_DASHED = "Dashed"
STYLE_DOTTED = "Dotted"

// Size options
SIZE_TINY = "Tiny"
SIZE_SMALL = "Small"
SIZE_NORMAL = "Normal"

// Quick Filter options
FILTER_ALL = "All"
FILTER_OFF = "Off"
FILTER_ADR = "ADR"
FILTER_AWR = "AWR"
FILTER_AMR = "AMR"
FILTER_ADR_AWR = "ADR + AWR"
FILTER_ADR_AMR = "ADR + AMR"
FILTER_AWR_AMR = "AWR + AMR"
FILTER_ADR_AWR_AMR = "ADR + AWR + AMR"

// Show Only options
SESSION_WINDOW_OVERNIGHT = "1600-0500:1234567"
SESSION_WINDOW_FROM_0500 = "0500-1600:1234567"
SESSION_WINDOW_FROM_0830 = "0830-1600:1234567"
SESSION_WINDOW_RTH = "0930-1600:1234567"
WINDOW_LABEL_OVERNIGHT = "Overnight"
WINDOW_LABEL_FROM_0500 = "● ● RTH"
WINDOW_LABEL_FROM_0830 = "● RTH"
WINDOW_LABEL_RTH = "RTH"

// Input groups
GROUP_QUICK_FILTER = "⚡ Quick Filter"
GROUP_QUICK_FILTER_SHOW_ONLY = "⚡ Quick Filter: Show Only"
GROUP_ADR = "Average Daily Range"
GROUP_ADR_STYLES = "Average Daily Range: Styles"
GROUP_AWR = "Average Weekly Range"
GROUP_AWR_STYLES = "Average Weekly Range: Styles"
GROUP_AMR = "Average Monthly Range"
GROUP_AMR_STYLES = "Average Monthly Range: Styles"
GROUP_JUDAS = "Judas Detection"
GROUP_ALERTS = "ADR Alerts"
GROUP_STATISTICS_TABLE = "Statistics Table"
GROUP_COLOR_TABLE = "Color Reference"
GROUP_SECONDARY_PANE = "Secondary Pane"

PLACEMENT_MAIN_CHART = "Main Chart"
PLACEMENT_SECONDARY_PANE = "Secondary Pane"
const color DEFAULT_PANE_UP_BODY_COLOR = #fafafa
const color DEFAULT_PANE_DOWN_BODY_COLOR = color.new(#5b9cf6, 25)
const color DEFAULT_PANE_UP_BORDER_COLOR = color.new(#808080, 25)
const color DEFAULT_PANE_DOWN_BORDER_COLOR = color.new(#808080, 20)
const color DEFAULT_PANE_WICK_COLOR = #9c9c9c

// Resource ceiling: 3 features × (3 level pairs + 1 open) × (20 completed + 1 current) = 441 lines.
// Only current periods keep labels (21 maximum); Judas retains at most 21 boxes.
MAX_LOOKBACK = 20
MAX_HISTORY_PERIODS = 20
DEFAULT_ADR_LOOKBACK = 5
DEFAULT_AWR_LOOKBACK = 4
DEFAULT_AMR_LOOKBACK = 4
DEFAULT_HISTORY = 1
STATISTICS_SECTION_ROWS = 6
STATISTICS_TABLE_ROWS = STATISTICS_SECTION_ROWS * 3
COLOR_TABLE_ROWS = 21
NEXT_DAY_PROBE_MS = 36 * 60 * 60 * 1000
SHOW_ONLY_MAX_TIMEFRAME_SECONDS = 60 * 60
RANGE_STYLE_TOOLTIP = "Color, style, and width • Full range"
LABEL_SIZE_TOOLTIP = "Current-period label size"
ADR_MAIN_TOOLTIP = "Average Daily Range\n\n• ADR — Enable the daily range.\n• × — Scale the projected range.\n• Lookback — Completed daily ranges used in the average."
AWR_MAIN_TOOLTIP = "Average Weekly Range\n\n• AWR — Enable the weekly range.\n• × — Scale the projected range.\n• Lookback — Completed weekly ranges used in the average."
AMR_MAIN_TOOLTIP = "Average Monthly Range\n\n• AMR — Enable the monthly range.\n• × — Scale the projected range.\n• Lookback — Completed monthly ranges used in the average."
STATISTICS_TABLE_TOOLTIP = "Statistics Table\n\n• Show — Display statistics for each enabled range.\n• Text — Table text size.\n\nCounts the current developing period plus displayed completed history within cumulative ±⅓, ±⅔, and full-range bands."
QUICK_FILTER_TOOLTIP = "Quick Filter\n\n• All — Respect individual checkboxes.\n• Off — Hide all three ranges.\n• Other presets — Force exactly the named ranges on."
CALCULATION_TOOLTIP = "Calculation\n\n• NY Midnight — Use 00:00–00:00 New York ranges.\n• Daily Candle — Use standard daily-candle ranges."
SHOW_ONLY_TOOLTIP = "Dims candles outside the selected New York window. Range drawings and calculations stay unchanged.\n\n• Overnight — 16:00–05:00.\n• ● ● RTH — 05:00–16:00.\n• ● RTH — 08:30–16:00.\n• RTH — 09:30–16:00.\n\nAvailable through 1-hour and on Range charts."
MOST_RECENT_ONLY_TOOLTIP = "Most Recent Only\n\nShows the selected window only on the current New York date.\n\nOff — Show the window every day."

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════

quickFilter = input.string(FILTER_ALL, "Quick Filter", options=[FILTER_ALL, FILTER_OFF, FILTER_ADR, FILTER_AWR, FILTER_AMR, FILTER_ADR_AWR, FILTER_ADR_AMR, FILTER_AWR_AMR, FILTER_ADR_AWR_AMR], group=GROUP_QUICK_FILTER, tooltip=QUICK_FILTER_TOOLTIP)
quickFilterUsesToggles = quickFilter == FILTER_ALL
// Direct expressions retain the input qualifier required by input.active.
filterAdr = quickFilter == FILTER_ADR or quickFilter == FILTER_ADR_AWR or quickFilter == FILTER_ADR_AMR or quickFilter == FILTER_ADR_AWR_AMR
filterAwr = quickFilter == FILTER_AWR or quickFilter == FILTER_ADR_AWR or quickFilter == FILTER_AWR_AMR or quickFilter == FILTER_ADR_AWR_AMR
filterAmr = quickFilter == FILTER_AMR or quickFilter == FILTER_ADR_AMR or quickFilter == FILTER_AWR_AMR or quickFilter == FILTER_ADR_AWR_AMR

// Quick Filter: Show Only
showOnlyEnabled = input.bool(true, "Show Only", inline="show_only", group=GROUP_QUICK_FILTER_SHOW_ONLY)
hiddenCandleColor = input.color(color.new(color.rgb(245, 245, 245), 10), "", inline="show_only", group=GROUP_QUICK_FILTER_SHOW_ONLY, active=showOnlyEnabled)
visibleWindow = input.string(WINDOW_LABEL_RTH, "", options=[WINDOW_LABEL_OVERNIGHT, WINDOW_LABEL_FROM_0500, WINDOW_LABEL_FROM_0830, WINDOW_LABEL_RTH], inline="show_only", group=GROUP_QUICK_FILTER_SHOW_ONLY, active=showOnlyEnabled)
showOnlyMostRecent = input.bool(false, "Most Recent Only", inline="show_only", group=GROUP_QUICK_FILTER_SHOW_ONLY, active=showOnlyEnabled, tooltip=SHOW_ONLY_TOOLTIP + "\n\n———\n\n" + MOST_RECENT_ONLY_TOOLTIP)

// Average Daily Range
showAdr = input.bool(true, "ADR", inline="adr_main", group=GROUP_ADR, active=quickFilterUsesToggles)
adrEnabled = quickFilterUsesToggles ? showAdr : filterAdr
adrMultiplier = input.float(1.0, "×", minval=0.5, maxval=3.0, step=0.1, inline="adr_main", group=GROUP_ADR, active=adrEnabled)
adrLookback = input.int(DEFAULT_ADR_LOOKBACK, "Lookback", minval=1, maxval=MAX_LOOKBACK, inline="adr_main", group=GROUP_ADR, active=adrEnabled, tooltip=ADR_MAIN_TOOLTIP)
showHistoricalDays = input.bool(true, "Show Historical Days", inline="adr_history", group=GROUP_ADR, active=adrEnabled)
adrHistory = input.int(DEFAULT_HISTORY, "", minval=1, maxval=MAX_HISTORY_PERIODS, inline="adr_history", group=GROUP_ADR, active=adrEnabled and showHistoricalDays, tooltip="Completed daily projections retained")
calcType = input.string(CALC_NY_MIDNIGHT, "Calculation", options=[CALC_NY_MIDNIGHT, CALC_DAILY_CANDLE], group=GROUP_ADR, active=adrEnabled, tooltip=CALCULATION_TOOLTIP)

// Average Daily Range: Styles
adrColor = input.color(color.rgb(242, 54, 69), "ADR", inline="adr_style", group=GROUP_ADR_STYLES, active=adrEnabled)
adrStyle = input.string(STYLE_SOLID, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="adr_style", group=GROUP_ADR_STYLES, active=adrEnabled)
adrWidth = input.int(2, "", options=[1, 2, 3, 4], inline="adr_style", group=GROUP_ADR_STYLES, active=adrEnabled, tooltip=RANGE_STYLE_TOOLTIP)
showAdrThirds = input.bool(true, "1/3 ADR", inline="adr_thirds", group=GROUP_ADR_STYLES, active=adrEnabled)
adrThirdsColor = input.color(color.rgb(41, 98, 255), "", inline="adr_thirds", group=GROUP_ADR_STYLES, active=adrEnabled and showAdrThirds)
adrThirdsStyle = input.string(STYLE_DASHED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="adr_thirds", group=GROUP_ADR_STYLES, active=adrEnabled and showAdrThirds)
adrThirdsWidth = input.int(1, "", options=[1, 2, 3, 4], inline="adr_thirds", group=GROUP_ADR_STYLES, active=adrEnabled and showAdrThirds)
showAdrTwoThirds = input.bool(true, "2/3 ADR", inline="adr_two_thirds", group=GROUP_ADR_STYLES, active=adrEnabled)
adrTwoThirdsColor = input.color(color.rgb(144, 191, 249), "", inline="adr_two_thirds", group=GROUP_ADR_STYLES, active=adrEnabled and showAdrTwoThirds)
adrTwoThirdsStyle = input.string(STYLE_DOTTED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="adr_two_thirds", group=GROUP_ADR_STYLES, active=adrEnabled and showAdrTwoThirds)
adrTwoThirdsWidth = input.int(1, "", options=[1, 2, 3, 4], inline="adr_two_thirds", group=GROUP_ADR_STYLES, active=adrEnabled and showAdrTwoThirds)
showMno = input.bool(true, "MNO", inline="adr_open", group=GROUP_ADR_STYLES, active=adrEnabled)
mnoColor = input.color(color.rgb(41, 98, 255), "", inline="adr_open", group=GROUP_ADR_STYLES, active=adrEnabled and showMno)
mnoStyle = input.string(STYLE_SOLID, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="adr_open", group=GROUP_ADR_STYLES, active=adrEnabled and showMno)
mnoWidth = input.int(1, "", options=[1, 2, 3, 4], inline="adr_open", group=GROUP_ADR_STYLES, active=adrEnabled and showMno)
adrLabelSize = input.string(SIZE_TINY, "", options=[SIZE_TINY, SIZE_SMALL, SIZE_NORMAL], group=GROUP_ADR_STYLES, active=adrEnabled, tooltip=LABEL_SIZE_TOOLTIP)

// Average Weekly Range
showAwr = input.bool(false, "AWR", inline="awr_main", group=GROUP_AWR, active=quickFilterUsesToggles)
awrEnabled = quickFilterUsesToggles ? showAwr : filterAwr
awrMultiplier = input.float(1.0, "×", minval=0.5, maxval=3.0, step=0.1, inline="awr_main", group=GROUP_AWR, active=awrEnabled)
awrLookback = input.int(DEFAULT_AWR_LOOKBACK, "Lookback", minval=1, maxval=MAX_LOOKBACK, inline="awr_main", group=GROUP_AWR, active=awrEnabled, tooltip=AWR_MAIN_TOOLTIP)
showHistoricalWeeks = input.bool(true, "Show Historical Weeks", inline="awr_history", group=GROUP_AWR, active=awrEnabled)
awrHistory = input.int(DEFAULT_HISTORY, "", minval=1, maxval=MAX_HISTORY_PERIODS, inline="awr_history", group=GROUP_AWR, active=awrEnabled and showHistoricalWeeks, tooltip="Completed weekly projections retained")

// Average Weekly Range: Styles
awrColor = input.color(color.rgb(156, 39, 176), "AWR", inline="awr_style", group=GROUP_AWR_STYLES, active=awrEnabled)
awrStyle = input.string(STYLE_SOLID, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="awr_style", group=GROUP_AWR_STYLES, active=awrEnabled)
awrWidth = input.int(2, "", options=[1, 2, 3, 4], inline="awr_style", group=GROUP_AWR_STYLES, active=awrEnabled, tooltip=RANGE_STYLE_TOOLTIP)
showAwrThirds = input.bool(true, "1/3 AWR", inline="awr_thirds", group=GROUP_AWR_STYLES, active=awrEnabled)
awrThirdsColor = input.color(color.rgb(156, 39, 176), "", inline="awr_thirds", group=GROUP_AWR_STYLES, active=awrEnabled and showAwrThirds)
awrThirdsStyle = input.string(STYLE_DASHED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="awr_thirds", group=GROUP_AWR_STYLES, active=awrEnabled and showAwrThirds)
awrThirdsWidth = input.int(1, "", options=[1, 2, 3, 4], inline="awr_thirds", group=GROUP_AWR_STYLES, active=awrEnabled and showAwrThirds)
showAwrTwoThirds = input.bool(true, "2/3 AWR", inline="awr_two_thirds", group=GROUP_AWR_STYLES, active=awrEnabled)
awrTwoThirdsColor = input.color(color.rgb(206, 147, 216), "", inline="awr_two_thirds", group=GROUP_AWR_STYLES, active=awrEnabled and showAwrTwoThirds)
awrTwoThirdsStyle = input.string(STYLE_DOTTED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="awr_two_thirds", group=GROUP_AWR_STYLES, active=awrEnabled and showAwrTwoThirds)
awrTwoThirdsWidth = input.int(1, "", options=[1, 2, 3, 4], inline="awr_two_thirds", group=GROUP_AWR_STYLES, active=awrEnabled and showAwrTwoThirds)
showWeeklyOpen = input.bool(true, "Weekly Open", inline="awr_open", group=GROUP_AWR_STYLES, active=awrEnabled)
weeklyOpenColor = input.color(color.rgb(41, 98, 255), "", inline="awr_open", group=GROUP_AWR_STYLES, active=awrEnabled and showWeeklyOpen)
weeklyOpenStyle = input.string(STYLE_SOLID, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="awr_open", group=GROUP_AWR_STYLES, active=awrEnabled and showWeeklyOpen)
weeklyOpenWidth = input.int(1, "", options=[1, 2, 3, 4], inline="awr_open", group=GROUP_AWR_STYLES, active=awrEnabled and showWeeklyOpen)
awrLabelSize = input.string(SIZE_SMALL, "", options=[SIZE_TINY, SIZE_SMALL, SIZE_NORMAL], group=GROUP_AWR_STYLES, active=awrEnabled, tooltip=LABEL_SIZE_TOOLTIP)

// Average Monthly Range
showAmr = input.bool(false, "AMR", inline="amr_main", group=GROUP_AMR, active=quickFilterUsesToggles)
amrEnabled = quickFilterUsesToggles ? showAmr : filterAmr
amrMultiplier = input.float(1.0, "×", minval=0.5, maxval=3.0, step=0.1, inline="amr_main", group=GROUP_AMR, active=amrEnabled)
amrLookback = input.int(DEFAULT_AMR_LOOKBACK, "Lookback", minval=1, maxval=MAX_LOOKBACK, inline="amr_main", group=GROUP_AMR, active=amrEnabled, tooltip=AMR_MAIN_TOOLTIP)
showHistoricalMonths = input.bool(true, "Show Historical Months", inline="amr_history", group=GROUP_AMR, active=amrEnabled)
amrHistory = input.int(DEFAULT_HISTORY, "", minval=1, maxval=MAX_HISTORY_PERIODS, inline="amr_history", group=GROUP_AMR, active=amrEnabled and showHistoricalMonths, tooltip="Completed monthly projections retained")

// Average Monthly Range: Styles
amrColor = input.color(color.rgb(0, 150, 136), "AMR", inline="amr_style", group=GROUP_AMR_STYLES, active=amrEnabled)
amrStyle = input.string(STYLE_SOLID, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="amr_style", group=GROUP_AMR_STYLES, active=amrEnabled)
amrWidth = input.int(2, "", options=[1, 2, 3, 4], inline="amr_style", group=GROUP_AMR_STYLES, active=amrEnabled, tooltip=RANGE_STYLE_TOOLTIP)
showAmrThirds = input.bool(true, "1/3 AMR", inline="amr_thirds", group=GROUP_AMR_STYLES, active=amrEnabled)
amrThirdsColor = input.color(color.rgb(0, 150, 136), "", inline="amr_thirds", group=GROUP_AMR_STYLES, active=amrEnabled and showAmrThirds)
amrThirdsStyle = input.string(STYLE_DASHED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="amr_thirds", group=GROUP_AMR_STYLES, active=amrEnabled and showAmrThirds)
amrThirdsWidth = input.int(1, "", options=[1, 2, 3, 4], inline="amr_thirds", group=GROUP_AMR_STYLES, active=amrEnabled and showAmrThirds)
showAmrTwoThirds = input.bool(true, "2/3 AMR", inline="amr_two_thirds", group=GROUP_AMR_STYLES, active=amrEnabled)
amrTwoThirdsColor = input.color(color.rgb(128, 203, 196), "", inline="amr_two_thirds", group=GROUP_AMR_STYLES, active=amrEnabled and showAmrTwoThirds)
amrTwoThirdsStyle = input.string(STYLE_DOTTED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="amr_two_thirds", group=GROUP_AMR_STYLES, active=amrEnabled and showAmrTwoThirds)
amrTwoThirdsWidth = input.int(1, "", options=[1, 2, 3, 4], inline="amr_two_thirds", group=GROUP_AMR_STYLES, active=amrEnabled and showAmrTwoThirds)
showMonthlyOpen = input.bool(true, "Monthly Open", inline="amr_open", group=GROUP_AMR_STYLES, active=amrEnabled)
monthlyOpenColor = input.color(color.rgb(41, 98, 255), "", inline="amr_open", group=GROUP_AMR_STYLES, active=amrEnabled and showMonthlyOpen)
monthlyOpenStyle = input.string(STYLE_SOLID, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="amr_open", group=GROUP_AMR_STYLES, active=amrEnabled and showMonthlyOpen)
monthlyOpenWidth = input.int(1, "", options=[1, 2, 3, 4], inline="amr_open", group=GROUP_AMR_STYLES, active=amrEnabled and showMonthlyOpen)
amrLabelSize = input.string(SIZE_NORMAL, "", options=[SIZE_TINY, SIZE_SMALL, SIZE_NORMAL], group=GROUP_AMR_STYLES, active=amrEnabled, tooltip=LABEL_SIZE_TOOLTIP)

// Judas Detection
judasEnabled = input.bool(false, "Enable", inline="judas", group=GROUP_JUDAS, active=adrEnabled)
judasCondition = input.string(JUDAS_THIRD, "", options=[JUDAS_THIRD, JUDAS_80PCT], inline="judas", group=GROUP_JUDAS, active=adrEnabled and judasEnabled)
judasColor = input.color(color.orange, "", inline="judas", group=GROUP_JUDAS, active=adrEnabled and judasEnabled)
judasWidth = input.int(3, "", options=[1, 2, 3, 4], inline="judas", group=GROUP_JUDAS, active=adrEnabled and judasEnabled)
judasHour = input.int(8, "Cutoff (NY)", minval=0, maxval=23, inline="cutoff", group=GROUP_JUDAS, active=adrEnabled and judasEnabled)
judasMinute = input.int(0, ":", minval=0, maxval=59, inline="cutoff", group=GROUP_JUDAS, active=adrEnabled and judasEnabled, tooltip="Judas Swing: price exhausts early in session before this cutoff time")

// Alerts
alertAdrEnabled = input.bool(true, "ADR", inline="alert_adr", group=GROUP_ALERTS, active=adrEnabled)
alertThirdsEnabled = input.bool(true, "1/3 ADR", inline="alert_thirds", group=GROUP_ALERTS, active=adrEnabled)
alertTwoThirdsEnabled = input.bool(true, "2/3 ADR", inline="alert_twothirds", group=GROUP_ALERTS, active=adrEnabled)
alertJudasEnabled = input.bool(true, "Judas", inline="alert_judas", group=GROUP_ALERTS, active=adrEnabled and judasEnabled)

// Statistics Table
showStatisticsTable = input.bool(false, "Show", inline="statistics_table", group=GROUP_STATISTICS_TABLE)
statisticsTextSize = input.string(SIZE_TINY, "Text", options=[SIZE_TINY, SIZE_SMALL, SIZE_NORMAL], inline="statistics_table", group=GROUP_STATISTICS_TABLE, active=showStatisticsTable, tooltip=STATISTICS_TABLE_TOOLTIP)

// Secondary Pane
placementMode = input.string(PLACEMENT_MAIN_CHART, "Placement", options=[PLACEMENT_MAIN_CHART, PLACEMENT_SECONDARY_PANE], group=GROUP_SECONDARY_PANE, tooltip="Main Chart: keep ADR on price.\n\nSecondary Pane: keep candle effects local to the indicator pane and disable main-chart candle effects.")
secondaryPaneMode = placementMode == PLACEMENT_SECONDARY_PANE
showPriceCandlesInPane = input.bool(true, "Show Price Candles in Pane", group=GROUP_SECONDARY_PANE, active=secondaryPaneMode, tooltip="Draw the chart's OHLC candles in the indicator pane.")
paneUpBodyColor = input.color(DEFAULT_PANE_UP_BODY_COLOR, "Candles", inline="pane_candles", group=GROUP_SECONDARY_PANE, active=secondaryPaneMode and showPriceCandlesInPane)
paneDownBodyColor = input.color(DEFAULT_PANE_DOWN_BODY_COLOR, "", inline="pane_candles", group=GROUP_SECONDARY_PANE, active=secondaryPaneMode and showPriceCandlesInPane)
paneUpBorderColor = input.color(DEFAULT_PANE_UP_BORDER_COLOR, "", inline="pane_candles", group=GROUP_SECONDARY_PANE, active=secondaryPaneMode and showPriceCandlesInPane)
paneDownBorderColor = input.color(DEFAULT_PANE_DOWN_BORDER_COLOR, "", inline="pane_candles", group=GROUP_SECONDARY_PANE, active=secondaryPaneMode and showPriceCandlesInPane)
paneUpWickColor = input.color(DEFAULT_PANE_WICK_COLOR, "", inline="pane_candles", group=GROUP_SECONDARY_PANE, active=secondaryPaneMode and showPriceCandlesInPane)
paneDownWickColor = input.color(DEFAULT_PANE_WICK_COLOR, "", inline="pane_candles", group=GROUP_SECONDARY_PANE, active=secondaryPaneMode and showPriceCandlesInPane, tooltip="Order: Up Body, Down Body, Up Border, Down Border, Up Wick, Down Wick.")

// Color Reference
showColorTable = input.bool(false, "Show Color Reference Table", group=GROUP_COLOR_TABLE, tooltip="Show enabled range elements with their RGB values and transparency")

// ═══════════════════════════════════════════════════════════════════════════
// TYPE DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════════

type LineStyleConfig
    bool show
    color col
    string style
    int width

type LevelConfig
    float multiplier
    string labelText
    color col
    string style
    int width
    bool show

type LevelPair
    line upper
    line lower
    label lblUpper
    label lblLower

type PeriodLevels
    array<LevelPair> pairs

type RangeObservation
    float openPrice
    float highPrice
    float lowPrice
    float averageRange

type PeriodProjectionState
    PeriodLevels current
    array<PeriodLevels> history
    RangeObservation currentObservation
    array<RangeObservation> historyObservations
    int drawnStartTime

type DayData
    float openPrice
    float highPrice
    float lowPrice
    float dayRange
    float adr
    int startTime
    int endTime
    bool judasHit

type RangeStats
    int displayed
    int withinThird
    int withinTwoThirds
    int withinFull
    int exceededFull

type AlertState
    bool adrPlus
    bool adrMinus
    bool thirdsPlus
    bool thirdsMinus
    bool twoThirdsPlus
    bool twoThirdsMinus

type DailyRangeState
    DayData current
    int observedNyDayStart
    bool rolledThisBar
    int rolloverTime
    RangeObservation completedObservation
    float activeBarHigh
    float activeBarLow
    int activeBarTime

method reset(AlertState this) =>
    this.adrPlus := false
    this.adrMinus := false
    this.thirdsPlus := false
    this.thirdsMinus := false
    this.twoThirdsPlus := false
    this.twoThirdsMinus := false

newPeriodProjectionState() =>
    PeriodProjectionState.new(history=array.new<PeriodLevels>(), historyObservations=array.new<RangeObservation>())

newDailyRangeState() =>
    DailyRangeState.new()

// ═══════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════

toLineStyle(string style) =>
    switch style
        STYLE_SOLID => line.style_solid
        STYLE_DASHED => line.style_dashed
        STYLE_DOTTED => line.style_dotted
        => line.style_solid

toLabelSize(string sizeStr) =>
    switch sizeStr
        SIZE_TINY => size.tiny
        SIZE_SMALL => size.small
        SIZE_NORMAL => size.normal
        => size.tiny

calcAdr(array<float> ranges, int lookback) =>
    count = math.min(lookback, array.size(ranges))
    if count > 0
        sum = 0.0
        for i = 0 to count - 1
            sum += array.get(ranges, i)
        sum / count
    else
        float(na)

nyDayTimestamp(int barTime) =>
    timestamp(NY_TIMEZONE, year(barTime, NY_TIMEZONE), month(barTime, NY_TIMEZONE), dayofmonth(barTime, NY_TIMEZONE), 0, 0)

nextNyDayTimestamp(int dayTime) =>
    nextDayProbe = dayTime + NEXT_DAY_PROBE_MS
    timestamp(NY_TIMEZONE, year(nextDayProbe, NY_TIMEZONE), month(nextDayProbe, NY_TIMEZONE), dayofmonth(nextDayProbe, NY_TIMEZONE), 0, 0)

method beginBar(DailyRangeState this) =>
    this.rolledThisBar := false
    this.rolloverTime := na
    this.completedObservation := na
    this.activeBarHigh := na
    this.activeBarLow := na
    this.activeBarTime := na

method observe(DailyRangeState this, int observedTime, float observedOpen, float observedHigh, float observedLow, bool futuresSymbol, bool judasHit, string calculationType, float dailyCandleAverage, int lookback, array<float> nyRanges, array<DayData> completedDays) =>
    int observedDayStart = nyDayTimestamp(observedTime)
    bool dateChanged = not na(this.observedNyDayStart) and observedDayStart != this.observedNyDayStart
    bool sundayReopen = dateChanged and futuresSymbol and dayofweek(observedTime, NY_TIMEZONE) == dayofweek.sunday
    bool dayRolled = dateChanged and not sundayReopen

    if na(this.current)
        float initialAverage = calculationType == CALC_DAILY_CANDLE ? dailyCandleAverage : calcAdr(nyRanges, lookback)
        this.current := DayData.new(observedOpen, observedHigh, observedLow, 0.0, initialAverage, observedTime, na, false)
    else if dayRolled
        this.current.dayRange := this.current.highPrice - this.current.lowPrice
        this.current.endTime := observedTime
        this.current.judasHit := judasHit
        this.completedObservation := RangeObservation.new(this.current.openPrice, this.current.highPrice, this.current.lowPrice, this.current.adr)

        array.unshift(nyRanges, this.current.dayRange)
        if array.size(nyRanges) > MAX_LOOKBACK
            array.pop(nyRanges)

        array.unshift(completedDays, this.current.copy())
        if array.size(completedDays) > MAX_HISTORY_PERIODS
            array.pop(completedDays)

        float currentAverage = calculationType == CALC_NY_MIDNIGHT ? calcAdr(nyRanges, lookback) : dailyCandleAverage
        this.current := DayData.new(observedOpen, observedHigh, observedLow, 0.0, currentAverage, observedTime, na, false)
        this.rolledThisBar := true
        this.rolloverTime := observedTime
        this.activeBarHigh := na
        this.activeBarLow := na
    else
        this.current.highPrice := math.max(this.current.highPrice, observedHigh)
        this.current.lowPrice := math.min(this.current.lowPrice, observedLow)

    this.observedNyDayStart := observedDayStart
    this.activeBarHigh := na(this.activeBarHigh) ? observedHigh : math.max(this.activeBarHigh, observedHigh)
    this.activeBarLow := na(this.activeBarLow) ? observedLow : math.min(this.activeBarLow, observedLow)
    this.activeBarTime := observedTime

withinRangeBand(float periodHigh, float periodLow, float periodOpen, float projectedRange, float fraction) =>
    not na(projectedRange) and periodHigh <= periodOpen + projectedRange * fraction and periodLow >= periodOpen - projectedRange * fraction

// Current anchors and completed-period values are stable at the period open.
requestRangeSnapshot(string tickerId, string period, int lookback) =>
    request.security(tickerId, period, [open, ta.sma(high - low, lookback)[1], time, time_close, open[1], high[1], low[1], ta.sma(high - low, lookback)[2]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

// ═══════════════════════════════════════════════════════════════════════════
// LEVEL DRAWING METHODS
// ═══════════════════════════════════════════════════════════════════════════

method draw(LevelConfig this, int t1, int t2, float anchor, float rangeValue, string labelSize) =>
    LevelPair pair = LevelPair.new()

    if not this.show
        pair
    else
        upperPrice = anchor + (rangeValue * this.multiplier)
        lowerPrice = anchor - (rangeValue * this.multiplier)
        lineStyle = toLineStyle(this.style)
        lblSize = toLabelSize(labelSize)

        pair.upper := line.new(t1, upperPrice, t2, upperPrice, color=this.col, style=lineStyle, width=this.width, xloc=xloc.bar_time)
        pair.lower := line.new(t1, lowerPrice, t2, lowerPrice, color=this.col, style=lineStyle, width=this.width, xloc=xloc.bar_time)

        pair.lblUpper := label.new(t2, upperPrice, this.labelText + "+", style=label.style_label_left, textcolor=this.col, color=color.new(color.white, 100), size=lblSize, xloc=xloc.bar_time)
        pair.lblLower := label.new(t2, lowerPrice, this.labelText + "-", style=label.style_label_left, textcolor=this.col, color=color.new(color.white, 100), size=lblSize, xloc=xloc.bar_time)

        pair

method drawAnchor(LevelConfig this, int t1, int t2, float anchor, string labelSize) =>
    LevelPair pair = LevelPair.new()

    if not this.show
        pair
    else
        lineStyle = toLineStyle(this.style)
        lblSize = toLabelSize(labelSize)

        pair.upper := line.new(t1, anchor, t2, anchor, color=this.col, style=lineStyle, width=this.width, xloc=xloc.bar_time)

        pair.lblUpper := label.new(t2, anchor, this.labelText, style=label.style_label_left, textcolor=this.col, color=color.new(color.white, 100), size=lblSize, xloc=xloc.bar_time)

        pair

method delete(LevelPair this) =>
    if not na(this)
        line.delete(this.upper)
        line.delete(this.lower)
        label.delete(this.lblUpper)
        label.delete(this.lblLower)

method deleteLabels(LevelPair this) =>
    if not na(this)
        label.delete(this.lblUpper)
        label.delete(this.lblLower)
        this.lblUpper := na
        this.lblLower := na

method extend(LevelPair this, int t2) =>
    if not na(this)
        if not na(this.upper)
            line.set_x2(this.upper, t2)
        if not na(this.lower)
            line.set_x2(this.lower, t2)

method updateLabelX(LevelPair this, int t) =>
    if not na(this)
        if not na(this.lblUpper)
            label.set_x(this.lblUpper, t)
        if not na(this.lblLower)
            label.set_x(this.lblLower, t)

method delete(PeriodLevels this) =>
    if not na(this) and not na(this.pairs)
        for pair in this.pairs
            pair.delete()

method deleteLabels(PeriodLevels this) =>
    if not na(this) and not na(this.pairs)
        for pair in this.pairs
            pair.deleteLabels()

method extend(PeriodLevels this, int t2) =>
    if not na(this) and not na(this.pairs)
        for pair in this.pairs
            pair.extend(t2)

method updateLabels(PeriodLevels this, int t) =>
    if not na(this) and not na(this.pairs)
        for pair in this.pairs
            pair.updateLabelX(t)

// ═══════════════════════════════════════════════════════════════════════════
// LEVEL CONFIGURATION BUILDER
// ═══════════════════════════════════════════════════════════════════════════

method toLevelConfig(LineStyleConfig this, float multiplier, string labelText) =>
    LevelConfig.new(multiplier, labelText, this.col, this.style, this.width, this.show)

buildRangeConfigs(string rangeName, int lookback, float rangeMultiplier, LineStyleConfig rangeStyle, LineStyleConfig thirdsStyle, LineStyleConfig twoThirdsStyle) =>
    array<LevelConfig> configs = array.new<LevelConfig>()
    multiplierSuffix = rangeMultiplier == 1.0 ? "" : " ×" + str.tostring(rangeMultiplier, "#.#")
    configs.push(rangeStyle.toLevelConfig(rangeMultiplier, str.tostring(lookback) + rangeName + multiplierSuffix))
    configs.push(thirdsStyle.toLevelConfig(rangeMultiplier / 3.0, "1/3" + rangeName + multiplierSuffix))
    configs.push(twoThirdsStyle.toLevelConfig(rangeMultiplier * 2.0 / 3.0, "2/3" + rangeName + multiplierSuffix))
    configs

buildOpenConfig(string labelText, LineStyleConfig openStyle) =>
    openStyle.toLevelConfig(0.0, labelText)

// ═══════════════════════════════════════════════════════════════════════════
// PERIOD DRAWING AND LIFECYCLE
// ═══════════════════════════════════════════════════════════════════════════

drawPeriodLevels(int t1, int t2, float anchor, float rangeValue, array<LevelConfig> configs, LevelConfig anchorConfig, string featureLabelSize) =>
    PeriodLevels periodLevels = PeriodLevels.new(array.new<LevelPair>())
    for config in configs
        periodLevels.pairs.push(config.draw(t1, t2, anchor, rangeValue, featureLabelSize))
    periodLevels.pairs.push(anchorConfig.drawAnchor(t1, t2, anchor, featureLabelSize))
    periodLevels

method clearHistory(PeriodProjectionState this) =>
    if not na(this.history)
        for levels in this.history
            levels.delete()
        array.clear(this.history)
    if not na(this.historyObservations)
        array.clear(this.historyObservations)

method pruneHistory(PeriodProjectionState this, int historyDepth) =>
    while array.size(this.history) > historyDepth
        expiredLevels = array.pop(this.history)
        expiredLevels.delete()
        array.pop(this.historyObservations)

method sync(PeriodProjectionState this, bool enabled, int startTime, int endTime, int completedPeriodEndTime, float anchor, float averageRange, float observedHigh, float observedLow, RangeObservation completedObservation, array<LevelConfig> configs, LevelConfig anchorConfig, string featureLabelSize, int historyDepth) =>
    if not enabled
        if not na(this.current) or array.size(this.history) > 0
            this.current.delete()
            this.current := na
            this.clearHistory()
        this.currentObservation := na
        this.drawnStartTime := na
    else if not na(averageRange)
        if na(this.drawnStartTime) or startTime != this.drawnStartTime
            if not na(this.current)
                if not na(completedPeriodEndTime)
                    this.current.extend(completedPeriodEndTime)
                if historyDepth > 0
                    this.current.deleteLabels()
                    array.unshift(this.history, this.current)
                    array.unshift(this.historyObservations, na(completedObservation) ? this.currentObservation : completedObservation)
                else
                    this.current.delete()
            this.current := drawPeriodLevels(startTime, endTime, anchor, averageRange, configs, anchorConfig, featureLabelSize)
            this.drawnStartTime := startTime
            this.pruneHistory(historyDepth)
            this.currentObservation := RangeObservation.new(anchor, observedHigh, observedLow, averageRange)
        else if na(this.currentObservation)
            this.currentObservation := RangeObservation.new(anchor, observedHigh, observedLow, averageRange)
        else
            this.currentObservation.openPrice := anchor
            this.currentObservation.highPrice := math.max(this.currentObservation.highPrice, observedHigh)
            this.currentObservation.lowPrice := math.min(this.currentObservation.lowPrice, observedLow)
            this.currentObservation.averageRange := averageRange

    this.current.extend(endTime)
    this.current.updateLabels(endTime)

var array<LevelConfig> adrConfigs = buildRangeConfigs("ADR", adrLookback, adrMultiplier, LineStyleConfig.new(true, adrColor, adrStyle, adrWidth), LineStyleConfig.new(showAdrThirds, adrThirdsColor, adrThirdsStyle, adrThirdsWidth), LineStyleConfig.new(showAdrTwoThirds, adrTwoThirdsColor, adrTwoThirdsStyle, adrTwoThirdsWidth))
var LevelConfig adrOpenConfig = buildOpenConfig("MNO", LineStyleConfig.new(showMno, mnoColor, mnoStyle, mnoWidth))
var array<LevelConfig> awrConfigs = buildRangeConfigs("AWR", awrLookback, awrMultiplier, LineStyleConfig.new(true, awrColor, awrStyle, awrWidth), LineStyleConfig.new(showAwrThirds, awrThirdsColor, awrThirdsStyle, awrThirdsWidth), LineStyleConfig.new(showAwrTwoThirds, awrTwoThirdsColor, awrTwoThirdsStyle, awrTwoThirdsWidth))
var LevelConfig awrOpenConfig = buildOpenConfig("W Open", LineStyleConfig.new(showWeeklyOpen, weeklyOpenColor, weeklyOpenStyle, weeklyOpenWidth))
var array<LevelConfig> amrConfigs = buildRangeConfigs("AMR", amrLookback, amrMultiplier, LineStyleConfig.new(true, amrColor, amrStyle, amrWidth), LineStyleConfig.new(showAmrThirds, amrThirdsColor, amrThirdsStyle, amrThirdsWidth), LineStyleConfig.new(showAmrTwoThirds, amrTwoThirdsColor, amrTwoThirdsStyle, amrTwoThirdsWidth))
var LevelConfig amrOpenConfig = buildOpenConfig("M Open", LineStyleConfig.new(showMonthlyOpen, monthlyOpenColor, monthlyOpenStyle, monthlyOpenWidth))

// ═══════════════════════════════════════════════════════════════════════════
// TIME DETECTION
// ═══════════════════════════════════════════════════════════════════════════

barSpansNyDay = not na(time_close) and nyDayTimestamp(time) != nyDayTimestamp(time_close - 1)
var bool adrBoundarySafe = true
if barSpansNyDay and not chart.is_range
    adrBoundarySafe := false

adrChartSupported = not chart.is_range and timeframe.isintraday and adrBoundarySafe
awrChartSupported = not chart.is_range and timeframe.in_seconds() <= timeframe.in_seconds("D")
amrChartSupported = not chart.is_range and timeframe.in_seconds() <= timeframe.in_seconds("W")
awrRequestPeriod = "W"
amrRequestPeriod = "M"

// Preserve native standard/Range prices; normalize transformed charts and all HTF contexts.
htfTickerId = chart.is_standard ? syminfo.tickerid : ticker.standard(syminfo.tickerid)
[weeklyOpen, averageWeeklyRange, weeklyStartTime, weeklyEndTime, previousWeeklyOpen, previousWeeklyHigh, previousWeeklyLow, previousAverageWeeklyRange] = requestRangeSnapshot(htfTickerId, awrRequestPeriod, awrLookback)
[monthlyOpen, averageMonthlyRange, monthlyStartTime, monthlyEndTime, previousMonthlyOpen, previousMonthlyHigh, previousMonthlyLow, previousAverageMonthlyRange] = requestRangeSnapshot(htfTickerId, amrRequestPeriod, amrLookback)
averageDailyCandleRange = request.security(htfTickerId, "D", ta.sma(high - low, adrLookback)[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

adrActive = adrEnabled and adrChartSupported
awrActive = awrEnabled and awrChartSupported
amrActive = amrEnabled and amrChartSupported

// ═══════════════════════════════════════════════════════════════════════════
// DATA STORAGE
// ═══════════════════════════════════════════════════════════════════════════

var array<DayData> completedDays = array.new<DayData>()
var array<float> nyRanges = array.new_float()
var DailyRangeState dailyState = newDailyRangeState()

var bool judasHitToday = false
var array<box> judasBoxes = array.new<box>()

// Alert tracking (reset each day)
var AlertState alertHit = AlertState.new()

// ═══════════════════════════════════════════════════════════════════════════
// DAILY RANGE TRACKING
// ═══════════════════════════════════════════════════════════════════════════

dailyState.beginBar()
float observedPeriodHigh = high
float observedPeriodLow = low

if chart.is_range or chart.is_standard
    dailyState.observe(time, open, high, low, syminfo.type == "futures", judasHitToday, calcType, averageDailyCandleRange, adrLookback, nyRanges, completedDays)
else
    [standardBarOpen, standardBarHigh, standardBarLow] = request.security(htfTickerId, timeframe.period, [open, high, low], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
    observedPeriodHigh := standardBarHigh
    observedPeriodLow := standardBarLow
    dailyState.observe(time, standardBarOpen, standardBarHigh, standardBarLow, syminfo.type == "futures", judasHitToday, calcType, averageDailyCandleRange, adrLookback, nyRanges, completedDays)

isNewNyDay = dailyState.rolledThisBar
DayData currentDay = dailyState.current
activePriceHigh = dailyState.activeBarHigh
activePriceLow = dailyState.activeBarLow
activePriceTime = dailyState.activeBarTime

if isNewNyDay
    judasHitToday := false
    alertHit.reset()

// ═══════════════════════════════════════════════════════════════════════════
// JUDAS DETECTION
// ═══════════════════════════════════════════════════════════════════════════

projectedAdrRange = currentDay.adr * adrMultiplier

if adrActive and judasEnabled and not judasHitToday and not na(projectedAdrRange)
    nyMinute = minute(activePriceTime, NY_TIMEZONE)
    cutoffMinutes = judasHour * 60 + judasMinute
    currentMinutes = hour(activePriceTime, NY_TIMEZONE) * 60 + nyMinute

    if currentMinutes <= cutoffMinutes
        levelOffset = judasCondition == JUDAS_THIRD ? projectedAdrRange / 3 : projectedAdrRange * 0.8
        levelPlus = currentDay.openPrice + levelOffset
        levelMinus = currentDay.openPrice - levelOffset

        if activePriceHigh >= levelPlus or activePriceLow <= levelMinus
            judasHitToday := true
            if alertJudasEnabled
                alert("ADR exhausted early", alert.freq_once_per_bar)

// ═══════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════

// Calculate level prices from anchor
anchor = currentDay.openPrice
hasAdr = adrActive and not na(projectedAdrRange)

// Check reaches and determine alerts (once per day per level)
alertAdrPlus = hasAdr and activePriceHigh >= anchor + projectedAdrRange and not alertHit.adrPlus
alertAdrMinus = hasAdr and activePriceLow <= anchor - projectedAdrRange and not alertHit.adrMinus
alertThirdsPlus = hasAdr and activePriceHigh >= anchor + projectedAdrRange / 3 and not alertHit.thirdsPlus
alertThirdsMinus = hasAdr and activePriceLow <= anchor - projectedAdrRange / 3 and not alertHit.thirdsMinus
alertTwoThirdsPlus = hasAdr and activePriceHigh >= anchor + projectedAdrRange * 2 / 3 and not alertHit.twoThirdsPlus
alertTwoThirdsMinus = hasAdr and activePriceLow <= anchor - projectedAdrRange * 2 / 3 and not alertHit.twoThirdsMinus

// Update hit tracking
if alertAdrPlus
    alertHit.adrPlus := true
if alertAdrMinus
    alertHit.adrMinus := true
if alertThirdsPlus
    alertHit.thirdsPlus := true
if alertThirdsMinus
    alertHit.thirdsMinus := true
if alertTwoThirdsPlus
    alertHit.twoThirdsPlus := true
if alertTwoThirdsMinus
    alertHit.twoThirdsMinus := true

// Fire alerts
if adrActive and alertAdrEnabled and alertAdrPlus
    alert("ADR+ reached", alert.freq_once_per_bar)
if adrActive and alertAdrEnabled and alertAdrMinus
    alert("ADR- reached", alert.freq_once_per_bar)
if adrActive and alertThirdsEnabled and alertThirdsPlus
    alert("1/3 ADR+ reached", alert.freq_once_per_bar)
if adrActive and alertThirdsEnabled and alertThirdsMinus
    alert("1/3 ADR- reached", alert.freq_once_per_bar)
if adrActive and alertTwoThirdsEnabled and alertTwoThirdsPlus
    alert("2/3 ADR+ reached", alert.freq_once_per_bar)
if adrActive and alertTwoThirdsEnabled and alertTwoThirdsMinus
    alert("2/3 ADR- reached", alert.freq_once_per_bar)

// ═══════════════════════════════════════════════════════════════════════════
// RANGE FEATURE DRAWING
// ═══════════════════════════════════════════════════════════════════════════

var PeriodProjectionState adrProjection = newPeriodProjectionState()
var PeriodProjectionState awrProjection = newPeriodProjectionState()
var PeriodProjectionState amrProjection = newPeriodProjectionState()
currentDayEndTime = nextNyDayTimestamp(dailyState.observedNyDayStart)

RangeObservation completedWeeklyObservation = na
if not na(awrProjection.drawnStartTime) and weeklyStartTime != awrProjection.drawnStartTime
    completedWeeklyObservation := RangeObservation.new(previousWeeklyOpen, previousWeeklyHigh, previousWeeklyLow, previousAverageWeeklyRange)

RangeObservation completedMonthlyObservation = na
if not na(amrProjection.drawnStartTime) and monthlyStartTime != amrProjection.drawnStartTime
    completedMonthlyObservation := RangeObservation.new(previousMonthlyOpen, previousMonthlyHigh, previousMonthlyLow, previousAverageMonthlyRange)

adrProjection.sync(adrActive, currentDay.startTime, currentDayEndTime, dailyState.rolloverTime, currentDay.openPrice, currentDay.adr, currentDay.highPrice, currentDay.lowPrice, dailyState.completedObservation, adrConfigs, adrOpenConfig, adrLabelSize, showHistoricalDays ? adrHistory : 0)
awrProjection.sync(awrActive, weeklyStartTime, weeklyEndTime, int(na), weeklyOpen, averageWeeklyRange, observedPeriodHigh, observedPeriodLow, completedWeeklyObservation, awrConfigs, awrOpenConfig, awrLabelSize, showHistoricalWeeks ? awrHistory : 0)
amrProjection.sync(amrActive, monthlyStartTime, monthlyEndTime, int(na), monthlyOpen, averageMonthlyRange, observedPeriodHigh, observedPeriodLow, completedMonthlyObservation, amrConfigs, amrOpenConfig, amrLabelSize, showHistoricalMonths ? amrHistory : 0)

// ═══════════════════════════════════════════════════════════════════════════
// JUDAS BOXES
// ═══════════════════════════════════════════════════════════════════════════

var box currentJudasBox = na

resetJudasDrawings = not adrActive or not judasEnabled or isNewNyDay
if resetJudasDrawings and (array.size(judasBoxes) > 0 or not na(currentJudasBox))
    for b in judasBoxes
        box.delete(b)
    array.clear(judasBoxes)
    box.delete(currentJudasBox)
    currentJudasBox := na

if adrActive and judasEnabled and isNewNyDay
    for day in completedDays
        if day.judasHit and not na(day.endTime)
            b = box.new(day.startTime, day.highPrice, day.endTime, day.lowPrice, border_color=judasColor, border_width=judasWidth, bgcolor=na, xloc=xloc.bar_time)
            array.push(judasBoxes, b)

if adrActive and judasEnabled and judasHitToday
    if na(currentJudasBox)
        currentJudasBox := box.new(currentDay.startTime, currentDay.highPrice, currentDayEndTime, currentDay.lowPrice, border_color=judasColor, border_width=judasWidth, bgcolor=na, xloc=xloc.bar_time)
    else
        box.set_top(currentJudasBox, currentDay.highPrice)
        box.set_bottom(currentJudasBox, currentDay.lowPrice)
        box.set_right(currentJudasBox, currentDayEndTime)

// ═══════════════════════════════════════════════════════════════════════════
// SHOW ONLY
// ═══════════════════════════════════════════════════════════════════════════

showOnlyTimeframeAllowed = chart.is_range or timeframe.in_seconds(timeframe.period) <= SHOW_ONLY_MAX_TIMEFRAME_SECONDS
activeShowOnlySession = visibleWindow == WINDOW_LABEL_FROM_0500 ? SESSION_WINDOW_FROM_0500 : visibleWindow == WINDOW_LABEL_FROM_0830 ? SESSION_WINDOW_FROM_0830 : visibleWindow == WINDOW_LABEL_RTH ? SESSION_WINDOW_RTH : SESSION_WINDOW_OVERNIGHT
showOnlyInVisibleWindow = not na(time(timeframe.period, activeShowOnlySession, NY_TIMEZONE))
bool showOnlyInMostRecentDay = true
if showOnlyMostRecent
    showOnlyInMostRecentDay := year(time, NY_TIMEZONE) == year(timenow, NY_TIMEZONE) and month(time, NY_TIMEZONE) == month(timenow, NY_TIMEZONE) and dayofmonth(time, NY_TIMEZONE) == dayofmonth(timenow, NY_TIMEZONE)
hideThisBar = showOnlyEnabled and showOnlyTimeframeAllowed and not (showOnlyInVisibleWindow and (not showOnlyMostRecent or showOnlyInMostRecentDay))

showPanePriceCandles = secondaryPaneMode and showPriceCandlesInPane
paneBodyColor = close >= open ? paneUpBodyColor : paneDownBodyColor
paneBorderColor = close >= open ? paneUpBorderColor : paneDownBorderColor
paneWickColor = close >= open ? paneUpWickColor : paneDownWickColor
hideMainChartCandle = not secondaryPaneMode and hideThisBar
hidePaneCandle = showPanePriceCandles and hideThisBar

plotcandle(showPanePriceCandles ? open : na, high, low, close, title="Pane Price Candles", color=paneBodyColor, bordercolor=paneBorderColor, wickcolor=paneWickColor, editable=false, display=display.pane)
plotcandle(hidePaneCandle ? open : na, high, low, close, title="Pane Hidden Candles", color=hiddenCandleColor, bordercolor=hiddenCandleColor, wickcolor=hiddenCandleColor, editable=false, display=display.pane)
plotcandle(hideMainChartCandle ? open : na, high, low, close, title="Hidden Candles", color=hiddenCandleColor, bordercolor=hiddenCandleColor, wickcolor=hiddenCandleColor, editable=false, display=display.pane, force_overlay=true)

// ═══════════════════════════════════════════════════════════════════════════
// STATISTICS TABLE
// ═══════════════════════════════════════════════════════════════════════════

method includeObservation(RangeStats this, RangeObservation period, float rangeMultiplier) =>
    if not na(period)
        this.displayed += 1
        float projectedRange = period.averageRange * rangeMultiplier
        if withinRangeBand(period.highPrice, period.lowPrice, period.openPrice, projectedRange, 1.0 / 3.0)
            this.withinThird += 1
        if withinRangeBand(period.highPrice, period.lowPrice, period.openPrice, projectedRange, 2.0 / 3.0)
            this.withinTwoThirds += 1
        if withinRangeBand(period.highPrice, period.lowPrice, period.openPrice, projectedRange, 1.0)
            this.withinFull += 1

calculateDisplayedRangeStats(array<RangeObservation> completedPeriods, RangeObservation currentPeriod, float rangeMultiplier) =>
    RangeStats stats = RangeStats.new(0, 0, 0, 0, 0)
    if array.size(completedPeriods) > 0
        for period in completedPeriods
            stats.includeObservation(period, rangeMultiplier)
    stats.includeObservation(currentPeriod, rangeMultiplier)
    stats.exceededFull := stats.displayed - stats.withinFull
    stats

statisticsRate(int count, int total) =>
    total > 0 ? str.tostring(count * 100.0 / total, "#.0") + "%" : "—"

statisticsRangeLabel(string rangeName, float rangeMultiplier) =>
    rangeMultiplier == 1.0 ? rangeName : str.tostring(rangeMultiplier, "#.#") + "× " + rangeName

setStatisticsRow(table tbl, int row, string metric, int count, int total, string textSize) =>
    table.cell(tbl, 0, row, metric, text_size=textSize, text_color=color.black)
    table.cell(tbl, 1, row, str.tostring(count), text_size=textSize, text_color=color.black)
    table.cell(tbl, 2, row, statisticsRate(count, total), text_size=textSize, text_color=color.black)

addStatisticsSection(table tbl, int startRow, string rangeName, string periodUnit, float rangeMultiplier, RangeStats stats, string textSize) =>
    table.cell(tbl, 0, startRow, rangeName, bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=textSize)
    table.cell(tbl, 1, startRow, periodUnit, bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=textSize)
    table.cell(tbl, 2, startRow, "Rate", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=textSize)
    setStatisticsRow(tbl, startRow + 1, "Displayed", stats.displayed, stats.displayed, textSize)
    setStatisticsRow(tbl, startRow + 2, "Within ±⅓", stats.withinThird, stats.displayed, textSize)
    setStatisticsRow(tbl, startRow + 3, "Within ±⅔", stats.withinTwoThirds, stats.displayed, textSize)
    string fullRangeLabel = statisticsRangeLabel(rangeName, rangeMultiplier)
    setStatisticsRow(tbl, startRow + 4, "Within ±" + fullRangeLabel, stats.withinFull, stats.displayed, textSize)
    setStatisticsRow(tbl, startRow + 5, "Exceeded " + fullRangeLabel, stats.exceededFull, stats.displayed, textSize)
    startRow + STATISTICS_SECTION_ROWS

var table statisticsTable = table.new(position.bottom_right, 3, STATISTICS_TABLE_ROWS, bgcolor=color.white, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

if barstate.islast
    table.clear(statisticsTable, 0, 0, 2, STATISTICS_TABLE_ROWS - 1)
    if showStatisticsTable
        string tableTextSize = toLabelSize(statisticsTextSize)
        int statisticsRow = 0

        if adrActive
            RangeStats adrStats = calculateDisplayedRangeStats(adrProjection.historyObservations, adrProjection.currentObservation, adrMultiplier)
            statisticsRow := addStatisticsSection(statisticsTable, statisticsRow, "ADR", "Days", adrMultiplier, adrStats, tableTextSize)

        if awrActive
            RangeStats awrStats = calculateDisplayedRangeStats(awrProjection.historyObservations, awrProjection.currentObservation, awrMultiplier)
            statisticsRow := addStatisticsSection(statisticsTable, statisticsRow, "AWR", "Weeks", awrMultiplier, awrStats, tableTextSize)

        if amrActive
            RangeStats amrStats = calculateDisplayedRangeStats(amrProjection.historyObservations, amrProjection.currentObservation, amrMultiplier)
            statisticsRow := addStatisticsSection(statisticsTable, statisticsRow, "AMR", "Months", amrMultiplier, amrStats, tableTextSize)

// ═══════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE
// ═══════════════════════════════════════════════════════════════════════════

addColorRow(table tbl, int row, string name, color clr) =>
    table.cell(tbl, 0, row, name, text_size=size.small, text_color=color.black)
    table.cell(tbl, 1, row, str.format("R:{0} G:{1} B:{2}", int(color.r(clr)), int(color.g(clr)), int(color.b(clr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 2, row, str.tostring(int(color.t(clr))), text_size=size.small, text_color=color.black)

if showColorTable and barstate.islast
    var table colorTable = table.new(position.top_right, 3, COLOR_TABLE_ROWS, bgcolor=color.white, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)
    table.clear(colorTable, 0, 0, 2, COLOR_TABLE_ROWS - 1)

    table.cell(colorTable, 0, 0, "Setting", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 1, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 2, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)

    int colorRow = 1

    if showOnlyEnabled and showOnlyTimeframeAllowed
        addColorRow(colorTable, colorRow, "Hidden Candles", hiddenCandleColor)
        colorRow += 1

    if secondaryPaneMode and showPriceCandlesInPane
        addColorRow(colorTable, colorRow, "Up Body", paneUpBodyColor)
        colorRow += 1
        addColorRow(colorTable, colorRow, "Down Body", paneDownBodyColor)
        colorRow += 1
        addColorRow(colorTable, colorRow, "Up Border", paneUpBorderColor)
        colorRow += 1
        addColorRow(colorTable, colorRow, "Down Border", paneDownBorderColor)
        colorRow += 1
        addColorRow(colorTable, colorRow, "Up Wick", paneUpWickColor)
        colorRow += 1
        addColorRow(colorTable, colorRow, "Down Wick", paneDownWickColor)
        colorRow += 1

    if adrActive
        addColorRow(colorTable, colorRow, "ADR", adrColor)
        colorRow += 1
        if showAdrThirds
            addColorRow(colorTable, colorRow, "1/3 ADR", adrThirdsColor)
            colorRow += 1
        if showAdrTwoThirds
            addColorRow(colorTable, colorRow, "2/3 ADR", adrTwoThirdsColor)
            colorRow += 1
        if showMno
            addColorRow(colorTable, colorRow, "MNO", mnoColor)
            colorRow += 1
        if judasEnabled
            addColorRow(colorTable, colorRow, "Judas", judasColor)
            colorRow += 1

    if awrActive
        addColorRow(colorTable, colorRow, "AWR", awrColor)
        colorRow += 1
        if showAwrThirds
            addColorRow(colorTable, colorRow, "1/3 AWR", awrThirdsColor)
            colorRow += 1
        if showAwrTwoThirds
            addColorRow(colorTable, colorRow, "2/3 AWR", awrTwoThirdsColor)
            colorRow += 1
        if showWeeklyOpen
            addColorRow(colorTable, colorRow, "Weekly Open", weeklyOpenColor)
            colorRow += 1

    if amrActive
        addColorRow(colorTable, colorRow, "AMR", amrColor)
        colorRow += 1
        if showAmrThirds
            addColorRow(colorTable, colorRow, "1/3 AMR", amrThirdsColor)
            colorRow += 1
        if showAmrTwoThirds
            addColorRow(colorTable, colorRow, "2/3 AMR", amrTwoThirdsColor)
            colorRow += 1
        if showMonthlyOpen
            addColorRow(colorTable, colorRow, "Monthly Open", monthlyOpenColor)
            colorRow += 1

// adr •
