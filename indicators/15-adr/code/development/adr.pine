//@version=6
indicator("adr •", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ═══════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════

// Calculation type options
CALC_NY_MIDNIGHT = "NY Midnight"
CALC_DAILY_CANDLE = "Daily Candle"

// Judas condition options
JUDAS_THIRD = "1/3 ADR"
JUDAS_80PCT = "80% ADR"

// Style options
STYLE_SOLID = "Solid"
STYLE_DASHED = "Dashed"
STYLE_DOTTED = "Dotted"

// Size options
SIZE_TINY = "Tiny"
SIZE_SMALL = "Small"
SIZE_NORMAL = "Normal"

// Input groups
GROUP_SETTINGS = "Settings"
GROUP_STYLE = "Styling"
GROUP_JUDAS = "Judas Detection"
GROUP_ALERTS = "Alerts"
GROUP_COLOR_TABLE = "Color Reference"

// Drawing
MAX_HISTORY = 20

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════

// Settings
adrLookback = input.int(5, "ADR Lookback", minval=1, maxval=MAX_HISTORY, group=GROUP_SETTINGS)
calcType = input.string(CALC_NY_MIDNIGHT, "Calculation", options=[CALC_NY_MIDNIGHT, CALC_DAILY_CANDLE], group=GROUP_SETTINGS, tooltip="• NY Midnight: Uses 00:00-00:00 NY Time ranges (ICT method)\n• Daily Candle: Uses standard daily candle high-low")
showHistorical = input.bool(false, "Show Historical", inline="hist", group=GROUP_SETTINGS)
historyDays = input.int(10, "Days", minval=1, maxval=MAX_HISTORY, inline="hist", group=GROUP_SETTINGS)
labelSize = input.string(SIZE_TINY, "Labels", options=[SIZE_TINY, SIZE_SMALL, SIZE_NORMAL], group=GROUP_SETTINGS)

// Styling - ADR
showAdr = input.bool(true, "ADR", inline="adr", group=GROUP_STYLE)
adrColor = input.color(color.rgb(242, 54, 69), "", inline="adr", group=GROUP_STYLE)
adrStyle = input.string(STYLE_SOLID, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="adr", group=GROUP_STYLE)
adrWidth = input.int(1, "", minval=1, maxval=4, inline="adr", group=GROUP_STYLE)

// Styling - 1/3 ADR
showThirds = input.bool(true, "1/3 ADR", inline="thirds", group=GROUP_STYLE)
thirdsColor = input.color(color.rgb(41, 98, 255), "", inline="thirds", group=GROUP_STYLE)
thirdsStyle = input.string(STYLE_DASHED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="thirds", group=GROUP_STYLE)
thirdsWidth = input.int(1, "", minval=1, maxval=4, inline="thirds", group=GROUP_STYLE)

// Styling - 2/3 ADR
showTwoThirds = input.bool(true, "2/3 ADR", inline="twothirds", group=GROUP_STYLE)
twoThirdsColor = input.color(color.rgb(144, 191, 249), "", inline="twothirds", group=GROUP_STYLE)
twoThirdsStyle = input.string(STYLE_DOTTED, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="twothirds", group=GROUP_STYLE)
twoThirdsWidth = input.int(1, "", minval=1, maxval=4, inline="twothirds", group=GROUP_STYLE)

// Styling - Anchor
showAnchor = input.bool(true, "Anchor", inline="anchor", group=GROUP_STYLE)
anchorColor = input.color(color.rgb(41, 98, 255), "", inline="anchor", group=GROUP_STYLE)
anchorStyle = input.string(STYLE_SOLID, "", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], inline="anchor", group=GROUP_STYLE)
anchorWidth = input.int(1, "", minval=1, maxval=4, inline="anchor", group=GROUP_STYLE)

// Judas Detection
judasEnabled = input.bool(false, "Enable", inline="judas", group=GROUP_JUDAS)
judasCondition = input.string(JUDAS_THIRD, "", options=[JUDAS_THIRD, JUDAS_80PCT], inline="judas", group=GROUP_JUDAS)
judasColor = input.color(color.orange, "", inline="judas", group=GROUP_JUDAS)
judasHour = input.int(8, "Cutoff (NY)", minval=0, maxval=23, inline="cutoff", group=GROUP_JUDAS)
judasMinute = input.int(0, ":", minval=0, maxval=59, inline="cutoff", group=GROUP_JUDAS, tooltip="Judas Swing: price exhausts early in session before this cutoff time")

// Alerts
alertAdrEnabled = input.bool(true, "ADR", inline="alert_adr", group=GROUP_ALERTS)
alertThirdsEnabled = input.bool(true, "1/3 ADR", inline="alert_thirds", group=GROUP_ALERTS)
alertTwoThirdsEnabled = input.bool(true, "2/3 ADR", inline="alert_twothirds", group=GROUP_ALERTS)

// Color Reference
showColorTable = input.bool(false, "Show Color Reference Table", group=GROUP_COLOR_TABLE, tooltip="Display a table showing all color settings with RGB values and transparency levels")

// ═══════════════════════════════════════════════════════════════════════════
// TYPE DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════════

type LevelConfig
    float multiplier
    string labelText
    color col
    string style
    int width
    bool show

type LevelPair
    line upper
    line lower
    label lblUpper
    label lblLower

type DayLevels
    array<LevelPair> pairs
    int startTime
    int endTime

type DayData
    float openPrice
    float highPrice
    float lowPrice
    float dayRange
    float adr
    int startTime
    int endTime
    bool judasHit

type AlertState
    bool adrPlus
    bool adrMinus
    bool thirdsPlus
    bool thirdsMinus
    bool twoThirdsPlus
    bool twoThirdsMinus

method reset(AlertState this) =>
    this.adrPlus := false
    this.adrMinus := false
    this.thirdsPlus := false
    this.thirdsMinus := false
    this.twoThirdsPlus := false
    this.twoThirdsMinus := false

// ═══════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════

toLineStyle(string style) =>
    switch style
        STYLE_SOLID => line.style_solid
        STYLE_DASHED => line.style_dashed
        STYLE_DOTTED => line.style_dotted
        => line.style_solid

toLabelSize(string sizeStr) =>
    switch sizeStr
        SIZE_TINY => size.tiny
        SIZE_SMALL => size.small
        SIZE_NORMAL => size.normal
        => size.tiny

calcAdr(array<float> ranges, int lookback) =>
    count = math.min(lookback, array.size(ranges))
    if count > 0
        sum = 0.0
        for i = 0 to count - 1
            sum += array.get(ranges, i)
        sum / count
    else
        float(na)

// ═══════════════════════════════════════════════════════════════════════════
// LEVEL DRAWING METHODS
// ═══════════════════════════════════════════════════════════════════════════

method draw(LevelConfig this, int t1, int t2, float anchor, float adrValue, bool showLabel, string labelSize) =>
    LevelPair pair = LevelPair.new()

    if not this.show
        pair
    else
        upperPrice = anchor + (adrValue * this.multiplier)
        lowerPrice = anchor - (adrValue * this.multiplier)
        lineStyle = toLineStyle(this.style)
        lblSize = toLabelSize(labelSize)

        pair.upper := line.new(t1, upperPrice, t2, upperPrice, color=this.col, style=lineStyle, width=this.width, xloc=xloc.bar_time)
        pair.lower := line.new(t1, lowerPrice, t2, lowerPrice, color=this.col, style=lineStyle, width=this.width, xloc=xloc.bar_time)

        if showLabel
            pair.lblUpper := label.new(t2, upperPrice, this.labelText + "+", style=label.style_label_left, textcolor=this.col, color=color.new(color.white, 100), size=lblSize, xloc=xloc.bar_time)
            pair.lblLower := label.new(t2, lowerPrice, this.labelText + "-", style=label.style_label_left, textcolor=this.col, color=color.new(color.white, 100), size=lblSize, xloc=xloc.bar_time)

        pair

method drawAnchor(LevelConfig this, int t1, int t2, float anchor, bool showLabel, string labelSize) =>
    LevelPair pair = LevelPair.new()

    if not this.show
        pair
    else
        lineStyle = toLineStyle(this.style)
        lblSize = toLabelSize(labelSize)

        pair.upper := line.new(t1, anchor, t2, anchor, color=this.col, style=lineStyle, width=this.width, xloc=xloc.bar_time)

        if showLabel
            pair.lblUpper := label.new(t2, anchor, this.labelText, style=label.style_label_left, textcolor=this.col, color=color.new(color.white, 100), size=lblSize, xloc=xloc.bar_time)

        pair

method delete(LevelPair this) =>
    if not na(this)
        line.delete(this.upper)
        line.delete(this.lower)
        label.delete(this.lblUpper)
        label.delete(this.lblLower)

method extend(LevelPair this, int t2) =>
    if not na(this)
        if not na(this.upper)
            line.set_x2(this.upper, t2)
        if not na(this.lower)
            line.set_x2(this.lower, t2)

method updateLabelX(LevelPair this, int t) =>
    if not na(this)
        if not na(this.lblUpper)
            label.set_x(this.lblUpper, t)
        if not na(this.lblLower)
            label.set_x(this.lblLower, t)

method updateLabelText(LevelPair this, string upperText, string lowerText) =>
    if not na(this)
        if not na(this.lblUpper)
            label.set_text(this.lblUpper, upperText)
        if not na(this.lblLower)
            label.set_text(this.lblLower, lowerText)

method delete(DayLevels this) =>
    if not na(this) and not na(this.pairs)
        for pair in this.pairs
            pair.delete()

method extend(DayLevels this, int t2) =>
    if not na(this) and not na(this.pairs)
        for pair in this.pairs
            pair.extend(t2)

method updateLabels(DayLevels this, int t) =>
    if not na(this) and not na(this.pairs)
        for pair in this.pairs
            pair.updateLabelX(t)

// ═══════════════════════════════════════════════════════════════════════════
// LEVEL CONFIGURATION BUILDER
// ═══════════════════════════════════════════════════════════════════════════

buildConfigs(int days) =>
    array<LevelConfig> configs = array.new<LevelConfig>()

    // ADR levels (multiplier = 1.0)
    configs.push(LevelConfig.new(1.0, str.tostring(days) + "ADR", adrColor, adrStyle, adrWidth, showAdr))

    // 2/3 ADR levels
    configs.push(LevelConfig.new(2.0/3.0, "2/3ADR", twoThirdsColor, twoThirdsStyle, twoThirdsWidth, showTwoThirds))

    // 1/3 ADR levels
    configs.push(LevelConfig.new(1.0/3.0, "1/3ADR", thirdsColor, thirdsStyle, thirdsWidth, showThirds))

    configs

buildAnchorConfig() =>
    LevelConfig.new(0.0, "MNO", anchorColor, anchorStyle, anchorWidth, showAnchor)

// ═══════════════════════════════════════════════════════════════════════════
// DRAW ALL LEVELS FOR A DAY
// ═══════════════════════════════════════════════════════════════════════════

drawDayLevels(int t1, int t2, float anchor, float adrValue, bool showLabels, int days) =>
    DayLevels dayLevels = DayLevels.new(array.new<LevelPair>(), t1, t2)
    configs = buildConfigs(days)
    anchorConfig = buildAnchorConfig()

    // Draw ADR levels
    for config in configs
        pair = config.draw(t1, t2, anchor, adrValue, showLabels, labelSize)
        dayLevels.pairs.push(pair)

    // Draw anchor
    anchorPair = anchorConfig.drawAnchor(t1, t2, anchor, showLabels, labelSize)
    dayLevels.pairs.push(anchorPair)

    dayLevels

// ═══════════════════════════════════════════════════════════════════════════
// TIME DETECTION
// ═══════════════════════════════════════════════════════════════════════════

nyHour = hour(time, "America/New_York")
prevNyHour = hour(time[1], "America/New_York")
isNewNyDay = nyHour == 0 and prevNyHour == 23
isNewDailyCandle = timeframe.change("D")

// ═══════════════════════════════════════════════════════════════════════════
// DATA STORAGE
// ═══════════════════════════════════════════════════════════════════════════

var array<DayData> completedDays = array.new<DayData>()
var array<float> nyRanges = array.new_float()
var array<float> dailyRanges = array.new_float()
var DayData currentDay = DayData.new(open, high, low, 0.0, na, time)

var float dailyCandleHigh = high
var float dailyCandleLow = low

var bool judasHitToday = false
var array<box> judasBoxes = array.new<box>()

// Alert tracking (reset each day)
var AlertState alertHit = AlertState.new()

// ═══════════════════════════════════════════════════════════════════════════
// NY MIDNIGHT TRACKING
// ═══════════════════════════════════════════════════════════════════════════

if isNewNyDay
    if not na(currentDay.openPrice) and currentDay.highPrice > 0
        currentDay.dayRange := currentDay.highPrice - currentDay.lowPrice
        currentDay.endTime := time
        currentDay.judasHit := judasHitToday
        array.unshift(nyRanges, currentDay.dayRange)
        if array.size(nyRanges) > MAX_HISTORY
            array.pop(nyRanges)

    todayAdr = calcType == CALC_NY_MIDNIGHT ? calcAdr(nyRanges, adrLookback) : calcAdr(dailyRanges, adrLookback)

    if not na(currentDay.openPrice) and currentDay.highPrice > 0
        array.unshift(completedDays, currentDay.copy())
        if array.size(completedDays) > MAX_HISTORY
            array.pop(completedDays)

    currentDay := DayData.new(open, high, low, 0.0, todayAdr, time, na, false)
    judasHitToday := false
    alertHit.reset()
else
    currentDay.highPrice := math.max(currentDay.highPrice, high)
    currentDay.lowPrice := math.min(currentDay.lowPrice, low)

// ═══════════════════════════════════════════════════════════════════════════
// DAILY CANDLE TRACKING
// ═══════════════════════════════════════════════════════════════════════════

if isNewDailyCandle
    if dailyCandleHigh > 0 and dailyCandleLow > 0
        array.unshift(dailyRanges, dailyCandleHigh - dailyCandleLow)
        if array.size(dailyRanges) > MAX_HISTORY
            array.pop(dailyRanges)
    dailyCandleHigh := high
    dailyCandleLow := low
else
    dailyCandleHigh := math.max(dailyCandleHigh, high)
    dailyCandleLow := math.min(dailyCandleLow, low)

// ═══════════════════════════════════════════════════════════════════════════
// JUDAS DETECTION
// ═══════════════════════════════════════════════════════════════════════════

if judasEnabled and not judasHitToday and not na(currentDay.adr)
    nyMinute = minute(time, "America/New_York")
    cutoffMinutes = judasHour * 60 + judasMinute
    currentMinutes = nyHour * 60 + nyMinute

    if currentMinutes <= cutoffMinutes
        levelOffset = judasCondition == JUDAS_THIRD ? currentDay.adr / 3 : currentDay.adr * 0.8
        levelPlus = currentDay.openPrice + levelOffset
        levelMinus = currentDay.openPrice - levelOffset

        if high >= levelPlus or low <= levelMinus
            judasHitToday := true

// ═══════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════

// Calculate level prices from anchor
anchor = currentDay.openPrice
adr = currentDay.adr
hasAdr = not na(adr)

// Check reaches and determine alerts (once per day per level)
alertAdrPlus = hasAdr and high >= anchor + adr and not alertHit.adrPlus
alertAdrMinus = hasAdr and low <= anchor - adr and not alertHit.adrMinus
alertThirdsPlus = hasAdr and high >= anchor + adr / 3 and not alertHit.thirdsPlus
alertThirdsMinus = hasAdr and low <= anchor - adr / 3 and not alertHit.thirdsMinus
alertTwoThirdsPlus = hasAdr and high >= anchor + adr * 2 / 3 and not alertHit.twoThirdsPlus
alertTwoThirdsMinus = hasAdr and low <= anchor - adr * 2 / 3 and not alertHit.twoThirdsMinus

// Update hit tracking
if alertAdrPlus
    alertHit.adrPlus := true
if alertAdrMinus
    alertHit.adrMinus := true
if alertThirdsPlus
    alertHit.thirdsPlus := true
if alertThirdsMinus
    alertHit.thirdsMinus := true
if alertTwoThirdsPlus
    alertHit.twoThirdsPlus := true
if alertTwoThirdsMinus
    alertHit.twoThirdsMinus := true

// Fire alerts
if alertAdrEnabled and alertAdrPlus
    alert("ADR+ reached", alert.freq_once_per_bar)
if alertAdrEnabled and alertAdrMinus
    alert("ADR- reached", alert.freq_once_per_bar)
if alertThirdsEnabled and alertThirdsPlus
    alert("1/3 ADR+ reached", alert.freq_once_per_bar)
if alertThirdsEnabled and alertThirdsMinus
    alert("1/3 ADR- reached", alert.freq_once_per_bar)
if alertTwoThirdsEnabled and alertTwoThirdsPlus
    alert("2/3 ADR+ reached", alert.freq_once_per_bar)
if alertTwoThirdsEnabled and alertTwoThirdsMinus
    alert("2/3 ADR- reached", alert.freq_once_per_bar)

// ═══════════════════════════════════════════════════════════════════════════
// DRAWING - CURRENT DAY
// ═══════════════════════════════════════════════════════════════════════════

var DayLevels currentLevels = na

if isNewNyDay and not na(currentDay.adr)
    currentLevels.delete()
    currentLevels := drawDayLevels(time, time, currentDay.openPrice, currentDay.adr, true, adrLookback)

currentLevels.extend(time)
currentLevels.updateLabels(time)

// Update ADR label text with current lookback days
if not na(currentLevels) and not na(currentLevels.pairs) and array.size(currentLevels.pairs) > 0
    adrPair = array.get(currentLevels.pairs, 0)
    adrPair.updateLabelText(str.tostring(adrLookback) + "ADR+", str.tostring(adrLookback) + "ADR-")

// ═══════════════════════════════════════════════════════════════════════════
// DRAWING - HISTORICAL
// ═══════════════════════════════════════════════════════════════════════════

var array<DayLevels> histLevels = array.new<DayLevels>()

if isNewNyDay and showHistorical and array.size(completedDays) > 0
    for levels in histLevels
        levels.delete()
    array.clear(histLevels)

    drawCount = math.min(historyDays, array.size(completedDays))
    for i = 0 to drawCount - 1
        day = array.get(completedDays, i)
        if not na(day.adr)
            endTime = i == 0 ? currentDay.startTime : array.get(completedDays, i - 1).startTime
            levels = drawDayLevels(day.startTime, endTime, day.openPrice, day.adr, false, adrLookback)
            array.push(histLevels, levels)

// ═══════════════════════════════════════════════════════════════════════════
// JUDAS BOXES
// ═══════════════════════════════════════════════════════════════════════════

var box currentJudasBox = na

if judasEnabled and isNewNyDay
    for b in judasBoxes
        box.delete(b)
    array.clear(judasBoxes)
    box.delete(currentJudasBox)
    currentJudasBox := na

    for day in completedDays
        if day.judasHit and not na(day.endTime)
            b = box.new(day.startTime, day.highPrice, day.endTime, day.lowPrice, border_color=judasColor, border_width=1, bgcolor=na, xloc=xloc.bar_time)
            array.push(judasBoxes, b)

if judasEnabled and judasHitToday
    if na(currentJudasBox)
        currentJudasBox := box.new(currentDay.startTime, currentDay.highPrice, time, currentDay.lowPrice, border_color=judasColor, border_width=1, bgcolor=na, xloc=xloc.bar_time)
    else
        box.set_top(currentJudasBox, currentDay.highPrice)
        box.set_bottom(currentJudasBox, currentDay.lowPrice)
        box.set_right(currentJudasBox, time)

// ═══════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE
// ═══════════════════════════════════════════════════════════════════════════

addColorRow(table tbl, int row, string name, color clr) =>
    table.cell(tbl, 0, row, name, text_size=size.small, text_color=color.black)
    table.cell(tbl, 1, row, str.format("R:{0} G:{1} B:{2}", int(color.r(clr)), int(color.g(clr)), int(color.b(clr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 2, row, str.tostring(int(color.t(clr))), text_size=size.small, text_color=color.black)

if showColorTable and barstate.islast
    var table color_table = table.new(position.top_right, 3, 10, bgcolor=color.white, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

    // Header row
    table.cell(color_table, 0, 0, "Setting", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(color_table, 1, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(color_table, 2, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)

    int currentRow = 1

    // ADR levels
    if showAdr
        addColorRow(color_table, currentRow, "ADR", adrColor)
        currentRow += 1
    if showThirds
        addColorRow(color_table, currentRow, "1/3 ADR", thirdsColor)
        currentRow += 1
    if showTwoThirds
        addColorRow(color_table, currentRow, "2/3 ADR", twoThirdsColor)
        currentRow += 1
    if showAnchor
        addColorRow(color_table, currentRow, "Anchor", anchorColor)
        currentRow += 1
    if judasEnabled
        addColorRow(color_table, currentRow, "Judas", judasColor)
        currentRow += 1
