//@version=6
indicator("hunter •", overlay=true, max_labels_count=500)

// ─── BEARISH SIGNAL SETTINGS ───
showBearishBreaks = input.bool(true, "Show Bearish Pre-CSDs", group="Bearish Signals", tooltip="Enable/disable bearish pattern detection and red triangle markers")
bullishCandleCount = input.int(2, "Required Bullish Candles", minval=1, maxval=5, group="Bearish Signals", tooltip="How many consecutive bullish candles must occur before the bearish breakdown candle.\n\n• 1 = Only the last candle needs to be bullish\n• 2 = Last 2 candles must be bullish\n• 3+ = Requires longer bullish sequence\n\nHigher values = stronger reversal signal but fewer signals")
maxBearishSignals = input.int(10, "Max Signals to Display", minval=1, maxval=100, group="Bearish Signals", tooltip="Maximum number of bearish triangle markers to keep visible on the chart (older signals are removed)")

// ─── BULLISH SIGNAL SETTINGS ───
showBullishBreaks = input.bool(true, "Show Bullish Pre-CSDs", group="Bullish Signals", tooltip="Enable/disable bullish pattern detection and green triangle markers")
bearishCandleCount = input.int(2, "Required Bearish Candles", minval=1, maxval=5, group="Bullish Signals", tooltip="How many consecutive bearish candles must occur before the bullish breakout candle.\n\n• 1 = Only the last candle needs to be bearish\n• 2 = Last 2 candles must be bearish\n• 3+ = Requires longer bearish sequence\n\nHigher values = stronger reversal signal but fewer signals")
maxBullishSignals = input.int(10, "Max Signals to Display", minval=1, maxval=100, group="Bullish Signals", tooltip="Maximum number of bullish triangle markers to keep visible on the chart (older signals are removed)")

// ─── BREAKOUT CONDITIONS ───
requireCloseThrough = input.bool(false, "Wait for Close Confirmation: Full CSD", group="Signal Timing", tooltip="Controls how strict the breakout requirement is:\n\n• DISABLED (Trade Through): Signal triggers when price just touches/wicks through the level - more sensitive, earlier signals\n\n• ENABLED (Close Through): Signal only triggers when candle actually closes beyond the level - more conservative, stronger confirmation")

// ─── ROOT CANDLE FILTERING ───
useRootFilter = input.bool(false, "Enable Root Candle Filtering", group="Root Candle Filter", tooltip="Filter Pre-CSD signals based on current price relative to a root candle:\n• Above root price = Only bearish Pre-CSDs shown\n• Below root price = Only bullish Pre-CSDs shown\n• Auto-displays root EQ line when enabled")
useClosestRoot = input.bool(false, "📍 Auto-Select Closest Root", group="Root Candle Filter", tooltip="Automatically select the closest past root candle to current time\n⚠️ Only works when 'Enable Root Candle Filtering' is turned ON")
extendLineToNow = input.bool(false, "Extend Line to Current Time", group="Root Candle Filter", tooltip="Extend the root EQ line to current time instead of ending at next model time")
rootFilterMethod = input.string("Span Check", "Root Filter Method", group="Root Candle Filter",
     options=["Standard", "Span Check"],
     tooltip="Standard: Uses setup candle open price only\nSpan Check: Includes candles that span across root line (recommended)")
rootModel = input.string("09:53 Judas", "Root Time Model", group="Root Candle Filter",
     options=["18:07 Damasu", "19:37 Osaka", "21:44 Kyoto", "00:08 Nagasaki",
              "03:12 Turncoat", "04:10 Bishop", "05:29 Knight", "06:58 Big Ben",
              "09:30 New York Open", "09:53 Judas", "10:34 Model 11", "11:10 Model 110",
              "12:02 Lunch Model", "12:35 Model 1001", "13:30 Model 111"],
     tooltip="Manual root selection (ignored when Auto-Select is enabled)")

getNextModelEndTime(rootHour, rootMinute) =>
    rootTimeMinutes = rootHour * 60 + rootMinute
    switch
        rootTimeMinutes == 18*60 + 7 => [21, 14]
        rootTimeMinutes == 19*60 + 37 => [23, 4]
        rootTimeMinutes == 21*60 + 44 => [3, 0]
        rootTimeMinutes == 0*60 + 8 => [3, 44]
        rootTimeMinutes == 3*60 + 12 => [5, 20]
        rootTimeMinutes == 4*60 + 10 => [6, 39]
        rootTimeMinutes == 5*60 + 29 => [9, 30]
        rootTimeMinutes == 6*60 + 58 => [9, 55]
        rootTimeMinutes == 9*60 + 30 => [10, 20]
        rootTimeMinutes == 9*60 + 53 => [11, 10]
        rootTimeMinutes == 10*60 + 34 => [11, 49]
        rootTimeMinutes == 11*60 + 10 => [12, 35]
        rootTimeMinutes == 12*60 + 2 => [14, 9]
        rootTimeMinutes == 12*60 + 35 => [18, 0]
        rootTimeMinutes == 13*60 + 30 => [19, 1]
        => [rootHour + 2, rootMinute]

// FIXED: Find closest past root candle - DEBUG VERSION
findClosestRoot() =>
    // Use current bar time consistently for both replay and live modes
    currentTime = time
    currentHour = hour(currentTime, "America/New_York")
    currentMinute = minute(currentTime, "America/New_York")
    currentTotalMinutes = currentHour * 60 + currentMinute

    // Get current day of week (1=Sunday, 2=Monday, etc.)
    currentDayOfWeek = dayofweek(currentTime, "America/New_York")

    // Check if it's weekend (Saturday=7, Sunday=1)
    isWeekend = currentDayOfWeek == 1 or currentDayOfWeek == 7

    // For crypto, always use normal logic
    isCrypto = syminfo.type == "crypto"

    // FIXED: Simplified logic - only use weekend override for actual weekends
    if isWeekend and not isCrypto and barstate.isrealtime
        "13:30 Model 111"
    else
        // Find the most recent root that has passed based on current time
        if currentTotalMinutes >= 13*60 + 30      // >= 810 (1:30 PM)
            "13:30 Model 111"
        else if currentTotalMinutes >= 12*60 + 35 // >= 755 (12:35 PM)
            "12:35 Model 1001"
        else if currentTotalMinutes >= 12*60 + 2  // >= 722 (12:02 PM)
            "12:02 Lunch Model"
        else if currentTotalMinutes >= 11*60 + 10 // >= 670 (11:10 AM)
            "11:10 Model 110"
        else if currentTotalMinutes >= 10*60 + 34 // >= 634 (10:34 AM)
            "10:34 Model 11"
        else if currentTotalMinutes >= 9*60 + 53  // >= 593 (9:53 AM)
            "09:53 Judas"
        else if currentTotalMinutes >= 9*60 + 30  // >= 570 (9:30 AM)
            "09:30 New York Open"
        else if currentTotalMinutes >= 6*60 + 58  // >= 418 (6:58 AM)
            "06:58 Big Ben"
        else if currentTotalMinutes >= 5*60 + 29  // >= 329 (5:29 AM)
            "05:29 Knight"
        else if currentTotalMinutes >= 4*60 + 10  // >= 250 (4:10 AM)
            "04:10 Bishop"
        else if currentTotalMinutes >= 3*60 + 12  // >= 192 (3:12 AM)
            "03:12 Turncoat"
        else if currentTotalMinutes >= 0*60 + 8   // >= 8 (12:08 AM)
            "00:08 Nagasaki"
        else
            "21:44 Kyoto"  // For very early morning (before 12:08 AM)

// Get root time from model name
getRootTimeFromModel(model) =>
    switch model
        "18:07 Damasu" => [18, 7]
        "19:37 Osaka" => [19, 37]
        "21:44 Kyoto" => [21, 44]
        "00:08 Nagasaki" => [0, 8]
        "03:12 Turncoat" => [3, 12]
        "04:10 Bishop" => [4, 10]
        "05:29 Knight" => [5, 29]
        "06:58 Big Ben" => [6, 58]
        "09:30 New York Open" => [9, 30]
        "09:53 Judas" => [9, 53]
        "10:34 Model 11" => [10, 34]
        "11:10 Model 110" => [11, 10]
        "12:02 Lunch Model" => [12, 2]
        "12:35 Model 1001" => [12, 35]
        "13:30 Model 111" => [13, 30]
        => [9, 53]

// FIXED: Better root model selection and tracking - PRESERVED ORIGINAL LOGIC
targetRootModel = useClosestRoot ? findClosestRoot() : rootModel
[rootHour, rootMinute] = getRootTimeFromModel(targetRootModel)

// Root candle setup - PRESERVED EXACTLY from working version
var float rootPrice = na
var bool rootFoundToday = false
var int rootTimestamp = na
var line rootLine = na
var label rootLabel = na
var string lastUsedModel = ""

// Reset daily - PRESERVED EXACTLY
if ta.change(dayofmonth(time)) != 0
    rootPrice := na
    rootFoundToday := false
    rootTimestamp := na
    lastUsedModel := ""

// Force reset when auto-select changes target - PRESERVED EXACTLY
if useClosestRoot and targetRootModel != lastUsedModel
    rootPrice := na
    rootFoundToday := false
    rootTimestamp := na
    lastUsedModel := targetRootModel

// Get current bar's time info - PRESERVED EXACTLY
currentTime = time("", "America/New_York")
currentHour = hour(currentTime, "America/New_York")
currentMinute = minute(currentTime, "America/New_York")

// Check if root time falls within this bar's time range - PRESERVED EXACTLY
isRootBar = false

if not rootFoundToday  // Only check if we haven't found it today
    if timeframe.multiplier == 1
        // 1-minute: exact match
        isRootBar := currentHour == rootHour and currentMinute == rootMinute
    else
        // Higher timeframes: check if root time falls within this bar
        barStartMinute = currentMinute - (currentMinute % timeframe.multiplier)
        barEndMinute = barStartMinute + timeframe.multiplier - 1

        if currentHour == rootHour
            isRootBar := rootMinute >= barStartMinute and rootMinute <= barEndMinute

// Capture root price when we find it - PRESERVED EXACTLY
if isRootBar and not rootFoundToday
    // Get 1-minute data for consistent pricing - EXACT same as working version
    oneMinHigh = request.security(syminfo.tickerid, "1", high, lookahead=barmerge.lookahead_off)
    oneMinLow = request.security(syminfo.tickerid, "1", low, lookahead=barmerge.lookahead_off)

    rootPrice := (oneMinHigh + oneMinLow) / 2
    rootFoundToday := true
    rootTimestamp := currentTime  // Use the timezone-consistent time

// Draw the root line with improved extension logic
if useRootFilter and not na(rootPrice) and not na(rootTimestamp)
    if not na(rootLine)
        line.delete(rootLine)
    if not na(rootLabel)
        label.delete(rootLabel)

    // Calculate model end time
    [endHour, endMinute] = getNextModelEndTime(rootHour, rootMinute)
    modelEndTime = timestamp("America/New_York", year(rootTimestamp), month(rootTimestamp), dayofmonth(rootTimestamp), endHour, endMinute, 0)

    // Handle overnight end times
    if modelEndTime < rootTimestamp
        modelEndTime := modelEndTime + 24*60*60*1000

    // FIXED: Better extension logic that works in both replay and live modes
    maxSafeExtension = time + (300 * timeframe.multiplier * 60 * 1000)  // Reduced from 500 to 300 bars for safety

    lineEndTime = modelEndTime  // Default: use model end time
    extendStatus = "Model End"

    if extendLineToNow
        // In replay mode, extend to current bar time
        // In live mode, extend to real time with buffer
        targetTime = barstate.isrealtime ? (timenow + 10 * timeframe.multiplier * 60 * 1000) : time

        if targetTime <= maxSafeExtension
            lineEndTime := targetTime
            extendStatus := barstate.isrealtime ? "Extended to Now" : "Extended to Bar"
        else
            lineEndTime := math.min(maxSafeExtension, math.max(modelEndTime, time))
            extendStatus := "Extended (Limited)"
    else
        // Respect TradingView's line extension limits
        if modelEndTime <= maxSafeExtension
            lineEndTime := modelEndTime
            extendStatus := "Model End"
        else
            lineEndTime := maxSafeExtension
            extendStatus := "Model End (Limited)"

    // Draw blue line using time coordinates
    rootLine := line.new(rootTimestamp, rootPrice, lineEndTime, rootPrice, color=color.new(color.blue, 0), width=2, xloc=xloc.bar_time, extend=extend.none)

    // FIXED: Clean label without redundant time display
    labelText = str.tostring(rootHour, "#00") + ":" + str.tostring(rootMinute, "#00")
    if useClosestRoot
        labelText := labelText + " (Auto)"
    labelText := labelText + " | " + str.tostring(rootPrice, "#,###.##")

    rootLabel := label.new(lineEndTime, rootPrice, labelText, style=label.style_label_left, color=color.new(color.yellow, 70), textcolor=color.black, size=size.tiny, xloc=xloc.bar_time)

// Filtering logic - two methods: Standard vs Span Check - PRESERVED EXACTLY
setupAboveRoot = false
setupBelowRoot = false

if useRootFilter and not na(rootPrice)
    switch rootFilterMethod
        "Standard" =>
            setupAboveRoot := open[1] > rootPrice
            setupBelowRoot := open[1] < rootPrice
        "Span Check" =>
            setupSpansRoot = high[1] > rootPrice and low[1] < rootPrice
            setupAboveRoot := open[1] > rootPrice or setupSpansRoot
            setupBelowRoot := open[1] < rootPrice or setupSpansRoot

noRootFilter = not useRootFilter or na(rootPrice)

afterRootTime = true
if useRootFilter and not na(rootTimestamp)
    afterRootTime := time > rootTimestamp

checkConsecutiveBearish(candleCount) =>
    allBearish = true
    for i = 1 to candleCount
        if close[i] >= open[i]
            allBearish := false
            break
    allBearish

checkConsecutiveBullish(candleCount) =>
    allBullish = true
    for i = 1 to candleCount
        if close[i] <= open[i]
            allBullish := false
            break
    allBullish

// Bearish Pre-CSD detection
priorCandlesAreBullish = checkConsecutiveBullish(bullishCandleCount)
currentIsBear = close < open
lastBullishOpen = open[1]
breaksBelowLastOpen = requireCloseThrough ? close < lastBullishOpen : low < lastBullishOpen
bearishCondition = priorCandlesAreBullish and currentIsBear and breaksBelowLastOpen
bearishTrigger = bearishCondition and showBearishBreaks and (noRootFilter or (setupAboveRoot and afterRootTime))

// Bullish Pre-CSD detection
priorCandlesAreBearish = checkConsecutiveBearish(bearishCandleCount)
currentIsBull = close > open
lastBearishOpen = open[1]
breaksAboveLastOpen = requireCloseThrough ? close > lastBearishOpen : high > lastBearishOpen
bullishCondition = priorCandlesAreBearish and currentIsBull and breaksAboveLastOpen
bullishTrigger = bullishCondition and showBullishBreaks and (noRootFilter or (setupBelowRoot and afterRootTime))

// Signal arrays
var label[] bearishSignals = array.new<label>()
var label[] bullishSignals = array.new<label>()

// Clean signals that occurred before root time
if useRootFilter and not na(rootTimestamp)
    // Clean bearish signals
    if array.size(bearishSignals) > 0
        for i = array.size(bearishSignals) - 1 to 0
            lbl = array.get(bearishSignals, i)
            lblTime = label.get_x(lbl)
            if lblTime <= rootTimestamp
                label.delete(lbl)
                array.remove(bearishSignals, i)

    // Clean bullish signals
    if array.size(bullishSignals) > 0
        for i = array.size(bullishSignals) - 1 to 0
            lbl = array.get(bullishSignals, i)
            lblTime = label.get_x(lbl)
            if lblTime <= rootTimestamp
                label.delete(lbl)
                array.remove(bullishSignals, i)

// Place signals
if bearishTrigger
    signalTime = time[1]
    bullishLow = low[1]
    hoverText = "Bearish Pre-CSD Pattern\n• Setup: " + str.tostring(bullishCandleCount) + " consecutive bullish candles\n• Broke below: " + str.tostring(lastBullishOpen, "#.##") + " (last bullish open)\n• Signal: Bearish CSD anticipated"

    // Only place signal if no root filter OR signal occurs after root time
    if noRootFilter or na(rootTimestamp) or signalTime > rootTimestamp
        lb = label.new(signalTime, bullishLow, "▼", style=label.style_none, textcolor=color.red, size=size.tiny, yloc=yloc.abovebar, tooltip=hoverText, xloc=xloc.bar_time)
        array.push(bearishSignals, lb)
        if array.size(bearishSignals) > maxBearishSignals
            label.delete(array.shift(bearishSignals))

if bullishTrigger
    signalTime = time[1]
    bearishHigh = high[1]
    hoverText = "Bullish Pre-CSD Pattern\n• Setup: " + str.tostring(bearishCandleCount) + " consecutive bearish candles\n• Broke above: " + str.tostring(lastBearishOpen, "#.##") + " (last bearish open)\n• Signal: Bullish CSD anticipated"

    // Only place signal if no root filter OR signal occurs after root time
    if noRootFilter or na(rootTimestamp) or signalTime > rootTimestamp
        lb = label.new(signalTime, bearishHigh, "▲", style=label.style_none, textcolor=color.green, size=size.tiny, yloc=yloc.belowbar, tooltip=hoverText, xloc=xloc.bar_time)
        array.push(bullishSignals, lb)
        if array.size(bullishSignals) > maxBullishSignals
            label.delete(array.shift(bullishSignals))

// Alerts
alertcondition(bearishTrigger, title="Bearish Pre-CSDs Alert", message="Bearish Pre-CSDs Pattern Detected")
alertcondition(bullishTrigger, title="Bullish Pre-CSDs Alert", message="Bullish Pre-CSDs Pattern Detected")

// hunter •