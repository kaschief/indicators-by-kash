//@version=6

// ═══════════════════════════════════════════════════════════════════════════════
// INDICATOR VISUAL LIMITS (Must be declared before indicator() function)
// ═══════════════════════════════════════════════════════════════════════════════
INDICATOR_MAX_BOXES = 500
INDICATOR_MAX_LABELS = 500
INDICATOR_MAX_LINES = 500
INDICATOR_TITLE='SIF Core° [Pro+]'
SHORT_TITLE="SIF Core° [Pro+]"

indicator(title=INDICATOR_TITLE, shorttitle=SHORT_TITLE, overlay=true, max_boxes_count=INDICATOR_MAX_BOXES, max_labels_count=INDICATOR_MAX_LABELS, max_lines_count=INDICATOR_MAX_LINES)

// Grouped alert system variables
var bool sif_grouped_alert_active = false
var array<string> sif_alert_parts = array.new<string>()

// Cache of consolidated groups from last visual render (for stars reuse)
// Moved declaration below type ConsolidatedSIF to satisfy Pine type ordering

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS & CONSTANTS - CLEAN STRUCTURE
// ═══════════════════════════════════════════════════════════════════════════════

GAP_TYPE_FVG = "fvg"
GAP_TYPE_IMPLIED = "implied"
GAP_TYPE_VOLUME = "volume"
GAP_TYPE_TRUE = "true"
GAP_TYPE_RDRB = "rdrb"

FVG_FILTER_ALL = "All"
FVG_FILTER_BREAKAWAY_ONLY = "Breakaway-Only"
FVG_FILTER_STANDARD_ONLY = "Standard-Only"
LABEL_PREFIX_IMMEDIATE = "IMM-"
LABEL_PREFIX_BREAKAWAY = "BRK-"
BREAKAWAY_SOURCE_PREFIX = "Breakaway "
BREAKAWAY_LENGTH = 20

SUBTYPE_STANDARD = "standard"
SUBTYPE_INCLUSION = "inclusion"
SUBTYPE_REFLECTION = "reflection"
SUBTYPE_INCLUSION_TIE = "inclusion-tie"
SUBTYPE_IMPLIED = "implied"
SUBTYPE_VOLUME = "volume"
SUBTYPE_TRUE = "true"
SUBTYPE_RDRB = "rdrb"


WICK_TIER_STANDARD = "standard"
WICK_TIER_RELAXED = "relaxed"
WICK_TIER_RISKY = "risky"
WICK_TIER_NONE = "none"

WICK_DOMINANCE_STANDARD_THRESHOLD = 1.0
WICK_DOMINANCE_RELAXED_THRESHOLD = 0.85
WICK_DOMINANCE_RISKY_THRESHOLD = 0.80

INVALIDATION_STRICT = "Strict (55%)"
INVALIDATION_LENIENT = "Lenient (85%)"
INVALIDATION_CUSTOM = "Custom"

SIF_DIRECTION_BOTH = 'Both'
SIF_DIRECTION_BULLISH = 'SIF⁺ Only'
SIF_DIRECTION_BEARISH = 'SIF⁻ Only'

SIF_INVERSION_TYPE_ALL = "All"
SIF_INVERSION_TYPE_IMMEDIATE = "Immediate Only"
SIF_INVERSION_TYPE_REGULAR = "Regular Only"

CAPACITY_MODE_OPTIMIZED = "Optimized"
CAPACITY_MODE_BOOST = "Boost"
CAPACITY_MODE_ULTRA_BOOST = "Ultra Boost"
CAPACITY_MODE_ULTRA_PRO_BOOST = "Ultra Pro Boost"

BOOST_MULTIPLIER = 4.0
ULTRA_BOOST_MULTIPLIER = 8.0
ULTRA_PRO_BOOST_MULTIPLIER = 12.0

DEFAULT_BREAKAWAY_BORDER_WIDTH = 1

// ═══════════════════════════════════════════════════════════════════════════════
// PERFORMANCE & THRESHOLD CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

MAX_ACTIVE_GAPS = 100
MAX_SIF_RECORDS = 60
MAX_BODY_HIGHLIGHTS = 75
MAX_WICK_HIGHLIGHTS = 75
MAX_EXTENDED_BOXES = 75

DEFAULT_IMPLIED_DISPLACEMENT_MULTIPLIER = 1.25
DEFAULT_TRANSPARENCY = 80
DEFAULT_CUSTOM_THRESHOLD = 50.0

DEFAULT_MAX_VALID_SIFS = 30
DEFAULT_MAX_INVALIDATED_SIFS = 5
MAX_VALID_SIFS_LIMIT = 55
MAX_INVALIDATED_SIFS_LIMIT = 22

STRICT_INVALIDATION_PERCENT = 55.0
LENIENT_INVALIDATION_PERCENT = 85.0
MIN_THRESHOLD_PERCENT = 1.0
MAX_THRESHOLD_PERCENT = 99.0

DEFAULT_EXTENSION_BARS = 8
MAX_EXTENSION_BARS = 50
DEFAULT_EXTENSION_OFFSET = 2
DEFAULT_BORDER_OPACITY_1 = 50
DEFAULT_BORDER_OPACITY_2 = 15
DEFAULT_BORDER_OPACITY_3 = 80
DEFAULT_BORDER_OPACITY_4 = 30
DEFAULT_BORDER_OPACITY_5 = 65
MAX_PADDING_HORIZONTAL = 10
MAX_PADDING_VERTICAL = 5
DEFAULT_SOURCE_GAP_BOXES = 10
MAX_SOURCE_GAP_BOXES = 50
DEFAULT_IMPLIED_DISPLACEMENT_LOOKBACK_CANDLES = 4
DEFAULT_EXTENSION_FILL_OPACITY = 97

LABEL_ALIGNMENT_LEFT = 'Left'
LABEL_ALIGNMENT_CENTER = 'Center'
LABEL_ALIGNMENT_RIGHT = 'Right'
LABEL_VERTICAL_TOP = 'Top'
LABEL_VERTICAL_CENTER = 'Center'
LABEL_VERTICAL_BOTTOM = 'Bottom'

SIF_PLUS = "SIF⁺"
SIF_MINUS = "SIF⁻"
SIF_BULLISH_SUFFIX = "⁺"
SIF_BEARISH_SUFFIX = "⁻"
SIF_BASE_TEXT = "SIF"


// ═══════════════════════════════════════════════════════════════════════════════
// UI GROUP NAME CONSTANTS (SIF)
// ═══════════════════════════════════════════════════════════════════════════════
GROUP_LIVE_WORKSPACE = '🎤 Workspace Tools'
GROUP_DETECTION = '🎯 Detection'
GROUP_INVALIDATION = '✋ Invalidation'
GROUP_VISIBILITY_FILTERS = '👁️ Visibility Filters'
GROUP_SIF_EXTENSION = '✨ SIF Extension'
GROUP_GAP_SOURCES = '🎯 Gap Sources'
GROUP_BREAKAWAY_PROPERTIES = '🔥 Breakaway Properties'
GROUP_SOURCE_ORIGINS = '📦 Source Origins'

// Workspace Mode Constants (hardcoded values for live workspace)
WORKSPACE_EXTENSION_OFFSET = 2
WORKSPACE_ATR_MULTIPLIER = 3.5

GAP_SOURCE_FVG_BREAKDOWN_DISPLAY = "fvg"
GAP_SOURCE_IMPLIED_DISPLAY = "imp"
GAP_SOURCE_VOLUME_DISPLAY = "vol"
GAP_SOURCE_TRUE_DISPLAY = "gap"
GAP_SOURCE_RDRB_DISPLAY = "rdrb"
STATUS_DISPLAY_ALL = "all"
STATUS_DISPLAY_WS = "WS"
DEFAULT_STATUS_TABLE_OFFSET = 50

GAP_LABEL_FVG_BULLISH = "FVG⁺ for "
GAP_LABEL_FVG_BEARISH = "FVG⁻ for "
GAP_LABEL_IMPLIED_BULLISH = "Imp FVG⁺ for "
GAP_LABEL_IMPLIED_BEARISH = "Imp FVG⁻ for "
GAP_LABEL_VOLUME_BULLISH = "Vol Imb⁺ for "
GAP_LABEL_VOLUME_BEARISH = "Vol Imb⁻ for "
GAP_LABEL_TRUE_BULLISH = "True Gap⁺ for "
GAP_LABEL_TRUE_BEARISH = "True Gap⁻ for "
GAP_LABEL_RDRB_BULLISH = "RDRB⁺ for "
GAP_LABEL_RDRB_BEARISH = "RDRB⁻ for "

MULTIPLIER_SYMBOL = "×"
COUNT_SEPARATOR = ": "
BREAKDOWN_SEPARATOR = ", "

// ═══════════════════════════════════════════════════════════════════════════════
// EXTENSION LABEL STRUCTURE
// ═══════════════════════════════════════════════════════════════════════════════
//
// EXTENSION LABELS (on zone boxes):
// Format: [prefix] + SIF⁺/⁻ + [status] + newline + [source]
// Examples: "SIF⁺\nimp", "IMM-SIF⁻ [X]\nvol", "BRK-SIF⁺\nfvg"
// Order:   1. Optional prefix (IMM- for immediate, BRK- for breakaway)
//          2. Direction: SIF⁺ (bullish) or SIF⁻ (bearish)
//          3. Status indicator: [X] for invalidated (ALWAYS LAST on first line)
//          4. Source type on new line: imp, vol, gap, rdrb
//
// ═══════════════════════════════════════════════════════════════════════════════

EMPTY_DISPLAY = ""

// ═══════════════════════════════════════════════════════════════════════════════
// INPUT LABEL CONSTANTS (SIF)
// ═══════════════════════════════════════════════════════════════════════════════

// Detection labels
INPUT_LABEL_MAX_VALID_SIFS = 'Max Valid SIFs'
INPUT_LABEL_MAX_INVALIDATED_SIFS = 'Max'
INPUT_LABEL_SHOW_INVALIDATED_SIFS = 'Show Invalidated SIFs'
INPUT_LABEL_INVALIDATION_THRESHOLD = 'Threshold'
INPUT_LABEL_CUSTOM_PERCENT = 'Custom %'

// Extension labels
INPUT_LABEL_EXTENSION_MODE = 'Extension Mode'
INPUT_LABEL_EXTENSION_BARS = 'No. of Bars'

// Gap source labels
INPUT_LABEL_FAIR_VALUE_GAPS = 'Fair Value Gaps'
INPUT_LABEL_IMPLIED_FVGS = 'Implied FVGs'
INPUT_LABEL_VOLUME_IMBALANCES = 'Volume Imbalances'
INPUT_LABEL_TRUE_GAPS = 'True Gaps'

// Additional SIF-specific labels
INPUT_LABEL_LABEL = 'Label'
INPUT_LABEL_MAX_BOXES = 'Max Boxes'
INPUT_LABEL_ENABLE_GAPS = 'Enable Gaps'

// Default Colors
const color DEFAULT_GAP_COLOR = color.new(color.rgb(187, 217, 251), 90)
const color DEFAULT_SOURCE_GAP_TEXT_COLOR = color.new(color.rgb(156, 156, 156), 50)
const color DEFAULT_EXTENDED_BOX_BULLISH_COLOR = color.new(color.rgb(77, 208, 225), 90)
const color DEFAULT_EXTENDED_BOX_BEARISH_COLOR = color.new(color.rgb(249, 121, 246), 95)
const color DEFAULT_EXTENDED_BOX_TEXT_COLOR = color.new(color.rgb(99, 99, 99), 0)
const color DEFAULT_BREAKAWAY_BULLISH_COLOR = color.new(color.rgb(91, 156, 246), 75)
const color DEFAULT_BREAKAWAY_BEARISH_COLOR = color.new(color.rgb(247, 11, 241), 80)
const color DEFAULT_BREAKAWAY_BULLISH_BORDER_COLOR = color.new(color.rgb(77, 208, 225), 50)
const color DEFAULT_BREAKAWAY_BEARISH_BORDER_COLOR = color.new(color.rgb(249, 121, 246), 50)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUT SETTINGS - OPTIMIZED LAYOUT
// ═══════════════════════════════════════════════════════════════════════════════

// === 🎤 WORKSPACE TOOLS ===
workspace_mode_enabled = input.bool(false, 'Enable Workspace Mode', group=GROUP_LIVE_WORKSPACE, tooltip='Enables live workspace features:\n• Extends zones to current price\n• Filters zones beyond ATR distance')

// === 🎯 DETECTION ===
max_valid_sifs = input.int(DEFAULT_MAX_VALID_SIFS, INPUT_LABEL_MAX_VALID_SIFS, minval=0, maxval=MAX_VALID_SIFS_LIMIT, group=GROUP_DETECTION, inline='det1', tooltip='Maximum number of valid SIFs to display on chart. Max: 55\n\n• 0 = Show no valid SIFs\n• Higher values show more valid SIFs\n• Independent of invalidated SIF limit')
capacity_mode = input.string(CAPACITY_MODE_OPTIMIZED, "Capacity Mode", options=[CAPACITY_MODE_OPTIMIZED, CAPACITY_MODE_BOOST, CAPACITY_MODE_ULTRA_BOOST, CAPACITY_MODE_ULTRA_PRO_BOOST], group=GROUP_DETECTION, inline='det1', tooltip='Optimized: base limits and performance\nBoost: roughly 4× the base limits (clamped to indicator caps)\nUltra Boost: roughly 8× the base limits for deeper scans\nUltra Pro Boost: roughly 12× the base limits for the heaviest history loads')

// === ✋ INVALIDATION ===
show_invalidated_sifs = input.bool(false, INPUT_LABEL_SHOW_INVALIDATED_SIFS, group=GROUP_INVALIDATION, inline='inv1', tooltip='Show invalidated SIFs with [X] marker\n\n[X] appears after candle closes at invalidation threshold')
max_invalidated_sifs = input.int(DEFAULT_MAX_INVALIDATED_SIFS, INPUT_LABEL_MAX_INVALIDATED_SIFS, minval=0, maxval=MAX_INVALIDATED_SIFS_LIMIT, group=GROUP_INVALIDATION, inline='inv1', tooltip='Maximum number of invalidated SIFs to display when enabled. Max: 22\n\n• 0 = Show no invalidated SIFs\n• Independent of valid SIF limit')
sif_invalidation_mode = input.string(INVALIDATION_STRICT, INPUT_LABEL_INVALIDATION_THRESHOLD, options=[INVALIDATION_STRICT, INVALIDATION_LENIENT, INVALIDATION_CUSTOM], group=GROUP_INVALIDATION, inline='inv2', tooltip='Zone fill threshold for invalidation\nStrict: 55% fill (more sensitive, earlier invalidation)\nLenient: 85% fill (less sensitive, later invalidation)\nCustom: set your own percentage (1-99%)\n\n[X] shows after candle closes at threshold')
custom_threshold_percent = input.float(DEFAULT_CUSTOM_THRESHOLD, INPUT_LABEL_CUSTOM_PERCENT, minval=MIN_THRESHOLD_PERCENT, maxval=MAX_THRESHOLD_PERCENT, step=1.0, group=GROUP_INVALIDATION, inline='inv2', tooltip='Custom invalidation threshold (1-99%). Used only when Custom mode is selected.')

// === 👁️ VISIBILITY FILTERS ===
sif_direction_filter = input.string(SIF_DIRECTION_BOTH, 'Direction', options=[SIF_DIRECTION_BOTH, SIF_DIRECTION_BULLISH, SIF_DIRECTION_BEARISH], group=GROUP_VISIBILITY_FILTERS, inline='dir1', tooltip='Filter SIF display by direction:\n• Both: Show all SIFs\n• SIF⁺ Only: Show only bullish SIFs\n• SIF⁻ Only: Show only bearish SIFs')
sif_inversion_type_filter = input.string(SIF_INVERSION_TYPE_IMMEDIATE, 'Inversion Type', options=[SIF_INVERSION_TYPE_ALL, SIF_INVERSION_TYPE_IMMEDIATE, SIF_INVERSION_TYPE_REGULAR], group=GROUP_VISIBILITY_FILTERS, inline="filter1", tooltip='Filter SIFs by inversion type:\n• All: Show all SIFs\n• Immediate Only: Show only immediate SIF inversions (gap formation & closure on same candle)\n• Regular Only: Show only regular SIFs (multi-candle gap closures)')

// === 🎯 GAP SOURCES ===
enable_fair_value_gaps = input.bool(true, INPUT_LABEL_FAIR_VALUE_GAPS, group=GROUP_GAP_SOURCES, inline='sources1', tooltip='GAP SOURCES:\n• Fair Value Gaps: Standard 3-candle FVGs - the foundation of SIF detection\n• Implied FVGs: 3-candle institutional gaps with displacement validation')
fvg_type_filter = input.string(FVG_FILTER_ALL, "", options=[FVG_FILTER_ALL, FVG_FILTER_BREAKAWAY_ONLY, FVG_FILTER_STANDARD_ONLY], group=GROUP_GAP_SOURCES, inline='sources1', tooltip='FVG Detection Filter:\n• All: Detect all FVGs (both breakaway and standard)\n• Breakaway-Only: Only detect breakaway FVGs\n• Standard-Only: Only detect standard FVGs')
enable_implied = input.bool(false, INPUT_LABEL_IMPLIED_FVGS, group=GROUP_GAP_SOURCES, inline='sources2')
enable_volume_imbalance = input.bool(false, INPUT_LABEL_VOLUME_IMBALANCES, group=GROUP_GAP_SOURCES, inline='sources2', tooltip='GAP SOURCES (continued):\n• Volume Imbalances: 2-candle retail body gaps\n• True Gaps: Classic price gaps between candle ranges')
enable_true_gaps = input.bool(false, INPUT_LABEL_TRUE_GAPS, group=GROUP_GAP_SOURCES, inline='sources3')
enable_rdrb = input.bool(false, 'Rebalanced Redistributed Gaps', group=GROUP_GAP_SOURCES, inline='sources3', tooltip='Rebalanced Redistributed (RDRB):\n• Middle candle body sits fully inside the previous candle\'s wick\n• The next candle takes (breaks) that middle candle\'s high/low\n• The leftover portion inside the prior wick becomes the zone')

// === 📦 SOURCE ORIGINS ===
gap_color = input.color(DEFAULT_GAP_COLOR, 'Box', group=GROUP_SOURCE_ORIGINS, inline='gap1', tooltip='Source gap settings\nBox: color for gap boxes\nMax Boxes: maximum boxes to keep visible\nEnable Gaps: show boxes for gaps (FVG/Implied/VI) that created each SIF')
max_source_gap_boxes = input.int(DEFAULT_SOURCE_GAP_BOXES, INPUT_LABEL_MAX_BOXES, minval=1, maxval=MAX_SOURCE_GAP_BOXES, group=GROUP_SOURCE_ORIGINS, inline='gap1')
show_source_gap = input.bool(false, INPUT_LABEL_ENABLE_GAPS, group=GROUP_SOURCE_ORIGINS, inline='gap1', tooltip='Show boxes for the gaps (FVG/Implied/VI) that created each SIF')
source_gap_text_color = input.color(DEFAULT_SOURCE_GAP_TEXT_COLOR, INPUT_LABEL_LABEL, group=GROUP_SOURCE_ORIGINS, inline='gap2')

// === ✨ SIF EXTENSION ===
extended_box_bullish_color = input.color(DEFAULT_EXTENDED_BOX_BULLISH_COLOR, 'SIF⁺', group=GROUP_SIF_EXTENSION, inline='ext_colors', tooltip='Extension colors and enable/disable highlights and extensions\nSIF⁺: zone color\nSIF⁻: zone color\nEnable Extension: show highlights and extensions for valid SIFs')
extended_box_bearish_color = input.color(DEFAULT_EXTENDED_BOX_BEARISH_COLOR, 'SIF⁻', group=GROUP_SIF_EXTENSION, inline='ext_colors')
extended_box_length = input.int(DEFAULT_EXTENSION_BARS, INPUT_LABEL_EXTENSION_BARS, minval=1, maxval=MAX_EXTENSION_BARS, group=GROUP_SIF_EXTENSION, inline='ext_fixed', tooltip='Number of bars zones extend from formation (minimum width)')
extension_fill_opacity = input.int(DEFAULT_EXTENSION_FILL_OPACITY, 'Fill Opacity', minval=0, maxval=100, group=GROUP_SIF_EXTENSION, inline='ext_fixed', tooltip='Base opacity for extension box fill (0=solid, 100=invisible)')
extended_box_text_color = input.color(DEFAULT_EXTENDED_BOX_TEXT_COLOR, INPUT_LABEL_LABEL, group=GROUP_SIF_EXTENSION, inline='ext_props', tooltip='Text color for extension boxes')
extension_label_horizontal_alignment = input.string(LABEL_ALIGNMENT_CENTER, 'Horizontal', options=[LABEL_ALIGNMENT_LEFT, LABEL_ALIGNMENT_CENTER, LABEL_ALIGNMENT_RIGHT], group=GROUP_SIF_EXTENSION, inline='ext_align', tooltip='Horizontal alignment for extension box text')
extension_label_vertical_alignment = input.string(LABEL_VERTICAL_CENTER, 'Vertical', options=[LABEL_VERTICAL_TOP, LABEL_VERTICAL_CENTER, LABEL_VERTICAL_BOTTOM], group=GROUP_SIF_EXTENSION, inline='ext_align', tooltip='Vertical alignment for extension box text')
extension_label_horizontal_padding = input.int(1, 'Horizontal Padding', minval=0, maxval=MAX_PADDING_HORIZONTAL, group=GROUP_SIF_EXTENSION, inline='ext_padding', tooltip='Number of spaces for left/right padding (0-10)')
extension_label_vertical_padding = input.int(0, 'Vertical Padding', minval=0, maxval=MAX_PADDING_VERTICAL, group=GROUP_SIF_EXTENSION, inline='ext_padding', tooltip='Number of newlines for top/bottom padding (0-5)')

// === 🔥 BREAKAWAY PROPERTIES ===
mark_breakaway_sifs = input.bool(true, "Mark Breakaway SIFs", group=GROUP_BREAKAWAY_PROPERTIES, tooltip='Mark SIFs formed from breakaway FVGs with "BRK-" prefix and custom colors')
breakaway_bullish_color = input.color(DEFAULT_BREAKAWAY_BULLISH_COLOR, "SIF⁺", group=GROUP_BREAKAWAY_PROPERTIES, inline='breakaway2', tooltip='Extension box color for active bullish breakaway SIFs')
breakaway_bearish_color = input.color(DEFAULT_BREAKAWAY_BEARISH_COLOR, "SIF⁻", group=GROUP_BREAKAWAY_PROPERTIES, inline='breakaway2', tooltip='Extension box color for active bearish breakaway SIFs')
enable_breakaway_borders = input.bool(true, "Show Breakaway Borders", group=GROUP_BREAKAWAY_PROPERTIES, inline='breakaway3', tooltip='Display enhanced borders around breakaway SIFs for visual distinction')
breakaway_bullish_border_color = input.color(DEFAULT_BREAKAWAY_BULLISH_BORDER_COLOR, "SIF⁺", group=GROUP_BREAKAWAY_PROPERTIES, inline='breakaway4', tooltip='Border color for bullish breakaway SIF highlighting')
breakaway_bearish_border_color = input.color(DEFAULT_BREAKAWAY_BEARISH_BORDER_COLOR, "SIF⁻", group=GROUP_BREAKAWAY_PROPERTIES, inline='breakaway4', tooltip='Border color for bearish breakaway SIF highlighting')
breakaway_border_width = input.int(DEFAULT_BREAKAWAY_BORDER_WIDTH, "Width", minval=1, maxval=5, group=GROUP_BREAKAWAY_PROPERTIES, inline='breakaway4', tooltip='Border width for breakaway SIFs (1-5px limit)')

// === 📊 COLOR REFERENCE TABLE ===
show_color_table = input.bool(false, "Show Color Reference Table", group="📊 Color Reference", tooltip='Display a table showing all color RGB values and transparency used in the indicator')
show_status_table = input.bool(true, 'Show Status Table', group="📊 Color Reference", inline='status', tooltip='Show a compact status table at bottom center displaying current settings')
status_table_offset = input.int(DEFAULT_STATUS_TABLE_OFFSET, 'Offset', minval=-50, maxval=50, group="📊 Color Reference", inline='status', tooltip='Horizontal offset: negative = left, positive = right (-50 to 50)')

// === 🚨 ALERT SETTINGS ===
// Alerts fire automatically for all SIFs forming on current bar

// ═══════════════════════════════════════════════════════════════════════════════
// DATA STRUCTURES
// ═══════════════════════════════════════════════════════════════════════════════

// Effective capacity settings (Boost mode temporarily raises limits)
is_capacity_boost = capacity_mode == CAPACITY_MODE_BOOST
is_capacity_ultra_boost = capacity_mode == CAPACITY_MODE_ULTRA_BOOST
is_capacity_ultra_pro_boost = capacity_mode == CAPACITY_MODE_ULTRA_PRO_BOOST

// Base (Optimized)
base_valid_sifs = max_valid_sifs
base_invalidated_sifs = max_invalidated_sifs
base_records = MAX_SIF_RECORDS                // 60
base_active_gaps = MAX_ACTIVE_GAPS            // 100
base_extended_boxes = MAX_EXTENDED_BOXES      // 75
base_body_highlights = MAX_BODY_HIGHLIGHTS    // 75
base_wick_highlights = MAX_WICK_HIGHLIGHTS    // 75
base_source_gap_boxes = max_source_gap_boxes  // input-bound (1..50)

// Boost, Ultra & Ultra Pro multipliers applied to base limits (clamped to platform caps where needed)
boost_valid_sifs = int(math.max(base_valid_sifs, math.round(base_valid_sifs * BOOST_MULTIPLIER)))
boost_records = int(math.max(base_records, math.round(base_records * BOOST_MULTIPLIER)))
boost_active_gaps = int(math.max(base_active_gaps, math.round(base_active_gaps * BOOST_MULTIPLIER)))
boost_extended_boxes = int(math.min(INDICATOR_MAX_BOXES, math.max(base_extended_boxes, math.round(base_extended_boxes * BOOST_MULTIPLIER))))
boost_body_highlights = int(math.min(INDICATOR_MAX_BOXES, math.max(base_body_highlights, math.round(base_body_highlights * BOOST_MULTIPLIER))))
boost_wick_highlights = int(math.min(INDICATOR_MAX_BOXES, math.max(base_wick_highlights, math.round(base_wick_highlights * BOOST_MULTIPLIER))))
boost_source_gap_boxes = int(math.min(INDICATOR_MAX_BOXES, math.max(base_source_gap_boxes, math.round(base_source_gap_boxes * BOOST_MULTIPLIER))))

ultra_valid_sifs = int(math.max(base_valid_sifs, math.round(base_valid_sifs * ULTRA_BOOST_MULTIPLIER)))
ultra_records = int(math.max(base_records, math.round(base_records * ULTRA_BOOST_MULTIPLIER)))
ultra_active_gaps = int(math.max(base_active_gaps, math.round(base_active_gaps * ULTRA_BOOST_MULTIPLIER)))
ultra_extended_boxes = int(math.min(INDICATOR_MAX_BOXES, math.max(base_extended_boxes, math.round(base_extended_boxes * ULTRA_BOOST_MULTIPLIER))))
ultra_body_highlights = int(math.min(INDICATOR_MAX_BOXES, math.max(base_body_highlights, math.round(base_body_highlights * ULTRA_BOOST_MULTIPLIER))))
ultra_wick_highlights = int(math.min(INDICATOR_MAX_BOXES, math.max(base_wick_highlights, math.round(base_wick_highlights * ULTRA_BOOST_MULTIPLIER))))
ultra_source_gap_boxes = int(math.min(INDICATOR_MAX_BOXES, math.max(base_source_gap_boxes, math.round(base_source_gap_boxes * ULTRA_BOOST_MULTIPLIER))))

ultra_pro_valid_sifs = int(math.max(base_valid_sifs, math.round(base_valid_sifs * ULTRA_PRO_BOOST_MULTIPLIER)))
ultra_pro_records = int(math.max(base_records, math.round(base_records * ULTRA_PRO_BOOST_MULTIPLIER)))
ultra_pro_active_gaps = int(math.max(base_active_gaps, math.round(base_active_gaps * ULTRA_PRO_BOOST_MULTIPLIER)))
ultra_pro_extended_boxes = int(math.min(INDICATOR_MAX_BOXES, math.max(base_extended_boxes, math.round(base_extended_boxes * ULTRA_PRO_BOOST_MULTIPLIER))))
ultra_pro_body_highlights = int(math.min(INDICATOR_MAX_BOXES, math.max(base_body_highlights, math.round(base_body_highlights * ULTRA_PRO_BOOST_MULTIPLIER))))
ultra_pro_wick_highlights = int(math.min(INDICATOR_MAX_BOXES, math.max(base_wick_highlights, math.round(base_wick_highlights * ULTRA_PRO_BOOST_MULTIPLIER))))
ultra_pro_source_gap_boxes = int(math.min(INDICATOR_MAX_BOXES, math.max(base_source_gap_boxes, math.round(base_source_gap_boxes * ULTRA_PRO_BOOST_MULTIPLIER))))

// Effective selections
max_valid_sifs_effective = is_capacity_ultra_pro_boost ? ultra_pro_valid_sifs : is_capacity_ultra_boost ? ultra_valid_sifs : is_capacity_boost ? boost_valid_sifs : base_valid_sifs
max_invalidated_sifs_effective = base_invalidated_sifs  // unchanged in Boost/Ultra
max_sif_records_effective = is_capacity_ultra_pro_boost ? ultra_pro_records : is_capacity_ultra_boost ? ultra_records : is_capacity_boost ? boost_records : base_records
max_active_gaps_effective = is_capacity_ultra_pro_boost ? ultra_pro_active_gaps : is_capacity_ultra_boost ? ultra_active_gaps : is_capacity_boost ? boost_active_gaps : base_active_gaps
max_extended_boxes_effective = is_capacity_ultra_pro_boost ? ultra_pro_extended_boxes : is_capacity_ultra_boost ? ultra_extended_boxes : is_capacity_boost ? boost_extended_boxes : base_extended_boxes
max_body_highlights_effective = is_capacity_ultra_pro_boost ? ultra_pro_body_highlights : is_capacity_ultra_boost ? ultra_body_highlights : is_capacity_boost ? boost_body_highlights : base_body_highlights
max_wick_highlights_effective = is_capacity_ultra_pro_boost ? ultra_pro_wick_highlights : is_capacity_ultra_boost ? ultra_wick_highlights : is_capacity_boost ? boost_wick_highlights : base_wick_highlights
max_source_gap_boxes_effective = is_capacity_ultra_pro_boost ? math.max(base_source_gap_boxes, ultra_pro_source_gap_boxes) : is_capacity_ultra_boost ? math.max(base_source_gap_boxes, ultra_source_gap_boxes) : is_capacity_boost ? math.max(base_source_gap_boxes, boost_source_gap_boxes) : base_source_gap_boxes

// ═══════════════════════════════════════════════════════════════════════════════
// LIVE EXTENSION HELPERS
// ═══════════════════════════════════════════════════════════════════════════════

EXTENSION_HASH_PRIME = 13

// Get unique offset for zone staggering (prevents overlapping zones from blending)
get_extension_offset(int zone_bar_index, float zone_top, int offset_setting) =>
    zone_price_hash = int(zone_top * 100)
    offset_index = (zone_bar_index + zone_price_hash) % EXTENSION_HASH_PRIME
    offset_index * math.max(1, int(offset_setting / 2))

// Get cycling border transparency for visual distinction
get_border_transparency(int zone_bar_index) =>
    border_index = zone_bar_index % 5
    switch border_index
        0 => DEFAULT_BORDER_OPACITY_1
        1 => DEFAULT_BORDER_OPACITY_2
        2 => DEFAULT_BORDER_OPACITY_3
        3 => DEFAULT_BORDER_OPACITY_4
        => DEFAULT_BORDER_OPACITY_5

type SIFCandidate
    int bar_index
    float body_top
    float body_bottom
    bool is_bullish

type GapData
    int bar_index
    float top
    float bottom
    bool is_bullish
    bool is_inverted
    int creation_bar
    SIFCandidate first_tapper
    int gap_id
    string gap_type
    bool is_breakaway_gap    // True if gap breaks above/below trend range

// Simplified SIFRecord
type SIFRecord
    int bar_index
    float sif_open
    float sif_close
    float sif_high
    float sif_low
    bool is_bullish
    bool is_invalidated
    float max_fill_percentage
    bool has_dominant_wick
    string sif_subtype
    float cached_zone_top
    float cached_zone_bottom
    bool cached_data_valid
    label sif_label
    int source_gap_id
    // Cached source gap geometry to decouple from active_gaps retention
    int source_gap_bar_index
    float source_gap_top
    float source_gap_bottom
    string source_gap_type
    bool is_immediate_sif_inversion    // true if formation candle also closes the gap
    bool is_breakaway_sif

// Consolidated SIF group type
type ConsolidatedSIF
    array<SIFRecord> sif_group
    int bar_index
    bool is_bullish
    float consolidated_zone_top
    float consolidated_zone_bottom
    bool is_consolidated_invalidated
    string consolidated_extension_label

// Cached counts for multi-source evaluation
type SourceTypeStats
    int group_size
    int distinct_types
    int fvg_count
    int imp_count
    int vol_count
    int true_count
    int rdrb_count

// Cache of consolidated groups from last visual render (for stars reuse)
var array<ConsolidatedSIF> last_consolidated_sifs = array.new<ConsolidatedSIF>()

// Global State
var array<GapData> active_gaps = array.new<GapData>()
var array<SIFRecord> all_sif_records = array.new<SIFRecord>()
var int next_gap_id = 1

// Visual Elements
var array<box> source_gap_boxes = array.new_box()
var array<box> sif_body_highlights = array.new_box()
var array<box> sif_wick_highlights = array.new_box()
var array<box> sif_extended_boxes = array.new_box()
var array<int> displayed_sif_indices = array.new<int>()

var bool needs_visual_update = true
var int last_update_bar = na
var bool needs_full_update = true

// ATR Distance Filter calculation (fixed 14-period ATR)
atr_value = ta.atr(14)
atr_max_distance = atr_value * WORKSPACE_ATR_MULTIPLIER

// Pre-calculated padding strings (performance optimization)
horizontal_padding_str = ""
for i = 0 to extension_label_horizontal_padding - 1
    horizontal_padding_str := horizontal_padding_str + " "

vertical_padding_str = ""
for i = 0 to extension_label_vertical_padding - 1
    vertical_padding_str := vertical_padding_str + "\n"

// ═══════════════════════════════════════════════════════════════════════════════
// UTILITY FUNCTIONS - DEFINED EARLY FOR DEPENDENCIES
// ═══════════════════════════════════════════════════════════════════════════════

// Gap Detection Functions with Coordinate Validation
// CRITICAL: These functions detect gaps but coordinates must be assigned carefully in gap creation

// @function is_bullish_fvg
// @description Detects bullish Fair Value Gap pattern (3-candle upward gap)
// @returns bool True if C0.low > C2.high (upward gap exists)
is_bullish_fvg() => low > high[2]

// @function is_bearish_fvg
// @description Detects bearish Fair Value Gap pattern (3-candle downward gap)
// @returns bool True if C0.high < C2.low (downward gap exists)
is_bearish_fvg() => high < low[2]

// Volume Imbalance Detection (2-candle body gap with wick connection)
is_bullish_vi() =>
    bodies_separated = math.min(open, close) > math.max(open[1], close[1])
    wicks_still_connect = low <= high[1]  // Current low reaches previous high
    bodies_separated and wicks_still_connect

is_bearish_vi() =>
    bodies_separated = math.max(open, close) < math.min(open[1], close[1])
    wicks_still_connect = high >= low[1]  // Current high reaches previous low
    bodies_separated and wicks_still_connect

// True Gap Detection (2-candle structure) with Coordinate Validation
// @function is_bullish_true_gap
// @description Detects bullish True Gap (2-candle upward price gap)
// @returns bool True if C1.high < C0.low (classic upward gap)
is_bullish_true_gap() => high[1] < low

// @function is_bearish_true_gap
// @description Detects bearish True Gap (2-candle downward price gap)
// @returns bool True if C1.low > C0.high (classic downward gap)
is_bearish_true_gap() => low[1] > high

// True Gap coordinates
get_true_gap_coordinates(is_bullish_gap) =>
    if is_bullish_gap
        // Bullish gap: between previous high and current low
        [low, high[1]]
    else
        // Bearish gap: between previous low and current high
        [low[1], high]

// Gap priority hierarchy (lower number = higher priority) - MUST BE DEFINED FIRST
get_gap_priority(gap_type) =>
    switch gap_type
        GAP_TYPE_FVG => 1        // Highest priority
        GAP_TYPE_IMPLIED => 2
        GAP_TYPE_RDRB => 3
        GAP_TYPE_TRUE => 4
        GAP_TYPE_VOLUME => 5     // Lowest priority
        => 5

// @function is_gap_overlapping
// @description Determines if a new gap should be suppressed by existing gaps using MBZ-style hierarchy enforcement (FVG > Implied > True > VI). Replaces dangerous 80% overlap threshold with targeted institutional priority system.
// @param new_top Upper boundary of new gap
// @param new_bottom Lower boundary of new gap
// @param new_is_bullish Direction of new gap (true = bullish, false = bearish)
// @param new_gap_type Gap classification (GAP_TYPE_FVG, GAP_TYPE_IMPLIED, GAP_TYPE_TRUE, GAP_TYPE_VOLUME)
// @param existing_gaps Array of existing GapData objects to check against
// @returns bool True if new gap should be suppressed, false if should be added
is_gap_overlapping(new_top, new_bottom, new_is_bullish, new_gap_type, existing_gaps) =>
    if array.size(existing_gaps) == 0
        false
    else
        should_suppress = false

        for i = 0 to array.size(existing_gaps) - 1
            existing_gap = array.get(existing_gaps, i)

            // MBZ-style targeted suppression - only same direction gaps with hierarchy enforcement
            if existing_gap.is_bullish == new_is_bullish and not existing_gap.is_inverted
                // Spatial overlap check: new_bottom < existing_top AND new_top >= existing_bottom
                if new_bottom < existing_gap.top and new_top >= existing_gap.bottom
                    // Apply hierarchy rules instead of percentage thresholds
                    can_suppress = false

                    if new_gap_type == GAP_TYPE_VOLUME  // VI can be suppressed by FVG, Implied, True, RDRB
                        can_suppress := (existing_gap.gap_type == GAP_TYPE_FVG or existing_gap.gap_type == GAP_TYPE_IMPLIED or existing_gap.gap_type == GAP_TYPE_TRUE or existing_gap.gap_type == GAP_TYPE_RDRB)
                    else if new_gap_type == GAP_TYPE_TRUE  // True Gap can be suppressed by FVG, Implied, RDRB
                        can_suppress := (existing_gap.gap_type == GAP_TYPE_FVG or existing_gap.gap_type == GAP_TYPE_IMPLIED or existing_gap.gap_type == GAP_TYPE_RDRB)
                    else if new_gap_type == GAP_TYPE_RDRB  // RDRB can be suppressed by FVG, Implied
                        can_suppress := (existing_gap.gap_type == GAP_TYPE_FVG or existing_gap.gap_type == GAP_TYPE_IMPLIED)
                    // FVG and Implied are never suppressed (institutional priority)

                    if can_suppress
                        should_suppress := true
                        break

        should_suppress

// Body helpers
bodyTop(o, c) => math.max(o, c)
bodyBot(o, c) => math.min(o, c)

// Convert string alignment selections into Pine text alignment enums
get_horizontal_alignment(alignment_setting) =>
    alignment_setting == LABEL_ALIGNMENT_LEFT ? text.align_left : alignment_setting == LABEL_ALIGNMENT_RIGHT ? text.align_right : text.align_center

get_vertical_alignment(alignment_setting) =>
    alignment_setting == LABEL_VERTICAL_TOP ? text.align_top : alignment_setting == LABEL_VERTICAL_BOTTOM ? text.align_bottom : text.align_center

get_extension_label_halign() => get_horizontal_alignment(extension_label_horizontal_alignment)

get_extension_label_valign() => get_vertical_alignment(extension_label_vertical_alignment)

// Function to check if consolidated SIF has immediate inversion
has_immediate_sif_inversion(consolidated_sif) =>
    has_inversion = false
    for i = 0 to array.size(consolidated_sif.sif_group) - 1
        sif_record = array.get(consolidated_sif.sif_group, i)
        if sif_record.is_immediate_sif_inversion
            has_inversion := true
            break
    has_inversion

get_border_properties_for_sif(consolidated_sif, sif_source_count) =>
    // Check if any SIF in group is a breakaway SIF (for custom borders)
    is_breakaway_group = false
    if enable_breakaway_borders and not consolidated_sif.is_consolidated_invalidated
        for i = 0 to array.size(consolidated_sif.sif_group) - 1
            sif_record = array.get(consolidated_sif.sif_group, i)
            if sif_record.is_breakaway_sif
                is_breakaway_group := true
                break

    // Get default border color (same as extension box by default)
    default_border_color = consolidated_sif.is_bullish ? extended_box_bullish_color : extended_box_bearish_color

    // Determine final border properties (priority: breakaway > default)
    border_width_final = is_breakaway_group ? breakaway_border_width : 1
    border_color_final = is_breakaway_group ? (consolidated_sif.is_bullish ? breakaway_bullish_border_color : breakaway_bearish_border_color) : default_border_color

    [border_width_final, border_color_final]

// === VISUAL SUPPORT FUNCTIONS (8 functions) ===
// Line style conversion
get_line_style(style_string) =>
    switch style_string
        'Solid' => line.style_solid
        'Dashed' => line.style_dashed
        'Dotted' => line.style_dotted
        => line.style_solid

// Get invalidation threshold percentage
get_sif_invalidation_threshold() =>
    switch sif_invalidation_mode
        INVALIDATION_STRICT => STRICT_INVALIDATION_PERCENT
        INVALIDATION_LENIENT => LENIENT_INVALIDATION_PERCENT
        INVALIDATION_CUSTOM => custom_threshold_percent

// Calculate zone penetration percentage using close price (for invalidation)
calculate_zone_penetration_from_close(close_price, zone_top, zone_bottom, is_bullish_zone) =>
    zone_range = zone_top - zone_bottom
    if zone_range <= 0
        0.0
    else
        if is_bullish_zone
            // Bullish zone: penetration is from top downward
            if close_price >= zone_top
                0.0  // No penetration
            else if close_price <= zone_bottom
                100.0  // Full penetration
            else
                penetration_distance = zone_top - close_price
                (penetration_distance / zone_range) * 100.0
        else
            // Bearish zone: penetration is from bottom upward
            if close_price <= zone_bottom
                0.0  // No penetration
            else if close_price >= zone_top
                100.0  // Full penetration
            else
                penetration_distance = close_price - zone_bottom
                (penetration_distance / zone_range) * 100.0

// Zone calculation based on subtype
get_subtype_zone(sif_record) =>
    sif_subtype_contains_inclusion = str.contains(sif_record.sif_subtype, SUBTYPE_INCLUSION)
    sif_subtype_contains_reflection = str.contains(sif_record.sif_subtype, SUBTYPE_REFLECTION)

    if sif_subtype_contains_inclusion
        if sif_record.is_bullish
            [sif_record.sif_close, sif_record.sif_low]
        else
            [sif_record.sif_high, sif_record.sif_close]
    else if sif_subtype_contains_reflection
        if sif_record.is_bullish
            wick_range = math.abs(sif_record.sif_high - sif_record.sif_open)
            [sif_record.sif_close, sif_record.sif_close - wick_range]
        else
            wick_range = math.abs(sif_record.sif_low - sif_record.sif_open)
            [sif_record.sif_close + wick_range, sif_record.sif_close]
    else
        body_top = math.max(sif_record.sif_open, sif_record.sif_close)
        body_bottom = math.min(sif_record.sif_open, sif_record.sif_close)
        [body_top, body_bottom]

// Enhanced invalidation: Check BOTH open and close for gaps and penetration
should_sif_be_invalidated_enhanced(sif_record, current_open, current_close) =>
    invalidation_threshold = get_sif_invalidation_threshold()

    // Get the SAME zone that visuals use
    [zone_top, zone_bottom] = get_subtype_zone(sif_record)

    // CRITICAL: Check for OPENING GAPS first (immediate invalidation)
    if sif_record.is_bullish
        // SIF⁺: If candle opens BELOW zone bottom = instant invalidation
        if current_open < zone_bottom
            true  // GAPPED BELOW - IMMEDIATE INVALIDATION
        else
            // No gap - check close penetration normally
            penetration_percentage = calculate_zone_penetration_from_close(current_close, zone_top, zone_bottom, sif_record.is_bullish)
            penetration_percentage >= invalidation_threshold
    else
        // SIF⁻: If candle opens ABOVE zone top = instant invalidation
        if current_open > zone_top
            true  // GAPPED ABOVE - IMMEDIATE INVALIDATION
        else
            // No gap - check close penetration normally
            penetration_percentage = calculate_zone_penetration_from_close(current_close, zone_top, zone_bottom, sif_record.is_bullish)
            penetration_percentage >= invalidation_threshold

should_sif_be_invalidated(sif_record, confirmed_close_price) =>
    should_sif_be_invalidated_enhanced(sif_record, open, confirmed_close_price)


// ═══════════════════════════════════════════════════════════════════════════════
// Volume Imbalance gap coordinates for 2-candle structure
get_vi_coordinates(is_bullish_gap) =>
    if is_bullish_gap
        // Bullish VI: gap between C1 body top and C2 body bottom
        gap_bottom = math.max(open[1], close[1])  // C1 body top
        gap_top = math.min(open, close)           // C2 body bottom
        [gap_top, gap_bottom]
    else
        // Bearish VI: gap between C1 body bottom and C2 body top
        gap_top = math.min(open[1], close[1])     // C1 body bottom
        gap_bottom = math.max(open, close)        // C2 body top
        [gap_top, gap_bottom]

// Volume Imbalance Edge Case - Use >= for boundary overlap
is_vi_suppressed_by_gaps(vi_top, vi_bottom, is_vi_bullish) =>
    if array.size(active_gaps) == 0
        false
    else
        has_overlap = false
        for i = 0 to array.size(active_gaps) - 1
            gap = array.get(active_gaps, i)

            // Check for both regular FVGs AND implied FVGs (not volume) - institutional gap hierarchy
            if (gap.gap_type == GAP_TYPE_FVG or gap.gap_type == GAP_TYPE_IMPLIED) and gap.is_bullish == is_vi_bullish and not gap.is_inverted
                // Use >= for edge case where VI exactly touches gap boundary
                if vi_bottom < gap.top and vi_top >= gap.bottom
                    has_overlap := true
                    break  // Found overlap, VI will be suppressed
        has_overlap

// Check if True Gap overlaps with existing VI gaps (prevent double detection)
is_true_gap_suppressed_by_vi_gaps(tg_top, tg_bottom, is_tg_bullish) =>
    if array.size(active_gaps) == 0
        false
    else
        has_overlap = false
        for i = 0 to array.size(active_gaps) - 1
            gap = array.get(active_gaps, i)

            // Check for VI gaps with same direction (prevent double detection)
            if gap.gap_type == GAP_TYPE_VOLUME and gap.is_bullish == is_tg_bullish
                if tg_bottom >= gap.bottom and tg_top <= gap.top
                    has_overlap := true
                    break  // Found overlap, True Gap will be suppressed
        has_overlap

// Displacement validation
is_displacement_candle() =>
    c2_body_size = math.abs(close[1] - open[1])
    total_body_size = 0.0
    for i = 2 to (1 + DEFAULT_IMPLIED_DISPLACEMENT_LOOKBACK_CANDLES)
        total_body_size += math.abs(close[i] - open[i])
    average_body_size = total_body_size / DEFAULT_IMPLIED_DISPLACEMENT_LOOKBACK_CANDLES

    if average_body_size > 0
        c2_body_size >= (DEFAULT_IMPLIED_DISPLACEMENT_MULTIPLIER * average_body_size)
    else
        false

// Implied FVG Detection
// Returns: [found, bottom, top, is_bullish]
detect_implied_fvg() =>
    has_bullish_fvg = is_bullish_fvg()
    has_bearish_fvg = is_bearish_fvg()

    if not is_displacement_candle()
        [false, float(na), float(na), bool(na)]
    else
        result_found = false
        result_bottom = float(na)
        result_top = float(na)
        result_bullish = bool(na)

        // Bullish IFVG Detection
        if not has_bullish_fvg and not result_found
            c1_body_top = bodyTop(open[2], close[2])
            c3_body_bottom = bodyBot(open, close)
            bullish_wicks_present = (high[2] > c1_body_top) and (c3_body_bottom > low)

            if bullish_wicks_present
                overlap_low = math.max(c1_body_top, low)
                overlap_high = math.min(high[2], c3_body_bottom)
                has_bullish_overlap = overlap_high > overlap_low

                if has_bullish_overlap and c1_body_top < c3_body_bottom
                    result_found := true
                    result_bottom := c1_body_top
                    result_top := c3_body_bottom
                    result_bullish := true

        // Bearish IFVG Detection
        if not has_bearish_fvg and not result_found
            c1_body_bottom = bodyBot(open[2], close[2])
            c3_body_top = bodyTop(open, close)
            bearish_wicks_present = (c1_body_bottom > low[2]) and (high > c3_body_top)

            if bearish_wicks_present
                overlap_low = math.max(low[2], c3_body_top)
                overlap_high = math.min(c1_body_bottom, high)
                has_bearish_overlap = overlap_high > overlap_low

                if has_bearish_overlap and c3_body_top < c1_body_bottom
                    result_found := true
                    result_bottom := c3_body_top
                    result_top := c1_body_bottom
                    result_bullish := false

        [result_found, result_bottom, result_top, result_bullish]

// RDRB Detection (3-candle): returns [found, bottom, top, is_bullish]
detect_rdrb_gap() =>
    // Initialize
    pattern_found = false
    zone_bottom = float(na)
    zone_top = float(na)
    is_rdrb_bullish = bool(na)

    min_tick = syminfo.mintick

    // Predeclare reused locals to avoid shadowing; reassign with := below
    c2_body_top = float(na)
    c2_body_bottom = float(na)
    c2_within_c1_wick = false
    c3_body_top = float(na)
    c3_body_bottom = float(na)
    remaining_zone_bottom = float(na)
    remaining_zone_top = float(na)
    intersection_bottom = float(na)
    intersection_top = float(na)
    anchored_top = false
    anchored_bottom = false
    valid_remaining = true

    // Bullish RDRB
    c1_body_top = bodyTop(open[2], close[2])
    c1_upper_wick_exists = high[2] > c1_body_top
    c2_body_top := bodyTop(open[1], close[1])
    c2_body_bottom := bodyBot(open[1], close[1])
    c2_within_c1_wick := (c2_body_bottom >= c1_body_top) and (c2_body_top <= high[2])
    c3_takes_c2_high = high > high[1]

    if c1_upper_wick_exists and c2_within_c1_wick and c3_takes_c2_high and not pattern_found
        // Remaining zone after subtracting C3 body, clipped to C1 upper wick
        c3_body_top := bodyTop(open, close)
        c3_body_bottom := bodyBot(open, close)

        remaining_zone_bottom := math.max(c2_body_bottom, c1_body_top)
        remaining_zone_top := math.min(c2_body_top, high[2])

        // Overlap with C3 body
        intersection_bottom := math.max(remaining_zone_bottom, c3_body_bottom)
        intersection_top := math.min(remaining_zone_top, c3_body_top)
        has_overlap = intersection_bottom < intersection_top

        anchored_top := has_overlap and intersection_top >= remaining_zone_top - min_tick
        anchored_bottom := has_overlap and intersection_bottom <= remaining_zone_bottom + min_tick

        valid_remaining := true
        if has_overlap
            if anchored_top and not anchored_bottom
                remaining_zone_top := intersection_bottom
            else if anchored_bottom and not anchored_top
                remaining_zone_bottom := intersection_top
            else
                valid_remaining := false

        if valid_remaining and remaining_zone_top > remaining_zone_bottom + min_tick
            pattern_found := true
            zone_bottom := remaining_zone_bottom
            zone_top := remaining_zone_top
            is_rdrb_bullish := true

    // Bearish RDRB
    if not pattern_found
        c1_body_bottom = bodyBot(open[2], close[2])
        c1_lower_wick_exists = low[2] < c1_body_bottom
        c2_body_top := bodyTop(open[1], close[1])
        c2_body_bottom := bodyBot(open[1], close[1])
        c2_within_c1_wick := (c2_body_top <= c1_body_bottom) and (c2_body_bottom >= low[2])
        c3_takes_c2_low = low < low[1]

        if c1_lower_wick_exists and c2_within_c1_wick and c3_takes_c2_low
            c3_body_top := bodyTop(open, close)
            c3_body_bottom := bodyBot(open, close)

            remaining_zone_bottom := math.max(c2_body_bottom, low[2])
            remaining_zone_top := math.min(c2_body_top, c1_body_bottom)

            intersection_bottom := math.max(remaining_zone_bottom, c3_body_bottom)
            intersection_top := math.min(remaining_zone_top, c3_body_top)
            has_overlap = intersection_bottom < intersection_top

            anchored_top := has_overlap and intersection_top >= remaining_zone_top - min_tick
            anchored_bottom := has_overlap and intersection_bottom <= remaining_zone_bottom + min_tick

            valid_remaining := true
            if has_overlap
                if anchored_top and not anchored_bottom
                    remaining_zone_top := intersection_bottom
                else if anchored_bottom and not anchored_top
                    remaining_zone_bottom := intersection_top
                else
                    valid_remaining := false

            if valid_remaining and remaining_zone_top > remaining_zone_bottom + min_tick
                pattern_found := true
                zone_bottom := remaining_zone_bottom
                zone_top := remaining_zone_top
                is_rdrb_bullish := false

    [pattern_found, zone_bottom, zone_top, is_rdrb_bullish]

// ═══════════════════════════════════════════════════════════════════════════════
// GAP SOURCE DISPLAY MAPPING
// ═══════════════════════════════════════════════════════════════════════════════

// Get display name for gap source (lowercase for labels)
get_gap_source_display(gap_type) =>
    switch gap_type
        GAP_TYPE_FVG => GAP_SOURCE_FVG_BREAKDOWN_DISPLAY  // FVG abbreviation for breakdown
        GAP_TYPE_IMPLIED => GAP_SOURCE_IMPLIED_DISPLAY
        GAP_TYPE_VOLUME => GAP_SOURCE_VOLUME_DISPLAY
        GAP_TYPE_TRUE => GAP_SOURCE_TRUE_DISPLAY
        GAP_TYPE_RDRB => GAP_SOURCE_RDRB_DISPLAY
        => EMPTY_DISPLAY

// ═══════════════════════════════════════════════════════════════════════════════
// ADVANCED SIF ANALYSIS
// ═══════════════════════════════════════════════════════════════════════════════

// Wick dominance classification - determines if candle has dominant wick for inclusion/reflection detection
classify_wick_dominance(body_size, upper_wick, lower_wick) =>
    if body_size <= 0
        [WICK_TIER_NONE, false]
    else
        upper_ratio = upper_wick / body_size
        lower_ratio = lower_wick / body_size
        max_ratio = math.max(upper_ratio, lower_ratio)

        if max_ratio >= WICK_DOMINANCE_STANDARD_THRESHOLD
            [WICK_TIER_STANDARD, true]
        else if max_ratio >= WICK_DOMINANCE_RELAXED_THRESHOLD
            [WICK_TIER_RELAXED, true]
        else if max_ratio >= WICK_DOMINANCE_RISKY_THRESHOLD
            [WICK_TIER_RISKY, true]
        else
            [WICK_TIER_NONE, false]

// ENHANCED: Advanced SIF subtype detection with simple majority wick classification
// Uses clear majority rule: biggest wick wins, no tie-breaking complexity
detect_sif_subtype(sif_open, sif_close, sif_high, sif_low, source_gap_type) =>
    body_top = math.max(sif_open, sif_close)
    body_bottom = math.min(sif_open, sif_close)
    body_size = body_top - body_bottom
    upper_wick = sif_high - body_top
    lower_wick = body_bottom - sif_low
    is_candle_bullish = sif_close > sif_open

    // Determine base classification from source type
    base_classification = SUBTYPE_STANDARD
    if source_gap_type == GAP_TYPE_IMPLIED and enable_implied
        base_classification := SUBTYPE_IMPLIED
    else if source_gap_type == GAP_TYPE_VOLUME and enable_volume_imbalance
        base_classification := SUBTYPE_VOLUME
    else if source_gap_type == GAP_TYPE_TRUE and enable_true_gaps
        base_classification := SUBTYPE_TRUE
    else if source_gap_type == GAP_TYPE_RDRB and enable_rdrb
        base_classification := SUBTYPE_RDRB

    // Check wick dominance
    [wick_tier, has_dominant] = classify_wick_dominance(body_size, upper_wick, lower_wick)

    if not has_dominant
        [base_classification, false]
    else
        // SIMPLE MAJORITY RULE: Biggest wick wins, exact ties favor inclusion patterns
        is_exact_tie = upper_wick == lower_wick
        upper_is_dominant = false  // Declare variable first

        if is_exact_tie
            // TIE-BREAKING LOGIC: When upper_wick == lower_wick (exact tie)
            // Design decision: All ties result in INCLUSION patterns for consistency
            // - Bullish ties: Force lower wick dominance → inclusion pattern → "inc-tie"
            // - Bearish ties: Force upper wick dominance → inclusion pattern → "inc-tie"
            // This ensures predictable, uniform behavior regardless of candle direction
            upper_is_dominant := not is_candle_bullish  // Bullish ties→lower dominant, Bearish ties→upper dominant
        else
            // CLEAR DOMINANCE: Standard comparison when wicks are different sizes
            upper_is_dominant := upper_wick > lower_wick

        // Determine wick pattern using simple majority
        wick_pattern = ""

        // SIMPLE MAJORITY CLASSIFICATION: Clear, predictable wick-based subtyping
        // Note: Due to tie-breaking logic above, ties can ONLY result in inclusion patterns
        // - Bullish ties: upper_is_dominant=false → takes inclusion path → "inc-tie"
        // - Bearish ties: upper_is_dominant=true → takes inclusion path → "inc-tie"
        // Therefore, "reflection-tie" is impossible and was removed as dead code

        if is_candle_bullish
            if upper_is_dominant
                // Bullish + upper wick dominance = reflection (clear dominance only, never ties)
                wick_pattern := SUBTYPE_REFLECTION
            else
                // Bullish + lower wick dominance = inclusion (clear dominance OR ties)
                wick_pattern := is_exact_tie ? SUBTYPE_INCLUSION_TIE : SUBTYPE_INCLUSION
        else
            if upper_is_dominant
                // Bearish + upper wick dominance = inclusion (clear dominance OR ties)
                wick_pattern := is_exact_tie ? SUBTYPE_INCLUSION_TIE : SUBTYPE_INCLUSION
            else
                // Bearish + lower wick dominance = reflection (clear dominance only, never ties)
                wick_pattern := SUBTYPE_REFLECTION

        // Combine base classification with wick pattern
        final_subtype = ""
        if base_classification == SUBTYPE_IMPLIED
            final_subtype := SUBTYPE_IMPLIED + "_" + wick_pattern
        else if base_classification == SUBTYPE_VOLUME
            final_subtype := SUBTYPE_VOLUME + "_" + wick_pattern
        else if base_classification == SUBTYPE_TRUE
            final_subtype := SUBTYPE_TRUE + "_" + wick_pattern
        else if base_classification == SUBTYPE_RDRB
            final_subtype := SUBTYPE_RDRB + "_" + wick_pattern
        else
            final_subtype := wick_pattern
        [final_subtype, true]

// ═══════════════════════════════════════════════════════════════════════════════
// ZONE CALCULATION FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// Calculate zone penetration percentage using extreme prices (low/high)
calculate_zone_penetration_from_extreme(test_price, zone_top, zone_bottom, is_bullish_zone) =>
    zone_range = zone_top - zone_bottom
    if zone_range <= 0
        0.0
    else
        if is_bullish_zone
            // SIF⁺: penetration comes from above downward → use low
            if test_price >= zone_top
                0.0  // No penetration
            else if test_price <= zone_bottom
                100.0  // Full penetration
            else
                penetration_distance = zone_top - test_price
                (penetration_distance / zone_range) * 100.0
        else
            // SIF⁻: penetration comes from below upward → use high
            if test_price <= zone_bottom
                0.0  // No penetration
            else if test_price >= zone_top
                100.0  // Full penetration
            else
                penetration_distance = test_price - zone_bottom
                (penetration_distance / zone_range) * 100.0

// Calculate zone penetration percentage using candle body for SIF
calculate_sif_zone_penetration_from_body(open_price, close_price, zone_top, zone_bottom, is_bullish_zone) =>
    zone_range = zone_top - zone_bottom
    if zone_range <= 0
        0.0
    else
        if is_bullish_zone
            // Bullish zone: use LOWER of open/close for deepest penetration from above
            test_price = math.min(open_price, close_price)
            if test_price >= zone_top
                0.0  // No penetration
            else if test_price <= zone_bottom
                100.0  // Full penetration
            else
                penetration_distance = zone_top - test_price
                (penetration_distance / zone_range) * 100.0
        else
            // Bearish zone: use HIGHER of open/close for deepest penetration from below
            test_price = math.max(open_price, close_price)
            if test_price <= zone_bottom
                0.0  // No penetration
            else if test_price >= zone_top
                100.0  // Full penetration
            else
                penetration_distance = test_price - zone_bottom
                (penetration_distance / zone_range) * 100.0

// ═══════════════════════════════════════════════════════════════════════════════
// CONSOLIDATION SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

// Group SIFs by candle (bar_index)
group_sifs_by_candle(sif_records) =>
    grouped_sifs = array.new<ConsolidatedSIF>()

    if array.size(sif_records) == 0
        grouped_sifs
    else
        // Create map-like structure using arrays
        processed_candles = array.new<int>()

        for i = 0 to array.size(sif_records) - 1
            sif_record = array.get(sif_records, i)
            current_bar = sif_record.bar_index

            // Check if we already processed this candle
            if not array.includes(processed_candles, current_bar)
                // Collect all SIFs for this candle
                candle_sifs = array.new<SIFRecord>()

                for j = 0 to array.size(sif_records) - 1
                    other_sif = array.get(sif_records, j)
                    if other_sif.bar_index == current_bar
                        array.push(candle_sifs, other_sif)

                // Create consolidated SIF if we have any records
                if array.size(candle_sifs) > 0
                    first_sif = array.get(candle_sifs, 0)
                    // Initialize placeholders; derived values computed below
                    consolidated = ConsolidatedSIF.new(
                         candle_sifs,
                         current_bar,
                         first_sif.is_bullish,  // All SIFs on same candle have same direction
                         0.0,
                         0.0,
                         false,
                         ""
                     )
                    array.push(grouped_sifs, consolidated)
                    array.push(processed_candles, current_bar)

                    // Note: Multi-source alert flags are set during SIF creation
                    // to avoid assigning globals from within a function.

        grouped_sifs

// Calculate consolidated zone boundaries (outermost limits)
calculate_consolidated_zone_boundaries(sif_group) =>
    if array.size(sif_group) == 0
        [float(na), float(na)]
    else
        zone_top = -999999.0
        zone_bottom = 999999.0

        for i = 0 to array.size(sif_group) - 1
            sif_record = array.get(sif_group, i)
            [individual_top, individual_bottom] = get_subtype_zone(sif_record)

            if individual_top > zone_top
                zone_top := individual_top
            if individual_bottom < zone_bottom
                zone_bottom := individual_bottom

        [zone_top, zone_bottom]

// Determine consolidated status for group
determine_consolidated_status(consolidated_sif) =>
    invalidation_threshold = get_sif_invalidation_threshold()
    is_invalidated = false

    // First check if any SIF in group is already invalidated
    for i = 0 to array.size(consolidated_sif.sif_group) - 1
        sif = array.get(consolidated_sif.sif_group, i)
        if sif.is_invalidated
            is_invalidated := true
            break

    // Check invalidation (confirmed close) - both current and historical
    if not is_invalidated and barstate.isconfirmed
        // Check current bar first
        current_penetration = calculate_zone_penetration_from_close(
             close,
             consolidated_sif.consolidated_zone_top,
             consolidated_sif.consolidated_zone_bottom,
             consolidated_sif.is_bullish
         )
        invalidation_threshold := get_sif_invalidation_threshold()
        if current_penetration >= invalidation_threshold
            is_invalidated := true

    is_invalidated

// ═══════════════════════════════════════════════════════════════════════════════
// CONSOLIDATED LABEL BUILDING SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

// Build source type stats for consolidated display - counts only enabled sources
get_source_type_stats(sif_group) =>
    stats = SourceTypeStats.new(0, 0, 0, 0, 0, 0, 0)
    stats.group_size := array.size(sif_group)

    for i = 0 to stats.group_size - 1
        sif_record = array.get(sif_group, i)

        // Only count if source is enabled
        if str.contains(sif_record.sif_subtype, SUBTYPE_IMPLIED) and enable_implied
            stats.imp_count += 1
        else if str.contains(sif_record.sif_subtype, SUBTYPE_VOLUME) and enable_volume_imbalance
            stats.vol_count += 1
        else if str.contains(sif_record.sif_subtype, SUBTYPE_TRUE) and enable_true_gaps
            stats.true_count += 1
        else if str.contains(sif_record.sif_subtype, SUBTYPE_RDRB) and enable_rdrb
            stats.rdrb_count += 1
        else if (sif_record.sif_subtype == SUBTYPE_STANDARD or str.contains(sif_record.sif_subtype, SUBTYPE_INCLUSION) or str.contains(sif_record.sif_subtype, SUBTYPE_REFLECTION)) and enable_fair_value_gaps
            stats.fvg_count += 1

    stats.distinct_types := (stats.fvg_count > 0 ? 1 : 0) + (stats.imp_count > 0 ? 1 : 0) + (stats.vol_count > 0 ? 1 : 0) + (stats.true_count > 0 ? 1 : 0) + (stats.rdrb_count > 0 ? 1 : 0)
    stats

// Count source types for consolidated display (compatibility helper)
count_source_types(sif_group) =>
    stats = get_source_type_stats(sif_group)
    [stats.fvg_count, stats.imp_count, stats.vol_count, stats.true_count, stats.rdrb_count]

// Build source breakdown with extension logic
build_source_breakdown_extension_from_stats(stats) =>
    if stats.group_size == 0
        ""
    else if stats.distinct_types == 1
        // All same type: just show "fvg×2", "vol×3", etc. (no redundant total count)
        if stats.fvg_count > 0
            if stats.fvg_count == 1
                ""
            else
                GAP_SOURCE_FVG_BREAKDOWN_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(stats.fvg_count)
        else if stats.imp_count > 0
            if stats.imp_count == 1
                GAP_SOURCE_IMPLIED_DISPLAY
            else
                GAP_SOURCE_IMPLIED_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(stats.imp_count)
        else if stats.vol_count > 0
            if stats.vol_count == 1
                GAP_SOURCE_VOLUME_DISPLAY
            else
                GAP_SOURCE_VOLUME_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(stats.vol_count)
        else if stats.true_count > 0
            if stats.true_count == 1
                GAP_SOURCE_TRUE_DISPLAY
            else
                GAP_SOURCE_TRUE_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(stats.true_count)
        else if stats.rdrb_count > 0
            if stats.rdrb_count == 1
                GAP_SOURCE_RDRB_DISPLAY
            else
                GAP_SOURCE_RDRB_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(stats.rdrb_count)
        else
            ""
    else
        parts = array.new<string>()

        if stats.fvg_count > 0
            array.push(parts, stats.fvg_count == 1 ? GAP_SOURCE_FVG_BREAKDOWN_DISPLAY : GAP_SOURCE_FVG_BREAKDOWN_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(stats.fvg_count))

        if stats.imp_count > 0
            array.push(parts, stats.imp_count == 1 ? GAP_SOURCE_IMPLIED_DISPLAY : GAP_SOURCE_IMPLIED_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(stats.imp_count))

        if stats.vol_count > 0
            array.push(parts, stats.vol_count == 1 ? GAP_SOURCE_VOLUME_DISPLAY : GAP_SOURCE_VOLUME_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(stats.vol_count))

        if stats.true_count > 0
            array.push(parts, stats.true_count == 1 ? GAP_SOURCE_TRUE_DISPLAY : GAP_SOURCE_TRUE_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(stats.true_count))

        if stats.rdrb_count > 0
            array.push(parts, stats.rdrb_count == 1 ? GAP_SOURCE_RDRB_DISPLAY : GAP_SOURCE_RDRB_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(stats.rdrb_count))

        breakdown = ""
        for i = 0 to array.size(parts) - 1
            if i > 0
                breakdown := breakdown + BREAKDOWN_SEPARATOR
            breakdown := breakdown + array.get(parts, i)

        str.tostring(stats.group_size) + COUNT_SEPARATOR + breakdown

build_source_breakdown_extension(sif_group) =>
    build_source_breakdown_extension_from_stats(get_source_type_stats(sif_group))

// Build source breakdown with counts - USED for candle label logic (Original)
build_source_breakdown(sif_group) =>
    [fvg_count, imp_count, vol_count, true_count, rdrb_count] = count_source_types(sif_group)

    parts = array.new<string>()

    // SPECIAL FVG LOGIC: FVGs are invisible when alone, visible when mixed with others
    // This creates clean labels like "SIF⁺" instead of "SIF⁺ (fvg)" for single FVG cases
    if fvg_count > 0
        types_present_count = (fvg_count > 0 ? 1 : 0) + (imp_count > 0 ? 1 : 0) + (vol_count > 0 ? 1 : 0) + (true_count > 0 ? 1 : 0) + (rdrb_count > 0 ? 1 : 0)
        if fvg_count == 1 and types_present_count == 1
            // Single FVG alone: INVISIBLE - don't add to parts array for clean "SIF+" display
            na  // No-op: intentionally empty branch
        else if fvg_count == 1
            // Single FVG mixed with others: show "fvg" (e.g., "SIF⁺ (fvg, vol)")
            array.push(parts, GAP_SOURCE_FVG_BREAKDOWN_DISPLAY)
        else
            // Multiple FVGs: show "fvg×2", "fvg×3", etc.
            array.push(parts, GAP_SOURCE_FVG_BREAKDOWN_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(fvg_count))

    if imp_count > 0
        if imp_count == 1
            array.push(parts, GAP_SOURCE_IMPLIED_DISPLAY)
        else
            array.push(parts, GAP_SOURCE_IMPLIED_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(imp_count))

    if vol_count > 0
        if vol_count == 1
            array.push(parts, GAP_SOURCE_VOLUME_DISPLAY)
        else
            array.push(parts, GAP_SOURCE_VOLUME_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(vol_count))

    if true_count > 0
        if true_count == 1
            array.push(parts, GAP_SOURCE_TRUE_DISPLAY)
        else
            array.push(parts, GAP_SOURCE_TRUE_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(true_count))
    if rdrb_count > 0
        if rdrb_count == 1
            array.push(parts, GAP_SOURCE_RDRB_DISPLAY)
        else
            array.push(parts, GAP_SOURCE_RDRB_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(rdrb_count))

    // Join with commas
    result = ""
    for i = 0 to array.size(parts) - 1
        if i > 0
            result := result + ", "
        result := result + array.get(parts, i)

    result

// Create consolidated extension label with source type on new line
// EXTENSION LABEL ORDER:
// 1. Prefixes: IMM- (immediate), BRK- (breakaway)
// 2. Base direction: SIF+ / SIF-
// 3. Status indicators: [X] (ALWAYS LAST)
// 4. Gap sources on new line: imp, vol, rdrb, (fvg,imp), etc.
create_consolidated_extension_label(consolidated_sif) =>
    source_stats = get_source_type_stats(consolidated_sif.sif_group)
    sif_count = source_stats.group_size

    // Standard direction for extension label (no prefix)
    direction = consolidated_sif.is_bullish ? SIF_PLUS : SIF_MINUS

    // Check if any SIF in group is breakaway (for labeling)
    has_breakaway = false
    if mark_breakaway_sifs
        for i = 0 to sif_count - 1
            sif = array.get(consolidated_sif.sif_group, i)
            if sif.is_breakaway_sif
                has_breakaway := true
                break

    // Check for immediate inversion
    has_immediate_inversion = has_immediate_sif_inversion(consolidated_sif)

    // Add prefixes in order: IMM- then BRK-
    direction := has_breakaway ? LABEL_PREFIX_BREAKAWAY + direction : direction
    direction := has_immediate_inversion ? LABEL_PREFIX_IMMEDIATE + direction : direction

    extension_result = ""
    source_type_text = ""

    if sif_count == 1
        // Single SIF - only show gap source if NOT standard FVG (fvg is implied)
        single_sif = array.get(consolidated_sif.sif_group, 0)
        if str.contains(single_sif.sif_subtype, SUBTYPE_IMPLIED)
            source_type_text := GAP_SOURCE_IMPLIED_DISPLAY
        else if str.contains(single_sif.sif_subtype, SUBTYPE_VOLUME)
            source_type_text := GAP_SOURCE_VOLUME_DISPLAY
        else if str.contains(single_sif.sif_subtype, SUBTYPE_RDRB)
            source_type_text := GAP_SOURCE_RDRB_DISPLAY
        // Standard FVG gets no gap source (implied)

        // Single SIF: direction only (no subtype in extension label, matching MBZ)
        extension_result := direction
    else
        // Multiple SIFs - use extension breakdown logic
        source_breakdown = build_source_breakdown_extension_from_stats(source_stats)
        source_type_text := source_breakdown

        sif_text = direction

        extension_result := sif_text

    // Add status indicators (always last)
    if consolidated_sif.is_consolidated_invalidated
        extension_result := extension_result + " [X]"

    // Add source type on new line (if exists)
    if str.length(source_type_text) > 0
        extension_result := extension_result + "\n" + source_type_text

    // Add horizontal padding based on alignment setting
    if extension_label_horizontal_alignment == LABEL_ALIGNMENT_LEFT and str.length(horizontal_padding_str) > 0
        extension_result := horizontal_padding_str + extension_result
    else if extension_label_horizontal_alignment == LABEL_ALIGNMENT_RIGHT and str.length(horizontal_padding_str) > 0
        extension_result := extension_result + horizontal_padding_str

    // Add vertical padding (newlines)
    if str.length(vertical_padding_str) > 0
        if extension_label_vertical_alignment == LABEL_VERTICAL_TOP
            extension_result := extension_result + vertical_padding_str
        else if extension_label_vertical_alignment == LABEL_VERTICAL_BOTTOM
            extension_result := vertical_padding_str + extension_result

    extension_result

// Build alert message from consolidated SIF
build_alert_message_from_consolidated(consolidated_sif) =>
    direction = SIF_BASE_TEXT + (consolidated_sif.is_bullish ? SIF_BULLISH_SUFFIX : SIF_BEARISH_SUFFIX)

    sif_count = array.size(consolidated_sif.sif_group)
    source_stats = get_source_type_stats(consolidated_sif.sif_group)
    source_text = ""

    if sif_count == 1
        single_sif = array.get(consolidated_sif.sif_group, 0)
        source_token = ""
        if str.contains(single_sif.sif_subtype, SUBTYPE_IMPLIED)
            source_token := GAP_SOURCE_IMPLIED_DISPLAY
        else if str.contains(single_sif.sif_subtype, SUBTYPE_VOLUME)
            source_token := GAP_SOURCE_VOLUME_DISPLAY
        else if str.contains(single_sif.sif_subtype, SUBTYPE_TRUE)
            source_token := GAP_SOURCE_TRUE_DISPLAY
        else if str.contains(single_sif.sif_subtype, SUBTYPE_RDRB)
            source_token := GAP_SOURCE_RDRB_DISPLAY
        // FVG shows nothing (default/implied)
        source_text := source_token != "" ? " (" + source_token + ")" : ""
    else
        source_breakdown = build_source_breakdown_extension_from_stats(source_stats)
        source_text := str.length(source_breakdown) > 0 ? " (" + source_breakdown + ")" : ""

    direction + source_text

// ═══════════════════════════════════════════════════════════════════════════════
// PROJECTION SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════
// DISPLAY LOGIC
// ═══════════════════════════════════════════════════════════════════════════════

should_display_sif(sif_record) =>
    if sif_record.is_invalidated and not show_invalidated_sifs
        false
    else if sif_inversion_type_filter == SIF_INVERSION_TYPE_IMMEDIATE and not sif_record.is_immediate_sif_inversion
        false
    else if sif_inversion_type_filter == SIF_INVERSION_TYPE_REGULAR and sif_record.is_immediate_sif_inversion
        false
    else
        // Check if source type is enabled
        source_enabled = true
        if str.contains(sif_record.sif_subtype, SUBTYPE_IMPLIED) and not enable_implied
            source_enabled := false
        else if str.contains(sif_record.sif_subtype, SUBTYPE_VOLUME) and not enable_volume_imbalance
            source_enabled := false
        else if str.contains(sif_record.sif_subtype, SUBTYPE_TRUE) and not enable_true_gaps
            source_enabled := false
        else if sif_record.sif_subtype == SUBTYPE_STANDARD and not enable_fair_value_gaps
            source_enabled := false

        source_enabled

// Check if SIF should be displayed based on directional filter
should_display_sif_direction(sif_record) =>
    if sif_direction_filter == SIF_DIRECTION_BOTH
        true
    else if sif_direction_filter == SIF_DIRECTION_BULLISH
        sif_record.is_bullish
    else
        not sif_record.is_bullish

should_display_consolidated_sif(consolidated_sif) =>
    // Check if any SIF in the group should be displayed
    should_display = false
    has_breakaway = false
    for i = 0 to array.size(consolidated_sif.sif_group) - 1
        sif_record = array.get(consolidated_sif.sif_group, i)
        if sif_record.is_breakaway_sif
            has_breakaway := true
        if should_display_sif(sif_record)
            should_display := true

    should_display

// ATR distance filter helper - checks if zone is within ATR range from current price
passes_atr_distance_filter(zone_top, zone_bottom) =>
    if not workspace_mode_enabled
        true
    else
        // Distance to nearest edge: 0 if price inside zone, otherwise distance to closest edge
        distance_to_zone = close > zone_top ? close - zone_top : (close < zone_bottom ? zone_bottom - close : 0.0)
        distance_to_zone <= atr_max_distance

get_consolidated_sif_colors(consolidated_sif) =>
    // Check if any SIF in group is breakaway
    has_breakaway = false
    if mark_breakaway_sifs and not consolidated_sif.is_consolidated_invalidated
        for i = 0 to array.size(consolidated_sif.sif_group) - 1
            sif = array.get(consolidated_sif.sif_group, i)
            if sif.is_breakaway_sif
                has_breakaway := true
                break

    // Determine base color (breakaway custom colors override normal colors for active zones)
    original_color = if has_breakaway
        consolidated_sif.is_bullish ? breakaway_bullish_color : breakaway_bearish_color
    else
        consolidated_sif.is_bullish ? extended_box_bullish_color : extended_box_bearish_color

    // Apply fill opacity to extension color
    extension_color = color.new(original_color, extension_fill_opacity)

    // Return candle highlight color and extension color
    [original_color, extension_color]

get_consolidated_sif_extension_text_color(consolidated_sif, default_text_color) =>
    consolidated_sif.is_consolidated_invalidated ? color.gray : default_text_color

// ═══════════════════════════════════════════════════════════════════════════════
// SIF EXTENSION BOX FADING SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════
// === VISUAL COLOR/FADING FUNCTIONS ===
// Get SIF zone color
get_sif_zone_color(sif_record) =>
    sif_record.is_bullish ? extended_box_bullish_color : extended_box_bearish_color

// Get SIF zone transparency
get_sif_zone_transparency() =>
    DEFAULT_TRANSPARENCY

// Apply visual effects to SIF zone color
get_sif_visual_color(sif_record) =>
    zone_color = get_sif_zone_color(sif_record)
    transparency = get_sif_zone_transparency()
    color.new(zone_color, transparency)

create_box(left_bar, top_price, bottom_price, box_color, label_text) =>
    box.new(left=left_bar, top=top_price, right=left_bar + 3, bottom=bottom_price, bgcolor=box_color, border_color=box_color, border_style=line.style_solid, border_width=1, text=label_text, text_halign=text.align_center, text_valign=text.align_center, text_size=size.tiny, text_color=source_gap_text_color)

// Cache breakaway trend range calculations once per bar (performance optimization)
// Only calculated when FVGs are enabled (breakaway is an FVG property)
var float breakaway_upper = na
var float breakaway_lower = na
bool filter_allows_breakaway = fvg_type_filter != FVG_FILTER_STANDARD_ONLY
bool filter_allows_standard = fvg_type_filter != FVG_FILTER_BREAKAWAY_ONLY
if enable_fair_value_gaps and barstate.isconfirmed
    breakaway_upper := ta.highest(high, BREAKAWAY_LENGTH)
    breakaway_lower := ta.lowest(low, BREAKAWAY_LENGTH)

// ═══════════════════════════════════════════════════════════════════════════════
// MAIN DETECTION LOGIC
// ═══════════════════════════════════════════════════════════════════════════════

// Process gaps only when at least one source is enabled
if enable_fair_value_gaps or enable_implied or enable_volume_imbalance or enable_true_gaps

    // Track new regular FVGs with correct anchoring (3-candle structure: anchor from C1)
    if enable_fair_value_gaps and barstate.isconfirmed and is_bullish_fvg()
        // COORDINATE VALIDATION: Bullish FVG - ensure TOP > BOTTOM
        fvg_top = low        // C0.low (current candle low)
        fvg_bottom = high[2] // C2.high (2 bars ago high)
        // CRITICAL: fvg_top (low) > fvg_bottom (high[2]) by FVG detection logic

        // Check for overlapping gaps before creating
        if not is_gap_overlapping(fvg_top, fvg_bottom, true, GAP_TYPE_FVG, active_gaps)
            is_breakaway = low > breakaway_upper[2]
            should_create = (is_breakaway and filter_allows_breakaway) or (not is_breakaway and filter_allows_standard)
            if should_create
                // GapData.new(anchor, TOP, BOTTOM, bullish, inverted, formation, candidate, id, type, breakaway)
                fvg_gap_data = GapData.new(bar_index - 2, fvg_top, fvg_bottom, true, false, bar_index, SIFCandidate.new(int(na), float(na), float(na), false), next_gap_id, GAP_TYPE_FVG, is_breakaway)
                array.push(active_gaps, fvg_gap_data)
                next_gap_id += 1

if enable_fair_value_gaps and barstate.isconfirmed and is_bearish_fvg()
    // COORDINATE VALIDATION: Bearish FVG - ensure TOP > BOTTOM
    // Corrected coordinate reversal bug (was causing missing bearish FVGs)
    fvg_top = low[2]     // C2.low (2 bars ago low) - HIGHER value
    fvg_bottom = high    // C0.high (current candle high) - LOWER value
    // CRITICAL: fvg_top (low[2]) > fvg_bottom (high) by FVG detection logic

    // Check for overlapping gaps before creating
    if not is_gap_overlapping(fvg_top, fvg_bottom, false, GAP_TYPE_FVG, active_gaps)
        is_breakaway = high < breakaway_lower[2]
        should_create = (is_breakaway and filter_allows_breakaway) or (not is_breakaway and filter_allows_standard)
        if should_create
            // GapData.new(anchor, TOP, BOTTOM, bearish, inverted, formation, candidate, id, type, breakaway)
            fvg_gap_data = GapData.new(bar_index - 2, fvg_top, fvg_bottom, false, false, bar_index, SIFCandidate.new(int(na), float(na), float(na), false), next_gap_id, GAP_TYPE_FVG, is_breakaway)
            array.push(active_gaps, fvg_gap_data)
            next_gap_id += 1

// Track new implied FVGs with correct anchoring (3-candle structure: anchor from C1)
if enable_implied and barstate.isconfirmed
    [is_valid_implied_fvg, implied_fvg_bottom, implied_fvg_top, is_implied_fvg_bullish] = detect_implied_fvg()
    if is_valid_implied_fvg
        // Check for overlapping gaps before creating
        if not is_gap_overlapping(implied_fvg_top, implied_fvg_bottom, is_implied_fvg_bullish, GAP_TYPE_IMPLIED, active_gaps)
            implied_fvg_gap_data = GapData.new(bar_index - 2, implied_fvg_top, implied_fvg_bottom, is_implied_fvg_bullish, false, bar_index, SIFCandidate.new(int(na), float(na), float(na), false), next_gap_id, GAP_TYPE_IMPLIED, false)
            array.push(active_gaps, implied_fvg_gap_data)
            next_gap_id += 1

// Track Volume Imbalances with correct anchoring (2-candle structure: anchor from C1)
if enable_volume_imbalance and barstate.isconfirmed
    // Check for bullish VI (2-candle body gap)
    if is_bullish_vi()
        [volume_imbalance_top, volume_imbalance_bottom] = get_vi_coordinates(true)

        // Check for overlapping gaps before creating
        if not is_gap_overlapping(volume_imbalance_top, volume_imbalance_bottom, true, GAP_TYPE_VOLUME, active_gaps)
            volume_imbalance_gap_data = GapData.new(bar_index - 1, volume_imbalance_top, volume_imbalance_bottom, true, false, bar_index, SIFCandidate.new(int(na), float(na), float(na), false), next_gap_id, GAP_TYPE_VOLUME, false)
            array.push(active_gaps, volume_imbalance_gap_data)
            next_gap_id += 1

    // Check for bearish VI (2-candle body gap)
    if is_bearish_vi()
        [volume_imbalance_top, volume_imbalance_bottom] = get_vi_coordinates(false)

        // Check for overlapping gaps before creating
        if not is_gap_overlapping(volume_imbalance_top, volume_imbalance_bottom, false, GAP_TYPE_VOLUME, active_gaps)
            volume_imbalance_gap_data = GapData.new(bar_index - 1, volume_imbalance_top, volume_imbalance_bottom, false, false, bar_index, SIFCandidate.new(int(na), float(na), float(na), false), next_gap_id, GAP_TYPE_VOLUME, false)
            array.push(active_gaps, volume_imbalance_gap_data)
            next_gap_id += 1

    // Track True Gaps with correct anchoring (2-candle structure: anchor from C1)
    if enable_true_gaps and barstate.isconfirmed
        // Check for bullish true gap
        if is_bullish_true_gap()
            [true_gap_top, true_gap_bottom] = get_true_gap_coordinates(true)

            // Check for overlapping gaps before creating
            if not is_gap_overlapping(true_gap_top, true_gap_bottom, true, GAP_TYPE_TRUE, active_gaps)
                is_breakaway = false  // True Gaps cannot be breakaway gaps (only FVGs can be breakaway)
                true_gap_data = GapData.new(bar_index - 1, true_gap_top, true_gap_bottom, true, false, bar_index, SIFCandidate.new(int(na), float(na), float(na), false), next_gap_id, GAP_TYPE_TRUE, is_breakaway)
                array.push(active_gaps, true_gap_data)
                next_gap_id += 1
            if not is_gap_overlapping(true_gap_top, true_gap_bottom, false, GAP_TYPE_TRUE, active_gaps)
                is_breakaway = false  // True Gaps cannot be breakaway gaps (only FVGs can be breakaway)
                true_gap_data = GapData.new(bar_index - 1, true_gap_top, true_gap_bottom, false, false, bar_index, SIFCandidate.new(int(na), float(na), float(na), false), next_gap_id, GAP_TYPE_TRUE, is_breakaway)
                array.push(active_gaps, true_gap_data)
                next_gap_id += 1

// Track new RDRB gaps (3-candle structure: anchor from C1)
if enable_rdrb and barstate.isconfirmed
    [is_valid_rdrb, rdrb_bottom, rdrb_top, is_rdrb_bullish] = detect_rdrb_gap()
    if is_valid_rdrb
        if not is_gap_overlapping(rdrb_top, rdrb_bottom, is_rdrb_bullish, GAP_TYPE_RDRB, active_gaps)
            is_breakaway = false  // RDRB gaps cannot be breakaway gaps (only FVGs can be breakaway)
            rdrb_gap_data = GapData.new(bar_index - 2, rdrb_top, rdrb_bottom, is_rdrb_bullish, false, bar_index, SIFCandidate.new(int(na), float(na), float(na), false), next_gap_id, GAP_TYPE_RDRB, is_breakaway)
            array.push(active_gaps, rdrb_gap_data)
            next_gap_id += 1

// Memory management (use configured limits)
while array.size(active_gaps) > max_active_gaps_effective
    array.shift(active_gaps)

while array.size(all_sif_records) > max_sif_records_effective
    array.shift(all_sif_records)

// Clean up visual elements
while array.size(sif_body_highlights) > max_body_highlights_effective
    box.delete(array.shift(sif_body_highlights))

while array.size(sif_wick_highlights) > max_wick_highlights_effective
    box.delete(array.shift(sif_wick_highlights))

while array.size(sif_extended_boxes) > max_extended_boxes_effective
    box.delete(array.shift(sif_extended_boxes))

// OPTIMIZED v4.11: Skip processing when no records exist
if array.size(all_sif_records) > 0
    for i = array.size(all_sif_records) - 1 to 0
        sif_record = array.get(all_sif_records, i)

        if not sif_record.is_invalidated
            updated_sif = sif_record  // No confirmation needed

            // Check for invalidation using enhanced gap detection
            should_invalidate = should_sif_be_invalidated_enhanced(updated_sif, open, close)
            if should_invalidate
                updated_sif.is_invalidated := true
                updated_sif.cached_data_valid := false  // Invalidate cache
                needs_visual_update := true

            array.set(all_sif_records, i, updated_sif)

// Gap processing and SIF detection with correct timing

if array.size(active_gaps) > 0
    for i = array.size(active_gaps) - 1 to 0
        gap = array.get(active_gaps, i)
        if not gap.is_inverted
            current_body_top = math.max(open, close)
            current_body_bottom = math.min(open, close)
            is_current_bullish = close > open
            is_current_bearish = close < open

            current_body_enters_gap = false
            is_opposite_color = false

            // SIF LOGIC: Body must enter gap (not just wick tapping like MBZ)
            if gap.is_bullish and is_current_bearish
                body_enters_from_above = open > gap.top and close < gap.top
                body_opens_inside = open <= gap.top and open >= gap.bottom
                body_closes_through = open >= gap.bottom and close < gap.bottom
                if body_enters_from_above or body_opens_inside or body_closes_through
                    current_body_enters_gap := true
                    is_opposite_color := true
            else if not gap.is_bullish and is_current_bullish
                body_enters_from_below = open < gap.bottom and close > gap.bottom
                body_opens_inside = open >= gap.bottom and open <= gap.top
                body_closes_through = open <= gap.top and close > gap.top
                if body_enters_from_below or body_opens_inside or body_closes_through
                    current_body_enters_gap := true
                    is_opposite_color := true

            // SIF timing validation with universal 1+ bar gap rule
            if current_body_enters_gap and is_opposite_color and na(gap.first_tapper.bar_index)
                // Universal timing rule: 1+ bar gap for ALL gap types
                bars_since_gap_creation = bar_index - gap.creation_bar
                if bars_since_gap_creation >= 1
                    gap.first_tapper := SIFCandidate.new(bar_index, current_body_top, current_body_bottom, is_current_bullish)
                    array.set(active_gaps, i, gap)

            // SIF LOGIC: Check for gap inversion (SIF-specific)
            gap_inverted = false
            if gap.is_bullish
                if close <= gap.bottom
                    gap_inverted := true
            else
                if close >= gap.top
                    gap_inverted := true

            if gap_inverted and not na(gap.first_tapper.bar_index)
                gap.is_inverted := true
                array.set(active_gaps, i, gap)

                sif_candidate = gap.first_tapper

                if not na(sif_candidate.bar_index)
                    is_immediate_sif_inversion = (sif_candidate.bar_index == bar_index)

                    bars_back = bar_index - sif_candidate.bar_index
                    sif_open_price = open[bars_back]
                    sif_close_price = close[bars_back]
                    sif_high_price = high[bars_back]
                    sif_low_price = low[bars_back]

                    [sif_subtype, has_dom_wick] = detect_sif_subtype(sif_open_price, sif_close_price, sif_high_price, sif_low_price, gap.gap_type)

                    // Create temporary SIF record for strength detection
                    temporary_sif_record = SIFRecord.new(
                         sif_candidate.bar_index,
                         sif_open_price,
                         sif_close_price,
                         sif_high_price,
                         sif_low_price,
                         sif_candidate.is_bullish,
                         false,
                         0.0,
                         has_dom_wick,
                         sif_subtype,
                         0.0,
                         0.0,
                         false,
                         label(na),
                         gap.gap_id,
                         gap.bar_index,
                         gap.top,
                         gap.bottom,
                         gap.gap_type,
                         false,
                         gap.is_breakaway_gap
                     )

                    sif_record = SIFRecord.new(
                         sif_candidate.bar_index,
                         sif_open_price,
                         sif_close_price,
                         sif_high_price,
                         sif_low_price,
                         sif_candidate.is_bullish,
                         false,
                         0.0,
                         has_dom_wick,
                         sif_subtype,
                         0.0,
                         0.0,
                         false,
                         label(na),
                         gap.gap_id,
                         gap.bar_index,
                         gap.top,
                         gap.bottom,
                         gap.gap_type,
                         is_immediate_sif_inversion,
                         gap.is_breakaway_gap
                     )

                    array.push(all_sif_records, sif_record)
                    needs_visual_update := true

// ═══════════════════════════════════════════════════════════════════════════════
// CONSOLIDATED VISUAL MANAGEMENT SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

manage_consolidated_sif_display() =>
    // Clear all visual elements efficiently
    // Always clear source gap boxes for dynamic toggle behavior
    for elem in source_gap_boxes
        box.delete(elem)
    array.clear(source_gap_boxes)

    for elem in sif_body_highlights
        box.delete(elem)
    array.clear(sif_body_highlights)

    for elem in sif_extended_boxes
        box.delete(elem)
    array.clear(sif_extended_boxes)

    array.clear(displayed_sif_indices)

    // Group SIFs by candle for consolidation
    displayable_sifs = array.new<SIFRecord>()

    // Add bounds checking to prevent array out of bounds error
    total_sif_records = array.size(all_sif_records)
    if total_sif_records > 0  // Only proceed if we have records
        // SEPARATE LIMITS SYSTEM: Process valid and invalidated SIFs with independent counters
        valid_sif_count = 0           // Counter for valid SIFs
        invalidated_sif_count = 0     // Counter for invalidated SIFs

        // Iterate through SIF records from most recent to oldest
        for record_index = total_sif_records - 1 to 0
            current_sif_record = array.get(all_sif_records, record_index)

            // Apply source type and directional filters first
            if should_display_sif(current_sif_record) and should_display_sif_direction(current_sif_record)

                // VALID SIF PROCESSING: Add valid SIFs up to configured limit
                if not current_sif_record.is_invalidated and valid_sif_count < max_valid_sifs_effective
                    array.push(displayable_sifs, current_sif_record)
                    valid_sif_count += 1

                // INVALIDATED SIF PROCESSING: Add invalidated SIFs only when display is enabled and under limit
                else if current_sif_record.is_invalidated and invalidated_sif_count < max_invalidated_sifs_effective and show_invalidated_sifs
                    array.push(displayable_sifs, current_sif_record)
                    invalidated_sif_count += 1

            // PERFORMANCE OPTIMIZATION: Early termination when both limits reached
            // Reduces unnecessary array iterations on charts with many SIFs
            if valid_sif_count >= max_valid_sifs_effective and (invalidated_sif_count >= max_invalidated_sifs_effective or not show_invalidated_sifs)
                break

    // Group displayable SIFs by candle (will return empty array if no displayable SIFs)
    consolidated_sifs = group_sifs_by_candle(displayable_sifs)

    // Only process if we have consolidated SIFs
    if array.size(consolidated_sifs) > 0
        // Process each consolidated group
        gap_boxes_already_created = array.new<int>()

        for consolidated_group_index = 0 to array.size(consolidated_sifs) - 1
            current_consolidated_sif = array.get(consolidated_sifs, consolidated_group_index)

            if not should_display_consolidated_sif(current_consolidated_sif)
                continue

            // Calculate consolidated zone boundaries
            [consolidated_zone_top_boundary, consolidated_zone_bottom_boundary] = calculate_consolidated_zone_boundaries(current_consolidated_sif.sif_group)
            current_consolidated_sif.consolidated_zone_top := consolidated_zone_top_boundary
            current_consolidated_sif.consolidated_zone_bottom := consolidated_zone_bottom_boundary

            // ATR distance filter - skip zones too far from current price
            if not passes_atr_distance_filter(consolidated_zone_top_boundary, consolidated_zone_bottom_boundary)
                continue

            // Determine consolidated status
            is_currently_invalidated = determine_consolidated_status(current_consolidated_sif)
            current_consolidated_sif.is_consolidated_invalidated := is_currently_invalidated

            // Build extension label
            current_consolidated_sif.consolidated_extension_label := create_consolidated_extension_label(current_consolidated_sif)

            // Update the consolidated_sifs array
            array.set(consolidated_sifs, consolidated_group_index, current_consolidated_sif)

            // Create consolidated extension box
            should_highlight_consolidated_zone = not current_consolidated_sif.is_consolidated_invalidated or show_invalidated_sifs
            if should_highlight_consolidated_zone
                [consolidated_highlight_color, consolidated_extension_color] = get_consolidated_sif_colors(current_consolidated_sif)

                // Get dynamic border properties for multi-source highlighting
                sif_source_count = array.size(current_consolidated_sif.sif_group)
                [border_width_final, border_color_final] = get_border_properties_for_sif(current_consolidated_sif, sif_source_count)

                // Highlight box (consolidated zone)
                consolidated_highlight_box = box.new(
                     left=current_consolidated_sif.bar_index,
                     right=current_consolidated_sif.bar_index + 1,
                     top=current_consolidated_sif.consolidated_zone_top,
                     bottom=current_consolidated_sif.consolidated_zone_bottom,
                     xloc=xloc.bar_index,
                     bgcolor=consolidated_highlight_color,
                     border_color=na
                 )
                array.push(sif_body_highlights, consolidated_highlight_box)

                // Extension box with consolidated label
                // Live extension: calculate offset and extension right position
                calculated_offset = workspace_mode_enabled ? get_extension_offset(current_consolidated_sif.bar_index, current_consolidated_sif.consolidated_zone_top, WORKSPACE_EXTENSION_OFFSET) : 0
                extension_right = workspace_mode_enabled ? math.max(bar_index, current_consolidated_sif.bar_index + extended_box_length) + calculated_offset : current_consolidated_sif.bar_index + extended_box_length

                // Live extension: cycling border opacity for visual distinction
                border_transparency = get_border_transparency(current_consolidated_sif.bar_index)
                staggered_border_color = color.new(border_color_final, border_transparency)

                consolidated_extension_box = box.new(
                     left=current_consolidated_sif.bar_index,
                     right=extension_right,
                     top=current_consolidated_sif.consolidated_zone_top,
                     bottom=current_consolidated_sif.consolidated_zone_bottom,
                     xloc=xloc.bar_index,
                     bgcolor=consolidated_extension_color,
                     border_color=staggered_border_color,
                     border_width=border_width_final,
                     text=current_consolidated_sif.consolidated_extension_label,
                     text_halign=get_extension_label_halign(),
                     text_valign=get_extension_label_valign(),
                     text_color=get_consolidated_sif_extension_text_color(current_consolidated_sif, extended_box_text_color),
                     text_size=size.tiny
                 )
                array.push(sif_extended_boxes, consolidated_extension_box)

            // Source gap creation - use cached geometry (independent of active_gaps retention)
            if show_source_gap and array.size(source_gap_boxes) < max_source_gap_boxes_effective
                // Create gap box for EACH SIF in the group
                for current_sif_index = 0 to array.size(current_consolidated_sif.sif_group) - 1
                    current_sif_in_group = array.get(current_consolidated_sif.sif_group, current_sif_index)

                    if not array.includes(gap_boxes_already_created, current_sif_in_group.source_gap_id)
                        individual_sif_label = current_sif_in_group.is_bullish ? SIF_PLUS : SIF_MINUS

                        // Build label text from cached type and direction
                        source_gap_label_text = ""
                        breakaway_prefix = (mark_breakaway_sifs and current_sif_in_group.is_breakaway_sif) ? BREAKAWAY_SOURCE_PREFIX : ""
                        if current_sif_in_group.source_gap_type == GAP_TYPE_IMPLIED
                            source_gap_label_text := breakaway_prefix + (current_sif_in_group.is_bullish ? GAP_LABEL_IMPLIED_BULLISH + individual_sif_label : GAP_LABEL_IMPLIED_BEARISH + individual_sif_label)
                        else if current_sif_in_group.source_gap_type == GAP_TYPE_VOLUME
                            source_gap_label_text := breakaway_prefix + (current_sif_in_group.is_bullish ? GAP_LABEL_VOLUME_BULLISH + individual_sif_label : GAP_LABEL_VOLUME_BEARISH + individual_sif_label)
                        else if current_sif_in_group.source_gap_type == GAP_TYPE_TRUE
                            source_gap_label_text := breakaway_prefix + (current_sif_in_group.is_bullish ? GAP_LABEL_TRUE_BULLISH + individual_sif_label : GAP_LABEL_TRUE_BEARISH + individual_sif_label)
                        else if current_sif_in_group.source_gap_type == GAP_TYPE_RDRB
                            source_gap_label_text := breakaway_prefix + (current_sif_in_group.is_bullish ? GAP_LABEL_RDRB_BULLISH + individual_sif_label : GAP_LABEL_RDRB_BEARISH + individual_sif_label)
                        else
                            source_gap_label_text := breakaway_prefix + (current_sif_in_group.is_bullish ? GAP_LABEL_FVG_BULLISH + individual_sif_label : GAP_LABEL_FVG_BEARISH + individual_sif_label)

                        // Create and configure gap box from cached geometry
                        individual_gap_box = create_box(
                             current_sif_in_group.source_gap_bar_index,
                             current_sif_in_group.source_gap_top,
                             current_sif_in_group.source_gap_bottom,
                             gap_color,
                             source_gap_label_text
                         )
                        box.set_right(individual_gap_box, current_sif_in_group.bar_index)
                        array.push(source_gap_boxes, individual_gap_box)

                        // Mark this gap ID as processed
                        array.push(gap_boxes_already_created, current_sif_in_group.source_gap_id)

    // Cache consolidated groups for reuse in stars block (avoid re-grouping)
    array.clear(last_consolidated_sifs)
    if array.size(consolidated_sifs) > 0
        for cache_i = 0 to array.size(consolidated_sifs) - 1
            array.push(last_consolidated_sifs, array.get(consolidated_sifs, cache_i))

// OPTIMIZED: Smart visual update system - only when necessary (match MBZ gating)
should_update_visuals = needs_full_update or needs_visual_update or barstate.islastconfirmedhistory or (barstate.islast and bar_index != last_update_bar)

if should_update_visuals
    manage_consolidated_sif_display()
    last_update_bar := bar_index
    needs_full_update := false
    needs_visual_update := false

// ═══════════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.isconfirmed
    array.clear(sif_alert_parts)

    if array.size(last_consolidated_sifs) > 0
        for i = 0 to array.size(last_consolidated_sifs) - 1
            consolidated_sif = array.get(last_consolidated_sifs, i)
            if consolidated_sif.bar_index == bar_index
                alert_msg = build_alert_message_from_consolidated(consolidated_sif)
                array.push(sif_alert_parts, alert_msg)

    sif_grouped_alert_active := array.size(sif_alert_parts) > 0

    if sif_grouped_alert_active
        alert_message = ""
        tf = str.tostring(timeframe.period)

        for i = 0 to array.size(sif_alert_parts) - 1
            if i > 0
                alert_message := alert_message + " | "
            alert_message := alert_message + array.get(sif_alert_parts, i)

        alert(alert_message + " • " + tf)

// ═══════════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE
// ═══════════════════════════════════════════════════════════════════════════════

if show_color_table and barstate.islast
    var table color_table = table.new(position.top_right, 4, 11, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

    // Header row
    table.cell(color_table, 0, 0, "Color", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(color_table, 1, 0, "Line", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(color_table, 2, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(color_table, 3, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)

    // Gap Color
    table.cell(color_table, 0, 1, "Gap Box", text_size=size.small)
    table.cell(color_table, 1, 1, "395", text_size=size.small)
    table.cell(color_table, 2, 1, str.format("R:{0} G:{1} B:{2}", int(color.r(gap_color)), int(color.g(gap_color)), int(color.b(gap_color))), text_size=size.small)
    table.cell(color_table, 3, 1, str.tostring(int(color.t(gap_color))), text_size=size.small)

    // Source Gap Text Color
    table.cell(color_table, 0, 2, "Gap Label", text_size=size.small)
    table.cell(color_table, 1, 2, "398", text_size=size.small)
    table.cell(color_table, 2, 2, str.format("R:{0} G:{1} B:{2}", int(color.r(source_gap_text_color)), int(color.g(source_gap_text_color)), int(color.b(source_gap_text_color))), text_size=size.small)
    table.cell(color_table, 3, 2, str.tostring(int(color.t(source_gap_text_color))), text_size=size.small)

    // Extended Box Bullish
    table.cell(color_table, 0, 3, "SIF⁺ Ext", text_size=size.small)
    table.cell(color_table, 1, 3, "408", text_size=size.small)
    table.cell(color_table, 2, 3, str.format("R:{0} G:{1} B:{2}", int(color.r(extended_box_bullish_color)), int(color.g(extended_box_bullish_color)), int(color.b(extended_box_bullish_color))), text_size=size.small)
    table.cell(color_table, 3, 3, str.tostring(int(color.t(extended_box_bullish_color))), text_size=size.small)

    // Extended Box Bearish
    table.cell(color_table, 0, 4, "SIF⁻ Ext", text_size=size.small)
    table.cell(color_table, 1, 4, "409", text_size=size.small)
    table.cell(color_table, 2, 4, str.format("R:{0} G:{1} B:{2}", int(color.r(extended_box_bearish_color)), int(color.g(extended_box_bearish_color)), int(color.b(extended_box_bearish_color))), text_size=size.small)
    table.cell(color_table, 3, 4, str.tostring(int(color.t(extended_box_bearish_color))), text_size=size.small)

    // Extended Box Text Color
    table.cell(color_table, 0, 5, "Ext Label", text_size=size.small)
    table.cell(color_table, 1, 5, "412", text_size=size.small)
    table.cell(color_table, 2, 5, str.format("R:{0} G:{1} B:{2}", int(color.r(extended_box_text_color)), int(color.g(extended_box_text_color)), int(color.b(extended_box_text_color))), text_size=size.small)
    table.cell(color_table, 3, 5, str.tostring(int(color.t(extended_box_text_color))), text_size=size.small)

    // Breakaway Bullish Color
    table.cell(color_table, 0, 6, "BRK SIF⁺", text_size=size.small)
    table.cell(color_table, 1, 6, "440", text_size=size.small)
    table.cell(color_table, 2, 6, str.format("R:{0} G:{1} B:{2}", int(color.r(breakaway_bullish_color)), int(color.g(breakaway_bullish_color)), int(color.b(breakaway_bullish_color))), text_size=size.small)
    table.cell(color_table, 3, 6, str.tostring(int(color.t(breakaway_bullish_color))), text_size=size.small)

    // Breakaway Bearish Color
    table.cell(color_table, 0, 7, "BRK SIF⁻", text_size=size.small)
    table.cell(color_table, 1, 7, "441", text_size=size.small)
    table.cell(color_table, 2, 7, str.format("R:{0} G:{1} B:{2}", int(color.r(breakaway_bearish_color)), int(color.g(breakaway_bearish_color)), int(color.b(breakaway_bearish_color))), text_size=size.small)
    table.cell(color_table, 3, 7, str.tostring(int(color.t(breakaway_bearish_color))), text_size=size.small)

    // Breakaway Bullish Border
    table.cell(color_table, 0, 8, "BRK⁺ Border", text_size=size.small)
    table.cell(color_table, 1, 8, "443", text_size=size.small)
    table.cell(color_table, 2, 8, str.format("R:{0} G:{1} B:{2}", int(color.r(breakaway_bullish_border_color)), int(color.g(breakaway_bullish_border_color)), int(color.b(breakaway_bullish_border_color))), text_size=size.small)
    table.cell(color_table, 3, 8, str.tostring(int(color.t(breakaway_bullish_border_color))), text_size=size.small)

    // Breakaway Bearish Border
    table.cell(color_table, 0, 9, "BRK⁻ Border", text_size=size.small)
    table.cell(color_table, 1, 9, "444", text_size=size.small)
    table.cell(color_table, 2, 9, str.format("R:{0} G:{1} B:{2}", int(color.r(breakaway_bearish_border_color)), int(color.g(breakaway_bearish_border_color)), int(color.b(breakaway_bearish_border_color))), text_size=size.small)
    table.cell(color_table, 3, 9, str.tostring(int(color.t(breakaway_bearish_border_color))), text_size=size.small)

// ═══════════════════════════════════════════════════════════════════════════════
// STATUS TABLE
// ═══════════════════════════════════════════════════════════════════════════════

if show_status_table and barstate.islast
    // Build gap sources string
    all_gaps_enabled = enable_fair_value_gaps and enable_implied and enable_volume_imbalance and enable_true_gaps and enable_rdrb

    gap_parts = array.new<string>()
    if enable_fair_value_gaps
        array.push(gap_parts, GAP_SOURCE_FVG_BREAKDOWN_DISPLAY)
    if enable_implied
        array.push(gap_parts, GAP_SOURCE_IMPLIED_DISPLAY)
    if enable_volume_imbalance
        array.push(gap_parts, GAP_SOURCE_VOLUME_DISPLAY)
    if enable_true_gaps
        array.push(gap_parts, GAP_SOURCE_TRUE_DISPLAY)
    if enable_rdrb
        array.push(gap_parts, GAP_SOURCE_RDRB_DISPLAY)

    gaps_text = all_gaps_enabled ? STATUS_DISPLAY_ALL : array.join(gap_parts, "·")

    // Build status text (WS only shown if enabled)
    status_text = workspace_mode_enabled ? STATUS_DISPLAY_WS + "  " + gaps_text : gaps_text

    // Create table with offset padding
    // Offset adds space characters to shift content left (negative) or right (positive)
    var table status_table = table.new(position.bottom_center, 4, 1, border_width=0)

    left_pad = status_table_offset < 0 ? "" : str.repeat(" ", status_table_offset * 3)
    right_pad = status_table_offset > 0 ? "" : str.repeat(" ", math.abs(status_table_offset) * 3)

    // Left padding cell
    table.cell(status_table, 0, 0, left_pad, bgcolor=color.new(color.white, 100), text_size=size.tiny)

    // Title cell: white text on black background
    table.cell(status_table, 1, 0, "SIF", bgcolor=color.black, text_color=color.white, text_size=size.tiny)

    // Status cell: black text on white background
    table.cell(status_table, 2, 0, status_text, bgcolor=color.new(color.rgb(245, 245, 245), 20), text_color=color.black, text_size=size.tiny)

    // Right padding cell
    table.cell(status_table, 3, 0, right_pad, bgcolor=color.new(color.white, 100), text_size=size.tiny)

// SIF Core° [Pro+]
