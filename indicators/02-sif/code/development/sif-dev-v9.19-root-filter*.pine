// === 🎯 ROOT FILTERING ===
// Timeframe validation
is_root_timeframe_valid = timeframe.multiplier <= 5 and not timeframe.isseconds

root_filter_mode = input.string("Off", "Root Filter", group=GROUP_ROOT_FILTER, options=["Off", "Above Root Only", "Below Root Only"], tooltip="Above Root Only: Show only SIFs above root EQ\nBelow Root Only: Show only SIFs below root EQ\n\n⚠️ Only works on timeframes ≤5 minutes")

