enable_immediate_sif_inversion_minus_alert = input.bool(false, ALERT_TITLE_IMMEDIATE_SIF_INVERSION_MINUS, group=GROUP_ALERT_SETTINGS, inline='special2', tooltip='Grouped only: Include Immediate SIF Inversion⁻ alerts in grouped alert')

// ═══════════════════════════════════════════════════════════════════════════════
// DATA STRUCTURES
// ═══════════════════════════════════════════════════════════════════════════════

type SIFCandidate
    int bar_index
    float body_top
    float body_bottom
    bool is_bullish

type GapData
    int bar_index
    float top
    float bottom
    bool is_bullish
    bool is_inverted
    int creation_bar
    SIFCandidate first_tapper
    int gap_id
    string gap_type

// Simplified SIFRecord with SUPER SIF detection
type SIFRecord
    int bar_index
    float sif_open
    float sif_close
    float sif_high
    float sif_low
    bool is_bullish
    bool is_invalidated
    float max_fill_percentage
    bool has_dominant_wick
    string sif_subtype
    string cached_label_text
    string cached_tooltip
    float cached_zone_top
    float cached_zone_bottom
    bool cached_data_valid
    label sif_label
    int source_gap_id
    // Just SUPER or NORMAL
    bool is_super_sif              // true if overlapping with any same-direction SIF
    float overlap_percentage       // 0.0 to 100.0
    int overlapping_sif_bar_index  // Which SIF we overlapped with
    bool is_immediate_sif_inversion    // true if formation candle also closes the gap

// Consolidated SIF group type
type ConsolidatedSIF
    array<SIFRecord> sif_group
    int bar_index
    bool is_bullish
    float consolidated_zone_top
    float consolidated_zone_bottom
    bool is_consolidated_breached
    bool is_consolidated_invalidated
    string consolidated_candle_label
    string consolidated_extension_label

// Global State
var array<GapData> active_gaps = array.new<GapData>()
var array<SIFRecord> all_sif_records = array.new<SIFRecord>()
var int next_gap_id = 1

// Visual Elements
var array<box> source_gap_boxes = array.new_box()
var array<label> sif_labels = array.new<label>()
var array<label> star_labels = array.new<label>()
var array<box> sif_body_highlights = array.new_box()
var array<box> sif_wick_highlights = array.new_box()
var array<box> sif_extended_boxes = array.new_box()
var array<line> sif_projection_lines = array.new_line()
var array<label> sif_projection_labels = array.new<label>()
var array<int> displayed_sif_indices = array.new<int>()

// Visual Arrays for Breach Detection Lines
var array<line> sif_breached_lines = array.new_line()
var array<line> sif_invalidation_lines = array.new_line()

// Root filtering variables
var float root_eq_price = na
var bool root_found_today = false
var int root_bar_time = na
var line root_eq_line = na
var label root_eq_label = na

var bool needs_visual_update = true

// ═══════════════════════════════════════════════════════════════════════════════
// UTILITY FUNCTIONS - DEFINED EARLY FOR DEPENDENCIES
// ═══════════════════════════════════════════════════════════════════════════════

// Gap Detection Functions with Coordinate Validation
// CRITICAL: These functions detect gaps but coordinates must be assigned carefully in gap creation

// @function is_bullish_fvg
// @description Detects bullish Fair Value Gap pattern (3-candle upward gap)
// @returns bool True if C0.low > C2.high (upward gap exists)
is_bullish_fvg() => low > high[2]

// @function is_bearish_fvg
// @description Detects bearish Fair Value Gap pattern (3-candle downward gap)
// @returns bool True if C0.high < C2.low (downward gap exists)
is_bearish_fvg() => high < low[2]

// Volume Imbalance Detection (2-candle body gap with wick connection)
is_bullish_vi() =>
    bodies_separated = math.min(open, close) > math.max(open[1], close[1])
    wicks_still_connect = low <= high[1]  // Current low reaches previous high
    bodies_separated and wicks_still_connect

is_bearish_vi() =>
    bodies_separated = math.max(open, close) < math.min(open[1], close[1])
    wicks_still_connect = high >= low[1]  // Current high reaches previous low
    bodies_separated and wicks_still_connect

// True Gap Detection (2-candle structure) with Coordinate Validation
// @function is_bullish_true_gap
// @description Detects bullish True Gap (2-candle upward price gap)
// @returns bool True if C1.high < C0.low (classic upward gap)
is_bullish_true_gap() => high[1] < low

// @function is_bearish_true_gap
// @description Detects bearish True Gap (2-candle downward price gap)
// @returns bool True if C1.low > C0.high (classic downward gap)
is_bearish_true_gap() => low[1] > high

// True Gap coordinates
get_true_gap_coordinates(is_bullish_gap) =>
    if is_bullish_gap
        // Bullish gap: between previous high and current low
        [low, high[1]]
    else
        // Bearish gap: between previous low and current high
        [low[1], high]

// Gap priority hierarchy (lower number = higher priority) - MUST BE DEFINED FIRST
get_gap_priority(gap_type) =>
    switch gap_type
        GAP_TYPE_FVG => 1        // Highest priority
        GAP_TYPE_IMPLIED => 2
        GAP_TYPE_TRUE => 3
        GAP_TYPE_VOLUME => 4     // Lowest priority
        => 5

// @function is_gap_overlapping
// @description Determines if a new gap should be suppressed by existing gaps using MBZ-style hierarchy enforcement (FVG > Implied > True > VI). Replaces dangerous 80% overlap threshold with targeted institutional priority system.
// @param new_top Upper boundary of new gap
// @param new_bottom Lower boundary of new gap
// @param new_is_bullish Direction of new gap (true = bullish, false = bearish)
// @param new_gap_type Gap classification (GAP_TYPE_FVG, GAP_TYPE_IMPLIED, GAP_TYPE_TRUE, GAP_TYPE_VOLUME)
// @param existing_gaps Array of existing GapData objects to check against
// @returns bool True if new gap should be suppressed, false if should be added
is_gap_overlapping(new_top, new_bottom, new_is_bullish, new_gap_type, existing_gaps) =>
    if array.size(existing_gaps) == 0
        false
    else
        should_suppress = false

        for i = 0 to array.size(existing_gaps) - 1
            existing_gap = array.get(existing_gaps, i)

            // MBZ-style targeted suppression - only same direction gaps with hierarchy enforcement
            if existing_gap.is_bullish == new_is_bullish and not existing_gap.is_inverted
                // Spatial overlap check: new_bottom < existing_top AND new_top >= existing_bottom
                if new_bottom < existing_gap.top and new_top >= existing_gap.bottom
                    // Apply hierarchy rules instead of percentage thresholds
                    can_suppress = false

                    if new_gap_type == GAP_TYPE_VOLUME  // VI can be suppressed by FVG, Implied, True
                        can_suppress := (existing_gap.gap_type == GAP_TYPE_FVG or existing_gap.gap_type == GAP_TYPE_IMPLIED or existing_gap.gap_type == GAP_TYPE_TRUE)
                    else if new_gap_type == GAP_TYPE_TRUE  // True Gap can be suppressed by FVG, Implied
                        can_suppress := (existing_gap.gap_type == GAP_TYPE_FVG or existing_gap.gap_type == GAP_TYPE_IMPLIED)
                    // FVG and Implied are never suppressed (institutional priority)

                    if can_suppress
                        should_suppress := true
                        break

        should_suppress

// Body helpers
bodyTop(o, c) => math.max(o, c)
bodyBot(o, c) => math.min(o, c)

// Text size conversion
get_text_size(size_string) =>
    switch size_string
        'Tiny' => size.tiny
        'Small' => size.small
        'Normal' => size.normal
        'Large' => size.large

// Function to check if consolidated SIF has immediate inversion
has_immediate_sif_inversion(consolidated_sif) =>
    has_inversion = false
    for i = 0 to array.size(consolidated_sif.sif_group) - 1
        sif_record = array.get(consolidated_sif.sif_group, i)
        if sif_record.is_immediate_sif_inversion
            has_inversion := true
            break
    has_inversion

// Enhanced border properties with immediate SIF inversion priority (similar to MBZ source gap wick detection)
get_border_properties_for_sif(consolidated_sif, sif_source_count) =>
    is_multi_source = enable_multi_source_highlighting and sif_source_count > 1
    has_immediate_inversion = has_immediate_sif_inversion(consolidated_sif)
    has_immediate_border = has_immediate_inversion and (immediate_sif_inversion_mode == IMMEDIATE_SIF_INVERSION_BORDER or immediate_sif_inversion_mode == IMMEDIATE_SIF_INVERSION_BOTH)

    default_border_color = consolidated_sif.is_bullish ? extended_box_bullish_color : extended_box_bearish_color

    // Determine final border properties (priority: immediate SIF inversion > multi-source > default)
    border_width_final = has_immediate_border ? immediate_inversion_border_width : is_multi_source ? multi_source_border_width : 1
    border_color_final = has_immediate_border ? immediate_sif_inversion_border_color : is_multi_source ? multi_source_border_color : default_border_color

    [border_width_final, border_color_final]

// Get root time from model name
get_root_model_time(model_name) =>
    switch model_name
        "09:30 New York Open" => [9, 30]
        "09:53 Judas" => [9, 53]
        "10:34 Model 11" => [10, 34]
        "11:10 Model 110" => [11, 10]
        "12:02 Lunch Model" => [12, 2]
        "12:35 Model 1001" => [12, 35]
        "13:30 Model 111" => [13, 30]
        => [9, 53]

// Auto-select closest root model
get_auto_root_model() =>
    ny_time = time("", "America/New_York")
    current_hour = hour(ny_time, "America/New_York")
    current_minute = minute(ny_time, "America/New_York")
    total_minutes = current_hour * 60 + current_minute
    
    if total_minutes >= 13*60 + 30
        "13:30 Model 111"
    else if total_minutes >= 12*60 + 35
        "12:35 Model 1001"
    else if total_minutes >= 12*60 + 2
        "12:02 Lunch Model"
    else if total_minutes >= 11*60 + 10
        "11:10 Model 110"
    else if total_minutes >= 10*60 + 34
        "10:34 Model 11"
    else if total_minutes >= 9*60 + 53
        "09:53 Judas"
    else
        "09:30 New York Open"

// Check if SIF should be filtered by root position
should_filter_sif_by_root(sif_high, sif_low, root_price) =>
    if not is_root_timeframe_valid or root_filter_mode == "Off" or na(root_price)
        false  // No filtering
    else
        sif_center = (sif_high + sif_low) / 2.0
        switch root_filter_mode
            "Above Root Only" => sif_center <= root_price  // Filter out SIFs at/below root
            "Below Root Only" => sif_center >= root_price  // Filter out SIFs at/above root
            => false


// Size helpers
get_sif_label_size() => get_text_size(sif_label_size)
get_invalidated_sif_size() => get_text_size(sif_invalidated_size)
get_label_size() => get_text_size(label_size)
get_extended_box_text_size() => get_text_size(extended_box_text_size)
get_wick_star_size() => get_text_size(wick_star_size)

// === VISUAL SUPPORT FUNCTIONS (8 functions) ===
// Line style conversion
get_line_style(style_string) =>
    switch style_string
        'Solid' => line.style_solid
        'Dashed' => line.style_dashed
        'Dotted' => line.style_dotted
        => line.style_solid

// Breach line style helper
get_sif_breached_line_style() => get_line_style(sif_breached_line_style)

// Invalidation line style helper
get_sif_invalidation_line_style() => get_line_style(sif_invalidation_line_style)

// Calculate breach level for SIF zone
get_sif_breach_level(zone_top, zone_bottom, is_bullish) =>
    zone_range = zone_top - zone_bottom
    breach_distance = (sif_breach_threshold_percent / 100.0) * zone_range
    if is_bullish
        zone_top - breach_distance
    else
        zone_bottom + breach_distance

// Get invalidation threshold percentage
get_sif_invalidation_threshold() =>
    switch sif_invalidation_mode
        INVALIDATION_STRICT => 55.0
        INVALIDATION_LENIENT => 85.0
        INVALIDATION_CUSTOM => custom_threshold_percent

// Calculate invalidation level for SIF zone
get_sif_invalidation_level(zone_top, zone_bottom, is_bullish) =>
    zone_range = zone_top - zone_bottom
    threshold_percent = get_sif_invalidation_threshold()
    invalidation_distance = (threshold_percent / 100.0) * zone_range
    if is_bullish
        zone_top - invalidation_distance
    else
        zone_bottom + invalidation_distance

// Get breach line color with transparency
get_sif_breached_line_color() =>
    color.new(sif_breached_line_color, sif_breached_line_transparency)

// Get invalidation line color with transparency
get_sif_invalidation_line_color() =>
    color.new(sif_invalidation_line_color, sif_invalidation_line_transparency)

// Check if SIF zone should show breach lines
should_show_sif_breached_lines(sif_record) =>
    enable_sif_breached_lines and enable_sif_breach_detection and not sif_record.is_invalidated

// Calculate zone penetration percentage using close price (for invalidation)
calculate_zone_penetration_from_close(close_price, zone_top, zone_bottom, is_bullish_zone) =>
    zone_range = zone_top - zone_bottom
    if zone_range <= 0
        0.0
    else
        if is_bullish_zone
            // Bullish zone: penetration is from top downward
            if close_price >= zone_top
                0.0  // No penetration
            else if close_price <= zone_bottom
                100.0  // Full penetration
            else
                penetration_distance = zone_top - close_price
                (penetration_distance / zone_range) * 100.0
        else
            // Bearish zone: penetration is from bottom upward
            if close_price <= zone_bottom
                0.0  // No penetration
            else if close_price >= zone_top
                100.0  // Full penetration
            else
                penetration_distance = close_price - zone_bottom
                (penetration_distance / zone_range) * 100.0

// Zone calculation based on subtype - MOVED UP for nested SIF detection
get_subtype_zone(sif_record) =>
    sif_subtype_contains_inclusion = str.contains(sif_record.sif_subtype, SUBTYPE_INCLUSION)
    sif_subtype_contains_reflection = str.contains(sif_record.sif_subtype, SUBTYPE_REFLECTION)

    if sif_subtype_contains_inclusion
        if sif_record.is_bullish
            [sif_record.sif_close, sif_record.sif_low]
        else
            [sif_record.sif_high, sif_record.sif_close]
    else if sif_subtype_contains_reflection
        if sif_record.is_bullish
            wick_range = math.abs(sif_record.sif_high - sif_record.sif_open)
            [sif_record.sif_close, sif_record.sif_close - wick_range]
        else
            wick_range = math.abs(sif_record.sif_low - sif_record.sif_open)
            [sif_record.sif_close + wick_range, sif_record.sif_close]
    else
        body_top = math.max(sif_record.sif_open, sif_record.sif_close)
        body_bottom = math.min(sif_record.sif_open, sif_record.sif_close)
        [body_top, body_bottom]

// Enhanced invalidation: Check BOTH open and close for gaps and penetration
should_sif_be_invalidated_enhanced(sif_record, current_open, current_close) =>
    invalidation_threshold = get_sif_invalidation_threshold()

    // Get the SAME zone that visuals use
    [zone_top, zone_bottom] = get_subtype_zone(sif_record)

    // CRITICAL: Check for OPENING GAPS first (immediate invalidation)
    if sif_record.is_bullish
        // SIF⁺: If candle opens BELOW zone bottom = instant invalidation
        if current_open < zone_bottom
            true  // GAPPED BELOW - IMMEDIATE INVALIDATION
        else
            // No gap - check close penetration normally
            penetration_percentage = calculate_zone_penetration_from_close(current_close, zone_top, zone_bottom, sif_record.is_bullish)
            penetration_percentage >= invalidation_threshold
    else
        // SIF⁻: If candle opens ABOVE zone top = instant invalidation
        if current_open > zone_top
            true  // GAPPED ABOVE - IMMEDIATE INVALIDATION
        else
            // No gap - check close penetration normally
            penetration_percentage = calculate_zone_penetration_from_close(current_close, zone_top, zone_bottom, sif_record.is_bullish)
            penetration_percentage >= invalidation_threshold

// Legacy function for backward compatibility (now calls enhanced version)
should_sif_be_invalidated(sif_record, confirmed_close_price) =>
    should_sif_be_invalidated_enhanced(sif_record, open, confirmed_close_price)


// ═══════════════════════════════════════════════════════════════════════════════
// SIMPLIFIED SUPER SIF DETECTION SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

// Detect if new SIF overlaps with any existing same-direction SIF
detect_sif_strength(new_sif_record) =>
    if not enable_nested_sifs or array.size(all_sif_records) == 0
        [false, 0.0, int(na)]
    else
        is_super = false
        stored_percentage = 0.0
        overlapped_bar = int(na)

        // OPTIMIZED: Limit scanning to recent records only (massive performance gain)
        if array.size(all_sif_records) > 0
            scan_limit = math.min(SUPER_SIF_SCAN_LIMIT, array.size(all_sif_records))
            start_index = math.max(0, array.size(all_sif_records) - scan_limit)

            for record_index = start_index to array.size(all_sif_records) - 1
                existing_sif = array.get(all_sif_records, record_index)
                if not existing_sif.is_invalidated and
                   existing_sif.bar_index < new_sif_record.bar_index and
                   existing_sif.is_bullish == new_sif_record.is_bullish  // SAME DIRECTION ONLY

                    // Quick range check before expensive zone calculation
                    if new_sif_record.sif_low < existing_sif.sif_high and
                       new_sif_record.sif_high > existing_sif.sif_low

                        // Use SAME zone logic as breach detection
                        [zone_top, zone_bottom] = get_subtype_zone(existing_sif)

                        // Check for actual overlap with zone
                        if new_sif_record.sif_low < zone_top and new_sif_record.sif_high > zone_bottom
                            // Calculate exact overlap percentage
                            overlap_top = math.min(new_sif_record.sif_high, zone_top)
                            overlap_bottom = math.max(new_sif_record.sif_low, zone_bottom)
                            overlap_range = overlap_top - overlap_bottom
                            new_sif_range = new_sif_record.sif_high - new_sif_record.sif_low

                            if new_sif_range > 0
                                overlap_pct = (overlap_range / new_sif_range) * 100

                                // Store the data - ANY overlap makes it SUPER
                                stored_percentage := overlap_pct
                                overlapped_bar := existing_sif.bar_index
                                is_super := true
                                break  // Take first overlap found

        [is_super, stored_percentage, overlapped_bar]

// Volume Imbalance gap coordinates for 2-candle structure
get_vi_coordinates(is_bullish_gap) =>
    if is_bullish_gap
        // Bullish VI: gap between C1 body top and C2 body bottom
        gap_bottom = math.max(open[1], close[1])  // C1 body top
        gap_top = math.min(open, close)           // C2 body bottom
        [gap_top, gap_bottom]
    else
        // Bearish VI: gap between C1 body bottom and C2 body top
        gap_top = math.min(open[1], close[1])     // C1 body bottom
        gap_bottom = math.max(open, close)        // C2 body top
        [gap_top, gap_bottom]

// Volume Imbalance Edge Case - Use >= for boundary overlap
is_vi_suppressed_by_gaps(vi_top, vi_bottom, is_vi_bullish) =>
    if array.size(active_gaps) == 0
        false
    else
        has_overlap = false
        for i = 0 to array.size(active_gaps) - 1
            gap = array.get(active_gaps, i)

            // Check for both regular FVGs AND implied FVGs (not volume) - institutional gap hierarchy
            if (gap.gap_type == GAP_TYPE_FVG or gap.gap_type == GAP_TYPE_IMPLIED) and gap.is_bullish == is_vi_bullish and not gap.is_inverted
                // Use >= for edge case where VI exactly touches gap boundary
                if vi_bottom < gap.top and vi_top >= gap.bottom
                    has_overlap := true
                    break  // Found overlap, VI will be suppressed
        has_overlap

// Check if True Gap overlaps with existing VI gaps (prevent double detection)
is_true_gap_suppressed_by_vi_gaps(tg_top, tg_bottom, is_tg_bullish) =>
    if array.size(active_gaps) == 0
        false
    else
        has_overlap = false
        for i = 0 to array.size(active_gaps) - 1
            gap = array.get(active_gaps, i)

            // Check for VI gaps with same direction (prevent double detection)
            if gap.gap_type == GAP_TYPE_VOLUME and gap.is_bullish == is_tg_bullish
                if tg_bottom >= gap.bottom and tg_top <= gap.top
                    has_overlap := true
                    break  // Found overlap, True Gap will be suppressed
        has_overlap

// Displacement validation
is_displacement_candle() =>
    c2_body_size = math.abs(close[1] - open[1])
    total_body_size = 0.0
    for i = 2 to (1 + lookback_candles)
        total_body_size += math.abs(close[i] - open[i])
    average_body_size = total_body_size / lookback_candles

    if average_body_size > 0
        c2_body_size >= (displacement_multiplier * average_body_size)
    else
        false

// Implied FVG Detection
detect_implied_fvg() =>
    has_bull_fvg = is_bullish_fvg()
    has_bear_fvg = is_bearish_fvg()

    if not is_displacement_candle()
        [false, float(na), float(na), bool(na)]
    else
        result_found = false
        result_bottom = float(na)
        result_top = float(na)
        result_bullish = bool(na)

        // Bullish IFVG Detection
        if not has_bull_fvg and not result_found
            c1_top = bodyTop(open[2], close[2])
            c3_bot = bodyBot(open, close)
            bull_wicks_present = (high[2] > c1_top) and (c3_bot > low)

            if bull_wicks_present
                overlap_lo = math.max(c1_top, low)
                overlap_hi = math.min(high[2], c3_bot)
                has_bull_overlap = overlap_hi > overlap_lo

                if has_bull_overlap and c1_top < c3_bot
                    result_found := true
                    result_bottom := c1_top
                    result_top := c3_bot
                    result_bullish := true

        // Bearish IFVG Detection
        if not has_bear_fvg and not result_found
            c1_bot = bodyBot(open[2], close[2])
            c3_top = bodyTop(open, close)
            bear_wicks_present = (c1_bot > low[2]) and (high > c3_top)

            if bear_wicks_present
                overlap_lo = math.max(low[2], c3_top)
                overlap_hi = math.min(c1_bot, high)
                has_bear_overlap = overlap_hi > overlap_lo

                if has_bear_overlap and c3_top < c1_bot
                    result_found := true
                    result_bottom := c3_top
                    result_top := c1_bot
                    result_bullish := false

        [result_found, result_bottom, result_top, result_bullish]

// ═══════════════════════════════════════════════════════════════════════════════
// GAP SOURCE AND SUBTYPE DISPLAY MAPPING
// ═══════════════════════════════════════════════════════════════════════════════

// Get display name for gap source (lowercase for labels)
get_gap_source_display(gap_type) =>
    switch gap_type
        GAP_TYPE_FVG => GAP_SOURCE_FVG_BREAKDOWN_DISPLAY  // FVG abbreviation for breakdown
        GAP_TYPE_IMPLIED => GAP_SOURCE_IMPLIED_DISPLAY
        GAP_TYPE_VOLUME => GAP_SOURCE_VOLUME_DISPLAY
        GAP_TYPE_TRUE => GAP_SOURCE_TRUE_DISPLAY
        => EMPTY_DISPLAY

// Get display name for subtype with arrows (lowercase for labels)
get_subtype_display(sif_subtype, is_bullish) =>
    if str.contains(sif_subtype, SUBTYPE_INCLUSION)
        if is_bullish
            ARROW_DOWN_INC  // Bullish inclusion = lower wick dominant (toward body)
        else
            ARROW_UP_INC  // Bearish inclusion = upper wick dominant (toward body)
    else if str.contains(sif_subtype, SUBTYPE_REFLECTION)
        if is_bullish
            ARROW_UP_REF  // Bullish reflection = upper wick dominant (away from body)
        else
            ARROW_DOWN_REF  // Bearish reflection = lower wick dominant (away from body)
    else
        EMPTY_DISPLAY  // No suffix for standard

// Get display name for subtype with risk indicator properly positioned after behavior
get_risky_subtype_display(sif_subtype, is_bullish, is_risky) =>
    if str.contains(sif_subtype, SUBTYPE_INCLUSION)
        if is_bullish
            is_risky ? ARROW_DOWN_INC_RISKY : ARROW_DOWN_INC
        else
            is_risky ? ARROW_UP_INC_RISKY : ARROW_UP_INC
    else if str.contains(sif_subtype, SUBTYPE_REFLECTION)
        if is_bullish
            is_risky ? ARROW_UP_REF_RISKY : ARROW_UP_REF
        else
            is_risky ? ARROW_DOWN_REF_RISKY : ARROW_DOWN_REF
    else
        EMPTY_DISPLAY  // No suffix for standard

// ═══════════════════════════════════════════════════════════════════════════════
// ADVANCED SIF ANALYSIS
// ═══════════════════════════════════════════════════════════════════════════════

// Wick dominance classification - determines SIF quality based on wick-to-body ratios
classify_wick_dominance(body_size, upper_wick, lower_wick) =>
    if body_size <= 0
        [WICK_TIER_NONE, false]
    else
        upper_ratio = upper_wick / body_size
        lower_ratio = lower_wick / body_size
        max_ratio = math.max(upper_ratio, lower_ratio)

        if max_ratio >= 1.0
            [WICK_TIER_STANDARD, true]
        else if max_ratio >= 0.85
            [WICK_TIER_RELAXED, true]
        else if max_ratio >= 0.80
            [WICK_TIER_RISKY, true]
        else
            [WICK_TIER_NONE, false]

// ENHANCED: Advanced SIF subtype detection with simple majority wick classification
// Uses clear majority rule: biggest wick wins, no tie-breaking complexity
detect_sif_subtype(sif_open, sif_close, sif_high, sif_low, source_gap_type) =>
    body_top = math.max(sif_open, sif_close)
    body_bottom = math.min(sif_open, sif_close)
    body_size = body_top - body_bottom
    upper_wick = sif_high - body_top
    lower_wick = body_bottom - sif_low
    is_candle_bullish = sif_close > sif_open

    // Determine base classification from source type
    base_classification = SUBTYPE_STANDARD
    if source_gap_type == GAP_TYPE_IMPLIED and enable_implied
        base_classification := SUBTYPE_IMPLIED
    else if source_gap_type == GAP_TYPE_VOLUME and enable_volume_imbalance
        base_classification := SUBTYPE_VOLUME
    else if source_gap_type == GAP_TYPE_TRUE and enable_true_gaps
        base_classification := SUBTYPE_TRUE

    // Check wick dominance
    [wick_tier, has_dominant] = classify_wick_dominance(body_size, upper_wick, lower_wick)

    if not has_dominant
        [base_classification, false]
    else
        // SIMPLE MAJORITY RULE: Biggest wick wins, exact ties favor inclusion patterns
        is_exact_tie = upper_wick == lower_wick
        upper_is_dominant = false  // Declare variable first

        if is_exact_tie
            // TIE-BREAKING LOGIC: When upper_wick == lower_wick (exact tie)
            // Design decision: All ties result in INCLUSION patterns for consistency
            // - Bullish ties: Force lower wick dominance → inclusion pattern → "inc-tie"
            // - Bearish ties: Force upper wick dominance → inclusion pattern → "inc-tie"
            // This ensures predictable, uniform behavior regardless of candle direction
            upper_is_dominant := not is_candle_bullish  // Bullish ties→lower dominant, Bearish ties→upper dominant
        else
            // CLEAR DOMINANCE: Standard comparison when wicks are different sizes
            upper_is_dominant := upper_wick > lower_wick

        // Determine wick pattern using simple majority
        wick_pattern = ""
        pattern_enabled = false

        // SIMPLE MAJORITY CLASSIFICATION: Clear, predictable wick-based subtyping
        // Note: Due to tie-breaking logic above, ties can ONLY result in inclusion patterns
        // - Bullish ties: upper_is_dominant=false → takes inclusion path → "inc-tie"
        // - Bearish ties: upper_is_dominant=true → takes inclusion path → "inc-tie"
        // Therefore, "reflection-tie" is impossible and was removed as dead code

        if is_candle_bullish
            if upper_is_dominant and enable_reflection
                // Bullish + upper wick dominance = reflection (clear dominance only, never ties)
                wick_pattern := SUBTYPE_REFLECTION
                pattern_enabled := true
            else if not upper_is_dominant and enable_inclusion
                // Bullish + lower wick dominance = inclusion (clear dominance OR ties)
                wick_pattern := is_exact_tie ? SUBTYPE_INCLUSION_TIE : SUBTYPE_INCLUSION
                pattern_enabled := true
        else
            if upper_is_dominant and enable_inclusion
                // Bearish + upper wick dominance = inclusion (clear dominance OR ties)
                wick_pattern := is_exact_tie ? SUBTYPE_INCLUSION_TIE : SUBTYPE_INCLUSION
                pattern_enabled := true
            else if not upper_is_dominant and enable_reflection
                // Bearish + lower wick dominance = reflection (clear dominance only, never ties)
                wick_pattern := SUBTYPE_REFLECTION
                pattern_enabled := true

        // Combine base classification with wick pattern
        if pattern_enabled
            final_subtype = ""
            if base_classification == SUBTYPE_IMPLIED
                final_subtype := SUBTYPE_IMPLIED + "_" + wick_pattern
            else if base_classification == SUBTYPE_VOLUME
                final_subtype := SUBTYPE_VOLUME + "_" + wick_pattern
            else if base_classification == SUBTYPE_TRUE
                final_subtype := SUBTYPE_TRUE + "_" + wick_pattern
            else
                final_subtype := wick_pattern
            [final_subtype, true]
        else
            [base_classification, false]

// ═══════════════════════════════════════════════════════════════════════════════
// ZONE CALCULATION FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// Calculate zone penetration percentage using extreme prices (low/high)
calculate_zone_penetration_from_extreme(test_price, zone_top, zone_bottom, is_bullish_zone) =>
    zone_range = zone_top - zone_bottom
    if zone_range <= 0
        0.0
    else
        if is_bullish_zone
            // SIF⁺: penetration comes from above downward → use low
            if test_price >= zone_top
                0.0  // No penetration
            else if test_price <= zone_bottom
                100.0  // Full penetration
            else
                penetration_distance = zone_top - test_price
                (penetration_distance / zone_range) * 100.0
        else
            // SIF⁻: penetration comes from below upward → use high
            if test_price <= zone_bottom
                0.0  // No penetration
            else if test_price >= zone_top
                100.0  // Full penetration
            else
                penetration_distance = test_price - zone_bottom
                (penetration_distance / zone_range) * 100.0

// Calculate zone penetration percentage using candle body for SIF
calculate_sif_zone_penetration_from_body(open_price, close_price, zone_top, zone_bottom, is_bullish_zone) =>
    zone_range = zone_top - zone_bottom
    if zone_range <= 0
        0.0
    else
        if is_bullish_zone
            // Bullish zone: use LOWER of open/close for deepest penetration from above
            test_price = math.min(open_price, close_price)
            if test_price >= zone_top
                0.0  // No penetration
            else if test_price <= zone_bottom
                100.0  // Full penetration
            else
                penetration_distance = zone_top - test_price
                (penetration_distance / zone_range) * 100.0
        else
            // Bearish zone: use HIGHER of open/close for deepest penetration from below
            test_price = math.max(open_price, close_price)
            if test_price <= zone_bottom
                0.0  // No penetration
            else if test_price >= zone_top
                100.0  // Full penetration
            else
                penetration_distance = test_price - zone_bottom
                (penetration_distance / zone_range) * 100.0

// Validated breach threshold - ensures breach is always below invalidation
get_validated_sif_breach_threshold() =>
    invalidation_threshold = get_sif_invalidation_threshold()
    sif_breach_threshold_percent < invalidation_threshold ? sif_breach_threshold_percent : invalidation_threshold * 0.95

// Real-time breach detection using subtype zones and selected method
is_sif_currently_breached(sif_record) =>
    // CRITICAL: Never show breach if disabled or in these cases:
    if not enable_sif_breach_detection or sif_record.is_invalidated or bar_index == sif_record.bar_index
        false
    else
        validated_breach_threshold = get_validated_sif_breach_threshold()
        // Get the SAME zone that visuals use
        [zone_top, zone_bottom] = get_subtype_zone(sif_record)

        // Calculate penetration based on selected breach method
        current_penetration = sif_breach_method == BREACH_METHOD_BODY_BREACH ? calculate_sif_zone_penetration_from_body(open, close, zone_top, zone_bottom, sif_record.is_bullish) : calculate_zone_penetration_from_extreme(sif_record.is_bullish ? low : high, zone_top, zone_bottom, sif_record.is_bullish)

        // Show breach if penetration meets or exceeds validated breach threshold
        current_penetration >= validated_breach_threshold

// Calculate current breach percentage for tooltip display
get_current_sif_breach_percentage(sif_record) =>
    if sif_record.is_invalidated or barstate.isconfirmed or bar_index == sif_record.bar_index
        0.0
    else
        // Get the SAME zone that visuals use
        [zone_top, zone_bottom] = get_subtype_zone(sif_record)

        // Calculate penetration based on selected breach method
        current_penetration = sif_breach_method == BREACH_METHOD_BODY_BREACH ? calculate_sif_zone_penetration_from_body(open, close, zone_top, zone_bottom, sif_record.is_bullish) : calculate_zone_penetration_from_extreme(sif_record.is_bullish ? low : high, zone_top, zone_bottom, sif_record.is_bullish)

        current_penetration

// Calculate current breach percentage for consolidated SIF
get_consolidated_sif_breach_percentage(consolidated_sif) =>
    if consolidated_sif.is_consolidated_invalidated or array.size(consolidated_sif.sif_group) == 0
        0.0
    else
        // Use the first SIF for zone calculation (all should have same zone)
        first_sif = array.get(consolidated_sif.sif_group, 0)
        [zone_top, zone_bottom] = get_subtype_zone(first_sif)

        // Calculate penetration based on selected breach method
        current_penetration = sif_breach_method == BREACH_METHOD_BODY_BREACH ? calculate_sif_zone_penetration_from_body(open, close, zone_top, zone_bottom, consolidated_sif.is_bullish) : calculate_zone_penetration_from_extreme(consolidated_sif.is_bullish ? low : high, zone_top, zone_bottom, consolidated_sif.is_bullish)

        current_penetration

// ═══════════════════════════════════════════════════════════════════════════════
// CONSOLIDATION SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

// Group SIFs by candle (bar_index)
group_sifs_by_candle(sif_records) =>
    grouped_sifs = array.new<ConsolidatedSIF>()

    if array.size(sif_records) == 0
        grouped_sifs
    else
        // Create map-like structure using arrays
        processed_candles = array.new<int>()

        for i = 0 to array.size(sif_records) - 1
            sif_record = array.get(sif_records, i)
            current_bar = sif_record.bar_index

            // Check if we already processed this candle
            if not array.includes(processed_candles, current_bar)
                // Collect all SIFs for this candle
                candle_sifs = array.new<SIFRecord>()

                for j = 0 to array.size(sif_records) - 1
                    other_sif = array.get(sif_records, j)
                    if other_sif.bar_index == current_bar
                        array.push(candle_sifs, other_sif)

                // Create consolidated SIF if we have any records
                if array.size(candle_sifs) > 0
                    first_sif = array.get(candle_sifs, 0)
                    // Initialize placeholders; derived values computed below
                    consolidated = ConsolidatedSIF.new(
                         candle_sifs,
                         current_bar,
                         first_sif.is_bullish,  // All SIFs on same candle have same direction
                         0.0,
                         0.0,
                         false,
                         false,
                         "",
                         ""
                     )
                    array.push(grouped_sifs, consolidated)
                    array.push(processed_candles, current_bar)

                    // Note: Multi-source alert flags are set during SIF creation
                    // to avoid assigning globals from within a function.

        grouped_sifs

// Calculate consolidated zone boundaries (outermost limits)
calculate_consolidated_zone_boundaries(sif_group) =>
    if array.size(sif_group) == 0
        [float(na), float(na)]
    else
        zone_top = -999999.0
        zone_bottom = 999999.0

        for i = 0 to array.size(sif_group) - 1
            sif_record = array.get(sif_group, i)
            [individual_top, individual_bottom] = get_subtype_zone(sif_record)

            if individual_top > zone_top
                zone_top := individual_top
            if individual_bottom < zone_bottom
                zone_bottom := individual_bottom

        [zone_top, zone_bottom]

// Determine consolidated status for group
determine_consolidated_status(consolidated_sif) =>
    invalidation_threshold = get_sif_invalidation_threshold()
    is_breached = false
    is_invalidated = false

    // First check if any SIF in group is already invalidated
    for i = 0 to array.size(consolidated_sif.sif_group) - 1
        sif = array.get(consolidated_sif.sif_group, i)
        if sif.is_invalidated
            is_invalidated := true
            break

    if not is_invalidated and enable_sif_breach_detection
        // Check breach using breach threshold (both real-time and historical) - exclude formation candle
        if bar_index != consolidated_sif.bar_index
            validated_breach_threshold = get_validated_sif_breach_threshold()

            // For current bar, check real-time price using selected breach method
            current_penetration = sif_breach_method == BREACH_METHOD_BODY_BREACH ? calculate_sif_zone_penetration_from_body(open, close, consolidated_sif.consolidated_zone_top, consolidated_sif.consolidated_zone_bottom, consolidated_sif.is_bullish) : calculate_zone_penetration_from_extreme(consolidated_sif.is_bullish ? low : high, consolidated_sif.consolidated_zone_top, consolidated_sif.consolidated_zone_bottom, consolidated_sif.is_bullish)

            // Check if current bar breached
            if current_penetration >= validated_breach_threshold
                is_breached := true
            else
                // For old SIFs, check historical breach by looking back from formation
                bars_since_formation = bar_index - consolidated_sif.bar_index
                if bars_since_formation > 1  // Only check history for old SIFs
                    historical_breach_found = false
                    // Look back through bars since formation (but not beyond formation)
                    max_lookback = math.min(bars_since_formation - 1, 500)  // Limit to bars since formation or 500, whichever is smaller
                    for i = 1 to max_lookback
                        historical_penetration = sif_breach_method == BREACH_METHOD_BODY_BREACH ? calculate_sif_zone_penetration_from_body(open[i], close[i], consolidated_sif.consolidated_zone_top, consolidated_sif.consolidated_zone_bottom, consolidated_sif.is_bullish) : calculate_zone_penetration_from_extreme(consolidated_sif.is_bullish ? low[i] : high[i], consolidated_sif.consolidated_zone_top, consolidated_sif.consolidated_zone_bottom, consolidated_sif.is_bullish)
                        if historical_penetration >= validated_breach_threshold
                            historical_breach_found := true
                            break
                    is_breached := historical_breach_found

    // Check invalidation (confirmed close) - both current and historical
    if not is_invalidated and barstate.isconfirmed
        // Check current bar first
        current_penetration = calculate_zone_penetration_from_close(
             close,
             consolidated_sif.consolidated_zone_top,
             consolidated_sif.consolidated_zone_bottom,
             consolidated_sif.is_bullish
         )
        invalidation_threshold := get_sif_invalidation_threshold()
        if current_penetration >= invalidation_threshold
            is_invalidated := true

    [is_breached, is_invalidated]

// ═══════════════════════════════════════════════════════════════════════════════
// CONSOLIDATED LABEL BUILDING SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

// Count source types for consolidated display
// Count source types for consolidated display - ONLY ENABLED SOURCES
count_source_types(sif_group) =>
    fvg_count = 0
    imp_count = 0
    vol_count = 0
    true_count = 0

    for i = 0 to array.size(sif_group) - 1
        sif_record = array.get(sif_group, i)

        // Only count if source is enabled
        if str.contains(sif_record.sif_subtype, SUBTYPE_IMPLIED) and enable_implied
            imp_count += 1
        else if str.contains(sif_record.sif_subtype, SUBTYPE_VOLUME) and enable_volume_imbalance
            vol_count += 1
        else if str.contains(sif_record.sif_subtype, SUBTYPE_TRUE) and enable_true_gaps
            true_count += 1
        else if (sif_record.sif_subtype == SUBTYPE_STANDARD or str.contains(sif_record.sif_subtype, SUBTYPE_INCLUSION) or str.contains(sif_record.sif_subtype, SUBTYPE_REFLECTION)) and enable_fair_value_gaps
            fvg_count += 1

    [fvg_count, imp_count, vol_count, true_count]

// Check if any SIF in group is SUPER
has_super_sifs(sif_group) =>
    has_super = false

    for i = 0 to array.size(sif_group) - 1
        sif_record = array.get(sif_group, i)
        if sif_record.is_super_sif
            has_super := true
            break

    has_super

// Build source breakdown with extension logic
build_source_breakdown_extension(sif_group) =>
    [fvg_count, imp_count, vol_count, true_count] = count_source_types(sif_group)
    sif_count = array.size(sif_group)

    // Count how many different types we have
    types_present = (fvg_count > 0 ? 1 : 0) + (imp_count > 0 ? 1 : 0) + (vol_count > 0 ? 1 : 0) + (true_count > 0 ? 1 : 0)

    if types_present == 1
        // All same type: just show "fvg×2", "vol×3", etc. (no redundant total count)
        // EXTENSION SINGLE TYPE: FVG special handling for clean displays
        if fvg_count > 0
            if fvg_count == 1
                ""  // Single FVG alone: EMPTY for invisible extension (clean look)
            else
                GAP_SOURCE_FVG_BREAKDOWN_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(fvg_count)  // Multiple FVGs: "fvg×2"
        else if imp_count > 0
            if imp_count == 1
                GAP_SOURCE_IMPLIED_DISPLAY
            else
                GAP_SOURCE_IMPLIED_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(imp_count)
        else if vol_count > 0
            if vol_count == 1
                GAP_SOURCE_VOLUME_DISPLAY
            else
                GAP_SOURCE_VOLUME_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(vol_count)
        else if true_count > 0
            if true_count == 1
                GAP_SOURCE_TRUE_DISPLAY
            else
                GAP_SOURCE_TRUE_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(true_count)
        else
            ""
    else
        // Multiple types: show total count and breakdown, drop ×1 for cleaner display
        parts = array.new<string>()

        // EXTENSION MULTIPLE TYPES: FVG becomes visible when mixed with other gap types
        if fvg_count > 0
            if fvg_count == 1
                array.push(parts, GAP_SOURCE_FVG_BREAKDOWN_DISPLAY)  // Single FVG mixed: show "fvg" (e.g., "2: fvg, vol")
            else
                array.push(parts, GAP_SOURCE_FVG_BREAKDOWN_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(fvg_count))  // Multiple FVGs mixed: "3: fvg×2, vol"

        if imp_count > 0
            if imp_count == 1
                array.push(parts, GAP_SOURCE_IMPLIED_DISPLAY)  // Drop ×1
            else
                array.push(parts, GAP_SOURCE_IMPLIED_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(imp_count))

        if vol_count > 0
            if vol_count == 1
                array.push(parts, GAP_SOURCE_VOLUME_DISPLAY)  // Drop ×1
            else
                array.push(parts, GAP_SOURCE_VOLUME_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(vol_count))

        if true_count > 0
            if true_count == 1
                array.push(parts, GAP_SOURCE_TRUE_DISPLAY)  // Drop ×1
            else
                array.push(parts, GAP_SOURCE_TRUE_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(true_count))

        // Join with commas
        breakdown = ""
        for i = 0 to array.size(parts) - 1
            if i > 0
                breakdown := breakdown + BREAKDOWN_SEPARATOR
            breakdown := breakdown + array.get(parts, i)

        // Show total count for different types: "2: fvg, vol" or "5: fvg×3, vol, imp"
        str.tostring(sif_count) + COUNT_SEPARATOR + breakdown

// Build source breakdown with counts - USED for candle label logic (Original)
build_source_breakdown(sif_group) =>
    [fvg_count, imp_count, vol_count, true_count] = count_source_types(sif_group)

    parts = array.new<string>()

    // SPECIAL FVG LOGIC: FVGs are invisible when alone, visible when mixed with others
    // This creates clean labels like "SIF⁺" instead of "SIF⁺ (fvg)" for single FVG cases
    if fvg_count > 0
        types_present_count = (fvg_count > 0 ? 1 : 0) + (imp_count > 0 ? 1 : 0) + (vol_count > 0 ? 1 : 0) + (true_count > 0 ? 1 : 0)
        if fvg_count == 1 and types_present_count == 1
            // Single FVG alone: INVISIBLE - don't add to parts array for clean "SIF+" display
            na  // No-op: intentionally empty branch
        else if fvg_count == 1
            // Single FVG mixed with others: show "fvg" (e.g., "SIF⁺ (fvg, vol)")
            array.push(parts, GAP_SOURCE_FVG_BREAKDOWN_DISPLAY)
        else
            // Multiple FVGs: show "fvg×2", "fvg×3", etc.
            array.push(parts, GAP_SOURCE_FVG_BREAKDOWN_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(fvg_count))

    if imp_count > 0
        if imp_count == 1
            array.push(parts, GAP_SOURCE_IMPLIED_DISPLAY)
        else
            array.push(parts, GAP_SOURCE_IMPLIED_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(imp_count))

    if vol_count > 0
        if vol_count == 1
            array.push(parts, GAP_SOURCE_VOLUME_DISPLAY)
        else
            array.push(parts, GAP_SOURCE_VOLUME_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(vol_count))

    if true_count > 0
        if true_count == 1
            array.push(parts, GAP_SOURCE_TRUE_DISPLAY)
        else
            array.push(parts, GAP_SOURCE_TRUE_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(true_count))

    // Join with commas
    result = ""
    for i = 0 to array.size(parts) - 1
        if i > 0
            result := result + ", "
        result := result + array.get(parts, i)

    result

// Get unified subtype for entire group - ONLY USED WHEN show_label_details = true
get_unified_subtype(sif_group) =>
    if array.size(sif_group) == 0
        ["", false]
    else
        first_sif = array.get(sif_group, 0)
        subtype_display = get_subtype_display(first_sif.sif_subtype, first_sif.is_bullish)

        // Get wick tier for risk indicator
        body_top = math.max(first_sif.sif_open, first_sif.sif_close)
        body_bottom = math.min(first_sif.sif_open, first_sif.sif_close)
        body_size = body_top - body_bottom
        upper_wick = first_sif.sif_high - body_top
        lower_wick = body_bottom - first_sif.sif_low
        [wick_tier, has_wick_dominance] = classify_wick_dominance(body_size, upper_wick, lower_wick)

        risky_prefix = wick_tier == WICK_TIER_RISKY ? "*" : ""
        is_risky = risky_prefix != ""

        final_subtype = ""
        if subtype_display != ""
            final_subtype := get_risky_subtype_display(first_sif.sif_subtype, first_sif.is_bullish, is_risky)

        [final_subtype, is_risky]

// Create consolidated candle label with SIMPLIFIED SUPER SIF support
// CANDLE LABEL ORDER (stacked):
// 1. Base direction: SIF+ / SIF-
// 2. Multi-count: (3), (4) etc. (if 3+ SIFs)
// 3. Gap sources: (vol), (imp), (fvg×2) etc.
// 4. Subtypes with risk: ↓inc*, ↑ref* (risk asterisk AFTER behavior)
// 5. Special properties: ☆ (immediate SIF inversion) - BEFORE status
// 6. Status indicators: [BREACHED], [X] (ALWAYS LAST)
create_consolidated_candle_label(consolidated_sif) =>
    sif_count = array.size(consolidated_sif.sif_group)

    // Check for same-candle closure in group
    has_immediate_sif_inversion = false
    for i = 0 to array.size(consolidated_sif.sif_group) - 1
        sif_record = array.get(consolidated_sif.sif_group, i)
        if sif_record.is_immediate_sif_inversion
            has_immediate_sif_inversion := true
            break

    // Determine base direction for candle label
    direction = consolidated_sif.is_bullish ? SIF_PLUS : SIF_MINUS

    // Check for SUPER SIFs in group
    has_super = has_super_sifs(consolidated_sif.sif_group)

    // Handle Arrow Only Mode - return just arrows
    if sif_symbol_type == DISPLAY_MODE_ARROW_ONLY
        consolidated_sif.is_bullish ? "▲" : "▼"
    else
        // Build candle label parts
        label_parts = array.new<string>()

        // Add direction arrow for Arrow + Text mode
        if sif_symbol_type == DISPLAY_MODE_ARROW_TEXT
            arrow = consolidated_sif.is_bullish ? "▲" : "▼"
            array.push(label_parts, arrow)

        // Always use normal SIF text for candle labels (SUPER indicated in extension only)
        sif_text = direction

        array.push(label_parts, sif_text)

        // Threshold-based candle labels (same as before)
        if show_label_details
            if sif_count >= 3
                // 3+ SIFs: Just show count (3), (4), etc.
                array.push(label_parts, "(" + str.tostring(sif_count) + ")")
            else if sif_count == 2
                // 2 SIFs: Check if same or different types
                [fvg_count, imp_count, vol_count, true_count] = count_source_types(consolidated_sif.sif_group)
                types_present = (fvg_count > 0 ? 1 : 0) + (imp_count > 0 ? 1 : 0) + (vol_count > 0 ? 1 : 0) + (true_count > 0 ? 1 : 0)

                if types_present == 1
                    // Same type: (fvg×2), (vol×2), (imp×2), (gap×2)
                    if fvg_count == 2
                        array.push(label_parts, "(fvg×2)")
                    else if imp_count == 2
                        array.push(label_parts, "(imp×2)")
                    else if vol_count == 2
                        array.push(label_parts, "(vol×2)")
                    else if true_count == 2
                        array.push(label_parts, "(gap×2)")
                else
                    // Different types: (fvg, vol), (fvg, imp), (vol, imp), (gap, fvg), etc.
                    type_list = array.new<string>()
                    if fvg_count > 0
                        array.push(type_list, GAP_SOURCE_FVG_BREAKDOWN_DISPLAY)
                    if imp_count > 0
                        array.push(type_list, GAP_SOURCE_IMPLIED_DISPLAY)
                    if vol_count > 0
                        array.push(type_list, GAP_SOURCE_VOLUME_DISPLAY)
                    if true_count > 0
                        array.push(type_list, GAP_SOURCE_TRUE_DISPLAY)

                    // Build type string based on array size
                    type_string = ""
                    if array.size(type_list) >= 2
                        type_string := array.get(type_list, 0) + ", " + array.get(type_list, 1)
                    else
                        type_string := array.get(type_list, 0)
                    array.push(label_parts, "(" + type_string + ")")
            else
                // Single SIF - only show gap source if NOT standard FVG
                single_sif = array.get(consolidated_sif.sif_group, 0)

                // Add gap source for single non-FVG SIFs (preserving FVG base behavior)
                gap_source = ""
                if str.contains(single_sif.sif_subtype, SUBTYPE_IMPLIED)
                    gap_source := GAP_SOURCE_IMPLIED_DISPLAY
                else if str.contains(single_sif.sif_subtype, SUBTYPE_VOLUME)
                    gap_source := GAP_SOURCE_VOLUME_DISPLAY
                else if str.contains(single_sif.sif_subtype, SUBTYPE_TRUE)
                    gap_source := GAP_SOURCE_TRUE_DISPLAY
                // FVG shows nothing (default/implied)

                if gap_source != ""
                    array.push(label_parts, "(" + gap_source + ")")

                // Add subtype if not standard
                subtype_display = get_subtype_display(single_sif.sif_subtype, single_sif.is_bullish)
                if subtype_display != ""
                    // Add risk indicator only for non-standard subtypes
                    body_top = math.max(single_sif.sif_open, single_sif.sif_close)
                    body_bottom = math.min(single_sif.sif_open, single_sif.sif_close)
                    body_size = body_top - body_bottom
                    upper_wick = single_sif.sif_high - body_top
                    lower_wick = body_bottom - single_sif.sif_low
                    [wick_tier, has_wick_dominance] = classify_wick_dominance(body_size, upper_wick, lower_wick)

                    is_risky = wick_tier == WICK_TIER_RISKY
                    risky_subtype = get_risky_subtype_display(single_sif.sif_subtype, single_sif.is_bullish, is_risky)
                    array.push(label_parts, risky_subtype)

            // Add unified subtype for multiple SIFs (all SIFs on same candle have same subtype)
            if sif_count > 1
                [unified_subtype, is_risky] = get_unified_subtype(consolidated_sif.sif_group)
                if unified_subtype != ""
                    array.push(label_parts, unified_subtype)

        // Add special properties (immediate SIF inversion, etc.)
        has_immediate_inversion = has_immediate_sif_inversion(consolidated_sif)
        if has_immediate_inversion and (immediate_sif_inversion_mode == IMMEDIATE_SIF_INVERSION_STAR or immediate_sif_inversion_mode == IMMEDIATE_SIF_INVERSION_BOTH)
            array.push(label_parts, IMMEDIATE_SIF_INVERSION_SYMBOL)

        // Add status indicators (ALWAYS LAST - after special properties)
        if consolidated_sif.is_consolidated_breached
            array.push(label_parts, "[BREACHED]")
        if consolidated_sif.is_consolidated_invalidated
            array.push(label_parts, "[X]")

        // Bearish Order - reverse the parts for SIF⁻
        if not consolidated_sif.is_bullish and array.size(label_parts) > 0
            // Reverse the array for bearish stacking
            reversed_parts = array.new<string>()
            for i = array.size(label_parts) - 1 to 0 by 1
                array.push(reversed_parts, array.get(label_parts, i))
            label_parts := reversed_parts

        // Join with newlines for vertical stacking
        result = ""
        for i = 0 to array.size(label_parts) - 1
            if i > 0
                result := result + "\n"
            result := result + array.get(label_parts, i)

        result

// Create consolidated extension label with SIMPLIFIED SUPER SIF support
// EXTENSION LABEL ORDER:
// 1. Base direction OR SUPER: SIF+ or ✔️ SIF+
// 2. Gap sources: (fvg), (vol), (imp,vol) etc.
// 3. Subtypes with risk: ↓inc*, ↑ref* (risk asterisk AFTER behavior)
// 4. Special properties: ☆ (immediate SIF inversion) - BEFORE status
// 5. Status indicators: [BREACHED], [X] (ALWAYS LAST)
create_consolidated_extension_label(consolidated_sif) =>
    sif_count = array.size(consolidated_sif.sif_group)

    // Standard direction for extension label (no prefix)
    direction = consolidated_sif.is_bullish ? SIF_PLUS : SIF_MINUS

    extension_result = ""

    // Check for SUPER SIFs in group
    has_super = has_super_sifs(consolidated_sif.sif_group)

    // Only show advanced info when show_label_details = true
    if show_label_details
        if sif_count == 1
            // Single SIF - only show gap source if NOT standard FVG (fvg is implied)
            single_sif = array.get(consolidated_sif.sif_group, 0)
            gap_source = ""
            if str.contains(single_sif.sif_subtype, SUBTYPE_IMPLIED)
                gap_source := " imp"
            else if str.contains(single_sif.sif_subtype, SUBTYPE_VOLUME)
                gap_source := " vol"
            // Standard FVG gets no gap source (implied)

            // Get subtype
            subtype_display = get_subtype_display(single_sif.sif_subtype, single_sif.is_bullish)

            // Get risk indicator
            body_top = math.max(single_sif.sif_open, single_sif.sif_close)
            body_bottom = math.min(single_sif.sif_open, single_sif.sif_close)
            body_size = body_top - body_bottom
            upper_wick = single_sif.sif_high - body_top
            lower_wick = body_bottom - single_sif.sif_low
            [wick_tier, has_wick_dominance] = classify_wick_dominance(body_size, upper_wick, lower_wick)
            risky_prefix = wick_tier == WICK_TIER_RISKY ? "*" : ""

            // Apply checkmark for SUPER SIFs in extensions
            sif_text = if single_sif.is_super_sif
                "✔️ SIF" + (consolidated_sif.is_bullish ? "+" : "-")  // Checkmark for SUPER
            else
                direction  // Normal

            // Build inline extension label (no newlines for subtype)
            extension_result := sif_text + gap_source
            if subtype_display != ""
                is_risky = risky_prefix != ""
                risky_subtype = get_risky_subtype_display(single_sif.sif_subtype, single_sif.is_bullish, is_risky)
                extension_result := extension_result + " " + risky_subtype
        else
            // Multiple SIFs - use extension breakdown logic
            source_breakdown = build_source_breakdown_extension(consolidated_sif.sif_group)

            // Apply checkmark for SUPER SIFs in extensions
            sif_text = if has_super
                "✔️ SIF" + (consolidated_sif.is_bullish ? "+" : "-")  // Checkmark for SUPER
            else
                direction  // Normal

            extension_result := sif_text + " (" + source_breakdown + ")"

            // Add unified subtype inline (not on new line)
            [unified_subtype, is_risky] = get_unified_subtype(consolidated_sif.sif_group)
            if unified_subtype != ""
                extension_result := extension_result + " " + unified_subtype
    else
        // When advanced labels are OFF, show clean SIF+/SIF- with checkmark for SUPER
        extension_result := if has_super
            "✔️ SIF" + (consolidated_sif.is_bullish ? "+" : "-")  // Checkmark for SUPER
        else
            direction  // Normal

    // Add special properties (immediate SIF inversion, etc.)
    has_immediate_inversion = has_immediate_sif_inversion(consolidated_sif)
    if has_immediate_inversion and (immediate_sif_inversion_mode == IMMEDIATE_SIF_INVERSION_STAR or immediate_sif_inversion_mode == IMMEDIATE_SIF_INVERSION_BOTH)
        extension_result := extension_result + " " + IMMEDIATE_SIF_INVERSION_SYMBOL

    // Add status indicators (always last - after special properties)
    if consolidated_sif.is_consolidated_breached
        extension_result := extension_result + " [BREACHED]"
    if consolidated_sif.is_consolidated_invalidated
        extension_result := extension_result + " [X]"

    extension_result

// Build consolidated tooltip with SIMPLIFIED SUPER SIF info
build_consolidated_tooltip(consolidated_sif) =>
    sif_count = array.size(consolidated_sif.sif_group)

    // Start with behavior-first format: "Inclusion SIF⁺" or "Reflection SIF⁺" with risk prefix
    behavior_text = ""
    if sif_count > 0
        first_sif = array.get(consolidated_sif.sif_group, 0)

        // Calculate risk level for behavior
        body_size = math.abs(first_sif.sif_close - first_sif.sif_open)
        body_top = math.max(first_sif.sif_open, first_sif.sif_close)
        body_bottom = math.min(first_sif.sif_open, first_sif.sif_close)
        upper_wick = first_sif.sif_high - body_top
        lower_wick = body_bottom - first_sif.sif_low
        [wick_tier, has_wick_dominance] = classify_wick_dominance(body_size, upper_wick, lower_wick)
        risky_prefix = wick_tier == WICK_TIER_RISKY ? "*" : ""

        if str.contains(first_sif.sif_subtype, SUBTYPE_INCLUSION)
            behavior_text := risky_prefix + "Inclusion "
        else if str.contains(first_sif.sif_subtype, SUBTYPE_REFLECTION)
            behavior_text := risky_prefix + "Reflection "

    direction = consolidated_sif.is_bullish ? SIF_PLUS : SIF_MINUS
    base_text = behavior_text + direction

    // Add source gap notation
    if sif_count > 1
        // Show detailed breakdown using extension logic
        source_breakdown = build_source_breakdown_extension(consolidated_sif.sif_group)
        base_text := base_text + " (" + source_breakdown + ")"
    else if sif_count == 1
        // Show source type for single non-FVG SIFs (preserving FVG base behavior)
        single_sif = array.get(consolidated_sif.sif_group, 0)
        if str.contains(single_sif.sif_subtype, SUBTYPE_IMPLIED)
            base_text := base_text + " (imp)"
        else if str.contains(single_sif.sif_subtype, SUBTYPE_VOLUME)
            base_text := base_text + " (vol)"
        else if str.contains(single_sif.sif_subtype, SUBTYPE_TRUE)
            base_text := base_text + " (gap)"
        // FVG shows nothing (default/implied)

    // Add immediate SIF inversion indicator (before SUPER SIF info)
    immediate_text = ""
    has_immediate_inversion = has_immediate_sif_inversion(consolidated_sif)
    if has_immediate_inversion and immediate_sif_inversion_mode != IMMEDIATE_SIF_INVERSION_OFF
        immediate_text := "\n" + IMMEDIATE_SIF_INVERSION_TEXT

    // Add SUPER SIF information (after immediate inversion)
    has_super = has_super_sifs(consolidated_sif.sif_group)
    strength_info = ""
    if has_super
        // Find the first SUPER SIF for details
        for i = 0 to array.size(consolidated_sif.sif_group) - 1
            sif_record = array.get(consolidated_sif.sif_group, i)
            if sif_record.is_super_sif
                bars_ago = bar_index - sif_record.overlapping_sif_bar_index
                strength_info := "\n" + str.tostring(sif_record.overlap_percentage, "#.1") + "% overlap with " + (sif_record.is_bullish ? SIF_PLUS : SIF_MINUS) + " from " + str.tostring(bars_ago) + " bars ago"
                break

    // Only show breach status if NOT invalidated (mutually exclusive)
    status_text = ""
    if consolidated_sif.is_consolidated_invalidated
        status_text := status_text + " - INVALIDATED"
    else if consolidated_sif.is_consolidated_breached
        status_text := status_text + " - BREACHED (unconfirmed)"

    base_text + immediate_text + strength_info + status_text

// ═══════════════════════════════════════════════════════════════════════════════
// PROJECTION SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

get_projection_line_style() =>
    switch projection_line_style
        'Solid' => line.style_solid
        'Dashed' => line.style_dashed
        'Dotted' => line.style_dotted
        => line.style_solid

get_level_style(level) =>
    if level == 0.0 or level == 1.0
        [boundary_color, get_text_size(boundary_text_size)]
    else if level == 0.5
        [ce_color, get_text_size(ce_text_size)]
    else if level > 0.0 and level < 1.0
        [quadrant_color, get_text_size(quadrant_text_size)]
    else if level > 1.0
        [stop_color, get_text_size(stop_text_size)]
    else if level < 0.0
        [target_color, get_text_size(target_text_size)]
    else
        [color.gray, size.small]

get_projection_levels() =>
    levels = array.new<float>()

    if show_boundaries
        array.push(levels, 0.0)
        array.push(levels, 1.0)

    if show_ce
        array.push(levels, FIBONACCI_CENTER)

    if show_quadrants
        array.push(levels, FIBONACCI_QUARTER_LOW)
        array.push(levels, FIBONACCI_QUARTER_HIGH)

    if show_stops
        array.push(levels, FIBONACCI_STOP_125)
        array.push(levels, FIBONACCI_STOP_150)
        array.push(levels, FIBONACCI_STOP_200)

    if show_targets
        array.push(levels, FIBONACCI_TARGET_233)
        array.push(levels, FIBONACCI_TARGET_250)
        array.push(levels, FIBONACCI_TARGET_400)
        array.push(levels, FIBONACCI_TARGET_450)

    if show_custom
        input_str = custom_levels_input
        if str.length(input_str) > 0
            split_values = str.split(input_str, ",")
            for i = 0 to array.size(split_values) - 1
                value_str = str.replace_all(array.get(split_values, i), " ", "")
                if str.length(value_str) > 0
                    parsed_value = str.tonumber(value_str)
                    if not na(parsed_value)
                        array.push(levels, parsed_value)

    if array.size(levels) == 0
        array.push(levels, 0.0)
        array.push(levels, 1.0)

    levels

format_level_label(level) =>
    base_str = str.tostring(level, '#.##')
    str_len = str.length(base_str)
    padding_needed = 5 - str_len
    padded_str = base_str

    if padding_needed > 0
        for i = 1 to padding_needed
            padded_str := padded_str + " "

    padded_str

// ═══════════════════════════════════════════════════════════════════════════════
// DISPLAY LOGIC
// ═══════════════════════════════════════════════════════════════════════════════

should_display_sif(sif_record) =>
    if sif_record.is_invalidated and invalidated_sif_display == INVALIDATED_DISPLAY_OFF
        false
    else
        // Check if source type is enabled
        source_enabled = true
        if str.contains(sif_record.sif_subtype, SUBTYPE_IMPLIED) and not enable_implied
            source_enabled := false
        else if str.contains(sif_record.sif_subtype, SUBTYPE_VOLUME) and not enable_volume_imbalance
            source_enabled := false
        else if str.contains(sif_record.sif_subtype, SUBTYPE_TRUE) and not enable_true_gaps
            source_enabled := false
        else if sif_record.sif_subtype == SUBTYPE_STANDARD and not enable_fair_value_gaps
            source_enabled := false

        source_enabled

// Check if SIF should be displayed based on directional filter
should_display_sif_direction(sif_record) =>
    sif_record.is_bullish ? show_bullish_sifs : show_bearish_sifs

should_display_consolidated_sif(consolidated_sif) =>
    // Check if any SIF in the group should be displayed
    should_display = false
    for i = 0 to array.size(consolidated_sif.sif_group) - 1
        sif_record = array.get(consolidated_sif.sif_group, i)
        if should_display_sif(sif_record)
            should_display := true
            break

    // Apply source filter if individual SIF checks pass
    if should_display
        sif_source_count = array.size(consolidated_sif.sif_group)
        should_display := sif_source_filter == SOURCE_FILTER_SHOW_ALL or
                         (sif_source_filter == SOURCE_FILTER_SINGLE_ONLY and sif_source_count == 1) or
                         (sif_source_filter == SOURCE_FILTER_MULTI_ONLY and sif_source_count > 1)

    should_display

should_highlight_sif(sif_record) =>
    if sif_record.is_invalidated
        invalidated_sif_display == INVALIDATED_DISPLAY_LABELS_ZONES
    else
        true

should_highlight_consolidated_sif(consolidated_sif) =>
    if consolidated_sif.is_consolidated_invalidated
        invalidated_sif_display == INVALIDATED_DISPLAY_LABELS_ZONES
    else
        true

should_project_sif(sif_record) =>
    not sif_record.is_invalidated

should_project_consolidated_sif(consolidated_sif) =>
    not consolidated_sif.is_consolidated_invalidated

get_sif_colors(sif_record) =>
    // Get original color
    original_color = sif_record.is_bullish ? extended_box_bullish_color : extended_box_bearish_color

    // Check if SIF is currently breached (but not invalidated)
    is_breached = is_sif_currently_breached(sif_record)
    should_fade = enable_sif_breach_detection and enable_sif_zone_fade and is_breached and not sif_record.is_invalidated
    if should_fade
        // Fade the original color
        original_transparency = color.t(original_color)
        fade_amount = sif_breach_transparency_percent / 100.0
        new_transparency = math.min(95, original_transparency + (fade_amount * (100 - original_transparency)))
        faded_color = color.new(color.rgb(color.r(original_color), color.g(original_color), color.b(original_color)), new_transparency)
        // Apply same faded color to both candle highlight AND extension
        [faded_color, faded_color]
    else
        // Use original color for both
        [original_color, original_color]

get_consolidated_sif_colors(consolidated_sif) =>
    // Get original color
    original_color = consolidated_sif.is_bullish ? extended_box_bullish_color : extended_box_bearish_color

    // Check if consolidated SIF is currently breached (but not invalidated)
    is_breached = consolidated_sif.is_consolidated_breached
    should_fade = enable_sif_breach_detection and enable_sif_zone_fade and is_breached and not consolidated_sif.is_consolidated_invalidated
    if should_fade
        // Fade the original color
        original_transparency = color.t(original_color)
        fade_amount = sif_breach_transparency_percent / 100.0
        new_transparency = math.min(95, original_transparency + (fade_amount * (100 - original_transparency)))
        faded_color = color.new(color.rgb(color.r(original_color), color.g(original_color), color.b(original_color)), new_transparency)
        // Apply same faded color to both candle highlight AND extension
        [faded_color, faded_color]
    else
        // Use original color for both
        [original_color, original_color]

// Get appropriate text color for SIF extension labels (use breach color when breached)
get_sif_extension_text_color(sif_record, default_text_color) =>
    // Check if SIF is currently breached and should use breach color
    is_breached = is_sif_currently_breached(sif_record)
    should_use_breach_color = enable_sif_breach_detection and enable_sif_text_color_change and is_breached and not sif_record.is_invalidated
    if should_use_breach_color
        sif_breach_label_color
    else
        default_text_color

// Get appropriate text color for consolidated SIF extension labels
get_consolidated_sif_extension_text_color(consolidated_sif, default_text_color) =>
    // Check if consolidated SIF is currently breached and should use breach color
    is_breached = consolidated_sif.is_consolidated_breached
    should_use_breach_color = enable_sif_breach_detection and enable_sif_text_color_change and is_breached and not consolidated_sif.is_consolidated_invalidated
    if should_use_breach_color
        sif_breach_label_color
    else
        default_text_color

// ═══════════════════════════════════════════════════════════════════════════════
// SIF EXTENSION BOX FADING SYSTEM — parity with MBZ v8.9 (concise overview)
// ═══════════════════════════════════════════════════════════════════════════════
// === VISUAL COLOR/FADING FUNCTIONS (6 functions) ===
// Get SIF zone color (normal or breached)
get_sif_zone_color(sif_record, is_breached) =>
    base_color = sif_record.is_bullish ? extended_box_bullish_color : extended_box_bearish_color
    if is_breached and enable_sif_text_color_change
        sif_breach_label_color
    else
        base_color

// Get SIF zone transparency (normal or faded)
get_sif_zone_transparency(is_breached) =>
    if is_breached and enable_sif_zone_fade
        int(sif_breach_transparency_percent)
    else
        DEFAULT_TRANSPARENCY

// Apply visual effects to SIF zone color
get_sif_visual_color(sif_record, is_breached) =>
    zone_color = get_sif_zone_color(sif_record, is_breached)
    transparency = get_sif_zone_transparency(is_breached)
    color.new(zone_color, transparency)

// Check if SIF should show invalidation lines
should_show_sif_invalidation_lines(sif_record) =>
    enable_sif_invalidation_lines and not sif_record.is_invalidated

create_box(left_bar, top_price, bottom_price, box_color, label_text) =>
    box.new(left=left_bar, top=top_price, right=left_bar + 3, bottom=bottom_price, bgcolor=box_color, border_color=box_color, border_style=line.style_solid, border_width=1, text=label_text, text_halign=text.align_center, text_valign=text.align_center, text_size=get_label_size(), text_color=source_gap_text_color)

// ═══════════════════════════════════════════════════════════════════════════════
// MAIN DETECTION LOGIC
// ═══════════════════════════════════════════════════════════════════════════════

// ROOT FILTERING EXECUTION - Add before SIF processing
if is_root_timeframe_valid and root_filter_mode != "Off"
    
    // Get target root model
    target_model = use_auto_root ? get_auto_root_model() : manual_root_model
    [root_hour, root_minute] = get_root_model_time(target_model)
    
    // Daily reset
    if ta.change(time("D")) != 0
        root_eq_price := na
        root_found_today := false
        root_bar_time := na
    
    // Check for root bar
    ny_time = time("", "America/New_York")
    current_hour = hour(ny_time, "America/New_York") 
    current_minute = minute(ny_time, "America/New_York")
    
    is_root_bar = false
    if not root_found_today
        if timeframe.multiplier == 1
            is_root_bar := current_hour == root_hour and current_minute == root_minute
        else
            bar_start = current_minute - (current_minute % timeframe.multiplier)
            bar_end = bar_start + timeframe.multiplier - 1
            if current_hour == root_hour
                is_root_bar := root_minute >= bar_start and root_minute <= bar_end
    
    // Capture root price
    if is_root_bar and not root_found_today
        one_min_high = request.security(syminfo.tickerid, "1", high, lookahead=barmerge.lookahead_off)
        one_min_low = request.security(syminfo.tickerid, "1", low, lookahead=barmerge.lookahead_off)
        root_eq_price := (one_min_high + one_min_low) / 2
        root_found_today := true
        root_bar_time := ny_time
    
    // Draw root line
    if not na(root_eq_price) and not na(root_bar_time)
        if not na(root_eq_line)
            line.delete(root_eq_line)
        if not na(root_eq_label)
            label.delete(root_eq_label)
        
        line_end_time = time + (50 * timeframe.multiplier * 60 * 1000)
        root_eq_line := line.new(root_bar_time, root_eq_price, line_end_time, root_eq_price, color=color.blue, width=1, xloc=xloc.bar_time)
        
        label_text = str.tostring(root_hour, "#00") + ":" + str.tostring(root_minute, "#00") + " | " + str.tostring(root_eq_price, "#.##")
        root_eq_label := label.new(line_end_time, root_eq_price, label_text, style=label.style_label_left, color=color.yellow, textcolor=color.black, size=size.tiny, xloc=xloc.bar_time)

// Timeframe warning
if root_filter_mode != "Off" and not is_root_timeframe_valid and barstate.islast
    var label warning_label = na
    if not na(warning_label)
        label.delete(warning_label)
    warning_label := label.new(bar_index, high, "⚠️ Root Filter: Timeframe >5min", style=label.style_label_down, color=color.orange, textcolor=color.white, size=size.small)

// Process gaps only when at least one source is enabled
if enable_fair_value_gaps or enable_implied or enable_volume_imbalance or enable_true_gaps

    // Track new regular FVGs with correct anchoring (3-candle structure: anchor from C1)
    if enable_fair_value_gaps and barstate.isconfirmed and is_bullish_fvg()
        // COORDINATE VALIDATION: Bullish FVG - ensure TOP > BOTTOM
        fvg_top = low        // C0.low (current candle low)
        fvg_bottom = high[2] // C2.high (2 bars ago high)
        // CRITICAL: fvg_top (low) > fvg_bottom (high[2]) by FVG detection logic

        // Check for overlapping gaps before creating
        if not is_gap_overlapping(fvg_top, fvg_bottom, true, GAP_TYPE_FVG, active_gaps)
            // GapData.new(anchor, TOP, BOTTOM, bullish, inverted, formation, candidate, id, type)
            gap_data = GapData.new(bar_index - 2, fvg_top, fvg_bottom, true, false, bar_index, SIFCandidate.new(int(na), float(na), float(na), false), next_gap_id, GAP_TYPE_FVG)
            array.push(active_gaps, gap_data)
            next_gap_id += 1

if enable_fair_value_gaps and barstate.isconfirmed and is_bearish_fvg()
    // COORDINATE VALIDATION: Bearish FVG - ensure TOP > BOTTOM
    // Corrected coordinate reversal bug (was causing missing bearish FVGs)
    fvg_top = low[2]     // C2.low (2 bars ago low) - HIGHER value
    fvg_bottom = high    // C0.high (current candle high) - LOWER value
    // CRITICAL: fvg_top (low[2]) > fvg_bottom (high) by FVG detection logic

    // Check for overlapping gaps before creating
    if not is_gap_overlapping(fvg_top, fvg_bottom, false, GAP_TYPE_FVG, active_gaps)
        // GapData.new(anchor, TOP, BOTTOM, bearish, inverted, formation, candidate, id, type)
        gap_data = GapData.new(bar_index - 2, fvg_top, fvg_bottom, false, false, bar_index, SIFCandidate.new(int(na), float(na), float(na), false), next_gap_id, GAP_TYPE_FVG)
        array.push(active_gaps, gap_data)
        next_gap_id += 1

// Track new implied FVGs with correct anchoring (3-candle structure: anchor from C1)
if enable_implied and barstate.isconfirmed
    [is_valid_ifvg, ifvg_bottom, ifvg_top, is_ifvg_bullish] = detect_implied_fvg()
    if is_valid_ifvg
        // Check for overlapping gaps before creating
        if not is_gap_overlapping(ifvg_top, ifvg_bottom, is_ifvg_bullish, GAP_TYPE_IMPLIED, active_gaps)
            ifvg_data = GapData.new(bar_index - 2, ifvg_top, ifvg_bottom, is_ifvg_bullish, false, bar_index, SIFCandidate.new(int(na), float(na), float(na), false), next_gap_id, GAP_TYPE_IMPLIED)
            array.push(active_gaps, ifvg_data)
            next_gap_id += 1

// Track Volume Imbalances with correct anchoring (2-candle structure: anchor from C1)
if enable_volume_imbalance and barstate.isconfirmed
    // Check for bullish VI (2-candle body gap)
    if is_bullish_vi()
        [vi_top, vi_bottom] = get_vi_coordinates(true)

        // Check for overlapping gaps before creating
        if not is_gap_overlapping(vi_top, vi_bottom, true, GAP_TYPE_VOLUME, active_gaps)
            vi_data = GapData.new(bar_index - 1, vi_top, vi_bottom, true, false, bar_index, SIFCandidate.new(int(na), float(na), float(na), false), next_gap_id, GAP_TYPE_VOLUME)
            array.push(active_gaps, vi_data)
            next_gap_id += 1

    // Check for bearish VI (2-candle body gap)
    if is_bearish_vi()
        [vi_top, vi_bottom] = get_vi_coordinates(false)

        // Check for overlapping gaps before creating
        if not is_gap_overlapping(vi_top, vi_bottom, false, GAP_TYPE_VOLUME, active_gaps)
            vi_data = GapData.new(bar_index - 1, vi_top, vi_bottom, false, false, bar_index, SIFCandidate.new(int(na), float(na), float(na), false), next_gap_id, GAP_TYPE_VOLUME)
            array.push(active_gaps, vi_data)
            next_gap_id += 1

    // Track True Gaps with correct anchoring (2-candle structure: anchor from C1)
    if enable_true_gaps and barstate.isconfirmed
        // Check for bullish true gap
        if is_bullish_true_gap()
            [tg_top, tg_bottom] = get_true_gap_coordinates(true)

            // Check for overlapping gaps before creating
            if not is_gap_overlapping(tg_top, tg_bottom, true, GAP_TYPE_TRUE, active_gaps)
                tg_data = GapData.new(bar_index - 1, tg_top, tg_bottom, true, false, bar_index, SIFCandidate.new(int(na), float(na), float(na), false), next_gap_id, GAP_TYPE_TRUE)
                array.push(active_gaps, tg_data)
                next_gap_id += 1

        // Check for bearish true gap
        if is_bearish_true_gap()
            [tg_top, tg_bottom] = get_true_gap_coordinates(false)

            // Check for overlapping gaps before creating
            if not is_gap_overlapping(tg_top, tg_bottom, false, GAP_TYPE_TRUE, active_gaps)
                tg_data = GapData.new(bar_index - 1, tg_top, tg_bottom, false, false, bar_index, SIFCandidate.new(int(na), float(na), float(na), false), next_gap_id, GAP_TYPE_TRUE)
                array.push(active_gaps, tg_data)
                next_gap_id += 1

// Reset per-bar alert flags
sif_bullish_formed = false
sif_bearish_formed = false
multi_source_sif_bullish_formed := false
multi_source_sif_bearish_formed := false
immediate_sif_inversion_bullish_formed := false
immediate_sif_inversion_bearish_formed := false
nested_sif_bullish_formed := false
nested_sif_bearish_formed := false

// Memory management (use configured limits)
while array.size(active_gaps) > MAX_ACTIVE_GAPS
    array.shift(active_gaps)

while array.size(all_sif_records) > MAX_SIF_RECORDS
    array.shift(all_sif_records)

// Clean up visual elements
while array.size(sif_body_highlights) > MAX_BODY_HIGHLIGHTS
    box.delete(array.shift(sif_body_highlights))

while array.size(sif_wick_highlights) > MAX_WICK_HIGHLIGHTS
    box.delete(array.shift(sif_wick_highlights))

while array.size(sif_extended_boxes) > MAX_EXTENDED_BOXES
    box.delete(array.shift(sif_extended_boxes))

while array.size(sif_projection_lines) > MAX_PROJECTION_LINES
    line.delete(array.shift(sif_projection_lines))

while array.size(sif_projection_labels) > MAX_PROJECTION_LABELS
    label.delete(array.shift(sif_projection_labels))

// OPTIMIZED v4.11: Skip processing when no records exist
if array.size(all_sif_records) > 0
    for i = array.size(all_sif_records) - 1 to 0
        sif_record = array.get(all_sif_records, i)

        if not sif_record.is_invalidated
            updated_sif = sif_record  // No confirmation needed

            // Check for invalidation using enhanced gap detection
            should_invalidate = should_sif_be_invalidated_enhanced(updated_sif, open, close)
            if should_invalidate
                updated_sif.is_invalidated := true
                updated_sif.cached_data_valid := false  // Invalidate cache
                needs_visual_update := true

            array.set(all_sif_records, i, updated_sif)

// Gap processing and SIF detection with correct timing

if array.size(active_gaps) > 0
    for i = array.size(active_gaps) - 1 to 0
        gap = array.get(active_gaps, i)
        if not gap.is_inverted
            current_body_top = math.max(open, close)
            current_body_bottom = math.min(open, close)
            is_current_bullish = close > open
            is_current_bearish = close < open

            current_body_enters_gap = false
            is_opposite_color = false

            // SIF LOGIC: Body must enter gap (not just wick tapping like MBZ)
            if gap.is_bullish and is_current_bearish
                body_enters_from_above = open > gap.top and close < gap.top
                body_opens_inside = open <= gap.top and open >= gap.bottom
                body_closes_through = open >= gap.bottom and close < gap.bottom
                if body_enters_from_above or body_opens_inside or body_closes_through
                    current_body_enters_gap := true
                    is_opposite_color := true
            else if not gap.is_bullish and is_current_bullish
                body_enters_from_below = open < gap.bottom and close > gap.bottom
                body_opens_inside = open >= gap.bottom and open <= gap.top
                body_closes_through = open <= gap.top and close > gap.top
                if body_enters_from_below or body_opens_inside or body_closes_through
                    current_body_enters_gap := true
                    is_opposite_color := true

            // SIF timing validation with universal 1+ bar gap rule
            if current_body_enters_gap and is_opposite_color and na(gap.first_tapper.bar_index)
                // Universal timing rule: 1+ bar gap for ALL gap types
                bars_since_gap_creation = bar_index - gap.creation_bar
                if bars_since_gap_creation >= 1
                    gap.first_tapper := SIFCandidate.new(bar_index, current_body_top, current_body_bottom, is_current_bullish)
                    array.set(active_gaps, i, gap)

            // SIF LOGIC: Check for gap inversion (SIF-specific)
            gap_inverted = false
            if gap.is_bullish
                if close <= gap.bottom
                    gap_inverted := true
            else
                if close >= gap.top
                    gap_inverted := true

            if gap_inverted and not na(gap.first_tapper.bar_index)
                gap.is_inverted := true
                array.set(active_gaps, i, gap)

                sif_candidate = gap.first_tapper

                if not na(sif_candidate.bar_index)
                    is_immediate_sif_inversion = immediate_sif_inversion_mode != IMMEDIATE_SIF_INVERSION_OFF and (sif_candidate.bar_index == bar_index)

                    bars_back = bar_index - sif_candidate.bar_index
                    sif_open_price = open[bars_back]
                    sif_close_price = close[bars_back]
                    sif_high_price = high[bars_back]
                    sif_low_price = low[bars_back]

                    [sif_subtype, has_dom_wick] = detect_sif_subtype(sif_open_price, sif_close_price, sif_high_price, sif_low_price, gap.gap_type)

                    // Create temporary SIF record for strength detection
                    temp_sif_record = SIFRecord.new(
                         sif_candidate.bar_index,
                         sif_open_price,
                         sif_close_price,
                         sif_high_price,
                         sif_low_price,
                         sif_candidate.is_bullish,
                         false,
                         0.0,
                         has_dom_wick,
                         sif_subtype,
                         "",
                         "",
                         0.0,
                         0.0,
                         false,
                         label(na),
                         gap.gap_id,
                         false,
                         0.0,
                         int(na),
                         false
                     )

                    // Detect SUPER SIF strength
                    [is_super, overlap_pct, overlapped_bar] = detect_sif_strength(temp_sif_record)
                    if is_super
                        if sif_candidate.is_bullish
                            nested_sif_bullish_formed := true
                        else
                            nested_sif_bearish_formed := true

                    sif_record = SIFRecord.new(
                         sif_candidate.bar_index,
                         sif_open_price,
                         sif_close_price,
                         sif_high_price,
                         sif_low_price,
                         sif_candidate.is_bullish,
                         false,
                         0.0,
                         has_dom_wick,
                         sif_subtype,
                         "",
                         "",
                         0.0,
                         0.0,
                         false,
                         label(na),
                         gap.gap_id,
                         is_super,
                         overlap_pct,
                         overlapped_bar,
                         is_immediate_sif_inversion
                     )

                    array.push(all_sif_records, sif_record)
                    needs_visual_update := true

                    // Set immediate SIF inversion alerts
                    if is_immediate_sif_inversion
                        if sif_candidate.is_bullish
                            immediate_sif_inversion_bullish_formed := true
                        else
                            immediate_sif_inversion_bearish_formed := true

                    if sif_candidate.is_bullish
                        sif_bullish_formed := true
                    else
                        sif_bearish_formed := true

                    // Multi-source SIF alert detection: set flags when >=2 SIFs form on same bar and direction
                    same_bar_same_direction_count = 0
                    for record_index = 0 to array.size(all_sif_records) - 1
                        existing_sif_record = array.get(all_sif_records, record_index)
                        if existing_sif_record.bar_index == sif_candidate.bar_index and existing_sif_record.is_bullish == sif_candidate.is_bullish
                            same_bar_same_direction_count += 1

                    if same_bar_same_direction_count >= 2
                        if sif_candidate.is_bullish
                            multi_source_sif_bullish_formed := true
                        else
                            multi_source_sif_bearish_formed := true

// ═══════════════════════════════════════════════════════════════════════════════
// CONSOLIDATED VISUAL MANAGEMENT SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

manage_consolidated_sif_display() =>
    // Clear all visual elements efficiently
    for elem in sif_labels
        label.delete(elem)
    array.clear(sif_labels)

    // Always clear source gap boxes for dynamic toggle behavior
    for elem in source_gap_boxes
        box.delete(elem)
    array.clear(source_gap_boxes)

    for elem in sif_body_highlights
        box.delete(elem)
    array.clear(sif_body_highlights)

    for elem in sif_extended_boxes
        box.delete(elem)
    array.clear(sif_extended_boxes)

    for elem in sif_projection_lines
        line.delete(elem)
    array.clear(sif_projection_lines)

    for elem in sif_projection_labels
        label.delete(elem)
    array.clear(sif_projection_labels)

    // Clear breach detection lines
    for elem in sif_breached_lines
        line.delete(elem)
    array.clear(sif_breached_lines)

    for elem in sif_invalidation_lines
        line.delete(elem)
    array.clear(sif_invalidation_lines)

    array.clear(displayed_sif_indices)

    // Group SIFs by candle for consolidation
    displayable_sifs = array.new<SIFRecord>()

    // Add bounds checking to prevent array out of bounds error
    total_sif_records = array.size(all_sif_records)
    if total_sif_records > 0  // Only proceed if we have records
        // SEPARATE LIMITS SYSTEM: Process valid and invalidated SIFs with independent counters
        // This provides fine-grained control over chart display density while preserving breach information
        valid_sif_count = 0           // Counter for valid (non-breached) SIFs
        invalidated_sif_count = 0     // Counter for invalidated (breached) SIFs

        // Iterate through SIF records from most recent to oldest
        for record_index = total_sif_records - 1 to 0
            current_sif_record = array.get(all_sif_records, record_index)

            // Apply source type and directional filters first
            sif_passes_root_filter = not should_filter_sif_by_root(current_sif_record.sif_high, current_sif_record.sif_low, root_eq_price)
            if should_display_sif(current_sif_record) and should_display_sif_direction(current_sif_record) and sif_passes_root_filter

                // VALID SIF PROCESSING: Add valid SIFs up to configured limit
                if not current_sif_record.is_invalidated and valid_sif_count < max_valid_sifs
                    array.push(displayable_sifs, current_sif_record)
                    valid_sif_count += 1

                // INVALIDATED SIF PROCESSING: Add invalidated SIFs only when display is enabled and under limit
                else if current_sif_record.is_invalidated and invalidated_sif_count < max_invalidated_sifs and invalidated_sif_display != INVALIDATED_DISPLAY_OFF
                    array.push(displayable_sifs, current_sif_record)
                    invalidated_sif_count += 1

            // PERFORMANCE OPTIMIZATION: Early termination when both limits reached
            // Reduces unnecessary array iterations on charts with many SIFs
            if valid_sif_count >= max_valid_sifs and (invalidated_sif_count >= max_invalidated_sifs or invalidated_sif_display == INVALIDATED_DISPLAY_OFF)
                break

    // Group displayable SIFs by candle (will return empty array if no displayable SIFs)
    consolidated_sifs = group_sifs_by_candle(displayable_sifs)

    // Only process if we have consolidated SIFs
    if array.size(consolidated_sifs) > 0
        // Process each consolidated group
        gap_boxes_already_created = array.new<int>()

        for consolidated_group_index = 0 to array.size(consolidated_sifs) - 1
            current_consolidated_sif = array.get(consolidated_sifs, consolidated_group_index)

            if not should_display_consolidated_sif(current_consolidated_sif)
                continue

            // Calculate consolidated zone boundaries
            [consolidated_zone_top_boundary, consolidated_zone_bottom_boundary] = calculate_consolidated_zone_boundaries(current_consolidated_sif.sif_group)
            current_consolidated_sif.consolidated_zone_top := consolidated_zone_top_boundary
            current_consolidated_sif.consolidated_zone_bottom := consolidated_zone_bottom_boundary

            // Determine consolidated status
            [is_currently_breached, is_currently_invalidated] = determine_consolidated_status(current_consolidated_sif)
            current_consolidated_sif.is_consolidated_breached := is_currently_breached
            current_consolidated_sif.is_consolidated_invalidated := is_currently_invalidated

            // Build labels
            current_consolidated_sif.consolidated_candle_label := create_consolidated_candle_label(current_consolidated_sif)
            current_consolidated_sif.consolidated_extension_label := create_consolidated_extension_label(current_consolidated_sif)

            // Update the consolidated_sifs array
            array.set(consolidated_sifs, consolidated_group_index, current_consolidated_sif)

            // Create candle label with proper positioning
            if show_sif_labels
                consolidated_label_color = current_consolidated_sif.is_consolidated_invalidated ? sif_invalidated_color : (current_consolidated_sif.is_bullish ? sif_bullish_color : sif_bearish_color)
                consolidated_label_size = current_consolidated_sif.is_consolidated_invalidated ? get_invalidated_sif_size() : get_sif_label_size()

                // Smart label positioning for reflection SIFs to avoid extension box overlap
                first_sif_in_group = array.get(current_consolidated_sif.sif_group, 0)

                // Check if any SIF in group is reflection type with extensions enabled
                has_reflection_sif = false
                for sif_check_index = 0 to array.size(current_consolidated_sif.sif_group) - 1
                    check_sif = array.get(current_consolidated_sif.sif_group, sif_check_index)
                    if str.contains(check_sif.sif_subtype, SUBTYPE_REFLECTION)
                        has_reflection_sif := true
                        break

                // Declare variables for positioning
                candle_label_y_position = float(na)
                candle_label_yloc = yloc.price

                // Calculate proper positioning
                if show_extended_boxes and has_reflection_sif
                    // For reflection SIFs with extensions, use 0.3 spacing offset (was 0.5)
                    zone_height = current_consolidated_sif.consolidated_zone_top - current_consolidated_sif.consolidated_zone_bottom
                    spacing_offset = zone_height * 0.3  // CHANGED from 0.5 to 0.3

                    if current_consolidated_sif.is_bullish
                        // Bullish reflection: extension goes down, push label further down
                        candle_label_y_position := current_consolidated_sif.consolidated_zone_bottom - spacing_offset
                    else
                        // Bearish reflection: extension goes up, push label further up
                        candle_label_y_position := current_consolidated_sif.consolidated_zone_top + spacing_offset

                    candle_label_yloc := yloc.price
                else
                    // Standard positioning using yloc.belowbar/abovebar
                    candle_label_y_position := current_consolidated_sif.is_bullish ? first_sif_in_group.sif_low : first_sif_in_group.sif_high
                    candle_label_yloc := current_consolidated_sif.is_bullish ? yloc.belowbar : yloc.abovebar

                consolidated_tooltip_text = build_consolidated_tooltip(current_consolidated_sif)

                new_consolidated_label = label.new(
                     x=current_consolidated_sif.bar_index,
                     y=candle_label_y_position,
                     text=current_consolidated_sif.consolidated_candle_label,
                     style=label.style_none,
                     textcolor=consolidated_label_color,
                     size=consolidated_label_size,
                     yloc=candle_label_yloc,
                     tooltip=consolidated_tooltip_text
                 )

                array.push(sif_labels, new_consolidated_label)

            // Create consolidated extension box
            should_highlight_consolidated_zone = show_extended_boxes and should_highlight_consolidated_sif(current_consolidated_sif)
            if should_highlight_consolidated_zone
                [consolidated_highlight_color, consolidated_extension_color] = get_consolidated_sif_colors(current_consolidated_sif)

                // Get dynamic border properties for multi-source highlighting
                sif_source_count = array.size(current_consolidated_sif.sif_group)
                [border_width_final, border_color_final] = get_border_properties_for_sif(current_consolidated_sif, sif_source_count)

                // Highlight box (consolidated zone)
                consolidated_highlight_box = box.new(
                     left=current_consolidated_sif.bar_index,
                     right=current_consolidated_sif.bar_index + 1,
                     top=current_consolidated_sif.consolidated_zone_top,
                     bottom=current_consolidated_sif.consolidated_zone_bottom,
                     xloc=xloc.bar_index,
                     bgcolor=consolidated_highlight_color,
                     border_color=na
                 )
                array.push(sif_body_highlights, consolidated_highlight_box)

                // Extension box with consolidated label - Dropdown Extension System
                extension_right = switch extension_mode
                    EXTENSION_FIXED => current_consolidated_sif.bar_index + extended_box_length
                    EXTENSION_TO_CURRENT => math.max(bar_index, current_consolidated_sif.bar_index + extended_box_length)
                    EXTENSION_BEYOND_CURRENT => bar_index + extended_box_length
                    => current_consolidated_sif.bar_index + extended_box_length
                consolidated_extension_box = box.new(
                     left=current_consolidated_sif.bar_index,
                     right=extension_right,
                     top=current_consolidated_sif.consolidated_zone_top,
                     bottom=current_consolidated_sif.consolidated_zone_bottom,
                     xloc=xloc.bar_index,
                     bgcolor=consolidated_extension_color,
                     border_color=border_color_final,
                     border_width=border_width_final,
                     text=current_consolidated_sif.consolidated_extension_label,
                     text_halign=text.align_right,
                     text_valign=text.align_center,
                     text_color=get_consolidated_sif_extension_text_color(current_consolidated_sif, extended_box_text_color),
                     text_size=get_extended_box_text_size()
                 )
                array.push(sif_extended_boxes, consolidated_extension_box)

                // Create breach detection lines if enabled
                if enable_sif_breach_detection
                    // Get first SIF from consolidated group for zone calculations
                    first_sif_in_group = array.get(current_consolidated_sif.sif_group, 0)

                    // Create breach lines if enabled and SIF is not invalidated
                    if should_show_sif_breached_lines(first_sif_in_group)
                        breach_level = get_sif_breach_level(current_consolidated_sif.consolidated_zone_top, current_consolidated_sif.consolidated_zone_bottom, current_consolidated_sif.is_bullish)
                        breach_line = line.new(x1=current_consolidated_sif.bar_index, y1=breach_level, x2=extension_right, y2=breach_level, xloc=xloc.bar_index, color=get_sif_breached_line_color(), style=get_sif_breached_line_style(), width=sif_breached_line_width)
                        array.push(sif_breached_lines, breach_line)

                    // Create invalidation lines if enabled and SIF is not invalidated
                    if should_show_sif_invalidation_lines(first_sif_in_group)
                        invalidation_level = get_sif_invalidation_level(current_consolidated_sif.consolidated_zone_top, current_consolidated_sif.consolidated_zone_bottom, current_consolidated_sif.is_bullish)
                        invalidation_line = line.new(x1=current_consolidated_sif.bar_index, y1=invalidation_level, x2=extension_right, y2=invalidation_level, xloc=xloc.bar_index, color=get_sif_invalidation_line_color(), style=get_sif_invalidation_line_style(), width=sif_invalidation_line_width)
                        array.push(sif_invalidation_lines, invalidation_line)

            // Source gap creation - Show ALL individual gaps, not just first one
            if show_source_gap and array.size(source_gap_boxes) < max_source_gap_boxes
                // Create gap box for EACH SIF in the group
                for current_sif_index = 0 to array.size(current_consolidated_sif.sif_group) - 1
                    current_sif_in_group = array.get(current_consolidated_sif.sif_group, current_sif_index)

                    if not array.includes(gap_boxes_already_created, current_sif_in_group.source_gap_id)
                        // Find the source gap by ID
                        for active_gap_index = 0 to array.size(active_gaps) - 1
                            source_gap_data = array.get(active_gaps, active_gap_index)
                            if source_gap_data.gap_id == current_sif_in_group.source_gap_id
                                individual_sif_label = current_sif_in_group.is_bullish ? SIF_PLUS : SIF_MINUS

                                // Use "Vol Imb+" instead of "VI+" for gap labels
                                source_gap_label_text = ""
                                if source_gap_data.gap_type == GAP_TYPE_IMPLIED
                                    source_gap_label_text := source_gap_data.is_bullish ? 'Imp FVG+ for ' + individual_sif_label : 'Imp FVG- for ' + individual_sif_label
                                else if source_gap_data.gap_type == GAP_TYPE_VOLUME
                                    source_gap_label_text := source_gap_data.is_bullish ? 'Vol Imb+ for ' + individual_sif_label : 'Vol Imb- for ' + individual_sif_label
                                else if source_gap_data.gap_type == GAP_TYPE_TRUE
                                    source_gap_label_text := source_gap_data.is_bullish ? 'True Gap+ for ' + individual_sif_label : 'True Gap- for ' + individual_sif_label
                                else
                                    source_gap_label_text := source_gap_data.is_bullish ? 'FVG+ for ' + individual_sif_label : 'FVG- for ' + individual_sif_label

                                // Create and configure gap box
                                individual_gap_box = create_box(source_gap_data.bar_index, source_gap_data.top, source_gap_data.bottom, gap_color, source_gap_label_text)
                                box.set_right(individual_gap_box, current_sif_in_group.bar_index)
                                array.push(source_gap_boxes, individual_gap_box)

                                // Mark this gap ID as processed
                                array.push(gap_boxes_already_created, current_sif_in_group.source_gap_id)
                                break

        // Projections using consolidated zones
        if show_sif_projections and array.size(consolidated_sifs) > 0
            projection_levels_list = get_projection_levels()
            projected_sif_count = 0

            for consolidated_sif_index = 0 to array.size(consolidated_sifs) - 1
                if projected_sif_count >= project_last_n_sifs
                    break

                current_consolidated_sif = array.get(consolidated_sifs, consolidated_sif_index)

                if not should_project_consolidated_sif(current_consolidated_sif)
                    continue

                // Use consolidated zone for projections
                consolidated_zone_close_level = current_consolidated_sif.consolidated_zone_bottom
                consolidated_zone_open_level = current_consolidated_sif.consolidated_zone_top

                projection_start_bar = current_consolidated_sif.bar_index
                projection_end_bar = current_consolidated_sif.bar_index + projection_extend_bars

                for level_index = 0 to array.size(projection_levels_list) - 1
                    current_level_value = array.get(projection_levels_list, level_index)
                    projection_target_price = if current_level_value == 0.0
                        consolidated_zone_close_level
                    else if current_level_value == 1.0
                        consolidated_zone_open_level
                    else if current_level_value > 0.0 and current_level_value < 1.0
                        consolidated_zone_close_level + ((consolidated_zone_open_level - consolidated_zone_close_level) * current_level_value)
                    else if current_level_value > 1.0
                        level_extension = current_level_value - 1.0
                        consolidated_zone_open_level + ((consolidated_zone_open_level - consolidated_zone_close_level) * level_extension)
                    else
                        absolute_level_value = math.abs(current_level_value)
                        consolidated_zone_close_level - ((consolidated_zone_open_level - consolidated_zone_close_level) * absolute_level_value)

                    [level_text_color, level_text_size] = get_level_style(current_level_value)

                    projection_line = line.new(x1=projection_start_bar, y1=projection_target_price, x2=projection_end_bar, y2=projection_target_price,
                                  xloc=xloc.bar_index, color=level_text_color,
                                  style=get_projection_line_style(), width=projection_line_width)
                    array.push(sif_projection_lines, projection_line)

                    level_label_text = format_level_label(current_level_value)
                    label_x_position = projection_label_side == 'Left' ? (projection_start_bar - projection_label_gap) : (projection_end_bar + projection_label_gap)
                    if label_x_position < 0
                        label_x_position := 0
                    projection_level_label = label.new(x=label_x_position, y=projection_target_price, text=level_label_text, style=label.style_none,
                                         textcolor=level_text_color, size=level_text_size,
                                         yloc=yloc.price,
                                         textalign=projection_label_side == 'Left' ? text.align_right : text.align_left)
                    array.push(sif_projection_labels, projection_level_label)
                projected_sif_count += 1

// OPTIMIZED: Smart visual update system - only when necessary (v9.13: historical backfill toggle added)
visual_update_needed = needs_visual_update or
                      (barstate.isconfirmed and array.size(all_sif_records) > 0) or
                      (ENABLE_HISTORICAL_BACKFILL and barstate.islastconfirmedhistory)

if visual_update_needed
    manage_consolidated_sif_display()
    needs_visual_update := false

// Wick dominance stars - Updated for consolidated display
if enable_wick_dominance_markers
    for existing_star_element in star_labels
        label.delete(existing_star_element)
    array.clear(star_labels)

    // Process each consolidated SIF group only if we have records
    total_sif_records_available = array.size(all_sif_records)
    if total_sif_records_available > 0
        displayable_sifs_for_stars = array.new<SIFRecord>()
        // SEPARATE LIMITS SYSTEM: Process SIFs for wick dominance stars with same limit logic
        // Ensures consistency between main SIF display and wick star overlay
        valid_sifs_count = 0           // Counter for valid SIFs in star display
        invalidated_sifs_count = 0     // Counter for invalidated SIFs in star display

        // Apply same filtering logic as main SIF display for consistency
        for record_index = total_sif_records_available - 1 to 0
            current_sif_record = array.get(all_sif_records, record_index)

            // Apply source type and directional filters
            sif_passes_root_filter = not should_filter_sif_by_root(current_sif_record.sif_high, current_sif_record.sif_low, root_eq_price)
            if should_display_sif(current_sif_record) and should_display_sif_direction(current_sif_record) and sif_passes_root_filter

                // VALID SIF PROCESSING: Add valid SIFs for star display
                if not current_sif_record.is_invalidated and valid_sifs_count < max_valid_sifs
                    array.push(displayable_sifs_for_stars, current_sif_record)
                    valid_sifs_count += 1

                // INVALIDATED SIF PROCESSING: Add invalidated SIFs for star display when enabled
                else if current_sif_record.is_invalidated and invalidated_sifs_count < max_invalidated_sifs and invalidated_sif_display != INVALIDATED_DISPLAY_OFF
                    array.push(displayable_sifs_for_stars, current_sif_record)
                    invalidated_sifs_count += 1

            // PERFORMANCE OPTIMIZATION: Early termination when limits reached
            if valid_sifs_count >= max_valid_sifs and (invalidated_sifs_count >= max_invalidated_sifs or invalidated_sif_display == INVALIDATED_DISPLAY_OFF)
                break

        // Only proceed if we have displayable SIFs
        if array.size(displayable_sifs_for_stars) > 0
            consolidated_sifs_for_stars = group_sifs_by_candle(displayable_sifs_for_stars)

            for consolidated_index = 0 to array.size(consolidated_sifs_for_stars) - 1
                current_consolidated_sif_for_star = array.get(consolidated_sifs_for_stars, consolidated_index)

                // Check each SIF in the group for dominant wicks
                for sif_in_group_index = 0 to array.size(current_consolidated_sif_for_star.sif_group) - 1
                    individual_sif_for_star = array.get(current_consolidated_sif_for_star.sif_group, sif_in_group_index)

                    sif_body_top_price = math.max(individual_sif_for_star.sif_open, individual_sif_for_star.sif_close)
                    sif_body_bottom_price = math.min(individual_sif_for_star.sif_open, individual_sif_for_star.sif_close)
                    sif_body_size_range = sif_body_top_price - sif_body_bottom_price
                    sif_upper_wick_size = individual_sif_for_star.sif_high - sif_body_top_price
                    sif_lower_wick_size = sif_body_bottom_price - individual_sif_for_star.sif_low

                    [wick_dominance_tier, has_significant_wick_dominance] = classify_wick_dominance(sif_body_size_range, sif_upper_wick_size, sif_lower_wick_size)

                    if has_significant_wick_dominance
                        wick_tier_star_color = switch wick_dominance_tier
                            WICK_TIER_STANDARD => standard_star_color
                            WICK_TIER_RELAXED => relaxed_star_color
                            WICK_TIER_RISKY => risky_star_color
                            => standard_star_color

                        wick_strength_description = switch wick_dominance_tier
                            WICK_TIER_STANDARD => "Standard (≥100%)"
                            WICK_TIER_RELAXED => "Relaxed (85-99%)"
                            WICK_TIER_RISKY => "Risky (80-84%)"
                            => "Standard"

                        is_sif_candle_bullish = individual_sif_for_star.sif_close > individual_sif_for_star.sif_open
                        star_y_position = is_sif_candle_bullish ? individual_sif_for_star.sif_low : individual_sif_for_star.sif_high
                        star_y_location = is_sif_candle_bullish ? yloc.abovebar : yloc.belowbar

                        star_label_size = current_consolidated_sif_for_star.is_consolidated_invalidated ? get_invalidated_sif_size() : get_wick_star_size()
                        star_label_color = current_consolidated_sif_for_star.is_consolidated_invalidated ? sif_invalidated_color : wick_tier_star_color

                        wick_dominance_star_label = label.new(
                             x=individual_sif_for_star.bar_index,
                             y=star_y_position,
                             text="★",
                             style=label.style_none,
                             textcolor=star_label_color,
                             size=star_label_size,
                             yloc=star_y_location,
                             tooltip="Dominant Wick SIF (" + wick_strength_description + ")"
                         )

                        array.push(star_labels, wick_dominance_star_label)

// ═══════════════════════════════════════════════════════════════════════════════
// ENHANCED ALERTS - INDIVIDUAL SIF DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

alertcondition(sif_bullish_formed, title=SIF_PLUS, message='{{interval}}')
alertcondition(sif_bearish_formed, title=SIF_MINUS, message='{{interval}}')
alertcondition(multi_source_sif_bullish_formed, title=ALERT_TITLE_MULTI_SOURCE_SIF_PLUS, message='{{interval}}')
alertcondition(multi_source_sif_bearish_formed, title=ALERT_TITLE_MULTI_SOURCE_SIF_MINUS, message='{{interval}}')
alertcondition(immediate_sif_inversion_bullish_formed, title=ALERT_TITLE_IMMEDIATE_SIF_INVERSION_PLUS, message='{{interval}}')
alertcondition(immediate_sif_inversion_bearish_formed, title=ALERT_TITLE_IMMEDIATE_SIF_INVERSION_MINUS, message='{{interval}}')
alertcondition(nested_sif_bullish_formed, title=ALERT_TITLE_NESTED_SIF_PLUS, message='{{interval}}')
alertcondition(nested_sif_bearish_formed, title=ALERT_TITLE_NESTED_SIF_MINUS, message='{{interval}}')

// Grouped alert system logic
if alert_mode == ALERT_MODE_GROUPED or alert_mode == ALERT_MODE_BOTH
    sif_grouped_alert_active := false
    array.clear(sif_alert_parts)

    // Collect enabled parts
    if enable_sif_plus_formation and sif_bullish_formed
        array.push(sif_alert_parts, ALERT_MSG_SIF_PLUS_FORMED)
        sif_grouped_alert_active := true
    if enable_sif_minus_formation and sif_bearish_formed
        array.push(sif_alert_parts, ALERT_MSG_SIF_MINUS_FORMED)
        sif_grouped_alert_active := true
    if enable_multi_source_sif_plus and multi_source_sif_bullish_formed
        array.push(sif_alert_parts, ALERT_MSG_MULTI_SOURCE_SIF_PLUS)
        sif_grouped_alert_active := true
    if enable_multi_source_sif_minus and multi_source_sif_bearish_formed
        array.push(sif_alert_parts, ALERT_MSG_MULTI_SOURCE_SIF_MINUS)
        sif_grouped_alert_active := true
    if enable_nested_sif_plus_alert and nested_sif_bullish_formed
        array.push(sif_alert_parts, ALERT_MSG_NESTED_SIF_PLUS)
        sif_grouped_alert_active := true
    if enable_nested_sif_minus_alert and nested_sif_bearish_formed
        array.push(sif_alert_parts, ALERT_MSG_NESTED_SIF_MINUS)
        sif_grouped_alert_active := true
    if enable_immediate_sif_inversion_plus_alert and immediate_sif_inversion_bullish_formed
        array.push(sif_alert_parts, ALERT_MSG_IMMEDIATE_SIF_INVERSION_PLUS)
        sif_grouped_alert_active := true
    if enable_immediate_sif_inversion_minus_alert and immediate_sif_inversion_bearish_formed
        array.push(sif_alert_parts, ALERT_MSG_IMMEDIATE_SIF_INVERSION_MINUS)
        sif_grouped_alert_active := true

    if sif_grouped_alert_active
        // Lead priority: Immediate > Multi-Source > Nested > Baseline
        lead_text = ""
        if array.includes(sif_alert_parts, ALERT_MSG_IMMEDIATE_SIF_INVERSION_PLUS)
            lead_text := ALERT_MSG_IMMEDIATE_SIF_INVERSION_PLUS
        else if array.includes(sif_alert_parts, ALERT_MSG_IMMEDIATE_SIF_INVERSION_MINUS)
            lead_text := ALERT_MSG_IMMEDIATE_SIF_INVERSION_MINUS
        else if array.includes(sif_alert_parts, ALERT_MSG_MULTI_SOURCE_SIF_PLUS)
            lead_text := ALERT_MSG_MULTI_SOURCE_SIF_PLUS
        else if array.includes(sif_alert_parts, ALERT_MSG_MULTI_SOURCE_SIF_MINUS)
            lead_text := ALERT_MSG_MULTI_SOURCE_SIF_MINUS
        else if array.includes(sif_alert_parts, ALERT_MSG_NESTED_SIF_PLUS)
            lead_text := ALERT_MSG_NESTED_SIF_PLUS
        else if array.includes(sif_alert_parts, ALERT_MSG_NESTED_SIF_MINUS)
            lead_text := ALERT_MSG_NESTED_SIF_MINUS
        else if array.includes(sif_alert_parts, ALERT_MSG_SIF_PLUS_FORMED)
            lead_text := ALERT_MSG_SIF_PLUS_FORMED
        else if array.includes(sif_alert_parts, ALERT_MSG_SIF_MINUS_FORMED)
            lead_text := ALERT_MSG_SIF_MINUS_FORMED

        // specials count (exclude baseline SIF)
        has_immediate_special = array.includes(sif_alert_parts, ALERT_MSG_IMMEDIATE_SIF_INVERSION_PLUS) or array.includes(sif_alert_parts, ALERT_MSG_IMMEDIATE_SIF_INVERSION_MINUS)
        has_multi_source_special = array.includes(sif_alert_parts, ALERT_MSG_MULTI_SOURCE_SIF_PLUS) or array.includes(sif_alert_parts, ALERT_MSG_MULTI_SOURCE_SIF_MINUS)
        has_nested_special = array.includes(sif_alert_parts, ALERT_MSG_NESTED_SIF_PLUS) or array.includes(sif_alert_parts, ALERT_MSG_NESTED_SIF_MINUS)
        specials_count = (has_immediate_special ? 1 : 0) + (has_multi_source_special ? 1 : 0) + (has_nested_special ? 1 : 0)

        lead_is_special = (lead_text == ALERT_MSG_IMMEDIATE_SIF_INVERSION_PLUS) or (lead_text == ALERT_MSG_IMMEDIATE_SIF_INVERSION_MINUS) or (lead_text == ALERT_MSG_MULTI_SOURCE_SIF_PLUS) or (lead_text == ALERT_MSG_MULTI_SOURCE_SIF_MINUS) or (lead_text == ALERT_MSG_NESTED_SIF_PLUS) or (lead_text == ALERT_MSG_NESTED_SIF_MINUS)
        extra = lead_is_special ? math.max(0, specials_count - 1) : specials_count
        plus_n = extra > 0 ? (" +" + str.tostring(extra)) : ""
        tf = str.tostring(timeframe.period)
        alert(lead_text + plus_n + " • " + tf)
// ═══════════════════════════════════════════════════════════════════════════════

// SIF Hunter° [Pro+] [v9.18-dual-alert-system]
