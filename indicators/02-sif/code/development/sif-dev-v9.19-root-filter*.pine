// ═══════════════════════════════════════════════════════════════════════════════
// INPUT SETTINGS - OPTIMIZED LAYOUT
// ═══════════════════════════════════════════════════════════════════════════════

// === 🎯 DETECTION ===
// SEPARATE LIMITS SYSTEM: Independent control over valid vs invalidated SIF display counts
// This allows fine-tuned control over chart clutter while maintaining important breach information
max_valid_sifs = input.int(DEFAULT_MAX_VALID_SIFS, INPUT_LABEL_MAX_VALID_SIFS, minval=0, maxval=MAX_VALID_SIFS_LIMIT, group=GROUP_DETECTION, inline='det1', tooltip='Maximum number of valid (non-breached) SIFs to display on chart. Max: 52\n\n• 0 = Show no valid SIFs\n• Higher values show more valid SIFs\n• Independent of invalidated SIF limit')
max_invalidated_sifs = input.int(DEFAULT_MAX_INVALIDATED_SIFS, INPUT_LABEL_MAX_INVALIDATED_SIFS, minval=0, maxval=MAX_INVALIDATED_SIFS_LIMIT, group=GROUP_DETECTION, inline='det1', tooltip='Maximum number of invalidated (breached) SIFs to display when Invalidated Style is enabled. Max: 22\n\n• 0 = Show no invalidated SIFs\n• Only applies when Invalidated Style ≠ Off\n• Independent of valid SIF limit')
invalidated_sif_display = input.string(INVALIDATED_DISPLAY_OFF, INPUT_LABEL_SHOW_INVALIDATED_SIFS, options=[INVALIDATED_DISPLAY_OFF, INVALIDATED_DISPLAY_LABELS, INVALIDATED_DISPLAY_LABELS_ZONES], group=GROUP_DETECTION, inline='det1', tooltip='Off: hide invalidated SIFs\nLabels Only: show just labels with [X] marker\nLabels + Zones: show labels and zone extensions\n\nNote: [BREACHED] appears in real-time when threshold exceeded, [X] appears after candle closes')
sif_invalidation_mode = input.string(INVALIDATION_STRICT, INPUT_LABEL_INVALIDATION_THRESHOLD, options=[INVALIDATION_STRICT, INVALIDATION_LENIENT, INVALIDATION_CUSTOM], group=GROUP_DETECTION, inline='det2', tooltip='Zone fill threshold for invalidation and breach detection\nStrict: 55% fill (more sensitive, faster invalidation and breach alerts)\nLenient: 85% fill (less sensitive, slower invalidation and breach alerts)\nCustom: set your own percentage (1-99%)\n\n[BREACHED] shows immediately when threshold exceeded\n[X] shows after candle closes with confirmation')
custom_threshold_percent = input.float(DEFAULT_CUSTOM_THRESHOLD, INPUT_LABEL_CUSTOM_PERCENT, minval=MIN_THRESHOLD_PERCENT, maxval=MAX_THRESHOLD_PERCENT, step=1.0, group=GROUP_DETECTION, inline='det2')

// === 🎯 DIRECTIONAL FILTER ===
show_bullish_sifs = input.bool(true, INPUT_LABEL_SHOW_SIF_PLUS, group=GROUP_DIRECTIONAL_FILTER, inline='dir1', tooltip='Display SIF⁺ zones and labels')
show_bearish_sifs = input.bool(true, INPUT_LABEL_SHOW_SIF_MINUS, group=GROUP_DIRECTIONAL_FILTER, inline='dir1', tooltip='Display SIF⁻ zones and labels')
sif_source_filter = input.string(SOURCE_FILTER_SHOW_ALL, "Source Filter", options=[SOURCE_FILTER_SHOW_ALL, SOURCE_FILTER_SINGLE_ONLY, SOURCE_FILTER_MULTI_ONLY], group=GROUP_DIRECTIONAL_FILTER, inline='source', tooltip='Filter SIFs by gap source count\n\nAll: Display all SIFs (default behavior)\nSingle-Source Only: Show only SIFs formed from one gap source (clean zones)\nMulti-Source Only: Show only SIFs formed from multiple gap sources (confluence zones)\n\nNote: Filters affect visuals only - all detection and alerts continue for all SIFs')


// === 🎨 SIF LABELLING (TYPE, SIZE & COLOR)===
sif_symbol_type = input.string('Arrow + Text', INPUT_LABEL_LABEL_STYLE, options=[DISPLAY_MODE_ARROW_ONLY, DISPLAY_MODE_TEXT_ONLY, DISPLAY_MODE_ARROW_TEXT], group=GROUP_SIF_LABELLING, inline='sif2', tooltip='What to display on SIF candles')
sif_label_size = input.string('Tiny', INPUT_LABEL_VALID_SIF, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_SIF_LABELLING, inline='sif1', tooltip='Size of valid SIF labels')
sif_invalidated_size = input.string('Tiny', INPUT_LABEL_INVALIDATED_SIF, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_SIF_LABELLING, inline='sif1', tooltip='Size of invalidated SIF labels')
sif_bullish_color = input.color(color.green, INPUT_LABEL_SIF_PLUS, group=GROUP_SIF_LABELLING, inline='sif2', tooltip='Color for SIF⁺ labels')
sif_bearish_color = input.color(color.red, INPUT_LABEL_SIF_MINUS, group=GROUP_SIF_LABELLING, inline='sif2', tooltip='Color for SIF⁻ labels')
sif_invalidated_color = input.color(color.gray, INPUT_LABEL_INVALIDATED, group=GROUP_SIF_LABELLING, inline='sif2', tooltip='Color for invalidated SIF labels')
show_sif_labels = input.bool(true, INPUT_LABEL_ENABLE_LABELS, group=GROUP_SIF_LABELLING, inline='sif3', tooltip='Show SIF arrow/text labels on candles\n\nNote: Arrow direction also points toward the source gap that created the SIF')
show_label_details = input.bool(true, 'Show Enhanced Label Details', group=GROUP_SIF_LABELLING, inline='sif4', tooltip='Display source types and behaviors in SIF labels\n\nOFF: Clean labels (SIF⁺, SIF⁻)\nON: Detailed labels (SIF⁺ (imp) ↓inc)')

// === ✨ SIF EXTENSION ===
extended_box_bullish_color = input.color(color.new(color.green, 85), 'SIF⁺', group=GROUP_SIF_EXTENSION, inline='ext_colors', tooltip='Extension colors and enable/disable highlights and extensions\nSIF⁺: zone color\nSIF⁻: zone color\nEnable Extension: show highlights and extensions for valid SIFs')
extended_box_bearish_color = input.color(color.new(color.red, 85), 'SIF⁻', group=GROUP_SIF_EXTENSION, inline='ext_colors')
show_extended_boxes = input.bool(true, INPUT_LABEL_ENABLE_EXTENSION, group=GROUP_SIF_EXTENSION, inline='ext_colors')
extension_mode = input.string(EXTENSION_FIXED, INPUT_LABEL_EXTENSION_MODE, options=[EXTENSION_FIXED, EXTENSION_TO_CURRENT, EXTENSION_BEYOND_CURRENT], group=GROUP_SIF_EXTENSION, inline='ext_mode', tooltip='Extension behavior:\n• Fixed Length: extend N bars from formation\n• To Current Price: extend at least to current bar (prevents shrinking)\n• Beyond Current Price: extend N bars beyond current bar (real-time)')
extended_box_text_size = input.string('Tiny', INPUT_LABEL_LABEL, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_SIF_EXTENSION, inline='ext_props', tooltip='Text size and color for extension box labels')
extended_box_text_color = input.color(color.black, INPUT_LABEL_LABEL, group=GROUP_SIF_EXTENSION, inline='ext_props')
extended_box_length = input.int(DEFAULT_EXTENSION_BARS, INPUT_LABEL_EXTENSION_BARS, minval=1, maxval=MAX_EXTENSION_BARS, group=GROUP_SIF_EXTENSION, inline='ext_mode', tooltip='Number of bars for extension (meaning changes based on Extension Mode selected). Max: 50')

// === 🎯 GAP SOURCES ===
enable_fair_value_gaps = input.bool(true, INPUT_LABEL_FAIR_VALUE_GAPS, group=GROUP_GAP_SOURCES, inline='sources1')
enable_implied = input.bool(true, INPUT_LABEL_IMPLIED_FVGS, group=GROUP_GAP_SOURCES, inline='sources1', tooltip='GAP SOURCES:\n• Fair Value Gaps: Standard 3-candle FVGs - the foundation of SIF detection\n• Implied FVGs: 3-candle institutional gaps with displacement validation')
enable_volume_imbalance = input.bool(true, INPUT_LABEL_VOLUME_IMBALANCES, group=GROUP_GAP_SOURCES, inline='sources2')
enable_true_gaps = input.bool(true, INPUT_LABEL_TRUE_GAPS, group=GROUP_GAP_SOURCES, inline='sources2', tooltip='GAP SOURCES (continued):\n• Volume Imbalances: 2-candle retail body gaps\n• True Gaps: Classic price gaps between candle ranges')

// === 📦 SOURCE GAP ===
gap_color = input.color(color.new(color.blue, 85), 'Box', group=GROUP_SOURCE_GAP, inline='gap1', tooltip='Source gap settings\nBox: color for gap boxes\nMax Boxes: maximum boxes to keep visible\nEnable Gaps: show boxes for gaps (FVG/Implied/VI) that created each SIF')
max_source_gap_boxes = input.int(DEFAULT_SOURCE_GAP_BOXES, INPUT_LABEL_MAX_BOXES, minval=1, maxval=MAX_SOURCE_GAP_BOXES, group=GROUP_SOURCE_GAP, inline='gap1')
