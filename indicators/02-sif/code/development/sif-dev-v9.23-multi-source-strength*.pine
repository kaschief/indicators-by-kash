// ═══════════════════════════════════════════════════════════════════════════════
// LABEL STRUCTURE ORDER DOCUMENTATION
// ═══════════════════════════════════════════════════════════════════════════════
//
// CANDLE LABELS (stacked):
// Format: [arrow] + SIF⁺/⁻ + (count/source) + [subtype] + [☆] + [STRONG] + [status]
// Examples: "▲\nSIF⁺\n(imp)\n↓inc*\n☆\n[STRONG]\n[BREACHED]", "▼\nSIF⁻\n(vol)\n↑ref*\n☆\n[STRONG]\n[X]"
// Order:   1. Optional directional arrow (▲/▼)  2. SIF⁺/⁻
//          3. Optional count/source lines  4. Subtype arrows with risk markers
//          5. Special properties (☆)  6. STRONG marker when enabled
//          7. Status indicators ([BREACHED], [X]) - ALWAYS LAST
//
// TOOLTIPS (comprehensive information structure):
// Format: [*]BEHAVIOR + SIF⁺/⁻ + (source) + fill% + overlap + breach + [X]
// Examples: "*Inclusion SIF⁺ (vol)\n[15.2% filled]\n15.2% overlap with SIF⁺ from 3 bars ago\n[breach info]"
// Order:   1. Risk warning (*) + Behavior (Inclusion/Reflection)  2. SIF⁺/⁻  3. Source gap (vol/imp/gap)  4. Fill percentage  5. Overlap info  6. Breach status  7. Invalidation [X]
//
// EXTENSION BOXES (clean minimal structure):
// Format: [STRONG] + [SUPER] + SIF⁺/⁻ + (source_breakdown) + [subtype] + [special] + [status]
// Examples: "[STRONG]\n✔ SIF⁻ (imp×2) ↑ref ☆ [X]", "SIF⁺ (fvg) ↓inc* ☆"
// Order:   1. Optional STRONG (placement configurable)  2. SUPER marker (✔)
//          3. SIF⁺/⁻  4. Source breakdown  5. Subtype (↓inc*/↑ref*)
//          6. Special properties (☆)  7. Status ([BREACHED], [X]) - ALWAYS LAST
//
// BEARISH REVERSAL RULE: Multi-part labels reverse their order for SIF⁻
// Example: Bullish "A B C D E" becomes Bearish "E D C B A" (last-to-first reversal)
// ═══════════════════════════════════════════════════════════════════════════════

PATTERN_INCLUSION_FULL = "Inclusion"
PATTERN_REFLECTION_FULL = "Reflection"
EMPTY_DISPLAY = ""

