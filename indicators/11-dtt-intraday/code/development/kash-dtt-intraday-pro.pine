// ══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════════════════════

// ══════════════════════════════════════════════════════════════════════════════
// AMRP (Average Model Range Projection)
// ══════════════════════════════════════════════════════════════════════════════
// Uses IQR (Interquartile Range) method: Q1 (25th percentile) and Q3 (75th percentile)
// Zero expansion values are filtered out automatically

// ─── Zones ───
show_amrp = input.bool(true, LABEL_ON_OFF, group=GROUP_AMRP_ZONES, tooltip="Show/hide volatility envelope zones")
amrp_lookback_mode = input.string("Manual", "Mode", options=["Manual", "Compare 3"], group=GROUP_AMRP_ZONES, tooltip="Manual: Choose 1 lookback period | Compare 3: Overlay lookbacks 4, 6, 9 for confluence analysis")
amrp_lookback = input.int(9, "Lookback Period", minval=1, maxval=15, group=GROUP_AMRP_ZONES, tooltip="Sessions to analyze (1-15). Higher = more stable zones | Lower = more reactive to recent volatility")
amrp_zone_color = input.color(color.new(color.gray, 85), "Zone Color", group=GROUP_AMRP_ZONES, inline="zone_colors")

// ─── Equilibrium Lines ───
show_amrp_eq = input.bool(true, LABEL_ON_OFF, group=GROUP_AMRP_EQ, inline="eq_toggle")
amrp_eq_color = input.color(color.new(color.gray, 60), "Color", group=GROUP_AMRP_EQ, inline="eq_toggle")
amrp_eq_style = input.string(STYLE_DASHED, LABEL_STYLE, options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], group=GROUP_AMRP_EQ, inline="eq_toggle")

// ─── Deviation Projections ───
show_deviation_projections = input.bool(true, LABEL_ON_OFF, group=GROUP_AMRP_PROJECTIONS, tooltip="Extension targets beyond outer zones when price breaks out")
projection_multipliers = input.string("1, 2, 2.5, 4", "Targets", group=GROUP_AMRP_PROJECTIONS, tooltip="Comma-separated values (max 4). Example: '1, 2, 2.5, 4' displays as -1, -2, -2.5, -4")
compare3_projection_source = input.string("Largest Zone", "Source (Compare 3)", options=["Largest Zone", "Most Recent (LB 4)", "Combined Envelope"], group=GROUP_AMRP_PROJECTIONS, tooltip="Largest Zone: Biggest of LB 4/6/9 | Most Recent: Current volatility (LB 4) | Combined Envelope: Extreme boundaries (most conservative)")
projection_color = input.color(color.new(color.red, 50), "Color", group=GROUP_AMRP_PROJECTIONS, inline="proj_style")
projection_style = input.string(STYLE_DOTTED, LABEL_STYLE, options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], group=GROUP_AMRP_PROJECTIONS, inline="proj_style")
show_projection_labels = input.bool(true, "Show Labels", group=GROUP_AMRP_PROJECTIONS, inline="proj_style")

// ─── Dynamic Fibonacci Range ───
show_fib = input.bool(false, LABEL_ON_OFF, group=GROUP_FIB, tooltip="Show dynamic Fibonacci levels anchored to AMRP boundaries, trailing with price extremes")
fib_last_n_sessions = input.int(1, "Show for Last N Sessions", minval=1, maxval=10, group=GROUP_FIB, tooltip="Number of sessions to display Fibonacci levels for")
show_fib_labels = input.bool(true, "Show Labels", group=GROUP_FIB, inline="fib_labels")
fib_width = input.int(1, LABEL_WIDTH, minval=1, maxval=5, group=GROUP_FIB, inline="fib_style")
fib_style = input.string(STYLE_SOLID, LABEL_STYLE, options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], group=GROUP_FIB, inline="fib_style")

// Individual enable/disable and color pickers for each Fibonacci level (ordered top to bottom as displayed on chart)
show_fib_100 = input.bool(true, "1", group=GROUP_FIB_LEVELS, inline="fib100")
fib_color_100 = input.color(color.gray, "", group=GROUP_FIB_LEVELS, inline="fib100")
show_fib_705 = input.bool(true, "0.705", group=GROUP_FIB_LEVELS, inline="fib705")
fib_color_705 = input.color(color.rgb(220, 20, 60), "", group=GROUP_FIB_LEVELS, inline="fib705")
show_fib_618 = input.bool(true, "0.618", group=GROUP_FIB_LEVELS, inline="fib618")
fib_color_618 = input.color(color.rgb(255, 182, 193), "", group=GROUP_FIB_LEVELS, inline="fib618")
show_fib_50 = input.bool(true, "0.5", group=GROUP_FIB_LEVELS, inline="fib50")
fib_color_50 = input.color(color.gray, "", group=GROUP_FIB_LEVELS, inline="fib50")
show_fib_382 = input.bool(true, "0.382", group=GROUP_FIB_LEVELS, inline="fib382")
fib_color_382 = input.color(color.rgb(144, 238, 144), "", group=GROUP_FIB_LEVELS, inline="fib382")
show_fib_295 = input.bool(true, "0.295", group=GROUP_FIB_LEVELS, inline="fib295")
fib_color_295 = input.color(color.rgb(34, 139, 34), "", group=GROUP_FIB_LEVELS, inline="fib295")
show_fib_0 = input.bool(true, "0", group=GROUP_FIB_LEVELS, inline="fib0")
fib_color_0 = input.color(color.gray, "", group=GROUP_FIB_LEVELS, inline="fib0")

// ─── SESSIONS ───
show_last_n_days = input.int(1, "Show Last N Days", minval=1, maxval=10, group=GROUP_SESSIONS, tooltip="Number of 24-hour DTT cycles to display")

show_boundaries = input.bool(true, "Boundaries?", group=GROUP_SESSIONS, inline="boundary", tooltip="Show session start and end boundary lines")
boundary_color = input.color(DEFAULT_BOUNDARY_COLOR, "", group=GROUP_SESSIONS, inline="boundary")
boundary_style = input.string(STYLE_SOLID, LABEL_STYLE, options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], group=GROUP_SESSIONS, inline="boundary")

show_intervals = input.bool(true, "Intervals?", group=GROUP_SESSIONS, inline="interval", tooltip="Show 3 inner interval markers within each model session")
interval_color = input.color(DEFAULT_INTERVAL_COLOR, "", group=GROUP_SESSIONS, inline="interval")
interval_style = input.string(STYLE_DASHED, LABEL_STYLE, options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], group=GROUP_SESSIONS, inline="interval")

show_pool_lines = input.bool(true, "High & Low?", group=GROUP_SESSIONS, inline="pool", tooltip="Show previous session high and low lines")
pool_color = input.color(DEFAULT_HIGH_LOW_COLOR, "", group=GROUP_SESSIONS, inline="pool")
pool_style = input.string(STYLE_SOLID, LABEL_STYLE, options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], group=GROUP_SESSIONS, inline="pool")

show_session_labels = input.bool(true, "Labels?", group=GROUP_SESSIONS, inline="label", tooltip="Show session name labels")
session_label_color = input.color(color.new(DEFAULT_BOUNDARY_COLOR, 50), "Text", group=GROUP_SESSIONS, inline="label", tooltip="Session label text color")
session_label_size = input.string(SIZE_SMALL, LABEL_SIZE, options=[SIZE_TINY, SIZE_SMALL, SIZE_NORMAL, SIZE_LARGE, SIZE_HUGE], group=GROUP_SESSIONS, inline="label")
show_root_time_in_session_label = input.bool(false, "Include Root Time", group=GROUP_SESSIONS, tooltip="Add root time below session name in label (e.g., 'Osaka\\n(19:37)')")

// ─── ROOT PRICES ───
show_roots = input.bool(false, LABEL_ON_OFF, group=GROUP_ROOT, tooltip="Display root prices captured at specific moments within each session")
show_root_zone = input.bool(true, "Box?", group=GROUP_ROOT, inline="root_box", tooltip="Display shaded area between root high and root low")
root_zone_color = input.color(DEFAULT_ROOT_ZONE_COLOR, "", group=GROUP_ROOT, inline="root_box")
show_root_line = input.bool(true, "Line?", group=GROUP_ROOT, inline="root_line", tooltip="Display EQ line at midpoint of root zone")
root_line_color = input.color(DEFAULT_ROOT_LINE_COLOR, "", group=GROUP_ROOT, inline="root_line")
root_line_style = input.string(STYLE_SOLID, LABEL_STYLE, options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], group=GROUP_ROOT, inline="root_line")
show_root_time_label = input.bool(true, "Time?", group=GROUP_ROOT, inline="root_time", tooltip="Display root time label at end of root zone")
root_time_label_color = input.color(DEFAULT_ROOT_TIME_LABEL_COLOR, "Background", group=GROUP_ROOT, inline="root_time", tooltip="Background color of time label")
root_time_text_color = input.color(DEFAULT_ROOT_TIME_TEXT_COLOR, "Text", group=GROUP_ROOT, inline="root_time", tooltip="Text color of time label")
root_label_size = input.string(SIZE_TINY, LABEL_SIZE, options=[SIZE_TINY, SIZE_SMALL, SIZE_NORMAL, SIZE_LARGE], group=GROUP_ROOT, inline="root_time2")

// ─── AMRP Range Analysis ───
show_range_analysis = input.bool(false, "Show Range Analysis Table", group=GROUP_AMRP_RANGE_ANALYSIS, tooltip="Display Expected vs Actual range for each session with % filled and room left")
range_analysis_display = input.string(DISPLAY_ALL_MODELS, "Display", options=[DISPLAY_ALL_MODELS, DISPLAY_ACTIVE_ONLY], group=GROUP_AMRP_RANGE_ANALYSIS, tooltip="All Models: Show last 15 sessions (rolling) | Active Only: Show only currently active session")
range_analysis_text_size = input.string(SIZE_TINY, "", options=[SIZE_TINY, SIZE_SMALL, SIZE_NORMAL], group=GROUP_AMRP_RANGE_ANALYSIS, inline="settings", tooltip="Table text size")
range_analysis_horizontal = input.string(POSITION_RIGHT, "", options=[POSITION_LEFT, POSITION_MIDDLE, POSITION_RIGHT], group=GROUP_AMRP_RANGE_ANALYSIS, inline="settings", tooltip="Horizontal position")
range_analysis_vertical = input.string(POSITION_TOP, "", options=[POSITION_TOP, POSITION_MIDDLE, POSITION_BOTTOM], group=GROUP_AMRP_RANGE_ANALYSIS, inline="settings", tooltip="Vertical position")

// ─── AMRP Accuracy Tracker ───
show_amrp_accuracy = input.bool(false, "Show AMRP Accuracy Table", group=GROUP_AMRP_ACCURACY, tooltip="Statistical performance tracking for AMRP predictions")
amrp_accuracy_mode = input.string("Auto-Score", "Mode", options=["Single Session", "Auto-Score"], group=GROUP_AMRP_ACCURACY, tooltip="Single Session: Specific session analysis | Auto-Score: Automated scoring system")
amrp_accuracy_session = input.string("Model 110", "Session", options=["Damasu", "Osaka", "Kyoto", "Nagasaki", "Turncoat", "Bishop", "Knight", "Big Ben", "NY Open", "Judas", "Model 11", "Model 110", "Lunch", "Model 1001", "Model 111"], group=GROUP_AMRP_ACCURACY, tooltip="Select session for Single Session mode")
amrp_accuracy_text_size = input.string(SIZE_SMALL, "", options=[SIZE_TINY, SIZE_SMALL, SIZE_NORMAL], group=GROUP_AMRP_ACCURACY, inline="settings", tooltip="Table text size")
amrp_accuracy_horizontal = input.string(POSITION_MIDDLE, "", options=[POSITION_LEFT, POSITION_MIDDLE, POSITION_RIGHT], group=GROUP_AMRP_ACCURACY, inline="settings", tooltip="Horizontal position")
amrp_accuracy_vertical = input.string(POSITION_MIDDLE, "", options=[POSITION_TOP, POSITION_MIDDLE, POSITION_BOTTOM], group=GROUP_AMRP_ACCURACY, inline="settings", tooltip="Vertical position")

// Convert string style inputs to Pine Script line style constants
boundary_style_converted = boundary_style == STYLE_SOLID ? line.style_solid : boundary_style == STYLE_DASHED ? line.style_dashed : line.style_dotted
pool_style_converted = pool_style == STYLE_SOLID ? line.style_solid : pool_style == STYLE_DASHED ? line.style_dashed : line.style_dotted
interval_style_converted = interval_style == STYLE_SOLID ? line.style_solid : interval_style == STYLE_DASHED ? line.style_dashed : line.style_dotted
root_line_style_converted = root_line_style == STYLE_SOLID ? line.style_solid : root_line_style == STYLE_DASHED ? line.style_dashed : line.style_dotted
amrp_eq_style_converted = amrp_eq_style == STYLE_SOLID ? line.style_solid : amrp_eq_style == STYLE_DASHED ? line.style_dashed : line.style_dotted
projection_style_converted = projection_style == STYLE_SOLID ? line.style_solid : projection_style == STYLE_DASHED ? line.style_dashed : line.style_dotted
fib_style_converted = fib_style == STYLE_SOLID ? line.style_solid : fib_style == STYLE_DASHED ? line.style_dashed : line.style_dotted

// Convert string size inputs to Pine Script size constants
root_label_size_converted = root_label_size == SIZE_TINY ? size.tiny : root_label_size == SIZE_SMALL ? size.small : root_label_size == SIZE_NORMAL ? size.normal : root_label_size == SIZE_LARGE ? size.large : size.huge
session_label_size_converted = session_label_size == SIZE_TINY ? size.tiny : session_label_size == SIZE_SMALL ? size.small : session_label_size == SIZE_NORMAL ? size.normal : session_label_size == SIZE_LARGE ? size.large : size.huge

// Session definitions
type DttIntradaySession
    int start_time
    int end_time
    string name
    string prev_session_name
    int start_bar
    int end_bar
    int start_timestamp                 // Actual timestamp when session started
    int end_timestamp                   // Actual timestamp when session ended
    int session_day
    float session_high
    float session_low
    int session_high_bar                 // Bar index where session high was formed
    int session_low_bar                  // Bar index where session low was formed
    float session_open_high              // Opening bar's high (first bar of session)
    float session_open_low               // Opening bar's low (first bar of session)
    bool session_open_captured           // Flag to prevent re-capture of opening price
    line pool_high_line
    line pool_low_line
    line start_boundary_line
    line end_boundary_line
    line interval_line1                      // First interval marker
    line interval_line2                      // Second interval marker
    line interval_line3                      // Third interval marker
    line interval_line4                      // Fourth interval marker (Model 1001 only)
    label session_label
    // Root price capture
    int root_time                        // Root time in HHMM format
    int root_timestamp                   // ACTUAL timestamp when root was captured (from intrabar)
    float root_price                     // Captured equilibrium price (1min high+low)/2
    float root_high                      // Captured 1min high at root time
    float root_low                       // Captured 1min low at root time
    bool root_captured                   // Flag to prevent re-capture
    line root_line                       // Horizontal line at root price (EQ)
    label root_label                     // Label showing time + price
    box root_box                         // Shaded zone from root_low to root_high
    // AMRP (Average Model Range Projection)
    box amrp_up_box                      // Upper AMRP zone (above root)
    box amrp_dn_box                      // Lower AMRP zone (below root)
    line amrp_up_eq_line                 // EQ line for upper zone (midpoint)
    line amrp_dn_eq_line                 // EQ line for lower zone (midpoint)
    line amrp_up_proj1                   // Upper projection -1x (1x zone size beyond outer)
    line amrp_up_proj2                   // Upper projection -2x (2x zone size beyond outer)
    line amrp_up_proj3                   // Upper projection -2.5x (2.5x zone size beyond outer)
    line amrp_up_proj4                   // Upper projection -4x (4x zone size beyond outer)
    line amrp_dn_proj1                   // Lower projection -1x (1x zone size beyond outer)
    line amrp_dn_proj2                   // Lower projection -2x (2x zone size beyond outer)
    line amrp_dn_proj3                   // Lower projection -2.5x (2.5x zone size beyond outer)
    line amrp_dn_proj4                   // Lower projection -4x (4x zone size beyond outer)
    label amrp_up_proj1_label            // Label for upper projection 1
    label amrp_up_proj2_label            // Label for upper projection 2
    label amrp_up_proj3_label            // Label for upper projection 3
    label amrp_up_proj4_label            // Label for upper projection 4
    label amrp_dn_proj1_label            // Label for lower projection 1
    label amrp_dn_proj2_label            // Label for lower projection 2
    label amrp_dn_proj3_label            // Label for lower projection 3
    label amrp_dn_proj4_label            // Label for lower projection 4
    bool amrp_drawn                      // Flag to prevent redrawing
    bool amrp_up_projections_drawn       // Flag to prevent redrawing upper projections
    bool amrp_dn_projections_drawn       // Flag to prevent redrawing lower projections
    bool amrp_broke_up                   // Flag: price broke above upper outer zone
    bool amrp_broke_dn                   // Flag: price broke below lower outer zone
    float amrp_up_inner                  // Inner upper boundary price
    float amrp_up_outer                  // Outer upper boundary price
    float amrp_dn_inner                  // Inner lower boundary price
    float amrp_dn_outer                  // Outer lower boundary price
    int amrp_bars_total                  // Total bars during session
    int amrp_bars_within_inner           // Bars where price stayed within inner zones
    int amrp_bars_within_outer           // Bars where price stayed within outer zones
    int amrp_bars_broke_outer            // Bars where price broke outside outer zones
    // Dynamic Fibonacci Range
    float fib_high_anchor                // High anchor for Fibonacci (initially AMRP upper outer, then trails session high if broken)
    float fib_low_anchor                 // Low anchor for Fibonacci (initially AMRP lower outer, then trails session low if broken)
    line fib_line_0                      // Fibonacci 0% level (low anchor)
    line fib_line_295                    // Fibonacci 29.5% level
    line fib_line_382                    // Fibonacci 38.2% level
    line fib_line_50                     // Fibonacci 50% level
    line fib_line_618                    // Fibonacci 61.8% level
    line fib_line_705                    // Fibonacci 70.5% level
    line fib_line_100                    // Fibonacci 100% level (high anchor)
    label fib_label_0                    // Label for 0% level
    label fib_label_295                  // Label for 29.5% level
    label fib_label_382                  // Label for 38.2% level
    label fib_label_50                   // Label for 50% level
    label fib_label_618                  // Label for 61.8% level
    label fib_label_705                  // Label for 70.5% level
    label fib_label_100                  // Label for 100% level
    bool fib_drawn                       // Flag to prevent redrawing

// Session template
type SessionTemplate
    int start_time
    int end_time
    string name
    string prev_session_name
    int root_time

// Convert session name to lowercase for labels
get_session_name_lower(session_name) =>
    result = ""
    switch session_name
        SESSION_DAMASU => result := SESSION_DAMASU_LOWER
        SESSION_OSAKA => result := SESSION_OSAKA_LOWER
        SESSION_KYOTO => result := SESSION_KYOTO_LOWER
        SESSION_NAGASAKI => result := SESSION_NAGASAKI_LOWER
        SESSION_TURNCOAT => result := SESSION_TURNCOAT_LOWER
        SESSION_BISHOP => result := SESSION_BISHOP_LOWER
        SESSION_KNIGHT => result := SESSION_KNIGHT_LOWER
        SESSION_BIGBEN => result := SESSION_BIGBEN_LOWER
        SESSION_NYOPEN => result := SESSION_NYOPEN_LOWER
        SESSION_JUDAS => result := SESSION_JUDAS_LOWER
        SESSION_MODEL11 => result := SESSION_MODEL11_LOWER
        SESSION_MODEL110 => result := SESSION_MODEL110_LOWER
        SESSION_LUNCH => result := SESSION_LUNCH_LOWER
        SESSION_MODEL1001 => result := SESSION_MODEL1001_LOWER
        SESSION_MODEL111 => result := SESSION_MODEL111_LOWER
    result

// Get interval times for a session (returns 4 values, 4th is 0 except for Model 1001)
get_interval_times(session_name) =>
    interval1 = 0
    interval2 = 0
    interval3 = 0
    interval4 = 0
    switch session_name
        SESSION_DAMASU =>
            interval1 := TIME_DAMASU_INTERVAL1
            interval2 := TIME_DAMASU_INTERVAL2
            interval3 := TIME_DAMASU_INTERVAL3
        SESSION_OSAKA =>
            interval1 := TIME_OSAKA_INTERVAL1
            interval2 := TIME_OSAKA_INTERVAL2
            interval3 := TIME_OSAKA_INTERVAL3
        SESSION_KYOTO =>
            interval1 := TIME_KYOTO_INTERVAL1
            interval2 := TIME_KYOTO_INTERVAL2
            interval3 := TIME_KYOTO_INTERVAL3
        SESSION_NAGASAKI =>
            interval1 := TIME_NAGASAKI_INTERVAL1
            interval2 := TIME_NAGASAKI_INTERVAL2
            interval3 := TIME_NAGASAKI_INTERVAL3
        SESSION_TURNCOAT =>
            interval1 := TIME_TURNCOAT_INTERVAL1
            interval2 := TIME_TURNCOAT_INTERVAL2
            interval3 := TIME_TURNCOAT_INTERVAL3
        SESSION_BISHOP =>
            interval1 := TIME_BISHOP_INTERVAL1
            interval2 := TIME_BISHOP_INTERVAL2
            interval3 := TIME_BISHOP_INTERVAL3
        SESSION_KNIGHT =>
            interval1 := TIME_KNIGHT_INTERVAL1
            interval2 := TIME_KNIGHT_INTERVAL2
            interval3 := TIME_KNIGHT_INTERVAL3
        SESSION_BIGBEN =>
            interval1 := TIME_BIGBEN_INTERVAL1
            interval2 := TIME_BIGBEN_INTERVAL2
            interval3 := TIME_BIGBEN_INTERVAL3
        SESSION_NYOPEN =>
            interval1 := TIME_NYOPEN_INTERVAL1
            interval2 := TIME_NYOPEN_INTERVAL2
            interval3 := TIME_NYOPEN_INTERVAL3
        SESSION_JUDAS =>
            interval1 := TIME_JUDAS_INTERVAL1
            interval2 := TIME_JUDAS_INTERVAL2
            interval3 := TIME_JUDAS_INTERVAL3
        SESSION_MODEL11 =>
            interval1 := TIME_MODEL11_INTERVAL1
            interval2 := TIME_MODEL11_INTERVAL2
            interval3 := TIME_MODEL11_INTERVAL3
        SESSION_MODEL110 =>
            interval1 := TIME_MODEL110_INTERVAL1
            interval2 := TIME_MODEL110_INTERVAL2
            interval3 := TIME_MODEL110_INTERVAL3
        SESSION_LUNCH =>
            interval1 := TIME_LUNCH_INTERVAL1
            interval2 := TIME_LUNCH_INTERVAL2
            interval3 := TIME_LUNCH_INTERVAL3
        SESSION_MODEL1001 =>
            interval1 := TIME_MODEL1001_INTERVAL1
            interval2 := TIME_MODEL1001_INTERVAL2
            interval3 := TIME_MODEL1001_INTERVAL3
            interval4 := TIME_MODEL1001_INTERVAL4
        SESSION_MODEL111 =>
            interval1 := TIME_MODEL111_INTERVAL1
            interval2 := TIME_MODEL111_INTERVAL2
            interval3 := TIME_MODEL111_INTERVAL3
    [interval1, interval2, interval3, interval4]

// Track all session instances across days
var session_instances = array.new<DttIntradaySession>()

// AMRP expansion data storage (separate arrays per session type)
var array<float> amrp_damasu_up = array.new<float>()
var array<float> amrp_damasu_dn = array.new<float>()
var array<float> amrp_osaka_up = array.new<float>()
var array<float> amrp_osaka_dn = array.new<float>()
var array<float> amrp_kyoto_up = array.new<float>()
var array<float> amrp_kyoto_dn = array.new<float>()
var array<float> amrp_nagasaki_up = array.new<float>()
var array<float> amrp_nagasaki_dn = array.new<float>()
var array<float> amrp_turncoat_up = array.new<float>()
var array<float> amrp_turncoat_dn = array.new<float>()
var array<float> amrp_bishop_up = array.new<float>()
var array<float> amrp_bishop_dn = array.new<float>()
var array<float> amrp_knight_up = array.new<float>()
var array<float> amrp_knight_dn = array.new<float>()
var array<float> amrp_bigben_up = array.new<float>()
var array<float> amrp_bigben_dn = array.new<float>()
var array<float> amrp_nyopen_up = array.new<float>()
var array<float> amrp_nyopen_dn = array.new<float>()
var array<float> amrp_judas_up = array.new<float>()
var array<float> amrp_judas_dn = array.new<float>()
var array<float> amrp_model11_up = array.new<float>()
var array<float> amrp_model11_dn = array.new<float>()
var array<float> amrp_model110_up = array.new<float>()
var array<float> amrp_model110_dn = array.new<float>()
var array<float> amrp_lunch_up = array.new<float>()
var array<float> amrp_lunch_dn = array.new<float>()
var array<float> amrp_model1001_up = array.new<float>()
var array<float> amrp_model1001_dn = array.new<float>()
var array<float> amrp_model111_up = array.new<float>()
var array<float> amrp_model111_dn = array.new<float>()

// Track previous input values to detect changes that require redrawing
var string prev_amrp_lookback_mode = "Manual"
var int prev_amrp_lookback = 9
var string prev_compare3_projection_source = "Largest Zone"
var string prev_projection_multipliers = "1, 2, 2.5, 4"

// Detect AMRP input changes and force redraw if needed
bool amrp_inputs_changed = (prev_amrp_lookback_mode != amrp_lookback_mode) or (prev_amrp_lookback != amrp_lookback) or (prev_compare3_projection_source != compare3_projection_source) or (prev_projection_multipliers != projection_multipliers)

if amrp_inputs_changed and barstate.isfirst
    // Delete all AMRP elements and reset flags for redrawing (only if sessions exist)
    if array.size(session_instances) > 0
        for i = 0 to array.size(session_instances) - 1
            sess = array.get(session_instances, i)

            // Delete AMRP zones
            if not na(sess.amrp_up_box)
                box.delete(sess.amrp_up_box)
                sess.amrp_up_box := na
            if not na(sess.amrp_dn_box)
                box.delete(sess.amrp_dn_box)
                sess.amrp_dn_box := na

            // Delete EQ lines
            if not na(sess.amrp_up_eq_line)
                line.delete(sess.amrp_up_eq_line)
                sess.amrp_up_eq_line := na
            if not na(sess.amrp_dn_eq_line)
                line.delete(sess.amrp_dn_eq_line)
                sess.amrp_dn_eq_line := na

            // Delete all projection lines and labels
            if not na(sess.amrp_up_proj1)
                line.delete(sess.amrp_up_proj1)
                sess.amrp_up_proj1 := na
            if not na(sess.amrp_up_proj1_label)
                label.delete(sess.amrp_up_proj1_label)
                sess.amrp_up_proj1_label := na
            if not na(sess.amrp_up_proj2)
                line.delete(sess.amrp_up_proj2)
                sess.amrp_up_proj2 := na
            if not na(sess.amrp_up_proj2_label)
                label.delete(sess.amrp_up_proj2_label)
                sess.amrp_up_proj2_label := na
            if not na(sess.amrp_up_proj3)
                line.delete(sess.amrp_up_proj3)
                sess.amrp_up_proj3 := na
            if not na(sess.amrp_up_proj3_label)
                label.delete(sess.amrp_up_proj3_label)
                sess.amrp_up_proj3_label := na
            if not na(sess.amrp_up_proj4)
                line.delete(sess.amrp_up_proj4)
                sess.amrp_up_proj4 := na
            if not na(sess.amrp_up_proj4_label)
                label.delete(sess.amrp_up_proj4_label)
                sess.amrp_up_proj4_label := na

            if not na(sess.amrp_dn_proj1)
                line.delete(sess.amrp_dn_proj1)
                sess.amrp_dn_proj1 := na
            if not na(sess.amrp_dn_proj1_label)
                label.delete(sess.amrp_dn_proj1_label)
                sess.amrp_dn_proj1_label := na
            if not na(sess.amrp_dn_proj2)
                line.delete(sess.amrp_dn_proj2)
                sess.amrp_dn_proj2 := na
            if not na(sess.amrp_dn_proj2_label)
                label.delete(sess.amrp_dn_proj2_label)
                sess.amrp_dn_proj2_label := na
            if not na(sess.amrp_dn_proj3)
                line.delete(sess.amrp_dn_proj3)
                sess.amrp_dn_proj3 := na
            if not na(sess.amrp_dn_proj3_label)
                label.delete(sess.amrp_dn_proj3_label)
                sess.amrp_dn_proj3_label := na
            if not na(sess.amrp_dn_proj4)
                line.delete(sess.amrp_dn_proj4)
                sess.amrp_dn_proj4 := na
            if not na(sess.amrp_dn_proj4_label)
                label.delete(sess.amrp_dn_proj4_label)
                sess.amrp_dn_proj4_label := na

            // Delete Fibonacci lines and labels
            if not na(sess.fib_line_0)
                line.delete(sess.fib_line_0)
                sess.fib_line_0 := na
            if not na(sess.fib_line_295)
                line.delete(sess.fib_line_295)
                sess.fib_line_295 := na
            if not na(sess.fib_line_382)
                line.delete(sess.fib_line_382)
                sess.fib_line_382 := na
            if not na(sess.fib_line_50)
                line.delete(sess.fib_line_50)
                sess.fib_line_50 := na
            if not na(sess.fib_line_618)
                line.delete(sess.fib_line_618)
                sess.fib_line_618 := na
            if not na(sess.fib_line_705)
                line.delete(sess.fib_line_705)
                sess.fib_line_705 := na
            if not na(sess.fib_line_100)
                line.delete(sess.fib_line_100)
                sess.fib_line_100 := na
            if not na(sess.fib_label_0)
                label.delete(sess.fib_label_0)
                sess.fib_label_0 := na
            if not na(sess.fib_label_295)
                label.delete(sess.fib_label_295)
                sess.fib_label_295 := na
            if not na(sess.fib_label_382)
                label.delete(sess.fib_label_382)
                sess.fib_label_382 := na
            if not na(sess.fib_label_50)
                label.delete(sess.fib_label_50)
                sess.fib_label_50 := na
            if not na(sess.fib_label_618)
                label.delete(sess.fib_label_618)
                sess.fib_label_618 := na
            if not na(sess.fib_label_705)
                label.delete(sess.fib_label_705)
                sess.fib_label_705 := na
            if not na(sess.fib_label_100)
                label.delete(sess.fib_label_100)
                sess.fib_label_100 := na

            // Reset flags to allow redrawing
            sess.amrp_drawn := false
            sess.amrp_up_projections_drawn := false
            sess.amrp_dn_projections_drawn := false

            array.set(session_instances, i, sess)

    // Update previous values
    prev_amrp_lookback_mode := amrp_lookback_mode
    prev_amrp_lookback := amrp_lookback
    prev_compare3_projection_source := compare3_projection_source
    prev_projection_multipliers := projection_multipliers

// Parse projection multipliers from input string
parse_projection_multipliers(input_str) =>
    result = array.new<float>()
    // Split by comma and parse each value
    parts = str.split(input_str, ",")
    for i = 0 to math.min(array.size(parts) - 1, MAX_PROJECTION_MULTIPLIERS - 1)
        part = str.trim(array.get(parts, i))
        // Convert string to float
        value = str.tonumber(part)
        if not na(value) and value > 0
            array.push(result, value)
    result

// Get parsed multipliers (cached to avoid re-parsing every bar)
var array<float> parsed_multipliers = parse_projection_multipliers(projection_multipliers)

// Generate margin string for projection labels
get_projection_margin() =>
    margin = ""
    for i = 0 to PROJECTION_LABEL_MARGIN_SPACES - 1
        margin := margin + " "
    margin

// Format number for projection labels - removes trailing zeros (e.g., "4" instead of "4.00", "2.5" instead of "2.50")
format_projection_label(value) =>
    // Check if it's a whole number
    if value == math.floor(value)
        str.tostring(int(value))
    else
        // Has decimals - convert and remove trailing zeros
        str_val = str.tostring(value)
        // Remove trailing zeros after decimal
        while str.endswith(str_val, "0") and str.contains(str_val, ".")
            str_val := str.substring(str_val, 0, str.length(str_val) - 1)
        // Remove trailing decimal point if no decimals left
        if str.endswith(str_val, ".")
            str_val := str.substring(str_val, 0, str.length(str_val) - 1)
        str_val

// Helper to add expansion data to session-specific arrays
add_to_amrp_arrays(session_name, up_exp, dn_exp, lookback) =>
    if session_name == SESSION_DAMASU
        array.unshift(amrp_damasu_up, up_exp)
        array.unshift(amrp_damasu_dn, dn_exp)
        while array.size(amrp_damasu_up) > lookback
            array.pop(amrp_damasu_up)
        while array.size(amrp_damasu_dn) > lookback
            array.pop(amrp_damasu_dn)
    else if session_name == SESSION_OSAKA
        array.unshift(amrp_osaka_up, up_exp)
        array.unshift(amrp_osaka_dn, dn_exp)
        while array.size(amrp_osaka_up) > lookback
            array.pop(amrp_osaka_up)
        while array.size(amrp_osaka_dn) > lookback
            array.pop(amrp_osaka_dn)
    else if session_name == SESSION_KYOTO
        array.unshift(amrp_kyoto_up, up_exp)
        array.unshift(amrp_kyoto_dn, dn_exp)
        while array.size(amrp_kyoto_up) > lookback
            array.pop(amrp_kyoto_up)
        while array.size(amrp_kyoto_dn) > lookback
            array.pop(amrp_kyoto_dn)
    else if session_name == SESSION_NAGASAKI
        array.unshift(amrp_nagasaki_up, up_exp)
        array.unshift(amrp_nagasaki_dn, dn_exp)
        while array.size(amrp_nagasaki_up) > lookback
            array.pop(amrp_nagasaki_up)
        while array.size(amrp_nagasaki_dn) > lookback
            array.pop(amrp_nagasaki_dn)
    else if session_name == SESSION_TURNCOAT
        array.unshift(amrp_turncoat_up, up_exp)
        array.unshift(amrp_turncoat_dn, dn_exp)
        while array.size(amrp_turncoat_up) > lookback
            array.pop(amrp_turncoat_up)
        while array.size(amrp_turncoat_dn) > lookback
            array.pop(amrp_turncoat_dn)
    else if session_name == SESSION_BISHOP
        array.unshift(amrp_bishop_up, up_exp)
        array.unshift(amrp_bishop_dn, dn_exp)
        while array.size(amrp_bishop_up) > lookback
            array.pop(amrp_bishop_up)
        while array.size(amrp_bishop_dn) > lookback
            array.pop(amrp_bishop_dn)
    else if session_name == SESSION_KNIGHT
        array.unshift(amrp_knight_up, up_exp)
        array.unshift(amrp_knight_dn, dn_exp)
        while array.size(amrp_knight_up) > lookback
            array.pop(amrp_knight_up)
        while array.size(amrp_knight_dn) > lookback
            array.pop(amrp_knight_dn)
    else if session_name == SESSION_BIGBEN
        array.unshift(amrp_bigben_up, up_exp)
        array.unshift(amrp_bigben_dn, dn_exp)
        while array.size(amrp_bigben_up) > lookback
            array.pop(amrp_bigben_up)
        while array.size(amrp_bigben_dn) > lookback
            array.pop(amrp_bigben_dn)
    else if session_name == SESSION_NYOPEN
        array.unshift(amrp_nyopen_up, up_exp)
        array.unshift(amrp_nyopen_dn, dn_exp)
        while array.size(amrp_nyopen_up) > lookback
            array.pop(amrp_nyopen_up)
        while array.size(amrp_nyopen_dn) > lookback
            array.pop(amrp_nyopen_dn)
    else if session_name == SESSION_JUDAS
        array.unshift(amrp_judas_up, up_exp)
        array.unshift(amrp_judas_dn, dn_exp)
        while array.size(amrp_judas_up) > lookback
            array.pop(amrp_judas_up)
        while array.size(amrp_judas_dn) > lookback
            array.pop(amrp_judas_dn)
    else if session_name == SESSION_MODEL11
        array.unshift(amrp_model11_up, up_exp)
        array.unshift(amrp_model11_dn, dn_exp)
        while array.size(amrp_model11_up) > lookback
            array.pop(amrp_model11_up)
        while array.size(amrp_model11_dn) > lookback
            array.pop(amrp_model11_dn)
    else if session_name == SESSION_MODEL110
        array.unshift(amrp_model110_up, up_exp)
        array.unshift(amrp_model110_dn, dn_exp)
        while array.size(amrp_model110_up) > lookback
            array.pop(amrp_model110_up)
        while array.size(amrp_model110_dn) > lookback
            array.pop(amrp_model110_dn)
    else if session_name == SESSION_LUNCH
        array.unshift(amrp_lunch_up, up_exp)
        array.unshift(amrp_lunch_dn, dn_exp)
        while array.size(amrp_lunch_up) > lookback
            array.pop(amrp_lunch_up)
        while array.size(amrp_lunch_dn) > lookback
            array.pop(amrp_lunch_dn)
    else if session_name == SESSION_MODEL1001
        array.unshift(amrp_model1001_up, up_exp)
        array.unshift(amrp_model1001_dn, dn_exp)
        while array.size(amrp_model1001_up) > lookback
            array.pop(amrp_model1001_up)
        while array.size(amrp_model1001_dn) > lookback
            array.pop(amrp_model1001_dn)
    else if session_name == SESSION_MODEL111
        array.unshift(amrp_model111_up, up_exp)
        array.unshift(amrp_model111_dn, dn_exp)
        while array.size(amrp_model111_up) > lookback
            array.pop(amrp_model111_up)
        while array.size(amrp_model111_dn) > lookback
            array.pop(amrp_model111_dn)

// Calculate percentile from array (for AMRP)
calculate_percentile(arr, pct) =>
    result = 0.0
    if array.size(arr) > 0
        sorted = array.copy(arr)
        array.sort(sorted, order.ascending)
        idx = math.floor(array.size(sorted) * pct / 100.0)
        idx := math.max(0, math.min(idx, array.size(sorted) - 1))
        result := array.get(sorted, idx)
    result

// Calculate IQR (Interquartile Range) - returns Q1 and Q3
calculate_iqr(arr) =>
    q1 = 0.0
    q3 = 0.0
    if array.size(arr) > 0
        q1 := calculate_percentile(arr, 25)
        q3 := calculate_percentile(arr, 75)
    [q1, q3]

// Filter zeros from array
filter_zeros(arr) =>
    filtered = array.new<float>()
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            val = array.get(arr, i)
            if val > 0.0
                array.push(filtered, val)
    filtered

// Auto-adaptive lookback based on volatility
// Returns: 4-6 for high volatility, 7-9 for low volatility
get_adaptive_lookback() =>
    // Calculate current ATR (14-period)
    current_atr = ta.atr(14)

    // Calculate average ATR over 100 bars
    avg_atr = ta.sma(ta.atr(14), 100)

    // Calculate volatility ratio
    vol_ratio = current_atr / avg_atr

    // Determine lookback based on volatility
    // High volatility (>1.3x avg) = shorter lookback (4)
    // Moderate-high volatility (1.1-1.3x) = lookback 5
    // Moderate volatility (0.9-1.1x) = lookback 6
    // Low volatility (0.7-0.9x) = lookback 7
    // Very low volatility (<0.7x) = lookback 9
    adaptive_lb = vol_ratio > 1.3 ? 4 : vol_ratio > 1.1 ? 5 : vol_ratio > 0.9 ? 6 : vol_ratio > 0.7 ? 7 : 9
    adaptive_lb

// Get AMRP percentiles for a session (with optional custom lookback for Compare All mode)
get_amrp_percentiles(session_name, inner_pct, outer_pct, custom_lookback = 0) =>
    up_inner = 0.0
    up_outer = 0.0
    dn_inner = 0.0
    dn_outer = 0.0
    has_data = false

    if session_name == SESSION_DAMASU
        up_arr_full = filter_zeros(amrp_damasu_up)
        dn_arr_full = filter_zeros(amrp_damasu_dn)

        // Limit array size if custom_lookback is specified (for Compare All mode)
        up_arr = custom_lookback > 0 and array.size(up_arr_full) > custom_lookback ?
                 array.slice(up_arr_full, 0, custom_lookback) : up_arr_full
        dn_arr = custom_lookback > 0 and array.size(dn_arr_full) > custom_lookback ?
                 array.slice(dn_arr_full, 0, custom_lookback) : dn_arr_full

        if array.size(up_arr) > 0 and array.size(dn_arr) > 0
            // IQR method only
            [up_q1, up_q3] = calculate_iqr(up_arr)
            [dn_q1, dn_q3] = calculate_iqr(dn_arr)
            up_inner := up_q1
            up_outer := up_q3
            dn_inner := dn_q1
            dn_outer := dn_q3
            has_data := true
    else if session_name == SESSION_OSAKA
        up_arr_full = filter_zeros(amrp_osaka_up)
        dn_arr_full = filter_zeros(amrp_osaka_dn)

        // Limit array size if custom_lookback is specified (for Compare All mode)
        up_arr = custom_lookback > 0 and array.size(up_arr_full) > custom_lookback ?
                 array.slice(up_arr_full, 0, custom_lookback) : up_arr_full
        dn_arr = custom_lookback > 0 and array.size(dn_arr_full) > custom_lookback ?
                 array.slice(dn_arr_full, 0, custom_lookback) : dn_arr_full

        if array.size(up_arr) > 0 and array.size(dn_arr) > 0
            [up_q1, up_q3] = calculate_iqr(up_arr)
            [dn_q1, dn_q3] = calculate_iqr(dn_arr)
            up_inner := up_q1
            up_outer := up_q3
            dn_inner := dn_q1
            dn_outer := dn_q3
            has_data := true
    else if session_name == SESSION_KYOTO
        up_arr_full = filter_zeros(amrp_kyoto_up)
        dn_arr_full = filter_zeros(amrp_kyoto_dn)

        // Limit array size if custom_lookback is specified (for Compare All mode)
        up_arr = custom_lookback > 0 and array.size(up_arr_full) > custom_lookback ?
                 array.slice(up_arr_full, 0, custom_lookback) : up_arr_full
        dn_arr = custom_lookback > 0 and array.size(dn_arr_full) > custom_lookback ?
                 array.slice(dn_arr_full, 0, custom_lookback) : dn_arr_full

        if array.size(up_arr) > 0 and array.size(dn_arr) > 0
            [up_q1, up_q3] = calculate_iqr(up_arr)
            [dn_q1, dn_q3] = calculate_iqr(dn_arr)
