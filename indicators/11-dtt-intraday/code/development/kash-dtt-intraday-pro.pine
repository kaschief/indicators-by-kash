//@version=6
indicator('Kash DTT Intraday° [Pro+]', overlay=true, max_lines_count=500, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ══════════════════════════════════════════════════════════════════════════════

const int SESSIONS_PER_CYCLE = 15
const int MILLISECONDS_PER_DAY = 86400000
const int LOOKBACK_BARS = 500
const string TIMEZONE = "America/New_York"

// Projection Label Settings
const int PROJECTION_LABEL_MARGIN_SPACES = 12  // Spaces between session boundary and projection label
const int MAX_PROJECTION_MULTIPLIERS = 4       // Maximum number of projection lines

// Default Colors
const color DEFAULT_BOUNDARY_COLOR = color.rgb(156, 156, 156)  // #9c9c9c
const color DEFAULT_INTERVAL_COLOR = color.rgb(200, 200, 200)  // #c8c8c8 (light faint grey)
const color DEFAULT_HIGH_LOW_COLOR = color.rgb(250, 161, 164)  // #faa1a4
const color DEFAULT_ROOT_ZONE_COLOR = color.rgb(225, 190, 231)  // #e1bee7
const color DEFAULT_ROOT_LINE_COLOR = color.rgb(179, 157, 219)  // #b39ddb
const color DEFAULT_ROOT_TIME_LABEL_COLOR = color.rgb(179, 157, 219)  // #b39ddb
const color DEFAULT_ROOT_TIME_TEXT_COLOR = color.rgb(156, 156, 156)  // #9c9c9c (grey)

// Style Constants (for uniform dropdown options)
const string STYLE_SOLID = "Solid"
const string STYLE_DASHED = "Dashed"
const string STYLE_DOTTED = "Dotted"

// Size Constants (for uniform dropdown options)
const string SIZE_TINY = "Tiny"
const string SIZE_SMALL = "Small"
const string SIZE_NORMAL = "Normal"
const string SIZE_LARGE = "Large"
const string SIZE_HUGE = "Huge"

// Display Mode Constants
const string DISPLAY_ALL_MODELS = "All Models"
const string DISPLAY_ACTIVE_ONLY = "Active Only"

// Position Constants
const string POSITION_LEFT = "Left"
const string POSITION_RIGHT = "Right"
const string POSITION_TOP = "Top"
const string POSITION_MIDDLE = "Middle"
const string POSITION_BOTTOM = "Bottom"

// Input Group Names (for maintainability)
const string GROUP_AMRP_ZONES = "AMRP Zones"
const string GROUP_AMRP_EQ = "AMRP EQ Lines"
const string GROUP_AMRP_PROJECTIONS = "AMRP Projections"
const string GROUP_AMRP_ACCURACY = "AMRP Accuracy"
const string GROUP_AMRP_RANGE_ANALYSIS = "AMRP Range Analysis"
const string GROUP_FIB = "Dynamic Fibonacci"
const string GROUP_FIB_LEVELS = "Dynamic Fibonacci Levels"
const string GROUP_SESSIONS = "Sessions"
const string GROUP_ROOT = "Root Prices"

// Input Label Strings (for consistency)
const string LABEL_ON_OFF = "ON/OFF"
const string LABEL_STYLE = "Style"
const string LABEL_WIDTH = "Width"
const string LABEL_SIZE = "Size"

// Session Names
const string SESSION_DAMASU = "Damasu"
const string SESSION_OSAKA = "Osaka"
const string SESSION_KYOTO = "Kyoto"
