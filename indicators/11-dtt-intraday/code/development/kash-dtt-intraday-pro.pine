                 array.slice(up_arr_full, 0, custom_lookback) : up_arr_full
        dn_arr = custom_lookback > 0 and array.size(dn_arr_full) > custom_lookback ?
                 array.slice(dn_arr_full, 0, custom_lookback) : dn_arr_full

        if array.size(up_arr) > 0 and array.size(dn_arr) > 0
            [up_q1, up_q3] = calculate_iqr(up_arr)
            [dn_q1, dn_q3] = calculate_iqr(dn_arr)
            up_inner := up_q1
            up_outer := up_q3
            dn_inner := dn_q1
            dn_outer := dn_q3
            has_data := true

    [has_data, up_inner, up_outer, dn_inner, dn_outer]

// Define session templates (in cascade order - 15 DTT sessions)
var session_templates = array.new<SessionTemplate>()
if barstate.isfirst
    array.push(session_templates, SessionTemplate.new(TIME_DAMASU_START, TIME_DAMASU_END, SESSION_DAMASU, SESSION_MODEL111, TIME_DAMASU_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_OSAKA_START, TIME_OSAKA_END, SESSION_OSAKA, SESSION_DAMASU, TIME_OSAKA_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_KYOTO_START, TIME_KYOTO_END, SESSION_KYOTO, SESSION_OSAKA, TIME_KYOTO_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_NAGASAKI_START, TIME_NAGASAKI_END, SESSION_NAGASAKI, SESSION_KYOTO, TIME_NAGASAKI_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_TURNCOAT_START, TIME_TURNCOAT_END, SESSION_TURNCOAT, SESSION_NAGASAKI, TIME_TURNCOAT_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_BISHOP_START, TIME_BISHOP_END, SESSION_BISHOP, SESSION_TURNCOAT, TIME_BISHOP_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_KNIGHT_START, TIME_KNIGHT_END, SESSION_KNIGHT, SESSION_BISHOP, TIME_KNIGHT_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_BIGBEN_START, TIME_BIGBEN_END, SESSION_BIGBEN, SESSION_KNIGHT, TIME_BIGBEN_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_NYOPEN_START, TIME_NYOPEN_END, SESSION_NYOPEN, SESSION_BIGBEN, TIME_NYOPEN_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_JUDAS_START, TIME_JUDAS_END, SESSION_JUDAS, SESSION_NYOPEN, TIME_JUDAS_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_MODEL11_START, TIME_MODEL11_END, SESSION_MODEL11, SESSION_JUDAS, TIME_MODEL11_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_MODEL110_START, TIME_MODEL110_END, SESSION_MODEL110, SESSION_MODEL11, TIME_MODEL110_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_LUNCH_START, TIME_LUNCH_END, SESSION_LUNCH, SESSION_MODEL110, TIME_LUNCH_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_MODEL1001_START, TIME_MODEL1001_END, SESSION_MODEL1001, SESSION_LUNCH, TIME_MODEL1001_ROOT))
    array.push(session_templates, SessionTemplate.new(TIME_MODEL111_START, TIME_MODEL111_END, SESSION_MODEL111, SESSION_MODEL1001, TIME_MODEL111_ROOT))

// Validate timeframe (indicator works only up to 5 minutes)
if timeframe.in_seconds(timeframe.period) > 300
    runtime.error("This indicator only works on timeframes up to 5 minutes (1m, 2m, 3m, 4m, 5m)")

// Get current time in HHMM format (using TIMEZONE constant)
// Use bar time, not real-world time
current_hour = hour(time, TIMEZONE)
current_minute = minute(time, TIMEZONE)
current_time = current_hour * 100 + current_minute
current_day = dayofweek(time, TIMEZONE)

// Auto-detect if asset trades 24/7 by checking if there are weekend bars
var bool is_247_asset = false
if barstate.isfirst
    is_247_asset := false
    // Check last LOOKBACK_BARS for any weekend activity
    for i = 0 to math.min(LOOKBACK_BARS, bar_index)
        check_day = dayofweek(time[i], TIMEZONE)
        if check_day == dayofweek.saturday or check_day == dayofweek.sunday
            is_247_asset := true
            break

// Check if we should process sessions (always process if 24/7 asset detected, or on weekdays)
process_sessions = is_247_asset or (current_day != dayofweek.saturday and current_day != dayofweek.sunday)

// Helper function to get the last instance of a session type (completed or active)
get_last_session_of_type(session_name) =>
    result = DttIntradaySession.new(0, 0, "", "", na, na, na, na, na, na, na, na, na, na, na, false, na, na, na, na, na, na, na, na, na, 0, na, na, na, na, false, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, false, false, false, false, false, na, na, na, na, na, na, na, na)
    if array.size(session_instances) > 0
        for i = array.size(session_instances) - 1 to 0
            sess = array.get(session_instances, i)
            if sess.name == session_name and not na(sess.start_bar)
                result := sess
                break
    result

// Get the count of completed Model 111 sessions (marks complete "days")
get_completed_model111_count() =>
    count = 0
    if array.size(session_instances) > 0
        for i = 0 to array.size(session_instances) - 1
            sess = array.get(session_instances, i)
            if sess.name == SESSION_MODEL111 and not na(sess.end_bar)
                count += 1
    count

// Helper function: Check if a given HHMM time falls within the current bar's time range
// Returns true if target_time is in the range [current_time, current_time + timeframe_multiplier)
time_in_bar_range(target_time, target_wraps_midnight) =>
    result = false

    if timeframe.multiplier == 1
        // 1-minute: exact match
        result := current_time == target_time
    else
        // Convert to minutes since midnight for easier math
        target_hour = math.floor(target_time / 100)
        target_minute = target_time % 100
        target_minutes = target_hour * 60 + target_minute

        bar_start_minutes = current_hour * 60 + current_minute
        bar_end_minutes = bar_start_minutes + timeframe.multiplier

        // Handle target time in "next day" for midnight-wrapping sessions
        if target_wraps_midnight and target_minutes < 720  // Before noon = next day
            target_minutes := target_minutes + 1440

            // CRITICAL: Also adjust bar times if bar is in early morning
            if bar_start_minutes < 720
                bar_start_minutes := bar_start_minutes + 1440
                bar_end_minutes := bar_end_minutes + 1440

        // Handle bar crossing midnight
        if bar_end_minutes >= 1440
            // Bar crosses midnight: e.g., 23:58 to 00:02 (1438 to 1442)
            if target_minutes < bar_start_minutes
                // Target is in the "next day" portion
                target_minutes := target_minutes + 1440

        // Check if target falls in [bar_start, bar_end)
        result := target_minutes >= bar_start_minutes and target_minutes < bar_end_minutes

    result

// Mark sessions as ended using mathematical range checking
if array.size(session_instances) > 0
    for j = array.size(session_instances) - 1 to 0
        sess = array.get(session_instances, j)
        if not na(sess.start_bar) and na(sess.end_bar)
            // Check if end time falls within current bar's range
            session_wraps_midnight = sess.end_time < sess.start_time
            session_should_end = time_in_bar_range(sess.end_time, session_wraps_midnight)

            if session_should_end
                sess.end_bar := bar_index
                sess.end_timestamp := time

                // Draw end boundary at CURRENT BAR TIME (only if enabled)
                if show_boundaries
                    if not na(sess.end_boundary_line)
                        line.delete(sess.end_boundary_line)
                    sess.end_boundary_line := line.new(time, 1e10, time, -1e6, xloc=xloc.bar_time, color=boundary_color, width=1, style=boundary_style_converted)

                // Update high/low line endpoints to current bar time
                if not na(sess.pool_high_line)
                    line.set_x2(sess.pool_high_line, time)
                if not na(sess.pool_low_line)
                    line.set_x2(sess.pool_low_line, time)

                // Collect AMRP expansion data when sessions end
                if show_amrp
                    if sess.root_captured and not na(sess.root_high) and not na(sess.root_low)
                        if not na(sess.session_high) and not na(sess.session_low)
                            // Calculate expansions
                            up_exp = sess.session_high - sess.root_high
                            dn_exp = sess.root_low - sess.session_low

                            // Determine effective lookback based on mode
                            effective_lookback = amrp_lookback_mode == "Compare 3" ? 9 : amrp_lookback  // Compare All uses max lookback (9) to store all data

                            // Add to session-specific arrays
                            add_to_amrp_arrays(sess.name, up_exp, dn_exp, effective_lookback)

                array.set(session_instances, j, sess)

// Clean up old sessions BEFORE creating new ones: keep only the last N "cycles"
if array.size(session_instances) > 0
    sessions_to_keep = show_last_n_days * SESSIONS_PER_CYCLE
    total_sessions = array.size(session_instances)

    if total_sessions > sessions_to_keep
        sessions_to_delete = total_sessions - sessions_to_keep

        for i = 0 to sessions_to_delete - 1
            sess = array.get(session_instances, i)
            if not na(sess.start_boundary_line)
                line.delete(sess.start_boundary_line)
            if not na(sess.end_boundary_line)
                line.delete(sess.end_boundary_line)
            // Delete interval lines
            if not na(sess.interval_line1)
                line.delete(sess.interval_line1)
            if not na(sess.interval_line2)
                line.delete(sess.interval_line2)
            if not na(sess.interval_line3)
                line.delete(sess.interval_line3)
            if not na(sess.interval_line4)
                line.delete(sess.interval_line4)
            if not na(sess.pool_high_line)
                line.delete(sess.pool_high_line)
            if not na(sess.pool_low_line)
                line.delete(sess.pool_low_line)
            if not na(sess.session_label)
                label.delete(sess.session_label)
            // Delete root line, label, and zone box
            if not na(sess.root_line)
                line.delete(sess.root_line)
            if not na(sess.root_label)
                label.delete(sess.root_label)
            if not na(sess.root_box)
                box.delete(sess.root_box)
            // Delete AMRP boxes, EQ lines, and projection lines
            if not na(sess.amrp_up_box)
                box.delete(sess.amrp_up_box)
            if not na(sess.amrp_dn_box)
                box.delete(sess.amrp_dn_box)
            if not na(sess.amrp_up_eq_line)
                line.delete(sess.amrp_up_eq_line)
            if not na(sess.amrp_dn_eq_line)
                line.delete(sess.amrp_dn_eq_line)
            if not na(sess.amrp_up_proj1)
                line.delete(sess.amrp_up_proj1)
            if not na(sess.amrp_up_proj1_label)
                label.delete(sess.amrp_up_proj1_label)
            if not na(sess.amrp_up_proj2)
                line.delete(sess.amrp_up_proj2)
            if not na(sess.amrp_up_proj2_label)
                label.delete(sess.amrp_up_proj2_label)
            if not na(sess.amrp_up_proj3)
                line.delete(sess.amrp_up_proj3)
            if not na(sess.amrp_up_proj3_label)
                label.delete(sess.amrp_up_proj3_label)
            if not na(sess.amrp_up_proj4)
                line.delete(sess.amrp_up_proj4)
            if not na(sess.amrp_up_proj4_label)
                label.delete(sess.amrp_up_proj4_label)
            if not na(sess.amrp_dn_proj1)
                line.delete(sess.amrp_dn_proj1)
            if not na(sess.amrp_dn_proj1_label)
                label.delete(sess.amrp_dn_proj1_label)
            if not na(sess.amrp_dn_proj2)
                line.delete(sess.amrp_dn_proj2)
            if not na(sess.amrp_dn_proj2_label)
                label.delete(sess.amrp_dn_proj2_label)
            if not na(sess.amrp_dn_proj3)
                line.delete(sess.amrp_dn_proj3)
            if not na(sess.amrp_dn_proj3_label)
                label.delete(sess.amrp_dn_proj3_label)
            if not na(sess.amrp_dn_proj4)
                line.delete(sess.amrp_dn_proj4)
            if not na(sess.amrp_dn_proj4_label)
                label.delete(sess.amrp_dn_proj4_label)
            // Delete Fibonacci lines and labels
            if not na(sess.fib_line_0)
                line.delete(sess.fib_line_0)
            if not na(sess.fib_line_295)
                line.delete(sess.fib_line_295)
            if not na(sess.fib_line_382)
                line.delete(sess.fib_line_382)
            if not na(sess.fib_line_50)
                line.delete(sess.fib_line_50)
            if not na(sess.fib_line_618)
                line.delete(sess.fib_line_618)
            if not na(sess.fib_line_705)
                line.delete(sess.fib_line_705)
            if not na(sess.fib_line_100)
                line.delete(sess.fib_line_100)
            if not na(sess.fib_label_0)
                label.delete(sess.fib_label_0)
            if not na(sess.fib_label_295)
                label.delete(sess.fib_label_295)
            if not na(sess.fib_label_382)
                label.delete(sess.fib_label_382)
            if not na(sess.fib_label_50)
                label.delete(sess.fib_label_50)
            if not na(sess.fib_label_618)
                label.delete(sess.fib_label_618)
            if not na(sess.fib_label_705)
                label.delete(sess.fib_label_705)
            if not na(sess.fib_label_100)
                label.delete(sess.fib_label_100)

        for i = 0 to sessions_to_delete - 1
            array.shift(session_instances)

// CREATE new sessions using mathematical range checking
if process_sessions
    // Process all session templates
    for i = 0 to array.size(session_templates) - 1
        template = array.get(session_templates, i)

        // Check if start time falls within current bar's range
        start_wraps_midnight = template.end_time < template.start_time
        session_should_start = time_in_bar_range(template.start_time, false)  // Start time never wraps

        // IMPORTANT: Also check if root time is reached (for sessions with roots BEFORE their start time)
        // Example: Model 111 starts at 14:09 but root is at 13:30
        // We need to pre-create the session at 13:30 so the root can be captured
        root_hour = math.floor(template.root_time / 100)
        root_minute = template.root_time % 100
        root_time_reached = false
        if timeframe.multiplier == 1
            root_time_reached := current_hour == root_hour and current_minute == root_minute
        else
            root_minutes_since_midnight = root_hour * 60 + root_minute
            bar_start_minutes = current_hour * 60 + current_minute
            bar_end_minutes = bar_start_minutes + timeframe.multiplier
            root_time_reached := root_minutes_since_midnight >= bar_start_minutes and root_minutes_since_midnight < bar_end_minutes

        // Check if this session type already has an active instance
        session_exists = false
        existing_session_index = -1
        if array.size(session_instances) > 0
            for j = array.size(session_instances) - 1 to 0
                sess = array.get(session_instances, j)
                if sess.name == template.name and not na(sess.start_bar) and na(sess.end_bar)
                    session_exists := true
                    existing_session_index := j
                    break

        // ⚠️ PHASE 2: If session was pre-created for root but now officially starting, update start_timestamp
        // CHANGELOG [2025-10-13]: Added boundary deletion, end boundary, and label drawing in phase 2
        if session_exists and session_should_start and existing_session_index >= 0
            sess = array.get(session_instances, existing_session_index)
            if na(sess.start_timestamp)
                sess.start_timestamp := time

                // Delete previous session's end boundary (which shares this timestamp)
                prev_session = get_last_session_of_type(template.prev_session_name)

                // Extend previous session's root elements to current session's end (aesthetic fix)
                if not na(prev_session.root_line) and show_roots
                    // Use this session's end timestamp to extend previous root to
                    extension_end_timestamp = sess.end_timestamp

                    // Extend root line
                    if not na(prev_session.root_line)
                        line.set_x2(prev_session.root_line, extension_end_timestamp)

                    // Extend root box
                    if not na(prev_session.root_box)
                        box.set_right(prev_session.root_box, extension_end_timestamp)

                    // Move root label to new end position
                    if not na(prev_session.root_label)
                        label.set_x(prev_session.root_label, extension_end_timestamp)

                    // Update the previous session in the array
                    if array.size(session_instances) > 1
                        for j = array.size(session_instances) - 2 to 0
                            check_sess = array.get(session_instances, j)
                            if check_sess.name == template.prev_session_name and not na(check_sess.start_bar)
                                // No need to store anything, just updated the visual elements
                                array.set(session_instances, j, check_sess)
                                break

                if not na(prev_session.end_boundary_line)
                    line.delete(prev_session.end_boundary_line)
                    // Update the previous session in the array
                    if array.size(session_instances) > 1
                        for j = array.size(session_instances) - 2 to 0
                            check_sess = array.get(session_instances, j)
                            if check_sess.name == template.prev_session_name and not na(check_sess.start_bar)
                                check_sess.end_boundary_line := na
                                array.set(session_instances, j, check_sess)
                                break

                // Draw start boundary line now that session is officially starting
                if show_boundaries
                    sess.start_boundary_line := line.new(time, 1e10, time, -1e6, xloc=xloc.bar_time, color=boundary_color, width=1, style=boundary_style_converted)

                // Draw end boundary line now that session is officially starting
                if show_boundaries
                    sess.end_boundary_line := line.new(sess.end_timestamp, 1e10, sess.end_timestamp, -1e6, xloc=xloc.bar_time, color=boundary_color, width=1, style=boundary_style_converted)

                // Draw high/low lines now that session is officially starting
                if show_pool_lines
                    // ⚠️ CRITICAL: Check not only for na, but also that values aren't at initialization extremes
                    // CHANGELOG [2025-10-13]: Added check for initialization values
                    // PROBLEM: Judas and NY Open missing high/low lines on instruments without 9:30 bar (e.g., NQ)
                    // ROOT CAUSE: Previous session had high/low still at -1e10/1e10 (initialization)
                    // FIX: Validate that high < 1e9 and low > -1e9 (realistic values)
                    valid_high = not na(prev_session.session_high) and prev_session.session_high < 1e9
                    valid_low = not na(prev_session.session_low) and prev_session.session_low > -1e9
                    if valid_high and valid_low
                        // Use the already-calculated end_timestamp from session object
                        end_timestamp = sess.end_timestamp

                        // Draw the high/low lines using start_timestamp (session start time, NOT root time)
                        sess.pool_high_line := line.new(time, prev_session.session_high, end_timestamp, prev_session.session_high, xloc=xloc.bar_time, color=pool_color, width=1, style=pool_style_converted)
                        sess.pool_low_line := line.new(time, prev_session.session_low, end_timestamp, prev_session.session_low, xloc=xloc.bar_time, color=pool_color, width=1, style=pool_style_converted)

                // Draw session label now that session is officially starting
                if show_session_labels
                    label_text = template.name
                    if show_root_time_in_session_label
                        root_hour_str = str.tostring(math.floor(template.root_time / 100), "#00")
                        root_minute_str = str.tostring(template.root_time % 100, "#00")
                        label_text := template.name + "\n(" + root_hour_str + ":" + root_minute_str + ")"

                    session_midpoint_timestamp = math.round((time + sess.end_timestamp) / 2)
                    sess.session_label := label.new(session_midpoint_timestamp, high, text=label_text, xloc=xloc.bar_time, style=label.style_none, color=color.new(color.white, 100), textcolor=session_label_color, size=session_label_size_converted)

                // Draw interval lines now that session is officially starting
                if show_intervals
                    [interval1_time, interval2_time, interval3_time, interval4_time] = get_interval_times(template.name)

                    // Calculate timestamps for each interval
                    current_year = year(time, TIMEZONE)
                    current_month = month(time, TIMEZONE)
                    current_date = dayofmonth(time, TIMEZONE)

                    // Interval 1
                    interval1_hour = math.floor(interval1_time / 100)
                    interval1_minute = interval1_time % 100
                    interval1_timestamp = timestamp(TIMEZONE, current_year, current_month, current_date, interval1_hour, interval1_minute)
                    if interval1_time < template.start_time and template.end_time < template.start_time
                        interval1_timestamp := interval1_timestamp + MILLISECONDS_PER_DAY
                    sess.interval_line1 := line.new(interval1_timestamp, 1e10, interval1_timestamp, -1e6, xloc=xloc.bar_time, color=interval_color, width=1, style=interval_style_converted)

                    // Interval 2
                    interval2_hour = math.floor(interval2_time / 100)
                    interval2_minute = interval2_time % 100
                    interval2_timestamp = timestamp(TIMEZONE, current_year, current_month, current_date, interval2_hour, interval2_minute)
                    if interval2_time < template.start_time and template.end_time < template.start_time
                        interval2_timestamp := interval2_timestamp + MILLISECONDS_PER_DAY
                    sess.interval_line2 := line.new(interval2_timestamp, 1e10, interval2_timestamp, -1e6, xloc=xloc.bar_time, color=interval_color, width=1, style=interval_style_converted)

                    // Interval 3
                    interval3_hour = math.floor(interval3_time / 100)
                    interval3_minute = interval3_time % 100
                    interval3_timestamp = timestamp(TIMEZONE, current_year, current_month, current_date, interval3_hour, interval3_minute)
                    if interval3_time < template.start_time and template.end_time < template.start_time
                        interval3_timestamp := interval3_timestamp + MILLISECONDS_PER_DAY
                    sess.interval_line3 := line.new(interval3_timestamp, 1e10, interval3_timestamp, -1e6, xloc=xloc.bar_time, color=interval_color, width=1, style=interval_style_converted)

                    // Interval 4 (Model 1001 only)
                    if interval4_time > 0
                        interval4_hour = math.floor(interval4_time / 100)
                        interval4_minute = interval4_time % 100
                        interval4_timestamp = timestamp(TIMEZONE, current_year, current_month, current_date, interval4_hour, interval4_minute)
                        if interval4_time < template.start_time and template.end_time < template.start_time
                            interval4_timestamp := interval4_timestamp + MILLISECONDS_PER_DAY
                        sess.interval_line4 := line.new(interval4_timestamp, 1e10, interval4_timestamp, -1e6, xloc=xloc.bar_time, color=interval_color, width=1, style=interval_style_converted)

                array.set(session_instances, existing_session_index, sess)

        // Create session if it should start OR if root time is reached (and doesn't exist yet)
        if (session_should_start or root_time_reached) and not session_exists
            // Count completed "days" (Model 111 sessions mark end of day)
            completed_days = get_completed_model111_count()
            day_number = completed_days

            // IMPORTANT: Set start_timestamp to na if this is a pre-creation for root capture
            // It will be updated to the actual start time when session officially starts
            session_start_timestamp = session_should_start ? time : na

            // Calculate end_timestamp early so it can be used for AMRP zones
            end_hour = math.floor(template.end_time / 100)
            end_minute = template.end_time % 100
            end_minutes_since_midnight = end_hour * 60 + end_minute
            end_bar_minutes = math.floor(end_minutes_since_midnight / timeframe.multiplier) * timeframe.multiplier
            end_bar_hour = math.floor(end_bar_minutes / 60)
            end_bar_minute = end_bar_minutes % 60
            current_year = year(time, TIMEZONE)
            current_month = month(time, TIMEZONE)
            current_date = dayofmonth(time, TIMEZONE)
            calculated_end_timestamp = timestamp(TIMEZONE, current_year, current_month, current_date, end_bar_hour, end_bar_minute)
            // ⚠️ CRITICAL: Only add a day if session actually wraps midnight
            // CHANGELOG [2025-10-13]: Removed `or calculated_end_timestamp <= time` condition
            // PROBLEM: Lines extending 24 hours into future when changing "Show Last N Days"
            // FIX: Only add day for midnight-wrapping sessions, not historical sessions
            if template.end_time < template.start_time
                calculated_end_timestamp := calculated_end_timestamp + MILLISECONDS_PER_DAY

            // ⚠️ CRITICAL: Initialize with extreme values so first 1-minute data always sets the high/low
            // DO NOT CHANGE -1e10 and 1e10 - see Developer Docs section 2.1
            new_sess = DttIntradaySession.new(template.start_time, template.end_time, template.name, template.prev_session_name, bar_index, na, session_start_timestamp, calculated_end_timestamp, day_number, -1e10, 1e10, bar_index, bar_index, na, na, false, na, na, na, na, na, na, na, na, na, template.root_time, na, na, na, na, false, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, false, false, false, false, false, na, na, na, na, na, na, na, na)
            array.push(session_instances, new_sess)

            // Draw boundaries
            idx = array.size(session_instances) - 1
            curr_sess = array.get(session_instances, idx)

            // ⚠️ CRITICAL: Get previous session to delete its end boundary ONLY if this is NOT a pre-creation
            // If session_start_timestamp is na, this is a pre-creation - we'll delete it when session officially starts
            // CHANGELOG [2025-10-13]: Added this check to prevent Model 1001's boundary from disappearing at 13:30
            // PROBLEM: Model 1001 end boundary disappeared when Model 111 was pre-created at 13:30 (root time)
            // FIX: Only delete previous boundary when session officially starts, not during pre-creation
            if not na(session_start_timestamp)
                prev_session = get_last_session_of_type(template.prev_session_name)

                // Extend previous session's root elements to current session's end (aesthetic fix)
                if not na(prev_session.root_line) and show_roots
                    // Calculate this session's end timestamp to extend previous root to
                    extension_end_timestamp = calculated_end_timestamp

                    // Extend root line
                    if not na(prev_session.root_line)
                        line.set_x2(prev_session.root_line, extension_end_timestamp)

                    // Extend root box
                    if not na(prev_session.root_box)
                        box.set_right(prev_session.root_box, extension_end_timestamp)

                    // Move root label to new end position
                    if not na(prev_session.root_label)
                        label.set_x(prev_session.root_label, extension_end_timestamp)

                    // Update the previous session in the array
                    if array.size(session_instances) > 1
                        for j = array.size(session_instances) - 2 to 0
                            check_sess = array.get(session_instances, j)
                            if check_sess.name == template.prev_session_name and not na(check_sess.start_bar)
                                // No need to store anything, just updated the visual elements
                                array.set(session_instances, j, check_sess)
                                break

                if not na(prev_session.end_boundary_line)
                    line.delete(prev_session.end_boundary_line)
                    // Update the previous session in the array
                    if array.size(session_instances) > 1
                        for j = array.size(session_instances) - 2 to 0
                            check_sess = array.get(session_instances, j)
                            if check_sess.name == template.prev_session_name and not na(check_sess.start_bar)
                                check_sess.end_boundary_line := na
                                array.set(session_instances, j, check_sess)
                                break

            // Draw start boundary at CURRENT BAR TIME (only if enabled and NOT a pre-creation)
            // If session_start_timestamp is na, this is a pre-creation for root - boundary will be drawn when session officially starts
            if show_boundaries and not na(session_start_timestamp)
                curr_sess.start_boundary_line := line.new(session_start_timestamp, 1e10, session_start_timestamp, -1e6, xloc=xloc.bar_time, color=boundary_color, width=1, style=boundary_style_converted)

            // Use the already-calculated end_timestamp from session object
            end_timestamp = curr_sess.end_timestamp

            // ⚠️ CRITICAL: Draw end boundary ONLY if this is NOT a pre-creation
            // CHANGELOG [2025-10-13]: Added `not na(session_start_timestamp)` check
            // PROBLEM: End boundaries appeared at root time (13:30) instead of session start (14:09)
            // FIX: Boundary will be drawn when session officially starts (see phase 2 logic earlier)
            if show_boundaries and not na(session_start_timestamp)
                curr_sess.end_boundary_line := line.new(end_timestamp, 1e10, end_timestamp, -1e6, xloc=xloc.bar_time, color=boundary_color, width=1, style=boundary_style_converted)

            // Get previous session for drawing high/low lines
            prev_session = get_last_session_of_type(template.prev_session_name)

            // Draw high/low lines from previous session ONLY if this is NOT a pre-creation
            // If session_start_timestamp is na, this is a pre-creation for root capture
            // Lines will be drawn later when session officially starts
            // ⚠️ CRITICAL: Also validate that values aren't at initialization extremes
            valid_high = not na(prev_session.session_high) and prev_session.session_high < 1e9
            valid_low = not na(prev_session.session_low) and prev_session.session_low > -1e9
            if show_pool_lines and valid_high and valid_low and not na(session_start_timestamp)
                curr_sess.pool_high_line := line.new(session_start_timestamp, prev_session.session_high, end_timestamp, prev_session.session_high, xloc=xloc.bar_time, color=pool_color, width=1, style=pool_style_converted)
                curr_sess.pool_low_line := line.new(session_start_timestamp, prev_session.session_low, end_timestamp, prev_session.session_low, xloc=xloc.bar_time, color=pool_color, width=1, style=pool_style_converted)

            // ⚠️ CRITICAL: Draw session name label ONLY if this is NOT a pre-creation
            // CHANGELOG [2025-10-13]: Added `not na(session_start_timestamp)` check
            // PROBLEM: Model 111 label appeared at 13:30 (root time) instead of 14:09 (session start)
            // FIX: Label will be drawn when session officially starts (see phase 2 logic earlier)
            if show_session_labels and not na(session_start_timestamp)
                label_text = template.name
                if show_root_time_in_session_label
                    root_hour_str = str.tostring(math.floor(template.root_time / 100), "#00")
                    root_minute_str = str.tostring(template.root_time % 100, "#00")
                    label_text := template.name + "\n(" + root_hour_str + ":" + root_minute_str + ")"

                // Calculate midpoint timestamp between session start and end
                session_midpoint_timestamp = math.round((time + end_timestamp) / 2)
                curr_sess.session_label := label.new(session_midpoint_timestamp, high, text=label_text, xloc=xloc.bar_time, style=label.style_none, color=color.new(color.white, 100), textcolor=session_label_color, size=session_label_size_converted)

            // Draw interval lines for new session (ONLY if this is NOT a pre-creation)
            if show_intervals and not na(session_start_timestamp)
                [interval1_time, interval2_time, interval3_time, interval4_time] = get_interval_times(template.name)

                // Calculate timestamps for each interval
                current_year = year(time, TIMEZONE)
                current_month = month(time, TIMEZONE)
                current_date = dayofmonth(time, TIMEZONE)

                // Interval 1
                interval1_hour = math.floor(interval1_time / 100)
                interval1_minute = interval1_time % 100
                interval1_timestamp = timestamp(TIMEZONE, current_year, current_month, current_date, interval1_hour, interval1_minute)
                if interval1_time < template.start_time and template.end_time < template.start_time
                    interval1_timestamp := interval1_timestamp + MILLISECONDS_PER_DAY
                curr_sess.interval_line1 := line.new(interval1_timestamp, 1e10, interval1_timestamp, -1e6, xloc=xloc.bar_time, color=interval_color, width=1, style=interval_style_converted)

                // Interval 2
                interval2_hour = math.floor(interval2_time / 100)
                interval2_minute = interval2_time % 100
                interval2_timestamp = timestamp(TIMEZONE, current_year, current_month, current_date, interval2_hour, interval2_minute)
                if interval2_time < template.start_time and template.end_time < template.start_time
                    interval2_timestamp := interval2_timestamp + MILLISECONDS_PER_DAY
                curr_sess.interval_line2 := line.new(interval2_timestamp, 1e10, interval2_timestamp, -1e6, xloc=xloc.bar_time, color=interval_color, width=1, style=interval_style_converted)

                // Interval 3
                interval3_hour = math.floor(interval3_time / 100)
                interval3_minute = interval3_time % 100
                interval3_timestamp = timestamp(TIMEZONE, current_year, current_month, current_date, interval3_hour, interval3_minute)
                if interval3_time < template.start_time and template.end_time < template.start_time
                    interval3_timestamp := interval3_timestamp + MILLISECONDS_PER_DAY
                curr_sess.interval_line3 := line.new(interval3_timestamp, 1e10, interval3_timestamp, -1e6, xloc=xloc.bar_time, color=interval_color, width=1, style=interval_style_converted)

                // Interval 4 (Model 1001 only)
                if interval4_time > 0
                    interval4_hour = math.floor(interval4_time / 100)
                    interval4_minute = interval4_time % 100
                    interval4_timestamp = timestamp(TIMEZONE, current_year, current_month, current_date, interval4_hour, interval4_minute)
                    if interval4_time < template.start_time and template.end_time < template.start_time
                        interval4_timestamp := interval4_timestamp + MILLISECONDS_PER_DAY
                    curr_sess.interval_line4 := line.new(interval4_timestamp, 1e10, interval4_timestamp, -1e6, xloc=xloc.bar_time, color=interval_color, width=1, style=interval_style_converted)

            array.set(session_instances, idx, curr_sess)

// ══════════════════════════════════════════════════════════════════════════════
// PERFORMANCE OPTIMIZATION: Cache 1-minute data ONCE per bar (not per session)
// ══════════════════════════════════════════════════════════════════════════════
// PROBLEM: request.security_lower_tf() was being called inside session loop (3x per bar)
// FIX: Call once, cache result, reuse for all sessions (66% performance improvement)

[cached_one_min_highs, cached_one_min_lows, cached_one_min_times] = request.security_lower_tf(syminfo.tickerid, "1", [high, low, time])

// ⚠️ FALLBACK: If no intrabar data (common on real-time bars or chart load), use bar's high/low
if array.size(cached_one_min_highs) == 0
    array.push(cached_one_min_highs, high)
    array.push(cached_one_min_lows, low)
    array.push(cached_one_min_times, time)

// PERFORMANCE OPTIMIZATION: Pre-calculate time conversions ONCE (not per session)
// PROBLEM: hour()/minute() called 15+ times per bar inside nested loops (sessions × 1-min bars)
// FIX: Convert all timestamps once, cache in arrays, reuse in session loop (~10-15% improvement)
var cached_one_min_minutes = array.new<int>()
array.clear(cached_one_min_minutes)

for j = 0 to array.size(cached_one_min_times) - 1
    one_min_time = array.get(cached_one_min_times, j)
    one_min_hour = hour(one_min_time, TIMEZONE)
    one_min_minute = minute(one_min_time, TIMEZONE)
    one_min_minutes_total = one_min_hour * 60 + one_min_minute
    array.push(cached_one_min_minutes, one_min_minutes_total)

// Update high/low for all active sessions and detect first touch (using cached 1-minute data)
if array.size(session_instances) > 0
    for i = 0 to array.size(session_instances) - 1
        sess = array.get(session_instances, i)
        if not na(sess.start_bar) and (na(sess.end_bar) or sess.end_bar == bar_index)
            // Session is active, update high/low using 1-minute data
            // Check if ANY part of current bar overlaps with session time range
            // Use LOCAL copies to avoid mutation across loop iterations
            bar_start_minutes = current_hour * 60 + current_minute
            bar_end_minutes = bar_start_minutes + timeframe.multiplier

            // Convert session times to minutes since midnight
            sess_start_hour = math.floor(sess.start_time / 100)
            sess_start_minute = sess.start_time % 100
            sess_start_minutes = sess_start_hour * 60 + sess_start_minute

            sess_end_hour = math.floor(sess.end_time / 100)
            sess_end_minute = sess.end_time % 100
            sess_end_minutes = sess_end_hour * 60 + sess_end_minute

            // Create local copies for this session's calculations
            check_bar_start_minutes = bar_start_minutes
            check_bar_end_minutes = bar_end_minutes

            // Handle midnight wrapping for sessions
            if sess.start_time > sess.end_time
                sess_end_minutes := sess_end_minutes + 1440  // Add 24 hours

                // For midnight-wrapping sessions, adjust bar times if they're in "early morning"
                // This handles bars like 03:00 which should be treated as next day (03:00 + 1440)
                if check_bar_start_minutes < 720  // Bar is before noon, treat as next day
                    check_bar_start_minutes := check_bar_start_minutes + 1440
                    check_bar_end_minutes := check_bar_end_minutes + 1440

            // Handle bar crossing midnight
            in_session = false
            if check_bar_end_minutes >= 1440 and sess.start_time <= sess.end_time
                // Bar crosses midnight but session doesn't - special handling needed
                // Check if session overlaps with either the pre-midnight or post-midnight portion
                bar_pre_midnight = check_bar_start_minutes < 1440
                bar_post_midnight = check_bar_end_minutes >= 1440
                if bar_pre_midnight and not (check_bar_start_minutes > sess_end_minutes)
                    in_session := true
                if bar_post_midnight and not ((check_bar_end_minutes - 1440) > sess_end_minutes or sess_start_minutes > (check_bar_end_minutes - 1440))
                    in_session := true
            else
                // Normal case or both bar and session handle midnight consistently
                // Use > (not >=) for end boundary to include bars that start exactly at end time
                in_session := not (check_bar_end_minutes <= sess_start_minutes or check_bar_start_minutes > sess_end_minutes)

            if in_session
                // Process all 1-minute bars to find true session high/low (using CACHED data)
                // IMPORTANT: Filter to only include 1-minute bars that fall within session time range
                if array.size(cached_one_min_highs) > 0
                    for j = 0 to array.size(cached_one_min_highs) - 1
                        // Get pre-calculated time in minutes (CACHED - no hour()/minute() calls)
                        one_min_minutes = array.get(cached_one_min_minutes, j)

                        // Calculate session time range in minutes
                        check_sess_start_minutes = sess_start_minutes
                        check_sess_end_minutes = sess_end_minutes

                        // Handle 1-minute bar crossing midnight for midnight-wrapping sessions
                        if sess.start_time > sess.end_time and one_min_minutes < 720  // Session wraps midnight and bar is "early morning"
                            one_min_minutes := one_min_minutes + 1440  // Treat as next day

                        // Check if this 1-minute bar falls within session time range [start, end] (INCLUSIVE on both ends)
                        // Session ending at 09:01 means it includes the ENTIRE 09:01 minute (09:01:00 to 09:01:59)
                        is_in_session_range = one_min_minutes >= check_sess_start_minutes and one_min_minutes <= check_sess_end_minutes

                        if is_in_session_range
                            one_min_high = array.get(cached_one_min_highs, j)
                            one_min_low = array.get(cached_one_min_lows, j)

                            // Capture opening price (first bar of session) - used for AMRP anchor
                            if not sess.session_open_captured and one_min_minutes == check_sess_start_minutes
                                sess.session_open_high := one_min_high
                                sess.session_open_low := one_min_low
                                sess.session_open_captured := true

                            // Track high and bar where it was formed (using 1-minute data)
                            if one_min_high > sess.session_high
                                sess.session_high := one_min_high
                                sess.session_high_bar := bar_index

                            // Track low and bar where it was formed (using 1-minute data)
                            if one_min_low < sess.session_low
                                sess.session_low := one_min_low
                                sess.session_low_bar := bar_index

                            // Update Fibonacci anchors dynamically if price breaks AMRP boundaries
                            // PERFORMANCE: Only update for sessions that are NOT ended (na(end_bar))
                            if show_fib and sess.fib_drawn and na(sess.end_bar) and not na(sess.amrp_up_outer) and not na(sess.amrp_dn_outer)
                                anchors_changed = false

                                // Check if session high broke above AMRP upper outer → trail high anchor
                                if sess.session_high > sess.amrp_up_outer and sess.session_high > sess.fib_high_anchor
                                    sess.fib_high_anchor := sess.session_high
                                    anchors_changed := true

                                // Check if session low broke below AMRP lower outer → trail low anchor
                                if sess.session_low < sess.amrp_dn_outer and sess.session_low < sess.fib_low_anchor
                                    sess.fib_low_anchor := sess.session_low
                                    anchors_changed := true

                                // Redraw Fibonacci levels ONLY if anchors changed
                                if anchors_changed
                                    start_ts = sess.start_timestamp
                                    end_ts = sess.end_timestamp
                                    fib_range = sess.fib_high_anchor - sess.fib_low_anchor
                                    fib_line_style = fib_style_converted

                                    // Calculate new Fibonacci price levels
                                    fib_0 = sess.fib_low_anchor
                                    fib_295 = sess.fib_low_anchor + fib_range * 0.295
                                    fib_382 = sess.fib_low_anchor + fib_range * 0.382
                                    fib_50 = sess.fib_low_anchor + fib_range * 0.50
                                    fib_618 = sess.fib_low_anchor + fib_range * 0.618
                                    fib_705 = sess.fib_low_anchor + fib_range * 0.705
                                    fib_100 = sess.fib_high_anchor

                                    // Update line prices (use line.set_y1 and line.set_y2)
                                    if not na(sess.fib_line_0)
                                        line.set_y1(sess.fib_line_0, fib_0)
                                        line.set_y2(sess.fib_line_0, fib_0)
                                    if not na(sess.fib_line_295)
                                        line.set_y1(sess.fib_line_295, fib_295)
                                        line.set_y2(sess.fib_line_295, fib_295)
                                    if not na(sess.fib_line_382)
                                        line.set_y1(sess.fib_line_382, fib_382)
                                        line.set_y2(sess.fib_line_382, fib_382)
                                    if not na(sess.fib_line_50)
                                        line.set_y1(sess.fib_line_50, fib_50)
                                        line.set_y2(sess.fib_line_50, fib_50)
                                    if not na(sess.fib_line_618)
                                        line.set_y1(sess.fib_line_618, fib_618)
                                        line.set_y2(sess.fib_line_618, fib_618)
                                    if not na(sess.fib_line_705)
                                        line.set_y1(sess.fib_line_705, fib_705)
                                        line.set_y2(sess.fib_line_705, fib_705)
                                    if not na(sess.fib_line_100)
                                        line.set_y1(sess.fib_line_100, fib_100)
                                        line.set_y2(sess.fib_line_100, fib_100)

                                    // Update label prices if labels are enabled
                                    if show_fib_labels
                                        if not na(sess.fib_label_0)
                                            label.set_y(sess.fib_label_0, fib_0)
                                        if not na(sess.fib_label_295)
                                            label.set_y(sess.fib_label_295, fib_295)
                                        if not na(sess.fib_label_382)
                                            label.set_y(sess.fib_label_382, fib_382)
                                        if not na(sess.fib_label_50)
                                            label.set_y(sess.fib_label_50, fib_50)
                                        if not na(sess.fib_label_618)
                                            label.set_y(sess.fib_label_618, fib_618)
                                        if not na(sess.fib_label_705)
                                            label.set_y(sess.fib_label_705, fib_705)
                                        if not na(sess.fib_label_100)
                                            label.set_y(sess.fib_label_100, fib_100)

                // Get previous session's high/low for comparison
                prev_session = get_last_session_of_type(sess.prev_session_name)
                prev_high = prev_session.session_high
                prev_low = prev_session.session_low

                array.set(session_instances, i, sess)

// ══════════════════════════════════════════════════════════════════════════════
// ROOT PRICE CAPTURE
// ══════════════════════════════════════════════════════════════════════════════

// ⚠️ CRITICAL: Capture root prices for ALL sessions (ALWAYS, regardless of display toggle)
// IMPORTANT: Some sessions have roots BEFORE their start time (e.g., Model 111 root at 13:30, starts at 14:09)
// These root times are based on years of study and must NEVER be changed
// CHANGELOG [2025-10-13]: Removed `if show_roots` gate - root CAPTURE must be independent of DISPLAY
// BUG FIX: AMRP requires root data even when root visualization is disabled
if true  // Always capture roots (used by AMRP even if show_roots is false)
    // Check if current bar contains any root time from ANY session template
    for template_idx = 0 to array.size(session_templates) - 1
        template = array.get(session_templates, template_idx)

        // Check if root time is reached (handle different timeframes)
        is_root_bar = false
        root_hour = math.floor(template.root_time / 100)
        root_minute = template.root_time % 100

        if timeframe.multiplier == 1
            // 1-minute: exact match
            is_root_bar := current_hour == root_hour and current_minute == root_minute
        else
            // Higher timeframes: check if root time falls within this bar
            root_minutes_since_midnight = root_hour * 60 + root_minute
            bar_start_minutes = current_hour * 60 + current_minute
            bar_end_minutes = bar_start_minutes + timeframe.multiplier

            // Check if root time falls within [bar_start, bar_end) range
            is_root_bar := root_minutes_since_midnight >= bar_start_minutes and root_minutes_since_midnight < bar_end_minutes

        // If this bar contains a root time, find the session and capture it
        if is_root_bar
            // Find the session instance for this template (it may not exist yet if root comes before session start)
            target_session_index = -1
            if array.size(session_instances) > 0
                for i = array.size(session_instances) - 1 to 0
                    sess = array.get(session_instances, i)
                    // Find the most recent instance of this session type that hasn't captured root yet
                    if sess.name == template.name and not sess.root_captured
                        target_session_index := i
                        break

            // If session found, capture the root
            if target_session_index >= 0
                sess = array.get(session_instances, target_session_index)

                // Get all 1-minute bars within the current bar (high, low, and time)
                [one_min_highs, one_min_lows, one_min_times] = request.security_lower_tf(syminfo.tickerid, "1", [high, low, time])

                // ⚠️ FALLBACK: If no intrabar data, use bar's high/low for root capture
                // CHANGELOG [2025-10-13]: Added fallback for root capture on real-time bars
                if array.size(one_min_highs) == 0
                    array.push(one_min_highs, high)
                    array.push(one_min_lows, low)
                    array.push(one_min_times, time)

                // Find the exact 1-minute bar that matches the root time
                if array.size(one_min_times) > 0
                    for j = 0 to array.size(one_min_times) - 1
                        bar_time = array.get(one_min_times, j)
                        bar_hour = hour(bar_time, TIMEZONE)
                        bar_minute = minute(bar_time, TIMEZONE)
                        bar_time_hhmm = bar_hour * 100 + bar_minute

                        // Check if this 1-minute bar's time matches the root time exactly
                        if bar_time_hhmm == template.root_time
                            sess.root_high := array.get(one_min_highs, j)
                            sess.root_low := array.get(one_min_lows, j)
                            sess.root_price := (sess.root_high + sess.root_low) / 2.0
                            sess.root_timestamp := bar_time  // CAPTURE the actual timestamp!
                            sess.root_captured := true
                            break

                    array.set(session_instances, target_session_index, sess)

// ══════════════════════════════════════════════════════════════════════════════
// ROOT LINE & ZONE DRAWING
// ══════════════════════════════════════════════════════════════════════════════

// Helper function to get next session name in cascade
get_next_session_name(current_session_name) =>
    result = ""
    switch current_session_name
        SESSION_DAMASU => result := SESSION_OSAKA
        SESSION_OSAKA => result := SESSION_KYOTO
        SESSION_KYOTO => result := SESSION_NAGASAKI
        SESSION_NAGASAKI => result := SESSION_TURNCOAT
        SESSION_TURNCOAT => result := SESSION_BISHOP
        SESSION_BISHOP => result := SESSION_KNIGHT
        SESSION_KNIGHT => result := SESSION_BIGBEN
        SESSION_BIGBEN => result := SESSION_NYOPEN
        SESSION_NYOPEN => result := SESSION_JUDAS
        SESSION_JUDAS => result := SESSION_MODEL11
        SESSION_MODEL11 => result := SESSION_MODEL110
        SESSION_MODEL110 => result := SESSION_LUNCH
        SESSION_LUNCH => result := SESSION_MODEL1001
        SESSION_MODEL1001 => result := SESSION_MODEL111
        SESSION_MODEL111 => result := SESSION_DAMASU
    result

// Draw root lines and zones for sessions that have captured root price
if show_roots and array.size(session_instances) > 0
    for i = 0 to array.size(session_instances) - 1
        sess = array.get(session_instances, i)

        // Draw line/zone if root captured but not yet drawn
        if sess.root_captured and not na(sess.root_price) and na(sess.root_line) and not na(sess.root_timestamp)
            // Use the ACTUAL captured root timestamp
            root_timestamp = sess.root_timestamp
            root_hour = math.floor(sess.root_time / 100)
            root_minute = sess.root_time % 100

            // AESTHETIC FIX: Initially draw to CURRENT session's end (clamped for clean look)
            // Will be extended to next session's end when next session starts
            visual_end_timestamp = sess.end_timestamp

            // Draw root zone (shaded box) if enabled - initially clamped to current session
            if show_root_zone and not na(sess.root_high) and not na(sess.root_low)
                sess.root_box := box.new(root_timestamp, sess.root_high, visual_end_timestamp, sess.root_low,
                                         xloc=xloc.bar_time, border_color=color.new(color.blue, 100),
                                         bgcolor=root_zone_color, border_width=0)

            // Draw horizontal EQ line - initially clamped to current session
            if show_root_line
                sess.root_line := line.new(root_timestamp, sess.root_price, visual_end_timestamp, sess.root_price,
                                           xloc=xloc.bar_time, color=root_line_color, width=1, style=root_line_style_converted)

            // Create time label at end of line (no price)
            if show_root_time_label
                root_hour_str = str.tostring(root_hour, "#00")
                root_minute_str = str.tostring(root_minute, "#00")
                label_text = root_hour_str + ":" + root_minute_str

                sess.root_label := label.new(visual_end_timestamp, sess.root_price, text=label_text,
                                             xloc=xloc.bar_time, style=label.style_label_left,
                                             color=color.new(root_time_label_color, 70), textcolor=root_time_text_color, size=root_label_size_converted)

            array.set(session_instances, i, sess)

// ══════════════════════════════════════════════════════════════════════════════
// AMRP ZONE DRAWING
// ══════════════════════════════════════════════════════════════════════════════

// Draw AMRP zones for model sessions
if show_amrp and array.size(session_instances) > 0
    for i = 0 to array.size(session_instances) - 1
        sess = array.get(session_instances, i)

        // Draw AMRP if session has captured opening price and not yet drawn
        if sess.session_open_captured and not sess.amrp_drawn
            if not na(sess.session_open_high) and not na(sess.session_open_low)
                if not na(sess.start_timestamp) and not na(sess.end_timestamp)
                    start_ts = sess.start_timestamp
                    end_ts = sess.end_timestamp

                    if amrp_lookback_mode == "Compare 3"
                        // Draw 3 lookbacks simultaneously: 4, 6, 9
                        lookbacks = array.from(4, 6, 9)
                        transparencies = array.from(90, 80, 70)  // Faint to strong

                        // Track zone sizes to find largest
                        var array<float> zone_sizes_up = array.new<float>()
                        var array<float> zone_sizes_dn = array.new<float>()
                        var array<float> stored_up_inner = array.new<float>()
                        var array<float> stored_up_outer = array.new<float>()
                        var array<float> stored_dn_inner = array.new<float>()
                        var array<float> stored_dn_outer = array.new<float>()
                        array.clear(zone_sizes_up)
                        array.clear(zone_sizes_dn)
                        array.clear(stored_up_inner)
                        array.clear(stored_up_outer)
                        array.clear(stored_dn_inner)
                        array.clear(stored_dn_outer)

                        for lb_idx = 0 to 2
                            lb = array.get(lookbacks, lb_idx)
                            transp = array.get(transparencies, lb_idx)

                            [has_data, up_inner, up_outer, dn_inner, dn_outer] = get_amrp_percentiles(sess.name, 0, 0, lb)

                            if has_data
                                amrp_up_inner_price = sess.session_open_high + up_inner
                                amrp_up_outer_price = sess.session_open_high + up_outer
                                amrp_dn_inner_price = sess.session_open_low - dn_inner
                                amrp_dn_outer_price = sess.session_open_low - dn_outer

                                // Calculate zone sizes (outer - inner = zone range)
                                up_zone_size = amrp_up_outer_price - amrp_up_inner_price
                                dn_zone_size = amrp_dn_inner_price - amrp_dn_outer_price

                                // Store for later comparison
                                array.push(zone_sizes_up, up_zone_size)
                                array.push(zone_sizes_dn, dn_zone_size)
                                array.push(stored_up_inner, amrp_up_inner_price)
                                array.push(stored_up_outer, amrp_up_outer_price)
                                array.push(stored_dn_inner, amrp_dn_inner_price)
                                array.push(stored_dn_outer, amrp_dn_outer_price)

                                // Draw AMRP+ zone with transparency
                                box.new(start_ts, amrp_up_outer_price,
                                       end_ts, amrp_up_inner_price,
                                       xloc=xloc.bar_time, border_color=color.new(amrp_zone_color, 100),
                                       bgcolor=color.new(amrp_zone_color, transp), border_width=0)

                                // Draw AMRP- zone with transparency
                                box.new(start_ts, amrp_dn_inner_price,
                                       end_ts, amrp_dn_outer_price,
                                       xloc=xloc.bar_time, border_color=color.new(amrp_zone_color, 100),
                                       bgcolor=color.new(amrp_zone_color, transp), border_width=0)

                                // Add lookback identifier labels - centered in zone, floating style
                                mid_ts = math.floor((start_ts + end_ts) / 2)  // Horizontal center of session
                                up_label_price = amrp_up_outer_price - (up_zone_size * 0.15)  // 15% down from outer edge
                                dn_label_price = amrp_dn_outer_price + (dn_zone_size * 0.15)  // 15% up from outer edge

                                // Upper zone label
                                label.new(mid_ts, up_label_price,
                                         text="LB" + str.tostring(lb),
                                         xloc=xloc.bar_time,
                                         yloc=yloc.price,
                                         color=color.new(color.white, 100),
                                         textcolor=color.new(color.gray, 40),
                                         size=size.tiny,
                                         style=label.style_label_center,
                                         textalign=text.align_center)

                                // Lower zone label
                                label.new(mid_ts, dn_label_price,
                                         text="LB" + str.tostring(lb),
                                         xloc=xloc.bar_time,
                                         yloc=yloc.price,
                                         color=color.new(color.white, 100),
                                         textcolor=color.new(color.gray, 40),
                                         size=size.tiny,
                                         style=label.style_label_center,
                                         textalign=text.align_center)

                        // Determine which lookback to use for projections based on toggle (only if we have data)
                        if array.size(zone_sizes_up) > 0
                            if compare3_projection_source == "Combined Envelope"
                                // Use extreme outer boundaries from all 3 lookbacks (widest possible envelope)
                                combined_up_outer = array.get(stored_up_outer, 0)
                                combined_up_inner = array.get(stored_up_inner, 0)
                                combined_dn_outer = array.get(stored_dn_outer, 0)
                                combined_dn_inner = array.get(stored_dn_inner, 0)

                                // Find extreme boundaries across all lookbacks
                                for idx = 1 to array.size(stored_up_outer) - 1
                                    combined_up_outer := math.max(combined_up_outer, array.get(stored_up_outer, idx))  // Highest upper outer (furthest up)
                                    combined_up_inner := math.min(combined_up_inner, array.get(stored_up_inner, idx))  // Lowest upper inner (closest to root)
                                    combined_dn_outer := math.min(combined_dn_outer, array.get(stored_dn_outer, idx))  // Lowest lower outer (furthest down)
                                    combined_dn_inner := math.max(combined_dn_inner, array.get(stored_dn_inner, idx))  // Highest lower inner (closest to root)

                                sess.amrp_up_inner := combined_up_inner
                                sess.amrp_up_outer := combined_up_outer
                                sess.amrp_dn_inner := combined_dn_inner
                                sess.amrp_dn_outer := combined_dn_outer
                                sess.amrp_bars_total := 0
                                sess.amrp_bars_within_inner := 0
                                sess.amrp_bars_within_outer := 0
                                sess.amrp_bars_broke_outer := 0
                            else
                                selected_idx = 0
                                if compare3_projection_source == "Largest Zone"
                                    // Find lookback with largest zone (use average of up and down zone sizes)
                                    largest_size = 0.0
                                    for idx = 0 to array.size(zone_sizes_up) - 1
                                        avg_size = (array.get(zone_sizes_up, idx) + array.get(zone_sizes_dn, idx)) / 2
                                        if avg_size > largest_size
                                            largest_size := avg_size
                                            selected_idx := idx
                                else  // "Most Recent (LB 4)"
                                    // Use lookback 4 (first index = 0)
                                    selected_idx := 0

                                // Store selected lookback's boundaries for projections and accuracy tracking
                                if array.size(stored_up_outer) > selected_idx
                                    sess.amrp_up_inner := array.get(stored_up_inner, selected_idx)
                                    sess.amrp_up_outer := array.get(stored_up_outer, selected_idx)
                                    sess.amrp_dn_inner := array.get(stored_dn_inner, selected_idx)
                                    sess.amrp_dn_outer := array.get(stored_dn_outer, selected_idx)
                                    sess.amrp_bars_total := 0
                                    sess.amrp_bars_within_inner := 0
                                    sess.amrp_bars_within_outer := 0
                                    sess.amrp_bars_broke_outer := 0

                        sess.amrp_drawn := true

                        // Initialize Fibonacci anchors from AMRP boundaries (Compare 3 mode)
                        if not na(sess.amrp_up_outer) and not na(sess.amrp_dn_outer)
                            sess.fib_high_anchor := sess.amrp_up_outer
                            sess.fib_low_anchor := sess.amrp_dn_outer
                            sess.fib_drawn := false

                            // Draw Fibonacci levels if enabled and session is within last N sessions
                            total_sessions = array.size(session_instances)
                            sessions_from_end = total_sessions - i  // How many sessions from the end (1 = most recent)
                            show_fib_for_this_session = show_fib and sessions_from_end <= fib_last_n_sessions

                            if show_fib_for_this_session
                                fib_range = sess.fib_high_anchor - sess.fib_low_anchor
                                fib_line_style = fib_style_converted

                                // Calculate Fibonacci price levels
                                fib_0 = sess.fib_low_anchor
                                fib_295 = sess.fib_low_anchor + fib_range * 0.295
                                fib_382 = sess.fib_low_anchor + fib_range * 0.382
                                fib_50 = sess.fib_low_anchor + fib_range * 0.50
                                fib_618 = sess.fib_low_anchor + fib_range * 0.618
                                fib_705 = sess.fib_low_anchor + fib_range * 0.705
                                fib_100 = sess.fib_high_anchor

                                // Draw horizontal Fibonacci lines spanning session duration (only if checkbox enabled)
                                if show_fib_0
                                    sess.fib_line_0 := line.new(start_ts, fib_0, end_ts, fib_0, xloc=xloc.bar_time, color=fib_color_0, width=fib_width, style=fib_line_style)
                                if show_fib_295
                                    sess.fib_line_295 := line.new(start_ts, fib_295, end_ts, fib_295, xloc=xloc.bar_time, color=fib_color_295, width=fib_width, style=fib_line_style)
                                if show_fib_382
                                    sess.fib_line_382 := line.new(start_ts, fib_382, end_ts, fib_382, xloc=xloc.bar_time, color=fib_color_382, width=fib_width, style=fib_line_style)
                                if show_fib_50
                                    sess.fib_line_50 := line.new(start_ts, fib_50, end_ts, fib_50, xloc=xloc.bar_time, color=fib_color_50, width=fib_width, style=fib_line_style)
                                if show_fib_618
                                    sess.fib_line_618 := line.new(start_ts, fib_618, end_ts, fib_618, xloc=xloc.bar_time, color=fib_color_618, width=fib_width, style=fib_line_style)
                                if show_fib_705
                                    sess.fib_line_705 := line.new(start_ts, fib_705, end_ts, fib_705, xloc=xloc.bar_time, color=fib_color_705, width=fib_width, style=fib_line_style)
                                if show_fib_100
                                    sess.fib_line_100 := line.new(start_ts, fib_100, end_ts, fib_100, xloc=xloc.bar_time, color=fib_color_100, width=fib_width, style=fib_line_style)

                                // Draw decimal labels at end of session if enabled
                                if show_fib_labels
                                    if show_fib_0
                                        sess.fib_label_0 := label.new(end_ts, fib_0, text="0", xloc=xloc.bar_time, style=label.style_none, color=color.new(color.white, 100), textcolor=fib_color_0, size=size.tiny)
                                    if show_fib_295
                                        sess.fib_label_295 := label.new(end_ts, fib_295, text="0.295", xloc=xloc.bar_time, style=label.style_none, color=color.new(color.white, 100), textcolor=fib_color_295, size=size.tiny)
                                    if show_fib_382
                                        sess.fib_label_382 := label.new(end_ts, fib_382, text="0.382", xloc=xloc.bar_time, style=label.style_none, color=color.new(color.white, 100), textcolor=fib_color_382, size=size.tiny)
                                    if show_fib_50
                                        sess.fib_label_50 := label.new(end_ts, fib_50, text="0.5", xloc=xloc.bar_time, style=label.style_none, color=color.new(color.white, 100), textcolor=fib_color_50, size=size.tiny)
                                    if show_fib_618
                                        sess.fib_label_618 := label.new(end_ts, fib_618, text="0.618", xloc=xloc.bar_time, style=label.style_none, color=color.new(color.white, 100), textcolor=fib_color_618, size=size.tiny)
                                    if show_fib_705
                                        sess.fib_label_705 := label.new(end_ts, fib_705, text="0.705", xloc=xloc.bar_time, style=label.style_none, color=color.new(color.white, 100), textcolor=fib_color_705, size=size.tiny)
                                    if show_fib_100
                                        sess.fib_label_100 := label.new(end_ts, fib_100, text="1", xloc=xloc.bar_time, style=label.style_none, color=color.new(color.white, 100), textcolor=fib_color_100, size=size.tiny)

                                sess.fib_drawn := true

                    else
                        // Manual mode - single lookback
                        effective_lookback = amrp_lookback

                        [has_data, up_inner, up_outer, dn_inner, dn_outer] = get_amrp_percentiles(sess.name, 0, 0, effective_lookback)

                        if has_data
                            // Calculate zone price levels from session opening price
                            amrp_up_inner_price = sess.session_open_high + up_inner
                            amrp_up_outer_price = sess.session_open_high + up_outer
                            amrp_dn_inner_price = sess.session_open_low - dn_inner
                            amrp_dn_outer_price = sess.session_open_low - dn_outer

                            // Store boundary values for accuracy tracking
                            sess.amrp_up_inner := amrp_up_inner_price
                            sess.amrp_up_outer := amrp_up_outer_price
                            sess.amrp_dn_inner := amrp_dn_inner_price
                            sess.amrp_dn_outer := amrp_dn_outer_price
                            sess.amrp_bars_total := 0
                            sess.amrp_bars_within_inner := 0
                            sess.amrp_bars_within_outer := 0
                            sess.amrp_bars_broke_outer := 0

                            // Draw AMRP+ zone (above root)
                            sess.amrp_up_box := box.new(start_ts, amrp_up_outer_price,
                                                         end_ts, amrp_up_inner_price,
                                                         xloc=xloc.bar_time, border_color=color.new(amrp_zone_color, 100),
                                                         bgcolor=amrp_zone_color, border_width=0)

                            // Draw AMRP- zone (below root)
                            sess.amrp_dn_box := box.new(start_ts, amrp_dn_inner_price,
                                                         end_ts, amrp_dn_outer_price,
                                                         xloc=xloc.bar_time, border_color=color.new(amrp_zone_color, 100),
                                                         bgcolor=amrp_zone_color, border_width=0)

                            // Draw EQ lines at zone midpoints
                            if show_amrp_eq
                                amrp_up_eq_price = (amrp_up_inner_price + amrp_up_outer_price) / 2
                                amrp_dn_eq_price = (amrp_dn_inner_price + amrp_dn_outer_price) / 2
                                eq_line_style = amrp_eq_style_converted

                                sess.amrp_up_eq_line := line.new(start_ts, amrp_up_eq_price, end_ts, amrp_up_eq_price, xloc=xloc.bar_time, color=amrp_eq_color, width=1, style=eq_line_style)
                                sess.amrp_dn_eq_line := line.new(start_ts, amrp_dn_eq_price, end_ts, amrp_dn_eq_price, xloc=xloc.bar_time, color=amrp_eq_color, width=1, style=eq_line_style)

                            sess.amrp_drawn := true

                            // Initialize Fibonacci anchors from AMRP boundaries
                            sess.fib_high_anchor := amrp_up_outer_price
                            sess.fib_low_anchor := amrp_dn_outer_price
                            sess.fib_drawn := false

                            // Draw Fibonacci levels if enabled and session is within last N sessions
                            if show_fib and not na(sess.fib_high_anchor) and not na(sess.fib_low_anchor)
                                total_sessions = array.size(session_instances)
                                sessions_from_end = total_sessions - i  // How many sessions from the end (1 = most recent)
                                show_fib_for_this_session = sessions_from_end <= fib_last_n_sessions

                                if show_fib_for_this_session
                                    fib_range = sess.fib_high_anchor - sess.fib_low_anchor
                                    fib_line_style = fib_style_converted

                                    // Calculate Fibonacci price levels
                                    fib_0 = sess.fib_low_anchor
                                    fib_295 = sess.fib_low_anchor + fib_range * 0.295
                                    fib_382 = sess.fib_low_anchor + fib_range * 0.382
                                    fib_50 = sess.fib_low_anchor + fib_range * 0.50
                                    fib_618 = sess.fib_low_anchor + fib_range * 0.618
                                    fib_705 = sess.fib_low_anchor + fib_range * 0.705
                                    fib_100 = sess.fib_high_anchor

                                    // Draw horizontal Fibonacci lines spanning session duration (only if checkbox enabled)
                                    if show_fib_0
                                        sess.fib_line_0 := line.new(start_ts, fib_0, end_ts, fib_0, xloc=xloc.bar_time, color=fib_color_0, width=fib_width, style=fib_line_style)
                                    if show_fib_295
                                        sess.fib_line_295 := line.new(start_ts, fib_295, end_ts, fib_295, xloc=xloc.bar_time, color=fib_color_295, width=fib_width, style=fib_line_style)
                                    if show_fib_382
                                        sess.fib_line_382 := line.new(start_ts, fib_382, end_ts, fib_382, xloc=xloc.bar_time, color=fib_color_382, width=fib_width, style=fib_line_style)
                                    if show_fib_50
                                        sess.fib_line_50 := line.new(start_ts, fib_50, end_ts, fib_50, xloc=xloc.bar_time, color=fib_color_50, width=fib_width, style=fib_line_style)
                                    if show_fib_618
                                        sess.fib_line_618 := line.new(start_ts, fib_618, end_ts, fib_618, xloc=xloc.bar_time, color=fib_color_618, width=fib_width, style=fib_line_style)
                                    if show_fib_705
                                        sess.fib_line_705 := line.new(start_ts, fib_705, end_ts, fib_705, xloc=xloc.bar_time, color=fib_color_705, width=fib_width, style=fib_line_style)
                                    if show_fib_100
                                        sess.fib_line_100 := line.new(start_ts, fib_100, end_ts, fib_100, xloc=xloc.bar_time, color=fib_color_100, width=fib_width, style=fib_line_style)

                                    // Draw decimal labels at end of session if enabled
                                    if show_fib_labels
                                        if show_fib_0
                                            sess.fib_label_0 := label.new(end_ts, fib_0, text="0", xloc=xloc.bar_time, style=label.style_none, color=color.new(color.white, 100), textcolor=fib_color_0, size=size.tiny)
                                        if show_fib_295
                                            sess.fib_label_295 := label.new(end_ts, fib_295, text="0.295", xloc=xloc.bar_time, style=label.style_none, color=color.new(color.white, 100), textcolor=fib_color_295, size=size.tiny)
                                        if show_fib_382
                                            sess.fib_label_382 := label.new(end_ts, fib_382, text="0.382", xloc=xloc.bar_time, style=label.style_none, color=color.new(color.white, 100), textcolor=fib_color_382, size=size.tiny)
                                        if show_fib_50
                                            sess.fib_label_50 := label.new(end_ts, fib_50, text="0.5", xloc=xloc.bar_time, style=label.style_none, color=color.new(color.white, 100), textcolor=fib_color_50, size=size.tiny)
                                        if show_fib_618
                                            sess.fib_label_618 := label.new(end_ts, fib_618, text="0.618", xloc=xloc.bar_time, style=label.style_none, color=color.new(color.white, 100), textcolor=fib_color_618, size=size.tiny)
                                        if show_fib_705
                                            sess.fib_label_705 := label.new(end_ts, fib_705, text="0.705", xloc=xloc.bar_time, style=label.style_none, color=color.new(color.white, 100), textcolor=fib_color_705, size=size.tiny)
                                        if show_fib_100
                                            sess.fib_label_100 := label.new(end_ts, fib_100, text="1", xloc=xloc.bar_time, style=label.style_none, color=color.new(color.white, 100), textcolor=fib_color_100, size=size.tiny)

                                    sess.fib_drawn := true

                    array.set(session_instances, i, sess)

// Manage Fibonacci visibility: Delete Fib lines for sessions outside "last N sessions" window
// PERFORMANCE: Only check sessions that might be outside the window (skip recent sessions)
if show_fib and array.size(session_instances) > 0
    total_sessions = array.size(session_instances)
    cutoff_index = math.max(0, total_sessions - fib_last_n_sessions)

    // Only iterate through older sessions that might need cleanup
    if cutoff_index > 0
        for i = 0 to cutoff_index - 1
            sess = array.get(session_instances, i)

            // If session has Fib lines drawn, delete them (outside visibility window)
            if sess.fib_drawn
                // Delete all Fibonacci lines
                if not na(sess.fib_line_0)
                    line.delete(sess.fib_line_0)
                    sess.fib_line_0 := na
                if not na(sess.fib_line_295)
                    line.delete(sess.fib_line_295)
                    sess.fib_line_295 := na
                if not na(sess.fib_line_382)
                    line.delete(sess.fib_line_382)
                    sess.fib_line_382 := na
                if not na(sess.fib_line_50)
                    line.delete(sess.fib_line_50)
                    sess.fib_line_50 := na
                if not na(sess.fib_line_618)
                    line.delete(sess.fib_line_618)
                    sess.fib_line_618 := na
                if not na(sess.fib_line_705)
                    line.delete(sess.fib_line_705)
                    sess.fib_line_705 := na
                if not na(sess.fib_line_100)
                    line.delete(sess.fib_line_100)
                    sess.fib_line_100 := na

                // Delete all Fibonacci labels
                if not na(sess.fib_label_0)
                    label.delete(sess.fib_label_0)
                    sess.fib_label_0 := na
                if not na(sess.fib_label_295)
                    label.delete(sess.fib_label_295)
                    sess.fib_label_295 := na
                if not na(sess.fib_label_382)
                    label.delete(sess.fib_label_382)
                    sess.fib_label_382 := na
                if not na(sess.fib_label_50)
                    label.delete(sess.fib_label_50)
                    sess.fib_label_50 := na
                if not na(sess.fib_label_618)
                    label.delete(sess.fib_label_618)
                    sess.fib_label_618 := na
                if not na(sess.fib_label_705)
                    label.delete(sess.fib_label_705)
                    sess.fib_label_705 := na
                if not na(sess.fib_label_100)
                    label.delete(sess.fib_label_100)
                    sess.fib_label_100 := na

                // Reset flag
                sess.fib_drawn := false

                array.set(session_instances, i, sess)

// Track AMRP accuracy (how often price stays within zones)
if show_amrp and array.size(session_instances) > 0
    for i = 0 to array.size(session_instances) - 1
        sess = array.get(session_instances, i)

        // Only track if session is active and AMRP is drawn
        if sess.amrp_drawn and not na(sess.amrp_up_inner)
            // Check if current bar is within this session's time range
            if time >= sess.start_timestamp and time <= sess.end_timestamp
                // Check if bar index is after root (we only care about post-root accuracy)
                if not na(sess.root_timestamp) and time >= sess.root_timestamp
                    sess.amrp_bars_total := sess.amrp_bars_total + 1

                    // Check price position relative to zones
                    in_inner_zone = false
                    in_outer_zone = false
                    broke_outer = false
                    broke_up = false
                    broke_dn = false

                    // Price within inner zones (between inner bounds)
                    if high <= sess.amrp_up_inner and low >= sess.amrp_dn_inner
                        in_inner_zone := true
                        in_outer_zone := true
                    // Price within outer zones but outside inner
                    else if high <= sess.amrp_up_outer and low >= sess.amrp_dn_outer
                        in_outer_zone := true
                    // Price broke outer zones
                    else
                        broke_outer := true
                        // Detect which direction
                        if high > sess.amrp_up_outer
                            broke_up := true
                        if low < sess.amrp_dn_outer
                            broke_dn := true

                    if in_inner_zone
                        sess.amrp_bars_within_inner := sess.amrp_bars_within_inner + 1
                    if in_outer_zone
                        sess.amrp_bars_within_outer := sess.amrp_bars_within_outer + 1
                    if broke_outer
                        sess.amrp_bars_broke_outer := sess.amrp_bars_broke_outer + 1

                    // Draw projections independently for each direction
                    if show_deviation_projections and array.size(parsed_multipliers) > 0
                        // Prepare shared calculation variables
                        proj_line_style = projection_style_converted
                        num_projections = math.min(array.size(parsed_multipliers), MAX_PROJECTION_MULTIPLIERS)
                        margin_str = get_projection_margin()

                        // Find max label width for alignment
                        max_label_width = 0
                        for proj_idx = 0 to num_projections - 1
                            multiplier = array.get(parsed_multipliers, proj_idx)
                            label_str = "-" + format_projection_label(multiplier)
                            max_label_width := math.max(max_label_width, str.length(label_str))

                        // Draw UPPER projections if broke up and not yet drawn
                        if broke_up and not sess.amrp_up_projections_drawn
                            sess.amrp_broke_up := true
                            up_zone_size = sess.amrp_up_outer - sess.amrp_up_inner

                            for proj_idx = 0 to num_projections - 1
                                multiplier = array.get(parsed_multipliers, proj_idx)
                                up_price = sess.amrp_up_outer + (up_zone_size * multiplier)
                                up_line = line.new(sess.start_timestamp, up_price, sess.end_timestamp, up_price, xloc=xloc.bar_time, color=projection_color, width=1, style=proj_line_style)

                                label up_label = na
                                if show_projection_labels
                                    label_str = "-" + format_projection_label(multiplier)
                                    padding_spaces = ""
                                    for p = 0 to (max_label_width - str.length(label_str)) - 1
                                        padding_spaces := padding_spaces + " "
                                    label_text = margin_str + label_str + padding_spaces
                                    up_label := label.new(sess.end_timestamp, up_price, label_text, xloc=xloc.bar_time, style=label.style_none, textcolor=projection_color, size=size.tiny, textalign=text.align_left)

                                // Assign to struct
                                if proj_idx == 0
                                    sess.amrp_up_proj1 := up_line
                                    sess.amrp_up_proj1_label := up_label
                                else if proj_idx == 1
                                    sess.amrp_up_proj2 := up_line
                                    sess.amrp_up_proj2_label := up_label
                                else if proj_idx == 2
                                    sess.amrp_up_proj3 := up_line
                                    sess.amrp_up_proj3_label := up_label
                                else if proj_idx == 3
                                    sess.amrp_up_proj4 := up_line
                                    sess.amrp_up_proj4_label := up_label

                            sess.amrp_up_projections_drawn := true

                        // Draw LOWER projections if broke down and not yet drawn
                        if broke_dn and not sess.amrp_dn_projections_drawn
                            sess.amrp_broke_dn := true
                            dn_zone_size = sess.amrp_dn_inner - sess.amrp_dn_outer

                            for proj_idx = 0 to num_projections - 1
                                multiplier = array.get(parsed_multipliers, proj_idx)
                                dn_price = sess.amrp_dn_outer - (dn_zone_size * multiplier)
                                dn_line = line.new(sess.start_timestamp, dn_price, sess.end_timestamp, dn_price, xloc=xloc.bar_time, color=projection_color, width=1, style=proj_line_style)

                                label dn_label = na
                                if show_projection_labels
                                    label_str = "-" + format_projection_label(multiplier)
                                    padding_spaces = ""
                                    for p = 0 to (max_label_width - str.length(label_str)) - 1
                                        padding_spaces := padding_spaces + " "
                                    label_text = margin_str + label_str + padding_spaces
                                    dn_label := label.new(sess.end_timestamp, dn_price, label_text, xloc=xloc.bar_time, style=label.style_none, textcolor=projection_color, size=size.tiny, textalign=text.align_left)

                                // Assign to struct
                                if proj_idx == 0
                                    sess.amrp_dn_proj1 := dn_line
                                    sess.amrp_dn_proj1_label := dn_label
                                else if proj_idx == 1
                                    sess.amrp_dn_proj2 := dn_line
                                    sess.amrp_dn_proj2_label := dn_label
                                else if proj_idx == 2
                                    sess.amrp_dn_proj3 := dn_line
                                    sess.amrp_dn_proj3_label := dn_label
                                else if proj_idx == 3
                                    sess.amrp_dn_proj4 := dn_line
                                    sess.amrp_dn_proj4_label := dn_label

                            sess.amrp_dn_projections_drawn := true

                    array.set(session_instances, i, sess)

// ══════════════════════════════════════════════════════════════════════════════
// ⚠️ DEVELOPER DOCUMENTATION - MUST READ BEFORE MODIFYING ⚠️
// ══════════════════════════════════════════════════════════════════════════════
// AMRP ACCURACY TRACKER (Advanced/Detailed)
// ══════════════════════════════════════════════════════════════════════════════

if show_amrp_accuracy and barstate.islast
    string acc_table_position = amrp_accuracy_horizontal == POSITION_LEFT ? (amrp_accuracy_vertical == POSITION_TOP ? position.top_left : amrp_accuracy_vertical == POSITION_MIDDLE ? position.middle_left : position.bottom_left) : amrp_accuracy_horizontal == POSITION_MIDDLE ? (amrp_accuracy_vertical == POSITION_TOP ? position.top_center : amrp_accuracy_vertical == POSITION_MIDDLE ? position.middle_center : position.bottom_center) : (amrp_accuracy_vertical == POSITION_TOP ? position.top_right : amrp_accuracy_vertical == POSITION_MIDDLE ? position.middle_right : position.bottom_right)

    string acc_text_size_value = amrp_accuracy_text_size == SIZE_TINY ? size.tiny : amrp_accuracy_text_size == SIZE_SMALL ? size.small : size.normal

    if amrp_accuracy_mode == "Single Session"
        var table acc_table = na
        var string acc_prev_position_h = ""
        var string acc_prev_position_v = ""
        var string acc_prev_text_size = ""

        bool acc_settings_changed = acc_prev_position_h != amrp_accuracy_horizontal or acc_prev_position_v != amrp_accuracy_vertical or acc_prev_text_size != amrp_accuracy_text_size

        if na(acc_table) or acc_settings_changed
            if not na(acc_table)
                table.delete(acc_table)
            acc_table := table.new(acc_table_position, 3, 10, bgcolor=color.new(color.black, 10), border_width=1)
            acc_prev_position_h := amrp_accuracy_horizontal
            acc_prev_position_v := amrp_accuracy_vertical
            acc_prev_text_size := amrp_accuracy_text_size

        table.cell(acc_table, 0, 0, "AMRP ACCURACY", text_color=color.white, text_size=acc_text_size_value, bgcolor=color.new(color.blue, 50))
        table.merge_cells(acc_table, 0, 0, 2, 0)

        table.cell(acc_table, 0, 1, "Session", text_color=color.gray, text_size=acc_text_size_value, bgcolor=color.new(color.gray, 80))
        table.cell(acc_table, 1, 1, amrp_accuracy_session, text_color=color.white, text_size=acc_text_size_value, bgcolor=color.new(color.gray, 80))
        table.merge_cells(acc_table, 1, 1, 2, 1)

        table.cell(acc_table, 0, 2, "Method", text_color=color.gray, text_size=acc_text_size_value, bgcolor=color.new(color.gray, 80))
        table.cell(acc_table, 1, 2, "IQR", text_color=color.white, text_size=acc_text_size_value, bgcolor=color.new(color.gray, 80))
        table.merge_cells(acc_table, 1, 2, 2, 2)

        effective_lookback_display = amrp_lookback_mode == "Compare 3" ? "4,6,9" : str.tostring(amrp_lookback)
        table.cell(acc_table, 0, 3, "Lookback", text_color=color.gray, text_size=acc_text_size_value, bgcolor=color.new(color.gray, 80))
        table.cell(acc_table, 1, 3, effective_lookback_display, text_color=color.white, text_size=acc_text_size_value, bgcolor=color.new(color.gray, 80))
        table.merge_cells(acc_table, 1, 3, 2, 3)

        table.cell(acc_table, 0, 4, "Metric", text_color=color.gray, text_size=acc_text_size_value, bgcolor=color.new(color.gray, 90))
        table.cell(acc_table, 1, 4, "Bars", text_color=color.gray, text_size=acc_text_size_value, bgcolor=color.new(color.gray, 90))
        table.cell(acc_table, 2, 4, "%", text_color=color.gray, text_size=acc_text_size_value, bgcolor=color.new(color.gray, 90))

        // Find the most recent completed session matching the selected name
        var int total_bars = na
        var int inner_bars = na
        var int outer_bars = na
        var int broke_bars = na

        if array.size(session_instances) > 0
            for i = array.size(session_instances) - 1 to 0
                sess = array.get(session_instances, i)
                if sess.name == amrp_accuracy_session and sess.amrp_drawn and sess.amrp_bars_total > 0
                    total_bars := sess.amrp_bars_total
                    inner_bars := sess.amrp_bars_within_inner
                    outer_bars := sess.amrp_bars_within_outer
                    broke_bars := sess.amrp_bars_broke_outer
                    break

        // Calculate percentages
        inner_pct_val = not na(total_bars) and total_bars > 0 ? (inner_bars / total_bars) * 100 : 0.0
        outer_pct_val = not na(total_bars) and total_bars > 0 ? (outer_bars / total_bars) * 100 : 0.0
        broke_pct_val = not na(total_bars) and total_bars > 0 ? (broke_bars / total_bars) * 100 : 0.0

        table.cell(acc_table, 0, 5, "Total Bars", text_color=color.white, text_size=acc_text_size_value)
        table.cell(acc_table, 1, 5, str.tostring(na(total_bars) ? 0 : total_bars), text_color=color.white, text_size=acc_text_size_value)
        table.cell(acc_table, 2, 5, "100%", text_color=color.white, text_size=acc_text_size_value)

        table.cell(acc_table, 0, 6, "", text_color=color.gray, text_size=acc_text_size_value)
        table.cell(acc_table, 1, 6, "", text_color=color.gray, text_size=acc_text_size_value)
        table.cell(acc_table, 2, 6, "", text_color=color.gray, text_size=acc_text_size_value)

        inner_color = inner_pct_val >= 40 ? color.green : inner_pct_val >= 25 ? color.orange : color.red
        table.cell(acc_table, 0, 7, "Within Inner", text_color=color.white, text_size=acc_text_size_value)
        table.cell(acc_table, 1, 7, str.tostring(na(inner_bars) ? 0 : inner_bars), text_color=color.white, text_size=acc_text_size_value)
        table.cell(acc_table, 2, 7, str.format("{0,number,#.#}%", inner_pct_val), text_color=inner_color, text_size=acc_text_size_value, bgcolor=color.new(inner_color, 85))

        outer_color = outer_pct_val >= 60 ? color.green : outer_pct_val >= 40 ? color.orange : color.red
        table.cell(acc_table, 0, 8, "Within Outer", text_color=color.white, text_size=acc_text_size_value)
        table.cell(acc_table, 1, 8, str.tostring(na(outer_bars) ? 0 : outer_bars), text_color=color.white, text_size=acc_text_size_value)
        table.cell(acc_table, 2, 8, str.format("{0,number,#.#}%", outer_pct_val), text_color=outer_color, text_size=acc_text_size_value, bgcolor=color.new(outer_color, 85))

        broke_color = broke_pct_val <= 20 ? color.green : broke_pct_val <= 40 ? color.orange : color.red
        table.cell(acc_table, 0, 9, "Broke Outer", text_color=color.white, text_size=acc_text_size_value)
        table.cell(acc_table, 1, 9, str.tostring(na(broke_bars) ? 0 : broke_bars), text_color=color.white, text_size=acc_text_size_value)
        table.cell(acc_table, 2, 9, str.format("{0,number,#.#}%", broke_pct_val), text_color=broke_color, text_size=acc_text_size_value, bgcolor=color.new(broke_color, 85))

    else if amrp_accuracy_mode == "Auto-Score"
        var table score_table = na
        var string score_prev_position_h = ""
        var string score_prev_position_v = ""
        var string score_prev_text_size = ""

        bool score_settings_changed = score_prev_position_h != amrp_accuracy_horizontal or score_prev_position_v != amrp_accuracy_vertical or score_prev_text_size != amrp_accuracy_text_size

        if na(score_table) or score_settings_changed
            if not na(score_table)
                table.delete(score_table)
            score_table := table.new(acc_table_position, 3, 12, bgcolor=color.new(color.black, 10), border_width=1)
            score_prev_position_h := amrp_accuracy_horizontal
            score_prev_position_v := amrp_accuracy_vertical
            score_prev_text_size := amrp_accuracy_text_size

        table.cell(score_table, 0, 0, "AMRP AUTO-SCORE", text_color=color.white, text_size=acc_text_size_value, bgcolor=color.new(color.purple, 50))
        table.merge_cells(score_table, 0, 0, 2, 0)

        table.cell(score_table, 0, 1, "Method: IQR", text_color=color.gray, text_size=acc_text_size_value, bgcolor=color.new(color.gray, 80))
        table.merge_cells(score_table, 0, 1, 2, 1)

        effective_lookback_display = amrp_lookback_mode == "Compare 3" ? "4,6,9" : str.tostring(amrp_lookback)
        table.cell(score_table, 0, 2, "Lookback: " + effective_lookback_display, text_color=color.gray, text_size=acc_text_size_value, bgcolor=color.new(color.gray, 80))
        table.merge_cells(score_table, 0, 2, 2, 2)

        // Aggregate all session data
        total_bars_all = 0
        inner_bars_all = 0
        outer_bars_all = 0
        broke_bars_all = 0

        if array.size(session_instances) > 0
            for i = 0 to array.size(session_instances) - 1
                sess = array.get(session_instances, i)
                if sess.amrp_drawn and sess.amrp_bars_total > 0
                    total_bars_all := total_bars_all + sess.amrp_bars_total
                    inner_bars_all := inner_bars_all + sess.amrp_bars_within_inner
                    outer_bars_all := outer_bars_all + sess.amrp_bars_within_outer
                    broke_bars_all := broke_bars_all + sess.amrp_bars_broke_outer

        // Calculate aggregate percentages
        inner_pct_agg = total_bars_all > 0 ? (inner_bars_all / total_bars_all) * 100 : 0.0
        outer_pct_agg = total_bars_all > 0 ? (outer_bars_all / total_bars_all) * 100 : 0.0
        broke_pct_agg = total_bars_all > 0 ? (broke_bars_all / total_bars_all) * 100 : 0.0

        // Calculate score (0-100, higher is better)
        // Target: Inner ~40-50%, Outer ~65-75%, Broke ~15-25%
        inner_score = math.max(0, 100 - math.abs(inner_pct_agg - 45) * 2)
        outer_score = math.max(0, 100 - math.abs(outer_pct_agg - 70) * 1.5)
        broke_score = math.max(0, 100 - math.abs(broke_pct_agg - 20) * 2)
        overall_score = (inner_score + outer_score + broke_score) / 3

        // Determine rating
        rating = overall_score >= 80 ? "EXCELLENT ★★★" : overall_score >= 60 ? "GOOD ★★" : overall_score >= 40 ? "FAIR ★" : "POOR"
        rating_color = overall_score >= 80 ? color.green : overall_score >= 60 ? color.lime : overall_score >= 40 ? color.orange : color.red

        table.cell(score_table, 0, 3, "", text_color=color.gray, text_size=acc_text_size_value)
        table.cell(score_table, 1, 3, "", text_color=color.gray, text_size=acc_text_size_value)
        table.cell(score_table, 2, 3, "", text_color=color.gray, text_size=acc_text_size_value)

        table.cell(score_table, 0, 4, "Metric", text_color=color.gray, text_size=acc_text_size_value, bgcolor=color.new(color.gray, 90))
        table.cell(score_table, 1, 4, "Value", text_color=color.gray, text_size=acc_text_size_value, bgcolor=color.new(color.gray, 90))
        table.cell(score_table, 2, 4, "Score", text_color=color.gray, text_size=acc_text_size_value, bgcolor=color.new(color.gray, 90))

        table.cell(score_table, 0, 5, "Total Bars", text_color=color.white, text_size=acc_text_size_value)
        table.cell(score_table, 1, 5, str.tostring(total_bars_all), text_color=color.white, text_size=acc_text_size_value)
        table.cell(score_table, 2, 5, "-", text_color=color.gray, text_size=acc_text_size_value)

        table.cell(score_table, 0, 6, "", text_color=color.gray, text_size=acc_text_size_value)
        table.cell(score_table, 1, 6, "", text_color=color.gray, text_size=acc_text_size_value)
        table.cell(score_table, 2, 6, "", text_color=color.gray, text_size=acc_text_size_value)

        inner_col = inner_score >= 80 ? color.green : inner_score >= 60 ? color.orange : color.red
        table.cell(score_table, 0, 7, "Within Inner", text_color=color.white, text_size=acc_text_size_value)
        table.cell(score_table, 1, 7, str.format("{0,number,#.#}%", inner_pct_agg), text_color=color.white, text_size=acc_text_size_value)
        table.cell(score_table, 2, 7, str.format("{0,number,#.#}", inner_score), text_color=inner_col, text_size=acc_text_size_value, bgcolor=color.new(inner_col, 85))

        outer_col = outer_score >= 80 ? color.green : outer_score >= 60 ? color.orange : color.red
        table.cell(score_table, 0, 8, "Within Outer", text_color=color.white, text_size=acc_text_size_value)
        table.cell(score_table, 1, 8, str.format("{0,number,#.#}%", outer_pct_agg), text_color=color.white, text_size=acc_text_size_value)
        table.cell(score_table, 2, 8, str.format("{0,number,#.#}", outer_score), text_color=outer_col, text_size=acc_text_size_value, bgcolor=color.new(outer_col, 85))

        broke_col = broke_score >= 80 ? color.green : broke_score >= 60 ? color.orange : color.red
        table.cell(score_table, 0, 9, "Broke Outer", text_color=color.white, text_size=acc_text_size_value)
        table.cell(score_table, 1, 9, str.format("{0,number,#.#}%", broke_pct_agg), text_color=color.white, text_size=acc_text_size_value)
        table.cell(score_table, 2, 9, str.format("{0,number,#.#}", broke_score), text_color=broke_col, text_size=acc_text_size_value, bgcolor=color.new(broke_col, 85))

        table.cell(score_table, 0, 10, "", text_color=color.gray, text_size=acc_text_size_value)
        table.cell(score_table, 1, 10, "", text_color=color.gray, text_size=acc_text_size_value)
        table.cell(score_table, 2, 10, "", text_color=color.gray, text_size=acc_text_size_value)

        table.cell(score_table, 0, 11, "OVERALL", text_color=color.white, text_size=acc_text_size_value, bgcolor=color.new(color.gray, 80))
        table.cell(score_table, 1, 11, rating, text_color=rating_color, text_size=acc_text_size_value, bgcolor=color.new(rating_color, 90))
        table.cell(score_table, 2, 11, str.format("{0,number,#.#}", overall_score), text_color=rating_color, text_size=acc_text_size_value, bgcolor=color.new(rating_color, 85))

// ══════════════════════════════════════════════════════════════════════════════
// AMRP RANGE ANALYSIS TABLE
// ══════════════════════════════════════════════════════════════════════════════

if show_range_analysis and array.size(session_instances) > 0 and barstate.islast
    string table_position = range_analysis_horizontal == POSITION_LEFT ? (range_analysis_vertical == POSITION_TOP ? position.top_left : range_analysis_vertical == POSITION_MIDDLE ? position.middle_left : position.bottom_left) : range_analysis_horizontal == POSITION_MIDDLE ? (range_analysis_vertical == POSITION_TOP ? position.top_center : range_analysis_vertical == POSITION_MIDDLE ? position.middle_center : position.bottom_center) : (range_analysis_vertical == POSITION_TOP ? position.top_right : range_analysis_vertical == POSITION_MIDDLE ? position.middle_right : position.bottom_right)

    string text_size_value = range_analysis_text_size == SIZE_TINY ? size.tiny : range_analysis_text_size == SIZE_SMALL ? size.small : size.normal

    int total_sessions = array.size(session_instances)
    bool display_active_only = range_analysis_display == DISPLAY_ACTIVE_ONLY
    int target_session_count = display_active_only ? 99 : SESSIONS_PER_CYCLE
    int max_table_rows = SESSIONS_PER_CYCLE + 1

    // Recreate table when user changes settings
    var table range_table = na
    var string prev_position_h = ""
    var string prev_position_v = ""
    var string prev_text_size = ""

    bool settings_changed = prev_position_h != range_analysis_horizontal or prev_position_v != range_analysis_vertical or prev_text_size != range_analysis_text_size

    if na(range_table) or settings_changed
        if not na(range_table)
            table.delete(range_table)
        range_table := table.new(table_position, 5, max_table_rows, bgcolor=color.new(color.black, 10), border_width=1)
        prev_position_h := range_analysis_horizontal
        prev_position_v := range_analysis_vertical
        prev_text_size := range_analysis_text_size

    table.cell(range_table, 0, 0, "Model", text_color=color.white, text_size=text_size_value, bgcolor=color.new(color.gray, 60))
    table.cell(range_table, 1, 0, "Expected", text_color=color.white, text_size=text_size_value, bgcolor=color.new(color.blue, 60))
    table.cell(range_table, 2, 0, "Actual", text_color=color.white, text_size=text_size_value, bgcolor=color.new(color.purple, 60))
    table.cell(range_table, 3, 0, "% Filled", text_color=color.white, text_size=text_size_value, bgcolor=color.new(color.orange, 60))
    table.cell(range_table, 4, 0, "Remaining %", text_color=color.white, text_size=text_size_value, bgcolor=color.new(color.teal, 60))

    array<string> displayed_names = array.new<string>()
    int row_index = 1

    for i = total_sessions - 1 to 0
        if row_index > target_session_count
            break

        DttIntradaySession sess = array.get(session_instances, i)

        // Skip sessions without valid AMRP data
        if na(sess.amrp_up_outer) or na(sess.amrp_dn_outer)
            continue

        if array.includes(displayed_names, sess.name)
            continue

        if display_active_only and not na(sess.end_bar)
            continue

        array.push(displayed_names, sess.name)

        bool is_active = na(sess.end_bar)
        color row_bg = is_active ? color.new(color.blue, 85) : color.new(color.black, 100)

        float expected_range = sess.amrp_up_outer - sess.amrp_dn_outer
        float actual_range = sess.session_high > sess.session_low ? sess.session_high - sess.session_low : na
        float pct_filled = expected_range > 0 and not na(actual_range) ? (actual_range / expected_range) * 100 : na
        float remaining_pct = not na(pct_filled) ? 100 - pct_filled : na

        table.cell(range_table, 0, row_index, sess.name, text_color=color.white, text_size=text_size_value, bgcolor=row_bg)

        string expected_str = str.tostring(expected_range, "#.##")
        table.cell(range_table, 1, row_index, expected_str, text_color=color.white, text_size=text_size_value, bgcolor=row_bg)

        if not na(actual_range)
            string actual_str = str.tostring(actual_range, "#.##")
            table.cell(range_table, 2, row_index, actual_str, text_color=color.white, text_size=text_size_value, bgcolor=row_bg)
        else
            table.cell(range_table, 2, row_index, "—", text_color=color.white, text_size=text_size_value, bgcolor=row_bg)

        if not na(pct_filled)
            string pct_str = str.tostring(pct_filled, "#.#") + "%"
            table.cell(range_table, 3, row_index, pct_str, text_color=color.white, text_size=text_size_value, bgcolor=row_bg)
        else
            table.cell(range_table, 3, row_index, "—", text_color=color.white, text_size=text_size_value, bgcolor=row_bg)

        if not na(remaining_pct)
            string remaining_str = str.tostring(remaining_pct, "#.#") + "%"
            color remaining_color = remaining_pct > 0 ? color.lime : color.red
            table.cell(range_table, 4, row_index, remaining_str, text_color=remaining_color, text_size=text_size_value, bgcolor=row_bg)
        else
            table.cell(range_table, 4, row_index, "—", text_color=color.white, text_size=text_size_value, bgcolor=row_bg)

        row_index := row_index + 1

// ══════════════════════════════════════════════════════════════════════════════
// DOCUMENTATION
// ══════════════════════════════════════════════════════════════════════════════
//
// READ THESE DOCUMENTS BEFORE MAKING ANY CHANGES TO THIS FILE!
//
// 📚 Developer Documentation: ./DTT_SESSION_DEVELOPER_DOCS.md
//    - Business requirements & expectations
//    - Critical implementation details (ROOT CAUSE fixes)
//    - Common pitfalls & how to avoid them
//    - Architecture decisions & rationale
//    - Mandatory testing requirements
//    - Modification checklist (15-point verification)
//
// 📝 Changelog: ./CHANGELOG.md
//    - Complete history of all changes and WHY they were made
//    - Problem descriptions, root causes, and solutions
//    - Test procedures for each fix
//
// ⚠️ Key Reminders:
// ✓ Session highs/lows MUST match exactly across all timeframes (1m-5m)
// ✓ Test Nagasaki & Turncoat sessions on 3-minute charts (midnight wrapping)
// ✓ Do NOT change initialization values (-1e10, 1e10)
// ✓ Visual elements must draw at SESSION START, not root time
// ✓ Always check `not na(session_start_timestamp)` before drawing visual elements
