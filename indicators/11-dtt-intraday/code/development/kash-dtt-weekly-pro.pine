// ══════════════════════════════════════════════════════════════════════════════
// TIMEFRAME GATING
// ══════════════════════════════════════════════════════════════════════════════

int tf_seconds = timeframe.in_seconds(timeframe.period)

if tf_seconds < 300  // < 5 minutes
    runtime.error("⚠️ Weekly DTT requires minimum 5-minute timeframe. Current: " + timeframe.period)

if tf_seconds > 14400  // > 4 hours
    runtime.error("⚠️ Weekly DTT requires maximum 4-hour timeframe. Current: " + timeframe.period)

