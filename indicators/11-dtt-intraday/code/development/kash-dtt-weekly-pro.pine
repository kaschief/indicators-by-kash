// ══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ══════════════════════════════════════════════════════════════════════════════

const int SESSIONS_PER_CYCLE = 4
const string TIMEZONE = "America/New_York"

// Session Name Constants
const string SESSION_ISCARIOT = "Iscariot"
const string SESSION_ARIES = "Aries"
const string SESSION_ASH = "Ash"
const string SESSION_ICARUS = "Icarus"

// Day of Week Constants (Pine Script standard: 1=Sunday, 7=Saturday)
const int DAY_SUNDAY = 1
const int DAY_MONDAY = 2
const int DAY_TUESDAY = 3
const int DAY_WEDNESDAY = 4
const int DAY_THURSDAY = 5
const int DAY_FRIDAY = 6
const int DAY_SATURDAY = 7

// Default Colors
const color DEFAULT_BOUNDARY_COLOR = color.rgb(156, 156, 156)
const color DEFAULT_INTERVAL_COLOR = color.rgb(200, 200, 200)
const color DEFAULT_HIGH_LOW_COLOR = color.rgb(250, 161, 164)
const color DEFAULT_ROOT_ZONE_COLOR = color.rgb(225, 190, 231)
