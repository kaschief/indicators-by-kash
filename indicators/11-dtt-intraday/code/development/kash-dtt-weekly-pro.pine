// ══════════════════════════════════════════════════════════════════════════════

show_last_n_weeks = input.int(1, "Show Last N Weeks", minval=1, maxval=10, group=GROUP_SESSIONS, tooltip="Number of weeks to display (4 sessions per week)")
show_boundaries = input.bool(true, "Boundaries?", group=GROUP_SESSIONS, inline="boundary")
boundary_color = input.color(DEFAULT_BOUNDARY_COLOR, "", group=GROUP_SESSIONS, inline="boundary")
boundary_style = input.string(STYLE_SOLID, "Style", options=[STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], group=GROUP_SESSIONS, inline="boundary")
