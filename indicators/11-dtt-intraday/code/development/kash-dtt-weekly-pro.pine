//@version=6
indicator('Kash DTT Weekly° [Pro+] (dev)', overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=100)

// ══════════════════════════════════════════════════════════════════════════════
// 📋 IMPLEMENTATION NOTES - READ BEFORE MODIFYING
