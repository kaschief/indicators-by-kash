//@version=6
indicator("Kash Gaps° [Pro+]", overlay=true, max_boxes_count=500, max_lines_count=500)

const int RIGHT_EDGE_CUSHION = 3
const float CE_LEVEL = 0.50
const float Q1_LEVEL = 0.25
const float Q3_LEVEL = 0.75
const int COMPACT_WIDTH = 5
const int COMPACT_OFFSET = 10

const int CLOSE_HOUR = 16
const int CLOSE_MINUTE = 59
const int SESSION_OPEN_HOUR = 18
const int ZERO_MINUTE = 0

// Performance optimization: Limit historical lookback
const int MILLISECONDS_PER_WEEK = 604800000
const int MILLISECONDS_PER_DAY = 86400000

const string GAP_TYPE_RTH = "RTH"
const string GAP_TYPE_NWOG = "NWOG"
const string GAP_TYPE_NDOG = "NDOG"
const string GAP_TYPE_BPR_BULLISH = "BPR+"
const string GAP_TYPE_BPR_BEARISH = "BPR-"

const string ENTRY_NONE = "none"
const string ENTRY_FROM_BELOW = "from_below"
const string ENTRY_FROM_ABOVE = "from_above"

// UI Labels
const string LABEL_NWOG = "NWOGs"
const string LABEL_NDOG = "NDOGs"
const string LABEL_RTH = "RTH Gaps"
const string LABEL_BPR = "BPRs"
const string LABEL_UNFILLED = "Unfilled"
const string LABEL_FILLED = "Filled"
const string LABEL_EXTEND = "Extend"
const string LABEL_HIDE_FILLED = "Hide Filled"
const string LABEL_DIVIDERS = "Dividers"
const string LABEL_PREVIEW = "Preview"
const string LABEL_MUTE_ETH = "Mute ETH"
const string LABEL_INTERNAL_LINES = "Internal Lines"
const string LABEL_BORDER_LABEL = "Border + Label"
const string LABEL_DATE_LABEL = "Date Label"
const string LABEL_LABELS = "Labels"

// Group Names
const string GROUP_NWOG = "NWOG"
const string GROUP_NDOG = "NDOG"
const string GROUP_RTH = "RTH Gaps"
const string GROUP_BPR = "BPR"
const string GROUP_APPEARANCE = "Appearance"

// Color Constants
const color DEFAULT_NWOG_UNFILLED_COLOR = color.new(color.rgb(41, 98, 255), 70)
const color DEFAULT_NWOG_FILLED_COLOR = color.new(color.rgb(99, 99, 99), 90)
const color DEFAULT_NWOG_DIVIDER_COLOR = color.new(color.rgb(41, 98, 255), 50)
const color DEFAULT_NWOG_BOUNDARY_COLOR = color.rgb(91, 156, 246)
const color DEFAULT_NDOG_UNFILLED_COLOR = color.new(color.rgb(240, 98, 146), 75)
const color DEFAULT_NDOG_FILLED_COLOR = color.new(color.rgb(99, 99, 99), 90)
const color DEFAULT_NDOG_DIVIDER_COLOR = color.new(color.rgb(233, 30, 99), 50)
const color DEFAULT_NDOG_BOUNDARY_COLOR = color.rgb(240, 98, 146, 0)
const color DEFAULT_RTH_UNFILLED_COLOR = color.new(color.rgb(138, 138, 138), 75)
const color DEFAULT_RTH_FILLED_COLOR = color.new(color.rgb(99, 99, 99), 90)
const color DEFAULT_RTH_PREVIEW_COLOR = color.new(color.rgb(255, 152, 0), 85)
const color DEFAULT_RTH_ETH_CANDLE_COLOR = color.new(color.rgb(120, 123, 134), 70)
const color DEFAULT_RTH_BOUNDARY_COLOR = color.rgb(128, 128, 128)
const color DEFAULT_BPR_BULLISH_UNFILLED_COLOR = color.new(color.rgb(76, 175, 80), 70)
const color DEFAULT_BPR_BULLISH_FILLED_COLOR = color.new(color.rgb(76, 175, 80), 90)
const color DEFAULT_BPR_BEARISH_UNFILLED_COLOR = color.new(color.rgb(242, 54, 69), 70)
const color DEFAULT_BPR_BEARISH_FILLED_COLOR = color.new(color.rgb(242, 54, 69), 90)
const color DEFAULT_BPR_BULLISH_BOUNDARY_COLOR = color.rgb(76, 175, 80)
const color DEFAULT_BPR_BEARISH_BOUNDARY_COLOR = color.rgb(242, 54, 69)
const color DEFAULT_INTERNAL_LINES_COLOR = color.new(color.rgb(184, 184, 184), 40)
const color DEFAULT_LABEL_COLOR = color.rgb(128, 128, 128)

// NWOG
showNWOG = input.bool(true, LABEL_NWOG, group=GROUP_NWOG, inline="1")
nwogGapsToShow = input.int(5, "", minval=1, maxval=20, group=GROUP_NWOG, inline="1")
nwogUnfilledColor = input.color(DEFAULT_NWOG_UNFILLED_COLOR, LABEL_UNFILLED, group=GROUP_NWOG, inline="2")
nwogFilledColor = input.color(DEFAULT_NWOG_FILLED_COLOR, LABEL_FILLED, group=GROUP_NWOG, inline="2")
extendNWOGToPresent = input.bool(false, LABEL_EXTEND, group=GROUP_NWOG, inline="3")
hideFilledNWOG = input.bool(false, LABEL_HIDE_FILLED, group=GROUP_NWOG, inline="3")
showNWOGDividers = input.bool(false, LABEL_DIVIDERS, group=GROUP_NWOG, inline="4")
nwogDividerColor = input.color(DEFAULT_NWOG_DIVIDER_COLOR, "", group=GROUP_NWOG, inline="4")
showNWOGDateLabel = input.bool(true, LABEL_DATE_LABEL, group=GROUP_NWOG, inline="5")
nwogBoundaryColor = input.color(DEFAULT_NWOG_BOUNDARY_COLOR, LABEL_BORDER_LABEL, group=GROUP_NWOG, inline="6")

// NDOG
showNDOG = input.bool(true, LABEL_NDOG, group=GROUP_NDOG, inline="1")
ndogGapsToShow = input.int(5, "", minval=1, maxval=20, group=GROUP_NDOG, inline="1")
ndogUnfilledColor = input.color(DEFAULT_NDOG_UNFILLED_COLOR, LABEL_UNFILLED, group=GROUP_NDOG, inline="2")
ndogFilledColor = input.color(DEFAULT_NDOG_FILLED_COLOR, LABEL_FILLED, group=GROUP_NDOG, inline="2")
extendNDOGToPresent = input.bool(false, LABEL_EXTEND, group=GROUP_NDOG, inline="3")
hideFilledNDOG = input.bool(false, LABEL_HIDE_FILLED, group=GROUP_NDOG, inline="3")
showNDOGDividers = input.bool(false, LABEL_DIVIDERS, group=GROUP_NDOG, inline="4")
ndogDividerColor = input.color(DEFAULT_NDOG_DIVIDER_COLOR, "", group=GROUP_NDOG, inline="4")
showNDOGDateLabel = input.bool(true, LABEL_DATE_LABEL, group=GROUP_NDOG, inline="5")
ndogBoundaryColor = input.color(DEFAULT_NDOG_BOUNDARY_COLOR, LABEL_BORDER_LABEL, group=GROUP_NDOG, inline="6")

// RTH
showRTHGaps = input.bool(false, LABEL_RTH, group=GROUP_RTH, inline="1")
rthGapsToShow = input.int(5, "", minval=1, maxval=50, group=GROUP_RTH, inline="1")
rthUnfilledColor = input.color(DEFAULT_RTH_UNFILLED_COLOR, LABEL_UNFILLED, group=GROUP_RTH, inline="2")
rthFilledColor = input.color(DEFAULT_RTH_FILLED_COLOR, LABEL_FILLED, group=GROUP_RTH, inline="2")
showPreview = input.bool(true, LABEL_PREVIEW, group=GROUP_RTH, inline="3")
previewMode = input.string("Compact", "", group=GROUP_RTH, inline="3", options=["Full", "Compact"])
previewColor = input.color(DEFAULT_RTH_PREVIEW_COLOR, "", group=GROUP_RTH, inline="3")
muteETHCandles = input.bool(true, LABEL_MUTE_ETH, group=GROUP_RTH, inline="4")
ethCandleColor = input.color(DEFAULT_RTH_ETH_CANDLE_COLOR, "", group=GROUP_RTH, inline="4")
showRTHDateLabel = input.bool(true, LABEL_DATE_LABEL, group=GROUP_RTH, inline="5")
rthBoundaryColor = input.color(DEFAULT_RTH_BOUNDARY_COLOR, LABEL_BORDER_LABEL, group=GROUP_RTH, inline="6")

// BPR
showBPR = input.bool(true, LABEL_BPR, group=GROUP_BPR, inline="1")
bprToShow = input.int(5, "", minval=1, maxval=20, group=GROUP_BPR, inline="1")
bprBullishUnfilledColor = input.color(DEFAULT_BPR_BULLISH_UNFILLED_COLOR, "Bullish Unfilled", group=GROUP_BPR, inline="2")
bprBullishFilledColor = input.color(DEFAULT_BPR_BULLISH_FILLED_COLOR, "Filled", group=GROUP_BPR, inline="2")
bprBearishUnfilledColor = input.color(DEFAULT_BPR_BEARISH_UNFILLED_COLOR, "Bearish Unfilled", group=GROUP_BPR, inline="3")
bprBearishFilledColor = input.color(DEFAULT_BPR_BEARISH_FILLED_COLOR, "Filled", group=GROUP_BPR, inline="3")
bprLookbackBars = input.int(10, "FVG Lookback Bars", minval=2, maxval=50, group=GROUP_BPR, inline="4", tooltip="Max bars between opposing FVGs to form a BPR")
extendBPRToPresent = input.bool(false, LABEL_EXTEND, group=GROUP_BPR, inline="5")
hideFilledBPR = input.bool(false, LABEL_HIDE_FILLED, group=GROUP_BPR, inline="5")
bprBullishBoundaryColor = input.color(DEFAULT_BPR_BULLISH_BOUNDARY_COLOR, "Bullish Border", group=GROUP_BPR, inline="6")
bprBearishBoundaryColor = input.color(DEFAULT_BPR_BEARISH_BOUNDARY_COLOR, "Bearish Border", group=GROUP_BPR, inline="6")

// Appearance
showInternalLines = input.bool(true, LABEL_INTERNAL_LINES, group=GROUP_APPEARANCE, inline="1")
internalLinesColor = input.color(DEFAULT_INTERNAL_LINES_COLOR, "", group=GROUP_APPEARANCE, inline="1")
labelColor = input.color(DEFAULT_LABEL_COLOR, LABEL_LABELS, group=GROUP_APPEARANCE, inline="1")

// Color Reference Table
showColorTable = input.bool(false, "Show Color Reference Table", group="📊 Color Reference", tooltip="Display a table showing all color values used in the indicator")

isValidRTHTimeframe = timeframe.in_seconds(timeframe.period) >= timeframe.in_seconds("1") and timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds("15")
isValidNWOGTimeframe = timeframe.in_seconds(timeframe.period) >= timeframe.in_seconds("1") and timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds("240")

rthSession = "0930-1615:1234567"
inRTH = isValidRTHTimeframe and not na(time(timeframe.period, rthSession, "America/New_York"))
rthStart = inRTH and not inRTH[1]
rthEnd = not inRTH and inRTH[1]

type GapData
    box topUnfilledBox
    box filledBox
    box bottomUnfilledBox
    line ceLine
    line q1Line
    line q3Line
    line topBoundaryLine
    line bottomBoundaryLine
    label gapLabel
    label dateLabel
    float top
    float bottom
    float penetrationLevel
    string entryDirection
    bool filled
    bool passedNextSession
    bool isPreview
    string gapType
    int creationBar
    int creationTime
    int leftBar

type SessionDividers
    array<int> dividerTimes

var float rthClosePrice = na
var int previewStartBar = na
var array<GapData> gapsArray = array.new<GapData>()
var SessionDividers ndogDividers = SessionDividers.new(array.new<int>())
var SessionDividers nwogDividers = SessionDividers.new(array.new<int>())
var array<line> dividerLines = array.new<line>()
var GapData previewGap = na

var float fridayClosePrice = na
var float sundayOpenPrice = na

var float prevDayClosePrice = na
var float newDayOpenPrice = na
var int lastNDOGDay = na

createGap(float topPrice, float bottomPrice, string gapType, bool isPreview = false, int customLeftBar = na) =>
    gapRange = topPrice - bottomPrice
    gapMid = bottomPrice + gapRange * CE_LEVEL
    gapQ1 = bottomPrice + gapRange * Q1_LEVEL
    gapQ3 = bottomPrice + gapRange * Q3_LEVEL

    unfilled = gapType == GAP_TYPE_NWOG ? nwogUnfilledColor : gapType == GAP_TYPE_NDOG ? ndogUnfilledColor : gapType == GAP_TYPE_BPR_BULLISH ? bprBullishUnfilledColor : gapType == GAP_TYPE_BPR_BEARISH ? bprBearishUnfilledColor : rthUnfilledColor
    filled = gapType == GAP_TYPE_NWOG ? nwogFilledColor : gapType == GAP_TYPE_NDOG ? ndogFilledColor : gapType == GAP_TYPE_BPR_BULLISH ? bprBullishFilledColor : gapType == GAP_TYPE_BPR_BEARISH ? bprBearishFilledColor : rthFilledColor
    boxColor = isPreview ? previewColor : unfilled

    isCompact = isPreview and previewMode == "Compact"
    leftBar = not na(customLeftBar) ? customLeftBar : (isPreview ? (isCompact ? bar_index + COMPACT_OFFSET : previewStartBar) : bar_index)
    rightBar = isPreview ? (isCompact ? leftBar + COMPACT_WIDTH : bar_index) : bar_index

    topUnfilledBox = box.new(leftBar, topPrice, rightBar, bottomPrice, bgcolor=boxColor, border_color=na)
    filledBox = box.new(leftBar, bottomPrice, rightBar, bottomPrice, bgcolor=filled, border_color=na)
    bottomUnfilledBox = box.new(leftBar, bottomPrice, rightBar, bottomPrice, bgcolor=na, border_color=na)

    // All internal lines are now dotted and uniform
    ceLine = (showInternalLines and not isPreview) ? line.new(leftBar, gapMid, rightBar, gapMid, color=internalLinesColor, style=line.style_dotted, width=1) : na
    q1Line = (showInternalLines and not isPreview) ? line.new(leftBar, gapQ1, rightBar, gapQ1, color=internalLinesColor, style=line.style_dotted, width=1) : na
    q3Line = (showInternalLines and not isPreview) ? line.new(leftBar, gapQ3, rightBar, gapQ3, color=internalLinesColor, style=line.style_dotted, width=1) : na

    // Outer boundary lines (top and bottom edges) - solid, width 1
    boundaryColor = gapType == GAP_TYPE_NWOG ? nwogBoundaryColor : gapType == GAP_TYPE_NDOG ? ndogBoundaryColor : gapType == GAP_TYPE_RTH ? rthBoundaryColor : gapType == GAP_TYPE_BPR_BULLISH ? bprBullishBoundaryColor : gapType == GAP_TYPE_BPR_BEARISH ? bprBearishBoundaryColor : na
    topBoundaryLine = not isPreview ? line.new(leftBar, topPrice, rightBar, topPrice, color=boundaryColor, style=line.style_solid, width=1) : na
    bottomBoundaryLine = not isPreview ? line.new(leftBar, bottomPrice, rightBar, bottomPrice, color=boundaryColor, style=line.style_solid, width=1) : na

    showLabel = (gapType == GAP_TYPE_NWOG or gapType == GAP_TYPE_NDOG or gapType == GAP_TYPE_BPR_BULLISH or gapType == GAP_TYPE_BPR_BEARISH) and not isPreview
    gapLabel = showLabel ? label.new(leftBar, gapMid, gapType, color=color.new(color.white, 100), textcolor=labelColor, style=label.style_none, size=size.tiny) : na

    // Create date label for NWOG, NDOG, and RTH gaps (when enabled)
    label dateLabel = na
    showDateLabel = (gapType == GAP_TYPE_NWOG and showNWOGDateLabel) or (gapType == GAP_TYPE_NDOG and showNDOGDateLabel) or (gapType == GAP_TYPE_RTH and showRTHDateLabel)

    if showDateLabel and not isPreview
        gapYear = year(time)
        gapMonth = month(time)
        gapDay = dayofmonth(time)

        // Format month name
        monthName = gapMonth == 1 ? "Jan" : gapMonth == 2 ? "Feb" : gapMonth == 3 ? "Mar" : gapMonth == 4 ? "Apr" : gapMonth == 5 ? "May" : gapMonth == 6 ? "Jun" : gapMonth == 7 ? "Jul" : gapMonth == 8 ? "Aug" : gapMonth == 9 ? "Sep" : gapMonth == 10 ? "Oct" : gapMonth == 11 ? "Nov" : "Dec"

        // Create date string: "NWOG Oct 26, 2025", "NDOG Oct 26, 2025", or "RTH Oct 26, 2025"
        gapPrefix = gapType == GAP_TYPE_NWOG ? "NWOG" : gapType == GAP_TYPE_NDOG ? "NDOG" : "RTH"
        dateStr = gapPrefix + " " + monthName + " " + str.tostring(gapDay) + ", " + str.tostring(gapYear)

        // Use boundary color for text (same color as boundary lines)
        dateLabelColor = gapType == GAP_TYPE_NWOG ? nwogBoundaryColor : gapType == GAP_TYPE_NDOG ? ndogBoundaryColor : rthBoundaryColor

        // Position at horizontal center, just below bottom boundary
        centerX = math.round((leftBar + rightBar) / 2)
        dateLabel := label.new(centerX, bottomPrice, dateStr, color=color.new(color.white, 100), textcolor=dateLabelColor, style=label.style_label_up, size=size.tiny, textalign=text.align_center)

    initialDirection = ENTRY_NONE
    if close < bottomPrice
        initialDirection := ENTRY_FROM_BELOW
    else if close > topPrice
        initialDirection := ENTRY_FROM_ABOVE

    GapData.new(
         topUnfilledBox=topUnfilledBox,
         filledBox=filledBox,
         bottomUnfilledBox=bottomUnfilledBox,
         ceLine=ceLine,
         q1Line=q1Line,
         q3Line=q3Line,
         topBoundaryLine=topBoundaryLine,
         bottomBoundaryLine=bottomBoundaryLine,
         gapLabel=gapLabel,
         dateLabel=dateLabel,
         top=topPrice,
         bottom=bottomPrice,
         penetrationLevel=na,
         entryDirection=initialDirection,
         filled=false,
         passedNextSession=false,
         isPreview=isPreview,
         gapType=gapType,
         creationBar=bar_index,
         creationTime=time,
         leftBar=leftBar
     )

deleteGap(GapData gap) =>
    box.delete(gap.topUnfilledBox)
    box.delete(gap.filledBox)
    box.delete(gap.bottomUnfilledBox)
    if not na(gap.ceLine)
        line.delete(gap.ceLine)
    if not na(gap.q1Line)
        line.delete(gap.q1Line)
    if not na(gap.q3Line)
        line.delete(gap.q3Line)
    if not na(gap.topBoundaryLine)
        line.delete(gap.topBoundaryLine)
    if not na(gap.bottomBoundaryLine)
        line.delete(gap.bottomBoundaryLine)
    if not na(gap.gapLabel)
        label.delete(gap.gapLabel)
    if not na(gap.dateLabel)
        label.delete(gap.dateLabel)

countGapsByType(string gapType) =>
    count = 0
    if array.size(gapsArray) > 0
        for i = 0 to array.size(gapsArray) - 1
            gap = array.get(gapsArray, i)
            if gap.gapType == gapType
                count += 1
    count

removeOldestGap(string gapType) =>
    if array.size(gapsArray) > 0
        for i = 0 to array.size(gapsArray) - 1
            gap = array.get(gapsArray, i)
            if gap.gapType == gapType
                deleteGap(gap)
                array.remove(gapsArray, i)
                break

if rthEnd and showRTHGaps
    rthClosePrice := close[1]
    previewStartBar := bar_index

    if showPreview
        previewTop = math.max(rthClosePrice, close)
        previewBottom = math.min(rthClosePrice, close)
        previewGap := createGap(previewTop, previewBottom, GAP_TYPE_RTH, true)

if not inRTH and not na(previewGap) and not na(rthClosePrice) and showPreview and showRTHGaps
    newTop = math.max(rthClosePrice, close)
    newBottom = math.min(rthClosePrice, close)

    isCompact = previewMode == "Compact"
    previewLeft = isCompact ? bar_index + COMPACT_OFFSET : previewStartBar
    previewRight = isCompact ? previewLeft + COMPACT_WIDTH : bar_index

    box.set_top(previewGap.topUnfilledBox, newTop)
    box.set_bottom(previewGap.topUnfilledBox, newBottom)
    box.set_left(previewGap.topUnfilledBox, previewLeft)
    box.set_right(previewGap.topUnfilledBox, previewRight)

    previewRange = newTop - newBottom
    if previewRange > 0
        newMid = newBottom + previewRange * CE_LEVEL

        if not na(previewGap.ceLine)
            line.set_y1(previewGap.ceLine, newMid)
            line.set_y2(previewGap.ceLine, newMid)
            line.set_x1(previewGap.ceLine, previewLeft)
            line.set_x2(previewGap.ceLine, previewRight)

    previewGap.top := newTop
    previewGap.bottom := newBottom

if rthStart and showRTHGaps and array.size(gapsArray) > 0
    for i = 0 to array.size(gapsArray) - 1
        gap = array.get(gapsArray, i)
        if gap.gapType == GAP_TYPE_RTH
            gap.passedNextSession := true

if showNWOG and isValidNWOGTimeframe and array.size(gapsArray) > 0
    [arrayTimes, arrayOpens, arrayCloses] = request.security_lower_tf(syminfo.tickerid, "1", [time, open, close])

    if not na(arrayTimes) and array.size(arrayTimes) > 0
        // Calculate lookback limit: only process recent weeks
        lookbackLimit = time - (nwogGapsToShow * 3 * MILLISECONDS_PER_WEEK)

        for i = 0 to array.size(arrayTimes) - 1
            barTime = array.get(arrayTimes, i)

            // Skip bars that are too old for performance
            if barTime < lookbackLimit
                continue

            barDay = dayofweek(barTime, "America/New_York")
            barHour = hour(barTime, "America/New_York")
            barMinute = minute(barTime, "America/New_York")

            if barDay == 1 and barHour == SESSION_OPEN_HOUR and barMinute == ZERO_MINUTE
                for j = 0 to array.size(gapsArray) - 1
                    gap = array.get(gapsArray, j)
                    // Only mark NWOG gaps that were created at least 6 days before this session
                    // (6 days = 518400000 ms, ensures it's the NEXT Sunday not the same one)
                    if gap.gapType == GAP_TYPE_NWOG and (barTime - gap.creationTime) >= 518400000
                        gap.passedNextSession := true

if rthStart and showRTHGaps
    if not na(previewGap)
        deleteGap(previewGap)
        previewGap := na
        previewStartBar := na

if rthStart and not na(rthClosePrice) and showRTHGaps
    rthOpenPrice = open

    if rthOpenPrice != rthClosePrice
        gapTop = math.max(rthClosePrice, rthOpenPrice)
        gapBottom = math.min(rthClosePrice, rthOpenPrice)

        rthGap = createGap(gapTop, gapBottom, GAP_TYPE_RTH, false)
        array.push(gapsArray, rthGap)

        if countGapsByType(GAP_TYPE_RTH) > rthGapsToShow
            removeOldestGap(GAP_TYPE_RTH)

if array.size(gapsArray) > 0
    mostRecentUnfilledNWOGBar = -1
    mostRecentUnfilledNDOGBar = -1

    for i = 0 to array.size(gapsArray) - 1
        gap = array.get(gapsArray, i)
        if gap.gapType == GAP_TYPE_NWOG and not gap.filled and gap.creationBar > mostRecentUnfilledNWOGBar
            mostRecentUnfilledNWOGBar := gap.creationBar
        if gap.gapType == GAP_TYPE_NDOG and not gap.filled and gap.creationBar > mostRecentUnfilledNDOGBar
            mostRecentUnfilledNDOGBar := gap.creationBar

    for i = array.size(gapsArray) - 1 to 0
        gap = array.get(gapsArray, i)

        if gap.gapType == GAP_TYPE_RTH and not showRTHGaps
            continue
        if gap.gapType == GAP_TYPE_NWOG and not showNWOG
            continue
        if gap.gapType == GAP_TYPE_NDOG and not showNDOG
            continue
        if (gap.gapType == GAP_TYPE_BPR_BULLISH or gap.gapType == GAP_TYPE_BPR_BEARISH) and not showBPR
            continue

        // Skip filled gaps that passed next session UNLESS "Extend" is ON
        skipGap = false
        if gap.filled and gap.passedNextSession
            if gap.gapType == GAP_TYPE_RTH
                skipGap := true
            else if gap.gapType == GAP_TYPE_NWOG and not extendNWOGToPresent
                skipGap := true
            else if gap.gapType == GAP_TYPE_NDOG and not extendNDOGToPresent
                skipGap := true
            else if (gap.gapType == GAP_TYPE_BPR_BULLISH or gap.gapType == GAP_TYPE_BPR_BEARISH) and not extendBPRToPresent
                skipGap := true

        if skipGap
            continue

        if gap.entryDirection == ENTRY_NONE
            if high >= gap.bottom and low <= gap.bottom
                gap.entryDirection := ENTRY_FROM_BELOW
            else if low <= gap.top and high >= gap.top
                gap.entryDirection := ENTRY_FROM_ABOVE

        if not gap.filled
            if gap.entryDirection == ENTRY_FROM_BELOW
                if high >= gap.bottom and high <= gap.top
                    gap.penetrationLevel := na(gap.penetrationLevel) ? high : math.max(gap.penetrationLevel, high)
                if high >= gap.top
                    gap.penetrationLevel := gap.top
                    gap.filled := true
                    // For BPRs, stop extending at mitigation point
                    if gap.gapType == GAP_TYPE_BPR_BULLISH or gap.gapType == GAP_TYPE_BPR_BEARISH
                        box.set_right(gap.topUnfilledBox, bar_index)
                        box.set_right(gap.filledBox, bar_index)
                        box.set_right(gap.bottomUnfilledBox, bar_index)
                        if not na(gap.ceLine)
                            line.set_x2(gap.ceLine, bar_index)
                        if not na(gap.q1Line)
                            line.set_x2(gap.q1Line, bar_index)
                        if not na(gap.q3Line)
                            line.set_x2(gap.q3Line, bar_index)
                        if not na(gap.topBoundaryLine)
                            line.set_x2(gap.topBoundaryLine, bar_index)
                        if not na(gap.bottomBoundaryLine)
                            line.set_x2(gap.bottomBoundaryLine, bar_index)

            else if gap.entryDirection == ENTRY_FROM_ABOVE
                if low <= gap.top and low >= gap.bottom
                    gap.penetrationLevel := na(gap.penetrationLevel) ? low : math.min(gap.penetrationLevel, low)
                if low <= gap.bottom
                    gap.penetrationLevel := gap.bottom
                    gap.filled := true
                    // For BPRs, stop extending at mitigation point
                    if gap.gapType == GAP_TYPE_BPR_BULLISH or gap.gapType == GAP_TYPE_BPR_BEARISH
                        box.set_right(gap.topUnfilledBox, bar_index)
                        box.set_right(gap.filledBox, bar_index)
                        box.set_right(gap.bottomUnfilledBox, bar_index)
                        if not na(gap.ceLine)
                            line.set_x2(gap.ceLine, bar_index)
                        if not na(gap.q1Line)
                            line.set_x2(gap.q1Line, bar_index)
                        if not na(gap.q3Line)
                            line.set_x2(gap.q3Line, bar_index)
                        if not na(gap.topBoundaryLine)
                            line.set_x2(gap.topBoundaryLine, bar_index)
                        if not na(gap.bottomBoundaryLine)
                            line.set_x2(gap.bottomBoundaryLine, bar_index)

            if not gap.filled and not na(gap.penetrationLevel)
                if gap.entryDirection == ENTRY_FROM_BELOW
                    if gap.penetrationLevel >= gap.top
                        gap.filled := true
                        // For BPRs, stop extending at mitigation point
                        if gap.gapType == GAP_TYPE_BPR_BULLISH or gap.gapType == GAP_TYPE_BPR_BEARISH
                            box.set_right(gap.topUnfilledBox, bar_index)
                            box.set_right(gap.filledBox, bar_index)
                            box.set_right(gap.bottomUnfilledBox, bar_index)
                            if not na(gap.ceLine)
                                line.set_x2(gap.ceLine, bar_index)
                            if not na(gap.q1Line)
                                line.set_x2(gap.q1Line, bar_index)
                            if not na(gap.q3Line)
                                line.set_x2(gap.q3Line, bar_index)
                            if not na(gap.topBoundaryLine)
                                line.set_x2(gap.topBoundaryLine, bar_index)
                            if not na(gap.bottomBoundaryLine)
                                line.set_x2(gap.bottomBoundaryLine, bar_index)
                else if gap.entryDirection == ENTRY_FROM_ABOVE
                    if gap.penetrationLevel <= gap.bottom
                        gap.filled := true
                        // For BPRs, stop extending at mitigation point
                        if gap.gapType == GAP_TYPE_BPR_BULLISH or gap.gapType == GAP_TYPE_BPR_BEARISH
                            box.set_right(gap.topUnfilledBox, bar_index)
                            box.set_right(gap.filledBox, bar_index)
                            box.set_right(gap.bottomUnfilledBox, bar_index)
                            if not na(gap.ceLine)
                                line.set_x2(gap.ceLine, bar_index)
                            if not na(gap.q1Line)
                                line.set_x2(gap.q1Line, bar_index)
                            if not na(gap.q3Line)
                                line.set_x2(gap.q3Line, bar_index)
                            if not na(gap.topBoundaryLine)
                                line.set_x2(gap.topBoundaryLine, bar_index)
                            if not na(gap.bottomBoundaryLine)
                                line.set_x2(gap.bottomBoundaryLine, bar_index)

        if gap.filled
            if (gap.gapType == GAP_TYPE_NWOG and hideFilledNWOG) or (gap.gapType == GAP_TYPE_NDOG and hideFilledNDOG) or ((gap.gapType == GAP_TYPE_BPR_BULLISH or gap.gapType == GAP_TYPE_BPR_BEARISH) and hideFilledBPR)
                deleteGap(gap)
                array.remove(gapsArray, i)
                continue

        gapUnfilledColor = gap.gapType == GAP_TYPE_NWOG ? nwogUnfilledColor : gap.gapType == GAP_TYPE_NDOG ? ndogUnfilledColor : gap.gapType == GAP_TYPE_BPR_BULLISH ? bprBullishUnfilledColor : gap.gapType == GAP_TYPE_BPR_BEARISH ? bprBearishUnfilledColor : rthUnfilledColor
        gapFilledColor = gap.gapType == GAP_TYPE_NWOG ? nwogFilledColor : gap.gapType == GAP_TYPE_NDOG ? ndogFilledColor : gap.gapType == GAP_TYPE_BPR_BULLISH ? bprBullishFilledColor : gap.gapType == GAP_TYPE_BPR_BEARISH ? bprBearishFilledColor : rthFilledColor

        if not na(gap.penetrationLevel)
            if gap.entryDirection == ENTRY_FROM_BELOW
                box.set_top(gap.filledBox, gap.penetrationLevel)
                box.set_bottom(gap.filledBox, gap.bottom)
                box.set_bgcolor(gap.filledBox, gapFilledColor)
                box.set_top(gap.topUnfilledBox, gap.top)
                box.set_bottom(gap.topUnfilledBox, gap.penetrationLevel)
                box.set_bgcolor(gap.topUnfilledBox, gapUnfilledColor)
                box.set_top(gap.bottomUnfilledBox, gap.bottom)
                box.set_bottom(gap.bottomUnfilledBox, gap.bottom)

            else if gap.entryDirection == ENTRY_FROM_ABOVE
                box.set_top(gap.filledBox, gap.top)
                box.set_bottom(gap.filledBox, gap.penetrationLevel)
                box.set_bgcolor(gap.filledBox, gapFilledColor)
                box.set_top(gap.bottomUnfilledBox, gap.penetrationLevel)
                box.set_bottom(gap.bottomUnfilledBox, gap.bottom)
                box.set_bgcolor(gap.bottomUnfilledBox, gapUnfilledColor)
                box.set_top(gap.topUnfilledBox, gap.top)
                box.set_bottom(gap.topUnfilledBox, gap.top)
        else
            box.set_top(gap.topUnfilledBox, gap.top)
            box.set_bottom(gap.topUnfilledBox, gap.bottom)
            box.set_bgcolor(gap.topUnfilledBox, gapUnfilledColor)
            box.set_top(gap.filledBox, gap.bottom)
            box.set_bottom(gap.filledBox, gap.bottom)
            box.set_top(gap.bottomUnfilledBox, gap.bottom)
            box.set_bottom(gap.bottomUnfilledBox, gap.bottom)

        // Extension logic varies by gap type
        // RTH: Continue extending unfilled gaps past next session
        // NWOG/NDOG: "Extend to Present" ON → extend all gaps to present
        //            "Extend to Present" OFF → unfilled extends to present, filled extends minimum to next session
        shouldExtend = false
        if gap.gapType == GAP_TYPE_RTH
            shouldExtend := not gap.passedNextSession or (gap.passedNextSession and not gap.filled)
        else if gap.gapType == GAP_TYPE_NWOG
            // Toggle ON: extend all | Toggle OFF: unfilled extends, filled extends until next session
            shouldExtend := extendNWOGToPresent or not gap.filled or not gap.passedNextSession
        else if gap.gapType == GAP_TYPE_NDOG
            // Toggle ON: extend all | Toggle OFF: unfilled extends, filled extends until next session
            shouldExtend := extendNDOGToPresent or not gap.filled or not gap.passedNextSession
        else if gap.gapType == GAP_TYPE_BPR_BULLISH or gap.gapType == GAP_TYPE_BPR_BEARISH
            // Toggle ON: extend all | Toggle OFF: unfilled extends, filled stops immediately
            shouldExtend := extendBPRToPresent or not gap.filled

        if shouldExtend
            rightEdge = bar_index + RIGHT_EDGE_CUSHION
            box.set_right(gap.topUnfilledBox, rightEdge)
            box.set_right(gap.filledBox, rightEdge)
            box.set_right(gap.bottomUnfilledBox, rightEdge)
            if not na(gap.ceLine)
                line.set_x2(gap.ceLine, rightEdge)
            if not na(gap.q1Line)
                line.set_x2(gap.q1Line, rightEdge)
            if not na(gap.q3Line)
                line.set_x2(gap.q3Line, rightEdge)
            if not na(gap.topBoundaryLine)
                line.set_x2(gap.topBoundaryLine, rightEdge)
            if not na(gap.bottomBoundaryLine)
                line.set_x2(gap.bottomBoundaryLine, rightEdge)

        if not na(gap.gapLabel)
            isMostRecentUnfilled = not gap.filled and ((gap.gapType == GAP_TYPE_NWOG and gap.creationBar == mostRecentUnfilledNWOGBar) or (gap.gapType == GAP_TYPE_NDOG and gap.creationBar == mostRecentUnfilledNDOGBar))

            if isMostRecentUnfilled
                label.set_color(gap.gapLabel, color.new(color.white, 100))
                label.set_textcolor(gap.gapLabel, labelColor)
                label.set_style(gap.gapLabel, label.style_none)
                label.set_size(gap.gapLabel, size.tiny)
            else
                label.set_color(gap.gapLabel, color.new(color.white, 100))
                label.set_textcolor(gap.gapLabel, color.new(labelColor, 100))

if showNWOG and isValidNWOGTimeframe
    [arrayTimes, arrayOpens, arrayCloses] = request.security_lower_tf(syminfo.tickerid, "1", [time, open, close])

    if not na(arrayTimes) and array.size(arrayTimes) > 0
        // Calculate lookback limit: only process recent weeks (3x buffer for safety)
        lookbackLimit = time - (nwogGapsToShow * 3 * MILLISECONDS_PER_WEEK)

        for i = 0 to array.size(arrayTimes) - 1
            barTime = array.get(arrayTimes, i)

            // Skip bars that are too old for performance
            if barTime < lookbackLimit
                continue

            barDay = dayofweek(barTime, "America/New_York")
            barHour = hour(barTime, "America/New_York")
            barMinute = minute(barTime, "America/New_York")

            if barDay == 6 and barHour == CLOSE_HOUR and barMinute == CLOSE_MINUTE
                fridayClosePrice := array.get(arrayCloses, i)

            if barDay == 1 and barHour == SESSION_OPEN_HOUR and barMinute == ZERO_MINUTE and not na(fridayClosePrice)
                sundayOpenPrice := array.get(arrayOpens, i)

                if sundayOpenPrice != fridayClosePrice
                    nwogTop = math.max(fridayClosePrice, sundayOpenPrice)
                    nwogBottom = math.min(fridayClosePrice, sundayOpenPrice)

                    nwogGap = createGap(nwogTop, nwogBottom, GAP_TYPE_NWOG, false)
                    array.push(gapsArray, nwogGap)

                    if countGapsByType(GAP_TYPE_NWOG) > nwogGapsToShow
                        removeOldestGap(GAP_TYPE_NWOG)

                fridayClosePrice := na

// Divider detection (independent of gap display toggles)
if (showNDOGDividers or showNWOGDividers) and isValidNWOGTimeframe
    [arrayTimes, arrayOpens, arrayCloses] = request.security_lower_tf(syminfo.tickerid, "1", [time, open, close])

    if not na(arrayTimes) and array.size(arrayTimes) > 0
        // Calculate lookback limit based on which dividers are enabled
        maxGapsToShow = showNWOGDividers ? nwogGapsToShow : ndogGapsToShow
        lookbackPeriod = showNWOGDividers ? MILLISECONDS_PER_WEEK : MILLISECONDS_PER_DAY
        lookbackLimit = time - (maxGapsToShow * 3 * lookbackPeriod)

        for i = 0 to array.size(arrayTimes) - 1
            barTime = array.get(arrayTimes, i)

            // Skip bars that are too old for performance
            if barTime < lookbackLimit
                continue

            barDay = dayofweek(barTime, "America/New_York")
            barHour = hour(barTime, "America/New_York")
            barMinute = minute(barTime, "America/New_York")

            // Detect 18:00 session open Monday-Friday and Sunday
            if ((barDay >= 2 and barDay <= 6) or barDay == 1) and barHour == SESSION_OPEN_HOUR and barMinute == ZERO_MINUTE
                // Store divider time for NDOG (all 18:00 openings)
                if showNDOGDividers
                    array.push(ndogDividers.dividerTimes, barTime)

                // Store divider time for NWOG (Sunday 18:00 only)
                if showNWOGDividers and barDay == 1
                    array.push(nwogDividers.dividerTimes, barTime)

if showNDOG and isValidNWOGTimeframe
    [arrayTimes, arrayOpens, arrayCloses] = request.security_lower_tf(syminfo.tickerid, "1", [time, open, close])

    if not na(arrayTimes) and array.size(arrayTimes) > 0
        // Calculate lookback limit: only process recent days (3x buffer for safety)
        lookbackLimit = time - (ndogGapsToShow * 3 * MILLISECONDS_PER_DAY)

        for i = 0 to array.size(arrayTimes) - 1
            barTime = array.get(arrayTimes, i)

            // Skip bars that are too old for performance
            if barTime < lookbackLimit
                continue

            barDay = dayofweek(barTime, "America/New_York")
            barHour = hour(barTime, "America/New_York")
            barMinute = minute(barTime, "America/New_York")

            // Capture close price Monday-Friday (16:59)
            if barDay >= 2 and barDay <= 6 and barHour == CLOSE_HOUR and barMinute == CLOSE_MINUTE
                prevDayClosePrice := array.get(arrayCloses, i)

            // Detect 18:00 session open Monday-Friday and Sunday
            // Note: Friday→Sunday creates both NDOG and NWOG (not mutually exclusive)
            if ((barDay >= 2 and barDay <= 6) or barDay == 1) and barHour == SESSION_OPEN_HOUR and barMinute == ZERO_MINUTE
                if not na(prevDayClosePrice)
                    newDayOpenPrice := array.get(arrayOpens, i)

                    if newDayOpenPrice != prevDayClosePrice
                        ndogTop = math.max(prevDayClosePrice, newDayOpenPrice)
                        ndogBottom = math.min(prevDayClosePrice, newDayOpenPrice)

                        ndogGap = createGap(ndogTop, ndogBottom, GAP_TYPE_NDOG, false)
                        array.push(gapsArray, ndogGap)

                        if countGapsByType(GAP_TYPE_NDOG) > ndogGapsToShow
                            removeOldestGap(GAP_TYPE_NDOG)

                    prevDayClosePrice := na
if showNDOG and isValidNWOGTimeframe and array.size(gapsArray) > 0
    [arrayTimes, arrayOpens, arrayCloses] = request.security_lower_tf(syminfo.tickerid, "1", [time, open, close])

    if not na(arrayTimes) and array.size(arrayTimes) > 0
        // Calculate lookback limit: only process recent days
        lookbackLimit = time - (ndogGapsToShow * 3 * MILLISECONDS_PER_DAY)

        for i = 0 to array.size(arrayTimes) - 1
            barTime = array.get(arrayTimes, i)

            // Skip bars that are too old for performance
            if barTime < lookbackLimit
                continue

            barDay = dayofweek(barTime, "America/New_York")
            barHour = hour(barTime, "America/New_York")
            barMinute = minute(barTime, "America/New_York")

            // Mark NDOG gaps as passed when reaching next 18:00 session (Mon-Fri + Sunday)
            if ((barDay >= 2 and barDay <= 6) or barDay == 1) and barHour == SESSION_OPEN_HOUR and barMinute == ZERO_MINUTE
                for j = 0 to array.size(gapsArray) - 1
                    gap = array.get(gapsArray, j)
                    // Only mark gaps created at least 20 hours before this session
                    // 20 hours = 72000000 ms (handles daily ~24h and Friday→Sunday ~50h gaps)
                    if gap.gapType == GAP_TYPE_NDOG and (barTime - gap.creationTime) >= 72000000
                        gap.passedNextSession := true

// BPR Detection
if showBPR
    fvgBearish = low[2] - high > 0
    fvgBullish = low - high[2] > 0

    var float bullBprTopDetected = na
    var float bullBprBottomDetected = na
    var int bullBprLeftBarDetected = na
    var float bearBprTopDetected = na
    var float bearBprBottomDetected = na
    var int bearBprLeftBarDetected = na

    // Detect bullish BPR (bearish FVG → bullish FVG)
    bullBprBarsSince = ta.barssince(fvgBearish)
    if fvgBullish and bullBprBarsSince <= bprLookbackBars
        sumOfPoints = high[bullBprBarsSince] + low[bullBprBarsSince + 2] + high[2] + low
        rangeDiff = math.max(low[bullBprBarsSince + 2], low) - math.min(high[bullBprBarsSince], high[2])
        if sumOfPoints > rangeDiff
            bullBprTopDetected := math.min(low[bullBprBarsSince + 2], low)
            bullBprBottomDetected := math.max(high[bullBprBarsSince], high[2])
            bullBprLeftBarDetected := bar_index - bullBprBarsSince - 1

    // Detect bearish BPR (bullish FVG → bearish FVG)
    bearBprBarsSince = ta.barssince(fvgBullish)
    if fvgBearish and bearBprBarsSince <= bprLookbackBars
        sumOfPoints = high[bearBprBarsSince] + low[bearBprBarsSince + 2] + high[2] + low
        rangeDiff = math.max(low[bearBprBarsSince + 2], low) - math.min(high[bearBprBarsSince], high[2])
        if sumOfPoints > rangeDiff
            bearBprTopDetected := math.min(low[bearBprBarsSince], low[2])
            bearBprBottomDetected := math.max(high[bearBprBarsSince + 2], high)
            bearBprLeftBarDetected := bar_index - bearBprBarsSince - 1

    // Create bullish BPR
    if not na(bullBprTopDetected[1]) and bullBprTopDetected[1] > bullBprBottomDetected[1]
        array.push(gapsArray, createGap(bullBprTopDetected[1], bullBprBottomDetected[1], GAP_TYPE_BPR_BULLISH, false, bullBprLeftBarDetected[1]))
        if countGapsByType(GAP_TYPE_BPR_BULLISH) + countGapsByType(GAP_TYPE_BPR_BEARISH) > bprToShow
            for i = 0 to array.size(gapsArray) - 1
                gap = array.get(gapsArray, i)
                if gap.gapType == GAP_TYPE_BPR_BULLISH or gap.gapType == GAP_TYPE_BPR_BEARISH
                    deleteGap(gap)
                    array.remove(gapsArray, i)
                    break
        bullBprTopDetected := na
        bullBprBottomDetected := na
        bullBprLeftBarDetected := na

    // Create bearish BPR
    if not na(bearBprTopDetected[1]) and bearBprTopDetected[1] > bearBprBottomDetected[1]
        array.push(gapsArray, createGap(bearBprTopDetected[1], bearBprBottomDetected[1], GAP_TYPE_BPR_BEARISH, false, bearBprLeftBarDetected[1]))
        if countGapsByType(GAP_TYPE_BPR_BULLISH) + countGapsByType(GAP_TYPE_BPR_BEARISH) > bprToShow
            for i = 0 to array.size(gapsArray) - 1
                gap = array.get(gapsArray, i)
                if gap.gapType == GAP_TYPE_BPR_BULLISH or gap.gapType == GAP_TYPE_BPR_BEARISH
                    deleteGap(gap)
                    array.remove(gapsArray, i)
                    break
        bearBprTopDetected := na
        bearBprBottomDetected := na
        bearBprLeftBarDetected := na

// Clear old divider lines
if array.size(dividerLines) > 0
    for i = 0 to array.size(dividerLines) - 1
        line.delete(array.get(dividerLines, i))
    array.clear(dividerLines)

// Draw NDOG dividers (18:00 daily)
// Requires BOTH "Show NDOG" and "NDOG Dividers" to be enabled
if showNDOG and showNDOGDividers and array.size(ndogDividers.dividerTimes) > 0
    // Only show dividers for the number of NDOGs being displayed
    count = math.min(ndogGapsToShow, array.size(ndogDividers.dividerTimes))

    for i = 0 to count - 1
        idx = array.size(ndogDividers.dividerTimes) - 1 - i
        dividerTime = array.get(ndogDividers.dividerTimes, idx)
        dividerLine = line.new(dividerTime, high, dividerTime, low, xloc=xloc.bar_time, color=ndogDividerColor, width=1, style=line.style_dashed, extend=extend.both)
        array.push(dividerLines, dividerLine)

// Draw NWOG dividers (Sunday 18:00 weekly)
// Requires BOTH "Show NWOG" and "NWOG Dividers" to be enabled
if showNWOG and showNWOGDividers and array.size(nwogDividers.dividerTimes) > 0
    // Only show dividers for the number of NWOGs being displayed
    count = math.min(nwogGapsToShow, array.size(nwogDividers.dividerTimes))

    for i = 0 to count - 1
        idx = array.size(nwogDividers.dividerTimes) - 1 - i
        dividerTime = array.get(nwogDividers.dividerTimes, idx)
        dividerLine = line.new(dividerTime, high, dividerTime, low, xloc=xloc.bar_time, color=nwogDividerColor, width=1, style=line.style_dashed, extend=extend.both)
        array.push(dividerLines, dividerLine)

plotcandle(showRTHGaps and muteETHCandles and not inRTH ? open : na, high, low, close, color=ethCandleColor, bordercolor=ethCandleColor, wickcolor=ethCandleColor, editable=false, display=display.pane, force_overlay=true)

// Color Reference Table
if showColorTable and barstate.islast
    var table colorTable = table.new(position.top_right, 4, 24, bgcolor=color.new(color.black, 20), frame_width=2, frame_color=color.gray, border_width=1, border_color=color.new(color.gray, 70))

    // Header
    table.cell(colorTable, 0, 0, "Setting", text_color=color.white, bgcolor=color.new(color.gray, 30), text_size=size.small)
    table.cell(colorTable, 1, 0, "Line", text_color=color.white, bgcolor=color.new(color.gray, 30), text_size=size.small)
    table.cell(colorTable, 2, 0, "RGB Values", text_color=color.white, bgcolor=color.new(color.gray, 30), text_size=size.small)
    table.cell(colorTable, 3, 0, "Transp", text_color=color.white, bgcolor=color.new(color.gray, 30), text_size=size.small)

    // NWOG Colors
    table.cell(colorTable, 0, 1, "NWOG Unfilled", text_size=size.small, text_color=color.white)
    table.cell(colorTable, 1, 1, "57", text_size=size.small, text_color=color.yellow)
    table.cell(colorTable, 2, 1, str.format("R:{0} G:{1} B:{2}", int(color.r(nwogUnfilledColor)), int(color.g(nwogUnfilledColor)), int(color.b(nwogUnfilledColor))), text_size=size.small, text_color=color.white)
    table.cell(colorTable, 3, 1, str.tostring(int(color.t(nwogUnfilledColor))), text_size=size.small, text_color=color.white)

    table.cell(colorTable, 0, 2, "NWOG Filled", text_size=size.small, text_color=color.white)
    table.cell(colorTable, 1, 2, "58", text_size=size.small, text_color=color.yellow)
    table.cell(colorTable, 2, 2, str.format("R:{0} G:{1} B:{2}", int(color.r(nwogFilledColor)), int(color.g(nwogFilledColor)), int(color.b(nwogFilledColor))), text_size=size.small, text_color=color.white)
    table.cell(colorTable, 3, 2, str.tostring(int(color.t(nwogFilledColor))), text_size=size.small, text_color=color.white)

    table.cell(colorTable, 0, 3, "NWOG Divider", text_size=size.small, text_color=color.white)
    table.cell(colorTable, 1, 3, "62", text_size=size.small, text_color=color.yellow)
    table.cell(colorTable, 2, 3, str.format("R:{0} G:{1} B:{2}", int(color.r(nwogDividerColor)), int(color.g(nwogDividerColor)), int(color.b(nwogDividerColor))), text_size=size.small, text_color=color.white)
    table.cell(colorTable, 3, 3, str.tostring(int(color.t(nwogDividerColor))), text_size=size.small, text_color=color.white)

    table.cell(colorTable, 0, 4, "NWOG Boundary", text_size=size.small, text_color=color.white)
    table.cell(colorTable, 1, 4, "64", text_size=size.small, text_color=color.yellow)
    table.cell(colorTable, 2, 4, str.format("R:{0} G:{1} B:{2}", int(color.r(nwogBoundaryColor)), int(color.g(nwogBoundaryColor)), int(color.b(nwogBoundaryColor))), text_size=size.small, text_color=color.white)
    table.cell(colorTable, 3, 4, str.tostring(int(color.t(nwogBoundaryColor))), text_size=size.small, text_color=color.white)

    // NDOG Colors
    table.cell(colorTable, 0, 5, "NDOG Unfilled", text_size=size.small, text_color=color.white)
    table.cell(colorTable, 1, 5, "69", text_size=size.small, text_color=color.yellow)
    table.cell(colorTable, 2, 5, str.format("R:{0} G:{1} B:{2}", int(color.r(ndogUnfilledColor)), int(color.g(ndogUnfilledColor)), int(color.b(ndogUnfilledColor))), text_size=size.small, text_color=color.white)
    table.cell(colorTable, 3, 5, str.tostring(int(color.t(ndogUnfilledColor))), text_size=size.small, text_color=color.white)

    table.cell(colorTable, 0, 6, "NDOG Filled", text_size=size.small, text_color=color.white)
    table.cell(colorTable, 1, 6, "70", text_size=size.small, text_color=color.yellow)
    table.cell(colorTable, 2, 6, str.format("R:{0} G:{1} B:{2}", int(color.r(ndogFilledColor)), int(color.g(ndogFilledColor)), int(color.b(ndogFilledColor))), text_size=size.small, text_color=color.white)
    table.cell(colorTable, 3, 6, str.tostring(int(color.t(ndogFilledColor))), text_size=size.small, text_color=color.white)

    table.cell(colorTable, 0, 7, "NDOG Divider", text_size=size.small, text_color=color.white)
    table.cell(colorTable, 1, 7, "74", text_size=size.small, text_color=color.yellow)
    table.cell(colorTable, 2, 7, str.format("R:{0} G:{1} B:{2}", int(color.r(ndogDividerColor)), int(color.g(ndogDividerColor)), int(color.b(ndogDividerColor))), text_size=size.small, text_color=color.white)
    table.cell(colorTable, 3, 7, str.tostring(int(color.t(ndogDividerColor))), text_size=size.small, text_color=color.white)

    table.cell(colorTable, 0, 8, "NDOG Boundary", text_size=size.small, text_color=color.white)
    table.cell(colorTable, 1, 8, "76", text_size=size.small, text_color=color.yellow)
    table.cell(colorTable, 2, 8, str.format("R:{0} G:{1} B:{2}", int(color.r(ndogBoundaryColor)), int(color.g(ndogBoundaryColor)), int(color.b(ndogBoundaryColor))), text_size=size.small, text_color=color.white)
    table.cell(colorTable, 3, 8, str.tostring(int(color.t(ndogBoundaryColor))), text_size=size.small, text_color=color.white)

    // RTH Colors
    table.cell(colorTable, 0, 9, "RTH Unfilled", text_size=size.small, text_color=color.white)
