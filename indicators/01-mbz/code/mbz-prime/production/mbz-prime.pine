DEFAULT_CUSTOM_THRESHOLD = 50.0

// Input Validation Constants
MIN_THRESHOLD_PERCENT = 1.0
MAX_THRESHOLD_PERCENT = 99.0
DEFAULT_STEP_SIZE = 0.1

// Liquidity Limits System Defaults
DEFAULT_MAX_LIQUIDITY_MBZS = 30  // Default liquidity quota
MAX_LIQUIDITY_MBZS_LIMIT = 60    // Max limit for liquidity MBZs
DEFAULT_MAX_INVALIDATED_MBZS = 30
MAX_INVALIDATED_MBZS_LIMIT = 30

// Invalidation Thresholds
STANDARD_INVALIDATION_PERCENT = 100.0
CONSERVATIVE_INVALIDATION_PERCENT = 85.0
STRICT_INVALIDATION_PERCENT = 55.0

// Invalidation threshold display
