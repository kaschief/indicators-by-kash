        if in_premarket_session
            // Update extremes during session (handles both start bar after reset and continuation bars)
            liquidity_pool_update_current_extremes(premarket_session_pool, high, low, time, bar_index)

        // Always mark breaches (both during and after session)
        premarket_breach := liquidity_pool_mark_breaches(premarket_session_pool, high, low, time)
else if barstate.isnew
    liquidity_pool_clear_current(premarket_session_pool)

// 4-hour timeframe liquidity pool tracking
if enable_4h_liquidity_tracking and enable_4h_liquidity and (show_source_origins or liquidity_detection_enabled)
    if barstate.isnew and timeframe.change(TF_PERIOD_4H)
        liquidity_pool_finalize_session(four_hour_pool, nz(time[1], time), FOUR_HOUR_LIQUIDITY_SCAN_CAP)
        liquidity_pool_reset_current(four_hour_pool, high, low, time, bar_index)
    else
        liquidity_pool_update_current_extremes(four_hour_pool, high, low, time, bar_index)
    four_hour_breach := liquidity_pool_mark_breaches(four_hour_pool, high, low, time)
else if barstate.isnew
    liquidity_pool_clear_current(four_hour_pool)

// 1-hour timeframe liquidity pool tracking
if enable_1h_liquidity_tracking and enable_1h_liquidity and (show_source_origins or liquidity_detection_enabled)
    if barstate.isnew and timeframe.change(TF_PERIOD_1H)
        liquidity_pool_finalize_session(one_hour_pool, nz(time[1], time), ONE_HOUR_LIQUIDITY_SCAN_CAP)
        liquidity_pool_reset_current(one_hour_pool, high, low, time, bar_index)
    else
        liquidity_pool_update_current_extremes(one_hour_pool, high, low, time, bar_index)
    one_hour_breach := liquidity_pool_mark_breaches(one_hour_pool, high, low, time)
else if barstate.isnew
    liquidity_pool_clear_current(one_hour_pool)

// 15-minute timeframe liquidity pool tracking
if enable_15m_liquidity_tracking and enable_15m_liquidity and (show_source_origins or liquidity_detection_enabled)
    if barstate.isnew and timeframe.change(TF_PERIOD_15M)
        liquidity_pool_finalize_session(fifteen_min_pool, nz(time[1], time), FIFTEEN_MIN_LIQUIDITY_SCAN_CAP)
        liquidity_pool_reset_current(fifteen_min_pool, high, low, time, bar_index)
    else
        liquidity_pool_update_current_extremes(fifteen_min_pool, high, low, time, bar_index)
    fifteen_min_breach := liquidity_pool_mark_breaches(fifteen_min_pool, high, low, time)
else if barstate.isnew
    liquidity_pool_clear_current(fifteen_min_pool)

// ═══════════════════════════════════════════════════════════════════════════════
// LIQUIDITY MBZ DETECTION
// ═══════════════════════════════════════════════════════════════════════════════
if liquidity_detection_enabled
    has_previous_bar = not na(open[1]) and not na(close[1])
    if has_previous_bar
        a_open = open[1]
        a_close = close[1]
        a_high = high[1]
        a_low = low[1]
        a_midpoint = (a_open + a_close) / 2.0

        b_open = open
        b_close = close
        b_high = high
        b_low = low

        // Simple fixed scan caps (liquidity pools are much smaller than imbalance scans)
        daily_scan_cap = DAILY_LIQUIDITY_SCAN_CAP
        weekly_scan_cap = WEEKLY_LIQUIDITY_SCAN_CAP
        monthly_scan_cap = MONTHLY_LIQUIDITY_SCAN_CAP
        asia_scan_cap = ASIA_LIQUIDITY_SCAN_CAP
        london_scan_cap = LONDON_LIQUIDITY_SCAN_CAP
        nyam_scan_cap = NYAM_LIQUIDITY_SCAN_CAP
        lunch_scan_cap = LUNCH_LIQUIDITY_SCAN_CAP
        nypm_scan_cap = NYPM_LIQUIDITY_SCAN_CAP
        ons_scan_cap = ONS_LIQUIDITY_SCAN_CAP
        premarket_scan_cap = PREMARKET_LIQUIDITY_SCAN_CAP

        // Process DAILY liquidity pool (if enabled and not skipping Sunday)
        if enable_daily_liquidity and not skip_sunday_liquidity
            [daily_events_is_high, daily_events_rules, daily_events_is_exact, daily_events_source_price, daily_events_source_bar_index, daily_events_sct, daily_events_lt] = process_liquidity_pool(daily_liquidity_pool, LIQUIDITY_SOURCE_TYPE_DAILY, daily_scan_cap, daily_breach or daily_breach_prev, enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

            if process_liquidity_events(daily_events_is_high, daily_events_rules, daily_events_is_exact, daily_events_source_price, daily_events_source_bar_index, daily_events_sct, daily_events_lt, LIQUIDITY_SOURCE_TYPE_DAILY, daily_liquidity_pool, bar_index, b_open, b_high, b_low, b_close)
                needs_visual_update := true

        // Process WEEKLY liquidity pool (if enabled)
        if enable_weekly_liquidity
            [weekly_events_is_high, weekly_events_rules, weekly_events_is_exact, weekly_events_source_price, weekly_events_source_bar_index, weekly_events_sct, weekly_events_lt] = process_liquidity_pool(weekly_liquidity_pool, LIQUIDITY_SOURCE_TYPE_WEEKLY, weekly_scan_cap, weekly_breach or weekly_breach_prev, enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

            if process_liquidity_events(weekly_events_is_high, weekly_events_rules, weekly_events_is_exact, weekly_events_source_price, weekly_events_source_bar_index, weekly_events_sct, weekly_events_lt, LIQUIDITY_SOURCE_TYPE_WEEKLY, weekly_liquidity_pool, bar_index, b_open, b_high, b_low, b_close)
                needs_visual_update := true

        // Process MONTHLY liquidity pool (if enabled)
        if enable_monthly_liquidity
            [monthly_events_is_high, monthly_events_rules, monthly_events_is_exact, monthly_events_source_price, monthly_events_source_bar_index, monthly_events_sct, monthly_events_lt] = process_liquidity_pool(monthly_liquidity_pool, LIQUIDITY_SOURCE_TYPE_MONTHLY, monthly_scan_cap, monthly_breach or monthly_breach_prev, enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

            if process_liquidity_events(monthly_events_is_high, monthly_events_rules, monthly_events_is_exact, monthly_events_source_price, monthly_events_source_bar_index, monthly_events_sct, monthly_events_lt, LIQUIDITY_SOURCE_TYPE_MONTHLY, monthly_liquidity_pool, bar_index, b_open, b_high, b_low, b_close)
                needs_visual_update := true

        if enable_asia_liquidity and not skip_sunday_liquidity
            [asia_events_is_high, asia_events_rules, asia_events_is_exact, asia_events_source_price, asia_events_source_bar_index, asia_events_sct, asia_events_lt] = process_liquidity_pool(asia_session_pool, LIQUIDITY_SOURCE_TYPE_ASIA, asia_scan_cap, asia_breach or asia_breach_prev, enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

            asia_token = nine_times_mode == NINE_MODE_NINE_ONLY ? LIQUIDITY_SOURCE_TYPE_ASIA_NINE : LIQUIDITY_SOURCE_TYPE_ASIA
            if process_liquidity_events(asia_events_is_high, asia_events_rules, asia_events_is_exact, asia_events_source_price, asia_events_source_bar_index, asia_events_sct, asia_events_lt, asia_token, asia_session_pool, bar_index, b_open, b_high, b_low, b_close)
                needs_visual_update := true

        // Asia NINE variant pool processing (Both mode)
        if enable_nine_variants and enable_asia_liquidity and not skip_sunday_liquidity
            [asia_nine_events_is_high, asia_nine_events_rules, asia_nine_events_is_exact, asia_nine_events_source_price, asia_nine_events_source_bar_index, asia_nine_events_sct, asia_nine_events_lt] = process_liquidity_pool(asia_nine_pool, LIQUIDITY_SOURCE_TYPE_ASIA_NINE, asia_scan_cap, asia_nine_breach or asia_nine_breach_prev, enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

