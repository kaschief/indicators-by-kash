                         b_open,
                         b_high,
                         b_low,
                         b_close,
                         dtt_source,            // Source in "dtt: sessionname" format
                         pool_boundary,
                         event_rule,
                         event_source_price,
                         event_source_bar_index,
                         is_bullish_event,
                         dtt_source,            // Origin also shows DTT session
                         event_is_exact,
                         dtt_dummy_pool,        // Pass dummy pool (DTT doesn't use pool collection)
                         event_is_high
                     )

                    needs_visual_update := true

// PERFORMANCE OPTIMIZATION: Skip historical processing for instant loading
if ENABLE_HISTORICAL_BACKFILL and not initialized and barstate.islastconfirmedhistory
    // Historical backfill processing would go here (currently disabled)
    initialized := true
else if not initialized
    // Skip historical processing - start fresh for instant loading
    initialized := true

// PERFORMANCE: Aggressive garbage collection of invalidated MBZs
// Philosophy: Invalidated MBZs are for display/analysis only (use replay mode for deep inspection)
// Keep ONLY what user wants to display, delete everything else immediately (free capacity for active MBZs)
// OPTIMIZATION: Only run on live bars or end of history (skip during historical load for speed)
should_run_garbage_collection = barstate.islastconfirmedhistory or barstate.islast
if should_run_garbage_collection and array.size(all_mbz_records) > 0
    invalidated_count = 0
    invalidated_indices = array.new_int()

    // Count invalidated MBZs and track their indices (oldest first)
    for i = 0 to array.size(all_mbz_records) - 1
        if array.get(all_mbz_records, i).is_invalidated
            invalidated_count += 1
            array.push(invalidated_indices, i)

    // Determine how many invalidated to keep
    // If "Show Invalidated" is OFF: keep 0 (delete all)
    // If "Show Invalidated" is ON: keep max_invalidated_mbzs (user's display quota)
    keep_invalidated = show_invalidated_mbzs ? max_invalidated_mbzs_effective : 0
    excess_invalidated = invalidated_count - keep_invalidated

    if excess_invalidated > 0
        // AGGRESSIVE: Delete ALL excess invalidated MBZs (free capacity immediately)
        removed = 0
        for idx = 0 to array.size(invalidated_indices) - 1
            if removed >= excess_invalidated
                break

            invalidated_idx = array.get(invalidated_indices, idx)
            adjusted_idx = invalidated_idx - removed  // Adjust for previous removals
            array.remove(all_mbz_records, adjusted_idx)

            // Also remove from active array if somehow still there
            if adjusted_idx < array.size(active_mbz_records)
                mbz_in_active = array.get(active_mbz_records, adjusted_idx)
                if mbz_in_active.is_invalidated
                    array.remove(active_mbz_records, adjusted_idx)

            removed += 1

// Clean up old records and visual elements
while array.size(all_mbz_records) > max_mbz_records_effective
    oldest_record = array.get(all_mbz_records, 0)  // Get before removing
    array.shift(all_mbz_records)

    // PERFORMANCE: Also remove from active array if it's still there (not invalidated yet)
    if not oldest_record.is_invalidated
        for active_idx = 0 to array.size(active_mbz_records) - 1
            active_rec = array.get(active_mbz_records, active_idx)
            if active_rec.bar_index == oldest_record.bar_index and
               active_rec.source_type == oldest_record.source_type and
               active_rec.is_bullish == oldest_record.is_bullish
                array.remove(active_mbz_records, active_idx)
                break

while array.size(mbz_body_highlights) > max_body_highlights_effective
    box.delete(array.shift(mbz_body_highlights))

while array.size(mbz_wick_highlights) > max_wick_highlights_effective
    box.delete(array.shift(mbz_wick_highlights))

while array.size(mbz_extended_boxes) > max_extended_boxes_effective
    box.delete(array.shift(mbz_extended_boxes))

// PERFORMANCE OPTIMIZED: Only check active (non-invalidated) MBZs
// This avoids wasting checks on already-invalidated records every bar
// CRITICAL OPTIMIZATION: Always sync invalidations (required for display), but skip confirmation status syncs during history
should_sync_confirmation_status = barstate.islastconfirmedhistory or barstate.islast
if array.size(active_mbz_records) > 0
    for i = array.size(active_mbz_records) - 1 to 0
        mbz_record = array.get(active_mbz_records, i)

        // Update confirmation status first
        updated_mbz = check_mbz_confirmation(mbz_record)
        // Check for invalidation using enhanced source detection
        should_invalidate = should_mbz_be_invalidated_enhanced(updated_mbz, open, close)

        if should_invalidate
            updated_mbz.is_invalidated := true
            updated_mbz.cached_data_valid := false  // Invalidate cache
            needs_visual_update := true

            // Update in active array
            array.set(active_mbz_records, i, updated_mbz)

            // ALWAYS sync invalidations to all_mbz_records (required for correct display)
            // Find and update in all_mbz_records
            for all_idx = 0 to array.size(all_mbz_records) - 1
                all_rec = array.get(all_mbz_records, all_idx)
                if all_rec.bar_index == updated_mbz.bar_index and
                   all_rec.source_type == updated_mbz.source_type and
                   all_rec.is_bullish == updated_mbz.is_bullish and
                   not all_rec.is_invalidated
                    array.set(all_mbz_records, all_idx, updated_mbz)
                    break

            // Remove from active array (no longer needs invalidation checks)
            array.remove(active_mbz_records, i)
        else
            // Still active, just update confirmation status in active array
            array.set(active_mbz_records, i, updated_mbz)

            // PERFORMANCE: Only sync confirmation status during display (not every bar during history)
            // This saves millions of comparisons without affecting display accuracy
            if should_sync_confirmation_status
                // Update in all_mbz_records as well
                for all_idx = 0 to array.size(all_mbz_records) - 1
                    all_rec = array.get(all_mbz_records, all_idx)
                    if all_rec.bar_index == updated_mbz.bar_index and
                       all_rec.source_type == updated_mbz.source_type and
                       all_rec.is_bullish == updated_mbz.is_bullish
                        array.set(all_mbz_records, all_idx, updated_mbz)
                        break

if not na(liquidity_variant_placeholder_label)
    label.delete(liquidity_variant_placeholder_label)
    liquidity_variant_placeholder_label := na

// ═══════════════════════════════════════════════════════════════════════════════
// VISUAL MANAGEMENT - CONSOLIDATED SYSTEM // ═══════════════════════════════════════════════════════════════════════════════

// PERFORMANCE OPTIMIZED: Smart visual update system - only when truly necessary
// Defer visual updates during historical load (fast initial render: 5-10x faster)
// Update only at: end of history (islastconfirmedhistory), live bars, or full update requests
should_update_visuals = needs_full_update or barstate.islastconfirmedhistory or (barstate.islast and (needs_visual_update or bar_index != last_update_bar))

if should_update_visuals
    [debug_examined, debug_liq_added, debug_daily_added, debug_weekly_added, debug_monthly_added, debug_asia_added, debug_rejected] = manage_consolidated_mbz_display()

    // PROFILING: Track display results after function completes
    if show_profiling
        profile_total_records_examined := debug_examined
        profile_liquidity_records_added := debug_liq_added
        profile_daily_liq_added := debug_daily_added
        profile_weekly_liq_added := debug_weekly_added
        profile_monthly_liq_added := debug_monthly_added
        profile_asia_liq_added := debug_asia_added
        profile_rejected_by_should_display := debug_rejected
        profile_records_consolidated := array.size(last_consolidated_mbzs)

        // Count totals in all_mbz_records
        profile_daily_liq_total := 0
        profile_weekly_liq_total := 0
        profile_monthly_liq_total := 0
        profile_asia_liq_total := 0
        profile_london_liq_total := 0
        profile_daily_liq_invalidated := 0
        profile_weekly_liq_invalidated := 0
        profile_monthly_liq_invalidated := 0
        profile_asia_liq_invalidated := 0
        profile_london_liq_invalidated := 0
        profile_weekly_rejected_direction := 0
        profile_weekly_rejected_display := 0
        if array.size(all_mbz_records) > 0
            for rec_idx = 0 to array.size(all_mbz_records) - 1
                rec = array.get(all_mbz_records, rec_idx)

                // Skip MBZs too old to render (same limit as rendering loop)
                rec_bars_ago = bar_index - rec.bar_index
                if rec_bars_ago >= MAX_RENDERABLE_BAR_AGE
                    continue

                if rec.source_family == SOURCE_FAMILY_LIQUIDITY
                    if rec.source_origin_token == LIQUIDITY_SOURCE_TYPE_DAILY
                        profile_daily_liq_total += 1
                        if rec.is_invalidated
                            profile_daily_liq_invalidated += 1
                    else if rec.source_origin_token == LIQUIDITY_SOURCE_TYPE_WEEKLY
                        profile_weekly_liq_total += 1
                        if rec.is_invalidated
                            profile_weekly_liq_invalidated += 1
                        // Check filters that would reject this weekly MBZ (liquidity-only mode)
                        if not rec.is_invalidated
                            if not should_display_mbz_direction(rec)
                                profile_weekly_rejected_direction += 1
                            else if not should_display_mbz(rec)
                                profile_weekly_rejected_display += 1
                    else if rec.source_origin_token == LIQUIDITY_SOURCE_TYPE_MONTHLY
                        profile_monthly_liq_total += 1
                        if rec.is_invalidated
                            profile_monthly_liq_invalidated += 1
                    else if rec.source_origin_token == LIQUIDITY_SOURCE_TYPE_ASIA or rec.source_origin_token == LIQUIDITY_SOURCE_TYPE_ASIA_NINE
                        profile_asia_liq_total += 1
                        if rec.is_invalidated
                            profile_asia_liq_invalidated += 1
                    else if rec.source_origin_token == LIQUIDITY_SOURCE_TYPE_LONDON or rec.source_origin_token == LIQUIDITY_SOURCE_TYPE_LONDON_NINE
                        profile_london_liq_total += 1
                        if rec.is_invalidated
                            profile_london_liq_invalidated += 1
                    else if rec.source_origin_token == LIQUIDITY_SOURCE_TYPE_NYAM or rec.source_origin_token == LIQUIDITY_SOURCE_TYPE_NYAM_NINE
                        profile_nyam_liq_total += 1
                        if rec.is_invalidated
                            profile_nyam_liq_invalidated += 1
                    else if rec.source_origin_token == LIQUIDITY_SOURCE_TYPE_LUNCH
                        profile_lunch_liq_total += 1
                        if rec.is_invalidated
                            profile_lunch_liq_invalidated += 1
                    else if rec.source_origin_token == LIQUIDITY_SOURCE_TYPE_NYPM or rec.source_origin_token == LIQUIDITY_SOURCE_TYPE_NYPM_NINE
                        profile_nypm_liq_total += 1
                        if rec.is_invalidated
                            profile_nypm_liq_invalidated += 1
                    else if rec.source_origin_token == LIQUIDITY_SOURCE_TYPE_ONS
                        profile_ons_liq_total += 1
                        if rec.is_invalidated
                            profile_ons_liq_invalidated += 1
                    else if str.startswith(rec.source_type, "dtt: ")
                        profile_dtt_liq_total += 1
                        if rec.is_invalidated
                            profile_dtt_liq_invalidated += 1

        // Pool sessions
        profile_daily_sessions := liquidity_pool_session_count(daily_liquidity_pool)
        profile_weekly_sessions := liquidity_pool_session_count(weekly_liquidity_pool)
        profile_monthly_sessions := liquidity_pool_session_count(monthly_liquidity_pool)
        profile_asia_sessions := liquidity_pool_session_count(asia_session_pool)
        profile_london_sessions := liquidity_pool_session_count(london_session_pool)
        profile_nyam_sessions := liquidity_pool_session_count(nyam_session_pool)
        profile_lunch_sessions := liquidity_pool_session_count(lunch_session_pool)
        profile_nypm_sessions := liquidity_pool_session_count(nypm_session_pool)
        profile_ons_sessions := liquidity_pool_session_count(ons_session_pool)
        profile_dtt_sessions := array.size(dtt_session_instances)

    last_update_bar := bar_index
    needs_full_update := false
    needs_visual_update := false


// ═══════════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.isconfirmed
    array.clear(mbz_alert_parts)

    if array.size(last_consolidated_mbzs) > 0
        for i = 0 to array.size(last_consolidated_mbzs) - 1
            consolidated_mbz = array.get(last_consolidated_mbzs, i)
            if consolidated_mbz.bar_index == bar_index
                alert_msg = build_alert_message_from_consolidated(consolidated_mbz)
                array.push(mbz_alert_parts, alert_msg)

    mbz_grouped_alert_active := array.size(mbz_alert_parts) > 0

    if mbz_grouped_alert_active
        alert_message = ""
        tf = str.tostring(timeframe.period)

        for i = 0 to array.size(mbz_alert_parts) - 1
            if i > 0
                alert_message := alert_message + " | "
            alert_message := alert_message + array.get(mbz_alert_parts, i)

        alert(alert_message + " • " + tf)

// ═══════════════════════════════════════════════════════════════════════════════
// PERFORMANCE PROFILING TABLE
// ═══════════════════════════════════════════════════════════════════════════════
if show_profiling
    // Count active liquidity pools (enabled by user AND available on current timeframe)
    active_daily = enable_daily_liquidity and enable_daily_liquidity_tracking
    active_weekly = enable_weekly_liquidity and enable_weekly_liquidity_tracking
    active_monthly = enable_monthly_liquidity and enable_monthly_liquidity_tracking
    active_asia = enable_asia_liquidity and enable_asia_liquidity_tracking
    active_london = enable_london_liquidity and enable_london_liquidity_tracking
    active_nyam = enable_nyam_liquidity and enable_nyam_liquidity_tracking
    active_lunch = actual_enable_lunch and enable_lunch_liquidity_tracking
    active_nypm = enable_nypm_liquidity and enable_nypm_liquidity_tracking
    active_ons = enable_ons_liquidity and enable_ons_liquidity_tracking
    active_dtt = enable_dtt_sessions and enable_dtt_liquidity_tracking

    active_pool_count = 0
    if active_daily
        active_pool_count += 1
    if active_weekly
        active_pool_count += 1
    if active_monthly
        active_pool_count += 1
    if active_asia
        active_pool_count += 1
    if active_london
        active_pool_count += 1
    if active_nyam
        active_pool_count += 1
    if active_lunch
        active_pool_count += 1
    if active_nypm
        active_pool_count += 1
    if active_ons
        active_pool_count += 1
    if active_dtt
        active_pool_count += 1

    // Recreate table if size changed (due to TF change or user toggling pools)
    if not na(profiling_table)
        table.delete(profiling_table)

    // Compact mode: Only show time mode
    if profiling_mode == "Compact"
        profiling_table := table.new(position.top_right, 1, 1, bgcolor=profiling_table_bg_color, border_width=1, border_color=color.white)
        cached_table_size = get_profiling_table_size()
        time_mode_text = nine_times_mode == NINE_MODE_NINE_ONLY ? "NINE'S" : (nine_times_mode == NINE_MODE_BOTH ? "STANDARD + NINE" : "STANDARD")
        table.cell(profiling_table, 0, 0, time_mode_text, text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=cached_table_size)
    else
        // Full mode: Calculate dynamic table height: 1 header + N pools + 1 spacer + 5 summary rows (Tot Recs, Active, Rejected, Asset, Time Mode)
        table_rows = 1 + active_pool_count + 1 + 5
        profiling_table := table.new(position.top_right, 5, table_rows, bgcolor=profiling_table_bg_color, border_width=1, border_color=color.white)

        // Cache text size (called 71 times in this block)
        cached_table_size = get_profiling_table_size()

        // Header Row (always row 0)
        table.cell(profiling_table, 0, 0, "Pool", text_color=profiling_header_text_color, bgcolor=profiling_header_bg_color, text_size=cached_table_size)
        table.cell(profiling_table, 1, 0, "Tot", text_color=profiling_header_text_color, bgcolor=profiling_header_bg_color, text_size=cached_table_size)
        table.cell(profiling_table, 2, 0, "Vis", text_color=profiling_header_text_color, bgcolor=profiling_header_bg_color, text_size=cached_table_size)
        table.cell(profiling_table, 3, 0, "Inv", text_color=profiling_header_text_color, bgcolor=profiling_header_bg_color, text_size=cached_table_size)
        table.cell(profiling_table, 4, 0, "Sess", text_color=profiling_header_text_color, bgcolor=profiling_header_bg_color, text_size=cached_table_size)

        // Dynamic pool rows (only show active pools)
        current_row = 1

        // Daily
        if active_daily
            table.cell(profiling_table, 0, current_row, LIQUIDITY_SOURCE_TYPE_DAILY, text_color=color.white, text_size=cached_table_size)
            table.cell(profiling_table, 1, current_row, str.tostring(profile_daily_liq_total), text_color=color.aqua, text_size=cached_table_size)
            table.cell(profiling_table, 2, current_row, str.tostring(profile_daily_liq_added), text_color=color.lime, text_size=cached_table_size)
            table.cell(profiling_table, 3, current_row, str.tostring(profile_daily_liq_invalidated), text_color=color.orange, text_size=cached_table_size)
            table.cell(profiling_table, 4, current_row, str.tostring(profile_daily_sessions), text_color=color.yellow, text_size=cached_table_size)
            current_row += 1

        // Weekly
        if active_weekly
            table.cell(profiling_table, 0, current_row, LIQUIDITY_SOURCE_TYPE_WEEKLY, text_color=color.white, text_size=cached_table_size)
            table.cell(profiling_table, 1, current_row, str.tostring(profile_weekly_liq_total), text_color=color.aqua, text_size=cached_table_size)
            table.cell(profiling_table, 2, current_row, str.tostring(profile_weekly_liq_added), text_color=color.lime, text_size=cached_table_size)
            table.cell(profiling_table, 3, current_row, str.tostring(profile_weekly_liq_invalidated), text_color=color.orange, text_size=cached_table_size)
            table.cell(profiling_table, 4, current_row, str.tostring(profile_weekly_sessions), text_color=color.yellow, text_size=cached_table_size)
            current_row += 1

        // Monthly
        if active_monthly
            table.cell(profiling_table, 0, current_row, LIQUIDITY_SOURCE_TYPE_MONTHLY, text_color=color.white, text_size=cached_table_size)
            table.cell(profiling_table, 1, current_row, str.tostring(profile_monthly_liq_total), text_color=color.aqua, text_size=cached_table_size)
            table.cell(profiling_table, 2, current_row, str.tostring(profile_monthly_liq_added), text_color=color.lime, text_size=cached_table_size)
            table.cell(profiling_table, 3, current_row, str.tostring(profile_monthly_liq_invalidated), text_color=color.orange, text_size=cached_table_size)
            table.cell(profiling_table, 4, current_row, str.tostring(profile_monthly_sessions), text_color=color.yellow, text_size=cached_table_size)
            current_row += 1

        // Asia
        if active_asia
            table.cell(profiling_table, 0, current_row, LIQUIDITY_SOURCE_TYPE_ASIA, text_color=color.white, text_size=cached_table_size)
            table.cell(profiling_table, 1, current_row, str.tostring(profile_asia_liq_total), text_color=color.aqua, text_size=cached_table_size)
            table.cell(profiling_table, 2, current_row, str.tostring(profile_asia_liq_added), text_color=color.lime, text_size=cached_table_size)
            table.cell(profiling_table, 3, current_row, str.tostring(profile_asia_liq_invalidated), text_color=color.orange, text_size=cached_table_size)
            table.cell(profiling_table, 4, current_row, str.tostring(profile_asia_sessions), text_color=color.yellow, text_size=cached_table_size)
            current_row += 1

        // London
        if active_london
            table.cell(profiling_table, 0, current_row, LIQUIDITY_SOURCE_TYPE_LONDON, text_color=color.white, text_size=cached_table_size)
            table.cell(profiling_table, 1, current_row, str.tostring(profile_london_liq_total), text_color=color.aqua, text_size=cached_table_size)
            table.cell(profiling_table, 2, current_row, str.tostring(profile_london_liq_added), text_color=color.lime, text_size=cached_table_size)
            table.cell(profiling_table, 3, current_row, str.tostring(profile_london_liq_invalidated), text_color=color.orange, text_size=cached_table_size)
            table.cell(profiling_table, 4, current_row, str.tostring(profile_london_sessions), text_color=color.yellow, text_size=cached_table_size)
            current_row += 1

        // NY AM
        if active_nyam
            table.cell(profiling_table, 0, current_row, LIQUIDITY_SOURCE_TYPE_NYAM, text_color=color.white, text_size=cached_table_size)
            table.cell(profiling_table, 1, current_row, str.tostring(profile_nyam_liq_total), text_color=color.aqua, text_size=cached_table_size)
            table.cell(profiling_table, 2, current_row, str.tostring(profile_nyam_liq_added), text_color=color.lime, text_size=cached_table_size)
            table.cell(profiling_table, 3, current_row, str.tostring(profile_nyam_liq_invalidated), text_color=color.orange, text_size=cached_table_size)
            table.cell(profiling_table, 4, current_row, str.tostring(profile_nyam_sessions), text_color=color.yellow, text_size=cached_table_size)
            current_row += 1

        // Lunch
        if active_lunch
            table.cell(profiling_table, 0, current_row, LIQUIDITY_SOURCE_TYPE_LUNCH, text_color=color.white, text_size=cached_table_size)
            table.cell(profiling_table, 1, current_row, str.tostring(profile_lunch_liq_total), text_color=color.aqua, text_size=cached_table_size)
            table.cell(profiling_table, 2, current_row, str.tostring(profile_lunch_liq_added), text_color=color.lime, text_size=cached_table_size)
            table.cell(profiling_table, 3, current_row, str.tostring(profile_lunch_liq_invalidated), text_color=color.orange, text_size=cached_table_size)
            table.cell(profiling_table, 4, current_row, str.tostring(profile_lunch_sessions), text_color=color.yellow, text_size=cached_table_size)
            current_row += 1

        // NY PM
        if active_nypm
            table.cell(profiling_table, 0, current_row, LIQUIDITY_SOURCE_TYPE_NYPM, text_color=color.white, text_size=cached_table_size)
            table.cell(profiling_table, 1, current_row, str.tostring(profile_nypm_liq_total), text_color=color.aqua, text_size=cached_table_size)
            table.cell(profiling_table, 2, current_row, str.tostring(profile_nypm_liq_added), text_color=color.lime, text_size=cached_table_size)
            table.cell(profiling_table, 3, current_row, str.tostring(profile_nypm_liq_invalidated), text_color=color.orange, text_size=cached_table_size)
            table.cell(profiling_table, 4, current_row, str.tostring(profile_nypm_sessions), text_color=color.yellow, text_size=cached_table_size)
            current_row += 1

        // ONS
        if active_ons
            table.cell(profiling_table, 0, current_row, LIQUIDITY_SOURCE_TYPE_ONS, text_color=color.white, text_size=cached_table_size)
            table.cell(profiling_table, 1, current_row, str.tostring(profile_ons_liq_total), text_color=color.aqua, text_size=cached_table_size)
            table.cell(profiling_table, 2, current_row, str.tostring(profile_ons_liq_added), text_color=color.lime, text_size=cached_table_size)
            table.cell(profiling_table, 3, current_row, str.tostring(profile_ons_liq_invalidated), text_color=color.orange, text_size=cached_table_size)
            table.cell(profiling_table, 4, current_row, str.tostring(profile_ons_sessions), text_color=color.yellow, text_size=cached_table_size)
            current_row += 1

        // DTT
        if active_dtt
            table.cell(profiling_table, 0, current_row, "dtt", text_color=color.white, text_size=cached_table_size)
            table.cell(profiling_table, 1, current_row, str.tostring(profile_dtt_liq_total), text_color=color.aqua, text_size=cached_table_size)
            table.cell(profiling_table, 2, current_row, str.tostring(profile_dtt_liq_added), text_color=color.lime, text_size=cached_table_size)
            table.cell(profiling_table, 3, current_row, str.tostring(profile_dtt_liq_invalidated), text_color=color.orange, text_size=cached_table_size)
            table.cell(profiling_table, 4, current_row, str.tostring(profile_dtt_sessions), text_color=color.yellow, text_size=cached_table_size)
            current_row += 1

        // Spacer
        table.cell(profiling_table, 0, current_row, "", text_color=color.white, text_size=cached_table_size)
        table.cell(profiling_table, 1, current_row, "", text_color=color.white, text_size=cached_table_size)
        table.cell(profiling_table, 2, current_row, "", text_color=color.white, text_size=cached_table_size)
        table.cell(profiling_table, 3, current_row, "", text_color=color.white, text_size=cached_table_size)
        table.cell(profiling_table, 4, current_row, "", text_color=color.white, text_size=cached_table_size)
        current_row += 1

        // Summary Metrics
        table.cell(profiling_table, 0, current_row, "Tot Recs", text_color=color.white, text_size=cached_table_size)
        table.cell(profiling_table, 1, current_row, str.tostring(array.size(all_mbz_records)), text_color=color.aqua, text_size=cached_table_size)
        table.cell(profiling_table, 2, current_row, "Max Liq", text_color=color.white, text_size=cached_table_size)
        table.cell(profiling_table, 3, current_row, str.tostring(max_liquidity_mbzs), text_color=color.yellow, text_size=cached_table_size)
        table.cell(profiling_table, 4, current_row, "", text_color=color.white, text_size=cached_table_size)
        current_row += 1

        table.cell(profiling_table, 0, current_row, "Active", text_color=color.white, bgcolor=color.new(color.green, 30), text_size=cached_table_size)
        table.cell(profiling_table, 1, current_row, str.tostring(profile_liquidity_records_added), text_color=color.lime, bgcolor=color.new(color.green, 30), text_size=cached_table_size)
        table.cell(profiling_table, 2, current_row, "Examined", text_color=color.white, text_size=cached_table_size)
        table.cell(profiling_table, 3, current_row, str.tostring(profile_total_records_examined), text_color=color.aqua, text_size=cached_table_size)
        table.cell(profiling_table, 4, current_row, "", text_color=color.white, text_size=cached_table_size)
        current_row += 1

        table.cell(profiling_table, 0, current_row, "Rejected", text_color=color.white, text_size=cached_table_size)
        table.cell(profiling_table, 1, current_row, str.tostring(profile_rejected_by_should_display), text_color=color.red, text_size=cached_table_size)
        table.cell(profiling_table, 2, current_row, "Groups", text_color=color.white, text_size=cached_table_size)
        table.cell(profiling_table, 3, current_row, str.tostring(profile_records_consolidated), text_color=color.aqua, text_size=cached_table_size)
        table.cell(profiling_table, 4, current_row, "", text_color=color.white, text_size=cached_table_size)
        current_row += 1

        // Asset Type Detection
        asset_type_label = is_247_asset ? "24/7" : "Mon-Fri"
        asset_type_color = is_247_asset ? color.new(color.green, 30) : color.new(color.blue, 30)
        table.cell(profiling_table, 0, current_row, "Asset", text_color=color.white, text_size=cached_table_size)
        table.cell(profiling_table, 1, current_row, asset_type_label, text_color=color.white, bgcolor=asset_type_color, text_size=cached_table_size)
        table.cell(profiling_table, 2, current_row, "Detected", text_color=color.white, text_size=cached_table_size)
        table.cell(profiling_table, 3, current_row, detection_completed ? "✓" : "...", text_color=detection_completed ? color.lime : color.yellow, text_size=cached_table_size)
        table.cell(profiling_table, 4, current_row, "", text_color=color.white, text_size=cached_table_size)
        current_row += 1

        // Time Mode footer
        time_mode_text = nine_times_mode == NINE_MODE_NINE_ONLY ? "Time Mode: NINE'S" : (nine_times_mode == NINE_MODE_BOTH ? "Time Mode: STANDARD + NINE" : "Time Mode: STANDARD")
        table.cell(profiling_table, 0, current_row, time_mode_text, text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=cached_table_size)
        table.merge_cells(profiling_table, 0, current_row, 4, current_row)


// MBZ Prime° [Pro+] Optimised
