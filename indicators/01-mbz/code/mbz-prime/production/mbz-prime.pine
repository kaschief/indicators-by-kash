            if process_liquidity_events(nypm_events_is_high, nypm_events_rules, nypm_events_is_exact, nypm_events_source_price, nypm_events_source_bar_index, nypm_events_sct, nypm_events_lt, nypm_token, nypm_session_pool, bar_index, b_open, b_high, b_low, b_close)
