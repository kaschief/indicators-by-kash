                needs_visual_update := true

        // NY AM NINE variant pool processing (Both mode)
        if enable_nine_variants and enable_nyam_liquidity and not skip_sunday_liquidity
            [nyam_nine_events_is_high, nyam_nine_events_rules, nyam_nine_events_is_exact, nyam_nine_events_source_price, nyam_nine_events_source_bar_index, nyam_nine_events_sct, nyam_nine_events_lt] = process_liquidity_pool(nyam_nine_pool, LIQUIDITY_SOURCE_TYPE_NYAM_NINE, nyam_scan_cap, nyam_nine_breach or nyam_nine_breach_prev, enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

            if process_liquidity_events(nyam_nine_events_is_high, nyam_nine_events_rules, nyam_nine_events_is_exact, nyam_nine_events_source_price, nyam_nine_events_source_bar_index, nyam_nine_events_sct, nyam_nine_events_lt, LIQUIDITY_SOURCE_TYPE_NYAM_NINE, nyam_nine_pool, bar_index, b_open, b_high, b_low, b_close)
                needs_visual_update := true

        if actual_enable_lunch and not skip_sunday_liquidity
            [lunch_events_is_high, lunch_events_rules, lunch_events_is_exact, lunch_events_source_price, lunch_events_source_bar_index, lunch_events_sct, lunch_events_lt] = process_liquidity_pool(lunch_session_pool, LIQUIDITY_SOURCE_TYPE_LUNCH, lunch_scan_cap, lunch_breach or lunch_breach_prev, enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

