            if process_liquidity_events(london_events_is_high, london_events_rules, london_events_is_exact, london_events_source_price, london_events_source_bar_index, london_events_sct, london_events_lt, london_token, london_session_pool, bar_index, b_open, b_high, b_low, b_close)
