MBZ_MINUS = "MBZ⁻"

WICK_TIER_STANDARD_DISPLAY = "Standard"
EMPTY_DISPLAY = ""

// UI Label Constants (for easy customization)
UI_LABEL_ASIA_SESSION = "Asia"
UI_LABEL_LONDON_SESSION = "London"
UI_LABEL_NYAM_SESSION = "NY AM"
UI_LABEL_LUNCH_SESSION = "Lunch"
UI_LABEL_NYPM_SESSION = "NY PM"
UI_LABEL_ONS_SESSION = "ONS"
UI_LABEL_24_7_MODE = "Enable 24/7 Mode"
UI_LABEL_NINE_TIMES = "Intraday Session Mode"

