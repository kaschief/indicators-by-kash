// @function bodyTop
// @description Calculates the top boundary of a candle body (excluding wicks)
// @param o float - open price
// @param c float - close price
// @returns float - higher of open or close (body top boundary)
bodyTop(o, c) => math.max(o, c)

// @function bodyBot
// @description Calculates the bottom boundary of a candle body (excluding wicks)
// @param o float - open price
// @param c float - close price
// @returns float - lower of open or close (body bottom boundary)
bodyBot(o, c) => math.min(o, c)

// Convert string alignment selections into Pine text alignment enums
get_horizontal_alignment(alignment_setting) =>
    alignment_setting == LABEL_ALIGNMENT_LEFT ? text.align_left : alignment_setting == LABEL_ALIGNMENT_RIGHT ? text.align_right : text.align_center

get_vertical_alignment(alignment_setting) =>
    alignment_setting == LABEL_VERTICAL_TOP ? text.align_top : alignment_setting == LABEL_VERTICAL_BOTTOM ? text.align_bottom : text.align_center

get_extension_label_halign() => get_horizontal_alignment(extension_label_horizontal_alignment)

get_extension_label_valign() => get_vertical_alignment(extension_label_vertical_alignment)

pad_two_digits(value) => value < 10 ? '0' + str.tostring(value) : str.tostring(value)

// Day of week abbreviation helper (parity with Playful)
get_day_abbreviation(time_value) =>
    switch dayofweek(time_value, NY_TIMEZONE)
        dayofweek.sunday => 'Sun'
        dayofweek.monday => 'Mon'
        dayofweek.tuesday => 'Tue'
        dayofweek.wednesday => 'Wed'
        dayofweek.thursday => 'Thu'
        dayofweek.friday => 'Fri'
        dayofweek.saturday => 'Sat'
        => ''

// Append NINE's times suffix to intraday session names when NINE Only mode is enabled
// Only affects: Asia, London, NY AM, NY PM (ONS is unaffected, Lunch is disabled)
append_nine_suffix(session_type) =>
    affected_by_nine = session_type == LIQUIDITY_SOURCE_TYPE_ASIA or session_type == LIQUIDITY_SOURCE_TYPE_LONDON or session_type == LIQUIDITY_SOURCE_TYPE_NYAM or session_type == LIQUIDITY_SOURCE_TYPE_NYPM
    nine_times_mode == NINE_MODE_NINE_ONLY and affected_by_nine ? session_type + NINE_TIMES_SUFFIX : session_type

// Format source token with count and NINE's times suffix
format_source_token_with_nine(token, count) =>
    display_token = append_nine_suffix(token)
    count <= 1 ? display_token : display_token + MULTIPLIER_SYMBOL + str.tostring(count)

build_liquidity_pool_label(pool_type, time_value) =>
    display_type = switch pool_type
        LIQUIDITY_SOURCE_TYPE_DAILY => LIQUIDITY_SOURCE_TYPE_DAILY
        LIQUIDITY_SOURCE_TYPE_WEEKLY => LIQUIDITY_SOURCE_TYPE_WEEKLY
        LIQUIDITY_SOURCE_TYPE_MONTHLY => LIQUIDITY_SOURCE_TYPE_MONTHLY
        LIQUIDITY_SOURCE_TYPE_ASIA => LIQUIDITY_SOURCE_TYPE_ASIA
        LIQUIDITY_SOURCE_TYPE_LONDON => LIQUIDITY_SOURCE_TYPE_LONDON
        LIQUIDITY_SOURCE_TYPE_NYAM => LIQUIDITY_SOURCE_TYPE_NYAM
        LIQUIDITY_SOURCE_TYPE_LUNCH => LIQUIDITY_SOURCE_TYPE_LUNCH
        LIQUIDITY_SOURCE_TYPE_NYPM => LIQUIDITY_SOURCE_TYPE_NYPM
        LIQUIDITY_SOURCE_TYPE_ONS => LIQUIDITY_SOURCE_TYPE_ONS
        LIQUIDITY_SOURCE_TYPE_PREMARKET => LIQUIDITY_SOURCE_TYPE_PREMARKET
        => pool_type
    append_nine_suffix(display_type)

create_liquidity_pool() =>
    LiquidityPoolCollection.new(
         array.new_float(),
         array.new_float(),
         array.new_int(),
         array.new_int(),
         array.new_int(),
         array.new_bool(),
         array.new_bool(),
         array.new_int(),
         array.new_int(),
         array.new_int(),
         array.new_int(),
         array.new_int(),
         array.new_int(),
         array.new_bool(),
         array.new_bool(),
         array.new_int(),
         array.new_int(),
         array.new_bool(),
         array.new_bool(),
         float(na),
         float(na),
         int(na),
         int(na),
         int(na),
         int(na),
         int(na),
         int(na),
         int(na),
         false,
         false,
         int(na),
         int(na),
         0,
         0
     )

liquidity_pool_session_count(pool) => array.size(pool.highs)

liquidity_pool_clear_current(pool) =>
    pool.current_high := na
    pool.current_low := na
    pool.current_high_time := na
    pool.current_low_time := na
    pool.current_session_start_time := na
    pool.current_high_origin_bar_index := na
    pool.current_low_origin_bar_index := na
    pool.current_high_first_breach_bar := na
    pool.current_low_first_breach_bar := na
    pool.current_high_mitigated := false
    pool.current_low_mitigated := false
    pool.current_high_mitigation_bar := na
    pool.current_low_mitigation_bar := na

liquidity_pool_reset_current(pool, highest, lowest, bar_time, bar_index_value) =>
    pool.current_high := highest
    pool.current_low := lowest
    pool.current_high_time := bar_time
    pool.current_low_time := bar_time
    pool.current_session_start_time := bar_time
    pool.current_high_origin_bar_index := bar_index_value
    pool.current_low_origin_bar_index := bar_index_value
    pool.current_high_first_breach_bar := na
    pool.current_low_first_breach_bar := na
    pool.current_high_mitigated := false
    pool.current_low_mitigated := false
    pool.current_high_mitigation_bar := na
    pool.current_low_mitigation_bar := na

liquidity_pool_update_current_extremes(pool, highest, lowest, bar_time, bar_index_value) =>
    if na(pool.current_high) or na(pool.current_low)
        liquidity_pool_reset_current(pool, highest, lowest, bar_time, bar_index_value)
    else
        if highest > pool.current_high
            pool.current_high := highest
            pool.current_high_time := bar_time
            pool.current_high_origin_bar_index := bar_index_value
            pool.current_high_first_breach_bar := na
            pool.current_high_mitigated := false
            pool.current_high_mitigation_bar := na
        if lowest < pool.current_low
            pool.current_low := lowest
            pool.current_low_time := bar_time
            pool.current_low_origin_bar_index := bar_index_value
            pool.current_low_first_breach_bar := na
            pool.current_low_mitigated := false
            pool.current_low_mitigation_bar := na

liquidity_pool_advance_high_pointer(pool) =>
    count = array.size(pool.high_breached)
    idx = math.max(0, pool.first_unbreached_high_index)
    if idx > count
        idx := count
    while idx < count and array.get(pool.high_breached, idx)
        idx += 1
    pool.first_unbreached_high_index := idx

liquidity_pool_advance_low_pointer(pool) =>
    count = array.size(pool.low_breached)
    idx = math.max(0, pool.first_unbreached_low_index)
    if idx > count
        idx := count
    while idx < count and array.get(pool.low_breached, idx)
        idx += 1
    pool.first_unbreached_low_index := idx

liquidity_pool_trim(pool, max_entries) =>
    while array.size(pool.highs) > max_entries
        array.shift(pool.highs)
        array.shift(pool.lows)
        array.shift(pool.high_times)
        array.shift(pool.low_times)
        array.shift(pool.session_close_times)
        array.shift(pool.high_breached)
        array.shift(pool.low_breached)
        array.shift(pool.high_breach_times)
        array.shift(pool.low_breach_times)
        array.shift(pool.high_origin_bar_indices)
        array.shift(pool.low_origin_bar_indices)
        array.shift(pool.high_first_breach_bars)
        array.shift(pool.low_first_breach_bars)
        array.shift(pool.high_mitigated_flags)
        array.shift(pool.low_mitigated_flags)
        array.shift(pool.high_mitigation_bars)
        array.shift(pool.low_mitigation_bars)
        array.shift(pool.high_used_by_pattern)
        array.shift(pool.low_used_by_pattern)
        pool.first_unbreached_high_index := math.max(0, pool.first_unbreached_high_index - 1)
        pool.first_unbreached_low_index := math.max(0, pool.first_unbreached_low_index - 1)

    liquidity_pool_advance_high_pointer(pool)
    liquidity_pool_advance_low_pointer(pool)

liquidity_pool_finalize_session(pool, session_close_time, max_entries) =>
    if not na(pool.current_high) and not na(pool.current_low)
        array.push(pool.highs, pool.current_high)
        array.push(pool.lows, pool.current_low)
        array.push(pool.high_times, pool.current_high_time)
        array.push(pool.low_times, pool.current_low_time)
        array.push(pool.session_close_times, session_close_time)
        array.push(pool.high_breached, false)
        array.push(pool.low_breached, false)
        array.push(pool.high_breach_times, na)
        array.push(pool.low_breach_times, na)
        array.push(pool.high_origin_bar_indices, pool.current_high_origin_bar_index)
        array.push(pool.low_origin_bar_indices, pool.current_low_origin_bar_index)
        array.push(pool.high_first_breach_bars, pool.current_high_first_breach_bar)
        array.push(pool.low_first_breach_bars, pool.current_low_first_breach_bar)
        array.push(pool.high_mitigated_flags, pool.current_high_mitigated)
        array.push(pool.low_mitigated_flags, pool.current_low_mitigated)
        array.push(pool.high_mitigation_bars, pool.current_high_mitigation_bar)
        array.push(pool.low_mitigation_bars, pool.current_low_mitigation_bar)
        array.push(pool.high_used_by_pattern, false)
        array.push(pool.low_used_by_pattern, false)

        new_index = liquidity_pool_session_count(pool) - 1
        if pool.first_unbreached_high_index >= liquidity_pool_session_count(pool)
            pool.first_unbreached_high_index := new_index
        if pool.first_unbreached_low_index >= liquidity_pool_session_count(pool)
            pool.first_unbreached_low_index := new_index

        liquidity_pool_trim(pool, max_entries)

    liquidity_pool_clear_current(pool)

liquidity_pool_mark_breaches(pool, bar_high, bar_low, bar_time) =>
    total = liquidity_pool_session_count(pool)
    if total > 0
        if pool.first_unbreached_high_index < total
            for i = pool.first_unbreached_high_index to total - 1
                if not array.get(pool.high_breached, i)
                    tracked_high = array.get(pool.highs, i)
                    if bar_high >= tracked_high
                        array.set(pool.high_breached, i, true)
                        array.set(pool.high_breach_times, i, bar_time)
            liquidity_pool_advance_high_pointer(pool)

        if pool.first_unbreached_low_index < total
            for i = pool.first_unbreached_low_index to total - 1
                if not array.get(pool.low_breached, i)
                    tracked_low = array.get(pool.lows, i)
                    if bar_low <= tracked_low
                        array.set(pool.low_breached, i, true)
                        array.set(pool.low_breach_times, i, bar_time)
            liquidity_pool_advance_low_pointer(pool)

    total

liquidity_pool_get_high_line_end_time(pool, index, fallback_time) =>
    high_breached = array.get(pool.high_breached, index)
    high_breach_time = array.get(pool.high_breach_times, index)
    high_breached and not na(high_breach_time) ? high_breach_time : fallback_time

liquidity_pool_get_low_line_end_time(pool, index, fallback_time) =>
    low_breached = array.get(pool.low_breached, index)
    low_breach_time = array.get(pool.low_breach_times, index)
    low_breached and not na(low_breach_time) ? low_breach_time : fallback_time

liquidity_pool_clear(pool) =>
    array.clear(pool.highs)
    array.clear(pool.lows)
    array.clear(pool.high_times)
    array.clear(pool.low_times)
    array.clear(pool.session_close_times)
    array.clear(pool.high_breached)
    array.clear(pool.low_breached)
    array.clear(pool.high_breach_times)
    array.clear(pool.low_breach_times)
    array.clear(pool.high_origin_bar_indices)
    array.clear(pool.low_origin_bar_indices)
    array.clear(pool.high_first_breach_bars)
    array.clear(pool.low_first_breach_bars)
    array.clear(pool.high_mitigated_flags)
    array.clear(pool.low_mitigated_flags)
    array.clear(pool.high_mitigation_bars)
    array.clear(pool.low_mitigation_bars)
    array.clear(pool.high_used_by_pattern)
    array.clear(pool.low_used_by_pattern)
    liquidity_pool_clear_current(pool)
    pool.first_unbreached_high_index := 0
    pool.first_unbreached_low_index := 0

// Initialize daily liquidity pool instance
var LiquidityPoolCollection daily_liquidity_pool = create_liquidity_pool()
// Initialize weekly liquidity pool instance
var LiquidityPoolCollection weekly_liquidity_pool = create_liquidity_pool()
// Initialize monthly liquidity pool instance
var LiquidityPoolCollection monthly_liquidity_pool = create_liquidity_pool()
