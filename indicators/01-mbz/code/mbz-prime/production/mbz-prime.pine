            liquidity_pool_reset_current(nypm_nine_pool, high, low, time, bar_index)

        if in_nypm_nine_session
            liquidity_pool_update_current_extremes(nypm_nine_pool, high, low, time, bar_index)

        nypm_nine_breach := liquidity_pool_mark_breaches(nypm_nine_pool, high, low, time)
else if barstate.isnew
    liquidity_pool_clear_current(nypm_nine_pool)

// ONS session liquidity pool tracking
if enable_ons_liquidity_tracking and (show_source_origins or liquidity_detection_enabled)
    if not skip_sunday_liquidity
        in_ons_session = not na(time(timeframe.period, actual_ons_session, NY_TIMEZONE))
        was_in_ons_session = not na(time(timeframe.period, actual_ons_session, NY_TIMEZONE)[1])

        // Detect session boundaries
        session_just_started = in_ons_session and not was_in_ons_session
