DEFAULT_EXTENSION_OFFSET = 2
DEFAULT_EXTENSION_FILL_OPACITY = 97
DEFAULT_BORDER_OPACITY_1 = 50
DEFAULT_BORDER_OPACITY_2 = 15
DEFAULT_BORDER_OPACITY_3 = 80
DEFAULT_BORDER_OPACITY_4 = 30
DEFAULT_BORDER_OPACITY_5 = 65
MAX_PADDING_HORIZONTAL = 10
MAX_PADDING_VERTICAL = 5
DEFAULT_SOURCE_DISPLAYS = 10
MIN_SOURCE_DISPLAYS = 1
MAX_SOURCE_DISPLAYS = 50
WEEKLY_LABEL_OFFSET_MULTIPLIER = 0.3  // Offset for weekly labels to avoid collision with daily labels
MONTHLY_LABEL_OFFSET_MULTIPLIER = 0.6  // Offset for monthly labels to avoid collision with daily and weekly labels
INTRADAY_LABEL_OFFSET_MULTIPLIER = 0.25  // Offset for intraday labels (Asia, London, NYAM, Lunch, NYPM, ONS) to avoid collision
DTT_LABEL_OFFSET_MULTIPLIER = 0.45  // Offset for DTT session labels to avoid collision with other source labels

// Label alignment constants
LABEL_ALIGNMENT_LEFT = 'Left'
LABEL_ALIGNMENT_CENTER = 'Center'
LABEL_ALIGNMENT_RIGHT = 'Right'
LABEL_VERTICAL_TOP = 'Top'
LABEL_VERTICAL_CENTER = 'Center'
LABEL_VERTICAL_BOTTOM = 'Bottom'

// Direction filter constants
MBZ_DIRECTION_BOTH = 'Both'
MBZ_DIRECTION_BULLISH = 'Bullish Only'
MBZ_DIRECTION_BEARISH = 'Bearish Only'

// UI Group constants
GROUP_LIVE_WORKSPACE = '🎤 Workspace Tools'
GROUP_DETECTION = '🎯 Detection'
GROUP_INVALIDATION = '✋ Invalidation'
GROUP_VISIBILITY_FILTERS = '👁️ Visibility Filters'
GROUP_MBZ_EXTENSION = '✨ MBZ Extension'
GROUP_SOURCE_ORIGINS = '📦 Source Origins'
GROUP_LIQUIDITY_HTF = '💧 Higher Timeframe Liquidity Pools'
GROUP_LIQUIDITY_INTRADAY = '💧 Intraday Liquidity Pools'
GROUP_LIQUIDITY_DTT = '💧 DTT Liquidity Pools'
GROUP_TIME_BEHAVIOR = '⏰ Time Behavior'
GROUP_LIQUIDITY_RULES = '🎭 MBZ Formation Variants'

// Workspace Mode Constants (hardcoded values for live workspace)
WORKSPACE_EXTENSION_OFFSET = 2

// Auto Workspace Configuration (extensible - add more timeframes as needed)
AUTO_WS_TIMEFRAMES = array.from("1", "2", "3", "5", "15", "60")  // 1m, 2m, 3m, 5m, 15m, 1h
AUTO_WS_START_HOUR = 8   // NY time
AUTO_WS_END_HOUR = 13    // NY time

// Source label text constants
MULTIPLIER_SYMBOL = "×"
COUNT_SEPARATOR = ": "
BREAKDOWN_SEPARATOR = ", "

// Input label constants
INPUT_LABEL_LABEL = 'Label'
INPUT_LABEL_MAX_VALID_MBZS = 'Max Valid MBZs'
INPUT_LABEL_MAX_INVALIDATED_MBZS = 'Max'
INPUT_LABEL_INVALIDATION_BOUNDARY = 'Boundary'
INPUT_LABEL_CUSTOM_PERCENT = 'Custom %'
INPUT_LABEL_MBZ_PLUS = 'MBZ⁺'
INPUT_LABEL_MBZ_MINUS = 'MBZ⁻'
INPUT_LABEL_NO_OF_BARS = 'No. of Bars'
INPUT_LABEL_SHOW_INVALIDATED_MBZS = 'Show Invalidated MBZs'
INPUT_LABEL_THRESHOLD = 'Threshold'
INPUT_LABEL_DAILY = 'Daily'
INPUT_LABEL_WEEKLY = 'Weekly'
INPUT_LABEL_MONTHLY = 'Monthly'
INPUT_LABEL_DTT = 'DTT'
INPUT_LABEL_INCLUDE_SUNDAY_EVENING = 'Include Sunday Evening'
INPUT_LABEL_IMMEDIATE = 'Immediate'
INPUT_LABEL_STANDARD = 'Standard'
INPUT_LABEL_DELAYED = 'Delayed'
INPUT_LABEL_SHOW_SOURCE_ORIGINS = 'Show Source Origins'
INPUT_LABEL_MAX_ORIGINS = 'Max Origins'
INPUT_LABEL_HORIZONTAL = 'Horizontal'
INPUT_LABEL_HORIZONTAL_PADDING = 'Horizontal Padding'
INPUT_LABEL_WIDTH = 'Width'
MBZ_BASE_TEXT = "MBZ"

// MBZ-specific string constants - Generic & Reusable
MBZ_PLUS = "MBZ⁺"
MBZ_MINUS = "MBZ⁻"

// UI Label Constants (for easy customization)
UI_LABEL_ASIA_SESSION = "Asia"
UI_LABEL_LONDON_SESSION = "London"
UI_LABEL_NYAM_SESSION = "NY AM"
UI_LABEL_LUNCH_SESSION = "Lunch"
UI_LABEL_NYPM_SESSION = "NY PM"
UI_LABEL_ONS_SESSION = "ONS"
UI_LABEL_PREMARKET_SESSION = "Premarket"
UI_LABEL_24_7_MODE = "Enable 24/7 Mode"
UI_LABEL_NINE_TIMES = "Intraday Session Mode"

// NINE mode constants
NINE_MODE_STANDARD = "Standard"
NINE_MODE_NINE_ONLY = "NINE Only"
NINE_MODE_BOTH = "Both"

// ═══════════════════════════════════════════════════════════════════════════════
// INPUT SETTINGS - ULTRA-COMPACT ALIGNED LAYOUT
// ═══════════════════════════════════════════════════════════════════════════════

// === 🎤 WORKSPACE TOOLS ===
WORKSPACE_DEFAULT_NEAREST = 1
WORKSPACE_FADE_OPACITY = 80
// Muted transparency for extended zones in workspace mode (fill, border, text)
WORKSPACE_EXTENDED_FILL_TRANS = 98
WORKSPACE_EXTENDED_BORDER_TRANS = 70
WORKSPACE_EXTENDED_TEXT_TRANS = 25
workspace_mode_enabled = input.bool(false, "Enable Workspace Mode", group=GROUP_LIVE_WORKSPACE,
                         tooltip="Extend only the nearest N zones to current price. Non-extended zones use faded opacity.")
auto_workspace_enabled = input.bool(true, "Auto Workspace", group=GROUP_LIVE_WORKSPACE,
                         tooltip="Automatically enable workspace mode when on configured timeframes during NY 8-13.")
workspace_nearest_bull = input.int(WORKSPACE_DEFAULT_NEAREST, "+", minval=0, maxval=10, group=GROUP_LIVE_WORKSPACE, inline="ws_nearest",
                         tooltip="Number of nearest bullish zones to extend to current price")
workspace_nearest_bear = input.int(WORKSPACE_DEFAULT_NEAREST, "-", minval=0, maxval=10, group=GROUP_LIVE_WORKSPACE, inline="ws_nearest",
                         tooltip="Number of nearest bearish zones to extend to current price")
WORKSPACE_FADE_ALL = "All Zones"
WORKSPACE_FADE_DISTANT = "Distant"
WORKSPACE_FADE_NONE = "Off"
workspace_fade_mode = input.string(WORKSPACE_FADE_DISTANT, "Fade Zones", options=[WORKSPACE_FADE_ALL, WORKSPACE_FADE_DISTANT, WORKSPACE_FADE_NONE], group=GROUP_LIVE_WORKSPACE, inline="ws_fade",
                         tooltip="All Zones: fade all zones\nDistant: only fade zones not extended to current price\nOff: no fading, all zones at full opacity")

// Auto workspace detection (M-F only)
is_auto_ws_timeframe = array.includes(AUTO_WS_TIMEFRAMES, timeframe.period)
ny_hour = hour(time, NY_TIMEZONE)
ny_dow = dayofweek(time, NY_TIMEZONE)
is_weekday = ny_dow >= dayofweek.monday and ny_dow <= dayofweek.friday
is_auto_ws_time_window = is_weekday and ny_hour >= AUTO_WS_START_HOUR and ny_hour < AUTO_WS_END_HOUR
workspace_active = workspace_mode_enabled or (auto_workspace_enabled and is_auto_ws_timeframe and is_auto_ws_time_window)

// === 🎯 DETECTION ===
max_liquidity_mbzs = input.int(DEFAULT_MAX_LIQUIDITY_MBZS, INPUT_LABEL_MAX_VALID_MBZS, minval=0, maxval=MAX_LIQUIDITY_MBZS_LIMIT, group=GROUP_DETECTION, inline='quotas', tooltip='Maximum liquidity MBZs on chart (0-60)')

// === ✋ INVALIDATION ===
mbz_invalidation_mode = input.string(INVALIDATION_STRICT, INPUT_LABEL_THRESHOLD, options=[INVALIDATION_STANDARD, INVALIDATION_CONSERVATIVE, INVALIDATION_STRICT, INVALIDATION_CUSTOM], group=GROUP_INVALIDATION, inline='inv1', tooltip='Zone fill threshold for invalidation (requires candle close)\n• Standard: 100% fill\n• Conservative: 85% fill\n• Strict: 55% fill\n• Custom: set your own percentage')
custom_threshold_percent = input.float(DEFAULT_CUSTOM_THRESHOLD, INPUT_LABEL_CUSTOM_PERCENT, minval=MIN_THRESHOLD_PERCENT, maxval=MAX_THRESHOLD_PERCENT, step=DEFAULT_STEP_SIZE, group=GROUP_INVALIDATION, inline='inv1', tooltip='Custom invalidation threshold (1-99%). Used only when Custom mode is selected.')
invalidation_boundary = input.string(INVALIDATION_BOUNDARY_BODY, INPUT_LABEL_INVALIDATION_BOUNDARY, options=[INVALIDATION_BOUNDARY_BODY, INVALIDATION_BOUNDARY_EXTREMES], group=GROUP_INVALIDATION, inline='inv1', tooltip='Invalidation boundary:\n• Body Zone: Uses MBZ zone (body) boundaries\n• Candle Extremes: Uses candle high/low (default, more forgiving)\n\nNote: Only applies to Standard MBZs. Inclusion and Reflection always use their zone boundaries.')
show_invalidated_mbzs_input = input.bool(false, INPUT_LABEL_SHOW_INVALIDATED_MBZS, group=GROUP_INVALIDATION, inline='inv2', tooltip='Show invalidated MBZs alongside active ones')
max_invalidated_mbzs = input.int(DEFAULT_MAX_INVALIDATED_MBZS, INPUT_LABEL_MAX_INVALIDATED_MBZS, minval=0, maxval=MAX_INVALIDATED_MBZS_LIMIT, group=GROUP_INVALIDATION, inline='inv2', tooltip='Maximum number of invalidated MBZs to show (0-15 limit)')
backtesting_mode = input.bool(false, "Enable Backtesting Mode", group=GROUP_INVALIDATION, inline='inv3', tooltip='Show ONLY invalidated MBZs for backtesting analysis.\nOverrides "Show Invalidated MBZs" toggle.')

// Derived display flags
show_active_mbzs = not backtesting_mode
show_invalidated_mbzs = show_invalidated_mbzs_input or backtesting_mode

// Set variant mode (liquidity only)
mbz_variant_mode = VARIANT_LIQUIDITY

// === 👁️ VISIBILITY FILTERS ===
mbz_direction_filter = input.string(MBZ_DIRECTION_BOTH, 'Direction', options=[MBZ_DIRECTION_BOTH, MBZ_DIRECTION_BULLISH, MBZ_DIRECTION_BEARISH], group=GROUP_VISIBILITY_FILTERS, inline='dir1', tooltip='Filter MBZ display by direction:\n• Both: Show all MBZs\n• Bullish Only: Show only bullish MBZs\n• Bearish Only: Show only bearish MBZs')
filter_duplicate_formations = input.bool(true, 'Show Best Formation Only', group=GROUP_VISIBILITY_FILTERS, inline='form1', tooltip='When multiple formations exist at the same liquidity level, show only the highest priority:\n• IMM > STD• > STD > DEL\n\nDisable to show all formations')

// === 💧 LIQUIDITY: HIGHER TIMEFRAMES ===
enable_daily_liquidity = input.bool(true, INPUT_LABEL_DAILY, group=GROUP_LIQUIDITY_HTF, inline='liq_htf', tooltip='Detect MBZs from daily high/low breaches')
enable_weekly_liquidity = input.bool(true, INPUT_LABEL_WEEKLY, group=GROUP_LIQUIDITY_HTF, inline='liq_htf', tooltip='Detect MBZs from weekly high/low breaches')
enable_monthly_liquidity = input.bool(true, INPUT_LABEL_MONTHLY, group=GROUP_LIQUIDITY_HTF, inline='liq_htf', tooltip='Detect MBZs from monthly high/low breaches')

// === 💧 LIQUIDITY: INTRADAY SESSIONS ===
enable_asia_liquidity = input.bool(true, UI_LABEL_ASIA_SESSION, group=GROUP_LIQUIDITY_INTRADAY, inline='intraday1')
enable_london_liquidity = input.bool(true, UI_LABEL_LONDON_SESSION, group=GROUP_LIQUIDITY_INTRADAY, inline='intraday1')
enable_nyam_liquidity = input.bool(true, UI_LABEL_NYAM_SESSION, group=GROUP_LIQUIDITY_INTRADAY, inline='intraday1')
enable_lunch_liquidity = input.bool(true, UI_LABEL_LUNCH_SESSION, group=GROUP_LIQUIDITY_INTRADAY, inline='intraday1')
enable_nypm_liquidity = input.bool(true, UI_LABEL_NYPM_SESSION, group=GROUP_LIQUIDITY_INTRADAY, inline='intraday1')
enable_ons_liquidity = input.bool(true, UI_LABEL_ONS_SESSION, group=GROUP_LIQUIDITY_INTRADAY, inline='intraday1')
enable_premarket_liquidity = input.bool(true, UI_LABEL_PREMARKET_SESSION, group=GROUP_LIQUIDITY_INTRADAY, inline='intraday1', tooltip='Asia: 2000-0000\nLondon: 0200-0500\nNY AM: 0930-1200\nLunch: 1200-1330\nNY PM: 1330-1600\nONS (Overnight): 1600-0500\nPremarket: 0500-0915')
nine_times_mode = input.string(NINE_MODE_BOTH, UI_LABEL_NINE_TIMES, options=[NINE_MODE_STANDARD, NINE_MODE_NINE_ONLY, NINE_MODE_BOTH], group=GROUP_LIQUIDITY_INTRADAY, tooltip='Standard: Use default session times:\n  Asia: 2000-0000\n  London: 0200-0500\n  NY AM: 0930-1200\n  Lunch: 1200-1330\n  NY PM: 1330-1600\n  ONS (Overnight): 1600-0500\n  Premarket: 0500-0915\n\nNINE Only: Replace with NINE\'s times:\n  Asia: 1800-0300\n  London: 0300-0930\n  NY AM: 0930-1200\n  NY PM: 1200-1800\n  Lunch: Disabled\n\nBoth: Run BOTH standard AND NINE sessions in parallel\n(NINE variants show with -9 suffix)\n\nONS/Premarket: Unaffected by NINE mode')
show_session_times_table = input.bool(false, "Show Session Times Table", group=GROUP_LIQUIDITY_INTRADAY, tooltip='Display a small reference table in the bottom right corner showing active session times based on current mode')

// === 💧 DTT LIQUIDITY POOLS ===
enable_dtt_sessions = input.bool(true, "Enable DTT Sessions", group=GROUP_LIQUIDITY_DTT, tooltip='Enable DTT: 15 cascading sessions where each session uses the previous session\'s high/low as liquidity pools\n\nSessions: Damasu → Osaka → Kyoto → Nagasaki → Turncoat → Bishop → Knight → Big Ben → NY Open → Judas → Model 11 → Model 110 → Lunch → Model 1001 → Model 111')

// === ⏰ TIME BEHAVIOR ===
include_sunday_evening_liquidity = input.bool(true, INPUT_LABEL_INCLUDE_SUNDAY_EVENING, group=GROUP_TIME_BEHAVIOR, tooltip='SUNDAY EVENING LIQUIDITY (Traditional markets):\n\nForex/Futures reopen Sunday 18:00 NY time after Friday close. This 6-hour period is technically "Sunday" but traders often consider it Monday\'s session start.\n\n• ON (default): Include Sunday 18:00-00:00 in HTF liquidity pools (Daily, Weekly, Monthly)\n• OFF: Skip Sunday evening, start fresh Monday 00:00\n\nNote: Crypto/24-7 assets auto-detected and ignore this setting (always include all weekend hours)')

// Current timeframe in minutes (calculated once, reused throughout)
current_tf_minutes = timeframe.in_seconds() / 60

// Auto-detect 24/7 asset by scanning for weekend bars (excluding Sunday 18:00+ reopen)
// STRATEGY: Default TRUE (assume 24/7), only set FALSE after scanning 7+ days with no weekends
var bool is_247_asset = true
var bool detection_completed = false

// Only run detection once after we have 7+ days of data
if not detection_completed
    bars_in_7_days = math.ceil(10080 / current_tf_minutes)

    if bar_index >= bars_in_7_days
        // Check current bar first (fast path - if we loaded on Saturday, instant detect)
        current_day = dayofweek(time, NY_TIMEZONE)
        current_hour = hour(time, NY_TIMEZONE)
        is_saturday_now = current_day == dayofweek.saturday
        is_early_sunday_now = current_day == dayofweek.sunday and current_hour < SUNDAY_REOPEN_START_HOUR

        if is_saturday_now or is_early_sunday_now
            // Current bar is weekend - definitely 24/7
            is_247_asset := true
        else
            // Scan last 7 days for weekend bars
            max_lookback = math.min(9999, bars_in_7_days)
            found_weekend_bar = false

            for lookback = 0 to max_lookback by 20
                check_day = dayofweek(time[lookback], NY_TIMEZONE)
                check_hour = hour(time[lookback], NY_TIMEZONE)

                is_saturday = check_day == dayofweek.saturday
                is_early_sunday = check_day == dayofweek.sunday and check_hour < SUNDAY_REOPEN_START_HOUR
                if is_saturday or is_early_sunday
                    found_weekend_bar := true
                    break

            // Set result based on scan
            is_247_asset := found_weekend_bar

        detection_completed := true

// Auto-apply 24/7 day codes if weekend bars detected
day_codes = is_247_asset ? DAY_CODE_ALL_DAYS : DAY_CODE_MON_SAT

// Apply day codes to all sessions (user custom times already have Mon-Sat, we just override if 24/7)
// Standard session times (used in "Standard" and "Both" modes)
standard_asia_session = is_247_asset ? (STANDARD_ASIA_TIME + DAY_CODE_ALL_DAYS) : DEFAULT_ASIA_SESSION_TIME
standard_london_session = is_247_asset ? (STANDARD_LONDON_TIME + DAY_CODE_ALL_DAYS) : DEFAULT_LONDON_SESSION_TIME
standard_nyam_session = is_247_asset ? (STANDARD_NYAM_TIME + DAY_CODE_ALL_DAYS) : DEFAULT_NYAM_SESSION_TIME
standard_lunch_session = is_247_asset ? (STANDARD_LUNCH_TIME + DAY_CODE_ALL_DAYS) : DEFAULT_LUNCH_SESSION_TIME
standard_nypm_session = is_247_asset ? (STANDARD_NYPM_TIME + DAY_CODE_ALL_DAYS) : DEFAULT_NYPM_SESSION_TIME

// NINE session times (used in "NINE Only" and "Both" modes)
nine_asia_session = NINE_ASIA_TIME + day_codes
nine_london_session = NINE_LONDON_TIME + day_codes
nine_nyam_session = NINE_NYAM_TIME + day_codes
nine_lunch_session = NINE_LUNCH_TIME + day_codes
nine_nypm_session = NINE_NYPM_TIME + day_codes

// Determine which times to use for primary detection based on mode
actual_asia_session = nine_times_mode == NINE_MODE_NINE_ONLY ? nine_asia_session : standard_asia_session
actual_london_session = nine_times_mode == NINE_MODE_NINE_ONLY ? nine_london_session : standard_london_session
actual_nyam_session = nine_times_mode == NINE_MODE_NINE_ONLY ? nine_nyam_session : standard_nyam_session
actual_lunch_session = nine_times_mode == NINE_MODE_NINE_ONLY ? nine_lunch_session : standard_lunch_session
actual_nypm_session = nine_times_mode == NINE_MODE_NINE_ONLY ? nine_nypm_session : standard_nypm_session
actual_ons_session = is_247_asset ? SESSION_24_7_ONS : DEFAULT_ONS_SESSION_TIME
actual_premarket_session = is_247_asset ? SESSION_24_7_PREMARKET : DEFAULT_PREMARKET_SESSION_TIME

// Auto-disable lunch when NINE Only mode enabled (NINE doesn't use lunch)
actual_enable_lunch = nine_times_mode == NINE_MODE_NINE_ONLY ? false : enable_lunch_liquidity

// Determine if we need to run NINE variant detection (Both mode)
enable_nine_variants = nine_times_mode == NINE_MODE_BOTH

// === 🎭 MBZ FORMATION VARIANTS ===
// Directional (•) suffix: Candle A moved in direction of sweep (bullish for BSL, bearish for SSL)
enable_liquidity_immediate = input.bool(true, INPUT_LABEL_IMMEDIATE, group=GROUP_LIQUIDITY_RULES, tooltip='Immediate: First touch of pool produces same-bar rejection (current bar sweep)')
enable_liquidity_standard = input.bool(true, INPUT_LABEL_STANDARD, group=GROUP_LIQUIDITY_RULES, tooltip='Standard: Previous bar swept pool, current bar respects original extreme (no new high/low)\n\nL-STD = Candle A direction does not matter\nL-STD• = Candle A moved into the sweep')
enable_liquidity_delayed = input.bool(true, INPUT_LABEL_DELAYED, group=GROUP_LIQUIDITY_RULES, tooltip='Delayed: Sweep closes beyond pool, next bar re-enters (delayed confirmation)\n\nL-DEL = Candle A direction does not matter\nL-DEL• = Candle A moved into the sweep')

liquidity_detection_enabled = enable_liquidity_immediate or enable_liquidity_standard or enable_liquidity_delayed

// === 📦 SOURCE ORIGINS ===
show_source_origins = input.bool(true, INPUT_LABEL_SHOW_SOURCE_ORIGINS, group=GROUP_SOURCE_ORIGINS, inline='src1', tooltip='Display visual markers at origin points where MBZs were created (liquidity sources show as lines). Only displays origins for currently visible MBZs (excludes invalidated when Show Invalidated is off). Auto-deduplicates: one visual per unique source even if multiple MBZs share it')
max_source_displays = input.int(DEFAULT_SOURCE_DISPLAYS, INPUT_LABEL_MAX_ORIGINS, minval=MIN_SOURCE_DISPLAYS, maxval=MAX_SOURCE_DISPLAYS, group=GROUP_SOURCE_ORIGINS, inline='src1', tooltip='Maximum source origin lines to display (applies to liquidity pool levels only). Limited by Pine Script to ~500 bars of history on lower timeframes.')
show_daily_liquidity_lines = input.bool(true, LIQUIDITY_SOURCE_TYPE_DAILY, group=GROUP_SOURCE_ORIGINS, inline='src4', tooltip='Show Daily liquidity pool levels')
daily_liquidity_color = input.color(DEFAULT_DAILY_LIQUIDITY_COLOR, '', group=GROUP_SOURCE_ORIGINS, inline='src4', tooltip='Line color for Daily liquidity pool levels')
daily_liquidity_line_width = input.int(DEFAULT_DAILY_LIQUIDITY_LINE_WIDTH, INPUT_LABEL_WIDTH, minval=MIN_BORDER_WIDTH, maxval=MAX_BORDER_WIDTH, group=GROUP_SOURCE_ORIGINS, inline='src4', tooltip='Line thickness for Daily liquidity pool levels')
show_weekly_liquidity_lines = input.bool(true, LIQUIDITY_SOURCE_TYPE_WEEKLY, group=GROUP_SOURCE_ORIGINS, inline='src5', tooltip='Show Weekly liquidity pool levels (Sunday close)')
weekly_liquidity_color = input.color(DEFAULT_WEEKLY_LIQUIDITY_COLOR, '', group=GROUP_SOURCE_ORIGINS, inline='src5', tooltip='Line color for Weekly liquidity pool levels')
weekly_liquidity_line_width = input.int(DEFAULT_WEEKLY_LIQUIDITY_LINE_WIDTH, INPUT_LABEL_WIDTH, minval=MIN_BORDER_WIDTH, maxval=MAX_BORDER_WIDTH, group=GROUP_SOURCE_ORIGINS, inline='src5', tooltip='Line thickness for Weekly liquidity pool levels')
show_monthly_liquidity_lines = input.bool(true, LIQUIDITY_SOURCE_TYPE_MONTHLY, group=GROUP_SOURCE_ORIGINS, inline='src6', tooltip='Show Monthly liquidity pool levels')
monthly_liquidity_color = input.color(DEFAULT_MONTHLY_LIQUIDITY_COLOR, '', group=GROUP_SOURCE_ORIGINS, inline='src6', tooltip='Line color for Monthly liquidity pool levels')
monthly_liquidity_line_width = input.int(DEFAULT_MONTHLY_LIQUIDITY_LINE_WIDTH, INPUT_LABEL_WIDTH, minval=MIN_BORDER_WIDTH, maxval=MAX_BORDER_WIDTH, group=GROUP_SOURCE_ORIGINS, inline='src6', tooltip='Line thickness for Monthly liquidity pool levels')
show_intraday_liquidity_lines = input.bool(true, 'Intraday', group=GROUP_SOURCE_ORIGINS, inline='src7', tooltip='Show liquidity pool levels for all intraday sessions (Asia, London, NYAM, Lunch, NYPM, ONS)')
intraday_liquidity_color = input.color(DEFAULT_INTRADAY_LIQUIDITY_COLOR, '', group=GROUP_SOURCE_ORIGINS, inline='src7', tooltip='Line color for all intraday session liquidity pool levels')
intraday_liquidity_line_width = input.int(DEFAULT_INTRADAY_LIQUIDITY_LINE_WIDTH, INPUT_LABEL_WIDTH, minval=MIN_BORDER_WIDTH, maxval=MAX_BORDER_WIDTH, group=GROUP_SOURCE_ORIGINS, inline='src7', tooltip='Line thickness for all intraday session liquidity pool levels')
show_dtt_liquidity_lines = input.bool(true, INPUT_LABEL_DTT, group=GROUP_SOURCE_ORIGINS, inline='src13', tooltip='Show DTT verification lines')
dtt_liquidity_color = input.color(DEFAULT_DTT_LIQUIDITY_COLOR, '', group=GROUP_SOURCE_ORIGINS, inline='src13', tooltip='Line color for DTT verification lines')
dtt_liquidity_line_width = input.int(DEFAULT_DTT_LIQUIDITY_LINE_WIDTH, INPUT_LABEL_WIDTH, minval=MIN_BORDER_WIDTH, maxval=MAX_BORDER_WIDTH, group=GROUP_SOURCE_ORIGINS, inline='src13', tooltip='Line thickness for DTT verification lines')
source_origin_label_text_color = input.color(DEFAULT_SOURCE_ORIGIN_LABEL_TEXT_COLOR, 'Label', group=GROUP_SOURCE_ORIGINS, inline='src14', tooltip='Text color for source origin labels')

// === ✨ MBZ EXTENSION ===
extended_box_bullish_color = input.color(DEFAULT_EXTENDED_BOX_BULLISH_COLOR, INPUT_LABEL_MBZ_PLUS, group=GROUP_MBZ_EXTENSION, inline='ext_colors', tooltip='Color for MBZ⁺ highlights and extensions')
extended_box_bearish_color = input.color(DEFAULT_EXTENDED_BOX_BEARISH_COLOR, INPUT_LABEL_MBZ_MINUS, group=GROUP_MBZ_EXTENSION, inline='ext_colors', tooltip='Color for MBZ⁻ highlights and extensions')
extend_to_reference_wick = input.bool(false, 'Extend to Reference Wick', group=GROUP_MBZ_EXTENSION, tooltip='Extend zone boundary to reference candle wick:\n• Bullish: Lower boundary extends to reference candle low\n• Bearish: Upper boundary extends to reference candle high')
extended_box_length = input.int(DEFAULT_EXTENSION_BARS, INPUT_LABEL_NO_OF_BARS, minval=MIN_EXTENSION_BARS, maxval=MAX_EXTENSION_BARS, group=GROUP_MBZ_EXTENSION, inline='ext_fixed', tooltip='Number of bars zones extend from formation (minimum width)')
extension_fill_opacity = input.int(DEFAULT_EXTENSION_FILL_OPACITY, 'Fill Opacity', minval=0, maxval=100, group=GROUP_MBZ_EXTENSION, inline='ext_fixed', tooltip='Base opacity for extension box fill (0=solid, 100=invisible)')
extended_box_text_color = input.color(DEFAULT_EXTENDED_BOX_TEXT_COLOR, INPUT_LABEL_LABEL, group=GROUP_MBZ_EXTENSION, inline='ext_props', tooltip='Text color for extension boxes')
extension_label_horizontal_alignment = input.string(LABEL_ALIGNMENT_CENTER, INPUT_LABEL_HORIZONTAL, options=[LABEL_ALIGNMENT_LEFT, LABEL_ALIGNMENT_CENTER, LABEL_ALIGNMENT_RIGHT], group=GROUP_MBZ_EXTENSION, inline='ext_align', tooltip='Horizontal text alignment')
extension_label_vertical_alignment = input.string(LABEL_VERTICAL_CENTER, 'Vertical', options=[LABEL_VERTICAL_TOP, LABEL_VERTICAL_CENTER, LABEL_VERTICAL_BOTTOM], group=GROUP_MBZ_EXTENSION, inline='ext_align', tooltip='Vertical text alignment')
extension_label_horizontal_padding = input.int(0, INPUT_LABEL_HORIZONTAL_PADDING, minval=0, maxval=MAX_PADDING_HORIZONTAL, group=GROUP_MBZ_EXTENSION, inline='ext_padding', tooltip='Horizontal padding (0-10 spaces)')
extension_label_vertical_padding = input.int(0, 'Vertical Padding', minval=0, maxval=MAX_PADDING_VERTICAL, group=GROUP_MBZ_EXTENSION, inline='ext_padding', tooltip='Vertical padding (0-5 newlines)')

// === 📊 COLOR REFERENCE TABLE ===
show_color_table = input.bool(false, "Show Color Reference Table", group="📊 Color Reference", tooltip='Display a table showing all color RGB values and transparency used in the indicator')
show_status_table = input.bool(true, 'Show Status Table', group="📊 Color Reference", inline='status', tooltip='Show a compact status table at bottom center displaying current settings')
status_table_offset = input.int(DEFAULT_STATUS_TABLE_OFFSET, 'Offset', minval=-150, maxval=150, group="📊 Color Reference", inline='status', tooltip='Horizontal offset: negative = left, positive = right (-150 to 150)')

// ═══════════════════════════════════════════════════════════════════════════════
// LIVE EXTENSION HELPERS
// ═══════════════════════════════════════════════════════════════════════════════

EXTENSION_HASH_PRIME = 13

// Get unique offset for zone staggering (prevents overlapping zones from blending)
get_extension_offset(int zone_bar_index, float zone_top, int offset_setting) =>
    zone_price_hash = int(zone_top * 100)
    offset_index = (zone_bar_index + zone_price_hash) % EXTENSION_HASH_PRIME
    offset_index * math.max(1, int(offset_setting / 2))

// Get cycling border transparency for visual distinction
get_border_transparency(int zone_bar_index) =>
    border_index = zone_bar_index % 5
    switch border_index
        0 => DEFAULT_BORDER_OPACITY_1
        1 => DEFAULT_BORDER_OPACITY_2
        2 => DEFAULT_BORDER_OPACITY_3
        3 => DEFAULT_BORDER_OPACITY_4
        => DEFAULT_BORDER_OPACITY_5

// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS & DATA STRUCTURES
// ═══════════════════════════════════════════════════════════════════════════════

// MBZ tracking
type MBZRecord
    int bar_index
    int formation_time  // Store time to avoid historical buffer limits with xloc.bar_time
    float high_price
    float low_price
    float mbz_open
    float mbz_close
    bool is_bullish
    bool is_invalidated
    float max_fill_percentage
    bool has_dominant_wick
    bool is_exactly_50_percent
    string mbz_subtype
    float cached_zone_top
    float cached_zone_bottom
    bool cached_data_valid
    label mbz_label
    int source_id
    // Cached source geometry retained with each record
    int source_bar_index
    float source_high
    float source_low
    string source_family
    string source_type
    string pool_boundary
    string variant               // Variant that produced this MBZ (imbalance/liquidity)
    string formation_rule          // Formation rule (e.g., imbalance_standard, liquidity_standard)
    string source_origin_token   // Unified token describing the origin (e.g., fvg, daily)
    float ref_candle_high
    float ref_candle_low
    bool is_extended
    int all_records_index    // PERF: Direct index in all_mbz_records for O(1) sync

type LiquidityPoolCollection
    array<float> highs
    array<float> lows
    array<int> high_times
    array<int> low_times
    array<int> session_close_times
    array<bool> high_breached
    array<bool> low_breached
    array<int> high_breach_times
    array<int> low_breach_times
    array<int> high_origin_bar_indices
    array<int> low_origin_bar_indices
    array<int> high_first_breach_bars
    array<int> low_first_breach_bars
    array<bool> high_mitigated_flags
    array<bool> low_mitigated_flags
    array<int> high_mitigation_bars
    array<int> low_mitigation_bars
    array<bool> high_used_by_pattern
    array<bool> low_used_by_pattern
    float current_high
    float current_low
    int current_high_time
    int current_low_time
    int current_session_start_time
    int current_high_origin_bar_index
    int current_low_origin_bar_index
    int current_high_first_breach_bar
    int current_low_first_breach_bar
    bool current_high_mitigated
    bool current_low_mitigated
    int current_high_mitigation_bar
    int current_low_mitigation_bar
    int first_unbreached_high_index
    int first_unbreached_low_index

// DTT Session tracking
type DttSession
    string name                    // Session name (e.g., "Judas")
    string prev_session_name       // Previous session name for cascade (e.g., "NY Open")
    int start_time_hhmm            // Start time in HHMM format
    int end_time_hhmm              // End time in HHMM format
    int start_bar                  // Bar index when session started (na if not started)
    int end_bar                    // Bar index when session ended (na if not ended)
    float session_high             // High price during session
    float session_low              // Low price during session
    int high_bar                   // Bar index of high
    int low_bar                    // Bar index of low
    bool high_breached             // Previous session's high was breached
    bool low_breached              // Previous session's low was breached
    int high_breach_bar            // Bar where high breach occurred
    int low_breach_bar             // Bar where low breach occurred
    bool high_pattern_checked      // High breach pattern already checked
    bool low_pattern_checked       // Low breach pattern already checked
    line start_boundary_line       // Visual: session start line
    line end_boundary_line         // Visual: session end line
    line prev_high_line            // Visual: previous session high
    line prev_low_line             // Visual: previous session low
    label session_label            // Visual: session name label

// Cached counts for multi-source evaluation
type SourceTypeStats
    int group_size
    int distinct_types
    int liquidity_daily_count
    int liquidity_weekly_count
    int liquidity_monthly_count
    int liquidity_asia_count
    int liquidity_london_count
    int liquidity_nyam_count
    int liquidity_lunch_count
    int liquidity_nypm_count
    int liquidity_ons_count
    int liquidity_premarket_count
    int liquidity_dtt_count
    int liquidity_total_count

// Consolidated MBZ group type
type ConsolidatedMBZ
    array<MBZRecord> mbz_group
    int bar_index
    int formation_time  // Store time to avoid historical buffer limits with xloc.bar_time
    bool is_bullish
    float consolidated_zone_top
    float consolidated_zone_bottom
    bool is_consolidated_invalidated
    string consolidated_extension_label
    int last_checked_bar_index  // Track last bar checked for historical invalidation

// Wrapper type for map-based consolidation (Pine Script doesn't allow nested collections directly)
type MBZGroupWrapper
    array<MBZRecord> mbz_group

var array<MBZRecord> all_mbz_records = array.new<MBZRecord>()  // Large pool for history
var array<MBZRecord> active_mbz_records = array.new<MBZRecord>()  // PERFORMANCE: Only non-invalidated MBZs (for fast invalidation checks)
var array<int> liquidity_source_id_counter = array.new_int(1, 1)  // Mutable counter for liquidity boundaries

// Visual elements
var array<label> mbz_labels = array.new<label>()
var array<label> star_labels = array.new<label>()
var array<box> mbz_body_highlights = array.new_box()          // Body highlighting
var array<box> mbz_wick_highlights = array.new_box()          // Wick highlighting
var array<box> mbz_extended_boxes = array.new_box()           // Extension boxes
var array<line> mbz_lines = array.new_line()                 // Breach level lines
var array<label> mbz_extension_labels = array.new<label>()    // External extension labels (when outside box)
var array<int> displayed_mbz_indices = array.new<int>()       // Display tracking
// Cache of consolidated groups from last visual render (for stars reuse)
var array<ConsolidatedMBZ> last_consolidated_mbzs = array.new<ConsolidatedMBZ>()
var label liquidity_variant_placeholder_label = na

// Daily liquidity tracking
var array<line> daily_liquidity_lines = array.new<line>()
var array<label> daily_liquidity_labels = array.new<label>()
// Weekly liquidity tracking
var array<line> weekly_liquidity_lines = array.new<line>()
var array<label> weekly_liquidity_labels = array.new<label>()
// Monthly liquidity tracking
var array<line> monthly_liquidity_lines = array.new<line>()
var array<label> monthly_liquidity_labels = array.new<label>()
// Asia session liquidity tracking
var array<line> asia_liquidity_lines = array.new<line>()
var array<label> asia_liquidity_labels = array.new<label>()
// London session liquidity tracking
var array<line> london_liquidity_lines = array.new<line>()
var array<label> london_liquidity_labels = array.new<label>()
// NY AM session liquidity tracking
var array<line> nyam_liquidity_lines = array.new<line>()
var array<label> nyam_liquidity_labels = array.new<label>()
// Lunch session liquidity tracking
var array<line> lunch_liquidity_lines = array.new<line>()
var array<label> lunch_liquidity_labels = array.new<label>()
// NY PM session liquidity tracking
var array<line> nypm_liquidity_lines = array.new<line>()
var array<label> nypm_liquidity_labels = array.new<label>()
// ONS session liquidity tracking
var array<line> ons_liquidity_lines = array.new<line>()
var array<label> ons_liquidity_labels = array.new<label>()
// Premarket session liquidity tracking
var array<line> premarket_liquidity_lines = array.new<line>()
var array<label> premarket_liquidity_labels = array.new<label>()

// Performance optimization flags
var bool needs_visual_update = true

// Pre-calculated padding strings (performance optimization)
horizontal_padding_str = ""
for i = 0 to extension_label_horizontal_padding - 1
    horizontal_padding_str := horizontal_padding_str + " "

// Vertical padding - build padding string
vertical_padding_str = ""
for i = 0 to extension_label_vertical_padding - 1
    vertical_padding_str := vertical_padding_str + "\n"

// PROFILING: Per-bar operation counters (liquidity-only)
var int profile_records_consolidated = 0
var int profile_total_records_examined = 0
var int profile_liquidity_records_added = 0
