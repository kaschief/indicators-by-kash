NINE_MODE_BOTH = "Both"

// ═══════════════════════════════════════════════════════════════════════════════
// INPUT SETTINGS - ULTRA-COMPACT ALIGNED LAYOUT
// ═══════════════════════════════════════════════════════════════════════════════

// === 🎯 DETECTION ===
max_liquidity_mbzs = input.int(DEFAULT_MAX_LIQUIDITY_MBZS, INPUT_LABEL_MAX_VALID_MBZS, minval=0, maxval=MAX_LIQUIDITY_MBZS_LIMIT, group=GROUP_DETECTION, inline='quotas', tooltip='Maximum liquidity MBZs on chart (0-60)')

// === ✋ INVALIDATION ===
show_invalidated_mbzs = input.bool(false, INPUT_LABEL_SHOW_INVALIDATED_MBZS, group=GROUP_INVALIDATION, inline='inv1', tooltip='Show invalidated MBZs with labels and zones')
max_invalidated_mbzs = input.int(DEFAULT_MAX_INVALIDATED_MBZS, INPUT_LABEL_MAX_INVALIDATED_MBZS, minval=0, maxval=MAX_INVALIDATED_MBZS_LIMIT, group=GROUP_INVALIDATION, inline='inv1', tooltip='Maximum number of invalidated MBZs to show (0-15 limit)')
mbz_invalidation_mode = input.string(INVALIDATION_STANDARD, INPUT_LABEL_THRESHOLD, options=[INVALIDATION_STANDARD, INVALIDATION_STRICT, INVALIDATION_CUSTOM], group=GROUP_INVALIDATION, inline='inv2', tooltip='Zone fill threshold for invalidation (requires candle close)\n• Standard: 100% fill\n• Strict: 85% fill\n• Custom: set your own percentage')
custom_threshold_percent = input.float(DEFAULT_CUSTOM_THRESHOLD, INPUT_LABEL_CUSTOM_PERCENT, minval=MIN_THRESHOLD_PERCENT, maxval=MAX_THRESHOLD_PERCENT, step=DEFAULT_STEP_SIZE, group=GROUP_INVALIDATION, inline='inv2', tooltip='Custom invalidation threshold (1-99%). Used only when Custom mode is selected.')
invalidation_boundary = input.string(INVALIDATION_BOUNDARY_BODY, INPUT_LABEL_INVALIDATION_BOUNDARY, options=[INVALIDATION_BOUNDARY_BODY, INVALIDATION_BOUNDARY_EXTREMES], group=GROUP_INVALIDATION, inline='inv3', tooltip='Invalidation boundary:\n• Body Zone: Uses MBZ zone (body) boundaries\n• Candle Extremes: Uses candle high/low (default, more forgiving)\n\nNote: Only applies to Standard MBZs. Inclusion and Reflection always use their zone boundaries.')

// Set variant mode (liquidity only)
mbz_variant_mode = VARIANT_LIQUIDITY

// === 👁️ VISIBILITY FILTERS ===
show_bullish_mbzs = input.bool(true, INPUT_LABEL_SHOW_MBZ_PLUS, group=GROUP_VISIBILITY_FILTERS, inline='dir1', tooltip='Display MBZ⁺ zones and labels')
show_bearish_mbzs = input.bool(true, INPUT_LABEL_SHOW_MBZ_MINUS, group=GROUP_VISIBILITY_FILTERS, inline='dir1', tooltip='Display MBZ⁻ zones and labels')

// === 💧 LIQUIDITY: HIGHER TIMEFRAMES ===
enable_daily_liquidity = input.bool(true, INPUT_LABEL_DAILY, group=GROUP_LIQUIDITY_HTF, inline='liq_htf', tooltip='Detect MBZs from daily high/low breaches')
enable_weekly_liquidity = input.bool(true, INPUT_LABEL_WEEKLY, group=GROUP_LIQUIDITY_HTF, inline='liq_htf', tooltip='Detect MBZs from weekly high/low breaches')
enable_monthly_liquidity = input.bool(true, INPUT_LABEL_MONTHLY, group=GROUP_LIQUIDITY_HTF, inline='liq_htf', tooltip='Detect MBZs from monthly high/low breaches')

// === 💧 LIQUIDITY: INTRADAY SESSIONS ===
enable_asia_liquidity = input.bool(true, UI_LABEL_ASIA_SESSION, group=GROUP_LIQUIDITY_INTRADAY, inline='intraday1')
enable_london_liquidity = input.bool(true, UI_LABEL_LONDON_SESSION, group=GROUP_LIQUIDITY_INTRADAY, inline='intraday1')
enable_nyam_liquidity = input.bool(true, UI_LABEL_NYAM_SESSION, group=GROUP_LIQUIDITY_INTRADAY, inline='intraday1')
enable_lunch_liquidity = input.bool(true, UI_LABEL_LUNCH_SESSION, group=GROUP_LIQUIDITY_INTRADAY, inline='intraday1')
enable_nypm_liquidity = input.bool(true, UI_LABEL_NYPM_SESSION, group=GROUP_LIQUIDITY_INTRADAY, inline='intraday1')
enable_ons_liquidity = input.bool(true, UI_LABEL_ONS_SESSION, group=GROUP_LIQUIDITY_INTRADAY, inline='intraday1', tooltip='Asia: 2000-0000\nLondon: 0200-0500\nNY AM: 0930-1200\nLunch: 1200-1330\nNY PM: 1330-1600\nONS: 0500-0915')
nine_times_mode = input.string(NINE_MODE_STANDARD, UI_LABEL_NINE_TIMES, options=[NINE_MODE_STANDARD, NINE_MODE_NINE_ONLY, NINE_MODE_BOTH], group=GROUP_LIQUIDITY_INTRADAY, tooltip='Standard: Use default session times\n\nNINE Only: Replace with NINE\'s times:\n  Asia: 1800-0300\n  London: 0300-0930\n  NY AM: 0930-1200\n  NY PM: 1200-1800\n  Lunch: Disabled\n\nBoth: Run BOTH standard AND NINE sessions in parallel\n(NINE variants show with -9 suffix)\n\nONS: Unaffected by NINE mode')

// === 💧 DTT LIQUIDITY POOLS ===
enable_dtt_sessions = input.bool(true, "Enable DTT Sessions", group=GROUP_LIQUIDITY_DTT, tooltip='Enable DTT: 15 cascading sessions where each session uses the previous session\'s high/low as liquidity pools\n\nSessions: Damasu → Osaka → Kyoto → Nagasaki → Turncoat → Bishop → Knight → Big Ben → NY Open → Judas → Model 11 → Model 110 → Lunch → Model 1001 → Model 111')

// === ⏰ TIME BEHAVIOR ===
include_sunday_evening_liquidity = input.bool(true, INPUT_LABEL_INCLUDE_SUNDAY_EVENING, group=GROUP_TIME_BEHAVIOR, tooltip='SUNDAY EVENING LIQUIDITY (Traditional markets):\n\nForex/Futures reopen Sunday 18:00 NY time after Friday close. This 6-hour period is technically "Sunday" but traders often consider it Monday\'s session start.\n\n• ON (default): Include Sunday 18:00-00:00 in HTF liquidity pools (Daily, Weekly, Monthly)\n• OFF: Skip Sunday evening, start fresh Monday 00:00\n\nNote: Crypto/24-7 assets auto-detected and ignore this setting (always include all weekend hours)')

// Current timeframe in minutes (calculated once, reused throughout)
current_tf_minutes = timeframe.in_seconds() / 60

// Auto-detect 24/7 asset by scanning for weekend bars (excluding Sunday 18:00+ reopen)
// STRATEGY: Default TRUE (assume 24/7), only set FALSE after scanning 7+ days with no weekends
var bool is_247_asset = true
var bool detection_completed = false

// Only run detection once after we have 7+ days of data
if not detection_completed
    bars_in_7_days = math.ceil(10080 / current_tf_minutes)

    if bar_index >= bars_in_7_days
        // Check current bar first (fast path - if we loaded on Saturday, instant detect)
        current_day = dayofweek(time, NY_TIMEZONE)
        current_hour = hour(time, NY_TIMEZONE)
        is_saturday_now = current_day == dayofweek.saturday
        is_early_sunday_now = current_day == dayofweek.sunday and current_hour < SUNDAY_REOPEN_START_HOUR

        if is_saturday_now or is_early_sunday_now
            // Current bar is weekend - definitely 24/7
            is_247_asset := true
        else
            // Scan last 7 days for weekend bars
            max_lookback = math.min(9999, bars_in_7_days)
            found_weekend_bar = false

            for lookback = 0 to max_lookback by 20
                check_day = dayofweek(time[lookback], NY_TIMEZONE)
                check_hour = hour(time[lookback], NY_TIMEZONE)

                is_saturday = check_day == dayofweek.saturday
                is_early_sunday = check_day == dayofweek.sunday and check_hour < SUNDAY_REOPEN_START_HOUR
                if is_saturday or is_early_sunday
                    found_weekend_bar := true
                    break

            // Set result based on scan
            is_247_asset := found_weekend_bar

        detection_completed := true

// Auto-apply 24/7 day codes if weekend bars detected
day_codes = is_247_asset ? DAY_CODE_ALL_DAYS : DAY_CODE_MON_SAT

// Apply day codes to all sessions (user custom times already have Mon-Sat, we just override if 24/7)
// Standard session times (used in "Standard" and "Both" modes)
standard_asia_session = is_247_asset ? ("2000-0000" + DAY_CODE_ALL_DAYS) : DEFAULT_ASIA_SESSION_TIME
standard_london_session = is_247_asset ? ("0200-0500" + DAY_CODE_ALL_DAYS) : DEFAULT_LONDON_SESSION_TIME
standard_nyam_session = is_247_asset ? ("0930-1200" + DAY_CODE_ALL_DAYS) : DEFAULT_NYAM_SESSION_TIME
standard_lunch_session = is_247_asset ? ("1200-1330" + DAY_CODE_ALL_DAYS) : DEFAULT_LUNCH_SESSION_TIME
standard_nypm_session = is_247_asset ? ("1330-1600" + DAY_CODE_ALL_DAYS) : DEFAULT_NYPM_SESSION_TIME

// NINE session times (used in "NINE Only" and "Both" modes)
nine_asia_session = NINE_ASIA_TIME + day_codes
nine_london_session = NINE_LONDON_TIME + day_codes
nine_nyam_session = NINE_NYAM_TIME + day_codes
nine_lunch_session = NINE_LUNCH_TIME + day_codes
nine_nypm_session = NINE_NYPM_TIME + day_codes

// Determine which times to use for primary detection based on mode
actual_asia_session = nine_times_mode == NINE_MODE_NINE_ONLY ? nine_asia_session : standard_asia_session
actual_london_session = nine_times_mode == NINE_MODE_NINE_ONLY ? nine_london_session : standard_london_session
actual_nyam_session = nine_times_mode == NINE_MODE_NINE_ONLY ? nine_nyam_session : standard_nyam_session
actual_lunch_session = nine_times_mode == NINE_MODE_NINE_ONLY ? nine_lunch_session : standard_lunch_session
actual_nypm_session = nine_times_mode == NINE_MODE_NINE_ONLY ? nine_nypm_session : standard_nypm_session
actual_ons_session = is_247_asset ? ("0500-0915" + DAY_CODE_ALL_DAYS) : DEFAULT_ONS_SESSION_TIME

// Auto-disable lunch when NINE Only mode enabled (NINE doesn't use lunch)
actual_enable_lunch = nine_times_mode == NINE_MODE_NINE_ONLY ? false : enable_lunch_liquidity

// Determine if we need to run NINE variant detection (Both mode)
enable_nine_variants = nine_times_mode == NINE_MODE_BOTH

// === 🎭 MBZ FORMATION VARIANTS ===
enable_liquidity_immediate = input.bool(true, INPUT_LABEL_IMMEDIATE, group=GROUP_LIQUIDITY_RULES, inline='liq_rules')
enable_liquidity_standard = input.bool(true, INPUT_LABEL_STANDARD, group=GROUP_LIQUIDITY_RULES, inline='liq_rules')
enable_liquidity_delayed = input.bool(true, INPUT_LABEL_DELAYED, group=GROUP_LIQUIDITY_RULES, inline='liq_rules', tooltip='LIQUIDITY FORMATION VARIANTS:\n\n• Immediate: First touch of pool produces same-bar rejection (current bar sweep)\n• Standard: Previous bar swept pool, current bar respects original extreme (no new high/low)\n• Delayed: Sweep closes beyond pool, next bar re-enters (delayed confirmation)')

liquidity_detection_enabled = enable_liquidity_immediate or enable_liquidity_standard or enable_liquidity_delayed

// === 📦 SOURCE ORIGINS ===
show_source_origins = input.bool(true, INPUT_LABEL_SHOW_SOURCE_ORIGINS, group=GROUP_SOURCE_ORIGINS, inline='src1', tooltip='Display visual markers at origin points where MBZs were created (liquidity sources show as lines). Only displays origins for currently visible MBZs (excludes invalidated when Show Invalidated is off). Auto-deduplicates: one visual per unique source even if multiple MBZs share it')
max_source_displays = input.int(DEFAULT_SOURCE_DISPLAYS, INPUT_LABEL_MAX_ORIGINS, minval=MIN_SOURCE_DISPLAYS, maxval=MAX_SOURCE_DISPLAYS, group=GROUP_SOURCE_ORIGINS, inline='src1', tooltip='Maximum source origin lines to display (applies to liquidity pool levels only). Limited by Pine Script to ~500 bars of history on lower timeframes.')
source_label_size = input.string(TEXT_SIZE_TINY, INPUT_LABEL_LABEL_SIZE, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_SOURCE_ORIGINS, inline='src1', tooltip='Text size for labels on liquidity source lines')
show_daily_liquidity_lines = input.bool(true, LIQUIDITY_SOURCE_TYPE_DAILY, group=GROUP_SOURCE_ORIGINS, inline='src4', tooltip='Show Daily liquidity pool levels')
daily_liquidity_color = input.color(color.new(color.purple, 0), '', group=GROUP_SOURCE_ORIGINS, inline='src4', tooltip='Line color for Daily liquidity pool levels')
daily_liquidity_line_width = input.int(DEFAULT_DAILY_LIQUIDITY_LINE_WIDTH, INPUT_LABEL_WIDTH, minval=MIN_BORDER_WIDTH, maxval=MAX_BORDER_WIDTH, group=GROUP_SOURCE_ORIGINS, inline='src4', tooltip='Line thickness for Daily liquidity pool levels')
show_weekly_liquidity_lines = input.bool(true, LIQUIDITY_SOURCE_TYPE_WEEKLY, group=GROUP_SOURCE_ORIGINS, inline='src5', tooltip='Show Weekly liquidity pool levels (Sunday close)')
weekly_liquidity_color = input.color(color.new(#ec407a, 0), '', group=GROUP_SOURCE_ORIGINS, inline='src5', tooltip='Line color for Weekly liquidity pool levels')
weekly_liquidity_line_width = input.int(DEFAULT_WEEKLY_LIQUIDITY_LINE_WIDTH, INPUT_LABEL_WIDTH, minval=MIN_BORDER_WIDTH, maxval=MAX_BORDER_WIDTH, group=GROUP_SOURCE_ORIGINS, inline='src5', tooltip='Line thickness for Weekly liquidity pool levels')
show_monthly_liquidity_lines = input.bool(true, LIQUIDITY_SOURCE_TYPE_MONTHLY, group=GROUP_SOURCE_ORIGINS, inline='src6', tooltip='Show Monthly liquidity pool levels')
monthly_liquidity_color = input.color(color.new(#ff9800, 0), '', group=GROUP_SOURCE_ORIGINS, inline='src6', tooltip='Line color for Monthly liquidity pool levels')
monthly_liquidity_line_width = input.int(DEFAULT_MONTHLY_LIQUIDITY_LINE_WIDTH, INPUT_LABEL_WIDTH, minval=MIN_BORDER_WIDTH, maxval=MAX_BORDER_WIDTH, group=GROUP_SOURCE_ORIGINS, inline='src6', tooltip='Line thickness for Monthly liquidity pool levels')
show_intraday_liquidity_lines = input.bool(true, 'Intraday', group=GROUP_SOURCE_ORIGINS, inline='src7', tooltip='Show liquidity pool levels for all intraday sessions (Asia, London, NYAM, Lunch, NYPM, ONS)')
intraday_liquidity_color = input.color(color.new(#00bcd4, 0), '', group=GROUP_SOURCE_ORIGINS, inline='src7', tooltip='Line color for all intraday session liquidity pool levels')
intraday_liquidity_line_width = input.int(DEFAULT_INTRADAY_LIQUIDITY_LINE_WIDTH, INPUT_LABEL_WIDTH, minval=MIN_BORDER_WIDTH, maxval=MAX_BORDER_WIDTH, group=GROUP_SOURCE_ORIGINS, inline='src7', tooltip='Line thickness for all intraday session liquidity pool levels')
show_dtt_liquidity_lines = input.bool(true, INPUT_LABEL_DTT, group=GROUP_SOURCE_ORIGINS, inline='src13', tooltip='Show DTT verification lines')
dtt_liquidity_color = input.color(color.new(#9c27b0, 30), '', group=GROUP_SOURCE_ORIGINS, inline='src13', tooltip='Line color for DTT verification lines')
dtt_liquidity_line_width = input.int(DEFAULT_DTT_LIQUIDITY_LINE_WIDTH, INPUT_LABEL_WIDTH, minval=MIN_BORDER_WIDTH, maxval=MAX_BORDER_WIDTH, group=GROUP_SOURCE_ORIGINS, inline='src13', tooltip='Line thickness for DTT verification lines')
// Note: Imbalance boxes always shown when Source Origins enabled (core source visualization)

// === 🎨 MBZ LABELLING (TYPE, SIZE & COLOR)===
mbz_symbol_type = input.string(DISPLAY_MODE_ARROW_TEXT, INPUT_LABEL_LABEL_STYLE, options=[DISPLAY_MODE_ARROW_ONLY, DISPLAY_MODE_TEXT_ONLY, DISPLAY_MODE_ARROW_TEXT], group=GROUP_MBZ_LABELLING, inline='mbz2', tooltip='What to display on MBZ candles')
mbz_label_size = input.string(TEXT_SIZE_TINY, INPUT_LABEL_VALID_MBZ, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_MBZ_LABELLING, inline='mbz1', tooltip='Size of valid MBZ labels')
mbz_invalidated_size = input.string(TEXT_SIZE_TINY, INPUT_LABEL_INVALIDATED_MBZ, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_MBZ_LABELLING, inline='mbz1', tooltip='Size of invalidated MBZ labels')
mbz_bullish_color = input.color(DEFAULT_MBZ_LABEL_COLOR_BULLISH, INPUT_LABEL_MBZ_PLUS, group=GROUP_MBZ_LABELLING, inline='mbz2', tooltip='Color for MBZ⁺ labels')
mbz_bearish_color = input.color(DEFAULT_MBZ_LABEL_COLOR_BEARISH, INPUT_LABEL_MBZ_MINUS, group=GROUP_MBZ_LABELLING, inline='mbz2', tooltip='Color for MBZ⁻ labels')
mbz_invalidated_color = input.color(color.gray, INPUT_LABEL_INVALIDATED, group=GROUP_MBZ_LABELLING, inline='mbz2', tooltip='Color for invalidated MBZ labels')
show_mbz_labels = input.bool(true, INPUT_LABEL_ENABLE_LABELS, group=GROUP_MBZ_LABELLING, inline='mbz3', tooltip='Show MBZ arrow/text labels on candles\n\nNote: Arrow direction also points toward the source region that created the MBZ')
show_enhanced_label_details = input.bool(true, INPUT_LABEL_SHOW_ENHANCED_LABEL_DETAILS, group=GROUP_MBZ_LABELLING, inline='mbz4', tooltip='Display detailed source types and behaviors in MBZ labels\n\nOFF: Clean labels (MBZ⁺, MBZ⁻)\nON: Enhanced labels (MBZ⁺ (imp) ↓inc)')
reflection_label_offset_multiplier = input.float(DEFAULT_REFLECTION_LABEL_SPACING_MULTIPLIER, INPUT_LABEL_REFLECTION_LABEL_OFFSET, minval=MIN_REFLECTION_LABEL_SPACING_MULTIPLIER, maxval=MAX_REFLECTION_LABEL_SPACING_MULTIPLIER, step=0.1, group=GROUP_MBZ_LABELLING, inline='mbz5', tooltip='Offset multiplier for reflection MBZ labels to prevent collision with extension boxes (0.0-2.0)')
general_label_offset_multiplier = input.float(DEFAULT_GENERAL_LABEL_OFFSET_MULTIPLIER, INPUT_LABEL_GENERAL_LABEL_OFFSET, minval=MIN_GENERAL_LABEL_OFFSET_MULTIPLIER, maxval=MAX_GENERAL_LABEL_OFFSET_MULTIPLIER, step=0.1, group=GROUP_MBZ_LABELLING, inline='mbz6', tooltip='Additional vertical offset multiplier for ALL labels based on zone height (0.0-5.0)\n\nUseful to separate liquidity MBZ labels from imbalance MBZ labels')

// === ✨ MBZ EXTENSION ===
extended_box_bullish_color = input.color(color.new(#90bff9, 85), INPUT_LABEL_MBZ_PLUS, group=GROUP_MBZ_EXTENSION, inline='ext1', tooltip='Color for MBZ⁺ highlights and extensions')
extended_box_bearish_color = input.color(color.new(#b39ddb, 85), INPUT_LABEL_MBZ_MINUS, group=GROUP_MBZ_EXTENSION, inline='ext1', tooltip='Color for MBZ⁻ highlights and extensions')
show_extended_boxes = input.bool(true, INPUT_LABEL_ENABLE_EXTENSION, group=GROUP_MBZ_EXTENSION, inline='ext1', tooltip='Show highlights and extensions for valid MBZs')
extension_mode = input.string(EXTENSION_FIXED, INPUT_LABEL_EXTENSION_MODE, options=[EXTENSION_FIXED, EXTENSION_TO_CURRENT, EXTENSION_BEYOND_CURRENT], group=GROUP_MBZ_EXTENSION, inline='ext1', tooltip='Extension behavior:\n• Fixed Length: extend N bars from formation\n• To Current Price: extend at least to current bar (prevents shrinking)\n• Beyond Current Price: extend N bars beyond current bar (real-time)')
extended_box_length = input.int(DEFAULT_EXTENSION_BARS, INPUT_LABEL_NO_OF_BARS, minval=MIN_EXTENSION_BARS, maxval=MAX_EXTENSION_BARS, group=GROUP_MBZ_EXTENSION, inline='ext1', tooltip='Number of bars for extension (1-50 limit, meaning changes based on Extension Mode selected)')
extended_box_text_size = input.string(TEXT_SIZE_TINY, INPUT_LABEL_LABEL, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_MBZ_EXTENSION, inline='ext2', tooltip='Text size for extension boxes')
extended_box_text_color = input.color(color.black, INPUT_LABEL_LABEL, group=GROUP_MBZ_EXTENSION, inline='ext2', tooltip='Text color for extension boxes')
extension_label_horizontal_alignment = input.string(LABEL_ALIGNMENT_CENTER, INPUT_LABEL_HORIZONTAL, options=[LABEL_ALIGNMENT_LEFT, LABEL_ALIGNMENT_CENTER, LABEL_ALIGNMENT_RIGHT], group=GROUP_MBZ_EXTENSION, inline='ext3', tooltip='Horizontal text alignment')
extension_label_horizontal_padding = input.int(0, INPUT_LABEL_HORIZONTAL_PADDING, minval=0, maxval=MAX_PADDING_HORIZONTAL, group=GROUP_MBZ_EXTENSION, inline='ext3', tooltip='Horizontal padding (0-10 spaces)')
extension_label_vertical_offset = input.int(0, 'V-Offset', minval=-MAX_PADDING_VERTICAL, maxval=MAX_PADDING_VERTICAL, group=GROUP_MBZ_EXTENSION, inline='ext4', tooltip='Vertical offset: + adds newlines after text (down), - adds newlines before text (up) (-5 to +5)')
show_extension_text_inside = input.bool(true, 'Text Inside', group=GROUP_MBZ_EXTENSION, inline='ext4', tooltip='Show text inside the extension box')
show_external_marker = input.bool(true, 'External Marker', group=GROUP_MBZ_EXTENSION, inline='ext5', tooltip='Show tiny box marker on right side of extension')
external_marker_bullish_color = input.color(DEFAULT_EXTERNAL_MARKER_COLOR_BULLISH, 'MBZ⁺', group=GROUP_MBZ_EXTENSION, inline='ext5')
external_marker_bearish_color = input.color(DEFAULT_EXTERNAL_MARKER_COLOR_BEARISH, 'MBZ⁻', group=GROUP_MBZ_EXTENSION, inline='ext5')

// === 🎭 MBZ WICK BEHAVIORS ===
enable_inclusion = input.bool(true, INPUT_LABEL_INCLUSION, group=GROUP_MBZ_BEHAVIORS, inline='behaviors', tooltip='MBZ WICK BEHAVIORS:\n• Inclusion: Wick toward body direction (bullish=lower wick, bearish=upper wick)\n• Reflection: Wick away from body direction (bullish=upper wick, bearish=lower wick)\n\nThese determine MBZ subtype based on dominant wick direction relative to candle body')
enable_reflection = input.bool(true, INPUT_LABEL_REFLECTION, group=GROUP_MBZ_BEHAVIORS, inline='behaviors', tooltip='MBZ BEHAVIORS:\n• Inclusion: Wick toward body direction (bullish=lower wick, bearish=upper wick)\n• Reflection: Wick away from body direction (bullish=upper wick, bearish=lower wick)')

// === 🏷️ MBZ SPECIAL PROPERTIES ===
show_50_percent_tags = input.bool(true, 'Mark 50% Formation MBZs', group=GROUP_MBZ_SPECIAL_PROPERTIES, inline='fifty', tooltip='Add [½] tag when MBZ forms at exactly 50% of mitigation candle')
// Always confirm on midpoint close (at or beyond 50%) - detecting exactly 50% automatically marked with [½]
confirm_on_midpoint_close = true
allow_standard_extreme_equality = input.bool(false, "Standard: allow B = A's extreme", group=GROUP_MBZ_SPECIAL_PROPERTIES, inline='std_eq', tooltip='Relax the Standard liquidity rule so the confirming bar can match (not exceed) the initial sweep extreme.')

// === 🎨 MULTI-SOURCE MBZ ===
enable_multi_source_highlighting = input.bool(true, INPUT_LABEL_SHOW_MULTI_SOURCE_BORDERS, group=GROUP_MULTI_SOURCE_MBZ, inline='multi', tooltip='Display enhanced borders around MBZs formed from multiple liquidity source origins for visual distinction')
multi_source_border_color = input.color(color.new(color.orange, 0), "Color", group=GROUP_MULTI_SOURCE_MBZ, inline='multi', tooltip='Border color for multi-source MBZ highlighting')
multi_source_border_width = input.int(DEFAULT_MULTI_SOURCE_BORDER_WIDTH, INPUT_LABEL_WIDTH, minval=MIN_BORDER_WIDTH, maxval=MAX_BORDER_WIDTH, group=GROUP_MULTI_SOURCE_MBZ, inline='multi', tooltip='Border width for MBZs formed from multiple liquidity source origins (1-5px limit)')
multi_source_strong_display_mode = input.string(MULTI_SOURCE_STRONG_DISPLAY_BOTH, INPUT_LABEL_STRENGTH_TAG, options=[MULTI_SOURCE_STRONG_DISPLAY_OFF, MULTI_SOURCE_STRONG_DISPLAY_LABEL, MULTI_SOURCE_STRONG_DISPLAY_EXTENSION, MULTI_SOURCE_STRONG_DISPLAY_BOTH], group=GROUP_MULTI_SOURCE_MBZ, inline='multi_strong_toggle', tooltip='Where to show the [STRONG] marker when the consolidated zone meets the multi-source strength criteria.')
strong_label_position_above = input.bool(true, '[STRONG] Above Extension Text', group=GROUP_MULTI_SOURCE_MBZ, inline='multi_strong_toggle', tooltip='Position [STRONG] label above extension text (ON) or below (OFF)')
multi_source_strong_min_sources = input.int(DEFAULT_MULTI_SOURCE_STRENGTH_MIN_SOURCES, INPUT_LABEL_MIN_SOURCES, minval=MIN_MULTI_SOURCE_STRENGTH_MIN_SOURCES, maxval=MAX_MULTI_SOURCE_STRENGTH_MIN_SOURCES, group=GROUP_MULTI_SOURCE_MBZ, inline='multi_strong_logic', tooltip='Minimum number of MBZ source regions consolidated on the candle before [STRONG] is applied.')
multi_source_strong_include_distinct = input.bool(true, 'Distinct Types', group=GROUP_MULTI_SOURCE_MBZ, inline='multi_strong_logic', tooltip='Mark [STRONG] when the consolidated MBZ blends different liquidity source types (e.g., daily + weekly).')
multi_source_strong_include_same = input.bool(false, 'Same Type', group=GROUP_MULTI_SOURCE_MBZ, inline='multi_strong_logic', tooltip='Mark [STRONG] when the consolidated MBZ is built from the same source type repeated (e.g., daily×2).')

// === 📈 PROJECTIONS === (Removed to reduce external elements)

// === ⚡ PERFORMANCE PROFILING ===
show_profiling = input.bool(false, "Profiling Table", group=GROUP_PERFORMANCE_PROFILING, tooltip='Display performance metrics table')
profiling_mode = input.string("Compact", "Mode", options=["Full", "Compact"], group=GROUP_PERFORMANCE_PROFILING, tooltip='Full: Show all metrics | Compact: Only show time mode')

// Profiling constants (hardcoded to reduce external elements)
profiling_table_text_size = TEXT_SIZE_TINY
profiling_table_bg_color = color.black
profiling_header_bg_color = color.new(color.gray, 50)
profiling_header_text_color = color.white

// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS & DATA STRUCTURES
// ═══════════════════════════════════════════════════════════════════════════════


// MBZ tracking
type MBZRecord
    int bar_index
    int formation_time  // Store time to avoid historical buffer limits with xloc.bar_time
    float high_price
    float low_price
    float mbz_open
    float mbz_close
    bool is_bullish
    bool is_invalidated
    float max_fill_percentage
    bool has_dominant_wick
    bool is_exactly_50_percent
    string mbz_subtype
    string cached_label_text
    string cached_tooltip
    float cached_zone_top
    float cached_zone_bottom
    bool cached_data_valid
    label mbz_label
    int source_id
    // Cached source geometry retained with each record
    int source_bar_index
    float source_high
    float source_low
    string source_family
    string source_type
    string pool_boundary
    bool wicked_deeper_into_source    // Track if wick penetrated deeper into the source origin
    bool reflection_pattern_deeper // Track if reflection pattern wick was deeper
    string variant               // Variant that produced this MBZ (imbalance/liquidity)
    string formation_rule          // Formation rule (e.g., imbalance_standard, liquidity_standard)
    string source_origin_token   // Unified token describing the origin (e.g., fvg, daily)

type LiquidityPoolCollection
    array<float> highs
    array<float> lows
    array<int> high_times
    array<int> low_times
    array<int> session_close_times
    array<bool> high_breached
    array<bool> low_breached
    array<int> high_breach_times
    array<int> low_breach_times
    array<int> high_origin_bar_indices
    array<int> low_origin_bar_indices
    array<int> high_first_breach_bars
    array<int> low_first_breach_bars
    array<bool> high_mitigated_flags
    array<bool> low_mitigated_flags
    array<int> high_mitigation_bars
    array<int> low_mitigation_bars
    array<bool> high_used_by_pattern
    array<bool> low_used_by_pattern
    float current_high
    float current_low
    int current_high_time
    int current_low_time
    int current_session_start_time
    int current_high_origin_bar_index
    int current_low_origin_bar_index
    int current_high_first_breach_bar
    int current_low_first_breach_bar
    bool current_high_mitigated
    bool current_low_mitigated
    int current_high_mitigation_bar
    int current_low_mitigation_bar
    int first_unbreached_high_index
    int first_unbreached_low_index

// DTT Session tracking
type DttSession
    string name                    // Session name (e.g., "Judas")
    string prev_session_name       // Previous session name for cascade (e.g., "NY Open")
    int start_time_hhmm            // Start time in HHMM format
    int end_time_hhmm              // End time in HHMM format
    int start_bar                  // Bar index when session started (na if not started)
    int end_bar                    // Bar index when session ended (na if not ended)
    float session_high             // High price during session
    float session_low              // Low price during session
    int high_bar                   // Bar index of high
    int low_bar                    // Bar index of low
    bool high_breached             // Previous session's high was breached
    bool low_breached              // Previous session's low was breached
    int high_breach_bar            // Bar where high breach occurred
    int low_breach_bar             // Bar where low breach occurred
    bool high_pattern_checked      // High breach pattern already checked
    bool low_pattern_checked       // Low breach pattern already checked
    line start_boundary_line       // Visual: session start line
    line end_boundary_line         // Visual: session end line
    line prev_high_line            // Visual: previous session high
    line prev_low_line             // Visual: previous session low
    label session_label            // Visual: session name label

