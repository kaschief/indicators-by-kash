                    needs_visual_update := true

        if actual_enable_lunch and not skip_sunday_liquidity
            [lunch_events_is_high, lunch_events_rules, lunch_events_is_exact, lunch_events_source_price, lunch_events_source_bar_index] = process_liquidity_pool(lunch_session_pool, LIQUIDITY_SOURCE_TYPE_LUNCH, lunch_scan_cap, enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

            // Create MBZ records from Lunch session events
            lunch_event_count = array.size(lunch_events_is_high)
            if lunch_event_count > 0
                for event_index = 0 to lunch_event_count - 1
                    event_is_high = array.get(lunch_events_is_high, event_index)
                    event_rule = array.get(lunch_events_rules, event_index)
                    event_is_exact = array.get(lunch_events_is_exact, event_index)
                    event_source_price = array.get(lunch_events_source_price, event_index)
                    event_source_bar_index = array.get(lunch_events_source_bar_index, event_index)

                    pool_boundary = event_is_high ? POOL_BOUNDARY_HIGH : POOL_BOUNDARY_LOW
                    is_bullish_event = not event_is_high

                    create_liquidity_mbz_record(
                         bar_index,
                         b_open,
                         b_high,
                         b_low,
                         b_close,
                         LIQUIDITY_SOURCE_TYPE_LUNCH,
                         pool_boundary,
                         event_rule,
                         event_source_price,
                         event_source_bar_index,
                         is_bullish_event,
                         LIQUIDITY_SOURCE_TYPE_LUNCH,
                         event_is_exact,
                         lunch_session_pool,
                         event_is_high
                     )

                    needs_visual_update := true

        if enable_nypm_liquidity and not skip_sunday_liquidity
            [nypm_events_is_high, nypm_events_rules, nypm_events_is_exact, nypm_events_source_price, nypm_events_source_bar_index] = process_liquidity_pool(nypm_session_pool, LIQUIDITY_SOURCE_TYPE_NYPM, nypm_scan_cap, enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

            // Create MBZ records from NY PM session events
            nypm_event_count = array.size(nypm_events_is_high)
            nypm_token = nine_times_mode == NINE_MODE_NINE_ONLY ? LIQUIDITY_SOURCE_TYPE_NYPM_NINE : LIQUIDITY_SOURCE_TYPE_NYPM
            if nypm_event_count > 0
                for event_index = 0 to nypm_event_count - 1
                    event_is_high = array.get(nypm_events_is_high, event_index)
                    event_rule = array.get(nypm_events_rules, event_index)
                    event_is_exact = array.get(nypm_events_is_exact, event_index)
                    event_source_price = array.get(nypm_events_source_price, event_index)
                    event_source_bar_index = array.get(nypm_events_source_bar_index, event_index)

                    pool_boundary = event_is_high ? POOL_BOUNDARY_HIGH : POOL_BOUNDARY_LOW
                    is_bullish_event = not event_is_high

                    create_liquidity_mbz_record(
                         bar_index,
                         b_open,
                         b_high,
                         b_low,
                         b_close,
                         nypm_token,
                         pool_boundary,
                         event_rule,
                         event_source_price,
                         event_source_bar_index,
                         is_bullish_event,
                         nypm_token,
                         event_is_exact,
                         nypm_session_pool,
                         event_is_high
                     )

                    needs_visual_update := true

        // NY PM NINE variant pool processing (Both mode)
        if enable_nine_variants and enable_nypm_liquidity and not skip_sunday_liquidity
            [nypm_nine_events_is_high, nypm_nine_events_rules, nypm_nine_events_is_exact, nypm_nine_events_source_price, nypm_nine_events_source_bar_index] = process_liquidity_pool(nypm_nine_pool, LIQUIDITY_SOURCE_TYPE_NYPM_NINE, nypm_scan_cap, enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

            nypm_nine_event_count = array.size(nypm_nine_events_is_high)
            if nypm_nine_event_count > 0
                for event_index = 0 to nypm_nine_event_count - 1
                    event_is_high = array.get(nypm_nine_events_is_high, event_index)
                    event_rule = array.get(nypm_nine_events_rules, event_index)
                    event_is_exact = array.get(nypm_nine_events_is_exact, event_index)
                    event_source_price = array.get(nypm_nine_events_source_price, event_index)
                    event_source_bar_index = array.get(nypm_nine_events_source_bar_index, event_index)

                    pool_boundary = event_is_high ? POOL_BOUNDARY_HIGH : POOL_BOUNDARY_LOW
                    is_bullish_event = not event_is_high

                    create_liquidity_mbz_record(bar_index, b_open, b_high, b_low, b_close, LIQUIDITY_SOURCE_TYPE_NYPM_NINE, pool_boundary, event_rule, event_source_price, event_source_bar_index, is_bullish_event, LIQUIDITY_SOURCE_TYPE_NYPM_NINE, event_is_exact, nypm_nine_pool, event_is_high)

                    needs_visual_update := true

        if enable_ons_liquidity and not skip_sunday_liquidity
            [ons_events_is_high, ons_events_rules, ons_events_is_exact, ons_events_source_price, ons_events_source_bar_index] = process_liquidity_pool(ons_session_pool, LIQUIDITY_SOURCE_TYPE_ONS, ons_scan_cap, enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

            // Create MBZ records from ONS session events
            ons_event_count = array.size(ons_events_is_high)
            if ons_event_count > 0
                for event_index = 0 to ons_event_count - 1
                    event_is_high = array.get(ons_events_is_high, event_index)
                    event_rule = array.get(ons_events_rules, event_index)
                    event_is_exact = array.get(ons_events_is_exact, event_index)
                    event_source_price = array.get(ons_events_source_price, event_index)
                    event_source_bar_index = array.get(ons_events_source_bar_index, event_index)

                    pool_boundary = event_is_high ? POOL_BOUNDARY_HIGH : POOL_BOUNDARY_LOW
                    is_bullish_event = not event_is_high

                    create_liquidity_mbz_record(
                         bar_index,
                         b_open,
                         b_high,
                         b_low,
                         b_close,
                         LIQUIDITY_SOURCE_TYPE_ONS,
                         pool_boundary,
                         event_rule,
                         event_source_price,
                         event_source_bar_index,
                         is_bullish_event,
                         LIQUIDITY_SOURCE_TYPE_ONS,
                         event_is_exact,
                         ons_session_pool,
                         event_is_high
                     )

                    needs_visual_update := true

        if enable_premarket_liquidity and not skip_sunday_liquidity
            [premarket_events_is_high, premarket_events_rules, premarket_events_is_exact, premarket_events_source_price, premarket_events_source_bar_index] = process_liquidity_pool(premarket_session_pool, LIQUIDITY_SOURCE_TYPE_PREMARKET, premarket_scan_cap, enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

            // Create MBZ records from Premarket session events
            premarket_event_count = array.size(premarket_events_is_high)
            if premarket_event_count > 0
                for event_index = 0 to premarket_event_count - 1
                    event_is_high = array.get(premarket_events_is_high, event_index)
                    event_rule = array.get(premarket_events_rules, event_index)
                    event_is_exact = array.get(premarket_events_is_exact, event_index)
                    event_source_price = array.get(premarket_events_source_price, event_index)
                    event_source_bar_index = array.get(premarket_events_source_bar_index, event_index)

                    pool_boundary = event_is_high ? POOL_BOUNDARY_HIGH : POOL_BOUNDARY_LOW
                    is_bullish_event = not event_is_high

                    create_liquidity_mbz_record(
                         bar_index,
                         b_open,
                         b_high,
                         b_low,
                         b_close,
                         LIQUIDITY_SOURCE_TYPE_PREMARKET,
                         pool_boundary,
                         event_rule,
                         event_source_price,
                         event_source_bar_index,
                         is_bullish_event,
                         LIQUIDITY_SOURCE_TYPE_PREMARKET,
                         event_is_exact,
                         premarket_session_pool,
                         event_is_high
                     )

                    needs_visual_update := true

        // ─────────────────────────────────────────────────────────────────────────
        // DTT SESSIONS - Process pattern detection and create MBZ records
        // ─────────────────────────────────────────────────────────────────────────
        if enable_dtt_sessions and enable_dtt_liquidity_tracking
            [dtt_events_is_high, dtt_events_rules, dtt_events_is_exact, dtt_events_source_price, dtt_events_source_bar_index, dtt_events_session_name] = process_dtt_sessions(enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

            // Create MBZ records from DTT session events
            dtt_event_count = array.size(dtt_events_is_high)
            if dtt_event_count > 0
                for event_index = 0 to dtt_event_count - 1
                    event_is_high = array.get(dtt_events_is_high, event_index)
                    event_rule = array.get(dtt_events_rules, event_index)
                    event_is_exact = array.get(dtt_events_is_exact, event_index)
                    event_source_price = array.get(dtt_events_source_price, event_index)
                    event_source_bar_index = array.get(dtt_events_source_bar_index, event_index)
                    event_session_name = array.get(dtt_events_session_name, event_index)

                    pool_boundary = event_is_high ? POOL_BOUNDARY_HIGH : POOL_BOUNDARY_LOW
                    is_bullish_event = not event_is_high

                    // Create source string in format "dtt: sessionname"
                    dtt_source = "dtt: " + get_dtt_session_name_lower(event_session_name)

                    create_liquidity_mbz_record(
                         bar_index,
                         b_open,
                         b_high,
                         b_low,
                         b_close,
                         dtt_source,            // Source in "dtt: sessionname" format
                         pool_boundary,
                         event_rule,
                         event_source_price,
                         event_source_bar_index,
                         is_bullish_event,
                         dtt_source,            // Origin also shows DTT session
                         event_is_exact,
                         dtt_dummy_pool,        // Pass dummy pool (DTT doesn't use pool collection)
                         event_is_high
                     )

                    needs_visual_update := true

// PERFORMANCE OPTIMIZATION: Skip historical processing for instant loading
if ENABLE_HISTORICAL_BACKFILL and not initialized and barstate.islastconfirmedhistory
    // Historical backfill processing would go here (currently disabled)
    initialized := true
else if not initialized
    // Skip historical processing - start fresh for instant loading
    initialized := true

// PERF: Update all_records_index in active_mbz_records after removal from all_mbz_records
// When a record is removed, all indices > removed_idx shift down by 1
update_indices_after_removal(int removed_idx) =>
    if array.size(active_mbz_records) > 0
        for i = 0 to array.size(active_mbz_records) - 1
            rec = array.get(active_mbz_records, i)
            if rec.all_records_index > removed_idx
                rec.all_records_index := rec.all_records_index - 1
                array.set(active_mbz_records, i, rec)

// PERFORMANCE: Aggressive garbage collection of invalidated MBZs
// Philosophy: Invalidated MBZs are for display/analysis only (use replay mode for deep inspection)
// Keep ONLY what user wants to display, delete everything else immediately (free capacity for active MBZs)
// OPTIMIZATION: Only run on live bars or end of history (skip during historical load for speed)
should_run_garbage_collection = barstate.islastconfirmedhistory or barstate.islast
if should_run_garbage_collection and array.size(all_mbz_records) > 0
    invalidated_count = 0
    invalidated_indices = array.new_int()

    // Count invalidated MBZs and track their indices (oldest first)
    for i = 0 to array.size(all_mbz_records) - 1
        if array.get(all_mbz_records, i).is_invalidated
            invalidated_count += 1
            array.push(invalidated_indices, i)

    // Determine how many invalidated to keep
    // If "Show Invalidated" is OFF: keep 0 (delete all)
    // If "Show Invalidated" is ON: keep max_invalidated_mbzs (user's display quota)
    keep_invalidated = show_invalidated_mbzs ? max_invalidated_mbzs_effective : 0
    excess_invalidated = invalidated_count - keep_invalidated

    if excess_invalidated > 0
        // AGGRESSIVE: Delete ALL excess invalidated MBZs (free capacity immediately)
        removed = 0
        for idx = 0 to array.size(invalidated_indices) - 1
            if removed >= excess_invalidated
                break

            invalidated_idx = array.get(invalidated_indices, idx)
            adjusted_idx = invalidated_idx - removed  // Adjust for previous removals
            array.remove(all_mbz_records, adjusted_idx)
            update_indices_after_removal(adjusted_idx)  // PERF: Keep indices in sync

            removed += 1

// Clean up old records and visual elements
while array.size(all_mbz_records) > max_mbz_records_effective
    oldest_record = array.get(all_mbz_records, 0)  // Get before removing
    array.shift(all_mbz_records)
    update_indices_after_removal(0)  // PERF: Keep indices in sync after shift

    // PERFORMANCE: Also remove from active array if it's still there (not invalidated yet)
    if not oldest_record.is_invalidated
        for active_idx = 0 to array.size(active_mbz_records) - 1
            active_rec = array.get(active_mbz_records, active_idx)
            if active_rec.bar_index == oldest_record.bar_index and
               active_rec.source_type == oldest_record.source_type and
               active_rec.is_bullish == oldest_record.is_bullish
                array.remove(active_mbz_records, active_idx)
                break

while array.size(mbz_body_highlights) > max_body_highlights_effective
    box.delete(array.shift(mbz_body_highlights))

while array.size(mbz_wick_highlights) > max_wick_highlights_effective
    box.delete(array.shift(mbz_wick_highlights))

while array.size(mbz_extended_boxes) > max_extended_boxes_effective
    box.delete(array.shift(mbz_extended_boxes))

// PERFORMANCE OPTIMIZED: Only check active (non-invalidated) MBZs
// This avoids wasting checks on already-invalidated records every bar
// CRITICAL OPTIMIZATION: Always sync invalidations (required for display), but skip confirmation status syncs during history
should_sync_confirmation_status = barstate.islastconfirmedhistory or barstate.islast
if array.size(active_mbz_records) > 0
    for i = array.size(active_mbz_records) - 1 to 0
        mbz_record = array.get(active_mbz_records, i)

        // Update confirmation status first
        updated_mbz = check_mbz_confirmation(mbz_record)
        // Check for invalidation using enhanced source detection
        should_invalidate = should_mbz_be_invalidated_enhanced(updated_mbz, open, close)

        if should_invalidate
            updated_mbz.is_invalidated := true
            updated_mbz.cached_data_valid := false  // Invalidate cache
            needs_visual_update := true

            // Update in active array
            array.set(active_mbz_records, i, updated_mbz)

            // PERF: Direct O(1) sync to all_mbz_records using index mapping
            if updated_mbz.all_records_index >= 0 and updated_mbz.all_records_index < array.size(all_mbz_records)
                array.set(all_mbz_records, updated_mbz.all_records_index, updated_mbz)

            // Remove from active array (no longer needs invalidation checks)
            array.remove(active_mbz_records, i)
        else
            // Still active, just update confirmation status in active array
            array.set(active_mbz_records, i, updated_mbz)

            // PERF: Only sync confirmation status during display (not every bar during history)
            // Direct O(1) sync using index mapping instead of O(n) loop
            if should_sync_confirmation_status
                if updated_mbz.all_records_index >= 0 and updated_mbz.all_records_index < array.size(all_mbz_records)
                    array.set(all_mbz_records, updated_mbz.all_records_index, updated_mbz)

if not na(liquidity_variant_placeholder_label)
    label.delete(liquidity_variant_placeholder_label)
    liquidity_variant_placeholder_label := na

// ═══════════════════════════════════════════════════════════════════════════════
// VISUAL MANAGEMENT - CONSOLIDATED SYSTEM // ═══════════════════════════════════════════════════════════════════════════════

// PERFORMANCE OPTIMIZED: Smart visual update system - only when truly necessary
// Defer visual updates during historical load (fast initial render: 5-10x faster)
// Update only at: end of history (islastconfirmedhistory), live bars, or full update requests
should_update_visuals = needs_full_update or barstate.islastconfirmedhistory or (barstate.islast and (needs_visual_update or bar_index != last_update_bar))

if should_update_visuals
    [debug_examined, debug_liq_added, debug_daily_added, debug_weekly_added, debug_monthly_added, debug_asia_added, debug_rejected] = manage_consolidated_mbz_display()

    // PROFILING: Track display results after function completes
    last_update_bar := bar_index
    needs_full_update := false
    needs_visual_update := false


// ═══════════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.isconfirmed
    array.clear(mbz_alert_parts)

    if array.size(last_consolidated_mbzs) > 0
        for i = 0 to array.size(last_consolidated_mbzs) - 1
            consolidated_mbz = array.get(last_consolidated_mbzs, i)
            if consolidated_mbz.bar_index == bar_index
                alert_msg = build_alert_message_from_consolidated(consolidated_mbz)
                array.push(mbz_alert_parts, alert_msg)

    mbz_grouped_alert_active := array.size(mbz_alert_parts) > 0

    if mbz_grouped_alert_active
        alert_message = ""
        tf = str.tostring(timeframe.period)

        for i = 0 to array.size(mbz_alert_parts) - 1
            if i > 0
                alert_message := alert_message + " | "
            alert_message := alert_message + array.get(mbz_alert_parts, i)

        alert(alert_message + " • " + tf)

// ═══════════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE
// ═══════════════════════════════════════════════════════════════════════════════

if show_color_table and barstate.islast
    var table color_table = table.new(position.top_right, 4, 10, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

    // Header row
    table.cell(color_table, 0, 0, "Color", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(color_table, 1, 0, "Line", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(color_table, 2, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(color_table, 3, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)

    // Extended Box Bullish
    table.cell(color_table, 0, 1, "MBZ⁺ Ext", text_size=size.small)
    table.cell(color_table, 1, 1, "596", text_size=size.small)
    table.cell(color_table, 2, 1, str.format("R:{0} G:{1} B:{2}", int(color.r(extended_box_bullish_color)), int(color.g(extended_box_bullish_color)), int(color.b(extended_box_bullish_color))), text_size=size.small)
    table.cell(color_table, 3, 1, str.tostring(int(color.t(extended_box_bullish_color))), text_size=size.small)

    // Extended Box Bearish
    table.cell(color_table, 0, 2, "MBZ⁻ Ext", text_size=size.small)
    table.cell(color_table, 1, 2, "597", text_size=size.small)
    table.cell(color_table, 2, 2, str.format("R:{0} G:{1} B:{2}", int(color.r(extended_box_bearish_color)), int(color.g(extended_box_bearish_color)), int(color.b(extended_box_bearish_color))), text_size=size.small)
    table.cell(color_table, 3, 2, str.tostring(int(color.t(extended_box_bearish_color))), text_size=size.small)

    // Extended Box Text Color
    table.cell(color_table, 0, 3, "Ext Label", text_size=size.small)
    table.cell(color_table, 1, 3, "601", text_size=size.small)
    table.cell(color_table, 2, 3, str.format("R:{0} G:{1} B:{2}", int(color.r(extended_box_text_color)), int(color.g(extended_box_text_color)), int(color.b(extended_box_text_color))), text_size=size.small)
    table.cell(color_table, 3, 3, str.tostring(int(color.t(extended_box_text_color))), text_size=size.small)

    // Daily Liquidity Color
    table.cell(color_table, 0, 4, "Daily Liq", text_size=size.small)
    table.cell(color_table, 1, 4, "527", text_size=size.small)
    table.cell(color_table, 2, 4, str.format("R:{0} G:{1} B:{2}", int(color.r(daily_liquidity_color)), int(color.g(daily_liquidity_color)), int(color.b(daily_liquidity_color))), text_size=size.small)
    table.cell(color_table, 3, 4, str.tostring(int(color.t(daily_liquidity_color))), text_size=size.small)

    // Weekly Liquidity Color
    table.cell(color_table, 0, 5, "Weekly Liq", text_size=size.small)
    table.cell(color_table, 1, 5, "530", text_size=size.small)
    table.cell(color_table, 2, 5, str.format("R:{0} G:{1} B:{2}", int(color.r(weekly_liquidity_color)), int(color.g(weekly_liquidity_color)), int(color.b(weekly_liquidity_color))), text_size=size.small)
    table.cell(color_table, 3, 5, str.tostring(int(color.t(weekly_liquidity_color))), text_size=size.small)

    // Monthly Liquidity Color
    table.cell(color_table, 0, 6, "Monthly Liq", text_size=size.small)
    table.cell(color_table, 1, 6, "533", text_size=size.small)
    table.cell(color_table, 2, 6, str.format("R:{0} G:{1} B:{2}", int(color.r(monthly_liquidity_color)), int(color.g(monthly_liquidity_color)), int(color.b(monthly_liquidity_color))), text_size=size.small)
    table.cell(color_table, 3, 6, str.tostring(int(color.t(monthly_liquidity_color))), text_size=size.small)

    // Intraday Liquidity Color
    table.cell(color_table, 0, 7, "Intraday Liq", text_size=size.small)
    table.cell(color_table, 1, 7, "536", text_size=size.small)
    table.cell(color_table, 2, 7, str.format("R:{0} G:{1} B:{2}", int(color.r(intraday_liquidity_color)), int(color.g(intraday_liquidity_color)), int(color.b(intraday_liquidity_color))), text_size=size.small)
    table.cell(color_table, 3, 7, str.tostring(int(color.t(intraday_liquidity_color))), text_size=size.small)

    // DTT Liquidity Color
    table.cell(color_table, 0, 8, "DTT Liq", text_size=size.small)
    table.cell(color_table, 1, 8, "539", text_size=size.small)
    table.cell(color_table, 2, 8, str.format("R:{0} G:{1} B:{2}", int(color.r(dtt_liquidity_color)), int(color.g(dtt_liquidity_color)), int(color.b(dtt_liquidity_color))), text_size=size.small)
    table.cell(color_table, 3, 8, str.tostring(int(color.t(dtt_liquidity_color))), text_size=size.small)

// ═══════════════════════════════════════════════════════════════════════════════
// SESSION TIMES TABLE
// ═══════════════════════════════════════════════════════════════════════════════

if show_session_times_table and barstate.islast
    // Determine table structure based on mode
    is_both_mode = nine_times_mode == NINE_MODE_BOTH
    is_nine_only = nine_times_mode == NINE_MODE_NINE_ONLY

    // Table dimensions: Both mode = 3 columns (Label, Standard, NINE), Others = 2 columns (Label, Time)
    num_columns = is_both_mode ? 3 : 2
    num_rows = is_both_mode ? 10 : 8  // Both: 10 (title + header + 8 sessions), Others: 8 (title + 7 sessions including Lunch)

    var table session_times_table = table.new(position.bottom_right, num_columns, num_rows, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

    // Build title based on mode
    title = nine_times_mode == NINE_MODE_STANDARD ? "STANDARD SESSION TIMES" : nine_times_mode == NINE_MODE_NINE_ONLY ? "SESSION TIMES -9" : "SESSION TIMES (BOTH)"

    if is_both_mode
        // Both mode: Show side-by-side columns
        table.cell(session_times_table, 0, 0, title, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
        table.merge_cells(session_times_table, 0, 0, 2, 0)  // Merge title across all columns

        // Column headers
        table.cell(session_times_table, 0, 1, "", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
        table.cell(session_times_table, 1, 1, "Standard", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
        table.cell(session_times_table, 2, 1, "NINE", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)

        // Session rows
        table.cell(session_times_table, 0, 2, "Asia", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
        table.cell(session_times_table, 1, 2, STANDARD_ASIA_TIME, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
        table.cell(session_times_table, 2, 2, NINE_ASIA_TIME, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)

        table.cell(session_times_table, 0, 3, "London", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
        table.cell(session_times_table, 1, 3, STANDARD_LONDON_TIME, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
        table.cell(session_times_table, 2, 3, NINE_LONDON_TIME, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)

        table.cell(session_times_table, 0, 4, "NY AM", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
        table.cell(session_times_table, 1, 4, STANDARD_NYAM_TIME, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
        table.cell(session_times_table, 2, 4, NINE_NYAM_TIME, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)

        table.cell(session_times_table, 0, 5, "Lunch", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
        table.cell(session_times_table, 1, 5, STANDARD_LUNCH_TIME, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
        table.cell(session_times_table, 2, 5, "─────────", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)

        table.cell(session_times_table, 0, 6, "NY PM", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
        table.cell(session_times_table, 1, 6, STANDARD_NYPM_TIME, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
        table.cell(session_times_table, 2, 6, NINE_NYPM_TIME, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)

        // Empty row for spacing
        table.cell(session_times_table, 0, 7, "", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
        table.merge_cells(session_times_table, 0, 7, 2, 7)

        table.cell(session_times_table, 0, 8, "ONS", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
        table.cell(session_times_table, 1, 8, STANDARD_ONS_TIME, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
        table.cell(session_times_table, 2, 8, "", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)

        table.cell(session_times_table, 0, 9, "Premarket", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
        table.cell(session_times_table, 1, 9, STANDARD_PREMARKET_TIME, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
        table.cell(session_times_table, 2, 9, "", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
    else
        // Standard or NINE Only mode: Single column
        table.cell(session_times_table, 0, 0, title, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
        table.merge_cells(session_times_table, 0, 0, 1, 0)  // Merge title across both columns

        if is_nine_only
            // NINE Only mode
            table.cell(session_times_table, 0, 1, "Asia", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
            table.cell(session_times_table, 1, 1, NINE_ASIA_TIME, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)

            table.cell(session_times_table, 0, 2, "London", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
            table.cell(session_times_table, 1, 2, NINE_LONDON_TIME, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)

            table.cell(session_times_table, 0, 3, "NY AM", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
            table.cell(session_times_table, 1, 3, NINE_NYAM_TIME, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)

            table.cell(session_times_table, 0, 4, "Lunch", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
            table.cell(session_times_table, 1, 4, "─────────", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)

            table.cell(session_times_table, 0, 5, "NY PM", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
            table.cell(session_times_table, 1, 5, NINE_NYPM_TIME, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)

            table.cell(session_times_table, 0, 6, "ONS", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
            table.cell(session_times_table, 1, 6, STANDARD_ONS_TIME, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)

            table.cell(session_times_table, 0, 7, "Premarket", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
            table.cell(session_times_table, 1, 7, STANDARD_PREMARKET_TIME, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
        else
            // Standard mode
            table.cell(session_times_table, 0, 1, "Asia", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
            table.cell(session_times_table, 1, 1, STANDARD_ASIA_TIME, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)

            table.cell(session_times_table, 0, 2, "London", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
            table.cell(session_times_table, 1, 2, STANDARD_LONDON_TIME, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)

            table.cell(session_times_table, 0, 3, "NY AM", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
            table.cell(session_times_table, 1, 3, STANDARD_NYAM_TIME, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)

            table.cell(session_times_table, 0, 4, "Lunch", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
            table.cell(session_times_table, 1, 4, STANDARD_LUNCH_TIME, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)

            table.cell(session_times_table, 0, 5, "NY PM", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
            table.cell(session_times_table, 1, 5, STANDARD_NYPM_TIME, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)

            table.cell(session_times_table, 0, 6, "ONS", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
            table.cell(session_times_table, 1, 6, STANDARD_ONS_TIME, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)

            table.cell(session_times_table, 0, 7, "Premarket", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)
            table.cell(session_times_table, 1, 7, STANDARD_PREMARKET_TIME, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// STATUS TABLE
// ═══════════════════════════════════════════════════════════════════════════════

if show_status_table and barstate.islast
    // Check if all liquidity sources enabled
    all_htf_enabled = enable_daily_liquidity and enable_weekly_liquidity and enable_monthly_liquidity
    all_intraday_enabled = enable_asia_liquidity and enable_london_liquidity and enable_nyam_liquidity and enable_lunch_liquidity and enable_nypm_liquidity and enable_ons_liquidity and enable_premarket_liquidity
    any_intraday_enabled = enable_asia_liquidity or enable_london_liquidity or enable_nyam_liquidity or enable_lunch_liquidity or enable_nypm_liquidity or enable_ons_liquidity or enable_premarket_liquidity
    all_sources_enabled = all_htf_enabled and all_intraday_enabled and enable_dtt_sessions

    // Build sources string
    source_parts = array.new<string>()

    if all_sources_enabled
        array.push(source_parts, STATUS_DISPLAY_ALL)
    else
        // HTF sources
        if all_htf_enabled
            array.push(source_parts, STATUS_DISPLAY_HTF)
        else
            htf_parts = array.new<string>()
            if enable_daily_liquidity
                array.push(htf_parts, STATUS_DISPLAY_DAILY)
            if enable_weekly_liquidity
                array.push(htf_parts, STATUS_DISPLAY_WEEKLY)
            if enable_monthly_liquidity
                array.push(htf_parts, STATUS_DISPLAY_MONTHLY)
            if array.size(htf_parts) > 0
                array.push(source_parts, array.join(htf_parts, "·"))

        // Intraday
        if all_intraday_enabled
            array.push(source_parts, STATUS_DISPLAY_INTRA)
        else if any_intraday_enabled
            array.push(source_parts, STATUS_DISPLAY_INTRA_PARTIAL)

        // DTT
        if enable_dtt_sessions
            array.push(source_parts, STATUS_DISPLAY_DTT)

    sources_text = array.join(source_parts, "  ")

    // Get invalidation threshold display
    inv_display = switch mbz_invalidation_mode
        INVALIDATION_STANDARD => STATUS_DISPLAY_INV_100
        INVALIDATION_CONSERVATIVE => STATUS_DISPLAY_INV_85
        INVALIDATION_STRICT => STATUS_DISPLAY_INV_55
        => "[" + str.tostring(int(custom_threshold_percent)) + "]"

    // Build status text (WS only shown if active)
    status_text = workspace_active ? STATUS_DISPLAY_WS + "  " + sources_text : sources_text
    status_text := extend_to_reference_wick ? status_text + "  " + SUBTYPE_EXT_DISPLAY : status_text
    status_text := status_text + "  " + inv_display

    // Create table with offset padding
    // Offset adds space characters to shift content left (negative) or right (positive)
    var table status_table = table.new(position.bottom_center, 4, 1, border_width=0)

    left_pad = status_table_offset < 0 ? "" : str.repeat(" ", status_table_offset * 3)
    right_pad = status_table_offset > 0 ? "" : str.repeat(" ", math.abs(status_table_offset) * 3)

    // Left padding cell
    table.cell(status_table, 0, 0, left_pad, bgcolor=color.new(color.white, 100), text_size=size.tiny)

    // Title cell: white text on black background
    table.cell(status_table, 1, 0, "mbz prime •", bgcolor=color.black, text_color=color.white, text_size=size.tiny)

    // Status cell: black text on white background
    table.cell(status_table, 2, 0, status_text, bgcolor=color.new(color.rgb(245, 245, 245), 20), text_color=color.black, text_size=size.tiny)

    // Right padding cell
    table.cell(status_table, 3, 0, right_pad, bgcolor=color.new(color.white, 100), text_size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
