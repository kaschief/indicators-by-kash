                         event_source_price,
                         event_source_bar_index,
                         is_bullish_event,
                         nyam_token,
                         event_is_exact,
                         nyam_session_pool,
                         event_is_high
                     )

                    needs_visual_update := true

        // NY AM NINE variant pool processing (Both mode)
        if enable_nine_variants and enable_nyam_liquidity and not skip_sunday_liquidity
            [nyam_nine_events_is_high, nyam_nine_events_rules, nyam_nine_events_is_exact, nyam_nine_events_source_price, nyam_nine_events_source_bar_index] = process_liquidity_pool(nyam_nine_pool, LIQUIDITY_SOURCE_TYPE_NYAM_NINE, nyam_scan_cap, enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

            nyam_nine_event_count = array.size(nyam_nine_events_is_high)
            if nyam_nine_event_count > 0
                for event_index = 0 to nyam_nine_event_count - 1
                    event_is_high = array.get(nyam_nine_events_is_high, event_index)
                    event_rule = array.get(nyam_nine_events_rules, event_index)
                    event_is_exact = array.get(nyam_nine_events_is_exact, event_index)
                    event_source_price = array.get(nyam_nine_events_source_price, event_index)
                    event_source_bar_index = array.get(nyam_nine_events_source_bar_index, event_index)

                    pool_boundary = event_is_high ? POOL_BOUNDARY_HIGH : POOL_BOUNDARY_LOW
