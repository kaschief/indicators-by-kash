// Additional Visual & Performance Constants
MIN_BORDER_WIDTH = 1
MAX_BORDER_WIDTH = 5

// Using xloc.bar_time avoids Pine's xloc.bar_index buffer limit (~348 bars with complex scripts)
// Now limited only by Pine's 500 object limit (boxes/labels/lines) and performance
MAX_RENDERABLE_BAR_AGE = 5000
ENABLE_HISTORICAL_BACKFILL = false
MBZ_BULLISH_SUFFIX = "⁺"
MBZ_BEARISH_SUFFIX = "⁻"
FIFTY_PERCENT_TAG = " [½]"

// Visual & Input Defaults
DEFAULT_EXTENSION_BARS = 12
