if enable_dtt_sessions
    // Get current time in HHMM format (NY timezone)
    current_hour = hour(time, NY_TIMEZONE)
    current_minute = minute(time, NY_TIMEZONE)
    current_time_hhmm = current_hour * 100 + current_minute

    // ─────────────────────────────────────────────────────────────────────────
    // STEP 1: Mark sessions as ended if we've left their time range
    // ─────────────────────────────────────────────────────────────────────────
    if array.size(dtt_session_instances) > 0
        for i = array.size(dtt_session_instances) - 1 to 0
            sess = array.get(dtt_session_instances, i)
            if not na(sess.start_bar) and na(sess.end_bar)
                // Session is active, check if still in time range
                in_session_time = is_within_dtt_time_range(current_time_hhmm, sess.start_time_hhmm, sess.end_time_hhmm)

                // If not in session anymore, mark as ended
                if not in_session_time
                    sess.end_bar := bar_index
                    array.set(dtt_session_instances, i, sess)

    // ─────────────────────────────────────────────────────────────────────────
    // STEP 2: Clean up old sessions (keep only last 15 sessions = 1 cycle)
    // ─────────────────────────────────────────────────────────────────────────
    if array.size(dtt_session_instances) > DTT_MAX_SESSIONS_TO_KEEP
        sessions_to_delete = array.size(dtt_session_instances) - DTT_MAX_SESSIONS_TO_KEEP
        for i = 0 to sessions_to_delete - 1
            array.shift(dtt_session_instances)

    // ─────────────────────────────────────────────────────────────────────────
    // STEP 3: Create new sessions when entering their time range
    // ─────────────────────────────────────────────────────────────────────────
    for i = 0 to array.size(dtt_session_templates) - 1
        template = array.get(dtt_session_templates, i)

        // Check if we're in this session's time range
        in_session_time = is_within_dtt_time_range(current_time_hhmm, template.start_time_hhmm, template.end_time_hhmm)

        // Check if this session type already has an active instance
        session_exists = false
        if array.size(dtt_session_instances) > 0
            for j = array.size(dtt_session_instances) - 1 to 0
                sess = array.get(dtt_session_instances, j)
                if sess.name == template.name and not na(sess.start_bar) and na(sess.end_bar)
                    session_exists := true
                    break

        // Create new session if in time range and doesn't exist
        if in_session_time and not session_exists
            new_sess = DttSession.new(template.name, template.prev_session_name, template.start_time_hhmm, template.end_time_hhmm, bar_index, na, high, low, bar_index, bar_index, false, false, na, na, false, false, na, na, na, na, na)
            array.push(dtt_session_instances, new_sess)

    // ─────────────────────────────────────────────────────────────────────────
    // STEP 4: Update high/low for active sessions and detect breaches
    // ─────────────────────────────────────────────────────────────────────────
    if array.size(dtt_session_instances) > 0
        for i = 0 to array.size(dtt_session_instances) - 1
            sess = array.get(dtt_session_instances, i)
            if not na(sess.start_bar) and na(sess.end_bar)
                // Session is active, check if in time range
                in_session_time = false
                if sess.end_time_hhmm > sess.start_time_hhmm
                    in_session_time := current_time_hhmm >= sess.start_time_hhmm and current_time_hhmm < sess.end_time_hhmm
                else
                    in_session_time := current_time_hhmm >= sess.start_time_hhmm or current_time_hhmm < sess.end_time_hhmm

                if in_session_time
                    // Update session high/low
                    if high > sess.session_high
                        sess.session_high := high
                        sess.high_bar := bar_index
                    if low < sess.session_low
                        sess.session_low := low
                        sess.low_bar := bar_index

                    // Get previous session's high/low for breach detection
                    if not na(sess.prev_session_name)
                        prev_session = get_last_dtt_session(sess.prev_session_name)
                        if not na(prev_session)
                            prev_high = prev_session.session_high
                            prev_low = prev_session.session_low

                            // Check for first breach of previous session's high (strict: must exceed)
                            if not sess.high_breached and not na(prev_high)
                                if high > prev_high
                                    sess.high_breached := true
                                    sess.high_breach_bar := bar_index

                            // Check for first breach of previous session's low (strict: must exceed)
                            if not sess.low_breached and not na(prev_low)
                                if low < prev_low
                                    sess.low_breached := true
                                    sess.low_breach_bar := bar_index

                    array.set(dtt_session_instances, i, sess)

// ═══════════════════════════════════════════════════════════════════════════════
// LIQUIDITY MBZ DETECTION
// ═══════════════════════════════════════════════════════════════════════════════
if liquidity_detection_enabled
    has_previous_bar = not na(open[1]) and not na(close[1])
    if has_previous_bar
        a_open = open[1]
        a_close = close[1]
        a_high = high[1]
        a_low = low[1]
        a_midpoint = (a_open + a_close) / 2.0

        b_open = open
        b_close = close
        b_high = high
        b_low = low

        // Simple fixed scan caps (liquidity pools are much smaller than imbalance scans)
        daily_scan_cap = DAILY_LIQUIDITY_SCAN_CAP
        weekly_scan_cap = WEEKLY_LIQUIDITY_SCAN_CAP
        monthly_scan_cap = MONTHLY_LIQUIDITY_SCAN_CAP
        asia_scan_cap = ASIA_LIQUIDITY_SCAN_CAP
        london_scan_cap = LONDON_LIQUIDITY_SCAN_CAP
        nyam_scan_cap = NYAM_LIQUIDITY_SCAN_CAP
        lunch_scan_cap = LUNCH_LIQUIDITY_SCAN_CAP
        nypm_scan_cap = NYPM_LIQUIDITY_SCAN_CAP
        ons_scan_cap = ONS_LIQUIDITY_SCAN_CAP
        premarket_scan_cap = PREMARKET_LIQUIDITY_SCAN_CAP

        // Process DAILY liquidity pool (if enabled and not skipping Sunday)
        if enable_daily_liquidity and not skip_sunday_liquidity
            [daily_events_is_high, daily_events_rules, daily_events_is_exact, daily_events_source_price, daily_events_source_bar_index] = process_liquidity_pool(daily_liquidity_pool, LIQUIDITY_SOURCE_TYPE_DAILY, daily_scan_cap, enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

            // Create MBZ records from daily events
            daily_event_count = array.size(daily_events_is_high)
            if daily_event_count > 0
                for event_index = 0 to daily_event_count - 1
                    event_is_high = array.get(daily_events_is_high, event_index)
                    event_rule = array.get(daily_events_rules, event_index)
                    event_is_exact = array.get(daily_events_is_exact, event_index)
                    event_source_price = array.get(daily_events_source_price, event_index)
                    event_source_bar_index = array.get(daily_events_source_bar_index, event_index)

                    pool_boundary = event_is_high ? POOL_BOUNDARY_HIGH : POOL_BOUNDARY_LOW
                    is_bullish_event = not event_is_high

                    create_liquidity_mbz_record(
                         bar_index,
                         b_open,
                         b_high,
                         b_low,
                         b_close,
                         LIQUIDITY_SOURCE_TYPE_DAILY,
                         pool_boundary,
                         event_rule,
                         event_source_price,
                         event_source_bar_index,
                         is_bullish_event,
                         LIQUIDITY_SOURCE_TYPE_DAILY,
                         event_is_exact,
                         daily_liquidity_pool,
                         event_is_high
                     )

                    needs_visual_update := true

        // Process WEEKLY liquidity pool (if enabled)
        if enable_weekly_liquidity
            [weekly_events_is_high, weekly_events_rules, weekly_events_is_exact, weekly_events_source_price, weekly_events_source_bar_index] = process_liquidity_pool(weekly_liquidity_pool, LIQUIDITY_SOURCE_TYPE_WEEKLY, weekly_scan_cap, enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

            // Create MBZ records from weekly events
            weekly_event_count = array.size(weekly_events_is_high)
            if weekly_event_count > 0
                for event_index = 0 to weekly_event_count - 1
                    event_is_high = array.get(weekly_events_is_high, event_index)
                    event_rule = array.get(weekly_events_rules, event_index)
                    event_is_exact = array.get(weekly_events_is_exact, event_index)
                    event_source_price = array.get(weekly_events_source_price, event_index)
                    event_source_bar_index = array.get(weekly_events_source_bar_index, event_index)

                    pool_boundary = event_is_high ? POOL_BOUNDARY_HIGH : POOL_BOUNDARY_LOW
                    is_bullish_event = not event_is_high

                    create_liquidity_mbz_record(
                         bar_index,
                         b_open,
                         b_high,
                         b_low,
                         b_close,
                         LIQUIDITY_SOURCE_TYPE_WEEKLY,
                         pool_boundary,
                         event_rule,
                         event_source_price,
                         event_source_bar_index,
                         is_bullish_event,
                         LIQUIDITY_SOURCE_TYPE_WEEKLY,
                         event_is_exact,
                         weekly_liquidity_pool,
                         event_is_high
                     )

                    needs_visual_update := true

        // Process MONTHLY liquidity pool (if enabled)
        if enable_monthly_liquidity
            [monthly_events_is_high, monthly_events_rules, monthly_events_is_exact, monthly_events_source_price, monthly_events_source_bar_index] = process_liquidity_pool(monthly_liquidity_pool, LIQUIDITY_SOURCE_TYPE_MONTHLY, monthly_scan_cap, enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

            // Create MBZ records from monthly events
            monthly_event_count = array.size(monthly_events_is_high)
            if monthly_event_count > 0
                for event_index = 0 to monthly_event_count - 1
                    event_is_high = array.get(monthly_events_is_high, event_index)
                    event_rule = array.get(monthly_events_rules, event_index)
                    event_is_exact = array.get(monthly_events_is_exact, event_index)
                    event_source_price = array.get(monthly_events_source_price, event_index)
                    event_source_bar_index = array.get(monthly_events_source_bar_index, event_index)

                    pool_boundary = event_is_high ? POOL_BOUNDARY_HIGH : POOL_BOUNDARY_LOW
                    is_bullish_event = not event_is_high

                    create_liquidity_mbz_record(
                         bar_index,
                         b_open,
                         b_high,
                         b_low,
                         b_close,
                         LIQUIDITY_SOURCE_TYPE_MONTHLY,
                         pool_boundary,
                         event_rule,
                         event_source_price,
                         event_source_bar_index,
                         is_bullish_event,
                         LIQUIDITY_SOURCE_TYPE_MONTHLY,
                         event_is_exact,
                         monthly_liquidity_pool,
                         event_is_high
                     )

                    needs_visual_update := true

        if enable_asia_liquidity and not skip_sunday_liquidity
            [asia_events_is_high, asia_events_rules, asia_events_is_exact, asia_events_source_price, asia_events_source_bar_index] = process_liquidity_pool(asia_session_pool, LIQUIDITY_SOURCE_TYPE_ASIA, asia_scan_cap, enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

            // Create MBZ records from Asia session events
            asia_event_count = array.size(asia_events_is_high)
            asia_token = nine_times_mode == NINE_MODE_NINE_ONLY ? LIQUIDITY_SOURCE_TYPE_ASIA_NINE : LIQUIDITY_SOURCE_TYPE_ASIA
            if asia_event_count > 0
                for event_index = 0 to asia_event_count - 1
                    event_is_high = array.get(asia_events_is_high, event_index)
                    event_rule = array.get(asia_events_rules, event_index)
                    event_is_exact = array.get(asia_events_is_exact, event_index)
                    event_source_price = array.get(asia_events_source_price, event_index)
                    event_source_bar_index = array.get(asia_events_source_bar_index, event_index)

                    pool_boundary = event_is_high ? POOL_BOUNDARY_HIGH : POOL_BOUNDARY_LOW
                    is_bullish_event = not event_is_high

                    create_liquidity_mbz_record(
                         bar_index,
                         b_open,
                         b_high,
                         b_low,
                         b_close,
                         asia_token,
                         pool_boundary,
                         event_rule,
                         event_source_price,
                         event_source_bar_index,
                         is_bullish_event,
                         asia_token,
                         event_is_exact,
                         asia_session_pool,
                         event_is_high
                     )

                    needs_visual_update := true

        // Asia NINE variant pool processing (Both mode)
        if enable_nine_variants and enable_asia_liquidity and not skip_sunday_liquidity
            [asia_nine_events_is_high, asia_nine_events_rules, asia_nine_events_is_exact, asia_nine_events_source_price, asia_nine_events_source_bar_index] = process_liquidity_pool(asia_nine_pool, LIQUIDITY_SOURCE_TYPE_ASIA_NINE, asia_scan_cap, enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

            asia_nine_event_count = array.size(asia_nine_events_is_high)
            if asia_nine_event_count > 0
                for event_index = 0 to asia_nine_event_count - 1
                    event_is_high = array.get(asia_nine_events_is_high, event_index)
                    event_rule = array.get(asia_nine_events_rules, event_index)
                    event_is_exact = array.get(asia_nine_events_is_exact, event_index)
                    event_source_price = array.get(asia_nine_events_source_price, event_index)
                    event_source_bar_index = array.get(asia_nine_events_source_bar_index, event_index)

                    pool_boundary = event_is_high ? POOL_BOUNDARY_HIGH : POOL_BOUNDARY_LOW
                    is_bullish_event = not event_is_high

                    create_liquidity_mbz_record(
                         bar_index,
                         b_open,
                         b_high,
                         b_low,
                         b_close,
                         LIQUIDITY_SOURCE_TYPE_ASIA_NINE,
                         pool_boundary,
                         event_rule,
                         event_source_price,
                         event_source_bar_index,
                         is_bullish_event,
                         LIQUIDITY_SOURCE_TYPE_ASIA_NINE,
                         event_is_exact,
                         asia_nine_pool,
                         event_is_high
                     )

                    needs_visual_update := true

        if enable_london_liquidity and not skip_sunday_liquidity
            [london_events_is_high, london_events_rules, london_events_is_exact, london_events_source_price, london_events_source_bar_index] = process_liquidity_pool(london_session_pool, LIQUIDITY_SOURCE_TYPE_LONDON, london_scan_cap, enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

            // Create MBZ records from London session events
            london_event_count = array.size(london_events_is_high)
            london_token = nine_times_mode == NINE_MODE_NINE_ONLY ? LIQUIDITY_SOURCE_TYPE_LONDON_NINE : LIQUIDITY_SOURCE_TYPE_LONDON
            if london_event_count > 0
                for event_index = 0 to london_event_count - 1
                    event_is_high = array.get(london_events_is_high, event_index)
                    event_rule = array.get(london_events_rules, event_index)
                    event_is_exact = array.get(london_events_is_exact, event_index)
                    event_source_price = array.get(london_events_source_price, event_index)
                    event_source_bar_index = array.get(london_events_source_bar_index, event_index)

                    pool_boundary = event_is_high ? POOL_BOUNDARY_HIGH : POOL_BOUNDARY_LOW
                    is_bullish_event = not event_is_high

                    create_liquidity_mbz_record(
                         bar_index,
                         b_open,
                         b_high,
                         b_low,
                         b_close,
                         london_token,
                         pool_boundary,
                         event_rule,
                         event_source_price,
                         event_source_bar_index,
                         is_bullish_event,
                         london_token,
                         event_is_exact,
                         london_session_pool,
                         event_is_high
                     )

                    needs_visual_update := true

        // London NINE variant pool processing (Both mode)
        if enable_nine_variants and enable_london_liquidity and not skip_sunday_liquidity
            [london_nine_events_is_high, london_nine_events_rules, london_nine_events_is_exact, london_nine_events_source_price, london_nine_events_source_bar_index] = process_liquidity_pool(london_nine_pool, LIQUIDITY_SOURCE_TYPE_LONDON_NINE, london_scan_cap, enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

            london_nine_event_count = array.size(london_nine_events_is_high)
            if london_nine_event_count > 0
                for event_index = 0 to london_nine_event_count - 1
                    event_is_high = array.get(london_nine_events_is_high, event_index)
                    event_rule = array.get(london_nine_events_rules, event_index)
                    event_is_exact = array.get(london_nine_events_is_exact, event_index)
                    event_source_price = array.get(london_nine_events_source_price, event_index)
                    event_source_bar_index = array.get(london_nine_events_source_bar_index, event_index)

                    pool_boundary = event_is_high ? POOL_BOUNDARY_HIGH : POOL_BOUNDARY_LOW
                    is_bullish_event = not event_is_high

                    create_liquidity_mbz_record(bar_index, b_open, b_high, b_low, b_close, LIQUIDITY_SOURCE_TYPE_LONDON_NINE, pool_boundary, event_rule, event_source_price, event_source_bar_index, is_bullish_event, LIQUIDITY_SOURCE_TYPE_LONDON_NINE, event_is_exact, london_nine_pool, event_is_high)

                    needs_visual_update := true

        if enable_nyam_liquidity and not skip_sunday_liquidity
            [nyam_events_is_high, nyam_events_rules, nyam_events_is_exact, nyam_events_source_price, nyam_events_source_bar_index] = process_liquidity_pool(nyam_session_pool, LIQUIDITY_SOURCE_TYPE_NYAM, nyam_scan_cap, enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

            // Create MBZ records from NY AM session events
            nyam_event_count = array.size(nyam_events_is_high)
            nyam_token = nine_times_mode == NINE_MODE_NINE_ONLY ? LIQUIDITY_SOURCE_TYPE_NYAM_NINE : LIQUIDITY_SOURCE_TYPE_NYAM
            if nyam_event_count > 0
                for event_index = 0 to nyam_event_count - 1
                    event_is_high = array.get(nyam_events_is_high, event_index)
                    event_rule = array.get(nyam_events_rules, event_index)
                    event_is_exact = array.get(nyam_events_is_exact, event_index)
                    event_source_price = array.get(nyam_events_source_price, event_index)
                    event_source_bar_index = array.get(nyam_events_source_bar_index, event_index)

                    pool_boundary = event_is_high ? POOL_BOUNDARY_HIGH : POOL_BOUNDARY_LOW
                    is_bullish_event = not event_is_high

                    create_liquidity_mbz_record(
