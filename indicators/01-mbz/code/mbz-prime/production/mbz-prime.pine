            [dtt_events_is_high, dtt_events_rules, dtt_events_is_exact, dtt_events_source_price, dtt_events_source_bar_index, dtt_events_session_name] = process_dtt_sessions(enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

            // Create MBZ records from DTT session events
            dtt_event_count = array.size(dtt_events_is_high)
            if dtt_event_count > 0
                for event_index = 0 to dtt_event_count - 1
                    event_is_high = array.get(dtt_events_is_high, event_index)
                    event_rule = array.get(dtt_events_rules, event_index)
                    event_is_exact = array.get(dtt_events_is_exact, event_index)
                    event_source_price = array.get(dtt_events_source_price, event_index)
                    event_source_bar_index = array.get(dtt_events_source_bar_index, event_index)
                    event_session_name = array.get(dtt_events_session_name, event_index)

                    pool_boundary = event_is_high ? POOL_BOUNDARY_HIGH : POOL_BOUNDARY_LOW
                    is_bullish_event = not event_is_high

                    // Create source string in format "dtt: sessionname"
                    dtt_source = "dtt: " + get_dtt_session_name_lower(event_session_name)

