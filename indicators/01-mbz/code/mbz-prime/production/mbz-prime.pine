                needs_visual_update := true

        if enable_nypm_liquidity and not skip_sunday_liquidity
            [nypm_events_is_high, nypm_events_rules, nypm_events_is_exact, nypm_events_source_price, nypm_events_source_bar_index, nypm_events_sct, nypm_events_lt] = process_liquidity_pool(nypm_session_pool, LIQUIDITY_SOURCE_TYPE_NYPM, nypm_scan_cap, nypm_breach or nypm_breach_prev, enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

