        // Always mark breaches (both during and after session)
        ons_breach := liquidity_pool_mark_breaches(ons_session_pool, high, low, time)
else if barstate.isnew
    liquidity_pool_clear_current(ons_session_pool)

// Premarket session liquidity pool tracking
if enable_premarket_liquidity_tracking and (show_source_origins or liquidity_detection_enabled)
    if not skip_sunday_liquidity
        in_premarket_session = not na(time(timeframe.period, actual_premarket_session, NY_TIMEZONE))
        was_in_premarket_session = not na(time(timeframe.period, actual_premarket_session, NY_TIMEZONE)[1])

        // Detect session boundaries
        session_just_started = in_premarket_session and not was_in_premarket_session
        session_just_ended = not in_premarket_session and was_in_premarket_session

        if session_just_ended
            // Finalize the session that just ended
            liquidity_pool_finalize_session(premarket_session_pool, nz(time[1], time), PREMARKET_LIQUIDITY_SCAN_CAP)

        if session_just_started
            // Start new session - always capture the start bar
