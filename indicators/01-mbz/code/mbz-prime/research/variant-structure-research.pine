//@version=6

// Prototype: Combined variant metadata structure for Imbalance & Liquidity
// This file is strictly research scratchpad (no runtime detection)
// Goal: verify one struct can represent both a sample FVG and a sample Daily level
// with hard enforcement of valid variant ↔ source relationships

// ═══════════════════════════════════════════════════════════════════════════════
// COMMON STRUCTURES
// ═══════════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════════
// CANONICAL CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

VARIANT_IMBALANCE = "Imbalance"
VARIANT_LIQUIDITY = "Liquidity"

SOURCE_FAMILY_IMBALANCE = "imbalance"
SOURCE_FAMILY_LIQUIDITY = "liquidity"

IMBALANCE_SOURCE_TYPE_FVG = "fvg"
IMBALANCE_SOURCE_TYPE_IMPLIED = "implied"
IMBALANCE_SOURCE_TYPE_VOLUME = "volume"
IMBALANCE_SOURCE_TYPE_GAP = "gap"
IMBALANCE_SOURCE_TYPE_RDRB = "rdrb"

POOL_BOUNDARY_NONE = ""
POOL_BOUNDARY_HIGH = "high"
POOL_BOUNDARY_LOW = "low"

FORMATION_RULE_GAP_STANDARD = "gap_standard"
FORMATION_RULE_LIQUIDITY_IMMEDIATE = "liquidity_immediate"
FORMATION_RULE_LIQUIDITY_STANDARD = "liquidity_standard"
FORMATION_RULE_LIQUIDITY_DELAYED = "liquidity_delayed"

LIQUIDITY_SOURCE_TYPE_DAILY = "daily"
LIQUIDITY_SOURCE_TYPE_WEEKLY = "weekly"
LIQUIDITY_SOURCE_TYPE_MONTHLY = "monthly"
LIQUIDITY_SOURCE_TYPE_SESSION = "session"

GEOMETRY_ZONE = "zone"
GEOMETRY_BAND = "band"
GEOMETRY_LINE = "line"

// ═══════════════════════════════════════════════════════════════════════════════
// COMMON STRUCTURES
// ═══════════════════════════════════════════════════════════════════════════════

type SourceVariantMeta
    string variant              // 'Imbalance' or 'Liquidity'
    string formation_rule         // formation rule (e.g., gap_standard, liquidity_immediate)
    string source_family        // 'imbalance', 'liquidity', ...
    string source_type          // concrete type (fvg, implied, gap, daily, weekly, ...)
    string pool_boundary        // liquidity boundary tested ('high', 'low', or empty for gaps)
    string collector_id         // which routine produced it

    // Provenance
    int origin_bar_index
    int formation_bar_index
    float formation_price
    int tapped_bar_index

    // Direction & structure
    bool is_bullish
    string relationship_tag     // optional: identifier tying this variant to related objects (mitigations, consolidations, etc.)
    int mitigation_bar_index    // placeholder for future mitigation tracking

    // Geometry - neutral fields
    float anchor_high
    float anchor_low
    float anchor_mid
    string geometry_type        // GEOMETRY_ZONE / BAND / LINE
    float zone_top
    float zone_bottom

    // Lifecycle markers
    int breach_bar_index
    float breach_price
    int invalidation_bar_index
    float invalidation_price

    // State & diagnostics
    bool is_active
    bool is_breached
    bool is_invalidated
    float max_fill_pct
    float overlap_pct
    string notes

new_source_variant_meta() =>
    SourceVariantMeta.new(
         "", "", "", "", POOL_BOUNDARY_NONE, "",
         na, na, na, na,
         false,
         "",
         na,
         na, na, na,
         na, na,
         na, na,
         na, na,
         na, na, na,
         ""
     )

// Helper to pretty print
format_meta(meta, validation) =>
    "Variant: " + meta.variant +
      "\nKind: " + meta.formation_rule +
      "\nSource family/type: " + meta.source_family + " / " + meta.source_type +
      "\nPool boundary: " + meta.pool_boundary +
      "\nCollector: " + meta.collector_id +
      "\norigin_bar_index: " + str.tostring(meta.origin_bar_index) +
      "\nformation_bar_index: " + str.tostring(meta.formation_bar_index) +
      "\nformation_price: " + str.tostring(meta.formation_price) +
      "\ntapped_bar_index: " + str.tostring(meta.tapped_bar_index) +
      "\nis_bullish: " + str.tostring(meta.is_bullish) +
      "\nrelationship_tag: " + meta.relationship_tag +
      "\nmitigation_bar_index: " + str.tostring(meta.mitigation_bar_index) +
      "\nanchor_high / low / mid: " + str.tostring(meta.anchor_high) + " / " + str.tostring(meta.anchor_low) + " / " + str.tostring(meta.anchor_mid) +
      "\ngeometry_type: " + meta.geometry_type +
      "\nzone_top / bottom: " + str.tostring(meta.zone_top) + " / " + str.tostring(meta.zone_bottom) +
      "\nbreach_bar_index / price: " + str.tostring(meta.breach_bar_index) + " / " + str.tostring(meta.breach_price) +
      "\ninvalidation_bar_index / price: " + str.tostring(meta.invalidation_bar_index) + " / " + str.tostring(meta.invalidation_price) +
      "\nis_active / breached / invalidated: " + str.tostring(meta.is_active) + " / " + str.tostring(meta.is_breached) + " / " + str.tostring(meta.is_invalidated) +
      "\nmax_fill_pct: " + str.tostring(meta.max_fill_pct) +
      "\noverlap_pct: " + str.tostring(meta.overlap_pct) +
      "\nnotes: " + meta.notes +
      "\nvalidation: " + validation + "\n"

get_expected_family_for_variant(variant) =>
    variant == VARIANT_IMBALANCE ? SOURCE_FAMILY_IMBALANCE : variant == VARIANT_LIQUIDITY ? SOURCE_FAMILY_LIQUIDITY : ""

get_allowed_source_types_for_variant(variant) =>
    if variant == VARIANT_IMBALANCE
        [IMBALANCE_SOURCE_TYPE_FVG, IMBALANCE_SOURCE_TYPE_IMPLIED, IMBALANCE_SOURCE_TYPE_VOLUME, IMBALANCE_SOURCE_TYPE_GAP, IMBALANCE_SOURCE_TYPE_RDRB]
    else if variant == VARIANT_LIQUIDITY
        [LIQUIDITY_SOURCE_TYPE_DAILY, LIQUIDITY_SOURCE_TYPE_WEEKLY, LIQUIDITY_SOURCE_TYPE_MONTHLY, LIQUIDITY_SOURCE_TYPE_SESSION]
    else
        array.new<string>()

get_allowed_formation_rules_for_variant(variant) =>
    if variant == VARIANT_IMBALANCE
        [FORMATION_RULE_GAP_STANDARD]
    else if variant == VARIANT_LIQUIDITY
        [FORMATION_RULE_LIQUIDITY_IMMEDIATE, FORMATION_RULE_LIQUIDITY_STANDARD, FORMATION_RULE_LIQUIDITY_DELAYED]
    else
        array.new<string>()

is_geometry_valid(geometry_type) =>
    geometry_type == GEOMETRY_ZONE or geometry_type == GEOMETRY_BAND or geometry_type == GEOMETRY_LINE

validate_source_meta(meta) =>
    errors = array.new<string>()

    if meta.variant == ""
        array.push(errors, "variant missing")

    expected_family = get_expected_family_for_variant(meta.variant)
    if expected_family == ""
        array.push(errors, "unknown variant: " + meta.variant)
    else if meta.source_family != expected_family
        array.push(errors, "source_family " + meta.source_family + " not allowed for variant " + meta.variant)

    allowed_types = get_allowed_source_types_for_variant(meta.variant)
    if array.size(allowed_types) > 0 and not array.includes(allowed_types, meta.source_type)
        array.push(errors, "source_type " + meta.source_type + " not allowed for variant " + meta.variant)

    allowed_rules = get_allowed_formation_rules_for_variant(meta.variant)
    if array.size(allowed_rules) > 0 and not array.includes(allowed_rules, meta.formation_rule)
        array.push(errors, "formation_rule/formation " + meta.formation_rule + " not allowed for variant " + meta.variant)

    if meta.source_family == SOURCE_FAMILY_LIQUIDITY
        if meta.pool_boundary != POOL_BOUNDARY_HIGH and meta.pool_boundary != POOL_BOUNDARY_LOW
            array.push(errors, "liquidity sources require pool_boundary high/low")
        if meta.is_bullish and meta.pool_boundary != POOL_BOUNDARY_LOW
            array.push(errors, "bullish liquidity MBZ must sweep pool low")
        if not meta.is_bullish and meta.pool_boundary != POOL_BOUNDARY_HIGH
            array.push(errors, "bearish liquidity MBZ must sweep pool high")
    else if meta.pool_boundary != POOL_BOUNDARY_NONE
        array.push(errors, "non-liquidity sources must leave pool_boundary empty")

    if not is_geometry_valid(meta.geometry_type)
        array.push(errors, "invalid geometry_type: " + meta.geometry_type)

    if meta.anchor_high < meta.anchor_low
        array.push(errors, "anchor_high < anchor_low")

    if array.size(errors) == 0
        "VALID"
    else
        "INVALID -> " + str.join(errors, "; ")

// ═══════════════════════════════════════════════════════════════════════════════
// SAMPLE DATA
// ═══════════════════════════════════════════════════════════════════════════════

// Sample: Fair Value Gap meta (rough static example)
build_sample_fvg_meta() =>
    meta = new_source_variant_meta()
    meta.variant := VARIANT_IMBALANCE
    meta.formation_rule := FORMATION_RULE_GAP_STANDARD
    meta.source_family := SOURCE_FAMILY_IMBALANCE
    meta.source_type := IMBALANCE_SOURCE_TYPE_FVG
    meta.pool_boundary := POOL_BOUNDARY_NONE
    meta.collector_id := "gap_detection_v9.23"

    meta.origin_bar_index := 100
    meta.formation_bar_index := 102
    meta.formation_price := 1.2050
    meta.tapped_bar_index := 101
    meta.is_bullish := true

    meta.anchor_high := 1.2075
    meta.anchor_low := 1.2030
    meta.anchor_mid := (meta.anchor_high + meta.anchor_low) / 2.0
    meta.geometry_type := GEOMETRY_ZONE
    meta.zone_top := 1.2075
    meta.zone_bottom := 1.2030

    meta.breach_bar_index := 118
    meta.breach_price := 1.2040
    meta.invalidation_bar_index := na
    meta.invalidation_price := na

    meta.is_active := true
    meta.is_breached := true
    meta.is_invalidated := false
    meta.max_fill_pct := 62.5
    meta.overlap_pct := 45.0
    meta.notes := "Sample FVG: three-candle structure, tapped once"
    meta

// Sample: Daily liquidity level (high/low from Playful logic)
build_sample_daily_liquidity_meta() =>
    meta = new_source_variant_meta()
    meta.variant := VARIANT_LIQUIDITY
    meta.formation_rule := FORMATION_RULE_LIQUIDITY_STANDARD
    meta.source_family := SOURCE_FAMILY_LIQUIDITY
    meta.source_type := LIQUIDITY_SOURCE_TYPE_DAILY
    meta.pool_boundary := POOL_BOUNDARY_LOW
    meta.collector_id := "playful_daily_v1"

    meta.origin_bar_index := 200
    meta.formation_bar_index := 200
    meta.formation_price := 1.2500
    meta.tapped_bar_index := 215
    meta.is_bullish := true

    meta.anchor_high := 1.2550
    meta.anchor_low := 1.2450
    meta.anchor_mid := (meta.anchor_high + meta.anchor_low) / 2.0
    meta.geometry_type := GEOMETRY_BAND  // Representing a level span rather than a box
    meta.zone_top := na
    meta.zone_bottom := na

    meta.breach_bar_index := 218
    meta.breach_price := 1.2465
    meta.invalidation_bar_index := 222
    meta.invalidation_price := 1.2435

    meta.is_active := false
    meta.is_breached := true
    meta.is_invalidated := true
    meta.max_fill_pct := 100.0
    meta.overlap_pct := na
    meta.notes := "Sample Daily liquidity: session high/low, treated as price band"
    meta

// ═══════════════════════════════════════════════════════════════════════════════
// INSPECTION OUTPUT
// ═══════════════════════════════════════════════════════════════════════════════

fvg_meta = build_sample_fvg_meta()
daily_meta = build_sample_daily_liquidity_meta()
fvg_validation = validate_source_meta(fvg_meta)
daily_validation = validate_source_meta(daily_meta)

plotshape(true, text='Sample Variant Meta Research\n\nFVG Meta:\n' + format_meta(fvg_meta, fvg_validation) + '\nDaily Liquidity Meta:\n' + format_meta(daily_meta, daily_validation), style=shape.labeldown, location=location.top, color=color.new(color.blue, 0), textcolor=color.white)
