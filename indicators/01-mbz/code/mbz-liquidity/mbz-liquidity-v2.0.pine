// ═══════════════════════════════════════════════════════════════════════════════
// UTILITY FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// @function bodyTop
// @description Calculates the top boundary of a candle body (excluding wicks)
// @param o float - open price
// @param c float - close price
// @returns float - higher of open or close (body top boundary)
bodyTop(o, c) => math.max(o, c)

// @function bodyBot
// @description Calculates the bottom boundary of a candle body (excluding wicks)
// @param o float - open price
// @param c float - close price
// @returns float - lower of open or close (body bottom boundary)
bodyBot(o, c) => math.min(o, c)

// Reusable text size helper
get_text_size(size_string) =>
    switch size_string
        TEXT_SIZE_TINY => size.tiny
        TEXT_SIZE_SMALL => size.small
        TEXT_SIZE_NORMAL => size.normal
        TEXT_SIZE_LARGE => size.large
        => size.small

// Convert string alignment selections into Pine text alignment enums
get_horizontal_alignment(alignment_setting) =>
    alignment_setting == LABEL_ALIGNMENT_LEFT ? text.align_left : alignment_setting == LABEL_ALIGNMENT_RIGHT ? text.align_right : text.align_center

get_vertical_alignment(alignment_setting) =>
    alignment_setting == LABEL_VERTICAL_TOP ? text.align_top : alignment_setting == LABEL_VERTICAL_BOTTOM ? text.align_bottom : text.align_center

get_extension_label_halign() => get_horizontal_alignment(extension_label_horizontal_alignment)

get_extension_label_valign() => get_vertical_alignment(extension_label_vertical_alignment)

// Size helpers
get_mbz_label_size() => get_text_size(mbz_label_size)
get_invalidated_mbz_size() => get_text_size(mbz_invalidated_size)
get_source_label_size() => get_text_size(source_label_size)
get_extended_box_text_size() => get_text_size(extended_box_text_size)
get_wick_star_size() => get_text_size(wick_star_size)

pad_two_digits(value) => value < 10 ? '0' + str.tostring(value) : str.tostring(value)

// Day of week abbreviation helper (parity with Playful)
get_day_abbreviation(time_value) =>
    switch dayofweek(time_value, NY_TIMEZONE)
        dayofweek.sunday => 'Sun'
        dayofweek.monday => 'Mon'
        dayofweek.tuesday => 'Tue'
        dayofweek.wednesday => 'Wed'
        dayofweek.thursday => 'Thu'
        dayofweek.friday => 'Fri'
        dayofweek.saturday => 'Sat'
        => ''

format_liquidity_pool_time_label(pool_type, time_value) =>
    switch pool_type
        LIQUIDITY_SOURCE_TYPE_DAILY =>
            day_abbr = get_day_abbreviation(time_value)
            date_str = str.tostring(month(time_value, NY_TIMEZONE)) + '/' + str.tostring(dayofmonth(time_value, NY_TIMEZONE))
            day_abbr + ' ' + date_str
        LIQUIDITY_SOURCE_TYPE_WEEKLY =>
            week_start_month = month(time_value, NY_TIMEZONE)
            week_start_day = dayofmonth(time_value, NY_TIMEZONE)
            week_end_time = time_value + (6 * 24 * 60 * 60 * 1000)
            week_end_month = month(week_end_time, NY_TIMEZONE)
            week_end_day = dayofmonth(week_end_time, NY_TIMEZONE)
            start_str = str.tostring(week_start_month) + '/' + str.tostring(week_start_day)
            end_str = str.tostring(week_end_month) + '/' + str.tostring(week_end_day)
            start_str + '-' + end_str
        LIQUIDITY_SOURCE_TYPE_MONTHLY =>
            pad_two_digits(month(time_value, NY_TIMEZONE)) + '/' + str.tostring(year(time_value))
        LIQUIDITY_SOURCE_TYPE_ASIA =>
            day_abbr = get_day_abbreviation(time_value)
            date_str = str.tostring(month(time_value, NY_TIMEZONE)) + '/' + str.tostring(dayofmonth(time_value, NY_TIMEZONE))
            day_abbr + ' ' + date_str
        => 'Unknown'

build_liquidity_pool_label(pool_type, time_value) =>
    label_prefix = switch pool_type
        LIQUIDITY_SOURCE_TYPE_DAILY => 'Daily'
        LIQUIDITY_SOURCE_TYPE_WEEKLY => 'Weekly'
        LIQUIDITY_SOURCE_TYPE_MONTHLY => 'Monthly'
        LIQUIDITY_SOURCE_TYPE_ASIA => 'Asia'
        => pool_type

    if na(time_value)
        label_prefix
    else
        label_prefix + ' ' + format_liquidity_pool_time_label(pool_type, time_value)

create_liquidity_pool() =>
    LiquidityPoolCollection.new(
         array.new_float(),
         array.new_float(),
         array.new_int(),
         array.new_int(),
         array.new_int(),
         array.new_bool(),
         array.new_bool(),
         array.new_int(),
         array.new_int(),
         array.new_int(),
         array.new_int(),
         array.new_int(),
         array.new_int(),
         array.new_bool(),
         array.new_bool(),
         array.new_int(),
         array.new_int(),
         array.new_bool(),
         array.new_bool(),
         float(na),
         float(na),
         int(na),
         int(na),
         int(na),
         int(na),
         int(na),
         int(na),
         int(na),
         false,
         false,
         int(na),
         int(na),
         0,
         0
     )

liquidity_pool_session_count(pool) => array.size(pool.highs)

liquidity_pool_clear_current(pool) =>
    pool.current_high := na
    pool.current_low := na
    pool.current_high_time := na
    pool.current_low_time := na
    pool.current_session_start_time := na
    pool.current_high_origin_bar_index := na
    pool.current_low_origin_bar_index := na
    pool.current_high_first_breach_bar := na
    pool.current_low_first_breach_bar := na
    pool.current_high_mitigated := false
    pool.current_low_mitigated := false
    pool.current_high_mitigation_bar := na
    pool.current_low_mitigation_bar := na

liquidity_pool_reset_current(pool, highest, lowest, bar_time, bar_index_value) =>
    pool.current_high := highest
    pool.current_low := lowest
    pool.current_high_time := bar_time
    pool.current_low_time := bar_time
    pool.current_session_start_time := bar_time
    pool.current_high_origin_bar_index := bar_index_value
    pool.current_low_origin_bar_index := bar_index_value
    pool.current_high_first_breach_bar := na
    pool.current_low_first_breach_bar := na
    pool.current_high_mitigated := false
    pool.current_low_mitigated := false
    pool.current_high_mitigation_bar := na
    pool.current_low_mitigation_bar := na

liquidity_pool_update_current_extremes(pool, highest, lowest, bar_time, bar_index_value) =>
    if na(pool.current_high) or na(pool.current_low)
        liquidity_pool_reset_current(pool, highest, lowest, bar_time, bar_index_value)
    else
        if highest > pool.current_high
            pool.current_high := highest
            pool.current_high_time := bar_time
            pool.current_high_origin_bar_index := bar_index_value
            pool.current_high_first_breach_bar := na
            pool.current_high_mitigated := false
            pool.current_high_mitigation_bar := na
        if lowest < pool.current_low
            pool.current_low := lowest
            pool.current_low_time := bar_time
            pool.current_low_origin_bar_index := bar_index_value
            pool.current_low_first_breach_bar := na
            pool.current_low_mitigated := false
            pool.current_low_mitigation_bar := na

liquidity_pool_advance_high_pointer(pool) =>
    count = array.size(pool.high_breached)
    idx = math.max(0, pool.first_unbreached_high_index)
    if idx > count
        idx := count
    while idx < count and array.get(pool.high_breached, idx)
        idx += 1
    pool.first_unbreached_high_index := idx

liquidity_pool_advance_low_pointer(pool) =>
    count = array.size(pool.low_breached)
    idx = math.max(0, pool.first_unbreached_low_index)
    if idx > count
        idx := count
    while idx < count and array.get(pool.low_breached, idx)
        idx += 1
    pool.first_unbreached_low_index := idx

liquidity_pool_trim(pool, max_entries) =>
    while array.size(pool.highs) > max_entries
        array.shift(pool.highs)
        array.shift(pool.lows)
        array.shift(pool.high_times)
        array.shift(pool.low_times)
        array.shift(pool.session_close_times)
        array.shift(pool.high_breached)
        array.shift(pool.low_breached)
        array.shift(pool.high_breach_times)
        array.shift(pool.low_breach_times)
        array.shift(pool.high_origin_bar_indices)
        array.shift(pool.low_origin_bar_indices)
        array.shift(pool.high_first_breach_bars)
        array.shift(pool.low_first_breach_bars)
        array.shift(pool.high_mitigated_flags)
        array.shift(pool.low_mitigated_flags)
        array.shift(pool.high_mitigation_bars)
        array.shift(pool.low_mitigation_bars)
        array.shift(pool.high_used_by_pattern)
        array.shift(pool.low_used_by_pattern)
        pool.first_unbreached_high_index := math.max(0, pool.first_unbreached_high_index - 1)
        pool.first_unbreached_low_index := math.max(0, pool.first_unbreached_low_index - 1)

    liquidity_pool_advance_high_pointer(pool)
    liquidity_pool_advance_low_pointer(pool)

liquidity_pool_finalize_session(pool, session_close_time, max_entries) =>
    if not na(pool.current_high) and not na(pool.current_low)
        array.push(pool.highs, pool.current_high)
        array.push(pool.lows, pool.current_low)
        array.push(pool.high_times, pool.current_high_time)
        array.push(pool.low_times, pool.current_low_time)
        array.push(pool.session_close_times, session_close_time)
        array.push(pool.high_breached, false)
        array.push(pool.low_breached, false)
        array.push(pool.high_breach_times, na)
        array.push(pool.low_breach_times, na)
        array.push(pool.high_origin_bar_indices, pool.current_high_origin_bar_index)
        array.push(pool.low_origin_bar_indices, pool.current_low_origin_bar_index)
        array.push(pool.high_first_breach_bars, pool.current_high_first_breach_bar)
        array.push(pool.low_first_breach_bars, pool.current_low_first_breach_bar)
        array.push(pool.high_mitigated_flags, pool.current_high_mitigated)
        array.push(pool.low_mitigated_flags, pool.current_low_mitigated)
        array.push(pool.high_mitigation_bars, pool.current_high_mitigation_bar)
        array.push(pool.low_mitigation_bars, pool.current_low_mitigation_bar)
        array.push(pool.high_used_by_pattern, false)
        array.push(pool.low_used_by_pattern, false)

        new_index = liquidity_pool_session_count(pool) - 1
        if pool.first_unbreached_high_index >= liquidity_pool_session_count(pool)
            pool.first_unbreached_high_index := new_index
        if pool.first_unbreached_low_index >= liquidity_pool_session_count(pool)
            pool.first_unbreached_low_index := new_index

        liquidity_pool_trim(pool, max_entries)

    liquidity_pool_clear_current(pool)

liquidity_pool_mark_breaches(pool, bar_high, bar_low, bar_time) =>
    total = liquidity_pool_session_count(pool)
    if total > 0
        if pool.first_unbreached_high_index < total
            for i = pool.first_unbreached_high_index to total - 1
                if not array.get(pool.high_breached, i)
                    tracked_high = array.get(pool.highs, i)
                    if bar_high >= tracked_high
                        array.set(pool.high_breached, i, true)
                        array.set(pool.high_breach_times, i, bar_time)
            liquidity_pool_advance_high_pointer(pool)

        if pool.first_unbreached_low_index < total
            for i = pool.first_unbreached_low_index to total - 1
                if not array.get(pool.low_breached, i)
                    tracked_low = array.get(pool.lows, i)
                    if bar_low <= tracked_low
                        array.set(pool.low_breached, i, true)
                        array.set(pool.low_breach_times, i, bar_time)
            liquidity_pool_advance_low_pointer(pool)

    total

liquidity_pool_get_high_line_end_time(pool, index, fallback_time) =>
    high_breached = array.get(pool.high_breached, index)
    high_breach_time = array.get(pool.high_breach_times, index)
    high_breached and not na(high_breach_time) ? high_breach_time : fallback_time

liquidity_pool_get_low_line_end_time(pool, index, fallback_time) =>
    low_breached = array.get(pool.low_breached, index)
    low_breach_time = array.get(pool.low_breach_times, index)
    low_breached and not na(low_breach_time) ? low_breach_time : fallback_time

liquidity_pool_clear(pool) =>
    array.clear(pool.highs)
    array.clear(pool.lows)
    array.clear(pool.high_times)
    array.clear(pool.low_times)
    array.clear(pool.session_close_times)
    array.clear(pool.high_breached)
    array.clear(pool.low_breached)
    array.clear(pool.high_breach_times)
    array.clear(pool.low_breach_times)
    array.clear(pool.high_origin_bar_indices)
    array.clear(pool.low_origin_bar_indices)
    array.clear(pool.high_first_breach_bars)
    array.clear(pool.low_first_breach_bars)
    array.clear(pool.high_mitigated_flags)
    array.clear(pool.low_mitigated_flags)
    array.clear(pool.high_mitigation_bars)
    array.clear(pool.low_mitigation_bars)
    array.clear(pool.high_used_by_pattern)
    array.clear(pool.low_used_by_pattern)
    liquidity_pool_clear_current(pool)
    pool.first_unbreached_high_index := 0
    pool.first_unbreached_low_index := 0

// Initialize daily liquidity pool instance
var LiquidityPoolCollection daily_liquidity_pool = create_liquidity_pool()
// Initialize weekly liquidity pool instance
var LiquidityPoolCollection weekly_liquidity_pool = create_liquidity_pool()
// Initialize monthly liquidity pool instance
var LiquidityPoolCollection monthly_liquidity_pool = create_liquidity_pool()
// Initialize Asia session liquidity pool instance
var LiquidityPoolCollection asia_session_pool = create_liquidity_pool()

liquidity_level_is_ready(level_value, level_time) =>
    not na(level_value) and not na(level_time) and level_time < time

check_midpoint_confirmation(is_bearish_mbz, close_price, midpoint) =>
    if is_bearish_mbz
        if confirm_on_midpoint_close
            if close_price < midpoint
                [true, false]
            else if close_price == midpoint
                [true, true]
            else
                [false, false]
        else
            [close_price < midpoint, false]
    else
        if confirm_on_midpoint_close
            if close_price > midpoint
                [true, false]
            else if close_price == midpoint
                [true, true]
            else
                [false, false]
        else
            [close_price > midpoint, false]

liquidity_immediate_condition(is_bearish_pattern, level_value, a_high, a_low, a_close, b_open, b_close, b_high, b_low) =>
    if is_bearish_pattern
        previous_inside = a_high < level_value and a_close < level_value
        current_sweep = b_high > level_value and b_open < level_value
        is_bearish_candle = b_close < b_open
        previous_inside and current_sweep and is_bearish_candle
    else
        previous_inside = a_low > level_value and a_close > level_value
        current_sweep = b_low < level_value and b_open > level_value
        is_bullish_candle = b_close > b_open
        previous_inside and current_sweep and is_bullish_candle

liquidity_standard_condition(is_bearish_pattern, level_value, a_open, a_close, a_high, a_low, b_open, b_close, b_high, b_low) =>
    if is_bearish_pattern
        wick_only_first_breach = a_open < level_value and a_high > level_value and a_close < level_value
        no_new_extreme = allow_standard_extreme_equality ? b_high <= a_high : b_high < a_high
        is_bearish_candle = b_close < b_open
        wick_only_first_breach and b_open < level_value and no_new_extreme and is_bearish_candle
    else
        wick_only_first_breach = a_open > level_value and a_low < level_value and a_close > level_value
        no_new_extreme = allow_standard_extreme_equality ? b_low >= a_low : b_low > a_low
        is_bullish_candle = b_close > b_open
        wick_only_first_breach and b_open > level_value and no_new_extreme and is_bullish_candle

liquidity_delayed_condition(is_bearish_pattern, level_value, a_close, b_open, b_close) =>
    if is_bearish_pattern
        body_close_breach = a_close > level_value
        is_bearish_candle = b_close < b_open
        body_close_breach and b_open > level_value and is_bearish_candle
    else
        body_close_breach = a_close < level_value
        is_bullish_candle = b_close > b_open
        body_close_breach and b_open < level_value and is_bullish_candle

detect_liquidity_pool_patterns(
     pool_high_ready,
     pool_low_ready,
     pool_high_value,
     pool_low_value,
     pool_high_breach_time,
     pool_low_breach_time,
     high_first_breach,
     low_first_breach,
     high_mitigated,
     low_mitigated,
     high_mitigation_bar,
     low_mitigation_bar,
     high_origin_bar_index,
     low_origin_bar_index,
     enable_immediate_rule,
     enable_standard_rule,
     enable_delayed_rule,
     a_open,
     a_close,
     a_high,
     a_low,
     a_midpoint,
     b_open,
     b_close,
     b_high,
     b_low
 ) =>
    high_first_breach_new = high_first_breach
    low_first_breach_new = low_first_breach
    high_mitigated_new = high_mitigated
    low_mitigated_new = low_mitigated
    high_mitigation_bar_new = high_mitigation_bar
    low_mitigation_bar_new = low_mitigation_bar

    events_is_high = array.new_bool()
    events_formation_rule = array.new_string()
    events_is_exact_midpoint = array.new_bool()
    events_source_price = array.new_float()
    events_source_bar_index = array.new_int()

    high_ready = (enable_immediate_rule or enable_standard_rule or enable_delayed_rule) and pool_high_ready and not na(pool_high_value)
    low_ready = (enable_immediate_rule or enable_standard_rule or enable_delayed_rule) and pool_low_ready and not na(pool_low_value)

    if high_ready and not high_mitigated_new
        high_breach_time_current = not na(pool_high_breach_time) and pool_high_breach_time == time
        high_breach_time_previous = not na(pool_high_breach_time) and pool_high_breach_time == time[1]

        if na(high_first_breach_new)
            if high_breach_time_current
                high_first_breach_new := bar_index
            else if high_breach_time_previous
                high_first_breach_new := bar_index - 1
            else
                if b_high >= pool_high_value
                    high_first_breach_new := bar_index
                else if a_high >= pool_high_value
                    high_first_breach_new := bar_index - 1

        breach_is_current_high = high_breach_time_current or (not na(high_first_breach_new) and high_first_breach_new == bar_index)
        breach_is_previous_high = high_breach_time_previous or (not na(high_first_breach_new) and high_first_breach_new == bar_index - 1)

        source_bar_high = na(high_origin_bar_index) ? bar_index : high_origin_bar_index

        immediate_cond_result = liquidity_immediate_condition(true, pool_high_value, a_high, a_low, a_close, b_open, b_close, b_high, b_low)

        // Debug: Track why immediate pattern fails
        if enable_immediate_rule and breach_is_current_high and not immediate_cond_result
            // Condition failed - let's see why
            prev_inside_check = a_high < pool_high_value and a_close < pool_high_value
            curr_sweep_check = b_high > pool_high_value and b_open < pool_high_value
            // Store for later debug output

        if enable_immediate_rule and breach_is_current_high and immediate_cond_result
            [midpoint_passed_high, is_exact_midpoint_high] = check_midpoint_confirmation(true, b_close, a_midpoint)
            if midpoint_passed_high
                array.push(events_is_high, true)
                array.push(events_formation_rule, FORMATION_RULE_LIQUIDITY_IMMEDIATE)
                array.push(events_is_exact_midpoint, is_exact_midpoint_high)
                array.push(events_source_price, pool_high_value)
                array.push(events_source_bar_index, source_bar_high)
                // Don't set mitigation here - allow multiple patterns per level
                // high_mitigated_new := true
                // high_mitigation_bar_new := bar_index

        if enable_standard_rule and breach_is_previous_high and liquidity_standard_condition(true, pool_high_value, a_open, a_close, a_high, a_low, b_open, b_close, b_high, b_low)
            [midpoint_passed_high_standard, is_exact_midpoint_high_standard] = check_midpoint_confirmation(true, b_close, a_midpoint)
            if midpoint_passed_high_standard
                array.push(events_is_high, true)
                array.push(events_formation_rule, FORMATION_RULE_LIQUIDITY_STANDARD)
                array.push(events_is_exact_midpoint, is_exact_midpoint_high_standard)
                array.push(events_source_price, pool_high_value)
                array.push(events_source_bar_index, source_bar_high)
                // Don't set mitigation here - allow multiple patterns per level
                // high_mitigated_new := true
                // high_mitigation_bar_new := bar_index

        if enable_delayed_rule and breach_is_previous_high and liquidity_delayed_condition(true, pool_high_value, a_close, b_open, b_close)
            [midpoint_passed_high_delayed, is_exact_midpoint_high_delayed] = check_midpoint_confirmation(true, b_close, a_midpoint)
            if midpoint_passed_high_delayed
                array.push(events_is_high, true)
                array.push(events_formation_rule, FORMATION_RULE_LIQUIDITY_DELAYED)
                array.push(events_is_exact_midpoint, is_exact_midpoint_high_delayed)
                array.push(events_source_price, pool_high_value)
                array.push(events_source_bar_index, source_bar_high)
                // Don't set mitigation here - allow multiple patterns per level
                // high_mitigated_new := true
                // high_mitigation_bar_new := bar_index

        // TEMPORARILY DISABLED: Auto-mitigation to debug why patterns don't form
        // if not high_mitigated_new and not na(high_first_breach_new) and bar_index > high_first_breach_new + 1
        //     high_mitigated_new := true

    if low_ready and not low_mitigated_new
        low_breach_time_current = not na(pool_low_breach_time) and pool_low_breach_time == time
        low_breach_time_previous = not na(pool_low_breach_time) and pool_low_breach_time == time[1]

        if na(low_first_breach_new)
            if low_breach_time_current
                low_first_breach_new := bar_index
            else if low_breach_time_previous
                low_first_breach_new := bar_index - 1
            else
                if b_low <= pool_low_value
                    low_first_breach_new := bar_index
                else if a_low <= pool_low_value
                    low_first_breach_new := bar_index - 1

        breach_is_current_low = low_breach_time_current or (not na(low_first_breach_new) and low_first_breach_new == bar_index)
        breach_is_previous_low = low_breach_time_previous or (not na(low_first_breach_new) and low_first_breach_new == bar_index - 1)

        source_bar_low = na(low_origin_bar_index) ? bar_index : low_origin_bar_index

        if enable_immediate_rule and breach_is_current_low and liquidity_immediate_condition(false, pool_low_value, a_high, a_low, a_close, b_open, b_close, b_high, b_low)
            [midpoint_passed_low, is_exact_midpoint_low] = check_midpoint_confirmation(false, b_close, a_midpoint)
            if midpoint_passed_low
                array.push(events_is_high, false)
                array.push(events_formation_rule, FORMATION_RULE_LIQUIDITY_IMMEDIATE)
                array.push(events_is_exact_midpoint, is_exact_midpoint_low)
                array.push(events_source_price, pool_low_value)
                array.push(events_source_bar_index, source_bar_low)
                // Don't set mitigation here - allow multiple patterns per level
                // low_mitigated_new := true
                // low_mitigation_bar_new := bar_index

        if enable_standard_rule and breach_is_previous_low and liquidity_standard_condition(false, pool_low_value, a_open, a_close, a_high, a_low, b_open, b_close, b_high, b_low)
            [midpoint_passed_low_standard, is_exact_midpoint_low_standard] = check_midpoint_confirmation(false, b_close, a_midpoint)
            if midpoint_passed_low_standard
                array.push(events_is_high, false)
                array.push(events_formation_rule, FORMATION_RULE_LIQUIDITY_STANDARD)
                array.push(events_is_exact_midpoint, is_exact_midpoint_low_standard)
                array.push(events_source_price, pool_low_value)
                array.push(events_source_bar_index, source_bar_low)
                // Don't set mitigation here - allow multiple patterns per level
                // low_mitigated_new := true
                // low_mitigation_bar_new := bar_index

        if enable_delayed_rule and breach_is_previous_low and liquidity_delayed_condition(false, pool_low_value, a_close, b_open, b_close)
            [midpoint_passed_low_delayed, is_exact_midpoint_low_delayed] = check_midpoint_confirmation(false, b_close, a_midpoint)
            if midpoint_passed_low_delayed
                array.push(events_is_high, false)
                array.push(events_formation_rule, FORMATION_RULE_LIQUIDITY_DELAYED)
                array.push(events_is_exact_midpoint, is_exact_midpoint_low_delayed)
                array.push(events_source_price, pool_low_value)
                array.push(events_source_bar_index, source_bar_low)
                // Don't set mitigation here - allow multiple patterns per level
                // low_mitigated_new := true
                // low_mitigation_bar_new := bar_index

        // TEMPORARILY DISABLED: Auto-mitigation to debug why patterns don't form
        // if not low_mitigated_new and not na(low_first_breach_new) and bar_index > low_first_breach_new + 1
        //     low_mitigated_new := true

    [
         high_first_breach_new,
         low_first_breach_new,
         high_mitigated_new,
         low_mitigated_new,
         high_mitigation_bar_new,
         low_mitigation_bar_new,
         events_is_high,
         events_formation_rule,
         events_is_exact_midpoint,
         events_source_price,
         events_source_bar_index
     ]

// Generic helper to process any liquidity pool (daily, weekly, monthly)
// Returns arrays of detected events that can be processed into MBZ records
process_liquidity_pool(
     pool,
     pool_source_type,
     timeframe_scan_cap,
     enable_immediate,
     enable_standard,
     enable_delayed,
     a_open,
     a_close,
     a_high,
     a_low,
     a_midpoint,
     b_open,
     b_close,
     b_high,
     b_low) =>

    detected_events_is_high = array.new_bool()
    detected_events_rules = array.new_string()
    detected_events_is_exact = array.new_bool()
    detected_events_source_price = array.new_float()
    detected_events_source_bar_index = array.new_int()

    total_sessions = liquidity_pool_session_count(pool)
    effective_scan_limit = math.min(total_sessions, timeframe_scan_cap)
    scan_start_index = math.max(0, total_sessions - effective_scan_limit)

    // Process finalized sessions
    if total_sessions > 0
        for session_index = scan_start_index to total_sessions - 1
            pool_high_value = array.get(pool.highs, session_index)
            pool_low_value = array.get(pool.lows, session_index)
            pool_high_breach_time = array.get(pool.high_breach_times, session_index)
            pool_low_breach_time = array.get(pool.low_breach_times, session_index)
            high_first_breach = array.get(pool.high_first_breach_bars, session_index)
            low_first_breach = array.get(pool.low_first_breach_bars, session_index)
            high_mitigated = array.get(pool.high_mitigated_flags, session_index)
            low_mitigated = array.get(pool.low_mitigated_flags, session_index)
            high_mitigation_bar = array.get(pool.high_mitigation_bars, session_index)
            low_mitigation_bar = array.get(pool.low_mitigation_bars, session_index)
            high_origin_bar_index = array.get(pool.high_origin_bar_indices, session_index)
            low_origin_bar_index = array.get(pool.low_origin_bar_indices, session_index)
            pool_high_time = array.get(pool.high_times, session_index)
            pool_low_time = array.get(pool.low_times, session_index)
            pool_high_ready = liquidity_level_is_ready(pool_high_value, pool_high_time)
            pool_low_ready = liquidity_level_is_ready(pool_low_value, pool_low_time)

            if not pool_high_ready and not pool_low_ready
                continue

            [
                 updated_high_first_breach,
                 updated_low_first_breach,
                 updated_high_mitigated,
                 updated_low_mitigated,
                 updated_high_mitigation_bar,
                 updated_low_mitigation_bar,
                 session_events_is_high,
                 session_events_rules,
                 session_events_is_exact,
                 session_events_source_price,
                 session_events_source_bar_index
             ] = detect_liquidity_pool_patterns(
                     pool_high_ready,
                     pool_low_ready,
                     pool_high_value,
                     pool_low_value,
                     pool_high_breach_time,
                     pool_low_breach_time,
                     high_first_breach,
                     low_first_breach,
                     high_mitigated,
                     low_mitigated,
                     high_mitigation_bar,
                     low_mitigation_bar,
                     high_origin_bar_index,
                     low_origin_bar_index,
                     enable_immediate,
                     enable_standard,
                     enable_delayed,
                     a_open,
                     a_close,
                     a_high,
                     a_low,
                     a_midpoint,
                     b_open,
                     b_close,
                     b_high,
                     b_low
                 )

            array.set(pool.high_first_breach_bars, session_index, updated_high_first_breach)
            array.set(pool.low_first_breach_bars, session_index, updated_low_first_breach)
            array.set(pool.high_mitigated_flags, session_index, updated_high_mitigated)
            array.set(pool.low_mitigated_flags, session_index, updated_low_mitigated)
            array.set(pool.high_mitigation_bars, session_index, updated_high_mitigation_bar)
            array.set(pool.low_mitigation_bars, session_index, updated_low_mitigation_bar)

            session_event_count = array.size(session_events_is_high)
            if session_event_count > 0
                for event_index = 0 to session_event_count - 1
                    array.push(detected_events_is_high, array.get(session_events_is_high, event_index))
                    array.push(detected_events_rules, array.get(session_events_rules, event_index))
                    array.push(detected_events_is_exact, array.get(session_events_is_exact, event_index))
                    array.push(detected_events_source_price, array.get(session_events_source_price, event_index))
                    array.push(detected_events_source_bar_index, array.get(session_events_source_bar_index, event_index))

    // Process current (active) session
    current_high_value = pool.current_high
    current_low_value = pool.current_low
    current_high_ready = liquidity_level_is_ready(current_high_value, pool.current_high_time)
    current_low_ready = liquidity_level_is_ready(current_low_value, pool.current_low_time)

    if current_high_ready or current_low_ready
        [
             current_high_first_breach_new,
             current_low_first_breach_new,
             current_high_mitigated_new,
             current_low_mitigated_new,
             current_high_mitigation_bar_new,
             current_low_mitigation_bar_new,
             current_events_is_high,
             current_events_rules,
             current_events_is_exact,
             current_events_source_price,
             current_events_source_bar_index
         ] = detect_liquidity_pool_patterns(
                 current_high_ready,
                 current_low_ready,
                 current_high_value,
                 current_low_value,
                 int(na),
                 int(na),
                 pool.current_high_first_breach_bar,
                 pool.current_low_first_breach_bar,
                 pool.current_high_mitigated,
                 pool.current_low_mitigated,
                 pool.current_high_mitigation_bar,
                 pool.current_low_mitigation_bar,
                 pool.current_high_origin_bar_index,
                 pool.current_low_origin_bar_index,
                 enable_immediate,
                 enable_standard,
                 enable_delayed,
                 a_open,
                 a_close,
                 a_high,
                 a_low,
                 a_midpoint,
                 b_open,
                 b_close,
                 b_high,
                 b_low
             )

        pool.current_high_first_breach_bar := current_high_first_breach_new
        pool.current_low_first_breach_bar := current_low_first_breach_new
        pool.current_high_mitigated := current_high_mitigated_new
        pool.current_low_mitigated := current_low_mitigated_new
        pool.current_high_mitigation_bar := current_high_mitigation_bar_new
        pool.current_low_mitigation_bar := current_low_mitigation_bar_new

        current_event_count = array.size(current_events_is_high)
        if current_event_count > 0
            for event_index = 0 to current_event_count - 1
                array.push(detected_events_is_high, array.get(current_events_is_high, event_index))
                array.push(detected_events_rules, array.get(current_events_rules, event_index))
                array.push(detected_events_is_exact, array.get(current_events_is_exact, event_index))
                array.push(detected_events_source_price, array.get(current_events_source_price, event_index))
                array.push(detected_events_source_bar_index, array.get(current_events_source_bar_index, event_index))

    // Apply priority system: Delayed > Standard > Immediate
    event_count = array.size(detected_events_is_high)
    if event_count > 0
        has_delayed = false
        has_standard = false
        has_immediate = false

        for rule_check_index = 0 to event_count - 1
            event_rule = array.get(detected_events_rules, rule_check_index)
            if event_rule == FORMATION_RULE_LIQUIDITY_DELAYED
                has_delayed := true
            else if event_rule == FORMATION_RULE_LIQUIDITY_STANDARD
                has_standard := true
            else if event_rule == FORMATION_RULE_LIQUIDITY_IMMEDIATE
                has_immediate := true

        unified_rule = ""
        if enable_delayed and has_delayed
            unified_rule := FORMATION_RULE_LIQUIDITY_DELAYED
        else if enable_standard and has_standard
            unified_rule := FORMATION_RULE_LIQUIDITY_STANDARD
        else if enable_immediate and has_immediate
            unified_rule := FORMATION_RULE_LIQUIDITY_IMMEDIATE

        if unified_rule != ""
            for rule_override_index = 0 to event_count - 1
                array.set(detected_events_rules, rule_override_index, unified_rule)

    [detected_events_is_high, detected_events_rules, detected_events_is_exact, detected_events_source_price, detected_events_source_bar_index]

is_sunday_liquidity_reopen(time_value) =>
    not include_daily_liquidity_sunday and dayofweek(time_value, NY_TIMEZONE) == dayofweek.sunday and hour(time_value, NY_TIMEZONE) >= SUNDAY_REOPEN_START_HOUR

is_new_liquidity_session(pool_type) =>
    prev_time = time[1]
    if na(prev_time)
        false
    else
        switch pool_type
            LIQUIDITY_SOURCE_TYPE_DAILY =>
                dayofmonth(prev_time, NY_TIMEZONE) != dayofmonth(time, NY_TIMEZONE)
            LIQUIDITY_SOURCE_TYPE_WEEKLY =>
                weekofyear(prev_time, NY_TIMEZONE) != weekofyear(time, NY_TIMEZONE)
            LIQUIDITY_SOURCE_TYPE_MONTHLY =>
                month(prev_time, NY_TIMEZONE) != month(time, NY_TIMEZONE)
            => false

// Get invalidation threshold percentage
get_mbz_invalidation_threshold() =>
    switch mbz_invalidation_mode
        INVALIDATION_STANDARD => STANDARD_INVALIDATION_PERCENT    // LESS sensitive, LATER invalidation
        INVALIDATION_STRICT => STRICT_INVALIDATION_PERCENT        // MORE sensitive, EARLIER invalidation
        INVALIDATION_CUSTOM => custom_threshold_percent
        => 100.0

// Validated breach threshold - ensures breach is always below invalidation
get_validated_breach_threshold() =>
    invalidation_threshold = get_mbz_invalidation_threshold()
    breach_threshold_percent < invalidation_threshold ? breach_threshold_percent : invalidation_threshold - 5.0

get_projection_line_style() =>
    switch projection_line_style
        LINE_STYLE_SOLID => line.style_solid
        LINE_STYLE_DASHED => line.style_dashed
        LINE_STYLE_DOTTED => line.style_dotted
        => line.style_solid

// Get breach line style based on user setting
get_breached_line_style() =>
    switch breached_line_style
        LINE_STYLE_SOLID => line.style_solid
        LINE_STYLE_DASHED => line.style_dashed
        LINE_STYLE_DOTTED => line.style_dotted
        => line.style_dashed

// Calculate breach level price for a given MBZ zone
get_breached_level_price(zone_top, zone_bottom, is_bullish_mbz) =>
    if not enable_breached_lines
        na
    else
        validated_breach_threshold = get_validated_breach_threshold()
        zone_height = zone_top - zone_bottom
        breach_distance = zone_height * (validated_breach_threshold / 100.0)

        if is_bullish_mbz
            // For MBZ⁺, breach level is INSIDE zone from top boundary
            zone_top - breach_distance
        else
            // For MBZ⁻, breach level is INSIDE zone from bottom boundary
            zone_bottom + breach_distance

// Get breach line color based on current breach status
get_breached_line_color() =>
    // Apply user-defined transparency to breach line color
    color.new(color.rgb(color.r(breached_line_color), color.g(breached_line_color), color.b(breached_line_color)), breached_line_transparency)

// Get invalidation line style based on user setting
get_invalidation_line_style() =>
    switch invalidation_line_style
        LINE_STYLE_SOLID => line.style_solid
        LINE_STYLE_DASHED => line.style_dashed
        LINE_STYLE_DOTTED => line.style_dotted
        => line.style_solid

// Calculate invalidation level price for display
get_invalidation_level_price(zone_top, zone_bottom, is_bullish_mbz) =>
    if not enable_invalidation_lines
        na
    else
        invalidation_threshold = get_mbz_invalidation_threshold()
        zone_height = zone_top - zone_bottom
        invalidation_distance = zone_height * (invalidation_threshold / 100.0)

        if is_bullish_mbz
            zone_top - invalidation_distance  // Inside zone from top
        else
            zone_bottom + invalidation_distance  // Inside zone from bottom

// Get invalidation line color
get_invalidation_line_color() =>
    // Apply user-defined transparency to invalidation line color
    color.new(color.rgb(color.r(invalidation_line_color), color.g(invalidation_line_color), color.b(invalidation_line_color)), invalidation_line_transparency)

// ═══════════════════════════════════════════════════════════════════════════════
// IMBALANCE SOURCE ORIGIN AND SUBTYPE DISPLAY MAPPING
// ═══════════════════════════════════════════════════════════════════════════════

// Liquidity-only mode: no imbalance sources to display
get_source_display(source_key) =>
    ""

format_source_token(token, count) => count <= 1 ? token : token + MULTIPLIER_SYMBOL + str.tostring(count)

get_mbz_primary_source_token(mbz_record) =>
    token = mbz_record.source_origin_token

    if token == "" and mbz_record.variant == VARIANT_LIQUIDITY
        formation_rule_value = mbz_record.formation_rule
        if formation_rule_value != ""
            token := str.replace_all(formation_rule_value, "liquidity_", "")

    if token == ""
        fallback_token = get_source_display(mbz_record.source_type)
        if fallback_token != ""
            token := fallback_token

    // Liquidity-only mode - no imbalance subtype checking needed

    token != "" ? str.replace_all(token, "_", "-") : token

// Get display name for subtype with arrows (lowercase for labels)
get_subtype_display(mbz_subtype, is_bullish) =>
    if str.contains(mbz_subtype, SUBTYPE_INCLUSION)
        if is_bullish
            ARROW_DOWN_INC  // Bullish inclusion = lower wick dominant (toward body)
        else
            ARROW_UP_INC  // Bearish inclusion = upper wick dominant (toward body)
    else if str.contains(mbz_subtype, SUBTYPE_REFLECTION)
        if is_bullish
            ARROW_UP_REF  // Bullish reflection = upper wick dominant (away from body)
        else
            ARROW_DOWN_REF  // Bearish reflection = lower wick dominant (away from body)
    else
        ""  // No suffix for standard

// Get display name for subtype with risk indicator properly positioned after behavior
get_risky_subtype_display(mbz_subtype, is_bullish, is_risky) =>
    if str.contains(mbz_subtype, SUBTYPE_INCLUSION)
        if is_bullish
            is_risky ? ARROW_DOWN_INC_RISKY : ARROW_DOWN_INC
        else
            is_risky ? ARROW_UP_INC_RISKY : ARROW_UP_INC
    else if str.contains(mbz_subtype, SUBTYPE_REFLECTION)
        if is_bullish
            is_risky ? ARROW_UP_REF_RISKY : ARROW_UP_REF
        else
            is_risky ? ARROW_DOWN_REF_RISKY : ARROW_DOWN_REF
    else
        ""  // No suffix for standard

// ═══════════════════════════════════════════════════════════════════════════════
// WICK DOMINANCE ANALYSIS
// ═══════════════════════════════════════════════════════════════════════════════

// Classify wick dominance into three tiers
classify_wick_dominance(mbz_body_size, mbz_upper_wick, mbz_lower_wick) =>
    if mbz_body_size <= 0
        [WICK_TIER_NONE, false]
    else
        mbz_upper_ratio = mbz_upper_wick / mbz_body_size
        mbz_lower_ratio = mbz_lower_wick / mbz_body_size
        max_wick_ratio = math.max(mbz_upper_ratio, mbz_lower_ratio)

        if max_wick_ratio >= WICK_DOMINANCE_STANDARD_THRESHOLD
            [WICK_TIER_STANDARD, true]  // ≥100%
        else if max_wick_ratio >= WICK_DOMINANCE_RELAXED_THRESHOLD
            [WICK_TIER_RELAXED, true]   // 85-99%
        else if max_wick_ratio >= WICK_DOMINANCE_RISKY_THRESHOLD
            [WICK_TIER_RISKY, true]     // 80-84%
        else
            [WICK_TIER_NONE, false]     // <80%

detect_mbz_subtype(mbz_open, mbz_close, mbz_high, mbz_low, source_type) =>
    if mbz_open == mbz_close
        [SUBTYPE_STANDARD, false]  // Doji handling
    else
        mbz_body_top = math.max(mbz_open, mbz_close)
        mbz_body_bottom = math.min(mbz_open, mbz_close)
        mbz_body_size = mbz_body_top - mbz_body_bottom
        mbz_upper_wick = mbz_high - mbz_body_top
        mbz_lower_wick = mbz_body_bottom - mbz_low
        is_candle_bullish = mbz_close > mbz_open

        // STEP 1: Determine base classification (liquidity-only mode)
        base_classification = SUBTYPE_STANDARD  // Always standard for liquidity sources

        // STEP 2: Check wick dominance using three-tier system (≥80% minimum)
        [wick_tier, has_dominant] = classify_wick_dominance(mbz_body_size, mbz_upper_wick, mbz_lower_wick)

        if not has_dominant
            [base_classification, false]  // No wick dominance = base type only
        else
            // SIMPLE MAJORITY RULE: Biggest wick wins, exact ties favor inclusion patterns
            is_exact_tie = mbz_upper_wick == mbz_lower_wick
            upper_is_dominant = false  // Declare variable first

            if is_exact_tie
                // TIE-BREAKING LOGIC: When mbz_upper_wick == mbz_lower_wick (exact tie)
                // Design decision: All ties result in INCLUSION patterns for consistency
                // - Bullish ties: Force lower wick dominance → inclusion pattern → "inc-tie"
                // - Bearish ties: Force upper wick dominance → inclusion pattern → "inc-tie"
                // This ensures predictable, uniform behavior regardless of candle direction
                upper_is_dominant := not is_candle_bullish  // Bullish ties→lower dominant, Bearish ties→upper dominant
            else
                // CLEAR DOMINANCE: Standard comparison when wicks are different sizes
                upper_is_dominant := mbz_upper_wick > mbz_lower_wick

            // STEP 3: Determine wick pattern direction using simple majority
            // SIMPLE MAJORITY CLASSIFICATION: Clear, predictable wick-based subtyping
            // Note: Due to tie-breaking logic above, ties can ONLY result in inclusion patterns
            // - Bullish ties: upper_is_dominant=false → takes inclusion path → "inc-tie"
            // - Bearish ties: upper_is_dominant=true → takes inclusion path → "inc-tie"
            // Therefore, "reflection-tie" is impossible and was removed as dead code
            wick_pattern = ""
            pattern_enabled = false

            if is_candle_bullish
                if upper_is_dominant and enable_reflection
                    // Bullish + upper wick dominance = reflection (clear dominance only, never ties)
                    wick_pattern := SUBTYPE_REFLECTION
                    pattern_enabled := true
                else if not upper_is_dominant and enable_inclusion
                    // Bullish + lower wick dominance = inclusion (clear dominance OR ties)
                    wick_pattern := is_exact_tie ? SUBTYPE_INCLUSION_TIE : SUBTYPE_INCLUSION
                    pattern_enabled := true
            else
                if upper_is_dominant and enable_inclusion
                    // Bearish + upper wick dominance = inclusion (clear dominance OR ties)
                    wick_pattern := is_exact_tie ? SUBTYPE_INCLUSION_TIE : SUBTYPE_INCLUSION
                    pattern_enabled := true
                else if not upper_is_dominant and enable_reflection
                    // Bearish + lower wick dominance = reflection (clear dominance only, never ties)
                    wick_pattern := SUBTYPE_REFLECTION
                    pattern_enabled := true

            // STEP 4: Combine base classification with wick pattern (liquidity-only mode)
            if pattern_enabled
                // Liquidity sources always use standard base, just add pattern
                final_subtype = wick_pattern
                [final_subtype, true]
            else
                [base_classification, false]

// ═══════════════════════════════════════════════════════════════════════════════
// MBZ ZONE CALCULATION - FIXED REFLECTION BUG
// ═══════════════════════════════════════════════════════════════════════════════

// Calculate zone boundaries for MBZ subtypes with corrected reflection logic
get_mbz_subtype_zone(mbz_record) =>
    if str.contains(mbz_record.mbz_subtype, SUBTYPE_INCLUSION)
        if mbz_record.is_bullish
            // Bullish inclusion: close down to low (body + lower wick zone)
            [mbz_record.mbz_close, mbz_record.low_price]
        else
            // Bearish inclusion: high down to close (body + upper wick zone)
            [mbz_record.high_price, mbz_record.mbz_close]
    else if str.contains(mbz_record.mbz_subtype, SUBTYPE_REFLECTION)
        if mbz_record.is_bullish
            // Bullish reflection uses OPEN as reference (not close)
            wick_range = math.abs(mbz_record.high_price - mbz_record.mbz_open)
            [mbz_record.mbz_close, mbz_record.mbz_close - wick_range]
        else
            // Bearish reflection uses OPEN as reference (not close)
            wick_range = math.abs(mbz_record.low_price - mbz_record.mbz_open)
            [mbz_record.mbz_close + wick_range, mbz_record.mbz_close]
    else
        // Standard MBZ uses BODY zone [open, close], NOT [high, low]!
        body_top = math.max(mbz_record.mbz_open, mbz_record.mbz_close)
        body_bottom = math.min(mbz_record.mbz_open, mbz_record.mbz_close)
        [body_top, body_bottom]

// ═══════════════════════════════════════════════════════════════════════════════
// SUPER MBZ DETECTION SYSTEM - REFLECTION ZONE OVERLAP FIXED
// ═══════════════════════════════════════════════════════════════════════════════

// @function detect_mbz_strength
// @description Detects if new MBZ overlaps with existing same-direction MBZs using proper zone-to-zone comparison
// @param new_mbz_record MBZRecord The new MBZ to check for nested/super status
// @returns tuple [bool, float, int] [is_super, overlap_percentage, overlapping_bar_index]
// @note Uses zone-based overlap detection for all MBZ types including reflection zones
detect_mbz_strength(new_mbz_record) =>
    if not enable_super_mbzs or array.size(all_mbz_records) == 0
        [false, 0.0, int(na)]
    else
        is_super = false
        stored_percentage = 0.0
        overlapped_bar = int(na)

        // OPTIMIZED: Limit scanning to recent records only (massive performance gain)
        if array.size(all_mbz_records) > 0
            scan_limit = math.min(SUPER_MBZ_SCAN_LIMIT, array.size(all_mbz_records))
            start_index = math.max(0, array.size(all_mbz_records) - scan_limit)

            for record_index = start_index to array.size(all_mbz_records) - 1
                existing_mbz = array.get(all_mbz_records, record_index)
                if not existing_mbz.is_invalidated and
                   existing_mbz.bar_index < new_mbz_record.bar_index and
                   existing_mbz.is_bullish == new_mbz_record.is_bullish  // SAME DIRECTION ONLY

                    // Use zone-to-zone for reflection MBZs, preserve candle-to-zone for standard MBZs
                    // This ensures reflection zones are detected while maintaining backward compatibility
                    has_overlap = false

                    // Check if either MBZ has reflection subtype - use zone-to-zone comparison
                    if str.contains(existing_mbz.mbz_subtype, SUBTYPE_REFLECTION) or str.contains(new_mbz_record.mbz_subtype, SUBTYPE_REFLECTION)
                        // Zone-to-zone comparison for reflection MBZs (needed for zones extending beyond candles)
                        [existing_zone_top, existing_zone_bottom] = get_mbz_subtype_zone(existing_mbz)
                        [new_zone_top, new_zone_bottom] = get_mbz_subtype_zone(new_mbz_record)
                        has_overlap := new_zone_bottom < existing_zone_top and new_zone_top > existing_zone_bottom
                    else
                        // Original candle-to-zone comparison for standard MBZs (preserves existing behavior)
                        if new_mbz_record.low_price < existing_mbz.high_price and new_mbz_record.high_price > existing_mbz.low_price
                            [zone_top, zone_bottom] = get_mbz_subtype_zone(existing_mbz)
                            has_overlap := new_mbz_record.low_price < zone_top and new_mbz_record.high_price > zone_bottom

                    if has_overlap
                        // Calculate overlap percentage based on detection method used
                        overlap_top = 0.0
                        overlap_bottom = 0.0
                        new_mbz_range = 0.0

                        if str.contains(existing_mbz.mbz_subtype, SUBTYPE_REFLECTION) or str.contains(new_mbz_record.mbz_subtype, SUBTYPE_REFLECTION)
                            // Zone-based calculation for reflection MBZs
                            [existing_zone_top, existing_zone_bottom] = get_mbz_subtype_zone(existing_mbz)
                            [new_zone_top, new_zone_bottom] = get_mbz_subtype_zone(new_mbz_record)
                            overlap_top := math.min(new_zone_top, existing_zone_top)
                            overlap_bottom := math.max(new_zone_bottom, existing_zone_bottom)
                            new_mbz_range := new_zone_top - new_zone_bottom
                        else
                            // Original candle-based calculation for standard MBZs
                            [zone_top, zone_bottom] = get_mbz_subtype_zone(existing_mbz)
                            overlap_top := math.min(new_mbz_record.high_price, zone_top)
                            overlap_bottom := math.max(new_mbz_record.low_price, zone_bottom)
                            new_mbz_range := new_mbz_record.high_price - new_mbz_record.low_price

                        overlap_range = overlap_top - overlap_bottom

                        if new_mbz_range > 0
                            overlap_pct = (overlap_range / new_mbz_range) * 100

                            // Store the data - ANY zone overlap makes it SUPER (shows checkmark ✔️)
                            stored_percentage := overlap_pct
                            overlapped_bar := existing_mbz.bar_index
                            is_super := true
                            break  // Take first overlap found

        [is_super, stored_percentage, overlapped_bar]

// ═══════════════════════════════════════════════════════════════════════════════
// BREACH CONFIRMATION SYSTEM FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// No confirmation system - return record unchanged
check_mbz_confirmation(mbz_record) =>
    mbz_record

// ═══════════════════════════════════════════════════════════════════════════════
// BREACH AND INVALIDATION DETECTION SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

// Calculate zone penetration percentage using extreme prices (low/high)
calculate_mbz_zone_penetration_from_extreme(test_price, zone_top, zone_bottom, is_bullish_zone) =>
    zone_range = zone_top - zone_bottom
    if zone_range <= 0
        0.0
    else
        if is_bullish_zone
            // Bullish MBZ: penetration comes from above downward → use low
            if test_price >= zone_top
                0.0  // No penetration
            else if test_price <= zone_bottom
                100.0  // Full penetration
            else
                penetration_distance = zone_top - test_price
                (penetration_distance / zone_range) * 100.0
        else
            // Bearish MBZ: penetration comes from below upward → use high
            if test_price <= zone_bottom
                0.0  // No penetration
            else if test_price >= zone_top
                100.0  // Full penetration
            else
                penetration_distance = test_price - zone_bottom
                (penetration_distance / zone_range) * 100.0

// Calculate zone penetration percentage using candle body (open/close prices)
calculate_mbz_zone_penetration_from_body(open_price, close_price, zone_top, zone_bottom, is_bullish_zone) =>
    zone_range = zone_top - zone_bottom
    if zone_range <= 0
        0.0
    else
        if is_bullish_zone
            // Bullish zone: use LOWER of open/close for deepest penetration from above
            test_price = math.min(open_price, close_price)
            if test_price >= zone_top
                0.0  // No penetration
            else if test_price <= zone_bottom
                100.0  // Full penetration
            else
                penetration_distance = zone_top - test_price
                (penetration_distance / zone_range) * 100.0
        else
            // Bearish zone: use HIGHER of open/close for deepest penetration from below
            test_price = math.max(open_price, close_price)
            if test_price <= zone_bottom
                0.0  // No penetration
            else if test_price >= zone_top
                100.0  // Full penetration
            else
                penetration_distance = test_price - zone_bottom
                (penetration_distance / zone_range) * 100.0

// Calculate zone penetration percentage using close price (for invalidation)
calculate_mbz_zone_penetration_from_close(close_price, zone_top, zone_bottom, is_bullish_zone) =>
    zone_range = zone_top - zone_bottom
    if zone_range <= 0
        0.0
    else
        if is_bullish_zone
            // Bullish zone: penetration is from top downward
            if close_price >= zone_top
                0.0  // No penetration
            else if close_price <= zone_bottom
                100.0  // Full penetration
            else
                penetration_distance = zone_top - close_price
                (penetration_distance / zone_range) * 100.0
        else
            // Bearish zone: penetration is from bottom upward
            if close_price <= zone_bottom
                0.0  // No penetration
            else if close_price >= zone_top
                100.0  // Full penetration
            else
                penetration_distance = close_price - zone_bottom
                (penetration_distance / zone_range) * 100.0

// Calculate current breach percentage for tooltip display
get_current_breach_percentage(mbz_record) =>
    if mbz_record.is_invalidated or barstate.isconfirmed or bar_index == mbz_record.bar_index
        0.0
    else
        // Get the SAME zone that visuals use (corrected zones)
        [zone_top, zone_bottom] = get_mbz_subtype_zone(mbz_record)

        // Calculate penetration based on selected breach method
        current_penetration = breach_method == BREACH_METHOD_BODY_BREACH ? calculate_mbz_zone_penetration_from_body(open, close, zone_top, zone_bottom, mbz_record.is_bullish) : calculate_mbz_zone_penetration_from_extreme(mbz_record.is_bullish ? low : high, zone_top, zone_bottom, mbz_record.is_bullish)

        current_penetration

// Calculate current breach percentage for consolidated MBZ
get_consolidated_breach_percentage(consolidated_mbz) =>
    if consolidated_mbz.is_consolidated_invalidated or array.size(consolidated_mbz.mbz_group) == 0
        0.0
    else
        // Use the first MBZ for zone calculation (all should have same zone)
        first_mbz = array.get(consolidated_mbz.mbz_group, 0)
        [zone_top, zone_bottom] = get_mbz_subtype_zone(first_mbz)

        // Calculate penetration based on selected breach method
        current_penetration = breach_method == BREACH_METHOD_BODY_BREACH ? calculate_mbz_zone_penetration_from_body(open, close, zone_top, zone_bottom, consolidated_mbz.is_bullish) : calculate_mbz_zone_penetration_from_extreme(consolidated_mbz.is_bullish ? low : high, zone_top, zone_bottom, consolidated_mbz.is_bullish)

        current_penetration

// Real-time breach detection using subtype zones and selected method
is_mbz_currently_breached(mbz_record) =>
    // CRITICAL: Never show breach if disabled or in these cases:
    if not enable_breach_detection or mbz_record.is_invalidated or bar_index == mbz_record.bar_index
        false
    else
        validated_breach_threshold = get_validated_breach_threshold()
        // Get the SAME zone that visuals use (corrected zones)
        [zone_top, zone_bottom] = get_mbz_subtype_zone(mbz_record)

        // Calculate penetration based on selected breach method
        current_penetration = breach_method == BREACH_METHOD_BODY_BREACH ? calculate_mbz_zone_penetration_from_body(open, close, zone_top, zone_bottom, mbz_record.is_bullish) : calculate_mbz_zone_penetration_from_extreme(mbz_record.is_bullish ? low : high, zone_top, zone_bottom, mbz_record.is_bullish)

        // Show breach if penetration meets or exceeds validated breach threshold
        current_penetration >= validated_breach_threshold

// Enhanced invalidation: Check BOTH open and close for gaps and penetration
should_mbz_be_invalidated_enhanced(mbz_record, current_open, current_close) =>
    invalidation_threshold = get_mbz_invalidation_threshold()

    // Get the SAME zone that visuals use (corrected zones)
    [zone_top, zone_bottom] = get_mbz_subtype_zone(mbz_record)

    // CRITICAL: Check for OPENING GAPS first (immediate invalidation)
    if mbz_record.is_bullish
        // Bullish MBZ: If candle opens BELOW zone bottom = instant invalidation
        if current_open < zone_bottom
            true  // GAPPED BELOW - IMMEDIATE INVALIDATION
        else
            // No gap - check close penetration normally
            penetration_percentage = calculate_mbz_zone_penetration_from_close(current_close, zone_top, zone_bottom, mbz_record.is_bullish)
            penetration_percentage >= invalidation_threshold
    else
        // Bearish MBZ: If candle opens ABOVE zone top = instant invalidation
        if current_open > zone_top
            true  // GAPPED ABOVE - IMMEDIATE INVALIDATION
        else
            // No gap - check close penetration normally
            penetration_percentage = calculate_mbz_zone_penetration_from_close(current_close, zone_top, zone_bottom, mbz_record.is_bullish)
            penetration_percentage >= invalidation_threshold

// Legacy function for backward compatibility (now calls enhanced version)
should_mbz_be_invalidated(mbz_record, confirmed_close_price) =>
    should_mbz_be_invalidated_enhanced(mbz_record, open, confirmed_close_price)

// ═══════════════════════════════════════════════════════════════════════════════
// LABEL BUILDING FUNCTIONS - DEFINED BEFORE CACHING
// ═══════════════════════════════════════════════════════════════════════════════

// Build MBZ label text with bearish 5-4-3-2-1 reversal and new hierarchy
build_mbz_label_text(mbz_record, wick_tier) =>
    // Check for real-time breach status
    is_currently_breached = is_mbz_currently_breached(mbz_record)

    // Get formation rule prefix
    formation_prefix = ""
    if mbz_record.formation_rule == FORMATION_RULE_LIQUIDITY_IMMEDIATE
        formation_prefix := FORMATION_PREFIX_LIQUIDITY_IMMEDIATE
    else if mbz_record.formation_rule == FORMATION_RULE_LIQUIDITY_STANDARD
        formation_prefix := FORMATION_PREFIX_LIQUIDITY_STANDARD
    else if mbz_record.formation_rule == FORMATION_RULE_LIQUIDITY_DELAYED
        formation_prefix := FORMATION_PREFIX_LIQUIDITY_DELAYED
    // Imbalance standard has no prefix (status quo)

    // Build main MBZ text with formation prefix and [½] inline
    mbz_base_text = formation_prefix + MBZ_BASE_TEXT + (mbz_record.is_bullish ? MBZ_BULLISH_SUFFIX : MBZ_BEARISH_SUFFIX)
    mbz_text = show_50_percent_tags and mbz_record.is_exactly_50_percent ? mbz_base_text + FIFTY_PERCENT_TAG : mbz_base_text

    // Handle different display modes
    if mbz_symbol_type == DISPLAY_MODE_ARROW_ONLY
        mbz_record.is_bullish ? "▲" : "▼"
    else
        // Build label parts in correct hierarchy order
        label_parts = array.new<string>()

        // 1. Arrow (for Arrow + Text mode only)
        if mbz_symbol_type == DISPLAY_MODE_ARROW_TEXT
            arrow = mbz_record.is_bullish ? "▲" : "▼"
            array.push(label_parts, arrow)

        // 2. MBZ label with [½] (most important)
        array.push(label_parts, mbz_text)

        // 3. Source type (contiguous - 2nd most important, only if advanced and not standard)
        if show_enhanced_label_details
            source_token = get_mbz_primary_source_token(mbz_record)
            if source_token != ""
                array.push(label_parts, "(" + source_token + ")")

        // 4. Subtype with risk indicator (3rd importance)
        if show_enhanced_label_details
            subtype_display = get_subtype_display(mbz_record.mbz_subtype, mbz_record.is_bullish)
            if subtype_display != ""
                // Add risk indicator to subtype (positioned after behavior)
                subtype_is_risky = wick_tier == WICK_TIER_RISKY
                risky_subtype = get_risky_subtype_display(mbz_record.mbz_subtype, mbz_record.is_bullish, subtype_is_risky)
                array.push(label_parts, risky_subtype)

        // 5. Status - BREACH or X, always at end (BREACH replaces X during breach)
        if is_currently_breached and not mbz_record.is_invalidated
            array.push(label_parts, BREACH_STATUS_LABEL)
        else if mbz_record.is_invalidated
            array.push(label_parts, "[X]")

        // MBZ⁻ Order - reverse the parts for MBZ⁻
        if not mbz_record.is_bullish and array.size(label_parts) > 0
            // Reverse the array for bearish stacking
            reversed_parts = array.new<string>()
            for i = array.size(label_parts) - 1 to 0 by 1
                array.push(reversed_parts, array.get(label_parts, i))
            label_parts := reversed_parts

        // Join with newlines for vertical stacking
        result = ""
        for i = 0 to array.size(label_parts) - 1
            if i > 0
                result := result + "\n"
            result := result + array.get(label_parts, i)

        result

// Build comprehensive MBZ tooltip with Volume Imbalance support and directional arrows
build_mbz_tooltip(mbz_record, wick_tier) =>
    // Get formation rule prefix
    formation_prefix = ""
    if mbz_record.formation_rule == FORMATION_RULE_LIQUIDITY_IMMEDIATE
        formation_prefix := FORMATION_PREFIX_LIQUIDITY_IMMEDIATE
    else if mbz_record.formation_rule == FORMATION_RULE_LIQUIDITY_STANDARD
        formation_prefix := FORMATION_PREFIX_LIQUIDITY_STANDARD
    else if mbz_record.formation_rule == FORMATION_RULE_LIQUIDITY_DELAYED
        formation_prefix := FORMATION_PREFIX_LIQUIDITY_DELAYED
    // Imbalance standard has no prefix (status quo)

    // Build behavior-first tooltip with risk warnings
    risky_prefix = wick_tier == WICK_TIER_RISKY ? "*" : ""

    behavior_text = ""
    if str.contains(mbz_record.mbz_subtype, SUBTYPE_INCLUSION)
        behavior_text := risky_prefix + "Inclusion "
    else if str.contains(mbz_record.mbz_subtype, SUBTYPE_REFLECTION)
        behavior_text := risky_prefix + "Reflection "

    direction = mbz_record.is_bullish ? MBZ_PLUS : MBZ_MINUS
    base_text = behavior_text + formation_prefix + direction

    // Add SUPER MBZ information
    strength_info = ""
    if mbz_record.is_super_mbz
        bars_ago = bar_index - mbz_record.overlapping_mbz_bar_index
        direction_text = mbz_record.is_bullish ? MBZ_PLUS : MBZ_MINUS
        strength_info := "\n" + str.tostring(mbz_record.overlap_percentage, "#.1") + "% overlap with " + direction_text + " from " + str.tostring(bars_ago) + " bars ago"

    // Add breach status with percentage
    is_currently_breached = is_mbz_currently_breached(mbz_record)
    breach_text = ""
    if is_currently_breached and not mbz_record.is_invalidated
        current_breach_pct = get_current_breach_percentage(mbz_record)
        breach_text := BREACH_STATUS_TEXT + str.tostring(current_breach_pct, "#.1") + BREACH_STATUS_SUFFIX
    else if not mbz_record.is_invalidated and not barstate.isconfirmed
        // Show re-entry percentage when price is back inside zone
        current_breach_pct = get_current_breach_percentage(mbz_record)
        if current_breach_pct > 0
            breach_text := " - " + str.tostring(current_breach_pct, "#.1") + "% filled"

    half_text = mbz_record.is_exactly_50_percent ? " [exactly 50%]" : ""
    fill_text = mbz_record.max_fill_percentage > 0 ? " (" + str.tostring(mbz_record.max_fill_percentage, "#.#") + "% filled)" : ""
    invalid_text = mbz_record.is_invalidated ? " - INVALIDATED" : ""

    base_text + half_text + fill_text + strength_info + breach_text + invalid_text

// ═══════════════════════════════════════════════════════════════════════════════
// CACHING FUNCTIONS - NOW DEFINED AFTER LABEL BUILDING
// ═══════════════════════════════════════════════════════════════════════════════

// Performance optimization: Cache frequently computed MBZ data using corrected zone logic
cache_mbz_data(mbz_record) =>
    // Calculate zone coordinates using the SAME get_mbz_subtype_zone() function that breach/invalidation use
    [cached_zone_top, cached_zone_bottom] = get_mbz_subtype_zone(mbz_record)

    // Determine wick tier for risky prefix
    mbz_body_top = math.max(mbz_record.mbz_open, mbz_record.mbz_close)
    mbz_body_bottom = math.min(mbz_record.mbz_open, mbz_record.mbz_close)
    mbz_body_size = mbz_body_top - mbz_body_bottom
    mbz_upper_wick = mbz_record.high_price - mbz_body_top
    mbz_lower_wick = mbz_body_bottom - mbz_record.low_price
    [wick_tier, has_wick_dominance] = classify_wick_dominance(mbz_body_size, mbz_upper_wick, mbz_lower_wick)

    // Cache tooltip only - label text rebuilt every bar for real-time breach detection
    cached_label_text = ""  // Don't cache label text - rebuild for real-time breach detection
    cached_tooltip = build_mbz_tooltip(mbz_record, wick_tier)

    // Return new record with all cached data
    MBZRecord.new(
         mbz_record.bar_index,
         mbz_record.high_price,
         mbz_record.low_price,
         mbz_record.mbz_open,
         mbz_record.mbz_close,
         mbz_record.is_bullish,
         mbz_record.is_invalidated,
         mbz_record.max_fill_percentage,
         mbz_record.has_dominant_wick,
         mbz_record.is_exactly_50_percent,
         mbz_record.mbz_subtype,
         cached_label_text,
         cached_tooltip,
         cached_zone_top,
         cached_zone_bottom,
         true,
         mbz_record.mbz_label,
         mbz_record.source_id,
         mbz_record.source_bar_index,
         mbz_record.source_high,
         mbz_record.source_low,
         mbz_record.source_family,
         mbz_record.source_type,
         mbz_record.pool_boundary,
         mbz_record.wicked_deeper_into_source,
         mbz_record.reflection_pattern_deeper,
         mbz_record.is_super_mbz,
         mbz_record.overlap_percentage,
         mbz_record.overlapping_mbz_bar_index,
         mbz_record.variant,
         mbz_record.formation_rule,
         mbz_record.source_origin_token
     )

get_cached_mbz_subtype_zone(mbz_record) =>
    if not mbz_record.cached_data_valid
        cached_record = cache_mbz_data(mbz_record)
        [cached_record.cached_zone_top, cached_record.cached_zone_bottom]
    else
        [mbz_record.cached_zone_top, mbz_record.cached_zone_bottom]

// ═══════════════════════════════════════════════════════════════════════════════
// CONSOLIDATION SYSTEM - PORTED FROM SIF CODE // ═══════════════════════════════════════════════════════════════════════════════

// Group MBZs by candle (bar_index) - adapted from SIF
group_mbzs_by_candle(mbz_records) =>
    grouped_mbzs = array.new<ConsolidatedMBZ>()

    if array.size(mbz_records) == 0
        grouped_mbzs
    else
        // Create map-like structure using arrays
        processed_candles = array.new<int>()

        for i = 0 to array.size(mbz_records) - 1
            mbz_record = array.get(mbz_records, i)
            current_bar = mbz_record.bar_index

            // Check if we already processed this candle
            if not array.includes(processed_candles, current_bar)
                // Collect all MBZs for this candle
                candle_mbzs = array.new<MBZRecord>()

                for j = 0 to array.size(mbz_records) - 1
                    other_mbz = array.get(mbz_records, j)
                    if other_mbz.bar_index == current_bar
                        array.push(candle_mbzs, other_mbz)

                // Create consolidated MBZ if we have any records
                if array.size(candle_mbzs) > 0
                    first_mbz = array.get(candle_mbzs, 0)

                    // Initialize placeholders; derived values computed below
                    consolidated = ConsolidatedMBZ.new(
                         candle_mbzs,
                         current_bar,
                         first_mbz.is_bullish,  // All MBZs on same candle have same direction
                         0.0,
                         0.0,
                         false,
                         false,
                         "",
                         ""
                     )
                    array.push(grouped_mbzs, consolidated)
                    array.push(processed_candles, current_bar)

                    // Note: Multi-source alert flags are set during MBZ creation
                    // to avoid assigning globals from within a function.

        grouped_mbzs

// Calculate consolidated zone boundaries (outermost limits) - adapted from SIF
calculate_consolidated_zone_boundaries(mbz_group) =>
    if array.size(mbz_group) == 0
        [float(na), float(na)]
    else
        zone_top = -999999.0
        zone_bottom = 999999.0

        for i = 0 to array.size(mbz_group) - 1
            mbz_record = array.get(mbz_group, i)
            [individual_top, individual_bottom] = get_mbz_subtype_zone(mbz_record)

            if individual_top > zone_top
                zone_top := individual_top
            if individual_bottom < zone_bottom
                zone_bottom := individual_bottom

        [zone_top, zone_bottom]

// Determine consolidated status for group - adapted from SIF
determine_consolidated_status(consolidated_mbz) =>
    invalidation_threshold = get_mbz_invalidation_threshold()
    is_breached = consolidated_mbz.is_consolidated_breached  // Start with existing breach state
    is_invalidated = consolidated_mbz.is_consolidated_invalidated  // Start with existing invalidation state

    // First check if any MBZ in group is already invalidated
    for i = 0 to array.size(consolidated_mbz.mbz_group) - 1
        mbz = array.get(consolidated_mbz.mbz_group, i)
        if mbz.is_invalidated
            is_invalidated := true
            break

    // Only check for breach if NOT already breached AND NOT already invalidated
    if not is_breached and not is_invalidated and enable_breach_detection
        // Check breach using breach threshold (both real-time and historical) - exclude formation candle
        if bar_index != consolidated_mbz.bar_index
            validated_breach_threshold = get_validated_breach_threshold()

            // For current bar, check real-time price using selected breach method
            current_penetration = breach_method == BREACH_METHOD_BODY_BREACH ? calculate_mbz_zone_penetration_from_body(open, close, consolidated_mbz.consolidated_zone_top, consolidated_mbz.consolidated_zone_bottom, consolidated_mbz.is_bullish) : calculate_mbz_zone_penetration_from_extreme(consolidated_mbz.is_bullish ? low : high, consolidated_mbz.consolidated_zone_top, consolidated_mbz.consolidated_zone_bottom, consolidated_mbz.is_bullish)

            // Check if current bar breached
            if current_penetration >= validated_breach_threshold
                is_breached := true
            else
                // For old MBZs, check historical breach by looking back from formation
                bars_since_formation = bar_index - consolidated_mbz.bar_index
                if bars_since_formation > 1  // Only check history for old MBZs
                    historical_breach_found = false
                    // Look back through bars since formation (but not beyond formation)
                    max_lookback = math.min(bars_since_formation - 1, HISTORICAL_LOOKBACK_LIMIT)  // Limit to bars since formation or 500, whichever is smaller
                    for i = 1 to max_lookback
                        historical_penetration = breach_method == BREACH_METHOD_BODY_BREACH ? calculate_mbz_zone_penetration_from_body(open[i], close[i], consolidated_mbz.consolidated_zone_top, consolidated_mbz.consolidated_zone_bottom, consolidated_mbz.is_bullish) : calculate_mbz_zone_penetration_from_extreme(consolidated_mbz.is_bullish ? low[i] : high[i], consolidated_mbz.consolidated_zone_top, consolidated_mbz.consolidated_zone_bottom, consolidated_mbz.is_bullish)
                        if historical_penetration >= validated_breach_threshold
                            historical_breach_found := true
                            break
                    is_breached := historical_breach_found

        // Check invalidation (confirmed close) - both current and historical
        if not is_invalidated and barstate.isconfirmed
            // Check current bar first
            current_penetration = calculate_mbz_zone_penetration_from_close(
                 close,
                 consolidated_mbz.consolidated_zone_top,
                 consolidated_mbz.consolidated_zone_bottom,
                 consolidated_mbz.is_bullish
             )
            if current_penetration >= invalidation_threshold
                is_invalidated := true
            else
                // For old MBZs, check historical invalidation by looking back from formation
                bars_since_formation = bar_index - consolidated_mbz.bar_index
                if bars_since_formation > 1  // Only check history for old MBZs
                    historical_invalidation_found = false
                    // Look back through bars since formation (but not beyond formation)
                    max_lookback = math.min(bars_since_formation - 1, HISTORICAL_LOOKBACK_LIMIT)  // Limit to bars since formation or 500, whichever is smaller
                    for i = 1 to max_lookback
                        historical_close_price = close[i]
                        historical_penetration = calculate_mbz_zone_penetration_from_close(
                             historical_close_price,
                             consolidated_mbz.consolidated_zone_top,
                             consolidated_mbz.consolidated_zone_bottom,
                             consolidated_mbz.is_bullish
                         )
                        if historical_penetration >= invalidation_threshold
                            historical_invalidation_found := true
                            break
                    is_invalidated := historical_invalidation_found

    [is_breached, is_invalidated]

// Build source type statistics for consolidated MBZ groups
get_source_type_stats(mbz_group) =>
    stats = SourceTypeStats.new(0, 0, 0, 0, 0, 0)
    stats.group_size := array.size(mbz_group)

    tokens_seen = array.new<string>()

    for i = 0 to stats.group_size - 1
        mbz_record = array.get(mbz_group, i)
        token = mbz_record.source_origin_token
        source_type = mbz_record.source_type
        source_family = mbz_record.source_family

        if token == "" and source_type != ""
            if source_family == SOURCE_FAMILY_LIQUIDITY
                token := source_type

        // Liquidity-only mode - count liquidity sources only
        counted_token = false

        if token == LIQUIDITY_SOURCE_TYPE_DAILY
            stats.liquidity_daily_count += 1
            counted_token := true
        else if token == LIQUIDITY_SOURCE_TYPE_WEEKLY
            stats.liquidity_weekly_count += 1
            counted_token := true
        else if token == LIQUIDITY_SOURCE_TYPE_MONTHLY
            stats.liquidity_monthly_count += 1
            counted_token := true

        if counted_token
            stats.liquidity_total_count += 1

        if counted_token and token != "" and not array.includes(tokens_seen, token)
            array.push(tokens_seen, token)

    stats.distinct_types := array.size(tokens_seen)
    stats

is_multi_source_strong(stats) =>
    meets_threshold = stats.group_size >= multi_source_strong_min_sources
    qualifies_distinct = multi_source_strong_include_distinct and stats.distinct_types > 1
    qualifies_same = multi_source_strong_include_same and stats.distinct_types == 1 and stats.group_size >= multi_source_strong_min_sources
    meets_threshold and (qualifies_distinct or qualifies_same)

should_show_strong_on_labels() =>
    multi_source_strong_display_mode == MULTI_SOURCE_STRONG_DISPLAY_LABEL or multi_source_strong_display_mode == MULTI_SOURCE_STRONG_DISPLAY_BOTH

should_show_strong_on_extensions() =>
    multi_source_strong_display_mode == MULTI_SOURCE_STRONG_DISPLAY_EXTENSION or multi_source_strong_display_mode == MULTI_SOURCE_STRONG_DISPLAY_BOTH

// Check if any MBZ in group is SUPER
has_super_mbzs(mbz_group) =>
    has_super = false

    for i = 0 to array.size(mbz_group) - 1
        mbz_record = array.get(mbz_group, i)
        if mbz_record.is_super_mbz
            has_super := true
            break

    has_super

// Register a newly created MBZ record into the global state (handles SUPER detection, caching, alerts)
register_new_mbz_record(mbz_record) =>
    // Detect SUPER MBZ strength before caching
    [is_super, overlap_pct, overlapped_bar] = detect_mbz_strength(mbz_record)

    mbz_record.is_super_mbz := is_super
    mbz_record.overlap_percentage := overlap_pct
    mbz_record.overlapping_mbz_bar_index := overlapped_bar

    // Cache derived data for performant reuse
    cached_mbz = cache_mbz_data(mbz_record)

    array.push(all_mbz_records, cached_mbz)
    array.push(active_mbz_records, cached_mbz)  // PERFORMANCE: Also add to active array for fast invalidation checks

    // Collect per-registration alert flags for caller (keep functions free of global mutation)
    formed_bull = cached_mbz.is_bullish
    formed_bear = not cached_mbz.is_bullish
    strong_plus = false
    strong_minus = false
    multi_plus = false
    multi_minus = false
    nested_plus = false
    nested_minus = false

    // Multi-source MBZ alert detection: set flags when >=2 MBZs form on same bar and direction
    same_bar_same_direction_count = 0
    for record_index = 0 to array.size(all_mbz_records) - 1
        existing_mbz_record = array.get(all_mbz_records, record_index)
        if existing_mbz_record.bar_index == cached_mbz.bar_index and existing_mbz_record.is_bullish == cached_mbz.is_bullish
            same_bar_same_direction_count += 1

    if same_bar_same_direction_count >= MIN_MULTI_SOURCE_ALERT_COUNT
        same_bar_mbzs = array.new<MBZRecord>()
        for record_index = 0 to array.size(all_mbz_records) - 1
            grouped_mbz = array.get(all_mbz_records, record_index)
            if grouped_mbz.bar_index == cached_mbz.bar_index and grouped_mbz.is_bullish == cached_mbz.is_bullish
                array.push(same_bar_mbzs, grouped_mbz)

        stats_for_alerts = get_source_type_stats(same_bar_mbzs)
        is_strong_multi_source = is_multi_source_strong(stats_for_alerts)

        if is_strong_multi_source
            if cached_mbz.is_bullish
                strong_plus := true
                multi_plus := true
            else
                strong_minus := true
                multi_minus := true
        else
            if cached_mbz.is_bullish
                multi_plus := true
            else
                multi_minus := true

    // Nested MBZ detection: Check for overlapping MBZs in same direction
    newly_added_index = array.size(all_mbz_records) - 1
    for overlap_check = 0 to array.size(all_mbz_records) - 1
        if overlap_check != newly_added_index
            overlap_mbz = array.get(all_mbz_records, overlap_check)
            if overlap_mbz.is_bullish == cached_mbz.is_bullish
                mbz_top = math.max(cached_mbz.mbz_open, cached_mbz.mbz_close)
                mbz_bottom = math.min(cached_mbz.mbz_open, cached_mbz.mbz_close)
                overlap_top = math.max(overlap_mbz.mbz_open, overlap_mbz.mbz_close)
                overlap_bottom = math.min(overlap_mbz.mbz_open, overlap_mbz.mbz_close)

                if mbz_bottom <= overlap_top and mbz_top >= overlap_bottom
                    if cached_mbz.is_bullish
                        nested_plus := true
                    else
                        nested_minus := true

    [cached_mbz, formed_bull, formed_bear, strong_plus, strong_minus, multi_plus, multi_minus, nested_plus, nested_minus]

// Helper to create and register a liquidity MBZ record (boundary derived)
create_liquidity_mbz_record(formation_bar_index, formation_open, formation_high, formation_low, formation_close, pool_type, pool_boundary, formation_rule, source_price, source_bar_index, is_bullish, source_origin_token, is_exact_midpoint, pool, is_high_boundary) =>
    liquidity_source_id = array.get(liquidity_source_id_counter, 0)
    array.set(liquidity_source_id_counter, 0, liquidity_source_id + 1)

    // Detect MBZ subtype (Inclusion/Reflection/Standard) based on wick dominance
    [mbz_subtype, has_dominant_wick] = detect_mbz_subtype(formation_open, formation_close, formation_high, formation_low, pool_type)

    base_mbz_record = MBZRecord.new(
         formation_bar_index,
         formation_high,
         formation_low,
         formation_open,
         formation_close,
         is_bullish,
         false,
         0.0,
         false,
         false,
         mbz_subtype,
         "",
         "",
         0.0,
         0.0,
         false,
         label(na),
         liquidity_source_id,
         source_bar_index,
         source_price,
         source_price,
         SOURCE_FAMILY_LIQUIDITY,
         pool_type,
         pool_boundary,
         false,
         false,
         false,
         0.0,
         int(na),
         VARIANT_LIQUIDITY,
         formation_rule,
         source_origin_token
     )

    base_mbz_record.is_exactly_50_percent := is_exact_midpoint

    // Mark the level as used by pattern (for verify mode display)
    if not na(pool)
        session_count = liquidity_pool_session_count(pool)
        for i = 0 to session_count - 1
            if is_high_boundary
                level_price = array.get(pool.highs, i)
                if level_price == source_price
                    array.set(pool.high_used_by_pattern, i, true)
                    break
            else
                level_price = array.get(pool.lows, i)
                if level_price == source_price
                    array.set(pool.low_used_by_pattern, i, true)
                    break

    register_new_mbz_record(base_mbz_record)

// Build source breakdown with counts - USED for candle label logic
build_source_breakdown(mbz_group) =>
    stats = get_source_type_stats(mbz_group)

    parts = array.new<string>()
    // Liquidity placeholders (always display when present)
    if stats.liquidity_daily_count > 0
        array.push(parts, format_source_token(LIQUIDITY_SOURCE_TYPE_DAILY, stats.liquidity_daily_count))
    if stats.liquidity_weekly_count > 0
        array.push(parts, format_source_token(LIQUIDITY_SOURCE_TYPE_WEEKLY, stats.liquidity_weekly_count))
    if stats.liquidity_monthly_count > 0
        array.push(parts, format_source_token(LIQUIDITY_SOURCE_TYPE_MONTHLY, stats.liquidity_monthly_count))

    result = ""
    for i = 0 to array.size(parts) - 1
        if i > 0
            result := result + BREAKDOWN_SEPARATOR
        result := result + array.get(parts, i)

    result

// Build source breakdown for extension labels using consolidated stats
build_source_breakdown_extension_from_stats(stats) =>
    if stats.group_size == 0
        ""
    else
        parts = array.new<string>()
        if stats.liquidity_daily_count > 0
            array.push(parts, format_source_token(LIQUIDITY_SOURCE_TYPE_DAILY, stats.liquidity_daily_count))
        if stats.liquidity_weekly_count > 0
            array.push(parts, format_source_token(LIQUIDITY_SOURCE_TYPE_WEEKLY, stats.liquidity_weekly_count))
        if stats.liquidity_monthly_count > 0
            array.push(parts, format_source_token(LIQUIDITY_SOURCE_TYPE_MONTHLY, stats.liquidity_monthly_count))

        breakdown = ""
        for i = 0 to array.size(parts) - 1
            if i > 0
                breakdown := breakdown + BREAKDOWN_SEPARATOR
            breakdown := breakdown + array.get(parts, i)

        if stats.distinct_types == 1 and array.size(parts) > 0
            array.get(parts, 0)
        else
            str.tostring(stats.group_size) + COUNT_SEPARATOR + breakdown

// Build source breakdown with new Option 1 logic for extension labels
build_source_breakdown_extension(mbz_group) =>
    build_source_breakdown_extension_from_stats(get_source_type_stats(mbz_group))

// Mirror stacked label content for bearish ordering (parity with SIF)
mirror_label_stack_for_bearish(label_parts) =>
    mirrored = array.new<string>()
    for i = array.size(label_parts) - 1 to 0 by 1
        array.push(mirrored, array.get(label_parts, i))
    mirrored

// Get unified subtype for entire group - ONLY USED WHEN show_enhanced_label_details = true
get_unified_subtype(mbz_group) =>
    if array.size(mbz_group) == 0
        ["", false]
    else
        first_mbz = array.get(mbz_group, 0)
        subtype_display = get_subtype_display(first_mbz.mbz_subtype, first_mbz.is_bullish)

        // Get wick tier for risk indicator
        body_top = math.max(first_mbz.mbz_open, first_mbz.mbz_close)
        body_bottom = math.min(first_mbz.mbz_open, first_mbz.mbz_close)
        body_size = body_top - body_bottom
        upper_wick = first_mbz.high_price - body_top
        lower_wick = body_bottom - first_mbz.low_price
        [wick_tier, has_wick_dominance] = classify_wick_dominance(body_size, upper_wick, lower_wick)

        risky_prefix = wick_tier == WICK_TIER_RISKY ? "*" : ""
        is_risky = risky_prefix != ""

        final_subtype = ""
        if subtype_display != ""
            final_subtype := get_risky_subtype_display(first_mbz.mbz_subtype, first_mbz.is_bullish, is_risky)

        [final_subtype, is_risky]

// Get priority formation rule for consolidated group (liquidity takes priority over imbalance)
get_consolidated_formation_rule(mbz_group) =>
    // Priority order: Liquidity Immediate > Liquidity Standard > Liquidity Delayed > Imbalance Standard
    has_liq_immediate = false
    has_liq_standard = false
    has_liq_delayed = false

    for i = 0 to array.size(mbz_group) - 1
        mbz = array.get(mbz_group, i)
        if mbz.formation_rule == FORMATION_RULE_LIQUIDITY_IMMEDIATE
            has_liq_immediate := true
            break  // Highest priority found
        else if mbz.formation_rule == FORMATION_RULE_LIQUIDITY_STANDARD
            has_liq_standard := true
        else if mbz.formation_rule == FORMATION_RULE_LIQUIDITY_DELAYED
            has_liq_delayed := true

    // Return highest priority rule found
    if has_liq_immediate
        FORMATION_RULE_LIQUIDITY_IMMEDIATE
    else if has_liq_standard
        FORMATION_RULE_LIQUIDITY_STANDARD
    else if has_liq_delayed
        FORMATION_RULE_LIQUIDITY_DELAYED
    else
        FORMATION_RULE_LIQUIDITY_STANDARD  // Default for liquidity-only mode

// Create consolidated candle label with 5-4-3-2-1 reversal - SUPER MBZ support
create_consolidated_candle_label(consolidated_mbz) =>
    mbz_count = array.size(consolidated_mbz.mbz_group)
    source_stats = get_source_type_stats(consolidated_mbz.mbz_group)
    strong_flag_active = is_multi_source_strong(source_stats)
    show_strong_label = strong_flag_active and should_show_strong_on_labels()

    // Get formation rule prefix (liquidity takes priority over imbalance in mixed groups)
    priority_formation_rule = get_consolidated_formation_rule(consolidated_mbz.mbz_group)
    formation_prefix = ""
    if priority_formation_rule == FORMATION_RULE_LIQUIDITY_IMMEDIATE
        formation_prefix := FORMATION_PREFIX_LIQUIDITY_IMMEDIATE
    else if priority_formation_rule == FORMATION_RULE_LIQUIDITY_STANDARD
        formation_prefix := FORMATION_PREFIX_LIQUIDITY_STANDARD
    else if priority_formation_rule == FORMATION_RULE_LIQUIDITY_DELAYED
        formation_prefix := FORMATION_PREFIX_LIQUIDITY_DELAYED
    // Imbalance standard has no prefix (status quo)

    direction = formation_prefix + MBZ_BASE_TEXT + (consolidated_mbz.is_bullish ? MBZ_BULLISH_SUFFIX : MBZ_BEARISH_SUFFIX)
    base_text = direction

    if show_50_percent_tags
        has_50_percent = false
        for i = 0 to mbz_count - 1
            mbz = array.get(consolidated_mbz.mbz_group, i)
            if mbz.is_exactly_50_percent
                has_50_percent := true
                break
        if has_50_percent
            base_text := base_text + FIFTY_PERCENT_TAG

    if mbz_symbol_type == DISPLAY_MODE_ARROW_ONLY
        consolidated_mbz.is_bullish ? ARROW_UP_SYMBOL : ARROW_DOWN_SYMBOL
    else
        label_parts = array.new<string>()

        if mbz_symbol_type == DISPLAY_MODE_ARROW_TEXT
            array.push(label_parts, consolidated_mbz.is_bullish ? ARROW_UP_SYMBOL : ARROW_DOWN_SYMBOL)

        array.push(label_parts, base_text)

        if show_enhanced_label_details
            if mbz_count >= 3
                array.push(label_parts, "(" + str.tostring(mbz_count) + ")")
            else if mbz_count == 2
                // Liquidity-only mode - show source breakdown
                breakdown = build_source_breakdown_extension_from_stats(source_stats)
                if str.length(breakdown) > 0
                    array.push(label_parts, "(" + breakdown + ")")
            else if mbz_count == 1
                single_mbz = array.get(consolidated_mbz.mbz_group, 0)
                source_token = get_mbz_primary_source_token(single_mbz)
                if source_token != ""
                    array.push(label_parts, "(" + source_token + ")")

                subtype_display = get_subtype_display(single_mbz.mbz_subtype, single_mbz.is_bullish)
                if subtype_display != ""
                    body_top = math.max(single_mbz.mbz_open, single_mbz.mbz_close)
                    body_bottom = math.min(single_mbz.mbz_open, single_mbz.mbz_close)
                    body_size = body_top - body_bottom
                    upper_wick = single_mbz.high_price - body_top
                    lower_wick = body_bottom - single_mbz.low_price
                    [wick_tier, has_wick_dominance] = classify_wick_dominance(body_size, upper_wick, lower_wick)
                    single_is_risky = wick_tier == WICK_TIER_RISKY
                    risky_subtype = get_risky_subtype_display(single_mbz.mbz_subtype, single_mbz.is_bullish, single_is_risky)
                    array.push(label_parts, risky_subtype)

            if mbz_count > 1
                [unified_subtype, is_risky] = get_unified_subtype(consolidated_mbz.mbz_group)
                if unified_subtype != ""
                    array.push(label_parts, unified_subtype)

        if show_strong_label
            array.push(label_parts, MULTI_SOURCE_STRENGTH_LABEL)

        status_parts = array.new<string>()
        if consolidated_mbz.is_consolidated_invalidated
            array.push(status_parts, "[X]")
        else if consolidated_mbz.is_consolidated_breached
            array.push(status_parts, BREACH_STATUS_LABEL)

        if array.size(status_parts) > 0
            for i = 0 to array.size(status_parts) - 1
                array.push(label_parts, array.get(status_parts, i))

        if not consolidated_mbz.is_bullish and array.size(label_parts) > 0
            label_parts := mirror_label_stack_for_bearish(label_parts)

        result = ""
        for i = 0 to array.size(label_parts) - 1
            if i > 0
                result := result + "\n"
            result := result + array.get(label_parts, i)

        result

// Create consolidated extension label with SUPER MBZ checkmark support
create_consolidated_extension_label(consolidated_mbz) =>
    mbz_count = array.size(consolidated_mbz.mbz_group)

    // Get formation rule prefix (liquidity takes priority over imbalance in mixed groups)
    priority_formation_rule = get_consolidated_formation_rule(consolidated_mbz.mbz_group)
    formation_prefix = ""
    if priority_formation_rule == FORMATION_RULE_LIQUIDITY_IMMEDIATE
        formation_prefix := FORMATION_PREFIX_LIQUIDITY_IMMEDIATE
    else if priority_formation_rule == FORMATION_RULE_LIQUIDITY_STANDARD
        formation_prefix := FORMATION_PREFIX_LIQUIDITY_STANDARD
    else if priority_formation_rule == FORMATION_RULE_LIQUIDITY_DELAYED
        formation_prefix := FORMATION_PREFIX_LIQUIDITY_DELAYED
    // Imbalance standard has no prefix (status quo)

    direction = formation_prefix + MBZ_BASE_TEXT + (consolidated_mbz.is_bullish ? MBZ_BULLISH_SUFFIX : MBZ_BEARISH_SUFFIX)
    extension_result = ""
    source_stats = get_source_type_stats(consolidated_mbz.mbz_group)
    strong_flag_active = is_multi_source_strong(source_stats)
    show_strong_extension = strong_flag_active and should_show_strong_on_extensions()

    // Add 50% tags if applicable
    mbz_text = direction
    if show_50_percent_tags
        // Check if any MBZ in group formed exactly at 50%
        has_50_percent = false
        for i = 0 to array.size(consolidated_mbz.mbz_group) - 1
            mbz = array.get(consolidated_mbz.mbz_group, i)
            if mbz.is_exactly_50_percent
                has_50_percent := true
                break
        if has_50_percent
            mbz_text := mbz_text + " [½]"

    // Check for SUPER MBZs in group
    has_super = has_super_mbzs(consolidated_mbz.mbz_group)
    base_label = has_super ? CHECKMARK_SYMBOL + mbz_text : mbz_text

    // Only show advanced info when show_enhanced_label_details = true
    if show_enhanced_label_details
        if mbz_count == 1
            // Single MBZ - derive display token from source metadata
            single_mbz = array.get(consolidated_mbz.mbz_group, 0)
            source_token = get_mbz_primary_source_token(single_mbz)
            origin_suffix = source_token != "" ? " (" + source_token + ")" : ""

            // Get subtype
            subtype_display = get_subtype_display(single_mbz.mbz_subtype, single_mbz.is_bullish)

            // Get risk indicator
            body_top = math.max(single_mbz.mbz_open, single_mbz.mbz_close)
            body_bottom = math.min(single_mbz.mbz_open, single_mbz.mbz_close)
            body_size = body_top - body_bottom
            upper_wick = single_mbz.high_price - body_top
            lower_wick = body_bottom - single_mbz.low_price
            [wick_tier, has_wick_dominance] = classify_wick_dominance(body_size, upper_wick, lower_wick)
            risky_prefix = wick_tier == WICK_TIER_RISKY ? "*" : ""

            // Apply checkmark for SUPER MBZs in extensions
            extension_result := base_label + origin_suffix

            if subtype_display != ""
                single_is_risky = risky_prefix != ""
                risky_subtype = get_risky_subtype_display(single_mbz.mbz_subtype, single_mbz.is_bullish, single_is_risky)
                extension_result := extension_result + " " + risky_subtype
        else
            // Multiple MBZs - use extension breakdown logic
            source_breakdown = build_source_breakdown_extension_from_stats(source_stats)

            extension_result := base_label + " (" + source_breakdown + ")"

            // Add unified subtype inline (not on new line)
            [unified_subtype, unified_is_risky] = get_unified_subtype(consolidated_mbz.mbz_group)
            if unified_subtype != ""
                extension_result := extension_result + " " + unified_subtype
    else
        // When advanced labels are OFF, show clean MBZ⁺/MBZ⁻ with checkmark for SUPER
        extension_result := base_label

    // Add status indicators AFTER special markers - invalidation takes precedence
    if consolidated_mbz.is_consolidated_invalidated
        extension_result := extension_result + " [X]"
    else if consolidated_mbz.is_consolidated_breached
        extension_result := extension_result + " " + BREACH_STATUS_LABEL

    if show_strong_extension
        extension_result := str.length(extension_result) == 0 ? MULTI_SOURCE_STRENGTH_LABEL : MULTI_SOURCE_STRENGTH_LABEL + "\n" + extension_result

    extension_result

// Build consolidated tooltip with SUPER MBZ info
build_consolidated_tooltip(consolidated_mbz) =>
    mbz_count = array.size(consolidated_mbz.mbz_group)
    source_stats = get_source_type_stats(consolidated_mbz.mbz_group)
    strong_flag_active = is_multi_source_strong(source_stats)

    // Get formation rule prefix (liquidity takes priority over imbalance in mixed groups)
    priority_formation_rule = get_consolidated_formation_rule(consolidated_mbz.mbz_group)
    formation_prefix = ""
    if priority_formation_rule == FORMATION_RULE_LIQUIDITY_IMMEDIATE
        formation_prefix := FORMATION_PREFIX_LIQUIDITY_IMMEDIATE
    else if priority_formation_rule == FORMATION_RULE_LIQUIDITY_STANDARD
        formation_prefix := FORMATION_PREFIX_LIQUIDITY_STANDARD
    else if priority_formation_rule == FORMATION_RULE_LIQUIDITY_DELAYED
        formation_prefix := FORMATION_PREFIX_LIQUIDITY_DELAYED
    // Imbalance standard has no prefix (status quo)

    direction = formation_prefix + (consolidated_mbz.is_bullish ? MBZ_PLUS : MBZ_MINUS)
    base_text = direction

    if mbz_count > 1
        // Show detailed breakdown using new extension logic
        source_breakdown = build_source_breakdown_extension_from_stats(source_stats)
        if str.length(source_breakdown) > 0
            base_text := base_text + " (" + source_breakdown + ")"
    else if mbz_count == 1
        // Show source type for single MBZ using variant-aware token
        single_mbz = array.get(consolidated_mbz.mbz_group, 0)
        source_token = get_mbz_primary_source_token(single_mbz)
        if source_token != ""
            base_text := base_text + " (" + source_token + ")"

    if strong_flag_active
        base_text := base_text + " " + MULTI_SOURCE_STRENGTH_LABEL

    // Restructure: Behavior comes FIRST - "Inclusion MBZ⁺ (imp)"
    if mbz_count > 0
        first_mbz = array.get(consolidated_mbz.mbz_group, 0)
        if str.contains(first_mbz.mbz_subtype, SUBTYPE_INCLUSION)
            base_text := SUBTYPE_INCLUSION_FULL + " " + base_text
        else if str.contains(first_mbz.mbz_subtype, SUBTYPE_REFLECTION)
            base_text := SUBTYPE_REFLECTION_FULL + " " + base_text

    // Add SUPER MBZ information
    has_super = has_super_mbzs(consolidated_mbz.mbz_group)
    strength_info = ""
    if has_super
        // Find the first SUPER MBZ for details
        for i = 0 to array.size(consolidated_mbz.mbz_group) - 1
            mbz_record = array.get(consolidated_mbz.mbz_group, i)
            if mbz_record.is_super_mbz
                bars_ago = bar_index - mbz_record.overlapping_mbz_bar_index
                direction_text = mbz_record.is_bullish ? MBZ_PLUS : MBZ_MINUS
                strength_info := "\n" + str.tostring(mbz_record.overlap_percentage, "#.1") + "% overlap with " + direction_text + " from " + str.tostring(bars_ago) + " bars ago"
                break

    // Only show breach status if NOT invalidated (mutually exclusive)
    status_text = ""
    if consolidated_mbz.is_consolidated_invalidated
        status_text := status_text + " - INVALIDATED"
    else if consolidated_mbz.is_consolidated_breached
        current_breach_pct = get_consolidated_breach_percentage(consolidated_mbz)
        status_text := status_text + BREACH_STATUS_TEXT + str.tostring(current_breach_pct, "#.1") + BREACH_STATUS_SUFFIX
    else if not barstate.isconfirmed
        // Show re-entry percentage when price is back inside zone
        current_breach_pct = get_consolidated_breach_percentage(consolidated_mbz)
        if current_breach_pct > 0
            status_text := status_text + " - " + str.tostring(current_breach_pct, "#.1") + "% filled"

    base_text + strength_info + status_text

// ═══════════════════════════════════════════════════════════════════════════════
// DISPLAY HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

get_mbz_colors(mbz_record) =>
    // Get original color
    original_color = mbz_record.is_bullish ? extended_box_bullish_color : extended_box_bearish_color

    // Check if MBZ is currently breached (but not invalidated)
    is_breached = is_mbz_currently_breached(mbz_record)
    should_fade = enable_breach_detection and enable_zone_fade and is_breached and not mbz_record.is_invalidated
    if should_fade
        // Fade the original color
        original_transparency = color.t(original_color)
        fade_amount = breach_transparency_percent / 100.0
        new_transparency = math.min(MAX_FADE_TRANSPARENCY, original_transparency + (fade_amount * (100 - original_transparency)))
        faded_color = color.new(color.rgb(color.r(original_color), color.g(original_color), color.b(original_color)), new_transparency)
        // Apply same faded color to both candle highlight AND extension
        [faded_color, faded_color]
    else
        // Use original color for both
        [original_color, original_color]

// Get appropriate text color for MBZ labels (use breach color when breached)
get_mbz_extension_text_color(mbz_record, default_text_color) =>
    // Check if MBZ is currently breached and should use breach color
    is_breached = is_mbz_currently_breached(mbz_record)
    should_use_breach_color = enable_breach_detection and enable_text_color_change and is_breached and not mbz_record.is_invalidated
    if should_use_breach_color
        breach_label_color
    else
        default_text_color

// Get appropriate text color for consolidated MBZ labels
get_consolidated_extension_text_color(consolidated_mbz, default_text_color) =>
    // Check if consolidated MBZ is currently breached and should use breach color
    is_breached = consolidated_mbz.is_consolidated_breached
    should_use_breach_color = enable_breach_detection and enable_text_color_change and is_breached and not consolidated_mbz.is_consolidated_invalidated
    if should_use_breach_color
        breach_label_color
    else
        default_text_color

get_consolidated_mbz_colors(consolidated_mbz) =>
    // Get original color
    original_color = consolidated_mbz.is_bullish ? extended_box_bullish_color : extended_box_bearish_color

    // Check if consolidated MBZ is currently breached (but not invalidated)
    is_breached = consolidated_mbz.is_consolidated_breached
    should_fade = enable_breach_detection and enable_zone_fade and is_breached and not consolidated_mbz.is_consolidated_invalidated
    if should_fade
        // Fade the original color
        original_transparency = color.t(original_color)
        fade_amount = breach_transparency_percent / 100.0
        new_transparency = math.min(MAX_FADE_TRANSPARENCY, original_transparency + (fade_amount * (100 - original_transparency)))
        faded_color = color.new(color.rgb(color.r(original_color), color.g(original_color), color.b(original_color)), new_transparency)
        // Apply same faded color to both candle highlight AND extension
        [faded_color, faded_color]
    else
        // Use original color for both
        [original_color, original_color]

should_display_mbz(mbz_record) =>
    if mbz_record.is_invalidated and not show_invalidated_mbzs
        false
    else
        true

// Check if MBZ should be displayed based on directional filter
should_display_mbz_direction(mbz_record) =>
    mbz_record.is_bullish ? show_bullish_mbzs : show_bearish_mbzs

// @function get_border_properties_for_mbz
// @description Returns border width and color based on MBZ properties (deeper wick > multi-source > single)
// @param consolidated_mbz ConsolidatedMBZ - the consolidated MBZ to analyze
// @param mbz_source_count int - cached source count for performance
// @returns [int, color] - [border_width, border_color]
get_border_properties_for_mbz(consolidated_mbz, mbz_source_count) =>
    is_multi_source = enable_multi_source_highlighting and mbz_source_count > 1

    // Get default border color (same as extension background color)
    default_border_color = consolidated_mbz.is_bullish ? extended_box_bullish_color : extended_box_bearish_color

    // Determine final border properties (multi-source > default)
    border_width_final = is_multi_source ? multi_source_border_width : 1
    border_color_final = is_multi_source ? multi_source_border_color : default_border_color

    [border_width_final, border_color_final]

should_display_consolidated_mbz(consolidated_mbz) =>
    // Liquidity-only mode - show all consolidated MBZs, check individual display rules
    should_display = false
    for i = 0 to array.size(consolidated_mbz.mbz_group) - 1
        mbz_record = array.get(consolidated_mbz.mbz_group, i)
        if should_display_mbz(mbz_record)
            should_display := true
            break
    should_display

should_highlight_mbz(mbz_record) =>
    // Show extensions for valid MBZs OR invalidated based on display mode
    if mbz_record.is_invalidated
        show_invalidated_mbzs
    else
        true

should_highlight_consolidated_mbz(consolidated_mbz) =>
    if consolidated_mbz.is_consolidated_invalidated
        show_invalidated_mbzs
    else
        true

should_project_mbz(mbz_record) =>
    not mbz_record.is_invalidated

should_project_consolidated_mbz(consolidated_mbz) =>
    not consolidated_mbz.is_consolidated_invalidated

// ═══════════════════════════════════════════════════════════════════════════════
// PROJECTION SYSTEM FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// Get color and size for specific level type
get_level_style(level) =>
    level_color = color.gray
    level_size = size.small

    if level == 0.0 or level == 1.0
        // Boundaries
        level_color := boundary_color
        level_size := get_text_size(boundary_text_size)
    else if level == FIBONACCI_CENTER
        // CE (50%)
        level_color := ce_color
        level_size := get_text_size(ce_text_size)
    else if level > 0.0 and level < 1.0
        // Quadrants
        level_color := quadrant_color
        level_size := get_text_size(quadrant_text_size)
    else if level > 1.0
        // Stops
        level_color := stop_color
        level_size := get_text_size(stop_text_size)
    else if level < 0.0
        // Targets
        level_color := target_color
        level_size := get_text_size(target_text_size)
    else
        // Fallback
        level_color := color.gray
        level_size := size.small

    [level_color, level_size]

// PROJECTION LEVELS FUNCTION
get_projection_levels() =>
    levels = array.new<float>()

    // BOUNDARIES: Core levels (0=close, 1=open)
    if show_boundaries
        array.push(levels, 0.0)   // Close
        array.push(levels, 1.0)   // Open

    // CE: 50% center level
    if show_ce
        array.push(levels, FIBONACCI_CENTER)   // 50% center

    // QUADRANTS: Only 0.25 and 0.75 (removed 0.5)
    if show_quadrants
        array.push(levels, FIBONACCI_QUARTER_LOW)  // Between 0 and 1
        array.push(levels, FIBONACCI_QUARTER_HIGH)  // Between 0 and 1

    // STOPS: Beyond open (1.25, 1.5, 2.0)
    if show_stops
        array.push(levels, FIBONACCI_STOP_125)
        array.push(levels, FIBONACCI_STOP_150)
        array.push(levels, FIBONACCI_STOP_200)

    // TARGETS: Beyond close (-2.0, -2.5, -4, -4.5)
    if show_targets
        array.push(levels, FIBONACCI_TARGET_200)
        array.push(levels, FIBONACCI_TARGET_250)
        array.push(levels, FIBONACCI_TARGET_400)
        array.push(levels, FIBONACCI_TARGET_450)

    // CUSTOM: Proper comma-separated parsing
    if show_custom
        input_str = custom_levels_input
        if str.length(input_str) > 0
            // Split by comma and parse each value
            split_values = str.split(input_str, ",")
            for i = 0 to array.size(split_values) - 1
                value_str = str.replace_all(array.get(split_values, i), " ", "")  // Remove spaces
                if str.length(value_str) > 0
                    parsed_value = str.tonumber(value_str)
                    if not na(parsed_value)
                        array.push(levels, parsed_value)

    // Default fallback if nothing selected
    if array.size(levels) == 0
        array.push(levels, 0.0)
        array.push(levels, 1.0)

    levels

// Format projection level labels
format_level_label(level) =>
    base_str = str.tostring(level, '#.##')
    str_len = str.length(base_str)
    padding_needed = 5 - str_len
    padded_str = base_str

    if padding_needed > 0
        for i = 1 to padding_needed
            padded_str := padded_str + " "

    padded_str

// Box creation
// ═══════════════════════════════════════════════════════════════════════════════
// CONSOLIDATED VISUAL MANAGEMENT SYSTEM // ═══════════════════════════════════════════════════════════════════════════════

manage_consolidated_mbz_display() =>
    // Clear all visual elements efficiently
    for elem in mbz_labels
        label.delete(elem)
    array.clear(mbz_labels)

    // Always clear source boxes for dynamic toggle behavior
    for elem in mbz_body_highlights
        box.delete(elem)
    array.clear(mbz_body_highlights)

    for elem in mbz_extended_boxes
        box.delete(elem)
    array.clear(mbz_extended_boxes)

    for elem in mbz_projection_lines
        line.delete(elem)
    array.clear(mbz_projection_lines)

    for elem in mbz_lines
        line.delete(elem)
    array.clear(mbz_lines)

    for elem in mbz_projection_labels
        label.delete(elem)
    array.clear(mbz_projection_labels)

    array.clear(displayed_mbz_indices)

    for liq_line in daily_liquidity_lines
        line.delete(liq_line)
    array.clear(daily_liquidity_lines)

    for liq_label in daily_liquidity_labels
        label.delete(liq_label)
    array.clear(daily_liquidity_labels)

    for liq_line in weekly_liquidity_lines
        line.delete(liq_line)
    array.clear(weekly_liquidity_lines)

    for liq_label in weekly_liquidity_labels
        label.delete(liq_label)
    array.clear(weekly_liquidity_labels)

    for liq_line in monthly_liquidity_lines
        line.delete(liq_line)
    array.clear(monthly_liquidity_lines)

    for liq_label in monthly_liquidity_labels
        label.delete(liq_label)
    array.clear(monthly_liquidity_labels)

    for liq_line in asia_liquidity_lines
        line.delete(liq_line)
    array.clear(asia_liquidity_lines)

    for liq_label in asia_liquidity_labels
        label.delete(liq_label)
    array.clear(asia_liquidity_labels)

    // Group MBZs by candle for consolidation
    displayable_mbzs = array.new<MBZRecord>()

    // PROFILING: Local debug counters (liquidity-only mode)
    debug_total_examined = 0
    debug_liquidity_added = 0
    debug_daily_liq_added = 0
    debug_weekly_liq_added = 0
    debug_monthly_liq_added = 0
    debug_asia_liq_added = 0
    debug_rejected_by_should_display = 0

    // Early filtering counters (liquidity-only mode)
    liquidity_record_count = 0
    invalidated_record_count = 0

    // Add bounds checking to prevent array out of bounds error
    total_mbz_records = array.size(all_mbz_records)
    if total_mbz_records > 0  // Only proceed if we have records
        // EARLY FILTERING (like v9.23): Filter records BEFORE consolidation
        for record_index = total_mbz_records - 1 to 0
            current_mbz_record = array.get(all_mbz_records, record_index)

            // Skip MBZs too old to render (prevents buffer errors and makes "visible" count accurate)
            mbz_bars_ago = bar_index - current_mbz_record.bar_index
            if mbz_bars_ago >= MAX_RENDERABLE_BAR_AGE
                continue

            // Apply direction filter (liquidity-only mode: no variant filter needed)
            if should_display_mbz_direction(current_mbz_record)
                if not current_mbz_record.is_invalidated
                    // PROFILING: Count examined records (only if profiling enabled)
                    if show_profiling
                        debug_total_examined += 1

                    // Apply quota limits (liquidity-only mode: all sources are liquidity)
                    can_add = false
                    passes_display_check = should_display_mbz(current_mbz_record)

                    if liquidity_record_count < max_liquidity_mbzs_effective
                        // Check if this liquidity source type is enabled
                        liquidity_source_enabled = true
                        if current_mbz_record.source_origin_token == LIQUIDITY_SOURCE_TYPE_DAILY
                            liquidity_source_enabled := enable_daily_liquidity
                        else if current_mbz_record.source_origin_token == LIQUIDITY_SOURCE_TYPE_WEEKLY
                            liquidity_source_enabled := enable_weekly_liquidity
                        else if current_mbz_record.source_origin_token == LIQUIDITY_SOURCE_TYPE_MONTHLY
                            liquidity_source_enabled := enable_monthly_liquidity
                        else if current_mbz_record.source_origin_token == LIQUIDITY_SOURCE_TYPE_ASIA
                            liquidity_source_enabled := enable_asia_liquidity

                        if passes_display_check and liquidity_source_enabled
                            can_add := true
                            liquidity_record_count += 1
                            if show_profiling
                                debug_liquidity_added += 1
                                if current_mbz_record.source_origin_token == LIQUIDITY_SOURCE_TYPE_DAILY
                                    debug_daily_liq_added += 1
                                else if current_mbz_record.source_origin_token == LIQUIDITY_SOURCE_TYPE_WEEKLY
                                    debug_weekly_liq_added += 1
                                else if current_mbz_record.source_origin_token == LIQUIDITY_SOURCE_TYPE_MONTHLY
                                    debug_monthly_liq_added += 1
                                else if current_mbz_record.source_origin_token == LIQUIDITY_SOURCE_TYPE_ASIA
                                    debug_asia_liq_added += 1
                        else if show_profiling
                            debug_rejected_by_should_display += 1

                    if can_add
                        array.push(displayable_mbzs, current_mbz_record)

                    // Early exit when quotas full (liquidity-only mode)
                    liquidity_quota_full = liquidity_record_count >= max_liquidity_mbzs_effective
                    invalidated_quota_full = invalidated_record_count >= max_invalidated_mbzs_effective or not show_invalidated_mbzs
                    if liquidity_quota_full and invalidated_quota_full
                        break
                else if current_mbz_record.is_invalidated and show_invalidated_mbzs
                    if invalidated_record_count < max_invalidated_mbzs_effective
                        if should_display_mbz(current_mbz_record)
                            array.push(displayable_mbzs, current_mbz_record)
                            invalidated_record_count += 1

    // Group displayable MBZs by candle (will return empty array if no displayable MBZs)
    consolidated_mbzs = group_mbzs_by_candle(displayable_mbzs)

    // Only process if we have consolidated MBZs
    if array.size(consolidated_mbzs) > 0
        // Process each consolidated group
        // Deduplicate liquidity level lines (by price AND source type) to prevent duplicate lines
        displayed_daily_levels = array.new_float()
        displayed_weekly_levels = array.new_float()
        displayed_monthly_levels = array.new_float()
        displayed_asia_levels = array.new_float()

        for consolidated_group_index = 0 to array.size(consolidated_mbzs) - 1
            current_consolidated_mbz = array.get(consolidated_mbzs, consolidated_group_index)

            if not should_display_consolidated_mbz(current_consolidated_mbz)
                continue

            // Calculate consolidated zone boundaries
            [consolidated_zone_top_boundary, consolidated_zone_bottom_boundary] = calculate_consolidated_zone_boundaries(current_consolidated_mbz.mbz_group)
            current_consolidated_mbz.consolidated_zone_top := consolidated_zone_top_boundary
            current_consolidated_mbz.consolidated_zone_bottom := consolidated_zone_bottom_boundary

            // Determine consolidated status
            [is_currently_breached, is_currently_invalidated] = determine_consolidated_status(current_consolidated_mbz)
            current_consolidated_mbz.is_consolidated_breached := is_currently_breached
            current_consolidated_mbz.is_consolidated_invalidated := is_currently_invalidated

            // Build labels
            current_consolidated_mbz.consolidated_candle_label := create_consolidated_candle_label(current_consolidated_mbz)
            current_consolidated_mbz.consolidated_extension_label := create_consolidated_extension_label(current_consolidated_mbz)

            // Update the consolidated_mbzs array
            array.set(consolidated_mbzs, consolidated_group_index, current_consolidated_mbz)

            // Create candle label with proper positioning
            if show_mbz_labels
                consolidated_label_color = current_consolidated_mbz.is_consolidated_invalidated ? mbz_invalidated_color : (current_consolidated_mbz.is_bullish ? mbz_bullish_color : mbz_bearish_color)
                consolidated_label_size = current_consolidated_mbz.is_consolidated_invalidated ? get_invalidated_mbz_size() : get_mbz_label_size()

                // Smart label positioning for reflection MBZs to avoid extension box overlap
                first_mbz_in_group = array.get(current_consolidated_mbz.mbz_group, 0)

                // Check if any MBZ in group is reflection type with extensions enabled
                has_reflection_mbz = false
                for mbz_check_index = 0 to array.size(current_consolidated_mbz.mbz_group) - 1
                    check_mbz = array.get(current_consolidated_mbz.mbz_group, mbz_check_index)
                    if str.contains(check_mbz.mbz_subtype, SUBTYPE_REFLECTION)
                        has_reflection_mbz := true
                        break

                // Declare variables for positioning
                candle_label_y_position = float(na)
                candle_label_yloc = yloc.price

                // Calculate proper positioning
                if show_extended_boxes and has_reflection_mbz
                    // For reflection MBZs with extensions, use 0.8 spacing multiplier (tested - prevents collision)
                    zone_height = current_consolidated_mbz.consolidated_zone_top - current_consolidated_mbz.consolidated_zone_bottom
                    spacing_offset = zone_height * REFLECTION_LABEL_SPACING_MULTIPLIER

                    if current_consolidated_mbz.is_bullish
                        // Bullish reflection: extension goes down, push label further down
                        candle_label_y_position := current_consolidated_mbz.consolidated_zone_bottom - spacing_offset
                    else
                        // Bearish reflection: extension goes up, push label further up
                        candle_label_y_position := current_consolidated_mbz.consolidated_zone_top + spacing_offset

                    candle_label_yloc := yloc.price
                else
                    // Standard positioning using yloc.belowbar/abovebar
                    candle_label_y_position := current_consolidated_mbz.is_bullish ? first_mbz_in_group.low_price : first_mbz_in_group.high_price
                    candle_label_yloc := current_consolidated_mbz.is_bullish ? yloc.belowbar : yloc.abovebar

                consolidated_tooltip_text = build_consolidated_tooltip(current_consolidated_mbz)

                new_consolidated_label = label.new(
                     x=current_consolidated_mbz.bar_index,
                     y=candle_label_y_position,
                     text=current_consolidated_mbz.consolidated_candle_label,
                     style=label.style_none,
                     textcolor=consolidated_label_color,
                     size=consolidated_label_size,
                     yloc=candle_label_yloc,
                     tooltip=consolidated_tooltip_text
                 )

                array.push(mbz_labels, new_consolidated_label)

            // Create consolidated extension box
            should_highlight_consolidated_zone = show_extended_boxes and should_highlight_consolidated_mbz(current_consolidated_mbz)
            if should_highlight_consolidated_zone
                [consolidated_highlight_color, consolidated_extension_color] = get_consolidated_mbz_colors(current_consolidated_mbz)

                // Highlight box (consolidated zone)
                consolidated_highlight_box = box.new(
                     left=current_consolidated_mbz.bar_index,
                     right=current_consolidated_mbz.bar_index + 1,
                     top=current_consolidated_mbz.consolidated_zone_top,
                     bottom=current_consolidated_mbz.consolidated_zone_bottom,
                     xloc=xloc.bar_index,
                     bgcolor=consolidated_highlight_color,
                     border_color=na
                 )
                array.push(mbz_body_highlights, consolidated_highlight_box)

                // Extension box with consolidated label - Dropdown Extension System
                extension_right = switch extension_mode
                    EXTENSION_FIXED => current_consolidated_mbz.bar_index + extended_box_length
                    EXTENSION_TO_CURRENT => math.max(bar_index, current_consolidated_mbz.bar_index + extended_box_length)
                    EXTENSION_BEYOND_CURRENT => bar_index + extended_box_length
                    => current_consolidated_mbz.bar_index + extended_box_length

                // Get cached source count for performance
                mbz_source_count = array.size(current_consolidated_mbz.mbz_group)

                // Get border properties for multi-source highlighting
                [border_width_to_use, border_color_to_use] = get_border_properties_for_mbz(current_consolidated_mbz, mbz_source_count)

                consolidated_extension_box = box.new(
                     left=current_consolidated_mbz.bar_index,
                     right=extension_right,
                     top=current_consolidated_mbz.consolidated_zone_top,
                     bottom=current_consolidated_mbz.consolidated_zone_bottom,
                     xloc=xloc.bar_index,
                     bgcolor=consolidated_extension_color,
                     border_color=border_color_to_use,
                     border_width=border_width_to_use,
                     text=current_consolidated_mbz.consolidated_extension_label,
                     text_halign=get_extension_label_halign(),
                     text_valign=get_extension_label_valign(),
                     text_color=get_consolidated_extension_text_color(current_consolidated_mbz, extended_box_text_color),
                     text_size=get_extended_box_text_size()
                 )
                array.push(mbz_extended_boxes, consolidated_extension_box)

                // Add breach level line within extension box
                if enable_breached_lines and enable_breach_detection
                    breached_level_price = get_breached_level_price(
                         current_consolidated_mbz.consolidated_zone_top,
                         current_consolidated_mbz.consolidated_zone_bottom,
                         current_consolidated_mbz.is_bullish
                     )
                    if not na(breached_level_price)
                        breached_line_color_final = get_breached_line_color()
                        breached_line = line.new(
                             x1=current_consolidated_mbz.bar_index,
                             y1=breached_level_price,
                             x2=extension_right,
                             y2=breached_level_price,
                             xloc=xloc.bar_index,
                             color=breached_line_color_final,
                             style=get_breached_line_style(),
                             width=breached_line_width
                         )
                        array.push(mbz_lines, breached_line)

                // Add invalidation level line within extension box
                if enable_invalidation_lines
                    invalidation_level_price = get_invalidation_level_price(
                         current_consolidated_mbz.consolidated_zone_top,
                         current_consolidated_mbz.consolidated_zone_bottom,
                         current_consolidated_mbz.is_bullish
                     )
                    if not na(invalidation_level_price)
                        invalidation_line_color_final = get_invalidation_line_color()
                        invalidation_line = line.new(
                             x1=current_consolidated_mbz.bar_index,
                             y1=invalidation_level_price,
                             x2=extension_right,
                             y2=invalidation_level_price,
                             xloc=xloc.bar_index,
                             color=invalidation_line_color_final,
                             style=get_invalidation_line_style(),
                             width=invalidation_line_width
                         )
                        array.push(mbz_lines, invalidation_line)

            // Liquidity source line creation - only for visible MBZs
            if show_source_origins and show_daily_liquidity_lines
                // Create liquidity level line for EACH MBZ in the group
                for current_mbz_index = 0 to array.size(current_consolidated_mbz.mbz_group) - 1
                    // Check capacity before processing each MBZ
                    if array.size(daily_liquidity_lines) >= max_source_displays_effective
                        break

                    current_mbz_in_group = array.get(current_consolidated_mbz.mbz_group, current_mbz_index)

                    if current_mbz_in_group.source_family != SOURCE_FAMILY_LIQUIDITY
                        continue

                    if current_mbz_in_group.source_origin_token != LIQUIDITY_SOURCE_TYPE_DAILY
                        continue

                    // Deduplicate by source price (daily-specific)
                    source_price_key = current_mbz_in_group.source_high  // Use source_high as the level price
                    if na(source_price_key)
                        continue
                    if not array.includes(displayed_daily_levels, source_price_key)
                        // Find this level in the pool to get timing info
                        session_count = liquidity_pool_session_count(daily_liquidity_pool)
                        for session_idx = 0 to session_count - 1
                            session_high = array.get(daily_liquidity_pool.highs, session_idx)
                            session_low = array.get(daily_liquidity_pool.lows, session_idx)

                            level_matched = false
                            level_price = 0.0
                            level_time = 0
                            level_end_time = 0
                            level_label_time = 0
                            is_high_level = false

                            if session_high == source_price_key
                                level_matched := true
                                level_price := session_high
                                level_time := array.get(daily_liquidity_pool.high_times, session_idx)
                                level_end_time := liquidity_pool_get_high_line_end_time(daily_liquidity_pool, session_idx, time)
                                level_label_time := array.get(daily_liquidity_pool.session_close_times, session_idx)
                                is_high_level := true
                            else if session_low == source_price_key
                                level_matched := true
                                level_price := session_low
                                level_time := array.get(daily_liquidity_pool.low_times, session_idx)
                                level_end_time := liquidity_pool_get_low_line_end_time(daily_liquidity_pool, session_idx, time)
                                level_label_time := array.get(daily_liquidity_pool.session_close_times, session_idx)
                                is_high_level := false

                            if level_matched
                                // Create line
                                liquidity_line = line.new(level_time, level_price, level_end_time, level_price, xloc=xloc.bar_time, color=daily_liquidity_color, width=daily_liquidity_line_width, style=line.style_solid)
                                array.push(daily_liquidity_lines, liquidity_line)

                                // Create label if enabled
                                if show_daily_liquidity_labels
                                    label_text = build_liquidity_pool_label(LIQUIDITY_SOURCE_TYPE_DAILY, level_label_time)
                                    final_label_time = level_end_time != level_time ? int((level_time + level_end_time) / 2) : level_time
                                    label_style = is_high_level ? label.style_label_down : label.style_label_up
                                    liquidity_label = label.new(final_label_time, level_price, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label_style, textcolor=color.black, size=get_source_label_size(), color=color.new(color.white, 100))
                                    array.push(daily_liquidity_labels, liquidity_label)

                                // Mark as displayed (daily-specific)
                                array.push(displayed_daily_levels, source_price_key)
                                break

            // Weekly liquidity source line creation
            if show_source_origins and show_weekly_liquidity_lines
                for current_mbz_index = 0 to array.size(current_consolidated_mbz.mbz_group) - 1
                    // Check capacity before processing each MBZ
                    if array.size(weekly_liquidity_lines) >= max_source_displays_effective
                        break

                    current_mbz_in_group = array.get(current_consolidated_mbz.mbz_group, current_mbz_index)

                    if current_mbz_in_group.source_family != SOURCE_FAMILY_LIQUIDITY
                        continue

                    if current_mbz_in_group.source_origin_token != LIQUIDITY_SOURCE_TYPE_WEEKLY
                        continue

                    source_price_key = current_mbz_in_group.source_high
                    if na(source_price_key)
                        continue
                    if not array.includes(displayed_weekly_levels, source_price_key)
                        session_count = liquidity_pool_session_count(weekly_liquidity_pool)
                        for session_idx = 0 to session_count - 1
                            session_high = array.get(weekly_liquidity_pool.highs, session_idx)
                            session_low = array.get(weekly_liquidity_pool.lows, session_idx)

                            level_matched = false
                            level_price = 0.0
                            level_time = 0
                            level_end_time = 0
                            level_label_time = 0
                            is_high_level = false

                            if session_high == source_price_key
                                level_matched := true
                                level_price := session_high
                                level_time := array.get(weekly_liquidity_pool.high_times, session_idx)
                                level_end_time := liquidity_pool_get_high_line_end_time(weekly_liquidity_pool, session_idx, time)
                                level_label_time := array.get(weekly_liquidity_pool.session_close_times, session_idx)
                                is_high_level := true
                            else if session_low == source_price_key
                                level_matched := true
                                level_price := session_low
                                level_time := array.get(weekly_liquidity_pool.low_times, session_idx)
                                level_end_time := liquidity_pool_get_low_line_end_time(weekly_liquidity_pool, session_idx, time)
                                level_label_time := array.get(weekly_liquidity_pool.session_close_times, session_idx)
                                is_high_level := false

                            if level_matched
                                liquidity_line = line.new(level_time, level_price, level_end_time, level_price, xloc=xloc.bar_time, color=weekly_liquidity_color, width=weekly_liquidity_line_width, style=line.style_solid)
                                array.push(weekly_liquidity_lines, liquidity_line)

                                if show_weekly_liquidity_labels
                                    label_text = build_liquidity_pool_label(LIQUIDITY_SOURCE_TYPE_WEEKLY, level_label_time)
                                    final_label_time = level_end_time != level_time ? int((level_time + level_end_time) / 2) : level_time
                                    label_style = is_high_level ? label.style_label_down : label.style_label_up
                                    // Offset weekly label vertically to avoid collision with daily labels
                                    bar_range = high - low
                                    spacing_offset = bar_range * WEEKLY_LABEL_OFFSET_MULTIPLIER
                                    label_price_with_offset = level_price + (is_high_level ? -spacing_offset : spacing_offset)
                                    liquidity_label = label.new(final_label_time, label_price_with_offset, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label_style, textcolor=color.black, size=get_source_label_size(), color=color.new(color.white, 100))
                                    array.push(weekly_liquidity_labels, liquidity_label)

                                array.push(displayed_weekly_levels, source_price_key)
                                break

            // Monthly liquidity source line creation
            if show_source_origins and show_monthly_liquidity_lines
                for current_mbz_index = 0 to array.size(current_consolidated_mbz.mbz_group) - 1
                    // Check capacity before processing each MBZ
                    if array.size(monthly_liquidity_lines) >= max_source_displays_effective
                        break

                    current_mbz_in_group = array.get(current_consolidated_mbz.mbz_group, current_mbz_index)

                    if current_mbz_in_group.source_family != SOURCE_FAMILY_LIQUIDITY
                        continue

                    if current_mbz_in_group.source_origin_token != LIQUIDITY_SOURCE_TYPE_MONTHLY
                        continue

                    source_price_key = current_mbz_in_group.source_high
                    if na(source_price_key)
                        continue
                    if not array.includes(displayed_monthly_levels, source_price_key)
                        session_count = liquidity_pool_session_count(monthly_liquidity_pool)
                        for session_idx = 0 to session_count - 1
                            session_high = array.get(monthly_liquidity_pool.highs, session_idx)
                            session_low = array.get(monthly_liquidity_pool.lows, session_idx)

                            level_matched = false
                            level_price = 0.0
                            level_time = 0
                            level_end_time = 0
                            level_label_time = 0
                            is_high_level = false

                            if session_high == source_price_key
                                level_matched := true
                                level_price := session_high
                                level_time := array.get(monthly_liquidity_pool.high_times, session_idx)
                                level_end_time := liquidity_pool_get_high_line_end_time(monthly_liquidity_pool, session_idx, time)
                                level_label_time := array.get(monthly_liquidity_pool.session_close_times, session_idx)
                                is_high_level := true
                            else if session_low == source_price_key
                                level_matched := true
                                level_price := session_low
                                level_time := array.get(monthly_liquidity_pool.low_times, session_idx)
                                level_end_time := liquidity_pool_get_low_line_end_time(monthly_liquidity_pool, session_idx, time)
                                level_label_time := array.get(monthly_liquidity_pool.session_close_times, session_idx)
                                is_high_level := false

                            if level_matched
                                liquidity_line = line.new(level_time, level_price, level_end_time, level_price, xloc=xloc.bar_time, color=monthly_liquidity_color, width=monthly_liquidity_line_width, style=line.style_solid)
                                array.push(monthly_liquidity_lines, liquidity_line)

                                if show_monthly_liquidity_labels
                                    label_text = build_liquidity_pool_label(LIQUIDITY_SOURCE_TYPE_MONTHLY, level_label_time)
                                    final_label_time = level_end_time != level_time ? int((level_time + level_end_time) / 2) : level_time
                                    label_style = is_high_level ? label.style_label_down : label.style_label_up
                                    // Offset monthly label vertically to avoid collision with daily and weekly labels
                                    bar_range = high - low
                                    spacing_offset = bar_range * MONTHLY_LABEL_OFFSET_MULTIPLIER
                                    label_price_with_offset = level_price + (is_high_level ? -spacing_offset : spacing_offset)
                                    liquidity_label = label.new(final_label_time, label_price_with_offset, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label_style, textcolor=color.black, size=get_source_label_size(), color=color.new(color.white, 100))
                                    array.push(monthly_liquidity_labels, liquidity_label)

                                array.push(displayed_monthly_levels, source_price_key)
                                break

            // Asia session liquidity source line creation
            if show_source_origins and show_asia_liquidity_lines
                for current_mbz_index = 0 to array.size(current_consolidated_mbz.mbz_group) - 1
                    // Check capacity before processing each MBZ
                    if array.size(asia_liquidity_lines) >= max_source_displays_effective
                        break

                    current_mbz_in_group = array.get(current_consolidated_mbz.mbz_group, current_mbz_index)

                    if current_mbz_in_group.source_family != SOURCE_FAMILY_LIQUIDITY
                        continue

                    if current_mbz_in_group.source_origin_token != LIQUIDITY_SOURCE_TYPE_ASIA
                        continue

                    source_price_key = current_mbz_in_group.source_high
                    if na(source_price_key)
                        continue
                    if not array.includes(displayed_asia_levels, source_price_key)
                        session_count = liquidity_pool_session_count(asia_session_pool)
                        for session_idx = 0 to session_count - 1
                            session_high = array.get(asia_session_pool.highs, session_idx)
                            session_low = array.get(asia_session_pool.lows, session_idx)

                            level_matched = false
                            level_price = 0.0
                            level_time = 0
                            level_end_time = 0
                            level_label_time = 0
                            is_high_level = false

                            if session_high == source_price_key
                                level_matched := true
                                level_price := session_high
                                level_time := array.get(asia_session_pool.high_times, session_idx)
                                level_end_time := liquidity_pool_get_high_line_end_time(asia_session_pool, session_idx, time)
                                level_label_time := array.get(asia_session_pool.session_close_times, session_idx)
                                is_high_level := true
                            else if session_low == source_price_key
                                level_matched := true
                                level_price := session_low
                                level_time := array.get(asia_session_pool.low_times, session_idx)
                                level_end_time := liquidity_pool_get_low_line_end_time(asia_session_pool, session_idx, time)
                                level_label_time := array.get(asia_session_pool.session_close_times, session_idx)
                                is_high_level := false

                            if level_matched
                                liquidity_line = line.new(level_time, level_price, level_end_time, level_price, xloc=xloc.bar_time, color=asia_liquidity_color, width=asia_liquidity_line_width, style=line.style_solid)
                                array.push(asia_liquidity_lines, liquidity_line)

                                if show_asia_liquidity_labels
                                    label_text = build_liquidity_pool_label(LIQUIDITY_SOURCE_TYPE_ASIA, level_label_time)
                                    final_label_time = level_end_time != level_time ? int((level_time + level_end_time) / 2) : level_time
                                    label_style = is_high_level ? label.style_label_down : label.style_label_up
                                    liquidity_label = label.new(final_label_time, level_price, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label_style, textcolor=color.black, size=get_source_label_size(), color=color.new(color.white, 100))
                                    array.push(asia_liquidity_labels, liquidity_label)

                                array.push(displayed_asia_levels, source_price_key)
                                break

        // Projections using consolidated zones
        if show_mbz_projections and array.size(consolidated_mbzs) > 0
            projection_levels_list = get_projection_levels()
            projected_mbz_count = 0

            for consolidated_mbz_index = 0 to array.size(consolidated_mbzs) - 1
                if projected_mbz_count >= project_last_n_mbzs
                    break

                current_consolidated_mbz = array.get(consolidated_mbzs, consolidated_mbz_index)

                if not should_project_consolidated_mbz(current_consolidated_mbz)
                    continue

                // Use consolidated zone for projections
                consolidated_zone_close_level = current_consolidated_mbz.consolidated_zone_bottom
                consolidated_zone_open_level = current_consolidated_mbz.consolidated_zone_top

                projection_start_bar = current_consolidated_mbz.bar_index
                projection_end_bar = current_consolidated_mbz.bar_index + projection_extend_bars

                for level_index = 0 to array.size(projection_levels_list) - 1
                    current_level_value = array.get(projection_levels_list, level_index)
                    zone_range = (consolidated_zone_open_level - consolidated_zone_close_level)
                    // Direction-aware projection mapping (parity with SIF v9.21):
                    // 0.0 => close (zone bottom), 1.0 => open (zone top),
                    // 0..1 => inside zone from close toward open,
                    // >1.0 (Stops): Bullish below close; Bearish above open
                    // <0.0 (Targets): Bullish above open; Bearish below close
                    projection_target_price = if current_level_value == 0.0
                        consolidated_zone_close_level
                    else if current_level_value == 1.0
                        consolidated_zone_open_level
                    else if current_level_value > 0.0 and current_level_value < 1.0
                        consolidated_zone_close_level + (zone_range * current_level_value)
                    else if current_level_value > 1.0
                        level_extension = current_level_value - 1.0
                        current_consolidated_mbz.is_bullish
                          ? (consolidated_zone_close_level - (zone_range * level_extension))
                          : (consolidated_zone_open_level + (zone_range * level_extension))
                    else
                        absolute_level_value = math.abs(current_level_value)
                        current_consolidated_mbz.is_bullish
                          ? (consolidated_zone_open_level + (zone_range * absolute_level_value))
                          : (consolidated_zone_close_level - (zone_range * absolute_level_value))

                    [level_text_color, level_text_size] = get_level_style(current_level_value)

                    projection_line = line.new(x1=projection_start_bar, y1=projection_target_price, x2=projection_end_bar, y2=projection_target_price,
                                  xloc=xloc.bar_index, color=level_text_color,
                                  style=get_projection_line_style(), width=projection_line_width)
                    array.push(mbz_projection_lines, projection_line)

                    level_label_text = format_level_label(current_level_value)
                    label_offset = PROJECTION_LABEL_OFFSET_BARS
                    label_x_position = projection_label_side == LABEL_POSITION_LEFT ? (projection_start_bar - label_offset) : (projection_end_bar + label_offset)
                    if label_x_position < 0
                        label_x_position := 0
                    projection_level_label = label.new(x=label_x_position, y=projection_target_price, text=level_label_text, style=label.style_none,
                                         textcolor=level_text_color, size=level_text_size,
                                         yloc=yloc.price,
                                         textalign=projection_label_side == LABEL_POSITION_LEFT ? text.align_right : text.align_left)
                    array.push(mbz_projection_labels, projection_level_label)
                projected_mbz_count += 1

    // Cache consolidated groups for reuse in stars block (avoid re-grouping)
    array.clear(last_consolidated_mbzs)
    if array.size(consolidated_mbzs) > 0
        for cache_i = 0 to array.size(consolidated_mbzs) - 1
            array.push(last_consolidated_mbzs, array.get(consolidated_mbzs, cache_i))

    // Liquidity source lines now rendered inline with MBZ display loop (above) for proper visibility filtering

    // Return profiling debug values (liquidity-only mode)
    [debug_total_examined, debug_liquidity_added, debug_daily_liq_added, debug_weekly_liq_added, debug_monthly_liq_added, debug_asia_liq_added, debug_rejected_by_should_display]

// ═══════════════════════════════════════════════════════════════════════════════
// MAIN DETECTION LOGIC // ═══════════════════════════════════════════════════════════════════════════════

// Reset alert flags each bar
nested_mbz_bullish_formed := false
nested_mbz_bearish_formed := false
multi_source_mbz_bullish_formed := false
multi_source_mbz_bearish_formed := false
strong_mbz_bullish_formed := false
strong_mbz_bearish_formed := false
// Reset baseline MBZ formation flags each bar (used by alertcondition/grouped alerts)
mbz_bullish_formed := false
mbz_bearish_formed := false

// Simple fixed pool capacity
liquidity_pool_max_entries = LIQUIDITY_POOL_MAX_ENTRIES

// ═══════════════════════════════════════════════════════════════════════════════
// LIQUIDITY POOL TRACKING
// ═══════════════════════════════════════════════════════════════════════════════
current_tf_minutes_for_tracking = timeframe.in_seconds() / 60

// Timeframe checks using constants
enable_daily_liquidity_tracking = current_tf_minutes_for_tracking >= MIN_TF_DAILY_LIQUIDITY
enable_weekly_liquidity_tracking = current_tf_minutes_for_tracking >= MIN_TF_WEEKLY_LIQUIDITY
enable_monthly_liquidity_tracking = current_tf_minutes_for_tracking >= MIN_TF_MONTHLY_LIQUIDITY
enable_asia_liquidity_tracking = current_tf_minutes_for_tracking <= MAX_TF_ASIA_LIQUIDITY

if enable_daily_liquidity_tracking and (show_source_origins or liquidity_detection_enabled)
    skip_sunday_liquidity = is_sunday_liquidity_reopen(time)
    if not skip_sunday_liquidity
        if barstate.isnew and is_new_liquidity_session(LIQUIDITY_SOURCE_TYPE_DAILY)
            liquidity_pool_finalize_session(daily_liquidity_pool, nz(time[1], time), liquidity_pool_max_entries)
            liquidity_pool_reset_current(daily_liquidity_pool, high, low, time, bar_index)
        else
            liquidity_pool_update_current_extremes(daily_liquidity_pool, high, low, time, bar_index)

        liquidity_pool_mark_breaches(daily_liquidity_pool, high, low, time)
else if barstate.isnew
    liquidity_pool_clear_current(daily_liquidity_pool)

// Weekly liquidity pool tracking
if enable_weekly_liquidity_tracking and (show_source_origins or liquidity_detection_enabled)
    if barstate.isnew and is_new_liquidity_session(LIQUIDITY_SOURCE_TYPE_WEEKLY)
        liquidity_pool_finalize_session(weekly_liquidity_pool, nz(time[1], time), liquidity_pool_max_entries)
        liquidity_pool_reset_current(weekly_liquidity_pool, high, low, time, bar_index)
    else
        liquidity_pool_update_current_extremes(weekly_liquidity_pool, high, low, time, bar_index)

    liquidity_pool_mark_breaches(weekly_liquidity_pool, high, low, time)
else if barstate.isnew
    liquidity_pool_clear_current(weekly_liquidity_pool)

// Monthly liquidity pool tracking
if enable_monthly_liquidity_tracking and (show_source_origins or liquidity_detection_enabled)
    if barstate.isnew and is_new_liquidity_session(LIQUIDITY_SOURCE_TYPE_MONTHLY)
        liquidity_pool_finalize_session(monthly_liquidity_pool, nz(time[1], time), liquidity_pool_max_entries)
        liquidity_pool_reset_current(monthly_liquidity_pool, high, low, time, bar_index)
    else
        liquidity_pool_update_current_extremes(monthly_liquidity_pool, high, low, time, bar_index)

    liquidity_pool_mark_breaches(monthly_liquidity_pool, high, low, time)
else if barstate.isnew
    liquidity_pool_clear_current(monthly_liquidity_pool)

// Asia session liquidity pool tracking
if enable_asia_liquidity_tracking and (show_source_origins or liquidity_detection_enabled)
    in_asia_session = not na(time(timeframe.period, asia_session_time, NY_TIMEZONE))
    was_in_asia_session = not na(time(timeframe.period, asia_session_time, NY_TIMEZONE)[1])

    // Detect session boundaries
    session_just_started = in_asia_session and not was_in_asia_session
    session_just_ended = not in_asia_session and was_in_asia_session

    if session_just_ended
        // Finalize the session that just ended
        liquidity_pool_finalize_session(asia_session_pool, nz(time[1], time), liquidity_pool_max_entries)

    if session_just_started
        // Start new session - always capture the start bar
        liquidity_pool_reset_current(asia_session_pool, high, low, time, bar_index)

    if in_asia_session
        // Update extremes during session (handles both start bar after reset and continuation bars)
        liquidity_pool_update_current_extremes(asia_session_pool, high, low, time, bar_index)

    // Always mark breaches (both during and after session)
    liquidity_pool_mark_breaches(asia_session_pool, high, low, time)
else if barstate.isnew
    liquidity_pool_clear_current(asia_session_pool)

// ═══════════════════════════════════════════════════════════════════════════════
// LIQUIDITY MBZ DETECTION
// ═══════════════════════════════════════════════════════════════════════════════
if liquidity_detection_enabled
    has_previous_bar = not na(open[1]) and not na(close[1])
    if has_previous_bar
        a_open = open[1]
        a_close = close[1]
        a_high = high[1]
        a_low = low[1]
        a_midpoint = (a_open + a_close) / 2.0

        b_open = open
        b_close = close
        b_high = high
        b_low = low

        // Simple fixed scan caps (liquidity pools are much smaller than imbalance scans)
        daily_scan_cap = DAILY_LIQUIDITY_SCAN_CAP
        weekly_scan_cap = WEEKLY_LIQUIDITY_SCAN_CAP
        monthly_scan_cap = MONTHLY_LIQUIDITY_SCAN_CAP
        asia_scan_cap = ASIA_LIQUIDITY_SCAN_CAP

        // Process DAILY liquidity pool (if enabled)
        if enable_daily_liquidity
            [daily_events_is_high, daily_events_rules, daily_events_is_exact, daily_events_source_price, daily_events_source_bar_index] = process_liquidity_pool(daily_liquidity_pool, LIQUIDITY_SOURCE_TYPE_DAILY, daily_scan_cap, enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

            // Create MBZ records from daily events
            daily_event_count = array.size(daily_events_is_high)
            if daily_event_count > 0
                for event_index = 0 to daily_event_count - 1
                    event_is_high = array.get(daily_events_is_high, event_index)
                    event_rule = array.get(daily_events_rules, event_index)
                    event_is_exact = array.get(daily_events_is_exact, event_index)
                    event_source_price = array.get(daily_events_source_price, event_index)
                    event_source_bar_index = array.get(daily_events_source_bar_index, event_index)

                    pool_boundary = event_is_high ? POOL_BOUNDARY_HIGH : POOL_BOUNDARY_LOW
                    is_bullish_event = not event_is_high

                    [_,
                     formed_bull_flag,
                     formed_bear_flag,
                     strong_plus_flag,
                     strong_minus_flag,
                     multi_plus_flag,
                     multi_minus_flag,
                     nested_plus_flag,
                     nested_minus_flag] = create_liquidity_mbz_record(
                         bar_index,
                         b_open,
                         b_high,
                         b_low,
                         b_close,
                         LIQUIDITY_SOURCE_TYPE_DAILY,
                         pool_boundary,
                         event_rule,
                         event_source_price,
                         event_source_bar_index,
                         is_bullish_event,
                         LIQUIDITY_SOURCE_TYPE_DAILY,
                         event_is_exact,
                         daily_liquidity_pool,
                         event_is_high
                     )

                    if formed_bull_flag
                        mbz_bullish_formed := true
                    if formed_bear_flag
                        mbz_bearish_formed := true
                    if multi_plus_flag
                        multi_source_mbz_bullish_formed := true
                    if multi_minus_flag
                        multi_source_mbz_bearish_formed := true
                    if strong_plus_flag
                        strong_mbz_bullish_formed := true
                    if strong_minus_flag
                        strong_mbz_bearish_formed := true
                    if nested_plus_flag
                        nested_mbz_bullish_formed := true
                    if nested_minus_flag
                        nested_mbz_bearish_formed := true
                    needs_visual_update := true

        // Process WEEKLY liquidity pool (if enabled)
        if enable_weekly_liquidity
            [weekly_events_is_high, weekly_events_rules, weekly_events_is_exact, weekly_events_source_price, weekly_events_source_bar_index] = process_liquidity_pool(weekly_liquidity_pool, LIQUIDITY_SOURCE_TYPE_WEEKLY, weekly_scan_cap, enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

            // Create MBZ records from weekly events
            weekly_event_count = array.size(weekly_events_is_high)
            if weekly_event_count > 0
                for event_index = 0 to weekly_event_count - 1
                    event_is_high = array.get(weekly_events_is_high, event_index)
                    event_rule = array.get(weekly_events_rules, event_index)
                    event_is_exact = array.get(weekly_events_is_exact, event_index)
                    event_source_price = array.get(weekly_events_source_price, event_index)
                    event_source_bar_index = array.get(weekly_events_source_bar_index, event_index)

                    pool_boundary = event_is_high ? POOL_BOUNDARY_HIGH : POOL_BOUNDARY_LOW
                    is_bullish_event = not event_is_high

                    [_,
                     formed_bull_flag,
                     formed_bear_flag,
                     strong_plus_flag,
                     strong_minus_flag,
                     multi_plus_flag,
                     multi_minus_flag,
                     nested_plus_flag,
                     nested_minus_flag] = create_liquidity_mbz_record(
                         bar_index,
                         b_open,
                         b_high,
                         b_low,
                         b_close,
                         LIQUIDITY_SOURCE_TYPE_WEEKLY,
                         pool_boundary,
                         event_rule,
                         event_source_price,
                         event_source_bar_index,
                         is_bullish_event,
                         LIQUIDITY_SOURCE_TYPE_WEEKLY,
                         event_is_exact,
                         weekly_liquidity_pool,
                         event_is_high
                     )

                    if formed_bull_flag
                        mbz_bullish_formed := true
                    if formed_bear_flag
                        mbz_bearish_formed := true
                    if multi_plus_flag
                        multi_source_mbz_bullish_formed := true
                    if multi_minus_flag
                        multi_source_mbz_bearish_formed := true
                    if strong_plus_flag
                        strong_mbz_bullish_formed := true
                    if strong_minus_flag
                        strong_mbz_bearish_formed := true
                    if nested_plus_flag
                        nested_mbz_bullish_formed := true
                    if nested_minus_flag
                        nested_mbz_bearish_formed := true
                    needs_visual_update := true

        // Process MONTHLY liquidity pool (if enabled)
        if enable_monthly_liquidity
            [monthly_events_is_high, monthly_events_rules, monthly_events_is_exact, monthly_events_source_price, monthly_events_source_bar_index] = process_liquidity_pool(monthly_liquidity_pool, LIQUIDITY_SOURCE_TYPE_MONTHLY, monthly_scan_cap, enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

            // Create MBZ records from monthly events
            monthly_event_count = array.size(monthly_events_is_high)
            if monthly_event_count > 0
                for event_index = 0 to monthly_event_count - 1
                    event_is_high = array.get(monthly_events_is_high, event_index)
                    event_rule = array.get(monthly_events_rules, event_index)
                    event_is_exact = array.get(monthly_events_is_exact, event_index)
                    event_source_price = array.get(monthly_events_source_price, event_index)
                    event_source_bar_index = array.get(monthly_events_source_bar_index, event_index)

                    pool_boundary = event_is_high ? POOL_BOUNDARY_HIGH : POOL_BOUNDARY_LOW
                    is_bullish_event = not event_is_high

                    [_,
                     formed_bull_flag,
                     formed_bear_flag,
                     strong_plus_flag,
                     strong_minus_flag,
                     multi_plus_flag,
                     multi_minus_flag,
                     nested_plus_flag,
                     nested_minus_flag] = create_liquidity_mbz_record(
                         bar_index,
                         b_open,
                         b_high,
                         b_low,
                         b_close,
                         LIQUIDITY_SOURCE_TYPE_MONTHLY,
                         pool_boundary,
                         event_rule,
                         event_source_price,
                         event_source_bar_index,
                         is_bullish_event,
                         LIQUIDITY_SOURCE_TYPE_MONTHLY,
                         event_is_exact,
                         monthly_liquidity_pool,
                         event_is_high
                     )

                    if formed_bull_flag
                        mbz_bullish_formed := true
                    if formed_bear_flag
                        mbz_bearish_formed := true
                    if multi_plus_flag
                        multi_source_mbz_bullish_formed := true
                    if multi_minus_flag
                        multi_source_mbz_bearish_formed := true
                    if strong_plus_flag
                        strong_mbz_bullish_formed := true
                    if strong_minus_flag
                        strong_mbz_bearish_formed := true
                    if nested_plus_flag
                        nested_mbz_bullish_formed := true
                    if nested_minus_flag
                        nested_mbz_bearish_formed := true
                    needs_visual_update := true

        // Process ASIA SESSION liquidity pool (if enabled)
        if enable_asia_liquidity
            [asia_events_is_high, asia_events_rules, asia_events_is_exact, asia_events_source_price, asia_events_source_bar_index] = process_liquidity_pool(asia_session_pool, LIQUIDITY_SOURCE_TYPE_ASIA, asia_scan_cap, enable_liquidity_immediate, enable_liquidity_standard, enable_liquidity_delayed, a_open, a_close, a_high, a_low, a_midpoint, b_open, b_close, b_high, b_low)

            // Create MBZ records from Asia session events
            asia_event_count = array.size(asia_events_is_high)
            if asia_event_count > 0
                for event_index = 0 to asia_event_count - 1
                    event_is_high = array.get(asia_events_is_high, event_index)
                    event_rule = array.get(asia_events_rules, event_index)
                    event_is_exact = array.get(asia_events_is_exact, event_index)
                    event_source_price = array.get(asia_events_source_price, event_index)
                    event_source_bar_index = array.get(asia_events_source_bar_index, event_index)

                    pool_boundary = event_is_high ? POOL_BOUNDARY_HIGH : POOL_BOUNDARY_LOW
                    is_bullish_event = not event_is_high

                    [_,
                     formed_bull_flag,
                     formed_bear_flag,
                     strong_plus_flag,
                     strong_minus_flag,
                     multi_plus_flag,
                     multi_minus_flag,
                     nested_plus_flag,
                     nested_minus_flag] = create_liquidity_mbz_record(
                         bar_index,
                         b_open,
                         b_high,
                         b_low,
                         b_close,
                         LIQUIDITY_SOURCE_TYPE_ASIA,
                         pool_boundary,
                         event_rule,
                         event_source_price,
                         event_source_bar_index,
                         is_bullish_event,
                         LIQUIDITY_SOURCE_TYPE_ASIA,
                         event_is_exact,
                         asia_session_pool,
                         event_is_high
                     )

                    if formed_bull_flag
                        mbz_bullish_formed := true
                    if formed_bear_flag
                        mbz_bearish_formed := true
                    if multi_plus_flag
                        multi_source_mbz_bullish_formed := true
                    if multi_minus_flag
                        multi_source_mbz_bearish_formed := true
                    if strong_plus_flag
                        strong_mbz_bullish_formed := true
                    if strong_minus_flag
                        strong_mbz_bearish_formed := true
                    if nested_plus_flag
                        nested_mbz_bullish_formed := true
                    if nested_minus_flag
                        nested_mbz_bearish_formed := true
                    needs_visual_update := true

// PERFORMANCE OPTIMIZATION: Skip historical processing for instant loading
if ENABLE_HISTORICAL_BACKFILL and not initialized and barstate.islastconfirmedhistory
    // Historical backfill processing would go here (currently disabled)
    initialized := true
else if not initialized
    // Skip historical processing - start fresh for instant loading
    initialized := true

// PERFORMANCE: Aggressive garbage collection of invalidated MBZs
// Philosophy: Invalidated MBZs are for display/analysis only (use replay mode for deep inspection)
// Keep ONLY what user wants to display, delete everything else immediately (free capacity for active MBZs)
// OPTIMIZATION: Only run on live bars or end of history (skip during historical load for speed)
should_run_garbage_collection = barstate.islastconfirmedhistory or barstate.islast
if should_run_garbage_collection and array.size(all_mbz_records) > 0
    invalidated_count = 0
    invalidated_indices = array.new_int()

    // Count invalidated MBZs and track their indices (oldest first)
    for i = 0 to array.size(all_mbz_records) - 1
        if array.get(all_mbz_records, i).is_invalidated
            invalidated_count += 1
            array.push(invalidated_indices, i)

    // Determine how many invalidated to keep
    // If "Show Invalidated" is OFF: keep 0 (delete all)
    // If "Show Invalidated" is ON: keep max_invalidated_mbzs (user's display quota)
    keep_invalidated = show_invalidated_mbzs ? max_invalidated_mbzs_effective : 0
    excess_invalidated = invalidated_count - keep_invalidated

    if excess_invalidated > 0
        // AGGRESSIVE: Delete ALL excess invalidated MBZs (free capacity immediately)
        removed = 0
        for idx = 0 to array.size(invalidated_indices) - 1
            if removed >= excess_invalidated
                break

            invalidated_idx = array.get(invalidated_indices, idx)
            adjusted_idx = invalidated_idx - removed  // Adjust for previous removals
            array.remove(all_mbz_records, adjusted_idx)

            // Also remove from active array if somehow still there
            if adjusted_idx < array.size(active_mbz_records)
                mbz_in_active = array.get(active_mbz_records, adjusted_idx)
                if mbz_in_active.is_invalidated
                    array.remove(active_mbz_records, adjusted_idx)

            removed += 1

// Clean up old records and visual elements
while array.size(all_mbz_records) > max_mbz_records_effective
    oldest_record = array.get(all_mbz_records, 0)  // Get before removing
    array.shift(all_mbz_records)

    // PERFORMANCE: Also remove from active array if it's still there (not invalidated yet)
    if not oldest_record.is_invalidated
        for active_idx = 0 to array.size(active_mbz_records) - 1
            active_rec = array.get(active_mbz_records, active_idx)
            if active_rec.bar_index == oldest_record.bar_index and
               active_rec.source_type == oldest_record.source_type and
               active_rec.is_bullish == oldest_record.is_bullish
                array.remove(active_mbz_records, active_idx)
                break

while array.size(mbz_body_highlights) > max_body_highlights_effective
    box.delete(array.shift(mbz_body_highlights))

while array.size(mbz_wick_highlights) > max_wick_highlights_effective
    box.delete(array.shift(mbz_wick_highlights))

while array.size(mbz_extended_boxes) > max_extended_boxes_effective
    box.delete(array.shift(mbz_extended_boxes))

while array.size(mbz_projection_lines) > MAX_PROJECTION_LINES
    line.delete(array.shift(mbz_projection_lines))

while array.size(mbz_projection_labels) > MAX_PROJECTION_LABELS
    label.delete(array.shift(mbz_projection_labels))

// PERFORMANCE OPTIMIZED: Only check active (non-invalidated) MBZs
// This avoids wasting checks on already-invalidated records every bar
// CRITICAL OPTIMIZATION: Always sync invalidations (required for display), but skip confirmation status syncs during history
should_sync_confirmation_status = barstate.islastconfirmedhistory or barstate.islast
if array.size(active_mbz_records) > 0
    for i = array.size(active_mbz_records) - 1 to 0
        mbz_record = array.get(active_mbz_records, i)

        // Update confirmation status first
        updated_mbz = check_mbz_confirmation(mbz_record)
        // Check for invalidation using enhanced source detection
        should_invalidate = should_mbz_be_invalidated_enhanced(updated_mbz, open, close)

        if should_invalidate
            updated_mbz.is_invalidated := true
            updated_mbz.cached_data_valid := false  // Invalidate cache
            needs_visual_update := true

            // Update in active array
            array.set(active_mbz_records, i, updated_mbz)

            // ALWAYS sync invalidations to all_mbz_records (required for correct display)
            // Find and update in all_mbz_records
            for all_idx = 0 to array.size(all_mbz_records) - 1
                all_rec = array.get(all_mbz_records, all_idx)
                if all_rec.bar_index == updated_mbz.bar_index and
                   all_rec.source_type == updated_mbz.source_type and
                   all_rec.is_bullish == updated_mbz.is_bullish and
                   not all_rec.is_invalidated
                    array.set(all_mbz_records, all_idx, updated_mbz)
                    break

            // Remove from active array (no longer needs invalidation checks)
            array.remove(active_mbz_records, i)
        else
            // Still active, just update confirmation status in active array
            array.set(active_mbz_records, i, updated_mbz)

            // PERFORMANCE: Only sync confirmation status during display (not every bar during history)
            // This saves millions of comparisons without affecting display accuracy
            if should_sync_confirmation_status
                // Update in all_mbz_records as well
                for all_idx = 0 to array.size(all_mbz_records) - 1
                    all_rec = array.get(all_mbz_records, all_idx)
                    if all_rec.bar_index == updated_mbz.bar_index and
                       all_rec.source_type == updated_mbz.source_type and
                       all_rec.is_bullish == updated_mbz.is_bullish
                        array.set(all_mbz_records, all_idx, updated_mbz)
                        break

if not na(liquidity_variant_placeholder_label)
    label.delete(liquidity_variant_placeholder_label)
    liquidity_variant_placeholder_label := na

// ═══════════════════════════════════════════════════════════════════════════════
// VISUAL MANAGEMENT - CONSOLIDATED SYSTEM // ═══════════════════════════════════════════════════════════════════════════════

// PERFORMANCE OPTIMIZED: Smart visual update system - only when truly necessary
// Defer visual updates during historical load (fast initial render: 5-10x faster)
// Update only at: end of history (islastconfirmedhistory), live bars, or full update requests
should_update_visuals = needs_full_update or barstate.islastconfirmedhistory or (barstate.islast and (needs_visual_update or bar_index != last_update_bar))

if should_update_visuals
    [debug_examined, debug_liq_added, debug_daily_added, debug_weekly_added, debug_monthly_added, debug_asia_added, debug_rejected] = manage_consolidated_mbz_display()

    // PROFILING: Track display results after function completes
    if show_profiling
        profile_total_records_examined := debug_examined
        profile_liquidity_records_added := debug_liq_added
        profile_daily_liq_added := debug_daily_added
        profile_weekly_liq_added := debug_weekly_added
        profile_monthly_liq_added := debug_monthly_added
        profile_asia_liq_added := debug_asia_added
        profile_rejected_by_should_display := debug_rejected
        profile_records_consolidated := array.size(last_consolidated_mbzs)

        // Count totals in all_mbz_records
        profile_daily_liq_total := 0
        profile_weekly_liq_total := 0
        profile_monthly_liq_total := 0
        profile_asia_liq_total := 0
        profile_daily_liq_invalidated := 0
        profile_weekly_liq_invalidated := 0
        profile_monthly_liq_invalidated := 0
        profile_asia_liq_invalidated := 0
        profile_weekly_rejected_direction := 0
        profile_weekly_rejected_display := 0
        if array.size(all_mbz_records) > 0
            for rec_idx = 0 to array.size(all_mbz_records) - 1
                rec = array.get(all_mbz_records, rec_idx)

                // Skip MBZs too old to render (same limit as rendering loop)
                rec_bars_ago = bar_index - rec.bar_index
                if rec_bars_ago >= MAX_RENDERABLE_BAR_AGE
                    continue

                if rec.source_family == SOURCE_FAMILY_LIQUIDITY
                    if rec.source_origin_token == LIQUIDITY_SOURCE_TYPE_DAILY
                        profile_daily_liq_total += 1
                        if rec.is_invalidated
                            profile_daily_liq_invalidated += 1
                    else if rec.source_origin_token == LIQUIDITY_SOURCE_TYPE_WEEKLY
                        profile_weekly_liq_total += 1
                        if rec.is_invalidated
                            profile_weekly_liq_invalidated += 1
                        // Check filters that would reject this weekly MBZ (liquidity-only mode)
                        if not rec.is_invalidated
                            if not should_display_mbz_direction(rec)
                                profile_weekly_rejected_direction += 1
                            else if not should_display_mbz(rec)
                                profile_weekly_rejected_display += 1
                    else if rec.source_origin_token == LIQUIDITY_SOURCE_TYPE_MONTHLY
                        profile_monthly_liq_total += 1
                        if rec.is_invalidated
                            profile_monthly_liq_invalidated += 1
                    else if rec.source_origin_token == LIQUIDITY_SOURCE_TYPE_ASIA
                        profile_asia_liq_total += 1
                        if rec.is_invalidated
                            profile_asia_liq_invalidated += 1

        // Pool sessions
        profile_daily_sessions := liquidity_pool_session_count(daily_liquidity_pool)
        profile_weekly_sessions := liquidity_pool_session_count(weekly_liquidity_pool)
        profile_monthly_sessions := liquidity_pool_session_count(monthly_liquidity_pool)
        profile_asia_sessions := liquidity_pool_session_count(asia_session_pool)

    last_update_bar := bar_index
    needs_full_update := false
    needs_visual_update := false


// Wick dominance stars - Reuse consolidated groups; update only on visual updates
if enable_wick_dominance_markers and should_update_visuals
    for existing_star_element in star_labels
        label.delete(existing_star_element)
    array.clear(star_labels)

    // Use last_consolidated_mbzs built during visual render to avoid re-grouping
    if array.size(last_consolidated_mbzs) > 0
        for consolidated_index = 0 to array.size(last_consolidated_mbzs) - 1
            current_consolidated_mbz_for_star = array.get(last_consolidated_mbzs, consolidated_index)

            // Check each MBZ in the group for dominant wicks
            for mbz_in_group_index = 0 to array.size(current_consolidated_mbz_for_star.mbz_group) - 1
                individual_mbz_for_star = array.get(current_consolidated_mbz_for_star.mbz_group, mbz_in_group_index)

                mbz_body_top_price = math.max(individual_mbz_for_star.mbz_open, individual_mbz_for_star.mbz_close)
                mbz_body_bottom_price = math.min(individual_mbz_for_star.mbz_open, individual_mbz_for_star.mbz_close)
                mbz_body_size_range = mbz_body_top_price - mbz_body_bottom_price
                mbz_upper_wick_size = individual_mbz_for_star.high_price - mbz_body_top_price
                mbz_lower_wick_size = mbz_body_bottom_price - individual_mbz_for_star.low_price

                [wick_dominance_tier, has_significant_wick_dominance] = classify_wick_dominance(mbz_body_size_range, mbz_upper_wick_size, mbz_lower_wick_size)

                if has_significant_wick_dominance
                    wick_tier_star_color = switch wick_dominance_tier
                        WICK_TIER_STANDARD => standard_star_color
                        WICK_TIER_RELAXED => relaxed_star_color
                        WICK_TIER_RISKY => risky_star_color
                        => standard_star_color

                    wick_strength_description = switch wick_dominance_tier
                        WICK_TIER_STANDARD => "Standard (≥100%)"
                        WICK_TIER_RELAXED => "Relaxed (85-99%)"
                        WICK_TIER_RISKY => "Risky (80-84%)"
                        => WICK_TIER_STANDARD_DISPLAY

                    is_mbz_candle_bullish = individual_mbz_for_star.mbz_close > individual_mbz_for_star.mbz_open
                    star_y_position = is_mbz_candle_bullish ? individual_mbz_for_star.low_price : individual_mbz_for_star.high_price
                    star_y_location = is_mbz_candle_bullish ? yloc.abovebar : yloc.belowbar

                    star_label_size = current_consolidated_mbz_for_star.is_consolidated_invalidated ? get_invalidated_mbz_size() : get_wick_star_size()
                    star_label_color = current_consolidated_mbz_for_star.is_consolidated_invalidated ? mbz_invalidated_color : wick_tier_star_color

                    wick_dominance_star_label = label.new(
                         x=individual_mbz_for_star.bar_index,
                         y=star_y_position,
                         text="★",
                         style=label.style_none,
                         textcolor=star_label_color,
                         size=star_label_size,
                         yloc=star_y_location,
                         tooltip="Dominant Wick MBZ (" + wick_strength_description + ")"
                     )

                    array.push(star_labels, wick_dominance_star_label)

// ═══════════════════════════════════════════════════════════════════════════════
// ENHANCED ALERTS - flags set in main detection (duplicate scan removed)

// Individual alertconditions
// - Always available by Pine design; attach alerts per condition if desired.
// - Minimal UX: title = condition name, message = timeframe only.
// Liquidity-only mode alerts
alertcondition(mbz_bullish_formed, title=MBZ_PLUS, message='{{interval}}')
alertcondition(mbz_bearish_formed, title=MBZ_MINUS, message='{{interval}}')
alertcondition(nested_mbz_bullish_formed, title=ALERT_TITLE_NESTED_MBZ_PLUS, message='{{interval}}')
alertcondition(nested_mbz_bearish_formed, title=ALERT_TITLE_NESTED_MBZ_MINUS, message='{{interval}}')
alertcondition(multi_source_mbz_bullish_formed, title=ALERT_TITLE_MULTI_SOURCE_MBZ_PLUS, message='{{interval}}')
alertcondition(multi_source_mbz_bearish_formed, title=ALERT_TITLE_MULTI_SOURCE_MBZ_MINUS, message='{{interval}}')
alertcondition(strong_mbz_bullish_formed, title=ALERT_TITLE_STRONG_MBZ_PLUS, message='{{interval}}')
alertcondition(strong_mbz_bearish_formed, title=ALERT_TITLE_STRONG_MBZ_MINUS, message='{{interval}}')
// Grouped alert system logic
// - Builds a single, clean message per bar if any enabled conditions occur.
// - Uses specials-priority lead and +N counting (see header docs) for clarity.
if alert_mode == ALERT_MODE_GROUPED or alert_mode == ALERT_MODE_BOTH
    // Reset grouped alert state
    mbz_grouped_alert_active := false
    array.clear(mbz_alert_parts)

    // Check each enabled condition
    if enable_mbz_plus_formation and mbz_bullish_formed
        array.push(mbz_alert_parts, ALERT_MSG_MBZ_PLUS_FORMED)
        mbz_grouped_alert_active := true
    if enable_mbz_minus_formation and mbz_bearish_formed
        array.push(mbz_alert_parts, ALERT_MSG_MBZ_MINUS_FORMED)
        mbz_grouped_alert_active := true

    // Special alerts (strong, multi-source, nested)
    strong_plus_active = enable_strong_mbz_plus and strong_mbz_bullish_formed
    strong_minus_active = enable_strong_mbz_minus and strong_mbz_bearish_formed

    if strong_plus_active
        array.push(mbz_alert_parts, ALERT_MSG_STRONG_MBZ_PLUS)
        mbz_grouped_alert_active := true
    if strong_minus_active
        array.push(mbz_alert_parts, ALERT_MSG_STRONG_MBZ_MINUS)
        mbz_grouped_alert_active := true

    if enable_multi_source_mbz_plus and multi_source_mbz_bullish_formed and not strong_plus_active
        array.push(mbz_alert_parts, ALERT_MSG_MULTI_SOURCE_MBZ_PLUS)
        mbz_grouped_alert_active := true
    if enable_multi_source_mbz_minus and multi_source_mbz_bearish_formed and not strong_minus_active
        array.push(mbz_alert_parts, ALERT_MSG_MULTI_SOURCE_MBZ_MINUS)
        mbz_grouped_alert_active := true

    if enable_nested_mbz_plus_alert and nested_mbz_bullish_formed
        array.push(mbz_alert_parts, ALERT_MSG_NESTED_MBZ_PLUS)
        mbz_grouped_alert_active := true
    if enable_nested_mbz_minus_alert and nested_mbz_bearish_formed
        array.push(mbz_alert_parts, ALERT_MSG_NESTED_MBZ_MINUS)
        mbz_grouped_alert_active := true

    // Fire grouped alert if any condition met
    if mbz_grouped_alert_active
        // Select a lead by priority: Strong > Multi-Source > Nested > Baseline MBZ
        lead_text = ""
        if array.includes(mbz_alert_parts, ALERT_MSG_STRONG_MBZ_PLUS)
            lead_text := ALERT_MSG_STRONG_MBZ_PLUS
        else if array.includes(mbz_alert_parts, ALERT_MSG_STRONG_MBZ_MINUS)
            lead_text := ALERT_MSG_STRONG_MBZ_MINUS
        else if array.includes(mbz_alert_parts, ALERT_MSG_MULTI_SOURCE_MBZ_PLUS)
            lead_text := ALERT_MSG_MULTI_SOURCE_MBZ_PLUS
        else if array.includes(mbz_alert_parts, ALERT_MSG_MULTI_SOURCE_MBZ_MINUS)
            lead_text := ALERT_MSG_MULTI_SOURCE_MBZ_MINUS
        else if array.includes(mbz_alert_parts, ALERT_MSG_NESTED_MBZ_PLUS)
            lead_text := ALERT_MSG_NESTED_MBZ_PLUS
        else if array.includes(mbz_alert_parts, ALERT_MSG_NESTED_MBZ_MINUS)
            lead_text := ALERT_MSG_NESTED_MBZ_MINUS
        // Fallback to baseline MBZ
        else if array.includes(mbz_alert_parts, ALERT_MSG_MBZ_PLUS_FORMED)
            lead_text := ALERT_MSG_MBZ_PLUS_FORMED
        else if array.includes(mbz_alert_parts, ALERT_MSG_MBZ_MINUS_FORMED)
            lead_text := ALERT_MSG_MBZ_MINUS_FORMED

        // Count specials only (ignore baseline MBZ)
        has_strong_special = array.includes(mbz_alert_parts, ALERT_MSG_STRONG_MBZ_PLUS) or array.includes(mbz_alert_parts, ALERT_MSG_STRONG_MBZ_MINUS)
        has_multi_source_special = array.includes(mbz_alert_parts, ALERT_MSG_MULTI_SOURCE_MBZ_PLUS) or array.includes(mbz_alert_parts, ALERT_MSG_MULTI_SOURCE_MBZ_MINUS)
        has_nested_special = array.includes(mbz_alert_parts, ALERT_MSG_NESTED_MBZ_PLUS) or array.includes(mbz_alert_parts, ALERT_MSG_NESTED_MBZ_MINUS)
        specials_count = (has_strong_special ? 1 : 0) + (has_multi_source_special ? 1 : 0) + (has_nested_special ? 1 : 0)

        // Determine if lead is a special
        lead_is_special = (lead_text == ALERT_MSG_STRONG_MBZ_PLUS) or (lead_text == ALERT_MSG_STRONG_MBZ_MINUS) or (lead_text == ALERT_MSG_MULTI_SOURCE_MBZ_PLUS) or (lead_text == ALERT_MSG_MULTI_SOURCE_MBZ_MINUS) or (lead_text == ALERT_MSG_NESTED_MBZ_PLUS) or (lead_text == ALERT_MSG_NESTED_MBZ_MINUS)

        extra = lead_is_special ? math.max(0, specials_count - 1) : specials_count
        plus_n = extra > 0 ? (" +" + str.tostring(extra)) : ""
        tf = str.tostring(timeframe.period)
        // Message: "<lead> +N • timeframe" (no prefix/price/commas/dashes)
        alert(ALERT_PREFIX_GROUPED + lead_text + plus_n + " • " + tf)

// ═══════════════════════════════════════════════════════════════════════════════
// PERFORMANCE PROFILING TABLE
// ═══════════════════════════════════════════════════════════════════════════════
if show_profiling
    if na(profiling_table)
        profiling_table := table.new(position.top_right, 2, 30, bgcolor=color.black, border_width=1, border_color=color.white)

    // Header
    table.cell(profiling_table, 0, 0, "v10 Setting/Metric", text_color=color.white, bgcolor=color.new(color.orange, 30), text_size=size.small)
    table.cell(profiling_table, 1, 0, "Value", text_color=color.white, bgcolor=color.new(color.orange, 30), text_size=size.small)

    // Settings
    table.cell(profiling_table, 0, 2, "Max Liquidity", text_color=color.white, text_size=size.small)
    table.cell(profiling_table, 1, 2, str.tostring(max_liquidity_mbzs), text_color=color.yellow, text_size=size.small)

    // Pool Status
    table.cell(profiling_table, 0, 3, "D / W / M / A Sessions", text_color=color.white, text_size=size.small)
    table.cell(profiling_table, 1, 3, str.tostring(profile_daily_sessions) + " / " + str.tostring(profile_weekly_sessions) + " / " + str.tostring(profile_monthly_sessions) + " / " + str.tostring(profile_asia_sessions), text_color=color.aqua, text_size=size.small)

    // Total Records Created (Liquidity Only)
    table.cell(profiling_table, 0, 4, "Total MBZ Records", text_color=color.white, text_size=size.small)
    table.cell(profiling_table, 1, 4, str.tostring(array.size(all_mbz_records)), text_color=color.aqua, text_size=size.small)

    table.cell(profiling_table, 0, 5, "  └─ Daily Liq Total", text_color=color.gray, text_size=size.small)
    table.cell(profiling_table, 1, 5, str.tostring(profile_daily_liq_total), text_color=color.aqua, text_size=size.small)

    table.cell(profiling_table, 0, 6, "  └─ Weekly Liq Total", text_color=color.gray, text_size=size.small)
    table.cell(profiling_table, 1, 6, str.tostring(profile_weekly_liq_total), text_color=color.aqua, text_size=size.small)

    table.cell(profiling_table, 0, 7, "  └─ Monthly Liq Total", text_color=color.gray, text_size=size.small)
    table.cell(profiling_table, 1, 7, str.tostring(profile_monthly_liq_total), text_color=color.aqua, text_size=size.small)

    table.cell(profiling_table, 0, 8, "  └─ Asia Liq Total", text_color=color.gray, text_size=size.small)
    table.cell(profiling_table, 1, 8, str.tostring(profile_asia_liq_total), text_color=color.aqua, text_size=size.small)

    // Visible on Chart (Active Only)
    table.cell(profiling_table, 0, 9, "ACTIVE VISIBLE", text_color=color.white, bgcolor=color.new(color.green, 30), text_size=size.small)
    table.cell(profiling_table, 1, 9, str.tostring(profile_liquidity_records_added), text_color=color.lime, bgcolor=color.new(color.green, 30), text_size=size.small, text_font_family=font.family_monospace)

    table.cell(profiling_table, 0, 10, "  └─ Daily Liq Visible", text_color=color.gray, text_size=size.small)
    table.cell(profiling_table, 1, 10, str.tostring(profile_daily_liq_added), text_color=color.lime, text_size=size.small)

    table.cell(profiling_table, 0, 11, "  └─ Weekly Liq Visible", text_color=color.gray, text_size=size.small)
    table.cell(profiling_table, 1, 11, str.tostring(profile_weekly_liq_added), text_color=color.lime, text_size=size.small)

    table.cell(profiling_table, 0, 12, "  └─ Monthly Liq Visible", text_color=color.gray, text_size=size.small)
    table.cell(profiling_table, 1, 12, str.tostring(profile_monthly_liq_added), text_color=color.lime, text_size=size.small)

    table.cell(profiling_table, 0, 13, "  └─ Asia Liq Visible", text_color=color.gray, text_size=size.small)
    table.cell(profiling_table, 1, 13, str.tostring(profile_asia_liq_added), text_color=color.lime, text_size=size.small)

    // Invalidated Liquidity
    table.cell(profiling_table, 0, 14, "INVALIDATED", text_color=color.white, bgcolor=color.new(color.orange, 70), text_size=size.small)
    table.cell(profiling_table, 1, 14, "", text_color=color.white, bgcolor=color.new(color.orange, 70), text_size=size.small)

    table.cell(profiling_table, 0, 15, "  └─ Daily Invalidated", text_color=color.gray, text_size=size.small)
    table.cell(profiling_table, 1, 15, str.tostring(profile_daily_liq_invalidated), text_color=color.orange, text_size=size.small)

    table.cell(profiling_table, 0, 16, "  └─ Weekly Invalidated", text_color=color.gray, text_size=size.small)
    table.cell(profiling_table, 1, 16, str.tostring(profile_weekly_liq_invalidated), text_color=color.orange, text_size=size.small)

    table.cell(profiling_table, 0, 17, "  └─ Monthly Invalidated", text_color=color.gray, text_size=size.small)
    table.cell(profiling_table, 1, 17, str.tostring(profile_monthly_liq_invalidated), text_color=color.orange, text_size=size.small)

    table.cell(profiling_table, 0, 18, "  └─ Asia Invalidated", text_color=color.gray, text_size=size.small)
    table.cell(profiling_table, 1, 18, str.tostring(profile_asia_liq_invalidated), text_color=color.orange, text_size=size.small)

    // Detection/Filter Metrics
    table.cell(profiling_table, 0, 19, "Records Examined", text_color=color.white, text_size=size.small)
    table.cell(profiling_table, 1, 19, str.tostring(profile_total_records_examined), text_color=color.aqua, text_size=size.small)

    table.cell(profiling_table, 0, 20, "Rejected by Display", text_color=color.white, text_size=size.small)
    table.cell(profiling_table, 1, 20, str.tostring(profile_rejected_by_should_display), text_color=color.red, text_size=size.small)

    table.cell(profiling_table, 0, 21, "Consolidated Groups", text_color=color.white, text_size=size.small)
    table.cell(profiling_table, 1, 21, str.tostring(profile_records_consolidated), text_color=color.aqua, text_size=size.small)

// ═══════════════════════════════════════════════════════════════════════════════
// 500 BAR AGE LIMIT INDICATOR LINE
// ═══════════════════════════════════════════════════════════════════════════════
if barstate.islast and show_age_limit_line
    // Calculate how many bars back is the limit (or current bar if less than 500 bars of history)
    cutoff_bars = math.min(bar_index, MAX_RENDERABLE_BAR_AGE)

    if cutoff_bars > 0
        cutoff_time = time[cutoff_bars]

        if not na(cutoff_time)
            // Draw vertical line at the 500 bar boundary
            var line age_limit_boundary = na
            if not na(age_limit_boundary)
                line.delete(age_limit_boundary)

            cutoff_low = low[cutoff_bars]
            cutoff_high = high[cutoff_bars]

            // Convert line style string to Pine style constant
            line_style_value = age_limit_line_style == 'Solid' ? line.style_solid : age_limit_line_style == 'Dotted' ? line.style_dotted : line.style_dashed

            age_limit_boundary := line.new(cutoff_time, cutoff_low, cutoff_time, cutoff_high, xloc=xloc.bar_time, extend=extend.both, color=age_limit_line_color, style=line_style_value, width=age_limit_line_width)

            // Add label explaining the line
            var label age_limit_label = na
            if not na(age_limit_label)
                label.delete(age_limit_label)

            // Calculate timeframe-specific duration text
            bars_per_day = 1440 / timeframe.in_seconds() * 60  // bars in 24 hours
            days_shown = math.round(MAX_RENDERABLE_BAR_AGE / bars_per_day * 10) / 10

            duration_text = days_shown < 1 ?
                 str.format("{0} hours", math.round(days_shown * 24 * 10) / 10) :
                 days_shown < 7 ?
                     str.format("{0} days", math.round(days_shown * 10) / 10) :
                     str.format("{0} weeks", math.round(days_shown / 7 * 10) / 10)

            label_text = "← 500 Bar Limit\n(" + duration_text + " ago)\nMBZs older than this\ncannot be rendered"

            // Convert label size string to Pine size constant
            label_size_value = age_limit_label_size == 'Tiny' ? size.tiny : age_limit_label_size == 'Small' ? size.small : age_limit_label_size == 'Normal' ? size.normal : size.large

            age_limit_label := label.new(cutoff_time, cutoff_high, label_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, color=age_limit_label_bg, textcolor=age_limit_label_color, size=label_size_value)

// MBZ Hunter° [Pro+] [mbz-ultimate]
