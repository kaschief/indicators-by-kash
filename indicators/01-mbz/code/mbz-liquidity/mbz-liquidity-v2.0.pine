//@version=6

// ═══════════════════════════════════════════════════════════════════════════════
// INDICATOR VISUAL LIMITS (Must be declared before indicator() function)
// ═══════════════════════════════════════════════════════════════════════════════
INDICATOR_MAX_BOXES = 500
INDICATOR_MAX_LABELS = 500
INDICATOR_MAX_LINES = 500
INDICATOR_TITLE='MBZ Hunter° [Pro+] [Liquidity]'
SHORT_TITLE="mbz-liquidity"

indicator(title=INDICATOR_TITLE, shorttitle=SHORT_TITLE, overlay=true, max_boxes_count=INDICATOR_MAX_BOXES, max_labels_count=INDICATOR_MAX_LABELS, max_lines_count=INDICATOR_MAX_LINES)
// Docs: indicators/mbz/docs/mbz-dual-alert-system.md (moved long-form comments)

// Alert variables
nested_mbz_bullish_formed = false
nested_mbz_bearish_formed = false
multi_source_mbz_bullish_formed = false
multi_source_mbz_bearish_formed = false
strong_mbz_bullish_formed = false
strong_mbz_bearish_formed = false

var bool mbz_grouped_alert_active = false
var string mbz_alert_message = ""
var array<string> mbz_alert_parts = array.new<string>()

mbz_bullish_formed = false
mbz_bearish_formed = false

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS & CONSTANTS - CLEAN STRUCTURE
// ═══════════════════════════════════════════════════════════════════════════════

// Liquidity source constants
SOURCE_FAMILY_LIQUIDITY = "liquidity"

POOL_BOUNDARY_NONE = ""
POOL_BOUNDARY_HIGH = "high"
POOL_BOUNDARY_LOW = "low"

// Variant types
VARIANT_LIQUIDITY = "Liquidity"

// Formation rules
FORMATION_RULE_LIQUIDITY_IMMEDIATE = "liquidity_immediate"
FORMATION_RULE_LIQUIDITY_STANDARD = "liquidity_standard"
FORMATION_RULE_LIQUIDITY_DELAYED = "liquidity_delayed"

FORMATION_PREFIX_LIQUIDITY_IMMEDIATE = "L-IMM "
FORMATION_PREFIX_LIQUIDITY_STANDARD = "L-STD "
FORMATION_PREFIX_LIQUIDITY_DELAYED = "L-DEL "

// Liquidity source types
LIQUIDITY_SOURCE_TYPE_DAILY = "daily"
LIQUIDITY_SOURCE_TYPE_WEEKLY = "weekly"
LIQUIDITY_SOURCE_TYPE_MONTHLY = "monthly"
LIQUIDITY_SOURCE_TYPE_ASIA = "asia"

// Liquidity pool limits (simple fixed values)
LIQUIDITY_POOL_MAX_ENTRIES = 360      // Max sessions stored per pool (~18 months for daily)

// Liquidity detection scan caps (simple fixed limits)
DAILY_LIQUIDITY_SCAN_CAP = 100        // Scan last 100 daily sessions (~3-4 months)
WEEKLY_LIQUIDITY_SCAN_CAP = 50        // Scan last 50 weekly sessions (~1 year)
MONTHLY_LIQUIDITY_SCAN_CAP = 30       // Scan last 30 monthly sessions (~2.5 years)
ASIA_LIQUIDITY_SCAN_CAP = 50          // Scan last 50 Asia sessions (~10 weeks)

// Timeframe restrictions for liquidity pools (in minutes)
MIN_TF_DAILY_LIQUIDITY = 60           // Daily: show on 1H+ (timeframe must be >= 60m)
MIN_TF_WEEKLY_LIQUIDITY = 60          // Weekly: show on 1H+ (timeframe must be >= 60m)
MIN_TF_MONTHLY_LIQUIDITY = 240        // Monthly: show on 4H+ (timeframe must be >= 240m)
MAX_TF_ASIA_LIQUIDITY = 15            // Asia: show on 15m and below (timeframe must be <= 15m)

// Intraday session defaults (all times in NY timezone)
DEFAULT_ASIA_SESSION_TIME = "2000-0000:23456"  // 8pm-12am NY, Mon-Sat (crosses midnight)

DEFAULT_DAILY_LIQUIDITY_LINE_WIDTH = 1
NY_TIMEZONE = "America/New_York"
SUNDAY_REOPEN_START_HOUR = 18

// Alert system constants
ALERT_MODE_INDIVIDUAL = "Individual Alerts"
ALERT_MODE_GROUPED = "Grouped Alerts"
ALERT_MODE_BOTH = "Both"

// MBZ subtype constants (used for wick pattern detection)
SUBTYPE_STANDARD = "standard"
SUBTYPE_INCLUSION = "inclusion"
SUBTYPE_REFLECTION = "reflection"
SUBTYPE_INCLUSION_TIE = "inclusion-tie"
SUBTYPE_REFLECTION_TIE = "reflection-tie"

// Wick Tier Constants
WICK_TIER_STANDARD = "standard"
WICK_TIER_RELAXED = "relaxed"
WICK_TIER_RISKY = "risky"
WICK_TIER_NONE = "none"
WICK_DOMINANCE_STANDARD_THRESHOLD = 1.0
WICK_DOMINANCE_RELAXED_THRESHOLD = 0.85
WICK_DOMINANCE_RISKY_THRESHOLD = 0.80




// MBZ Invalidation Mode Constants
INVALIDATION_STANDARD = "Standard (100%)"
INVALIDATION_STRICT = "Strict (85%)"
INVALIDATION_CUSTOM = "Custom"

// Extension Mode Constants
EXTENSION_FIXED = "Fixed Length"
EXTENSION_TO_CURRENT = "To Current Price"
EXTENSION_BEYOND_CURRENT = "Beyond Current Price"

// Breach Method Constants
BREACH_METHOD_TRADE_THROUGH = "Trade Through"
BREACH_METHOD_BODY_BREACH = "Body Breach"

// ═══════════════════════════════════════════════════════════════════════════════
// PERFORMANCE & THRESHOLD CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

// Array Size Limits (Optimized through performance testing)
MAX_MBZ_RECORDS = 60  // Liquidity MBZ capacity
MAX_BODY_HIGHLIGHTS = 75
MAX_WICK_HIGHLIGHTS = 75
MAX_EXTENDED_BOXES = 75
MAX_PROJECTION_LINES = 200
MAX_PROJECTION_LABELS = 200

// Default Optimal Values (Based on observed performance)
DEFAULT_CUSTOM_THRESHOLD = 50.0

// Input Validation Constants
MIN_THRESHOLD_PERCENT = 1.0
MAX_THRESHOLD_PERCENT = 99.0
DEFAULT_STEP_SIZE = 0.1

// Liquidity Limits System Defaults
DEFAULT_MAX_LIQUIDITY_MBZS = 30  // Default liquidity quota
MAX_LIQUIDITY_MBZS_LIMIT = 60    // Max limit for liquidity MBZs
DEFAULT_MAX_INVALIDATED_MBZS = 5
MAX_INVALIDATED_MBZS_LIMIT = 15

// Invalidation Thresholds
STANDARD_INVALIDATION_PERCENT = 100.0
STRICT_INVALIDATION_PERCENT = 85.0

// Fibonacci-Based Projection Levels (Research-based optimal levels)
FIBONACCI_CENTER = 0.5
FIBONACCI_QUARTER_LOW = 0.25
FIBONACCI_QUARTER_HIGH = 0.75
FIBONACCI_STOP_125 = 1.25
FIBONACCI_STOP_150 = 1.5
FIBONACCI_STOP_200 = 2.0
FIBONACCI_TARGET_200 = -2.0
FIBONACCI_TARGET_250 = -2.5
FIBONACCI_TARGET_400 = -4.0
FIBONACCI_TARGET_450 = -4.5

// Additional Visual & Performance Constants
DEFAULT_BREACH_THRESHOLD = 25.0
TRANSPARENCY_LIGHT = 20
TRANSPARENCY_MEDIUM = 30
TRANSPARENCY_HEAVY = 40
TRANSPARENCY_BREACH_DEFAULT = 50
MAX_FADE_TRANSPARENCY = 95
MIN_BREACH_TRANSPARENCY_PERCENT = 10
MAX_BREACH_TRANSPARENCY_PERCENT = 90
MIN_LINE_TRANSPARENCY = 0
MAX_LINE_TRANSPARENCY = 90
MIN_BORDER_WIDTH = 1
MAX_BORDER_WIDTH = 5
LINE_WIDTH_THIN = 1
LINE_WIDTH_MEDIUM = 2
MIN_PROJECTION_LINE_WIDTH = 1
MAX_PROJECTION_LINE_WIDTH = 3
SUPER_MBZ_SCAN_LIMIT = 15
HISTORICAL_LOOKBACK_LIMIT = 75
MIN_BARS_SINCE_SOURCE_CREATION = 1

// Pine Script hard limit: bar_index references in drawing functions limited to ~500 bars from current bar
// Attempting to draw beyond this causes: "Bar index value too far from current bar index" error
// Impact varies by timeframe: 4m = 33 hours, 15m = 5 days, 1H = 21 days, 1D = 1.4 years
MAX_RENDERABLE_BAR_AGE = 500
ENABLE_HISTORICAL_BACKFILL = false
MBZ_BULLISH_SUFFIX = "⁺"
MBZ_BEARISH_SUFFIX = "⁻"
FIFTY_PERCENT_TAG = " [½]"
SUPER_PREFIX = "SUPER "
CHECKMARK_SYMBOL = "✔️ "
ARROW_UP_SYMBOL = "▲"
ARROW_DOWN_SYMBOL = "▼"
MULTI_SOURCE_STRENGTH_LABEL = "[STRONG]"
MULTI_SOURCE_STRENGTH_INCLUDE_DISTINCT = "Distinct Types"
MULTI_SOURCE_STRENGTH_INCLUDE_SAME = "Same Type"
DEFAULT_MULTI_SOURCE_STRENGTH_MIN_SOURCES = 2
MIN_MULTI_SOURCE_STRENGTH_MIN_SOURCES = 1
MAX_MULTI_SOURCE_STRENGTH_MIN_SOURCES = 20
MULTI_SOURCE_STRONG_DISPLAY_OFF = "Off"
MULTI_SOURCE_STRONG_DISPLAY_LABEL = "Label"
MULTI_SOURCE_STRONG_DISPLAY_EXTENSION = "Extension"
MULTI_SOURCE_STRONG_DISPLAY_BOTH = "Label + Extension"
DEFAULT_MULTI_SOURCE_BORDER_WIDTH = 2
MIN_MULTI_SOURCE_ALERT_COUNT = 2

// Visual & Input Defaults (parity with SIF)
DEFAULT_EXTENSION_BARS = 10
MAX_EXTENSION_BARS = 50
MIN_EXTENSION_BARS = 1
DEFAULT_SOURCE_DISPLAYS = 10  // Base for Optimized mode (scales to 40/80/120 in Boost/Ultra/Ultra Pro)
MIN_SOURCE_DISPLAYS = 1
MAX_SOURCE_DISPLAYS = 50
DEFAULT_PROJECT_LAST_N = 3
MIN_PROJECT_LAST_N = 1
MAX_PROJECT_LAST_N = 20
DEFAULT_PROJECTION_BARS = 20
MIN_PROJECTION_BARS = 5
MAX_PROJECTION_BARS = 100
PROJECTION_LABEL_OFFSET_BARS = 1
REFLECTION_LABEL_SPACING_MULTIPLIER = 0.8  // Tested value - prevents label collision with reflection extension boxes
WEEKLY_LABEL_OFFSET_MULTIPLIER = 0.3  // Offset for weekly labels to avoid collision with daily labels
MONTHLY_LABEL_OFFSET_MULTIPLIER = 0.6  // Offset for monthly labels to avoid collision with daily and weekly labels

// Text size constants
TEXT_SIZE_TINY = 'Tiny'
TEXT_SIZE_SMALL = 'Small'
TEXT_SIZE_NORMAL = 'Normal'
TEXT_SIZE_LARGE = 'Large'

// Line style constants
LINE_STYLE_SOLID = 'Solid'
LINE_STYLE_DASHED = 'Dashed'
LINE_STYLE_DOTTED = 'Dotted'

// Display mode constants
DISPLAY_MODE_ARROW_ONLY = 'Arrow Only'
DISPLAY_MODE_TEXT_ONLY = 'Text Only'
DISPLAY_MODE_ARROW_TEXT = 'Arrow + Text'

// Label position constants
LABEL_POSITION_LEFT = 'Left'
LABEL_POSITION_RIGHT = 'Right'
LABEL_ALIGNMENT_LEFT = 'Left'
LABEL_ALIGNMENT_CENTER = 'Center'
LABEL_ALIGNMENT_RIGHT = 'Right'
LABEL_VERTICAL_TOP = 'Top'
LABEL_VERTICAL_CENTER = 'Center'
LABEL_VERTICAL_BOTTOM = 'Bottom'

// UI Group constants
GROUP_DETECTION = '🎯 Detection'
GROUP_INVALIDATION = '✋ Invalidation'
GROUP_VISIBILITY_FILTERS = '👁️ Visibility Filters'
GROUP_BREACH_DETECTION = '🚨 Breach Detection'
GROUP_ALERT_SETTINGS = '🚨 Alert Settings'
GROUP_MBZ_LABELLING = '🎨 MBZ Labelling (Type, Size & Color)'
GROUP_MBZ_EXTENSION = '✨ MBZ Extension'
GROUP_MBZ_BEHAVIORS = '🎭 MBZ Wick Behaviors'
GROUP_MBZ_ANALYSIS = '🔍 MBZ Analysis'
GROUP_MBZ_SPECIAL_PROPERTIES = '🏷️ MBZ Special Properties'
GROUP_WICK_ANALYSIS = '⭐ Wick-to-Body Ratio Analysis'
GROUP_SOURCE_ORIGINS = '📦 Source Origins'
GROUP_LIQUIDITY_SOURCE_TYPES = '💧 Liquidity Source Types'
GROUP_LIQUIDITY_RULES = '💧 Liquidity Formation Variants'
GROUP_PROJECTIONS = '📈 Projections'
GROUP_PERFORMANCE_PROFILING = '⚡ Performance Profiling'

// Display text & abbreviation constants
INCLUSION_ABBREVIATION = "inc"
REFLECTION_ABBREVIATION = "ref"
ARROW_DOWN_INC = "↓inc"
ARROW_UP_INC = "↑inc"
ARROW_UP_REF = "↑ref"
ARROW_DOWN_REF = "↓ref"
ARROW_DOWN_INC_RISKY = "↓inc*"
ARROW_UP_INC_RISKY = "↑inc*"
ARROW_UP_REF_RISKY = "↑ref*"
ARROW_DOWN_REF_RISKY = "↓ref*"

// Source label text constants
MULTIPLIER_SYMBOL = "×"
COUNT_SEPARATOR = ": "
BREAKDOWN_SEPARATOR = ", "
// See docs: indicators/mbz/docs/mbz-dual-alert-system.md (Label structure, tooltips, extensions)
SUBTYPE_INCLUSION_FULL = "Inclusion"
SUBTYPE_REFLECTION_FULL = "Reflection"
DIRECTION_BULLISH = "bullish"
DIRECTION_BEARISH = "bearish"
BREACH_STATUS_LABEL = "[BREACHED]"
BREACH_STATUS_TEXT = " - BREACHED "
BREACH_STATUS_SUFFIX = "% (unconfirmed)"

// Input label constants
INPUT_LABEL_VALID_MBZ = 'Valid MBZ'
INPUT_LABEL_INVALIDATED_MBZ = 'Invalidated MBZ'
INPUT_LABEL_STAR_SIZE = 'Star Size'
INPUT_LABEL_SIZE = 'Size'
INPUT_LABEL_LABEL = 'Label'
INPUT_LABEL_MAX_LIQUIDITY_MBZS = 'Max Liquidity'
INPUT_LABEL_MAX_INVALIDATED_MBZS = 'Max Invalidated MBZs'
INPUT_LABEL_INVALIDATION_THRESHOLD = 'Invalidation Threshold'
INPUT_LABEL_CUSTOM_PERCENT = 'Custom %'
INPUT_LABEL_SHOW_MBZ_PLUS = 'Show MBZ⁺'
INPUT_LABEL_SHOW_MBZ_MINUS = 'Show MBZ⁻'
INPUT_LABEL_ENABLE_BREACH_DETECTION = 'Enable Breach Detection'
INPUT_LABEL_METHOD = 'Method'
INPUT_LABEL_THRESHOLD_PERCENT = 'Threshold %'
INPUT_LABEL_BREACHED_TEXT_COLOR = 'Breached Text Color'
INPUT_LABEL_FADE_EXTENSION_BOX = 'Fade Extension Box on Breach'
INPUT_LABEL_OPACITY_PERCENT = 'Opacity%'
INPUT_LABEL_ALTERNATIVE_TEXT = 'Enable Alternative Text'
INPUT_LABEL_BREACH_LINES = 'Breach'
INPUT_LABEL_INVALIDATION_LINES = 'Invalidation'
INPUT_LABEL_LABEL_STYLE = 'Label Style'
INPUT_LABEL_MBZ_PLUS = 'MBZ⁺'
INPUT_LABEL_MBZ_MINUS = 'MBZ⁻'
INPUT_LABEL_INVALIDATED = 'Invalidated'
INPUT_LABEL_ENABLE_LABELS = 'Enable Labels on MBZ Candles'
INPUT_LABEL_ENABLE_EXTENSION = 'Enable Extension'
INPUT_LABEL_EXTENSION_MODE = 'Extension Mode'
INPUT_LABEL_NO_OF_BARS = 'No. of Bars'
INPUT_LABEL_BOX = 'Box'
INPUT_LABEL_MAX_BOXES = 'Max Boxes'
INPUT_LABEL_ENABLE_SOURCE_BOXES = 'Show Source Boxes'
INPUT_LABEL_MULTI_SOURCE_STRENGTH_MIN = 'Min Source Gaps'
INPUT_LABEL_PROJECT_LAST_N = 'Project Last N'
INPUT_LABEL_ENABLE_PROJECTIONS = 'Enable Projections'
INPUT_LABEL_LINE_WIDTH = 'Line Width'
INPUT_LABEL_LINE_STYLE = 'Line Style'
INPUT_LABEL_VARIANT_MODE = 'Variant Mode'
INPUT_LABEL_LABEL_SIDE = 'Label Side'
INPUT_LABEL_BOUNDARIES = 'Boundaries'
INPUT_LABEL_QUADRANTS = 'Quadrants'
INPUT_LABEL_STOPS = 'Stops'
INPUT_LABEL_TARGETS = 'Targets'
INPUT_LABEL_CUSTOM_LEVELS = 'Custom Levels'
INPUT_LABEL_CUSTOM_LIST = 'Custom List'
INPUT_LABEL_CE = 'CE'
MBZ_BASE_TEXT = "MBZ"
DIRECTION_BULLISH_DISPLAY = "Bullish"
DIRECTION_BEARISH_DISPLAY = "Bearish"

// MBZ-specific string constants - Generic & Reusable
MBZ_PLUS = "MBZ⁺"
MBZ_MINUS = "MBZ⁻"

// Alert title constants
ALERT_TITLE_NESTED_MBZ_PLUS = "Nested MBZ⁺"
ALERT_TITLE_NESTED_MBZ_MINUS = "Nested MBZ⁻"
ALERT_TITLE_MULTI_SOURCE_MBZ_PLUS = "Multi-Source MBZ⁺"
ALERT_TITLE_MULTI_SOURCE_MBZ_MINUS = "Multi-Source MBZ⁻"
ALERT_TITLE_STRONG_MBZ_PLUS = "Strong MBZ⁺"
ALERT_TITLE_STRONG_MBZ_MINUS = "Strong MBZ⁻"

// Grouped alert message constants
ALERT_MSG_MBZ_PLUS_FORMED = "MBZ⁺"
ALERT_MSG_MBZ_MINUS_FORMED = "MBZ⁻"
ALERT_MSG_NESTED_MBZ_PLUS = "Nested MBZ⁺"
ALERT_MSG_NESTED_MBZ_MINUS = "Nested MBZ⁻"
ALERT_MSG_MULTI_SOURCE_MBZ_PLUS = "Multi-Source MBZ⁺"
ALERT_MSG_MULTI_SOURCE_MBZ_MINUS = "Multi-Source MBZ⁻"
ALERT_MSG_STRONG_MBZ_PLUS = "Strong MBZ⁺"
ALERT_MSG_STRONG_MBZ_MINUS = "Strong MBZ⁻"
ALERT_PREFIX_GROUPED = ""

// Repeated string constants
ALERT_TOOLTIP_PREFIX = "Grouped only: Include "
ALERT_TOOLTIP_SUFFIX = " alerts in grouped alert"
ALERT_MESSAGE_SUFFIX = " • {{interval}}"
ALERT_MESSAGE_AT_SUFFIX = " • {{interval}}"
WICK_TIER_STANDARD_DISPLAY = "Standard"
EMPTY_DISPLAY = ""

// ═══════════════════════════════════════════════════════════════════════════════
// INPUT SETTINGS - ULTRA-COMPACT ALIGNED LAYOUT
// ═══════════════════════════════════════════════════════════════════════════════

// === 🎯 DETECTION ===
max_liquidity_mbzs = input.int(DEFAULT_MAX_LIQUIDITY_MBZS, INPUT_LABEL_MAX_LIQUIDITY_MBZS, minval=0, maxval=MAX_LIQUIDITY_MBZS_LIMIT, group=GROUP_DETECTION, inline='quotas', tooltip='Maximum liquidity MBZs on chart (0-60)')

// === ✋ INVALIDATION ===
show_invalidated_mbzs = input.bool(false, 'Show Invalidated MBZs', group=GROUP_INVALIDATION, inline='inv1', tooltip='Show invalidated (breached) MBZs with labels and zones')
max_invalidated_mbzs = input.int(DEFAULT_MAX_INVALIDATED_MBZS, 'Max', minval=0, maxval=MAX_INVALIDATED_MBZS_LIMIT, group=GROUP_INVALIDATION, inline='inv1', tooltip='Maximum number of invalidated MBZs to show (0-15 limit)')
mbz_invalidation_mode = input.string(INVALIDATION_STANDARD, 'Threshold', options=[INVALIDATION_STANDARD, INVALIDATION_STRICT, INVALIDATION_CUSTOM], group=GROUP_INVALIDATION, inline='inv2', tooltip='Zone fill threshold for invalidation (requires candle close)\n• Standard: 100% fill\n• Strict: 85% fill\n• Custom: set your own percentage')
custom_threshold_percent = input.float(DEFAULT_CUSTOM_THRESHOLD, 'Custom %', minval=MIN_THRESHOLD_PERCENT, maxval=MAX_THRESHOLD_PERCENT, step=DEFAULT_STEP_SIZE, group=GROUP_INVALIDATION, inline='inv2', tooltip='Custom invalidation threshold (1-99%). Used only when Custom mode is selected.')

// Set variant mode (liquidity only)
mbz_variant_mode = VARIANT_LIQUIDITY

// === 👁️ VISIBILITY FILTERS ===
show_bullish_mbzs = input.bool(true, INPUT_LABEL_SHOW_MBZ_PLUS, group=GROUP_VISIBILITY_FILTERS, inline='dir1', tooltip='Display MBZ⁺ zones and labels')
show_bearish_mbzs = input.bool(true, INPUT_LABEL_SHOW_MBZ_MINUS, group=GROUP_VISIBILITY_FILTERS, inline='dir1', tooltip='Display MBZ⁻ zones and labels')

// === 💧 LIQUIDITY SOURCE TYPES ===
enable_daily_liquidity = input.bool(true, 'Daily Highs/Lows', group=GROUP_LIQUIDITY_SOURCE_TYPES, inline='liq_types1', tooltip='Detect MBZs from daily session high/low breaches')
include_daily_liquidity_sunday = input.bool(true, 'Include Sunday Evening (18:00-00:00)', group=GROUP_LIQUIDITY_SOURCE_TYPES, tooltip='Include Sunday 18:00-00:00 NY time as part of daily liquidity sessions')
enable_weekly_liquidity = input.bool(true, 'Weekly Highs/Lows', group=GROUP_LIQUIDITY_SOURCE_TYPES, inline='liq_types2', tooltip='Detect MBZs from weekly session high/low breaches')
enable_monthly_liquidity = input.bool(true, 'Monthly Highs/Lows', group=GROUP_LIQUIDITY_SOURCE_TYPES, inline='liq_types3', tooltip='Detect MBZs from monthly session high/low breaches')

// Intraday session liquidity (only visible on 15m and lower timeframes)
enable_asia_liquidity = input.bool(true, 'Asia Session', group=GROUP_LIQUIDITY_SOURCE_TYPES, inline='liq_asia', tooltip='Detect MBZs from Asia session high/low breaches (only on 15m or lower timeframes)')
asia_session_time = input.session(DEFAULT_ASIA_SESSION_TIME, 'Time', group=GROUP_LIQUIDITY_SOURCE_TYPES, inline='liq_asia', tooltip='Asia session time range in NY timezone (default: 2000-0000 = 8pm-12am)')

// === 💧 LIQUIDITY FORMATION VARIANTS ===
enable_liquidity_immediate = input.bool(true, 'Immediate', group=GROUP_LIQUIDITY_RULES, inline='liq_rules')
enable_liquidity_standard = input.bool(true, 'Standard', group=GROUP_LIQUIDITY_RULES, inline='liq_rules')
enable_liquidity_delayed = input.bool(true, 'Delayed', group=GROUP_LIQUIDITY_RULES, inline='liq_rules', tooltip='LIQUIDITY FORMATION VARIANTS:\n\n• Immediate: First touch of pool produces same-bar rejection (current bar sweep)\n• Standard: Previous bar swept pool, current bar respects original extreme (no new high/low)\n• Delayed: Sweep closes beyond pool, next bar re-enters (delayed confirmation)')

liquidity_detection_enabled = enable_liquidity_immediate or enable_liquidity_standard or enable_liquidity_delayed

// === 📦 SOURCE ORIGINS ===
show_source_origins = input.bool(false, 'Show Source Origins', group=GROUP_SOURCE_ORIGINS, inline='src1', tooltip='Display visual markers at origin points where MBZs were created (liquidity sources show as lines). Only displays origins for currently visible MBZs (excludes invalidated when Show Invalidated is off). Auto-deduplicates: one visual per unique source even if multiple MBZs share it')
max_source_displays = input.int(DEFAULT_SOURCE_DISPLAYS, 'Max Origins', minval=MIN_SOURCE_DISPLAYS, maxval=MAX_SOURCE_DISPLAYS, group=GROUP_SOURCE_ORIGINS, inline='src1', tooltip='Maximum combined source origins to display on chart (liquidity lines). Automatically scales with Capacity Mode: Base=10, Boost=40, Ultra=80, Ultra Pro=120. Higher values recommended with extended liquidity scan depth.')
source_label_size = input.string(TEXT_SIZE_TINY, 'Label Size', options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_SOURCE_ORIGINS, inline='src2', tooltip='Text size for labels on liquidity lines')
show_daily_liquidity_lines = input.bool(true, 'Daily Lines', group=GROUP_SOURCE_ORIGINS, inline='src3', tooltip='Show daily liquidity pool level lines (horizontal lines at daily highs/lows that spawned MBZs)')
daily_liquidity_color = input.color(color.new(color.purple, 0), 'Color', group=GROUP_SOURCE_ORIGINS, inline='src4', tooltip='Line color for daily liquidity pool levels')
daily_liquidity_line_width = input.int(2, 'Width', minval=MIN_BORDER_WIDTH, maxval=MAX_BORDER_WIDTH, group=GROUP_SOURCE_ORIGINS, inline='src4', tooltip='Line thickness for daily liquidity pool level lines')
show_daily_liquidity_labels = input.bool(true, 'Labels', group=GROUP_SOURCE_ORIGINS, inline='src4', tooltip='Show date labels on daily liquidity pool lines (e.g., "Daily Mon 9/22")')
show_weekly_liquidity_lines = input.bool(true, 'Weekly Lines', group=GROUP_SOURCE_ORIGINS, inline='src5', tooltip='Show weekly liquidity pool level lines (horizontal lines at weekly highs/lows that spawned MBZs)')
weekly_liquidity_color = input.color(color.new(#ec407a, 0), 'Color', group=GROUP_SOURCE_ORIGINS, inline='src5', tooltip='Line color for weekly liquidity pool levels')
weekly_liquidity_line_width = input.int(3, 'Width', minval=MIN_BORDER_WIDTH, maxval=MAX_BORDER_WIDTH, group=GROUP_SOURCE_ORIGINS, inline='src5', tooltip='Line thickness for weekly liquidity pool level lines')
show_weekly_liquidity_labels = input.bool(true, 'Labels', group=GROUP_SOURCE_ORIGINS, inline='src5', tooltip='Show date labels on weekly liquidity pool lines (e.g., "Weekly 8/19-8/25")')
show_monthly_liquidity_lines = input.bool(true, 'Monthly Lines', group=GROUP_SOURCE_ORIGINS, inline='src6', tooltip='Show monthly liquidity pool level lines (horizontal lines at monthly highs/lows that spawned MBZs)')
monthly_liquidity_color = input.color(color.new(#ff9800, 0), 'Color', group=GROUP_SOURCE_ORIGINS, inline='src6', tooltip='Line color for monthly liquidity pool levels')
monthly_liquidity_line_width = input.int(4, 'Width', minval=MIN_BORDER_WIDTH, maxval=MAX_BORDER_WIDTH, group=GROUP_SOURCE_ORIGINS, inline='src6', tooltip='Line thickness for monthly liquidity pool level lines')
show_monthly_liquidity_labels = input.bool(true, 'Labels', group=GROUP_SOURCE_ORIGINS, inline='src6', tooltip='Show date labels on monthly liquidity pool lines (e.g., "Monthly Sep 2024")')
show_asia_liquidity_lines = input.bool(true, 'Asia Lines', group=GROUP_SOURCE_ORIGINS, inline='src7', tooltip='Show Asia session liquidity pool level lines (horizontal lines at Asia session highs/lows that spawned MBZs)')
asia_liquidity_color = input.color(color.new(#00bcd4, 0), 'Color', group=GROUP_SOURCE_ORIGINS, inline='src7', tooltip='Line color for Asia session liquidity pool levels')
asia_liquidity_line_width = input.int(1, 'Width', minval=MIN_BORDER_WIDTH, maxval=MAX_BORDER_WIDTH, group=GROUP_SOURCE_ORIGINS, inline='src7', tooltip='Line thickness for Asia session liquidity pool level lines')
show_asia_liquidity_labels = input.bool(true, 'Labels', group=GROUP_SOURCE_ORIGINS, inline='src7', tooltip='Show date/time labels on Asia session liquidity pool lines')
// Note: Imbalance boxes always shown when Source Origins enabled (core source visualization)

// === 🎨 MBZ LABELLING (TYPE, SIZE & COLOR)===
mbz_symbol_type = input.string(DISPLAY_MODE_ARROW_TEXT, INPUT_LABEL_LABEL_STYLE, options=[DISPLAY_MODE_ARROW_ONLY, DISPLAY_MODE_TEXT_ONLY, DISPLAY_MODE_ARROW_TEXT], group=GROUP_MBZ_LABELLING, inline='mbz2', tooltip='What to display on MBZ candles')
mbz_label_size = input.string(TEXT_SIZE_TINY, INPUT_LABEL_VALID_MBZ, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_MBZ_LABELLING, inline='mbz1', tooltip='Size of valid MBZ labels')
mbz_invalidated_size = input.string(TEXT_SIZE_TINY, INPUT_LABEL_INVALIDATED_MBZ, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_MBZ_LABELLING, inline='mbz1', tooltip='Size of invalidated MBZ labels')
mbz_bullish_color = input.color(color.green, INPUT_LABEL_MBZ_PLUS, group=GROUP_MBZ_LABELLING, inline='mbz2', tooltip='Color for MBZ⁺ labels')
mbz_bearish_color = input.color(color.red, INPUT_LABEL_MBZ_MINUS, group=GROUP_MBZ_LABELLING, inline='mbz2', tooltip='Color for MBZ⁻ labels')
mbz_invalidated_color = input.color(color.gray, INPUT_LABEL_INVALIDATED, group=GROUP_MBZ_LABELLING, inline='mbz2', tooltip='Color for invalidated MBZ labels')
show_mbz_labels = input.bool(true, INPUT_LABEL_ENABLE_LABELS, group=GROUP_MBZ_LABELLING, inline='mbz3', tooltip='Show MBZ arrow/text labels on candles\n\nNote: Arrow direction also points toward the source region that created the MBZ')
show_enhanced_label_details = input.bool(true, 'Show Enhanced Label Details', group=GROUP_MBZ_LABELLING, inline='mbz4', tooltip='Display detailed source types and behaviors in MBZ labels\n\nOFF: Clean labels (MBZ⁺, MBZ⁻)\nON: Enhanced labels (MBZ⁺ (imp) ↓inc)')

// === ✨ MBZ EXTENSION ===
extended_box_bullish_color = input.color(color.new(color.green, 85), INPUT_LABEL_MBZ_PLUS, group=GROUP_MBZ_EXTENSION, inline='ext1', tooltip='Color for MBZ⁺ highlights and extensions')
extended_box_bearish_color = input.color(color.new(color.red, 85), INPUT_LABEL_MBZ_MINUS, group=GROUP_MBZ_EXTENSION, inline='ext1', tooltip='Color for MBZ⁻ highlights and extensions')
show_extended_boxes = input.bool(true, INPUT_LABEL_ENABLE_EXTENSION, group=GROUP_MBZ_EXTENSION, inline='ext1', tooltip='Show highlights and extensions for valid MBZs')
extension_mode = input.string(EXTENSION_FIXED, INPUT_LABEL_EXTENSION_MODE, options=[EXTENSION_FIXED, EXTENSION_TO_CURRENT, EXTENSION_BEYOND_CURRENT], group=GROUP_MBZ_EXTENSION, inline='ext_mode', tooltip='Extension behavior:\n• Fixed Length: extend N bars from formation\n• To Current Price: extend at least to current bar (prevents shrinking)\n• Beyond Current Price: extend N bars beyond current bar (real-time)')
extended_box_text_size = input.string(TEXT_SIZE_TINY, INPUT_LABEL_LABEL, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_MBZ_EXTENSION, inline='ext2', tooltip='Text size for extension boxes')
extended_box_text_color = input.color(color.black, INPUT_LABEL_LABEL, group=GROUP_MBZ_EXTENSION, inline='ext2', tooltip='Text color for extension boxes')
extension_label_horizontal_alignment = input.string(LABEL_ALIGNMENT_RIGHT, 'Horizontal', options=[LABEL_ALIGNMENT_LEFT, LABEL_ALIGNMENT_CENTER, LABEL_ALIGNMENT_RIGHT], group=GROUP_MBZ_EXTENSION, inline='ext_align', tooltip='Horizontal alignment for extension box text')
extension_label_vertical_alignment = input.string(LABEL_VERTICAL_CENTER, 'Vertical', options=[LABEL_VERTICAL_TOP, LABEL_VERTICAL_CENTER, LABEL_VERTICAL_BOTTOM], group=GROUP_MBZ_EXTENSION, inline='ext_align', tooltip='Vertical alignment for extension box text')
extended_box_length = input.int(DEFAULT_EXTENSION_BARS, INPUT_LABEL_NO_OF_BARS, minval=MIN_EXTENSION_BARS, maxval=MAX_EXTENSION_BARS, group=GROUP_MBZ_EXTENSION, inline='ext_mode', tooltip='Number of bars for extension (1-50 limit, meaning changes based on Extension Mode selected)')

// === 🎭 MBZ WICK BEHAVIORS ===
enable_inclusion = input.bool(true, 'Inclusion', group=GROUP_MBZ_BEHAVIORS, inline='behaviors', tooltip='MBZ WICK BEHAVIORS:\n• Inclusion: Wick toward body direction (bullish=lower wick, bearish=upper wick)\n• Reflection: Wick away from body direction (bullish=upper wick, bearish=lower wick)\n\nThese determine MBZ subtype based on dominant wick direction relative to candle body')
enable_reflection = input.bool(true, 'Reflection', group=GROUP_MBZ_BEHAVIORS, inline='behaviors', tooltip='MBZ BEHAVIORS:\n• Inclusion: Wick toward body direction (bullish=lower wick, bearish=upper wick)\n• Reflection: Wick away from body direction (bullish=upper wick, bearish=lower wick)')

// === 🏷️ MBZ SPECIAL PROPERTIES ===
enable_super_mbzs = input.bool(true, 'Mark Nested MBZs', group=GROUP_MBZ_SPECIAL_PROPERTIES, inline='nested', tooltip='Mark MBZs that overlap with other same-direction MBZs using ✔️ checkmark')
enable_wick_dominance_markers = input.bool(false, 'Mark Wick-Dominant MBZs', group=GROUP_MBZ_SPECIAL_PROPERTIES, inline='wick1', tooltip='Mark MBZs where the wick is significantly larger than the body with colored stars')
standard_star_color = input.color(color.blue, 'Standard', group=GROUP_MBZ_SPECIAL_PROPERTIES, inline='wick2', tooltip='Standard ≥100% wick-to-body ratio | Relaxed ≥85% | Risky ≥80%')
relaxed_star_color = input.color(color.black, 'Relaxed', group=GROUP_MBZ_SPECIAL_PROPERTIES, inline='wick2', tooltip='Relaxed wick dominance threshold')
risky_star_color = input.color(color.orange, 'Risky', group=GROUP_MBZ_SPECIAL_PROPERTIES, inline='wick2', tooltip='Risky wick dominance threshold')
wick_star_size = input.string(TEXT_SIZE_TINY, INPUT_LABEL_STAR_SIZE, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_MBZ_SPECIAL_PROPERTIES, inline='wick1', tooltip='Size of wick dominance stars')
enable_multi_source_highlighting = input.bool(true, "Show Multi-Source MBZ Borders", group=GROUP_MBZ_SPECIAL_PROPERTIES, inline='multi', tooltip='Display enhanced borders around MBZs formed from multiple liquidity source origins for visual distinction')
multi_source_border_color = input.color(color.new(color.orange, 0), "Color", group=GROUP_MBZ_SPECIAL_PROPERTIES, inline='multi', tooltip='Border color for multi-source MBZ highlighting')
multi_source_border_width = input.int(DEFAULT_MULTI_SOURCE_BORDER_WIDTH, "Width", minval=MIN_BORDER_WIDTH, maxval=MAX_BORDER_WIDTH, group=GROUP_MBZ_SPECIAL_PROPERTIES, inline='multi', tooltip='Border width for MBZs formed from multiple liquidity source origins (1-5px limit)')
multi_source_strong_display_mode = input.string(MULTI_SOURCE_STRONG_DISPLAY_BOTH, 'Strength Tag', options=[MULTI_SOURCE_STRONG_DISPLAY_OFF, MULTI_SOURCE_STRONG_DISPLAY_LABEL, MULTI_SOURCE_STRONG_DISPLAY_EXTENSION, MULTI_SOURCE_STRONG_DISPLAY_BOTH], group=GROUP_MBZ_SPECIAL_PROPERTIES, inline='multi_strong_toggle', tooltip='Where to show the [STRONG] marker when the consolidated zone meets the multi-source strength criteria. Extension placement renders above the main label when enabled.')
multi_source_strong_min_sources = input.int(DEFAULT_MULTI_SOURCE_STRENGTH_MIN_SOURCES, 'Min Sources', minval=MIN_MULTI_SOURCE_STRENGTH_MIN_SOURCES, maxval=MAX_MULTI_SOURCE_STRENGTH_MIN_SOURCES, group=GROUP_MBZ_SPECIAL_PROPERTIES, inline='multi_strong_logic', tooltip='Minimum number of MBZ source regions consolidated on the candle before [STRONG] is applied.')
multi_source_strong_include_distinct = input.bool(true, 'Distinct Types', group=GROUP_MBZ_SPECIAL_PROPERTIES, inline='multi_strong_logic', tooltip='Mark [STRONG] when the consolidated MBZ blends different liquidity source types (e.g., daily + weekly).')
multi_source_strong_include_same = input.bool(false, 'Same Type', group=GROUP_MBZ_SPECIAL_PROPERTIES, inline='multi_strong_logic', tooltip='Mark [STRONG] when the consolidated MBZ is built from the same source type repeated (e.g., daily×2).')
show_50_percent_tags = input.bool(true, 'Mark 50% Formation MBZs', group=GROUP_MBZ_SPECIAL_PROPERTIES, inline='fifty', tooltip='Add [½] tag when MBZ forms at exactly 50% of mitigation candle')
// Always confirm on midpoint close (at or beyond 50%) - detecting exactly 50% automatically marked with [½]
confirm_on_midpoint_close = true
allow_standard_extreme_equality = input.bool(false, "Standard: allow B = A's extreme", group=GROUP_MBZ_SPECIAL_PROPERTIES, inline='std_eq', tooltip='Relax the Standard liquidity rule so the confirming bar can match (not exceed) the initial sweep extreme.')

// === 🚨 BREACH DETECTION ===
// Core Settings
enable_breach_detection = input.bool(false, INPUT_LABEL_ENABLE_BREACH_DETECTION, group=GROUP_BREACH_DETECTION, inline='core', tooltip='Enable breach detection system - monitors when price enters MBZ zones before invalidation')
breach_method = input.string(BREACH_METHOD_TRADE_THROUGH, INPUT_LABEL_METHOD, options=[BREACH_METHOD_TRADE_THROUGH, BREACH_METHOD_BODY_BREACH], group=GROUP_BREACH_DETECTION, inline='core', tooltip='Trade Through: Any price movement into zone (wicks + bodies)\nBody Breach: Only when candle body (open/close) enters zone')
breach_threshold_percent = input.float(DEFAULT_BREACH_THRESHOLD, INPUT_LABEL_THRESHOLD_PERCENT, minval=MIN_THRESHOLD_PERCENT, maxval=MAX_THRESHOLD_PERCENT, step=1.0, group=GROUP_BREACH_DETECTION, inline='core', tooltip='Percentage of zone that must be penetrated to trigger breach detection (1-99%)')

// Visual Response
enable_zone_fade = input.bool(true, INPUT_LABEL_FADE_EXTENSION_BOX, group=GROUP_BREACH_DETECTION, inline='visual1', tooltip='Reduce extension box opacity when breach occurs')
breach_transparency_percent = input.int(TRANSPARENCY_BREACH_DEFAULT, INPUT_LABEL_OPACITY_PERCENT, minval=MIN_BREACH_TRANSPARENCY_PERCENT, maxval=MAX_BREACH_TRANSPARENCY_PERCENT, group=GROUP_BREACH_DETECTION, inline='visual1', tooltip='Extension box transparency level after breach (10-90%)')
enable_text_color_change = input.bool(true, INPUT_LABEL_ALTERNATIVE_TEXT, group=GROUP_BREACH_DETECTION, inline='visual2', tooltip='Change label text color when breach occurs')
breach_label_color = input.color(color.new(color.red, TRANSPARENCY_LIGHT), INPUT_LABEL_BREACHED_TEXT_COLOR, group=GROUP_BREACH_DETECTION, inline='visual2', tooltip='Text color for breached MBZ labels')

// Breach Lines
enable_breached_lines = input.bool(false, INPUT_LABEL_BREACH_LINES, group=GROUP_BREACH_DETECTION, inline='breach')
breached_line_color = input.color(color.new(color.red, TRANSPARENCY_LIGHT), '', group=GROUP_BREACH_DETECTION, inline='breach')
breached_line_style = input.string(LINE_STYLE_DASHED, '', options=[LINE_STYLE_SOLID, LINE_STYLE_DASHED, LINE_STYLE_DOTTED], group=GROUP_BREACH_DETECTION, inline='breach')
breached_line_width = input.int(LINE_WIDTH_THIN, '', minval=MIN_BORDER_WIDTH, maxval=MAX_BORDER_WIDTH, group=GROUP_BREACH_DETECTION, inline='breach')
breached_line_transparency = input.int(TRANSPARENCY_LIGHT, '', minval=MIN_LINE_TRANSPARENCY, maxval=MAX_LINE_TRANSPARENCY, group=GROUP_BREACH_DETECTION, inline='breach')

// Invalidation Lines
enable_invalidation_lines = input.bool(false, INPUT_LABEL_INVALIDATION_LINES, group=GROUP_BREACH_DETECTION, inline='invalidation')
invalidation_line_color = input.color(color.new(color.gray, TRANSPARENCY_MEDIUM), '', group=GROUP_BREACH_DETECTION, inline='invalidation')
invalidation_line_style = input.string(LINE_STYLE_SOLID, '', options=[LINE_STYLE_SOLID, LINE_STYLE_DASHED, LINE_STYLE_DOTTED], group=GROUP_BREACH_DETECTION, inline='invalidation')
invalidation_line_width = input.int(LINE_WIDTH_MEDIUM, '', minval=MIN_BORDER_WIDTH, maxval=MAX_BORDER_WIDTH, group=GROUP_BREACH_DETECTION, inline='invalidation')
invalidation_line_transparency = input.int(TRANSPARENCY_HEAVY, '', minval=MIN_LINE_TRANSPARENCY, maxval=MAX_LINE_TRANSPARENCY, group=GROUP_BREACH_DETECTION, inline='invalidation', tooltip='BREACH DETECTION SUMMARY:\n• Core Settings: Enable system, choose detection method (Trade Through/Body Breach), set threshold %\n• Visual Response: Control extension box fading and label color changes on breach\n• Breach Lines: Add visual breach threshold lines with custom color/style/width/transparency\n• Invalidation Lines: Add visual invalidation threshold lines (separate from breach lines)\n\nNote: Breach occurs before invalidation - provides early warning system')

// === 📈 PROJECTIONS ===
project_last_n_mbzs = input.int(DEFAULT_PROJECT_LAST_N, INPUT_LABEL_PROJECT_LAST_N, minval=MIN_PROJECT_LAST_N, maxval=MAX_PROJECT_LAST_N, group=GROUP_PROJECTIONS, inline='proj1', tooltip='Projection settings\nProject Last N: number of recent valid MBZs to project. Max: 20\nEnable Projections: show projection lines from valid MBZs\nNo. of Bars: bars to extend projections')
show_mbz_projections = input.bool(false, INPUT_LABEL_ENABLE_PROJECTIONS, group=GROUP_PROJECTIONS, inline='proj1')
projection_extend_bars = input.int(DEFAULT_PROJECTION_BARS, INPUT_LABEL_NO_OF_BARS, minval=MIN_PROJECTION_BARS, maxval=MAX_PROJECTION_BARS, group=GROUP_PROJECTIONS, inline='proj1')
projection_line_width = input.int(LINE_WIDTH_THIN, INPUT_LABEL_LINE_WIDTH, minval=MIN_PROJECTION_LINE_WIDTH, maxval=MAX_PROJECTION_LINE_WIDTH, group=GROUP_PROJECTIONS, inline='proj2', tooltip='Projection line settings\nLine Width: thickness of projection lines. Max: 3\nLine Style: visual style of lines\nLabel Side: where to place level labels')
projection_line_style = input.string(LINE_STYLE_DOTTED, INPUT_LABEL_LINE_STYLE, options=[LINE_STYLE_SOLID, LINE_STYLE_DASHED, LINE_STYLE_DOTTED], group=GROUP_PROJECTIONS, inline='proj2')
projection_label_side = input.string(LABEL_POSITION_RIGHT, INPUT_LABEL_LABEL_SIDE, options=[LABEL_POSITION_LEFT, LABEL_POSITION_RIGHT], group=GROUP_PROJECTIONS, inline='proj2')

// Boundaries
show_boundaries = input.bool(true, INPUT_LABEL_BOUNDARIES, group=GROUP_PROJECTIONS, inline='levels1', tooltip='Show zone boundaries\nBoundaries: levels 0 (close) and 1 (open)\nLabel: color and text size for boundary labels')
boundary_color = input.color(color.black, INPUT_LABEL_LABEL, group=GROUP_PROJECTIONS, inline='levels1', tooltip='Color for boundary levels')
boundary_text_size = input.string(TEXT_SIZE_TINY, INPUT_LABEL_SIZE, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_PROJECTIONS, inline='levels1', tooltip='Text size for boundary labels')

// CE (50%)
show_ce = input.bool(false, INPUT_LABEL_CE, group=GROUP_PROJECTIONS, inline='levels1_5', tooltip='Show 50% center level\nCE: equilibrium level at 50%\nLabel: color and text size for center level')
ce_color = input.color(color.gray, INPUT_LABEL_LABEL, group=GROUP_PROJECTIONS, inline='levels1_5', tooltip='Color for 50% center level')
ce_text_size = input.string(TEXT_SIZE_TINY, INPUT_LABEL_SIZE, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_PROJECTIONS, inline='levels1_5', tooltip='Text size for 50% center label')

// Quadrants
show_quadrants = input.bool(false, INPUT_LABEL_QUADRANTS, group=GROUP_PROJECTIONS, inline='levels2', tooltip='Show quarter levels between boundaries\nQuadrants: 25% and 75% levels\nLabel: color and text size for quadrant levels')
quadrant_color = input.color(color.yellow, INPUT_LABEL_LABEL, group=GROUP_PROJECTIONS, inline='levels2', tooltip='Color for quadrant levels')
quadrant_text_size = input.string(TEXT_SIZE_TINY, INPUT_LABEL_SIZE, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_PROJECTIONS, inline='levels2', tooltip='Text size for quadrant labels')

// Stops
show_stops = input.bool(true, INPUT_LABEL_STOPS, group=GROUP_PROJECTIONS, inline='levels3', tooltip='Show stop levels beyond open\nStops: potential stop loss levels (1.25, 1.5, 2.0)\nLabel: color and text size for stop levels')
stop_color = input.color(color.red, INPUT_LABEL_LABEL, group=GROUP_PROJECTIONS, inline='levels3', tooltip='Color for stop levels')
stop_text_size = input.string(TEXT_SIZE_TINY, INPUT_LABEL_SIZE, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_PROJECTIONS, inline='levels3', tooltip='Text size for stop labels')

// Targets
show_targets = input.bool(true, INPUT_LABEL_TARGETS, group=GROUP_PROJECTIONS, inline='levels4', tooltip='Show target levels beyond close\nTargets: potential profit target levels (-2.0, -2.5, -4, -4.5)\nLabel: color and text size for target levels')
target_color = input.color(color.green, INPUT_LABEL_LABEL, group=GROUP_PROJECTIONS, inline='levels4', tooltip='Color for target levels')
target_text_size = input.string(TEXT_SIZE_TINY, INPUT_LABEL_SIZE, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_PROJECTIONS, inline='levels4', tooltip='Text size for target labels')

// Custom
show_custom = input.bool(false, INPUT_LABEL_CUSTOM_LEVELS, group=GROUP_PROJECTIONS, inline='levels5', tooltip='Use custom level list\nCustom Levels: enable custom projection levels\nCustom List: comma-separated values (e.g., 0, 1, 1.5, -2.33, -4)\nLabel: color and text size for custom level labels')
custom_levels_input = input.string('0, 1, 1.5, -2.33, -4', INPUT_LABEL_CUSTOM_LIST, group=GROUP_PROJECTIONS, inline='levels5', tooltip='Comma-separated levels for projections')
custom_text_size = input.string(TEXT_SIZE_TINY, INPUT_LABEL_SIZE, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_PROJECTIONS, inline='levels5', tooltip='Text size for custom labels')

// === 🚨 ALERT SETTINGS === (see docs for full behavior)
alert_mode = input.string(ALERT_MODE_GROUPED, "Alert Mode", options=[ALERT_MODE_INDIVIDUAL, ALERT_MODE_GROUPED, ALERT_MODE_BOTH], group=GROUP_ALERT_SETTINGS, tooltip="Individual: Create alerts per condition (select a specific condition)\nGrouped: Create ONE alert with 'Any alert() function call' (uses checkboxes below)\nBoth: Use both methods; may produce duplicate notifications")

enable_mbz_plus_formation = input.bool(true, MBZ_PLUS, group=GROUP_ALERT_SETTINGS, inline="core1", tooltip=ALERT_TOOLTIP_PREFIX + MBZ_PLUS + ALERT_TOOLTIP_SUFFIX)
enable_mbz_minus_formation = input.bool(true, MBZ_MINUS, group=GROUP_ALERT_SETTINGS, inline="core1", tooltip=ALERT_TOOLTIP_PREFIX + MBZ_MINUS + ALERT_TOOLTIP_SUFFIX)

enable_nested_mbz_plus_alert = input.bool(true, ALERT_TITLE_NESTED_MBZ_PLUS, group=GROUP_ALERT_SETTINGS, inline="special1", tooltip=ALERT_TOOLTIP_PREFIX + ALERT_TITLE_NESTED_MBZ_PLUS + ALERT_TOOLTIP_SUFFIX)
enable_nested_mbz_minus_alert = input.bool(true, ALERT_TITLE_NESTED_MBZ_MINUS, group=GROUP_ALERT_SETTINGS, inline="special1", tooltip=ALERT_TOOLTIP_PREFIX + ALERT_TITLE_NESTED_MBZ_MINUS + ALERT_TOOLTIP_SUFFIX)

enable_multi_source_mbz_plus = input.bool(true, ALERT_TITLE_MULTI_SOURCE_MBZ_PLUS, group=GROUP_ALERT_SETTINGS, inline="special2", tooltip=ALERT_TOOLTIP_PREFIX + ALERT_TITLE_MULTI_SOURCE_MBZ_PLUS + ALERT_TOOLTIP_SUFFIX)
enable_multi_source_mbz_minus = input.bool(true, ALERT_TITLE_MULTI_SOURCE_MBZ_MINUS, group=GROUP_ALERT_SETTINGS, inline="special2", tooltip=ALERT_TOOLTIP_PREFIX + ALERT_TITLE_MULTI_SOURCE_MBZ_MINUS + ALERT_TOOLTIP_SUFFIX)

enable_strong_mbz_plus = input.bool(true, ALERT_TITLE_STRONG_MBZ_PLUS, group=GROUP_ALERT_SETTINGS, inline="special3", tooltip=ALERT_TOOLTIP_PREFIX + ALERT_TITLE_STRONG_MBZ_PLUS + ALERT_TOOLTIP_SUFFIX)
enable_strong_mbz_minus = input.bool(true, ALERT_TITLE_STRONG_MBZ_MINUS, group=GROUP_ALERT_SETTINGS, inline="special3", tooltip=ALERT_TOOLTIP_PREFIX + ALERT_TITLE_STRONG_MBZ_MINUS + ALERT_TOOLTIP_SUFFIX)

// === ⚡ PERFORMANCE PROFILING ===
show_profiling = input.bool(false, "Show Profiling Table", group=GROUP_PERFORMANCE_PROFILING, tooltip='Display performance metrics table on chart showing operation counts per bar')
show_age_limit_line = input.bool(false, 'Show 500 Bar Limit Line', group=GROUP_PERFORMANCE_PROFILING, tooltip='Display vertical line showing the 500 bar limit (MBZs older than this cannot be rendered due to Pine Script limitations)\n4m = 33 hours | 15m = 5 days | 1H = 21 days | 1D = 1.4 years')
age_limit_line_color = input.color(color.new(color.orange, 0), 'Line Color', group=GROUP_PERFORMANCE_PROFILING, inline='age_limit')
age_limit_line_width = input.int(2, 'Width', minval=1, maxval=5, group=GROUP_PERFORMANCE_PROFILING, inline='age_limit')
age_limit_line_style = input.string('Dashed', 'Style', options=['Solid', 'Dashed', 'Dotted'], group=GROUP_PERFORMANCE_PROFILING, inline='age_limit2')
age_limit_label_color = input.color(color.white, 'Label Text', group=GROUP_PERFORMANCE_PROFILING, inline='age_limit2')
age_limit_label_bg = input.color(color.new(color.orange, 20), 'Label BG', group=GROUP_PERFORMANCE_PROFILING, inline='age_limit3')
age_limit_label_size = input.string('Small', 'Label Size', options=['Tiny', 'Small', 'Normal', 'Large'], group=GROUP_PERFORMANCE_PROFILING, inline='age_limit3')

// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS & DATA STRUCTURES
// ═══════════════════════════════════════════════════════════════════════════════


// MBZ tracking with SUPER MBZ detection
type MBZRecord
    int bar_index
    float high_price
    float low_price
    float mbz_open
    float mbz_close
    bool is_bullish
    bool is_invalidated
    float max_fill_percentage
    bool has_dominant_wick
    bool is_exactly_50_percent
    string mbz_subtype
    string cached_label_text
    string cached_tooltip
    float cached_zone_top
    float cached_zone_bottom
    bool cached_data_valid
    label mbz_label
    int source_id
    // Cached source geometry retained with each record
    int source_bar_index
    float source_high
    float source_low
    string source_family
    string source_type
    string pool_boundary
    bool wicked_deeper_into_source    // Track if wick penetrated deeper into the source origin
    bool reflection_pattern_deeper // Track if reflection pattern wick was deeper
    // SUPER MBZ detection
    bool is_super_mbz            // true if overlapping with any same-direction MBZ
    float overlap_percentage     // 0.0 to 100.0
    int overlapping_mbz_bar_index // Which MBZ we overlapped with
    string variant               // Variant that produced this MBZ (imbalance/liquidity)
    string formation_rule          // Formation rule (e.g., imbalance_standard, liquidity_standard)
    string source_origin_token   // Unified token describing the origin (e.g., fvg, daily)

type LiquidityPoolCollection
    array<float> highs
    array<float> lows
    array<int> high_times
    array<int> low_times
    array<int> session_close_times
    array<bool> high_breached
    array<bool> low_breached
    array<int> high_breach_times
    array<int> low_breach_times
    array<int> high_origin_bar_indices
    array<int> low_origin_bar_indices
    array<int> high_first_breach_bars
    array<int> low_first_breach_bars
    array<bool> high_mitigated_flags
    array<bool> low_mitigated_flags
    array<int> high_mitigation_bars
    array<int> low_mitigation_bars
    array<bool> high_used_by_pattern
    array<bool> low_used_by_pattern
    float current_high
    float current_low
    int current_high_time
    int current_low_time
    int current_session_start_time
    int current_high_origin_bar_index
    int current_low_origin_bar_index
    int current_high_first_breach_bar
    int current_low_first_breach_bar
    bool current_high_mitigated
    bool current_low_mitigated
    int current_high_mitigation_bar
    int current_low_mitigation_bar
    int first_unbreached_high_index
    int first_unbreached_low_index

// Cached counts for multi-source evaluation
type SourceTypeStats
    int group_size
    int distinct_types
    int liquidity_daily_count
    int liquidity_weekly_count
    int liquidity_monthly_count
    int liquidity_total_count

// Consolidated MBZ group type
type ConsolidatedMBZ
    array<MBZRecord> mbz_group
    int bar_index
    bool is_bullish
    float consolidated_zone_top
    float consolidated_zone_bottom
    bool is_consolidated_breached
    bool is_consolidated_invalidated
    string consolidated_candle_label
    string consolidated_extension_label

var array<MBZRecord> all_mbz_records = array.new<MBZRecord>()  // Large pool for history
