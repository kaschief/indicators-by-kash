//@version=6
indicator("FVG+VIB Combo Detector", overlay=true)

// Highlights displacement candles that create both an FVG and a VIB on either side.

bull_color = input.color(color.rgb(33, 150, 243), "+", inline="c")
bear_color = input.color(color.rgb(255, 152, 0), "−", inline="c")

body_top(float o, float c) => math.max(o, c)
body_bot(float o, float c) => math.min(o, c)

// [3]=before, [2]=displacement, [1]=after

// ─── FVG (3-candle) ───
bool bear_fvg = high[1] < low[3]
bool bull_fvg = low[1] > high[3]

// ─── VIB after displacement ([2] and [1]) ───
// Bearish: candle after body top < displacement body bottom, wicks connect
bool bear_vib_after = body_top(open[1], close[1]) < body_bot(open[2], close[2]) and high[1] >= low[2]
// Bullish: candle after body bottom > displacement body top, wicks connect
bool bull_vib_after = body_bot(open[1], close[1]) > body_top(open[2], close[2]) and low[1] <= high[2]

// ─── VIB before displacement ([3] and [2]) ───
// Bearish: displacement body top < candle before body bottom, wicks connect
bool bear_vib_before = body_top(open[2], close[2]) < body_bot(open[3], close[3]) and high[2] >= low[3]
// Bullish: displacement body bottom > candle before body top, wicks connect
bool bull_vib_before = body_bot(open[2], close[2]) > body_top(open[3], close[3]) and low[2] <= high[3]

// ─── Combo: FVG + VIB on either side ───
bool bear_combo = bear_fvg and (bear_vib_after or bear_vib_before)
bool bull_combo = bull_fvg and (bull_vib_after or bull_vib_before)

barcolor(bear_combo ? bear_color : bull_combo ? bull_color : na, offset=-2)

// FVG+VIB Combo Detector
