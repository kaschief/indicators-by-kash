// ═══════════════════════════════════════════════════════════════════════════════
// INVALIDATION THRESHOLDS (Edit these values to adjust invalidation sensitivity)
// ═══════════════════════════════════════════════════════════════════════════════
// MBZ Thresholds: % of zone that must be penetrated to invalidate
//   - 100% = Full close through entire zone required
//   - 85%  = Conservative, allows minor wicks through
//   - 55%  = Strict, invalidates on majority penetration
const float MBZ_THRESHOLD_STANDARD     = 100.0
const float MBZ_THRESHOLD_CONSERVATIVE = 85.0
const float MBZ_THRESHOLD_STRICT       = 55.0

// SIF Thresholds: % of zone that must be penetrated to invalidate
//   - 85%  = Lenient, allows more room before invalidation
//   - 55%  = Strict, invalidates on majority penetration
const float SIF_THRESHOLD_LENIENT = 85.0
const float SIF_THRESHOLD_STRICT  = 55.0
// ═══════════════════════════════════════════════════════════════════════════════

// MBZ invalidation mode constants (UI labels)
const string MBZ_INVALIDATION_STANDARD     = "Standard (100%)"
const string MBZ_INVALIDATION_CONSERVATIVE = "Conservative (85%)"
const string MBZ_INVALIDATION_STRICT       = "Strict (55%)"
const string MBZ_INVALIDATION_CUSTOM       = "Custom"

// SIF invalidation mode constants (UI labels)
const string SIF_INVALIDATION_STRICT   = "Strict (55%)"
const string SIF_INVALIDATION_LENIENT  = "Lenient (85%)"
const string SIF_INVALIDATION_CUSTOM   = "Custom"

// Implied FVG detection parameters
const float  IMPLIED_DISPLACEMENT_MULTIPLIER = 1.25

// MBZ label text color default
const color DEFAULT_ZONE_LABEL_COLOR = color.new(color.rgb(156, 156, 156), 20)

// ═══════════════════════════════════════════════════════════════════════════════
// TIMEFRAME CONFIGURATION
// ═══════════════════════════════════════════════════════════════════════════════
// Centralized pairing definition - 3-tier LTF→HTF mapping
// Returns: [is_valid, htf_string, htf_label, htf_ms, ltf_label]
//
// To add a new pairing: add one case to the switch below
// ═══════════════════════════════════════════════════════════════════════════════

// HTF slot constants
const string HTF_SLOT_1 = "1"
const string HTF_SLOT_2 = "2"
const string HTF_SLOT_3 = "3"

// Unified HTF pairing function
get_tf_pairing(string chart_tf, string slot) =>
    if slot == HTF_SLOT_1
        switch chart_tf
            "30S" => [true, "5",   "5m",  TF_5M_MS,  "30s"]   // 30s → 5m
            "1"   => [true, "15",  "15m", TF_15M_MS, "1m"]    // 1m  → 15m
            "2"   => [true, "30",  "30m", TF_30M_MS, "2m"]    // 2m  → 30m
            "3"   => [true, "30",  "30m", TF_30M_MS, "3m"]    // 3m  → 30m
            "4"   => [true, "30",  "30m", TF_30M_MS, "4m"]    // 4m  → 30m
            "5"   => [true, "60",  "1H",  TF_1H_MS,  "5m"]    // 5m  → 1H
            "10"  => [true, "60",  "1H",  TF_1H_MS,  "10m"]   // 10m → 1H
            "15"  => [true, "240", "4H",  TF_4H_MS,  "15m"]   // 15m → 4H
            "30"  => [true, "240", "4H",  TF_4H_MS,  "30m"]   // 30m → 4H
            "45"  => [true, "240", "4H",  TF_4H_MS,  "45m"]   // 45m → 4H
            "60"  => [true, "D",   "D",   TF_D_MS,   "1H"]    // 1H  → D
            "120" => [true, "D",   "D",   TF_D_MS,   "2H"]    // 2H  → D
            "180" => [true, "D",   "D",   TF_D_MS,   "3H"]    // 3H  → D
            "240" => [true, "D",   "D",   TF_D_MS,   "4H"]    // 4H  → D
            "1D"  => [true, "W",   "W",   TF_W_MS,   "D"]     // D   → W
            "1W"  => [true, "M",   "1Mo", TF_M_MS,   "W"]     // W   → 1Mo
            =>       [false, "",   "",    0,         ""]      // Unsupported
    else if slot == HTF_SLOT_2
        switch chart_tf
            "30S" => [true, "1",   "1m",  TF_1M_MS,  "30s"]   // 30s → 1m
            "1"   => [true, "5",   "5m",  TF_5M_MS,  "1m"]    // 1m  → 5m
            "2"   => [true, "5",   "5m",  TF_5M_MS,  "2m"]    // 2m  → 5m
            "3"   => [true, "15",  "15m", TF_15M_MS, "3m"]    // 3m  → 15m
            "4"   => [true, "15",  "15m", TF_15M_MS, "4m"]    // 4m  → 15m
            "5"   => [true, "15",  "15m", TF_15M_MS, "5m"]    // 5m  → 15m
            "10"  => [true, "30",  "30m", TF_30M_MS, "10m"]   // 10m → 30m
            "15"  => [true, "60",  "1H",  TF_1H_MS,  "15m"]   // 15m → 1H
            "30"  => [true, "60",  "1H",  TF_1H_MS,  "30m"]   // 30m → 1H
            "45"  => [true, "60",  "1H",  TF_1H_MS,  "45m"]   // 45m → 1H
            "60"  => [true, "240", "4H",  TF_4H_MS,  "1H"]    // 1H  → 4H
            "120" => [true, "240", "4H",  TF_4H_MS,  "2H"]    // 2H  → 4H
            "180" => [true, "240", "4H",  TF_4H_MS,  "3H"]    // 3H  → 4H
            "240" => [true, "W",   "W",   TF_W_MS,   "4H"]    // 4H  → W
            "1D"  => [true, "M",   "1Mo", TF_M_MS,   "D"]     // D   → 1Mo
            "1W"  => [true, "3M",  "3Mo", TF_3M_MS,  "W"]     // W   → 3Mo
            =>       [false, "",   "",    0,         ""]      // Unsupported
    else if slot == HTF_SLOT_3
        switch chart_tf
            "30S" => [true, "15",  "15m", TF_15M_MS, "30s"]   // 30s → 15m
            "1"   => [true, "60",  "1H",  TF_1H_MS,  "1m"]    // 1m  → 1H
            "2"   => [true, "60",  "1H",  TF_1H_MS,  "2m"]    // 2m  → 1H
            "3"   => [true, "60",  "1H",  TF_1H_MS,  "3m"]    // 3m  → 1H
            "4"   => [true, "60",  "1H",  TF_1H_MS,  "4m"]    // 4m  → 1H
            "5"   => [true, "240", "4H",  TF_4H_MS,  "5m"]    // 5m  → 4H
            "10"  => [true, "240", "4H",  TF_4H_MS,  "10m"]   // 10m → 4H
            "15"  => [true, "D",   "D",   TF_D_MS,   "15m"]   // 15m → D
            "30"  => [true, "D",   "D",   TF_D_MS,   "30m"]   // 30m → D
            "45"  => [true, "D",   "D",   TF_D_MS,   "45m"]   // 45m → D
            "60"  => [true, "W",   "W",   TF_W_MS,   "1H"]    // 1H  → W
            "120" => [true, "W",   "W",   TF_W_MS,   "2H"]    // 2H  → W
            "180" => [true, "W",   "W",   TF_W_MS,   "3H"]    // 3H  → W
            "240" => [true, "M",   "1Mo", TF_M_MS,   "4H"]    // 4H  → 1Mo
            "1D"  => [true, "3M",  "3Mo", TF_3M_MS,  "D"]     // D   → 3Mo
            =>       [false, "",   "",    0,         ""]      // Unsupported (W)
    else
        [false, "", "", 0, ""]  // Unknown slot

string CHART_TF = timeframe.period
[HTF1_AUTO_VALID, HTF1_AUTO_STRING, HTF1_AUTO_LABEL, HTF1_AUTO_MS, LTF_LABEL] = get_tf_pairing(CHART_TF, HTF_SLOT_1)

// Helper to convert Pine TF string to display label
get_tf_display_label(string tf) =>
    int secs = timeframe.in_seconds(tf)
    if secs < 60
        str.tostring(secs) + "s"
    else if secs < 3600
        str.tostring(secs / 60) + "m"
    else if secs < 86400
        str.tostring(secs / 3600) + "H"
    else if secs < 604800
        "D"
    else if secs < 2592000
        "W"
    else if secs < 7776000
        "1Mo"
    else
        "3Mo"

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

// Direction filter options
const string DIR_BOTH    = "Both"
const string DIR_BULLISH = "Bullish Only"
const string DIR_BEARISH = "Bearish Only"

// Gap color
const color GAP_COLOR = color.new(color.rgb(187, 217, 251), 90)

// ─── Group Constants ───
GROUP_ENGINE       = "🔧 Engine"
GROUP_PO3_CHART    = "📊 PO3 Chart"
GROUP_PO3_CANDLES  = "📊 PO3 Candles"
GROUP_PO3_FVGS     = "📊 PO3 FVGs"
GROUP_MBZ_PO3        = "🎯 MBZ on PO3"
GROUP_MBZ_CHART      = "🎯 MBZ on Chart"
GROUP_MBZ_DETECTION  = "🎯 Liquidity MBZ"
GROUP_LIQ_HTF        = "💧 Higher Timeframe Pools"
GROUP_LIQ_TF         = "💧 Timeframe Pools"
GROUP_TIME_BEHAVIOR  = "⏰ Time Behavior"
GROUP_SIF_PO3        = "✨ SIF on PO3"
GROUP_SIF_CHART      = "✨ SIF on Chart"
GROUP_CHART_ZONES    = "🎨 Chart Zones"
GROUP_INVALIDATION   = "✋ Invalidation"
GROUP_GAP_SOURCES    = "📊 Gap Sources"
GROUP_ADVANCED       = "⚙️ Advanced"

// ─── 🔧 Engine ───
const string MBZ_MODE_GAP       = "Gap"
const string MBZ_MODE_LIQUIDITY = "Liquidity"
const string MBZ_MODE_BOTH      = "Liquidity + Gap"
const string MBZ_MODE_OFF       = "Off"
mbz_mode = input.string(MBZ_MODE_BOTH, "MBZ", options=[MBZ_MODE_GAP, MBZ_MODE_LIQUIDITY, MBZ_MODE_BOTH, MBZ_MODE_OFF], group=GROUP_ENGINE, inline="engine")
enable_sif = input.bool(true, "SIF", group=GROUP_ENGINE, inline="engine")
mbz_direction_filter = input.string(DIR_BOTH, "Direction", options=[DIR_BOTH, DIR_BULLISH, DIR_BEARISH], group=GROUP_ENGINE)

// Derive engine + source flags from dropdown
bool enable_mbz        = mbz_mode != MBZ_MODE_OFF
bool enable_gap_mbz    = mbz_mode == MBZ_MODE_GAP or mbz_mode == MBZ_MODE_BOTH
bool enable_liq_pools = mbz_mode == MBZ_MODE_LIQUIDITY or mbz_mode == MBZ_MODE_BOTH

// ─── 📊 PO3 Chart ───
show_po3_chart         = input.bool(true, "Show PO3", group=GROUP_PO3_CHART, inline="po3_master")
htf1_candle_count      = input.int(15, "HTF 1", minval=2, maxval=100, group=GROUP_PO3_CHART, inline="po3_htf1")
htf1_manual            = input.bool(false, "Manual", group=GROUP_PO3_CHART, inline="po3_htf1")
htf1_tf_input          = input.timeframe("60", "", group=GROUP_PO3_CHART, inline="po3_htf1")
show_htf2    = input.bool(false, "HTF 2", group=GROUP_PO3_CHART, inline="po3_htf2", tooltip="Lower timeframe for detailed price structure")
htf2_manual         = input.bool(false, "Manual", group=GROUP_PO3_CHART, inline="po3_htf2")
htf2_tf_input       = input.timeframe("5", "", group=GROUP_PO3_CHART, inline="po3_htf2")
htf2_candle_count   = input.int(20, "", minval=2, maxval=100, group=GROUP_PO3_CHART, inline="po3_htf2")
show_htf3    = input.bool(false, "HTF 3", group=GROUP_PO3_CHART, inline="po3_htf3", tooltip="Higher timeframe for broader market context")
htf3_manual         = input.bool(false, "Manual", group=GROUP_PO3_CHART, inline="po3_htf3")
htf3_tf_input       = input.timeframe("240", "", group=GROUP_PO3_CHART, inline="po3_htf3")
htf3_candle_count   = input.int(10, "", minval=2, maxval=100, group=GROUP_PO3_CHART, inline="po3_htf3")

// Resolve HTF1 TF
string HTF1_STRING = htf1_manual ? htf1_tf_input : (HTF1_AUTO_VALID ? HTF1_AUTO_STRING : "1")
string HTF1_LABEL  = htf1_manual ? get_tf_display_label(htf1_tf_input) : HTF1_AUTO_LABEL
int    HTF1_MS     = htf1_manual ? timeframe.in_seconds(htf1_tf_input) * 1000 : HTF1_AUTO_MS
bool   HTF1_VALID  = (htf1_manual or HTF1_AUTO_VALID) and timeframe.in_seconds(HTF1_STRING) > timeframe.in_seconds()

// Resolve HTF2 TF
[HTF2_AUTO_VALID, HTF2_AUTO_STRING, HTF2_AUTO_LABEL, HTF2_AUTO_MS, _htf2] = get_tf_pairing(CHART_TF, HTF_SLOT_2)
string HTF2_STRING = htf2_manual ? htf2_tf_input : (HTF2_AUTO_VALID ? HTF2_AUTO_STRING : "1")
string HTF2_LABEL  = htf2_manual ? get_tf_display_label(htf2_tf_input) : HTF2_AUTO_LABEL
int    HTF2_MS     = htf2_manual ? timeframe.in_seconds(htf2_tf_input) * 1000 : HTF2_AUTO_MS
bool   HTF2_VALID  = show_htf2 and (htf2_manual or HTF2_AUTO_VALID) and timeframe.in_seconds(HTF2_STRING) > timeframe.in_seconds()

// Resolve HTF3 TF
[HTF3_AUTO_VALID, HTF3_AUTO_STRING, HTF3_AUTO_LABEL, HTF3_AUTO_MS, _htf3] = get_tf_pairing(CHART_TF, HTF_SLOT_3)
string HTF3_STRING = htf3_manual ? htf3_tf_input : (HTF3_AUTO_VALID ? HTF3_AUTO_STRING : "1")
string HTF3_LABEL  = htf3_manual ? get_tf_display_label(htf3_tf_input) : HTF3_AUTO_LABEL
int    HTF3_MS     = htf3_manual ? timeframe.in_seconds(htf3_tf_input) * 1000 : HTF3_AUTO_MS
bool   HTF3_VALID  = show_htf3 and (htf3_manual or HTF3_AUTO_VALID) and timeframe.in_seconds(HTF3_STRING) > timeframe.in_seconds()

// ─── 📊 PO3 Candles ───
po3_is_overlay         = input.bool(false, "Overlay", group=GROUP_PO3_CANDLES, inline="po3_candle_layout")
po3_overlay_trans      = input.int(15, "Opacity", minval=0, maxval=100, group=GROUP_PO3_CANDLES, inline="po3_candle_layout", tooltip="Transparency of PO3 candles in overlay mode")
po3_offset             = input.int(50, "Offset", minval=5, maxval=300, group=GROUP_PO3_CANDLES, inline="po3_candle_layout")
po3_gap                = input.int(10, "Gap", minval=0, maxval=50, group=GROUP_PO3_CANDLES, inline="po3_candle_layout", tooltip="Space between PO3 tier charts")
po3_bull_body          = input.color(color.rgb(255, 255, 255), "+ Body", group=GROUP_PO3_CANDLES, inline="po3_bull")
po3_bull_border        = input.color(color.rgb(76, 76, 76), "Border", group=GROUP_PO3_CANDLES, inline="po3_bull")
po3_bull_wick          = input.color(color.rgb(76, 76, 76), "Wick", group=GROUP_PO3_CANDLES, inline="po3_bull")
po3_bear_body          = input.color(color.rgb(0, 0, 0), "− Body", group=GROUP_PO3_CANDLES, inline="po3_bear")
po3_bear_border        = input.color(color.rgb(76, 76, 76), "Border", group=GROUP_PO3_CANDLES, inline="po3_bear")
po3_bear_wick          = input.color(color.rgb(76, 76, 76), "Wick", group=GROUP_PO3_CANDLES, inline="po3_bear")
show_po3_label         = input.bool(true, "Label", group=GROUP_PO3_CANDLES, inline="po3_lbl")
po3_label_color        = input.color(color.rgb(0, 0, 0), "", group=GROUP_PO3_CANDLES, inline="po3_lbl")
po3_label_size_input   = input.string("Large", "", options=["Tiny", "Small", "Normal", "Large"], group=GROUP_PO3_CANDLES, inline="po3_lbl")
po3_pool_source_mode   = input.string(POOL_SRC_SOURCE_COUNT, "Pool Source", options=[POOL_SRC_OFF, POOL_SRC_SOURCE, POOL_SRC_SOURCE_COUNT], group=GROUP_PO3_CANDLES, inline="po3_lbl", tooltip='Off: hide pool source.\nSource: show highest-TF pool (e.g., "daily").\nSource + Count: show highest + total count (e.g., "daily (5)").')
po3_align_labels       = input.bool(true, "Align Labels", group=GROUP_PO3_CANDLES, inline="po3_align", tooltip="Align all PO3 tier labels at the same height")
po3_label_bottom       = input.bool(false, "Bottom", group=GROUP_PO3_CANDLES, inline="po3_align")
show_po3_dividers      = input.bool(true, "Dividers", group=GROUP_PO3_CANDLES, inline="po3_div")
po3_divider_color      = input.color(color.new(color.rgb(219, 219, 219), 40), "", group=GROUP_PO3_CANDLES, inline="po3_div")
po3_divider_style_in   = input.string("····", "", options=["⎯⎯⎯", "----", "····"], group=GROUP_PO3_CANDLES, inline="po3_div")
po3_show_times         = input.bool(false, "Show Times", group=GROUP_PO3_CANDLES)
po3_midline_color      = input.color(color.new(color.rgb(0, 0, 0), 50), "PO3 Midline", group=GROUP_PO3_CANDLES, inline="po3_midline")
po3_midline_style      = input.string("----", "", options=["⎯⎯⎯", "----", "····"], group=GROUP_PO3_CANDLES, inline="po3_midline")

// ─── 📊 PO3 FVGs ───
show_po3_fvgs          = input.bool(false, "Show FVGs", group=GROUP_PO3_FVGS, inline="po3_fvg")
po3_fvg_bull_color     = input.color(color.new(color.rgb(184, 184, 184), 75), "+", group=GROUP_PO3_FVGS, inline="po3_fvg")
po3_fvg_bear_color     = input.color(color.new(color.rgb(184, 184, 184), 75), "−", group=GROUP_PO3_FVGS, inline="po3_fvg")
po3_fvg_extend         = input.int(1, "Extend", minval=0, maxval=5, group=GROUP_PO3_FVGS, inline="po3_fvg", tooltip="Extra candles to extend FVG boxes on PO3")

// ─── 🎯 MBZ on PO3 ───
po3_show_mbz           = input.bool(true, "Show MBZ on PO3", group=GROUP_MBZ_PO3)
