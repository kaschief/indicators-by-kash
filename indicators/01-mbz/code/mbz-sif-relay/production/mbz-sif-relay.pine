po3_mbz_zone_bear     = input.color(color.new(color.rgb(255, 204, 128), 90), "−", group=GROUP_MBZ_PO3, inline="po3_mbz_zone")
po3_mbz_label_color   = input.color(color.new(color.rgb(57, 120, 221), 0), "Label +", group=GROUP_MBZ_PO3, inline="po3_mbz_lbl")
po3_mbz_label_bear    = input.color(color.new(color.rgb(239, 83, 80), 0), "−", group=GROUP_MBZ_PO3, inline="po3_mbz_lbl")

// ─── 🎯 MBZ on Chart ───
show_mbz_on_chart  = input.bool(true, "Show MBZ on Chart", group=GROUP_MBZ_CHART)
mbz_fill_bull      = input.color(color.new(color.rgb(187, 217, 251), 90), "Fill +", group=GROUP_MBZ_CHART, inline="mbz_fill")
mbz_fill_bear      = input.color(color.new(color.rgb(255, 224, 178), 90), "−", group=GROUP_MBZ_CHART, inline="mbz_fill")
mbz_border_bull    = input.color(color.new(color.rgb(92, 166, 233), 40), "Border +", group=GROUP_MBZ_CHART, inline="mbz_bdr")
mbz_border_bear    = input.color(color.new(color.rgb(255, 152, 0), 60), "−", group=GROUP_MBZ_CHART, inline="mbz_bdr")
extend_to_wick = input.bool(true, "Extend to Wick", group=GROUP_MBZ_CHART, tooltip='Extend zone boundary to the furthest wick (own candle or reference candle)')
same_source_filter = input.string(SAME_SOURCE_FILTER_LATEST_TOUCH, "Same-Source", options=[SAME_SOURCE_FILTER_ALL_TOUCHES, SAME_SOURCE_FILTER_FIRST_TOUCH, SAME_SOURCE_FILTER_LATEST_TOUCH], group=GROUP_MBZ_CHART)

// ─── 🎯 MBZ Detection ───
enable_liq_imm = input.bool(true, "Immediate", group=GROUP_MBZ_DETECTION, inline="liq_rules", tooltip='A stays inside level, B sweeps through on current candle.')
enable_liq_std = input.bool(true, "Standard", group=GROUP_MBZ_DETECTION, inline="liq_rules", tooltip='A wicks through level (directional), closes inside; B displaces.')
enable_liq_del = input.bool(true, "Delayed", group=GROUP_MBZ_DETECTION, inline="liq_rules", tooltip='A body closes through level (directional); B displaces.')
enable_liq_daily   = input.bool(true, "Daily", group=GROUP_LIQ_HTF, inline="liq_htf")
enable_liq_weekly  = input.bool(true, "Weekly", group=GROUP_LIQ_HTF, inline="liq_htf")
enable_liq_monthly = input.bool(true, "Monthly", group=GROUP_LIQ_HTF, inline="liq_htf")
enable_liq_4h      = input.bool(true, "4ʰ", group=GROUP_LIQ_TF, inline="liq_tf")
enable_liq_1h      = input.bool(true, "1ʰ", group=GROUP_LIQ_TF, inline="liq_tf")
daily_boundary_mode = input.string(DAILY_BOUNDARY_EXCHANGE, "Daily Boundary", options=[DAILY_BOUNDARY_EXCHANGE, DAILY_BOUNDARY_CALENDAR], group=GROUP_TIME_BEHAVIOR, tooltip='How daily sessions are defined for liquidity pool tracking:\n\n• Exchange Session (default): 18:00-17:59 ET — matches futures/forex session boundaries. Sunday 18:00 starts Monday\'s session.\n• Calendar Day: Midnight-midnight ET — traditional calendar day boundaries.\n\n24/7 assets (crypto) force Calendar Day mode automatically.')
include_sunday_evening = input.bool(true, "Include Sunday Evening", group=GROUP_TIME_BEHAVIOR, tooltip='Calendar Day mode only: Include Sunday 18:00-00:00 in daily pool tracking.\n\n• ON (default): Sunday evening data included in daily high/low.\n• OFF: Skip Sunday evening, start fresh Monday 00:00.\n\nIgnored in Exchange Session mode (Sunday 18:00 always starts Monday\'s session).')
enable_pool_backfill = input.bool(true, "Historical Backfill", group=GROUP_TIME_BEHAVIOR, tooltip="Pre-populate daily/weekly/monthly pools with historical sessions via request.security. Adds ~60 daily, ~40 weekly, ~24 monthly sessions on low-TF charts where normal tracking has limited history. Only active in Exchange Session mode.")

// ─── ✨ SIF on PO3 ───
po3_show_sif           = input.bool(true, "Show SIF on PO3", group=GROUP_SIF_PO3)
po3_sif_bull_highlight = input.color(color.new(color.rgb(38, 166, 154), 50), "Candle +", group=GROUP_SIF_PO3, inline="po3_sif_hl")
po3_sif_bear_highlight = input.color(color.new(color.rgb(239, 83, 80), 50), "−", group=GROUP_SIF_PO3, inline="po3_sif_hl")
po3_sif_zone_bull     = input.color(color.new(color.rgb(38, 166, 154), 90), "Zone +", group=GROUP_SIF_PO3, inline="po3_sif_zone")
po3_sif_zone_bear     = input.color(color.new(color.rgb(239, 83, 80), 85), "−", group=GROUP_SIF_PO3, inline="po3_sif_zone")
po3_sif_label_color   = input.color(color.new(color.rgb(38, 166, 154), 0), "Label +", group=GROUP_SIF_PO3, inline="po3_sif_lbl")
po3_sif_label_bear    = input.color(color.new(color.rgb(239, 83, 80), 0), "−", group=GROUP_SIF_PO3, inline="po3_sif_lbl")

// ─── ✨ SIF on Chart ───
show_sif_on_chart  = input.bool(true, "Show SIF on Chart", group=GROUP_SIF_CHART)
sif_fill_bull      = input.color(color.new(color.rgb(172, 229, 220), 90), "Fill +", group=GROUP_SIF_CHART, inline="sif_fill")
sif_fill_bear      = input.color(color.new(color.rgb(252, 203, 205), 90), "−", group=GROUP_SIF_CHART, inline="sif_fill")
sif_border_bull    = input.color(color.new(color.rgb(38, 166, 154), 55), "Border +", group=GROUP_SIF_CHART, inline="sif_bdr")
sif_border_bear    = input.color(color.new(color.rgb(239, 83, 80), 65), "−", group=GROUP_SIF_CHART, inline="sif_bdr")

bool show_chart_zones = show_mbz_on_chart or show_sif_on_chart

// ─── 🎨 Chart Zones ───
chart_zone_source = input.string(CHART_SRC_MAIN, "Chart Source", options=[CHART_SRC_MAIN, CHART_SRC_TF2, CHART_SRC_TF3], group=GROUP_CHART_ZONES, tooltip="Which timeframe tier's zones render on the main chart")
po3_limit_to_range = input.bool(true, "Limit to PO3 Range", group=GROUP_CHART_ZONES, tooltip="When on, chart zones only show for candles visible on the PO3. Disable to show all detected zones.")
zone_border_width  = input.int(2, "Border Width", minval=0, maxval=5, group=GROUP_CHART_ZONES, inline="zone_shared")
zone_extension_bars = input.int(4, "Zone Extension", minval=1, maxval=20, group=GROUP_CHART_ZONES, inline="zone_shared")
zone_label_color   = input.color(DEFAULT_ZONE_LABEL_COLOR, "Zone Label", group=GROUP_CHART_ZONES, inline="lbl")
zone_label_size    = input.string("Small", "", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=GROUP_CHART_ZONES, inline="lbl")
show_zone_midline  = input.bool(true, "Midline", group=GROUP_CHART_ZONES, inline="zone_mid")
zone_midline_color = input.color(color.new(color.rgb(99, 99, 99), 50), "", group=GROUP_CHART_ZONES, inline="zone_mid")
zone_midline_style_in = input.string("----", "", options=["⎯⎯⎯", "----", "····"], group=GROUP_CHART_ZONES, inline="zone_mid")

// ─── 📊 Gap Sources ───
enable_fvg      = input.bool(true, "FVG", group=GROUP_GAP_SOURCES, inline="src1")
enable_fvg_vi   = input.bool(true, "VI Extension", group=GROUP_GAP_SOURCES, inline="src1")
enable_implied  = input.bool(false, "Implied", group=GROUP_GAP_SOURCES, inline="src1")
enable_volume   = input.bool(false, "Volume", group=GROUP_GAP_SOURCES, inline="src1")

// ─── ✋ Invalidation ───
enable_invalidation = input.bool(true, "Enable", group=GROUP_INVALIDATION, inline="inv_main")
invalidation_mode = input.string(MBZ_INVALIDATION_STRICT, "MBZ", options=[MBZ_INVALIDATION_STANDARD, MBZ_INVALIDATION_CONSERVATIVE, MBZ_INVALIDATION_STRICT, MBZ_INVALIDATION_CUSTOM], group=GROUP_INVALIDATION, inline="mbz_inv")
custom_threshold_percent = input.float(50, "Custom %", minval=1, maxval=100, step=1, group=GROUP_INVALIDATION, inline="mbz_inv")
sif_invalidation_mode = input.string(SIF_INVALIDATION_STRICT, "SIF", options=[SIF_INVALIDATION_STRICT, SIF_INVALIDATION_LENIENT, SIF_INVALIDATION_CUSTOM], group=GROUP_INVALIDATION, inline="sif_inv")
sif_custom_threshold_percent = input.float(99, "Custom %", minval=1, maxval=100, step=1, group=GROUP_INVALIDATION, inline="sif_inv")

// ─── ⚙️ Advanced ───
max_htf_candles  = input.int(200, "Gap/SIF HTF Lookback", minval=5, maxval=200, group=GROUP_ADVANCED, tooltip='How many HTF candles back to scan for FVG gaps, MBZ/SIF zone formation, and invalidation.\n\nGaps and zones older than this are removed.\n\nOnly affects gap-based detection (FVG, implied, volume). Liquidity pool depth is separate — see Daily Scan Cap in MBZ Detection.')

// Workspace Tools
WORKSPACE_DEFAULT_NEAREST = 1
WORKSPACE_FADE_OPACITY = 80


// Auto Workspace Configuration (extensible - add more timeframes as needed)
NY_TIMEZONE = "America/New_York"
AUTO_WS_TIMEFRAMES = array.from("1", "2", "3", "5", "15", "60")  // 1m, 2m, 3m, 5m, 15m, 1h
AUTO_WS_START_HOUR = 8   // NY time
AUTO_WS_END_HOUR = 13    // NY time

workspace_mode_enabled = input.bool(false, "Enable Workspace Mode", group=GROUP_ADVANCED)
auto_workspace_enabled = input.bool(false, "Auto Workspace", group=GROUP_ADVANCED)
workspace_nearest_bull = input.int(WORKSPACE_DEFAULT_NEAREST, "+", minval=0, maxval=10, group=GROUP_ADVANCED, inline="ws_nearest")
workspace_nearest_bear = input.int(WORKSPACE_DEFAULT_NEAREST, "-", minval=0, maxval=10, group=GROUP_ADVANCED, inline="ws_nearest")
workspace_exclude_vi_only = input.bool(true, "Exclude VI-Only Zones", group=GROUP_ADVANCED)

// Auto workspace detection (M-F only)
is_auto_ws_timeframe = array.includes(AUTO_WS_TIMEFRAMES, timeframe.period)
ny_hour = hour(time, NY_TIMEZONE)
ny_dow = dayofweek(time, NY_TIMEZONE)
is_weekday = ny_dow >= dayofweek.monday and ny_dow <= dayofweek.friday
is_auto_ws_time_window = is_weekday and ny_hour >= AUTO_WS_START_HOUR and ny_hour < AUTO_WS_END_HOUR
workspace_active = workspace_mode_enabled or (auto_workspace_enabled and is_auto_ws_timeframe and is_auto_ws_time_window)

// Gap display mode constants
const string GAP_DISPLAY_OFF        = "Off"
const string GAP_DISPLAY_ALL        = "All Gaps"
const string GAP_DISPLAY_MBZ_SOURCE = "MBZ Source Only"
const string GAP_DISPLAY_SIF_SOURCE = "SIF Source Only"

gap_display_mode = input.string(GAP_DISPLAY_OFF, "Show Gaps", options=[GAP_DISPLAY_OFF, GAP_DISPLAY_ALL, GAP_DISPLAY_MBZ_SOURCE, GAP_DISPLAY_SIF_SOURCE], group=GROUP_ADVANCED)
show_status_table = input.bool(true, "Show Status Table", group=GROUP_ADVANCED, inline="status")
status_table_offset = input.int(100, "Offset", minval=-150, maxval=150, group=GROUP_ADVANCED, inline="status")
show_htf_candles = input.bool(false, "Show HTF Candles", group=GROUP_ADVANCED)
disable_vi_suppression = input.bool(true, "Disable VI Suppression", group=GROUP_ADVANCED)
pool_debug_mode = input.string("Off", "Pool Debug", options=["Off", "Daily", "Weekly", "Monthly", "4H", "1H"], group=GROUP_ADVANCED)
show_color_table = input.bool(false, "Show Color Table", group=GROUP_ADVANCED)


// ─── Input Enforcement ───
// MBZ source enforcement handled by dropdown (Gap/Liquidity/Both/Off — no invalid state possible)
// Formation rule enforcement: at least one rule when liquidity active
if enable_liq_pools and not enable_liq_imm and not enable_liq_std and not enable_liq_del
    enable_liq_std := true

// ═══════════════════════════════════════════════════════════════════════════════
// 24/7 ASSET DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

current_tf_minutes = timeframe.in_seconds() / 60
var bool is_247_asset = true
var bool detection_completed = false

if not detection_completed
    bars_in_7_days = math.ceil(10080 / current_tf_minutes)
    if bar_index >= bars_in_7_days
        current_day = dayofweek(time, NY_TIMEZONE)
        current_hour_detect = hour(time, NY_TIMEZONE)
        is_saturday_now = current_day == dayofweek.saturday
        is_early_sunday_now = current_day == dayofweek.sunday and current_hour_detect < SUNDAY_REOPEN_START_HOUR
        if is_saturday_now or is_early_sunday_now
            is_247_asset := true
        else
            max_lookback = math.min(9999, bars_in_7_days)
            found_weekend_bar = false
            for lookback = 0 to max_lookback by 20
                check_day = dayofweek(time[lookback], NY_TIMEZONE)
                check_hour_detect = hour(time[lookback], NY_TIMEZONE)
                is_saturday = check_day == dayofweek.saturday
                is_early_sunday = check_day == dayofweek.sunday and check_hour_detect < SUNDAY_REOPEN_START_HOUR
                if is_saturday or is_early_sunday
                    found_weekend_bar := true
                    break
            is_247_asset := found_weekend_bar
        detection_completed := true

// Resolve effective daily boundary mode (24/7 assets force Calendar Day)
effective_daily_boundary = is_247_asset ? DAILY_BOUNDARY_CALENDAR : daily_boundary_mode
use_exchange_session = effective_daily_boundary == DAILY_BOUNDARY_EXCHANGE

// ═══════════════════════════════════════════════════════════════════════════════
// DERIVED VALUES
// ═══════════════════════════════════════════════════════════════════════════════

color BULL_BORDER = color.new(color.from_gradient(50, 0, 100, color.new(color.rgb(165, 214, 167), 74), color.new(color.rgb(165, 214, 167), 85)), 60)
color BEAR_BORDER = color.new(color.from_gradient(50, 0, 100, color.new(color.rgb(244, 143, 177), 74), color.new(color.rgb(252, 203, 205), 80)), 60)

// Resolve label size from string to Pine constant
string ZONE_LABEL_SIZE_RESOLVED = switch zone_label_size
    "Tiny"   => size.tiny
    "Small"  => size.small
    "Normal" => size.normal
    "Large"  => size.large
    "Huge"   => size.huge
    => size.large

// Resolve zone midline style
string ZONE_MIDLINE_STYLE = switch zone_midline_style_in
    "----" => line.style_dashed
    "····" => line.style_dotted
    => line.style_solid

// Validation boundary is an inherent feature - static styling
const string VALIDATION_LINE_STYLE = line.style_dotted
const int VALIDATION_LINE_WIDTH = 2
const int VALIDATION_LINE_TRANS = 65

// Resolve MBZ invalidation threshold based on mode
float MBZ_INVALIDATION_THRESHOLD = switch invalidation_mode
    MBZ_INVALIDATION_STANDARD     => MBZ_THRESHOLD_STANDARD
    MBZ_INVALIDATION_CONSERVATIVE => MBZ_THRESHOLD_CONSERVATIVE
    MBZ_INVALIDATION_STRICT       => MBZ_THRESHOLD_STRICT
    MBZ_INVALIDATION_CUSTOM       => custom_threshold_percent
    => MBZ_THRESHOLD_STANDARD

// Resolve SIF invalidation threshold based on mode
float SIF_INVALIDATION_THRESHOLD = switch sif_invalidation_mode
    SIF_INVALIDATION_STRICT  => SIF_THRESHOLD_STRICT
    SIF_INVALIDATION_LENIENT => SIF_THRESHOLD_LENIENT
    SIF_INVALIDATION_CUSTOM  => sif_custom_threshold_percent
    => SIF_THRESHOLD_STRICT

// Smart FVG limit based on candle overlay usage
// Candles use 2 boxes each (wick + body), FVGs use 1 box each
int CANDLE_BOX_USAGE = show_htf_candles ? max_htf_candles * 2 : 0
int MAX_FVGS = DRAW_LIMIT - CANDLE_BOX_USAGE - DRAW_BUFFER
int MAX_ZONES = 100  // Zones use 1 box + 1 line each

// ═══════════════════════════════════════════════════════════════════════════════
// TYPES
// ═══════════════════════════════════════════════════════════════════════════════

type HTFCandle
    box   wick
    box   body
    int   start_time

// PO3 mini chart candle data (OHLC history for offset rendering)
type PO3CandleData
    float  o
    float  h
    float  l
    float  c
    int    t

// PO3 mini chart visual state (one per HTF slot)
type PO3Chart
    // ─── Config (per-chart, supports multi-HTF) ───
    string htf_label
    int    max_candles
    int    offset
    int    spacing
    color  bull_body
    color  bull_border
    color  bull_wick
    color  bear_body
    color  bear_border
    color  bear_wick
    bool   show_label
    color  label_color
    string label_size
    bool   show_dividers
    color  divider_color
    string divider_style
    bool   show_mbz
    color  mbz_bull_highlight
    color  mbz_bear_highlight
    bool   show_sif
    color  sif_bull_highlight
    color  sif_bear_highlight
    color  mbz_zone_bull
    color  mbz_zone_bear
    color  sif_zone_bull
    color  sif_zone_bear
    color  midline_color
    string midline_style
    bool   is_overlay
    int    htf_ms
    float  highest_point
    float  lowest_point
    // ─── Data ───
    array<PO3CandleData> data
    // ─── Visual state ───
    array<box>           bodies
    array<line>          wicks
    array<line>          dividers
    array<box>           highlights      // MBZ candle highlights
    array<box>           zone_boxes      // MBZ zone boxes on PO3
    array<line>          zone_midlines   // MBZ zone 50% midlines on PO3
    array<label>         zone_labels     // MBZ labels on PO3
    array<box>           fvg_boxes       // FVG boxes between PO3 candles
    box                  forming_body
    line                 forming_wick
    label                tf_label

// Candle that interacted with gap (for tap/inversion tracking)
type TapCandidate
    int    bar_index
    int    bar_time
    float  body_top
    float  body_bottom
    bool   is_bullish

// Unified gap data for all gap types (FVG, Implied, VI)
type GapData
    // ─── Core geometry ───
    float  top
    float  bottom
    float  ce                    // Consequent encroachment (midpoint)
    int    bar_index             // Bar index when gap completed
    int    start_time            // Time of first candle in formation
    int    formation_end_time    // Time of completion candle
    bool   is_bullish
    string gap_type              // "fvg", "implied", "volume"
    int    gap_id
    // ─── Gap state ───
    bool   is_inverted           // Gap closed (price closed through)
    int    inverted_time
    // ─── SIF tap tracking (body-based, NOT wick-based like MBZ) ───
    TapCandidate sif_body_tapper    // First candle whose BODY enters gap (SIF definition)
    // ─── MBZ tracking ───
    int    mbz_ref_time          // When MBZ formed, freeze box at reference candle time
    bool   mbz_is_bullish        // Direction of MBZ that formed (for direction filter)
    // ─── Visual elements ───
    box    gap_box
    line   ce_line
    label  tf_label

// MBZ Formation Match (for multi-source consolidated candles support)
type MBZFormationMatch
    bool   is_bullish
    string subtype
    int    source_gap_id
    string source_gap_type

// ═══════════════════════════════════════════════════════════════════════════════
// UNIFIED CANDLE ZONE TYPE
// ═══════════════════════════════════════════════════════════════════════════════
// Agnostic container for both MBZ and SIF zones
// Zone geometry comes from formation candle, not from source gap

type CandleZone
    // ─── Formation candle geometry (same for both MBZ and SIF) ───
    int    bar_index
    int    formation_time
    float  candle_open
    float  candle_close
    float  candle_high
    float  candle_low

    // ─── Zone classification ───
    bool   is_bullish
    string zone_subtype        // "standard", "inclusion", "reflection"

    // ─── Engine flags (which detection systems validated this zone) ───
    bool   has_mbz             // True if MBZ engine validated this zone
    bool   has_sif             // True if SIF engine validated this zone

    // ─── Cached zone boundaries (calculated from candle geometry) ───
    float  zone_top
    float  zone_bottom

    // ─── Source gap references (may have multiple sources) ───
    array<int>    source_gap_ids      // All gap IDs that contributed to this zone
    array<string> source_gap_types    // Corresponding gap types ("fvg", "implied", "volume")

    // ─── State ───
    bool   is_invalidated
    bool   mbz_invalidated     // MBZ-specific invalidation state
    bool   sif_invalidated     // SIF-specific invalidation state

    // ─── MBZ-specific fields ───
    float  ref_candle_high     // Reference candle high (for wick extension)
    float  ref_candle_low      // Reference candle low (for wick extension)
    bool   is_wick_extended    // True if zone was extended to reference wick
    string liq_formation_rule  // "L-IMM", "L-STD", "L-DEL", or "" if gap-only
    bool   has_gap_mbz         // True if gap-based MBZ contributed (for label parenthesizing)

    // ─── SIF-specific fields ───
    bool   is_immediate_sif    // True if first tap AND inversion same candle

    // ─── HTF context ───
    string htf_label           // Which HTF this zone belongs to ("1H", "4H", etc.)

    // ─── Visual elements ───
    box    zone_box
    line   validation_line    // Vertical line marking when HTF candle closed (zone became valid)
    line   midline            // 50% midline within zone

// ═══════════════════════════════════════════════════════════════════════════════
// HTF CONTEXT TYPE (for multi-HTF support)
// ═══════════════════════════════════════════════════════════════════════════════
// Encapsulates all state for a single HTF timeframe
// Functions accept arrays as parameters to enable reuse across multiple HTFs

type HTFContext
    // ─── Configuration ───
    int    tier_index              // 1, 2, or 3 — used for per-tier pool detection state
    string htf_string              // TradingView timeframe string ("240", "D", etc.)
    string htf_label               // Display label ("4H", "D", etc.)
    int    htf_ms                  // Milliseconds per HTF candle

    // ─── Current forming candle ───
    float  curr_open
    float  curr_high
    float  curr_low
    int    curr_time

    // ─── Confirmed candle history [1] = most recent closed ───
    float  o1
    float  h1
    float  l1
    float  c1
    int    t1

    // ─── Confirmed candle history [2] = second most recent ───
    float  o2
    float  h2
    float  l2
    float  c2
    int    t2

    // ─── Confirmed candle history [3] = third most recent ───
    float  o3
    float  h3
    float  l3
    float  c3
    int    t3

    // ─── Extra history for displacement lookback ───
    float  o4
    float  h4
    float  l4
    float  c4
    float  o5
    float  h5
    float  l5
    float  c5

    // ─── Data arrays ───
    array<GapData>      gap_array
    array<CandleZone>   zone_array
    array<int>          htf_times      // Track HTF candle times for window

    // ─── Unique ID counter ───
    int    next_gap_id

    // ─── Display flag: true when this tier is the chart zone source ───
    bool   is_chart_source

// ═══════════════════════════════════════════════════════════════════════════════
// LIQUIDITY POOL TYPES
// ═══════════════════════════════════════════════════════════════════════════════

type PoolLevel
    // ─── Session identity ───
    float  session_high
    float  session_low
    int    high_time
    int    low_time
    int    session_close_time
    // ─── Breach state (shared — tier-independent) ───
    bool   high_breached
    int    high_breach_time
    int    high_first_breach_bar
    bool   low_breached
    int    low_breach_time
    int    low_first_breach_bar
    // ─── Per-tier pattern-used flags (prevents duplicate zones per tier) ───
    bool   high_used_by_pattern_1
    bool   high_used_by_pattern_2
    bool   high_used_by_pattern_3
    bool   low_used_by_pattern_1
    bool   low_used_by_pattern_2
    bool   low_used_by_pattern_3

type LiquidityPoolCollection
    // ─── Finalized sessions ───
    array<PoolLevel> levels
    // ─── Forming session ───
    float current_high
    float current_low
    int   current_high_time
    int   current_low_time
    // ─── Performance pointers ───
    int   first_unbreached_high_index
    int   first_unbreached_low_index
    float min_unbreached_high
    float max_unbreached_low

// ─── Backfill Batch Types ───
// UDTs for batching historical H/L pairs through request.security.
// Each field counts as one tuple element; 40 fields (20 H + 20 L) stays well under Pine's 127 limit.
