po3_divider_style_in   = input.string("····", "", options=["⎯⎯⎯", "----", "····"], group=GROUP_PO3_CANDLES, inline="po3_div")
po3_show_times         = input.bool(false, "Show Times", group=GROUP_PO3_CANDLES)

// ─── 📊 PO3 FVGs ───
show_po3_fvgs          = input.bool(false, "Show FVGs", group=GROUP_PO3_FVGS, inline="po3_fvg")
po3_fvg_bull_color     = input.color(color.new(color.rgb(184, 184, 184), 75), "+", group=GROUP_PO3_FVGS, inline="po3_fvg")
po3_fvg_bear_color     = input.color(color.new(color.rgb(184, 184, 184), 75), "−", group=GROUP_PO3_FVGS, inline="po3_fvg")
