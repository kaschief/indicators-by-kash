po3_label_align        = input.string("Top", "Alignment", options=["Off", "Top", "Bottom"], group=GROUP_PO3_ANNOT, inline="po3_align", tooltip="Align all PO3 tier labels at the same height.\nOff: labels follow their own tier.\nTop/Bottom: all tiers align to the highest/lowest point.")
