enable_volume   = input.bool(false, "Volume", group=GROUP_GAP_SOURCES, inline="src1")

enable_invalidation = input.bool(true, "Enable", group=GROUP_INVALIDATION, inline="mbz_inv")
invalidation_mode = input.string(MBZ_INVALIDATION_STRICT, "MBZ", options=[MBZ_INVALIDATION_STANDARD, MBZ_INVALIDATION_CONSERVATIVE, MBZ_INVALIDATION_STRICT, MBZ_INVALIDATION_CUSTOM], group=GROUP_INVALIDATION, inline="mbz_inv")
custom_threshold_percent = input.float(50, "Custom %", minval=1, maxval=100, step=1, group=GROUP_INVALIDATION, inline="mbz_inv")
sif_invalidation_mode = input.string(SIF_INVALIDATION_STRICT, "SIF", options=[SIF_INVALIDATION_STRICT, SIF_INVALIDATION_LENIENT, SIF_INVALIDATION_CUSTOM], group=GROUP_INVALIDATION, inline="sif_inv")
sif_custom_threshold_percent = input.float(99, "Custom %", minval=1, maxval=100, step=1, group=GROUP_INVALIDATION, inline="sif_inv")

const string AT_RISK_OFF     = "Off"
const string AT_RISK_FADE    = "Fade"
const string AT_RISK_WARNING = "Warning"
const string AT_RISK_BREACH  = "Breach line"
at_risk_mode = input.string(AT_RISK_OFF, "At-Risk", options=[AT_RISK_OFF, AT_RISK_FADE, AT_RISK_WARNING, AT_RISK_BREACH], group=GROUP_INVALIDATION, tooltip="Visual signal when the live HTF wick has penetrated a zone deeply enough that, if the HTF candle closed at the current wick extreme, the zone would invalidate per its component's MBZ/SIF threshold above. No separate threshold — this reuses your existing invalidation settings.")

max_htf_candles  = input.int(200, "Gap/SIF HTF Lookback", minval=5, maxval=200, group=GROUP_ADVANCED, tooltip='How many HTF candles back to scan for FVG gaps, MBZ/SIF zone formation, and invalidation.\n\nGaps and zones older than this are removed.\n\nOnly affects gap-based detection (FVG, implied, volume). Liquidity pool depth is separate — see Daily Scan Cap in MBZ Detection.')

WORKSPACE_DEFAULT_NEAREST = 1
WORKSPACE_FADE_OPACITY = 80

NY_TIMEZONE = "America/New_York"
AUTO_WS_TIMEFRAMES = array.from("1", "2", "3", "5", "15", "60")
AUTO_WS_START_HOUR = 8
AUTO_WS_END_HOUR = 13

workspace_mode_enabled = input.bool(false, "Enable Workspace Mode", group=GROUP_ADVANCED, inline="ws_mode")
auto_workspace_enabled = input.bool(false, "Auto Workspace", group=GROUP_ADVANCED, inline="ws_mode")
workspace_nearest_bull = input.int(WORKSPACE_DEFAULT_NEAREST, "+", minval=0, maxval=10, group=GROUP_ADVANCED, inline="ws_nearest")
workspace_nearest_bear = input.int(WORKSPACE_DEFAULT_NEAREST, "-", minval=0, maxval=10, group=GROUP_ADVANCED, inline="ws_nearest")
workspace_exclude_vi_only = input.bool(true, "Exclude VI-Only Zones", group=GROUP_ADVANCED, inline="vi_opts")

is_auto_ws_timeframe = array.includes(AUTO_WS_TIMEFRAMES, timeframe.period)
ny_hour = hour(time, NY_TIMEZONE)
ny_dow = dayofweek(time, NY_TIMEZONE)
is_weekday = ny_dow >= dayofweek.monday and ny_dow <= dayofweek.friday
is_auto_ws_time_window = is_weekday and ny_hour >= AUTO_WS_START_HOUR and ny_hour < AUTO_WS_END_HOUR
workspace_active = workspace_mode_enabled or (auto_workspace_enabled and is_auto_ws_timeframe and is_auto_ws_time_window)

const string GAP_DISPLAY_OFF        = "Off"
const string GAP_DISPLAY_ALL        = "All Gaps"
const string GAP_DISPLAY_MBZ_SOURCE = "MBZ Source Only"
const string GAP_DISPLAY_SIF_SOURCE = "SIF Source Only"

gap_display_mode = input.string(GAP_DISPLAY_OFF, "Show Gaps", options=[GAP_DISPLAY_OFF, GAP_DISPLAY_ALL, GAP_DISPLAY_MBZ_SOURCE, GAP_DISPLAY_SIF_SOURCE], group=GROUP_ADVANCED)
show_status_table = input.bool(true, "Show Status Table", group=GROUP_ADVANCED, inline="status")
status_table_offset = input.int(100, "Offset", minval=-300, maxval=300, group=GROUP_ADVANCED, inline="status")
show_htf_candles = input.bool(false, "Show HTF Candles", group=GROUP_ADVANCED, inline="debug_viz")
disable_vi_suppression = input.bool(true, "Disable VI Suppression", group=GROUP_ADVANCED, inline="vi_opts")
pool_debug_mode = input.string("Off", "Pool Debug", options=["Off", "Daily", "Weekly", "Monthly", "4h", "1h", "15m", "Asia", "London", "NYAM", "Lunch", "NYPM", "ONS", "Premarket", "Asia-9", "London-9", "NYPM-9"], group=GROUP_ADVANCED)
show_color_table = input.bool(false, "Show Color Table", group=GROUP_ADVANCED, inline="debug_viz")


if enable_liq_pools and not enable_liq_imm and not enable_liq_std and not enable_liq_del
    enable_liq_std := true

current_tf_minutes = timeframe.in_seconds() / 60
var bool is_247_asset = true
var bool detection_completed = false

if not detection_completed
    bars_in_7_days = math.ceil(10080 / current_tf_minutes)
    if bar_index >= bars_in_7_days
        current_day = dayofweek(time, NY_TIMEZONE)
        current_hour_detect = hour(time, NY_TIMEZONE)
        is_saturday_now = current_day == dayofweek.saturday
        is_early_sunday_now = current_day == dayofweek.sunday and current_hour_detect < SUNDAY_REOPEN_START_HOUR
        if is_saturday_now or is_early_sunday_now
            is_247_asset := true
        else
            // TODO: migrate to request.security(syminfo.tickerid, "D", dayofweek) — TF-independent, no buffer pressure.
            // Scale step so 299 samples span the full 7-day window on every TF, while every subscript stays ≤299 (Pine's default buffer).
            int step = math.max(1, math.ceil(bars_in_7_days / 299.0))
            int iters = math.min(299, math.ceil(bars_in_7_days / step))
            found_weekend_bar = false
            for i = 0 to iters
                int lookback = i * step
                if lookback > 299
                    break
                check_day = dayofweek(time[lookback], NY_TIMEZONE)
                check_hour_detect = hour(time[lookback], NY_TIMEZONE)
                is_saturday = check_day == dayofweek.saturday
                is_early_sunday = check_day == dayofweek.sunday and check_hour_detect < SUNDAY_REOPEN_START_HOUR
                if is_saturday or is_early_sunday
                    found_weekend_bar := true
                    break
            is_247_asset := found_weekend_bar
        detection_completed := true

effective_daily_boundary = is_247_asset ? DAILY_BOUNDARY_CALENDAR : daily_boundary_mode
use_exchange_session = effective_daily_boundary == DAILY_BOUNDARY_EXCHANGE

color BULL_BORDER = color.new(color.from_gradient(50, 0, 100, color.new(color.rgb(165, 214, 167), 74), color.new(color.rgb(165, 214, 167), 85)), 60)
color BEAR_BORDER = color.new(color.from_gradient(50, 0, 100, color.new(color.rgb(244, 143, 177), 74), color.new(color.rgb(252, 203, 205), 80)), 60)

string ZONE_LABEL_SIZE_RESOLVED = switch zone_label_size
    "Tiny"   => size.tiny
    "Small"  => size.small
    "Normal" => size.normal
    "Large"  => size.large
    "Huge"   => size.huge
    => size.large

string ZONE_MIDLINE_STYLE = switch zone_midline_style_in
    "----" => line.style_dashed
    "····" => line.style_dotted
    => line.style_solid

string SECONDARY_BORDER_STYLE = switch secondary_border_style_in
    "Dashed" => line.style_dashed
    "Dotted" => line.style_dotted
    => line.style_solid

const string VALIDATION_LINE_STYLE = line.style_dotted
const int VALIDATION_LINE_WIDTH = 3
const int VALIDATION_LINE_TRANS = 65
const int SECONDARY_VALIDATION_TRANS_BUMP = 15
const int SECONDARY_BORDER_WIDTH = 1

float MBZ_INVALIDATION_THRESHOLD = switch invalidation_mode
    MBZ_INVALIDATION_STANDARD     => MBZ_THRESHOLD_STANDARD
    MBZ_INVALIDATION_CONSERVATIVE => MBZ_THRESHOLD_CONSERVATIVE
    MBZ_INVALIDATION_STRICT       => MBZ_THRESHOLD_STRICT
    MBZ_INVALIDATION_CUSTOM       => custom_threshold_percent
    => MBZ_THRESHOLD_STANDARD

float SIF_INVALIDATION_THRESHOLD = switch sif_invalidation_mode
    SIF_INVALIDATION_STRICT  => SIF_THRESHOLD_STRICT
    SIF_INVALIDATION_LENIENT => SIF_THRESHOLD_LENIENT
    SIF_INVALIDATION_CUSTOM  => sif_custom_threshold_percent
    => SIF_THRESHOLD_STRICT

int CANDLE_BOX_USAGE = show_htf_candles ? max_htf_candles * 2 : 0
int MAX_FVGS = DRAW_LIMIT - CANDLE_BOX_USAGE - DRAW_BUFFER
int MAX_ZONES = 100

// ═══════════════════════════════════════════════════════════════════════════════
// TYPES
// ═══════════════════════════════════════════════════════════════════════════════

type HTFCandle
    box   wick
    box   body
    int   start_time

type PO3CandleData
    float  o
    float  h
    float  l
    float  c
    int    t

type PO3Chart
    string htf_label
    int    slot_index
    int    max_candles
    int    offset
    int    spacing
    color  bull_body
    color  bull_border
    color  bull_wick
    color  bear_body
    color  bear_border
    color  bear_wick
    bool   show_label
    color  label_color
    string label_size
    bool   show_dividers
    color  divider_color
    bool   show_mbz
    color  mbz_bull_highlight
    color  mbz_bear_highlight
    bool   show_sif
    color  sif_bull_highlight
    color  sif_bear_highlight
    color  mbz_zone_bull
    color  mbz_zone_bear
    color  sif_zone_bull
    color  sif_zone_bear
    color  midline_color
    bool   is_overlay
    int    htf_ms
    int    zone_ext
    float  highest_point
    float  lowest_point
    array<PO3CandleData> data
    array<box>           bodies
    array<line>          wicks
    array<line>          dividers
    array<box>           highlights
    array<box>           zone_boxes
    array<line>          zone_midlines
    array<label>         zone_labels
    array<box>           fvg_boxes
    box                  forming_body
    line                 forming_wick
    label                tf_label

type TapCandidate
    int    bar_index
    int    bar_time
    float  body_top
    float  body_bottom
    bool   is_bullish

type GapData
    float  top
    float  bottom
    float  ce
    int    bar_index
    int    start_time
    int    formation_end_time
    bool   is_bullish
    string gap_type
    int    gap_id
    bool   is_inverted
    int    inverted_time
    TapCandidate sif_body_tapper
    int    mbz_ref_time
    bool   mbz_is_bullish
    box    gap_box
    line   ce_line
    label  tf_label

type MBZFormationMatch
    bool   is_bullish
    string subtype
    int    source_gap_id
    string source_gap_type

type CandleZone
    int    bar_index
    int    formation_time
    float  candle_open
    float  candle_close
    float  candle_high
    float  candle_low
    bool   is_bullish
    string zone_subtype
    bool   has_mbz
    bool   has_sif
    float  zone_top
    float  zone_bottom
    array<int>    source_gap_ids
    array<string> source_gap_types
    bool   is_invalidated
    bool   mbz_invalidated
    bool   sif_invalidated
    float  ref_candle_high
    float  ref_candle_low
    bool   is_wick_extended
    string liq_formation_rule
    bool   has_gap_mbz
    bool   is_immediate_sif
