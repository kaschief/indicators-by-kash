color BULL_BORDER = color.new(color.from_gradient(50, 0, 100, htf_bull_body_color, htf_bull_wick_color), 60)
color BEAR_BORDER = color.new(color.from_gradient(50, 0, 100, htf_bear_body_color, htf_bear_wick_color), 60)

// Resolve label size from string to Pine constant
string ZONE_LABEL_SIZE_RESOLVED = switch zone_label_size
    "Tiny"   => size.tiny
    "Small"  => size.small
    "Normal" => size.normal
    "Large"  => size.large
    "Huge"   => size.huge
    => size.large

// Resolve MBZ invalidation threshold based on mode
float MBZ_INVALIDATION_THRESHOLD = switch invalidation_mode
    INVALIDATION_STANDARD     => MBZ_THRESHOLD_STANDARD
    INVALIDATION_CONSERVATIVE => MBZ_THRESHOLD_CONSERVATIVE
    INVALIDATION_STRICT       => MBZ_THRESHOLD_STRICT
    INVALIDATION_CUSTOM       => custom_threshold_percent
    => MBZ_THRESHOLD_STANDARD

// Resolve SIF invalidation threshold based on mode
float SIF_INVALIDATION_THRESHOLD = switch sif_invalidation_mode
    SIF_INVALIDATION_STRICT  => SIF_THRESHOLD_STRICT
    SIF_INVALIDATION_LENIENT => SIF_THRESHOLD_LENIENT
    SIF_INVALIDATION_CUSTOM  => sif_custom_threshold_percent
    => SIF_THRESHOLD_STRICT

// Smart FVG limit based on candle overlay usage
// Candles use 2 boxes each (wick + body), FVGs use 1 box each
int CANDLE_BOX_USAGE = show_htf_candles ? max_htf_candles * 2 : 0
int MAX_FVGS = DRAW_LIMIT - CANDLE_BOX_USAGE - DRAW_BUFFER

// ═══════════════════════════════════════════════════════════════════════════════
// TYPES
// ═══════════════════════════════════════════════════════════════════════════════

type HTFCandle
    box   wick
    box   body
    int   start_time

// Candle that interacted with gap (for tap/inversion tracking)
type TapCandidate
    int    bar_index
    int    bar_time
    float  body_top
    float  body_bottom
    bool   is_bullish

// Unified gap data for all gap types (FVG, Implied, VI)
type GapData
    // ─── Core geometry ───
    float  top
    float  bottom
    float  ce                    // Consequent encroachment (midpoint)
    int    bar_index             // Bar index when gap completed
    int    start_time            // Time of first candle in formation
    int    formation_end_time    // Time of completion candle
    bool   is_bullish
    string gap_type              // "fvg", "implied", "volume"
    int    gap_id
    // ─── Gap state ───
    bool   is_inverted           // Gap closed (price closed through)
    int    inverted_time
    bool   is_breakaway          // Gap breaks trend range
    // ─── SIF tap tracking (body-based, NOT wick-based like MBZ) ───
    TapCandidate sif_body_tapper    // First candle whose BODY enters gap (SIF definition)
    // ─── MBZ tracking ───
    int    mbz_ref_time          // When MBZ formed, freeze box at reference candle time
    bool   mbz_is_bullish        // Direction of MBZ that formed (for direction filter)
    // ─── Visual elements ───
    box    gap_box
    line   ce_line
    label  tf_label

// MBZ tracking (mirrors MBZ-Core MBZRecord structure)
type MBZRecord
    int    bar_index
    int    formation_time       // Bar time when MBZ formed (for xloc.bar_time positioning)
    float  high_price           // MBZ candle high
    float  low_price            // MBZ candle low
    float  ref_candle_high      // Reference candle high
    float  ref_candle_low       // Reference candle low
    float  mbz_open             // MBZ candle open
    float  mbz_close            // MBZ candle close
    bool   is_bullish
    bool   is_invalidated
    string mbz_subtype          // "standard", "inclusion", "reflection"
    float  cached_zone_top      // Pre-calculated zone boundary
    float  cached_zone_bottom   // Pre-calculated zone boundary
    int    source_gap_id        // Reference to source FVG
    string source_gap_type      // "fvg" or "implied"
    box    mbz_box              // Visual box for the MBZ zone

// MBZ Formation Match (for multi-source consolidated candles support)
type MBZFormationMatch
    bool   is_bullish
    string subtype
    int    source_gap_id
    string source_gap_type

// ═══════════════════════════════════════════════════════════════════════════════
// UNIFIED CANDLE ZONE TYPE
// ═══════════════════════════════════════════════════════════════════════════════
// Agnostic container for both MBZ and SIF zones
// Zone geometry comes from formation candle, not from source gap

type CandleZone
    // ─── Formation candle geometry (same for both MBZ and SIF) ───
    int    bar_index
    int    formation_time
    float  candle_open
    float  candle_close
    float  candle_high
    float  candle_low

    // ─── Zone classification ───
    bool   is_bullish
    string zone_subtype        // "standard", "inclusion", "reflection"

    // ─── Engine flags (which detection systems validated this zone) ───
    bool   has_mbz             // True if MBZ engine validated this zone
    bool   has_sif             // True if SIF engine validated this zone

    // ─── Cached zone boundaries (calculated from candle geometry) ───
    float  zone_top
    float  zone_bottom

    // ─── Source gap references (may have multiple sources) ───
    array<int>    source_gap_ids      // All gap IDs that contributed to this zone
    array<string> source_gap_types    // Corresponding gap types ("fvg", "implied", "volume")

    // ─── State ───
    bool   is_invalidated
    bool   mbz_invalidated     // MBZ-specific invalidation state
    bool   sif_invalidated     // SIF-specific invalidation state

    // ─── MBZ-specific fields ───
    float  ref_candle_high     // Reference candle high (for wick extension)
    float  ref_candle_low      // Reference candle low (for wick extension)
    bool   is_wick_extended    // True if zone was extended to reference wick

    // ─── SIF-specific fields ───
    bool   is_immediate_sif    // True if first tap AND inversion same candle

    // ─── Visual elements ───
    box    zone_box

// Unified zone storage (declared early so functions can reference it)
var array<CandleZone> zone_array = array.new<CandleZone>()

// ═══════════════════════════════════════════════════════════════════════════════
// UNIFIED ZONE FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// Unified subtype detection for both MBZ and SIF zones
// Analyzes candle shape to determine zone geometry type
// Returns [subtype, has_dominant_wick]
detect_zone_subtype(float candle_open, float candle_close, float candle_high, float candle_low) =>
    if candle_open == candle_close
        [SUBTYPE_STANDARD, false]  // Doji = standard
    else
        float body_top = math.max(candle_open, candle_close)
        float body_bot = math.min(candle_open, candle_close)
        float body_size = body_top - body_bot
        float upper_wick = candle_high - body_top
        float lower_wick = body_bot - candle_low
        bool is_bullish = candle_close > candle_open

        // Check wick dominance (≥80% of body)
        float upper_ratio = body_size > 0 ? upper_wick / body_size : 0
        float lower_ratio = body_size > 0 ? lower_wick / body_size : 0
        float max_ratio = math.max(upper_ratio, lower_ratio)
        bool has_dominant = max_ratio >= WICK_DOMINANCE_THRESHOLD

        if not has_dominant
            [SUBTYPE_STANDARD, false]
        else
            // Determine which wick is dominant
            bool upper_dominant = upper_wick > lower_wick

            // Subtype logic (same for MBZ and SIF):
            // Bullish candle + upper wick dominant = Reflection
            // Bullish candle + lower wick dominant = Inclusion
            // Bearish candle + upper wick dominant = Inclusion
            // Bearish candle + lower wick dominant = Reflection
            string subtype = ""
            if is_bullish
                subtype := upper_dominant ? SUBTYPE_REFLECTION : SUBTYPE_INCLUSION
            else
                subtype := upper_dominant ? SUBTYPE_INCLUSION : SUBTYPE_REFLECTION

            [subtype, true]

// Unified zone boundary calculation for both MBZ and SIF
// Calculates zone top/bottom from candle geometry based on subtype
// ref_high/ref_low used for MBZ wick extension (set to na for SIF)
// Returns [zone_top, zone_bottom, is_extended]
calculate_zone_boundaries(float candle_open, float candle_close, float candle_high, float candle_low, bool is_bullish, string subtype, float ref_high, float ref_low, bool allow_wick_extension) =>
    float body_top = math.max(candle_open, candle_close)
    float body_bot = math.min(candle_open, candle_close)
    bool is_extended = false

    if subtype == SUBTYPE_INCLUSION
        // Inclusion: Close to dominant wick
        if is_bullish
            // Bullish inclusion: lower boundary may extend to reference low
            if allow_wick_extension and not na(ref_low) and ref_low < candle_low
                is_extended := true
                [candle_close, ref_low, is_extended]
            else
                [candle_close, candle_low, is_extended]
        else
            // Bearish inclusion: upper boundary may extend to reference high
            if allow_wick_extension and not na(ref_high) and ref_high > candle_high
                is_extended := true
                [ref_high, candle_close, is_extended]
            else
                [candle_high, candle_close, is_extended]
    else if subtype == SUBTYPE_REFLECTION
        // Reflection: Mirror wick distance from open, projected from close
        if is_bullish
            float wick_range = math.abs(candle_high - candle_open)
            // Bullish reflection: lower boundary may extend to reference low
            if allow_wick_extension and not na(ref_low) and ref_low < candle_low
                is_extended := true
                [candle_close, ref_low, is_extended]
            else
                [candle_close, candle_close - wick_range, is_extended]
        else
            float wick_range = math.abs(candle_low - candle_open)
            // Bearish reflection: upper boundary may extend to reference high
            if allow_wick_extension and not na(ref_high) and ref_high > candle_high
                is_extended := true
                [ref_high, candle_close, is_extended]
            else
                [candle_close + wick_range, candle_close, is_extended]
    else
        // Standard: Body only, with optional reference wick extension
        if allow_wick_extension
            if is_bullish
                // Bullish: extend lower boundary to reference low if lower
                if not na(ref_low) and ref_low < candle_low
                    is_extended := true
                    [body_top, ref_low, is_extended]
                else
                    [body_top, body_bot, is_extended]
            else
                // Bearish: extend upper boundary to reference high if higher
                if not na(ref_high) and ref_high > candle_high
                    is_extended := true
                    [ref_high, body_bot, is_extended]
                else
                    [body_top, body_bot, is_extended]
        else
            [body_top, body_bot, is_extended]

// Factory function to create a CandleZone from formation candle data
// has_mbz/has_sif: which engine(s) validated this zone
// For MBZ: provide ref_high/ref_low for wick extension
// For SIF: is_immediate_sif indicates immediate SIF
create_candle_zone(int formation_bar_index, int formation_time, float candle_open, float candle_close, float candle_high, float candle_low, bool is_bullish, array<int> gap_ids, array<string> gap_types, float ref_high, float ref_low, bool allow_wick_extension, bool has_mbz, bool has_sif, bool is_immediate_sif) =>
    // Detect subtype from candle shape
    [subtype, _has_dominant] = detect_zone_subtype(candle_open, candle_close, candle_high, candle_low)

    // Calculate zone boundaries
    [zone_top, zone_bottom, is_extended] = calculate_zone_boundaries(candle_open, candle_close, candle_high, candle_low, is_bullish, subtype, ref_high, ref_low, allow_wick_extension)

    // Create zone record
    CandleZone zone = CandleZone.new()
    zone.bar_index := formation_bar_index
    zone.formation_time := formation_time
    zone.candle_open := candle_open
    zone.candle_close := candle_close
    zone.candle_high := candle_high
    zone.candle_low := candle_low
    zone.is_bullish := is_bullish
    zone.zone_subtype := subtype
    zone.has_mbz := has_mbz
    zone.has_sif := has_sif
    zone.zone_top := zone_top
    zone.zone_bottom := zone_bottom
    zone.source_gap_ids := gap_ids
    zone.source_gap_types := gap_types
    zone.is_invalidated := false
    zone.mbz_invalidated := false
    zone.sif_invalidated := false
    zone.ref_candle_high := ref_high
    zone.ref_candle_low := ref_low
    zone.is_wick_extended := is_extended
    zone.is_immediate_sif := is_immediate_sif

    zone

// Find existing zone for a candle by formation_time
// Returns index in zone_array, or -1 if not found
find_zone_index_for_candle(int formation_time) =>
    int result = -1
    if array.size(zone_array) > 0
        for i = 0 to array.size(zone_array) - 1
            CandleZone z = array.get(zone_array, i)
            if z.formation_time == formation_time
                result := i
                break
    result

// Get or create zone for a candle
// If zone exists, returns it for updating
// If not, creates new zone and adds to array
// Note: Caller must update the zone and call array.set() after modifications
get_or_create_zone(int formation_bar_index, int formation_time, float candle_open, float candle_close, float candle_high, float candle_low, bool is_bullish, float ref_high, float ref_low, bool allow_wick_extension) =>
    int existing_idx = find_zone_index_for_candle(formation_time)

    if existing_idx >= 0
        // Return existing zone
        [array.get(zone_array, existing_idx), existing_idx, false]
    else
        // Create new zone with empty source arrays
        array<int> gap_ids = array.new<int>()
        array<string> gap_types = array.new<string>()

        CandleZone new_zone = create_candle_zone(formation_bar_index, formation_time, candle_open, candle_close, candle_high, candle_low, is_bullish, gap_ids, gap_types, ref_high, ref_low, allow_wick_extension, false, false, false)

        array.unshift(zone_array, new_zone)
        [new_zone, 0, true]

// Add source gap to zone's source arrays (avoids duplicates)
add_source_to_zone(CandleZone zone, int gap_id, string gap_type) =>
    // Check if already present
    bool already_present = false
    if array.size(zone.source_gap_ids) > 0
        for i = 0 to array.size(zone.source_gap_ids) - 1
            if array.get(zone.source_gap_ids, i) == gap_id
                already_present := true
                break

    if not already_present
        array.push(zone.source_gap_ids, gap_id)
        array.push(zone.source_gap_types, gap_type)

// ═══════════════════════════════════════════════════════════════════════════════
// STATE VARIABLES
// ═══════════════════════════════════════════════════════════════════════════════

// HTF OHLC tracking - current forming candle
var float htf_open  = 0.0
var float htf_high  = 0.0
var float htf_low   = 0.0
var int   htf_time  = 0

// HTF candle history [1], [2], [3] - full OHLC for implied FVG detection
var float htf_o1 = 0.0, var float htf_h1 = 0.0, var float htf_l1 = 0.0, var float htf_c1 = 0.0, var int htf_t1 = 0
var float htf_o2 = 0.0, var float htf_h2 = 0.0, var float htf_l2 = 0.0, var float htf_c2 = 0.0, var int htf_t2 = 0
var float htf_o3 = 0.0, var float htf_h3 = 0.0, var float htf_l3 = 0.0, var float htf_c3 = 0.0, var int htf_t3 = 0
var float htf_o4 = 0.0, var float htf_h4 = 0.0, var float htf_l4 = 0.0, var float htf_c4 = 0.0  // Extra for displacement lookback
var float htf_o5 = 0.0, var float htf_h5 = 0.0, var float htf_l5 = 0.0, var float htf_c5 = 0.0  // Extra for displacement lookback

// Current candle boxes
var box wick_box = na
var box body_box = na

// Track previous wick boxes for MBZ highlighting
// At MBZ check: prev_wick_box = htf_*1's box (MBZ), prev_prev_wick_box = htf_*2's box (reference)
var box prev_wick_box = na
var box prev_prev_wick_box = na

// Storage arrays
var array<HTFCandle> candle_boxes = array.new<HTFCandle>()
var array<GapData>   gap_array    = array.new<GapData>()
var array<MBZRecord> mbz_array    = array.new<MBZRecord>()  // MBZ records (mirrors MBZ-Core all_mbz_records)
var array<int>       htf_times    = array.new<int>()  // Track HTF candle times for window (independent of display)
var array<box>       inversion_highlights = array.new<box>()  // Visual debug: highlight candles that invert gaps
var array<box>       tap_highlights = array.new<box>()  // Visual debug: highlight first tapper candles
var int next_gap_id = 1  // Unique ID counter for gap tracking (mirrors MBZ-Core)

// HTF boundary detection
bool new_htf = IS_VALID ? ta.change(time(HTF_STRING)) != 0 : false

// ═══════════════════════════════════════════════════════════════════════════════
// FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════════
// MBZ LABEL TEXT
// ═══════════════════════════════════════════════════════════════════════════════

// Convert HTF label to bold Unicode
get_bold_htf_label() =>
    switch HTF_LABEL
        "15m" => "𝟭𝟱𝗺"
        "1H"  => "𝟭𝗛"
        "4H"  => "𝟰𝗛"
        "D"   => "𝗗"
        "W"   => "𝗪"
        => HTF_LABEL

// Build MBZ box label text: MBZ⁺·{𝗧𝗙} with optional source type on new line
// Mirrors MBZ-Core's build_source_breakdown_extension_from_stats logic exactly
build_mbz_box_label(bool is_bullish, array<string> source_gap_types) =>
    string direction_suffix = is_bullish ? MBZ_BULLISH_SUFFIX : MBZ_BEARISH_SUFFIX
    // Regular MBZ + Bold TF: MBZ⁺·𝟰𝗛
    string result = "MBZ" + direction_suffix + "·" + get_bold_htf_label()

    int num_sources = array.size(source_gap_types)
    if num_sources == 0
        result
    else
        // Count each type (mirrors MBZ-Core SourceTypeStats)
        int fvg_count = 0
        int imp_count = 0
        int vol_count = 0

        for i = 0 to num_sources - 1
            string src = array.get(source_gap_types, i)
            if src == GAP_TYPE_FVG
                fvg_count += 1
            else if src == GAP_TYPE_IMPLIED
                imp_count += 1
            else if src == GAP_TYPE_VOLUME
                vol_count += 1

        // Count distinct types
        int distinct_types = (fvg_count > 0 ? 1 : 0) + (imp_count > 0 ? 1 : 0) + (vol_count > 0 ? 1 : 0)

        string source_type_text = ""

        if distinct_types == 1
            // Single type: show type with multiplier if count > 1 (FVG shows nothing if count == 1)
            if fvg_count > 0
                if fvg_count == 1
                    source_type_text := ""
                else
                    source_type_text := GAP_SOURCE_FVG_BREAKDOWN_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(fvg_count)
            else if imp_count > 0
                if imp_count == 1
                    source_type_text := "ⁱᵐᵖ"  // Superscript for single implied
                else
                    source_type_text := GAP_SOURCE_IMPLIED_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(imp_count)
            else if vol_count > 0
                if vol_count == 1
                    source_type_text := "ᵛᵒˡ"  // Superscript for single volume
                else
                    source_type_text := GAP_SOURCE_VOLUME_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(vol_count)
        else
            // Multiple distinct types: show "count: type1, type2" format (mirrors MBZ-Core)
            array<string> parts = array.new<string>()

            if fvg_count > 0
                array.push(parts, fvg_count == 1 ? GAP_SOURCE_FVG_BREAKDOWN_DISPLAY : GAP_SOURCE_FVG_BREAKDOWN_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(fvg_count))
            if imp_count > 0
                array.push(parts, imp_count == 1 ? GAP_SOURCE_IMPLIED_DISPLAY : GAP_SOURCE_IMPLIED_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(imp_count))
            if vol_count > 0
                array.push(parts, vol_count == 1 ? GAP_SOURCE_VOLUME_DISPLAY : GAP_SOURCE_VOLUME_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(vol_count))

            string breakdown = array.join(parts, BREAKDOWN_SEPARATOR)
            source_type_text := str.tostring(num_sources) + COUNT_SEPARATOR + breakdown

        // Add source type on new line if not empty
        if str.length(source_type_text) > 0
            result := result + "\n" + source_type_text

        result

// Calculate MBZ zone boundaries based on subtype (from MBZ-Core get_mbz_subtype_zone)
// Now includes reference wick extension (mirrors MBZ-Core extend_to_reference_wick)
// Returns [zone_top, zone_bottom]
get_mbz_zone(float mbz_open, float mbz_high, float mbz_low, float mbz_close, bool is_bullish, string subtype, float ref_high, float ref_low) =>
    float body_top = math.max(mbz_open, mbz_close)
    float body_bot = math.min(mbz_open, mbz_close)

    if subtype == SUBTYPE_INCLUSION
        // Inclusion: Close to dominant wick
        if is_bullish
            // Bullish inclusion: lower boundary may extend to reference low
            if extend_to_reference_wick and ref_low < mbz_low
                [mbz_close, ref_low]
            else
                [mbz_close, mbz_low]
        else
            // Bearish inclusion: upper boundary may extend to reference high
            if extend_to_reference_wick and ref_high > mbz_high
                [ref_high, mbz_close]
            else
                [mbz_high, mbz_close]
    else if subtype == SUBTYPE_REFLECTION
        // Reflection: Mirror wick distance from open, projected from close
        if is_bullish
            float wick_range = math.abs(mbz_high - mbz_open)
            // Bullish reflection: lower boundary may extend to reference low
            if extend_to_reference_wick and ref_low < mbz_low
                [mbz_close, ref_low]
            else
                [mbz_close, mbz_close - wick_range]
        else
            float wick_range = math.abs(mbz_low - mbz_open)
            // Bearish reflection: upper boundary may extend to reference high
            if extend_to_reference_wick and ref_high > mbz_high
                [ref_high, mbz_close]
            else
                [mbz_close + wick_range, mbz_close]
    else
        // Standard: Body only, with optional reference wick extension
        if extend_to_reference_wick
            if is_bullish
                // Bullish: extend lower boundary to reference low if lower
                if ref_low < mbz_low
                    [body_top, ref_low]
                else
                    [body_top, body_bot]
            else
                // Bearish: extend upper boundary to reference high if higher
                if ref_high > mbz_high
                    [ref_high, body_bot]
                else
                    [body_top, body_bot]
        else
            [body_top, body_bot]

// Build MBZ label text (from MBZ-Core format)
// Format: "MBZ⁺" or "MBZ⁻" with optional subtype
build_mbz_label(bool is_bullish, string subtype, string source_type) =>
    string base = MBZ_BASE_TEXT + (is_bullish ? MBZ_BULLISH_SUFFIX : MBZ_BEARISH_SUFFIX)

    // Add subtype suffix for non-standard
    string subtype_suffix = ""
    if subtype == SUBTYPE_INCLUSION
        subtype_suffix := " inc"
    else if subtype == SUBTYPE_REFLECTION
        subtype_suffix := " ref"

    // Add source type prefix for implied
    string source_prefix = ""
    if source_type == GAP_TYPE_IMPLIED
        source_prefix := "imp "

    source_prefix + base + subtype_suffix

// Build source breakdown text from gap types array
// Returns empty string for single FVG (standard case), otherwise shows breakdown
build_source_breakdown(array<string> source_gap_types) =>
    int num_sources = array.size(source_gap_types)
    if num_sources == 0
        ""
    else
        // Count each type
        int fvg_count = 0
        int imp_count = 0
        int vol_count = 0

        for i = 0 to num_sources - 1
            string src = array.get(source_gap_types, i)
            if src == GAP_TYPE_FVG
                fvg_count += 1
            else if src == GAP_TYPE_IMPLIED
                imp_count += 1
            else if src == GAP_TYPE_VOLUME
                vol_count += 1

        // Count distinct types
        int distinct_types = (fvg_count > 0 ? 1 : 0) + (imp_count > 0 ? 1 : 0) + (vol_count > 0 ? 1 : 0)

        string source_type_text = ""

        if distinct_types == 1
            // Single type: show type with multiplier if count > 1 (FVG shows nothing if count == 1)
            if fvg_count > 0
                if fvg_count == 1
                    source_type_text := ""
                else
                    source_type_text := GAP_SOURCE_FVG_BREAKDOWN_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(fvg_count)
            else if imp_count > 0
                if imp_count == 1
                    source_type_text := "ⁱᵐᵖ"  // Superscript for single implied
                else
                    source_type_text := GAP_SOURCE_IMPLIED_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(imp_count)
            else if vol_count > 0
                if vol_count == 1
                    source_type_text := "ᵛᵒˡ"  // Superscript for single volume
                else
                    source_type_text := GAP_SOURCE_VOLUME_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(vol_count)
        else
            // Multiple distinct types: show "count: type1, type2" format
            array<string> parts = array.new<string>()

            if fvg_count > 0
                array.push(parts, fvg_count == 1 ? GAP_SOURCE_FVG_BREAKDOWN_DISPLAY : GAP_SOURCE_FVG_BREAKDOWN_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(fvg_count))
            if imp_count > 0
                array.push(parts, imp_count == 1 ? GAP_SOURCE_IMPLIED_DISPLAY : GAP_SOURCE_IMPLIED_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(imp_count))
            if vol_count > 0
                array.push(parts, vol_count == 1 ? GAP_SOURCE_VOLUME_DISPLAY : GAP_SOURCE_VOLUME_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(vol_count))

            string breakdown = array.join(parts, BREAKDOWN_SEPARATOR)
            source_type_text := str.tostring(num_sources) + COUNT_SEPARATOR + breakdown

        source_type_text

// Build unified zone label showing which engines validated it
// Format: "𝗠𝗕𝗭·𝗦𝗜𝗙⁺·𝟰𝗛" or "IMM-SIF⁺·𝟰𝗛" or "MBZ⁺·𝟰𝗛" with source breakdown on second line
build_zone_label(CandleZone zone) =>
    string direction_suffix = zone.is_bullish ? "⁺" : "⁻"

    // Build engine prefix
    string engine_prefix = ""
    if zone.has_mbz and zone.has_sif
        engine_prefix := SIF_MBZ_COMBINED_BOLD
    else if zone.has_mbz
        engine_prefix := MBZ_BASE_TEXT
    else if zone.has_sif
        engine_prefix := SIF_LABEL

    string result = engine_prefix + direction_suffix + "·" + get_bold_htf_label()

    // Add source breakdown on new line if not empty
    string source_text = build_source_breakdown(zone.source_gap_types)
    if str.length(source_text) > 0
        result := result + "\n" + source_text

    result

// ─── Body Boundary Helpers (from MBZ-Core) ───
htf_body_top(float o, float c) => math.max(o, c)
htf_body_bot(float o, float c) => math.min(o, c)

// ─── HTF Displacement Candle Check (from MBZ-Core) ───
// Checks if C2 (htf_o2/htf_c2) is a displacement candle relative to C3-C5
is_htf_displacement_candle() =>
    // C2 body size
    float c2_body = math.abs(htf_c2 - htf_o2)

    // Average body size of C3, C4, C5 (lookback candles)
    float c3_body = math.abs(htf_c3 - htf_o3)
    float c4_body = math.abs(htf_c4 - htf_o4)
    float c5_body = math.abs(htf_c5 - htf_o5)
    float avg_body = (c3_body + c4_body + c5_body) / 3.0

    // Require C2 >= multiplier * average
    if avg_body > 0
        c2_body >= (IMPLIED_DISPLACEMENT_MULTIPLIER * avg_body)
    else
        false

// ─── HTF Implied FVG Detection (from MBZ-Core) ───
// Returns [is_valid, bottom, top, is_bullish]
// MBZ-Core convention: C1=[2] oldest, C2=[1] middle, C3=[0] newest
// Our HTF tracking: htf_*3=oldest, htf_*2=middle, htf_*1=newest
// So: MBZ C1 = our htf_*3, MBZ C3 = our htf_*1
detect_htf_implied_fvg() =>
    // Pre-filter: Check displacement candle strength
    if not is_htf_displacement_candle()
        [false, float(na), float(na), bool(na)]
    else
        // Body boundaries (using MBZ-Core naming convention)
        // old = htf_*3 (oldest, like MBZ's C1/[2])
        // new = htf_*1 (newest, like MBZ's C3/[0])
        float old_body_top = htf_body_top(htf_o3, htf_c3)
        float old_body_bot = htf_body_bot(htf_o3, htf_c3)
        float new_body_top = htf_body_top(htf_o1, htf_c1)
        float new_body_bot = htf_body_bot(htf_o1, htf_c1)

        // ─── BULLISH Implied FVG ───
        // Price moved UP: old candle below, new candle above
        // Bodies separate: old body top < new body bottom (gap between)
        // Wicks overlap: old upper wick overlaps new lower wick
        bool bodies_sep_bull = old_body_top < new_body_bot
        bool old_upper_wick_exists = htf_h3 > old_body_top
        bool new_lower_wick_exists = new_body_bot > htf_l1
        bool bull_wicks_valid = bodies_sep_bull and old_upper_wick_exists and new_lower_wick_exists

        float bull_overlap_lo = math.max(old_body_top, htf_l1)
        float bull_overlap_hi = math.min(htf_h3, new_body_bot)
        bool bull_has_overlap = bull_overlap_hi > bull_overlap_lo and bull_wicks_valid

        if bull_has_overlap
            [true, old_body_top, new_body_bot, true]
        else
            // ─── BEARISH Implied FVG ───
            // Price moved DOWN: old candle above, new candle below
            // Bodies separate: new body top < old body bottom (gap between)
            // Wicks overlap: new upper wick overlaps old lower wick
            bool bodies_sep_bear = new_body_top < old_body_bot
            bool new_upper_wick_exists = htf_h1 > new_body_top
            bool old_lower_wick_exists = old_body_bot > htf_l3
            bool bear_wicks_valid = bodies_sep_bear and new_upper_wick_exists and old_lower_wick_exists

            float bear_overlap_lo = math.max(new_body_top, htf_l3)
            float bear_overlap_hi = math.min(htf_h1, old_body_bot)
            bool bear_has_overlap = bear_overlap_hi > bear_overlap_lo and bear_wicks_valid

            if bear_has_overlap
                [true, new_body_top, old_body_bot, false]
            else
                [false, float(na), float(na), false]

// ═══════════════════════════════════════════════════════════════════════════════
// HTF VOLUME IMBALANCE DETECTION (from MBZ-Core)
// ═══════════════════════════════════════════════════════════════════════════════

// Detects 2-candle bullish Volume Imbalance with body separation and wick overlap
// Uses htf_*1 (newest) and htf_*2 (previous) candles
// Condition: htf_*1 body completely above htf_*2 body, but wicks still connect
is_htf_bullish_vi() =>
    float curr_body_bot = htf_body_bot(htf_o1, htf_c1)  // Current body bottom
    float prev_body_top = htf_body_top(htf_o2, htf_c2)  // Previous body top
    bool bodies_separated = curr_body_bot > prev_body_top
    bool wicks_still_connect = htf_l1 <= htf_h2  // Current low reaches previous high
    bodies_separated and wicks_still_connect

// Detects 2-candle bearish Volume Imbalance with body separation and wick overlap
// Uses htf_*1 (newest) and htf_*2 (previous) candles
// Condition: htf_*1 body completely below htf_*2 body, but wicks still connect
is_htf_bearish_vi() =>
    float curr_body_top = htf_body_top(htf_o1, htf_c1)  // Current body top
    float prev_body_bot = htf_body_bot(htf_o2, htf_c2)  // Previous body bottom
    bool bodies_separated = curr_body_top < prev_body_bot
    bool wicks_still_connect = htf_h1 >= htf_l2  // Current high reaches previous low
    bodies_separated and wicks_still_connect

// Calculates Volume Imbalance gap coordinates using 2-candle body separation
// Returns [gap_top, gap_bottom]
get_htf_vi_coordinates(bool is_bullish_gap) =>
    if is_bullish_gap
        // Bullish VI: gap between htf_*2 body top and htf_*1 body bottom
        float gap_bottom = htf_body_top(htf_o2, htf_c2)  // Previous body top
        float gap_top = htf_body_bot(htf_o1, htf_c1)     // Current body bottom
        [gap_top, gap_bottom]
    else
        // Bearish VI: gap between htf_*2 body bottom and htf_*1 body top
        float gap_top = htf_body_bot(htf_o2, htf_c2)     // Previous body bottom
        float gap_bottom = htf_body_top(htf_o1, htf_c1)  // Current body top
        [gap_top, gap_bottom]

// Checks if Volume Imbalance should be suppressed by higher-priority gaps
// Matches SIF-Core's is_gap_overlapping logic exactly:
// VI is suppressed if there's an overlapping FVG or Implied FVG of the same direction that is still open
is_htf_vi_suppressed_by_gaps(float vi_top, float vi_bottom, bool is_vi_bullish) =>
    if array.size(gap_array) == 0
        false  // No existing gaps = no suppression
    else
        bool has_overlap = false
        for i = 0 to array.size(gap_array) - 1
            GapData gap = array.get(gap_array, i)

            // Check for both FVG AND Implied FVG (not volume) - institutional gap hierarchy
            // Matches SIF-Core: (gap.gap_type == GAP_TYPE_FVG or gap.gap_type == GAP_TYPE_IMPLIED)
            bool is_higher_priority = gap.gap_type == GAP_TYPE_FVG or gap.gap_type == GAP_TYPE_IMPLIED
            bool same_direction = gap.is_bullish == is_vi_bullish
            bool is_open = not gap.is_inverted  // Inverted = closed, cannot suppress

            if is_higher_priority and same_direction and is_open
                // Use >= for edge case where VI exactly touches gap boundary (matches SIF-Core)
                if vi_bottom < gap.top and vi_top >= gap.bottom
                    has_overlap := true
                    break  // Found overlap, VI will be suppressed
        has_overlap

// Check gap interactions: first tap and inversion (close through)
// Must be called BEFORE MBZ detection - ALWAYS runs (independent of gap display mode)
// Handles three visual cases:
//   1. First Tapper only: dashed border (cyan=bullish gap, pink=bearish gap)
//   2. Inversion only: solid border (red=bullish gap inverted, green=bearish gap inverted)
//   3. Both (same candle): solid border + fill (immediate SIF)
// Also registers SIF zones when enable_sif_engine is true
check_gap_interactions(float htf_candle_open, float htf_candle_high, float htf_candle_low, float htf_candle_close, int htf_candle_time) =>
    // OPTIMIZATION: Check if any visual toggle is enabled (skip visual tracking if all off)
    bool any_visual_enabled = show_first_tap_only or show_immediate_sif or show_delayed_inversion

    // Track highest priority interaction across ALL gaps for this candle
    // Priority: Immediate SIF > Delayed Inversion > First Tap Only
    // (Per SIF-Core: if candle is immediate SIF for ANY gap, it's classified as immediate SIF)
    bool has_immediate_sif = false
    bool has_delayed_inversion = false
    bool has_first_tap_only = false

    // Track colors based on first interaction of each type (for consistent coloring)
    color immediate_sif_color = na
    color delayed_inv_color = na
    color first_tap_color = na

    // Track gap sources that contribute to SIF (for zone registration)
    array<int> sif_gap_ids = array.new<int>()
    array<string> sif_gap_types = array.new<string>()

    // Body boundaries for tap detection (computed once)
    float body_top = math.max(htf_candle_open, htf_candle_close)
    float body_bottom = math.min(htf_candle_open, htf_candle_close)
    bool is_candle_bullish = htf_candle_close > htf_candle_open
    bool is_candle_bearish = htf_candle_close < htf_candle_open

    if array.size(gap_array) > 0
        // PASS 1: Process all gaps, update state, and determine highest priority interaction
        for i = 0 to array.size(gap_array) - 1
            GapData gap = array.get(gap_array, i)

            // Skip already inverted gaps
            if gap.is_inverted
                continue

            // CRITICAL: The candle that forms the gap cannot tap/invert that same gap
            bool is_gap_forming_candle = htf_candle_time == gap.formation_end_time
            if is_gap_forming_candle
                continue

            // Determine if this candle taps and/or inverts THIS gap
            bool is_first_tap = false
            bool is_inversion = false

            if gap.is_bullish
                // Bullish gap + bearish candle = potential SIF tap
                bool body_enters_from_above = htf_candle_open > gap.top and htf_candle_close < gap.top
                bool body_opens_inside = htf_candle_open <= gap.top and htf_candle_open >= gap.bottom
                bool body_closes_through = htf_candle_open >= gap.bottom and htf_candle_close < gap.bottom
                bool body_enters_gap = is_candle_bearish and (body_enters_from_above or body_opens_inside or body_closes_through)

                // Inversion: CLOSE through gap bottom (SIF Core: close <= gap.bottom)
                bool candle_closes_through = htf_candle_close <= gap.bottom

                if na(gap.sif_body_tapper) and body_enters_gap
                    is_first_tap := true
                if candle_closes_through
                    is_inversion := true
            else
                // Bearish gap + bullish candle = potential SIF tap
                bool body_enters_from_below = htf_candle_open < gap.bottom and htf_candle_close > gap.bottom
                bool body_opens_inside = htf_candle_open >= gap.bottom and htf_candle_open <= gap.top
                bool body_closes_through = htf_candle_open <= gap.top and htf_candle_close > gap.top
                bool body_enters_gap = is_candle_bullish and (body_enters_from_below or body_opens_inside or body_closes_through)

                // Inversion: CLOSE through gap top (SIF Core: close >= gap.top)
                bool candle_closes_through = htf_candle_close >= gap.top

                if na(gap.sif_body_tapper) and body_enters_gap
                    is_first_tap := true
                if candle_closes_through
                    is_inversion := true

            // Record first tapper if this is the first tap
            if is_first_tap
                TapCandidate tapper = TapCandidate.new()
                tapper.bar_index := bar_index
                tapper.bar_time := htf_candle_time
                tapper.body_top := body_top
                tapper.body_bottom := body_bottom
                tapper.is_bullish := is_candle_bullish
                gap.sif_body_tapper := tapper

            // Record inversion
            if is_inversion
                gap.is_inverted := true
                gap.inverted_time := time

                // Track this gap as SIF source (inversion = SIF)
                array.push(sif_gap_ids, gap.gap_id)
                array.push(sif_gap_types, gap.gap_type)

            // Update gap if anything changed
            if is_first_tap or is_inversion
                array.set(gap_array, i, gap)

            // Determine colors based on gap direction
            color tap_color = gap.is_bullish ? TAP_BEARISH_CANDLE_COLOR : TAP_BULLISH_CANDLE_COLOR
            color inv_color = gap.is_bullish ? INVERSION_BEARISH_CANDLE_COLOR : INVERSION_BULLISH_CANDLE_COLOR

            // Track highest priority interaction type
            if is_first_tap and is_inversion
                // Immediate SIF (highest priority)
                has_immediate_sif := true
                if na(immediate_sif_color)
                    immediate_sif_color := inv_color
            else if is_inversion
                // Delayed inversion (second priority)
                has_delayed_inversion := true
                if na(delayed_inv_color)
                    delayed_inv_color := inv_color
            else if is_first_tap
                // First tap only (third priority)
                has_first_tap_only := true
                if na(first_tap_color)
                    first_tap_color := tap_color

        // PASS 2: Register SIF zone ONLY for immediate SIF (first tap + inversion same candle)
        // Delayed inversions don't create zones - they're just gap closures, not SIF formations
        if enable_sif_engine and has_immediate_sif
            // Immediate SIF detected - get or create zone for this candle
            // SIF zones don't use reference wick extension (set ref to na, allow_extension to false)
            [zone, zone_idx, is_new] = get_or_create_zone(bar_index, htf_candle_time, htf_candle_open, htf_candle_close, htf_candle_high, htf_candle_low, is_candle_bullish, float(na), float(na), false)

            // Update zone with SIF flag
            zone.has_sif := true
            zone.is_immediate_sif := true

            // Add all SIF source gaps
            for j = 0 to array.size(sif_gap_ids) - 1
                add_source_to_zone(zone, array.get(sif_gap_ids, j), array.get(sif_gap_types, j))

            // Save updated zone back to array
            array.set(zone_array, zone_idx, zone)

        // PASS 3: Draw ONE highlight based on highest priority interaction (skip if all toggles off)
        if any_visual_enabled
            int highlight_right = htf_candle_time + HTF_MS

            if has_immediate_sif and show_immediate_sif
                // Immediate SIF wins - show thick border with fill
                box highlight = box.new(htf_candle_time, htf_candle_high, highlight_right, htf_candle_low, xloc=xloc.bar_time, bgcolor=color.new(immediate_sif_color, 70), border_color=immediate_sif_color, border_width=3)
                array.push(inversion_highlights, highlight)
            else if has_delayed_inversion and show_delayed_inversion
                // Delayed inversion - show thin border with minimal fill
                box highlight = box.new(htf_candle_time, htf_candle_high, highlight_right, htf_candle_low, xloc=xloc.bar_time, bgcolor=color.new(delayed_inv_color, 90), border_color=delayed_inv_color, border_width=2)
                array.push(inversion_highlights, highlight)
            else if has_first_tap_only and show_first_tap_only
                // First tap only - show dashed border
                box highlight = box.new(htf_candle_time, htf_candle_high, highlight_right, htf_candle_low, xloc=xloc.bar_time, bgcolor=color.new(first_tap_color, 95), border_color=first_tap_color, border_width=2, border_style=line.style_dashed)
                array.push(tap_highlights, highlight)

// Check for MBZ formation (like MBZ-Core: check tap + conviction in single pass)
// prev_* = reference candle (htf_*2 = candle before the one that just completed)
// curr_* = MBZ candle (htf_*1 = candle that just completed)
// ref_time = reference candle's start time (htf_t2) - must be AFTER gap formation
// Returns array of MBZFormationMatch for ALL gaps that form MBZs on this candle
check_mbz_formation(float prev_o, float prev_h, float prev_l, float prev_c, int ref_time, float curr_o, float curr_h, float curr_l, float curr_c) =>
    array<MBZFormationMatch> matches = array.new<MBZFormationMatch>()

    // Previous candle (reference) direction
    bool prev_is_bullish = prev_c > prev_o
    bool prev_is_bearish = prev_c < prev_o

    // Current candle (MBZ) direction
    bool curr_is_bullish = curr_c > curr_o
    bool curr_is_bearish = curr_c < curr_o

    if array.size(gap_array) > 0
        for i = 0 to array.size(gap_array) - 1
            GapData gap = array.get(gap_array, i)

            // Skip closed gaps - inverted gaps are closed and cannot form MBZ
            if gap.is_inverted
                continue

            // CRITICAL: Reference candle must be AFTER gap formation
            // Like MBZ-Core: prev_index <= gap.creation_bar → continue
            // This prevents FVG-forming candles from being detected as MBZ
            if ref_time <= gap.formation_end_time
                continue

            // Check if PREVIOUS candle tapped this gap (like MBZ-Core prev_tapped_gap)
            bool prev_tapped_gap = false

            if gap.is_bullish and prev_is_bearish
                // Bullish gap: bearish candle wick must enter gap
                if prev_l <= gap.top and prev_h >= gap.bottom
                    prev_tapped_gap := true
            else if not gap.is_bullish and prev_is_bullish
                // Bearish gap: bullish candle wick must enter gap
                if prev_h >= gap.bottom and prev_l <= gap.top
                    prev_tapped_gap := true

            // Check for MBZ formation (tap + conviction)
            if prev_tapped_gap
                float prev_body_top = math.max(prev_o, prev_c)
                float prev_body_bot = math.min(prev_o, prev_c)
                float prev_50_percent = (prev_body_top + prev_body_bot) / 2

                // Bullish MBZ: gap bullish, ref bearish, current bullish, close >= 50%
                if gap.is_bullish and prev_is_bearish and curr_is_bullish
                    if curr_c >= prev_50_percent
                        // Mark source FVG - freeze box at reference candle + track MBZ direction
                        gap.mbz_ref_time := ref_time
                        gap.mbz_is_bullish := true
                        array.set(gap_array, i, gap)
                        // Detect subtype from MBZ candle (always on)
                        [detected_subtype, _has_dominant] = detect_zone_subtype(curr_o, curr_c, curr_h, curr_l)
                        // Create match record
                        MBZFormationMatch match = MBZFormationMatch.new()
                        match.is_bullish := true
                        match.subtype := detected_subtype
                        match.source_gap_id := gap.gap_id
                        match.source_gap_type := gap.gap_type
                        array.push(matches, match)

                // Bearish MBZ: gap bearish, ref bullish, current bearish, close <= 50%
                else if not gap.is_bullish and prev_is_bullish and curr_is_bearish
                    if curr_c <= prev_50_percent
                        // Mark source FVG - freeze box at reference candle + track MBZ direction
                        gap.mbz_ref_time := ref_time
                        gap.mbz_is_bullish := false
                        array.set(gap_array, i, gap)
                        // Detect subtype from MBZ candle (always on)
                        [detected_subtype, _has_dominant] = detect_zone_subtype(curr_o, curr_c, curr_h, curr_l)
                        // Create match record
                        MBZFormationMatch match = MBZFormationMatch.new()
                        match.is_bullish := false
                        match.subtype := detected_subtype
                        match.source_gap_id := gap.gap_id
                        match.source_gap_type := gap.gap_type
                        array.push(matches, match)

    matches

// Update FVG box positions and visibility based on display mode + direction filter
// Priority: mbz_ref_time (freeze at reference candle) > inverted_time > current time
update_gap_positions() =>
    int gap_count = array.size(gap_array)
    if gap_count > 0
        // OPTIMIZATION: Pre-calculate colors outside loop
        color gap_bg_visible = color.new(GAP_COLOR, 90)
        color gap_bg_hidden = color.new(GAP_COLOR, 100)
        color gap_border_visible = color.new(GAP_COLOR, 70)
        color gap_border_hidden = color.new(GAP_COLOR, 100)
        color gap_label_visible = color.new(GAP_COLOR, 50)
        color gap_label_hidden = color.new(GAP_COLOR, 100)

        // OPTIMIZATION: Build active gap_id lookup maps ONCE before iterating gaps
        // This converts O(n*m) nested loops to O(n+m) with O(1) lookups
        map<int, bool> active_mbz_gap_ids = map.new<int, bool>()
        map<int, bool> active_sif_gap_ids = map.new<int, bool>()
        int zone_count = array.size(zone_array)
        if zone_count > 0
            for i = 0 to zone_count - 1
                CandleZone zone = array.get(zone_array, i)
                int gap_id_count = array.size(zone.source_gap_ids)
                if gap_id_count > 0
                    if zone.has_mbz and not zone.mbz_invalidated
                        for j = 0 to gap_id_count - 1
                            map.put(active_mbz_gap_ids, array.get(zone.source_gap_ids, j), true)
                    if zone.has_sif and not zone.sif_invalidated
                        for j = 0 to gap_id_count - 1
                            map.put(active_sif_gap_ids, array.get(zone.source_gap_ids, j), true)

        for i = 0 to gap_count - 1
            GapData gap = array.get(gap_array, i)
            // Freeze at reference candle when MBZ formed, else at inversion, else extend
            int right_edge = gap.mbz_ref_time > 0 ? gap.mbz_ref_time : (gap.is_inverted ? gap.inverted_time : time)
            box.set_right(gap.gap_box, right_edge)
            line.set_x2(gap.ce_line, right_edge)
            label.set_x(gap.tf_label, right_edge)

            // Check if this gap led to an MBZ and passes filters (must have MBZ engine enabled)
            bool type_ok = (enable_fvg and gap.gap_type == GAP_TYPE_FVG) or (enable_implied and gap.gap_type == GAP_TYPE_IMPLIED) or (enable_volume and gap.gap_type == GAP_TYPE_VOLUME)
            bool dir_ok = mbz_direction_filter == DIR_BOTH or (gap.mbz_is_bullish and mbz_direction_filter == DIR_BULLISH) or (not gap.mbz_is_bullish and mbz_direction_filter == DIR_BEARISH)
            bool is_mbz_source = enable_mbz_engine and gap.mbz_ref_time > 0 and dir_ok and type_ok
            // Check if this gap was inverted (became a SIF source, must have SIF engine enabled)
            bool sif_dir_ok = mbz_direction_filter == DIR_BOTH or (gap.is_bullish and mbz_direction_filter == DIR_BEARISH) or (not gap.is_bullish and mbz_direction_filter == DIR_BULLISH)
            bool is_sif_source = enable_sif_engine and gap.is_inverted and sif_dir_ok and type_ok

            // Check zone validity using O(1) map lookup
            bool mbz_zone_active = map.contains(active_mbz_gap_ids, gap.gap_id)
            bool sif_zone_active = map.contains(active_sif_gap_ids, gap.gap_id)

            // Determine gap visibility based on display mode
            bool show_gap = switch gap_display_mode
                GAP_DISPLAY_ALL        => type_ok  // Show all gaps matching type filter
                GAP_DISPLAY_MBZ_SOURCE => is_mbz_source and mbz_zone_active  // Only gaps with active MBZ
                GAP_DISPLAY_SIF_SOURCE => is_sif_source and sif_zone_active  // Only gaps with active SIF
                => false  // GAP_DISPLAY_OFF

            // Use pre-calculated colors
            box.set_bgcolor(gap.gap_box, show_gap ? gap_bg_visible : gap_bg_hidden)
            box.set_border_color(gap.gap_box, show_gap ? gap_border_visible : gap_border_hidden)
            line.set_color(gap.ce_line, show_gap ? gap_border_visible : gap_border_hidden)
            label.set_textcolor(gap.tf_label, show_gap ? gap_label_visible : gap_label_hidden)

// Cleanup FVGs: window-based + enforce max count
cleanup_gaps(int window_start, int max_count) =>
    // Remove FVGs outside data window
    if window_start > 0 and array.size(gap_array) > 0
        for i = array.size(gap_array) - 1 to 0
            GapData gap = array.get(gap_array, i)
            if gap.start_time < window_start
                box.delete(gap.gap_box)
                line.delete(gap.ce_line)
                label.delete(gap.tf_label)
                array.remove(gap_array, i)
    // Enforce max count (remove oldest to stay under drawing limit)
    while array.size(gap_array) > max_count
        GapData old = array.pop(gap_array)
        box.delete(old.gap_box)
        line.delete(old.ce_line)
        label.delete(old.tf_label)

// Cleanup old candle boxes beyond limit
cleanup_candles() =>
    while array.size(candle_boxes) > max_htf_candles
        HTFCandle old = array.pop(candle_boxes)
        box.delete(old.wick)
        box.delete(old.body)

// Cleanup old inversion highlight boxes beyond limit (only when needed)
cleanup_inversion_highlights() =>
    if array.size(inversion_highlights) > max_htf_candles
        while array.size(inversion_highlights) > max_htf_candles
            box old = array.shift(inversion_highlights)
            box.delete(old)

// Cleanup old tap highlight boxes beyond limit (only when needed)
cleanup_tap_highlights() =>
    if array.size(tap_highlights) > max_htf_candles
        while array.size(tap_highlights) > max_htf_candles
            box old = array.shift(tap_highlights)
            box.delete(old)

// Get window start time from htf_times array (independent of candle display)
get_window_start() =>
    int start = 0
    if array.size(htf_times) > 0
        int idx = math.min(max_htf_candles - 1, array.size(htf_times) - 1)
        if idx >= 0
            start := array.get(htf_times, idx)
    start

// Maintain htf_times array for window tracking
update_htf_times(int candle_time) =>
    array.unshift(htf_times, candle_time)
    while array.size(htf_times) > max_htf_candles
        array.pop(htf_times)

// ═══════════════════════════════════════════════════════════════════════════════
// INVALIDATION FUNCTIONS (from MBZ-Core)
// ═══════════════════════════════════════════════════════════════════════════════

// Calculate zone penetration percentage using close price (from MBZ-Core)
calculate_mbz_zone_penetration_from_close(float close_price, float zone_top, float zone_bottom, bool is_bullish_zone) =>
    float zone_range = zone_top - zone_bottom
    if zone_range <= 0
        0.0
    else
        if is_bullish_zone
            // Bullish zone: penetration is from top downward
            if close_price >= zone_top
                0.0
            else if close_price <= zone_bottom
                100.0
            else
                (zone_top - close_price) / zone_range * 100.0
        else
            // Bearish zone: penetration is from bottom upward
            if close_price <= zone_bottom
                0.0
            else if close_price >= zone_top
                100.0
            else
                (close_price - zone_bottom) / zone_range * 100.0

// Check if MBZ should be invalidated by a single candle (from MBZ-Core)
check_single_candle_invalidation(MBZRecord mbz, float candle_open, float candle_close) =>
    float zone_top = mbz.cached_zone_top
    float zone_bottom = mbz.cached_zone_bottom

    if mbz.is_bullish
        // Bullish MBZ: gap-through below zone = instant invalidation
        if candle_open < zone_bottom
            true
        else
            float penetration = calculate_mbz_zone_penetration_from_close(candle_close, zone_top, zone_bottom, true)
            penetration >= MBZ_INVALIDATION_THRESHOLD
    else
        // Bearish MBZ: gap-through above zone = instant invalidation
        if candle_open > zone_top
            true
        else
            float penetration = calculate_mbz_zone_penetration_from_close(candle_close, zone_top, zone_bottom, false)
            penetration >= MBZ_INVALIDATION_THRESHOLD

// Check if MBZ should be invalidated
// NOTE: Historical lookback removed for relay - close[i]/open[i] is LTF data, not HTF!
// MBZs invalidate via: (1) completed HTF candles on new_htf, (2) live htf_open/close check
should_mbz_be_invalidated(MBZRecord mbz, float htf_open_price, float htf_close_price) =>
    check_single_candle_invalidation(mbz, htf_open_price, htf_close_price)

// Check invalidation for all MBZ records
check_mbz_invalidation(float htf_open_price, float htf_close_price) =>
    if array.size(mbz_array) > 0
        for i = 0 to array.size(mbz_array) - 1
            MBZRecord mbz = array.get(mbz_array, i)
            if not mbz.is_invalidated
                if should_mbz_be_invalidated(mbz, htf_open_price, htf_close_price)
                    mbz.is_invalidated := true
                    // Hide the MBZ box
                    if not na(mbz.mbz_box)
                        box.delete(mbz.mbz_box)
                    array.set(mbz_array, i, mbz)

// ═══════════════════════════════════════════════════════════════════════════════
// UNIFIED ZONE INVALIDATION
// ═══════════════════════════════════════════════════════════════════════════════

// Generic component invalidation check - works for both MBZ and SIF
check_component_single_candle_invalidation(float zone_top, float zone_bottom, bool is_bullish, float threshold, float candle_open, float candle_close) =>
    if is_bullish
        // Bullish zone: gap-through below zone = instant invalidation
        if candle_open < zone_bottom
            true
        else
            float penetration = calculate_mbz_zone_penetration_from_close(candle_close, zone_top, zone_bottom, true)
            penetration >= threshold
    else
        // Bearish zone: gap-through above zone = instant invalidation
        if candle_open > zone_top
            true
        else
            float penetration = calculate_mbz_zone_penetration_from_close(candle_close, zone_top, zone_bottom, false)
            penetration >= threshold

// Check if MBZ component should be invalidated by a single candle
check_mbz_component_invalidation(CandleZone zone, float candle_open, float candle_close) =>
    if not zone.has_mbz or zone.mbz_invalidated
        false
    else
        check_component_single_candle_invalidation(zone.zone_top, zone.zone_bottom, zone.is_bullish, MBZ_INVALIDATION_THRESHOLD, candle_open, candle_close)

// Check if SIF component should be invalidated by a single candle
check_sif_component_invalidation(CandleZone zone, float candle_open, float candle_close) =>
    if not zone.has_sif or zone.sif_invalidated
        false
    else
        check_component_single_candle_invalidation(zone.zone_top, zone.zone_bottom, zone.is_bullish, SIF_INVALIDATION_THRESHOLD, candle_open, candle_close)

// Check if MBZ component should be invalidated
// NOTE: Historical lookback removed for relay - close[i]/open[i] is LTF data, not HTF!
// Zones invalidate via: (1) completed HTF candles on new_htf, (2) live htf_open/close check
should_mbz_component_be_invalidated(CandleZone zone, float htf_open_price, float htf_close_price) =>
    if not zone.has_mbz or zone.mbz_invalidated
        false
    else
        check_mbz_component_invalidation(zone, htf_open_price, htf_close_price)

// Check if SIF component should be invalidated
// NOTE: Historical lookback removed for relay - close[i]/open[i] is LTF data, not HTF!
// Zones invalidate via: (1) completed HTF candles on new_htf, (2) live opening gap check
should_sif_component_be_invalidated(CandleZone zone, float htf_open_price, float htf_close_price) =>
    if not zone.has_sif or zone.sif_invalidated
        false
    else
        check_sif_component_invalidation(zone, htf_open_price, htf_close_price)

// ═══════════════════════════════════════════════════════════════════════════════
// LIVE INVALIDATION (Opening Gaps Only)
// For forming HTF candles, we only check opening gaps - NOT close penetration
// Close penetration requires a CONFIRMED HTF close, which isn't available until new_htf
// ═══════════════════════════════════════════════════════════════════════════════

// Check if component is invalidated by opening gap only (for live checks)
check_component_opening_gap_invalidation(float zone_top, float zone_bottom, bool is_bullish, float candle_open) =>
    if is_bullish
        // Bullish zone: gap-through below zone = instant invalidation
        candle_open < zone_bottom
    else
        // Bearish zone: gap-through above zone = instant invalidation
        candle_open > zone_top

// Check MBZ component for opening gap invalidation (live check)
check_mbz_component_opening_gap(CandleZone zone, float candle_open) =>
    if not zone.has_mbz or zone.mbz_invalidated
        false
    else
        check_component_opening_gap_invalidation(zone.zone_top, zone.zone_bottom, zone.is_bullish, candle_open)

// Check SIF component for opening gap invalidation (live check)
check_sif_component_opening_gap(CandleZone zone, float candle_open) =>
    if not zone.has_sif or zone.sif_invalidated
        false
    else
        check_component_opening_gap_invalidation(zone.zone_top, zone.zone_bottom, zone.is_bullish, candle_open)

// Check MBZRecord for opening gap invalidation (live check)
check_mbz_record_opening_gap(MBZRecord mbz, float candle_open) =>
    if mbz.is_invalidated
        false
    else
        check_component_opening_gap_invalidation(mbz.cached_zone_top, mbz.cached_zone_bottom, mbz.is_bullish, candle_open)

// Live invalidation for MBZ records - opening gaps only
check_mbz_invalidation_live(float htf_open_price) =>
    if array.size(mbz_array) > 0
        for i = 0 to array.size(mbz_array) - 1
            MBZRecord mbz = array.get(mbz_array, i)
            if not mbz.is_invalidated
                if check_mbz_record_opening_gap(mbz, htf_open_price)
                    mbz.is_invalidated := true
                    if not na(mbz.mbz_box)
                        box.delete(mbz.mbz_box)
                    array.set(mbz_array, i, mbz)

// Live invalidation for unified zones - opening gaps only (no close penetration)
check_zone_invalidation_live(float htf_open_price) =>
    if array.size(zone_array) > 0
        for i = 0 to array.size(zone_array) - 1
            CandleZone zone = array.get(zone_array, i)

            if zone.is_invalidated
                continue

            bool needs_update = false

            // Check MBZ component for opening gap
            if check_mbz_component_opening_gap(zone, htf_open_price)
                zone.mbz_invalidated := true
                zone.has_mbz := false
                needs_update := true

            // Check SIF component for opening gap
            if check_sif_component_opening_gap(zone, htf_open_price)
                zone.sif_invalidated := true
                zone.has_sif := false
                needs_update := true

            // If NO active components remain, mark zone as fully invalidated
            if not zone.has_mbz and not zone.has_sif
                zone.is_invalidated := true
                if not na(zone.zone_box)
                    box.delete(zone.zone_box)
                    zone.zone_box := na
            else if needs_update
                if not na(zone.zone_box)
                    box.delete(zone.zone_box)
                    zone.zone_box := na

            array.set(zone_array, i, zone)

// Check invalidation for all unified zones - tracks MBZ and SIF independently
// This is for CONFIRMED HTF candles only (called on new_htf with htf_o1, htf_c1)
check_zone_invalidation(float htf_open_price, float htf_close_price) =>
    if array.size(zone_array) > 0
        for i = 0 to array.size(zone_array) - 1
            CandleZone zone = array.get(zone_array, i)

            // Skip fully invalidated zones
            if zone.is_invalidated
                continue

            bool needs_update = false

            // Check MBZ component
            if should_mbz_component_be_invalidated(zone, htf_open_price, htf_close_price)
                zone.mbz_invalidated := true
                zone.has_mbz := false  // Remove MBZ from zone
                needs_update := true

            // Check SIF component
            if should_sif_component_be_invalidated(zone, htf_open_price, htf_close_price)
                zone.sif_invalidated := true
                zone.has_sif := false  // Remove SIF from zone
                needs_update := true

            // If NO active components remain, mark zone as fully invalidated
            if not zone.has_mbz and not zone.has_sif
                zone.is_invalidated := true
                // Delete the zone box
                if not na(zone.zone_box)
                    box.delete(zone.zone_box)
                    zone.zone_box := na
            else if needs_update
                // Partial invalidation: update zone label (box will be updated in rendering loop)
                // Force box recreation by setting to na
                if not na(zone.zone_box)
                    box.delete(zone.zone_box)
                    zone.zone_box := na

            array.set(zone_array, i, zone)

// Cleanup MBZ records outside window
cleanup_mbz_records(int window_start) =>
    if window_start > 0 and array.size(mbz_array) > 0
        for i = array.size(mbz_array) - 1 to 0
            MBZRecord mbz = array.get(mbz_array, i)
            if mbz.formation_time < window_start
                if not na(mbz.mbz_box)
                    box.delete(mbz.mbz_box)
                array.remove(mbz_array, i)

// Cleanup unified zones outside window
cleanup_zones(int window_start) =>
    if window_start > 0 and array.size(zone_array) > 0
        for i = array.size(zone_array) - 1 to 0
            CandleZone zone = array.get(zone_array, i)
            if zone.formation_time < window_start
                if not na(zone.zone_box)
                    box.delete(zone.zone_box)
                array.remove(zone_array, i)

// ═══════════════════════════════════════════════════════════════════════════════
// MAIN EXECUTION
// ═══════════════════════════════════════════════════════════════════════════════

if IS_VALID
    if new_htf
        // ─── Window Management ───
        int window_start = get_window_start()

        // ─── Shift Wick Box History (for MBZ candle highlighting) ───
        // After this shift: prev_wick_box = htf_*1's box, prev_prev_wick_box = htf_*2's box
        prev_prev_wick_box := prev_wick_box
        prev_wick_box := wick_box

        // ─── Capture HTF Close (just-completed candle) ───
        float htf_close = close[1]  // LTF close at HTF boundary = HTF close

        // ─── Shift History (full OHLC for implied FVG) ───
        // Shift [4] → [5]
        htf_o5 := htf_o4, htf_h5 := htf_h4, htf_l5 := htf_l4, htf_c5 := htf_c4
        // Shift [3] → [4]
        htf_o4 := htf_o3, htf_h4 := htf_h3, htf_l4 := htf_l3, htf_c4 := htf_c3
        // Shift [2] → [3]
        htf_o3 := htf_o2, htf_h3 := htf_h2, htf_l3 := htf_l2, htf_c3 := htf_c2, htf_t3 := htf_t2
        // Shift [1] → [2]
        htf_o2 := htf_o1, htf_h2 := htf_h1, htf_l2 := htf_l1, htf_c2 := htf_c1, htf_t2 := htf_t1
        // Shift current → [1]
        htf_o1 := htf_open, htf_h1 := htf_high, htf_l1 := htf_low, htf_c1 := htf_close, htf_t1 := htf_time

        // ─── Track Window (independent of candle display) ───
        update_htf_times(htf_t1)

        // ─── Gap Detection (ALL enabled types detected independently - mirrors MBZ Core) ───
        // Each gap type is detected and stored separately to support multi-source MBZs
        if htf_h3 > 0  // Ensure we have 3 candles of history
            bool gap_in_window = htf_t3 >= window_start or window_start == 0

            // ─── Standard FVG Detection (Bullish) ───
            if enable_fvg and gap_in_window
                bool is_bull_fvg = htf_l1 > htf_h3
                if is_bull_fvg
                    float gap_top = htf_l1
                    float gap_bot = htf_h3
                    float gap_ce = (gap_top + gap_bot) / 2
                    int this_gap_id = next_gap_id
                    next_gap_id := next_gap_id + 1
                    GapData new_gap = GapData.new()
                    new_gap.top := gap_top
                    new_gap.bottom := gap_bot
                    new_gap.ce := gap_ce
                    new_gap.bar_index := bar_index
                    new_gap.start_time := htf_t3
                    new_gap.formation_end_time := htf_t1
                    new_gap.is_bullish := true
                    new_gap.gap_type := GAP_TYPE_FVG
                    new_gap.gap_id := this_gap_id
                    new_gap.gap_box := box.new(htf_t3, gap_top, time, gap_bot, xloc=xloc.bar_time, bgcolor=color.new(GAP_COLOR, 100), border_color=color.new(GAP_COLOR, 100), border_width=1)
                    new_gap.ce_line := line.new(htf_t3, gap_ce, time, gap_ce, xloc=xloc.bar_time, color=color.new(GAP_COLOR, 100), style=line.style_dotted, width=1)
                    new_gap.tf_label := label.new(time, gap_ce, HTF_LABEL, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white, 100), textcolor=color.new(GAP_COLOR, 100), size=size.small)
                    array.unshift(gap_array, new_gap)

            // ─── Standard FVG Detection (Bearish) ───
            if enable_fvg and gap_in_window
                bool is_bear_fvg = htf_h1 < htf_l3
                if is_bear_fvg
                    float gap_top = htf_l3
                    float gap_bot = htf_h1
                    float gap_ce = (gap_top + gap_bot) / 2
                    int this_gap_id = next_gap_id
                    next_gap_id := next_gap_id + 1
                    GapData new_gap = GapData.new()
                    new_gap.top := gap_top
                    new_gap.bottom := gap_bot
                    new_gap.ce := gap_ce
                    new_gap.bar_index := bar_index
                    new_gap.start_time := htf_t3
                    new_gap.formation_end_time := htf_t1
                    new_gap.is_bullish := false
                    new_gap.gap_type := GAP_TYPE_FVG
                    new_gap.gap_id := this_gap_id
                    new_gap.gap_box := box.new(htf_t3, gap_top, time, gap_bot, xloc=xloc.bar_time, bgcolor=color.new(GAP_COLOR, 100), border_color=color.new(GAP_COLOR, 100), border_width=1)
                    new_gap.ce_line := line.new(htf_t3, gap_ce, time, gap_ce, xloc=xloc.bar_time, color=color.new(GAP_COLOR, 100), style=line.style_dotted, width=1)
                    new_gap.tf_label := label.new(time, gap_ce, HTF_LABEL, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white, 100), textcolor=color.new(GAP_COLOR, 100), size=size.small)
                    array.unshift(gap_array, new_gap)

            // ─── Implied FVG Detection (independent of FVG) ───
            if enable_implied and gap_in_window
                [impl_found, impl_bot, impl_top, impl_bull] = detect_htf_implied_fvg()
                if impl_found
                    float gap_ce = (impl_top + impl_bot) / 2
                    int this_gap_id = next_gap_id
                    next_gap_id := next_gap_id + 1
                    GapData new_gap = GapData.new()
                    new_gap.top := impl_top
                    new_gap.bottom := impl_bot
                    new_gap.ce := gap_ce
                    new_gap.bar_index := bar_index
                    new_gap.start_time := htf_t3
                    new_gap.formation_end_time := htf_t1
                    new_gap.is_bullish := impl_bull
                    new_gap.gap_type := GAP_TYPE_IMPLIED
                    new_gap.gap_id := this_gap_id
                    new_gap.gap_box := box.new(htf_t3, impl_top, time, impl_bot, xloc=xloc.bar_time, bgcolor=color.new(GAP_COLOR, 100), border_color=color.new(GAP_COLOR, 100), border_width=1)
                    new_gap.ce_line := line.new(htf_t3, gap_ce, time, gap_ce, xloc=xloc.bar_time, color=color.new(GAP_COLOR, 100), style=line.style_dotted, width=1)
                    new_gap.tf_label := label.new(time, gap_ce, HTF_LABEL + " imp", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white, 100), textcolor=color.new(GAP_COLOR, 100), size=size.small)
                    array.unshift(gap_array, new_gap)

            // ─── Volume Imbalance Detection (Bullish - with suppression check matching SIF-Core) ───
            if enable_volume and htf_h2 > 0
                bool vi_in_window = htf_t2 >= window_start or window_start == 0
                if vi_in_window and is_htf_bullish_vi()
                    [vi_top, vi_bot] = get_htf_vi_coordinates(true)
                    // Check for overlapping gaps before creating (matches SIF-Core is_gap_overlapping)
                    // Can be disabled via toggle for testing
                    bool vi_is_suppressed = disable_vi_suppression ? false : is_htf_vi_suppressed_by_gaps(vi_top, vi_bot, true)
                    if not vi_is_suppressed
                        float gap_ce = (vi_top + vi_bot) / 2
                        int this_gap_id = next_gap_id
                        next_gap_id := next_gap_id + 1
                        GapData new_gap = GapData.new()
                        new_gap.top := vi_top
                        new_gap.bottom := vi_bot
                        new_gap.ce := gap_ce
                        new_gap.bar_index := bar_index
                        new_gap.start_time := htf_t2
                        new_gap.formation_end_time := htf_t1
                        new_gap.is_bullish := true
                        new_gap.gap_type := GAP_TYPE_VOLUME
                        new_gap.gap_id := this_gap_id
                        new_gap.gap_box := box.new(htf_t2, vi_top, time, vi_bot, xloc=xloc.bar_time, bgcolor=color.new(GAP_COLOR, 100), border_color=color.new(GAP_COLOR, 100), border_width=1)
                        new_gap.ce_line := line.new(htf_t2, gap_ce, time, gap_ce, xloc=xloc.bar_time, color=color.new(GAP_COLOR, 100), style=line.style_dotted, width=1)
                        new_gap.tf_label := label.new(time, gap_ce, HTF_LABEL + " vol", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white, 100), textcolor=color.new(GAP_COLOR, 100), size=size.small)
                        array.unshift(gap_array, new_gap)

            // ─── Volume Imbalance Detection (Bearish - with suppression check matching SIF-Core) ───
            if enable_volume and htf_h2 > 0
                bool vi_in_window = htf_t2 >= window_start or window_start == 0
                if vi_in_window and is_htf_bearish_vi()
                    [vi_top, vi_bot] = get_htf_vi_coordinates(false)
                    // Check for overlapping gaps before creating (matches SIF-Core is_gap_overlapping)
                    // Can be disabled via toggle for testing
                    bool vi_is_suppressed = disable_vi_suppression ? false : is_htf_vi_suppressed_by_gaps(vi_top, vi_bot, false)
                    if not vi_is_suppressed
                        float gap_ce = (vi_top + vi_bot) / 2
                        int this_gap_id = next_gap_id
                        next_gap_id := next_gap_id + 1
                        GapData new_gap = GapData.new()
                        new_gap.top := vi_top
                        new_gap.bottom := vi_bot
                        new_gap.ce := gap_ce
                        new_gap.bar_index := bar_index
                        new_gap.start_time := htf_t2
                        new_gap.formation_end_time := htf_t1
                        new_gap.is_bullish := false
                        new_gap.gap_type := GAP_TYPE_VOLUME
                        new_gap.gap_id := this_gap_id
                        new_gap.gap_box := box.new(htf_t2, vi_top, time, vi_bot, xloc=xloc.bar_time, bgcolor=color.new(GAP_COLOR, 100), border_color=color.new(GAP_COLOR, 100), border_width=1)
                        new_gap.ce_line := line.new(htf_t2, gap_ce, time, gap_ce, xloc=xloc.bar_time, color=color.new(GAP_COLOR, 100), style=line.style_dotted, width=1)
                        new_gap.tf_label := label.new(time, gap_ce, HTF_LABEL + " vol", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white, 100), textcolor=color.new(GAP_COLOR, 100), size=size.small)
                        array.unshift(gap_array, new_gap)

        cleanup_gaps(window_start, MAX_FVGS)
        cleanup_mbz_records(window_start)
        cleanup_zones(window_start)

        // ─── Reset Current Candle ───
        htf_open := open
        htf_high := high
        htf_low  := low
        htf_time := time

        // ─── Gap Interaction Check (BEFORE MBZ detection) ───
        // Check if MBZ candle (htf_*1) taps and/or closes through any gaps
        // Sets sif_body_tapper and is_inverted, draws visual highlights
        check_gap_interactions(htf_o1, htf_h1, htf_l1, htf_c1, htf_t1)
        cleanup_inversion_highlights()
        cleanup_tap_highlights()

        // ─── Invalidation Check ───
        // Check if the just-completed HTF candle invalidates any zones
        if enable_invalidation
            check_mbz_invalidation(htf_o1, htf_c1)
            check_zone_invalidation(htf_o1, htf_c1)

        // ─── MBZ Formation Check (supports consolidated candles with multiple sources) ───
        // htf_*2 = reference candle (tapped gap) → prev_prev_wick_box
        // htf_*1 = MBZ candle (conviction candle) → prev_wick_box
        // htf_t2 = reference candle time (must be > FVG formation_end_time)
        if enable_mbz_engine
            array<MBZFormationMatch> mbz_matches = check_mbz_formation(htf_o2, htf_h2, htf_l2, htf_c2, htf_t2, htf_o1, htf_h1, htf_l1, htf_c1)
            int num_matches = array.size(mbz_matches)

            if num_matches > 0
                // All matches on same candle have same direction (determined by MBZ candle)
                MBZFormationMatch first_match = array.get(mbz_matches, 0)
                bool mbz_bull = first_match.is_bullish

                // Apply direction filter (detection always runs, filter controls display)
                bool show_this_mbz = mbz_direction_filter == DIR_BOTH or (mbz_bull and mbz_direction_filter == DIR_BULLISH) or (not mbz_bull and mbz_direction_filter == DIR_BEARISH)

                if show_this_mbz
                    // ─── Calculate consolidated zone boundaries (outermost limits across all matches) ───
                    float consolidated_zone_top = 0.0
                    float consolidated_zone_bottom = 0.0

                    for i = 0 to num_matches - 1
                        MBZFormationMatch match = array.get(mbz_matches, i)
                        [match_zone_top, match_zone_bot] = get_mbz_zone(htf_o1, htf_h1, htf_l1, htf_c1, match.is_bullish, match.subtype, htf_h2, htf_l2)
                        if i == 0
                            consolidated_zone_top := match_zone_top
                            consolidated_zone_bottom := match_zone_bot
                        else
                            // Take outermost boundaries
                            consolidated_zone_top := math.max(consolidated_zone_top, match_zone_top)
                            consolidated_zone_bottom := math.min(consolidated_zone_bottom, match_zone_bot)

                    // ─── Collect all source types for consolidated label ───
                    array<string> source_types = array.new<string>()
                    for i = 0 to num_matches - 1
                        MBZFormationMatch match = array.get(mbz_matches, i)
                        array.push(source_types, match.source_gap_type)

                    // Create consolidated MBZRecord (legacy rendering)
                    // Note: Uses first match's subtype and gap_id for record tracking, but zone is consolidated
                    color mbz_color = mbz_bull ? MBZ_BULLISH_COLOR : MBZ_BEARISH_COLOR
                    MBZRecord new_mbz = MBZRecord.new()
                    new_mbz.bar_index := bar_index
                    new_mbz.formation_time := htf_t1
                    new_mbz.high_price := htf_h1
                    new_mbz.low_price := htf_l1
                    new_mbz.ref_candle_high := htf_h2
                    new_mbz.ref_candle_low := htf_l2
                    new_mbz.mbz_open := htf_o1
                    new_mbz.mbz_close := htf_c1
                    new_mbz.is_bullish := mbz_bull
                    new_mbz.is_invalidated := false
                    new_mbz.mbz_subtype := first_match.subtype
                    new_mbz.cached_zone_top := consolidated_zone_top
                    new_mbz.cached_zone_bottom := consolidated_zone_bottom
                    new_mbz.source_gap_id := first_match.source_gap_id
                    new_mbz.source_gap_type := first_match.source_gap_type
                    // Note: Visual box creation now handled by unified zone_array rendering
                    array.unshift(mbz_array, new_mbz)

                    // ─── Register MBZ in unified zone_array ───
                    // Get or create zone for this candle (MBZ uses reference wick extension)
                    [zone, zone_idx, is_new] = get_or_create_zone(bar_index, htf_t1, htf_o1, htf_c1, htf_h1, htf_l1, mbz_bull, htf_h2, htf_l2, extend_to_reference_wick)

                    // Update zone with MBZ flag
                    zone.has_mbz := true
                    zone.ref_candle_high := htf_h2
                    zone.ref_candle_low := htf_l2

                    // Add all MBZ source gaps
                    for i = 0 to num_matches - 1
                        MBZFormationMatch match = array.get(mbz_matches, i)
                        add_source_to_zone(zone, match.source_gap_id, match.source_gap_type)

                    // Save updated zone back to array
                    array.set(zone_array, zone_idx, zone)

        // ─── Create New Candle Boxes (ALWAYS create for MBZ highlighting) ───
        bool is_bull = close >= open
        // Wick box always created (for MBZ highlighting), invisible if overlay OFF
        color wick_bg = show_htf_candles ? (is_bull ? htf_bull_wick_color : htf_bear_wick_color) : color.new(color.white, 100)
        color wick_bdr = show_htf_candles ? (is_bull ? BULL_BORDER : BEAR_BORDER) : color.new(color.white, 100)
        wick_box := box.new(time, high, time, low, xloc=xloc.bar_time, border_color=wick_bdr, bgcolor=wick_bg, border_width=1, border_style=line.style_dashed)

        // Body box only if overlay ON
        if show_htf_candles
            body_box := box.new(time, math.max(open, close), time, math.min(open, close), xloc=xloc.bar_time, border_color=color.new(color.white, 100), bgcolor=is_bull ? htf_bull_body_color : htf_bear_body_color, border_width=0)

            HTFCandle new_candle = HTFCandle.new()
            new_candle.wick := wick_box
            new_candle.body := body_box
            new_candle.start_time := time
            array.unshift(candle_boxes, new_candle)
            cleanup_candles()

    else
        // ─── Update Forming Candle ───
        htf_high := math.max(high, htf_high)
        htf_low  := math.min(low, htf_low)

        // Always update wick_box position (for MBZ highlighting)
        if not na(wick_box)
            bool is_bull = close >= htf_open
            box.set_top(wick_box, htf_high)
            box.set_bottom(wick_box, htf_low)
            box.set_right(wick_box, time)
            // Only set visual colors if overlay ON
            if show_htf_candles
                box.set_bgcolor(wick_box, is_bull ? htf_bull_wick_color : htf_bear_wick_color)
                box.set_border_color(wick_box, is_bull ? BULL_BORDER : BEAR_BORDER)

        if show_htf_candles and not na(body_box)
            bool is_bull = close >= htf_open
            box.set_top(body_box, math.max(htf_open, close))
            box.set_bottom(body_box, math.min(htf_open, close))
            box.set_right(body_box, time)
            box.set_bgcolor(body_box, is_bull ? htf_bull_body_color : htf_bear_body_color)

    // ─── FVG Updates (every bar) ───
    update_gap_positions()

    // ─── Live Invalidation (every bar) ───
    // Check if forming HTF candle has GAPPED THROUGH any zones (opening gap only)
    // NOTE: Close penetration is NOT checked here - that requires CONFIRMED HTF close (on new_htf)
    // This prevents false invalidation from LTF intra-bar price spikes
    if enable_invalidation
        check_mbz_invalidation_live(htf_open)
        check_zone_invalidation_live(htf_open)

    // ─── Unified Zone Rendering (every bar) ───
    // Render zones from zone_array - these are agnostic containers that know which engines validated them
    if array.size(zone_array) > 0
        int zone_extension_width = zone_extension_bars * HTF_MS
        color zone_color_bull = MBZ_BULLISH_COLOR
        color zone_color_bear = MBZ_BEARISH_COLOR

        // Same-Source filter tracking (from MBZ-Core)
        var map<int, bool> seen_gap_ids = map.new<int, bool>()  // For LATEST TOUCH mode
        var map<int, int> first_touch_index_per_gap = map.new<int, int>()  // For FIRST TOUCH mode: gap_id -> zone index
        map.clear(seen_gap_ids)
        map.clear(first_touch_index_per_gap)

        // Pre-pass for FIRST TOUCH mode: Find oldest (first) non-invalidated MBZ zone per gap_id
        // Note: Same-Source filter only applies to MBZ zones, not SIF-only zones
        if same_source_filter == SAME_SOURCE_FILTER_FIRST_TOUCH
            for zone_index = array.size(zone_array) - 1 to 0
                CandleZone current_zone = array.get(zone_array, zone_index)
                // Only consider MBZ zones for same-source filtering
                if not current_zone.has_mbz
                    continue
                // Apply direction filter and invalidation check
                bool show_direction = mbz_direction_filter == DIR_BOTH or (current_zone.is_bullish and mbz_direction_filter == DIR_BULLISH) or (not current_zone.is_bullish and mbz_direction_filter == DIR_BEARISH)
                if show_direction and not current_zone.is_invalidated and array.size(current_zone.source_gap_ids) > 0
                    int gap_id = array.get(current_zone.source_gap_ids, 0)  // Use primary source (first gap)
                    // Loop backwards, so keep updating - last one seen = oldest (first) chronologically
                    map.put(first_touch_index_per_gap, gap_id, zone_index)

        for i = 0 to array.size(zone_array) - 1
            CandleZone zone = array.get(zone_array, i)

            // Skip invalidated zones
            if zone.is_invalidated
                continue

            // Skip if neither engine validated (shouldn't happen, but defensive)
            if not zone.has_mbz and not zone.has_sif
                continue

            // Apply direction filter
            bool show_direction = mbz_direction_filter == DIR_BOTH or (zone.is_bullish and mbz_direction_filter == DIR_BULLISH) or (not zone.is_bullish and mbz_direction_filter == DIR_BEARISH)
            if not show_direction
                // Delete box if it exists (zone filtered out by direction)
                if not na(zone.zone_box)
                    box.delete(zone.zone_box)
                    zone.zone_box := na
                    array.set(zone_array, i, zone)
                continue

            // Apply zone type filter
            // Note: "MBZ Only" shows any zone with MBZ (even if also has SIF)
            // "SIF Only" shows any zone with SIF (even if also has MBZ)
            // "Combined Only" shows ONLY zones with both MBZ and SIF
            bool show_zone_type = zone_type_filter == ZONE_TYPE_ALL or
                                  (zone_type_filter == ZONE_TYPE_MBZ_ONLY and zone.has_mbz) or
                                  (zone_type_filter == ZONE_TYPE_SIF_ONLY and zone.has_sif) or
                                  (zone_type_filter == ZONE_TYPE_COMBINED and zone.has_mbz and zone.has_sif)
            if not show_zone_type
                // Delete box if it exists (zone filtered out by type)
                if not na(zone.zone_box)
                    box.delete(zone.zone_box)
                    zone.zone_box := na
                    array.set(zone_array, i, zone)
                continue

            // Same-Source filter logic (MBZ only - SIF zones always pass through)
            bool should_show_zone = true
            if zone.has_mbz and array.size(zone.source_gap_ids) > 0
                int primary_gap_id = array.get(zone.source_gap_ids, 0)  // Use primary source (first gap)

                if same_source_filter == SAME_SOURCE_FILTER_LATEST_TOUCH
                    // LATEST TOUCH: Show most recent MBZ zone per gap_id
                    if map.contains(seen_gap_ids, primary_gap_id)
                        should_show_zone := false  // Already added latest for this gap
                    else
                        // Mark as seen (we're processing forward chronologically)
                        map.put(seen_gap_ids, primary_gap_id, true)
                else if same_source_filter == SAME_SOURCE_FILTER_FIRST_TOUCH
                    // FIRST TOUCH: Only show FIRST (oldest) non-invalidated MBZ zone per gap_id
                    if map.contains(first_touch_index_per_gap, primary_gap_id)
                        int first_touch_idx = map.get(first_touch_index_per_gap, primary_gap_id)
                        // Only show if this IS the first touch for this gap_id
                        if i != first_touch_idx
                            should_show_zone := false
                    else
                        should_show_zone := false  // No first touch found (shouldn't happen)
                // SAME_SOURCE_FILTER_ALL_TOUCHES: No filtering, show all

            if not should_show_zone
                // Delete box if it exists (zone filtered out)
                if not na(zone.zone_box)
                    box.delete(zone.zone_box)
                    zone.zone_box := na
                    array.set(zone_array, i, zone)
                continue

            // Create box if doesn't exist yet
            if na(zone.zone_box)
                color zone_color = zone.is_bullish ? zone_color_bull : zone_color_bear
                string zone_label_text = build_zone_label(zone)
                int zone_right_edge = zone.formation_time + zone_extension_width

                zone.zone_box := box.new(zone.formation_time, zone.zone_top, zone_right_edge, zone.zone_bottom, xloc=xloc.bar_time, bgcolor=color.new(zone_color, MBZ_FILL_TRANSPARENCY), border_color=zone_color, border_width=3, text=zone_label_text, text_color=zone_label_color, text_size=ZONE_LABEL_SIZE_RESOLVED, text_halign=text.align_right, text_valign=text.align_center)
                array.set(zone_array, i, zone)
            else
                // Update extension
                box.set_right(zone.zone_box, zone.formation_time + zone_extension_width)

// ═══════════════════════════════════════════════════════════════════════════════
// STATUS TABLE
// ═══════════════════════════════════════════════════════════════════════════════

if IS_VALID and show_status_table and barstate.islast
    var table status_table = table.new(position.bottom_center, 4, 1, border_width=0)

    // Calculate padding for offset
    string left_pad = status_table_offset < 0 ? "" : str.repeat(" ", status_table_offset * 3)
    string right_pad = status_table_offset > 0 ? "" : str.repeat(" ", math.abs(status_table_offset) * 3)

    // Left padding cell
    table.cell(status_table, 0, 0, left_pad, bgcolor=color.new(color.white, 100), text_size=size.tiny)

    // Title cell: white text on black background
    table.cell(status_table, 1, 0, "mbz relay •", bgcolor=color.black, text_color=color.white, text_size=size.tiny)

    // Build status text: TF mapping + enabled gap sources + ref wick indicator
    // Show "all" when all gap sources are enabled (mirrors MBZ-Core)
    string gap_type_display = ""
    if enable_fvg and enable_implied and enable_volume
        gap_type_display := STATUS_DISPLAY_ALL
    else
        var array<string> gap_parts = array.new<string>()
        array.clear(gap_parts)
        if enable_fvg
            array.push(gap_parts, STATUS_DISPLAY_FVG)
        if enable_implied
            array.push(gap_parts, STATUS_DISPLAY_IMP)
        if enable_volume
            array.push(gap_parts, STATUS_DISPLAY_VOL)
        gap_type_display := array.size(gap_parts) > 0 ? array.join(gap_parts, "·") : "none"
    string ref_wick_display = extend_to_reference_wick ? "  " + STATUS_DISPLAY_REF_WICK : ""

    string status_text = LTF_LABEL + " → " + HTF_LABEL + "  " + gap_type_display + ref_wick_display
    table.cell(status_table, 2, 0, status_text, bgcolor=color.new(color.rgb(245, 245, 245), 20), text_color=color.black, text_size=size.tiny)

    // Right padding cell
    table.cell(status_table, 3, 0, right_pad, bgcolor=color.new(color.white, 100), text_size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE
// ═══════════════════════════════════════════════════════════════════════════════

if show_color_table and barstate.islast
    var table t = table.new(position.top_right, 3, 10, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

    table.cell(t, 0, 0, "Element", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(t, 2, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)

    table.cell(t, 0, 1, "Bull Body", text_size=size.small)
    table.cell(t, 1, 1, str.format("R:{0} G:{1} B:{2}", int(color.r(htf_bull_body_color)), int(color.g(htf_bull_body_color)), int(color.b(htf_bull_body_color))), text_size=size.small)
    table.cell(t, 2, 1, str.tostring(int(color.t(htf_bull_body_color))), text_size=size.small)

    table.cell(t, 0, 2, "Bull Wick", text_size=size.small)
    table.cell(t, 1, 2, str.format("R:{0} G:{1} B:{2}", int(color.r(htf_bull_wick_color)), int(color.g(htf_bull_wick_color)), int(color.b(htf_bull_wick_color))), text_size=size.small)
    table.cell(t, 2, 2, str.tostring(int(color.t(htf_bull_wick_color))), text_size=size.small)

    table.cell(t, 0, 3, "Bear Body", text_size=size.small)
    table.cell(t, 1, 3, str.format("R:{0} G:{1} B:{2}", int(color.r(htf_bear_body_color)), int(color.g(htf_bear_body_color)), int(color.b(htf_bear_body_color))), text_size=size.small)
    table.cell(t, 2, 3, str.tostring(int(color.t(htf_bear_body_color))), text_size=size.small)

    table.cell(t, 0, 4, "Bear Wick", text_size=size.small)
    table.cell(t, 1, 4, str.format("R:{0} G:{1} B:{2}", int(color.r(htf_bear_wick_color)), int(color.g(htf_bear_wick_color)), int(color.b(htf_bear_wick_color))), text_size=size.small)
    table.cell(t, 2, 4, str.tostring(int(color.t(htf_bear_wick_color))), text_size=size.small)

    table.cell(t, 0, 5, "Gap", text_size=size.small)
    table.cell(t, 1, 5, str.format("R:{0} G:{1} B:{2}", int(color.r(GAP_COLOR)), int(color.g(GAP_COLOR)), int(color.b(GAP_COLOR))), text_size=size.small)
    table.cell(t, 2, 5, str.tostring(int(color.t(GAP_COLOR))), text_size=size.small)

    table.cell(t, 0, 6, "MBZ Bull", text_size=size.small)
    table.cell(t, 1, 6, str.format("R:{0} G:{1} B:{2}", int(color.r(MBZ_BULLISH_COLOR)), int(color.g(MBZ_BULLISH_COLOR)), int(color.b(MBZ_BULLISH_COLOR))), text_size=size.small)
    table.cell(t, 2, 6, str.tostring(MBZ_FILL_TRANSPARENCY), text_size=size.small)

    table.cell(t, 0, 7, "MBZ Bear", text_size=size.small)
    table.cell(t, 1, 7, str.format("R:{0} G:{1} B:{2}", int(color.r(MBZ_BEARISH_COLOR)), int(color.g(MBZ_BEARISH_COLOR)), int(color.b(MBZ_BEARISH_COLOR))), text_size=size.small)
    table.cell(t, 2, 7, str.tostring(MBZ_FILL_TRANSPARENCY), text_size=size.small)

    table.cell(t, 0, 8, "MBZ Label", text_size=size.small)
    table.cell(t, 1, 8, str.format("R:{0} G:{1} B:{2}", int(color.r(zone_label_color)), int(color.g(zone_label_color)), int(color.b(zone_label_color))), text_size=size.small)
    table.cell(t, 2, 8, str.tostring(int(color.t(zone_label_color))), text_size=size.small)
