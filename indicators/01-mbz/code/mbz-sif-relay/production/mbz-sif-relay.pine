//@version=6

// ═══════════════════════════════════════════════════════════════════════════════
// MBZ SIF RELAY
// ═══════════════════════════════════════════════════════════════════════════════
// Multi-timeframe MBZ + SIF detection with 3-tier HTF system:
//   Main (HTF1), HTF2, HTF3 each run full detection.
//   Chart Zone Source selector controls which tier renders on the main chart.
// ═══════════════════════════════════════════════════════════════════════════════

indicator("mbz sif relay •", shorttitle="relay • DEVELOPMENT", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

