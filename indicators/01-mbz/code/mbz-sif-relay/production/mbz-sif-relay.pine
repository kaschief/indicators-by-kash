po3_midline_color      = input.color(color.new(color.rgb(0, 0, 0), 50), "PO3 Midline", group=GROUP_PO3_FVGS, inline="po3_midline")
po3_midline_style      = input.string("----", "", options=["⎯⎯⎯", "----", "····"], group=GROUP_PO3_FVGS, inline="po3_midline")

// ─── 🎯 MBZ ───
po3_show_mbz           = input.bool(true, "Enable MBZ", group=GROUP_MBZ)
