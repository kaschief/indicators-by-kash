// ═══════════════════════════════════════════════════════════════════════════════
// NON-CONTEXT STATE (visual elements, not tied to HTF data)
// ═══════════════════════════════════════════════════════════════════════════════

// Current candle boxes
var box wick_box = na
var box body_box = na

// Track previous wick boxes for MBZ highlighting
var box prev_wick_box = na
var box prev_prev_wick_box = na

// Visual storage (shared across HTFs)
var array<HTFCandle> candle_boxes = array.new<HTFCandle>()
var array<box>       inversion_highlights = array.new<box>()
var array<box>       tap_highlights = array.new<box>()

// HTF boundary detection
bool new_htf = IS_VALID ? ta.change(time(HTF_STRING)) != 0 : false
bool new_htf2 = IS_VALID_HTF2 ? ta.change(time(HTF2_STRING)) != 0 : false

// Breakaway trend range (HTF 20-bar high/low for breakaway detection)
float htf_breakaway_upper = IS_VALID ? request.security(syminfo.tickerid, HTF_STRING, ta.highest(high, BREAKAWAY_LENGTH)) : na
float htf_breakaway_lower = IS_VALID ? request.security(syminfo.tickerid, HTF_STRING, ta.lowest(low, BREAKAWAY_LENGTH)) : na
float htf2_breakaway_upper = IS_VALID_HTF2 ? request.security(syminfo.tickerid, HTF2_STRING, ta.highest(high, BREAKAWAY_LENGTH)) : na
float htf2_breakaway_lower = IS_VALID_HTF2 ? request.security(syminfo.tickerid, HTF2_STRING, ta.lowest(low, BREAKAWAY_LENGTH)) : na

// ═══════════════════════════════════════════════════════════════════════════════
// FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════════
// MBZ LABEL TEXT
// ═══════════════════════════════════════════════════════════════════════════════

// Convert HTF label to bold Unicode
get_bold_htf_label(string label) =>
    switch label
        "5m"  => "𝟱𝗺"
        "15m" => "𝟭𝟱𝗺"
        "30m" => "𝟯𝟬𝗺"
        "1H"  => "𝟭𝗛"
        "4H"  => "𝟰𝗛"
        "D"   => "𝗗"
        "W"   => "𝗪"
        => label

// Build MBZ box label text: MBZ⁺·{𝗧𝗙} with optional source type on new line
build_mbz_box_label(bool is_bullish, array<string> source_gap_types) =>
    string direction_suffix = is_bullish ? MBZ_BULLISH_SUFFIX : MBZ_BEARISH_SUFFIX
    // Regular MBZ + Bold TF: MBZ⁺·𝟰𝗛
    string result = "MBZ" + direction_suffix + "·" + get_bold_htf_label(HTF_LABEL)

    int num_sources = array.size(source_gap_types)
    if num_sources == 0
        result
    else
        // Count each type
        int fvg_count = 0
        int imp_count = 0
        int vol_count = 0

        for i = 0 to num_sources - 1
            string src = array.get(source_gap_types, i)
            if src == GAP_TYPE_FVG
                fvg_count += 1
            else if src == GAP_TYPE_IMPLIED
                imp_count += 1
            else if src == GAP_TYPE_VOLUME
                vol_count += 1

        // Count distinct types
        int distinct_types = (fvg_count > 0 ? 1 : 0) + (imp_count > 0 ? 1 : 0) + (vol_count > 0 ? 1 : 0)

        string source_type_text = ""

        if distinct_types == 1
            // Single type: show type with multiplier if count > 1 (FVG shows nothing if count == 1)
            if fvg_count > 0
                if fvg_count == 1
                    source_type_text := ""
                else
                    source_type_text := GAP_SOURCE_FVG_BREAKDOWN_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(fvg_count)
            else if imp_count > 0
                if imp_count == 1
                    source_type_text := "ⁱᵐᵖ"  // Superscript for single implied
                else
                    source_type_text := GAP_SOURCE_IMPLIED_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(imp_count)
            else if vol_count > 0
                if vol_count == 1
                    source_type_text := "ᵛᵒˡ"  // Superscript for single volume
                else
                    source_type_text := GAP_SOURCE_VOLUME_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(vol_count)
        else
            // Multiple distinct types: show "count: type1, type2" format
            array<string> parts = array.new<string>()

            if fvg_count > 0
                array.push(parts, fvg_count == 1 ? GAP_SOURCE_FVG_BREAKDOWN_DISPLAY : GAP_SOURCE_FVG_BREAKDOWN_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(fvg_count))
            if imp_count > 0
                array.push(parts, imp_count == 1 ? GAP_SOURCE_IMPLIED_DISPLAY : GAP_SOURCE_IMPLIED_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(imp_count))
            if vol_count > 0
                array.push(parts, vol_count == 1 ? GAP_SOURCE_VOLUME_DISPLAY : GAP_SOURCE_VOLUME_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(vol_count))

            string breakdown = array.join(parts, BREAKDOWN_SEPARATOR)
            source_type_text := str.tostring(num_sources) + COUNT_SEPARATOR + breakdown

        // Add source type on new line if not empty
        if str.length(source_type_text) > 0
            result := result + "\n" + source_type_text

        result

// Calculate MBZ zone boundaries based on subtype
// Includes reference wick extension when enabled
// Returns [zone_top, zone_bottom]
get_mbz_zone(float mbz_open, float mbz_high, float mbz_low, float mbz_close, bool is_bullish, string subtype, float ref_high, float ref_low) =>
    float body_top = math.max(mbz_open, mbz_close)
    float body_bot = math.min(mbz_open, mbz_close)

    if subtype == SUBTYPE_INCLUSION
        // Inclusion: Close to dominant wick
        if is_bullish
            // Bullish inclusion: lower boundary may extend to reference low
            if extend_to_reference_wick and ref_low < mbz_low
                [mbz_close, ref_low]
            else
                [mbz_close, mbz_low]
        else
            // Bearish inclusion: upper boundary may extend to reference high
            if extend_to_reference_wick and ref_high > mbz_high
                [ref_high, mbz_close]
            else
                [mbz_high, mbz_close]
    else if subtype == SUBTYPE_REFLECTION
        // Reflection: Mirror wick distance from open, projected from close
        if is_bullish
            float wick_range = math.abs(mbz_high - mbz_open)
            // Bullish reflection: lower boundary may extend to reference low
            if extend_to_reference_wick and ref_low < mbz_low
                [mbz_close, ref_low]
            else
                [mbz_close, mbz_close - wick_range]
        else
            float wick_range = math.abs(mbz_low - mbz_open)
            // Bearish reflection: upper boundary may extend to reference high
            if extend_to_reference_wick and ref_high > mbz_high
                [ref_high, mbz_close]
            else
                [mbz_close + wick_range, mbz_close]
    else
        // Standard: Body only, with optional reference wick extension
        if extend_to_reference_wick
            if is_bullish
                // Bullish: extend lower boundary to reference low if lower
                if ref_low < mbz_low
                    [body_top, ref_low]
                else
                    [body_top, body_bot]
            else
                // Bearish: extend upper boundary to reference high if higher
                if ref_high > mbz_high
                    [ref_high, body_bot]
                else
                    [body_top, body_bot]
        else
            [body_top, body_bot]

// Build MBZ label text
// Format: "MBZ⁺" or "MBZ⁻" with optional subtype
build_mbz_label(bool is_bullish, string subtype, string source_type) =>
    string base = MBZ_BASE_TEXT + (is_bullish ? MBZ_BULLISH_SUFFIX : MBZ_BEARISH_SUFFIX)

    // Add subtype suffix for non-standard
    string subtype_suffix = ""
    if subtype == SUBTYPE_INCLUSION
        subtype_suffix := " inc"
    else if subtype == SUBTYPE_REFLECTION
        subtype_suffix := " ref"

    // Add source type prefix for implied
    string source_prefix = ""
    if source_type == GAP_TYPE_IMPLIED
        source_prefix := "imp "

    source_prefix + base + subtype_suffix

// Build source breakdown text from gap types array
// Returns empty string for single FVG (standard case), otherwise shows breakdown
build_source_breakdown(array<string> source_gap_types) =>
    int num_sources = array.size(source_gap_types)
    if num_sources == 0
        ""
    else
        // Count each type
        int fvg_count = 0
        int imp_count = 0
        int vol_count = 0

        for i = 0 to num_sources - 1
            string src = array.get(source_gap_types, i)
            if src == GAP_TYPE_FVG
                fvg_count += 1
            else if src == GAP_TYPE_IMPLIED
                imp_count += 1
            else if src == GAP_TYPE_VOLUME
                vol_count += 1

        // Count distinct types
        int distinct_types = (fvg_count > 0 ? 1 : 0) + (imp_count > 0 ? 1 : 0) + (vol_count > 0 ? 1 : 0)

        string source_type_text = ""

        if distinct_types == 1
            // Single type: show type with multiplier if count > 1 (FVG shows nothing if count == 1)
            if fvg_count > 0
                if fvg_count == 1
                    source_type_text := ""
                else
                    source_type_text := GAP_SOURCE_FVG_BREAKDOWN_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(fvg_count)
            else if imp_count > 0
                if imp_count == 1
                    source_type_text := "ⁱᵐᵖ"  // Superscript for single implied
                else
                    source_type_text := GAP_SOURCE_IMPLIED_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(imp_count)
            else if vol_count > 0
                if vol_count == 1
                    source_type_text := "ᵛᵒˡ"  // Superscript for single volume
                else
                    source_type_text := GAP_SOURCE_VOLUME_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(vol_count)
        else
            // Multiple distinct types: show "count: type1, type2" format
            array<string> parts = array.new<string>()

            if fvg_count > 0
                array.push(parts, fvg_count == 1 ? GAP_SOURCE_FVG_BREAKDOWN_DISPLAY : GAP_SOURCE_FVG_BREAKDOWN_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(fvg_count))
            if imp_count > 0
                array.push(parts, imp_count == 1 ? GAP_SOURCE_IMPLIED_DISPLAY : GAP_SOURCE_IMPLIED_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(imp_count))
            if vol_count > 0
                array.push(parts, vol_count == 1 ? GAP_SOURCE_VOLUME_DISPLAY : GAP_SOURCE_VOLUME_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(vol_count))

            string breakdown = array.join(parts, BREAKDOWN_SEPARATOR)
            source_type_text := str.tostring(num_sources) + COUNT_SEPARATOR + breakdown

        source_type_text

// Build unified zone label showing which engines validated it
// Format: "𝗠𝗕𝗭·𝗦𝗜𝗙⁺·𝟰𝗛" or "IMM-SIF⁺·𝟰𝗛" or "MBZ⁺·𝟰𝗛" with source breakdown on second line
build_zone_label(CandleZone zone) =>
    string direction_suffix = zone.is_bullish ? "⁺" : "⁻"

    // Build engine prefix
    string engine_prefix = ""
    if zone.has_mbz and zone.has_sif
        engine_prefix := SIF_MBZ_COMBINED_BOLD
    else if zone.has_mbz
        engine_prefix := MBZ_BASE_TEXT
    else if zone.has_sif
        engine_prefix := SIF_LABEL

    // Prepend breakaway prefix if zone has breakaway source
    string breakaway_prefix = zone.is_breakaway ? LABEL_PREFIX_BREAKAWAY : ""

    // Use zone's stored HTF label (supports multi-HTF)
    string htf_label_display = na(zone.htf_label) ? get_bold_htf_label(HTF_LABEL) : get_bold_htf_label(zone.htf_label)
    string result = breakaway_prefix + engine_prefix + direction_suffix + "·" + htf_label_display

    // Add source breakdown on new line if not empty
    string source_text = build_source_breakdown(zone.source_gap_types)
    if str.length(source_text) > 0
        result := result + "\n" + source_text

    result

// ─── Body Boundary Helpers ───
htf_body_top(float o, float c) => math.max(o, c)
htf_body_bot(float o, float c) => math.min(o, c)

// ─── HTF Displacement Candle Check ───
// Checks if C2 (htf1.o2/htf1.c2) is a displacement candle relative to C3-C5
is_htf_displacement_candle(HTFContext ctx) =>
    // C2 body size
    float c2_body = math.abs(ctx.c2 - ctx.o2)

    // Average body size of C3, C4, C5 (lookback candles)
    float c3_body = math.abs(ctx.c3 - ctx.o3)
    float c4_body = math.abs(ctx.c4 - ctx.o4)
    float c5_body = math.abs(ctx.c5 - ctx.o5)
    float avg_body = (c3_body + c4_body + c5_body) / 3.0

    // Require C2 >= multiplier * average
    if avg_body > 0
        c2_body >= (IMPLIED_DISPLACEMENT_MULTIPLIER * avg_body)
    else
        false

// ─── HTF Implied FVG Detection ───
// Returns [is_valid, bottom, top, is_bullish]
// Convention: C1=[2] oldest, C2=[1] middle, C3=[0] newest
// HTF tracking: htf_*3=oldest, htf_*2=middle, htf_*1=newest
detect_htf_implied_fvg(HTFContext ctx) =>
    // Pre-filter: Check displacement candle strength
    if not is_htf_displacement_candle(ctx)
        [false, float(na), float(na), bool(na)]
    else
        // Body boundaries
        // old = htf_*3 (oldest)
        // new = htf_*1 (newest)
        float old_body_top = htf_body_top(ctx.o3, ctx.c3)
        float old_body_bot = htf_body_bot(ctx.o3, ctx.c3)
        float new_body_top = htf_body_top(ctx.o1, ctx.c1)
        float new_body_bot = htf_body_bot(ctx.o1, ctx.c1)

        // ─── BULLISH Implied FVG ───
        // Price moved UP: old candle below, new candle above
        // Bodies separate: old body top < new body bottom (gap between)
        // Wicks overlap: old upper wick overlaps new lower wick
        bool bodies_sep_bull = old_body_top < new_body_bot
        bool old_upper_wick_exists = ctx.h3 > old_body_top
        bool new_lower_wick_exists = new_body_bot > ctx.l1
        bool bull_wicks_valid = bodies_sep_bull and old_upper_wick_exists and new_lower_wick_exists

        float bull_overlap_lo = math.max(old_body_top, ctx.l1)
        float bull_overlap_hi = math.min(ctx.h3, new_body_bot)
        bool bull_has_overlap = bull_overlap_hi > bull_overlap_lo and bull_wicks_valid

        if bull_has_overlap
            [true, old_body_top, new_body_bot, true]
        else
            // ─── BEARISH Implied FVG ───
            // Price moved DOWN: old candle above, new candle below
            // Bodies separate: new body top < old body bottom (gap between)
            // Wicks overlap: new upper wick overlaps old lower wick
            bool bodies_sep_bear = new_body_top < old_body_bot
            bool new_upper_wick_exists = ctx.h1 > new_body_top
            bool old_lower_wick_exists = old_body_bot > ctx.l3
            bool bear_wicks_valid = bodies_sep_bear and new_upper_wick_exists and old_lower_wick_exists

            float bear_overlap_lo = math.max(new_body_top, ctx.l3)
            float bear_overlap_hi = math.min(ctx.h1, old_body_bot)
            bool bear_has_overlap = bear_overlap_hi > bear_overlap_lo and bear_wicks_valid

            if bear_has_overlap
                [true, new_body_top, old_body_bot, false]
            else
                [false, float(na), float(na), false]

// ═══════════════════════════════════════════════════════════════════════════════
// HTF VOLUME IMBALANCE DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

// Detects 2-candle bullish Volume Imbalance with body separation and wick overlap
// Uses htf_*1 (newest) and htf_*2 (previous) candles
// Condition: htf_*1 body completely above htf_*2 body, but wicks still connect
is_htf_bullish_vi(HTFContext ctx) =>
    float curr_body_bot = htf_body_bot(ctx.o1, ctx.c1)  // Current body bottom
    float prev_body_top = htf_body_top(ctx.o2, ctx.c2)  // Previous body top
    bool bodies_separated = curr_body_bot > prev_body_top
    bool wicks_still_connect = ctx.l1 <= ctx.h2  // Current low reaches previous high
    bodies_separated and wicks_still_connect

// Detects 2-candle bearish Volume Imbalance with body separation and wick overlap
// Uses htf_*1 (newest) and htf_*2 (previous) candles
// Condition: htf_*1 body completely below htf_*2 body, but wicks still connect
is_htf_bearish_vi(HTFContext ctx) =>
    float curr_body_top = htf_body_top(ctx.o1, ctx.c1)  // Current body top
    float prev_body_bot = htf_body_bot(ctx.o2, ctx.c2)  // Previous body bottom
    bool bodies_separated = curr_body_top < prev_body_bot
    bool wicks_still_connect = ctx.h1 >= ctx.l2  // Current high reaches previous low
    bodies_separated and wicks_still_connect

// Calculates Volume Imbalance gap coordinates using 2-candle body separation
// Returns [gap_top, gap_bottom]
get_htf_vi_coordinates(HTFContext ctx, bool is_bullish_gap) =>
    if is_bullish_gap
        // Bullish VI: gap between htf_*2 body top and htf_*1 body bottom
        float gap_bottom = htf_body_top(ctx.o2, ctx.c2)  // Previous body top
        float gap_top = htf_body_bot(ctx.o1, ctx.c1)     // Current body bottom
        [gap_top, gap_bottom]
    else
        // Bearish VI: gap between htf_*2 body bottom and htf_*1 body top
        float gap_top = htf_body_bot(ctx.o2, ctx.c2)     // Previous body bottom
        float gap_bottom = htf_body_top(ctx.o1, ctx.c1)  // Current body top
        [gap_top, gap_bottom]

// Checks if Volume Imbalance should be suppressed by higher-priority gaps
// Matches SIF-Core's is_gap_overlapping logic exactly:
// VI is suppressed if there's an overlapping FVG or Implied FVG of the same direction that is still open
is_htf_vi_suppressed_by_gaps(array<GapData> gap_arr, float vi_top, float vi_bottom, bool is_vi_bullish) =>
    if array.size(gap_arr) == 0
        false  // No existing gaps = no suppression
    else
        bool has_overlap = false
        for i = 0 to array.size(gap_arr) - 1
            GapData gap = array.get(gap_arr, i)

            // Check for both FVG AND Implied FVG (not volume) - institutional gap hierarchy
            // Matches SIF-Core: (gap.gap_type == GAP_TYPE_FVG or gap.gap_type == GAP_TYPE_IMPLIED)
            bool is_higher_priority = gap.gap_type == GAP_TYPE_FVG or gap.gap_type == GAP_TYPE_IMPLIED
            bool same_direction = gap.is_bullish == is_vi_bullish
            bool is_open = not gap.is_inverted  // Inverted = closed, cannot suppress

            if is_higher_priority and same_direction and is_open
                // Use >= for edge case where VI exactly touches gap boundary (matches SIF-Core)
                if vi_bottom < gap.top and vi_top >= gap.bottom
                    has_overlap := true
                    break  // Found overlap, VI will be suppressed
        has_overlap

// ═══════════════════════════════════════════════════════════════════════════════
// HTF WINDOW MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

// Get window start time from htf_times array (independent of candle display)
get_window_start(array<int> times_arr) =>
    int start = 0
    if array.size(times_arr) > 0
        int idx = math.min(max_htf_candles - 1, array.size(times_arr) - 1)
        if idx >= 0
            start := array.get(times_arr, idx)
    start

// Maintain htf_times array for window tracking
update_htf_times(array<int> times_arr, int candle_time) =>
    array.unshift(times_arr, candle_time)
    while array.size(times_arr) > max_htf_candles
        array.pop(times_arr)

// ═══════════════════════════════════════════════════════════════════════════════
// HTF PROCESSING HELPERS (reusable across multiple HTF contexts)
// ═══════════════════════════════════════════════════════════════════════════════

// Create a gap and add to context's gap_array
// Centralizes all gap creation to eliminate duplication
create_htf_gap(HTFContext ctx, string gap_type, bool is_bullish, float top, float bot, int start_time, int formation_end_time, bool is_breakaway, string label_suffix) =>
    float ce = (top + bot) / 2
    int gap_id = ctx.next_gap_id
    ctx.next_gap_id := ctx.next_gap_id + 1

    GapData gap = GapData.new()
    gap.top := top
    gap.bottom := bot
    gap.ce := ce
    gap.bar_index := bar_index
    gap.start_time := start_time
    gap.formation_end_time := formation_end_time
    gap.is_bullish := is_bullish
    gap.gap_type := gap_type
    gap.gap_id := gap_id
    gap.is_breakaway := is_breakaway
    gap.gap_box := box.new(start_time, top, time, bot, xloc=xloc.bar_time, bgcolor=color.new(GAP_COLOR, 100), border_color=color.new(GAP_COLOR, 100), border_width=1)
    gap.ce_line := line.new(start_time, ce, time, ce, xloc=xloc.bar_time, color=color.new(GAP_COLOR, 100), style=line.style_dotted, width=1)
    string label_text = ctx.htf_label + label_suffix
    gap.tf_label := label.new(time, ce, label_text, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white, 100), textcolor=color.new(GAP_COLOR, 100), size=size.small)

    array.unshift(ctx.gap_array, gap)

// Shift history for an HTF context when a new candle closes
// Also resets current candle tracking for the new forming candle
shift_htf_history(HTFContext ctx, float htf_close, float breakaway_upper, float breakaway_lower) =>
    // Shift [4] → [5]
    ctx.o5 := ctx.o4, ctx.h5 := ctx.h4, ctx.l5 := ctx.l4, ctx.c5 := ctx.c4
    // Shift [3] → [4]
    ctx.o4 := ctx.o3, ctx.h4 := ctx.h3, ctx.l4 := ctx.l3, ctx.c4 := ctx.c3
    // Shift [2] → [3]
    ctx.o3 := ctx.o2, ctx.h3 := ctx.h2, ctx.l3 := ctx.l2, ctx.c3 := ctx.c2, ctx.t3 := ctx.t2
    // Shift [1] → [2]
    ctx.o2 := ctx.o1, ctx.h2 := ctx.h1, ctx.l2 := ctx.l1, ctx.c2 := ctx.c1, ctx.t2 := ctx.t1
    // Shift current → [1]
    ctx.o1 := ctx.curr_open, ctx.h1 := ctx.curr_high, ctx.l1 := ctx.curr_low, ctx.c1 := htf_close, ctx.t1 := ctx.curr_time

    // Shift breakaway trend range
    ctx.breakaway_upper_3 := ctx.breakaway_upper_2
    ctx.breakaway_lower_3 := ctx.breakaway_lower_2
    ctx.breakaway_upper_2 := ctx.breakaway_upper_1
    ctx.breakaway_lower_2 := ctx.breakaway_lower_1
    ctx.breakaway_upper_1 := breakaway_upper
    ctx.breakaway_lower_1 := breakaway_lower

    // Reset current candle for new forming candle
    ctx.curr_open := open
    ctx.curr_high := high
    ctx.curr_low := low
    ctx.curr_time := time

// Detect all gap types for an HTF context
// Called after history shift, creates gaps in ctx.gap_array
detect_htf_gaps(HTFContext ctx, int window_start) =>
    if ctx.h3 > 0  // Ensure we have 3 candles of history
        bool gap_in_window = ctx.t3 >= window_start or window_start == 0

        // ─── Standard FVG Detection (Bullish) ───
        if enable_fvg and gap_in_window
            if ctx.l1 > ctx.h3
                bool is_breakaway = not na(ctx.breakaway_upper_3) and ctx.l1 > ctx.breakaway_upper_3
                create_htf_gap(ctx, GAP_TYPE_FVG, true, ctx.l1, ctx.h3, ctx.t3, ctx.t1, is_breakaway, "")

        // ─── Standard FVG Detection (Bearish) ───
        if enable_fvg and gap_in_window
            if ctx.h1 < ctx.l3
                bool is_breakaway = not na(ctx.breakaway_lower_3) and ctx.h1 < ctx.breakaway_lower_3
                create_htf_gap(ctx, GAP_TYPE_FVG, false, ctx.l3, ctx.h1, ctx.t3, ctx.t1, is_breakaway, "")

        // ─── Implied FVG Detection ───
        if enable_implied and gap_in_window
            [impl_found, impl_bot, impl_top, impl_bull] = detect_htf_implied_fvg(ctx)
            if impl_found
                create_htf_gap(ctx, GAP_TYPE_IMPLIED, impl_bull, impl_top, impl_bot, ctx.t3, ctx.t1, false, " imp")

        // ─── Volume Imbalance Detection (Bullish) ───
        if enable_volume and ctx.h2 > 0
            bool vi_in_window = ctx.t2 >= window_start or window_start == 0
            if vi_in_window and is_htf_bullish_vi(ctx)
                [vi_top, vi_bot] = get_htf_vi_coordinates(ctx, true)
                bool vi_is_suppressed = disable_vi_suppression ? false : is_htf_vi_suppressed_by_gaps(ctx.gap_array, vi_top, vi_bot, true)
                if not vi_is_suppressed
                    create_htf_gap(ctx, GAP_TYPE_VOLUME, true, vi_top, vi_bot, ctx.t2, ctx.t1, false, " vol")

        // ─── Volume Imbalance Detection (Bearish) ───
        if enable_volume and ctx.h2 > 0
            bool vi_in_window = ctx.t2 >= window_start or window_start == 0
            if vi_in_window and is_htf_bearish_vi(ctx)
                [vi_top, vi_bot] = get_htf_vi_coordinates(ctx, false)
                bool vi_is_suppressed = disable_vi_suppression ? false : is_htf_vi_suppressed_by_gaps(ctx.gap_array, vi_top, vi_bot, false)
                if not vi_is_suppressed
                    create_htf_gap(ctx, GAP_TYPE_VOLUME, false, vi_top, vi_bot, ctx.t2, ctx.t1, false, " vol")

// Check gap interactions: first tap and inversion (close through)
// Must be called BEFORE MBZ detection - ALWAYS runs (independent of gap display mode)
// Handles three visual cases:
//   1. First Tapper only: dashed border (cyan=bullish gap, pink=bearish gap)
//   2. Inversion only: solid border (red=bullish gap inverted, green=bearish gap inverted)
//   3. Both (same candle): solid border + fill (immediate SIF)
// Also registers SIF zones when enable_sif_engine is true
check_gap_interactions(array<GapData> gap_arr, array<CandleZone> zone_arr, float htf_candle_open, float htf_candle_high, float htf_candle_low, float htf_candle_close, int htf_candle_time, string htf_label_param) =>
    // OPTIMIZATION: Check if any visual toggle is enabled (skip visual tracking if all off)
    bool any_visual_enabled = show_first_tap_only or show_immediate_sif or show_delayed_inversion

    // Track highest priority interaction across ALL gaps for this candle
    // Priority: Immediate SIF > Delayed Inversion > First Tap Only
    // (Per SIF-Core: if candle is immediate SIF for ANY gap, it's classified as immediate SIF)
    bool has_immediate_sif = false
    bool has_delayed_inversion = false
    bool has_first_tap_only = false

    // Track colors based on first interaction of each type (for consistent coloring)
    color immediate_sif_color = na
    color delayed_inv_color = na
    color first_tap_color = na

    // Track gap sources that contribute to SIF (for zone registration)
    array<int> sif_gap_ids = array.new<int>()
    array<string> sif_gap_types = array.new<string>()
    array<bool> sif_gap_breakaways = array.new<bool>()

    // Body boundaries for tap detection (computed once)
    float body_top = math.max(htf_candle_open, htf_candle_close)
    float body_bottom = math.min(htf_candle_open, htf_candle_close)
    bool is_candle_bullish = htf_candle_close > htf_candle_open
    bool is_candle_bearish = htf_candle_close < htf_candle_open

    if array.size(gap_arr) > 0
        // PASS 1: Process all gaps, update state, and determine highest priority interaction
        for i = 0 to array.size(gap_arr) - 1
            GapData gap = array.get(gap_arr, i)

            // Skip already inverted gaps
            if gap.is_inverted
                continue

            // CRITICAL: The candle that forms the gap cannot tap/invert that same gap
            bool is_gap_forming_candle = htf_candle_time == gap.formation_end_time
            if is_gap_forming_candle
                continue

            // Determine if this candle taps and/or inverts THIS gap
            bool is_first_tap = false
            bool is_inversion = false

            if gap.is_bullish
                // Bullish gap + bearish candle = potential SIF tap
                bool body_enters_from_above = htf_candle_open > gap.top and htf_candle_close < gap.top
                bool body_opens_inside = htf_candle_open <= gap.top and htf_candle_open >= gap.bottom
                bool body_closes_through = htf_candle_open >= gap.bottom and htf_candle_close < gap.bottom
                bool body_enters_gap = is_candle_bearish and (body_enters_from_above or body_opens_inside or body_closes_through)

                // Inversion: CLOSE through gap bottom (SIF Core: close <= gap.bottom)
                bool candle_closes_through = htf_candle_close <= gap.bottom

                if na(gap.sif_body_tapper) and body_enters_gap
                    is_first_tap := true
                if candle_closes_through
                    is_inversion := true
            else
                // Bearish gap + bullish candle = potential SIF tap
                bool body_enters_from_below = htf_candle_open < gap.bottom and htf_candle_close > gap.bottom
                bool body_opens_inside = htf_candle_open >= gap.bottom and htf_candle_open <= gap.top
                bool body_closes_through = htf_candle_open <= gap.top and htf_candle_close > gap.top
                bool body_enters_gap = is_candle_bullish and (body_enters_from_below or body_opens_inside or body_closes_through)

                // Inversion: CLOSE through gap top (SIF Core: close >= gap.top)
                bool candle_closes_through = htf_candle_close >= gap.top

                if na(gap.sif_body_tapper) and body_enters_gap
                    is_first_tap := true
                if candle_closes_through
                    is_inversion := true

            // Record first tapper if this is the first tap
            if is_first_tap
                TapCandidate tapper = TapCandidate.new()
                tapper.bar_index := bar_index
                tapper.bar_time := htf_candle_time
                tapper.body_top := body_top
                tapper.body_bottom := body_bottom
                tapper.is_bullish := is_candle_bullish
                gap.sif_body_tapper := tapper

            // Record inversion
            if is_inversion
                gap.is_inverted := true
                gap.inverted_time := time

                // Track this gap as SIF source (inversion = SIF)
                array.push(sif_gap_ids, gap.gap_id)
                array.push(sif_gap_types, gap.gap_type)
                array.push(sif_gap_breakaways, gap.is_breakaway)

            // Update gap if anything changed
            if is_first_tap or is_inversion
                array.set(gap_arr, i, gap)

            // Determine colors based on gap direction
            color tap_color = gap.is_bullish ? TAP_BEARISH_CANDLE_COLOR : TAP_BULLISH_CANDLE_COLOR
            color inv_color = gap.is_bullish ? INVERSION_BEARISH_CANDLE_COLOR : INVERSION_BULLISH_CANDLE_COLOR

            // Track highest priority interaction type
            if is_first_tap and is_inversion
                // Immediate SIF (highest priority)
                has_immediate_sif := true
                if na(immediate_sif_color)
                    immediate_sif_color := inv_color
            else if is_inversion
                // Delayed inversion (second priority)
                has_delayed_inversion := true
                if na(delayed_inv_color)
                    delayed_inv_color := inv_color
            else if is_first_tap
                // First tap only (third priority)
                has_first_tap_only := true
                if na(first_tap_color)
                    first_tap_color := tap_color

        // PASS 2: Register SIF zone ONLY for immediate SIF (first tap + inversion same candle)
        // Delayed inversions don't create zones - they're just gap closures, not SIF formations
        if enable_sif_engine and has_immediate_sif
            // Immediate SIF detected - get or create zone for this candle
            // SIF zones don't use reference wick extension (set ref to na, allow_extension to false)
            [zone, zone_idx, is_new] = get_or_create_zone(zone_arr, bar_index, htf_candle_time, htf_candle_open, htf_candle_close, htf_candle_high, htf_candle_low, is_candle_bullish, float(na), float(na), false, htf_label_param)

            // Update zone with SIF flag
            zone.has_sif := true
            zone.is_immediate_sif := true

            // Add all SIF source gaps
            for j = 0 to array.size(sif_gap_ids) - 1
                add_source_to_zone(zone, array.get(sif_gap_ids, j), array.get(sif_gap_types, j), array.get(sif_gap_breakaways, j))

            // Save updated zone back to array
            array.set(zone_arr, zone_idx, zone)

        // PASS 3: Draw ONE highlight based on highest priority interaction (skip if all toggles off)
        if any_visual_enabled
            int highlight_right = htf_candle_time + HTF_MS

            if has_immediate_sif and show_immediate_sif
                // Immediate SIF wins - show thick border with fill
                box highlight = box.new(htf_candle_time, htf_candle_high, highlight_right, htf_candle_low, xloc=xloc.bar_time, bgcolor=color.new(immediate_sif_color, 70), border_color=immediate_sif_color, border_width=3)
                array.push(inversion_highlights, highlight)
            else if has_delayed_inversion and show_delayed_inversion
                // Delayed inversion - show thin border with minimal fill
                box highlight = box.new(htf_candle_time, htf_candle_high, highlight_right, htf_candle_low, xloc=xloc.bar_time, bgcolor=color.new(delayed_inv_color, 90), border_color=delayed_inv_color, border_width=2)
                array.push(inversion_highlights, highlight)
            else if has_first_tap_only and show_first_tap_only
                // First tap only - show dashed border
                box highlight = box.new(htf_candle_time, htf_candle_high, highlight_right, htf_candle_low, xloc=xloc.bar_time, bgcolor=color.new(first_tap_color, 95), border_color=first_tap_color, border_width=2, border_style=line.style_dashed)
                array.push(tap_highlights, highlight)

// Check for MBZ formation (check tap + conviction in single pass)
// prev_* = reference candle (htf_*2 = candle before the one that just completed)
// curr_* = MBZ candle (htf_*1 = candle that just completed)
// ref_time = reference candle's start time (htf1.t2) - must be AFTER gap formation
// Returns array of MBZFormationMatch for ALL gaps that form MBZs on this candle
check_mbz_formation(array<GapData> gap_arr, float prev_o, float prev_h, float prev_l, float prev_c, int ref_time, float curr_o, float curr_h, float curr_l, float curr_c) =>
    array<MBZFormationMatch> matches = array.new<MBZFormationMatch>()

    // Previous candle (reference) direction
    bool prev_is_bullish = prev_c > prev_o
    bool prev_is_bearish = prev_c < prev_o

    // Current candle (MBZ) direction
    bool curr_is_bullish = curr_c > curr_o
    bool curr_is_bearish = curr_c < curr_o

    if array.size(gap_arr) > 0
        for i = 0 to array.size(gap_arr) - 1
            GapData gap = array.get(gap_arr, i)

            // Skip closed gaps - inverted gaps are closed and cannot form MBZ
            if gap.is_inverted
                continue

            // CRITICAL: Reference candle must be AFTER gap formation
            // This prevents FVG-forming candles from being detected as MBZ
            if ref_time <= gap.formation_end_time
                continue

            // Check if PREVIOUS candle tapped this gap
            bool prev_tapped_gap = false

            if gap.is_bullish and prev_is_bearish
                // Bullish gap: bearish candle wick must enter gap
                if prev_l <= gap.top and prev_h >= gap.bottom
                    prev_tapped_gap := true
            else if not gap.is_bullish and prev_is_bullish
                // Bearish gap: bullish candle wick must enter gap
                if prev_h >= gap.bottom and prev_l <= gap.top
                    prev_tapped_gap := true

            // Check for MBZ formation (tap + conviction)
            if prev_tapped_gap
                float prev_body_top = math.max(prev_o, prev_c)
                float prev_body_bot = math.min(prev_o, prev_c)
                float prev_50_percent = (prev_body_top + prev_body_bot) / 2

                // Bullish MBZ: gap bullish, ref bearish, current bullish, close >= 50%
                if gap.is_bullish and prev_is_bearish and curr_is_bullish
                    if curr_c >= prev_50_percent
                        // Mark source FVG - freeze box at reference candle + track MBZ direction
                        gap.mbz_ref_time := ref_time
                        gap.mbz_is_bullish := true
                        array.set(gap_arr, i, gap)
                        // Detect subtype from MBZ candle (always on)
                        [detected_subtype, _has_dominant] = detect_zone_subtype(curr_o, curr_c, curr_h, curr_l)
                        // Create match record
                        MBZFormationMatch match = MBZFormationMatch.new()
                        match.is_bullish := true
                        match.subtype := detected_subtype
                        match.source_gap_id := gap.gap_id
                        match.source_gap_type := gap.gap_type
                        match.source_gap_is_breakaway := gap.is_breakaway
                        array.push(matches, match)

                // Bearish MBZ: gap bearish, ref bullish, current bearish, close <= 50%
                else if not gap.is_bullish and prev_is_bullish and curr_is_bearish
                    if curr_c <= prev_50_percent
                        // Mark source FVG - freeze box at reference candle + track MBZ direction
                        gap.mbz_ref_time := ref_time
                        gap.mbz_is_bullish := false
                        array.set(gap_arr, i, gap)
                        // Detect subtype from MBZ candle (always on)
                        [detected_subtype, _has_dominant] = detect_zone_subtype(curr_o, curr_c, curr_h, curr_l)
                        // Create match record
                        MBZFormationMatch match = MBZFormationMatch.new()
                        match.is_bullish := false
                        match.subtype := detected_subtype
                        match.source_gap_id := gap.gap_id
                        match.source_gap_type := gap.gap_type
                        match.source_gap_is_breakaway := gap.is_breakaway
                        array.push(matches, match)

    matches

// Update FVG box positions and visibility based on display mode + direction filter
// Priority: mbz_ref_time (freeze at reference candle) > inverted_time > current time
update_gap_positions(array<GapData> gap_arr, array<CandleZone> zone_arr) =>
    int gap_count = array.size(gap_arr)
    if gap_count > 0
        // OPTIMIZATION: Pre-calculate colors outside loop
        color gap_bg_visible = color.new(GAP_COLOR, 90)
        color gap_bg_hidden = color.new(GAP_COLOR, 100)
        color gap_border_visible = color.new(GAP_COLOR, 70)
        color gap_border_hidden = color.new(GAP_COLOR, 100)
        color gap_label_visible = color.new(GAP_COLOR, 50)
        color gap_label_hidden = color.new(GAP_COLOR, 100)

        // OPTIMIZATION: Build active gap_id lookup maps ONCE before iterating gaps
        // This converts O(n*m) nested loops to O(n+m) with O(1) lookups
        map<int, bool> active_mbz_gap_ids = map.new<int, bool>()
        map<int, bool> active_sif_gap_ids = map.new<int, bool>()
        int zone_count = array.size(zone_arr)
        if zone_count > 0
            for i = 0 to zone_count - 1
                CandleZone zone = array.get(zone_arr, i)
                int gap_id_count = array.size(zone.source_gap_ids)
                if gap_id_count > 0
                    if zone.has_mbz and not zone.mbz_invalidated
                        for j = 0 to gap_id_count - 1
                            map.put(active_mbz_gap_ids, array.get(zone.source_gap_ids, j), true)
                    if zone.has_sif and not zone.sif_invalidated
                        for j = 0 to gap_id_count - 1
                            map.put(active_sif_gap_ids, array.get(zone.source_gap_ids, j), true)

        for i = 0 to gap_count - 1
            GapData gap = array.get(gap_arr, i)
            // Freeze at reference candle when MBZ formed, else at inversion, else extend
            int right_edge = gap.mbz_ref_time > 0 ? gap.mbz_ref_time : (gap.is_inverted ? gap.inverted_time : time)
            box.set_right(gap.gap_box, right_edge)
            line.set_x2(gap.ce_line, right_edge)
            label.set_x(gap.tf_label, right_edge)

            // Check if this gap led to an MBZ and passes filters (must have MBZ engine enabled)
            bool type_ok = (enable_fvg and gap.gap_type == GAP_TYPE_FVG) or (enable_implied and gap.gap_type == GAP_TYPE_IMPLIED) or (enable_volume and gap.gap_type == GAP_TYPE_VOLUME)
            bool dir_ok = mbz_direction_filter == DIR_BOTH or (gap.mbz_is_bullish and mbz_direction_filter == DIR_BULLISH) or (not gap.mbz_is_bullish and mbz_direction_filter == DIR_BEARISH)
            bool is_mbz_source = enable_mbz_engine and gap.mbz_ref_time > 0 and dir_ok and type_ok
            // Check if this gap was inverted (became a SIF source, must have SIF engine enabled)
            bool sif_dir_ok = mbz_direction_filter == DIR_BOTH or (gap.is_bullish and mbz_direction_filter == DIR_BEARISH) or (not gap.is_bullish and mbz_direction_filter == DIR_BULLISH)
            bool is_sif_source = enable_sif_engine and gap.is_inverted and sif_dir_ok and type_ok

            // Check zone validity using O(1) map lookup
            bool mbz_zone_active = map.contains(active_mbz_gap_ids, gap.gap_id)
            bool sif_zone_active = map.contains(active_sif_gap_ids, gap.gap_id)

            // Determine gap visibility based on display mode
            bool show_gap = switch gap_display_mode
                GAP_DISPLAY_ALL        => type_ok  // Show all gaps matching type filter
                GAP_DISPLAY_MBZ_SOURCE => is_mbz_source and mbz_zone_active  // Only gaps with active MBZ
                GAP_DISPLAY_SIF_SOURCE => is_sif_source and sif_zone_active  // Only gaps with active SIF
                => false  // GAP_DISPLAY_OFF

            // Use pre-calculated colors
            box.set_bgcolor(gap.gap_box, show_gap ? gap_bg_visible : gap_bg_hidden)
            box.set_border_color(gap.gap_box, show_gap ? gap_border_visible : gap_border_hidden)
            line.set_color(gap.ce_line, show_gap ? gap_border_visible : gap_border_hidden)
            label.set_textcolor(gap.tf_label, show_gap ? gap_label_visible : gap_label_hidden)

// Cleanup FVGs: window-based + enforce max count
cleanup_gaps(array<GapData> gap_arr, int window_start, int max_count) =>
    // Remove FVGs outside data window
    if window_start > 0 and array.size(gap_arr) > 0
        for i = array.size(gap_arr) - 1 to 0
            GapData gap = array.get(gap_arr, i)
            if gap.start_time < window_start
                box.delete(gap.gap_box)
                line.delete(gap.ce_line)
                label.delete(gap.tf_label)
                array.remove(gap_arr, i)
    // Enforce max count (remove oldest to stay under drawing limit)
    while array.size(gap_arr) > max_count
        GapData old = array.pop(gap_arr)
        box.delete(old.gap_box)
        line.delete(old.ce_line)
        label.delete(old.tf_label)

// Cleanup old candle boxes beyond limit
cleanup_candles() =>
    while array.size(candle_boxes) > max_htf_candles
        HTFCandle old = array.pop(candle_boxes)
        box.delete(old.wick)
        box.delete(old.body)

// Cleanup old inversion highlight boxes beyond limit (only when needed)
cleanup_inversion_highlights() =>
    if array.size(inversion_highlights) > max_htf_candles
        while array.size(inversion_highlights) > max_htf_candles
            box old = array.shift(inversion_highlights)
            box.delete(old)

// Cleanup old tap highlight boxes beyond limit (only when needed)
cleanup_tap_highlights() =>
    if array.size(tap_highlights) > max_htf_candles
        while array.size(tap_highlights) > max_htf_candles
            box old = array.shift(tap_highlights)
            box.delete(old)

// ═══════════════════════════════════════════════════════════════════════════════
// PREVIEW ZONE FUNCTIONS (for forming HTF candle)
// ═══════════════════════════════════════════════════════════════════════════════

// Clear all preview zones (called each bar before re-detecting)
cleanup_preview_zones() =>
    if array.size(preview_zone_array) > 0
        for i = array.size(preview_zone_array) - 1 to 0
            CandleZone zone = array.get(preview_zone_array, i)
            if not na(zone.zone_box)
                box.delete(zone.zone_box)
            if not na(zone.validation_line)
                line.delete(zone.validation_line)
        array.clear(preview_zone_array)

// Create and render a preview zone
// Returns the created zone (also adds to preview_zone_array)
create_preview_zone(int formation_time, float candle_open, float candle_close, float candle_high, float candle_low, bool is_bullish, float ref_high, float ref_low, bool allow_wick_extension, bool has_mbz, bool has_sif, array<int> gap_ids, array<string> gap_types, color zone_color_bull, color zone_color_bear, int zone_extension_width, string htf_label_param) =>
    // Detect subtype from candle shape
    [subtype, _has_dominant] = detect_zone_subtype(candle_open, candle_close, candle_high, candle_low)

    // Calculate zone boundaries
    [zone_top, zone_bottom, is_extended] = calculate_zone_boundaries(candle_open, candle_close, candle_high, candle_low, is_bullish, subtype, ref_high, ref_low, allow_wick_extension)

    // Create zone record
    CandleZone zone = CandleZone.new()
    zone.bar_index := bar_index
    zone.formation_time := formation_time
    zone.candle_open := candle_open
    zone.candle_close := candle_close
    zone.candle_high := candle_high
    zone.candle_low := candle_low
    zone.is_bullish := is_bullish
    zone.zone_subtype := subtype
    zone.has_mbz := has_mbz
    zone.has_sif := has_sif
    zone.zone_top := zone_top
    zone.zone_bottom := zone_bottom
    zone.source_gap_ids := gap_ids
    zone.source_gap_types := gap_types
    zone.is_invalidated := false
    zone.mbz_invalidated := false
    zone.sif_invalidated := false
    zone.ref_candle_high := ref_high
    zone.ref_candle_low := ref_low
    zone.is_wick_extended := is_extended
    zone.is_immediate_sif := has_sif
    zone.is_breakaway := false
    zone.is_preview := true
    zone.htf_label := htf_label_param

    // Create visual box with preview styling (dashed border)
    color zone_color = is_bullish ? zone_color_bull : zone_color_bear
    string zone_label_text = build_zone_label(zone) + "\n(forming)"
    int zone_right_edge = formation_time + zone_extension_width

    zone.zone_box := box.new(formation_time, zone_top, zone_right_edge, zone_bottom, xloc=xloc.bar_time, bgcolor=color.new(zone_color, PREVIEW_FILL_TRANSPARENCY), border_color=zone_color, border_width=2, border_style=line.style_dashed, text=zone_label_text, text_color=zone_label_color, text_size=ZONE_LABEL_SIZE_RESOLVED, text_halign=text.align_right, text_valign=text.align_center)

    // Add to preview array
    array.push(preview_zone_array, zone)

    zone

// Check for preview MBZ formation using forming candle
// ref_* = reference candle (htf_*1 = last confirmed candle)
// forming_* = forming candle (htf_open, htf_high, htf_low, current close)
// ref_time = reference candle's time (htf1.t1)
// Returns array of MBZFormationMatch for potential MBZs
check_preview_mbz_formation(array<GapData> gap_arr, float ref_o, float ref_h, float ref_l, float ref_c, int ref_time, float forming_o, float forming_h, float forming_l, float forming_c) =>
    array<MBZFormationMatch> matches = array.new<MBZFormationMatch>()

    // Reference candle direction
    bool ref_is_bullish = ref_c > ref_o
    bool ref_is_bearish = ref_c < ref_o

    // Forming candle direction (using current close as potential close)
    bool forming_is_bullish = forming_c > forming_o
    bool forming_is_bearish = forming_c < forming_o

    if array.size(gap_arr) > 0
        for i = 0 to array.size(gap_arr) - 1
            GapData gap = array.get(gap_arr, i)

            // Skip closed gaps - inverted gaps cannot form MBZ
            if gap.is_inverted
                continue

            // Reference candle must be AFTER gap formation
            if ref_time <= gap.formation_end_time
                continue

            // Check if REFERENCE candle tapped this gap
            bool ref_tapped_gap = false

            if gap.is_bullish and ref_is_bearish
                // Bullish gap: bearish candle wick must enter gap
                if ref_l <= gap.top and ref_h >= gap.bottom
                    ref_tapped_gap := true
            else if not gap.is_bullish and ref_is_bullish
                // Bearish gap: bullish candle wick must enter gap
                if ref_h >= gap.bottom and ref_l <= gap.top
                    ref_tapped_gap := true

            // Check for potential MBZ formation
            if ref_tapped_gap
                float ref_body_top = math.max(ref_o, ref_c)
                float ref_body_bot = math.min(ref_o, ref_c)
                float ref_50_percent = (ref_body_top + ref_body_bot) / 2

                // Bullish MBZ: gap bullish, ref bearish, forming bullish, close >= 50%
                if gap.is_bullish and ref_is_bearish and forming_is_bullish
                    if forming_c >= ref_50_percent
                        [detected_subtype, _has_dominant] = detect_zone_subtype(forming_o, forming_c, forming_h, forming_l)
                        MBZFormationMatch match = MBZFormationMatch.new()
                        match.is_bullish := true
                        match.subtype := detected_subtype
                        match.source_gap_id := gap.gap_id
                        match.source_gap_type := gap.gap_type
                        match.source_gap_is_breakaway := gap.is_breakaway
                        array.push(matches, match)

                // Bearish MBZ: gap bearish, ref bullish, forming bearish, close <= 50%
                else if not gap.is_bullish and ref_is_bullish and forming_is_bearish
                    if forming_c <= ref_50_percent
                        [detected_subtype, _has_dominant] = detect_zone_subtype(forming_o, forming_c, forming_h, forming_l)
                        MBZFormationMatch match = MBZFormationMatch.new()
                        match.is_bullish := false
                        match.subtype := detected_subtype
                        match.source_gap_id := gap.gap_id
                        match.source_gap_type := gap.gap_type
                        match.source_gap_is_breakaway := gap.is_breakaway
                        array.push(matches, match)

    matches

// Check for preview SIF formation using forming candle
// Returns [has_sif, is_bullish_candle, gap_ids, gap_types, gap_breakaways]
check_preview_sif_formation(array<GapData> gap_arr, float forming_o, float forming_h, float forming_l, float forming_c, int forming_time) =>
    array<int> sif_gap_ids = array.new<int>()
    array<string> sif_gap_types = array.new<string>()
    array<bool> sif_gap_breakaways = array.new<bool>()
    bool has_immediate_sif = false

    // Forming candle direction
    bool is_candle_bullish = forming_c > forming_o
    bool is_candle_bearish = forming_c < forming_o

    if array.size(gap_arr) > 0
        for i = 0 to array.size(gap_arr) - 1
            GapData gap = array.get(gap_arr, i)

            // Skip already inverted gaps
            if gap.is_inverted
                continue

            // Skip if this would be the gap-forming candle
            if forming_time == gap.formation_end_time
                continue

            bool is_first_tap = false
            bool is_inversion = false

            if gap.is_bullish
                // Bullish gap + bearish candle = potential SIF
                bool body_enters_from_above = forming_o > gap.top and forming_c < gap.top
                bool body_opens_inside = forming_o <= gap.top and forming_o >= gap.bottom
                bool body_closes_through = forming_o >= gap.bottom and forming_c < gap.bottom
                bool body_enters_gap = is_candle_bearish and (body_enters_from_above or body_opens_inside or body_closes_through)

                // Check for first tap (no prior tapper recorded)
                if na(gap.sif_body_tapper) and body_enters_gap
                    is_first_tap := true

                // Inversion: close through gap bottom
                if forming_c <= gap.bottom
                    is_inversion := true
            else
                // Bearish gap + bullish candle = potential SIF
                bool body_enters_from_below = forming_o < gap.bottom and forming_c > gap.bottom
                bool body_opens_inside = forming_o >= gap.bottom and forming_o <= gap.top
                bool body_closes_through = forming_o <= gap.top and forming_c > gap.top
                bool body_enters_gap = is_candle_bullish and (body_enters_from_below or body_opens_inside or body_closes_through)

                // Check for first tap (no prior tapper recorded)
                if na(gap.sif_body_tapper) and body_enters_gap
                    is_first_tap := true

                // Inversion: close through gap top
                if forming_c >= gap.top
                    is_inversion := true

            // Immediate SIF: first tap AND inversion same candle
            if is_first_tap and is_inversion
                has_immediate_sif := true
                array.push(sif_gap_ids, gap.gap_id)
                array.push(sif_gap_types, gap.gap_type)
                array.push(sif_gap_breakaways, gap.is_breakaway)

    [has_immediate_sif, is_candle_bullish, sif_gap_ids, sif_gap_types, sif_gap_breakaways]

// ═══════════════════════════════════════════════════════════════════════════════
// INVALIDATION FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// Calculate zone penetration percentage using close price
calculate_mbz_zone_penetration_from_close(float close_price, float zone_top, float zone_bottom, bool is_bullish_zone) =>
    float zone_range = zone_top - zone_bottom
    if zone_range <= 0
        0.0
    else
        if is_bullish_zone
            // Bullish zone: penetration is from top downward
            if close_price >= zone_top
                0.0
            else if close_price <= zone_bottom
                100.0
            else
                (zone_top - close_price) / zone_range * 100.0
        else
            // Bearish zone: penetration is from bottom upward
            if close_price <= zone_bottom
                0.0
            else if close_price >= zone_top
                100.0
            else
                (close_price - zone_bottom) / zone_range * 100.0

// ═══════════════════════════════════════════════════════════════════════════════
// UNIFIED ZONE INVALIDATION
// ═══════════════════════════════════════════════════════════════════════════════

// Generic component invalidation check - works for both MBZ and SIF
check_component_single_candle_invalidation(float zone_top, float zone_bottom, bool is_bullish, float threshold, float candle_open, float candle_close) =>
    if is_bullish
        // Bullish zone: gap-through below zone = instant invalidation
        if candle_open < zone_bottom
            true
        else
            float penetration = calculate_mbz_zone_penetration_from_close(candle_close, zone_top, zone_bottom, true)
            penetration >= threshold
    else
        // Bearish zone: gap-through above zone = instant invalidation
        if candle_open > zone_top
            true
        else
            float penetration = calculate_mbz_zone_penetration_from_close(candle_close, zone_top, zone_bottom, false)
            penetration >= threshold

// Check if MBZ component should be invalidated by a single candle
check_mbz_component_invalidation(CandleZone zone, float candle_open, float candle_close) =>
    if not zone.has_mbz or zone.mbz_invalidated
        false
    else
        check_component_single_candle_invalidation(zone.zone_top, zone.zone_bottom, zone.is_bullish, MBZ_INVALIDATION_THRESHOLD, candle_open, candle_close)

// Check if SIF component should be invalidated by a single candle
check_sif_component_invalidation(CandleZone zone, float candle_open, float candle_close) =>
    if not zone.has_sif or zone.sif_invalidated
        false
    else
        check_component_single_candle_invalidation(zone.zone_top, zone.zone_bottom, zone.is_bullish, SIF_INVALIDATION_THRESHOLD, candle_open, candle_close)

// Check if zone is comprised ONLY of Volume Imbalance (VI) sources
is_vi_only_zone(CandleZone zone) =>
    int num_sources = array.size(zone.source_gap_types)
    if num_sources == 0
        false
    else
        bool all_vi = true
        for i = 0 to num_sources - 1
            if array.get(zone.source_gap_types, i) != GAP_TYPE_VOLUME
                all_vi := false
                break
        all_vi

// Check if MBZ component should be invalidated
// NOTE: Historical lookback removed for relay - close[i]/open[i] is LTF data, not HTF!
// Zones invalidate via: (1) completed HTF candles on new_htf, (2) live htf_open/close check
should_mbz_component_be_invalidated(CandleZone zone, float htf_open_price, float htf_close_price) =>
    if not zone.has_mbz or zone.mbz_invalidated
        false
    else
        check_mbz_component_invalidation(zone, htf_open_price, htf_close_price)

// Check if SIF component should be invalidated
// NOTE: Historical lookback removed for relay - close[i]/open[i] is LTF data, not HTF!
// Zones invalidate via: (1) completed HTF candles on new_htf, (2) live opening gap check
should_sif_component_be_invalidated(CandleZone zone, float htf_open_price, float htf_close_price) =>
    if not zone.has_sif or zone.sif_invalidated
        false
    else
        check_sif_component_invalidation(zone, htf_open_price, htf_close_price)

// ═══════════════════════════════════════════════════════════════════════════════
// LIVE INVALIDATION (Opening Gaps Only)
// For forming HTF candles, we only check opening gaps - NOT close penetration
// Close penetration requires a CONFIRMED HTF close, which isn't available until new_htf
// ═══════════════════════════════════════════════════════════════════════════════

// Check if component is invalidated by opening gap only (for live checks)
check_component_opening_gap_invalidation(float zone_top, float zone_bottom, bool is_bullish, float candle_open) =>
    if is_bullish
        // Bullish zone: gap-through below zone = instant invalidation
        candle_open < zone_bottom
    else
        // Bearish zone: gap-through above zone = instant invalidation
        candle_open > zone_top

// Check MBZ component for opening gap invalidation (live check)
check_mbz_component_opening_gap(CandleZone zone, float candle_open) =>
    if not zone.has_mbz or zone.mbz_invalidated
        false
    else
        check_component_opening_gap_invalidation(zone.zone_top, zone.zone_bottom, zone.is_bullish, candle_open)

// Check SIF component for opening gap invalidation (live check)
check_sif_component_opening_gap(CandleZone zone, float candle_open) =>
    if not zone.has_sif or zone.sif_invalidated
        false
    else
        check_component_opening_gap_invalidation(zone.zone_top, zone.zone_bottom, zone.is_bullish, candle_open)

// Live invalidation for unified zones - OPENING GAPS ONLY (permanent)
// Close-based invalidation is computed in rendering for visual hide/show
check_zone_invalidation_live(array<CandleZone> zone_arr, float htf_open_price) =>
    if array.size(zone_arr) > 0
        for i = 0 to array.size(zone_arr) - 1
            CandleZone zone = array.get(zone_arr, i)

            if zone.is_invalidated
                continue

            bool needs_update = false

            // Check MBZ component for opening gap ONLY (permanent)
            if check_mbz_component_opening_gap(zone, htf_open_price)
                zone.mbz_invalidated := true
                zone.has_mbz := false
                needs_update := true

            // Check SIF component for opening gap ONLY (permanent)
            if check_sif_component_opening_gap(zone, htf_open_price)
                zone.sif_invalidated := true
                zone.has_sif := false
                needs_update := true

            // If NO active components remain, mark zone as fully invalidated
            if not zone.has_mbz and not zone.has_sif
                zone.is_invalidated := true
                if not na(zone.zone_box)
                    box.delete(zone.zone_box)
                    zone.zone_box := na
                if not na(zone.validation_line)
                    line.delete(zone.validation_line)
                    zone.validation_line := na
            else if needs_update
                if not na(zone.zone_box)
                    box.delete(zone.zone_box)
                    zone.zone_box := na
                if not na(zone.validation_line)
                    line.delete(zone.validation_line)
                    zone.validation_line := na

            array.set(zone_arr, i, zone)

// Check invalidation for all unified zones - tracks MBZ and SIF independently
// This is for CONFIRMED HTF candles only (called on new_htf with htf1.o1, htf1.c1)
check_zone_invalidation(array<CandleZone> zone_arr, float htf_open_price, float htf_close_price) =>
    if array.size(zone_arr) > 0
        for i = 0 to array.size(zone_arr) - 1
            CandleZone zone = array.get(zone_arr, i)

            // Skip fully invalidated zones
            if zone.is_invalidated
                continue

            bool needs_update = false

            // Check MBZ component
            if should_mbz_component_be_invalidated(zone, htf_open_price, htf_close_price)
                zone.mbz_invalidated := true
                zone.has_mbz := false  // Remove MBZ from zone
                needs_update := true

            // Check SIF component
            if should_sif_component_be_invalidated(zone, htf_open_price, htf_close_price)
                zone.sif_invalidated := true
                zone.has_sif := false  // Remove SIF from zone
                needs_update := true

            // If NO active components remain, mark zone as fully invalidated
            if not zone.has_mbz and not zone.has_sif
                zone.is_invalidated := true
                // Delete the zone box and validation line
                if not na(zone.zone_box)
                    box.delete(zone.zone_box)
                    zone.zone_box := na
                if not na(zone.validation_line)
                    line.delete(zone.validation_line)
                    zone.validation_line := na
            else if needs_update
                // Partial invalidation: update zone label (box will be updated in rendering loop)
                // Force box recreation by setting to na
                if not na(zone.zone_box)
                    box.delete(zone.zone_box)
                    zone.zone_box := na
                if not na(zone.validation_line)
                    line.delete(zone.validation_line)
                    zone.validation_line := na

            array.set(zone_arr, i, zone)

// Cleanup unified zones outside window
cleanup_zones(array<CandleZone> zone_arr, int window_start, int max_count) =>
    // Remove zones outside data window
    if window_start > 0 and array.size(zone_arr) > 0
        for i = array.size(zone_arr) - 1 to 0
            CandleZone zone = array.get(zone_arr, i)
            if zone.formation_time < window_start
                if not na(zone.zone_box)
                    box.delete(zone.zone_box)
                if not na(zone.validation_line)
                    line.delete(zone.validation_line)
                array.remove(zone_arr, i)
    // Enforce max count (remove oldest to stay under drawing limit)
    while array.size(zone_arr) > max_count
        CandleZone old = array.pop(zone_arr)
        if not na(old.zone_box)
            box.delete(old.zone_box)
        if not na(old.validation_line)
            line.delete(old.validation_line)

// Process a complete HTF candle close for any context
// This is the master function that orchestrates all HTF processing
process_htf_close(HTFContext ctx, float htf_close, float breakaway_upper, float breakaway_lower) =>
    // Window management
    int window_start = get_window_start(ctx.htf_times)

    // Shift history and reset current candle
    shift_htf_history(ctx, htf_close, breakaway_upper, breakaway_lower)

    // Track window
    update_htf_times(ctx.htf_times, ctx.t1)

    // Gap detection
    detect_htf_gaps(ctx, window_start)

    // Cleanup
    cleanup_gaps(ctx.gap_array, window_start, MAX_FVGS)
    cleanup_zones(ctx.zone_array, window_start, MAX_ZONES)

    // Gap interactions (SIF detection)
    check_gap_interactions(ctx.gap_array, ctx.zone_array, ctx.o1, ctx.h1, ctx.l1, ctx.c1, ctx.t1, ctx.htf_label)
    cleanup_inversion_highlights()
    cleanup_tap_highlights()

    // Invalidation check
    if enable_invalidation
        check_zone_invalidation(ctx.zone_array, ctx.o1, ctx.c1)

    // MBZ formation check
    if enable_mbz_engine
        array<MBZFormationMatch> mbz_matches = check_mbz_formation(ctx.gap_array, ctx.o2, ctx.h2, ctx.l2, ctx.c2, ctx.t2, ctx.o1, ctx.h1, ctx.l1, ctx.c1)
        int num_matches = array.size(mbz_matches)

        if num_matches > 0
            MBZFormationMatch first_match = array.get(mbz_matches, 0)
            bool mbz_bull = first_match.is_bullish

            bool show_this_mbz = mbz_direction_filter == DIR_BOTH or (mbz_bull and mbz_direction_filter == DIR_BULLISH) or (not mbz_bull and mbz_direction_filter == DIR_BEARISH)

            if show_this_mbz
                // Calculate consolidated zone boundaries
                float consolidated_zone_top = 0.0
                float consolidated_zone_bottom = 0.0

                for i = 0 to num_matches - 1
                    MBZFormationMatch match = array.get(mbz_matches, i)
                    [match_zone_top, match_zone_bot] = get_mbz_zone(ctx.o1, ctx.h1, ctx.l1, ctx.c1, match.is_bullish, match.subtype, ctx.h2, ctx.l2)
                    if i == 0
                        consolidated_zone_top := match_zone_top
                        consolidated_zone_bottom := match_zone_bot
                    else
                        consolidated_zone_top := math.max(consolidated_zone_top, match_zone_top)
                        consolidated_zone_bottom := math.min(consolidated_zone_bottom, match_zone_bot)

                // Register MBZ in unified zone_array
                [zone, zone_idx, is_new] = get_or_create_zone(ctx.zone_array, bar_index, ctx.t1, ctx.o1, ctx.c1, ctx.h1, ctx.l1, mbz_bull, ctx.h2, ctx.l2, extend_to_reference_wick, ctx.htf_label)

                zone.has_mbz := true
                zone.ref_candle_high := ctx.h2
                zone.ref_candle_low := ctx.l2

                // If existing zone and wick extension enabled but not applied, recalculate
                if not is_new and extend_to_reference_wick and not zone.is_wick_extended
                    [new_top, new_bottom, now_extended] = calculate_zone_boundaries(ctx.o1, ctx.c1, ctx.h1, ctx.l1, mbz_bull, zone.zone_subtype, ctx.h2, ctx.l2, true)
                    zone.zone_top := new_top
                    zone.zone_bottom := new_bottom
                    zone.is_wick_extended := now_extended

                // Add all MBZ source gaps
                for i = 0 to num_matches - 1
                    MBZFormationMatch match = array.get(mbz_matches, i)
                    add_source_to_zone(zone, match.source_gap_id, match.source_gap_type, match.source_gap_is_breakaway)

                array.set(ctx.zone_array, zone_idx, zone)

// ═══════════════════════════════════════════════════════════════════════════════
// MAIN EXECUTION
// ═══════════════════════════════════════════════════════════════════════════════

if IS_VALID
    if new_htf
        // ─── Reset Preview Tracking (new HTF candle = new preview context) ───
        prev_preview_close := na

        // ─── Shift Wick Box History (for MBZ candle highlighting) ───
        prev_prev_wick_box := prev_wick_box
        prev_wick_box := wick_box

        // ─── Process HTF1 Candle Close ───
        if show_htf1
            process_htf_close(htf1, close[1], htf_breakaway_upper, htf_breakaway_lower)

        // ─── Create New Candle Boxes (ALWAYS create for MBZ highlighting) ───
        bool is_bull = close >= open
        // Wick box always created (for MBZ highlighting), invisible if overlay OFF
        color wick_bg = show_htf_candles ? (is_bull ? htf_bull_wick_color : htf_bear_wick_color) : color.new(color.white, 100)
        color wick_bdr = show_htf_candles ? (is_bull ? BULL_BORDER : BEAR_BORDER) : color.new(color.white, 100)
        wick_box := box.new(time, high, time, low, xloc=xloc.bar_time, border_color=wick_bdr, bgcolor=wick_bg, border_width=1, border_style=line.style_dashed)

        // Body box only if overlay ON
        if show_htf_candles
            body_box := box.new(time, math.max(open, close), time, math.min(open, close), xloc=xloc.bar_time, border_color=color.new(color.white, 100), bgcolor=is_bull ? htf_bull_body_color : htf_bear_body_color, border_width=0)

            HTFCandle new_candle = HTFCandle.new()
            new_candle.wick := wick_box
            new_candle.body := body_box
            new_candle.start_time := time
            array.unshift(candle_boxes, new_candle)
            cleanup_candles()

    else
        // ─── Update Forming Candle ───
        htf1.curr_high := math.max(high, htf1.curr_high)
        htf1.curr_low  := math.min(low, htf1.curr_low)

        // Always update wick_box position (for MBZ highlighting)
        if not na(wick_box)
            bool is_bull = close >= htf1.curr_open
            box.set_top(wick_box, htf1.curr_high)
            box.set_bottom(wick_box, htf1.curr_low)
            box.set_right(wick_box, time)
            // Only set visual colors if overlay ON
            if show_htf_candles
                box.set_bgcolor(wick_box, is_bull ? htf_bull_wick_color : htf_bear_wick_color)
                box.set_border_color(wick_box, is_bull ? BULL_BORDER : BEAR_BORDER)

        if show_htf_candles and not na(body_box)
            bool is_bull = close >= htf1.curr_open
            box.set_top(body_box, math.max(htf1.curr_open, close))
            box.set_bottom(body_box, math.min(htf1.curr_open, close))
            box.set_right(body_box, time)
            box.set_bgcolor(body_box, is_bull ? htf_bull_body_color : htf_bear_body_color)

    // ─── FVG Updates (every bar) ───
    if show_htf1
        update_gap_positions(htf1.gap_array, htf1.zone_array)

        // ─── Live Invalidation (every bar) ───
        // Check for OPENING GAPS only (permanent invalidation)
        // Close-based invalidation is computed in rendering loop for visual hide/show
        if enable_invalidation
            check_zone_invalidation_live(htf1.zone_array, htf1.curr_open)

// ─── HTF2 Processing (Secondary Timeframe) ───
if IS_VALID_HTF2 and show_htf2
    if new_htf2
        process_htf_close(htf2, close[1], htf2_breakaway_upper, htf2_breakaway_lower)
    else
        // Update forming HTF2 candle
        htf2.curr_high := math.max(high, htf2.curr_high)
        htf2.curr_low  := math.min(low, htf2.curr_low)

    // HTF2 gap position updates
    update_gap_positions(htf2.gap_array, htf2.zone_array)

    // HTF2 live invalidation
    if enable_invalidation
        check_zone_invalidation_live(htf2.zone_array, htf2.curr_open)

if IS_VALID
    // ─── Preview Zone Detection (realtime only, on price change) ───
    // Check for zones forming during the current HTF candle
    // Uses current LTF close as potential HTF close
    // Only runs on realtime bars to avoid performance overhead on historical data
    // Only updates when close price changes to avoid unnecessary box recreation
    bool preview_close_changed = close != prev_preview_close
    if show_forming_zones and htf1.t1 > 0 and barstate.isrealtime and preview_close_changed
        prev_preview_close := close
        // Clear existing preview zones before re-detecting
        cleanup_preview_zones()

        int preview_extension_width = zone_extension_bars * HTF_MS
        color preview_color_bull = zone_bull_color
        color preview_color_bear = zone_bear_color

        // Preview MBZ: htf_*1 = reference candle, forming candle = potential MBZ candle
        if enable_mbz_engine
            array<MBZFormationMatch> preview_mbz_matches = check_preview_mbz_formation(htf1.gap_array, htf1.o1, htf1.h1, htf1.l1, htf1.c1, htf1.t1, htf1.curr_open, htf1.curr_high, htf1.curr_low, close)
            int num_preview_mbz = array.size(preview_mbz_matches)

            if num_preview_mbz > 0
                MBZFormationMatch first_match = array.get(preview_mbz_matches, 0)
                bool preview_mbz_bull = first_match.is_bullish

                // Apply direction filter
                bool show_preview_mbz = mbz_direction_filter == DIR_BOTH or (preview_mbz_bull and mbz_direction_filter == DIR_BULLISH) or (not preview_mbz_bull and mbz_direction_filter == DIR_BEARISH)

                if show_preview_mbz
                    // Collect gap sources
                    array<int> mbz_gap_ids = array.new<int>()
                    array<string> mbz_gap_types = array.new<string>()
                    for j = 0 to num_preview_mbz - 1
                        MBZFormationMatch match = array.get(preview_mbz_matches, j)
                        array.push(mbz_gap_ids, match.source_gap_id)
                        array.push(mbz_gap_types, match.source_gap_type)

                    // Create preview zone (MBZ uses reference wick extension from htf_*1)
                    create_preview_zone(htf1.curr_time, htf1.curr_open, close, htf1.curr_high, htf1.curr_low, preview_mbz_bull, htf1.h1, htf1.l1, extend_to_reference_wick, true, false, mbz_gap_ids, mbz_gap_types, preview_color_bull, preview_color_bear, preview_extension_width, HTF_LABEL)

        // Preview SIF: Check if forming candle would create immediate SIF
        if enable_sif_engine
            [has_preview_sif, sif_candle_bull, sif_gap_ids, sif_gap_types, sif_gap_breakaways] = check_preview_sif_formation(htf1.gap_array, htf1.curr_open, htf1.curr_high, htf1.curr_low, close, htf1.curr_time)

            if has_preview_sif
                // Apply direction filter (SIF direction = candle direction)
                bool show_preview_sif = mbz_direction_filter == DIR_BOTH or (sif_candle_bull and mbz_direction_filter == DIR_BULLISH) or (not sif_candle_bull and mbz_direction_filter == DIR_BEARISH)

                if show_preview_sif
                    // Check if we already created a preview zone for this candle (MBZ+SIF combo)
                    bool mbz_preview_exists = array.size(preview_zone_array) > 0
                    if mbz_preview_exists
                        // Update existing preview zone to include SIF flag
                        CandleZone existing = array.get(preview_zone_array, 0)
                        existing.has_sif := true
                        existing.is_immediate_sif := true
                        // Add SIF sources
                        for j = 0 to array.size(sif_gap_ids) - 1
                            add_source_to_zone(existing, array.get(sif_gap_ids, j), array.get(sif_gap_types, j), array.get(sif_gap_breakaways, j))
                        // Update label
                        string updated_label = build_zone_label(existing) + "\n(forming)"
                        box.set_text(existing.zone_box, updated_label)
                        array.set(preview_zone_array, 0, existing)
                    else
                        // Create new SIF-only preview zone
                        create_preview_zone(htf1.curr_time, htf1.curr_open, close, htf1.curr_high, htf1.curr_low, sif_candle_bull, float(na), float(na), false, false, true, sif_gap_ids, sif_gap_types, preview_color_bull, preview_color_bear, preview_extension_width, HTF_LABEL)

// ═══════════════════════════════════════════════════════════════════════════════
// UNIFIED ZONE RENDERING (parameterized for HTF1/HTF2)
// ═══════════════════════════════════════════════════════════════════════════════

render_htf_zones(array<CandleZone> zone_arr, int htf_ms, float htf_curr_open, bool is_secondary, ZoneVisualStyle style) =>
    if array.size(zone_arr) == 0
        false
    else
        int zone_ext_width = zone_extension_bars * htf_ms

        // Same-Source filter tracking
        var map<int, bool> seen_gap_ids = map.new<int, bool>()
        var map<int, int> first_touch_index_per_gap = map.new<int, int>()
        map.clear(seen_gap_ids)
        map.clear(first_touch_index_per_gap)

        // Pre-pass for FIRST TOUCH mode: Find oldest (first) non-invalidated MBZ zone per gap_id
        if same_source_filter == SAME_SOURCE_FILTER_FIRST_TOUCH
            for zone_index = array.size(zone_arr) - 1 to 0
                CandleZone current_zone = array.get(zone_arr, zone_index)
                if not current_zone.has_mbz
                    continue
                bool show_direction = mbz_direction_filter == DIR_BOTH or (current_zone.is_bullish and mbz_direction_filter == DIR_BULLISH) or (not current_zone.is_bullish and mbz_direction_filter == DIR_BEARISH)
                if show_direction and not current_zone.is_invalidated and array.size(current_zone.source_gap_ids) > 0
                    int gap_id = array.get(current_zone.source_gap_ids, 0)
                    map.put(first_touch_index_per_gap, gap_id, zone_index)

        // Pre-pass for Nearest Zone Extension (workspace mode - primary only)
        var map<int, bool> extend_to_current = map.new<int, bool>()
        map.clear(extend_to_current)

        if workspace_active and barstate.islast and not is_secondary
            var array<float> bull_distances = array.new<float>()
            var array<int> bull_indices = array.new<int>()
            var array<float> bear_distances = array.new<float>()
            var array<int> bear_indices = array.new<int>()
            array.clear(bull_distances)
            array.clear(bull_indices)
            array.clear(bear_distances)
            array.clear(bear_indices)

            float current_price = close

            for zone_idx = 0 to array.size(zone_arr) - 1
                CandleZone z = array.get(zone_arr, zone_idx)
                if z.is_invalidated
                    continue
                if not z.has_mbz and not z.has_sif
                    continue
                bool show_dir = mbz_direction_filter == DIR_BOTH or (z.is_bullish and mbz_direction_filter == DIR_BULLISH) or (not z.is_bullish and mbz_direction_filter == DIR_BEARISH)
                if not show_dir
                    continue
                bool visible = (enable_mbz_engine and z.has_mbz) or (enable_sif_engine and z.has_sif)
                if not visible
                    continue
                // Exclude VI-only zones from workspace extension if enabled
                if workspace_exclude_vi_only and is_vi_only_zone(z)
                    continue

                float dist = z.is_bullish ? math.abs(current_price - z.zone_top) : math.abs(current_price - z.zone_bottom)

                if z.is_bullish
                    array.push(bull_distances, dist)
                    array.push(bull_indices, zone_idx)
                else
                    array.push(bear_distances, dist)
                    array.push(bear_indices, zone_idx)

            // Select nearest N bullish zones
            if workspace_nearest_bull > 0 and array.size(bull_indices) > 0
                for n = 0 to math.min(workspace_nearest_bull, array.size(bull_indices)) - 1
                    float min_dist = 1e18
                    int min_idx = -1
                    int min_pos = -1
                    for j = 0 to array.size(bull_distances) - 1
                        if array.get(bull_distances, j) < min_dist
                            min_dist := array.get(bull_distances, j)
                            min_idx := array.get(bull_indices, j)
                            min_pos := j
                    if min_idx >= 0
                        map.put(extend_to_current, min_idx, true)
                        array.set(bull_distances, min_pos, 1e18)

            // Select nearest N bearish zones
            if workspace_nearest_bear > 0 and array.size(bear_indices) > 0
                for n = 0 to math.min(workspace_nearest_bear, array.size(bear_indices)) - 1
                    float min_dist = 1e18
                    int min_idx = -1
                    int min_pos = -1
                    for j = 0 to array.size(bear_distances) - 1
                        if array.get(bear_distances, j) < min_dist
                            min_dist := array.get(bear_distances, j)
                            min_idx := array.get(bear_indices, j)
                            min_pos := j
                    if min_idx >= 0
                        map.put(extend_to_current, min_idx, true)
                        array.set(bear_distances, min_pos, 1e18)

        // Main rendering loop
        for i = 0 to array.size(zone_arr) - 1
            CandleZone zone = array.get(zone_arr, i)

            if zone.is_invalidated
                continue

            if not zone.has_mbz and not zone.has_sif
                continue

            // Live Invalidation Check (computed, not permanent)
            bool mbz_live_invalid = zone.has_mbz and enable_invalidation and check_mbz_component_invalidation(zone, htf_curr_open, close)
            bool sif_live_invalid = zone.has_sif and enable_invalidation and check_sif_component_invalidation(zone, htf_curr_open, close)

            bool mbz_active = enable_mbz_engine and zone.has_mbz
            bool sif_active = enable_sif_engine and zone.has_sif
            bool all_live_invalidated = (not mbz_active or mbz_live_invalid) and (not sif_active or sif_live_invalid)

            if all_live_invalidated and (mbz_active or sif_active)
                if not na(zone.zone_box)
                    box.delete(zone.zone_box)
                    zone.zone_box := na
                if not na(zone.validation_line)
                    line.delete(zone.validation_line)
                    zone.validation_line := na
                array.set(zone_arr, i, zone)
                continue

            // Direction filter
            bool show_direction = mbz_direction_filter == DIR_BOTH or (zone.is_bullish and mbz_direction_filter == DIR_BULLISH) or (not zone.is_bullish and mbz_direction_filter == DIR_BEARISH)
            if not show_direction
                if not na(zone.zone_box)
                    box.delete(zone.zone_box)
                    zone.zone_box := na
                if not na(zone.validation_line)
                    line.delete(zone.validation_line)
                    zone.validation_line := na
                array.set(zone_arr, i, zone)
                continue

            // Engine visibility
            bool show_zone = (enable_mbz_engine and zone.has_mbz) or (enable_sif_engine and zone.has_sif)
            if not show_zone
                if not na(zone.zone_box)
                    box.delete(zone.zone_box)
                    zone.zone_box := na
                if not na(zone.validation_line)
                    line.delete(zone.validation_line)
                    zone.validation_line := na
                array.set(zone_arr, i, zone)
                continue

            // Same-Source filter logic (MBZ only)
            bool should_show_zone = true
            if zone.has_mbz and array.size(zone.source_gap_ids) > 0
                int primary_gap_id = array.get(zone.source_gap_ids, 0)

                if same_source_filter == SAME_SOURCE_FILTER_LATEST_TOUCH
                    if map.contains(seen_gap_ids, primary_gap_id)
                        should_show_zone := false
                    else
                        map.put(seen_gap_ids, primary_gap_id, true)
                else if same_source_filter == SAME_SOURCE_FILTER_FIRST_TOUCH
                    if map.contains(first_touch_index_per_gap, primary_gap_id)
                        int first_touch_idx = map.get(first_touch_index_per_gap, primary_gap_id)
                        if i != first_touch_idx
                            should_show_zone := false
                    else
                        should_show_zone := false

            if not should_show_zone
                if not na(zone.zone_box)
                    box.delete(zone.zone_box)
                    zone.zone_box := na
                if not na(zone.validation_line)
                    line.delete(zone.validation_line)
                    zone.validation_line := na
                array.set(zone_arr, i, zone)
                continue

            // Extension and staggering
            bool should_extend_to_current = workspace_active and map.contains(extend_to_current, i)
            int stagger_hash = should_extend_to_current ? (zone.formation_time + int(zone.zone_top * 100)) % 7 : 0
            int stagger_offset_ms = stagger_hash * (htf_ms / 4)
            int normal_extension_right = zone.formation_time + zone_ext_width
            int zone_right_edge = should_extend_to_current ? math.max(time + stagger_offset_ms, normal_extension_right) : normal_extension_right

            // Faded opacity for non-extended zones in workspace mode (primary only)
            bool is_faded = workspace_active and not should_extend_to_current and not is_secondary
            int fill_trans = is_faded ? 99 : style.fill_trans
            int border_trans = is_faded ? WORKSPACE_FADE_OPACITY : style.border_trans
            int label_trans = is_faded ? WORKSPACE_FADE_OPACITY : style.label_trans
            color label_color_resolved = label_trans > 0 ? color.new(zone_label_color, label_trans) : zone_label_color

            if na(zone.zone_box)
                color zone_color = zone.is_bullish ? zone_bull_color : zone_bear_color
                string zone_label_text = build_zone_label(zone)

                // Create box: secondary uses dashed border with width 2, primary uses solid with style.border_width
                if is_secondary
                    zone.zone_box := box.new(zone.formation_time, zone.zone_top, zone_right_edge, zone.zone_bottom, xloc=xloc.bar_time, bgcolor=color.new(zone_color, fill_trans), border_color=color.new(zone_color, border_trans), border_width=SECONDARY_BORDER_WIDTH, border_style=SECONDARY_BORDER_STYLE, text=zone_label_text, text_color=label_color_resolved, text_size=ZONE_LABEL_SIZE_RESOLVED, text_halign=text.align_right, text_valign=text.align_center)
                else
                    zone.zone_box := box.new(zone.formation_time, zone.zone_top, zone_right_edge, zone.zone_bottom, xloc=xloc.bar_time, bgcolor=color.new(zone_color, fill_trans), border_color=color.new(zone_color, border_trans), border_width=style.border_width, text=zone_label_text, text_color=label_color_resolved, text_size=ZONE_LABEL_SIZE_RESOLVED, text_halign=text.align_right, text_valign=text.align_center)

                // Validation boundary line (inherent feature - static styling)
                int validation_time = zone.formation_time + htf_ms
                color vb_color = color.new(zone_color, 80)  // More muted than zone border
                zone.validation_line := line.new(validation_time, zone.zone_top, validation_time, zone.zone_bottom, xloc=xloc.bar_time, color=vb_color, width=2, style=VALIDATION_LINE_STYLE)

                array.set(zone_arr, i, zone)
            else
                // Update extension and opacity
                box.set_right(zone.zone_box, zone_right_edge)
                color zone_color = zone.is_bullish ? zone_bull_color : zone_bear_color
                box.set_bgcolor(zone.zone_box, color.new(zone_color, fill_trans))
                box.set_border_color(zone.zone_box, color.new(zone_color, border_trans))
                box.set_text_color(zone.zone_box, label_color_resolved)
        true

if IS_VALID
    // ─── Unified Zone Rendering (on HTF change or current bar) ───
    // Only render when: HTF candle closes (new_htf) OR current bar updates (barstate.islast)
    // This avoids redundant iterations on historical bars where zone state cannot change
    if show_htf1 and (new_htf or barstate.islast)
        render_htf_zones(htf1.zone_array, HTF_MS, htf1.curr_open, false, htf1_style)

    // ─── HTF2 Zone Rendering (Secondary Timeframe - Dashed Borders) ───
    if show_htf2 and (new_htf2 or barstate.islast)
        render_htf_zones(htf2.zone_array, HTF2_MS, htf2.curr_open, true, htf2_style)

// ═══════════════════════════════════════════════════════════════════════════════
// STATUS TABLE
// ═══════════════════════════════════════════════════════════════════════════════

if IS_VALID and show_status_table and barstate.islast
    var table status_table = table.new(position.bottom_center, 4, 1, border_width=0)

    // Calculate padding for offset
    string left_pad = status_table_offset < 0 ? "" : str.repeat(" ", status_table_offset * 3)
    string right_pad = status_table_offset > 0 ? "" : str.repeat(" ", math.abs(status_table_offset) * 3)

    // Left padding cell
    table.cell(status_table, 0, 0, left_pad, bgcolor=color.new(color.white, 100), text_size=size.tiny)

    // Title cell: white tex\t on black background
    table.cell(status_table, 1, 0, "relay •", bgcolor=color.black, text_color=color.white, text_size=size.tiny)

    // Build status text: TF mapping + enabled gap sources + ref wick indicator
    // Show "all" when all gap sources are enabled
    string gap_type_display = ""
    if enable_fvg and enable_implied and enable_volume
        gap_type_display := STATUS_DISPLAY_ALL
    else
        var array<string> gap_parts = array.new<string>()
        array.clear(gap_parts)
        if enable_fvg
            array.push(gap_parts, STATUS_DISPLAY_FVG)
        if enable_implied
            array.push(gap_parts, STATUS_DISPLAY_IMP)
        if enable_volume
            array.push(gap_parts, STATUS_DISPLAY_VOL)
        gap_type_display := array.size(gap_parts) > 0 ? array.join(gap_parts, "·") : "none"
    string ref_wick_display = extend_to_reference_wick ? "  " + STATUS_DISPLAY_REF_WICK : ""
    string workspace_display = workspace_active ? "  WS" : ""

    // Build timeframe mapping display
    string tf_display = ""
    if show_htf1 and show_htf2
        tf_display := LTF_LABEL + " → " + HTF_LABEL + " + " + HTF2_LABEL
    else if show_htf2
        tf_display := LTF_LABEL + " → " + HTF2_LABEL
    else
        tf_display := LTF_LABEL + " → " + HTF_LABEL

    string status_text = tf_display + "  " + gap_type_display + ref_wick_display + workspace_display
    table.cell(status_table, 2, 0, status_text, bgcolor=color.new(color.rgb(245, 245, 245), 20), text_color=color.black, text_size=size.tiny)

    // Right padding cell
    table.cell(status_table, 3, 0, right_pad, bgcolor=color.new(color.white, 100), text_size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE
// ═══════════════════════════════════════════════════════════════════════════════

if show_color_table and barstate.islast
    var table t = table.new(position.top_right, 3, 4, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

    table.cell(t, 0, 0, "Element", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(t, 2, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)

    table.cell(t, 0, 1, "Zone +", text_size=size.small)
    table.cell(t, 1, 1, str.format("R:{0} G:{1} B:{2}", int(color.r(zone_bull_color)), int(color.g(zone_bull_color)), int(color.b(zone_bull_color))), text_size=size.small)
    table.cell(t, 2, 1, str.tostring(htf1_style.fill_trans), text_size=size.small)

    table.cell(t, 0, 2, "Zone −", text_size=size.small)
    table.cell(t, 1, 2, str.format("R:{0} G:{1} B:{2}", int(color.r(zone_bear_color)), int(color.g(zone_bear_color)), int(color.b(zone_bear_color))), text_size=size.small)
    table.cell(t, 2, 2, str.tostring(htf1_style.fill_trans), text_size=size.small)

    table.cell(t, 0, 3, "Zone Label", text_size=size.small)
    table.cell(t, 1, 3, str.format("R:{0} G:{1} B:{2}", int(color.r(zone_label_color)), int(color.g(zone_label_color)), int(color.b(zone_label_color))), text_size=size.small)
    table.cell(t, 2, 3, str.tostring(int(color.t(zone_label_color))), text_size=size.small)
