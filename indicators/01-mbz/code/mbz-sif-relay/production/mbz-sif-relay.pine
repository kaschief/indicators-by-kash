sif_fill_bear      = input.color(color.new(color.rgb(252, 203, 205), 90), "−", group=GROUP_SIF_CHART, inline="sif_fill_bdr")
sif_border_bull    = input.color(color.new(color.rgb(38, 166, 154), 55), "Border +", group=GROUP_SIF_CHART, inline="sif_fill_bdr")
sif_border_bear    = input.color(color.new(color.rgb(239, 83, 80), 65), "−", group=GROUP_SIF_CHART, inline="sif_fill_bdr")

bool show_chart_zones = show_mbz_on_chart or show_sif_on_chart

po3_limit_to_range = input.bool(true, "Limit to PO3 Range", group=GROUP_CHART_ZONES, tooltip="When on, chart zones only show for candles visible on the PO3. Disable to show all detected zones.")
