const string DIR_BOTH    = "Both"
const string DIR_BULLISH = "Bullish Only"
const string DIR_BEARISH = "Bearish Only"

const color GAP_COLOR = color.new(color.rgb(187, 217, 251), 90)


GROUP_ENGINE       = "🔧 Engine"
GROUP_PO3_CHART    = "📊 PO3 Chart"
GROUP_QUICK_ACCESS = "⚡ Quick Access"
GROUP_PO3_CANDLES  = "📊 PO3 Candles"
GROUP_PO3_ANNOT    = "📊 PO3 Annotations"
GROUP_PO3_FVGS     = "📊 PO3 FVGs"
GROUP_MBZ_PO3        = "🎯 MBZ on PO3"
GROUP_MBZ_CHART      = "🎯 MBZ on Chart"
GROUP_MBZ_DETECTION  = "🎯 Liquidity MBZ"
GROUP_LIQ_HTF        = "💧 Higher Timeframe Pools"
GROUP_LIQ_SESSION    = "💧 Session Pools"
GROUP_TIME_BEHAVIOR  = "⏰ Time Behavior"
GROUP_SIF_PO3        = "✨ SIF on PO3"
GROUP_SIF_CHART      = "✨ SIF on Chart"
GROUP_CHART_ZONES    = "🎨 Chart Zones"
GROUP_INVALIDATION   = "✋ Invalidation"
GROUP_GAP_SOURCES    = "📊 Gap Sources"
GROUP_ADVANCED       = "⚙️ Advanced"

const string MBZ_MODE_GAP       = "Gap"
const string MBZ_MODE_LIQUIDITY = "Liquidity"
const string MBZ_MODE_BOTH      = "Liquidity + Gap"
const string MBZ_MODE_OFF       = "Off"
mbz_mode = input.string(MBZ_MODE_BOTH, "MBZ", options=[MBZ_MODE_GAP, MBZ_MODE_LIQUIDITY, MBZ_MODE_BOTH, MBZ_MODE_OFF], group=GROUP_ENGINE, inline="engine")
enable_sif = input.bool(true, "SIF", group=GROUP_ENGINE, inline="engine")
mbz_direction_filter = input.string(DIR_BOTH, "Direction", options=[DIR_BOTH, DIR_BULLISH, DIR_BEARISH], group=GROUP_ENGINE)

bool enable_mbz        = mbz_mode != MBZ_MODE_OFF
bool enable_gap_mbz    = mbz_mode == MBZ_MODE_GAP or mbz_mode == MBZ_MODE_BOTH
bool enable_liq_pools = mbz_mode == MBZ_MODE_LIQUIDITY or mbz_mode == MBZ_MODE_BOTH

show_po3_chart         = input.bool(true, "Show PO3", group=GROUP_PO3_CHART, inline="po3_master")
htf1_candle_count      = input.int(15, "HTF 1", minval=2, maxval=100, group=GROUP_PO3_CHART, inline="po3_htf1")
htf1_manual            = input.bool(false, "Manual", group=GROUP_PO3_CHART, inline="po3_htf1")
htf1_tf_input          = input.timeframe("60", "", group=GROUP_PO3_CHART, inline="po3_htf1")
show_htf2    = input.bool(false, "HTF 2", group=GROUP_PO3_CHART, inline="po3_htf2", tooltip="Lower timeframe for detailed price structure")
htf2_manual         = input.bool(false, "Manual", group=GROUP_PO3_CHART, inline="po3_htf2")
htf2_tf_input       = input.timeframe("5", "", group=GROUP_PO3_CHART, inline="po3_htf2")
htf2_candle_count   = input.int(20, "", minval=2, maxval=100, group=GROUP_PO3_CHART, inline="po3_htf2")
show_htf3    = input.bool(false, "HTF 3", group=GROUP_PO3_CHART, inline="po3_htf3", tooltip="Higher timeframe for broader market context")
htf3_manual         = input.bool(false, "Manual", group=GROUP_PO3_CHART, inline="po3_htf3")
htf3_tf_input       = input.timeframe("240", "", group=GROUP_PO3_CHART, inline="po3_htf3")
htf3_candle_count   = input.int(10, "", minval=2, maxval=100, group=GROUP_PO3_CHART, inline="po3_htf3")
show_htf4    = input.bool(false, "HTF 4", group=GROUP_PO3_CHART, inline="po3_htf4", tooltip="Macro timeframe for broader context above HTF3")
htf4_manual         = input.bool(false, "Manual", group=GROUP_PO3_CHART, inline="po3_htf4")
htf4_tf_input       = input.timeframe("D", "", group=GROUP_PO3_CHART, inline="po3_htf4")
htf4_candle_count   = input.int(8, "", minval=2, maxval=100, group=GROUP_PO3_CHART, inline="po3_htf4")

chart_zone_source = input.string(CHART_SRC_HTF1, "Chart Source", options=[CHART_SRC_HTF1, CHART_SRC_HTF2, CHART_SRC_HTF3, CHART_SRC_HTF4], group=GROUP_QUICK_ACCESS, tooltip="Which timeframe tier's zones render on the chart")
chart_zone_secondary       = input.string(CHART_SRC_NONE, "Secondary Chart Source", options=[CHART_SRC_NONE, CHART_SRC_HTF2, CHART_SRC_HTF3, CHART_SRC_HTF4], group=GROUP_QUICK_ACCESS, inline="sec_src", tooltip="Optional secondary tier rendered alongside the chart source with a distinct border style")
secondary_border_style_in  = input.string("Dashed", "", options=["Solid", "Dashed", "Dotted"], group=GROUP_QUICK_ACCESS, inline="sec_src")
show_zone_size    = input.bool(false, "Show Size", group=GROUP_QUICK_ACCESS, tooltip="Show the zone size in points on the label")
show_po3_slot     = input.bool(false, "Show PO3 Slot", group=GROUP_QUICK_ACCESS, tooltip="Append a superscript slot identifier (²/³/⁴) under each PO3 tier's timeframe label. HTF 1 stays bare.")

string HTF1_STRING = htf1_manual ? htf1_tf_input : (HTF1_AUTO_VALID ? HTF1_AUTO_STRING : "1")
string HTF1_LABEL  = htf1_manual ? get_tf_display_label(htf1_tf_input) : HTF1_AUTO_LABEL
int    HTF1_MS     = htf1_manual ? timeframe.in_seconds(htf1_tf_input) * 1000 : HTF1_AUTO_MS
bool   HTF1_VALID  = (htf1_manual or HTF1_AUTO_VALID) and timeframe.in_seconds(HTF1_STRING) > timeframe.in_seconds()

[HTF2_AUTO_VALID, HTF2_AUTO_STRING, HTF2_AUTO_LABEL, HTF2_AUTO_MS, _htf2] = get_tf_pairing(CHART_TF, HTF_SLOT_2)
string HTF2_STRING = htf2_manual ? htf2_tf_input : (HTF2_AUTO_VALID ? HTF2_AUTO_STRING : "1")
string HTF2_LABEL  = htf2_manual ? get_tf_display_label(htf2_tf_input) : HTF2_AUTO_LABEL
int    HTF2_MS     = htf2_manual ? timeframe.in_seconds(htf2_tf_input) * 1000 : HTF2_AUTO_MS
bool   HTF2_VALID  = show_htf2 and (htf2_manual or HTF2_AUTO_VALID) and timeframe.in_seconds(HTF2_STRING) > timeframe.in_seconds()

[HTF3_AUTO_VALID, HTF3_AUTO_STRING, HTF3_AUTO_LABEL, HTF3_AUTO_MS, _htf3] = get_tf_pairing(CHART_TF, HTF_SLOT_3)
string HTF3_STRING = htf3_manual ? htf3_tf_input : (HTF3_AUTO_VALID ? HTF3_AUTO_STRING : "1")
string HTF3_LABEL  = htf3_manual ? get_tf_display_label(htf3_tf_input) : HTF3_AUTO_LABEL
int    HTF3_MS     = htf3_manual ? timeframe.in_seconds(htf3_tf_input) * 1000 : HTF3_AUTO_MS
bool   HTF3_VALID  = show_htf3 and (htf3_manual or HTF3_AUTO_VALID) and timeframe.in_seconds(HTF3_STRING) > timeframe.in_seconds()

[HTF4_AUTO_VALID, HTF4_AUTO_STRING, HTF4_AUTO_LABEL, HTF4_AUTO_MS, _htf4] = get_tf_pairing(CHART_TF, HTF_SLOT_4)
string HTF4_STRING = htf4_manual ? htf4_tf_input : (HTF4_AUTO_VALID ? HTF4_AUTO_STRING : "1")
string HTF4_LABEL  = htf4_manual ? get_tf_display_label(htf4_tf_input) : HTF4_AUTO_LABEL
int    HTF4_MS     = htf4_manual ? timeframe.in_seconds(htf4_tf_input) * 1000 : HTF4_AUTO_MS
bool   HTF4_VALID  = show_htf4 and (htf4_manual or HTF4_AUTO_VALID) and timeframe.in_seconds(HTF4_STRING) > timeframe.in_seconds()

po3_is_overlay         = input.bool(false, "Overlay", group=GROUP_PO3_CANDLES, inline="po3_overlay")
