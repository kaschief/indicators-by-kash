po3_sif_label_bear    = input.color(color.new(color.rgb(239, 83, 80), 0), "−", group=GROUP_SIF_PO3, inline="po3_sif_candle_zone")

show_sif_on_chart  = input.bool(true, "Show SIF on Chart", group=GROUP_SIF_CHART)
