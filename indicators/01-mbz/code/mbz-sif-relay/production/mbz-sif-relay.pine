enable_liq_nypm    = input.bool(true, "NY PM", group=GROUP_LIQ_SESSION, inline="liq_session", tooltip='Track NY PM session (1330-1600 NY) highs/lows as liquidity levels.\nPatterns detected when session extremes are swept on HTF candles.\nOnly active on sub-1H chart timeframes.')
enable_liq_ons     = input.bool(true, "ONS", group=GROUP_LIQ_SESSION, inline="liq_session2", tooltip='Track Overnight Session (1600-0500 NY) highs/lows as liquidity levels.\nPatterns detected when session extremes are swept on HTF candles.\nOnly active on sub-1H chart timeframes.')
enable_liq_premarket = input.bool(true, "Premarket", group=GROUP_LIQ_SESSION, inline="liq_session2", tooltip='Track Premarket session (0500-0915 NY) highs/lows as liquidity levels.\nPatterns detected when session extremes are swept on HTF candles.\nOnly active on sub-1H chart timeframes.')
const string NINE_MODE_STANDARD  = "Standard"
const string NINE_MODE_NINE_ONLY = "NINE Only"
const string NINE_MODE_BOTH      = "Both"
nine_times_mode = input.string(NINE_MODE_STANDARD, "Session Mode", options=[NINE_MODE_STANDARD, NINE_MODE_NINE_ONLY, NINE_MODE_BOTH], group=GROUP_LIQ_SESSION, tooltip='Standard: default ICT session times.\nNINE Only: use NINE alternative windows (Asia 1800-0300, London 0300-0930, NYPM 1200-1800).\nBoth: run Standard AND NINE sessions in parallel as independent pools.')
bool enable_nine_variants = nine_times_mode == NINE_MODE_BOTH
daily_boundary_mode = input.string(DAILY_BOUNDARY_EXCHANGE, "Daily Boundary", options=[DAILY_BOUNDARY_EXCHANGE, DAILY_BOUNDARY_CALENDAR], group=GROUP_TIME_BEHAVIOR, tooltip='How daily sessions are defined for liquidity pool tracking:\n\n• Exchange Session (default): 18:00-17:59 ET — matches futures/forex session boundaries. Sunday 18:00 starts Monday\'s session.\n• Calendar Day: Midnight-midnight ET — traditional calendar day boundaries.\n\n24/7 assets (crypto) force Calendar Day mode automatically.')
include_sunday_evening = input.bool(true, "Include Sunday Evening", group=GROUP_TIME_BEHAVIOR, inline="time_toggles", tooltip='Calendar Day mode only: Include Sunday 18:00-00:00 in daily pool tracking.\n\n• ON (default): Sunday evening data included in daily high/low.\n• OFF: Skip Sunday evening, start fresh Monday 00:00.\n\nIgnored in Exchange Session mode (Sunday 18:00 always starts Monday\'s session).')
enable_pool_backfill = input.bool(true, "Historical Backfill", group=GROUP_TIME_BEHAVIOR, inline="time_toggles", tooltip="Pre-populate pools with historical sessions via request.security. Adds ~20 daily, ~20 weekly, ~24 monthly sessions on low-TF charts where normal tracking has limited history. Only active in Exchange Session mode.")

po3_show_sif           = input.bool(true, "Show SIF on PO3", group=GROUP_SIF_PO3)
