//@version=6

// ═══════════════════════════════════════════════════════════════════════════════
// MBZ CORE RELAY
// ═══════════════════════════════════════════════════════════════════════════════
// Multi-timeframe MBZ detection with automatic timeframe pairing:
//   1m  chart → 15m HTF
//   2m  chart → 15m HTF
//   5m  chart → 1H  HTF
//   15m chart → 4H  HTF
//   1H  chart → D   HTF
//   4H  chart → W   HTF
// ═══════════════════════════════════════════════════════════════════════════════

indicator("mbz sif relay •", shorttitle="mbz sif relay • development", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

// MBZ Zone Colors (from MBZ-Core production)
