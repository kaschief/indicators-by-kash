//@version=6

// ═══════════════════════════════════════════════════════════════════════════════
// MBZ SIF RELAY
// ═══════════════════════════════════════════════════════════════════════════════
// Multi-timeframe MBZ + SIF detection with 3-tier HTF system:
//   Main (primary), Support A, Support B each run full detection.
//   Chart Zone Source selector controls which tier renders on the main chart.
// ═══════════════════════════════════════════════════════════════════════════════

indicator("mbz sif relay •", shorttitle="relay •", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

// Zone color defaults
const int   PREVIEW_FILL_TRANSPARENCY = 94  // Slightly more visible for preview zones

// Drawing budget
const int DRAW_LIMIT = 500
const int DRAW_BUFFER = 20  // Reserve for test zones, warnings, etc.

// Timeframe milliseconds
const int TF_5M_MS  = 300000
const int TF_15M_MS = 900000
const int TF_30M_MS = 1800000
const int TF_1H_MS  = 3600000
const int TF_4H_MS  = 14400000
const int TF_D_MS   = 86400000
const int TF_1M_MS  = 60000
const int TF_W_MS   = 604800000

// Stagger configuration
const int STAGGER_MODULO  = 7
const int STAGGER_DIVISOR = 4
const int STAGGER_PRICE_MULTIPLIER = 100

// Gap type constants
const string GAP_TYPE_FVG     = "fvg"
const string GAP_TYPE_FVG_VI  = "fvg·vi"
const string GAP_TYPE_IMPLIED = "implied"
const string GAP_TYPE_VOLUME  = "volume"

// Status display constants
const string STATUS_DISPLAY_ALL = "all"
const string STATUS_DISPLAY_FVG = "fvg"
const string STATUS_DISPLAY_IMP = "imp"
const string STATUS_DISPLAY_VOL = "vol"
const string STATUS_DISPLAY_WICK_EXT = "⁺ʷ"

// Invalidation threshold display
const string STATUS_DISPLAY_MBZ_STD = "[std 100]"
const string STATUS_DISPLAY_MBZ_CON = "[con 85]"
const string STATUS_DISPLAY_MBZ_STR = "[str 55]"
const string STATUS_DISPLAY_SIF_STR = "[str 55]"
const string STATUS_DISPLAY_SIF_LEN = "[len 85]"

// MBZ subtype constants
const string SUBTYPE_STANDARD   = "standard"
const string SUBTYPE_INCLUSION  = "inclusion"
const string SUBTYPE_REFLECTION = "reflection"

// Same-Source filter constants
const string SAME_SOURCE_FILTER_ALL_TOUCHES = "All"
const string SAME_SOURCE_FILTER_FIRST_TOUCH = "First Touch"
const string SAME_SOURCE_FILTER_LATEST_TOUCH = "Latest Touch"

// MBZ label constants
const string MBZ_BASE_TEXT     = "MBZ"
const string MBZ_BULLISH_SUFFIX = "⁺"
const string MBZ_BEARISH_SUFFIX = "⁻"

// SIF label text constants
const string SIF_MBZ_COMBINED_BOLD = "𝗠𝗕𝗭·𝗦𝗜𝗙"
const string SIF_LABEL             = "SIF"

// Gap source display text for labels
const string GAP_SOURCE_FVG_BREAKDOWN_DISPLAY = "fvg"
const string GAP_SOURCE_FVG_VI_DISPLAY = "fvg·vi"
const string GAP_SOURCE_IMPLIED_DISPLAY = "imp"
const string GAP_SOURCE_VOLUME_DISPLAY  = "vol"

// Consolidated label formatting
const string MULTIPLIER_SYMBOL = "×"
const string COUNT_SEPARATOR = ": "
const string BREAKDOWN_SEPARATOR = ", "

// Wick dominance threshold (wick must be >= 80% of body)
const float WICK_DOMINANCE_THRESHOLD = 0.80

// Breakaway detection
const int    BREAKAWAY_LENGTH = 20
const string LABEL_PREFIX_BREAKAWAY = "BRK-"

// ═══════════════════════════════════════════════════════════════════════════════
// INVALIDATION THRESHOLDS (Edit these values to adjust invalidation sensitivity)
// ═══════════════════════════════════════════════════════════════════════════════
// MBZ Thresholds: % of zone that must be penetrated to invalidate
//   - 100% = Full close through entire zone required
//   - 85%  = Conservative, allows minor wicks through
//   - 55%  = Strict, invalidates on majority penetration
const float MBZ_THRESHOLD_STANDARD     = 100.0
const float MBZ_THRESHOLD_CONSERVATIVE = 85.0
const float MBZ_THRESHOLD_STRICT       = 55.0

// SIF Thresholds: % of zone that must be penetrated to invalidate
//   - 85%  = Lenient, allows more room before invalidation
//   - 55%  = Strict, invalidates on majority penetration
const float SIF_THRESHOLD_LENIENT = 85.0
const float SIF_THRESHOLD_STRICT  = 55.0
// ═══════════════════════════════════════════════════════════════════════════════

// MBZ invalidation mode constants (UI labels)
const string MBZ_INVALIDATION_STANDARD     = "Standard (100%)"
const string MBZ_INVALIDATION_CONSERVATIVE = "Conservative (85%)"
const string MBZ_INVALIDATION_STRICT       = "Strict (55%)"
const string MBZ_INVALIDATION_CUSTOM       = "Custom"

// SIF invalidation mode constants (UI labels)
const string SIF_INVALIDATION_STRICT   = "Strict (55%)"
const string SIF_INVALIDATION_LENIENT  = "Lenient (85%)"
const string SIF_INVALIDATION_CUSTOM   = "Custom"

const int   INVALIDATION_LOOKBACK_LIMIT = 500

// Implied FVG detection parameters
const float  IMPLIED_DISPLACEMENT_MULTIPLIER = 1.25
const int    IMPLIED_DISPLACEMENT_LOOKBACK   = 4

// VI suppression temporal window
const int SUPPRESSION_TEMPORAL_WINDOW = 2

// MBZ label text color default
const color DEFAULT_ZONE_LABEL_COLOR = color.new(color.rgb(156, 156, 156), 20)

// ═══════════════════════════════════════════════════════════════════════════════
// TIMEFRAME CONFIGURATION
// ═══════════════════════════════════════════════════════════════════════════════
// Centralized pairing definition - 3-tier LTF→HTF mapping
// Returns: [is_valid, htf_string, htf_label, htf_ms, ltf_label]
//
// To add a new pairing: add one case to the switch below
// ═══════════════════════════════════════════════════════════════════════════════

// HTF slot constants
const string HTF_SLOT_PRIMARY   = "primary"
const string HTF_SLOT_SUPPORT_A = "support_a"
const string HTF_SLOT_SUPPORT_B = "support_b"

// Unified HTF pairing function
get_tf_pairing(string chart_tf, string slot) =>
    if slot == HTF_SLOT_PRIMARY
        switch chart_tf
            "30S" => [true, "5",   "5m",  TF_5M_MS,  "30s"]   // 30s → 5m
            "1"   => [true, "15",  "15m", TF_15M_MS, "1m"]    // 1m  → 15m
            "2"   => [true, "30",  "30m", TF_30M_MS, "2m"]    // 2m  → 30m
            "3"   => [true, "30",  "30m", TF_30M_MS, "3m"]    // 3m  → 30m
            "4"   => [true, "30",  "30m", TF_30M_MS, "4m"]    // 4m  → 30m
            "5"   => [true, "60",  "1H",  TF_1H_MS,  "5m"]    // 5m  → 1H
            "10"  => [true, "60",  "1H",  TF_1H_MS,  "10m"]   // 10m → 1H
            "15"  => [true, "240", "4H",  TF_4H_MS,  "15m"]   // 15m → 4H
            "30"  => [true, "240", "4H",  TF_4H_MS,  "30m"]   // 30m → 4H
            "45"  => [true, "240", "4H",  TF_4H_MS,  "45m"]   // 45m → 4H
            "60"  => [true, "D",   "D",   TF_D_MS,   "1H"]    // 1H  → D
            "120" => [true, "D",   "D",   TF_D_MS,   "2H"]    // 2H  → D
            "180" => [true, "D",   "D",   TF_D_MS,   "3H"]    // 3H  → D
            "240" => [true, "D",   "D",   TF_D_MS,   "4H"]    // 4H  → D
            "D"   => [true, "W",   "W",   TF_W_MS,   "D"]     // D   → W
            =>       [false, "",   "",    0,         ""]      // Unsupported
    else if slot == HTF_SLOT_SUPPORT_A
        switch chart_tf
            "30S" => [true, "1",   "1m",  TF_1M_MS,  "30s"]   // 30s → 1m
            "1"   => [true, "5",   "5m",  TF_5M_MS,  "1m"]    // 1m  → 5m
            "2"   => [true, "5",   "5m",  TF_5M_MS,  "2m"]    // 2m  → 5m
            "3"   => [true, "15",  "15m", TF_15M_MS, "3m"]    // 3m  → 15m
            "4"   => [true, "15",  "15m", TF_15M_MS, "4m"]    // 4m  → 15m
            "5"   => [true, "15",  "15m", TF_15M_MS, "5m"]    // 5m  → 15m
            "10"  => [true, "30",  "30m", TF_30M_MS, "10m"]   // 10m → 30m
            "15"  => [true, "60",  "1H",  TF_1H_MS,  "15m"]   // 15m → 1H
            "30"  => [true, "60",  "1H",  TF_1H_MS,  "30m"]   // 30m → 1H
            "45"  => [true, "60",  "1H",  TF_1H_MS,  "45m"]   // 45m → 1H
            "60"  => [true, "240", "4H",  TF_4H_MS,  "1H"]    // 1H  → 4H
            "120" => [true, "240", "4H",  TF_4H_MS,  "2H"]    // 2H  → 4H
            "180" => [true, "240", "4H",  TF_4H_MS,  "3H"]    // 3H  → 4H
            =>       [false, "",   "",    0,         ""]      // Unsupported (240, D)
    else if slot == HTF_SLOT_SUPPORT_B
        switch chart_tf
            "30S" => [true, "15",  "15m", TF_15M_MS, "30s"]   // 30s → 15m
            "1"   => [true, "60",  "1H",  TF_1H_MS,  "1m"]    // 1m  → 1H
            "2"   => [true, "60",  "1H",  TF_1H_MS,  "2m"]    // 2m  → 1H
            "3"   => [true, "60",  "1H",  TF_1H_MS,  "3m"]    // 3m  → 1H
            "4"   => [true, "60",  "1H",  TF_1H_MS,  "4m"]    // 4m  → 1H
            "5"   => [true, "240", "4H",  TF_4H_MS,  "5m"]    // 5m  → 4H
            "10"  => [true, "240", "4H",  TF_4H_MS,  "10m"]   // 10m → 4H
            "15"  => [true, "D",   "D",   TF_D_MS,   "15m"]   // 15m → D
            "30"  => [true, "D",   "D",   TF_D_MS,   "30m"]   // 30m → D
            "45"  => [true, "D",   "D",   TF_D_MS,   "45m"]   // 45m → D
            "60"  => [true, "W",   "W",   TF_W_MS,   "1H"]    // 1H  → W
            "120" => [true, "W",   "W",   TF_W_MS,   "2H"]    // 2H  → W
            "180" => [true, "W",   "W",   TF_W_MS,   "3H"]    // 3H  → W
            "240" => [true, "W",   "W",   TF_W_MS,   "4H"]    // 4H  → W
            =>       [false, "",   "",    0,         ""]      // Unsupported (D)
    else
        [false, "", "", 0, ""]  // Unknown slot

string CHART_TF = timeframe.period
[IS_VALID, HTF_STRING, HTF_LABEL, HTF_MS, LTF_LABEL] = get_tf_pairing(CHART_TF, HTF_SLOT_PRIMARY)

// Helper to convert Pine TF string to display label
get_tf_display_label(string tf) =>
    int secs = timeframe.in_seconds(tf)
    if secs < 60
        str.tostring(secs) + "s"
    else if secs < 3600
        str.tostring(secs / 60) + "m"
    else if secs < 86400
        str.tostring(secs / 3600) + "H"
    else if secs < 604800
        "D"
    else
        "W"

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

// Direction filter options
const string DIR_BOTH    = "Both"
const string DIR_BULLISH = "Bullish Only"
const string DIR_BEARISH = "Bearish Only"

// Gap color
const color GAP_COLOR = color.new(color.rgb(187, 217, 251), 90)

// ─── Group Constants ───
GROUP_PO3_CHART    = "📊 PO3 Chart"
GROUP_PO3_CANDLES  = "📊 PO3 Candles"
GROUP_PO3_FVGS     = "📊 PO3 FVGs"
GROUP_MBZ          = "🎯 MBZ"
GROUP_SIF          = "✨ SIF"
GROUP_CHART_ZONES  = "🎨 Chart Zones"
GROUP_INVALIDATION = "✋ Invalidation"
GROUP_GAP_SOURCES  = "📊 Gap Sources"
GROUP_ADVANCED     = "⚙️ Advanced"

// ─── 📊 PO3 Chart ───
show_po3_chart         = input.bool(true, "Show PO3 Chart", group=GROUP_PO3_CHART, inline="po3_master")
po3_placement          = input.string("Right", "", options=["Right", "Overlay"], group=GROUP_PO3_CHART, inline="po3_master")
po3_overlay_trans      = input.int(15, "Opacity", minval=0, maxval=100, group=GROUP_PO3_CHART, inline="po3_master", tooltip="Transparency of PO3 candles in overlay mode")
bool po3_is_overlay    = po3_placement == "Overlay"
po3_candle_count       = input.int(15, "TF 1", minval=2, maxval=50, group=GROUP_PO3_CHART, inline="po3_tf1", tooltip="Main timeframe candle count (always active, auto-paired)")
show_po3_support_a    = input.bool(false, "TF 2", group=GROUP_PO3_CHART, inline="po3_sa", tooltip="Lower timeframe for detailed price structure")
po3_sa_manual         = input.bool(false, "Manual", group=GROUP_PO3_CHART, inline="po3_sa")
po3_sa_tf_input       = input.timeframe("5", "", group=GROUP_PO3_CHART, inline="po3_sa")
po3_sa_candle_count   = input.int(10, "", minval=2, maxval=50, group=GROUP_PO3_CHART, inline="po3_sa")
show_po3_support_b    = input.bool(false, "TF 3", group=GROUP_PO3_CHART, inline="po3_sb", tooltip="Higher timeframe for broader market context")
po3_sb_manual         = input.bool(false, "Manual", group=GROUP_PO3_CHART, inline="po3_sb")
po3_sb_tf_input       = input.timeframe("240", "", group=GROUP_PO3_CHART, inline="po3_sb")
po3_sb_candle_count   = input.int(10, "", minval=2, maxval=50, group=GROUP_PO3_CHART, inline="po3_sb")
po3_offset             = input.int(50, "Offset", minval=5, maxval=200, group=GROUP_PO3_CHART, inline="po3_layout")
po3_candle_spacing     = input.int(3, "Spacing", minval=2, maxval=10, group=GROUP_PO3_CHART, inline="po3_layout")
po3_gap                = input.int(5, "Gap", minval=0, maxval=20, group=GROUP_PO3_CHART, inline="po3_layout", tooltip="Space between PO3 tier charts")

// Resolve Support A TF
[SA_VALID_AUTO, SA_STRING_AUTO, SA_LABEL_AUTO, SA_MS_AUTO, _sa] = get_tf_pairing(CHART_TF, HTF_SLOT_SUPPORT_A)
string SA_TF_STRING = po3_sa_manual ? po3_sa_tf_input : (SA_VALID_AUTO ? SA_STRING_AUTO : "1")
string SA_TF_LABEL  = po3_sa_manual ? get_tf_display_label(po3_sa_tf_input) : SA_LABEL_AUTO
int    SA_TF_MS     = po3_sa_manual ? timeframe.in_seconds(po3_sa_tf_input) * 1000 : SA_MS_AUTO
bool   SA_IS_VALID  = show_po3_support_a and (po3_sa_manual or SA_VALID_AUTO) and timeframe.in_seconds(SA_TF_STRING) > timeframe.in_seconds()

// Resolve Support B TF
[SB_VALID_AUTO, SB_STRING_AUTO, SB_LABEL_AUTO, SB_MS_AUTO, _sb] = get_tf_pairing(CHART_TF, HTF_SLOT_SUPPORT_B)
string SB_TF_STRING = po3_sb_manual ? po3_sb_tf_input : (SB_VALID_AUTO ? SB_STRING_AUTO : "1")
string SB_TF_LABEL  = po3_sb_manual ? get_tf_display_label(po3_sb_tf_input) : SB_LABEL_AUTO
int    SB_TF_MS     = po3_sb_manual ? timeframe.in_seconds(po3_sb_tf_input) * 1000 : SB_MS_AUTO
bool   SB_IS_VALID  = show_po3_support_b and (po3_sb_manual or SB_VALID_AUTO) and timeframe.in_seconds(SB_TF_STRING) > timeframe.in_seconds()

// ─── 📊 PO3 Candles ───
po3_bull_body          = input.color(color.rgb(255, 255, 255), "+ Body", group=GROUP_PO3_CANDLES, inline="po3_bull")
po3_bull_border        = input.color(color.rgb(76, 76, 76), "Border", group=GROUP_PO3_CANDLES, inline="po3_bull")
po3_bull_wick          = input.color(color.rgb(76, 76, 76), "Wick", group=GROUP_PO3_CANDLES, inline="po3_bull")
po3_bear_body          = input.color(color.rgb(0, 0, 0), "− Body", group=GROUP_PO3_CANDLES, inline="po3_bear")
po3_bear_border        = input.color(color.rgb(76, 76, 76), "Border", group=GROUP_PO3_CANDLES, inline="po3_bear")
po3_bear_wick          = input.color(color.rgb(76, 76, 76), "Wick", group=GROUP_PO3_CANDLES, inline="po3_bear")
