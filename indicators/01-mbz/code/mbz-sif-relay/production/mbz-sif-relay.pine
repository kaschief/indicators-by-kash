// FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════════
// MBZ LABEL TEXT
// ═══════════════════════════════════════════════════════════════════════════════

// Convert HTF label to bold Unicode
// uppercase=false: "15m" → "𝟭𝟱𝗺" (zone labels)
// uppercase=true:  "15m" → "𝟭𝟱𝗠" (PO3 chart label)
get_bold_htf_label(string label, bool uppercase) =>
    switch label
        "1m"  => uppercase ? "𝟭𝗠" : "𝟭𝗺"
        "5m"  => uppercase ? "𝟱𝗠" : "𝟱𝗺"
        "15m" => uppercase ? "𝟭𝟱𝗠" : "𝟭𝟱𝗺"
        "30m" => uppercase ? "𝟯𝟬𝗠" : "𝟯𝟬𝗺"
        "1H"  => "𝟭𝗛"
        "4H"  => "𝟰𝗛"
        "D"   => "𝗗"
        "W"   => "𝗪"
        "1Mo" => "𝟭𝗠𝗼"
        "3Mo" => "𝟯𝗠𝗼"
        => label

// Build source breakdown text from gap types array
// Returns empty string for single FVG (standard case), otherwise shows breakdown
// Pool source timeframe in milliseconds (0 = not a pool source)
pool_source_ms(string src) =>
    switch src
        POOL_SOURCE_MONTHLY => TF_M_MS
        POOL_SOURCE_WEEKLY  => TF_W_MS
        POOL_SOURCE_DAILY   => TF_D_MS
        POOL_SOURCE_4H      => TF_4H_MS
        POOL_SOURCE_1H      => TF_1H_MS
        => 0

// Pool sources (e.g., "daily") appear first, then gap sources
// show_pool_sources: pool sources are MBZ-only, hide when MBZ off
// show_gap_sources: gap sources may come from MBZ or SIF, hide when neither engine wants them
build_source_breakdown(array<string> source_gap_types, bool show_pool_sources, bool show_gap_sources, int htf_ms) =>
    int num_sources = array.size(source_gap_types)
    if num_sources == 0
        ""
    else
        // Count each type
        int fvg_count = 0
        int fvg_vi_count = 0
        int imp_count = 0
        int vol_count = 0
        int pool_count = 0
        array<string> pool_names = array.new<string>()
        array<int> pool_counts = array.new<int>()

        for i = 0 to num_sources - 1
            string src = array.get(source_gap_types, i)
            bool is_gap = src == GAP_TYPE_FVG or src == GAP_TYPE_FVG_VI or src == GAP_TYPE_IMPLIED or src == GAP_TYPE_VOLUME
            if is_gap and not show_gap_sources
                continue
            if not is_gap and not show_pool_sources
                continue
            if not is_gap
                int src_ms = pool_source_ms(src)
                if src_ms > 0 and src_ms <= htf_ms
                    continue
            if src == GAP_TYPE_FVG
                fvg_count += 1
            else if src == GAP_TYPE_FVG_VI
                fvg_vi_count += 1
            else if src == GAP_TYPE_IMPLIED
                imp_count += 1
            else if src == GAP_TYPE_VOLUME
                vol_count += 1
            else
                pool_count += 1
                int name_idx = array.indexof(pool_names, src)
                if name_idx == -1
                    array.push(pool_names, src)
                    array.push(pool_counts, 1)
                else
                    array.set(pool_counts, name_idx, array.get(pool_counts, name_idx) + 1)

        int visible_count = fvg_count + fvg_vi_count + imp_count + vol_count + pool_count
        if visible_count == 0
            ""
        else
            // Build pool display string ordered by TF priority (monthly > weekly > daily > 4H), matching Prime
            string pool_display = ""
            if array.size(pool_names) > 0
                array<string> pool_parts = array.new<string>()
                array<string> pool_order = array.from(POOL_SOURCE_MONTHLY, POOL_SOURCE_WEEKLY, POOL_SOURCE_DAILY, POOL_SOURCE_4H, POOL_SOURCE_1H)
                for p = 0 to array.size(pool_order) - 1
                    string ordered_name = array.get(pool_order, p)
                    int name_idx = array.indexof(pool_names, ordered_name)
                    if name_idx != -1
                        int pc = array.get(pool_counts, name_idx)
                        array.push(pool_parts, pc == 1 ? ordered_name : ordered_name + MULTIPLIER_SYMBOL + str.tostring(pc))
                pool_display := array.join(pool_parts, BREAKDOWN_SEPARATOR)

            // Count distinct type families (fvg and fvg·vi grouped as one)
            int gap_types = (fvg_count > 0 or fvg_vi_count > 0 ? 1 : 0) + (imp_count > 0 ? 1 : 0) + (vol_count > 0 ? 1 : 0)
            int distinct_types = gap_types + (pool_count > 0 ? 1 : 0)

            string source_type_text = ""

            if distinct_types == 1
                if pool_count > 0
                    source_type_text := array.size(pool_names) > 1 ? str.tostring(visible_count) + COUNT_SEPARATOR + pool_display : pool_display
                else if fvg_count > 0 and fvg_vi_count == 0
                    if fvg_count == 1
                        source_type_text := ""
                    else
                        source_type_text := GAP_SOURCE_FVG_BREAKDOWN_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(fvg_count)
                else if fvg_vi_count > 0 and fvg_count == 0
                    if fvg_vi_count == 1
                        source_type_text := GAP_SOURCE_FVG_VI_DISPLAY
                    else
                        source_type_text := GAP_SOURCE_FVG_VI_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(fvg_vi_count)
                else if fvg_count > 0 and fvg_vi_count > 0
                    array<string> fvg_parts = array.new<string>()
                    array.push(fvg_parts, fvg_count == 1 ? GAP_SOURCE_FVG_BREAKDOWN_DISPLAY : GAP_SOURCE_FVG_BREAKDOWN_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(fvg_count))
                    array.push(fvg_parts, fvg_vi_count == 1 ? GAP_SOURCE_FVG_VI_DISPLAY : GAP_SOURCE_FVG_VI_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(fvg_vi_count))
                    source_type_text := str.tostring(fvg_count + fvg_vi_count) + COUNT_SEPARATOR + array.join(fvg_parts, BREAKDOWN_SEPARATOR)
                else if imp_count > 0
                    if imp_count == 1
                        source_type_text := "ⁱᵐᵖ"
                    else
                        source_type_text := GAP_SOURCE_IMPLIED_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(imp_count)
                else if vol_count > 0
                    if vol_count == 1
                        source_type_text := "ᵛᵒˡ"
                    else
                        source_type_text := GAP_SOURCE_VOLUME_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(vol_count)
            else
                // Multiple distinct types: pool sources first, then gap sources
                array<string> parts = array.new<string>()

                if pool_count > 0
                    array.push(parts, pool_display)
                if fvg_count > 0
                    array.push(parts, fvg_count == 1 ? GAP_SOURCE_FVG_BREAKDOWN_DISPLAY : GAP_SOURCE_FVG_BREAKDOWN_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(fvg_count))
                if fvg_vi_count > 0
                    array.push(parts, fvg_vi_count == 1 ? GAP_SOURCE_FVG_VI_DISPLAY : GAP_SOURCE_FVG_VI_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(fvg_vi_count))
                if imp_count > 0
                    array.push(parts, imp_count == 1 ? GAP_SOURCE_IMPLIED_DISPLAY : GAP_SOURCE_IMPLIED_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(imp_count))
                if vol_count > 0
                    array.push(parts, vol_count == 1 ? GAP_SOURCE_VOLUME_DISPLAY : GAP_SOURCE_VOLUME_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(vol_count))

                string breakdown = array.join(parts, BREAKDOWN_SEPARATOR)
                source_type_text := str.tostring(visible_count) + COUNT_SEPARATOR + breakdown

            source_type_text

// Build unified zone label showing which engines validated it
// Format: "𝗠𝗕𝗭·𝗦𝗜𝗙⁺·𝟰𝗛" or "IMM-SIF⁺·𝟰𝗛" or "MBZ⁺·𝟰𝗛" with source breakdown on second line
// show_mbz/show_sif control which engines appear in the label (adapts to active toggles)
// Build engine prefix string: handles MBZ/SIF combinations + LQ formation rule.
// Parentheses only when zone has BOTH gap-based MBZ AND pool-based MBZ.
// use_bold: true for main chart labels (bold Unicode), false for PO3 (plain text).
build_engine_prefix(CandleZone zone, bool show_mbz, bool show_sif, bool use_bold) =>
    bool mbz_visible = zone.has_mbz and show_mbz
    bool sif_visible = zone.has_sif and show_sif
    string prefix = ""
    if mbz_visible and sif_visible
        prefix := use_bold ? SIF_MBZ_COMBINED_BOLD : "MBZ·SIF"
    else if mbz_visible
        prefix := MBZ_BASE_TEXT
    else if sif_visible
        prefix := SIF_LABEL

    bool has_liq = zone.liq_formation_rule != "" and na(zone.liq_formation_rule) == false
    if has_liq and mbz_visible
        if zone.has_gap_mbz
            prefix := "(" + zone.liq_formation_rule + ")·" + prefix
        else
            prefix := zone.liq_formation_rule + "·" + prefix
    prefix

build_zone_label(CandleZone zone, bool show_mbz, bool show_sif, int htf_ms) =>
    string direction_suffix = zone.is_bullish ? "⁺" : "⁻"
    string prefix = build_engine_prefix(zone, show_mbz, show_sif, true)
    string htf_label_display = na(zone.htf_label) ? get_bold_htf_label(HTF1_LABEL, false) : get_bold_htf_label(zone.htf_label, false)
    string result = prefix + direction_suffix + "·" + htf_label_display
    // Pool sources are MBZ-only; gap sources show when gap-MBZ contributed or SIF is visible
    bool show_pool = show_mbz
    bool show_gap = (show_mbz and zone.has_gap_mbz) or (zone.has_sif and show_sif)
    string source_text = build_source_breakdown(zone.source_gap_types, show_pool, show_gap, htf_ms)
    if str.length(source_text) > 0
        result := result + "\n" + source_text
    result

// Returns highest-TF pool source name + optional total visible count.
// Uses same visibility logic as build_source_breakdown for count parity.
get_pool_source_label(array<string> source_gap_types, bool show_pool_sources, bool show_gap_sources, int htf_ms, bool show_count) =>
    string highest = ""
    int highest_priority = 0
    int count = 0
    for i = 0 to array.size(source_gap_types) - 1
        string src = array.get(source_gap_types, i)
        bool is_gap = src == GAP_TYPE_FVG or src == GAP_TYPE_FVG_VI or src == GAP_TYPE_IMPLIED or src == GAP_TYPE_VOLUME
        if is_gap and not show_gap_sources
            continue
        if not is_gap and not show_pool_sources
            continue
        if not is_gap
            int src_ms = pool_source_ms(src)
            if src_ms > 0 and src_ms <= htf_ms
                continue
            if src_ms > highest_priority
                highest_priority := src_ms
                highest := src
        count += 1
    string result = highest
    if show_count and count > 1
        result := highest + " (" + str.tostring(count) + ")"
    result

// ─── Direction Filter Helper ───
passes_direction_filter(bool is_bullish) =>
    mbz_direction_filter == DIR_BOTH or (is_bullish and mbz_direction_filter == DIR_BULLISH) or (not is_bullish and mbz_direction_filter == DIR_BEARISH)

// ─── Body Boundary Helpers ───
htf_body_top(float o, float c) => math.max(o, c)
htf_body_bot(float o, float c) => math.min(o, c)

// ─── HTF Displacement Candle Check ───
// Checks if C2 (htf1.o2/htf1.c2) is a displacement candle relative to C3-C5
is_htf_displacement_candle(HTFContext ctx) =>
    // C2 body size
    float c2_body = math.abs(ctx.c2 - ctx.o2)

    // Average body size of C3, C4, C5 (lookback candles)
    float c3_body = math.abs(ctx.c3 - ctx.o3)
    float c4_body = math.abs(ctx.c4 - ctx.o4)
    float c5_body = math.abs(ctx.c5 - ctx.o5)
    float avg_body = (c3_body + c4_body + c5_body) / 3.0

    // Require C2 >= multiplier * average
    if avg_body > 0
        c2_body >= (IMPLIED_DISPLACEMENT_MULTIPLIER * avg_body)
    else
        false

// ─── HTF Implied FVG Detection ───
// Returns [is_valid, bottom, top, is_bullish]
// Convention: C1=[2] oldest, C2=[1] middle, C3=[0] newest
// HTF tracking: htf_*3=oldest, htf_*2=middle, htf_*1=newest
detect_htf_implied_fvg(HTFContext ctx) =>
    // Pre-filter: Check displacement candle strength
    if not is_htf_displacement_candle(ctx)
        [false, float(na), float(na), bool(na)]
    else
        // Body boundaries
        // old = htf_*3 (oldest)
        // new = htf_*1 (newest)
        float old_body_top = htf_body_top(ctx.o3, ctx.c3)
        float old_body_bot = htf_body_bot(ctx.o3, ctx.c3)
        float new_body_top = htf_body_top(ctx.o1, ctx.c1)
        float new_body_bot = htf_body_bot(ctx.o1, ctx.c1)

        // ─── BULLISH Implied FVG ───
        // Price moved UP: old candle below, new candle above
        // Bodies separate: old body top < new body bottom (gap between)
        // Wicks overlap: old upper wick overlaps new lower wick
        bool bodies_sep_bull = old_body_top < new_body_bot
        bool old_upper_wick_exists = ctx.h3 > old_body_top
        bool new_lower_wick_exists = new_body_bot > ctx.l1
        bool bull_wicks_valid = bodies_sep_bull and old_upper_wick_exists and new_lower_wick_exists

        float bull_overlap_lo = math.max(old_body_top, ctx.l1)
        float bull_overlap_hi = math.min(ctx.h3, new_body_bot)
        bool bull_has_overlap = bull_overlap_hi > bull_overlap_lo and bull_wicks_valid

        if bull_has_overlap
            [true, old_body_top, new_body_bot, true]
        else
            // ─── BEARISH Implied FVG ───
            // Price moved DOWN: old candle above, new candle below
            // Bodies separate: new body top < old body bottom (gap between)
            // Wicks overlap: new upper wick overlaps old lower wick
            bool bodies_sep_bear = new_body_top < old_body_bot
            bool new_upper_wick_exists = ctx.h1 > new_body_top
            bool old_lower_wick_exists = old_body_bot > ctx.l3
            bool bear_wicks_valid = bodies_sep_bear and new_upper_wick_exists and old_lower_wick_exists

            float bear_overlap_lo = math.max(new_body_top, ctx.l3)
            float bear_overlap_hi = math.min(ctx.h1, old_body_bot)
            bool bear_has_overlap = bear_overlap_hi > bear_overlap_lo and bear_wicks_valid

            if bear_has_overlap
                [true, new_body_top, old_body_bot, false]
            else
                [false, float(na), float(na), false]

// ═══════════════════════════════════════════════════════════════════════════════
// HTF VOLUME IMBALANCE DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

// Detects 2-candle bullish Volume Imbalance with body separation and wick overlap
// Uses htf_*1 (newest) and htf_*2 (previous) candles
// Condition: htf_*1 body completely above htf_*2 body, but wicks still connect
is_htf_bullish_vi(HTFContext ctx) =>
    float curr_body_bot = htf_body_bot(ctx.o1, ctx.c1)  // Current body bottom
    float prev_body_top = htf_body_top(ctx.o2, ctx.c2)  // Previous body top
    bool bodies_separated = curr_body_bot > prev_body_top
    bool wicks_still_connect = ctx.l1 <= ctx.h2  // Current low reaches previous high
    bodies_separated and wicks_still_connect

// Detects 2-candle bearish Volume Imbalance with body separation and wick overlap
// Uses htf_*1 (newest) and htf_*2 (previous) candles
// Condition: htf_*1 body completely below htf_*2 body, but wicks still connect
is_htf_bearish_vi(HTFContext ctx) =>
    float curr_body_top = htf_body_top(ctx.o1, ctx.c1)  // Current body top
    float prev_body_bot = htf_body_bot(ctx.o2, ctx.c2)  // Previous body bottom
    bool bodies_separated = curr_body_top < prev_body_bot
    bool wicks_still_connect = ctx.h1 >= ctx.l2  // Current high reaches previous low
    bodies_separated and wicks_still_connect

// Calculates Volume Imbalance gap coordinates using 2-candle body separation
// Returns [gap_top, gap_bottom]
get_htf_vi_coordinates(HTFContext ctx, bool is_bullish_gap) =>
    if is_bullish_gap
        // Bullish VI: gap between htf_*2 body top and htf_*1 body bottom
        float gap_bottom = htf_body_top(ctx.o2, ctx.c2)  // Previous body top
        float gap_top = htf_body_bot(ctx.o1, ctx.c1)     // Current body bottom
        [gap_top, gap_bottom]
    else
        // Bearish VI: gap between htf_*2 body bottom and htf_*1 body top
        float gap_top = htf_body_bot(ctx.o2, ctx.c2)     // Previous body bottom
        float gap_bottom = htf_body_top(ctx.o1, ctx.c1)  // Current body top
        [gap_top, gap_bottom]

// Checks if Volume Imbalance should be suppressed by higher-priority gaps
// Matches SIF-Core's is_gap_overlapping logic exactly:
// VI is suppressed if there's an overlapping FVG or Implied FVG of the same direction that is still open
is_htf_vi_suppressed_by_gaps(array<GapData> gap_arr, float vi_top, float vi_bottom, bool is_vi_bullish) =>
    if array.size(gap_arr) == 0
        false  // No existing gaps = no suppression
    else
        bool has_overlap = false
        for i = 0 to array.size(gap_arr) - 1
            GapData gap = array.get(gap_arr, i)

            // Check for both FVG AND Implied FVG (not volume) - institutional gap hierarchy
            // Matches SIF-Core: (gap.gap_type == GAP_TYPE_FVG or gap.gap_type == GAP_TYPE_IMPLIED)
            bool is_higher_priority = gap.gap_type == GAP_TYPE_FVG or gap.gap_type == GAP_TYPE_FVG_VI or gap.gap_type == GAP_TYPE_IMPLIED
            bool same_direction = gap.is_bullish == is_vi_bullish
            bool is_open = not gap.is_inverted  // Inverted = closed, cannot suppress

            if is_higher_priority and same_direction and is_open
                // Use >= for edge case where VI exactly touches gap boundary (matches SIF-Core)
                if vi_bottom < gap.top and vi_top >= gap.bottom
                    has_overlap := true
                    break  // Found overlap, VI will be suppressed
        has_overlap

// ═══════════════════════════════════════════════════════════════════════════════
// HTF WINDOW MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

// Get window start time from htf_times array (independent of candle display)
get_window_start(array<int> times_arr) =>
    int start = 0
    if array.size(times_arr) > 0
        int idx = math.min(max_htf_candles - 1, array.size(times_arr) - 1)
        if idx >= 0
            start := array.get(times_arr, idx)
    start

// Maintain htf_times array for window tracking
update_htf_times(array<int> times_arr, int candle_time) =>
    array.unshift(times_arr, candle_time)
    while array.size(times_arr) > max_htf_candles
        array.pop(times_arr)

// ═══════════════════════════════════════════════════════════════════════════════
// HTF PROCESSING HELPERS (reusable across multiple HTF contexts)
// ═══════════════════════════════════════════════════════════════════════════════

// Create a gap and add to context's gap_array
// Centralizes all gap creation to eliminate duplication
create_htf_gap(HTFContext ctx, string gap_type, bool is_bullish, float top, float bot, int start_time, int formation_end_time, string label_suffix) =>
    float ce = (top + bot) / 2
    int gap_id = ctx.next_gap_id
    ctx.next_gap_id := ctx.next_gap_id + 1

    GapData gap = GapData.new()
    gap.top := top
    gap.bottom := bot
    gap.ce := ce
    gap.bar_index := bar_index
    gap.start_time := start_time
    gap.formation_end_time := formation_end_time
    gap.is_bullish := is_bullish
    gap.gap_type := gap_type
    gap.gap_id := gap_id
    if gap_display_mode != GAP_DISPLAY_OFF and ctx.is_chart_source
        gap.gap_box := box.new(start_time, top, time, bot, xloc=xloc.bar_time, bgcolor=color.new(GAP_COLOR, 100), border_color=color.new(GAP_COLOR, 100), border_width=1)
        gap.ce_line := line.new(start_time, ce, time, ce, xloc=xloc.bar_time, color=color.new(GAP_COLOR, 100), style=line.style_dotted, width=1)
        string label_text = ctx.htf_label + label_suffix
        gap.tf_label := label.new(time, ce, label_text, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white, 100), textcolor=color.new(GAP_COLOR, 100), size=size.small)

    array.unshift(ctx.gap_array, gap)

// Shift history for an HTF context when a new candle closes
// Also resets current candle tracking for the new forming candle
shift_htf_history(HTFContext ctx, float htf_close) =>
    // Shift [4] → [5]
    ctx.o5 := ctx.o4, ctx.h5 := ctx.h4, ctx.l5 := ctx.l4, ctx.c5 := ctx.c4
    // Shift [3] → [4]
    ctx.o4 := ctx.o3, ctx.h4 := ctx.h3, ctx.l4 := ctx.l3, ctx.c4 := ctx.c3
    // Shift [2] → [3]
    ctx.o3 := ctx.o2, ctx.h3 := ctx.h2, ctx.l3 := ctx.l2, ctx.c3 := ctx.c2, ctx.t3 := ctx.t2
    // Shift [1] → [2]
    ctx.o2 := ctx.o1, ctx.h2 := ctx.h1, ctx.l2 := ctx.l1, ctx.c2 := ctx.c1, ctx.t2 := ctx.t1
    // Shift current → [1]
    ctx.o1 := ctx.curr_open, ctx.h1 := ctx.curr_high, ctx.l1 := ctx.curr_low, ctx.c1 := htf_close, ctx.t1 := ctx.curr_time

    // Reset current candle for new forming candle
    ctx.curr_open := open
    ctx.curr_high := high
    ctx.curr_low := low
    ctx.curr_time := time

// Detect all gap types for an HTF context
// Called after history shift, creates gaps in ctx.gap_array
detect_htf_gaps(HTFContext ctx, int window_start) =>
    if ctx.h3 > 0  // Ensure we have 3 candles of history
        bool gap_in_window = ctx.t3 >= window_start or window_start == 0

        // Track whether FVG+VI combo absorbed a VIB on this bar
        bool bull_fvg_vi_created = false
        bool bear_fvg_vi_created = false

        // ─── Standard FVG Detection (Bullish) ───
        if enable_fvg and gap_in_window
            if ctx.l1 > ctx.h3
                // Check for FVG+VI combo: VIB on either side of displacement candle [2]
                float c1_body_bot = htf_body_bot(ctx.o1, ctx.c1)
                float c3_body_top = htf_body_top(ctx.o3, ctx.c3)
                bool vib_after  = c1_body_bot > htf_body_top(ctx.o2, ctx.c2) and ctx.l1 <= ctx.h2
                bool vib_before = htf_body_bot(ctx.o2, ctx.c2) > c3_body_top and ctx.l2 <= ctx.h3
                if enable_fvg_vi and (vib_after or vib_before)
                    float combo_top = vib_after ? c1_body_bot : ctx.l1
                    float combo_bot = vib_before ? c3_body_top : ctx.h3
                    create_htf_gap(ctx, GAP_TYPE_FVG_VI, true, combo_top, combo_bot, ctx.t3, ctx.t1, " fvg·vi")
                    bull_fvg_vi_created := true
                else
                    create_htf_gap(ctx, GAP_TYPE_FVG, true, ctx.l1, ctx.h3, ctx.t3, ctx.t1, "")

        // ─── Standard FVG Detection (Bearish) ───
        if enable_fvg and gap_in_window
            if ctx.h1 < ctx.l3
                float c1_body_top = htf_body_top(ctx.o1, ctx.c1)
                float c3_body_bot = htf_body_bot(ctx.o3, ctx.c3)
                bool vib_after  = c1_body_top < htf_body_bot(ctx.o2, ctx.c2) and ctx.h1 >= ctx.l2
                bool vib_before = htf_body_top(ctx.o2, ctx.c2) < c3_body_bot and ctx.h2 >= ctx.l3
                if enable_fvg_vi and (vib_after or vib_before)
                    float combo_top = vib_before ? c3_body_bot : ctx.l3
                    float combo_bot = vib_after ? c1_body_top : ctx.h1
                    create_htf_gap(ctx, GAP_TYPE_FVG_VI, false, combo_top, combo_bot, ctx.t3, ctx.t1, " fvg·vi")
                    bear_fvg_vi_created := true
                else
                    create_htf_gap(ctx, GAP_TYPE_FVG, false, ctx.l3, ctx.h1, ctx.t3, ctx.t1, "")

        // ─── Implied FVG Detection ───
        if enable_implied and gap_in_window
            [impl_found, impl_bot, impl_top, impl_bull] = detect_htf_implied_fvg(ctx)
            if impl_found
                create_htf_gap(ctx, GAP_TYPE_IMPLIED, impl_bull, impl_top, impl_bot, ctx.t3, ctx.t1, " imp")

        // ─── Volume Imbalance Detection (Bullish) ───
        if enable_volume and ctx.h2 > 0 and not bull_fvg_vi_created
            bool vi_in_window = ctx.t2 >= window_start or window_start == 0
            if vi_in_window and is_htf_bullish_vi(ctx)
                [vi_top, vi_bot] = get_htf_vi_coordinates(ctx, true)
                bool vi_is_suppressed = disable_vi_suppression ? false : is_htf_vi_suppressed_by_gaps(ctx.gap_array, vi_top, vi_bot, true)
                if not vi_is_suppressed
                    create_htf_gap(ctx, GAP_TYPE_VOLUME, true, vi_top, vi_bot, ctx.t2, ctx.t1, " vol")

        // ─── Volume Imbalance Detection (Bearish) ───
        if enable_volume and ctx.h2 > 0 and not bear_fvg_vi_created
            bool vi_in_window = ctx.t2 >= window_start or window_start == 0
            if vi_in_window and is_htf_bearish_vi(ctx)
                [vi_top, vi_bot] = get_htf_vi_coordinates(ctx, false)
                bool vi_is_suppressed = disable_vi_suppression ? false : is_htf_vi_suppressed_by_gaps(ctx.gap_array, vi_top, vi_bot, false)
                if not vi_is_suppressed
                    create_htf_gap(ctx, GAP_TYPE_VOLUME, false, vi_top, vi_bot, ctx.t2, ctx.t1, " vol")

// Check gap interactions: first tap and inversion (close through)
// Must be called BEFORE MBZ detection - ALWAYS runs (independent of gap display mode)
// Registers SIF zones when enable_sif is true and immediate SIF is detected
check_gap_interactions(array<GapData> gap_arr, array<CandleZone> zone_arr, float htf_candle_open, float htf_candle_high, float htf_candle_low, float htf_candle_close, int htf_candle_time, string htf_label_param) =>
    // Track whether any gap has immediate SIF (first tap + inversion same candle)
    bool has_immediate_sif = false

    // Track gap sources that contribute to SIF (for zone registration)
    array<int> sif_gap_ids = array.new<int>()
    array<string> sif_gap_types = array.new<string>()

    // Body boundaries for tap detection (computed once)
    float body_top = math.max(htf_candle_open, htf_candle_close)
    float body_bottom = math.min(htf_candle_open, htf_candle_close)
    bool is_candle_bullish = htf_candle_close > htf_candle_open
    bool is_candle_bearish = htf_candle_close < htf_candle_open

    if array.size(gap_arr) > 0
        // PASS 1: Process all gaps, update tap/inversion state, and detect immediate SIF
        for i = 0 to array.size(gap_arr) - 1
            GapData gap = array.get(gap_arr, i)

            // Skip already inverted gaps
            if gap.is_inverted
                continue

            // CRITICAL: The candle that forms the gap cannot tap/invert that same gap
            bool is_gap_forming_candle = htf_candle_time == gap.formation_end_time
            if is_gap_forming_candle
                continue

            // Determine if this candle taps and/or inverts THIS gap
            bool is_first_tap = false
            bool is_inversion = false

            if gap.is_bullish
                // Bullish gap + bearish candle = potential SIF tap
                bool body_enters_from_above = htf_candle_open > gap.top and htf_candle_close < gap.top
                bool body_opens_inside = htf_candle_open <= gap.top and htf_candle_open >= gap.bottom
                bool body_closes_through = htf_candle_open >= gap.bottom and htf_candle_close < gap.bottom
                bool body_enters_gap = is_candle_bearish and (body_enters_from_above or body_opens_inside or body_closes_through)

                // Inversion: CLOSE through gap bottom (SIF Core: close <= gap.bottom)
                bool candle_closes_through = htf_candle_close <= gap.bottom

                if na(gap.sif_body_tapper) and body_enters_gap
                    is_first_tap := true
                if candle_closes_through
                    is_inversion := true
            else
                // Bearish gap + bullish candle = potential SIF tap
                bool body_enters_from_below = htf_candle_open < gap.bottom and htf_candle_close > gap.bottom
                bool body_opens_inside = htf_candle_open >= gap.bottom and htf_candle_open <= gap.top
                bool body_closes_through = htf_candle_open <= gap.top and htf_candle_close > gap.top
                bool body_enters_gap = is_candle_bullish and (body_enters_from_below or body_opens_inside or body_closes_through)

                // Inversion: CLOSE through gap top (SIF Core: close >= gap.top)
                bool candle_closes_through = htf_candle_close >= gap.top

                if na(gap.sif_body_tapper) and body_enters_gap
                    is_first_tap := true
                if candle_closes_through
                    is_inversion := true

            if is_first_tap
                TapCandidate tapper = TapCandidate.new()
                tapper.bar_index := bar_index
                tapper.bar_time := htf_candle_time
                tapper.body_top := body_top
                tapper.body_bottom := body_bottom
                tapper.is_bullish := is_candle_bullish
                gap.sif_body_tapper := tapper

            // Record inversion (is_inverted always set for gap display; SIF tracking excludes fvg·vi)
            if is_inversion
                gap.is_inverted := true
                gap.inverted_time := time

                array.push(sif_gap_ids, gap.gap_id)
                array.push(sif_gap_types, gap.gap_type)

            // Update gap if anything changed
            if is_first_tap or is_inversion
                array.set(gap_arr, i, gap)

            if is_first_tap and is_inversion
                has_immediate_sif := true

        // PASS 2: Register SIF zone ONLY for immediate SIF (first tap + inversion same candle)
        // Delayed inversions don't create zones - they're just gap closures, not SIF formations
        if enable_sif and has_immediate_sif
            // Immediate SIF detected - get or create zone for this candle
            // SIF zones don't use reference wick extension (set ref to na, allow_extension to false)
            [zone, zone_idx, is_new] = get_or_create_zone(zone_arr, bar_index, htf_candle_time, htf_candle_open, htf_candle_close, htf_candle_high, htf_candle_low, is_candle_bullish, float(na), float(na), false, htf_label_param)

            // Update zone with SIF flag
            zone.has_sif := true
            zone.is_immediate_sif := true

            // Add all SIF source gaps
            for j = 0 to array.size(sif_gap_ids) - 1
                add_source_to_zone(zone, array.get(sif_gap_ids, j), array.get(sif_gap_types, j))

            // Save updated zone back to array
            array.set(zone_arr, zone_idx, zone)

// Check for MBZ formation (check tap + conviction in single pass)
// prev_* = reference candle (htf_*2 = candle before the one that just completed)
// curr_* = MBZ candle (htf_*1 = candle that just completed)
// ref_time = reference candle's start time (htf1.t2) - must be AFTER gap formation
// Returns array of MBZFormationMatch for ALL gaps that form MBZs on this candle
check_mbz_formation(array<GapData> gap_arr, float prev_o, float prev_h, float prev_l, float prev_c, int ref_time, float curr_o, float curr_h, float curr_l, float curr_c) =>
    array<MBZFormationMatch> matches = array.new<MBZFormationMatch>()

    // Previous candle (reference) direction
    bool prev_is_bullish = prev_c > prev_o
    bool prev_is_bearish = prev_c < prev_o

    // Current candle (MBZ) direction
    bool curr_is_bullish = curr_c > curr_o
    bool curr_is_bearish = curr_c < curr_o

    if array.size(gap_arr) > 0
        for i = 0 to array.size(gap_arr) - 1
            GapData gap = array.get(gap_arr, i)

            // Skip closed gaps - inverted gaps are closed and cannot form MBZ
            if gap.is_inverted
                continue

            // CRITICAL: Reference candle must be AFTER gap formation
            // This prevents FVG-forming candles from being detected as MBZ
            if ref_time <= gap.formation_end_time
                continue

            // Check if PREVIOUS candle tapped this gap
            bool prev_tapped_gap = false

            if gap.is_bullish and prev_is_bearish
                // Bullish gap: bearish candle wick must enter gap
                if prev_l <= gap.top and prev_h >= gap.bottom
                    prev_tapped_gap := true
            else if not gap.is_bullish and prev_is_bullish
                // Bearish gap: bullish candle wick must enter gap
                if prev_h >= gap.bottom and prev_l <= gap.top
                    prev_tapped_gap := true

            // Check for MBZ formation (tap + conviction)
            if prev_tapped_gap
                float prev_body_top = math.max(prev_o, prev_c)
                float prev_body_bot = math.min(prev_o, prev_c)
                float prev_50_percent = (prev_body_top + prev_body_bot) / 2

                // Bullish MBZ: gap bullish, ref bearish, current bullish, close >= 50%
                if gap.is_bullish and prev_is_bearish and curr_is_bullish
                    if curr_c >= prev_50_percent
                        // Mark source FVG - freeze box at reference candle + track MBZ direction
                        gap.mbz_ref_time := ref_time
                        gap.mbz_is_bullish := true
                        array.set(gap_arr, i, gap)
                        // Detect subtype from MBZ candle (always on)
                        [detected_subtype, _has_dominant] = detect_zone_subtype(curr_o, curr_c, curr_h, curr_l)
                        // Create match record
                        MBZFormationMatch match = MBZFormationMatch.new()
                        match.is_bullish := true
                        match.subtype := detected_subtype
                        match.source_gap_id := gap.gap_id
                        match.source_gap_type := gap.gap_type
                        array.push(matches, match)

                // Bearish MBZ: gap bearish, ref bullish, current bearish, close <= 50%
                else if not gap.is_bullish and prev_is_bullish and curr_is_bearish
                    if curr_c <= prev_50_percent
                        // Mark source FVG - freeze box at reference candle + track MBZ direction
                        gap.mbz_ref_time := ref_time
                        gap.mbz_is_bullish := false
                        array.set(gap_arr, i, gap)
                        // Detect subtype from MBZ candle (always on)
                        [detected_subtype, _has_dominant] = detect_zone_subtype(curr_o, curr_c, curr_h, curr_l)
                        // Create match record
                        MBZFormationMatch match = MBZFormationMatch.new()
                        match.is_bullish := false
                        match.subtype := detected_subtype
                        match.source_gap_id := gap.gap_id
                        match.source_gap_type := gap.gap_type
                        array.push(matches, match)

    matches

// Update FVG box positions and visibility based on display mode + direction filter
// Priority: mbz_ref_time (freeze at reference candle) > inverted_time > current time
update_gap_positions(array<GapData> gap_arr, array<CandleZone> zone_arr, bool do_style_update) =>
    int gap_count = array.size(gap_arr)
    if gap_count > 0
        // Style update: visibility/color toggling (expensive — only needed on HTF boundary or last bar)
        color gap_bg_visible = color.new(GAP_COLOR, 90)
        color gap_bg_hidden = color.new(GAP_COLOR, 100)
        color gap_border_visible = color.new(GAP_COLOR, 70)
        color gap_border_hidden = color.new(GAP_COLOR, 100)
        color gap_label_visible = color.new(GAP_COLOR, 50)
        color gap_label_hidden = color.new(GAP_COLOR, 100)

        map<int, bool> active_mbz_gap_ids = map.new<int, bool>()
        map<int, bool> active_sif_gap_ids = map.new<int, bool>()
        if do_style_update
            bool need_zone_lookup = gap_display_mode == GAP_DISPLAY_MBZ_SOURCE or gap_display_mode == GAP_DISPLAY_SIF_SOURCE
            if need_zone_lookup
                int zone_count = array.size(zone_arr)
                if zone_count > 0
                    for i = 0 to zone_count - 1
                        CandleZone zone = array.get(zone_arr, i)
                        int gap_id_count = array.size(zone.source_gap_ids)
                        if gap_id_count > 0
                            if zone.has_mbz and not zone.mbz_invalidated
                                for j = 0 to gap_id_count - 1
                                    map.put(active_mbz_gap_ids, array.get(zone.source_gap_ids, j), true)
                            if zone.has_sif and not zone.sif_invalidated
                                for j = 0 to gap_id_count - 1
                                    map.put(active_sif_gap_ids, array.get(zone.source_gap_ids, j), true)

        for i = 0 to gap_count - 1
            GapData gap = array.get(gap_arr, i)
            int right_edge = gap.mbz_ref_time > 0 ? gap.mbz_ref_time : (gap.is_inverted ? gap.inverted_time : time)
            box.set_right(gap.gap_box, right_edge)
            line.set_x2(gap.ce_line, right_edge)
            label.set_x(gap.tf_label, right_edge)

            if do_style_update and not na(gap.gap_box)
                bool type_ok = (enable_fvg and (gap.gap_type == GAP_TYPE_FVG or gap.gap_type == GAP_TYPE_FVG_VI)) or (enable_implied and gap.gap_type == GAP_TYPE_IMPLIED) or (enable_volume and gap.gap_type == GAP_TYPE_VOLUME)
                bool dir_ok = mbz_direction_filter == DIR_BOTH or (gap.mbz_is_bullish and mbz_direction_filter == DIR_BULLISH) or (not gap.mbz_is_bullish and mbz_direction_filter == DIR_BEARISH)
                bool is_mbz_source = enable_mbz and gap.mbz_ref_time > 0 and dir_ok and type_ok
                bool sif_dir_ok = mbz_direction_filter == DIR_BOTH or (gap.is_bullish and mbz_direction_filter == DIR_BEARISH) or (not gap.is_bullish and mbz_direction_filter == DIR_BULLISH)
                bool sif_type_ok = (enable_fvg and (gap.gap_type == GAP_TYPE_FVG or gap.gap_type == GAP_TYPE_FVG_VI)) or (enable_implied and gap.gap_type == GAP_TYPE_IMPLIED) or (enable_volume and gap.gap_type == GAP_TYPE_VOLUME)
                bool is_sif_source = enable_sif and gap.is_inverted and sif_dir_ok and sif_type_ok

                bool mbz_zone_active = map.contains(active_mbz_gap_ids, gap.gap_id)
                bool sif_zone_active = map.contains(active_sif_gap_ids, gap.gap_id)

                bool show_gap = switch gap_display_mode
                    GAP_DISPLAY_ALL        => type_ok
                    GAP_DISPLAY_MBZ_SOURCE => is_mbz_source and mbz_zone_active
                    GAP_DISPLAY_SIF_SOURCE => is_sif_source and sif_zone_active
                    => false

                box.set_bgcolor(gap.gap_box, show_gap ? gap_bg_visible : gap_bg_hidden)
                box.set_border_color(gap.gap_box, show_gap ? gap_border_visible : gap_border_hidden)
                line.set_color(gap.ce_line, show_gap ? gap_border_visible : gap_border_hidden)
                label.set_textcolor(gap.tf_label, show_gap ? gap_label_visible : gap_label_hidden)

// Cleanup FVGs: window-based + enforce max count
cleanup_gaps(array<GapData> gap_arr, int window_start, int max_count) =>
    // Remove FVGs outside data window
    if window_start > 0 and array.size(gap_arr) > 0
        for i = array.size(gap_arr) - 1 to 0
            GapData gap = array.get(gap_arr, i)
            if gap.start_time < window_start
                box.delete(gap.gap_box)
                line.delete(gap.ce_line)
                label.delete(gap.tf_label)
                array.remove(gap_arr, i)
    // Enforce max count (remove oldest to stay under drawing limit)
    while array.size(gap_arr) > max_count
        GapData old = array.pop(gap_arr)
        box.delete(old.gap_box)
        line.delete(old.ce_line)
        label.delete(old.tf_label)

// Cleanup old candle boxes beyond limit
cleanup_candles() =>
    while array.size(candle_boxes) > max_htf_candles
        HTFCandle old = array.pop(candle_boxes)
        box.delete(old.wick)
        box.delete(old.body)

// ═══════════════════════════════════════════════════════════════════════════════
// PO3 MINI CHART FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// Clear drawing arrays (shared helpers)
po3_clear_lines(array<line> arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            line.delete(array.get(arr, i))
        array.clear(arr)

po3_clear_boxes(array<box> arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            box.delete(array.get(arr, i))
        array.clear(arr)

po3_clear_labels(array<label> arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            label.delete(array.get(arr, i))
        array.clear(arr)

// Collect a confirmed candle into a PO3Chart's data array
po3_collect(PO3Chart chart, float o, float h, float l, float c, int t) =>
    array.unshift(chart.data, PO3CandleData.new(o, h, l, c, t))
    while array.size(chart.data) > chart.max_candles
        array.pop(chart.data)

// Clean up all visual elements for a PO3Chart
po3_cleanup(PO3Chart chart) =>
    po3_clear_boxes(chart.bodies)
    po3_clear_boxes(chart.highlights)
    po3_clear_boxes(chart.zone_boxes)
    po3_clear_lines(chart.zone_midlines)
    po3_clear_labels(chart.zone_labels)
    po3_clear_boxes(chart.fvg_boxes)
    po3_clear_lines(chart.wicks)
    po3_clear_lines(chart.dividers)
    label.delete(chart.tf_label)
    box.delete(chart.forming_body)
    line.delete(chart.forming_wick)

// Draw a single PO3 candle (body box + wick line)
// Right mode: x_center is a bar_index position (xloc.bar_index)
// Overlay mode: x_left/x_right are time boundaries (xloc.bar_time)
// When is_forming=true, stores in chart.forming_body/wick instead of arrays
po3_draw_candle(PO3Chart chart, int x_center, float o, float h, float l, float c, bool is_forming, int x_left = na, int x_right = na) =>
    bool is_bull   = c >= o
    // In overlay mode, blend additional transparency into candle colors
    color raw_body   = is_bull ? chart.bull_body   : chart.bear_body
    color raw_border = is_bull ? chart.bull_border : chart.bear_border
    color raw_wick   = is_bull ? chart.bull_wick   : chart.bear_wick
    int ot = chart.is_overlay ? po3_overlay_trans : 0
    color c_body   = ot > 0 ? color.new(raw_body, math.min(100, color.t(raw_body) + ot)) : raw_body
    color c_border = ot > 0 ? color.new(raw_border, math.min(100, color.t(raw_border) + ot)) : raw_border
    color c_wick   = ot > 0 ? color.new(raw_wick, math.min(100, color.t(raw_wick) + ot)) : raw_wick

    float body_top = math.max(o, c)
    float body_bot = math.min(o, c)
    if body_top == body_bot
        body_top := o + syminfo.mintick

    line wick_line = na
    box  body_box  = na
    if chart.is_overlay
        int wick_x = x_left + (x_right - x_left) / 2
        wick_line := line.new(wick_x, h, wick_x, l, xloc=xloc.bar_time, color=c_wick, width=1)
        body_box  := box.new(x_left, body_top, x_right, body_bot, xloc=xloc.bar_time, border_color=c_border, bgcolor=c_body, border_width=1)
    else
        wick_line := line.new(x_center, h, x_center, l, color=c_wick, width=1)
        body_box  := box.new(x_center - 1, body_top, x_center + 1, body_bot, border_color=c_border, bgcolor=c_body, border_width=1)
    if is_forming
        chart.forming_wick := wick_line
        chart.forming_body := body_box
        true
    else
        array.push(chart.wicks, wick_line)
        array.push(chart.bodies, body_box)
        true

// Draw the full PO3 chart: confirmed candles + forming candle + label
po3_render(PO3Chart chart, float curr_open, float curr_high, float curr_low, float curr_close, int curr_candle_time) =>
    po3_cleanup(chart)
    int confirmed_count = array.size(chart.data)
    float highest_point = curr_high
    float lowest_point  = curr_low
    int base_x = bar_index + chart.offset

    if chart.is_overlay
        if confirmed_count > 0
            for i = 0 to confirmed_count - 1
                int slot = confirmed_count - 1 - i
                PO3CandleData candle = array.get(chart.data, slot)
                po3_draw_candle(chart, na, candle.o, candle.h, candle.l, candle.c, false, candle.t, candle.t + chart.htf_ms)
                if candle.h > highest_point
                    highest_point := candle.h
                if candle.l < lowest_point
                    lowest_point := candle.l

        po3_draw_candle(chart, na, curr_open, curr_high, curr_low, curr_close, true, curr_candle_time, time)

        chart.highest_point := highest_point
        chart.lowest_point  := lowest_point
        if chart.show_label
            int oldest_time = confirmed_count > 0 ? array.get(chart.data, confirmed_count - 1).t : curr_candle_time
            int label_time = oldest_time + (time - oldest_time) / 2
            float label_y = po3_label_bottom ? lowest_point : highest_point
            string label_sty = po3_label_bottom ? label.style_label_up : label.style_label_down
            chart.tf_label := label.new(label_time, label_y, get_bold_htf_label(chart.htf_label, true), xloc=xloc.bar_time, style=label_sty, color=color.new(color.white, 100), textcolor=chart.label_color, size=chart.label_size)
    else
        // Right mode: draw candles at bar_index offsets
        if confirmed_count > 0
            for i = 0 to confirmed_count - 1
                int slot = confirmed_count - 1 - i
                PO3CandleData candle = array.get(chart.data, slot)
                int x_center = base_x + (i * chart.spacing)
                po3_draw_candle(chart, x_center, candle.o, candle.h, candle.l, candle.c, false)
                if candle.h > highest_point
                    highest_point := candle.h
                if candle.l < lowest_point
                    lowest_point := candle.l

        int f_x = base_x + (confirmed_count * chart.spacing)
        po3_draw_candle(chart, f_x, curr_open, curr_high, curr_low, curr_close, true)

        chart.highest_point := highest_point
        chart.lowest_point  := lowest_point
        if chart.show_label
            int label_x = (base_x + f_x) / 2
            float label_y = po3_label_bottom ? lowest_point : highest_point
            string label_sty = po3_label_bottom ? label.style_label_up : label.style_label_down
            chart.tf_label := label.new(label_x, label_y, get_bold_htf_label(chart.htf_label, true), style=label_sty, color=color.new(color.white, 100), textcolor=chart.label_color, size=chart.label_size)

// Draw HTF divider lines on the main chart for visible candle range
po3_draw_dividers(PO3Chart chart, int curr_candle_time) =>
    po3_clear_lines(chart.dividers)

    line div_forming = line.new(curr_candle_time, high, curr_candle_time, low, xloc=xloc.bar_time, color=chart.divider_color, width=1, style=chart.divider_style, extend=extend.both)
    array.push(chart.dividers, div_forming)

    int count = array.size(chart.data)
    if count > 0
        for i = 0 to count - 1
            PO3CandleData candle = array.get(chart.data, i)
            line div = line.new(candle.t, high, candle.t, low, xloc=xloc.bar_time, color=chart.divider_color, width=1, style=chart.divider_style, extend=extend.both)
            array.push(chart.dividers, div)

// Draw FVGs between visible PO3 candles
// Detects standard FVGs and fvg·vi combos based on Detection toggles
po3_draw_fvgs(PO3Chart chart) =>
    po3_clear_boxes(chart.fvg_boxes)
    int count = array.size(chart.data)
    if count >= 3
        int base_x = bar_index + chart.offset
        // Iterate triplets: data[0]=newest, data[count-1]=oldest
        // Draw slot index: oldest at left (slot 0), newest at right
        for i = 0 to count - 3
            // data indices: i=newest of triplet, i+1=middle(displacement), i+2=oldest
            PO3CandleData c1 = array.get(chart.data, i)      // after displacement
            PO3CandleData c2 = array.get(chart.data, i + 1)  // displacement
            PO3CandleData c3 = array.get(chart.data, i + 2)  // before displacement

            float c1_body_bot = math.min(c1.o, c1.c)
            float c1_body_top = math.max(c1.o, c1.c)
            float c2_body_bot = math.min(c2.o, c2.c)
            float c2_body_top = math.max(c2.o, c2.c)
            float c3_body_top = math.max(c3.o, c3.c)
            float c3_body_bot = math.min(c3.o, c3.c)

            // X coordinates differ by mode
            int x_left  = na
            int x_right = na
            string fvg_xloc = xloc.bar_index
            if chart.is_overlay
                x_left  := c3.t
                x_right := c1.t + chart.htf_ms * (1 + po3_fvg_extend)
                fvg_xloc := xloc.bar_time
            else
                // Slot positions (oldest=left): c3 at slot count-1-(i+2), c1 at slot count-1-i
                x_left  := base_x + ((count - 1 - (i + 2)) * chart.spacing) + 1
                x_right := base_x + ((count - 1 - i + po3_fvg_extend) * chart.spacing) - 1

            // Bullish FVG: c1 low > c3 high
            if enable_fvg and c1.l > c3.h
                float fvg_top = c1.l
                float fvg_bot = c3.h
                // Check for fvg·vi combo
                bool vib_after  = enable_fvg_vi and c1_body_bot > c2_body_top and c1.l <= c2.h
                bool vib_before = enable_fvg_vi and c2_body_bot > c3_body_top and c2.l <= c3.h
                if vib_after or vib_before
                    fvg_top := vib_after ? c1_body_bot : c1.l
                    fvg_bot := vib_before ? c3_body_top : c3.h
                box fvg = box.new(x_left, fvg_top, x_right, fvg_bot, xloc=fvg_xloc, border_color=color.new(color.white, 100), bgcolor=po3_fvg_bull_color, border_width=0)
                array.push(chart.fvg_boxes, fvg)

            // Bearish FVG: c1 high < c3 low
            if enable_fvg and c1.h < c3.l
                float fvg_top = c3.l
                float fvg_bot = c1.h
                bool vib_after  = enable_fvg_vi and c1_body_top < c2_body_bot and c1.h >= c2.l
                bool vib_before = enable_fvg_vi and c2_body_top < c3_body_bot and c2.h >= c3.l
                if vib_after or vib_before
                    fvg_top := vib_before ? c3_body_bot : c3.l
                    fvg_bot := vib_after ? c1_body_top : c1.h
                box fvg = box.new(x_left, fvg_top, x_right, fvg_bot, xloc=fvg_xloc, border_color=color.new(color.white, 100), bgcolor=po3_fvg_bear_color, border_width=0)
                array.push(chart.fvg_boxes, fvg)

// Highlight PO3 candles that have MBZ/SIF zones: recolor body + draw zone box + label
// inv_zone_ids: set of zone formation_times that are live-invalidated (computed by caller)
po3_highlight_zones(PO3Chart chart, array<CandleZone> zone_arr, map<int, bool> inv_mbz_ids, map<int, bool> inv_sif_ids, int htf_ms, map<int, bool> same_source_hidden) =>
    int confirmed_count = array.size(chart.data)
    int zone_count = array.size(zone_arr)
    if confirmed_count > 0 and zone_count > 0
        int base_x = bar_index + chart.offset

        for i = 0 to confirmed_count - 1
            int data_idx = confirmed_count - 1 - i
            PO3CandleData candle = array.get(chart.data, data_idx)
            int x_center = chart.is_overlay ? na : base_x + (i * chart.spacing)
            int candle_time_mid = chart.is_overlay ? candle.t + chart.htf_ms / 2 : na
            bool wick_split = false

            for z_idx = 0 to zone_count - 1
                CandleZone zone = array.get(zone_arr, z_idx)
                if zone.is_invalidated or zone.formation_time != candle.t
                    continue

                // Determine if this zone should show on PO3 (respect live invalidation + same-source filter)
                bool mbz_live_ok = zone.has_mbz and chart.show_mbz and not map.contains(inv_mbz_ids, zone.formation_time)
                bool sif_live_ok = zone.has_sif and chart.show_sif and not map.contains(inv_sif_ids, zone.formation_time)
                if not mbz_live_ok and not sif_live_ok
                    continue
                if mbz_live_ok and map.contains(same_source_hidden, z_idx)
                    continue

                // Pick highlight color: MBZ takes priority, then SIF
                color hl_color = na
                if mbz_live_ok
                    hl_color := zone.is_bullish ? chart.mbz_bull_highlight : chart.mbz_bear_highlight
                else
                    hl_color := zone.is_bullish ? chart.sif_bull_highlight : chart.sif_bear_highlight

                string zone_text = build_engine_prefix(zone, mbz_live_ok, sif_live_ok, false)

                // Recolor candle body (keep original border) + split wick (once per candle)
                if i < array.size(chart.bodies) and i < array.size(chart.wicks)
                    box.set_bgcolor(array.get(chart.bodies, i), hl_color)

                    if not wick_split
                        float body_t = math.max(candle.o, candle.c)
                        float body_b = math.min(candle.o, candle.c)
                        color wk = candle.c >= candle.o ? chart.bull_wick : chart.bear_wick
                        line.delete(array.get(chart.wicks, i))
                        if chart.is_overlay
                            array.set(chart.wicks, i, line.new(candle_time_mid, candle.h, candle_time_mid, body_t, xloc=xloc.bar_time, color=wk, width=1))
                            array.push(chart.wicks, line.new(candle_time_mid, body_b, candle_time_mid, candle.l, xloc=xloc.bar_time, color=wk, width=1))
                        else
                            array.set(chart.wicks, i, line.new(x_center, candle.h, x_center, body_t, color=wk, width=1))
                            array.push(chart.wicks, line.new(x_center, body_b, x_center, candle.l, color=wk, width=1))
                        wick_split := true

                // Zone box left edge:
                //   ref_pushed → extend to ref candle (left by 1 spacing)
                //   otherwise → right half of candle body only
                bool ref_pushed = false
                if zone.is_wick_extended and not na(zone.ref_candle_high) and not na(zone.ref_candle_low)
                    if zone.is_bullish and zone.ref_candle_low < zone.candle_low
                        ref_pushed := true
                    else if not zone.is_bullish and zone.ref_candle_high > zone.candle_high
                        ref_pushed := true
                int zone_left  = na
                int zone_right = na
                string zone_xloc = xloc.bar_index
                if chart.is_overlay
                    zone_left  := ref_pushed ? candle.t - chart.htf_ms : candle.t
                    zone_right := candle.t + chart.htf_ms
                    zone_xloc  := xloc.bar_time
                else
                    zone_left  := ref_pushed ? x_center - chart.spacing : x_center
                    zone_right := x_center + chart.spacing + 1

                bool po3_use_mbz = zone.has_mbz and chart.show_mbz
                color po3_zb_color = zone.is_bullish ? (po3_use_mbz ? chart.mbz_zone_bull : chart.sif_zone_bull) : (po3_use_mbz ? chart.mbz_zone_bear : chart.sif_zone_bear)
                box zb = box.new(zone_left, zone.zone_top, zone_right, zone.zone_bottom, xloc=zone_xloc, border_color=color.new(color.white, 100), bgcolor=po3_zb_color, border_width=0)
                array.push(chart.zone_boxes, zb)

                // 50% midline
                float midpoint = (zone.zone_top + zone.zone_bottom) / 2
                line ml = line.new(zone_left, midpoint, zone_right, midpoint, xloc=zone_xloc, color=chart.midline_color, width=1, style=chart.midline_style)
                array.push(chart.zone_midlines, ml)

                // Zone label: above for bearish, below for bullish
                string dir = zone.is_bullish ? MBZ_BULLISH_SUFFIX : MBZ_BEARISH_SUFFIX
                string label_text = zone_text + dir
                if po3_show_times
                    int valid_time = zone.formation_time + htf_ms
                    string h = str.tostring(hour(valid_time, NY_TIMEZONE))
                    string m = str.tostring(minute(valid_time, NY_TIMEZONE))
                    if str.length(m) < 2
                        m := "0" + m
                    label_text := label_text + " · " + h + ":" + m
                if po3_pool_source_mode != POOL_SRC_OFF
                    bool po3_show_pool = mbz_live_ok
                    bool po3_show_gap = (mbz_live_ok and zone.has_gap_mbz) or (sif_live_ok and zone.has_sif)
                    string pool_src = get_pool_source_label(zone.source_gap_types, po3_show_pool, po3_show_gap, htf_ms, po3_pool_source_mode == POOL_SRC_SOURCE_COUNT)
                    if pool_src != ""
                        label_text := label_text + ":  " + pool_src
                float label_y = zone.is_bullish ? math.min(zone.zone_bottom, candle.l) : math.max(zone.zone_top, candle.h)
                string label_sty = zone.is_bullish ? label.style_label_up : label.style_label_down
                bool use_mbz_lbl = zone.has_mbz and enable_mbz
                color label_clr = zone.is_bullish ? (use_mbz_lbl ? po3_mbz_label_color : po3_sif_label_color) : (use_mbz_lbl ? po3_mbz_label_bear : po3_sif_label_bear)
                int base_len = str.length(zone_text) + str.length(dir)
                int extra_chars = math.max(0, str.length(label_text) - base_len)
                int label_x_offset = 0
                if not chart.is_overlay
                    label_x_offset := int((zone_right - zone_left) * extra_chars / PO3_LABEL_OFFSET_DIVISOR)
                int label_x_pos = (zone_left + zone_right) / 2 + label_x_offset
                label lbl = label.new(label_x_pos, label_y, label_text, xloc=zone_xloc, style=label_sty, color=color.new(color.white, 100), textcolor=label_clr, size=size.tiny)
                array.push(chart.zone_labels, lbl)

// ═══════════════════════════════════════════════════════════════════════════════
// INVALIDATION FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// Calculate zone penetration percentage using close price
calculate_mbz_zone_penetration_from_close(float close_price, float zone_top, float zone_bottom, bool is_bullish_zone) =>
    float zone_range = zone_top - zone_bottom
    if zone_range <= 0
        0.0
    else
        if is_bullish_zone
            // Bullish zone: penetration is from top downward
            if close_price >= zone_top
                0.0
            else if close_price <= zone_bottom
                100.0
            else
                (zone_top - close_price) / zone_range * 100.0
        else
            // Bearish zone: penetration is from bottom upward
            if close_price <= zone_bottom
                0.0
            else if close_price >= zone_top
                100.0
            else
                (close_price - zone_bottom) / zone_range * 100.0

// ═══════════════════════════════════════════════════════════════════════════════
// UNIFIED ZONE INVALIDATION
// ═══════════════════════════════════════════════════════════════════════════════

// Generic component invalidation check - works for both MBZ and SIF
check_component_single_candle_invalidation(float zone_top, float zone_bottom, bool is_bullish, float threshold, float candle_open, float candle_close) =>
    if is_bullish
        // Bullish zone: gap-through below zone = instant invalidation
        if candle_open < zone_bottom
            true
        else
            float penetration = calculate_mbz_zone_penetration_from_close(candle_close, zone_top, zone_bottom, true)
            penetration >= threshold
    else
        // Bearish zone: gap-through above zone = instant invalidation
        if candle_open > zone_top
            true
        else
            float penetration = calculate_mbz_zone_penetration_from_close(candle_close, zone_top, zone_bottom, false)
            penetration >= threshold

// Check if MBZ component should be invalidated by a single candle
check_mbz_component_invalidation(CandleZone zone, float candle_open, float candle_close) =>
    if not zone.has_mbz or zone.mbz_invalidated
        false
    else
        check_component_single_candle_invalidation(zone.zone_top, zone.zone_bottom, zone.is_bullish, MBZ_INVALIDATION_THRESHOLD, candle_open, candle_close)

// Check if SIF component should be invalidated by a single candle
check_sif_component_invalidation(CandleZone zone, float candle_open, float candle_close) =>
    if not zone.has_sif or zone.sif_invalidated
        false
    else
        check_component_single_candle_invalidation(zone.zone_top, zone.zone_bottom, zone.is_bullish, SIF_INVALIDATION_THRESHOLD, candle_open, candle_close)

// Check if zone is comprised ONLY of Volume Imbalance (VI) sources
is_vi_only_zone(CandleZone zone) =>
    int num_sources = array.size(zone.source_gap_types)
    if num_sources == 0
        false
    else
        bool all_vi = true
        for i = 0 to num_sources - 1
            if array.get(zone.source_gap_types, i) != GAP_TYPE_VOLUME
                all_vi := false
                break
        all_vi

// Check if MBZ component should be invalidated
// NOTE: Historical lookback removed for relay - close[i]/open[i] is LTF data, not HTF!
// Zones invalidate via: (1) completed HTF candles on new_htf, (2) live htf_open/close check
should_mbz_component_be_invalidated(CandleZone zone, float htf_open_price, float htf_close_price) =>
    if not zone.has_mbz or zone.mbz_invalidated
        false
    else
        check_mbz_component_invalidation(zone, htf_open_price, htf_close_price)

// Check if SIF component should be invalidated
// NOTE: Historical lookback removed for relay - close[i]/open[i] is LTF data, not HTF!
// Zones invalidate via: (1) completed HTF candles on new_htf, (2) live opening gap check
should_sif_component_be_invalidated(CandleZone zone, float htf_open_price, float htf_close_price) =>
    if not zone.has_sif or zone.sif_invalidated
        false
    else
        check_sif_component_invalidation(zone, htf_open_price, htf_close_price)

// ═══════════════════════════════════════════════════════════════════════════════
// LIVE INVALIDATION (Opening Gaps Only)
// For forming HTF candles, we only check opening gaps - NOT close penetration
// Close penetration requires a CONFIRMED HTF close, which isn't available until new_htf
// ═══════════════════════════════════════════════════════════════════════════════

// Check if component is invalidated by opening gap only (for live checks)
check_component_opening_gap_invalidation(float zone_top, float zone_bottom, bool is_bullish, float candle_open) =>
    if is_bullish
        // Bullish zone: gap-through below zone = instant invalidation
        candle_open < zone_bottom
    else
        // Bearish zone: gap-through above zone = instant invalidation
        candle_open > zone_top

// Check MBZ component for opening gap invalidation (live check)
check_mbz_component_opening_gap(CandleZone zone, float candle_open) =>
    if not zone.has_mbz or zone.mbz_invalidated
        false
    else
        check_component_opening_gap_invalidation(zone.zone_top, zone.zone_bottom, zone.is_bullish, candle_open)

// Check SIF component for opening gap invalidation (live check)
check_sif_component_opening_gap(CandleZone zone, float candle_open) =>
    if not zone.has_sif or zone.sif_invalidated
        false
    else
        check_component_opening_gap_invalidation(zone.zone_top, zone.zone_bottom, zone.is_bullish, candle_open)

// Live invalidation for unified zones - OPENING GAPS ONLY (permanent)
// Close-based invalidation is computed in rendering for visual hide/show
check_zone_invalidation_live(array<CandleZone> zone_arr, float htf_open_price) =>
    if array.size(zone_arr) > 0
        for i = 0 to array.size(zone_arr) - 1
            CandleZone zone = array.get(zone_arr, i)

            if zone.is_invalidated
                continue

            bool needs_update = false

            // Check MBZ component for opening gap ONLY (permanent)
            if check_mbz_component_opening_gap(zone, htf_open_price)
                zone.mbz_invalidated := true
                zone.has_mbz := false
                needs_update := true

            // Check SIF component for opening gap ONLY (permanent)
            if check_sif_component_opening_gap(zone, htf_open_price)
                zone.sif_invalidated := true
                zone.has_sif := false
                needs_update := true

            // If NO active components remain, mark zone as fully invalidated
            if not zone.has_mbz and not zone.has_sif
                zone.is_invalidated := true
                delete_zone_visuals(zone)
            else if needs_update
                delete_zone_visuals(zone)

            array.set(zone_arr, i, zone)

// Check invalidation for all unified zones - tracks MBZ and SIF independently
// This is for CONFIRMED HTF candles only (called on new_htf with htf1.o1, htf1.c1)
check_zone_invalidation(array<CandleZone> zone_arr, float htf_open_price, float htf_close_price) =>
    if array.size(zone_arr) > 0
        for i = 0 to array.size(zone_arr) - 1
            CandleZone zone = array.get(zone_arr, i)

            // Skip fully invalidated zones
            if zone.is_invalidated
                continue

            bool needs_update = false

            // Check MBZ component
            if should_mbz_component_be_invalidated(zone, htf_open_price, htf_close_price)
                zone.mbz_invalidated := true
                zone.has_mbz := false  // Remove MBZ from zone
                needs_update := true

            // Check SIF component
            if should_sif_component_be_invalidated(zone, htf_open_price, htf_close_price)
                zone.sif_invalidated := true
                zone.has_sif := false  // Remove SIF from zone
                needs_update := true

            // If NO active components remain, mark zone as fully invalidated
            if not zone.has_mbz and not zone.has_sif
                zone.is_invalidated := true
                delete_zone_visuals(zone)
            else if needs_update
                // Partial invalidation: force box recreation by clearing visuals
                delete_zone_visuals(zone)

            array.set(zone_arr, i, zone)

// Cleanup unified zones outside window
cleanup_zones(array<CandleZone> zone_arr, int window_start, int max_count) =>
    // Remove zones outside data window
    if window_start > 0 and array.size(zone_arr) > 0
        for i = array.size(zone_arr) - 1 to 0
            CandleZone zone = array.get(zone_arr, i)
            if zone.formation_time < window_start
                delete_zone_visuals(zone)
                array.remove(zone_arr, i)
    // Enforce max count (remove oldest to stay under drawing limit)
    while array.size(zone_arr) > max_count
        delete_zone_visuals(array.pop(zone_arr))

// ═══════════════════════════════════════════════════════════════════════════════
// LIQUIDITY POOL FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

liq_pool_create() =>
    LiquidityPoolCollection.new(array.new<PoolLevel>(), float(na), float(na), int(na), int(na), 0, 0, float(na), float(na))

liq_pool_session_count(LiquidityPoolCollection pool) =>
    array.size(pool.levels)

liq_pool_clear_current(LiquidityPoolCollection pool) =>
    pool.current_high := na
    pool.current_low := na
    pool.current_high_time := na
    pool.current_low_time := na

liq_pool_reset_current(LiquidityPoolCollection pool, float highest, float lowest, int time_val) =>
    pool.current_high := highest
    pool.current_low := lowest
    pool.current_high_time := time_val
    pool.current_low_time := time_val

liq_pool_update_current(LiquidityPoolCollection pool, float highest, float lowest, int time_val) =>
    if na(pool.current_high) or na(pool.current_low)
        liq_pool_reset_current(pool, highest, lowest, time_val)
    else
        if highest > pool.current_high
            pool.current_high := highest
            pool.current_high_time := time_val
        if lowest < pool.current_low
            pool.current_low := lowest
            pool.current_low_time := time_val

liq_pool_advance_high_pointer(LiquidityPoolCollection pool) =>
    count = liq_pool_session_count(pool)
    idx = math.max(0, pool.first_unbreached_high_index)
    if idx > count
        idx := count
    while idx < count and array.get(pool.levels, idx).high_breached
        idx += 1
    pool.first_unbreached_high_index := idx

liq_pool_advance_low_pointer(LiquidityPoolCollection pool) =>
    count = liq_pool_session_count(pool)
    idx = math.max(0, pool.first_unbreached_low_index)
    if idx > count
        idx := count
    while idx < count and array.get(pool.levels, idx).low_breached
        idx += 1
    pool.first_unbreached_low_index := idx

liq_pool_recompute_min_unbreached_high(LiquidityPoolCollection pool) =>
    total = liq_pool_session_count(pool)
    result = float(na)
    if pool.first_unbreached_high_index < total
        for i = pool.first_unbreached_high_index to total - 1
            PoolLevel lvl = array.get(pool.levels, i)
            if not lvl.high_breached
                if na(result) or lvl.session_high < result
                    result := lvl.session_high
    pool.min_unbreached_high := result

liq_pool_recompute_max_unbreached_low(LiquidityPoolCollection pool) =>
    total = liq_pool_session_count(pool)
    result = float(na)
    if pool.first_unbreached_low_index < total
        for i = pool.first_unbreached_low_index to total - 1
            PoolLevel lvl = array.get(pool.levels, i)
            if not lvl.low_breached
                if na(result) or lvl.session_low > result
                    result := lvl.session_low
    pool.max_unbreached_low := result

liq_pool_trim(LiquidityPoolCollection pool, int max_entries) =>
    while liq_pool_session_count(pool) > max_entries
        array.shift(pool.levels)
        pool.first_unbreached_high_index := math.max(0, pool.first_unbreached_high_index - 1)
        pool.first_unbreached_low_index := math.max(0, pool.first_unbreached_low_index - 1)

    liq_pool_advance_high_pointer(pool)
    liq_pool_advance_low_pointer(pool)
    liq_pool_recompute_min_unbreached_high(pool)
    liq_pool_recompute_max_unbreached_low(pool)

liq_pool_finalize_session(LiquidityPoolCollection pool, int close_time, int max_entries) =>
    if not na(pool.current_high) and not na(pool.current_low)
        PoolLevel lvl = PoolLevel.new()
        lvl.session_high := pool.current_high
        lvl.session_low := pool.current_low
        lvl.high_time := pool.current_high_time
        lvl.low_time := pool.current_low_time
        lvl.session_close_time := close_time
        lvl.high_breached := false
        lvl.low_breached := false
        lvl.high_used_by_pattern_1 := false
        lvl.high_used_by_pattern_2 := false
        lvl.high_used_by_pattern_3 := false
        lvl.low_used_by_pattern_1 := false
        lvl.low_used_by_pattern_2 := false
        lvl.low_used_by_pattern_3 := false
        array.push(pool.levels, lvl)

        new_index = liq_pool_session_count(pool) - 1
        if pool.first_unbreached_high_index >= liq_pool_session_count(pool)
            pool.first_unbreached_high_index := new_index
        if pool.first_unbreached_low_index >= liq_pool_session_count(pool)
            pool.first_unbreached_low_index := new_index

        pool.min_unbreached_high := na(pool.min_unbreached_high) ? pool.current_high : math.min(pool.min_unbreached_high, pool.current_high)
        pool.max_unbreached_low := na(pool.max_unbreached_low) ? pool.current_low : math.max(pool.max_unbreached_low, pool.current_low)

        liq_pool_trim(pool, max_entries)

    liq_pool_clear_current(pool)

liq_pool_mark_breaches(LiquidityPoolCollection pool, float bar_high, float bar_low, int bar_time) =>
    found_breach = false
    total = liq_pool_session_count(pool)
    if total > 0
        bool high_breached_min = false
        if pool.first_unbreached_high_index < total and not na(pool.min_unbreached_high) and bar_high >= pool.min_unbreached_high
            for i = pool.first_unbreached_high_index to total - 1
                PoolLevel lvl = array.get(pool.levels, i)
                if not lvl.high_breached and bar_high >= lvl.session_high
                    lvl.high_breached := true
                    lvl.high_breach_time := bar_time
                    lvl.high_first_breach_bar := bar_index
                    array.set(pool.levels, i, lvl)
                    found_breach := true
                    if lvl.session_high == pool.min_unbreached_high
                        high_breached_min := true
            liq_pool_advance_high_pointer(pool)
            if high_breached_min
                liq_pool_recompute_min_unbreached_high(pool)

        bool low_breached_max = false
        if pool.first_unbreached_low_index < total and not na(pool.max_unbreached_low) and bar_low <= pool.max_unbreached_low
            for i = pool.first_unbreached_low_index to total - 1
                PoolLevel lvl = array.get(pool.levels, i)
                if not lvl.low_breached and bar_low <= lvl.session_low
                    lvl.low_breached := true
                    lvl.low_breach_time := bar_time
                    lvl.low_first_breach_bar := bar_index
                    array.set(pool.levels, i, lvl)
                    found_breach := true
                    if lvl.session_low == pool.max_unbreached_low
                        low_breached_max := true
            liq_pool_advance_low_pointer(pool)
            if low_breached_max
                liq_pool_recompute_max_unbreached_low(pool)

    found_breach

// ─── Liquidity Pool Pattern Conditions ───
// Pure functions ported from Prime — detect IMM/STD/DEL sweep patterns against a pool level

// IMMEDIATE: A stays inside level, B sweeps through on current candle
liquidity_immediate_condition(bool is_bearish_pattern, float level_value, float a_high, float a_low, float a_close, float b_open, float b_close, float b_high, float b_low) =>
    if is_bearish_pattern
        previous_inside = a_high <= level_value
        current_sweep = b_high > level_value and b_open < level_value
        is_bearish_candle = b_close < b_open
        previous_inside and current_sweep and is_bearish_candle
    else
        previous_inside = a_low >= level_value
        current_sweep = b_low < level_value and b_open > level_value
        is_bullish_candle = b_close > b_open
        previous_inside and current_sweep and is_bullish_candle

// STANDARD: A moves into the sweep (directional), wicks through level but closes inside, B displaces
liquidity_standard_condition(bool is_bearish_pattern, float level_value, float a_open, float a_close, float a_high, float a_low, float b_open, float b_close, float b_high, float b_low) =>
    if is_bearish_pattern
        wick_only_first_breach = a_open < level_value and a_high > level_value and a_close < level_value
        a_moved_into_sweep = a_close > a_open
        is_bearish_candle = b_close < b_open
        is_valid = wick_only_first_breach and b_open < level_value and is_bearish_candle and a_moved_into_sweep
        [is_valid, true]
    else
        wick_only_first_breach = a_open > level_value and a_low < level_value and a_close > level_value
        a_moved_into_sweep = a_close < a_open
        is_bullish_candle = b_close > b_open
        is_valid = wick_only_first_breach and b_open > level_value and is_bullish_candle and a_moved_into_sweep
        [is_valid, true]

// DELAYED: A moves into the sweep (directional), body closes through level, B displaces
liquidity_delayed_condition(bool is_bearish_pattern, float level_value, float a_open, float a_close, float b_open, float b_close) =>
    if is_bearish_pattern
        body_close_breach = a_close > level_value
        a_moved_into_sweep = a_close > a_open
        is_bearish_candle = b_close < b_open
        is_valid = body_close_breach and b_open > level_value and is_bearish_candle and a_moved_into_sweep
        [is_valid, true]
    else
        body_close_breach = a_close < level_value
        a_moved_into_sweep = a_close < a_open
        is_bullish_candle = b_close > b_open
        is_valid = body_close_breach and b_open < level_value and is_bullish_candle and a_moved_into_sweep
        [is_valid, true]

// Midpoint confirmation: B close must cross 50% of B body in the pattern direction
check_midpoint_confirmation(bool is_bearish_mbz, float close_price, float midpoint) =>
    if is_bearish_mbz
        if close_price < midpoint
            [true, false]
        else if close_price == midpoint
            [true, true]
        else
            [false, false]
    else
        if close_price > midpoint
            [true, false]
        else if close_price == midpoint
            [true, true]
        else
            [false, false]

// ─── Liquidity Formation Rule Priority ───
// IMM > STD > DEL — used when multiple rules match the same zone
get_liq_rule_priority(string rule) =>
    if rule == LIQ_RULE_IMM
        3
    else if rule == LIQ_RULE_STD
        2
    else if rule == LIQ_RULE_DEL
        1
    else
        0

// ─── Pool Zone Creation Helper ───
// Creates or updates a CandleZone from a pool sweep pattern.
// Uses HTF candle OHLC (matching Prime at HTF granularity):
//   - Midpoint: candle A body 50% = (ctx.o2+ctx.c2)/2
//   - Zone boundaries: candle B OHLC (ctx.o1/c1/h1/l1)
//   - Ref candle: candle A (ctx.h2/l2)
create_pool_zone(HTFContext ctx, bool mbz_bull, string pool_source_label, string formation_rule, int pool_source_id) =>
    float a_midpoint = (ctx.o2 + ctx.c2) / 2.0
    [mid_ok, _at_mid] = check_midpoint_confirmation(not mbz_bull, ctx.c1, a_midpoint)

    bool created = false
    if mid_ok
        if passes_direction_filter(mbz_bull)
            [zone, zone_idx, is_new] = get_or_create_zone(ctx.zone_array, bar_index, ctx.t1, ctx.o1, ctx.c1, ctx.h1, ctx.l1, mbz_bull, ctx.h2, ctx.l2, extend_to_wick, ctx.htf_label)
            zone.has_mbz := true
            zone.ref_candle_high := ctx.h2
            zone.ref_candle_low := ctx.l2
            if not is_new and extend_to_wick and not zone.is_wick_extended
                [new_top, new_bottom, now_extended] = calculate_zone_boundaries(ctx.o1, ctx.c1, ctx.h1, ctx.l1, mbz_bull, zone.zone_subtype, ctx.h2, ctx.l2, extend_to_wick)
                zone.zone_top := new_top
                zone.zone_bottom := new_bottom
                zone.is_wick_extended := now_extended
            if zone.liq_formation_rule == "" or get_liq_rule_priority(formation_rule) > get_liq_rule_priority(zone.liq_formation_rule)
                zone.liq_formation_rule := formation_rule
            add_source_to_zone(zone, pool_source_id, pool_source_label)
            array.set(ctx.zone_array, zone_idx, zone)
            created := true
    created

// ─── Per-Tier Pool Detection State Accessors ───
pool_get_used(PoolLevel lvl, bool check_high, int tier) =>
    check_high ?
      (tier == 1 ? lvl.high_used_by_pattern_1 : tier == 2 ? lvl.high_used_by_pattern_2 : lvl.high_used_by_pattern_3) :
      (tier == 1 ? lvl.low_used_by_pattern_1  : tier == 2 ? lvl.low_used_by_pattern_2  : lvl.low_used_by_pattern_3)

pool_set_used(PoolLevel lvl, bool check_high, int tier, bool val) =>
    if check_high
        if tier == 1
            lvl.high_used_by_pattern_1 := val
        else if tier == 2
            lvl.high_used_by_pattern_2 := val
        else
            lvl.high_used_by_pattern_3 := val
    else
        if tier == 1
            lvl.low_used_by_pattern_1 := val
        else if tier == 2
            lvl.low_used_by_pattern_2 := val
        else
            lvl.low_used_by_pattern_3 := val

// ─── Pool Side Detection Helper ───
// Runs at HTF close. Uses breach_time windowing to map chart-bar breaches
// to HTF candle A/B geometry. No latch — levels stay eligible until
// breach_time naturally falls outside the 2-candle window.
// IMM: breach during candle B period (B is sweep candle).
// STD/DEL: breach during candle A period (A is sweep candle).
// A B-period breach on close N becomes an A-period breach on close N+1
// (after shift_htf_history), giving each level 2 consecutive close checks.
detect_pool_side(LiquidityPoolCollection pool, HTFContext ctx, string pool_source_label, bool check_high_side, int i, int pool_source_id) =>
    PoolLevel lvl = array.get(pool.levels, i)
    int tier = ctx.tier_index
    bool breached = check_high_side ? lvl.high_breached : lvl.low_breached
    bool used = pool_get_used(lvl, check_high_side, tier)
    bool found = false
    if breached and not used
        float level = check_high_side ? lvl.session_high : lvl.session_low
        int breach_time = check_high_side ? lvl.high_breach_time : lvl.low_breach_time
        bool is_bearish_pattern = check_high_side

        // Breach-time windowing: map chart-bar breach timestamp to HTF candle periods.
        // breach_in_b: breach during candle B period — check IMM (B is sweep candle)
        // breach_in_a: breach during candle A period — check STD/DEL (A is sweep candle)
        // These are mutually exclusive per close, matching Prime's breach_is_current/previous.
        // After shift_htf_history, a B-period breach becomes an A-period breach on the next close.
        bool breach_in_b = not na(breach_time) and breach_time >= ctx.t1
        bool breach_in_a = not na(breach_time) and breach_time >= ctx.t2 and breach_time < ctx.t1

        // OHLC reach: does the candle physically touch the level?
        bool a_reaches = check_high_side ? (ctx.h2 >= level) : (ctx.l2 <= level)
        bool b_reaches = check_high_side ? (ctx.h1 >= level) : (ctx.l1 <= level)

        string matched_rule = ""
        // IMM: breach during candle B, B sweeps the level
        if enable_liq_imm and breach_in_b and b_reaches
            if liquidity_immediate_condition(is_bearish_pattern, level, ctx.h2, ctx.l2, ctx.c2, ctx.o1, ctx.c1, ctx.h1, ctx.l1)
                matched_rule := LIQ_RULE_IMM
        // STD: breach during candle A, A is the sweep candle
        if matched_rule == "" and enable_liq_std and breach_in_a and a_reaches
            [std_valid, _] = liquidity_standard_condition(is_bearish_pattern, level, ctx.o2, ctx.c2, ctx.h2, ctx.l2, ctx.o1, ctx.c1, ctx.h1, ctx.l1)
            if std_valid
                matched_rule := LIQ_RULE_STD
        // DEL: breach during candle A, A is the sweep candle
        if matched_rule == "" and enable_liq_del and breach_in_a and a_reaches
            [del_valid, _] = liquidity_delayed_condition(is_bearish_pattern, level, ctx.o2, ctx.c2, ctx.o1, ctx.c1)
            if del_valid
                matched_rule := LIQ_RULE_DEL
        if matched_rule != ""
            pool_set_used(lvl, check_high_side, tier, true)
            array.set(pool.levels, i, lvl)
            found := create_pool_zone(ctx, not check_high_side, pool_source_label, matched_rule, pool_source_id)
    found

// ─── Liquidity Pool Pattern Detection ───
// Runs at HTF close. Scans finalized pool sessions for sweep patterns.
detect_liq_pool_patterns(LiquidityPoolCollection pool, HTFContext ctx, string pool_source_label, int pool_source_id) =>
    bool found_pattern = false
    int total = liq_pool_session_count(pool)
    if total > 0
        for i = 0 to total - 1
            if detect_pool_side(pool, ctx, pool_source_label, true, i, pool_source_id)
                found_pattern := true
            if detect_pool_side(pool, ctx, pool_source_label, false, i, pool_source_id)
                found_pattern := true
    found_pattern

// ─── Backfill Helpers ───
// Creates an unbreached PoolLevel from a historical H/L pair.
// Times set to na (backfilled levels have no intra-session timing data).
backfill_create_level(float h, float l) =>
    PoolLevel lvl = PoolLevel.new()
    lvl.session_high := h
    lvl.session_low := l
    lvl.high_time := int(na)
    lvl.low_time := int(na)
    lvl.session_close_time := int(na)
    lvl.high_breached := false
    lvl.low_breached := false
    lvl.high_used_by_pattern_1 := false
    lvl.high_used_by_pattern_2 := false
    lvl.high_used_by_pattern_3 := false
    lvl.low_used_by_pattern_1 := false
    lvl.low_used_by_pattern_2 := false
    lvl.low_used_by_pattern_3 := false
    lvl

// Injects a single H/L pair into a pool (oldest-first ordering).
// Guards against na values (insufficient history).
backfill_push_level(LiquidityPoolCollection pool, float h, float l) =>
    if not na(h) and not na(l)
        array.push(pool.levels, backfill_create_level(h, l))

// Recalculates all performance pointers after bulk injection.
backfill_recompute_pointers(LiquidityPoolCollection pool) =>
    pool.first_unbreached_high_index := 0
    pool.first_unbreached_low_index := 0
    liq_pool_advance_high_pointer(pool)
    liq_pool_advance_low_pointer(pool)
    liq_pool_recompute_min_unbreached_high(pool)
    liq_pool_recompute_max_unbreached_low(pool)

// Injects 20 sessions from a BackfillBatch20 into a pool (oldest-first).
backfill_inject_batch20(LiquidityPoolCollection pool, BackfillBatch20 b) =>
    backfill_push_level(pool, b.h1,  b.l1)
    backfill_push_level(pool, b.h2,  b.l2)
    backfill_push_level(pool, b.h3,  b.l3)
    backfill_push_level(pool, b.h4,  b.l4)
    backfill_push_level(pool, b.h5,  b.l5)
    backfill_push_level(pool, b.h6,  b.l6)
    backfill_push_level(pool, b.h7,  b.l7)
    backfill_push_level(pool, b.h8,  b.l8)
    backfill_push_level(pool, b.h9,  b.l9)
    backfill_push_level(pool, b.h10, b.l10)
    backfill_push_level(pool, b.h11, b.l11)
    backfill_push_level(pool, b.h12, b.l12)
    backfill_push_level(pool, b.h13, b.l13)
    backfill_push_level(pool, b.h14, b.l14)
    backfill_push_level(pool, b.h15, b.l15)
    backfill_push_level(pool, b.h16, b.l16)
    backfill_push_level(pool, b.h17, b.l17)
    backfill_push_level(pool, b.h18, b.l18)
    backfill_push_level(pool, b.h19, b.l19)
    backfill_push_level(pool, b.h20, b.l20)

// Injects 24 sessions from a BackfillBatch24 into a pool (oldest-first).
backfill_inject_batch24(LiquidityPoolCollection pool, BackfillBatch24 b) =>
    backfill_push_level(pool, b.h1,  b.l1)
    backfill_push_level(pool, b.h2,  b.l2)
    backfill_push_level(pool, b.h3,  b.l3)
    backfill_push_level(pool, b.h4,  b.l4)
    backfill_push_level(pool, b.h5,  b.l5)
    backfill_push_level(pool, b.h6,  b.l6)
    backfill_push_level(pool, b.h7,  b.l7)
    backfill_push_level(pool, b.h8,  b.l8)
    backfill_push_level(pool, b.h9,  b.l9)
    backfill_push_level(pool, b.h10, b.l10)
    backfill_push_level(pool, b.h11, b.l11)
    backfill_push_level(pool, b.h12, b.l12)
    backfill_push_level(pool, b.h13, b.l13)
    backfill_push_level(pool, b.h14, b.l14)
    backfill_push_level(pool, b.h15, b.l15)
    backfill_push_level(pool, b.h16, b.l16)
    backfill_push_level(pool, b.h17, b.l17)
    backfill_push_level(pool, b.h18, b.l18)
    backfill_push_level(pool, b.h19, b.l19)
    backfill_push_level(pool, b.h20, b.l20)
    backfill_push_level(pool, b.h21, b.l21)
    backfill_push_level(pool, b.h22, b.l22)
    backfill_push_level(pool, b.h23, b.l23)
    backfill_push_level(pool, b.h24, b.l24)

// ─── Backfill Batch Builder Functions ───
// Each returns a UDT populated with historical H/L from [offset..offset+N-1] lookback.
// Called inside request.security context at the appropriate timeframe.

// Build batch of sessions [start_offset .. start_offset+19] (oldest-first inside batch).
// start_offset = 1 means most recent closed bar, 21 means bars 21..40, etc.
build_backfill_batch20(int start_offset) =>
    BackfillBatch20.new(
      high[start_offset + 19], low[start_offset + 19],
      high[start_offset + 18], low[start_offset + 18],
      high[start_offset + 17], low[start_offset + 17],
      high[start_offset + 16], low[start_offset + 16],
      high[start_offset + 15], low[start_offset + 15],
      high[start_offset + 14], low[start_offset + 14],
      high[start_offset + 13], low[start_offset + 13],
      high[start_offset + 12], low[start_offset + 12],
      high[start_offset + 11], low[start_offset + 11],
      high[start_offset + 10], low[start_offset + 10],
      high[start_offset + 9],  low[start_offset + 9],
      high[start_offset + 8],  low[start_offset + 8],
      high[start_offset + 7],  low[start_offset + 7],
      high[start_offset + 6],  low[start_offset + 6],
      high[start_offset + 5],  low[start_offset + 5],
      high[start_offset + 4],  low[start_offset + 4],
      high[start_offset + 3],  low[start_offset + 3],
      high[start_offset + 2],  low[start_offset + 2],
      high[start_offset + 1],  low[start_offset + 1],
      high[start_offset + 0],  low[start_offset + 0])

// Build batch of sessions [start_offset .. start_offset+23] (oldest-first inside batch).
build_backfill_batch24(int start_offset) =>
    BackfillBatch24.new(
      high[start_offset + 23], low[start_offset + 23],
      high[start_offset + 22], low[start_offset + 22],
      high[start_offset + 21], low[start_offset + 21],
      high[start_offset + 20], low[start_offset + 20],
      high[start_offset + 19], low[start_offset + 19],
      high[start_offset + 18], low[start_offset + 18],
      high[start_offset + 17], low[start_offset + 17],
      high[start_offset + 16], low[start_offset + 16],
      high[start_offset + 15], low[start_offset + 15],
      high[start_offset + 14], low[start_offset + 14],
      high[start_offset + 13], low[start_offset + 13],
      high[start_offset + 12], low[start_offset + 12],
      high[start_offset + 11], low[start_offset + 11],
      high[start_offset + 10], low[start_offset + 10],
      high[start_offset + 9],  low[start_offset + 9],
      high[start_offset + 8],  low[start_offset + 8],
      high[start_offset + 7],  low[start_offset + 7],
      high[start_offset + 6],  low[start_offset + 6],
      high[start_offset + 5],  low[start_offset + 5],
      high[start_offset + 4],  low[start_offset + 4],
      high[start_offset + 3],  low[start_offset + 3],
      high[start_offset + 2],  low[start_offset + 2],
      high[start_offset + 1],  low[start_offset + 1],
      high[start_offset + 0],  low[start_offset + 0])

// ─── Liquidity Pool Instances ───
var LiquidityPoolCollection liq_daily_pool = liq_pool_create()
var LiquidityPoolCollection liq_weekly_pool = liq_pool_create()
var LiquidityPoolCollection liq_monthly_pool = liq_pool_create()
var LiquidityPoolCollection liq_4h_pool = liq_pool_create()
var LiquidityPoolCollection liq_1h_pool = liq_pool_create()

// Authoritative H/L from TradingView's native candle data.
// Eliminates chart-TF granularity mismatch: pool levels are identical on 5m, 15m, 1H, etc.
// Daily H/L override removed — exchange session boundary tracks natively from bar data.
[sec_weekly_high, sec_weekly_low] = request.security(syminfo.tickerid, "W", [high, low])
[sec_monthly_high, sec_monthly_low] = request.security(syminfo.tickerid, "M", [high, low])

// ─── Historical Backfill via request.security ───
// Daily: 3 calls x 20 sessions = 60 sessions (offsets 1-20, 21-40, 41-60)
// Weekly: 2 calls x 20 sessions = 40 sessions (offsets 1-20, 21-40)
// Monthly: 1 call x 24 sessions = 24 sessions (offsets 1-24)
// 4H and 1H: skipped (chart history covers enough)
// lookahead_on is safe because all data accessed via [N] offsets (closed bars only)
BackfillBatch20 bf_daily_1  = request.security(syminfo.tickerid, "D", build_backfill_batch20(1),  lookahead=barmerge.lookahead_on)
BackfillBatch20 bf_daily_2  = request.security(syminfo.tickerid, "D", build_backfill_batch20(21), lookahead=barmerge.lookahead_on)
BackfillBatch20 bf_daily_3  = request.security(syminfo.tickerid, "D", build_backfill_batch20(41), lookahead=barmerge.lookahead_on)
BackfillBatch20 bf_weekly_1 = request.security(syminfo.tickerid, "W", build_backfill_batch20(1),  lookahead=barmerge.lookahead_on)
BackfillBatch20 bf_weekly_2 = request.security(syminfo.tickerid, "W", build_backfill_batch20(21), lookahead=barmerge.lookahead_on)
BackfillBatch24 bf_monthly  = request.security(syminfo.tickerid, "M", build_backfill_batch24(1),  lookahead=barmerge.lookahead_on)

// Exchange session boundary: new daily session starts at 18:00 ET
// Sunday 18:00 = Monday's session start
// On daily+ timeframes: fall back to calendar day change (each bar = one session)
is_new_exchange_daily_session() =>
    prev_time = time[1]
    if na(prev_time)
        false
    else if timeframe.in_seconds() >= 86400
        dayofmonth(prev_time, NY_TIMEZONE) != dayofmonth(time, NY_TIMEZONE)
    else
        cur_hour = hour(time, NY_TIMEZONE)
        prev_hour = hour(prev_time, NY_TIMEZONE)
        cur_dow = dayofweek(time, NY_TIMEZONE)
        prev_dow = dayofweek(prev_time, NY_TIMEZONE)
        crossed_18 = (cur_hour >= EXCHANGE_SESSION_START_HOUR and prev_hour < EXCHANGE_SESSION_START_HOUR and cur_dow == prev_dow)
        day_changed = cur_dow != prev_dow and cur_hour >= EXCHANGE_SESSION_START_HOUR
        crossed_18 or day_changed

// ─── Liquidity Pool Per-Bar Tracking ───
// Shared session tracking: detects new sessions, finalizes the previous,
// resets/updates current extremes, and marks breaches.
// Returns true if any new breach was found (used for has_recent_breach gate).
liq_pool_track(LiquidityPoolCollection pool, bool is_new_session, int scan_cap) =>
    if is_new_session
        liq_pool_finalize_session(pool, nz(time[1], time), scan_cap)
        liq_pool_reset_current(pool, high, low, time)
    else
        liq_pool_update_current(pool, high, low, time)
    liq_pool_mark_breaches(pool, high, low, time)

// Process a complete HTF candle close for any context
// This is the master function that orchestrates all HTF processing
process_htf_close(HTFContext ctx, float htf_close) =>
    // Window management
    int window_start = get_window_start(ctx.htf_times)

    // Shift history and reset current candle
    shift_htf_history(ctx, htf_close)

    // Track window
    update_htf_times(ctx.htf_times, ctx.t1)

    // Gap detection
    detect_htf_gaps(ctx, window_start)

    // Cleanup
    cleanup_gaps(ctx.gap_array, window_start, MAX_FVGS)
    cleanup_zones(ctx.zone_array, window_start, MAX_ZONES)

    // Gap interactions (SIF detection)
    check_gap_interactions(ctx.gap_array, ctx.zone_array, ctx.o1, ctx.h1, ctx.l1, ctx.c1, ctx.t1, ctx.htf_label)

    // Invalidation check
    if enable_invalidation
        check_zone_invalidation(ctx.zone_array, ctx.o1, ctx.c1)

    // Gap-based MBZ formation check
    if enable_mbz and enable_gap_mbz
        array<MBZFormationMatch> mbz_matches = check_mbz_formation(ctx.gap_array, ctx.o2, ctx.h2, ctx.l2, ctx.c2, ctx.t2, ctx.o1, ctx.h1, ctx.l1, ctx.c1)
        int num_matches = array.size(mbz_matches)

        if num_matches > 0
            MBZFormationMatch first_match = array.get(mbz_matches, 0)
            bool mbz_bull = first_match.is_bullish

            if passes_direction_filter(mbz_bull)
                // Register MBZ in unified zone_array
                [zone, zone_idx, is_new] = get_or_create_zone(ctx.zone_array, bar_index, ctx.t1, ctx.o1, ctx.c1, ctx.h1, ctx.l1, mbz_bull, ctx.h2, ctx.l2, extend_to_wick, ctx.htf_label)

                zone.has_mbz := true
                zone.has_gap_mbz := true
                zone.ref_candle_high := ctx.h2
                zone.ref_candle_low := ctx.l2

                // If existing zone and wick extension enabled but not applied, recalculate
                if not is_new and extend_to_wick and not zone.is_wick_extended
                    [new_top, new_bottom, now_extended] = calculate_zone_boundaries(ctx.o1, ctx.c1, ctx.h1, ctx.l1, mbz_bull, zone.zone_subtype, ctx.h2, ctx.l2, extend_to_wick)
                    zone.zone_top := new_top
                    zone.zone_bottom := new_bottom
                    zone.is_wick_extended := now_extended

                // Add all MBZ source gaps
                for i = 0 to num_matches - 1
                    MBZFormationMatch match = array.get(mbz_matches, i)
                    add_source_to_zone(zone, match.source_gap_id, match.source_gap_type)

                array.set(ctx.zone_array, zone_idx, zone)

    // Liquidity pool MBZ detection
    if enable_liq_pools
        if enable_liq_daily
            detect_liq_pool_patterns(liq_daily_pool, ctx, POOL_SOURCE_DAILY, POOL_SOURCE_ID_DAILY)
        if enable_liq_weekly
            detect_liq_pool_patterns(liq_weekly_pool, ctx, POOL_SOURCE_WEEKLY, POOL_SOURCE_ID_WEEKLY)
        if enable_liq_monthly
            detect_liq_pool_patterns(liq_monthly_pool, ctx, POOL_SOURCE_MONTHLY, POOL_SOURCE_ID_MONTHLY)
        if enable_liq_4h
            detect_liq_pool_patterns(liq_4h_pool, ctx, POOL_SOURCE_4H, POOL_SOURCE_ID_4H)
        if enable_liq_1h
            detect_liq_pool_patterns(liq_1h_pool, ctx, POOL_SOURCE_1H, POOL_SOURCE_ID_1H)

// ═══════════════════════════════════════════════════════════════════════════════
// MAIN EXECUTION
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Historical Pool Backfill (runs once on first bar) ───
// Pre-populates daily/weekly/monthly pools with older sessions from request.security.
// Injected oldest-first so chronological ordering matches normal tracking.
// Levels start unbreached; mark_breaches handles naturally as bars progress.
// Backfill uses calendar-day D/W/M data from request.security — only valid in Exchange Session mode
// where the boundary closely aligns. Calendar Day mode tracks natively.
if barstate.isfirst and enable_pool_backfill and enable_liq_pools and use_exchange_session
    // Daily: 60 sessions (3 batches, oldest first)
    if enable_liq_daily
        backfill_inject_batch20(liq_daily_pool, bf_daily_3)
        backfill_inject_batch20(liq_daily_pool, bf_daily_2)
        backfill_inject_batch20(liq_daily_pool, bf_daily_1)
        backfill_recompute_pointers(liq_daily_pool)
    // Weekly: 40 sessions (2 batches, oldest first)
    if enable_liq_weekly
        backfill_inject_batch20(liq_weekly_pool, bf_weekly_2)
        backfill_inject_batch20(liq_weekly_pool, bf_weekly_1)
        backfill_recompute_pointers(liq_weekly_pool)
    // Monthly: 24 sessions (1 batch)
    if enable_liq_monthly
        backfill_inject_batch24(liq_monthly_pool, bf_monthly)
        backfill_recompute_pointers(liq_monthly_pool)

// ─── Liquidity Pool Tracking (MUST run BEFORE HTF close processing) ───
// Session boundary: barstate.isnew gated (matching Prime) — only finalize on new bar opens.
// Exchange Session mode: 18:00 ET boundary, Sunday 18:00 = Monday's session
// Calendar Day mode: midnight boundary, Sunday skip based on include_sunday_evening toggle
bool is_new_daily_session = barstate.isnew and not na(time[1]) and (use_exchange_session ? is_new_exchange_daily_session() : dayofmonth(time[1], NY_TIMEZONE) != dayofmonth(time, NY_TIMEZONE))
bool skip_sunday_liq = use_exchange_session ? false : (not is_247_asset and not include_sunday_evening and timeframe.in_seconds() < 86400 and dayofweek(time, NY_TIMEZONE) == dayofweek.sunday and hour(time, NY_TIMEZONE) >= SUNDAY_REOPEN_START_HOUR)
bool is_new_weekly_session = barstate.isnew and not na(time[1]) and weekofyear(time[1], NY_TIMEZONE) != weekofyear(time, NY_TIMEZONE)
bool is_new_monthly_session = barstate.isnew and not na(time[1]) and month(time[1], NY_TIMEZONE) != month(time, NY_TIMEZONE)
if enable_liq_pools and not skip_sunday_liq
    // Daily pool
    if enable_liq_daily
        liq_pool_track(liq_daily_pool, is_new_daily_session, LIQ_SCAN_CAP_DAILY)
    // Weekly pool
    if enable_liq_weekly
        if is_new_weekly_session and not na(sec_weekly_high[1]) and not na(sec_weekly_low[1])
            liq_weekly_pool.current_high := sec_weekly_high[1]
            liq_weekly_pool.current_low := sec_weekly_low[1]
        liq_pool_track(liq_weekly_pool, is_new_weekly_session, LIQ_SCAN_CAP_WEEKLY)
    // Monthly pool
    if enable_liq_monthly
        if is_new_monthly_session and not na(sec_monthly_high[1]) and not na(sec_monthly_low[1])
            liq_monthly_pool.current_high := sec_monthly_high[1]
            liq_monthly_pool.current_low := sec_monthly_low[1]
        liq_pool_track(liq_monthly_pool, is_new_monthly_session, LIQ_SCAN_CAP_MONTHLY)
    // 4H pool (sub-4H charts only)
    if enable_liq_4h and timeframe.in_seconds() < 14400
        bool is_new_4h_session = barstate.isnew and timeframe.change("240")
        liq_pool_track(liq_4h_pool, is_new_4h_session, LIQ_SCAN_CAP_4H)
    // 1H pool (sub-1H charts only)
    if enable_liq_1h and timeframe.in_seconds() < 3600
        bool is_new_1h_session = barstate.isnew and timeframe.change("60")
        liq_pool_track(liq_1h_pool, is_new_1h_session, LIQ_SCAN_CAP_1H)
if HTF1_VALID
    if new_htf1
        // ─── Process HTF1 Candle Close ───
        process_htf_close(htf1, close[1])

        // ─── Collect PO3 Mini Chart Data ───
        if show_po3_chart and htf1.t1 > 0
            po3_collect(po3_primary, htf1.o1, htf1.h1, htf1.l1, htf1.c1, htf1.t1)

        // ─── Create New Candle Boxes (ALWAYS create for MBZ highlighting) ───
        bool is_bull = close >= open
        // Wick box always created (for MBZ highlighting), invisible if overlay OFF
        color wick_bg = show_htf_candles ? (is_bull ? color.new(color.rgb(165, 214, 167), 85) : color.new(color.rgb(252, 203, 205), 80)) : color.new(color.white, 100)
        color wick_bdr = show_htf_candles ? (is_bull ? BULL_BORDER : BEAR_BORDER) : color.new(color.white, 100)
        wick_box := box.new(time, high, time, low, xloc=xloc.bar_time, border_color=wick_bdr, bgcolor=wick_bg, border_width=1, border_style=line.style_dashed)

        // Body box only if overlay ON
        if show_htf_candles
            body_box := box.new(time, math.max(open, close), time, math.min(open, close), xloc=xloc.bar_time, border_color=color.new(color.white, 100), bgcolor=is_bull ? color.new(color.rgb(165, 214, 167), 74) : color.new(color.rgb(244, 143, 177), 74), border_width=0)

            HTFCandle new_candle = HTFCandle.new()
            new_candle.wick := wick_box
            new_candle.body := body_box
            new_candle.start_time := time
            array.unshift(candle_boxes, new_candle)
            cleanup_candles()

    else
        // ─── Update Forming Candle ───
        htf1.curr_high := math.max(high, htf1.curr_high)
        htf1.curr_low  := math.min(low, htf1.curr_low)

        // Always update wick_box position (for MBZ highlighting)
        if not na(wick_box)
            bool is_bull = close >= htf1.curr_open
            box.set_top(wick_box, htf1.curr_high)
            box.set_bottom(wick_box, htf1.curr_low)
            box.set_right(wick_box, time)
            // Only set visual colors if overlay ON
            if show_htf_candles
                box.set_bgcolor(wick_box, is_bull ? color.new(color.rgb(165, 214, 167), 85) : color.new(color.rgb(252, 203, 205), 80))
                box.set_border_color(wick_box, is_bull ? BULL_BORDER : BEAR_BORDER)

        if show_htf_candles and not na(body_box)
            bool is_bull = close >= htf1.curr_open
            box.set_top(body_box, math.max(htf1.curr_open, close))
            box.set_bottom(body_box, math.min(htf1.curr_open, close))
            box.set_right(body_box, time)
            box.set_bgcolor(body_box, is_bull ? color.new(color.rgb(165, 214, 167), 74) : color.new(color.rgb(244, 143, 177), 74))

    // ─── FVG Updates (only for chart zone source tier — non-source tiers have no gap boxes) ───
    // Right-edge extension runs every bar; visibility/color toggling only on HTF boundary or last bar
    if gap_display_mode != GAP_DISPLAY_OFF and htf1.is_chart_source
        update_gap_positions(htf1.gap_array, htf1.zone_array, new_htf1 or barstate.islast)

    // ─── Live Invalidation (opening gap only — curr_open is constant within HTF candle) ───
    if enable_invalidation and new_htf1
        check_zone_invalidation_live(htf1.zone_array, htf1.curr_open)

// ─── HTF2 Processing ───
if HTF2_VALID
    if new_htf2
        process_htf_close(htf2, close[1])
        if show_po3_chart and htf2.t1 > 0
            po3_collect(po3_htf2, htf2.o1, htf2.h1, htf2.l1, htf2.c1, htf2.t1)
    else
        htf2.curr_high := math.max(high, htf2.curr_high)
        htf2.curr_low  := math.min(low, htf2.curr_low)
    if gap_display_mode != GAP_DISPLAY_OFF and htf2.is_chart_source
        update_gap_positions(htf2.gap_array, htf2.zone_array, new_htf2 or barstate.islast)
    if enable_invalidation and new_htf2
        check_zone_invalidation_live(htf2.zone_array, htf2.curr_open)

// ─── HTF3 Processing ───
if HTF3_VALID
    if new_htf3
        process_htf_close(htf3, close[1])
        if show_po3_chart and htf3.t1 > 0
            po3_collect(po3_htf3, htf3.o1, htf3.h1, htf3.l1, htf3.c1, htf3.t1)
    else
        htf3.curr_high := math.max(high, htf3.curr_high)
        htf3.curr_low  := math.min(low, htf3.curr_low)
    if gap_display_mode != GAP_DISPLAY_OFF and htf3.is_chart_source
        update_gap_positions(htf3.gap_array, htf3.zone_array, new_htf3 or barstate.islast)
    if enable_invalidation and new_htf3
        check_zone_invalidation_live(htf3.zone_array, htf3.curr_open)


// ═══════════════════════════════════════════════════════════════════════════════
// UNIFIED ZONE RENDERING
// ═══════════════════════════════════════════════════════════════════════════════


// ─── Same-Source Filter Helpers ───

// Build first-touch index map: for each gap_id, stores the oldest eligible zone index.
// eligible: pre-built map of zone indices that pass has_mbz, not invalidated, not live-invalidated, direction filter.
ss_build_first_touch(array<CandleZone> zone_arr, map<int, bool> eligible) =>
    map<int, int> ft = map.new<int, int>()
    for i = 0 to array.size(zone_arr) - 1
        if not map.contains(eligible, i)
            continue
        CandleZone z = array.get(zone_arr, i)
        if z.has_mbz and array.size(z.source_gap_ids) > 0
            int gid = array.get(z.source_gap_ids, 0)
            if gid >= 0
                map.put(ft, gid, i)
    ft

// Check if a zone should be hidden by same-source filter.
// Mutates seen_gaps for LATEST_TOUCH mode (marks gap_id as seen).
ss_should_hide(int zone_idx, int gap_id, map<int, bool> seen_gaps, map<int, int> first_touch_map) =>
    if gap_id < 0
        false
    else if same_source_filter == SAME_SOURCE_FILTER_ALL_TOUCHES
        false
    else if same_source_filter == SAME_SOURCE_FILTER_LATEST_TOUCH
        if map.contains(seen_gaps, gap_id)
            true
        else
            map.put(seen_gaps, gap_id, true)
            false
    else
        not map.contains(first_touch_map, gap_id) or map.get(first_touch_map, gap_id) != zone_idx

render_htf_zones(array<CandleZone> zone_arr, int htf_ms, float htf_curr_open) =>
    if array.size(zone_arr) == 0
        false
    else
        int zone_ext_width = zone_extension_bars * htf_ms

        // Same-Source filter tracking
        var map<int, bool> seen_gap_ids = map.new<int, bool>()
        map.clear(seen_gap_ids)

        // Pre-pass for FIRST TOUCH mode: build eligible map, then delegate to ss_build_first_touch
        var map<int, bool> ss_eligible = map.new<int, bool>()
        var map<int, int> first_touch_index_per_gap = map.new<int, int>()
        map.clear(ss_eligible)
        map.clear(first_touch_index_per_gap)
        if same_source_filter == SAME_SOURCE_FILTER_FIRST_TOUCH
            for zone_index = 0 to array.size(zone_arr) - 1
                CandleZone current_zone = array.get(zone_arr, zone_index)
                if not current_zone.has_mbz or current_zone.is_invalidated
                    continue
                bool live_inv = enable_invalidation and check_mbz_component_invalidation(current_zone, htf_curr_open, close)
                if not live_inv and passes_direction_filter(current_zone.is_bullish)
                    map.put(ss_eligible, zone_index, true)
            first_touch_index_per_gap := ss_build_first_touch(zone_arr, ss_eligible)

        // Pre-pass for Nearest Zone Extension (workspace mode)
        var map<int, bool> extend_to_current = map.new<int, bool>()
        map.clear(extend_to_current)

        if workspace_active and barstate.islast
            var array<float> bull_distances = array.new<float>()
            var array<int> bull_indices = array.new<int>()
            var array<float> bear_distances = array.new<float>()
            var array<int> bear_indices = array.new<int>()
            array.clear(bull_distances)
            array.clear(bull_indices)
            array.clear(bear_distances)
            array.clear(bear_indices)

            float current_price = close

            for zone_idx = 0 to array.size(zone_arr) - 1
                CandleZone z = array.get(zone_arr, zone_idx)
                if z.is_invalidated
                    continue
                if not z.has_mbz and not z.has_sif
                    continue
                if not passes_direction_filter(z.is_bullish)
                    continue
                bool visible = (enable_mbz and z.has_mbz) or (enable_sif and z.has_sif)
                if not visible
                    continue
                // Exclude VI-only zones from workspace extension if enabled
                if workspace_exclude_vi_only and is_vi_only_zone(z)
                    continue

                float dist = z.is_bullish ? math.abs(current_price - z.zone_top) : math.abs(current_price - z.zone_bottom)

                if z.is_bullish
                    array.push(bull_distances, dist)
                    array.push(bull_indices, zone_idx)
                else
                    array.push(bear_distances, dist)
                    array.push(bear_indices, zone_idx)

            // Select nearest N bullish zones
            if workspace_nearest_bull > 0 and array.size(bull_indices) > 0
                for n = 0 to math.min(workspace_nearest_bull, array.size(bull_indices)) - 1
                    float min_dist = 1e18
                    int min_idx = -1
                    int min_pos = -1
                    for j = 0 to array.size(bull_distances) - 1
                        if array.get(bull_distances, j) < min_dist
                            min_dist := array.get(bull_distances, j)
                            min_idx := array.get(bull_indices, j)
                            min_pos := j
                    if min_idx >= 0
                        map.put(extend_to_current, min_idx, true)
                        array.set(bull_distances, min_pos, 1e18)

            // Select nearest N bearish zones
            if workspace_nearest_bear > 0 and array.size(bear_indices) > 0
                for n = 0 to math.min(workspace_nearest_bear, array.size(bear_indices)) - 1
                    float min_dist = 1e18
                    int min_idx = -1
                    int min_pos = -1
                    for j = 0 to array.size(bear_distances) - 1
                        if array.get(bear_distances, j) < min_dist
                            min_dist := array.get(bear_distances, j)
                            min_idx := array.get(bear_indices, j)
                            min_pos := j
                    if min_idx >= 0
                        map.put(extend_to_current, min_idx, true)
                        array.set(bear_distances, min_pos, 1e18)

        // Main rendering loop
        for i = 0 to array.size(zone_arr) - 1
            CandleZone zone = array.get(zone_arr, i)

            if zone.is_invalidated
                continue

            if not zone.has_mbz and not zone.has_sif
                continue

            // PO3 zone filter: by default, main chart only shows zones from PO3 visible range
            // "Show All Chart Zones" disables this filter to reveal all detected zones
            if show_po3_chart and po3_limit_to_range and map.size(po3_visible_times) > 0
                bool in_po3_range = map.contains(po3_visible_times, zone.formation_time)
                bool po3_type_ok = (zone.has_mbz and enable_mbz and po3_show_mbz) or (zone.has_sif and enable_sif and po3_show_sif)
                if not in_po3_range or not po3_type_ok
                    delete_zone_visuals(zone)
                    array.set(zone_arr, i, zone)
                    continue

            // Live Invalidation Check (computed, not permanent)
            bool mbz_live_invalid = zone.has_mbz and enable_invalidation and check_mbz_component_invalidation(zone, htf_curr_open, close)
            bool sif_live_invalid = zone.has_sif and enable_invalidation and check_sif_component_invalidation(zone, htf_curr_open, close)

            bool mbz_active = enable_mbz and zone.has_mbz and show_mbz_on_chart
            bool sif_active = enable_sif and zone.has_sif and show_sif_on_chart
            bool all_live_invalidated = (not mbz_active or mbz_live_invalid) and (not sif_active or sif_live_invalid)

            if all_live_invalidated and (mbz_active or sif_active)
                delete_zone_visuals(zone)
                array.set(zone_arr, i, zone)
                continue

            // Direction filter
            if not passes_direction_filter(zone.is_bullish)
                delete_zone_visuals(zone)
                array.set(zone_arr, i, zone)
                continue

            // Engine visibility
            bool show_zone = (enable_mbz and zone.has_mbz and show_mbz_on_chart) or (enable_sif and zone.has_sif and show_sif_on_chart)
            if not show_zone
                delete_zone_visuals(zone)
                array.set(zone_arr, i, zone)
                continue

            // Same-Source filter (MBZ only, gap sources only — pool zones are independent)
            if zone.has_mbz and array.size(zone.source_gap_ids) > 0 and ss_should_hide(i, array.get(zone.source_gap_ids, 0), seen_gap_ids, first_touch_index_per_gap)
                delete_zone_visuals(zone)
                array.set(zone_arr, i, zone)
                continue

            bool should_extend_to_current = workspace_active and map.contains(extend_to_current, i)
            int stagger_hash = should_extend_to_current ? (zone.formation_time + int(zone.zone_top * STAGGER_PRICE_MULTIPLIER)) % STAGGER_MODULO : 0
            int stagger_offset_ms = stagger_hash * (htf_ms / STAGGER_DIVISOR)
            int normal_extension_right = zone.formation_time + zone_ext_width
            int zone_right_edge = should_extend_to_current ? math.max(time + stagger_offset_ms, normal_extension_right) : normal_extension_right

            // Faded opacity for non-extended zones in workspace mode
            bool is_faded = workspace_active and not should_extend_to_current
            color resolved_label_color = is_faded ? color.new(zone_label_color, WORKSPACE_FADE_OPACITY) : zone_label_color

            // Resolve fill/border colors: MBZ takes priority, then SIF
            bool use_mbz_colors = zone.has_mbz and enable_mbz
            color zone_fill = zone.is_bullish ? (use_mbz_colors ? mbz_fill_bull : sif_fill_bull) : (use_mbz_colors ? mbz_fill_bear : sif_fill_bear)
            color zone_bdr  = zone.is_bullish ? (use_mbz_colors ? mbz_border_bull : sif_border_bull) : (use_mbz_colors ? mbz_border_bear : sif_border_bear)
            color resolved_fill = is_faded ? color.new(zone_fill, 99) : zone_fill
            color resolved_border = is_faded ? color.new(zone_bdr, WORKSPACE_FADE_OPACITY) : zone_bdr

            if na(zone.zone_box)
                bool label_mbz = zone.has_mbz and enable_mbz and show_mbz_on_chart
                bool label_sif = zone.has_sif and enable_sif and show_sif_on_chart
                string zone_label_text = build_zone_label(zone, label_mbz, label_sif, htf_ms)
                zone.zone_box := box.new(zone.formation_time, zone.zone_top, zone_right_edge, zone.zone_bottom, xloc=xloc.bar_time, bgcolor=resolved_fill, border_color=resolved_border, border_width=zone_border_width, text=zone_label_text, text_color=resolved_label_color, text_size=ZONE_LABEL_SIZE_RESOLVED, text_halign=text.align_right, text_valign=text.align_center)

                // Validation boundary line
                int validation_time = zone.formation_time + htf_ms
                color vb_color = color.new(zone_bdr, VALIDATION_LINE_TRANS)
                zone.validation_line := line.new(validation_time, zone.zone_top, validation_time, zone.zone_bottom, xloc=xloc.bar_time, color=vb_color, width=VALIDATION_LINE_WIDTH, style=VALIDATION_LINE_STYLE)

                // Zone midline (50% level)
                if show_zone_midline
                    float mid = (zone.zone_top + zone.zone_bottom) / 2
                    zone.midline := line.new(zone.formation_time, mid, zone_right_edge, mid, xloc=xloc.bar_time, color=zone_midline_color, width=1, style=ZONE_MIDLINE_STYLE)

                array.set(zone_arr, i, zone)
            else
                // Update extension and opacity
                box.set_right(zone.zone_box, zone_right_edge)
                box.set_bgcolor(zone.zone_box, resolved_fill)
                box.set_border_color(zone.zone_box, resolved_border)
                box.set_text_color(zone.zone_box, resolved_label_color)
                // Update midline extension
                if not na(zone.midline)
                    line.set_x2(zone.midline, zone_right_edge)
        true

// Build PO3 visible times set (only on HTF boundary changes when data changes)
bool po3_times_need_rebuild = new_htf1 or new_htf2 or new_htf3 or map.size(po3_visible_times) == 0
if HTF1_VALID and show_chart_zones and show_po3_chart and po3_limit_to_range and barstate.islast and po3_times_need_rebuild
    map.clear(po3_visible_times)
    if chart_zone_source == CHART_SRC_TF2 and HTF2_VALID
        if array.size(po3_htf2.data) > 0
            for i = 0 to array.size(po3_htf2.data) - 1
                map.put(po3_visible_times, array.get(po3_htf2.data, i).t, true)
        if htf2.curr_time > 0
            map.put(po3_visible_times, htf2.curr_time, true)
    else if chart_zone_source == CHART_SRC_TF3 and HTF3_VALID
        if array.size(po3_htf3.data) > 0
            for i = 0 to array.size(po3_htf3.data) - 1
                map.put(po3_visible_times, array.get(po3_htf3.data, i).t, true)
        if htf3.curr_time > 0
            map.put(po3_visible_times, htf3.curr_time, true)
    else
        if array.size(po3_primary.data) > 0
            for i = 0 to array.size(po3_primary.data) - 1
                map.put(po3_visible_times, array.get(po3_primary.data, i).t, true)
        if htf1.curr_time > 0
            map.put(po3_visible_times, htf1.curr_time, true)

if HTF1_VALID
    // ─── Unified Zone Rendering (single tier based on chart zone source) ───
    // Only render on barstate.islast — historical HTF boundaries don't need visual updates
    if show_chart_zones and barstate.islast
        if chart_zone_source == CHART_SRC_TF2 and HTF2_VALID
            render_htf_zones(htf2.zone_array, HTF2_MS, htf2.curr_open)
        else if chart_zone_source == CHART_SRC_TF3 and HTF3_VALID
            render_htf_zones(htf3.zone_array, HTF3_MS, htf3.curr_open)
        else
            render_htf_zones(htf1.zone_array, HTF1_MS, htf1.curr_open)

// ═══════════════════════════════════════════════════════════════════════════════
// PO3 MINI CHART RENDERING
// ═══════════════════════════════════════════════════════════════════════════════

// Helper: build invalidation + same-source maps for a zone array, then highlight
po3_build_and_highlight(PO3Chart chart, array<CandleZone> zone_arr, float curr_open, int htf_ms) =>
    int zone_count = array.size(zone_arr)
    int confirmed_count = array.size(chart.data)
    var map<int, bool> inv_mbz = map.new<int, bool>()
    var map<int, bool> inv_sif = map.new<int, bool>()
    map.clear(inv_mbz)
    map.clear(inv_sif)
    if enable_invalidation and zone_count > 0
        for z_i = 0 to zone_count - 1
            CandleZone z = array.get(zone_arr, z_i)
            if not z.is_invalidated
                if z.has_mbz and check_mbz_component_invalidation(z, curr_open, close)
                    map.put(inv_mbz, z.formation_time, true)
                if z.has_sif and check_sif_component_invalidation(z, curr_open, close)
                    map.put(inv_sif, z.formation_time, true)

    // Build set of PO3 candle times (only zones matching these can render on PO3)
    var map<int, bool> po3_candle_times = map.new<int, bool>()
    map.clear(po3_candle_times)
    if confirmed_count > 0
        for c_i = 0 to confirmed_count - 1
            map.put(po3_candle_times, array.get(chart.data, c_i).t, true)

    var map<int, bool> ss_hidden = map.new<int, bool>()
    map.clear(ss_hidden)
    if same_source_filter != SAME_SOURCE_FILTER_ALL_TOUCHES and zone_count > 0
        // Build eligible map: zones that can render on PO3 (matching candle time, not invalidated, direction OK)
        var map<int, bool> po3_eligible = map.new<int, bool>()
        map.clear(po3_eligible)
        for z_j = 0 to zone_count - 1
            CandleZone zf = array.get(zone_arr, z_j)
            if zf.has_mbz and not zf.is_invalidated and map.contains(po3_candle_times, zf.formation_time) and not map.contains(inv_mbz, zf.formation_time) and passes_direction_filter(zf.is_bullish)
                map.put(po3_eligible, z_j, true)

        var map<int, bool> seen_gaps = map.new<int, bool>()
        map.clear(seen_gaps)
        map<int, int> first_touch = ss_build_first_touch(zone_arr, po3_eligible)

        for z_j = 0 to zone_count - 1
            if not map.contains(po3_eligible, z_j)
                continue
            CandleZone zf = array.get(zone_arr, z_j)
            if array.size(zf.source_gap_ids) > 0 and ss_should_hide(z_j, array.get(zf.source_gap_ids, 0), seen_gaps, first_touch)
                map.put(ss_hidden, z_j, true)
    po3_highlight_zones(chart, zone_arr, inv_mbz, inv_sif, htf_ms, ss_hidden)

// ─── PO3 Tier Rendering (script-scope helpers) ───

// Render a single PO3 tier: set offset, draw candles, highlight zones, draw FVGs, draw dividers
po3_render_tier(PO3Chart chart, float tier_open, float tier_high, float tier_low, float tier_close, int tier_time, array<CandleZone> zone_arr, int tier_ms, int offset_val) =>
    chart.offset := offset_val
    po3_render(chart, tier_open, tier_high, tier_low, tier_close, tier_time)
    if chart.show_mbz or chart.show_sif
        po3_build_and_highlight(chart, zone_arr, tier_open, tier_ms)
    if show_po3_fvgs
        po3_draw_fvgs(chart)
    if chart.show_dividers
        po3_draw_dividers(chart, tier_time)

// Width of a tier's PO3 section in bar units
po3_tier_width(int tier_id) =>
    tier_id == 2 ? (htf2_candle_count + 1) * 3 : tier_id == 3 ? (htf3_candle_count + 1) * 3 : (htf1_candle_count + 1) * 3

// Dispatch render by tier ID (1=Main, 2=HTF2, 3=HTF3)
po3_dispatch_tier(int tier_id, int offset_val) =>
    if tier_id == 1
        po3_render_tier(po3_primary, htf1.curr_open, htf1.curr_high, htf1.curr_low, close, htf1.curr_time, htf1.zone_array, HTF1_MS, offset_val)
    else if tier_id == 2
        po3_render_tier(po3_htf2, htf2.curr_open, htf2.curr_high, htf2.curr_low, close, htf2.curr_time, htf2.zone_array, HTF2_MS, offset_val)
    else if tier_id == 3
        po3_render_tier(po3_htf3, htf3.curr_open, htf3.curr_high, htf3.curr_low, close, htf3.curr_time, htf3.zone_array, HTF3_MS, offset_val)

if HTF1_VALID and show_po3_chart and barstate.islast and htf1.curr_open > 0
    // ─── Sort active tiers by ms ascending (smallest TF = leftmost) ───
    bool htf2_active = HTF2_VALID and htf2.curr_open > 0
    bool htf3_active = HTF3_VALID and htf3.curr_open > 0

    var array<int> sort_ms  = array.new<int>()
    var array<int> sort_ids = array.new<int>()
    array.clear(sort_ms)
    array.clear(sort_ids)

    array.push(sort_ms, HTF1_MS),  array.push(sort_ids, 1)
    if htf2_active
        array.push(sort_ms, HTF2_MS), array.push(sort_ids, 2)
    if htf3_active
        array.push(sort_ms, HTF3_MS), array.push(sort_ids, 3)

    // 3-element sorting network (compare-and-swap)
    int n = array.size(sort_ms)
    if n >= 2 and array.get(sort_ms, 0) > array.get(sort_ms, 1)
        int tmp_ms = array.get(sort_ms, 0)
        int tmp_id = array.get(sort_ids, 0)
        array.set(sort_ms, 0, array.get(sort_ms, 1))
        array.set(sort_ids, 0, array.get(sort_ids, 1))
        array.set(sort_ms, 1, tmp_ms)
        array.set(sort_ids, 1, tmp_id)
    if n >= 3
        if array.get(sort_ms, 1) > array.get(sort_ms, 2)
            int tmp_ms = array.get(sort_ms, 1)
            int tmp_id = array.get(sort_ids, 1)
            array.set(sort_ms, 1, array.get(sort_ms, 2))
            array.set(sort_ids, 1, array.get(sort_ids, 2))
            array.set(sort_ms, 2, tmp_ms)
            array.set(sort_ids, 2, tmp_id)
        if array.get(sort_ms, 0) > array.get(sort_ms, 1)
            int tmp_ms = array.get(sort_ms, 0)
            int tmp_id = array.get(sort_ids, 0)
            array.set(sort_ms, 0, array.get(sort_ms, 1))
            array.set(sort_ids, 0, array.get(sort_ids, 1))
            array.set(sort_ms, 1, tmp_ms)
            array.set(sort_ids, 1, tmp_id)

    // ─── Layout and render tiers in sorted order ───
    if po3_is_overlay
        // Overlay: Main at actual time, others at po3_offset sorted left→right
        int overlay_cursor = po3_offset
        for i = 0 to n - 1
            int tid = array.get(sort_ids, i)
            if tid != 1
                po3_dispatch_tier(tid, overlay_cursor)
                overlay_cursor := overlay_cursor + po3_tier_width(tid) + po3_gap
        po3_dispatch_tier(1, po3_primary.offset)
    else
        // Right mode: render all tiers left→right sorted by TF size
        int cursor = po3_offset
        for i = 0 to n - 1
            int tid = array.get(sort_ids, i)
            po3_dispatch_tier(tid, cursor)
            cursor := cursor + po3_tier_width(tid) + po3_gap

    // ─── Align labels across all tiers ───
    if po3_align_labels and show_po3_label
        float align_y = na
        if po3_label_bottom
            align_y := po3_primary.lowest_point
            if htf2_active
                align_y := math.min(align_y, po3_htf2.lowest_point)
            if htf3_active
                align_y := math.min(align_y, po3_htf3.lowest_point)
        else
            align_y := po3_primary.highest_point
            if htf2_active
                align_y := math.max(align_y, po3_htf2.highest_point)
            if htf3_active
                align_y := math.max(align_y, po3_htf3.highest_point)
        if not na(po3_primary.tf_label)
            label.set_y(po3_primary.tf_label, align_y)
        if htf2_active and not na(po3_htf2.tf_label)
            label.set_y(po3_htf2.tf_label, align_y)
        if htf3_active and not na(po3_htf3.tf_label)
            label.set_y(po3_htf3.tf_label, align_y)

// ═══════════════════════════════════════════════════════════════════════════════
// STATUS TABLE
// ═══════════════════════════════════════════════════════════════════════════════

if HTF1_VALID and show_status_table and barstate.islast
    var table status_table = table.new(position.bottom_center, 4, 1, border_width=0)

    // Calculate padding for offset
    string left_pad = status_table_offset < 0 ? "" : str.repeat(" ", status_table_offset * 3)
    string right_pad = status_table_offset > 0 ? "" : str.repeat(" ", math.abs(status_table_offset) * 3)

    // Left padding cell
    table.cell(status_table, 0, 0, left_pad, bgcolor=color.new(color.white, 100), text_size=size.tiny)

    // Title cell: white tex\t on black background
    table.cell(status_table, 1, 0, "relay •", bgcolor=color.black, text_color=color.white, text_size=size.tiny)

    // Build status text: TF mapping + enabled gap sources + ref wick indicator
    // Show "all" when all gap sources are enabled
    string gap_type_display = ""
    if enable_fvg and enable_implied and enable_volume
        gap_type_display := STATUS_DISPLAY_ALL
    else
        var array<string> gap_parts = array.new<string>()
        array.clear(gap_parts)
        if enable_fvg
            array.push(gap_parts, STATUS_DISPLAY_FVG)
        if enable_implied
            array.push(gap_parts, STATUS_DISPLAY_IMP)
        if enable_volume
            array.push(gap_parts, STATUS_DISPLAY_VOL)
        gap_type_display := array.size(gap_parts) > 0 ? array.join(gap_parts, "·") : "none"
    string wick_ext_display = extend_to_wick ? "  " + STATUS_DISPLAY_WICK_EXT : ""
    string workspace_display = workspace_active ? "  WS" : ""

    // Build invalidation threshold display
    string mbz_inv_display = switch invalidation_mode
        MBZ_INVALIDATION_STANDARD     => STATUS_DISPLAY_MBZ_STD
        MBZ_INVALIDATION_CONSERVATIVE => STATUS_DISPLAY_MBZ_CON
        MBZ_INVALIDATION_STRICT       => STATUS_DISPLAY_MBZ_STR
        => "[" + str.tostring(int(custom_threshold_percent)) + "]"
    string sif_inv_display = switch sif_invalidation_mode
        SIF_INVALIDATION_STRICT  => STATUS_DISPLAY_SIF_STR
        SIF_INVALIDATION_LENIENT => STATUS_DISPLAY_SIF_LEN
        => "[" + str.tostring(int(sif_custom_threshold_percent)) + "]"
    string inv_display = "  " + mbz_inv_display + " " + sif_inv_display

    // Build timeframe mapping display
    string tf_display = LTF_LABEL + " → " + HTF1_LABEL
    if chart_zone_source == CHART_SRC_TF2 and HTF2_VALID
        tf_display := LTF_LABEL + " → " + HTF2_LABEL
    else if chart_zone_source == CHART_SRC_TF3 and HTF3_VALID
        tf_display := LTF_LABEL + " → " + HTF3_LABEL

    string status_text = tf_display + "  " + gap_type_display + inv_display + wick_ext_display + workspace_display
    table.cell(status_table, 2, 0, status_text, bgcolor=color.new(color.rgb(245, 245, 245), 20), text_color=color.black, text_size=size.tiny)

    // Right padding cell
    table.cell(status_table, 3, 0, right_pad, bgcolor=color.new(color.white, 100), text_size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE
// ═══════════════════════════════════════════════════════════════════════════════

addColorRow(table tbl, int row, string name, color clr) =>
    table.cell(tbl, 0, row, name, text_size=size.small, text_color=color.black)
    table.cell(tbl, 1, row, str.format("R:{0} G:{1} B:{2}", int(color.r(clr)), int(color.g(clr)), int(color.b(clr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 2, row, str.tostring(int(color.t(clr))), text_size=size.small, text_color=color.black)

// ─── Pool Debug Table ───
if show_pool_debug and barstate.islast
    int d_count = liq_pool_session_count(liq_daily_pool)
    int w_count = liq_pool_session_count(liq_weekly_pool)
    int m_count = liq_pool_session_count(liq_monthly_pool)
    int h4_count = liq_pool_session_count(liq_4h_pool)
    int h1_count = liq_pool_session_count(liq_1h_pool)

    // Count breached levels per pool
    int d_h_breached = 0
    int d_l_breached = 0
    if d_count > 0
        for i = 0 to d_count - 1
            PoolLevel lvl = array.get(liq_daily_pool.levels, i)
            if lvl.high_breached
                d_h_breached += 1
            if lvl.low_breached
                d_l_breached += 1

    var table pool_tbl = table.new(position.bottom_left, 6, 7, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)

    // Header
    table.cell(pool_tbl, 0, 0, "Pool", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.gray, 30))
    table.cell(pool_tbl, 1, 0, "Count", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.gray, 30))
    table.cell(pool_tbl, 2, 0, "Newest H", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.gray, 30))
    table.cell(pool_tbl, 3, 0, "Newest L", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.gray, 30))
    table.cell(pool_tbl, 4, 0, "Oldest H", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.gray, 30))
    table.cell(pool_tbl, 5, 0, "Oldest L", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.gray, 30))

    // Pool rows — inline since Pine doesn't allow function declarations inside if blocks
    array<LiquidityPoolCollection> debug_pools = array.from(liq_daily_pool, liq_weekly_pool, liq_monthly_pool, liq_4h_pool, liq_1h_pool)
    array<string> debug_names = array.from("Daily", "Weekly", "Monthly", "4H", "1H")
    for r = 0 to 4
        LiquidityPoolCollection p = array.get(debug_pools, r)
        int cnt = liq_pool_session_count(p)
        table.cell(pool_tbl, 0, r + 1, array.get(debug_names, r), text_color=color.white, text_size=size.tiny)
        table.cell(pool_tbl, 1, r + 1, str.tostring(cnt), text_color=color.white, text_size=size.tiny)
        if cnt > 0
            PoolLevel newest = array.get(p.levels, cnt - 1)
            PoolLevel oldest = array.get(p.levels, 0)
            table.cell(pool_tbl, 2, r + 1, str.tostring(newest.session_high, "#.##"), text_color=color.white, text_size=size.tiny)
            table.cell(pool_tbl, 3, r + 1, str.tostring(newest.session_low, "#.##"), text_color=color.white, text_size=size.tiny)
            table.cell(pool_tbl, 4, r + 1, str.tostring(oldest.session_high, "#.##"), text_color=color.white, text_size=size.tiny)
            table.cell(pool_tbl, 5, r + 1, str.tostring(oldest.session_low, "#.##"), text_color=color.white, text_size=size.tiny)
        else
            table.cell(pool_tbl, 2, r + 1, "-", text_color=color.gray, text_size=size.tiny)
            table.cell(pool_tbl, 3, r + 1, "-", text_color=color.gray, text_size=size.tiny)
            table.cell(pool_tbl, 4, r + 1, "-", text_color=color.gray, text_size=size.tiny)
            table.cell(pool_tbl, 5, r + 1, "-", text_color=color.gray, text_size=size.tiny)

    // Backfill status row
    table.cell(pool_tbl, 0, 6, "Backfill", text_color=color.yellow, text_size=size.tiny)
    table.cell(pool_tbl, 1, 6, enable_pool_backfill ? "ON" : "OFF", text_color=enable_pool_backfill ? color.lime : color.red, text_size=size.tiny)
    table.cell(pool_tbl, 2, 6, "D:" + str.tostring(d_h_breached) + "H/" + str.tostring(d_l_breached) + "L breached", text_color=color.yellow, text_size=size.tiny)

    // Daily detail table: last 10 sessions with H/L and breach state
    int show_count = math.min(d_count, 10)
    if show_count > 0
        var table daily_tbl = table.new(position.bottom_right, 9, 12, bgcolor=color.white, border_width=1, border_color=color.gray)
        table.cell(daily_tbl, 0, 0, "#",       text_color=color.black, text_size=size.small, bgcolor=color.new(color.gray, 70))
        table.cell(daily_tbl, 1, 0, "Close",   text_color=color.black, text_size=size.small, bgcolor=color.new(color.gray, 70))
        table.cell(daily_tbl, 2, 0, "High",    text_color=color.black, text_size=size.small, bgcolor=color.new(color.gray, 70))
        table.cell(daily_tbl, 3, 0, "H date",  text_color=color.black, text_size=size.small, bgcolor=color.new(color.gray, 70))
        table.cell(daily_tbl, 4, 0, "Low",     text_color=color.black, text_size=size.small, bgcolor=color.new(color.gray, 70))
        table.cell(daily_tbl, 5, 0, "L date",  text_color=color.black, text_size=size.small, bgcolor=color.new(color.gray, 70))
        table.cell(daily_tbl, 6, 0, "H br",    text_color=color.black, text_size=size.small, bgcolor=color.new(color.gray, 70))
        table.cell(daily_tbl, 7, 0, "L br",    text_color=color.black, text_size=size.small, bgcolor=color.new(color.gray, 70))
        table.cell(daily_tbl, 8, 0, "Count",   text_color=color.black, text_size=size.small, bgcolor=color.new(color.gray, 70))
        for i = 0 to show_count - 1
            int idx = d_count - 1 - i
            PoolLevel dlvl = array.get(liq_daily_pool.levels, idx)
            string close_str = na(dlvl.session_close_time) ? "bf" : str.tostring(month(dlvl.session_close_time, NY_TIMEZONE)) + "/" + str.tostring(dayofmonth(dlvl.session_close_time, NY_TIMEZONE))
            string h_date = na(dlvl.high_time) ? "bf" : str.tostring(month(dlvl.high_time, NY_TIMEZONE)) + "/" + str.tostring(dayofmonth(dlvl.high_time, NY_TIMEZONE)) + " " + str.tostring(hour(dlvl.high_time, NY_TIMEZONE)) + ":" + (minute(dlvl.high_time, NY_TIMEZONE) < 10 ? "0" : "") + str.tostring(minute(dlvl.high_time, NY_TIMEZONE))
            string l_date = na(dlvl.low_time) ? "bf" : str.tostring(month(dlvl.low_time, NY_TIMEZONE)) + "/" + str.tostring(dayofmonth(dlvl.low_time, NY_TIMEZONE)) + " " + str.tostring(hour(dlvl.low_time, NY_TIMEZONE)) + ":" + (minute(dlvl.low_time, NY_TIMEZONE) < 10 ? "0" : "") + str.tostring(minute(dlvl.low_time, NY_TIMEZONE))
            bool is_bf = na(dlvl.session_close_time)
            table.cell(daily_tbl, 0, i + 1, str.tostring(i + 1), text_color=color.black, text_size=size.small)
            table.cell(daily_tbl, 1, i + 1, close_str, text_color=is_bf ? color.gray : color.black, text_size=size.small)
            table.cell(daily_tbl, 2, i + 1, str.tostring(dlvl.session_high, "#.##"), text_color=color.black, text_size=size.small)
            table.cell(daily_tbl, 3, i + 1, h_date, text_color=is_bf ? color.gray : color.black, text_size=size.small)
            table.cell(daily_tbl, 4, i + 1, str.tostring(dlvl.session_low, "#.##"), text_color=color.black, text_size=size.small)
            table.cell(daily_tbl, 5, i + 1, l_date, text_color=is_bf ? color.gray : color.black, text_size=size.small)
            table.cell(daily_tbl, 6, i + 1, dlvl.high_breached ? "Y" : "N", text_color=dlvl.high_breached ? color.red : color.green, text_size=size.small)
            table.cell(daily_tbl, 7, i + 1, dlvl.low_breached ? "Y" : "N", text_color=dlvl.low_breached ? color.red : color.green, text_size=size.small)
            table.cell(daily_tbl, 8, i + 1, str.tostring(d_count), text_color=color.gray, text_size=size.small)
        table.cell(daily_tbl, 0, show_count + 1, "Relay Daily", text_color=color.blue, text_size=size.small)
        table.cell(daily_tbl, 1, show_count + 1, "1=newest", text_color=color.gray, text_size=size.small)
        table.cell(daily_tbl, 2, show_count + 1, "bf=backfill", text_color=color.gray, text_size=size.small)
        table.cell(daily_tbl, 3, show_count + 1, effective_daily_boundary, text_color=color.gray, text_size=size.small)

if show_color_table and barstate.islast
    var table color_table = table.new(position.top_right, 3, 34, bgcolor=color.white, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

    table.cell(color_table, 0, 0, "Setting", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(color_table, 1, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(color_table, 2, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)

    int row = 1
    addColorRow(color_table, row, "MBZ Fill +", mbz_fill_bull)
    row += 1
    addColorRow(color_table, row, "MBZ Fill −", mbz_fill_bear)
    row += 1
    addColorRow(color_table, row, "MBZ Border +", mbz_border_bull)
    row += 1
    addColorRow(color_table, row, "MBZ Border −", mbz_border_bear)
    row += 1
    addColorRow(color_table, row, "SIF Fill +", sif_fill_bull)
    row += 1
    addColorRow(color_table, row, "SIF Fill −", sif_fill_bear)
    row += 1
    addColorRow(color_table, row, "SIF Border +", sif_border_bull)
    row += 1
    addColorRow(color_table, row, "SIF Border −", sif_border_bear)
    row += 1
    addColorRow(color_table, row, "Zone Label", zone_label_color)
    row += 1
    addColorRow(color_table, row, "PO3 + Body", po3_bull_body)
    row += 1
    addColorRow(color_table, row, "PO3 + Border", po3_bull_border)
    row += 1
    addColorRow(color_table, row, "PO3 + Wick", po3_bull_wick)
    row += 1
    addColorRow(color_table, row, "PO3 − Body", po3_bear_body)
    row += 1
    addColorRow(color_table, row, "PO3 − Border", po3_bear_border)
    row += 1
    addColorRow(color_table, row, "PO3 − Wick", po3_bear_wick)
    row += 1
    addColorRow(color_table, row, "PO3 Label", po3_label_color)
    row += 1
    addColorRow(color_table, row, "PO3 Divider", po3_divider_color)
    row += 1
    addColorRow(color_table, row, "PO3 MBZ +", po3_mbz_bull_highlight)
    row += 1
    addColorRow(color_table, row, "PO3 MBZ −", po3_mbz_bear_highlight)
    row += 1
    addColorRow(color_table, row, "PO3 SIF +", po3_sif_bull_highlight)
    row += 1
    addColorRow(color_table, row, "PO3 SIF −", po3_sif_bear_highlight)
    row += 1
    addColorRow(color_table, row, "PO3 MBZ Zone +", po3_mbz_zone_bull)
    row += 1
    addColorRow(color_table, row, "PO3 MBZ Zone −", po3_mbz_zone_bear)
    row += 1
    addColorRow(color_table, row, "PO3 SIF Zone +", po3_sif_zone_bull)
    row += 1
    addColorRow(color_table, row, "PO3 SIF Zone −", po3_sif_zone_bear)
    row += 1
    addColorRow(color_table, row, "PO3 MBZ Lbl +", po3_mbz_label_color)
    row += 1
    addColorRow(color_table, row, "PO3 MBZ Lbl −", po3_mbz_label_bear)
    row += 1
    addColorRow(color_table, row, "PO3 SIF Lbl +", po3_sif_label_color)
    row += 1
    addColorRow(color_table, row, "PO3 SIF Lbl −", po3_sif_label_bear)
    row += 1
    addColorRow(color_table, row, "PO3 Midline", po3_midline_color)
    row += 1
    addColorRow(color_table, row, "Zone Midline", zone_midline_color)
    row += 1
    addColorRow(color_table, row, "PO3 FVG +", po3_fvg_bull_color)
    row += 1
    addColorRow(color_table, row, "PO3 FVG −", po3_fvg_bear_color)

