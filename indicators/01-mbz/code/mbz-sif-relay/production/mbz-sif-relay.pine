const string HTF_SLOT_1 = "1"
const string HTF_SLOT_2 = "2"
const string HTF_SLOT_3 = "3"
const string HTF_SLOT_4 = "4"

get_tf_pairing(string chart_tf, string slot) =>
    if slot == HTF_SLOT_1
        switch chart_tf
            "30S" => [true, "5",   "5m",  TF_5M_MS,  "30s"]
            "1"   => [true, "15",  "15m", TF_15M_MS, "1m"]
            "2"   => [true, "30",  "30m", TF_30M_MS, "2m"]
            "3"   => [true, "30",  "30m", TF_30M_MS, "3m"]
            "4"   => [true, "30",  "30m", TF_30M_MS, "4m"]
            "5"   => [true, "60",  "1H",  TF_1H_MS,  "5m"]
            "10"  => [true, "60",  "1H",  TF_1H_MS,  "10m"]
            "15"  => [true, "240", "4H",  TF_4H_MS,  "15m"]
            "30"  => [true, "240", "4H",  TF_4H_MS,  "30m"]
            "45"  => [true, "240", "4H",  TF_4H_MS,  "45m"]
            "60"  => [true, "D",   "D",   TF_D_MS,   "1H"]
            "120" => [true, "D",   "D",   TF_D_MS,   "2H"]
            "180" => [true, "D",   "D",   TF_D_MS,   "3H"]
            "240" => [true, "D",   "D",   TF_D_MS,   "4H"]
            "1D"  => [true, "W",   "W",   TF_W_MS,   "D"]
            "1W"  => [true, "M",   "1Mo", TF_M_MS,   "W"]
            =>       [false, "",   "",    0,         ""]
    else if slot == HTF_SLOT_2
        switch chart_tf
            "30S" => [true, "1",   "1m",  TF_1M_MS,  "30s"]
            "1"   => [true, "5",   "5m",  TF_5M_MS,  "1m"]
            "2"   => [true, "5",   "5m",  TF_5M_MS,  "2m"]
            "3"   => [true, "15",  "15m", TF_15M_MS, "3m"]
            "4"   => [true, "15",  "15m", TF_15M_MS, "4m"]
            "5"   => [true, "15",  "15m", TF_15M_MS, "5m"]
            "10"  => [true, "30",  "30m", TF_30M_MS, "10m"]
            "15"  => [true, "60",  "1H",  TF_1H_MS,  "15m"]
            "30"  => [true, "60",  "1H",  TF_1H_MS,  "30m"]
            "45"  => [true, "60",  "1H",  TF_1H_MS,  "45m"]
            "60"  => [true, "240", "4H",  TF_4H_MS,  "1H"]
            "120" => [true, "240", "4H",  TF_4H_MS,  "2H"]
            "180" => [true, "240", "4H",  TF_4H_MS,  "3H"]
            "240" => [true, "W",   "W",   TF_W_MS,   "4H"]
            "1D"  => [true, "M",   "1Mo", TF_M_MS,   "D"]
            "1W"  => [true, "3M",  "3Mo", TF_3M_MS,  "W"]
            =>       [false, "",   "",    0,         ""]
    else if slot == HTF_SLOT_3
        switch chart_tf
            "30S" => [true, "15",  "15m", TF_15M_MS, "30s"]
            "1"   => [true, "60",  "1H",  TF_1H_MS,  "1m"]
            "2"   => [true, "60",  "1H",  TF_1H_MS,  "2m"]
            "3"   => [true, "60",  "1H",  TF_1H_MS,  "3m"]
            "4"   => [true, "60",  "1H",  TF_1H_MS,  "4m"]
            "5"   => [true, "240", "4H",  TF_4H_MS,  "5m"]
            "10"  => [true, "240", "4H",  TF_4H_MS,  "10m"]
            "15"  => [true, "D",   "D",   TF_D_MS,   "15m"]
            "30"  => [true, "D",   "D",   TF_D_MS,   "30m"]
            "45"  => [true, "D",   "D",   TF_D_MS,   "45m"]
            "60"  => [true, "W",   "W",   TF_W_MS,   "1H"]
            "120" => [true, "W",   "W",   TF_W_MS,   "2H"]
            "180" => [true, "W",   "W",   TF_W_MS,   "3H"]
            "240" => [true, "M",   "1Mo", TF_M_MS,   "4H"]
            "1D"  => [true, "3M",  "3Mo", TF_3M_MS,  "D"]
            =>       [false, "",   "",    0,         ""]
    else if slot == HTF_SLOT_4
        switch chart_tf
            "30S" => [true, "60",  "1H",  TF_1H_MS,  "30s"]
            "1"   => [true, "240", "4H",  TF_4H_MS,  "1m"]
            "2"   => [true, "240", "4H",  TF_4H_MS,  "2m"]
            "3"   => [true, "240", "4H",  TF_4H_MS,  "3m"]
            "4"   => [true, "240", "4H",  TF_4H_MS,  "4m"]
            "5"   => [true, "D",   "D",   TF_D_MS,   "5m"]
            "10"  => [true, "D",   "D",   TF_D_MS,   "10m"]
            "15"  => [true, "W",   "W",   TF_W_MS,   "15m"]
            "30"  => [true, "W",   "W",   TF_W_MS,   "30m"]
            "45"  => [true, "W",   "W",   TF_W_MS,   "45m"]
            "60"  => [true, "M",   "1Mo", TF_M_MS,   "1H"]
            "120" => [true, "M",   "1Mo", TF_M_MS,   "2H"]
            "180" => [true, "M",   "1Mo", TF_M_MS,   "3H"]
            "240" => [true, "3M",  "3Mo", TF_3M_MS,  "4H"]
            =>       [false, "",   "",    0,         ""]
    else
        [false, "", "", 0, ""]

string CHART_TF = timeframe.period
[HTF1_AUTO_VALID, HTF1_AUTO_STRING, HTF1_AUTO_LABEL, HTF1_AUTO_MS, LTF_LABEL] = get_tf_pairing(CHART_TF, HTF_SLOT_1)

get_tf_display_label(string tf) =>
    int secs = timeframe.in_seconds(tf)
    if secs < 60
        str.tostring(secs) + "s"
    else if secs < 3600
        str.tostring(secs / 60) + "m"
    else if secs < 86400
        str.tostring(secs / 3600) + "H"
    else if secs < 604800
        "D"
    else if secs < 2592000
        "W"
    else if secs < 7776000
        "1Mo"
    else
        "3Mo"

