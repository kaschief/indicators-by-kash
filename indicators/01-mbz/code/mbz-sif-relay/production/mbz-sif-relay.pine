zone_extension_bars = input.int(4, "Extend", minval=1, maxval=20, group=GROUP_CHART_ZONES, inline="zone_shared")
zone_label_color   = input.color(DEFAULT_ZONE_LABEL_COLOR, "Zone Label", group=GROUP_CHART_ZONES, inline="lbl")
zone_label_size    = input.string("Small", "", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=GROUP_CHART_ZONES, inline="lbl")
