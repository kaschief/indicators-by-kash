//@version=6

// ═══════════════════════════════════════════════════════════════════════════════
// MBZ SIF RELAY
// ═══════════════════════════════════════════════════════════════════════════════
// Multi-timeframe MBZ + SIF detection with automatic timeframe pairing:
//   30s chart → 5m  HTF
//   1m  chart → 15m HTF
//   2m  chart → 30m HTF
//   3m  chart → 30m HTF
//   5m  chart → 1H  HTF
//   15m chart → 4H  HTF
//   1H  chart → D   HTF
//   4H  chart → D   HTF
// ═══════════════════════════════════════════════════════════════════════════════

indicator("mbz sif relay •", shorttitle="relay •", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

// Zone color defaults
const color DEFAULT_ZONE_BULL_COLOR = color.rgb(77, 208, 225)   // Cyan/teal
const color DEFAULT_ZONE_BEAR_COLOR = color.rgb(249, 121, 246)  // Pink/magenta
const int   PREVIEW_FILL_TRANSPARENCY = 94  // Slightly more visible for preview zones

// Inversion highlight colors (direction-aware by CANDLE that inverts, not gap)
const color INVERSION_BEARISH_CANDLE_COLOR = color.rgb(239, 83, 80)   // Red (bearish candle closes through bullish gap)
const color INVERSION_BULLISH_CANDLE_COLOR = color.rgb(38, 166, 154)  // Green (bullish candle closes through bearish gap)

// First tapper highlight colors (direction-aware by CANDLE color, not gap)
const color TAP_BULLISH_CANDLE_COLOR = color.rgb(77, 208, 225)   // Cyan (bullish candle tapping bearish gap)
const color TAP_BEARISH_CANDLE_COLOR = color.rgb(249, 121, 246)  // Pink (bearish candle tapping bullish gap)

// Development flag: suppress MBZ plotting to isolate inversion testing
// (Now controlled via UI input in Development group)

// Drawing budget
const int DRAW_LIMIT = 500
const int DRAW_BUFFER = 20  // Reserve for test zones, warnings, etc.

// Gap type constants
const string GAP_TYPE_FVG     = "fvg"
const string GAP_TYPE_IMPLIED = "implied"
const string GAP_TYPE_VOLUME  = "volume"

// Status display constants
const string STATUS_DISPLAY_ALL = "all"
const string STATUS_DISPLAY_FVG = "fvg"
const string STATUS_DISPLAY_IMP = "imp"
const string STATUS_DISPLAY_VOL = "vol"
const string STATUS_DISPLAY_REF_WICK = "⁺ʷ"

// MBZ subtype constants
const string SUBTYPE_STANDARD   = "standard"
const string SUBTYPE_INCLUSION  = "inclusion"
const string SUBTYPE_REFLECTION = "reflection"

// Same-Source filter constants
const string SAME_SOURCE_FILTER_ALL_TOUCHES = "All"
const string SAME_SOURCE_FILTER_FIRST_TOUCH = "First Touch"
const string SAME_SOURCE_FILTER_LATEST_TOUCH = "Latest Touch"

// MBZ label constants
const string MBZ_BASE_TEXT     = "MBZ"
const string MBZ_BULLISH_SUFFIX = "⁺"
const string MBZ_BEARISH_SUFFIX = "⁻"

// SIF label text constants
const string SIF_MBZ_COMBINED_BOLD = "𝗠𝗕𝗭·𝗦𝗜𝗙"
const string SIF_LABEL             = "SIF"

// Gap source display text for labels
const string GAP_SOURCE_FVG_BREAKDOWN_DISPLAY = "fvg"
const string GAP_SOURCE_IMPLIED_DISPLAY = "imp"
const string GAP_SOURCE_VOLUME_DISPLAY  = "vol"

// Consolidated label formatting
const string MULTIPLIER_SYMBOL = "×"
const string COUNT_SEPARATOR = ": "
const string BREAKDOWN_SEPARATOR = ", "

// Wick dominance threshold (wick must be >= 80% of body)
const float WICK_DOMINANCE_THRESHOLD = 0.80

// Breakaway detection
const int    BREAKAWAY_LENGTH = 20
const string LABEL_PREFIX_BREAKAWAY = "BRK-"

// ═══════════════════════════════════════════════════════════════════════════════
// INVALIDATION THRESHOLDS (Edit these values to adjust invalidation sensitivity)
// ═══════════════════════════════════════════════════════════════════════════════
// MBZ Thresholds: % of zone that must be penetrated to invalidate
//   - 100% = Full close through entire zone required
//   - 85%  = Conservative, allows minor wicks through
//   - 55%  = Strict, invalidates on majority penetration
const float MBZ_THRESHOLD_STANDARD     = 100.0
const float MBZ_THRESHOLD_CONSERVATIVE = 85.0
const float MBZ_THRESHOLD_STRICT       = 55.0

// SIF Thresholds: % of zone that must be penetrated to invalidate
//   - 85%  = Lenient, allows more room before invalidation
//   - 55%  = Strict, invalidates on majority penetration
const float SIF_THRESHOLD_LENIENT = 85.0
const float SIF_THRESHOLD_STRICT  = 55.0
// ═══════════════════════════════════════════════════════════════════════════════

// MBZ invalidation mode constants (UI labels)
const string MBZ_INVALIDATION_STANDARD     = "Standard (100%)"
const string MBZ_INVALIDATION_CONSERVATIVE = "Conservative (85%)"
const string MBZ_INVALIDATION_STRICT       = "Strict (55%)"
const string MBZ_INVALIDATION_CUSTOM       = "Custom"

// SIF invalidation mode constants (UI labels)
const string SIF_INVALIDATION_STRICT   = "Strict (55%)"
const string SIF_INVALIDATION_LENIENT  = "Lenient (85%)"
const string SIF_INVALIDATION_CUSTOM   = "Custom"

const int   INVALIDATION_LOOKBACK_LIMIT = 500

// Implied FVG detection parameters
const float  IMPLIED_DISPLACEMENT_MULTIPLIER = 1.25
const int    IMPLIED_DISPLACEMENT_LOOKBACK   = 4

// VI suppression temporal window
const int SUPPRESSION_TEMPORAL_WINDOW = 2

// MBZ label text color default
const color DEFAULT_ZONE_LABEL_COLOR = color.new(color.rgb(156, 156, 156), 20)

// ═══════════════════════════════════════════════════════════════════════════════
// TIMEFRAME CONFIGURATION
// ═══════════════════════════════════════════════════════════════════════════════
// Centralized pairing definition - strict 1:1 LTF→HTF mapping
// Returns: [is_valid, htf_string, htf_label, htf_ms, ltf_label]
//
// SUPPORTED PAIRINGS:
//   LTF    →  HTF     Label   HTF_MS       Density
//   30s    →  5m      "5m"    300000       10x
//   1m     →  15m     "15m"   900000       15x
//   2m     →  30m     "30m"   1800000      15x
//   3m     →  30m     "30m"   1800000      10x
//   5m     →  1H      "1H"    3600000      12x
//   15m    →  4H      "4H"    14400000     16x
//   1H     →  D       "D"     86400000     24x
//   4H     →  D       "D"     86400000     6x
//
// To add a new pairing: add one case to the switch below
// ═══════════════════════════════════════════════════════════════════════════════

// HTF slot constants
const string HTF_SLOT_PRIMARY   = "primary"
const string HTF_SLOT_SECONDARY = "secondary"

// Unified HTF pairing function
get_tf_pairing(string chart_tf, string slot) =>
    if slot == HTF_SLOT_PRIMARY
        switch chart_tf
            "30S" => [true, "5",   "5m",  300000,    "30s"]   // 30s → 5m   (10x)
            "1"   => [true, "15",  "15m", 900000,    "1m"]    // 1m  → 15m  (15x)
            "2"   => [true, "30",  "30m", 1800000,   "2m"]    // 2m  → 30m  (15x)
            "3"   => [true, "30",  "30m", 1800000,   "3m"]    // 3m  → 30m  (10x)
            "5"   => [true, "60",  "1H",  3600000,   "5m"]    // 5m  → 1H   (12x)
            "15"  => [true, "240", "4H",  14400000,  "15m"]   // 15m → 4H   (16x)
            "60"  => [true, "D",   "D",   86400000,  "1H"]    // 1H  → D    (24x)
            "240" => [true, "D",   "D",   86400000,  "4H"]    // 4H  → D    (6x)
            =>       [false, "",   "",    0,         ""]      // Unsupported
    else  // secondary
        switch chart_tf
            "5"   => [true, "240", "4H", 14400000, "5m"]      // 5m → 4H (MVP)
            =>       [false, "",   "",   0,        ""]        // Not supported

string CHART_TF = timeframe.period
[IS_VALID, HTF_STRING, HTF_LABEL, HTF_MS, LTF_LABEL] = get_tf_pairing(CHART_TF, HTF_SLOT_PRIMARY)
[IS_VALID_HTF2, HTF2_STRING, HTF2_LABEL, HTF2_MS, _] = get_tf_pairing(CHART_TF, HTF_SLOT_SECONDARY)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

// Engine mode constants
const string ENGINE_MBZ_SIF  = "MBZ + SIF"
const string ENGINE_MBZ_ONLY = "MBZ Only"
const string ENGINE_SIF_ONLY = "SIF Only"

// Direction filter options
const string DIR_BOTH    = "Both"
const string DIR_BULLISH = "Bullish Only"
const string DIR_BEARISH = "Bearish Only"

// Gap color
const color GAP_COLOR = color.new(color.rgb(187, 217, 251), 90)

// ─── 🎤 Workspace Tools ───
GROUP_LIVE_WORKSPACE = "🎤 Workspace Tools"
WORKSPACE_DEFAULT_NEAREST = 1
WORKSPACE_FADE_OPACITY = 80

// Auto Workspace Configuration (extensible - add more timeframes as needed)
NY_TIMEZONE = "America/New_York"
AUTO_WS_TIMEFRAMES = array.from("1", "2", "3", "5", "15", "60")  // 1m, 2m, 3m, 5m, 15m, 1h
AUTO_WS_START_HOUR = 8   // NY time
AUTO_WS_END_HOUR = 13    // NY time

workspace_mode_enabled = input.bool(false, "Enable Workspace Mode", group=GROUP_LIVE_WORKSPACE)
auto_workspace_enabled = input.bool(true, "Auto Workspace", group=GROUP_LIVE_WORKSPACE)
workspace_nearest_bull = input.int(WORKSPACE_DEFAULT_NEAREST, "+", minval=0, maxval=10, group=GROUP_LIVE_WORKSPACE, inline="ws_nearest")
workspace_nearest_bear = input.int(WORKSPACE_DEFAULT_NEAREST, "-", minval=0, maxval=10, group=GROUP_LIVE_WORKSPACE, inline="ws_nearest")
workspace_exclude_vi_only = input.bool(true, "Exclude VI-Only Zones", group=GROUP_LIVE_WORKSPACE)

// Auto workspace detection (M-F only)
is_auto_ws_timeframe = array.includes(AUTO_WS_TIMEFRAMES, timeframe.period)
ny_hour = hour(time, NY_TIMEZONE)
ny_dow = dayofweek(time, NY_TIMEZONE)
is_weekday = ny_dow >= dayofweek.monday and ny_dow <= dayofweek.friday
is_auto_ws_time_window = is_weekday and ny_hour >= AUTO_WS_START_HOUR and ny_hour < AUTO_WS_END_HOUR
workspace_active = workspace_mode_enabled or (auto_workspace_enabled and is_auto_ws_timeframe and is_auto_ws_time_window)

// ─── ⚡ Zone Engine ───
GROUP_ENGINE     = "⚡ Zone Engine"
engine_mode      = input.string(ENGINE_MBZ_SIF, "Engine Mode", options=[ENGINE_MBZ_SIF, ENGINE_MBZ_ONLY, ENGINE_SIF_ONLY], group=GROUP_ENGINE)

// Derived engine flags (from single selector)
bool enable_mbz_engine = engine_mode == ENGINE_MBZ_SIF or engine_mode == ENGINE_MBZ_ONLY
bool enable_sif_engine = engine_mode == ENGINE_MBZ_SIF or engine_mode == ENGINE_SIF_ONLY

// ─── 📊 Gap Sources ───
GROUP_GAP_SOURCES = "📊 Gap Sources"
enable_fvg      = input.bool(true, "Fair Value Gaps", group=GROUP_GAP_SOURCES, inline="src1")
enable_implied  = input.bool(true, "Implied FVG", group=GROUP_GAP_SOURCES, inline="src2")
enable_volume   = input.bool(true, "Volume Imbalance", group=GROUP_GAP_SOURCES, inline="src3")

// ─── 🔍 Detection Filters ───
GROUP_FILTERS    = "🔍 Detection Filters"
max_htf_candles  = input.int(200, "HTF Candles", minval=5, maxval=200, group=GROUP_FILTERS)
mbz_direction_filter = input.string(DIR_BOTH, "Direction", options=[DIR_BOTH, DIR_BULLISH, DIR_BEARISH], group=GROUP_FILTERS)

// HTF display mode
const string HTF_DISPLAY_BOTH     = "Primary + Secondary"
const string HTF_DISPLAY_PRIMARY  = "Primary"
const string HTF_DISPLAY_SECONDARY = "Secondary"
htf_display_mode = input.string(HTF_DISPLAY_BOTH, "HTF Display", options=[HTF_DISPLAY_BOTH, HTF_DISPLAY_PRIMARY, HTF_DISPLAY_SECONDARY], group=GROUP_FILTERS)

// Derived display flags
bool show_htf1 = htf_display_mode == HTF_DISPLAY_BOTH or htf_display_mode == HTF_DISPLAY_PRIMARY
bool show_htf2 = IS_VALID_HTF2 and (htf_display_mode == HTF_DISPLAY_BOTH or htf_display_mode == HTF_DISPLAY_SECONDARY)

// ─── 🎨 Zone Display ───
GROUP_ZONE_DISPLAY = "🎨 Zone Display"
zone_bull_color  = input.color(DEFAULT_ZONE_BULL_COLOR, "+", group=GROUP_ZONE_DISPLAY, inline="zc")
zone_bear_color  = input.color(DEFAULT_ZONE_BEAR_COLOR, "-", group=GROUP_ZONE_DISPLAY, inline="zc")

// Visual intensity type (must be defined before use)
type ZoneVisualStyle
    int border_trans      // Border transparency (0=solid, 100=invisible)
    int fill_trans        // Fill transparency
    int label_trans       // Label transparency
    int border_width      // Border width

// Zone intensity presets
const string ZONE_STYLE_DEFAULT     = "Default"
const string ZONE_STYLE_MUTED       = "Muted"
const string ZONE_STYLE_ULTRA_MUTED = "Ultra Muted"

primary_zone_style   = input.string(ZONE_STYLE_MUTED, "Primary Intensity", options=[ZONE_STYLE_DEFAULT, ZONE_STYLE_MUTED, ZONE_STYLE_ULTRA_MUTED], group=GROUP_ZONE_DISPLAY)
secondary_zone_style = input.string(ZONE_STYLE_ULTRA_MUTED, "Secondary Intensity", options=[ZONE_STYLE_DEFAULT, ZONE_STYLE_MUTED, ZONE_STYLE_ULTRA_MUTED], group=GROUP_ZONE_DISPLAY)

// Secondary zone styling (fixed - not user configurable)
const string SECONDARY_BORDER_STYLE = line.style_dashed
const int SECONDARY_BORDER_WIDTH = 2

// Resolve ZoneVisualStyle from preset name
// Preset values: border_trans, fill_trans, label_trans, border_width
get_zone_style(string preset) =>
    switch preset
        ZONE_STYLE_DEFAULT     => ZoneVisualStyle.new(0,  94, 0,  3)
        ZONE_STYLE_MUTED       => ZoneVisualStyle.new(55, 98, 55, 3)
        ZONE_STYLE_ULTRA_MUTED => ZoneVisualStyle.new(80, 99, 80, 3)
        => ZoneVisualStyle.new(55, 98, 55, 3)  // fallback to Muted

// Resolved styles for HTF1 (Primary) and HTF2 (Secondary)
var ZoneVisualStyle htf1_style = get_zone_style(primary_zone_style)
var ZoneVisualStyle htf2_style = get_zone_style(secondary_zone_style)

zone_extension_bars = input.int(5, "Zone Extension in HTF Bars", minval=1, maxval=20, group=GROUP_ZONE_DISPLAY)
zone_label_color = input.color(DEFAULT_ZONE_LABEL_COLOR, "Label Color", group=GROUP_ZONE_DISPLAY, inline="lbl")
zone_label_size  = input.string("Large", "Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=GROUP_ZONE_DISPLAY, inline="lbl")
show_forming_zones = input.bool(false, "Show Forming Zones", group=GROUP_ZONE_DISPLAY)

// ─── 🎯 MBZ Settings ───
GROUP_MBZ        = "🎯 MBZ Settings"
extend_to_reference_wick = input.bool(true, "Extend to Reference Wick", group=GROUP_MBZ)
same_source_filter = input.string(SAME_SOURCE_FILTER_LATEST_TOUCH, "Same-Source MBZ", options=[SAME_SOURCE_FILTER_ALL_TOUCHES, SAME_SOURCE_FILTER_FIRST_TOUCH, SAME_SOURCE_FILTER_LATEST_TOUCH], group=GROUP_MBZ)
invalidation_mode = input.string(MBZ_INVALIDATION_STRICT, "MBZ Invalidation", options=[MBZ_INVALIDATION_STANDARD, MBZ_INVALIDATION_CONSERVATIVE, MBZ_INVALIDATION_STRICT, MBZ_INVALIDATION_CUSTOM], group=GROUP_MBZ, inline="mbz_inv")
custom_threshold_percent = input.float(50, "Custom %", minval=1, maxval=100, step=1, group=GROUP_MBZ, inline="mbz_inv")

// ─── ✨ SIF Settings ───
GROUP_SIF        = "✨ SIF Settings"
sif_invalidation_mode = input.string(SIF_INVALIDATION_STRICT, "SIF Invalidation", options=[SIF_INVALIDATION_STRICT, SIF_INVALIDATION_LENIENT, SIF_INVALIDATION_CUSTOM], group=GROUP_SIF, inline="sif_inv")
sif_custom_threshold_percent = input.float(99, "Custom %", minval=1, maxval=100, step=1, group=GROUP_SIF, inline="sif_inv")

// ─── ✋ Invalidation ───
GROUP_INVALIDATION = "✋ Invalidation"
enable_invalidation = input.bool(true, "Enable Invalidation", group=GROUP_INVALIDATION)

// ─── 📦 Source Origins ───
GROUP_SOURCE     = "📦 Source Origins"

// Gap display mode constants
const string GAP_DISPLAY_OFF        = "Off"
const string GAP_DISPLAY_ALL        = "All Gaps"
const string GAP_DISPLAY_MBZ_SOURCE = "MBZ Source Only"
const string GAP_DISPLAY_SIF_SOURCE = "SIF Source Only"

gap_display_mode = input.string(GAP_DISPLAY_OFF, "Show Gaps", options=[GAP_DISPLAY_OFF, GAP_DISPLAY_ALL, GAP_DISPLAY_MBZ_SOURCE, GAP_DISPLAY_SIF_SOURCE], group=GROUP_SOURCE)

// ─── 📋 Reference ───
GROUP_REF        = "📋 Reference"
show_color_table = input.bool(false, "Show Color Table", group=GROUP_REF)
show_status_table = input.bool(true, "Show Status Table", group=GROUP_REF, inline="status")
status_table_offset = input.int(100, "Offset", minval=-150, maxval=150, group=GROUP_REF, inline="status")

// ─── 🧪 Development ───
GROUP_DEV        = "🧪 Development"
show_htf_candles = input.bool(false, "Show HTF Candles", group=GROUP_DEV)
// HTF candle colors (hardcoded)
color htf_bull_body_color = color.new(color.rgb(165, 214, 167), 74)
color htf_bull_wick_color = color.new(color.rgb(165, 214, 167), 85)
color htf_bear_body_color = color.new(color.rgb(244, 143, 177), 74)
color htf_bear_wick_color = color.new(color.rgb(252, 203, 205), 80)

// Debug highlights for SIF tap/inversion detection
show_first_tap_only = input.bool(false, "First Tap (no inversion)", group=GROUP_DEV)
show_immediate_sif = input.bool(false, "Immediate SIF", group=GROUP_DEV)
show_delayed_inversion = input.bool(false, "Delayed Inversion", group=GROUP_DEV)
disable_vi_suppression = input.bool(true, "Disable VI Suppression", group=GROUP_DEV)

// ═══════════════════════════════════════════════════════════════════════════════
// DERIVED VALUES
// ═══════════════════════════════════════════════════════════════════════════════

color BULL_BORDER = color.new(color.from_gradient(50, 0, 100, htf_bull_body_color, htf_bull_wick_color), 60)
color BEAR_BORDER = color.new(color.from_gradient(50, 0, 100, htf_bear_body_color, htf_bear_wick_color), 60)

// Resolve label size from string to Pine constant
string ZONE_LABEL_SIZE_RESOLVED = switch zone_label_size
    "Tiny"   => size.tiny
    "Small"  => size.small
    "Normal" => size.normal
    "Large"  => size.large
    "Huge"   => size.huge
    => size.large

// Validation boundary is an inherent feature - static styling
const string VALIDATION_LINE_STYLE = line.style_dotted

// Resolve MBZ invalidation threshold based on mode
float MBZ_INVALIDATION_THRESHOLD = switch invalidation_mode
    MBZ_INVALIDATION_STANDARD     => MBZ_THRESHOLD_STANDARD
    MBZ_INVALIDATION_CONSERVATIVE => MBZ_THRESHOLD_CONSERVATIVE
    MBZ_INVALIDATION_STRICT       => MBZ_THRESHOLD_STRICT
    MBZ_INVALIDATION_CUSTOM       => custom_threshold_percent
    => MBZ_THRESHOLD_STANDARD

// Resolve SIF invalidation threshold based on mode
float SIF_INVALIDATION_THRESHOLD = switch sif_invalidation_mode
    SIF_INVALIDATION_STRICT  => SIF_THRESHOLD_STRICT
    SIF_INVALIDATION_LENIENT => SIF_THRESHOLD_LENIENT
    SIF_INVALIDATION_CUSTOM  => sif_custom_threshold_percent
    => SIF_THRESHOLD_STRICT

// Smart FVG limit based on candle overlay usage
// Candles use 2 boxes each (wick + body), FVGs use 1 box each
int CANDLE_BOX_USAGE = show_htf_candles ? max_htf_candles * 2 : 0
int MAX_FVGS = DRAW_LIMIT - CANDLE_BOX_USAGE - DRAW_BUFFER
int MAX_ZONES = 100  // Zones use 1 box + 1 line each

// ═══════════════════════════════════════════════════════════════════════════════
// TYPES
// ═══════════════════════════════════════════════════════════════════════════════

type HTFCandle
    box   wick
    box   body
    int   start_time

// Candle that interacted with gap (for tap/inversion tracking)
type TapCandidate
    int    bar_index
    int    bar_time
    float  body_top
    float  body_bottom
    bool   is_bullish

// Unified gap data for all gap types (FVG, Implied, VI)
type GapData
    // ─── Core geometry ───
    float  top
    float  bottom
    float  ce                    // Consequent encroachment (midpoint)
    int    bar_index             // Bar index when gap completed
    int    start_time            // Time of first candle in formation
    int    formation_end_time    // Time of completion candle
    bool   is_bullish
    string gap_type              // "fvg", "implied", "volume"
    int    gap_id
    // ─── Gap state ───
    bool   is_inverted           // Gap closed (price closed through)
    int    inverted_time
    bool   is_breakaway          // Gap breaks trend range
    // ─── SIF tap tracking (body-based, NOT wick-based like MBZ) ───
    TapCandidate sif_body_tapper    // First candle whose BODY enters gap (SIF definition)
    // ─── MBZ tracking ───
    int    mbz_ref_time          // When MBZ formed, freeze box at reference candle time
    bool   mbz_is_bullish        // Direction of MBZ that formed (for direction filter)
    // ─── Visual elements ───
    box    gap_box
    line   ce_line
    label  tf_label

// MBZ Formation Match (for multi-source consolidated candles support)
type MBZFormationMatch
    bool   is_bullish
    string subtype
    int    source_gap_id
    string source_gap_type
    bool   source_gap_is_breakaway

// ═══════════════════════════════════════════════════════════════════════════════
// UNIFIED CANDLE ZONE TYPE
// ═══════════════════════════════════════════════════════════════════════════════
// Agnostic container for both MBZ and SIF zones
// Zone geometry comes from formation candle, not from source gap

type CandleZone
    // ─── Formation candle geometry (same for both MBZ and SIF) ───
    int    bar_index
    int    formation_time
    float  candle_open
    float  candle_close
    float  candle_high
    float  candle_low

    // ─── Zone classification ───
    bool   is_bullish
    string zone_subtype        // "standard", "inclusion", "reflection"

    // ─── Engine flags (which detection systems validated this zone) ───
    bool   has_mbz             // True if MBZ engine validated this zone
    bool   has_sif             // True if SIF engine validated this zone

    // ─── Cached zone boundaries (calculated from candle geometry) ───
    float  zone_top
    float  zone_bottom

    // ─── Source gap references (may have multiple sources) ───
    array<int>    source_gap_ids      // All gap IDs that contributed to this zone
    array<string> source_gap_types    // Corresponding gap types ("fvg", "implied", "volume")

    // ─── State ───
    bool   is_invalidated
    bool   mbz_invalidated     // MBZ-specific invalidation state
    bool   sif_invalidated     // SIF-specific invalidation state

    // ─── MBZ-specific fields ───
    float  ref_candle_high     // Reference candle high (for wick extension)
    float  ref_candle_low      // Reference candle low (for wick extension)
    bool   is_wick_extended    // True if zone was extended to reference wick

    // ─── SIF-specific fields ───
    bool   is_immediate_sif    // True if first tap AND inversion same candle

    // ─── Breakaway state ───
    bool   is_breakaway        // True if any source FVG was a breakaway gap

    // ─── Preview state ───
    bool   is_preview          // True if this is a forming/preview zone (not yet confirmed)

    // ─── HTF context ───
    string htf_label           // Which HTF this zone belongs to ("1H", "4H", etc.)

    // ─── Visual elements ───
    box    zone_box
    line   validation_line    // Vertical line marking when HTF candle closed (zone became valid)

// ═══════════════════════════════════════════════════════════════════════════════
// HTF CONTEXT TYPE (for multi-HTF support)
// ═══════════════════════════════════════════════════════════════════════════════
// Encapsulates all state for a single HTF timeframe
// Functions accept arrays as parameters to enable reuse across multiple HTFs

type HTFContext
    // ─── Configuration ───
    string htf_string              // TradingView timeframe string ("240", "D", etc.)
    string htf_label               // Display label ("4H", "D", etc.)
    int    htf_ms                  // Milliseconds per HTF candle

    // ─── Current forming candle ───
    float  curr_open
    float  curr_high
    float  curr_low
    int    curr_time

    // ─── Confirmed candle history [1] = most recent closed ───
    float  o1
    float  h1
    float  l1
    float  c1
    int    t1

    // ─── Confirmed candle history [2] = second most recent ───
    float  o2
    float  h2
    float  l2
    float  c2
    int    t2

    // ─── Confirmed candle history [3] = third most recent ───
    float  o3
    float  h3
    float  l3
    float  c3
    int    t3

    // ─── Extra history for displacement lookback ───
    float  o4
    float  h4
    float  l4
    float  c4
    float  o5
    float  h5
    float  l5
    float  c5

    // ─── Breakaway trend range (20-bar HTF high/low) ───
    float  breakaway_upper_1
    float  breakaway_lower_1
    float  breakaway_upper_2
    float  breakaway_lower_2
    float  breakaway_upper_3
    float  breakaway_lower_3

    // ─── Data arrays ───
    array<GapData>      gap_array
    array<CandleZone>   zone_array
    array<int>          htf_times      // Track HTF candle times for window

    // ─── Unique ID counter ───
    int    next_gap_id

// Preview zone storage (separate from confirmed zones - rebuilt each bar)
var array<CandleZone> preview_zone_array = array.new<CandleZone>()

// Track previous close for preview zone optimization (avoid redraw when price unchanged)
var float prev_preview_close = na

// ═══════════════════════════════════════════════════════════════════════════════
// UNIFIED ZONE FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// Unified subtype detection for both MBZ and SIF zones
// Analyzes candle shape to determine zone geometry type
// Returns [subtype, has_dominant_wick]
detect_zone_subtype(float candle_open, float candle_close, float candle_high, float candle_low) =>
    if candle_open == candle_close
        [SUBTYPE_STANDARD, false]  // Doji = standard
    else
        float body_top = math.max(candle_open, candle_close)
        float body_bot = math.min(candle_open, candle_close)
        float body_size = body_top - body_bot
        float upper_wick = candle_high - body_top
        float lower_wick = body_bot - candle_low
        bool is_bullish = candle_close > candle_open

        // Check wick dominance (≥80% of body)
        float upper_ratio = body_size > 0 ? upper_wick / body_size : 0
        float lower_ratio = body_size > 0 ? lower_wick / body_size : 0
        float max_ratio = math.max(upper_ratio, lower_ratio)
        bool has_dominant = max_ratio >= WICK_DOMINANCE_THRESHOLD

        if not has_dominant
            [SUBTYPE_STANDARD, false]
        else
            // Determine which wick is dominant
            bool upper_dominant = upper_wick > lower_wick

            // Subtype logic (same for MBZ and SIF):
            // Bullish candle + upper wick dominant = Reflection
            // Bullish candle + lower wick dominant = Inclusion
            // Bearish candle + upper wick dominant = Inclusion
            // Bearish candle + lower wick dominant = Reflection
            string subtype = ""
            if is_bullish
                subtype := upper_dominant ? SUBTYPE_REFLECTION : SUBTYPE_INCLUSION
            else
                subtype := upper_dominant ? SUBTYPE_INCLUSION : SUBTYPE_REFLECTION

            [subtype, true]

// Unified zone boundary calculation for both MBZ and SIF
// Calculates zone top/bottom from candle geometry based on subtype
// ref_high/ref_low used for MBZ wick extension (set to na for SIF)
// Returns [zone_top, zone_bottom, is_extended]
calculate_zone_boundaries(float candle_open, float candle_close, float candle_high, float candle_low, bool is_bullish, string subtype, float ref_high, float ref_low, bool allow_wick_extension) =>
    float body_top = math.max(candle_open, candle_close)
    float body_bot = math.min(candle_open, candle_close)
    bool is_extended = false

    if subtype == SUBTYPE_INCLUSION
        // Inclusion: Close to dominant wick
        if is_bullish
            // Bullish inclusion: lower boundary may extend to reference low
            if allow_wick_extension and not na(ref_low) and ref_low < candle_low
                is_extended := true
                [candle_close, ref_low, is_extended]
            else
                [candle_close, candle_low, is_extended]
        else
            // Bearish inclusion: upper boundary may extend to reference high
            if allow_wick_extension and not na(ref_high) and ref_high > candle_high
                is_extended := true
                [ref_high, candle_close, is_extended]
            else
                [candle_high, candle_close, is_extended]
    else if subtype == SUBTYPE_REFLECTION
        // Reflection: Mirror wick distance from open, projected from close
        if is_bullish
            float wick_range = math.abs(candle_high - candle_open)
            // Bullish reflection: lower boundary may extend to reference low
            if allow_wick_extension and not na(ref_low) and ref_low < candle_low
                is_extended := true
                [candle_close, ref_low, is_extended]
            else
                [candle_close, candle_close - wick_range, is_extended]
        else
            float wick_range = math.abs(candle_low - candle_open)
            // Bearish reflection: upper boundary may extend to reference high
            if allow_wick_extension and not na(ref_high) and ref_high > candle_high
                is_extended := true
                [ref_high, candle_close, is_extended]
            else
                [candle_close + wick_range, candle_close, is_extended]
    else
        // Standard: Body only, with optional reference wick extension
        if allow_wick_extension
            if is_bullish
                // Bullish: extend lower boundary to reference low if lower
                if not na(ref_low) and ref_low < candle_low
                    is_extended := true
                    [body_top, ref_low, is_extended]
                else
                    [body_top, body_bot, is_extended]
            else
                // Bearish: extend upper boundary to reference high if higher
                if not na(ref_high) and ref_high > candle_high
                    is_extended := true
                    [ref_high, body_bot, is_extended]
                else
                    [body_top, body_bot, is_extended]
        else
            [body_top, body_bot, is_extended]

// Factory function to create a CandleZone from formation candle data
// has_mbz/has_sif: which engine(s) validated this zone
// For MBZ: provide ref_high/ref_low for wick extension
// For SIF: is_immediate_sif indicates immediate SIF
create_candle_zone(int formation_bar_index, int formation_time, float candle_open, float candle_close, float candle_high, float candle_low, bool is_bullish, array<int> gap_ids, array<string> gap_types, float ref_high, float ref_low, bool allow_wick_extension, bool has_mbz, bool has_sif, bool is_immediate_sif, string htf_label_param) =>
    // Detect subtype from candle shape
    [subtype, _has_dominant] = detect_zone_subtype(candle_open, candle_close, candle_high, candle_low)

    // Calculate zone boundaries
    [zone_top, zone_bottom, is_extended] = calculate_zone_boundaries(candle_open, candle_close, candle_high, candle_low, is_bullish, subtype, ref_high, ref_low, allow_wick_extension)

    // Create zone record
    CandleZone zone = CandleZone.new()
    zone.bar_index := formation_bar_index
    zone.formation_time := formation_time
    zone.candle_open := candle_open
    zone.candle_close := candle_close
    zone.candle_high := candle_high
    zone.candle_low := candle_low
    zone.is_bullish := is_bullish
    zone.zone_subtype := subtype
    zone.has_mbz := has_mbz
    zone.has_sif := has_sif
    zone.zone_top := zone_top
    zone.zone_bottom := zone_bottom
    zone.source_gap_ids := gap_ids
    zone.source_gap_types := gap_types
    zone.is_invalidated := false
    zone.mbz_invalidated := false
    zone.sif_invalidated := false
    zone.ref_candle_high := ref_high
    zone.ref_candle_low := ref_low
    zone.is_wick_extended := is_extended
    zone.is_immediate_sif := is_immediate_sif
    zone.is_breakaway := false
    zone.is_preview := false
    zone.htf_label := htf_label_param

    zone

// Find existing zone for a candle by formation_time
// Returns index in zone_arr, or -1 if not found
find_zone_index_for_candle(array<CandleZone> zone_arr, int formation_time) =>
    int result = -1
    if array.size(zone_arr) > 0
        for i = 0 to array.size(zone_arr) - 1
            CandleZone z = array.get(zone_arr, i)
            if z.formation_time == formation_time
                result := i
                break
    result

// Get or create zone for a candle
// If zone exists, returns it for updating
// If not, creates new zone and adds to array
// Note: Caller must update the zone and call array.set() after modifications
get_or_create_zone(array<CandleZone> zone_arr, int formation_bar_index, int formation_time, float candle_open, float candle_close, float candle_high, float candle_low, bool is_bullish, float ref_high, float ref_low, bool allow_wick_extension, string htf_label_param) =>
    int existing_idx = find_zone_index_for_candle(zone_arr, formation_time)

    if existing_idx >= 0
        // Return existing zone
        [array.get(zone_arr, existing_idx), existing_idx, false]
    else
        // Create new zone with empty source arrays
        array<int> gap_ids = array.new<int>()
        array<string> gap_types = array.new<string>()

        CandleZone new_zone = create_candle_zone(formation_bar_index, formation_time, candle_open, candle_close, candle_high, candle_low, is_bullish, gap_ids, gap_types, ref_high, ref_low, allow_wick_extension, false, false, false, htf_label_param)

        array.unshift(zone_arr, new_zone)
        [new_zone, 0, true]

// Add source gap to zone's source arrays (avoids duplicates)
// Also propagates breakaway status (zone is breakaway if ANY source gap is breakaway)
add_source_to_zone(CandleZone zone, int gap_id, string gap_type, bool gap_is_breakaway) =>
    // Check if already present
    bool already_present = false
    if array.size(zone.source_gap_ids) > 0
        for i = 0 to array.size(zone.source_gap_ids) - 1
            if array.get(zone.source_gap_ids, i) == gap_id
                already_present := true
                break

    if not already_present
        array.push(zone.source_gap_ids, gap_id)
        array.push(zone.source_gap_types, gap_type)
        // Propagate breakaway: zone is breakaway if ANY source is breakaway
        if gap_is_breakaway
            zone.is_breakaway := true

// ═══════════════════════════════════════════════════════════════════════════════
// HTF1 CONTEXT INSTANCE
// ═══════════════════════════════════════════════════════════════════════════════
// Primary HTF context - encapsulates all state for the main timeframe

var HTFContext htf1 = HTFContext.new(
    htf_string       = HTF_STRING,
    htf_label        = HTF_LABEL,
    htf_ms           = HTF_MS,
    curr_open        = 0.0,
    curr_high        = 0.0,
    curr_low         = 0.0,
    curr_time        = 0,
    o1 = 0.0, h1 = 0.0, l1 = 0.0, c1 = 0.0, t1 = 0,
    o2 = 0.0, h2 = 0.0, l2 = 0.0, c2 = 0.0, t2 = 0,
    o3 = 0.0, h3 = 0.0, l3 = 0.0, c3 = 0.0, t3 = 0,
    o4 = 0.0, h4 = 0.0, l4 = 0.0, c4 = 0.0,
    o5 = 0.0, h5 = 0.0, l5 = 0.0, c5 = 0.0,
    breakaway_upper_1 = na, breakaway_lower_1 = na,
    breakaway_upper_2 = na, breakaway_lower_2 = na,
    breakaway_upper_3 = na, breakaway_lower_3 = na,
    gap_array        = array.new<GapData>(),
    zone_array       = array.new<CandleZone>(),
    htf_times        = array.new<int>(),
    next_gap_id      = 1
)

// Secondary HTF context
var HTFContext htf2 = HTFContext.new(
    htf_string       = HTF2_STRING,
    htf_label        = HTF2_LABEL,
    htf_ms           = HTF2_MS,
    curr_open        = 0.0,
    curr_high        = 0.0,
    curr_low         = 0.0,
    curr_time        = 0,
    o1 = 0.0, h1 = 0.0, l1 = 0.0, c1 = 0.0, t1 = 0,
    o2 = 0.0, h2 = 0.0, l2 = 0.0, c2 = 0.0, t2 = 0,
    o3 = 0.0, h3 = 0.0, l3 = 0.0, c3 = 0.0, t3 = 0,
    o4 = 0.0, h4 = 0.0, l4 = 0.0, c4 = 0.0,
    o5 = 0.0, h5 = 0.0, l5 = 0.0, c5 = 0.0,
    breakaway_upper_1 = na, breakaway_lower_1 = na,
    breakaway_upper_2 = na, breakaway_lower_2 = na,
    breakaway_upper_3 = na, breakaway_lower_3 = na,
    gap_array        = array.new<GapData>(),
