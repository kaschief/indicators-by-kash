// === 🎯 DETECTION ===
// SEPARATE LIMITS SYSTEM: Independent control over valid vs invalidated MBZ display counts
max_valid_mbzs = input.int(DEFAULT_MAX_VALID_MBZS, 'Max Valid MBZs', minval=0, maxval=MAX_VALID_MBZS_LIMIT, group='🎯 Detection', inline='det1', tooltip='Maximum number of valid (non-breached) MBZs visible on chart')
max_invalidated_mbzs = input.int(DEFAULT_MAX_INVALIDATED_MBZS, 'Max Invalidated MBZs', minval=0, maxval=MAX_INVALIDATED_MBZS_LIMIT, group='🎯 Detection', inline='det1', tooltip='Maximum number of invalidated (breached) MBZs to show when enabled')
invalidated_mbz_display = input.string(INVALIDATED_DISPLAY_OFF, 'Show Invalidated MBZs', options=[INVALIDATED_DISPLAY_OFF, INVALIDATED_DISPLAY_LABELS, INVALIDATED_DISPLAY_LABELS_ZONES], group='🎯 Detection', inline='det1', tooltip='Off: hide invalidated MBZs\nLabels Only: show just labels with [X] marker\nLabels + Zones: show labels and zone extensions\n\nNote: [BREACH] appears in real-time when threshold exceeded, [X] appears after candle closes')
mbz_invalidation_mode = input.string(INVALIDATION_STANDARD, 'Invalidation Threshold', options=[INVALIDATION_STANDARD, INVALIDATION_STRICT, INVALIDATION_CUSTOM], group='🎯 Detection', inline='det2', tooltip='Zone fill threshold for invalidation and breach detection\nStandard: 100% fill (less sensitive, later invalidation - traditional MBZ)\nStrict: 85% fill (more sensitive, earlier invalidation)\nCustom: set your own percentage (1-99%)\n\n[BREACH] shows immediately when threshold exceeded\n[X] shows after candle closes with confirmation')
custom_threshold_percent = input.float(DEFAULT_CUSTOM_THRESHOLD, 'Custom %', minval=1.0, maxval=99.0, step=1.0, group='🎯 Detection', inline='det2')
show_50_percent_tags = input.bool(true, 'Mark MBZs formed at 50% with [½]', group='📊 Analysis', inline='det3', tooltip='Add [½] tag inline with MBZ text when MBZ forms at exactly 50% of mitigation candle')

// === 🎯 DIRECTIONAL FILTER ===
show_bullish_mbzs = input.bool(true, 'Show MBZ+', group='🎯 Directional Filter', inline='dir1', tooltip='Display bullish (upward) MBZ zones and labels')
show_bearish_mbzs = input.bool(true, 'Show MBZ-', group='🎯 Directional Filter', inline='dir1', tooltip='Display bearish (downward) MBZ zones and labels')

enable_breach_confirmation = input.bool(true, 'Enable Breach Confirmation System', group='🎯 Behavior', inline='conf1', tooltip='Prevents false [BREACH] alerts on newly formed MBZs\nMBZs must be "confirmed" before breach detection becomes active\nEliminates immediate false positives from normal price consolidation around formation')
confirmation_mode = input.string(CONFIRMATION_HYBRID_OR, 'Confirmation Method', options=[CONFIRMATION_DISTANCE_ONLY, CONFIRMATION_TIME_ONLY, CONFIRMATION_HYBRID_OR, CONFIRMATION_HYBRID_AND], group='🎯 Behavior', inline='conf1', tooltip='How MBZs become confirmed:\nDistance Only: price must move away from zone\nTime Only: wait minimum bars after formation\nHybrid OR: confirmed when EITHER distance OR time met (recommended)\nHybrid AND: confirmed only when BOTH distance AND time met (strictest)')
confirmation_distance_percent = input.float(DEFAULT_CONFIRMATION_DISTANCE, 'Distance %', minval=0.1, maxval=10.0, step=0.1, group='🎯 Behavior', inline='conf2', tooltip='Percentage of zone height that price must move away for distance confirmation\nBullish MBZ: price must drop below zone bottom by this amount\nBearish MBZ: price must rise above zone top by this amount')
confirmation_time_bars = input.int(DEFAULT_CONFIRMATION_TIME, 'Time Bars', minval=1, maxval=10, group='🎯 Behavior', inline='conf2', tooltip='Minimum bars that must pass after MBZ formation for time confirmation\nRecommended: 2-3 bars for most timeframes')

