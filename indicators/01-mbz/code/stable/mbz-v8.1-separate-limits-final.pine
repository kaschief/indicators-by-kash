// Array Size Limits (Optimized through performance testing)
MAX_ACTIVE_GAPS = 100           // Active gap tracking limit (performance optimized)
MAX_MBZ_RECORDS = 75            // MBZ history limit (visual clarity + performance)
MAX_BODY_HIGHLIGHTS = 100       // Body highlight boxes limit
MAX_WICK_HIGHLIGHTS = 100       // Wick highlight boxes limit
MAX_EXTENDED_BOXES = 100        // Extension boxes limit
MAX_PROJECTION_LINES = 200      // Projection lines limit (higher for multiple levels)
MAX_PROJECTION_LABELS = 200     // Projection labels limit (higher for multiple levels)

// Default Optimal Values (Based on observed performance)
DEFAULT_DISPLACEMENT_MULTIPLIER = 1.5    // Displacement detection threshold (testing optimized)
DEFAULT_CONFIRMATION_DISTANCE = 1.0      // Confirmation distance percentage (volatility tested)
DEFAULT_CONFIRMATION_TIME = 3            // Confirmation time in bars (optimal timing)
DEFAULT_CUSTOM_THRESHOLD = 70.0          // Default custom invalidation threshold

// Separate Limits System Defaults (v8.1 Feature)
DEFAULT_MAX_VALID_MBZS = 20      // Default maximum valid MBZs to display
DEFAULT_MAX_INVALIDATED_MBZS = 5 // Default maximum invalidated MBZs to display
MAX_VALID_MBZS_LIMIT = 100       // Maximum allowed valid MBZ limit (UI constraint)
MAX_INVALIDATED_MBZS_LIMIT = 50  // Maximum allowed invalidated MBZ limit (UI constraint)

// Invalidation Thresholds
STANDARD_INVALIDATION_PERCENT = 100.0    // Traditional MBZ invalidation (100% fill)
STRICT_INVALIDATION_PERCENT = 85.0       // Early invalidation (15% less than standard)

// Fibonacci-Based Projection Levels (Research-based optimal levels)
FIBONACCI_CENTER = 0.5                   // 50% retracement level
FIBONACCI_QUARTER_LOW = 0.25             // Lower quadrant level
FIBONACCI_QUARTER_HIGH = 0.75            // Upper quadrant level
FIBONACCI_STOP_125 = 1.25                // Stop level extension
FIBONACCI_STOP_150 = 1.5                 // Stop level extension
FIBONACCI_STOP_200 = 2.0                 // Stop level extension
FIBONACCI_TARGET_233 = -2.33             // Target extension (negative = beyond close)
FIBONACCI_TARGET_250 = -2.5              // Target extension
FIBONACCI_TARGET_400 = -4.0              // Target extension
FIBONACCI_TARGET_450 = -4.5              // Target extension

