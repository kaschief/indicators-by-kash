//@version=6

// ═══════════════════════════════════════════════════════════════════════════════
// INDICATOR VISUAL LIMITS (Must be declared before indicator() function)
// ═══════════════════════════════════════════════════════════════════════════════
INDICATOR_MAX_BOXES = 500
INDICATOR_MAX_LABELS = 500
INDICATOR_MAX_LINES = 500
INDICATOR_TITLE='MBZ Hunter° [Pro+] [mbz-ultimate]'
SHORT_TITLE="mbz-ultimate"

indicator(title=INDICATOR_TITLE, shorttitle=SHORT_TITLE, overlay=true, max_boxes_count=INDICATOR_MAX_BOXES, max_labels_count=INDICATOR_MAX_LABELS, max_lines_count=INDICATOR_MAX_LINES)
// Docs: indicators/mbz/docs/mbz-dual-alert-system.md (moved long-form comments)

// Alert variables
multi_source_mbz_bullish_formed = false
multi_source_mbz_bearish_formed = false
strong_mbz_bullish_formed = false
strong_mbz_bearish_formed = false
nested_mbz_bullish_formed = false
nested_mbz_bearish_formed = false
deeper_wick_mbz_bullish_formed = false
deeper_wick_mbz_bearish_formed = false

var bool mbz_grouped_alert_active = false
var string mbz_alert_message = ""
var array<string> mbz_alert_parts = array.new<string>()

mbz_bullish_formed = false
mbz_bearish_formed = false

