// Imbalance source tracking with unified structure
type ImbalanceSource
    int bar_index
    float top
    float bottom
    bool is_bullish
    bool is_closed_through
    int creation_bar
    int source_id
    string source_type

var array<ImbalanceSource> active_imbalance_sources = array.new<ImbalanceSource>()

// MBZ tracking with SUPER MBZ detection
type MBZRecord
    int bar_index
    float high_price
    float low_price
    float mbz_open
    float mbz_close
    bool is_bullish
    bool is_invalidated
    float max_fill_percentage
    bool has_dominant_wick
    bool is_exactly_50_percent
    string mbz_subtype
    string cached_label_text
    string cached_tooltip
    float cached_zone_top
    float cached_zone_bottom
    bool cached_data_valid
    label mbz_label
    int source_id
    // Cached source geometry to decouple from active_imbalance_sources retention
    int source_bar_index
    float source_high
    float source_low
    string source_family
    string source_type
    string pool_boundary
    bool wicked_deeper_into_source    // Track if wick penetrated deeper into the source origin
    bool reflection_pattern_deeper // Track if reflection pattern wick was deeper
    // SUPER MBZ detection
    bool is_super_mbz            // true if overlapping with any same-direction MBZ
    float overlap_percentage     // 0.0 to 100.0
    int overlapping_mbz_bar_index // Which MBZ we overlapped with
    string variant               // Variant that produced this MBZ (imbalance/liquidity)
    string formation_rule          // Formation rule (e.g., imbalance_standard, liquidity_standard)
    string source_origin_token   // Unified token describing the origin (e.g., fvg, daily)

type LiquidityPoolCollection
    array<float> highs
    array<float> lows
    array<int> high_times
    array<int> low_times
    array<int> session_close_times
