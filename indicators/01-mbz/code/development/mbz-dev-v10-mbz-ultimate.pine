    array<int> low_first_breach_bars
    array<bool> high_mitigated_flags
    array<bool> low_mitigated_flags
    array<int> high_mitigation_bars
    array<int> low_mitigation_bars
    array<bool> high_used_by_pattern
    array<bool> low_used_by_pattern
    float current_high
    float current_low
    int current_high_time
    int current_low_time
    int current_session_start_time
    int current_high_origin_bar_index
    int current_low_origin_bar_index
