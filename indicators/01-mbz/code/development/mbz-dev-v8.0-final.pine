//@version=6
indicator('MBZ Hunter° [Pro+] [v8.0-final]', overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS & CONSTANTS - CLEAN STRUCTURE
// ═══════════════════════════════════════════════════════════════════════════════

// Gap source constants
GAP_TYPE_FVG = "fvg"
GAP_TYPE_IMPLIED = "implied"
GAP_TYPE_VOLUME = "volume"
GAP_TYPE_TRUE = "true"

// MBZ subtype constants
SUBTYPE_STANDARD = "standard"
SUBTYPE_INCLUSION = "inclusion"
SUBTYPE_REFLECTION = "reflection"
SUBTYPE_IMPLIED = "implied"
SUBTYPE_VOLUME = "volume"
SUBTYPE_IMPLIED_INCLUSION = "implied_inclusion"
SUBTYPE_IMPLIED_REFLECTION = "implied_reflection"
SUBTYPE_VOLUME_INCLUSION = "volume_inclusion"
SUBTYPE_VOLUME_REFLECTION = "volume_reflection"
SUBTYPE_TRUE = "true"
SUBTYPE_TRUE_INCLUSION = "true_inclusion"
SUBTYPE_TRUE_REFLECTION = "true_reflection"

// Display Mode Constants
DISPLAY_ARROW_ONLY = "Arrow Only"
DISPLAY_TEXT_ONLY = "Text Only"
DISPLAY_ARROW_TEXT = "Arrow + Text"

// Wick Tier Constants
WICK_TIER_STANDARD = "standard"
WICK_TIER_RELAXED = "relaxed"
WICK_TIER_RISKY = "risky"
WICK_TIER_NONE = "none"

// Breach Confirmation Mode Constants
CONFIRMATION_DISTANCE_ONLY = "Distance Only"
CONFIRMATION_TIME_ONLY = "Time Only"
CONFIRMATION_HYBRID_OR = "Hybrid (Distance OR Time)"
CONFIRMATION_HYBRID_AND = "Hybrid (Distance AND Time)"

// Invalidated MBZ Display Constants
INVALIDATED_DISPLAY_OFF = "Off"
INVALIDATED_DISPLAY_LABELS = "Labels Only"
INVALIDATED_DISPLAY_LABELS_ZONES = "Labels + Zones"

// MBZ Invalidation Mode Constants
INVALIDATION_STANDARD = "Standard (100%)"
INVALIDATION_STRICT = "Strict (85%)"
INVALIDATION_CUSTOM = "Custom"

// ═══════════════════════════════════════════════════════════════════════════════
// PERFORMANCE & THRESHOLD CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

// Array Size Limits (Optimized through performance testing)
MAX_ACTIVE_GAPS = 100            // Maximum number of active gaps tracked
MAX_MBZ_RECORDS = 75             // Maximum number of MBZ records stored
MAX_MBZ_BODY_HIGHLIGHTS = 100    // Maximum number of body highlight boxes
MAX_MBZ_ZONES = 100              // Maximum number of MBZ zone boxes
MAX_MBZ_LABELS = 200             // Maximum number of MBZ labels

// Detection Thresholds
DEFAULT_DISPLACEMENT_MULTIPLIER = 1.5  // Default displacement detection threshold
DEFAULT_TRANSPARENCY = 80              // Default transparency for visual elements
DEFAULT_BREACH_DISTANCE = 5           // Default breach confirmation distance (pips)
DEFAULT_BREACH_TIME = 3               // Default breach confirmation time (bars)

// Visual Constants
LABEL_MAX_SIZE = 500             // Maximum characters in label text
BOX_EXTENSION_BARS = 50          // Default box extension length

// ═══════════════════════════════════════════════════════════════════════════════
// DATA STRUCTURES
// ═══════════════════════════════════════════════════════════════════════════════

// @type GapData
// @description Stores gap formation data with complete validation metadata
// @field anchor_bar int The bar index where the gap anchors
// @field top float Upper boundary of the gap (must be > bottom)
// @field bottom float Lower boundary of the gap (must be < top)
// @field is_bullish bool Direction of the gap (true = bullish, false = bearish)
// @field is_inverted bool Whether the gap has been filled (true = filled)
// @field formation_bar int The bar index where the gap was detected
// @field gap_id int Unique sequential identifier for the gap
// @field gap_type string Classification of the gap (GAP_TYPE_FVG, etc.)
type GapData
    int anchor_bar
    float top
    float bottom
    bool is_bullish
    bool is_inverted
    int formation_bar
    int gap_id
    string gap_type

// @type MBZRecord
// @description Stores MBZ formation data with complete zone and visual information
// @field bar_index int The bar where the MBZ was detected
// @field mbz_open float Opening price of the MBZ zone
// @field mbz_close float Closing price of the MBZ zone
// @field mbz_high float Highest point of the MBZ zone
// @field mbz_low float Lowest point of the MBZ zone
// @field is_bullish bool Direction of the MBZ (true = bullish, false = bearish)
// @field is_breached bool Whether the MBZ has been breached
// @field breach_percentage float Current breach level (0-100%)
// @field has_dominant_wick bool Whether the MBZ has wick dominance
// @field mbz_subtype string Detailed classification of MBZ type
// @field cached_label_text string Pre-computed label text for performance
// @field cached_tooltip string Pre-computed tooltip for performance
// @field mbz_label label Visual label element for the MBZ
// @field source_gap_id int ID of the gap that formed this MBZ
// @field is_super_mbz bool Whether this is classified as a Super MBZ
// @field overlap_percentage float Percentage of overlap with other MBZs
// @field overlapping_mbz_bar_index int Bar index of overlapping MBZ
type MBZRecord
    int bar_index
    float mbz_open
    float mbz_close
    float mbz_high
    float mbz_low
    bool is_bullish
    bool is_breached
    float breach_percentage
    bool has_dominant_wick
    string mbz_subtype
    string cached_label_text
    string cached_tooltip
    label mbz_label
    int source_gap_id
    bool is_super_mbz
    float overlap_percentage
    int overlapping_mbz_bar_index

// ═══════════════════════════════════════════════════════════════════════════════
// GLOBAL VARIABLES - SYSTEMATIC ARRAY MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

// Core data arrays with size limits
var array<GapData> active_gaps = array.new<GapData>(MAX_ACTIVE_GAPS)
var array<MBZRecord> mbz_records = array.new<MBZRecord>(MAX_MBZ_RECORDS)

// Visual element arrays
var array<box> mbz_body_highlights = array.new<box>(MAX_MBZ_BODY_HIGHLIGHTS)
var array<box> mbz_zones = array.new<box>(MAX_MBZ_ZONES)
var array<label> mbz_labels = array.new<label>(MAX_MBZ_LABELS)

// Gap ID tracking
var int next_gap_id = 1

// ═══════════════════════════════════════════════════════════════════════════════
// INPUT SETTINGS - ORGANIZED BY FUNCTIONAL AREA
// ═══════════════════════════════════════════════════════════════════════════════

// === GAP SOURCE SETTINGS ===
enable_fair_value_gaps = input.bool(true, 'Fair Value Gaps (FVG)', group='🎯 Gap Sources')
enable_implied = input.bool(true, 'Implied Fair Value Gaps', group='🎯 Gap Sources')
enable_volume_imbalance = input.bool(true, 'Volume Imbalance', group='🎯 Gap Sources')
enable_true_gaps = input.bool(false, 'True Gaps', group='🎯 Gap Sources')

// Displacement settings (for Implied FVGs)
displacement_multiplier = input.float(DEFAULT_DISPLACEMENT_MULTIPLIER, 'Displacement Multiplier', minval=1.0, maxval=3.0, step=0.1, group='🎯 Gap Sources')

// === MBZ DETECTION SETTINGS ===
wick_dominance_tier = input.string(WICK_TIER_STANDARD, 'Wick Dominance Tier', options=[WICK_TIER_STANDARD, WICK_TIER_RELAXED, WICK_TIER_RISKY], group='🔍 MBZ Detection')

// === MBZ BREACH SETTINGS ===
breach_confirmation_mode = input.string(CONFIRMATION_DISTANCE_ONLY, 'Breach Confirmation', options=[CONFIRMATION_DISTANCE_ONLY, CONFIRMATION_TIME_ONLY, CONFIRMATION_HYBRID_OR, CONFIRMATION_HYBRID_AND], group='⚡ MBZ Breach')
breach_distance_pips = input.int(DEFAULT_BREACH_DISTANCE, 'Distance (pips)', minval=1, maxval=50, group='⚡ MBZ Breach')
breach_time_bars = input.int(DEFAULT_BREACH_TIME, 'Time (bars)', minval=1, maxval=20, group='⚡ MBZ Breach')

// === MBZ INVALIDATION SETTINGS ===
mbz_invalidation_mode = input.string(INVALIDATION_STANDARD, 'Invalidation Mode', options=[INVALIDATION_STANDARD, INVALIDATION_STRICT, INVALIDATION_CUSTOM], group='❌ MBZ Invalidation')
custom_invalidation_threshold = input.float(100, 'Custom Threshold (%)', minval=50, maxval=100, step=5, group='❌ MBZ Invalidation')

// === VISUAL SETTINGS ===
// Color settings
mbz_bullish_color = input.color(color.new(color.green, DEFAULT_TRANSPARENCY), 'Bullish MBZ', group='🎨 Colors')
mbz_bearish_color = input.color(color.new(color.red, DEFAULT_TRANSPARENCY), 'Bearish MBZ', group='🎨 Colors')
mbz_super_bullish_color = input.color(color.new(color.lime, DEFAULT_TRANSPARENCY), 'Super Bullish', group='🎨 Colors')
mbz_super_bearish_color = input.color(color.new(color.orange, DEFAULT_TRANSPARENCY), 'Super Bearish', group='🎨 Colors')
mbz_breached_color = input.color(color.new(color.gray, DEFAULT_TRANSPARENCY), 'Breached MBZ', group='🎨 Colors')

// Display settings
mbz_display_mode = input.string(DISPLAY_ARROW_TEXT, 'Display Mode', options=[DISPLAY_ARROW_ONLY, DISPLAY_TEXT_ONLY, DISPLAY_ARROW_TEXT], group='📺 Display')
show_mbz_zones = input.bool(true, 'Show MBZ Zones', group='📺 Display')
show_body_highlights = input.bool(false, 'Show Body Highlights', group='📺 Display')
mbz_text_size = input.string('small', 'Text Size', options=['tiny', 'small', 'normal', 'large'], group='📺 Display')

// Invalidated MBZ display
invalidated_mbz_display = input.string(INVALIDATED_DISPLAY_LABELS, 'Show Invalidated MBZs', options=[INVALIDATED_DISPLAY_OFF, INVALIDATED_DISPLAY_LABELS, INVALIDATED_DISPLAY_LABELS_ZONES], group='📺 Display')

// === ALERT SETTINGS ===
enable_mbz_alerts = input.bool(true, 'MBZ Formation Alerts', group='🔔 Alerts')
enable_breach_alerts = input.bool(false, 'Breach Alerts', group='🔔 Alerts')
enable_super_mbz_alerts = input.bool(false, 'Super MBZ Alerts', group='🔔 Alerts')

// ═══════════════════════════════════════════════════════════════════════════════
// CORE DETECTION FUNCTIONS - ALGORITHMIC IMPLEMENTATIONS
// ═══════════════════════════════════════════════════════════════════════════════

// @function is_bullish_fvg
// @description Detects bullish Fair Value Gap pattern (3-candle upward gap)
// @returns bool True if current candle low > 2-candles-ago high (upward gap exists)
is_bullish_fvg() => low > high[2]

// @function is_bearish_fvg
// @description Detects bearish Fair Value Gap pattern (3-candle downward gap)
// @returns bool True if current candle high < 2-candles-ago low (downward gap exists)
is_bearish_fvg() => high < low[2]

// @function is_bullish_true_gap
// @description Detects bullish True Gap pattern (2-candle upward gap)
// @returns bool True if previous candle high < current candle low (classic upward gap)
is_bullish_true_gap() => high[1] < low

// @function is_bearish_true_gap
// @description Detects bearish True Gap pattern (2-candle downward gap)
// @returns bool True if previous candle low > current candle high (classic downward gap)
is_bearish_true_gap() => low[1] > high

// @function is_bullish_vi
// @description Detects bullish Volume Imbalance (2-candle body gap with wick connection)
// @returns bool True if candle bodies are separated but wicks still connect
is_bullish_vi() =>
    bodies_separated = math.min(open, close) > math.max(open[1], close[1])
    wicks_still_connect = low <= high[1]
    bodies_separated and wicks_still_connect

// @function is_bearish_vi
// @description Detects bearish Volume Imbalance (2-candle body gap with wick connection)
// @returns bool True if candle bodies are separated but wicks still connect
is_bearish_vi() =>
    bodies_separated = math.max(open, close) < math.min(open[1], close[1])
    wicks_still_connect = high >= low[1]
    bodies_separated and wicks_still_connect

// @function is_displacement_valid
// @description Enhanced displacement validation for Implied FVGs with robust statistical analysis
// @param displacement_multiplier float Multiplier threshold for displacement validation
// @returns bool True if C2 (2-bars-ago) shows sufficient displacement vs recent average
is_displacement_valid(displacement_multiplier) =>
    // Enhanced algorithm: 10-candle sample with outlier filtering
    sample_size = 10

    // Collect candle ranges for statistical analysis
    ranges = array.new<float>()
    for i = 3 to sample_size + 2  // Start from 3 to avoid displacement candle
        candle_range = high[i] - low[i]
        if candle_range > 0
            array.push(ranges, candle_range)

    if array.size(ranges) < 5
        false  // Insufficient data
    else
        // Calculate average with outlier filtering (remove top 20%)
        array.sort(ranges, order.ascending)
        outlier_count = math.max(1, math.round(array.size(ranges) * 0.2))

        total = 0.0
        count = 0
        for i = 0 to array.size(ranges) - 1 - outlier_count
            total += array.get(ranges, i)
            count += 1

        if count > 0
            average_range = total / count
            displacement_range = high[2] - low[2]  // C2 range

            // Enhanced validation: displacement must be significant
            displacement_valid = displacement_range >= (average_range * displacement_multiplier)
            minimum_size_valid = displacement_range >= (average_range * 0.5)  // 50%+ of average minimum

            displacement_valid and minimum_size_valid
        else
            false

// @function detect_implied_fvg
// @description Detects Implied Fair Value Gaps with enhanced displacement and wick validation
// @returns tuple [bool, float, float, bool] [is_valid, bottom, top, is_bullish]
detect_implied_fvg() =>
    is_valid = false
    gap_bottom = 0.0
    gap_top = 0.0
    is_bullish = false

    // Displacement validation first (most restrictive check)
    displacement_valid = is_displacement_valid(displacement_multiplier)

    if displacement_valid
        // Check for bullish Implied FVG pattern
        bullish_bodies_separated = math.min(open, close) > math.max(open[2], close[2])  // C0 body above C2 body
        bullish_wicks_overlap = low <= high[2]  // But wicks still connect

        if bullish_bodies_separated and bullish_wicks_overlap
            is_valid := true
            gap_bottom := math.max(open[2], close[2])  // Top of C2 body
            gap_top := math.min(open, close)          // Bottom of C0 body
            is_bullish := true
        else
            // Check for bearish Implied FVG pattern
            bearish_bodies_separated = math.max(open, close) < math.min(open[2], close[2])  // C0 body below C2 body
            bearish_wicks_overlap = high >= low[2]  // But wicks still connect

            if bearish_bodies_separated and bearish_wicks_overlap
                is_valid := true
                gap_bottom := math.max(open, close)          // Top of C0 body
                gap_top := math.min(open[2], close[2])      // Bottom of C2 body
                is_bullish := false

    [is_valid, gap_bottom, gap_top, is_bullish]

// ═══════════════════════════════════════════════════════════════════════════════
// SUPPRESSION SYSTEM - INSTITUTIONAL PRIORITY ENFORCEMENT
// ═══════════════════════════════════════════════════════════════════════════════

// @function is_gap_overlapping
// @description Master suppression function implementing institutional hierarchy enforcement
// @param new_top float Upper boundary of new gap
// @param new_bottom float Lower boundary of new gap
// @param new_is_bullish bool Direction of new gap (true = bullish, false = bearish)
// @param new_gap_type string Gap type classification (GAP_TYPE_FVG, GAP_TYPE_IMPLIED, GAP_TYPE_TRUE, GAP_TYPE_VOLUME)
// @param existing_gaps array<GapData> Array of existing gaps to check against
// @returns bool True if new gap should be suppressed, false if should be added
is_gap_overlapping(new_top, new_bottom, new_is_bullish, new_gap_type, existing_gaps) =>
    // INSTITUTIONAL PRIORITY ENFORCEMENT:
    // FVG and Implied FVG: NEVER suppressed (institutional priority)
    // True Gap: Can be suppressed by FVG and Implied FVG only
    // Volume Imbalance: Can be suppressed by FVG, Implied FVG, and True Gap

    switch new_gap_type
        GAP_TYPE_FVG => false              // FVGs are never suppressed
        GAP_TYPE_IMPLIED => false          // Implied FVGs are never suppressed
        GAP_TYPE_TRUE => is_true_gap_suppressed(new_top, new_bottom, new_is_bullish, existing_gaps)
        GAP_TYPE_VOLUME => is_vi_suppressed(new_top, new_bottom, new_is_bullish, existing_gaps)
        => false

// @function is_true_gap_suppressed
// @description Checks if True Gap should be suppressed by institutional gaps (FVG, Implied FVG)
// @param true_top float True Gap upper boundary
// @param true_bottom float True Gap lower boundary
// @param is_true_bullish bool True Gap direction
// @param existing_gaps array<GapData> Array of existing gaps
// @returns bool True if True Gap should be suppressed
is_true_gap_suppressed(true_top, true_bottom, is_true_bullish, existing_gaps) =>
    should_suppress = false

    // Check against existing institutional gaps only
    for existing_gap in existing_gaps
        if (existing_gap.gap_type == GAP_TYPE_FVG or existing_gap.gap_type == GAP_TYPE_IMPLIED) and
           existing_gap.is_bullish == is_true_bullish and not existing_gap.is_inverted
            // Check for spatial overlap using mathematical intersection
            if true_bottom < existing_gap.top and true_top >= existing_gap.bottom
                should_suppress := true
                break  // First institutional gap wins

    should_suppress

// @function is_vi_suppressed
// @description Checks if Volume Imbalance should be suppressed by higher priority gaps
// @param vi_top float VI upper boundary
// @param vi_bottom float VI lower boundary
// @param is_vi_bullish bool VI direction
// @param existing_gaps array<GapData> Array of existing gaps
// @returns bool True if VI should be suppressed
is_vi_suppressed(vi_top, vi_bottom, is_vi_bullish, existing_gaps) =>
    should_suppress = false

    // Check against all higher priority gaps (FVG, Implied FVG, True Gap)
    for existing_gap in existing_gaps
        if (existing_gap.gap_type == GAP_TYPE_FVG or
            existing_gap.gap_type == GAP_TYPE_IMPLIED or
            existing_gap.gap_type == GAP_TYPE_TRUE) and
           existing_gap.is_bullish == is_vi_bullish and not existing_gap.is_inverted
            // Check for spatial overlap using mathematical intersection
            if vi_bottom < existing_gap.top and vi_top >= existing_gap.bottom
                should_suppress := true
                break  // First higher priority gap wins

    should_suppress

// ═══════════════════════════════════════════════════════════════════════════════
// MBZ ANALYSIS FUNCTIONS - COMPREHENSIVE CLASSIFICATION SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

// @function get_wick_dominance_analysis
// @description Analyzes candle for wick dominance classification with tiered thresholds
// @param candle_open float Candle open price
// @param candle_close float Candle close price
// @param candle_high float Candle high price
// @param candle_low float Candle low price
// @returns tuple [string, bool] [wick_tier_classification, has_dominant_wick]
get_wick_dominance_analysis(candle_open, candle_close, candle_high, candle_low) =>
    body_size = math.abs(candle_close - candle_open)
    upper_wick = candle_high - math.max(candle_open, candle_close)
    lower_wick = math.min(candle_open, candle_close) - candle_low

    max_wick = math.max(upper_wick, lower_wick)
    max_ratio = body_size > 0 ? max_wick / body_size : 0

    // Tiered wick dominance classification
    if max_ratio >= 1.0       // 100%+ wick dominance
        [WICK_TIER_STANDARD, true]
    else if max_ratio >= 0.85  // 85%+ wick dominance
        [WICK_TIER_RELAXED, true]
    else if max_ratio >= 0.80  // 80%+ wick dominance
        [WICK_TIER_RISKY, true]
    else
        [WICK_TIER_NONE, false]

// @function analyze_mbz_formation
// @description Comprehensive MBZ analysis including subtype classification and validation
// @param gap GapData The gap data to analyze for MBZ formation
// @returns tuple [bool, MBZRecord] [is_valid_mbz, mbz_record_or_na]
analyze_mbz_formation(gap) =>
    is_valid = false
    mbz_record = MBZRecord.new(na, na, na, na, na, false, false, 0.0, false, "", "", "", na, na, false, 0.0, na)

    // Get candle data for the gap's anchor candle
    anchor_open = open[bar_index - gap.anchor_bar]
    anchor_close = close[bar_index - gap.anchor_bar]
    anchor_high = high[bar_index - gap.anchor_bar]
    anchor_low = low[bar_index - gap.anchor_bar]

    // Analyze wick dominance for the anchor candle
    [wick_tier, has_dominant_wick] = get_wick_dominance_analysis(anchor_open, anchor_close, anchor_high, anchor_low)

    // Check if wick dominance meets user's selected tier
    wick_meets_criteria = switch wick_dominance_tier
        WICK_TIER_STANDARD => wick_tier == WICK_TIER_STANDARD
        WICK_TIER_RELAXED => wick_tier == WICK_TIER_STANDARD or wick_tier == WICK_TIER_RELAXED
        WICK_TIER_RISKY => wick_tier == WICK_TIER_STANDARD or wick_tier == WICK_TIER_RELAXED or wick_tier == WICK_TIER_RISKY
        => false

    if wick_meets_criteria
        is_valid := true

        // Determine MBZ subtype based on gap type and wick characteristics
        mbz_subtype = switch gap.gap_type
            GAP_TYPE_FVG =>
                if has_dominant_wick
                    gap.is_bullish ?
                        (upper_wick > lower_wick ? SUBTYPE_INCLUSION : SUBTYPE_REFLECTION) :
                        (lower_wick > upper_wick ? SUBTYPE_INCLUSION : SUBTYPE_REFLECTION)
                else
                    SUBTYPE_STANDARD
            GAP_TYPE_IMPLIED =>
                if has_dominant_wick
                    gap.is_bullish ?
                        (upper_wick > lower_wick ? SUBTYPE_IMPLIED_INCLUSION : SUBTYPE_IMPLIED_REFLECTION) :
                        (lower_wick > upper_wick ? SUBTYPE_IMPLIED_INCLUSION : SUBTYPE_IMPLIED_REFLECTION)
                else
                    SUBTYPE_IMPLIED
            GAP_TYPE_VOLUME =>
                if has_dominant_wick
                    gap.is_bullish ?
                        (upper_wick > lower_wick ? SUBTYPE_VOLUME_INCLUSION : SUBTYPE_VOLUME_REFLECTION) :
                        (lower_wick > upper_wick ? SUBTYPE_VOLUME_INCLUSION : SUBTYPE_VOLUME_REFLECTION)
                else
                    SUBTYPE_VOLUME
            GAP_TYPE_TRUE =>
                if has_dominant_wick
                    gap.is_bullish ?
                        (upper_wick > lower_wick ? SUBTYPE_TRUE_INCLUSION : SUBTYPE_TRUE_REFLECTION) :
                        (lower_wick > upper_wick ? SUBTYPE_TRUE_INCLUSION : SUBTYPE_TRUE_REFLECTION)
                else
                    SUBTYPE_TRUE
            => SUBTYPE_STANDARD

        // Create MBZ record with comprehensive zone calculation
        mbz_open = anchor_open
        mbz_close = anchor_close
        mbz_high = math.max(gap.top, anchor_high)
        mbz_low = math.min(gap.bottom, anchor_low)

        // Pre-compute label text for performance
        label_text = get_mbz_label_text(mbz_subtype, gap.gap_type)
        tooltip_text = get_mbz_tooltip(mbz_subtype, gap.gap_type, has_dominant_wick)

        mbz_record := MBZRecord.new(
            gap.anchor_bar,           // bar_index
            mbz_open,                 // mbz_open
            mbz_close,                // mbz_close
            mbz_high,                 // mbz_high
            mbz_low,                  // mbz_low
            gap.is_bullish,           // is_bullish
            false,                    // is_breached (initially false)
            0.0,                      // breach_percentage
            has_dominant_wick,        // has_dominant_wick
            mbz_subtype,              // mbz_subtype
            label_text,               // cached_label_text
            tooltip_text,             // cached_tooltip
            na,                       // mbz_label (will be created later)
            gap.gap_id,               // source_gap_id
            false,                    // is_super_mbz (will be calculated)
            0.0,                      // overlap_percentage
            na                        // overlapping_mbz_bar_index
        )

    [is_valid, mbz_record]

// @function get_mbz_label_text
// @description Generates display text for MBZ labels based on subtype
// @param subtype string MBZ subtype classification
// @param gap_type string Originating gap type
// @returns string Formatted label text
get_mbz_label_text(subtype, gap_type) =>
    base_text = switch gap_type
        GAP_TYPE_FVG => "MBZ"
        GAP_TYPE_IMPLIED => "iMBZ"
        GAP_TYPE_VOLUME => "vMBZ"
        GAP_TYPE_TRUE => "tMBZ"
        => "MBZ"

    modifier = switch subtype
        SUBTYPE_INCLUSION, SUBTYPE_IMPLIED_INCLUSION, SUBTYPE_VOLUME_INCLUSION, SUBTYPE_TRUE_INCLUSION => "+"
        SUBTYPE_REFLECTION, SUBTYPE_IMPLIED_REFLECTION, SUBTYPE_VOLUME_REFLECTION, SUBTYPE_TRUE_REFLECTION => "-"
        => ""

    base_text + modifier

// @function get_mbz_tooltip
// @description Generates detailed tooltip for MBZ with classification information
// @param subtype string MBZ subtype
// @param gap_type string Originating gap type
// @param has_dominant_wick bool Whether MBZ has wick dominance
// @returns string Formatted tooltip text
get_mbz_tooltip(subtype, gap_type, has_dominant_wick) =>
    gap_name = switch gap_type
        GAP_TYPE_FVG => "Fair Value Gap"
        GAP_TYPE_IMPLIED => "Implied FVG"
        GAP_TYPE_VOLUME => "Volume Imbalance"
        GAP_TYPE_TRUE => "True Gap"
        => "Unknown"

    wick_info = has_dominant_wick ? " (Wick Dominant)" : " (Standard)"

    "MBZ from " + gap_name + wick_info

// ═══════════════════════════════════════════════════════════════════════════════
// BREACH DETECTION SYSTEM - COMPREHENSIVE VALIDATION
// ═══════════════════════════════════════════════════════════════════════════════

// @function get_mbz_breach_threshold
// @description Gets current breach threshold percentage based on user settings
// @returns float Breach threshold as percentage (0.0 to 1.0)
get_mbz_breach_threshold() =>
    switch mbz_invalidation_mode
        INVALIDATION_STANDARD => 1.0      // 100% breach required
        INVALIDATION_STRICT => 0.85       // 85% breach required
        INVALIDATION_CUSTOM => custom_invalidation_threshold / 100.0
        => 1.0

// @function calculate_breach_percentage
// @description Calculates how much of MBZ zone has been breached by current price
// @param mbz_high float MBZ upper boundary
// @param mbz_low float MBZ lower boundary
// @param current_price float Current market price
// @param is_bullish bool MBZ direction (true = bullish, false = bearish)
// @returns float Breach percentage (0.0 to 100.0)
calculate_breach_percentage(mbz_high, mbz_low, current_price, is_bullish) =>
    zone_size = mbz_high - mbz_low
    if zone_size <= 0
        0.0
    else
        penetration = is_bullish ?
            math.max(0, mbz_high - current_price) :    // Bullish: penetration from top
            math.max(0, current_price - mbz_low)       // Bearish: penetration from bottom
        math.min(100.0, (penetration / zone_size) * 100.0)

// @function is_mbz_breached
// @description Comprehensive breach detection with distance and time confirmation
// @param mbz MBZRecord MBZ to check for breach
// @returns bool True if MBZ meets breach criteria
is_mbz_breached(mbz) =>
    if mbz.is_breached
        true  // Already confirmed breached
    else
        // Calculate current breach percentage
        current_breach = calculate_breach_percentage(mbz.mbz_high, mbz.mbz_low, close, mbz.is_bullish)
        breach_threshold = get_mbz_breach_threshold()
        percentage_breached = current_breach >= (breach_threshold * 100.0)

        if percentage_breached
            // Apply breach confirmation logic
            switch breach_confirmation_mode
                CONFIRMATION_DISTANCE_ONLY =>
                    distance_confirmed = current_breach >= ((breach_threshold * 100.0) + breach_distance_pips)
                    distance_confirmed

                CONFIRMATION_TIME_ONLY =>
                    time_confirmed = (bar_index - mbz.bar_index) >= breach_time_bars
                    time_confirmed

                CONFIRMATION_HYBRID_OR =>
                    distance_confirmed = current_breach >= ((breach_threshold * 100.0) + breach_distance_pips)
                    time_confirmed = (bar_index - mbz.bar_index) >= breach_time_bars
                    distance_confirmed or time_confirmed

                CONFIRMATION_HYBRID_AND =>
                    distance_confirmed = current_breach >= ((breach_threshold * 100.0) + breach_distance_pips)
                    time_confirmed = (bar_index - mbz.bar_index) >= breach_time_bars
                    distance_confirmed and time_confirmed

                => false
        else
            false

// ═══════════════════════════════════════════════════════════════════════════════
// VISUAL RENDERING SYSTEM - OPTIMIZED DISPLAY MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

// @function get_mbz_colors
// @description Determines appropriate colors for MBZ visual elements
// @param mbz MBZRecord MBZ record to get colors for
// @returns tuple [color, color] [zone_color, border_color]
get_mbz_colors(mbz) =>
    if mbz.is_breached
        [mbz_breached_color, color.gray]
    else if mbz.is_super_mbz
        if mbz.is_bullish
            [mbz_super_bullish_color, color.lime]
        else
            [mbz_super_bearish_color, color.orange]
    else
        if mbz.is_bullish
            [mbz_bullish_color, color.green]
        else
            [mbz_bearish_color, color.red]

// @function create_mbz_zone
// @description Creates visual zone box for MBZ with proper styling
// @param mbz MBZRecord MBZ record
// @returns box Visual zone box
create_mbz_zone(mbz) =>
    [zone_color, border_color] = get_mbz_colors(mbz)

    box.new(
        left=mbz.bar_index,
        top=mbz.mbz_high,
        right=mbz.bar_index + BOX_EXTENSION_BARS,
        bottom=mbz.mbz_low,
        bgcolor=zone_color,
        border_color=border_color,
        border_width=1,
        extend=extend.right
    )

// @function create_mbz_label
// @description Creates identification label for MBZ with appropriate styling
// @param mbz MBZRecord MBZ record
// @returns label Visual label
create_mbz_label(mbz) =>
    [zone_color, label_color] = get_mbz_colors(mbz)
    text_size = get_text_size(mbz_text_size)

    label_y_position = mbz.is_bullish ? mbz.mbz_low : mbz.mbz_high
    label_style = mbz.is_bullish ? label.style_label_up : label.style_label_down

    // Choose display content based on user preference
    display_text = switch mbz_display_mode
        DISPLAY_ARROW_ONLY => ""
        DISPLAY_TEXT_ONLY => mbz.cached_label_text
        DISPLAY_ARROW_TEXT => mbz.cached_label_text
        => mbz.cached_label_text

    label.new(
        x=mbz.bar_index,
        y=label_y_position,
        text=display_text,
        style=label_style,
        color=label_color,
        textcolor=color.white,
        size=text_size,
        tooltip=mbz.cached_tooltip
    )

// @function create_body_highlight
// @description Creates body highlight box for MBZ candle
// @param mbz MBZRecord MBZ record
// @returns box Body highlight box
create_body_highlight(mbz) =>
    [zone_color, border_color] = get_mbz_colors(mbz)

    box.new(
        left=mbz.bar_index,
        top=mbz.mbz_open,
        right=mbz.bar_index + 1,
        bottom=mbz.mbz_close,
        bgcolor=color.new(zone_color, 70),  // More transparent for body highlight
        border_color=border_color,
        border_width=2
    )

// @function get_text_size
// @description Converts text size string to Pine Script size constant
// @param size_string string Size designation
// @returns string Pine Script size constant
get_text_size(size_string) =>
    switch size_string
        "tiny" => size.tiny
        "small" => size.small
        "normal" => size.normal
        "large" => size.large
        => size.small

// ═══════════════════════════════════════════════════════════════════════════════
// ARRAY MANAGEMENT - SYSTEMATIC CLEANUP AND PERFORMANCE OPTIMIZATION
// ═══════════════════════════════════════════════════════════════════════════════

// @function cleanup_arrays
// @description Maintains all arrays within their size limits with proper visual cleanup
cleanup_arrays() =>
    // Clean active gaps array (FIFO)
    while array.size(active_gaps) > MAX_ACTIVE_GAPS
        array.shift(active_gaps)

    // Clean MBZ records with visual element cleanup
    while array.size(mbz_records) > MAX_MBZ_RECORDS
        old_mbz = array.shift(mbz_records)
        // Clean associated visual elements
        if not na(old_mbz.mbz_label)
            label.delete(old_mbz.mbz_label)

    // Clean visual arrays (FIFO)
    while array.size(mbz_zones) > MAX_MBZ_ZONES
        old_box = array.shift(mbz_zones)
        box.delete(old_box)

    while array.size(mbz_body_highlights) > MAX_MBZ_BODY_HIGHLIGHTS
        old_highlight = array.shift(mbz_body_highlights)
        box.delete(old_highlight)

    while array.size(mbz_labels) > MAX_MBZ_LABELS
        old_label = array.shift(mbz_labels)
        label.delete(old_label)

// @function update_gap_inversion_status
// @description Updates inversion status for all active gaps based on current price action
update_gap_inversion_status() =>
    for gap in active_gaps
        if not gap.is_inverted
            // Check if gap has been filled (inverted)
            gap_filled = gap.is_bullish ? close <= gap.bottom : close >= gap.top
            if gap_filled
                gap.is_inverted := true

// ═══════════════════════════════════════════════════════════════════════════════
// MAIN PROCESSING LOGIC - SYSTEMATIC EXECUTION PIPELINE
// ═══════════════════════════════════════════════════════════════════════════════

// Real-time gap detection and MBZ analysis
if barstate.isconfirmed

    // === FAIR VALUE GAP DETECTION ===
    if enable_fair_value_gaps
        // Bullish FVG detection
        if is_bullish_fvg()
            gap_top = low        // Current candle low (higher value)
            gap_bottom = high[2] // 2-bars-ago high (lower value)

            // COORDINATE VALIDATION: Ensure gap_top > gap_bottom (prevents MBZ v7.1-v7.4 bugs)
            if gap_top > gap_bottom and not is_gap_overlapping(gap_top, gap_bottom, true, GAP_TYPE_FVG, active_gaps)
                gap_data = GapData.new(bar_index - 2, gap_top, gap_bottom, true, false, bar_index, next_gap_id, GAP_TYPE_FVG)
                array.push(active_gaps, gap_data)
                next_gap_id += 1

        // Bearish FVG detection
        if is_bearish_fvg()
            // CRITICAL FIX: Corrected coordinate reversal bug (MBZ v7.1-v7.4 issue)
            gap_top = low[2]     // 2-bars-ago low (higher value) - CORRECTED
            gap_bottom = high    // Current candle high (lower value) - CORRECTED

            // COORDINATE VALIDATION: Ensure gap_top > gap_bottom
            if gap_top > gap_bottom and not is_gap_overlapping(gap_top, gap_bottom, false, GAP_TYPE_FVG, active_gaps)
                gap_data = GapData.new(bar_index - 2, gap_top, gap_bottom, false, false, bar_index, next_gap_id, GAP_TYPE_FVG)
                array.push(active_gaps, gap_data)
                next_gap_id += 1

    // === IMPLIED FVG DETECTION ===
    if enable_implied
        [is_implied_valid, implied_bottom, implied_top, implied_bullish] = detect_implied_fvg()
        if is_implied_valid and not is_gap_overlapping(implied_top, implied_bottom, implied_bullish, GAP_TYPE_IMPLIED, active_gaps)
            gap_data = GapData.new(bar_index - 2, implied_top, implied_bottom, implied_bullish, false, bar_index, next_gap_id, GAP_TYPE_IMPLIED)
            array.push(active_gaps, gap_data)
            next_gap_id += 1

    // === TRUE GAP DETECTION ===
    if enable_true_gaps
        // Bullish True Gap
        if is_bullish_true_gap()
            gap_top = low        // Current candle low
            gap_bottom = high[1] // Previous candle high

            if gap_top > gap_bottom and not is_gap_overlapping(gap_top, gap_bottom, true, GAP_TYPE_TRUE, active_gaps)
                gap_data = GapData.new(bar_index - 1, gap_top, gap_bottom, true, false, bar_index, next_gap_id, GAP_TYPE_TRUE)
                array.push(active_gaps, gap_data)
                next_gap_id += 1

        // Bearish True Gap
        if is_bearish_true_gap()
            gap_top = low[1]     // Previous candle low
            gap_bottom = high    // Current candle high

            if gap_top > gap_bottom and not is_gap_overlapping(gap_top, gap_bottom, false, GAP_TYPE_TRUE, active_gaps)
                gap_data = GapData.new(bar_index - 1, gap_top, gap_bottom, false, false, bar_index, next_gap_id, GAP_TYPE_TRUE)
                array.push(active_gaps, gap_data)
                next_gap_id += 1

    // === VOLUME IMBALANCE DETECTION ===
    if enable_volume_imbalance
        // Bullish VI
        if is_bullish_vi()
            gap_top = math.min(open, close)          // Current candle body bottom
            gap_bottom = math.max(open[1], close[1]) // Previous candle body top

            if gap_top > gap_bottom and not is_gap_overlapping(gap_top, gap_bottom, true, GAP_TYPE_VOLUME, active_gaps)
                gap_data = GapData.new(bar_index - 1, gap_top, gap_bottom, true, false, bar_index, next_gap_id, GAP_TYPE_VOLUME)
                array.push(active_gaps, gap_data)
                next_gap_id += 1

        // Bearish VI
        if is_bearish_vi()
            gap_top = math.min(open[1], close[1])   // Previous candle body bottom
            gap_bottom = math.max(open, close)       // Current candle body top

            if gap_top > gap_bottom and not is_gap_overlapping(gap_top, gap_bottom, false, GAP_TYPE_VOLUME, active_gaps)
                gap_data = GapData.new(bar_index - 1, gap_top, gap_bottom, false, false, bar_index, next_gap_id, GAP_TYPE_VOLUME)
                array.push(active_gaps, gap_data)
                next_gap_id += 1

// === MBZ ANALYSIS AND CREATION ===
// Process new gaps for MBZ formation potential
for gap in active_gaps
    if not gap.is_inverted  // Only analyze unfilled gaps
        [is_valid_mbz, mbz_record] = analyze_mbz_formation(gap)

        if is_valid_mbz
            // Check if this gap already formed an MBZ
            already_processed = false
            for existing_mbz in mbz_records
                if existing_mbz.source_gap_id == gap.gap_id
                    already_processed := true
                    break

            if not already_processed
                // Create visual elements for the MBZ
                if show_mbz_zones
                    zone_box = create_mbz_zone(mbz_record)
                    array.push(mbz_zones, zone_box)

                if mbz_display_mode != DISPLAY_ARROW_ONLY
                    mbz_label = create_mbz_label(mbz_record)
                    mbz_record.mbz_label := mbz_label
                    array.push(mbz_labels, mbz_label)

                if show_body_highlights
                    body_highlight = create_body_highlight(mbz_record)
                    array.push(mbz_body_highlights, body_highlight)

                // Add MBZ to records
                array.push(mbz_records, mbz_record)

                // Fire alerts if enabled
                if enable_mbz_alerts
                    alert("MBZ Formed: " + mbz_record.cached_label_text, alert.freq_once_per_bar)

// === BREACH DETECTION AND UPDATES ===
// Update breach status for existing MBZs
for mbz in mbz_records
    if not mbz.is_breached
        if is_mbz_breached(mbz)
            mbz.is_breached := true
            mbz.breach_percentage := calculate_breach_percentage(mbz.mbz_high, mbz.mbz_low, close, mbz.is_bullish)

            // Update visual elements for breached MBZ
            if not na(mbz.mbz_label) and invalidated_mbz_display == INVALIDATED_DISPLAY_OFF
                label.delete(mbz.mbz_label)
                mbz.mbz_label := na

            // Fire breach alert if enabled
            if enable_breach_alerts
                alert("MBZ Breached: " + mbz.cached_label_text, alert.freq_once_per_bar)

// === SYSTEM MAINTENANCE ===
// Update gap inversion status based on current price
update_gap_inversion_status()

// Clean up arrays to maintain performance
cleanup_arrays()

// ═══════════════════════════════════════════════════════════════════════════════
// ALERT CONDITIONS - COMPREHENSIVE NOTIFICATION SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

// MBZ Formation Alert
mbz_formed = array.size(mbz_records) > array.size(mbz_records)[1]
alertcondition(mbz_formed and enable_mbz_alerts, title='MBZ Formed', message='New MBZ formation detected')

// MBZ Breach Alert
mbz_breached_condition = false
for mbz in mbz_records
    if mbz.is_breached and mbz.breach_percentage[1] < get_mbz_breach_threshold() * 100
        mbz_breached_condition := true
        break

alertcondition(mbz_breached_condition and enable_breach_alerts, title='MBZ Breached', message='MBZ breach confirmed')

// Super MBZ Alert (based on advanced criteria)
super_mbz_formed = false
for mbz in mbz_records
    if mbz.is_super_mbz and not mbz.is_super_mbz[1]  // Newly classified as super MBZ
        super_mbz_formed := true
        break

alertcondition(super_mbz_formed and enable_super_mbz_alerts, title='Super MBZ', message='High-priority MBZ formation')

// MBZ Hunter° [Pro+] [v8.0-final] - FINAL: Complete MBZ detection system with critical coordinate bug fixed, comprehensive documentation, and proven suppression hierarchy from battle-tested algorithms