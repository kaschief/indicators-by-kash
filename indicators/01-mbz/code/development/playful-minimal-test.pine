        array.push(session5_low_used_by_pattern, false)
        array.push(session5_high_pattern_type, '')
        array.push(session5_low_pattern_type, '')

        max_session5_entries = math.min(session5ShowLast, MAX_SESSION_LEVELS)
        while array.size(session5_highs) > max_session5_entries
            array.shift(session5_highs)
            array.shift(session5_lows)
            array.shift(session5_times)
            array.shift(session5_high_times)
            array.shift(session5_low_times)
            array.shift(session5_high_breached)
            array.shift(session5_low_breached)
            array.shift(session5_high_breach_times)
            array.shift(session5_low_breach_times)
            array.shift(session5_high_used_by_pattern)
            array.shift(session5_low_used_by_pattern)
            array.shift(session5_high_pattern_type)
            array.shift(session5_low_pattern_type)

    if session5_session_ended
        session5_current_high := na
        session5_current_low := na
        session5_current_high_time := na
        session5_current_low_time := na

    session5_in_session_prev := session5_in_session
else
