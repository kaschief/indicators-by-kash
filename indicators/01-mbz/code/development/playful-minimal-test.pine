        standard_label_with_sign := STANDARD_LABEL_TEXT + (close < open ? '⁻' : close > open ? '⁺' : '')
    if delayed_levels_used > 0
        delayed_label_with_sign := DELAYED_LABEL_TEXT + (close < open ? '⁻' : close > open ? '⁺' : '')

if showSession4
    [session4_immediate, session4_standard, session4_delayed, session4_immediate_high_count, session4_immediate_low_count, session4_standard_high_count, session4_standard_low_count, session4_delayed_high_count, session4_delayed_low_count] = detect_pool_patterns(showSession4, session4_highs, session4_lows, session4_high_breach_times, session4_low_breach_times, session4_high_used_by_pattern, session4_low_used_by_pattern, session4_high_pattern_type, session4_low_pattern_type)
    session4_imm_detected := session4_immediate
    session4_std_detected := session4_standard
    session4_del_detected := session4_delayed
    immediate_detected := immediate_detected or session4_immediate
    standard_detected := standard_detected or session4_standard
    delayed_detected := delayed_detected or session4_delayed
    immediate_levels_used += session4_immediate_high_count + session4_immediate_low_count
    standard_levels_used += session4_standard_high_count + session4_standard_low_count
    delayed_levels_used += session4_delayed_high_count + session4_delayed_low_count
    immediate_high_levels_used += session4_immediate_high_count
    immediate_low_levels_used += session4_immediate_low_count
    standard_high_levels_used += session4_standard_high_count
    standard_low_levels_used += session4_standard_low_count
    delayed_high_levels_used += session4_delayed_high_count
    delayed_low_levels_used += session4_delayed_low_count

    if immediate_levels_used > 0
        immediate_label_with_sign := IMMEDIATE_LABEL_TEXT + (close < open ? '⁻' : close > open ? '⁺' : '')
    if standard_levels_used > 0
        standard_label_with_sign := STANDARD_LABEL_TEXT + (close < open ? '⁻' : close > open ? '⁺' : '')
    if delayed_levels_used > 0
        delayed_label_with_sign := DELAYED_LABEL_TEXT + (close < open ? '⁻' : close > open ? '⁺' : '')

if showSession5
    [session5_immediate, session5_standard, session5_delayed, session5_immediate_high_count, session5_immediate_low_count, session5_standard_high_count, session5_standard_low_count, session5_delayed_high_count, session5_delayed_low_count] = detect_pool_patterns(showSession5, session5_highs, session5_lows, session5_high_breach_times, session5_low_breach_times, session5_high_used_by_pattern, session5_low_used_by_pattern, session5_high_pattern_type, session5_low_pattern_type)
    session5_imm_detected := session5_immediate
    session5_std_detected := session5_standard
    session5_del_detected := session5_delayed
    immediate_detected := immediate_detected or session5_immediate
    standard_detected := standard_detected or session5_standard
    delayed_detected := delayed_detected or session5_delayed
    immediate_levels_used += session5_immediate_high_count + session5_immediate_low_count
    standard_levels_used += session5_standard_high_count + session5_standard_low_count
    delayed_levels_used += session5_delayed_high_count + session5_delayed_low_count
    immediate_high_levels_used += session5_immediate_high_count
    immediate_low_levels_used += session5_immediate_low_count
    standard_high_levels_used += session5_standard_high_count
    standard_low_levels_used += session5_standard_low_count
    delayed_high_levels_used += session5_delayed_high_count
    delayed_low_levels_used += session5_delayed_low_count

    if immediate_levels_used > 0
        immediate_label_with_sign := IMMEDIATE_LABEL_TEXT + (close < open ? '⁻' : close > open ? '⁺' : '')
    if standard_levels_used > 0
        standard_label_with_sign := STANDARD_LABEL_TEXT + (close < open ? '⁻' : close > open ? '⁺' : '')
    if delayed_levels_used > 0
        delayed_label_with_sign := DELAYED_LABEL_TEXT + (close < open ? '⁻' : close > open ? '⁺' : '')

color final_bar_color = na
if highlightDelayedType and delayed_detected
    final_bar_color := delayedHighlightColor
else if highlightStandardType and standard_detected
    final_bar_color := standardHighlightColor
else if highlightImmediateType and immediate_detected
    final_bar_color := immediateHighlightColor

barcolor(final_bar_color)

if barstate.isconfirmed
    if highlightDelayedType and delayed_detected
        create_pattern_label(delayed_label_with_sign, delayedLabelTextColor, delayed_levels_used)
    else if highlightStandardType and standard_detected
        create_pattern_label(standard_label_with_sign, standardLabelTextColor, standard_levels_used)
    else if highlightImmediateType and immediate_detected
        create_pattern_label(immediate_label_with_sign, immediateLabelTextColor, immediate_levels_used)


