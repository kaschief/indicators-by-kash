//@version=6

// ═══════════════════════════════════════════════════════════════════════════════
// INDICATOR SETUP (Multi-timeframe liquidity baseline)
// ═══════════════════════════════════════════════════════════════════════════════
INDICATOR_MAX_LINES = 300
INDICATOR_MAX_LABELS = 300
INDICATOR_TITLE = 'Playful Daily Baseline'

indicator(INDICATOR_TITLE, shorttitle='playful-daily', overlay=true, max_lines_count=INDICATOR_MAX_LINES, max_labels_count=INDICATOR_MAX_LABELS)

// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS (mirrored from Playful)
// ═══════════════════════════════════════════════════════════════════════════════
DEFAULT_SHOW_LAST = 5
DEFAULT_LINE_WIDTH = 1
DEFAULT_LABEL_SIZE = 'Tiny'

MIN_SHOW_LAST = 1
MAX_SHOW_LAST = 50
MIN_LINE_WIDTH = 1
MAX_LINE_WIDTH = 5

DEFAULT_DAILY_HIGH_COLOR = #9c27b0
DEFAULT_DAILY_LOW_COLOR = #9c27b0
DEFAULT_WEEKLY_HIGH_COLOR = #ec407a
DEFAULT_WEEKLY_LOW_COLOR = #ec407a
DEFAULT_MONTHLY_HIGH_COLOR = #ff9800
DEFAULT_MONTHLY_LOW_COLOR = #ff9800
DEFAULT_LABEL_COLOR = #000000
DEFAULT_IMMEDIATE_HIGHLIGHT_COLOR = #ffeb3b
DEFAULT_STANDARD_HIGHLIGHT_COLOR = #ab47bc
DEFAULT_DELAYED_HIGHLIGHT_COLOR = #39ff14
DEFAULT_IMMEDIATE_LABEL_TEXT_COLOR = color.black
DEFAULT_STANDARD_LABEL_TEXT_COLOR = color.white
DEFAULT_DELAYED_LABEL_TEXT_COLOR = color.white

