weeklyLowColor = input.color(DEFAULT_WEEKLY_LOW_COLOR, 'Low Color', inline='weekly_colors', group='📅 Weekly')
weeklyLineWidth = input.int(4, 'Line Width', minval=MIN_LINE_WIDTH, maxval=MAX_LINE_WIDTH, group='📅 Weekly')

showMonthly = input.bool(true, 'Enable Monthly Levels', group='📅 Monthly')
showMonthlyLast = input.int(DEFAULT_SHOW_LAST, 'Show Last', minval=MIN_SHOW_LAST, maxval=MAX_SHOW_LAST, group='📅 Monthly')
monthlyHighColor = input.color(DEFAULT_MONTHLY_HIGH_COLOR, 'High Color', inline='monthly_colors', group='📅 Monthly')
monthlyLowColor = input.color(DEFAULT_MONTHLY_LOW_COLOR, 'Low Color', inline='monthly_colors', group='📅 Monthly')
monthlyLineWidth = input.int(5, 'Line Width', minval=MIN_LINE_WIDTH, maxval=MAX_LINE_WIDTH, group='📅 Monthly')

showSession1 = input.bool(true, 'Session 1', group='🕘 Sessions', inline='session1_base')
