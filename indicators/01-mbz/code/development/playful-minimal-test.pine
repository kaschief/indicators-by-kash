// ═══════════════════════════════════════════════════════════════════════════════
// UTILITY HELPERS (copied from Playful)
// ═══════════════════════════════════════════════════════════════════════════════
get_label_size() =>
    switch labelSize
        'Tiny' => size.tiny
        'Small' => size.small
        'Normal' => size.normal
        => size.small

pad_two_digits(value) => value < 10 ? '0' + str.tostring(value) : str.tostring(value)

get_day_name(time_value) =>
    day = dayofweek(time_value, NY_TIMEZONE)
    switch day
        dayofweek.monday => WEEKDAY_LABEL_MON
        dayofweek.tuesday => WEEKDAY_LABEL_TUE
        dayofweek.wednesday => WEEKDAY_LABEL_WED
        dayofweek.thursday => WEEKDAY_LABEL_THU
        dayofweek.friday => WEEKDAY_LABEL_FRI
        dayofweek.saturday => WEEKDAY_LABEL_SAT
        dayofweek.sunday => WEEKDAY_LABEL_SUN
        => ''

format_day_date(time_value) =>
    day_name = get_day_name(time_value)
    month_str = pad_two_digits(month(time_value, NY_TIMEZONE))
    day_str = pad_two_digits(dayofmonth(time_value, NY_TIMEZONE))
    day_name + ' ' + month_str + '/' + day_str

build_daily_label(time_value) =>
    if not appendTimeframeDateLabels or na(time_value)
        DAILY_TIMEFRAME_LABEL
    else
        DAILY_TIMEFRAME_LABEL + ' ' + format_day_date(time_value)

get_pattern_label_size() =>
    switch patternLabelSizeSetting
        'Tiny' => size.tiny
        'Small' => size.small
        'Normal' => size.normal
        'Large' => size.large
        'Huge' => size.huge
        => size.small

is_sunday_evening_reopen(time_value) =>
    not includeSundayReopen and dayofweek(time_value, NY_TIMEZONE) == dayofweek.sunday and hour(time_value, NY_TIMEZONE) >= SUNDAY_REOPEN_START_HOUR

is_new_day() =>
    prev_time = time[1]
    not na(prev_time) and dayofmonth(prev_time, NY_TIMEZONE) != dayofmonth(time, NY_TIMEZONE)

is_new_week() =>
    timeframe.change("1W")

build_weekly_label(time_value) =>
    if not appendTimeframeDateLabels or na(time_value)
        WEEKLY_TIMEFRAME_LABEL
    else
        // Calculate week start and end dates
        week_start_month = month(time_value, NY_TIMEZONE)
        week_start_day = dayofmonth(time_value, NY_TIMEZONE)

        // Add 6 days (in milliseconds) to get week end
        week_end_time = time_value + (6 * 24 * 60 * 60 * 1000)
        week_end_month = month(week_end_time, NY_TIMEZONE)
        week_end_day = dayofmonth(week_end_time, NY_TIMEZONE)

        // Format as M/D-M/D
        start_str = str.tostring(week_start_month) + '/' + str.tostring(week_start_day)
        end_str = str.tostring(week_end_month) + '/' + str.tostring(week_end_day)

        WEEKLY_TIMEFRAME_LABEL + ' ' + start_str + '-' + end_str

is_new_month() =>
    timeframe.change("1M")

build_monthly_label(time_value) =>
    if not appendTimeframeDateLabels or na(time_value)
        MONTHLY_TIMEFRAME_LABEL
    else
        month_str = str.tostring(month(time_value, NY_TIMEZONE))
        year_str = str.tostring(year(time_value, NY_TIMEZONE))
        MONTHLY_TIMEFRAME_LABEL + ' ' + month_str + '/' + year_str

parse_session_minutes(session_range) =>
    parts = str.split(session_range, '-')
    if array.size(parts) != 2
        [na, na]
    else
        start_str = array.get(parts, 0)
        end_str = array.get(parts, 1)
        start_hour = int(str.tonumber(str.substring(start_str, 0, 2)))
        start_minute = int(str.tonumber(str.substring(start_str, 2, 2)))
        end_hour = int(str.tonumber(str.substring(end_str, 0, 2)))
        end_minute = int(str.tonumber(str.substring(end_str, 2, 2)))
        if na(start_hour) or na(start_minute) or na(end_hour) or na(end_minute)
            [na, na]
        else
            [start_hour * 60 + start_minute, end_hour * 60 + end_minute]

minutes_to_hhmm(total_minutes) =>
    if na(total_minutes)
        '??:??'
    else
        normalized = (total_minutes % 1440 + 1440) % 1440
        hrs = int(math.floor(normalized / 60))
        mins = normalized % 60
        pad_two_digits(hrs) + ':' + pad_two_digits(mins)

format_session_range(start_minutes, end_minutes) =>
    minutes_to_hhmm(start_minutes) + '-' + minutes_to_hhmm(end_minutes)

build_session_label(session_name, reference_time, start_minutes, end_minutes) =>
    base_label = session_name
    if appendTimeframeDateLabels and not na(reference_time)
        base_label += ' ' + format_day_date(reference_time)
    if not na(start_minutes) and not na(end_minutes)
        base_label += ' ' + format_session_range(start_minutes, end_minutes)
    base_label

// Pattern detection copied verbatim from Playful
detect_pool_patterns(show_pool, array<float> levels_high, array<float> levels_low, array<int> high_breach_times, array<int> low_breach_times, array<bool> high_used_flags, array<bool> low_used_flags, array<string> high_pattern_types, array<string> low_pattern_types) =>
    immediate_found = false
    standard_found = false
    delayed_found = false
    immediate_high_count = 0
    immediate_low_count = 0
    standard_high_count = 0
    standard_low_count = 0
    delayed_high_count = 0
    delayed_low_count = 0
    if show_pool and array.size(levels_high) > 0 and array.size(levels_low) > 0 and array.size(high_breach_times) > 0 and array.size(low_breach_times) > 0
        has_previous_bar = not na(time[1]) and not na(open[1]) and not na(close[1]) and not na(high[1]) and not na(low[1])
        if has_previous_bar
            a_mid = (open[1] + close[1]) / 2.0

            if highlightImmediateType
                for i = 0 to array.size(levels_high) - 1
                    if array.get(high_breach_times, i) == time
                        level = array.get(levels_high, i)
                        if not na(level) and high[1] < level and close[1] < level and open < level and high > level and close < a_mid and close < open
                            immediate_found := true
                            if array.size(high_used_flags) > i and array.size(high_pattern_types) > i
                                array.set(high_used_flags, i, true)
                                array.set(high_pattern_types, i, IMMEDIATE_LABEL_TEXT)
                            immediate_high_count += 1

                for i = 0 to array.size(levels_low) - 1
                    if array.get(low_breach_times, i) == time
                        level = array.get(levels_low, i)
                        if not na(level) and low[1] > level and close[1] > level and open > level and low < level and close > a_mid and close > open
                            immediate_found := true
                            if array.size(low_used_flags) > i and array.size(low_pattern_types) > i
                                array.set(low_used_flags, i, true)
                                array.set(low_pattern_types, i, IMMEDIATE_LABEL_TEXT)
                            immediate_low_count += 1

            if highlightStandardType
                for i = 0 to array.size(levels_high) - 1
                    if array.get(high_breach_times, i) == time[1]
                        level = array.get(levels_high, i)
                        if not na(level) and close < open
                            is_wick_only_first_breach = open[1] < level and high[1] > level and close[1] < level
                            b_open_inside = open < level
                            b_close_beyond_mid = close < a_mid
                            b_no_new_high = high < high[1]
                            if is_wick_only_first_breach and b_open_inside and b_close_beyond_mid and b_no_new_high
                                standard_found := true
                                if array.size(high_used_flags) > i and array.size(high_pattern_types) > i
                                    array.set(high_used_flags, i, true)
                                    array.set(high_pattern_types, i, STANDARD_LABEL_TEXT)
                                standard_high_count += 1

                for i = 0 to array.size(levels_low) - 1
                    if array.get(low_breach_times, i) == time[1]
                        level = array.get(levels_low, i)
                        if not na(level) and close > open
                            is_wick_only_first_breach = open[1] > level and low[1] < level and close[1] > level
                            b_open_inside = open > level
                            b_close_beyond_mid = close > a_mid
                            b_no_new_low = low > low[1]
                            if is_wick_only_first_breach and b_open_inside and b_close_beyond_mid and b_no_new_low
                                standard_found := true
                                if array.size(low_used_flags) > i and array.size(low_pattern_types) > i
                                    array.set(low_used_flags, i, true)
                                    array.set(low_pattern_types, i, STANDARD_LABEL_TEXT)
                                standard_low_count += 1

            if highlightDelayedType
                for i = 0 to array.size(levels_high) - 1
                    if array.get(high_breach_times, i) == time[1]
                        level = array.get(levels_high, i)
                        if not na(level) and close < open
                            is_body_close_breach = close[1] > level
                            b_open_outside = open > level
                            b_close_beyond_mid = close < a_mid
                            if is_body_close_breach and b_open_outside and b_close_beyond_mid
                                delayed_found := true
                                if array.size(high_used_flags) > i and array.size(high_pattern_types) > i
                                    array.set(high_used_flags, i, true)
                                    array.set(high_pattern_types, i, DELAYED_LABEL_TEXT)
                                delayed_high_count += 1

                for i = 0 to array.size(levels_low) - 1
                    if array.get(low_breach_times, i) == time[1]
                        level = array.get(levels_low, i)
                        if not na(level) and close > open
                            is_body_close_breach = close[1] < level
                            b_open_outside = open < level
                            b_close_beyond_mid = close > a_mid
                            if is_body_close_breach and b_open_outside and b_close_beyond_mid
                                delayed_found := true
                                if array.size(low_used_flags) > i and array.size(low_pattern_types) > i
                                    array.set(low_used_flags, i, true)
                                    array.set(low_pattern_types, i, DELAYED_LABEL_TEXT)
                                delayed_low_count += 1

    [immediate_found, standard_found, delayed_found, immediate_high_count, immediate_low_count, standard_high_count, standard_low_count, delayed_high_count, delayed_low_count]

create_pattern_label(label_text, text_color, levels_used) =>
    if not na(low)
        price_range = high - low
        offset = math.max(price_range, syminfo.mintick * 50) * 0.25
        label_price = low - offset
        full_text = label_text
        if levels_used > 1
            full_text += '\n(' + str.tostring(levels_used) + ')'
        pattern_label = label.new(
             x=bar_index,
             y=label_price,
             text=full_text,
             style=label.style_label_up,
             textcolor=text_color,
             size=get_pattern_label_size(),
             color=color.new(color.white, 100),
             xloc=xloc.bar_index,
             yloc=yloc.price
         )
        array.push(pattern_labels, pattern_label)
        while array.size(pattern_labels) > MAX_PATTERN_LABELS
            old_pattern_label = array.shift(pattern_labels)
            if not na(old_pattern_label)
                label.delete(old_pattern_label)

// ═══════════════════════════════════════════════════════════════════════════════
// SESSION TRACKING
// ═══════════════════════════════════════════════════════════════════════════════
new_day = is_new_day()
new_week = is_new_week()
new_month = is_new_month()
new_bar = barstate.isnew

if showDaily
    skip_sunday_reopen = is_sunday_evening_reopen(time)
    if not skip_sunday_reopen
        if new_bar and new_day
            if not na(daily_session_high) and not na(daily_session_low)
                session_close_time = nz(time[1], time)
                array.push(daily_highs, daily_session_high)
                array.push(daily_lows, daily_session_low)
                array.push(daily_times, session_close_time)
                array.push(daily_high_times, daily_session_high_time)
                array.push(daily_low_times, daily_session_low_time)
                array.push(daily_high_breached, false)
                array.push(daily_low_breached, false)
                array.push(daily_high_breach_times, na)
                array.push(daily_low_breach_times, na)
                array.push(daily_high_used_by_pattern, false)
                array.push(daily_low_used_by_pattern, false)
                array.push(daily_high_pattern_type, "")
                array.push(daily_low_pattern_type, "")

                max_daily_entries = math.min(showDailyLast, MAX_SESSION_LEVELS)
                while array.size(daily_highs) > max_daily_entries
                    array.shift(daily_highs)
                    array.shift(daily_lows)
                    array.shift(daily_times)
                    array.shift(daily_high_times)
                    array.shift(daily_low_times)
                    array.shift(daily_high_breached)
                    array.shift(daily_low_breached)
                    array.shift(daily_high_breach_times)
                    array.shift(daily_low_breach_times)
                    array.shift(daily_high_used_by_pattern)
                    array.shift(daily_low_used_by_pattern)
                    array.shift(daily_high_pattern_type)
                    array.shift(daily_low_pattern_type)

            daily_session_high := high
            daily_session_low := low
            daily_session_high_time := time
            daily_session_low_time := time

        if na(daily_session_high) or na(daily_session_low)
            daily_session_high := high
            daily_session_low := low
            daily_session_high_time := time
            daily_session_low_time := time

        if high > daily_session_high
            daily_session_high := high
            daily_session_high_time := time
        if low < daily_session_low
            daily_session_low := low
            daily_session_low_time := time

if showWeekly
    if new_bar and new_week
        if not na(weekly_session_high) and not na(weekly_session_low)
            session_close_time = nz(time[1], time)
            array.push(weekly_highs, weekly_session_high)
