    [daily_immediate, daily_standard, daily_delayed, daily_immediate_high_count, daily_immediate_low_count, daily_standard_high_count, daily_standard_low_count, daily_delayed_high_count, daily_delayed_low_count] = detect_pool_patterns(showDaily, daily_highs, daily_lows, daily_high_breach_times, daily_low_breach_times, daily_high_used_by_pattern, daily_low_used_by_pattern, daily_high_pattern_type, daily_low_pattern_type)
    daily_imm_detected := daily_immediate
    daily_std_detected := daily_standard
    daily_del_detected := daily_delayed
    immediate_detected := daily_immediate
    standard_detected := daily_standard
    delayed_detected := daily_delayed
    immediate_levels_used := daily_immediate_high_count + daily_immediate_low_count
    standard_levels_used := daily_standard_high_count + daily_standard_low_count
    delayed_levels_used := daily_delayed_high_count + daily_delayed_low_count
    immediate_high_levels_used := daily_immediate_high_count
    immediate_low_levels_used := daily_immediate_low_count
    standard_high_levels_used := daily_standard_high_count
    standard_low_levels_used := daily_standard_low_count
    delayed_high_levels_used := daily_delayed_high_count
    delayed_low_levels_used := daily_delayed_low_count

    if immediate_levels_used > 0
        immediate_label_with_sign := IMMEDIATE_LABEL_TEXT + (close < open ? '⁻' : close > open ? '⁺' : '')
    if standard_levels_used > 0
