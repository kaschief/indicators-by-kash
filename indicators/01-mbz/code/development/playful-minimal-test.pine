    if session4_in_session
        if na(session4_current_high) or high > session4_current_high
            session4_current_high := high
            session4_current_high_time := time
        if na(session4_current_low) or low < session4_current_low
            session4_current_low := low
            session4_current_low_time := time

    if session4_session_ended and not na(session4_current_high) and not na(session4_current_low)
        session_close_time = nz(time[1], time)
        array.push(session4_highs, session4_current_high)
        array.push(session4_lows, session4_current_low)
        array.push(session4_times, session_close_time)
        array.push(session4_high_times, session4_current_high_time)
        array.push(session4_low_times, session4_current_low_time)
        array.push(session4_high_breached, false)
        array.push(session4_low_breached, false)
        array.push(session4_high_breach_times, na)
        array.push(session4_low_breach_times, na)
        array.push(session4_high_used_by_pattern, false)
        array.push(session4_low_used_by_pattern, false)
        array.push(session4_high_pattern_type, '')
        array.push(session4_low_pattern_type, '')

        max_session4_entries = math.min(session4ShowLast, MAX_SESSION_LEVELS)
        while array.size(session4_highs) > max_session4_entries
            array.shift(session4_highs)
            array.shift(session4_lows)
            array.shift(session4_times)
            array.shift(session4_high_times)
            array.shift(session4_low_times)
            array.shift(session4_high_breached)
            array.shift(session4_low_breached)
            array.shift(session4_high_breach_times)
            array.shift(session4_low_breach_times)
            array.shift(session4_high_used_by_pattern)
            array.shift(session4_low_used_by_pattern)
            array.shift(session4_high_pattern_type)
            array.shift(session4_low_pattern_type)

    if session4_session_ended
        session4_current_high := na
        session4_current_low := na
        session4_current_high_time := na
        session4_current_low_time := na

    session4_in_session_prev := session4_in_session
else
    session4_in_session_prev := false
    session4_current_high := na
    session4_current_low := na
    session4_current_high_time := na
    session4_current_low_time := na

int session5_start_minutes = na
int session5_end_minutes = na
if showSession5
    [session5_start_minutes, session5_end_minutes] = parse_session_minutes(session5Time)
bool session5_in_session = showSession5 and not na(time(timeframe.period, session5Time))
bool session5_session_started = session5_in_session and not session5_in_session_prev
bool session5_session_ended = session5_in_session_prev and not session5_in_session

if showSession5
    if session5_session_started
        session5_current_high := high
        session5_current_low := low
        session5_current_high_time := time
        session5_current_low_time := time

    if session5_in_session
        if na(session5_current_high) or high > session5_current_high
            session5_current_high := high
            session5_current_high_time := time
        if na(session5_current_low) or low < session5_current_low
            session5_current_low := low
            session5_current_low_time := time

