weeklyLineWidth = input.int(DEFAULT_WEEKLY_LINE_WIDTH, 'Line Width', minval=MIN_LINE_WIDTH, maxval=MAX_LINE_WIDTH, group='📊 Weekly')

// === 📆 MONTHLY ===
