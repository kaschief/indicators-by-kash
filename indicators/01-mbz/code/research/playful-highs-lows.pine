                low_line = line.new(low_time, asia_low, end_time, asia_low, xloc=xloc.bar_time)
                line.set_color(low_line, asiaLowColor)
                line.set_width(low_line, asiaLineWidth)
                line.set_style(low_line, line.style_solid)
                array.push(all_lines, low_line)

                // Add label for low
                if showLabels
                    label_time = is_low_breached ? int((low_time + end_time) / 2) : end_time
                    low_label = label.new(label_time, asia_low, ASIA_TIMEFRAME_LABEL, style=label.style_label_up, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
                    array.push(all_labels, low_label)

    // === LONDON SESSION LINES ===
    if showLondon and array.size(london_highs) > 0
        for i = 0 to array.size(london_highs) - 1
            london_high = array.get(london_highs, i)
            london_low = array.get(london_lows, i)
            high_time = array.get(london_high_times, i)
            low_time = array.get(london_low_times, i)
            is_high_breached = array.get(london_high_breached, i)
            is_low_breached = array.get(london_low_breached, i)
            high_breach_time = array.get(london_high_breach_times, i)
            low_breach_time = array.get(london_low_breach_times, i)

            // Draw London high line
            if showLondonHighs
                end_time = is_high_breached ? high_breach_time : time
                high_line = line.new(high_time, london_high, end_time, london_high, xloc=xloc.bar_time)
                line.set_color(high_line, londonHighColor)
                line.set_width(high_line, londonLineWidth)
                line.set_style(high_line, line.style_solid)
                array.push(all_lines, high_line)

                // Add label for high
                if showLabels
                    label_time = is_high_breached ? int((high_time + end_time) / 2) : end_time
                    high_label = label.new(label_time, london_high, LONDON_TIMEFRAME_LABEL, style=label.style_label_down, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
                    array.push(all_labels, high_label)

            // Draw London low line
            if showLondonLows
                end_time = is_low_breached ? low_breach_time : time
                low_line = line.new(low_time, london_low, end_time, london_low, xloc=xloc.bar_time)
                line.set_color(low_line, londonLowColor)
                line.set_width(low_line, londonLineWidth)
                line.set_style(low_line, line.style_solid)
                array.push(all_lines, low_line)

                // Add label for low
                if showLabels
                    label_time = is_low_breached ? int((low_time + end_time) / 2) : end_time
                    low_label = label.new(label_time, london_low, LONDON_TIMEFRAME_LABEL, style=label.style_label_up, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
                    array.push(all_labels, low_label)

    // === NY AM SESSION LINES ===
    if showNYAM and array.size(nyam_highs) > 0
        for i = 0 to array.size(nyam_highs) - 1
            nyam_high = array.get(nyam_highs, i)
            nyam_low = array.get(nyam_lows, i)
            high_time = array.get(nyam_high_times, i)
            low_time = array.get(nyam_low_times, i)
            is_high_breached = array.get(nyam_high_breached, i)
            is_low_breached = array.get(nyam_low_breached, i)
            high_breach_time = array.get(nyam_high_breach_times, i)
            low_breach_time = array.get(nyam_low_breach_times, i)

            // Draw NY AM high line
            if showNYAMHighs
                end_time = is_high_breached ? high_breach_time : time
                high_line = line.new(high_time, nyam_high, end_time, nyam_high, xloc=xloc.bar_time)
                line.set_color(high_line, nyamHighColor)
                line.set_width(high_line, nyamLineWidth)
                line.set_style(high_line, line.style_solid)
                array.push(all_lines, high_line)

                // Add label for high
                if showLabels
                    label_time = is_high_breached ? int((high_time + end_time) / 2) : end_time
                    high_label = label.new(label_time, nyam_high, NYAM_TIMEFRAME_LABEL, style=label.style_label_down, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
                    array.push(all_labels, high_label)

            // Draw NY AM low line
            if showNYAMLows
                end_time = is_low_breached ? low_breach_time : time
                low_line = line.new(low_time, nyam_low, end_time, nyam_low, xloc=xloc.bar_time)
                line.set_color(low_line, nyamLowColor)
                line.set_width(low_line, nyamLineWidth)
                line.set_style(low_line, line.style_solid)
                array.push(all_lines, low_line)

                // Add label for low
                if showLabels
                    label_time = is_low_breached ? int((low_time + end_time) / 2) : end_time
                    low_label = label.new(label_time, nyam_low, NYAM_TIMEFRAME_LABEL, style=label.style_label_up, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
                    array.push(all_labels, low_label)

    // === LUNCH SESSION LINES ===
    if showLunch and array.size(lunch_highs) > 0
        for i = 0 to array.size(lunch_highs) - 1
            lunch_high = array.get(lunch_highs, i)
            lunch_low = array.get(lunch_lows, i)
            high_time = array.get(lunch_high_times, i)
            low_time = array.get(lunch_low_times, i)
            is_high_breached = array.get(lunch_high_breached, i)
            is_low_breached = array.get(lunch_low_breached, i)
            high_breach_time = array.get(lunch_high_breach_times, i)
            low_breach_time = array.get(lunch_low_breach_times, i)

            // Draw Lunch high line
            if showLunchHighs
                end_time = is_high_breached ? high_breach_time : time
                high_line = line.new(high_time, lunch_high, end_time, lunch_high, xloc=xloc.bar_time)
                line.set_color(high_line, lunchHighColor)
                line.set_width(high_line, lunchLineWidth)
                line.set_style(high_line, line.style_solid)
                array.push(all_lines, high_line)

                // Add label for high
                if showLabels
                    label_time = is_high_breached ? int((high_time + end_time) / 2) : end_time
                    high_label = label.new(label_time, lunch_high, LUNCH_TIMEFRAME_LABEL, style=label.style_label_down, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
                    array.push(all_labels, high_label)

            // Draw Lunch low line
            if showLunchLows
                end_time = is_low_breached ? low_breach_time : time
                low_line = line.new(low_time, lunch_low, end_time, lunch_low, xloc=xloc.bar_time)
                line.set_color(low_line, lunchLowColor)
                line.set_width(low_line, lunchLineWidth)
                line.set_style(low_line, line.style_solid)
                array.push(all_lines, low_line)

                // Add label for low
                if showLabels
                    label_time = is_low_breached ? int((low_time + end_time) / 2) : end_time
                    low_label = label.new(label_time, lunch_low, LUNCH_TIMEFRAME_LABEL, style=label.style_label_up, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
                    array.push(all_labels, low_label)

    // === NY PM SESSION LINES ===
    if showNYPM and array.size(nypm_highs) > 0
        for i = 0 to array.size(nypm_highs) - 1
            nypm_high = array.get(nypm_highs, i)
            nypm_low = array.get(nypm_lows, i)
            high_time = array.get(nypm_high_times, i)
            low_time = array.get(nypm_low_times, i)
            is_high_breached = array.get(nypm_high_breached, i)
            is_low_breached = array.get(nypm_low_breached, i)
            high_breach_time = array.get(nypm_high_breach_times, i)
            low_breach_time = array.get(nypm_low_breach_times, i)

            // Draw NY PM high line
            if showNYPMHighs
                end_time = is_high_breached ? high_breach_time : time
                high_line = line.new(high_time, nypm_high, end_time, nypm_high, xloc=xloc.bar_time)
                line.set_color(high_line, nypmHighColor)
                line.set_width(high_line, nypmLineWidth)
                line.set_style(high_line, line.style_solid)
                array.push(all_lines, high_line)

                // Add label for high
                if showLabels
                    label_time = is_high_breached ? int((high_time + end_time) / 2) : end_time
                    high_label = label.new(label_time, nypm_high, NYPM_TIMEFRAME_LABEL, style=label.style_label_down, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
                    array.push(all_labels, high_label)

            // Draw NY PM low line
            if showNYPMLows
                end_time = is_low_breached ? low_breach_time : time
                low_line = line.new(low_time, nypm_low, end_time, nypm_low, xloc=xloc.bar_time)
                line.set_color(low_line, nypmLowColor)
                line.set_width(low_line, nypmLineWidth)
                line.set_style(low_line, line.style_solid)
                array.push(all_lines, low_line)

                // Add label for low
                if showLabels
                    label_time = is_low_breached ? int((low_time + end_time) / 2) : end_time
                    low_label = label.new(label_time, nypm_low, NYPM_TIMEFRAME_LABEL, style=label.style_label_up, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
                    array.push(all_labels, low_label)
