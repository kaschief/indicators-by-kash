    nypm_session_high := na
    nypm_session_low := na
    nypm_session_high_time := na
    nypm_session_low_time := na

// ═══════════════════════════════════════════════════════════════════════════════
// BREACH DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

// Check for breaches of existing levels across all timeframes (PERFORMANCE OPTIMIZED)

// Daily breaches
if showDaily and array.size(daily_highs) > 0
    // PERFORMANCE: Limit scanning to recent entries only
    scan_size = math.min(array.size(daily_highs), MAX_BREACH_SCAN_BARS)
    start_index = math.max(0, array.size(daily_highs) - scan_size)

    for i = start_index to array.size(daily_highs) - 1
        if not array.get(daily_high_breached, i)
            daily_high = array.get(daily_highs, i)
            if high >= daily_high
                array.set(daily_high_breached, i, true)
                array.set(daily_high_breach_times, i, time)

        if not array.get(daily_low_breached, i)
            daily_low = array.get(daily_lows, i)
            if low <= daily_low
                array.set(daily_low_breached, i, true)
                array.set(daily_low_breach_times, i, time)

// Weekly breaches
if showWeekly and array.size(weekly_highs) > 0
    // PERFORMANCE: Limit scanning to recent entries only
    scan_size = math.min(array.size(weekly_highs), MAX_BREACH_SCAN_BARS)
    start_index = math.max(0, array.size(weekly_highs) - scan_size)

    for i = start_index to array.size(weekly_highs) - 1
        if not array.get(weekly_high_breached, i)
            weekly_high = array.get(weekly_highs, i)
            if high >= weekly_high
                array.set(weekly_high_breached, i, true)
                array.set(weekly_high_breach_times, i, time)

        if not array.get(weekly_low_breached, i)
            weekly_low = array.get(weekly_lows, i)
            if low <= weekly_low
                array.set(weekly_low_breached, i, true)
                array.set(weekly_low_breach_times, i, time)

// Monthly breaches
if showMonthly and array.size(monthly_highs) > 0
    // PERFORMANCE: Limit scanning to recent entries only
    scan_size = math.min(array.size(monthly_highs), MAX_BREACH_SCAN_BARS)
    start_index = math.max(0, array.size(monthly_highs) - scan_size)

    for i = start_index to array.size(monthly_highs) - 1
        if not array.get(monthly_high_breached, i)
            monthly_high = array.get(monthly_highs, i)
            if high >= monthly_high
                array.set(monthly_high_breached, i, true)
                array.set(monthly_high_breach_times, i, time)

        if not array.get(monthly_low_breached, i)
            monthly_low = array.get(monthly_lows, i)
            if low <= monthly_low
                array.set(monthly_low_breached, i, true)
                array.set(monthly_low_breach_times, i, time)

// Asia session breaches
if showAsia and array.size(asia_highs) > 0
    // PERFORMANCE: Limit scanning to recent entries only
    scan_size = math.min(array.size(asia_highs), MAX_BREACH_SCAN_BARS)
    start_index = math.max(0, array.size(asia_highs) - scan_size)

    for i = start_index to array.size(asia_highs) - 1
        if not array.get(asia_high_breached, i)
            asia_high = array.get(asia_highs, i)
            if high >= asia_high
                array.set(asia_high_breached, i, true)
                array.set(asia_high_breach_times, i, time)

        if not array.get(asia_low_breached, i)
            asia_low = array.get(asia_lows, i)
            if low <= asia_low
                array.set(asia_low_breached, i, true)
                array.set(asia_low_breach_times, i, time)

// London session breaches
if showLondon and array.size(london_highs) > 0
    // PERFORMANCE: Limit scanning to recent entries only
    scan_size = math.min(array.size(london_highs), MAX_BREACH_SCAN_BARS)
    start_index = math.max(0, array.size(london_highs) - scan_size)

    for i = start_index to array.size(london_highs) - 1
        if not array.get(london_high_breached, i)
            london_high = array.get(london_highs, i)
            if high >= london_high
                array.set(london_high_breached, i, true)
                array.set(london_high_breach_times, i, time)

        if not array.get(london_low_breached, i)
            london_low = array.get(london_lows, i)
            if low <= london_low
                array.set(london_low_breached, i, true)
                array.set(london_low_breach_times, i, time)

// NY AM session breaches
if showNYAM and array.size(nyam_highs) > 0
    // PERFORMANCE: Limit scanning to recent entries only
    scan_size = math.min(array.size(nyam_highs), MAX_BREACH_SCAN_BARS)
    start_index = math.max(0, array.size(nyam_highs) - scan_size)

    for i = start_index to array.size(nyam_highs) - 1
        if not array.get(nyam_high_breached, i)
            nyam_high = array.get(nyam_highs, i)
            if high >= nyam_high
                array.set(nyam_high_breached, i, true)
                array.set(nyam_high_breach_times, i, time)

        if not array.get(nyam_low_breached, i)
            nyam_low = array.get(nyam_lows, i)
            if low <= nyam_low
                array.set(nyam_low_breached, i, true)
                array.set(nyam_low_breach_times, i, time)

// Lunch session breaches
if showLunch and array.size(lunch_highs) > 0
    // PERFORMANCE: Limit scanning to recent entries only
    scan_size = math.min(array.size(lunch_highs), MAX_BREACH_SCAN_BARS)
    start_index = math.max(0, array.size(lunch_highs) - scan_size)

    for i = start_index to array.size(lunch_highs) - 1
        if not array.get(lunch_high_breached, i)
            lunch_high = array.get(lunch_highs, i)
            if high >= lunch_high
                array.set(lunch_high_breached, i, true)
                array.set(lunch_high_breach_times, i, time)

        if not array.get(lunch_low_breached, i)
            lunch_low = array.get(lunch_lows, i)
            if low <= lunch_low
                array.set(lunch_low_breached, i, true)
                array.set(lunch_low_breach_times, i, time)

// NY PM session breaches
if showNYPM and array.size(nypm_highs) > 0
    // PERFORMANCE: Limit scanning to recent entries only
    scan_size = math.min(array.size(nypm_highs), MAX_BREACH_SCAN_BARS)
    start_index = math.max(0, array.size(nypm_highs) - scan_size)

    for i = start_index to array.size(nypm_highs) - 1
        if not array.get(nypm_high_breached, i)
            nypm_high = array.get(nypm_highs, i)
            if high >= nypm_high
                array.set(nypm_high_breached, i, true)
                array.set(nypm_high_breach_times, i, time)

        if not array.get(nypm_low_breached, i)
            nypm_low = array.get(nypm_lows, i)
            if low <= nypm_low
                array.set(nypm_low_breached, i, true)
                array.set(nypm_low_breach_times, i, time)

bool immediate_detected = false
bool standard_detected = false
bool delayed_detected = false

[daily_pool_immediate, daily_pool_standard, daily_pool_delayed] = detect_pool_patterns(showDaily, daily_highs, daily_lows, daily_high_breach_times, daily_low_breach_times)
immediate_detected := immediate_detected or daily_pool_immediate
standard_detected := standard_detected or daily_pool_standard
delayed_detected := delayed_detected or daily_pool_delayed

[weekly_pool_immediate, weekly_pool_standard, weekly_pool_delayed] = detect_pool_patterns(showWeekly, weekly_highs, weekly_lows, weekly_high_breach_times, weekly_low_breach_times)
immediate_detected := immediate_detected or weekly_pool_immediate
standard_detected := standard_detected or weekly_pool_standard
delayed_detected := delayed_detected or weekly_pool_delayed

[monthly_pool_immediate, monthly_pool_standard, monthly_pool_delayed] = detect_pool_patterns(showMonthly, monthly_highs, monthly_lows, monthly_high_breach_times, monthly_low_breach_times)
immediate_detected := immediate_detected or monthly_pool_immediate
standard_detected := standard_detected or monthly_pool_standard
delayed_detected := delayed_detected or monthly_pool_delayed

[asia_pool_immediate, asia_pool_standard, asia_pool_delayed] = detect_pool_patterns(showAsia, asia_highs, asia_lows, asia_high_breach_times, asia_low_breach_times)
immediate_detected := immediate_detected or asia_pool_immediate
standard_detected := standard_detected or asia_pool_standard
delayed_detected := delayed_detected or asia_pool_delayed

[london_pool_immediate, london_pool_standard, london_pool_delayed] = detect_pool_patterns(showLondon, london_highs, london_lows, london_high_breach_times, london_low_breach_times)
immediate_detected := immediate_detected or london_pool_immediate
standard_detected := standard_detected or london_pool_standard
delayed_detected := delayed_detected or london_pool_delayed

[nyam_pool_immediate, nyam_pool_standard, nyam_pool_delayed] = detect_pool_patterns(showNYAM, nyam_highs, nyam_lows, nyam_high_breach_times, nyam_low_breach_times)
immediate_detected := immediate_detected or nyam_pool_immediate
standard_detected := standard_detected or nyam_pool_standard
delayed_detected := delayed_detected or nyam_pool_delayed

[lunch_pool_immediate, lunch_pool_standard, lunch_pool_delayed] = detect_pool_patterns(showLunch, lunch_highs, lunch_lows, lunch_high_breach_times, lunch_low_breach_times)
immediate_detected := immediate_detected or lunch_pool_immediate
standard_detected := standard_detected or lunch_pool_standard
delayed_detected := delayed_detected or lunch_pool_delayed

[nypm_pool_immediate, nypm_pool_standard, nypm_pool_delayed] = detect_pool_patterns(showNYPM, nypm_highs, nypm_lows, nypm_high_breach_times, nypm_low_breach_times)
immediate_detected := immediate_detected or nypm_pool_immediate
standard_detected := standard_detected or nypm_pool_standard
delayed_detected := delayed_detected or nypm_pool_delayed

color final_bar_color = na
if highlightDelayedType and delayed_detected
    final_bar_color := delayedHighlightColor
else if highlightStandardType and standard_detected
    final_bar_color := standardHighlightColor
else if highlightImmediateType and immediate_detected
    final_bar_color := immediateHighlightColor

barcolor(final_bar_color)

// ═══════════════════════════════════════════════════════════════════════════════
// VISUAL DISPLAY
// ═══════════════════════════════════════════════════════════════════════════════

// Clean up previous visuals
if barstate.islast
    while array.size(all_lines) > 0
        old_line = array.shift(all_lines)
        if not na(old_line)
            line.delete(old_line)

    while array.size(all_labels) > 0
        old_label = array.shift(all_labels)
        if not na(old_label)
            label.delete(old_label)

// Draw lines and labels on last bar for all enabled timeframes (PERFORMANCE OPTIMIZED)
if barstate.islast
    // === DAILY LINES ===
    if showDaily and array.size(daily_highs) > 0
        for i = 0 to array.size(daily_highs) - 1
            daily_high = array.get(daily_highs, i)
            daily_low = array.get(daily_lows, i)
            high_time = array.get(daily_high_times, i)
            low_time = array.get(daily_low_times, i)
            is_high_breached = array.get(daily_high_breached, i)
            is_low_breached = array.get(daily_low_breached, i)
            high_breach_time = array.get(daily_high_breach_times, i)
            low_breach_time = array.get(daily_low_breach_times, i)

            // Draw daily high line
            if showDailyHighs
                end_time = is_high_breached ? high_breach_time : time
                high_line = line.new(high_time, daily_high, end_time, daily_high, xloc=xloc.bar_time)
                line.set_color(high_line, dailyHighColor)
                line.set_width(high_line, dailyLineWidth)
                line.set_style(high_line, line.style_solid)
                array.push(all_lines, high_line)

                // Add label for high
                if showLabels
                    label_time = is_high_breached ? int((high_time + end_time) / 2) : end_time
                    high_label = label.new(label_time, daily_high, build_daily_label(high_time), style=label.style_label_down, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
                    array.push(all_labels, high_label)

            // Draw daily low line
            if showDailyLows
                end_time = is_low_breached ? low_breach_time : time
                low_line = line.new(low_time, daily_low, end_time, daily_low, xloc=xloc.bar_time)
                line.set_color(low_line, dailyLowColor)
                line.set_width(low_line, dailyLineWidth)
                line.set_style(low_line, line.style_solid)
                array.push(all_lines, low_line)

                // Add label for low
                if showLabels
                    label_time = is_low_breached ? int((low_time + end_time) / 2) : end_time
                    low_label = label.new(label_time, daily_low, build_daily_label(low_time), style=label.style_label_up, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
                    array.push(all_labels, low_label)

    // Draw current daily session (active day) so users see today's high/low
    if showDaily
        if showDailyHighs and not na(daily_session_high) and not na(daily_session_high_time)
            active_daily_high_line = line.new(daily_session_high_time, daily_session_high, time, daily_session_high, xloc=xloc.bar_time)
            line.set_color(active_daily_high_line, dailyHighColor)
            line.set_width(active_daily_high_line, dailyLineWidth)
            line.set_style(active_daily_high_line, line.style_solid)
            array.push(all_lines, active_daily_high_line)

            if showLabels
                label_time = int((daily_session_high_time + time) / 2)
                active_daily_high_label = label.new(label_time, daily_session_high, build_daily_label(daily_session_high_time), style=label.style_label_down, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
                array.push(all_labels, active_daily_high_label)

        if showDailyLows and not na(daily_session_low) and not na(daily_session_low_time)
            active_daily_low_line = line.new(daily_session_low_time, daily_session_low, time, daily_session_low, xloc=xloc.bar_time)
            line.set_color(active_daily_low_line, dailyLowColor)
            line.set_width(active_daily_low_line, dailyLineWidth)
            line.set_style(active_daily_low_line, line.style_solid)
            array.push(all_lines, active_daily_low_line)

            if showLabels
                label_time = int((daily_session_low_time + time) / 2)
                active_daily_low_label = label.new(label_time, daily_session_low, build_daily_label(daily_session_low_time), style=label.style_label_up, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
                array.push(all_labels, active_daily_low_label)

    // === WEEKLY LINES ===
    if showWeekly and array.size(weekly_highs) > 0
        for i = 0 to array.size(weekly_highs) - 1
            weekly_high = array.get(weekly_highs, i)
            weekly_low = array.get(weekly_lows, i)
            high_time = array.get(weekly_high_times, i)
            low_time = array.get(weekly_low_times, i)
            is_high_breached = array.get(weekly_high_breached, i)
            is_low_breached = array.get(weekly_low_breached, i)
            high_breach_time = array.get(weekly_high_breach_times, i)
            low_breach_time = array.get(weekly_low_breach_times, i)

            // Draw weekly high line
            if showWeeklyHighs
                end_time = is_high_breached ? high_breach_time : time
                high_line = line.new(high_time, weekly_high, end_time, weekly_high, xloc=xloc.bar_time)
                line.set_color(high_line, weeklyHighColor)
                line.set_width(high_line, weeklyLineWidth)
                line.set_style(high_line, line.style_solid)
                array.push(all_lines, high_line)

                // Add label for high
                if showLabels
                    label_time = is_high_breached ? int((high_time + end_time) / 2) : end_time
                    high_label = label.new(label_time, weekly_high, build_weekly_label(high_time), style=label.style_label_down, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
                    array.push(all_labels, high_label)

            // Draw weekly low line
            if showWeeklyLows
                end_time = is_low_breached ? low_breach_time : time
                low_line = line.new(low_time, weekly_low, end_time, weekly_low, xloc=xloc.bar_time)
                line.set_color(low_line, weeklyLowColor)
                line.set_width(low_line, weeklyLineWidth)
                line.set_style(low_line, line.style_solid)
                array.push(all_lines, low_line)

                // Add label for low
                if showLabels
                    label_time = is_low_breached ? int((low_time + end_time) / 2) : end_time
                    low_label = label.new(label_time, weekly_low, build_weekly_label(low_time), style=label.style_label_up, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
                    array.push(all_labels, low_label)

    // Draw current weekly session so in-progress week stays visible
    if showWeekly
        if showWeeklyHighs and not na(weekly_session_high) and not na(weekly_session_high_time)
            active_weekly_high_line = line.new(weekly_session_high_time, weekly_session_high, time, weekly_session_high, xloc=xloc.bar_time)
            line.set_color(active_weekly_high_line, weeklyHighColor)
            line.set_width(active_weekly_high_line, weeklyLineWidth)
            line.set_style(active_weekly_high_line, line.style_solid)
            array.push(all_lines, active_weekly_high_line)

            if showLabels
                label_time = int((weekly_session_high_time + time) / 2)
                active_weekly_high_label = label.new(label_time, weekly_session_high, build_weekly_label(weekly_session_high_time), style=label.style_label_down, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
                array.push(all_labels, active_weekly_high_label)

        if showWeeklyLows and not na(weekly_session_low) and not na(weekly_session_low_time)
            active_weekly_low_line = line.new(weekly_session_low_time, weekly_session_low, time, weekly_session_low, xloc=xloc.bar_time)
            line.set_color(active_weekly_low_line, weeklyLowColor)
            line.set_width(active_weekly_low_line, weeklyLineWidth)
            line.set_style(active_weekly_low_line, line.style_solid)
            array.push(all_lines, active_weekly_low_line)

            if showLabels
                label_time = int((weekly_session_low_time + time) / 2)
                active_weekly_low_label = label.new(label_time, weekly_session_low, build_weekly_label(weekly_session_low_time), style=label.style_label_up, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
                array.push(all_labels, active_weekly_low_label)

    // === MONTHLY LINES ===
    if showMonthly and array.size(monthly_highs) > 0
        for i = 0 to array.size(monthly_highs) - 1
            monthly_high = array.get(monthly_highs, i)
            monthly_low = array.get(monthly_lows, i)
            high_time = array.get(monthly_high_times, i)
            low_time = array.get(monthly_low_times, i)
            is_high_breached = array.get(monthly_high_breached, i)
            is_low_breached = array.get(monthly_low_breached, i)
            high_breach_time = array.get(monthly_high_breach_times, i)
            low_breach_time = array.get(monthly_low_breach_times, i)

            // Draw monthly high line
            if showMonthlyHighs
                end_time = is_high_breached ? high_breach_time : time
                high_line = line.new(high_time, monthly_high, end_time, monthly_high, xloc=xloc.bar_time)
                line.set_color(high_line, monthlyHighColor)
                line.set_width(high_line, monthlyLineWidth)
                line.set_style(high_line, line.style_solid)
                array.push(all_lines, high_line)

                // Add label for high
                if showLabels
                    label_time = is_high_breached ? int((high_time + end_time) / 2) : end_time
                    high_label = label.new(label_time, monthly_high, build_monthly_label(high_time), style=label.style_label_down, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
                    array.push(all_labels, high_label)

            // Draw monthly low line
            if showMonthlyLows
                end_time = is_low_breached ? low_breach_time : time
                low_line = line.new(low_time, monthly_low, end_time, monthly_low, xloc=xloc.bar_time)
                line.set_color(low_line, monthlyLowColor)
