            line.set_width(active_monthly_low_line, monthlyLineWidth)
            line.set_style(active_monthly_low_line, line.style_solid)
            array.push(all_lines, active_monthly_low_line)

            if showLabels
                label_time = int((monthly_session_low_time + time) / 2)
                active_monthly_low_label = label.new(label_time, monthly_session_low, build_monthly_label(monthly_session_low_time), style=label.style_label_up, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
                array.push(all_labels, active_monthly_low_label)

    // === ASIA SESSION LINES ===
    if showAsia and array.size(asia_highs) > 0
        for i = 0 to array.size(asia_highs) - 1
            asia_high = array.get(asia_highs, i)
            asia_low = array.get(asia_lows, i)
            high_time = array.get(asia_high_times, i)
            low_time = array.get(asia_low_times, i)
