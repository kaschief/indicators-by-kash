showAsiaLast = input.int(DEFAULT_SHOW_LAST, 'Show Last', minval=MIN_SHOW_LAST, maxval=MAX_SHOW_LAST, group='🌏 Asia Session', tooltip="Number of previous Asia session highs and lows to display")
