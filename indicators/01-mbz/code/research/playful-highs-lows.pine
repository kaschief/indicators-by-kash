                active_monthly_high_label = label.new(label_time, monthly_session_high, build_monthly_label(monthly_session_high_time), style=label.style_label_down, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
                array.push(all_labels, active_monthly_high_label)

        if showMonthlyLows and not na(monthly_session_low) and not na(monthly_session_low_time)
            active_monthly_low_line = line.new(monthly_session_low_time, monthly_session_low, time, monthly_session_low, xloc=xloc.bar_time)
