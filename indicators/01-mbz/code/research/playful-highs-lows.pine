labelColor = input(DEFAULT_LABEL_COLOR, 'Label Color', group='🎨 Global Style')
appendTimeframeDateLabels = input.bool(false, 'Append Day/Date To TF Labels', group='🎨 Global Style',
     tooltip='When enabled, append the day-of-week and date (NY) to Daily, Weekly, and Monthly labels.')

