        array.push(nypm_high_breach_times, na)
        array.push(nypm_low_breach_times, na)
        max_nypm_entries = math.min(showNYPMLast, MAX_SESSION_LEVELS)
        while array.size(nypm_highs) > max_nypm_entries
            array.shift(nypm_highs)
            array.shift(nypm_lows)
            array.shift(nypm_times)
            array.shift(nypm_high_times)
            array.shift(nypm_low_times)
            array.shift(nypm_high_breached)
            array.shift(nypm_low_breached)
            array.shift(nypm_high_breach_times)
            array.shift(nypm_low_breach_times)

    if nypm_session_ended
        nypm_session_high := na
        nypm_session_low := na
