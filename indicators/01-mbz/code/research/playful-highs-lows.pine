monthlyHighColor = input(DEFAULT_MONTHLY_HIGH_COLOR, '', inline='monthly_lines', group='📆 Monthly')
showMonthlyLows = input(true, 'Show Lows', inline='monthly_lines', group='📆 Monthly')
monthlyLowColor = input(DEFAULT_MONTHLY_LOW_COLOR, '', inline='monthly_lines', group='📆 Monthly')
monthlyLineWidth = input.int(DEFAULT_MONTHLY_LINE_WIDTH, 'Line Width', minval=MIN_LINE_WIDTH, maxval=MAX_LINE_WIDTH, group='📆 Monthly')

// === 🌏 ASIA SESSION ===
