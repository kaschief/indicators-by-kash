//@version=6

// ═══════════════════════════════════════════════════════════════════════════════
// INDICATOR VISUAL LIMITS (Must be declared before indicator() function)
// ═══════════════════════════════════════════════════════════════════════════════
INDICATOR_MAX_LINES = 500               // Maximum lines allowed by indicator
INDICATOR_MAX_LABELS = 500              // Maximum labels allowed by indicator
INDICATOR_TITLE = 'Playful Highs & Lows'

indicator(INDICATOR_TITLE, overlay=true, max_lines_count=INDICATOR_MAX_LINES, max_labels_count=INDICATOR_MAX_LABELS)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUT CONSTANTS (Must be declared before input declarations)
// ═══════════════════════════════════════════════════════════════════════════════

// Input default values
DEFAULT_SHOW_LAST = 5                    // Default number of levels to show
DEFAULT_LINE_WIDTH = 1                   // Default line thickness
DEFAULT_LABEL_SIZE = 'Tiny'              // Default label size

// Input minimum/maximum values
MIN_SHOW_LAST = 1                        // Minimum levels to show
MAX_SHOW_LAST = 20                       // Maximum levels to show
MIN_LINE_WIDTH = 1                       // Minimum line thickness
MAX_LINE_WIDTH = 5                       // Maximum line thickness

// Color constants - Timeframes
DEFAULT_DAILY_HIGH_COLOR = #9c27b0       // Default color for daily highs
DEFAULT_DAILY_LOW_COLOR = #9c27b0        // Default color for daily lows
DEFAULT_WEEKLY_HIGH_COLOR = #ec407a      // Default color for weekly highs
DEFAULT_WEEKLY_LOW_COLOR = #ec407a       // Default color for weekly lows
DEFAULT_MONTHLY_HIGH_COLOR = #4caf50     // Default color for monthly highs
DEFAULT_MONTHLY_LOW_COLOR = #4caf50      // Default color for monthly lows

// Color constants - Sessions
DEFAULT_ASIA_HIGH_COLOR = #80deea        // Default color for Asia session highs
DEFAULT_ASIA_LOW_COLOR = #80deea         // Default color for Asia session lows
DEFAULT_LONDON_HIGH_COLOR = #80deea      // Default color for London session highs
DEFAULT_LONDON_LOW_COLOR = #80deea       // Default color for London session lows
DEFAULT_NY_AM_HIGH_COLOR = #80deea       // Default color for NY AM session highs
DEFAULT_NY_AM_LOW_COLOR = #80deea        // Default color for NY AM session lows
DEFAULT_LUNCH_HIGH_COLOR = #80deea       // Default color for Lunch session highs
DEFAULT_LUNCH_LOW_COLOR = #80deea        // Default color for Lunch session lows
DEFAULT_NY_PM_HIGH_COLOR = #80deea       // Default color for NY PM session highs
DEFAULT_NY_PM_LOW_COLOR = #80deea        // Default color for NY PM session lows

DEFAULT_LABEL_COLOR = #000000            // Default color for labels
DEFAULT_IMMEDIATE_HIGHLIGHT_COLOR = #ffeb3b // Default color for immediate highlight
DEFAULT_STANDARD_HIGHLIGHT_COLOR = #ab47bc // Default color for standard highlight
DEFAULT_DELAYED_HIGHLIGHT_COLOR = #39ff14  // Default color for delayed highlight

// Line width constants - Timeframes
DEFAULT_DAILY_LINE_WIDTH = 1             // Default line width for daily levels
DEFAULT_WEEKLY_LINE_WIDTH = 4            // Default line width for weekly levels
DEFAULT_MONTHLY_LINE_WIDTH = 5           // Default line width for monthly levels

// Line width constants - Sessions
DEFAULT_ASIA_LINE_WIDTH = 2              // Default line width for Asia session levels
DEFAULT_LONDON_LINE_WIDTH = 2            // Default line width for London session levels
DEFAULT_NY_AM_LINE_WIDTH = 2             // Default line width for NY AM session levels
DEFAULT_LUNCH_LINE_WIDTH = 2             // Default line width for Lunch session levels
DEFAULT_NY_PM_LINE_WIDTH = 2             // Default line width for NY PM session levels

// Timezone constants
NY_TIMEZONE = "America/New_York"         // New York timezone for midnight detection

// Time constants
MIDNIGHT_HOUR = 0                        // Midnight hour
MIDNIGHT_MINUTE = 0                      // Midnight minute

// Label constants
DAILY_TIMEFRAME_LABEL = "1D"             // Daily timeframe label text
WEEKLY_TIMEFRAME_LABEL = "1W"            // Weekly timeframe label text
MONTHLY_TIMEFRAME_LABEL = "1M"           // Monthly timeframe label text

// Weekday label constants (used for debugging labels)
WEEKDAY_LABEL_MON = "Mon"
WEEKDAY_LABEL_TUE = "Tue"
WEEKDAY_LABEL_WED = "Wed"
WEEKDAY_LABEL_THU = "Thu"
WEEKDAY_LABEL_FRI = "Fri"
WEEKDAY_LABEL_SAT = "Sat"
WEEKDAY_LABEL_SUN = "Sun"

// Sunday evening reopen handling
SUNDAY_REOPEN_START_HOUR = 18            // 6:00 PM NY on Sundays

// Session label constants
ASIA_TIMEFRAME_LABEL = "Asia"            // Asia session label text
LONDON_TIMEFRAME_LABEL = "London"        // London session label text
NYAM_TIMEFRAME_LABEL = "NY AM"           // New York AM session label text
LUNCH_TIMEFRAME_LABEL = "Lunch"          // Lunch session label text
NYPM_TIMEFRAME_LABEL = "NY PM"           // New York PM session label text

// Session time constants (all in NY timezone)
ASIA_START_HOUR = 20                     // Asia session start: 8:00 PM NY
ASIA_START_MINUTE = 0
ASIA_END_HOUR = 0                        // Asia session end: 12:00 AM NY (midnight)
ASIA_END_MINUTE = 0

LONDON_START_HOUR = 2                    // London session start: 2:00 AM NY
LONDON_START_MINUTE = 0
LONDON_END_HOUR = 5                      // London session end: 5:00 AM NY
LONDON_END_MINUTE = 0

NY_AM_START_HOUR = 9                     // NY AM session start: 9:30 AM NY
NY_AM_START_MINUTE = 30
NY_AM_END_HOUR = 12                      // NY AM session end: 12:00 PM NY
NY_AM_END_MINUTE = 0

LUNCH_START_HOUR = 12                    // Lunch session start: 12:00 PM NY
LUNCH_START_MINUTE = 0
LUNCH_END_HOUR = 13                      // Lunch session end: 1:30 PM NY
LUNCH_END_MINUTE = 30

NY_PM_START_HOUR = 13                    // NY PM session start: 1:30 PM NY
NY_PM_START_MINUTE = 30
NY_PM_END_HOUR = 16                      // NY PM session end: 4:00 PM NY
NY_PM_END_MINUTE = 0

// Performance optimization constants
MAX_BREACH_SCAN_BARS = 50                // Limit breach detection to recent bars for performance
MAX_ARRAY_PROCESS_SIZE = 100             // Maximum array size to process in one cycle
MAX_SESSION_LEVELS = 10                  // Maximum levels per session for performance

// ═══════════════════════════════════════════════════════════════════════════════
// INPUT SETTINGS
// ═══════════════════════════════════════════════════════════════════════════════

// === 📅 DAILY ===
showDaily = input(true, 'Enable Daily Levels', group='📅 Daily')
showDailyLast = input.int(DEFAULT_SHOW_LAST, 'Show Last', minval=MIN_SHOW_LAST, maxval=MAX_SHOW_LAST, group='📅 Daily', tooltip="Number of previous daily highs and lows to display")
showDailyHighs = input(true, 'Show Highs', inline='daily_lines', group='📅 Daily')
dailyHighColor = input(DEFAULT_DAILY_HIGH_COLOR, '', inline='daily_lines', group='📅 Daily')
showDailyLows = input(true, 'Show Lows', inline='daily_lines', group='📅 Daily')
dailyLowColor = input(DEFAULT_DAILY_LOW_COLOR, '', inline='daily_lines', group='📅 Daily')
dailyLineWidth = input.int(DEFAULT_DAILY_LINE_WIDTH, 'Line Width', minval=MIN_LINE_WIDTH, maxval=MAX_LINE_WIDTH, group='📅 Daily')
includeSundayReopen = input.bool(true, 'Include Sunday Evening (18:00-00:00)', group='📅 Daily',
     tooltip='When enabled, price action from Sunday 6:00 PM to midnight NY is treated as its own day. Disable to ignore that period.')
highlightImmediateType = input.bool(false, 'Highlight Immediate-Type Candle', inline='pattern_highlight_immediate', group='📅 Daily')
immediateHighlightColor = input.color(DEFAULT_IMMEDIATE_HIGHLIGHT_COLOR, 'Immediate Color', inline='pattern_highlight_immediate', group='📅 Daily')
highlightStandardType = input.bool(false, 'Highlight Standard-Type Candle', inline='pattern_highlight_standard', group='📅 Daily')
standardHighlightColor = input.color(DEFAULT_STANDARD_HIGHLIGHT_COLOR, 'Standard Color', inline='pattern_highlight_standard', group='📅 Daily')
highlightDelayedType = input.bool(false, 'Highlight Delayed-Type Candle', inline='pattern_highlight_delayed', group='📅 Daily')
delayedHighlightColor = input.color(DEFAULT_DELAYED_HIGHLIGHT_COLOR, 'Delayed Color', inline='pattern_highlight_delayed', group='📅 Daily')

// === 📊 WEEKLY ===
showWeekly = input(true, 'Enable Weekly Levels', group='📊 Weekly')
showWeeklyLast = input.int(DEFAULT_SHOW_LAST, 'Show Last', minval=MIN_SHOW_LAST, maxval=MAX_SHOW_LAST, group='📊 Weekly', tooltip="Number of previous weekly highs and lows to display")
showWeeklyHighs = input(true, 'Show Highs', inline='weekly_lines', group='📊 Weekly')
weeklyHighColor = input(DEFAULT_WEEKLY_HIGH_COLOR, '', inline='weekly_lines', group='📊 Weekly')
showWeeklyLows = input(true, 'Show Lows', inline='weekly_lines', group='📊 Weekly')
