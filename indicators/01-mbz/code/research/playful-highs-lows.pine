                    low_label = label.new(label_time, monthly_low, build_monthly_label(low_time), style=label.style_label_up, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
                    array.push(all_labels, low_label)

    // Draw current monthly session so ongoing month is visible
    if showMonthly
        if showMonthlyHighs and not na(monthly_session_high) and not na(monthly_session_high_time)
            active_monthly_high_line = line.new(monthly_session_high_time, monthly_session_high, time, monthly_session_high, xloc=xloc.bar_time)
            line.set_color(active_monthly_high_line, monthlyHighColor)
            line.set_width(active_monthly_high_line, monthlyLineWidth)
            line.set_style(active_monthly_high_line, line.style_solid)
