var float lunch_session_low = na
var int lunch_session_high_time = na    // Time when session high was set
var int lunch_session_low_time = na     // Time when session low was set

var float nypm_session_high = na
var float nypm_session_low = na
var int nypm_session_high_time = na     // Time when session high was set
var int nypm_session_low_time = na      // Time when session low was set

var bool asia_in_session_prev = false
var bool london_in_session_prev = false
var bool nyam_in_session_prev = false
var bool lunch_in_session_prev = false
var bool nypm_in_session_prev = false

// Performance optimization: Cache session detection results once per bar

// ═══════════════════════════════════════════════════════════════════════════════
// UTILITY FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

get_label_size() =>
    switch labelSize
        'Tiny' => size.tiny
        'Small' => size.small
        'Normal' => size.normal
        => size.small

pad_two_digits(value) =>
    value < 10 ? '0' + str.tostring(value) : str.tostring(value)

get_day_name(time_value) =>
    day = dayofweek(time_value, NY_TIMEZONE)
    switch day
        dayofweek.monday => WEEKDAY_LABEL_MON
        dayofweek.tuesday => WEEKDAY_LABEL_TUE
        dayofweek.wednesday => WEEKDAY_LABEL_WED
        dayofweek.thursday => WEEKDAY_LABEL_THU
        dayofweek.friday => WEEKDAY_LABEL_FRI
        dayofweek.saturday => WEEKDAY_LABEL_SAT
        dayofweek.sunday => WEEKDAY_LABEL_SUN
        => ''

format_day_date(time_value) =>
    day_name = get_day_name(time_value)
    month_str = pad_two_digits(month(time_value, NY_TIMEZONE))
    day_str = pad_two_digits(dayofmonth(time_value, NY_TIMEZONE))
    day_name + ' ' + month_str + '/' + day_str

build_daily_label(time_value) =>
    if not appendTimeframeDateLabels or na(time_value)
        DAILY_TIMEFRAME_LABEL
    else
        DAILY_TIMEFRAME_LABEL + ' ' + format_day_date(time_value)

build_weekly_label(time_value) =>
    if not appendTimeframeDateLabels or na(time_value)
        WEEKLY_TIMEFRAME_LABEL
    else
        WEEKLY_TIMEFRAME_LABEL + ' ' + format_day_date(time_value)

build_monthly_label(time_value) =>
    if not appendTimeframeDateLabels or na(time_value)
        MONTHLY_TIMEFRAME_LABEL
    else
        MONTHLY_TIMEFRAME_LABEL + ' ' + format_day_date(time_value)

is_sunday_evening_reopen(time_value) =>
    not includeSundayReopen and dayofweek(time_value, NY_TIMEZONE) == dayofweek.sunday and hour(time_value, NY_TIMEZONE) >= SUNDAY_REOPEN_START_HOUR

is_cross_midnight_session(start_hour, start_minute, end_hour, end_minute) =>
    start_hour > end_hour or (start_hour == end_hour and start_minute > end_minute)

is_time_in_session(start_hour, start_minute, end_hour, end_minute) =>
    current_minutes = hour(time, NY_TIMEZONE) * 60 + minute(time, NY_TIMEZONE)
    start_minutes = start_hour * 60 + start_minute
    end_minutes = end_hour * 60 + end_minute
    crosses_midnight = is_cross_midnight_session(start_hour, start_minute, end_hour, end_minute)
    crosses_midnight ? (current_minutes >= start_minutes or current_minutes < end_minutes) : (current_minutes >= start_minutes and current_minutes < end_minutes)

// Session detection functions - NY midnight-based detection
is_new_day() =>
    prev_time = time[1]
    not na(prev_time) and dayofmonth(prev_time, NY_TIMEZONE) != dayofmonth(time, NY_TIMEZONE)

is_new_week() =>
    // Weekly detection using standard timeframe change
    timeframe.change("1W")

is_new_month() =>
    // Monthly detection using standard timeframe change
    timeframe.change("1M")

// Cache session detection results (moved outside functions)
new_day = is_new_day()
new_week = is_new_week()
new_month = is_new_month()
new_bar = barstate.isnew

// ═══════════════════════════════════════════════════════════════════════════════
// SESSION TRACKING
// ═══════════════════════════════════════════════════════════════════════════════

// Track daily session highs and lows - BASIC WORKING LOGIC
if showDaily
    skip_sunday_reopen = is_sunday_evening_reopen(time)
    if not skip_sunday_reopen
        if new_bar and new_day
            // Save previous session if it exists
            if not na(daily_session_high) and not na(daily_session_low)
                session_close_time = nz(time[1], time)
                array.push(daily_highs, daily_session_high)
                array.push(daily_lows, daily_session_low)
                array.push(daily_times, session_close_time)
                array.push(daily_high_times, daily_session_high_time)
                array.push(daily_low_times, daily_session_low_time)
                array.push(daily_high_breached, false)
                array.push(daily_low_breached, false)
                array.push(daily_high_breach_times, na)
                array.push(daily_low_breach_times, na)

                // Maintain array size
                max_daily_entries = math.min(showDailyLast, MAX_SESSION_LEVELS)
                while array.size(daily_highs) > max_daily_entries
                    array.shift(daily_highs)
                    array.shift(daily_lows)
                    array.shift(daily_times)
                    array.shift(daily_high_times)
                    array.shift(daily_low_times)
                    array.shift(daily_high_breached)
                    array.shift(daily_low_breached)
                    array.shift(daily_high_breach_times)
                    array.shift(daily_low_breach_times)

            // Reset for new session
            daily_session_high := high
            daily_session_low := low
            daily_session_high_time := time
            daily_session_low_time := time

        if na(daily_session_high) or na(daily_session_low)
            daily_session_high := high
            daily_session_low := low
            daily_session_high_time := time
            daily_session_low_time := time

        // Update current session highs and lows as the bar evolves
        if high > daily_session_high
            daily_session_high := high
            daily_session_high_time := time
        if low < daily_session_low
            daily_session_low := low
            daily_session_low_time := time

// Track weekly session highs and lows using NY Monday midnight
if showWeekly
    if new_bar and new_week
        if not na(weekly_session_high) and not na(weekly_session_low)
            // New week started - lock in previous session's high/low
            session_close_time = nz(time[1], time)
            array.push(weekly_highs, weekly_session_high)
            array.push(weekly_lows, weekly_session_low)
            array.push(weekly_times, session_close_time)
            array.push(weekly_high_times, weekly_session_high_time)
            array.push(weekly_low_times, weekly_session_low_time)
            array.push(weekly_high_breached, false)
            array.push(weekly_low_breached, false)
            array.push(weekly_high_breach_times, na)
            array.push(weekly_low_breach_times, na)

            // Maintain array size
            max_weekly_entries = math.min(showWeeklyLast, MAX_SESSION_LEVELS)
            while array.size(weekly_highs) > max_weekly_entries
                array.shift(weekly_highs)
                array.shift(weekly_lows)
                array.shift(weekly_times)
                array.shift(weekly_high_times)
                array.shift(weekly_low_times)
                array.shift(weekly_high_breached)
                array.shift(weekly_low_breached)
                array.shift(weekly_high_breach_times)
                array.shift(weekly_low_breach_times)

        // Initialize or reset session highs/lows at the start of the new week
        weekly_session_high := high
        weekly_session_low := low
        weekly_session_high_time := time
        weekly_session_low_time := time

    if na(weekly_session_high) or na(weekly_session_low)
        weekly_session_high := high
        weekly_session_low := low
        weekly_session_high_time := time
        weekly_session_low_time := time
    else
        // Update session highs and lows, tracking when they were set
        if high > weekly_session_high
            weekly_session_high := high
            weekly_session_high_time := time
        if low < weekly_session_low
            weekly_session_low := low
            weekly_session_low_time := time

// Track monthly session highs and lows using NY 1st of month midnight
if showMonthly
    if new_bar and new_month
        if not na(monthly_session_high) and not na(monthly_session_low)
            // New month started - lock in previous session's high/low
            session_close_time = nz(time[1], time)
            array.push(monthly_highs, monthly_session_high)
            array.push(monthly_lows, monthly_session_low)
            array.push(monthly_times, session_close_time)
            array.push(monthly_high_times, monthly_session_high_time)
            array.push(monthly_low_times, monthly_session_low_time)
            array.push(monthly_high_breached, false)
            array.push(monthly_low_breached, false)
            array.push(monthly_high_breach_times, na)
            array.push(monthly_low_breach_times, na)

        // Maintain array size
        max_monthly_entries = math.min(showMonthlyLast, MAX_SESSION_LEVELS)
        while array.size(monthly_highs) > max_monthly_entries
            array.shift(monthly_highs)
            array.shift(monthly_lows)
            array.shift(monthly_times)
            array.shift(monthly_high_times)
            array.shift(monthly_low_times)
            array.shift(monthly_high_breached)
            array.shift(monthly_low_breached)
            array.shift(monthly_high_breach_times)
            array.shift(monthly_low_breach_times)

        // Initialize or reset session highs/lows
        monthly_session_high := high
        monthly_session_low := low
        monthly_session_high_time := time
        monthly_session_low_time := time

    if na(monthly_session_high) or na(monthly_session_low)
        monthly_session_high := high
        monthly_session_low := low
        monthly_session_high_time := time
        monthly_session_low_time := time
    else
        // Update session highs and lows, tracking when they were set
        if high > monthly_session_high
            monthly_session_high := high
            monthly_session_high_time := time
        if low < monthly_session_low
            monthly_session_low := low
            monthly_session_low_time := time

// PERFORMANCE: Session tracking with macro-style approach
// Asia Session (8:00 PM → 12:00 AM NY)
if showAsia
    asia_in_session = is_time_in_session(ASIA_START_HOUR, ASIA_START_MINUTE, ASIA_END_HOUR, ASIA_END_MINUTE)
    asia_session_started = asia_in_session and not asia_in_session_prev
    asia_session_ended = asia_in_session_prev and not asia_in_session

    if asia_session_started
        asia_session_high := high
        asia_session_low := low
        asia_session_high_time := time
        asia_session_low_time := time

    if asia_in_session
        if na(asia_session_high) or high > asia_session_high
            asia_session_high := high
            asia_session_high_time := time
        if na(asia_session_low) or low < asia_session_low
            asia_session_low := low
            asia_session_low_time := time

    if asia_session_ended and not na(asia_session_high) and not na(asia_session_low)
        session_close_time = nz(time[1], time)
        array.push(asia_highs, asia_session_high)
        array.push(asia_lows, asia_session_low)
        array.push(asia_times, session_close_time)
        array.push(asia_high_times, asia_session_high_time)
        array.push(asia_low_times, asia_session_low_time)
        array.push(asia_high_breached, false)
        array.push(asia_low_breached, false)
        array.push(asia_high_breach_times, na)
        array.push(asia_low_breach_times, na)
        max_asia_entries = math.min(showAsiaLast, MAX_SESSION_LEVELS)
        while array.size(asia_highs) > max_asia_entries
            array.shift(asia_highs)
            array.shift(asia_lows)
            array.shift(asia_times)
            array.shift(asia_high_times)
            array.shift(asia_low_times)
            array.shift(asia_high_breached)
            array.shift(asia_low_breached)
            array.shift(asia_high_breach_times)
            array.shift(asia_low_breach_times)

    if asia_session_ended
        asia_session_high := na
        asia_session_low := na
        asia_session_high_time := na
        asia_session_low_time := na

    asia_in_session_prev := asia_in_session
else
    asia_in_session_prev := false
    asia_session_high := na
    asia_session_low := na
    asia_session_high_time := na
    asia_session_low_time := na

// London Session (2:00 AM → 5:00 AM NY)
if showLondon
    london_in_session = is_time_in_session(LONDON_START_HOUR, LONDON_START_MINUTE, LONDON_END_HOUR, LONDON_END_MINUTE)
    london_session_started = london_in_session and not london_in_session_prev
    london_session_ended = london_in_session_prev and not london_in_session

    if london_session_started
        london_session_high := high
        london_session_low := low
        london_session_high_time := time
        london_session_low_time := time

    if london_in_session
        if na(london_session_high) or high > london_session_high
            london_session_high := high
            london_session_high_time := time
        if na(london_session_low) or low < london_session_low
            london_session_low := low
            london_session_low_time := time

    if london_session_ended and not na(london_session_high) and not na(london_session_low)
        session_close_time = nz(time[1], time)
        array.push(london_highs, london_session_high)
        array.push(london_lows, london_session_low)
        array.push(london_times, session_close_time)
        array.push(london_high_times, london_session_high_time)
        array.push(london_low_times, london_session_low_time)
        array.push(london_high_breached, false)
        array.push(london_low_breached, false)
        array.push(london_high_breach_times, na)
        array.push(london_low_breach_times, na)
        max_london_entries = math.min(showLondonLast, MAX_SESSION_LEVELS)
        while array.size(london_highs) > max_london_entries
            array.shift(london_highs)
            array.shift(london_lows)
            array.shift(london_times)
            array.shift(london_high_times)
            array.shift(london_low_times)
            array.shift(london_high_breached)
            array.shift(london_low_breached)
            array.shift(london_high_breach_times)
            array.shift(london_low_breach_times)

    if london_session_ended
        london_session_high := na
        london_session_low := na
        london_session_high_time := na
        london_session_low_time := na

    london_in_session_prev := london_in_session
else
    london_in_session_prev := false
    london_session_high := na
    london_session_low := na
    london_session_high_time := na
    london_session_low_time := na

// NY AM Session (9:30 AM → 12:00 PM NY)
if showNYAM
    nyam_in_session = is_time_in_session(NY_AM_START_HOUR, NY_AM_START_MINUTE, NY_AM_END_HOUR, NY_AM_END_MINUTE)
    nyam_session_started = nyam_in_session and not nyam_in_session_prev
    nyam_session_ended = nyam_in_session_prev and not nyam_in_session

    if nyam_session_started
        nyam_session_high := high
        nyam_session_low := low
        nyam_session_high_time := time
        nyam_session_low_time := time

    if nyam_in_session
        if na(nyam_session_high) or high > nyam_session_high
            nyam_session_high := high
            nyam_session_high_time := time
        if na(nyam_session_low) or low < nyam_session_low
            nyam_session_low := low
            nyam_session_low_time := time

    if nyam_session_ended and not na(nyam_session_high) and not na(nyam_session_low)
        session_close_time = nz(time[1], time)
        array.push(nyam_highs, nyam_session_high)
        array.push(nyam_lows, nyam_session_low)
        array.push(nyam_times, session_close_time)
        array.push(nyam_high_times, nyam_session_high_time)
        array.push(nyam_low_times, nyam_session_low_time)
        array.push(nyam_high_breached, false)
        array.push(nyam_low_breached, false)
        array.push(nyam_high_breach_times, na)
        array.push(nyam_low_breach_times, na)
        max_nyam_entries = math.min(showNYAMLast, MAX_SESSION_LEVELS)
        while array.size(nyam_highs) > max_nyam_entries
            array.shift(nyam_highs)
            array.shift(nyam_lows)
            array.shift(nyam_times)
            array.shift(nyam_high_times)
            array.shift(nyam_low_times)
            array.shift(nyam_high_breached)
            array.shift(nyam_low_breached)
            array.shift(nyam_high_breach_times)
            array.shift(nyam_low_breach_times)

    if nyam_session_ended
        nyam_session_high := na
        nyam_session_low := na
        nyam_session_high_time := na
        nyam_session_low_time := na

    nyam_in_session_prev := nyam_in_session
else
    nyam_in_session_prev := false
    nyam_session_high := na
    nyam_session_low := na
    nyam_session_high_time := na
    nyam_session_low_time := na

// Lunch Session (12:00 PM → 1:30 PM NY)
if showLunch
    lunch_in_session = is_time_in_session(LUNCH_START_HOUR, LUNCH_START_MINUTE, LUNCH_END_HOUR, LUNCH_END_MINUTE)
    lunch_session_started = lunch_in_session and not lunch_in_session_prev
    lunch_session_ended = lunch_in_session_prev and not lunch_in_session

    if lunch_session_started
        lunch_session_high := high
        lunch_session_low := low
        lunch_session_high_time := time
        lunch_session_low_time := time

    if lunch_in_session
        if na(lunch_session_high) or high > lunch_session_high
            lunch_session_high := high
            lunch_session_high_time := time
        if na(lunch_session_low) or low < lunch_session_low
            lunch_session_low := low
            lunch_session_low_time := time

    if lunch_session_ended and not na(lunch_session_high) and not na(lunch_session_low)
        session_close_time = nz(time[1], time)
        array.push(lunch_highs, lunch_session_high)
        array.push(lunch_lows, lunch_session_low)
        array.push(lunch_times, session_close_time)
        array.push(lunch_high_times, lunch_session_high_time)
        array.push(lunch_low_times, lunch_session_low_time)
        array.push(lunch_high_breached, false)
        array.push(lunch_low_breached, false)
        array.push(lunch_high_breach_times, na)
        array.push(lunch_low_breach_times, na)
        max_lunch_entries = math.min(showLunchLast, MAX_SESSION_LEVELS)
        while array.size(lunch_highs) > max_lunch_entries
            array.shift(lunch_highs)
            array.shift(lunch_lows)
            array.shift(lunch_times)
            array.shift(lunch_high_times)
            array.shift(lunch_low_times)
            array.shift(lunch_high_breached)
            array.shift(lunch_low_breached)
            array.shift(lunch_high_breach_times)
            array.shift(lunch_low_breach_times)

    if lunch_session_ended
        lunch_session_high := na
        lunch_session_low := na
        lunch_session_high_time := na
        lunch_session_low_time := na

    lunch_in_session_prev := lunch_in_session
else
    lunch_in_session_prev := false
    lunch_session_high := na
    lunch_session_low := na
    lunch_session_high_time := na
    lunch_session_low_time := na

// NY PM Session (1:30 PM → 4:00 PM NY)
if showNYPM
    nypm_in_session = is_time_in_session(NY_PM_START_HOUR, NY_PM_START_MINUTE, NY_PM_END_HOUR, NY_PM_END_MINUTE)
    nypm_session_started = nypm_in_session and not nypm_in_session_prev
    nypm_session_ended = nypm_in_session_prev and not nypm_in_session

    if nypm_session_started
        nypm_session_high := high
        nypm_session_low := low
        nypm_session_high_time := time
        nypm_session_low_time := time

    if nypm_in_session
        if na(nypm_session_high) or high > nypm_session_high
            nypm_session_high := high
            nypm_session_high_time := time
        if na(nypm_session_low) or low < nypm_session_low
            nypm_session_low := low
            nypm_session_low_time := time

    if nypm_session_ended and not na(nypm_session_high) and not na(nypm_session_low)
        session_close_time = nz(time[1], time)
        array.push(nypm_highs, nypm_session_high)
        array.push(nypm_lows, nypm_session_low)
        array.push(nypm_times, session_close_time)
        array.push(nypm_high_times, nypm_session_high_time)
        array.push(nypm_low_times, nypm_session_low_time)
