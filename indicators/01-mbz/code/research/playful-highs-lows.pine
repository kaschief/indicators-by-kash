                    label_time = is_high_breached ? int((high_time + end_time) / 2) : end_time
                    high_label = label.new(label_time, asia_high, ASIA_TIMEFRAME_LABEL, style=label.style_label_down, textcolor=labelColor, size=get_label_size(), color=color.new(color.white, 100), xloc=xloc.bar_time)
