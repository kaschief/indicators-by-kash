ALERT_MSG_MULTI_SOURCE_MBZ_MINUS = "Multi-Source MBZ⁻"
ALERT_MSG_STRONG_MBZ_PLUS = "Strong MBZ⁺"
ALERT_MSG_STRONG_MBZ_MINUS = "Strong MBZ⁻"
ALERT_MSG_NESTED_MBZ_PLUS = "Nested MBZ⁺"
ALERT_MSG_NESTED_MBZ_MINUS = "Nested MBZ⁻"
ALERT_MSG_DEEPER_WICK_MBZ_PLUS = "Deeper Wick MBZ⁺"
ALERT_MSG_DEEPER_WICK_MBZ_MINUS = "Deeper Wick MBZ⁻"
ALERT_PREFIX_GROUPED = ""

// Repeated string constants
ALERT_TOOLTIP_PREFIX = "Grouped only: Include "
ALERT_TOOLTIP_SUFFIX = " alerts in grouped alert"
ALERT_MESSAGE_SUFFIX = " • {{interval}}"
ALERT_MESSAGE_AT_SUFFIX = " • {{interval}}"
INPUT_LABEL_IMPLIED_DISPLACEMENT = 'Implied: Displacement'
INPUT_LABEL_LOOKBACK = 'Lookback'
WICK_TIER_STANDARD_DISPLAY = "Standard"
GAP_LABEL_VOL_IMB = "Vol Imb"
EMPTY_DISPLAY = ""

// ═══════════════════════════════════════════════════════════════════════════════
// INPUT SETTINGS - ULTRA-COMPACT ALIGNED LAYOUT
// ═══════════════════════════════════════════════════════════════════════════════

// === 🎯 DETECTION ===
max_valid_mbzs = input.int(DEFAULT_MAX_VALID_MBZS, INPUT_LABEL_MAX_VALID_MBZS, minval=0, maxval=MAX_VALID_MBZS_LIMIT, group=GROUP_DETECTION, inline='det1', tooltip='Maximum number of valid (non-breached) MBZs visible on chart (0-55 limit)')
capacity_mode = input.string(CAPACITY_MODE_OPTIMIZED, "Capacity Mode", options=[CAPACITY_MODE_OPTIMIZED, CAPACITY_MODE_BOOST, CAPACITY_MODE_ULTRA_BOOST, CAPACITY_MODE_ULTRA_PRO_BOOST], group=GROUP_DETECTION, inline='det1', tooltip='DETECTION GROUP SUMMARY:\n• Max Valid MBZs: Control display count for active MBZs\n• Capacity Mode: Adjust internal limits for deeper history scans\n\nOptimized: base limits and performance\nBoost: roughly 4× the base limits (clamped to indicator caps)\nUltra Boost: roughly 8× the base limits for deeper scans\nUltra Pro Boost: roughly 12× the base limits for the heaviest history loads')

// === ✋ INVALIDATION ===
show_invalidated_mbzs = input.bool(false, INPUT_LABEL_SHOW_INVALIDATED_MBZS, group=GROUP_INVALIDATION, inline='inv1', tooltip='Show invalidated MBZs with [X] marker\n\nTwo-tier warning system:\n[BREACHED] = price enters breach zone (optional)\n[X] = candle closes at invalidation threshold')
max_invalidated_mbzs = input.int(DEFAULT_MAX_INVALIDATED_MBZS, INPUT_LABEL_MAX_INVALIDATED_MBZS, minval=0, maxval=MAX_INVALIDATED_MBZS_LIMIT, group=GROUP_INVALIDATION, inline='inv1', tooltip='Maximum number of invalidated (breached) MBZs to show when enabled (0-15 limit)')
mbz_invalidation_mode = input.string(INVALIDATION_STANDARD, INPUT_LABEL_INVALIDATION_THRESHOLD, options=[INVALIDATION_STANDARD, INVALIDATION_STRICT, INVALIDATION_CUSTOM], group=GROUP_INVALIDATION, inline='inv2', tooltip='Zone fill threshold for invalidation (requires candle close)\nStandard: 100% fill (less sensitive, later invalidation - traditional MBZ)\nStrict: 85% fill (more sensitive, earlier invalidation)\nCustom: set your own percentage (1-99%)\n\n[X] shows after candle closes at invalidation threshold')
custom_threshold_percent = input.float(DEFAULT_CUSTOM_THRESHOLD, INPUT_LABEL_CUSTOM_PERCENT, minval=MIN_THRESHOLD_PERCENT, maxval=MAX_THRESHOLD_PERCENT, step=DEFAULT_STEP_SIZE, group=GROUP_INVALIDATION, inline='inv2', tooltip='Custom invalidation threshold (1-99%). Used only when Custom mode is selected.')
invalidation_boundary = input.string(INVALIDATION_BOUNDARY_EXTREMES, INPUT_LABEL_INVALIDATION_BOUNDARY, options=[INVALIDATION_BOUNDARY_BODY, INVALIDATION_BOUNDARY_EXTREMES], group=GROUP_INVALIDATION, inline='inv3', tooltip='INVALIDATION GROUP SUMMARY:\n• Show Invalidated MBZs: Toggle display of breached MBZs\n• Max: Maximum invalidated MBZs to show (0-15 limit)\n• Threshold: Set sensitivity - Standard (100%), Strict (85%), or Custom percentage\n• Custom %: Used only when Custom mode is selected (1-99% range)\n• Boundary: Body Zone uses MBZ zone, Candle Extremes uses candle high/low (default, more forgiving)\n\nNote: Boundary only applies to Standard MBZs. Inclusion and Reflection always use their zone boundaries.')

// === 👁️ VISIBILITY FILTERS ===
show_bullish_mbzs = input.bool(true, INPUT_LABEL_SHOW_MBZ_PLUS, group=GROUP_VISIBILITY_FILTERS, inline='dir1', tooltip='Display MBZ⁺ zones and labels')
show_bearish_mbzs = input.bool(true, INPUT_LABEL_SHOW_MBZ_MINUS, group=GROUP_VISIBILITY_FILTERS, inline='dir1', tooltip='Display MBZ⁻ zones and labels')
filter_single_source_mbzs = input.bool(true, 'Single-Source', group=GROUP_VISIBILITY_FILTERS, inline='source', tooltip='Show MBZs formed from a single gap source (clean zones)')
filter_multi_source_mbzs = input.bool(true, 'Multi-Source', group=GROUP_VISIBILITY_FILTERS, inline='source', tooltip='Show MBZs formed from multiple gap sources (confluence zones)')

// === 🎯 GAP SOURCES ===
enable_fair_value_gaps = input.bool(true, INPUT_LABEL_FAIR_VALUE_GAPS, group=GROUP_GAP_SOURCES, inline='sources1', tooltip='GAP SOURCES:\n• Fair Value Gaps: Standard 3-candle FVGs - the foundation of MBZ detection\n• Implied FVGs: 3-candle institutional gaps with displacement validation')
fvg_type_filter = input.string(FVG_FILTER_ALL, "", options=[FVG_FILTER_ALL, FVG_FILTER_BREAKAWAY_ONLY, FVG_FILTER_STANDARD_ONLY], group=GROUP_GAP_SOURCES, inline='sources1', tooltip='FVG Detection Filter:\n• All: Detect all FVGs (both breakaway and standard)\n• Breakaway-Only: Only detect breakaway FVGs (for testing super strong zones)\n• Standard-Only: Only detect standard FVGs')
enable_implied = input.bool(true, INPUT_LABEL_IMPLIED_FVGS, group=GROUP_GAP_SOURCES, inline='sources2')
enable_volume_imbalance = input.bool(true, INPUT_LABEL_VOLUME_IMBALANCES, group=GROUP_GAP_SOURCES, inline='sources2', tooltip='GAP SOURCES (continued):\n• Volume Imbalances: 2-candle retail body gaps\n• True Gaps: Classic price gaps between candle ranges')
enable_true_gaps = input.bool(true, INPUT_LABEL_TRUE_GAPS, group=GROUP_GAP_SOURCES, inline='sources3')
enable_rdrb = input.bool(true, 'Rebalanced Redistributed Gaps', group=GROUP_GAP_SOURCES, inline='sources3', tooltip='Rebalanced Redistributed (RDRB):\n• Middle candle\'s body stays fully inside the previous candle\'s wick\n• The next candle takes (breaks) that middle candle\'s high/low\n• The remaining portion inside that wick becomes the tradable zone')

// === 📦 SOURCE ORIGINS ===
gap_color = input.color(color.new(color.blue, 85), INPUT_LABEL_BOX, group=GROUP_SOURCE_ORIGINS, inline='gap1', tooltip='Source gap settings\nBox: color for gap boxes\nMax Boxes: maximum boxes to keep visible\nEnable Gaps: show boxes for gaps (FVG/Implied/VI) that created each MBZ')
max_source_gap_boxes = input.int(DEFAULT_SOURCE_GAP_BOXES, INPUT_LABEL_MAX_BOXES, minval=MIN_SOURCE_GAP_BOXES, maxval=MAX_SOURCE_GAP_BOXES, group=GROUP_SOURCE_ORIGINS, inline='gap1', tooltip='Maximum number of gap boxes to keep visible (1-50 limit)')
show_source_gap = input.bool(false, INPUT_LABEL_ENABLE_GAPS, group=GROUP_SOURCE_ORIGINS, inline='gap1', tooltip='Show boxes for the gaps (FVG/Implied/VI) that created each MBZ')
label_size = input.string(TEXT_SIZE_TINY, INPUT_LABEL_LABEL, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_SOURCE_ORIGINS, inline='gap2', tooltip='Gap label text size and label text color')
source_gap_text_color = input.color(color.black, INPUT_LABEL_LABEL, group=GROUP_SOURCE_ORIGINS, inline='gap2', tooltip='SOURCE GAP SUMMARY:\n• Visual Display: Control source gap box color, max visible count, enable/disable display\n• Label Settings: Set gap label text size and color\n\nNote: Shows visual boxes for the gaps (FVG/Implied/VI/TG) that created each MBZ for analysis')

// === 🎨 MBZ LABELLING (TYPE, SIZE & COLOR)===
mbz_symbol_type = input.string(DISPLAY_MODE_ARROW_TEXT, INPUT_LABEL_LABEL_STYLE, options=[DISPLAY_MODE_ARROW_ONLY, DISPLAY_MODE_TEXT_ONLY, DISPLAY_MODE_ARROW_TEXT], group=GROUP_MBZ_LABELLING, inline='mbz2', tooltip='What to display on MBZ candles')
mbz_label_size = input.string(TEXT_SIZE_TINY, INPUT_LABEL_VALID_MBZ, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_MBZ_LABELLING, inline='mbz1', tooltip='Size of valid MBZ labels')
mbz_invalidated_size = input.string(TEXT_SIZE_TINY, INPUT_LABEL_INVALIDATED_MBZ, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_MBZ_LABELLING, inline='mbz1', tooltip='Size of invalidated MBZ labels')
mbz_bullish_color = input.color(color.green, INPUT_LABEL_MBZ_PLUS, group=GROUP_MBZ_LABELLING, inline='mbz2', tooltip='Color for MBZ⁺ labels')
mbz_bearish_color = input.color(color.red, INPUT_LABEL_MBZ_MINUS, group=GROUP_MBZ_LABELLING, inline='mbz2', tooltip='Color for MBZ⁻ labels')
mbz_invalidated_color = input.color(color.gray, INPUT_LABEL_INVALIDATED, group=GROUP_MBZ_LABELLING, inline='mbz2', tooltip='Color for invalidated MBZ labels')
show_mbz_labels = input.bool(true, INPUT_LABEL_ENABLE_LABELS, group=GROUP_MBZ_LABELLING, inline='mbz3', tooltip='Show MBZ arrow/text labels on candles\n\nNote: Arrow direction also points toward the source gap that created the MBZ')
show_enhanced_label_details = input.bool(true, 'Show Enhanced Label Details', group=GROUP_MBZ_LABELLING, inline='mbz4', tooltip='Display detailed source types and behaviors in MBZ labels\n\nOFF: Clean labels (MBZ⁺, MBZ⁻)\nON: Enhanced labels (MBZ⁺ (imp) ↓inc)')
reflection_label_offset_multiplier = input.float(DEFAULT_REFLECTION_LABEL_SPACING_MULTIPLIER, INPUT_LABEL_REFLECTION_LABEL_OFFSET, minval=MIN_REFLECTION_LABEL_SPACING_MULTIPLIER, maxval=MAX_REFLECTION_LABEL_SPACING_MULTIPLIER, step=0.1, group=GROUP_MBZ_LABELLING, inline='mbz5', tooltip='Offset multiplier for reflection MBZ labels to prevent collision with extension boxes (0.0-2.0)')
general_label_offset_multiplier = input.float(DEFAULT_GENERAL_LABEL_OFFSET_MULTIPLIER, INPUT_LABEL_GENERAL_LABEL_OFFSET, minval=MIN_GENERAL_LABEL_OFFSET_MULTIPLIER, maxval=MAX_GENERAL_LABEL_OFFSET_MULTIPLIER, step=0.1, group=GROUP_MBZ_LABELLING, inline='mbz6', tooltip='Additional vertical offset multiplier for ALL labels based on zone height (0.0-5.0)\n\nUseful to separate labels for better visibility')

// === ✨ MBZ EXTENSION ===
extended_box_bullish_color = input.color(color.new(#4dd0e1, 85), INPUT_LABEL_MBZ_PLUS, group=GROUP_MBZ_EXTENSION, inline='ext1', tooltip='Color for MBZ⁺ highlights and extensions')
extended_box_bearish_color = input.color(color.new(#f70bf1, 85), INPUT_LABEL_MBZ_MINUS, group=GROUP_MBZ_EXTENSION, inline='ext1', tooltip='Color for MBZ⁻ highlights and extensions')
show_extended_boxes = input.bool(true, INPUT_LABEL_ENABLE_EXTENSION, group=GROUP_MBZ_EXTENSION, inline='ext1', tooltip='Show highlights and extensions for valid MBZs')
extension_mode = input.string(EXTENSION_FIXED, INPUT_LABEL_EXTENSION_MODE, options=[EXTENSION_FIXED, EXTENSION_TO_CURRENT, EXTENSION_BEYOND_CURRENT], group=GROUP_MBZ_EXTENSION, inline='ext_mode', tooltip='Extension behavior:\n• Fixed Length: extend N bars from formation\n• To Current Price: extend at least to current bar (prevents shrinking)\n• Beyond Current Price: extend N bars beyond current bar (real-time)')
extended_box_text_size = input.string(TEXT_SIZE_TINY, INPUT_LABEL_LABEL, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_MBZ_EXTENSION, inline='ext2', tooltip='Text size for extension boxes')
extended_box_text_color = input.color(color.black, INPUT_LABEL_LABEL, group=GROUP_MBZ_EXTENSION, inline='ext2', tooltip='Text color for extension boxes')
extension_label_horizontal_alignment = input.string(LABEL_ALIGNMENT_RIGHT, 'Horizontal', options=[LABEL_ALIGNMENT_LEFT, LABEL_ALIGNMENT_CENTER, LABEL_ALIGNMENT_RIGHT], group=GROUP_MBZ_EXTENSION, inline='ext_align', tooltip='Horizontal alignment for extension box text')
extension_label_vertical_alignment = input.string(LABEL_VERTICAL_CENTER, 'Vertical', options=[LABEL_VERTICAL_TOP, LABEL_VERTICAL_CENTER, LABEL_VERTICAL_BOTTOM], group=GROUP_MBZ_EXTENSION, inline='ext_align', tooltip='Vertical alignment for extension box text')
extension_label_horizontal_padding = input.int(1, 'Horizontal Padding', minval=0, maxval=MAX_PADDING_HORIZONTAL, group=GROUP_MBZ_EXTENSION, inline='ext_padding', tooltip='Number of spaces for left/right padding (0-10)')
extension_label_vertical_padding = input.int(0, 'Vertical Padding', minval=0, maxval=MAX_PADDING_VERTICAL, group=GROUP_MBZ_EXTENSION, inline='ext_padding', tooltip='Number of newlines for top/bottom padding (0-5)')
extended_box_length = input.int(DEFAULT_EXTENSION_BARS, INPUT_LABEL_NO_OF_BARS, minval=MIN_EXTENSION_BARS, maxval=MAX_EXTENSION_BARS, group=GROUP_MBZ_EXTENSION, inline='ext_mode', tooltip='Number of bars for extension (1-50 limit, meaning changes based on Extension Mode selected)')

// === 🎭 MBZ WICK BEHAVIORS ===
enable_inclusion = input.bool(true, 'Inclusion', group=GROUP_MBZ_BEHAVIORS, inline='behaviors', tooltip='MBZ WICK BEHAVIORS:\n• Inclusion: Wick toward body direction (bullish=lower wick, bearish=upper wick)\n• Reflection: Wick away from body direction (bullish=upper wick, bearish=lower wick)\n\nThese determine MBZ subtype based on dominant wick direction relative to candle body')
enable_reflection = input.bool(true, 'Reflection', group=GROUP_MBZ_BEHAVIORS, inline='behaviors', tooltip='MBZ BEHAVIORS:\n• Inclusion: Wick toward body direction (bullish=lower wick, bearish=upper wick)\n• Reflection: Wick away from body direction (bullish=upper wick, bearish=lower wick)')

// === 🏷️ MBZ DETECTION MARKERS ===
source_gap_wick_detection_mode = input.string(SOURCE_GAP_DEEPER_WICK_BOTH, "Mark MBZs with Deeper Wick", options=[SOURCE_GAP_DEEPER_WICK_OFF, SOURCE_GAP_DEEPER_WICK_ICON, SOURCE_GAP_DEEPER_WICK_BORDER, SOURCE_GAP_DEEPER_WICK_BOTH], group=GROUP_MBZ_DETECTION_MARKERS, inline='sgwd1', tooltip='Mark MBZs where the formation candle\'s wick penetrated deeper into the source gap than the mitigating candle\n\n• Off: No marking\n• Icon: Add symbol to label\n• Border: Add colored border around MBZ\n• Icon + Border: Both icon and colored border')
source_gap_wick_border_color = input.color(color.blue, "Color", group=GROUP_MBZ_DETECTION_MARKERS, inline='sgwd1', tooltip='Border color for deeper wick detection')
deeper_wick_border_width = input.int(DEFAULT_DEEPER_WICK_BORDER_WIDTH, "Width", minval=MIN_BORDER_WIDTH, maxval=MAX_BORDER_WIDTH, group=GROUP_MBZ_DETECTION_MARKERS, inline='sgwd1', tooltip='Border width for MBZs with deeper wick penetration (1-5px limit)')
deeper_wick_icon_style = input.string(SOURCE_GAP_DEEPER_WICK_LABEL, SOURCE_GAP_DEEPER_WICK_ICON, options=[SOURCE_GAP_DEEPER_WICK_ICON_CIRCLE, SOURCE_GAP_DEEPER_WICK_LABEL], group=GROUP_MBZ_DETECTION_MARKERS, inline='sgwd1', tooltip='Choose the marker shown when a deeper wick is detected. "◉" keeps the compact icon; "[deeper]" renders descriptive text.')
enable_reflection_pattern_deeper = input.bool(true, 'Enhanced Reflection Detection', group=GROUP_MBZ_DETECTION_MARKERS, inline='reflection1', tooltip='For reflection MBZs: also check if projected pattern zone would penetrate gap deeper than mitigating candle')
enable_super_mbzs = input.bool(true, 'Mark Nested MBZs', group=GROUP_MBZ_DETECTION_MARKERS, inline='nested', tooltip='Mark MBZs that overlap with other same-direction MBZs using ✔️ checkmark')
show_50_percent_tags = input.bool(true, 'Mark 50% Formation MBZs', group=GROUP_MBZ_DETECTION_MARKERS, inline='fifty', tooltip='Add [½] tag when MBZ forms at exactly 50% of mitigation candle')

// === ⭐ WICK DOMINANCE ANALYSIS ===
enable_wick_dominance_markers = input.bool(false, 'Mark Wick-Dominant MBZs', group=GROUP_WICK_ANALYSIS, inline='wick1', tooltip='Mark MBZs where the wick is significantly larger than the body with colored stars')
wick_star_size = input.string(TEXT_SIZE_TINY, INPUT_LABEL_STAR_SIZE, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_WICK_ANALYSIS, inline='wick1', tooltip='Size of wick dominance stars')
standard_star_color = input.color(color.blue, 'Standard', group=GROUP_WICK_ANALYSIS, inline='wick2', tooltip='Standard ≥100% wick-to-body ratio | Relaxed ≥85% | Risky ≥80%')
relaxed_star_color = input.color(color.black, 'Relaxed', group=GROUP_WICK_ANALYSIS, inline='wick2', tooltip='Relaxed wick dominance threshold')
risky_star_color = input.color(color.orange, 'Risky', group=GROUP_WICK_ANALYSIS, inline='wick2', tooltip='Risky wick dominance threshold')

// === 📦 MULTI-SOURCE PROPERTIES ===
enable_multi_source_highlighting = input.bool(true, "Show Multi-Source MBZ Borders", group=GROUP_MULTI_SOURCE_PROPERTIES, inline='multi', tooltip='Display enhanced borders around MBZs formed from multiple gap sources for visual distinction')
multi_source_border_color = input.color(color.new(color.orange, 0), "Color", group=GROUP_MULTI_SOURCE_PROPERTIES, inline='multi', tooltip='Border color for multi-source MBZ highlighting')
multi_source_border_width = input.int(DEFAULT_MULTI_SOURCE_BORDER_WIDTH, "Width", minval=MIN_BORDER_WIDTH, maxval=MAX_BORDER_WIDTH, group=GROUP_MULTI_SOURCE_PROPERTIES, inline='multi', tooltip='Border width for MBZs formed from multiple gap sources (1-5px limit)')
multi_source_strong_display_mode = input.string(MULTI_SOURCE_STRONG_DISPLAY_BOTH, 'Strength Tag', options=[MULTI_SOURCE_STRONG_DISPLAY_OFF, MULTI_SOURCE_STRONG_DISPLAY_LABEL, MULTI_SOURCE_STRONG_DISPLAY_EXTENSION, MULTI_SOURCE_STRONG_DISPLAY_BOTH], group=GROUP_MULTI_SOURCE_PROPERTIES, inline='multi_strong_toggle', tooltip='Where to show the [STRONG] marker when the consolidated zone meets the multi-source strength criteria. Extension placement renders above the main label when enabled.')
multi_source_strong_min_sources = input.int(DEFAULT_MULTI_SOURCE_STRENGTH_MIN_SOURCES, INPUT_LABEL_MULTI_SOURCE_STRENGTH_MIN, minval=MIN_MULTI_SOURCE_STRENGTH_MIN_SOURCES, maxval=MAX_MULTI_SOURCE_STRENGTH_MIN_SOURCES, group=GROUP_MULTI_SOURCE_PROPERTIES, inline='multi_strong_logic', tooltip='Minimum number of MBZ source gaps consolidated on the candle before [STRONG] is applied.')
multi_source_strong_include_distinct = input.bool(true, MULTI_SOURCE_STRENGTH_INCLUDE_DISTINCT, group=GROUP_MULTI_SOURCE_PROPERTIES, inline='multi_strong_logic', tooltip='Mark [STRONG] when the consolidated MBZ blends different source types (e.g., fvg + imp).')
multi_source_strong_include_same = input.bool(false, MULTI_SOURCE_STRENGTH_INCLUDE_SAME, group=GROUP_MULTI_SOURCE_PROPERTIES, inline='multi_strong_logic', tooltip='Mark [STRONG] when the consolidated MBZ is built from the same source type repeated (e.g., vol×3).')

// === 🔥 BREAKAWAY PROPERTIES ===
label_breakaway_fvgs = input.bool(true, "Show Breakaway Label", group=GROUP_BREAKAWAY_PROPERTIES, inline='breakaway1', tooltip='Add "BREAKAWAY" prefix to MBZ labels formed from breakaway FVGs')
enable_breakaway_custom_colors = input.bool(false, "Custom Breakaway Colors", group=GROUP_BREAKAWAY_PROPERTIES, inline='breakaway1', tooltip='Use custom colors for active breakaway MBZ extension boxes (invalidated zones always use invalidation color)')
breakaway_bullish_color = input.color(color.new(#4dd0e1, 80), "MBZ⁺", group=GROUP_BREAKAWAY_PROPERTIES, inline='breakaway2', tooltip='Extension box color for active bullish breakaway MBZs')
breakaway_bearish_color = input.color(color.new(#f70bf1, 80), "MBZ⁻", group=GROUP_BREAKAWAY_PROPERTIES, inline='breakaway2', tooltip='Extension box color for active bearish breakaway MBZs')

// === ⚙️ IMPLIED SOURCE SETTINGS ===
displacement_multiplier = input.float(DEFAULT_IMPLIED_DISPLACEMENT_MULTIPLIER, INPUT_LABEL_IMPLIED_DISPLACEMENT, minval=IMPLIED_DISPLACEMENT_MULTIPLIER_MIN, maxval=IMPLIED_DISPLACEMENT_MULTIPLIER_MAX, step=IMPLIED_DISPLACEMENT_MULTIPLIER_STEP, group=GROUP_IMPLIED_SOURCE_SETTINGS, inline='implied', tooltip='C2 body size multiplier vs recent average for Implied FVG validation (1.0-5.0x limit)')
lookback_candles = input.int(DEFAULT_IMPLIED_DISPLACEMENT_LOOKBACK_CANDLES, INPUT_LABEL_LOOKBACK, minval=MIN_IMPLIED_DISPLACEMENT_LOOKBACK_CANDLES, maxval=MAX_IMPLIED_DISPLACEMENT_LOOKBACK_CANDLES, group=GROUP_IMPLIED_SOURCE_SETTINGS, inline='implied', tooltip='SOURCE SETTINGS SUMMARY:\n• Displacement Multiplier: How much larger C2 body must be vs recent average (1.0-5.0x)\n• Lookback Candles: Number of recent bars to calculate body size average (3-5 bars)\n\nThese settings only affect Implied FVG detection - other gap types use standard criteria')
// RDRB detection requires C2 body within C1 wick

// === 🚨 BREACH DETECTION ===
// Core Settings
enable_breach_detection = input.bool(false, INPUT_LABEL_ENABLE_BREACH_DETECTION, group=GROUP_BREACH_DETECTION, inline='core', tooltip='Enable breach detection system - monitors when price enters MBZ zones before invalidation')
breach_method = input.string(BREACH_METHOD_TRADE_THROUGH, INPUT_LABEL_METHOD, options=[BREACH_METHOD_TRADE_THROUGH, BREACH_METHOD_BODY_BREACH], group=GROUP_BREACH_DETECTION, inline='core', tooltip='Trade Through: Any price movement into zone (wicks + bodies)\nBody Breach: Only when candle body (open/close) enters zone')
breach_threshold_percent = input.float(DEFAULT_BREACH_THRESHOLD, INPUT_LABEL_THRESHOLD_PERCENT, minval=MIN_THRESHOLD_PERCENT, maxval=MAX_THRESHOLD_PERCENT, step=1.0, group=GROUP_BREACH_DETECTION, inline='core', tooltip='Percentage of zone that must be penetrated to trigger breach detection (1-99%)')

// Visual Response
enable_zone_fade = input.bool(true, INPUT_LABEL_FADE_EXTENSION_BOX, group=GROUP_BREACH_DETECTION, inline='visual1', tooltip='Reduce extension box opacity when breach occurs')
breach_transparency_percent = input.int(TRANSPARENCY_BREACH_DEFAULT, INPUT_LABEL_OPACITY_PERCENT, minval=MIN_BREACH_TRANSPARENCY_PERCENT, maxval=MAX_BREACH_TRANSPARENCY_PERCENT, group=GROUP_BREACH_DETECTION, inline='visual1', tooltip='Extension box transparency level after breach (10-90%)')
enable_text_color_change = input.bool(true, INPUT_LABEL_ALTERNATIVE_TEXT, group=GROUP_BREACH_DETECTION, inline='visual2', tooltip='Change label text color when breach occurs')
breach_label_color = input.color(color.new(color.red, TRANSPARENCY_LIGHT), INPUT_LABEL_BREACHED_TEXT_COLOR, group=GROUP_BREACH_DETECTION, inline='visual2', tooltip='Text color for breached MBZ labels')

// Breach Lines
enable_breached_lines = input.bool(false, INPUT_LABEL_BREACH_LINES, group=GROUP_BREACH_DETECTION, inline='breach')
breached_line_color = input.color(color.new(color.red, TRANSPARENCY_LIGHT), '', group=GROUP_BREACH_DETECTION, inline='breach')
breached_line_style = input.string(LINE_STYLE_DASHED, '', options=[LINE_STYLE_SOLID, LINE_STYLE_DASHED, LINE_STYLE_DOTTED], group=GROUP_BREACH_DETECTION, inline='breach')
breached_line_width = input.int(LINE_WIDTH_THIN, '', minval=MIN_BORDER_WIDTH, maxval=MAX_BORDER_WIDTH, group=GROUP_BREACH_DETECTION, inline='breach')
breached_line_transparency = input.int(TRANSPARENCY_LIGHT, '', minval=MIN_LINE_TRANSPARENCY, maxval=MAX_LINE_TRANSPARENCY, group=GROUP_BREACH_DETECTION, inline='breach')

// Invalidation Lines
enable_invalidation_lines = input.bool(false, INPUT_LABEL_INVALIDATION_LINES, group=GROUP_BREACH_DETECTION, inline='invalidation')
invalidation_line_color = input.color(color.new(color.gray, TRANSPARENCY_MEDIUM), '', group=GROUP_BREACH_DETECTION, inline='invalidation')
invalidation_line_style = input.string(LINE_STYLE_SOLID, '', options=[LINE_STYLE_SOLID, LINE_STYLE_DASHED, LINE_STYLE_DOTTED], group=GROUP_BREACH_DETECTION, inline='invalidation')
invalidation_line_width = input.int(LINE_WIDTH_MEDIUM, '', minval=MIN_BORDER_WIDTH, maxval=MAX_BORDER_WIDTH, group=GROUP_BREACH_DETECTION, inline='invalidation')
invalidation_line_transparency = input.int(TRANSPARENCY_HEAVY, '', minval=MIN_LINE_TRANSPARENCY, maxval=MAX_LINE_TRANSPARENCY, group=GROUP_BREACH_DETECTION, inline='invalidation', tooltip='BREACH DETECTION SUMMARY:\n• Core Settings: Enable system, choose detection method (Trade Through/Body Breach), set threshold %\n• Visual Response: Control extension box fading and label color changes on breach\n• Breach Lines: Add visual breach threshold lines with custom color/style/width/transparency\n• Invalidation Lines: Add visual invalidation threshold lines (separate from breach lines)\n\nNote: Breach occurs before invalidation - provides early warning system')

// === 📈 PROJECTIONS ===
project_last_n_mbzs = input.int(DEFAULT_PROJECT_LAST_N, INPUT_LABEL_PROJECT_LAST_N, minval=MIN_PROJECT_LAST_N, maxval=MAX_PROJECT_LAST_N, group=GROUP_PROJECTIONS, inline='proj1', tooltip='Projection settings\nProject Last N: number of recent valid MBZs to project. Max: 20\nEnable Projections: show projection lines from valid MBZs\nNo. of Bars: bars to extend projections')
show_mbz_projections = input.bool(false, INPUT_LABEL_ENABLE_PROJECTIONS, group=GROUP_PROJECTIONS, inline='proj1')
projection_extend_bars = input.int(DEFAULT_PROJECTION_BARS, INPUT_LABEL_NO_OF_BARS, minval=MIN_PROJECTION_BARS, maxval=MAX_PROJECTION_BARS, group=GROUP_PROJECTIONS, inline='proj1')
projection_line_width = input.int(LINE_WIDTH_THIN, INPUT_LABEL_LINE_WIDTH, minval=MIN_PROJECTION_LINE_WIDTH, maxval=MAX_PROJECTION_LINE_WIDTH, group=GROUP_PROJECTIONS, inline='proj2', tooltip='Projection line settings\nLine Width: thickness of projection lines. Max: 3\nLine Style: visual style of lines\nLabel Side: where to place level labels')
projection_line_style = input.string(LINE_STYLE_DOTTED, INPUT_LABEL_LINE_STYLE, options=[LINE_STYLE_SOLID, LINE_STYLE_DASHED, LINE_STYLE_DOTTED], group=GROUP_PROJECTIONS, inline='proj2')
projection_label_side = input.string(LABEL_POSITION_RIGHT, INPUT_LABEL_LABEL_SIDE, options=[LABEL_POSITION_LEFT, LABEL_POSITION_RIGHT], group=GROUP_PROJECTIONS, inline='proj2')

// Boundaries
show_boundaries = input.bool(true, INPUT_LABEL_BOUNDARIES, group=GROUP_PROJECTIONS, inline='levels1', tooltip='Show zone boundaries\nBoundaries: levels 0 (close) and 1 (open)\nLabel: color and text size for boundary labels')
boundary_color = input.color(color.black, INPUT_LABEL_LABEL, group=GROUP_PROJECTIONS, inline='levels1', tooltip='Color for boundary levels')
boundary_text_size = input.string(TEXT_SIZE_TINY, INPUT_LABEL_SIZE, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_PROJECTIONS, inline='levels1', tooltip='Text size for boundary labels')

// CE (50%)
show_ce = input.bool(false, INPUT_LABEL_CE, group=GROUP_PROJECTIONS, inline='levels1_5', tooltip='Show 50% center level\nCE: equilibrium level at 50%\nLabel: color and text size for center level')
ce_color = input.color(color.gray, INPUT_LABEL_LABEL, group=GROUP_PROJECTIONS, inline='levels1_5', tooltip='Color for 50% center level')
ce_text_size = input.string(TEXT_SIZE_TINY, INPUT_LABEL_SIZE, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_PROJECTIONS, inline='levels1_5', tooltip='Text size for 50% center label')

// Quadrants
show_quadrants = input.bool(false, INPUT_LABEL_QUADRANTS, group=GROUP_PROJECTIONS, inline='levels2', tooltip='Show quarter levels between boundaries\nQuadrants: 25% and 75% levels\nLabel: color and text size for quadrant levels')
quadrant_color = input.color(color.yellow, INPUT_LABEL_LABEL, group=GROUP_PROJECTIONS, inline='levels2', tooltip='Color for quadrant levels')
quadrant_text_size = input.string(TEXT_SIZE_TINY, INPUT_LABEL_SIZE, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_PROJECTIONS, inline='levels2', tooltip='Text size for quadrant labels')

// Stops
show_stops = input.bool(true, INPUT_LABEL_STOPS, group=GROUP_PROJECTIONS, inline='levels3', tooltip='Show stop levels beyond open\nStops: potential stop loss levels (1.25, 1.5, 2.0)\nLabel: color and text size for stop levels')
stop_color = input.color(color.red, INPUT_LABEL_LABEL, group=GROUP_PROJECTIONS, inline='levels3', tooltip='Color for stop levels')
stop_text_size = input.string(TEXT_SIZE_TINY, INPUT_LABEL_SIZE, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_PROJECTIONS, inline='levels3', tooltip='Text size for stop labels')

// Targets
show_targets = input.bool(true, INPUT_LABEL_TARGETS, group=GROUP_PROJECTIONS, inline='levels4', tooltip='Show target levels beyond close\nTargets: potential profit target levels (-2.0, -2.5, -4, -4.5)\nLabel: color and text size for target levels')
target_color = input.color(color.green, INPUT_LABEL_LABEL, group=GROUP_PROJECTIONS, inline='levels4', tooltip='Color for target levels')
target_text_size = input.string(TEXT_SIZE_TINY, INPUT_LABEL_SIZE, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_PROJECTIONS, inline='levels4', tooltip='Text size for target labels')

// Custom
show_custom = input.bool(false, INPUT_LABEL_CUSTOM_LEVELS, group=GROUP_PROJECTIONS, inline='levels5', tooltip='Use custom level list\nCustom Levels: enable custom projection levels\nCustom List: comma-separated values (e.g., 0, 1, 1.5, -2.33, -4)\nLabel: color and text size for custom level labels')
custom_levels_input = input.string('0, 1, 1.5, -2.33, -4', INPUT_LABEL_CUSTOM_LIST, group=GROUP_PROJECTIONS, inline='levels5', tooltip='Comma-separated levels for projections')
custom_text_size = input.string(TEXT_SIZE_TINY, INPUT_LABEL_SIZE, options=[TEXT_SIZE_TINY, TEXT_SIZE_SMALL, TEXT_SIZE_NORMAL, TEXT_SIZE_LARGE], group=GROUP_PROJECTIONS, inline='levels5', tooltip='Text size for custom labels')

// === 🚨 ALERT SETTINGS === (see docs for full behavior)
alert_mode = input.string(ALERT_MODE_GROUPED, "Alert Mode", options=[ALERT_MODE_INDIVIDUAL, ALERT_MODE_GROUPED, ALERT_MODE_BOTH], group=GROUP_ALERT_SETTINGS, tooltip="Individual: Create alerts per condition (select a specific condition)\nGrouped: Create ONE alert with 'Any alert() function call' (uses checkboxes below)\nBoth: Use both methods; may produce duplicate notifications")

enable_mbz_plus_formation = input.bool(true, MBZ_PLUS, group=GROUP_ALERT_SETTINGS, inline="core1", tooltip=ALERT_TOOLTIP_PREFIX + MBZ_PLUS + ALERT_TOOLTIP_SUFFIX)
enable_mbz_minus_formation = input.bool(true, MBZ_MINUS, group=GROUP_ALERT_SETTINGS, inline="core1", tooltip=ALERT_TOOLTIP_PREFIX + MBZ_MINUS + ALERT_TOOLTIP_SUFFIX)

enable_multi_source_mbz_plus = input.bool(true, ALERT_TITLE_MULTI_SOURCE_MBZ_PLUS, group=GROUP_ALERT_SETTINGS, inline="multi1", tooltip=ALERT_TOOLTIP_PREFIX + ALERT_TITLE_MULTI_SOURCE_MBZ_PLUS + ALERT_TOOLTIP_SUFFIX)
enable_multi_source_mbz_minus = input.bool(true, ALERT_TITLE_MULTI_SOURCE_MBZ_MINUS, group=GROUP_ALERT_SETTINGS, inline="multi1", tooltip=ALERT_TOOLTIP_PREFIX + ALERT_TITLE_MULTI_SOURCE_MBZ_MINUS + ALERT_TOOLTIP_SUFFIX)
enable_strong_mbz_plus = input.bool(true, ALERT_TITLE_STRONG_MBZ_PLUS, group=GROUP_ALERT_SETTINGS, inline='multi_strong_alert', tooltip=ALERT_TOOLTIP_PREFIX + ALERT_TITLE_STRONG_MBZ_PLUS + ALERT_TOOLTIP_SUFFIX)
enable_strong_mbz_minus = input.bool(true, ALERT_TITLE_STRONG_MBZ_MINUS, group=GROUP_ALERT_SETTINGS, inline='multi_strong_alert', tooltip=ALERT_TOOLTIP_PREFIX + ALERT_TITLE_STRONG_MBZ_MINUS + ALERT_TOOLTIP_SUFFIX)

enable_nested_mbz_plus_alert = input.bool(true, ALERT_TITLE_NESTED_MBZ_PLUS, group=GROUP_ALERT_SETTINGS, inline="special1", tooltip=ALERT_TOOLTIP_PREFIX + ALERT_TITLE_NESTED_MBZ_PLUS + ALERT_TOOLTIP_SUFFIX)
enable_nested_mbz_minus_alert = input.bool(true, ALERT_TITLE_NESTED_MBZ_MINUS, group=GROUP_ALERT_SETTINGS, inline="special1", tooltip=ALERT_TOOLTIP_PREFIX + ALERT_TITLE_NESTED_MBZ_MINUS + ALERT_TOOLTIP_SUFFIX)

enable_deeper_wick_mbz_plus_alert = input.bool(true, ALERT_TITLE_DEEPER_WICK_MBZ_PLUS, group=GROUP_ALERT_SETTINGS, inline="special2", tooltip=ALERT_TOOLTIP_PREFIX + ALERT_TITLE_DEEPER_WICK_MBZ_PLUS + ALERT_TOOLTIP_SUFFIX)
enable_deeper_wick_mbz_minus_alert = input.bool(true, ALERT_TITLE_DEEPER_WICK_MBZ_MINUS, group=GROUP_ALERT_SETTINGS, inline="special2", tooltip=ALERT_TOOLTIP_PREFIX + ALERT_TITLE_DEEPER_WICK_MBZ_MINUS + ALERT_TOOLTIP_SUFFIX)

