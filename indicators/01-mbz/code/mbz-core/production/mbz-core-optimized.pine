// CONSTANTS & DATA STRUCTURES
// ═══════════════════════════════════════════════════════════════════════════════


// Gap tracking with unified structure
type GapData
    int bar_index
    float top
    float bottom
    bool is_bullish
    bool is_closed_through
    int creation_bar
    int gap_id
    string gap_type
    bool is_breakaway_gap    // True if gap breaks above/below trend range

var array<GapData> active_gaps = array.new<GapData>()

// MBZ tracking with SUPER MBZ detection
type MBZRecord
    int bar_index
    int formation_time        // NEW: Bar time when MBZ formed (for xloc.bar_time positioning)
    float high_price
    float low_price
    float mbz_open
    float mbz_close
    bool is_bullish
    bool is_invalidated
    float max_fill_percentage
    bool has_dominant_wick
    bool is_exactly_50_percent
    string mbz_subtype
    string cached_label_text
    string cached_tooltip
    float cached_zone_top
    float cached_zone_bottom
    bool cached_data_valid
    label mbz_label
    int source_gap_id
    // Cached source gap geometry to decouple from active_gaps retention
    int source_gap_bar_index
    float source_gap_top
    float source_gap_bottom
    string source_gap_type
    bool wicked_into_source_gap    // Track if wick penetrated deeper into source gap
    bool reflection_pattern_deeper // Track if reflection pattern wick was deeper
    // SUPER MBZ detection
    bool is_super_mbz            // true if overlapping with any same-direction MBZ
    float overlap_percentage     // 0.0 to 100.0
    int overlapping_mbz_bar_index // Which MBZ we overlapped with
    // Breakaway MBZ detection
    bool is_breakaway_mbz        // true if source gap was a breakaway gap

// Cached counts for multi-source evaluation
type SourceTypeStats
    int group_size
    int distinct_types
    int fvg_count
    int imp_count
    int vol_count
    int true_count
    int rdrb_count

// Wrapper type for map-based consolidation (Pine Script doesn't allow nested collections directly)
type MBZGroupWrapper
    array<MBZRecord> mbz_group

// Consolidated MBZ group type
type ConsolidatedMBZ
    array<MBZRecord> mbz_group
    int bar_index
    int formation_time        // NEW: Formation time for xloc.bar_time positioning
    bool is_bullish
    float consolidated_zone_top
    float consolidated_zone_bottom
    bool is_consolidated_breached
    bool is_consolidated_invalidated
    string consolidated_candle_label
    string consolidated_extension_label

var array<MBZRecord> all_mbz_records = array.new<MBZRecord>()  // Large pool for history
var int next_gap_id = 1  // Unique ID counter for gap tracking

// Visual elements
var array<box> source_gap_boxes = array.new_box()
var array<label> mbz_labels = array.new<label>()
var array<label> star_labels = array.new<label>()
var array<box> mbz_body_highlights = array.new_box()          // Body highlighting
var array<box> mbz_wick_highlights = array.new_box()          // Wick highlighting
var array<box> mbz_extended_boxes = array.new_box()           // Extension boxes
var array<line> mbz_projection_lines = array.new_line()       // Projection lines
var array<label> mbz_projection_labels = array.new<label>()   // Projection labels
var array<line> mbz_lines = array.new_line()                 // Breach level lines
var array<int> displayed_mbz_indices = array.new<int>()       // Display tracking
// Cache of consolidated groups from last visual render (for stars reuse)
var array<ConsolidatedMBZ> last_consolidated_mbzs = array.new<ConsolidatedMBZ>()


// Performance optimization flags
var bool needs_visual_update = true

// Pre-calculated padding strings (performance optimization)
horizontal_padding_str = ""
for i = 0 to extension_label_horizontal_padding - 1
    horizontal_padding_str := horizontal_padding_str + " "

vertical_padding_str = ""
for i = 0 to extension_label_vertical_padding - 1
    vertical_padding_str := vertical_padding_str + "\n"

// Effective capacity settings (Boost mode temporarily raises limits)
is_capacity_boost = capacity_mode == CAPACITY_MODE_BOOST
is_capacity_ultra_boost = capacity_mode == CAPACITY_MODE_ULTRA_BOOST
is_capacity_ultra_pro_boost = capacity_mode == CAPACITY_MODE_ULTRA_PRO_BOOST

// Base (Optimized)
base_valid_mbzs = max_valid_mbzs
base_invalidated_mbzs = max_invalidated_mbzs
base_records = MAX_MBZ_RECORDS                // 60 (updated for parity)
base_active_gaps = MAX_ACTIVE_GAPS            // 100
base_extended_boxes = MAX_EXTENDED_BOXES      // 75
base_body_highlights = MAX_BODY_HIGHLIGHTS    // 75
base_wick_highlights = MAX_WICK_HIGHLIGHTS    // 75
base_source_gap_boxes = max_source_gap_boxes  // input-bound

// Boost, Ultra & Ultra Pro multipliers applied to base limits (clamped to platform caps where needed)
boost_valid_mbzs = int(math.max(base_valid_mbzs, math.round(base_valid_mbzs * BOOST_MULTIPLIER)))
boost_records = int(math.max(base_records, math.round(base_records * BOOST_MULTIPLIER)))
boost_active_gaps = int(math.max(base_active_gaps, math.round(base_active_gaps * BOOST_MULTIPLIER)))
boost_extended_boxes = int(math.min(INDICATOR_MAX_BOXES, math.max(base_extended_boxes, math.round(base_extended_boxes * BOOST_MULTIPLIER))))
boost_body_highlights = int(math.min(INDICATOR_MAX_BOXES, math.max(base_body_highlights, math.round(base_body_highlights * BOOST_MULTIPLIER))))
boost_wick_highlights = int(math.min(INDICATOR_MAX_BOXES, math.max(base_wick_highlights, math.round(base_wick_highlights * BOOST_MULTIPLIER))))
boost_source_gap_boxes = int(math.min(INDICATOR_MAX_BOXES, math.max(base_source_gap_boxes, math.round(base_source_gap_boxes * BOOST_MULTIPLIER))))

ultra_valid_mbzs = int(math.max(base_valid_mbzs, math.round(base_valid_mbzs * ULTRA_BOOST_MULTIPLIER)))
ultra_records = int(math.max(base_records, math.round(base_records * ULTRA_BOOST_MULTIPLIER)))
ultra_active_gaps = int(math.max(base_active_gaps, math.round(base_active_gaps * ULTRA_BOOST_MULTIPLIER)))
ultra_extended_boxes = int(math.min(INDICATOR_MAX_BOXES, math.max(base_extended_boxes, math.round(base_extended_boxes * ULTRA_BOOST_MULTIPLIER))))
ultra_body_highlights = int(math.min(INDICATOR_MAX_BOXES, math.max(base_body_highlights, math.round(base_body_highlights * ULTRA_BOOST_MULTIPLIER))))
ultra_wick_highlights = int(math.min(INDICATOR_MAX_BOXES, math.max(base_wick_highlights, math.round(base_wick_highlights * ULTRA_BOOST_MULTIPLIER))))
ultra_source_gap_boxes = int(math.min(INDICATOR_MAX_BOXES, math.max(base_source_gap_boxes, math.round(base_source_gap_boxes * ULTRA_BOOST_MULTIPLIER))))

ultra_pro_valid_mbzs = int(math.max(base_valid_mbzs, math.round(base_valid_mbzs * ULTRA_PRO_BOOST_MULTIPLIER)))
ultra_pro_records = int(math.max(base_records, math.round(base_records * ULTRA_PRO_BOOST_MULTIPLIER)))
ultra_pro_active_gaps = int(math.max(base_active_gaps, math.round(base_active_gaps * ULTRA_PRO_BOOST_MULTIPLIER)))
ultra_pro_extended_boxes = int(math.min(INDICATOR_MAX_BOXES, math.max(base_extended_boxes, math.round(base_extended_boxes * ULTRA_PRO_BOOST_MULTIPLIER))))
ultra_pro_body_highlights = int(math.min(INDICATOR_MAX_BOXES, math.max(base_body_highlights, math.round(base_body_highlights * ULTRA_PRO_BOOST_MULTIPLIER))))
ultra_pro_wick_highlights = int(math.min(INDICATOR_MAX_BOXES, math.max(base_wick_highlights, math.round(base_wick_highlights * ULTRA_PRO_BOOST_MULTIPLIER))))
ultra_pro_source_gap_boxes = int(math.min(INDICATOR_MAX_BOXES, math.max(base_source_gap_boxes, math.round(base_source_gap_boxes * ULTRA_PRO_BOOST_MULTIPLIER))))

// Effective selections
max_valid_mbzs_effective = is_capacity_ultra_pro_boost ? ultra_pro_valid_mbzs : is_capacity_ultra_boost ? ultra_valid_mbzs : is_capacity_boost ? boost_valid_mbzs : base_valid_mbzs
max_invalidated_mbzs_effective = base_invalidated_mbzs
max_mbz_records_effective = is_capacity_ultra_pro_boost ? ultra_pro_records : is_capacity_ultra_boost ? ultra_records : is_capacity_boost ? boost_records : base_records
max_active_gaps_effective = is_capacity_ultra_pro_boost ? ultra_pro_active_gaps : is_capacity_ultra_boost ? ultra_active_gaps : is_capacity_boost ? boost_active_gaps : base_active_gaps
max_extended_boxes_effective = is_capacity_ultra_pro_boost ? ultra_pro_extended_boxes : is_capacity_ultra_boost ? ultra_extended_boxes : is_capacity_boost ? boost_extended_boxes : base_extended_boxes
max_body_highlights_effective = is_capacity_ultra_pro_boost ? ultra_pro_body_highlights : is_capacity_ultra_boost ? ultra_body_highlights : is_capacity_boost ? boost_body_highlights : base_body_highlights
max_wick_highlights_effective = is_capacity_ultra_pro_boost ? ultra_pro_wick_highlights : is_capacity_ultra_boost ? ultra_wick_highlights : is_capacity_boost ? boost_wick_highlights : base_wick_highlights
max_source_gap_boxes_effective = is_capacity_ultra_pro_boost ? math.max(base_source_gap_boxes, ultra_pro_source_gap_boxes) : is_capacity_ultra_boost ? math.max(base_source_gap_boxes, ultra_source_gap_boxes) : is_capacity_boost ? math.max(base_source_gap_boxes, boost_source_gap_boxes) : base_source_gap_boxes
var int last_update_bar = na
var bool needs_full_update = true
var bool initialized = false

// ═══════════════════════════════════════════════════════════════════════════════
// BASIC HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════════
// GAP DETECTION FUNCTIONS - CORE SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

// @function is_bullish_fvg
// @description Detects 3-candle bullish Fair Value Gap formation using institutional gap detection logic
// @returns bool - true if bullish FVG detected, false otherwise
// @details
//   • Condition: high[2] < low (complete range separation between C1 and C3)
//   • C1 = 2 bars ago (establishes lower boundary), C2 = transition, C3 = current (establishes upper boundary)
//   • Gap coordinates: bottom = low (current), top = high[2] (C1 high)
//   • Institutional priority: Always detected, never suppressed by other gap types
is_bullish_fvg() => low > high[2]

// @function is_bearish_fvg
// @description Detects 3-candle bearish Fair Value Gap formation using institutional gap detection logic
// @returns bool - true if bearish FVG detected, false otherwise
// @details
//   • Condition: high < low[2] (complete range separation between C1 and C3)
//   • C1 = 2 bars ago (establishes upper boundary), C2 = transition, C3 = current (establishes lower boundary)
//   • Gap coordinates: top = low[2] (C1 low), bottom = high (current)
//   • Institutional priority: Always detected, never suppressed by other gap types
is_bearish_fvg() => high < low[2]

// @function is_bullish_vi
// @description Detects 2-candle bullish Volume Imbalance with body separation and wick overlap validation
// @returns bool - true if bullish VI detected, false otherwise
// @details
//   • Condition: Current bullish body completely above previous bearish body, but wicks still connect
//   • Body separation: min(current open/close) > max(previous open/close)
//   • Wick connection: current low <= previous high (wicks bridge the body gap)
//   • Gap coordinates: bottom = current body bottom, top = previous body top
//   • Retail priority: Can be suppressed by FVGs, Implied FVGs, and True Gaps
is_bullish_vi() =>
    bodies_separated = math.min(open, close) > math.max(open[1], close[1])
    wicks_still_connect = low <= high[1]  // Current low reaches previous high
    bodies_separated and wicks_still_connect

// @function is_bearish_vi
// @description Detects 2-candle bearish Volume Imbalance with body separation and wick overlap validation
// @returns bool - true if bearish VI detected, false otherwise
// @details
//   • Condition: Current bearish body completely below previous bullish body, but wicks still connect
//   • Body separation: max(current open/close) < min(previous open/close)
//   • Wick connection: current high >= previous low (wicks bridge the body gap)
//   • Gap coordinates: top = current body top, bottom = previous body bottom
//   • Retail priority: Can be suppressed by FVGs, Implied FVGs, and True Gaps
is_bearish_vi() =>
    bodies_separated = math.max(open, close) < math.min(open[1], close[1])
    wicks_still_connect = high >= low[1]  // Current high reaches previous low
    bodies_separated and wicks_still_connect

// @function bodyTop
// @description Calculates the top boundary of a candle body (excluding wicks)
// @param o float - open price
// @param c float - close price
// @returns float - higher of open or close (body top boundary)
bodyTop(o, c) => math.max(o, c)

// @function bodyBot
// @description Calculates the bottom boundary of a candle body (excluding wicks)
// @param o float - open price
// @param c float - close price
// @returns float - lower of open or close (body bottom boundary)
bodyBot(o, c) => math.min(o, c)

// Reusable text size helper
get_text_size(size_string) =>
    switch size_string
        TEXT_SIZE_TINY => size.tiny
        TEXT_SIZE_SMALL => size.small
        TEXT_SIZE_NORMAL => size.normal
        TEXT_SIZE_LARGE => size.large
        => size.small

// Convert string alignment selections into Pine text alignment enums
get_horizontal_alignment(alignment_setting) =>
    alignment_setting == LABEL_ALIGNMENT_LEFT ? text.align_left : alignment_setting == LABEL_ALIGNMENT_RIGHT ? text.align_right : text.align_center

get_vertical_alignment(alignment_setting) =>
    alignment_setting == LABEL_VERTICAL_TOP ? text.align_top : alignment_setting == LABEL_VERTICAL_BOTTOM ? text.align_bottom : text.align_center

get_extension_label_halign() => get_horizontal_alignment(extension_label_horizontal_alignment)

get_extension_label_valign() => get_vertical_alignment(extension_label_vertical_alignment)

// Size helpers
get_mbz_label_size() => get_text_size(mbz_label_size)
get_invalidated_mbz_size() => get_text_size(mbz_invalidated_size)
get_label_size() => get_text_size(label_size)
get_extended_box_text_size() => get_text_size(extended_box_text_size)
get_wick_star_size() => get_text_size(wick_star_size)

// Source gap deeper wick detection helper functions
should_show_source_gap_wick_star() =>
    source_gap_wick_detection_mode == SOURCE_GAP_DEEPER_WICK_ICON or source_gap_wick_detection_mode == SOURCE_GAP_DEEPER_WICK_BOTH

should_show_source_gap_wick_border() =>
    source_gap_wick_detection_mode == SOURCE_GAP_DEEPER_WICK_BORDER or source_gap_wick_detection_mode == SOURCE_GAP_DEEPER_WICK_BOTH

is_source_gap_wick_detection_enabled() =>
    source_gap_wick_detection_mode != SOURCE_GAP_DEEPER_WICK_OFF

get_deeper_wick_icon() =>
    deeper_wick_icon_style == SOURCE_GAP_DEEPER_WICK_LABEL ? SOURCE_GAP_DEEPER_WICK_LABEL : SOURCE_GAP_DEEPER_WICK_ICON_CIRCLE


// Get invalidation threshold percentage
get_mbz_invalidation_threshold() =>
    switch mbz_invalidation_mode
        INVALIDATION_STANDARD => STANDARD_INVALIDATION_PERCENT    // LESS sensitive, LATER invalidation
        INVALIDATION_STRICT => STRICT_INVALIDATION_PERCENT        // MORE sensitive, EARLIER invalidation
        INVALIDATION_CUSTOM => custom_threshold_percent
        => 100.0

// Validated breach threshold - ensures breach is always below invalidation
get_validated_breach_threshold() =>
    invalidation_threshold = get_mbz_invalidation_threshold()
    breach_threshold_percent < invalidation_threshold ? breach_threshold_percent : invalidation_threshold - 5.0

get_projection_line_style() =>
    switch projection_line_style
        LINE_STYLE_SOLID => line.style_solid
        LINE_STYLE_DASHED => line.style_dashed
        LINE_STYLE_DOTTED => line.style_dotted
        => line.style_solid

// Get breach line style based on user setting
get_breached_line_style() =>
    switch breached_line_style
        LINE_STYLE_SOLID => line.style_solid
        LINE_STYLE_DASHED => line.style_dashed
        LINE_STYLE_DOTTED => line.style_dotted
        => line.style_dashed

// Calculate breach level price for a given MBZ zone
get_breached_level_price(zone_top, zone_bottom, is_bullish_mbz) =>
    if not enable_breached_lines
        na
    else
        validated_breach_threshold = get_validated_breach_threshold()
        zone_height = zone_top - zone_bottom
        breach_distance = zone_height * (validated_breach_threshold / 100.0)

        if is_bullish_mbz
            // For MBZ⁺, breach level is INSIDE zone from top boundary
            zone_top - breach_distance
        else
            // For MBZ⁻, breach level is INSIDE zone from bottom boundary
            zone_bottom + breach_distance

// Get breach line color based on current breach status
get_breached_line_color() =>
    // Apply user-defined transparency to breach line color
    color.new(color.rgb(color.r(breached_line_color), color.g(breached_line_color), color.b(breached_line_color)), breached_line_transparency)

// Get invalidation line style based on user setting
get_invalidation_line_style() =>
    switch invalidation_line_style
        LINE_STYLE_SOLID => line.style_solid
        LINE_STYLE_DASHED => line.style_dashed
        LINE_STYLE_DOTTED => line.style_dotted
        => line.style_solid

// Get invalidation line color
get_invalidation_line_color() =>
    // Apply user-defined transparency to invalidation line color
    color.new(color.rgb(color.r(invalidation_line_color), color.g(invalidation_line_color), color.b(invalidation_line_color)), invalidation_line_transparency)

// ═══════════════════════════════════════════════════════════════════════════════
// GAP SOURCE AND SUBTYPE DISPLAY MAPPING
// ═══════════════════════════════════════════════════════════════════════════════

// Get display name for gap source (lowercase for labels)
get_gap_source_display(gap_type) =>
    switch gap_type
        GAP_TYPE_FVG => GAP_SOURCE_FVG_BREAKDOWN_DISPLAY  // FVG abbreviation for breakdown
        GAP_TYPE_IMPLIED => GAP_SOURCE_IMPLIED_DISPLAY
        GAP_TYPE_VOLUME => GAP_SOURCE_VOLUME_DISPLAY
        GAP_TYPE_TRUE => GAP_SOURCE_TRUE_DISPLAY
        GAP_TYPE_RDRB => GAP_SOURCE_RDRB_DISPLAY
        => ""

// Get display name for subtype with arrows (lowercase for labels)
get_subtype_display(mbz_subtype, is_bullish) =>
    if str.contains(mbz_subtype, SUBTYPE_INCLUSION)
        if is_bullish
            ARROW_DOWN_INC  // Bullish inclusion = lower wick dominant (toward body)
        else
            ARROW_UP_INC  // Bearish inclusion = upper wick dominant (toward body)
    else if str.contains(mbz_subtype, SUBTYPE_REFLECTION)
        if is_bullish
            ARROW_UP_REF  // Bullish reflection = upper wick dominant (away from body)
        else
            ARROW_DOWN_REF  // Bearish reflection = lower wick dominant (away from body)
    else
        ""  // No suffix for standard

// Get display name for subtype with risk indicator properly positioned after behavior
get_risky_subtype_display(mbz_subtype, is_bullish, is_risky) =>
    if str.contains(mbz_subtype, SUBTYPE_INCLUSION)
        if is_bullish
            is_risky ? ARROW_DOWN_INC_RISKY : ARROW_DOWN_INC
        else
            is_risky ? ARROW_UP_INC_RISKY : ARROW_UP_INC
    else if str.contains(mbz_subtype, SUBTYPE_REFLECTION)
        if is_bullish
            is_risky ? ARROW_UP_REF_RISKY : ARROW_UP_REF
        else
            is_risky ? ARROW_DOWN_REF_RISKY : ARROW_DOWN_REF
    else
        ""  // No suffix for standard

// ═══════════════════════════════════════════════════════════════════════════════
// DISPLACEMENT AND ADVANCED GAP DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

// @function is_displacement_candle
// @description Validates C2 (middle candle) shows significant institutional displacement strength
// @returns bool - true if C2 body size exceeds displacement threshold, false otherwise
// @details
//   • Calculates C2 body size: abs(close[1] - open[1])
//   • Compares against recent average body size (lookback_candles period)
//   • Displacement threshold: C2 body >= displacement_multiplier × average_body_size
//   • Used as pre-filter for Implied FVG detection to ensure institutional strength
//   • Prevents false signals from weak consolidation patterns
is_displacement_candle() =>
    // Calculate C2 body size
    c2_body_size = math.abs(close[1] - open[1])

    // Calculate average body size of recent candles (efficient: last 3-5 only)
    total_body_size = 0.0
    for i = 2 to (1 + lookback_candles)
        total_body_size += math.abs(close[i] - open[i])

    average_body_size = total_body_size / lookback_candles

    // Require C2 body >= multiplier * average (avoid division by zero)
    if average_body_size > 0
        c2_body_size >= (displacement_multiplier * average_body_size)
    else
        false

// @function detect_implied_fvg
// @description Advanced 3-candle Implied FVG detection using body separation with wick overlap validation
// @returns [bool, float, float, bool] - [is_valid, bottom, top, is_bullish]
// @details COMPLEX ALGORITHM - CORE INSTITUTIONAL GAP DETECTION
//   • Purpose: Detects institutional positioning despite market noise (wicks overlap but bodies separate)
//   • Pre-filters: No existing FVG + displacement candle strength validation
//   • BULLISH Detection: C1 body top < C3 body bottom AND C1 upper wick overlaps C3 lower wick
//   • BEARISH Detection: C1 body bottom > C3 body top AND C1 lower wick overlaps C3 upper wick
//   • Critical: Uses STRICT overlap rule (> not >=) to avoid false positives
//   • Coordinates: Uses body boundaries for gap calculation (institutional discipline level)
//   • Institutional priority: Equal to FVGs, never suppressed
detect_implied_fvg() =>
    // Pre-filter: Check for visible FVGs first
    has_bull_fvg = is_bullish_fvg()
    has_bear_fvg = is_bearish_fvg()

    // Pre-filter: Check displacement candle strength
    if not is_displacement_candle()
        [false, float(na), float(na), bool(na)]
    else
        result_found = false
        result_bottom = float(na)
        result_top = float(na)
        result_bullish = bool(na)

        // ---- BULLISH IFVG DETECTION ----
        if not has_bull_fvg and not result_found
            // Step 1: Bullish wick validation
            c1_top = bodyTop(open[2], close[2])
            c3_bot = bodyBot(open, close)

            // Check if both wicks exist
            bull_wicks_present = (high[2] > c1_top) and (c3_bot > low)

            if bull_wicks_present
                // Compute overlap with STRICT rule (> not >=)
                overlap_lo = math.max(c1_top, low)
                overlap_hi = math.min(high[2], c3_bot)
                has_bull_overlap = overlap_hi > overlap_lo

                if has_bull_overlap and c1_top < c3_bot
                    result_found := true
                    result_bottom := c1_top
                    result_top := c3_bot
                    result_bullish := true

        // ---- BEARISH IFVG DETECTION ----
        if not has_bear_fvg and not result_found
            // Step 1: Bearish wick validation
            c1_bot = bodyBot(open[2], close[2])
            c3_top = bodyTop(open, close)

            // Check if both wicks exist
            bear_wicks_present = (c1_bot > low[2]) and (high > c3_top)

            if bear_wicks_present
                // Compute overlap with STRICT rule (> not >=)
                overlap_lo = math.max(low[2], c3_top)
                overlap_hi = math.min(c1_bot, high)
                has_bear_overlap = overlap_hi > overlap_lo

                if has_bear_overlap and c3_top < c1_bot
                    result_found := true
                    result_bottom := c3_top
                    result_top := c1_bot
                    result_bullish := false

        // Return final result
        [result_found, result_bottom, result_top, result_bullish]

// @function get_vi_coordinates
// @description Calculates Volume Imbalance gap coordinates using 2-candle body separation
// @param is_bullish_gap bool - direction of VI gap
// @returns [float, float] - [top, bottom] gap boundaries
// @details COORDINATE CALCULATION ALGORITHM:
//   • BULLISH VI: Current bullish body above previous bearish body
//     - gap_top = min(current open/close) = current body bottom
//     - gap_bottom = max(previous open/close) = previous body top
//   • BEARISH VI: Current bearish body below previous bullish body
//     - gap_top = min(previous open/close) = previous body bottom
//     - gap_bottom = max(current open/close) = current body top
//   • Critical: Always returns [top, bottom] where top > bottom (coordinate validation)
get_vi_coordinates(is_bullish_gap) =>
    if is_bullish_gap
        // Bullish VI: gap between C1 body top and C2 body bottom
        gap_bottom = math.max(open[1], close[1])  // C1 body top
        gap_top = math.min(open, close)           // C2 body bottom
        [gap_top, gap_bottom]
    else
        // Bearish VI: gap between C1 body bottom and C2 body top
        gap_top = math.min(open[1], close[1])     // C1 body bottom
        gap_bottom = math.max(open, close)        // C2 body top
        [gap_top, gap_bottom]

// @function is_vi_suppressed_by_gaps
// @description Checks if Volume Imbalance should be suppressed by higher-priority gaps in hierarchy
// @param vi_top float - upper boundary of VI gap
// @param vi_bottom float - lower boundary of VI gap
// @param is_vi_bullish bool - direction of VI gap
// @returns bool - true if VI should be suppressed, false if allowed
// @details GAP HIERARCHY SUPPRESSION ALGORITHM:
//   • Suppression conditions (ALL must be true):
//     1. Gap type: FVG, Implied FVG, or True Gap (higher priority than VI)
//     2. Direction match: gap.is_bullish == is_vi_bullish (same direction only)
//     3. Active status: not gap.is_closed_through (unfilled gaps only)
//     4. Spatial overlap: vi_bottom < gap.top AND vi_top >= gap.bottom
//   • Uses >= for edge case where VI exactly touches gap boundary
//   • Early exit: breaks loop immediately when overlap found (performance optimization)
is_vi_suppressed_by_gaps(vi_top, vi_bottom, is_vi_bullish) =>
    if array.size(active_gaps) == 0
        false  // No existing gaps = no suppression
    else
        has_overlap = false
        for i = 0 to array.size(active_gaps) - 1
            gap = array.get(active_gaps, i)

            // Gap hierarchy filter: FVG, Implied FVG, RDRB, and True Gap can suppress VI
            if (gap.gap_type == GAP_TYPE_FVG or gap.gap_type == GAP_TYPE_IMPLIED or gap.gap_type == GAP_TYPE_RDRB or gap.gap_type == GAP_TYPE_TRUE) and
               gap.is_bullish == is_vi_bullish and  // Same direction only
               not gap.is_closed_through            // Active (unfilled) gaps only

                // Spatial overlap detection: Mathematical overlap formula
                // Overlap exists if: vi_bottom < gap.top AND vi_top >= gap.bottom
                if vi_bottom < gap.top and vi_top >= gap.bottom
                    has_overlap := true
                    break  // Early exit: Found overlap, VI will be suppressed
        has_overlap

// @function is_true_gap_suppressed_by_gaps
// @description Checks if True Gap should be suppressed by any existing same-direction gap
// @param tg_top float - upper boundary of True Gap
// @param tg_bottom float - lower boundary of True Gap
// @param is_tg_bullish bool - direction of True Gap
// @returns bool - true if True Gap should be suppressed, false if allowed
// @details TRUE GAP SUPPRESSION ALGORITHM:
//   • True Gaps have lowest priority in hierarchy (suppressed by ALL other gap types)
//   • Suppression conditions (ALL must be true):
//     1. Direction match: gap.is_bullish == is_tg_bullish (same direction only)
//     2. Active status: not gap.is_closed_through (unfilled gaps only)
//     3. Spatial overlap: tg_bottom < gap.top AND tg_top > gap.bottom
//   • Unlike VI suppression: ANY gap type can suppress True Gaps (broadest suppression)
//   • Uses strict > rule (no boundary edge case handling needed)
is_true_gap_suppressed_by_gaps(tg_top, tg_bottom, is_tg_bullish) =>
    if array.size(active_gaps) == 0
        false  // No existing gaps = no suppression
    else
        has_overlap = false
        for i = 0 to array.size(active_gaps) - 1
            gap = array.get(active_gaps, i)

            // Broadest suppression: ANY gap type can suppress True Gap (lowest hierarchy priority)
            if gap.is_bullish == is_tg_bullish and  // Same direction only
               not gap.is_closed_through             // Active (unfilled) gaps only

                // Spatial overlap detection: Mathematical overlap formula
                // Overlap exists if: tg_bottom < gap.top AND tg_top > gap.bottom
                if tg_bottom < gap.top and tg_top > gap.bottom
                    has_overlap := true
                    break  // Early exit: Found overlap, True Gap will be suppressed
        has_overlap

// True Gap Detection Functions (Pure Price Gaps)
is_bullish_true_gap() =>
    // Pure bullish gap: C3 low is above C1 high with no body/wick overlap
    high[2] < low and not (is_bullish_fvg() or is_bearish_fvg())  // Exclude if already an FVG

is_bearish_true_gap() =>
    // Pure bearish gap: C3 high is below C1 low with no body/wick overlap
    low[2] > high and not (is_bullish_fvg() or is_bearish_fvg())  // Exclude if already an FVG

detect_true_gap() =>
    // Check for True Gap formation (3-candle structure like FVG)
    result_found = false
    result_bottom = float(na)
    result_top = float(na)
    result_bullish = bool(na)

    if is_bullish_true_gap()
        result_found := true
        result_bottom := high[2]  // Top of C1
        result_top := low         // Bottom of C3
        result_bullish := true
    else if is_bearish_true_gap()
        result_found := true
        result_bottom := high     // Top of C3
        result_top := low[2]      // Bottom of C1
        result_bullish := false

    [result_found, result_bottom, result_top, result_bullish]

// RDRB Detection (3-candle): returns [found, bottom, top, is_bullish]
detect_rdrb_gap() =>
    pattern_found = false
    zone_bottom = float(na)
    zone_top = float(na)
    is_rdrb_bullish = bool(na)

    min_tick = syminfo.mintick

    // Predeclare locals
    c2_body_top = float(na)
    c2_body_bottom = float(na)
    c2_within_c1_wick = false
    c3_body_top = float(na)
    c3_body_bottom = float(na)
    remaining_zone_bottom = float(na)
    remaining_zone_top = float(na)
    intersection_bottom = float(na)
    intersection_top = float(na)
    anchored_top = false
    anchored_bottom = false
    valid_remaining = true

    // Bullish RDRB
    c1_body_top = math.max(open[2], close[2])
    c1_upper_wick_exists = high[2] > c1_body_top
    c2_body_top := math.max(open[1], close[1])
    c2_body_bottom := math.min(open[1], close[1])
    c2_within_c1_wick := (c2_body_bottom >= c1_body_top) and (c2_body_top <= high[2])
    c3_takes_c2_high = high > high[1]

    if c1_upper_wick_exists and c2_within_c1_wick and c3_takes_c2_high and not pattern_found
        c3_body_top := math.max(open, close)
        c3_body_bottom := math.min(open, close)

        remaining_zone_bottom := math.max(c2_body_bottom, c1_body_top)
        remaining_zone_top := math.min(c2_body_top, high[2])

        intersection_bottom := math.max(remaining_zone_bottom, c3_body_bottom)
        intersection_top := math.min(remaining_zone_top, c3_body_top)
        has_overlap = intersection_bottom < intersection_top

        anchored_top := has_overlap and intersection_top >= remaining_zone_top - min_tick
        anchored_bottom := has_overlap and intersection_bottom <= remaining_zone_bottom + min_tick

        valid_remaining := true
        if has_overlap
            if anchored_top and not anchored_bottom
                remaining_zone_top := intersection_bottom
            else if anchored_bottom and not anchored_top
                remaining_zone_bottom := intersection_top
            else
                valid_remaining := false

        if valid_remaining and remaining_zone_top > remaining_zone_bottom + min_tick
            pattern_found := true
            zone_bottom := remaining_zone_bottom
            zone_top := remaining_zone_top
            is_rdrb_bullish := true

    // Bearish RDRB
    if not pattern_found
        c1_body_bottom = math.min(open[2], close[2])
        c1_lower_wick_exists = low[2] < c1_body_bottom
        c2_body_top := math.max(open[1], close[1])
        c2_body_bottom := math.min(open[1], close[1])
        c2_within_c1_wick := (c2_body_top <= c1_body_bottom) and (c2_body_bottom >= low[2])
        c3_takes_c2_low = low < low[1]

        if c1_lower_wick_exists and c2_within_c1_wick and c3_takes_c2_low
            c3_body_top := math.max(open, close)
            c3_body_bottom := math.min(open, close)

            remaining_zone_bottom := math.max(c2_body_bottom, low[2])
            remaining_zone_top := math.min(c2_body_top, c1_body_bottom)

            intersection_bottom := math.max(remaining_zone_bottom, c3_body_bottom)
            intersection_top := math.min(remaining_zone_top, c3_body_top)
            has_overlap = intersection_bottom < intersection_top

            anchored_top := has_overlap and intersection_top >= remaining_zone_top - min_tick
            anchored_bottom := has_overlap and intersection_bottom <= remaining_zone_bottom + min_tick

            valid_remaining := true
            if has_overlap
                if anchored_top and not anchored_bottom
                    remaining_zone_top := intersection_bottom
                else if anchored_bottom and not anchored_top
                    remaining_zone_bottom := intersection_top
                else
                    valid_remaining := false

            if valid_remaining and remaining_zone_top > remaining_zone_bottom + min_tick
                pattern_found := true
                zone_bottom := remaining_zone_bottom
                zone_top := remaining_zone_top
                is_rdrb_bullish := false

    [pattern_found, zone_bottom, zone_top, is_rdrb_bullish]


// ═══════════════════════════════════════════════════════════════════════════════
// WICK DOMINANCE ANALYSIS
// ═══════════════════════════════════════════════════════════════════════════════

// Classify wick dominance into three tiers
classify_wick_dominance(mbz_body_size, mbz_upper_wick, mbz_lower_wick) =>
    if mbz_body_size <= 0
        [WICK_TIER_NONE, false]
    else
        mbz_upper_ratio = mbz_upper_wick / mbz_body_size
        mbz_lower_ratio = mbz_lower_wick / mbz_body_size
        max_wick_ratio = math.max(mbz_upper_ratio, mbz_lower_ratio)

        if max_wick_ratio >= WICK_DOMINANCE_STANDARD_THRESHOLD
            [WICK_TIER_STANDARD, true]  // ≥100%
        else if max_wick_ratio >= WICK_DOMINANCE_RELAXED_THRESHOLD
            [WICK_TIER_RELAXED, true]   // 85-99%
        else if max_wick_ratio >= WICK_DOMINANCE_RISKY_THRESHOLD
            [WICK_TIER_RISKY, true]     // 80-84%
        else
            [WICK_TIER_NONE, false]     // <80%

// ENHANCED: Advanced MBZ detection and classification with simple majority wick classification
// Uses clear majority rule: biggest wick wins, no tie-breaking complexity
detect_mbz_subtype(mbz_open, mbz_close, mbz_high, mbz_low, source_gap_type) =>
    if mbz_open == mbz_close
        [SUBTYPE_STANDARD, false]  // Doji handling
    else
        mbz_body_top = math.max(mbz_open, mbz_close)
        mbz_body_bottom = math.min(mbz_open, mbz_close)
        mbz_body_size = mbz_body_top - mbz_body_bottom
        mbz_upper_wick = mbz_high - mbz_body_top
        mbz_lower_wick = mbz_body_bottom - mbz_low
        is_candle_bullish = mbz_close > mbz_open

        // STEP 1: Determine base classification from source type
        base_classification = SUBTYPE_STANDARD
        if source_gap_type == GAP_TYPE_TRUE and enable_true_gaps
            base_classification := SUBTYPE_TRUE
        else if source_gap_type == GAP_TYPE_IMPLIED and enable_implied
            base_classification := SUBTYPE_IMPLIED
        else if source_gap_type == GAP_TYPE_VOLUME and enable_volume_imbalance
            base_classification := SUBTYPE_VOLUME
        else if source_gap_type == GAP_TYPE_RDRB and enable_rdrb
            base_classification := SUBTYPE_RDRB

        // STEP 2: Check wick dominance using three-tier system (≥80% minimum)
        [wick_tier, has_dominant] = classify_wick_dominance(mbz_body_size, mbz_upper_wick, mbz_lower_wick)

        if not has_dominant
            [base_classification, false]  // No wick dominance = base type only
        else
            // SIMPLE MAJORITY RULE: Biggest wick wins, exact ties favor inclusion patterns
            is_exact_tie = mbz_upper_wick == mbz_lower_wick
            upper_is_dominant = false  // Declare variable first

            if is_exact_tie
                // TIE-BREAKING LOGIC: When mbz_upper_wick == mbz_lower_wick (exact tie)
                // Design decision: All ties result in INCLUSION patterns for consistency
                // - Bullish ties: Force lower wick dominance → inclusion pattern → "inc-tie"
                // - Bearish ties: Force upper wick dominance → inclusion pattern → "inc-tie"
                // This ensures predictable, uniform behavior regardless of candle direction
                upper_is_dominant := not is_candle_bullish  // Bullish ties→lower dominant, Bearish ties→upper dominant
            else
                // CLEAR DOMINANCE: Standard comparison when wicks are different sizes
                upper_is_dominant := mbz_upper_wick > mbz_lower_wick

            // STEP 3: Determine wick pattern direction using simple majority
            // SIMPLE MAJORITY CLASSIFICATION: Clear, predictable wick-based subtyping
            // Note: Due to tie-breaking logic above, ties can ONLY result in inclusion patterns
            // - Bullish ties: upper_is_dominant=false → takes inclusion path → "inc-tie"
            // - Bearish ties: upper_is_dominant=true → takes inclusion path → "inc-tie"
            // Therefore, "reflection-tie" is impossible and was removed as dead code
            wick_pattern = ""
            pattern_enabled = false

            if is_candle_bullish
                if upper_is_dominant and enable_reflection
                    // Bullish + upper wick dominance = reflection (clear dominance only, never ties)
                    wick_pattern := SUBTYPE_REFLECTION
                    pattern_enabled := true
                else if not upper_is_dominant and enable_inclusion
                    // Bullish + lower wick dominance = inclusion (clear dominance OR ties)
                    wick_pattern := is_exact_tie ? SUBTYPE_INCLUSION_TIE : SUBTYPE_INCLUSION
                    pattern_enabled := true
            else
                if upper_is_dominant and enable_inclusion
                    // Bearish + upper wick dominance = inclusion (clear dominance OR ties)
                    wick_pattern := is_exact_tie ? SUBTYPE_INCLUSION_TIE : SUBTYPE_INCLUSION
                    pattern_enabled := true
                else if not upper_is_dominant and enable_reflection
                    // Bearish + lower wick dominance = reflection (clear dominance only, never ties)
                    wick_pattern := SUBTYPE_REFLECTION
                    pattern_enabled := true

            // STEP 4: Combine base classification with wick pattern
            if pattern_enabled
                final_subtype = ""
                if base_classification == SUBTYPE_TRUE
                    final_subtype := SUBTYPE_TRUE + "_" + wick_pattern
                else if base_classification == SUBTYPE_IMPLIED
                    final_subtype := SUBTYPE_IMPLIED + "_" + wick_pattern
                else if base_classification == SUBTYPE_VOLUME
                    final_subtype := SUBTYPE_VOLUME + "_" + wick_pattern
                else if base_classification == SUBTYPE_RDRB
                    final_subtype := SUBTYPE_RDRB + "_" + wick_pattern
                else
                    final_subtype := wick_pattern
                [final_subtype, true]
            else
                [base_classification, false]

// @function check_deeper_wick_penetration
// @description Check standard deeper wick (always) + optional reflection pattern deeper
// CORRECTED: Standard detection always runs, projection-based reflection detection optional
// - Standard: Normal gap penetration logic for all MBZ types
// - Reflection Pattern: Optional projection of reflection wick toward gap (toggle required)
// @param mbz_high float MBZ candle high price
// @param mbz_low float MBZ candle low price
// @param mbz_open float MBZ candle open price
// @param mbz_close float MBZ candle close price
// @param mbz_is_bullish bool MBZ direction
// @param mbz_subtype string MBZ subtype (for reflection detection)
// @param mitigating_high float Mitigating candle high
// @param mitigating_low float Mitigating candle low
// @param source_gap_id int ID of source gap
// @returns [bool, bool] [standard_deeper, reflection_pattern_deeper]
check_deeper_wick_penetration(mbz_high, mbz_low, mbz_open, mbz_close, mbz_is_bullish, mbz_subtype, mitigating_high, mitigating_low, source_gap_id) =>
    bool standard_deeper = false
    bool reflection_pattern_deeper = false

    if array.size(active_gaps) > 0
        for i = 0 to array.size(active_gaps) - 1
            gap = array.get(active_gaps, i)
            if gap.gap_id == source_gap_id
                // Standard deeper wick detection (ALWAYS RUNS for all MBZ types)
                if gap.is_bullish
                    // Bullish gap: deeper = lower values (going down into gap)
                    // BOTH candles must enter gap, MBZ must be equal or deeper
                    if mbz_low <= gap.top and mitigating_low <= gap.top
                        standard_deeper := mbz_low <= mitigating_low
                else
                    // Bearish gap: deeper = higher values (going up into gap)
                    // BOTH candles must enter gap, MBZ must be equal or deeper
                    if mbz_high >= gap.bottom and mitigating_high >= gap.bottom
                        standard_deeper := mbz_high >= mitigating_high

                // Optional reflection pattern detection (only if enabled AND reflection)
                if enable_reflection_pattern_deeper and str.contains(mbz_subtype, SUBTYPE_REFLECTION)
                    mbz_body_top = math.max(mbz_open, mbz_close)
                    mbz_body_bottom = math.min(mbz_open, mbz_close)

                    if mbz_is_bullish
                        // Bullish reflection: upper wick projects downward
                        upper_wick_size = mbz_high - mbz_body_top
                        projected_zone_bottom = mbz_body_bottom - upper_wick_size
                        reflection_pattern_deeper := projected_zone_bottom <= mitigating_low
                    else
                        // Bearish reflection: lower wick projects upward
                        lower_wick_size = mbz_body_bottom - mbz_low
                        projected_zone_top = mbz_body_top + lower_wick_size
                        reflection_pattern_deeper := projected_zone_top >= mitigating_high

                break

    [standard_deeper, reflection_pattern_deeper]

// ═══════════════════════════════════════════════════════════════════════════════
// MBZ ZONE CALCULATION - FIXED REFLECTION BUG
// ═══════════════════════════════════════════════════════════════════════════════

// Calculate zone boundaries for MBZ subtypes with corrected reflection logic
get_mbz_subtype_zone(mbz_record) =>
    if str.contains(mbz_record.mbz_subtype, SUBTYPE_INCLUSION)
        if mbz_record.is_bullish
            // Bullish inclusion: close down to low (body + lower wick zone)
            [mbz_record.mbz_close, mbz_record.low_price]
        else
            // Bearish inclusion: high down to close (body + upper wick zone)
            [mbz_record.high_price, mbz_record.mbz_close]
    else if str.contains(mbz_record.mbz_subtype, SUBTYPE_REFLECTION)
        if mbz_record.is_bullish
            // Bullish reflection uses OPEN as reference (not close)
            wick_range = math.abs(mbz_record.high_price - mbz_record.mbz_open)
            [mbz_record.mbz_close, mbz_record.mbz_close - wick_range]
        else
            // Bearish reflection uses OPEN as reference (not close)
            wick_range = math.abs(mbz_record.low_price - mbz_record.mbz_open)
            [mbz_record.mbz_close + wick_range, mbz_record.mbz_close]
    else
        // Standard MBZ uses BODY zone [open, close], NOT [high, low]!
        body_top = math.max(mbz_record.mbz_open, mbz_record.mbz_close)
        body_bottom = math.min(mbz_record.mbz_open, mbz_record.mbz_close)
        [body_top, body_bottom]

get_mbz_invalidation_boundaries(mbz_record) =>
    is_inclusion = str.contains(mbz_record.mbz_subtype, SUBTYPE_INCLUSION)
    is_reflection = str.contains(mbz_record.mbz_subtype, SUBTYPE_REFLECTION)
    is_standard = not is_inclusion and not is_reflection

    if is_standard and invalidation_boundary == INVALIDATION_BOUNDARY_EXTREMES
        [mbz_record.high_price, mbz_record.low_price]
    else
        get_mbz_subtype_zone(mbz_record)

get_invalidation_level_price(mbz_record) =>
    if not enable_invalidation_lines
        na
    else
        invalidation_threshold = get_mbz_invalidation_threshold()
        [boundary_top, boundary_bottom] = get_mbz_invalidation_boundaries(mbz_record)
        boundary_height = boundary_top - boundary_bottom
        invalidation_distance = boundary_height * (invalidation_threshold / 100.0)

        if mbz_record.is_bullish
            boundary_top - invalidation_distance
        else
            boundary_bottom + invalidation_distance

// ═══════════════════════════════════════════════════════════════════════════════
// SUPER MBZ DETECTION SYSTEM - REFLECTION ZONE OVERLAP FIXED
// ═══════════════════════════════════════════════════════════════════════════════

// @function detect_mbz_strength
// @description Detects if new MBZ overlaps with existing same-direction MBZs using proper zone-to-zone comparison
// @param new_mbz_record MBZRecord The new MBZ to check for nested/super status
// @returns tuple [bool, float, int] [is_super, overlap_percentage, overlapping_bar_index]
// @note Uses zone-based overlap detection for all MBZ types including reflection zones
detect_mbz_strength(new_mbz_record) =>
    if not enable_super_mbzs or array.size(all_mbz_records) == 0
        [false, 0.0, int(na)]
    else
        is_super = false
        stored_percentage = 0.0
        overlapped_bar = int(na)

        // OPTIMIZED: Limit scanning to recent records only (massive performance gain)
        if array.size(all_mbz_records) > 0
            scan_limit = math.min(SUPER_MBZ_SCAN_LIMIT, array.size(all_mbz_records))
            start_index = math.max(0, array.size(all_mbz_records) - scan_limit)

            for record_index = start_index to array.size(all_mbz_records) - 1
                existing_mbz = array.get(all_mbz_records, record_index)
                if not existing_mbz.is_invalidated and
                   existing_mbz.bar_index < new_mbz_record.bar_index and
                   existing_mbz.is_bullish == new_mbz_record.is_bullish  // SAME DIRECTION ONLY

                    // Use zone-to-zone for reflection MBZs, preserve candle-to-zone for standard MBZs
                    // This ensures reflection zones are detected while maintaining backward compatibility
                    has_overlap = false

                    // Check if either MBZ has reflection subtype - use zone-to-zone comparison
                    if str.contains(existing_mbz.mbz_subtype, SUBTYPE_REFLECTION) or str.contains(new_mbz_record.mbz_subtype, SUBTYPE_REFLECTION)
                        // Zone-to-zone comparison for reflection MBZs (needed for zones extending beyond candles)
                        [existing_zone_top, existing_zone_bottom] = get_mbz_subtype_zone(existing_mbz)
                        [new_zone_top, new_zone_bottom] = get_mbz_subtype_zone(new_mbz_record)
                        has_overlap := new_zone_bottom < existing_zone_top and new_zone_top > existing_zone_bottom
                    else
                        // Original candle-to-zone comparison for standard MBZs (preserves existing behavior)
                        if new_mbz_record.low_price < existing_mbz.high_price and new_mbz_record.high_price > existing_mbz.low_price
                            [zone_top, zone_bottom] = get_mbz_subtype_zone(existing_mbz)
                            has_overlap := new_mbz_record.low_price < zone_top and new_mbz_record.high_price > zone_bottom

                    if has_overlap
                        // Calculate overlap percentage based on detection method used
                        overlap_top = 0.0
                        overlap_bottom = 0.0
                        new_mbz_range = 0.0

                        if str.contains(existing_mbz.mbz_subtype, SUBTYPE_REFLECTION) or str.contains(new_mbz_record.mbz_subtype, SUBTYPE_REFLECTION)
                            // Zone-based calculation for reflection MBZs
                            [existing_zone_top, existing_zone_bottom] = get_mbz_subtype_zone(existing_mbz)
                            [new_zone_top, new_zone_bottom] = get_mbz_subtype_zone(new_mbz_record)
                            overlap_top := math.min(new_zone_top, existing_zone_top)
                            overlap_bottom := math.max(new_zone_bottom, existing_zone_bottom)
                            new_mbz_range := new_zone_top - new_zone_bottom
                        else
                            // Original candle-based calculation for standard MBZs
                            [zone_top, zone_bottom] = get_mbz_subtype_zone(existing_mbz)
                            overlap_top := math.min(new_mbz_record.high_price, zone_top)
                            overlap_bottom := math.max(new_mbz_record.low_price, zone_bottom)
                            new_mbz_range := new_mbz_record.high_price - new_mbz_record.low_price

                        overlap_range = overlap_top - overlap_bottom

                        if new_mbz_range > 0
                            overlap_pct = (overlap_range / new_mbz_range) * 100

                            // Store the data - ANY zone overlap makes it SUPER (shows checkmark ✔️)
                            stored_percentage := overlap_pct
                            overlapped_bar := existing_mbz.bar_index
                            is_super := true
                            break  // Take first overlap found

        [is_super, stored_percentage, overlapped_bar]

// ═══════════════════════════════════════════════════════════════════════════════
// BREACH CONFIRMATION SYSTEM FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// No confirmation system - return record unchanged
check_mbz_confirmation(mbz_record) =>
    mbz_record

// ═══════════════════════════════════════════════════════════════════════════════
// BREACH AND INVALIDATION DETECTION SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

// Calculate zone penetration percentage using extreme prices (low/high)
calculate_mbz_zone_penetration_from_extreme(test_price, zone_top, zone_bottom, is_bullish_zone) =>
    zone_range = zone_top - zone_bottom
    if zone_range <= 0
        0.0
    else
        if is_bullish_zone
            // Bullish MBZ: penetration comes from above downward → use low
            if test_price >= zone_top
                0.0  // No penetration
            else if test_price <= zone_bottom
                100.0  // Full penetration
            else
                penetration_distance = zone_top - test_price
                (penetration_distance / zone_range) * 100.0
        else
            // Bearish MBZ: penetration comes from below upward → use high
            if test_price <= zone_bottom
                0.0  // No penetration
            else if test_price >= zone_top
                100.0  // Full penetration
            else
                penetration_distance = test_price - zone_bottom
                (penetration_distance / zone_range) * 100.0

// Calculate zone penetration percentage using candle body (open/close prices)
calculate_mbz_zone_penetration_from_body(open_price, close_price, zone_top, zone_bottom, is_bullish_zone) =>
    zone_range = zone_top - zone_bottom
    if zone_range <= 0
        0.0
    else
        if is_bullish_zone
            // Bullish zone: use LOWER of open/close for deepest penetration from above
            test_price = math.min(open_price, close_price)
            if test_price >= zone_top
                0.0  // No penetration
            else if test_price <= zone_bottom
                100.0  // Full penetration
            else
                penetration_distance = zone_top - test_price
                (penetration_distance / zone_range) * 100.0
        else
            // Bearish zone: use HIGHER of open/close for deepest penetration from below
            test_price = math.max(open_price, close_price)
            if test_price <= zone_bottom
                0.0  // No penetration
            else if test_price >= zone_top
                100.0  // Full penetration
            else
                penetration_distance = test_price - zone_bottom
                (penetration_distance / zone_range) * 100.0

// Calculate zone penetration percentage using close price (for invalidation)
calculate_mbz_zone_penetration_from_close(close_price, zone_top, zone_bottom, is_bullish_zone) =>
    zone_range = zone_top - zone_bottom
    if zone_range <= 0
        0.0
    else
        if is_bullish_zone
            // Bullish zone: penetration is from top downward
            if close_price >= zone_top
                0.0  // No penetration
            else if close_price <= zone_bottom
                100.0  // Full penetration
            else
                penetration_distance = zone_top - close_price
                (penetration_distance / zone_range) * 100.0
        else
            // Bearish zone: penetration is from bottom upward
            if close_price <= zone_bottom
                0.0  // No penetration
            else if close_price >= zone_top
                100.0  // Full penetration
            else
                penetration_distance = close_price - zone_bottom
                (penetration_distance / zone_range) * 100.0

// Calculate current breach percentage for tooltip display
get_current_breach_percentage(mbz_record) =>
    if mbz_record.is_invalidated or barstate.isconfirmed or bar_index == mbz_record.bar_index
        0.0
    else
        // Get the SAME zone that visuals use (corrected zones)
        [zone_top, zone_bottom] = get_mbz_subtype_zone(mbz_record)

        // Calculate penetration based on selected breach method
        current_penetration = breach_method == BREACH_METHOD_BODY_BREACH ? calculate_mbz_zone_penetration_from_body(open, close, zone_top, zone_bottom, mbz_record.is_bullish) : calculate_mbz_zone_penetration_from_extreme(mbz_record.is_bullish ? low : high, zone_top, zone_bottom, mbz_record.is_bullish)

        current_penetration

// Calculate current breach percentage for consolidated MBZ
get_consolidated_breach_percentage(consolidated_mbz) =>
    if consolidated_mbz.is_consolidated_invalidated or array.size(consolidated_mbz.mbz_group) == 0
        0.0
    else
        // Use the first MBZ for zone calculation (all should have same zone)
        first_mbz = array.get(consolidated_mbz.mbz_group, 0)
        [zone_top, zone_bottom] = get_mbz_subtype_zone(first_mbz)

        // Calculate penetration based on selected breach method
        current_penetration = breach_method == BREACH_METHOD_BODY_BREACH ? calculate_mbz_zone_penetration_from_body(open, close, zone_top, zone_bottom, consolidated_mbz.is_bullish) : calculate_mbz_zone_penetration_from_extreme(consolidated_mbz.is_bullish ? low : high, zone_top, zone_bottom, consolidated_mbz.is_bullish)

        current_penetration

// Real-time breach detection using subtype zones and selected method
is_mbz_currently_breached(mbz_record) =>
    // CRITICAL: Never show breach if disabled or in these cases:
    if not enable_breach_detection or mbz_record.is_invalidated or bar_index == mbz_record.bar_index
        false
    else
        validated_breach_threshold = get_validated_breach_threshold()
        // Get the SAME zone that visuals use (corrected zones)
        [zone_top, zone_bottom] = get_mbz_subtype_zone(mbz_record)

        // Calculate penetration based on selected breach method
        current_penetration = breach_method == BREACH_METHOD_BODY_BREACH ? calculate_mbz_zone_penetration_from_body(open, close, zone_top, zone_bottom, mbz_record.is_bullish) : calculate_mbz_zone_penetration_from_extreme(mbz_record.is_bullish ? low : high, zone_top, zone_bottom, mbz_record.is_bullish)

        // Show breach if penetration meets or exceeds validated breach threshold
        current_penetration >= validated_breach_threshold

// Enhanced invalidation: Check BOTH open and close for gaps and penetration
should_mbz_be_invalidated_enhanced(mbz_record, current_open, current_close) =>
    invalidation_threshold = get_mbz_invalidation_threshold()

    // Get invalidation boundaries based on user setting (candle extremes or zone)
    [boundary_top, boundary_bottom] = get_mbz_invalidation_boundaries(mbz_record)

    // CRITICAL: Check for OPENING GAPS first (immediate invalidation)
    if mbz_record.is_bullish
        // Bullish MBZ: If candle opens BELOW boundary bottom = instant invalidation
        if current_open < boundary_bottom
            true  // GAPPED BELOW - IMMEDIATE INVALIDATION
        else
            // No gap - check close penetration normally
            penetration_percentage = calculate_mbz_zone_penetration_from_close(current_close, boundary_top, boundary_bottom, mbz_record.is_bullish)
            penetration_percentage >= invalidation_threshold
    else
        // Bearish MBZ: If candle opens ABOVE boundary top = instant invalidation
        if current_open > boundary_top
            true  // GAPPED ABOVE - IMMEDIATE INVALIDATION
        else
            // No gap - check close penetration normally
            penetration_percentage = calculate_mbz_zone_penetration_from_close(current_close, boundary_top, boundary_bottom, mbz_record.is_bullish)
            penetration_percentage >= invalidation_threshold

// Legacy function for backward compatibility (now calls enhanced version)
should_mbz_be_invalidated(mbz_record, confirmed_close_price) =>
    should_mbz_be_invalidated_enhanced(mbz_record, open, confirmed_close_price)

// ═══════════════════════════════════════════════════════════════════════════════
// LABEL BUILDING FUNCTIONS - DEFINED BEFORE CACHING
// ═══════════════════════════════════════════════════════════════════════════════

// Build MBZ label text with bearish 5-4-3-2-1 reversal and new hierarchy
build_mbz_label_text(mbz_record, wick_tier) =>
    // Check for real-time breach status
    is_currently_breached = is_mbz_currently_breached(mbz_record)

    // Build main MBZ text with [½] inline
    mbz_base_text = MBZ_BASE_TEXT + (mbz_record.is_bullish ? MBZ_BULLISH_SUFFIX : MBZ_BEARISH_SUFFIX)
    // Add BREAKAWAY prefix if this MBZ is from a breakaway gap (when labeling enabled)
    if label_breakaway_fvgs and mbz_record.is_breakaway_mbz
        mbz_base_text := LABEL_PREFIX_BREAKAWAY + mbz_base_text
    mbz_text = show_50_percent_tags and mbz_record.is_exactly_50_percent ? mbz_base_text + FIFTY_PERCENT_TAG : mbz_base_text

    // Handle different display modes
    if mbz_symbol_type == DISPLAY_MODE_ARROW_ONLY
        mbz_record.is_bullish ? "▲" : "▼"
    else
        // Build label parts in correct hierarchy order
        label_parts = array.new<string>()

        // 1. Arrow (for Arrow + Text mode only)
        if mbz_symbol_type == DISPLAY_MODE_ARROW_TEXT
            arrow = mbz_record.is_bullish ? "▲" : "▼"
            array.push(label_parts, arrow)

        // 2. MBZ label with [½] (most important)
        array.push(label_parts, mbz_text)

        // 3. Source type (contiguous - 2nd most important, only if advanced and not standard)
        if show_enhanced_label_details
            gap_type = if str.contains(mbz_record.mbz_subtype, SUBTYPE_IMPLIED)
                GAP_TYPE_IMPLIED
            else if str.contains(mbz_record.mbz_subtype, SUBTYPE_VOLUME)
                GAP_TYPE_VOLUME
            else
                GAP_TYPE_FVG

            gap_source = get_gap_source_display(gap_type)

            if gap_source != ""
                array.push(label_parts, "(" + gap_source + ")")

        // 4. Subtype with risk indicator (3rd importance)
        if show_enhanced_label_details
            subtype_display = get_subtype_display(mbz_record.mbz_subtype, mbz_record.is_bullish)
            if subtype_display != ""
                // Add risk indicator to subtype (positioned after behavior)
                subtype_is_risky = wick_tier == WICK_TIER_RISKY
                risky_subtype = get_risky_subtype_display(mbz_record.mbz_subtype, mbz_record.is_bullish, subtype_is_risky)
                array.push(label_parts, risky_subtype)

        // 5. Status - BREACH or X, always at end (BREACH replaces X during breach)
        if is_currently_breached and not mbz_record.is_invalidated
            array.push(label_parts, BREACH_STATUS_LABEL)
        else if mbz_record.is_invalidated
            array.push(label_parts, "[X]")

        // MBZ⁻ Order - reverse the parts for MBZ⁻
        if not mbz_record.is_bullish and array.size(label_parts) > 0
            // Reverse the array for bearish stacking
            reversed_parts = array.new<string>()
            for i = array.size(label_parts) - 1 to 0 by 1
                array.push(reversed_parts, array.get(label_parts, i))
            label_parts := reversed_parts

        // Join with newlines for vertical stacking
        result = ""
        for i = 0 to array.size(label_parts) - 1
            if i > 0
                result := result + "\n"
            result := result + array.get(label_parts, i)

        result

// Build comprehensive MBZ tooltip with Volume Imbalance support and directional arrows
build_mbz_tooltip(mbz_record, wick_tier) =>
    // Build behavior-first tooltip with risk warnings
    risky_prefix = wick_tier == WICK_TIER_RISKY ? "*" : ""

    behavior_text = ""
    if str.contains(mbz_record.mbz_subtype, SUBTYPE_INCLUSION)
        behavior_text := risky_prefix + "Inclusion "
    else if str.contains(mbz_record.mbz_subtype, SUBTYPE_REFLECTION)
        behavior_text := risky_prefix + "Reflection "

    direction = mbz_record.is_bullish ? MBZ_PLUS : MBZ_MINUS
    base_text = behavior_text + direction

    // Build subtype text using new display functions
    subtype_parts = array.new<string>()
    if str.contains(mbz_record.mbz_subtype, SUBTYPE_IMPLIED)
        array.push(subtype_parts, GAP_SOURCE_IMPLIED_FULL)
    else if str.contains(mbz_record.mbz_subtype, SUBTYPE_VOLUME)
        array.push(subtype_parts, GAP_SOURCE_VOLUME_FULL)

    subtype_text = ""
    if array.size(subtype_parts) > 0
        combined_subtype = ""
        for i = 0 to array.size(subtype_parts) - 1
            if i > 0
                combined_subtype := combined_subtype + "/"
            combined_subtype := combined_subtype + array.get(subtype_parts, i)
        subtype_text := " (" + combined_subtype + ")"

    // Add SUPER MBZ information
    strength_info = ""
    if mbz_record.is_super_mbz
        bars_ago = bar_index - mbz_record.overlapping_mbz_bar_index
        direction_text = mbz_record.is_bullish ? MBZ_PLUS : MBZ_MINUS
        strength_info := "\n" + str.tostring(mbz_record.overlap_percentage, "#.1") + "% overlap with " + direction_text + " from " + str.tostring(bars_ago) + " bars ago"

    // Add breach status with percentage
    is_currently_breached = is_mbz_currently_breached(mbz_record)
    breach_text = ""
    if is_currently_breached and not mbz_record.is_invalidated
        current_breach_pct = get_current_breach_percentage(mbz_record)
        breach_text := BREACH_STATUS_TEXT + str.tostring(current_breach_pct, "#.1") + BREACH_STATUS_SUFFIX
    else if not mbz_record.is_invalidated and not barstate.isconfirmed
        // Show re-entry percentage when price is back inside zone
        current_breach_pct = get_current_breach_percentage(mbz_record)
        if current_breach_pct > 0
            breach_text := " - " + str.tostring(current_breach_pct, "#.1") + "% filled"

    // Add deeper wick descriptor (gap-side or pattern-side)
    aggressive_text = ""
    if mbz_record.wicked_into_source_gap or mbz_record.reflection_pattern_deeper
        aggressive_text := "\n" + SOURCE_GAP_DEEPER_WICK_DESCRIPTION_TEXT

    half_text = mbz_record.is_exactly_50_percent ? " [exactly 50%]" : ""
    fill_text = mbz_record.max_fill_percentage > 0 ? " (" + str.tostring(mbz_record.max_fill_percentage, "#.#") + "% filled)" : ""
    invalid_text = mbz_record.is_invalidated ? " - INVALIDATED" : ""

    base_text + subtype_text + aggressive_text + half_text + fill_text + strength_info + breach_text + invalid_text

// ═══════════════════════════════════════════════════════════════════════════════
// CACHING FUNCTIONS - NOW DEFINED AFTER LABEL BUILDING
// ═══════════════════════════════════════════════════════════════════════════════

// Performance optimization: Cache frequently computed MBZ data using corrected zone logic
cache_mbz_data(mbz_record) =>
    // Calculate zone coordinates using the SAME get_mbz_subtype_zone() function that breach/invalidation use
    [cached_zone_top, cached_zone_bottom] = get_mbz_subtype_zone(mbz_record)

    // Determine wick tier for risky prefix
    mbz_body_top = math.max(mbz_record.mbz_open, mbz_record.mbz_close)
    mbz_body_bottom = math.min(mbz_record.mbz_open, mbz_record.mbz_close)
    mbz_body_size = mbz_body_top - mbz_body_bottom
    mbz_upper_wick = mbz_record.high_price - mbz_body_top
    mbz_lower_wick = mbz_body_bottom - mbz_record.low_price
    [wick_tier, has_wick_dominance] = classify_wick_dominance(mbz_body_size, mbz_upper_wick, mbz_lower_wick)

    cached_label_text = ""
    cached_tooltip = build_mbz_tooltip(mbz_record, wick_tier)
    MBZRecord.new(
         mbz_record.bar_index,
         mbz_record.formation_time,
         mbz_record.high_price,
         mbz_record.low_price,
         mbz_record.mbz_open,
         mbz_record.mbz_close,
         mbz_record.is_bullish,
         mbz_record.is_invalidated,
         mbz_record.max_fill_percentage,
         mbz_record.has_dominant_wick,
         mbz_record.is_exactly_50_percent,
         mbz_record.mbz_subtype,
         cached_label_text,
         cached_tooltip,
         cached_zone_top,
         cached_zone_bottom,
         true,
         mbz_record.mbz_label,
         mbz_record.source_gap_id,
         mbz_record.source_gap_bar_index,
         mbz_record.source_gap_top,
         mbz_record.source_gap_bottom,
         mbz_record.source_gap_type,
         mbz_record.wicked_into_source_gap,
         mbz_record.reflection_pattern_deeper,
         mbz_record.is_super_mbz,
         mbz_record.overlap_percentage,
         mbz_record.overlapping_mbz_bar_index,
         mbz_record.is_breakaway_mbz
     )

get_cached_mbz_subtype_zone(mbz_record) =>
    if not mbz_record.cached_data_valid
        cached_record = cache_mbz_data(mbz_record)
        [cached_record.cached_zone_top, cached_record.cached_zone_bottom]
    else
        [mbz_record.cached_zone_top, mbz_record.cached_zone_bottom]

// ═══════════════════════════════════════════════════════════════════════════════
// CONSOLIDATION SYSTEM - PORTED FROM SIF CODE // ═══════════════════════════════════════════════════════════════════════════════

group_mbzs_by_candle(mbz_records) =>
    grouped_mbzs = array.new<ConsolidatedMBZ>()

    if array.size(mbz_records) == 0
        grouped_mbzs
    else
        mbz_by_bar = map.new<int, MBZGroupWrapper>()

        for i = 0 to array.size(mbz_records) - 1
            mbz_record = array.get(mbz_records, i)
            bar_key = mbz_record.bar_index

            if not map.contains(mbz_by_bar, bar_key)
                wrapper = MBZGroupWrapper.new(array.new<MBZRecord>())
                map.put(mbz_by_bar, bar_key, wrapper)

            wrapper = map.get(mbz_by_bar, bar_key)
            array.push(wrapper.mbz_group, mbz_record)

        bar_keys = map.keys(mbz_by_bar)
        sorted_keys = array.copy(bar_keys)
        array.sort(sorted_keys, order.ascending)

        for i = 0 to array.size(sorted_keys) - 1
            bar_key = array.get(sorted_keys, i)
            wrapper = map.get(mbz_by_bar, bar_key)
            candle_mbzs = wrapper.mbz_group

            if array.size(candle_mbzs) > 0
                first_mbz = array.get(candle_mbzs, 0)
                consolidated = ConsolidatedMBZ.new(
                     candle_mbzs,
                     bar_key,
                     first_mbz.formation_time,
                     first_mbz.is_bullish,
                     0.0, 0.0, false, false, "", ""
                 )
                array.push(grouped_mbzs, consolidated)

        grouped_mbzs

// Calculate consolidated zone boundaries (outermost limits) - adapted from SIF
calculate_consolidated_zone_boundaries(mbz_group) =>
    if array.size(mbz_group) == 0
        [float(na), float(na)]
    else
        zone_top = -999999.0
        zone_bottom = 999999.0

        for i = 0 to array.size(mbz_group) - 1
            mbz_record = array.get(mbz_group, i)
            [individual_top, individual_bottom] = get_mbz_subtype_zone(mbz_record)

            if individual_top > zone_top
                zone_top := individual_top
            if individual_bottom < zone_bottom
                zone_bottom := individual_bottom

        [zone_top, zone_bottom]

// Determine consolidated status for group - adapted from SIF
determine_consolidated_status(consolidated_mbz) =>
    invalidation_threshold = get_mbz_invalidation_threshold()
    is_breached = consolidated_mbz.is_consolidated_breached  // Start with existing breach state
    is_invalidated = consolidated_mbz.is_consolidated_invalidated  // Start with existing invalidation state

    // First check if any MBZ in group is already invalidated
    for i = 0 to array.size(consolidated_mbz.mbz_group) - 1
        mbz = array.get(consolidated_mbz.mbz_group, i)
        if mbz.is_invalidated
            is_invalidated := true
            break

    // Only check for breach if NOT already breached AND NOT already invalidated
    if not is_breached and not is_invalidated and enable_breach_detection
        // Check breach using breach threshold (both real-time and historical) - exclude formation candle
        if bar_index != consolidated_mbz.bar_index
            validated_breach_threshold = get_validated_breach_threshold()

            // For current bar, check real-time price using selected breach method
            current_penetration = breach_method == BREACH_METHOD_BODY_BREACH ? calculate_mbz_zone_penetration_from_body(open, close, consolidated_mbz.consolidated_zone_top, consolidated_mbz.consolidated_zone_bottom, consolidated_mbz.is_bullish) : calculate_mbz_zone_penetration_from_extreme(consolidated_mbz.is_bullish ? low : high, consolidated_mbz.consolidated_zone_top, consolidated_mbz.consolidated_zone_bottom, consolidated_mbz.is_bullish)

            // Check if current bar breached
            if current_penetration >= validated_breach_threshold
                is_breached := true
            else
                // For old MBZs, check historical breach by looking back from formation
                bars_since_formation = bar_index - consolidated_mbz.bar_index
                if bars_since_formation > 1  // Only check history for old MBZs
                    historical_breach_found = false
                    // Look back through bars since formation (but not beyond formation)
                    max_lookback = math.min(bars_since_formation - 1, HISTORICAL_LOOKBACK_LIMIT)  // Limit to bars since formation or 500, whichever is smaller
                    for i = 1 to max_lookback
                        historical_penetration = breach_method == BREACH_METHOD_BODY_BREACH ? calculate_mbz_zone_penetration_from_body(open[i], close[i], consolidated_mbz.consolidated_zone_top, consolidated_mbz.consolidated_zone_bottom, consolidated_mbz.is_bullish) : calculate_mbz_zone_penetration_from_extreme(consolidated_mbz.is_bullish ? low[i] : high[i], consolidated_mbz.consolidated_zone_top, consolidated_mbz.consolidated_zone_bottom, consolidated_mbz.is_bullish)
                        if historical_penetration >= validated_breach_threshold
                            historical_breach_found := true
                            break
                    is_breached := historical_breach_found

        // Check invalidation (confirmed close) - both current and historical
        if not is_invalidated and barstate.isconfirmed
            // Check current bar first
            current_penetration = calculate_mbz_zone_penetration_from_close(
                 close,
                 consolidated_mbz.consolidated_zone_top,
                 consolidated_mbz.consolidated_zone_bottom,
                 consolidated_mbz.is_bullish
             )
            if current_penetration >= invalidation_threshold
                is_invalidated := true
            else
                // For old MBZs, check historical invalidation by looking back from formation
                bars_since_formation = bar_index - consolidated_mbz.bar_index
                if bars_since_formation > 1  // Only check history for old MBZs
                    historical_invalidation_found = false
                    // Look back through bars since formation (but not beyond formation)
                    max_lookback = math.min(bars_since_formation - 1, HISTORICAL_LOOKBACK_LIMIT)  // Limit to bars since formation or 500, whichever is smaller
                    for i = 1 to max_lookback
                        historical_close_price = close[i]
                        historical_penetration = calculate_mbz_zone_penetration_from_close(
                             historical_close_price,
                             consolidated_mbz.consolidated_zone_top,
                             consolidated_mbz.consolidated_zone_bottom,
                             consolidated_mbz.is_bullish
                         )
                        if historical_penetration >= invalidation_threshold
                            historical_invalidation_found := true
                            break
                    is_invalidated := historical_invalidation_found

    [is_breached, is_invalidated]

// Build source type statistics for consolidated MBZ groups
get_source_type_stats(mbz_group) =>
    stats = SourceTypeStats.new(0, 0, 0, 0, 0, 0, 0)
    stats.group_size := array.size(mbz_group)

    for i = 0 to stats.group_size - 1
        mbz_record = array.get(mbz_group, i)

        if str.contains(mbz_record.mbz_subtype, SUBTYPE_IMPLIED)
            if enable_implied
                stats.imp_count += 1
        else if str.contains(mbz_record.mbz_subtype, SUBTYPE_VOLUME)
            if enable_volume_imbalance
                stats.vol_count += 1
        else if str.contains(mbz_record.mbz_subtype, SUBTYPE_TRUE)
            if enable_true_gaps
                stats.true_count += 1
        else if str.contains(mbz_record.mbz_subtype, SUBTYPE_RDRB)
            if enable_rdrb
                stats.rdrb_count += 1
        else if enable_fair_value_gaps
            stats.fvg_count += 1

    stats.distinct_types := (stats.fvg_count > 0 ? 1 : 0) + (stats.imp_count > 0 ? 1 : 0) + (stats.vol_count > 0 ? 1 : 0) + (stats.true_count > 0 ? 1 : 0) + (stats.rdrb_count > 0 ? 1 : 0)
    stats

// Count source types for consolidated display (compatibility helper)
count_source_types(mbz_group) =>
    stats = get_source_type_stats(mbz_group)
    [stats.fvg_count, stats.imp_count, stats.vol_count, stats.true_count, stats.rdrb_count]

// Determine if consolidated group meets STRONG criteria
is_multi_source_strong(stats) =>
    meets_threshold = stats.group_size >= multi_source_strong_min_sources
    qualifies_distinct = multi_source_strong_include_distinct and stats.distinct_types > 1
    qualifies_same = multi_source_strong_include_same and stats.distinct_types == 1 and stats.group_size >= multi_source_strong_min_sources
    meets_threshold and (qualifies_distinct or qualifies_same)

should_show_strong_on_labels() =>
    multi_source_strong_display_mode == MULTI_SOURCE_STRONG_DISPLAY_LABEL or multi_source_strong_display_mode == MULTI_SOURCE_STRONG_DISPLAY_BOTH

should_show_strong_on_extensions() =>
    multi_source_strong_display_mode == MULTI_SOURCE_STRONG_DISPLAY_EXTENSION or multi_source_strong_display_mode == MULTI_SOURCE_STRONG_DISPLAY_BOTH

// Check if any MBZ in group is SUPER
has_super_mbzs(mbz_group) =>
    has_super = false

    for i = 0 to array.size(mbz_group) - 1
        mbz_record = array.get(mbz_group, i)
        if mbz_record.is_super_mbz
            has_super := true
            break

    has_super

// Build source breakdown with counts - USED for candle label logic
build_source_breakdown(mbz_group) =>
    [fvg_count, imp_count, vol_count, true_count, rdrb_count] = count_source_types(mbz_group)

    parts = array.new<string>()

    // SPECIAL FVG LOGIC: FVGs are invisible when alone, visible when mixed with others
    // This creates clean labels like "MBZ⁺" instead of "MBZ⁺ (fvg)" for single FVG cases
    if fvg_count > 0
        types_present_count = (fvg_count > 0 ? 1 : 0) + (imp_count > 0 ? 1 : 0) + (vol_count > 0 ? 1 : 0) + (true_count > 0 ? 1 : 0) + (rdrb_count > 0 ? 1 : 0)
        if fvg_count == 1 and types_present_count == 1
            na
        else if fvg_count == 1
            array.push(parts, GAP_SOURCE_FVG_BREAKDOWN_DISPLAY)
        else
            array.push(parts, GAP_SOURCE_FVG_BREAKDOWN_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(fvg_count))

    if imp_count > 0
        if imp_count == 1
            array.push(parts, GAP_SOURCE_IMPLIED_DISPLAY)
        else
            array.push(parts, GAP_SOURCE_IMPLIED_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(imp_count))

    if vol_count > 0
        if vol_count == 1
            array.push(parts, GAP_SOURCE_VOLUME_DISPLAY)
        else
            array.push(parts, GAP_SOURCE_VOLUME_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(vol_count))

    if true_count > 0
        if true_count == 1
            array.push(parts, GAP_SOURCE_TRUE_DISPLAY)
        else
            array.push(parts, GAP_SOURCE_TRUE_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(true_count))
    if rdrb_count > 0
        if rdrb_count == 1
            array.push(parts, GAP_SOURCE_RDRB_DISPLAY)
        else
            array.push(parts, GAP_SOURCE_RDRB_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(rdrb_count))

    result = ""
    for i = 0 to array.size(parts) - 1
        if i > 0
            result := result + ", "
        result := result + array.get(parts, i)

    result

// Build source breakdown for extension labels using consolidated stats
build_source_breakdown_extension_from_stats(stats) =>
    if stats.group_size == 0
        ""
    else if stats.distinct_types == 1
        if stats.fvg_count > 0
            if stats.fvg_count == 1
                ""
            else
                GAP_SOURCE_FVG_BREAKDOWN_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(stats.fvg_count)
        else if stats.imp_count > 0
            if stats.imp_count == 1
                GAP_SOURCE_IMPLIED_DISPLAY
            else
                GAP_SOURCE_IMPLIED_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(stats.imp_count)
        else if stats.vol_count > 0
            if stats.vol_count == 1
                GAP_SOURCE_VOLUME_DISPLAY
            else
                GAP_SOURCE_VOLUME_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(stats.vol_count)
        else if stats.true_count > 0
            if stats.true_count == 1
                GAP_SOURCE_TRUE_DISPLAY
            else
                GAP_SOURCE_TRUE_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(stats.true_count)
        else if stats.rdrb_count > 0
            if stats.rdrb_count == 1
                GAP_SOURCE_RDRB_DISPLAY
            else
                GAP_SOURCE_RDRB_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(stats.rdrb_count)
        else
            ""
    else
        parts = array.new<string>()

        if stats.fvg_count > 0
            array.push(parts, stats.fvg_count == 1 ? GAP_SOURCE_FVG_BREAKDOWN_DISPLAY : GAP_SOURCE_FVG_BREAKDOWN_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(stats.fvg_count))

        if stats.imp_count > 0
            array.push(parts, stats.imp_count == 1 ? GAP_SOURCE_IMPLIED_DISPLAY : GAP_SOURCE_IMPLIED_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(stats.imp_count))

        if stats.vol_count > 0
            array.push(parts, stats.vol_count == 1 ? GAP_SOURCE_VOLUME_DISPLAY : GAP_SOURCE_VOLUME_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(stats.vol_count))

        if stats.true_count > 0
            array.push(parts, stats.true_count == 1 ? GAP_SOURCE_TRUE_DISPLAY : GAP_SOURCE_TRUE_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(stats.true_count))

        if stats.rdrb_count > 0
            array.push(parts, stats.rdrb_count == 1 ? GAP_SOURCE_RDRB_DISPLAY : GAP_SOURCE_RDRB_DISPLAY + MULTIPLIER_SYMBOL + str.tostring(stats.rdrb_count))

        breakdown = ""
        for i = 0 to array.size(parts) - 1
            if i > 0
                breakdown := breakdown + BREAKDOWN_SEPARATOR
            breakdown := breakdown + array.get(parts, i)

        str.tostring(stats.group_size) + COUNT_SEPARATOR + breakdown

// Build source breakdown with new Option 1 logic for extension labels
build_source_breakdown_extension(mbz_group) =>
    build_source_breakdown_extension_from_stats(get_source_type_stats(mbz_group))

// Mirror stacked label content for bearish ordering (parity with SIF)
mirror_label_stack_for_bearish(label_parts) =>
    mirrored = array.new<string>()
    for i = array.size(label_parts) - 1 to 0 by 1
        array.push(mirrored, array.get(label_parts, i))
    mirrored

// Get unified subtype for entire group - ONLY USED WHEN show_enhanced_label_details = true
get_unified_subtype(mbz_group) =>
    if array.size(mbz_group) == 0
        ["", false]
    else
        first_mbz = array.get(mbz_group, 0)
        subtype_display = get_subtype_display(first_mbz.mbz_subtype, first_mbz.is_bullish)

        // Get wick tier for risk indicator
        body_top = math.max(first_mbz.mbz_open, first_mbz.mbz_close)
        body_bottom = math.min(first_mbz.mbz_open, first_mbz.mbz_close)
        body_size = body_top - body_bottom
        upper_wick = first_mbz.high_price - body_top
        lower_wick = body_bottom - first_mbz.low_price
        [wick_tier, has_wick_dominance] = classify_wick_dominance(body_size, upper_wick, lower_wick)

        risky_prefix = wick_tier == WICK_TIER_RISKY ? "*" : ""
        is_risky = risky_prefix != ""

        final_subtype = ""
        if subtype_display != ""
            final_subtype := get_risky_subtype_display(first_mbz.mbz_subtype, first_mbz.is_bullish, is_risky)

        [final_subtype, is_risky]

// Create consolidated candle label with 5-4-3-2-1 reversal - SUPER MBZ support
create_consolidated_candle_label(consolidated_mbz) =>
    mbz_count = array.size(consolidated_mbz.mbz_group)
    source_stats = get_source_type_stats(consolidated_mbz.mbz_group)
    strong_flag_active = is_multi_source_strong(source_stats)
    show_strong_label = strong_flag_active and should_show_strong_on_labels()

    direction = MBZ_BASE_TEXT + (consolidated_mbz.is_bullish ? MBZ_BULLISH_SUFFIX : MBZ_BEARISH_SUFFIX)

    // Check if any MBZ in group is breakaway (for labeling)
    has_breakaway = false
    if label_breakaway_fvgs
        for i = 0 to mbz_count - 1
            mbz = array.get(consolidated_mbz.mbz_group, i)
            if mbz.is_breakaway_mbz
                has_breakaway := true
                break

    base_text = has_breakaway ? LABEL_PREFIX_BREAKAWAY + direction : direction

    if show_50_percent_tags
        has_50_percent = false
        for i = 0 to mbz_count - 1
            mbz = array.get(consolidated_mbz.mbz_group, i)
            if mbz.is_exactly_50_percent
                has_50_percent := true
                break
        if has_50_percent
            base_text := base_text + FIFTY_PERCENT_TAG

    if mbz_symbol_type == DISPLAY_MODE_ARROW_ONLY
        consolidated_mbz.is_bullish ? ARROW_UP_SYMBOL : ARROW_DOWN_SYMBOL
    else
        label_parts = array.new<string>()

        if mbz_symbol_type == DISPLAY_MODE_ARROW_TEXT
            array.push(label_parts, consolidated_mbz.is_bullish ? ARROW_UP_SYMBOL : ARROW_DOWN_SYMBOL)

        array.push(label_parts, base_text)

        if show_enhanced_label_details
            if mbz_count >= 3
                array.push(label_parts, "(" + str.tostring(mbz_count) + ")")
            else if mbz_count == 2
                fvg_count = source_stats.fvg_count
                imp_count = source_stats.imp_count
                vol_count = source_stats.vol_count
                true_count = source_stats.true_count
                rdrb_count = source_stats.rdrb_count
                types_present = source_stats.distinct_types

                if types_present == 1
                    if fvg_count == 2
                        array.push(label_parts, "(fvg×2)")
                    else if imp_count == 2
                        array.push(label_parts, "(imp×2)")
                    else if vol_count == 2
                        array.push(label_parts, "(vol×2)")
                    else if true_count == 2
                        array.push(label_parts, "(gap×2)")
                    else if rdrb_count == 2
                        array.push(label_parts, "(rdrb×2)")
                else
                    type_list = array.new<string>()
                    if fvg_count > 0
                        array.push(type_list, GAP_SOURCE_FVG_BREAKDOWN_DISPLAY)
                    if imp_count > 0
                        array.push(type_list, GAP_SOURCE_IMPLIED_DISPLAY)
                    if vol_count > 0
                        array.push(type_list, GAP_SOURCE_VOLUME_DISPLAY)
                    if true_count > 0
                        array.push(type_list, GAP_SOURCE_TRUE_DISPLAY)
                    if rdrb_count > 0
                        array.push(type_list, GAP_SOURCE_RDRB_DISPLAY)

                    type_string = ""
                    if array.size(type_list) >= 2
                        type_string := array.get(type_list, 0) + ", " + array.get(type_list, 1)
                    else if array.size(type_list) == 1
                        type_string := array.get(type_list, 0)
                    if str.length(type_string) > 0
                        array.push(label_parts, "(" + type_string + ")")
            else if mbz_count == 1
                single_mbz = array.get(consolidated_mbz.mbz_group, 0)
                gap_source = ""
                if str.contains(single_mbz.mbz_subtype, SUBTYPE_IMPLIED)
                    gap_source := GAP_SOURCE_IMPLIED_DISPLAY
                else if str.contains(single_mbz.mbz_subtype, SUBTYPE_VOLUME)
                    gap_source := GAP_SOURCE_VOLUME_DISPLAY
                else if str.contains(single_mbz.mbz_subtype, SUBTYPE_TRUE)
                    gap_source := GAP_SOURCE_TRUE_DISPLAY
                else if str.contains(single_mbz.mbz_subtype, SUBTYPE_RDRB)
                    gap_source := GAP_SOURCE_RDRB_DISPLAY

                if gap_source != ""
                    array.push(label_parts, "(" + gap_source + ")")

                subtype_display = get_subtype_display(single_mbz.mbz_subtype, single_mbz.is_bullish)
                if subtype_display != ""
                    body_top = math.max(single_mbz.mbz_open, single_mbz.mbz_close)
                    body_bottom = math.min(single_mbz.mbz_open, single_mbz.mbz_close)
                    body_size = body_top - body_bottom
                    upper_wick = single_mbz.high_price - body_top
                    lower_wick = body_bottom - single_mbz.low_price
                    [wick_tier, has_wick_dominance] = classify_wick_dominance(body_size, upper_wick, lower_wick)
                    single_is_risky = wick_tier == WICK_TIER_RISKY
                    risky_subtype = get_risky_subtype_display(single_mbz.mbz_subtype, single_mbz.is_bullish, single_is_risky)
                    array.push(label_parts, risky_subtype)

            if mbz_count > 1
                [unified_subtype, is_risky] = get_unified_subtype(consolidated_mbz.mbz_group)
                if unified_subtype != ""
                    array.push(label_parts, unified_subtype)

        has_deeper_wick_icon = false
        if should_show_source_gap_wick_star()
            for i = 0 to mbz_count - 1
                mbz_record = array.get(consolidated_mbz.mbz_group, i)
                if mbz_record.wicked_into_source_gap or mbz_record.reflection_pattern_deeper
                    has_deeper_wick_icon := true
                    break

        deeper_wick_icon_index = -1
        deeper_wick_icon_value = ""
        if has_deeper_wick_icon
            deeper_wick_icon_value := get_deeper_wick_icon()
            array.push(label_parts, deeper_wick_icon_value)
            deeper_wick_icon_index := array.size(label_parts) - 1

        if show_strong_label
            if deeper_wick_icon_index != -1
                array.insert(label_parts, deeper_wick_icon_index + 1, MULTI_SOURCE_STRENGTH_LABEL)
            else
                array.push(label_parts, MULTI_SOURCE_STRENGTH_LABEL)

        status_parts = array.new<string>()
        if consolidated_mbz.is_consolidated_invalidated
            array.push(status_parts, "[X]")
        else if consolidated_mbz.is_consolidated_breached
            array.push(status_parts, BREACH_STATUS_LABEL)

        if array.size(status_parts) > 0
            for i = 0 to array.size(status_parts) - 1
                array.push(label_parts, array.get(status_parts, i))

        if not consolidated_mbz.is_bullish and array.size(label_parts) > 0
            label_parts := mirror_label_stack_for_bearish(label_parts)

        result = ""
        for i = 0 to array.size(label_parts) - 1
            if i > 0
                result := result + "\n"
            result := result + array.get(label_parts, i)

        result

// Create consolidated extension label with SUPER MBZ checkmark support
create_consolidated_extension_label(consolidated_mbz) =>
    mbz_count = array.size(consolidated_mbz.mbz_group)
    direction = MBZ_BASE_TEXT + (consolidated_mbz.is_bullish ? MBZ_BULLISH_SUFFIX : MBZ_BEARISH_SUFFIX)
    extension_result = ""
    source_stats = get_source_type_stats(consolidated_mbz.mbz_group)
    strong_flag_active = is_multi_source_strong(source_stats)
    show_strong_extension = strong_flag_active and should_show_strong_on_extensions()

    // Check if any MBZ in group is breakaway (for labeling)
    has_breakaway = false
    if label_breakaway_fvgs
        for i = 0 to mbz_count - 1
            mbz = array.get(consolidated_mbz.mbz_group, i)
            if mbz.is_breakaway_mbz
                has_breakaway := true
                break

    // Add 50% tags if applicable
    mbz_text = has_breakaway ? LABEL_PREFIX_BREAKAWAY + direction : direction
    if show_50_percent_tags
        // Check if any MBZ in group formed exactly at 50%
        has_50_percent = false
        for i = 0 to array.size(consolidated_mbz.mbz_group) - 1
            mbz = array.get(consolidated_mbz.mbz_group, i)
            if mbz.is_exactly_50_percent
                has_50_percent := true
                break
        if has_50_percent
            mbz_text := mbz_text + " [½]"

    // Check for SUPER MBZs in group
    has_super = has_super_mbzs(consolidated_mbz.mbz_group)
    base_label = has_super ? CHECKMARK_SYMBOL + mbz_text : mbz_text

    // Only show advanced info when show_enhanced_label_details = true
    if show_enhanced_label_details
        if mbz_count == 1
            // Single MBZ - only show gap source if NOT standard FVG (fvg is implied)
            single_mbz = array.get(consolidated_mbz.mbz_group, 0)
            gap_source = ""
            if str.contains(single_mbz.mbz_subtype, SUBTYPE_IMPLIED)
                gap_source := " imp"
            else if str.contains(single_mbz.mbz_subtype, SUBTYPE_VOLUME)
                gap_source := " vol"
            else if str.contains(single_mbz.mbz_subtype, SUBTYPE_RDRB)
                gap_source := " rdrb"

            // Get subtype
            subtype_display = get_subtype_display(single_mbz.mbz_subtype, single_mbz.is_bullish)

            // Get risk indicator
            body_top = math.max(single_mbz.mbz_open, single_mbz.mbz_close)
            body_bottom = math.min(single_mbz.mbz_open, single_mbz.mbz_close)
            body_size = body_top - body_bottom
            upper_wick = single_mbz.high_price - body_top
            lower_wick = body_bottom - single_mbz.low_price
            [wick_tier, has_wick_dominance] = classify_wick_dominance(body_size, upper_wick, lower_wick)
            risky_prefix = wick_tier == WICK_TIER_RISKY ? "*" : ""

            // Apply checkmark for SUPER MBZs in extensions
            extension_result := base_label + gap_source

            if subtype_display != ""
                single_is_risky = risky_prefix != ""
                risky_subtype = get_risky_subtype_display(single_mbz.mbz_subtype, single_mbz.is_bullish, single_is_risky)
                extension_result := extension_result + " " + risky_subtype
        else
            // Multiple MBZs - use extension breakdown logic
            source_breakdown = build_source_breakdown_extension_from_stats(source_stats)

            extension_result := base_label + " (" + source_breakdown + ")"

            // Add unified subtype inline (not on new line)
            [unified_subtype, unified_is_risky] = get_unified_subtype(consolidated_mbz.mbz_group)
            if unified_subtype != ""
                extension_result := extension_result + " " + unified_subtype
    else
        // When advanced labels are OFF, show clean MBZ⁺/MBZ⁻ with checkmark for SUPER
        extension_result := base_label

    // Check if any MBZ in group wicked into source gap
    has_deeper_wick_border = false
    if should_show_source_gap_wick_star()
        for i = 0 to array.size(consolidated_mbz.mbz_group) - 1
            mbz_record = array.get(consolidated_mbz.mbz_group, i)
            if mbz_record.wicked_into_source_gap or mbz_record.reflection_pattern_deeper
                has_deeper_wick_border := true
                break

    // Add deeper wick symbol at the end (like SIF immediate inversion)
    if has_deeper_wick_border
        extension_result := extension_result + " " + get_deeper_wick_icon()

    // Add status indicators AFTER special markers - invalidation takes precedence
    if consolidated_mbz.is_consolidated_invalidated
        extension_result := extension_result + " [X]"
    else if consolidated_mbz.is_consolidated_breached
        extension_result := extension_result + " " + BREACH_STATUS_LABEL

    if show_strong_extension
        extension_result := str.length(extension_result) == 0 ? MULTI_SOURCE_STRENGTH_LABEL : MULTI_SOURCE_STRENGTH_LABEL + "\n" + extension_result

    // Add horizontal padding based on alignment setting
    if extension_label_horizontal_alignment == LABEL_ALIGNMENT_LEFT and str.length(horizontal_padding_str) > 0
        extension_result := horizontal_padding_str + extension_result
    else if extension_label_horizontal_alignment == LABEL_ALIGNMENT_RIGHT and str.length(horizontal_padding_str) > 0
        extension_result := extension_result + horizontal_padding_str

    // Add vertical padding (newlines)
    if str.length(vertical_padding_str) > 0
        if extension_label_vertical_alignment == LABEL_VERTICAL_TOP
            extension_result := extension_result + vertical_padding_str
        else if extension_label_vertical_alignment == LABEL_VERTICAL_BOTTOM
            extension_result := vertical_padding_str + extension_result

    extension_result

// Build consolidated tooltip with SUPER MBZ info
build_consolidated_tooltip(consolidated_mbz) =>
    mbz_count = array.size(consolidated_mbz.mbz_group)
    source_stats = get_source_type_stats(consolidated_mbz.mbz_group)
    strong_flag_active = is_multi_source_strong(source_stats)
    direction = consolidated_mbz.is_bullish ? MBZ_PLUS : MBZ_MINUS
    base_text = direction

    if mbz_count > 1
        // Show detailed breakdown using new extension logic
        source_breakdown = build_source_breakdown_extension_from_stats(source_stats)
        base_text := base_text + " (" + source_breakdown + ")"
    else if mbz_count == 1
        // Show source type for single non-FVG MBZs
        single_mbz = array.get(consolidated_mbz.mbz_group, 0)
        if str.contains(single_mbz.mbz_subtype, SUBTYPE_IMPLIED)
            base_text := base_text + " (imp)"
        else if str.contains(single_mbz.mbz_subtype, SUBTYPE_VOLUME)
            base_text := base_text + " (vol)"
        else if str.contains(single_mbz.mbz_subtype, SUBTYPE_TRUE)
            base_text := base_text + " (gap)"
        else if str.contains(single_mbz.mbz_subtype, SUBTYPE_RDRB)
            base_text := base_text + " (rdrb)"
        // FVG shows nothing (default/implied)

    if strong_flag_active
        base_text := base_text + " " + MULTI_SOURCE_STRENGTH_LABEL

    // Restructure: Behavior comes FIRST - "Inclusion MBZ⁺ (imp)"
    if mbz_count > 0
        first_mbz = array.get(consolidated_mbz.mbz_group, 0)
        if str.contains(first_mbz.mbz_subtype, SUBTYPE_INCLUSION)
            base_text := SUBTYPE_INCLUSION_FULL + " " + base_text
        else if str.contains(first_mbz.mbz_subtype, SUBTYPE_REFLECTION)
            base_text := SUBTYPE_REFLECTION_FULL + " " + base_text

    // Add source gap wick information if enabled
    has_deeper_wick_border = false
    if mbz_count > 0
        for i = 0 to array.size(consolidated_mbz.mbz_group) - 1
            mbz_record = array.get(consolidated_mbz.mbz_group, i)
            if mbz_record.wicked_into_source_gap or mbz_record.reflection_pattern_deeper
                has_deeper_wick_border := true
                break

    // Add descriptive text for source gap wick detection
    if has_deeper_wick_border
        base_text := base_text + "\n" + SOURCE_GAP_DEEPER_WICK_DESCRIPTION_TEXT

    // Add SUPER MBZ information
    has_super = has_super_mbzs(consolidated_mbz.mbz_group)
    strength_info = ""
    if has_super
        // Find the first SUPER MBZ for details
        for i = 0 to array.size(consolidated_mbz.mbz_group) - 1
            mbz_record = array.get(consolidated_mbz.mbz_group, i)
            if mbz_record.is_super_mbz
                bars_ago = bar_index - mbz_record.overlapping_mbz_bar_index
                direction_text = mbz_record.is_bullish ? MBZ_PLUS : MBZ_MINUS
                strength_info := "\n" + str.tostring(mbz_record.overlap_percentage, "#.1") + "% overlap with " + direction_text + " from " + str.tostring(bars_ago) + " bars ago"
                break

    // Only show breach status if NOT invalidated (mutually exclusive)
    status_text = ""
    if consolidated_mbz.is_consolidated_invalidated
        status_text := status_text + " - INVALIDATED"
    else if consolidated_mbz.is_consolidated_breached
        current_breach_pct = get_consolidated_breach_percentage(consolidated_mbz)
        status_text := status_text + BREACH_STATUS_TEXT + str.tostring(current_breach_pct, "#.1") + BREACH_STATUS_SUFFIX
    else if not barstate.isconfirmed
        // Show re-entry percentage when price is back inside zone
        current_breach_pct = get_consolidated_breach_percentage(consolidated_mbz)
        if current_breach_pct > 0
            status_text := status_text + " - " + str.tostring(current_breach_pct, "#.1") + "% filled"

    base_text + strength_info + status_text

// ═══════════════════════════════════════════════════════════════════════════════
// DISPLAY HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

get_mbz_colors(mbz_record) =>
    // Determine base color (breakaway custom colors override normal colors for active zones)
    original_color = if enable_breakaway_custom_colors and mbz_record.is_breakaway_mbz and not mbz_record.is_invalidated
        mbz_record.is_bullish ? breakaway_bullish_color : breakaway_bearish_color
    else
        mbz_record.is_bullish ? extended_box_bullish_color : extended_box_bearish_color

    // Check if MBZ is currently breached (but not invalidated)
    is_breached = is_mbz_currently_breached(mbz_record)
    should_fade = enable_breach_detection and enable_zone_fade and is_breached and not mbz_record.is_invalidated
    if should_fade
        // Fade the original color
        original_transparency = color.t(original_color)
        fade_amount = breach_transparency_percent / 100.0
        new_transparency = math.min(MAX_FADE_TRANSPARENCY, original_transparency + (fade_amount * (100 - original_transparency)))
        faded_color = color.new(color.rgb(color.r(original_color), color.g(original_color), color.b(original_color)), new_transparency)
        // Apply same faded color to both candle highlight AND extension
        [faded_color, faded_color]
    else
        // Use original color for both
        [original_color, original_color]

// Get appropriate text color for MBZ labels (use breach color when breached)
get_mbz_extension_text_color(mbz_record, default_text_color) =>
    // Check if MBZ is currently breached and should use breach color
    is_breached = is_mbz_currently_breached(mbz_record)
    should_use_breach_color = enable_breach_detection and enable_text_color_change and is_breached and not mbz_record.is_invalidated
    if should_use_breach_color
        breach_label_color
    else
        default_text_color

// Get appropriate text color for consolidated MBZ labels
get_consolidated_extension_text_color(consolidated_mbz, default_text_color) =>
    // Check if consolidated MBZ is currently breached and should use breach color
    is_breached = consolidated_mbz.is_consolidated_breached
    should_use_breach_color = enable_breach_detection and enable_text_color_change and is_breached and not consolidated_mbz.is_consolidated_invalidated
    if should_use_breach_color
        breach_label_color
    else
        default_text_color

get_consolidated_mbz_colors(consolidated_mbz) =>
    // Check if any MBZ in group is breakaway
    has_breakaway = false
    if enable_breakaway_custom_colors and not consolidated_mbz.is_consolidated_invalidated
        for i = 0 to array.size(consolidated_mbz.mbz_group) - 1
            mbz = array.get(consolidated_mbz.mbz_group, i)
            if mbz.is_breakaway_mbz
                has_breakaway := true
                break

    // Determine base color (breakaway custom colors override normal colors for active zones)
    original_color = if has_breakaway
        consolidated_mbz.is_bullish ? breakaway_bullish_color : breakaway_bearish_color
    else
        consolidated_mbz.is_bullish ? extended_box_bullish_color : extended_box_bearish_color

    // Check if consolidated MBZ is currently breached (but not invalidated)
    is_breached = consolidated_mbz.is_consolidated_breached
    should_fade = enable_breach_detection and enable_zone_fade and is_breached and not consolidated_mbz.is_consolidated_invalidated
    if should_fade
        // Fade the original color
        original_transparency = color.t(original_color)
        fade_amount = breach_transparency_percent / 100.0
        new_transparency = math.min(MAX_FADE_TRANSPARENCY, original_transparency + (fade_amount * (100 - original_transparency)))
        faded_color = color.new(color.rgb(color.r(original_color), color.g(original_color), color.b(original_color)), new_transparency)
        // Apply same faded color to both candle highlight AND extension
        [faded_color, faded_color]
    else
        // Use original color for both
        [original_color, original_color]

should_display_mbz(mbz_record) =>
    if mbz_record.is_invalidated and not show_invalidated_mbzs
        false
    else if str.contains(mbz_record.mbz_subtype, SUBTYPE_TRUE) and not enable_true_gaps
        false  // Hide True Gap MBZs when source disabled
    else if str.contains(mbz_record.mbz_subtype, SUBTYPE_IMPLIED) and not enable_implied
        false  // Hide Implied MBZs when source disabled
    else if str.contains(mbz_record.mbz_subtype, SUBTYPE_VOLUME) and not enable_volume_imbalance
        false  // Hide Volume MBZs when source disabled
    else if str.contains(mbz_record.mbz_subtype, SUBTYPE_RDRB) and not enable_rdrb
        false  // Hide RDRB MBZs when source disabled
    else if not str.contains(mbz_record.mbz_subtype, SUBTYPE_TRUE) and not str.contains(mbz_record.mbz_subtype, SUBTYPE_IMPLIED) and not str.contains(mbz_record.mbz_subtype, SUBTYPE_VOLUME) and not str.contains(mbz_record.mbz_subtype, SUBTYPE_RDRB) and not enable_fair_value_gaps
        false  // Hide FVG MBZs when source disabled (detected by exclusion)
    else
        true

// Check if MBZ should be displayed based on directional filter
should_display_mbz_direction(mbz_record) =>
    mbz_record.is_bullish ? show_bullish_mbzs : show_bearish_mbzs

// @function get_border_properties_for_mbz
// @description Returns border width and color based on MBZ properties (deeper wick > multi-source > single)
// @param consolidated_mbz ConsolidatedMBZ - the consolidated MBZ to analyze
// @param mbz_source_count int - cached source count for performance
// @returns [int, color] - [border_width, border_color]
get_border_properties_for_mbz(consolidated_mbz, mbz_source_count) =>
    is_multi_source = enable_multi_source_highlighting and mbz_source_count > 1

    // Check if any MBZ in group has source gap wick detection
    has_deeper_wick_border = false
    if should_show_source_gap_wick_border()
        for i = 0 to array.size(consolidated_mbz.mbz_group) - 1
            mbz_record = array.get(consolidated_mbz.mbz_group, i)
            if mbz_record.wicked_into_source_gap or mbz_record.reflection_pattern_deeper
                has_deeper_wick_border := true
                break

    // Get default border color (same as extension background color)
    default_border_color = consolidated_mbz.is_bullish ? extended_box_bullish_color : extended_box_bearish_color

    // Determine final border properties (priority: source gap wick > multi-source > default)
    border_width_final = has_deeper_wick_border ? deeper_wick_border_width : is_multi_source ? multi_source_border_width : 1
    border_color_final = has_deeper_wick_border ? source_gap_wick_border_color : is_multi_source ? multi_source_border_color : default_border_color

    [border_width_final, border_color_final]

should_display_consolidated_mbz(consolidated_mbz) =>
    // Cache source count for performance
    mbz_source_count = array.size(consolidated_mbz.mbz_group)

    matches_single = mbz_source_count == 1 and filter_single_source_mbzs
    matches_multi = mbz_source_count > 1 and filter_multi_source_mbzs

    if not (matches_single or matches_multi)
        false
    else
        // Check if any MBZ in the group should be displayed (original v9.15 logic preserved)
        should_display = false
        has_breakaway = false
        for i = 0 to array.size(consolidated_mbz.mbz_group) - 1
            mbz_record = array.get(consolidated_mbz.mbz_group, i)
            if mbz_record.is_breakaway_mbz
                has_breakaway := true
            if should_display_mbz(mbz_record)
                should_display := true

        should_display

should_highlight_mbz(mbz_record) =>
    // Show extensions for valid MBZs OR invalidated when enabled
    if mbz_record.is_invalidated
        show_invalidated_mbzs
    else
        true

should_highlight_consolidated_mbz(consolidated_mbz) =>
    if consolidated_mbz.is_consolidated_invalidated
        show_invalidated_mbzs
    else
        true

should_project_mbz(mbz_record) =>
    not mbz_record.is_invalidated

should_project_consolidated_mbz(consolidated_mbz) =>
    not consolidated_mbz.is_consolidated_invalidated

// ═══════════════════════════════════════════════════════════════════════════════
// PROJECTION SYSTEM FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// Get color and size for specific level type
get_level_style(level) =>
    level_color = color.gray
    level_size = size.small

    if level == 0.0 or level == 1.0
        // Boundaries
        level_color := boundary_color
        level_size := get_text_size(boundary_text_size)
    else if level == FIBONACCI_CENTER
        // CE (50%)
        level_color := ce_color
        level_size := get_text_size(ce_text_size)
    else if level > 0.0 and level < 1.0
        // Quadrants
        level_color := quadrant_color
        level_size := get_text_size(quadrant_text_size)
    else if level > 1.0
        // Stops
        level_color := stop_color
        level_size := get_text_size(stop_text_size)
    else if level < 0.0
        // Targets
        level_color := target_color
        level_size := get_text_size(target_text_size)
    else
        // Fallback
        level_color := color.gray
        level_size := size.small

    [level_color, level_size]

// PROJECTION LEVELS FUNCTION
get_projection_levels() =>
    levels = array.new<float>()

    // BOUNDARIES: Core levels (0=close, 1=open)
    if show_boundaries
        array.push(levels, 0.0)   // Close
        array.push(levels, 1.0)   // Open

    // CE: 50% center level
    if show_ce
        array.push(levels, FIBONACCI_CENTER)   // 50% center

    // QUADRANTS: Only 0.25 and 0.75 (removed 0.5)
    if show_quadrants
        array.push(levels, FIBONACCI_QUARTER_LOW)  // Between 0 and 1
        array.push(levels, FIBONACCI_QUARTER_HIGH)  // Between 0 and 1

    // STOPS: Beyond open (1.25, 1.5, 2.0)
    if show_stops
        array.push(levels, FIBONACCI_STOP_125)
        array.push(levels, FIBONACCI_STOP_150)
        array.push(levels, FIBONACCI_STOP_200)

    // TARGETS: Beyond close (-2.0, -2.5, -4, -4.5)
    if show_targets
        array.push(levels, FIBONACCI_TARGET_200)
        array.push(levels, FIBONACCI_TARGET_250)
        array.push(levels, FIBONACCI_TARGET_400)
        array.push(levels, FIBONACCI_TARGET_450)

    // CUSTOM: Proper comma-separated parsing
    if show_custom
        input_str = custom_levels_input
        if str.length(input_str) > 0
            // Split by comma and parse each value
            split_values = str.split(input_str, ",")
            for i = 0 to array.size(split_values) - 1
                value_str = str.replace_all(array.get(split_values, i), " ", "")  // Remove spaces
                if str.length(value_str) > 0
                    parsed_value = str.tonumber(value_str)
                    if not na(parsed_value)
                        array.push(levels, parsed_value)

    // Default fallback if nothing selected
    if array.size(levels) == 0
        array.push(levels, 0.0)
        array.push(levels, 1.0)

    levels

// Format projection level labels
format_level_label(level) =>
    base_str = str.tostring(level, '#.##')
    str_len = str.length(base_str)
    padding_needed = 5 - str_len
    padded_str = base_str

    if padding_needed > 0
        for i = 1 to padding_needed
            padded_str := padded_str + " "

    padded_str

// Box creation
create_box(left_bar, top_price, bottom_price, box_color, label_text) =>
    box.new(
         left=left_bar,
         top=top_price,
         right=left_bar + 3,
         bottom=bottom_price,
         bgcolor=box_color,
         border_color=box_color,
         border_style=line.style_solid,
         border_width=1,
         text=label_text,
         text_halign=text.align_center,
         text_valign=text.align_center,
         text_size=get_label_size(),
         text_color=source_gap_text_color
     )

// ═══════════════════════════════════════════════════════════════════════════════
// CONSOLIDATED VISUAL MANAGEMENT SYSTEM // ═══════════════════════════════════════════════════════════════════════════════

manage_consolidated_mbz_display() =>
    // Clear all visual elements efficiently
    for elem in mbz_labels
        label.delete(elem)
    array.clear(mbz_labels)

    // Always clear source gap boxes for dynamic toggle behavior
    for elem in source_gap_boxes
        box.delete(elem)
    array.clear(source_gap_boxes)

    for elem in mbz_body_highlights
        box.delete(elem)
    array.clear(mbz_body_highlights)

    for elem in mbz_extended_boxes
        box.delete(elem)
    array.clear(mbz_extended_boxes)

    for elem in mbz_projection_lines
        line.delete(elem)
    array.clear(mbz_projection_lines)

    for elem in mbz_lines
        line.delete(elem)
    array.clear(mbz_lines)

    for elem in mbz_projection_labels
        label.delete(elem)
    array.clear(mbz_projection_labels)

    array.clear(displayed_mbz_indices)

    // Group MBZs by candle for consolidation
    displayable_mbzs = array.new<MBZRecord>()

    // Add bounds checking to prevent array out of bounds error
    total_mbz_records = array.size(all_mbz_records)

    if total_mbz_records > 0  // Only proceed if we have records
        // SEPARATE LIMITS SYSTEM: Independent control over valid vs invalidated MBZ display counts
        valid_mbz_count = 0           // Counter for valid (non-breached) MBZs
        invalidated_mbz_count = 0     // Counter for invalidated (breached) MBZs

        for record_index = total_mbz_records - 1 to 0
            current_mbz_record = array.get(all_mbz_records, record_index)

            if should_display_mbz_direction(current_mbz_record)
                // SEPARATE LIMITS SYSTEM: Process valid and invalidated MBZs with independent counters
                if not current_mbz_record.is_invalidated and valid_mbz_count < max_valid_mbzs_effective
                    // Add valid MBZs up to configured limit
                    if should_display_mbz(current_mbz_record)
                        array.push(displayable_mbzs, current_mbz_record)
                        valid_mbz_count += 1
                else if current_mbz_record.is_invalidated and invalidated_mbz_count < max_invalidated_mbzs and show_invalidated_mbzs
                    // Add invalidated MBZs only when display is enabled and under limit
                    if should_display_mbz(current_mbz_record)
                        array.push(displayable_mbzs, current_mbz_record)
                        invalidated_mbz_count += 1

                // PERFORMANCE OPTIMIZATION: Early termination when limits reached
                if valid_mbz_count >= max_valid_mbzs_effective and
                   (invalidated_mbz_count >= max_invalidated_mbzs or not show_invalidated_mbzs)
                    break  // Stop processing when display limits are reached

    // Group displayable MBZs by candle (will return empty array if no displayable MBZs)
    consolidated_mbzs = group_mbzs_by_candle(displayable_mbzs)

    // Only process if we have consolidated MBZs
    if array.size(consolidated_mbzs) > 0
        gap_boxes_already_created = array.new<int>()
        created_gap_ids_overall = array.new_int()
        bar_duration_ms = timeframe.in_seconds() * 1000

        for consolidated_group_index = 0 to array.size(consolidated_mbzs) - 1
            current_consolidated_mbz = array.get(consolidated_mbzs, consolidated_group_index)

            if not should_display_consolidated_mbz(current_consolidated_mbz)
                continue

            // Calculate consolidated zone boundaries
            [consolidated_zone_top_boundary, consolidated_zone_bottom_boundary] = calculate_consolidated_zone_boundaries(current_consolidated_mbz.mbz_group)
            current_consolidated_mbz.consolidated_zone_top := consolidated_zone_top_boundary
            current_consolidated_mbz.consolidated_zone_bottom := consolidated_zone_bottom_boundary

            // Determine consolidated status
            [is_currently_breached, is_currently_invalidated] = determine_consolidated_status(current_consolidated_mbz)
            current_consolidated_mbz.is_consolidated_breached := is_currently_breached
            current_consolidated_mbz.is_consolidated_invalidated := is_currently_invalidated

            // Build labels
            current_consolidated_mbz.consolidated_candle_label := create_consolidated_candle_label(current_consolidated_mbz)
            current_consolidated_mbz.consolidated_extension_label := create_consolidated_extension_label(current_consolidated_mbz)

            // Update the consolidated_mbzs array
            array.set(consolidated_mbzs, consolidated_group_index, current_consolidated_mbz)

            // Get first MBZ from group for invalidation boundary calculation and label positioning
            first_mbz_in_group = array.get(current_consolidated_mbz.mbz_group, 0)

            // Create candle label with proper positioning
            if show_mbz_labels
                consolidated_label_color = current_consolidated_mbz.is_consolidated_invalidated ? mbz_invalidated_color : (current_consolidated_mbz.is_bullish ? mbz_bullish_color : mbz_bearish_color)
                consolidated_label_size = current_consolidated_mbz.is_consolidated_invalidated ? get_invalidated_mbz_size() : get_mbz_label_size()

                // Check if any MBZ in group is reflection type with extensions enabled
                has_reflection_mbz = false
                for mbz_check_index = 0 to array.size(current_consolidated_mbz.mbz_group) - 1
                    check_mbz = array.get(current_consolidated_mbz.mbz_group, mbz_check_index)
                    if str.contains(check_mbz.mbz_subtype, SUBTYPE_REFLECTION)
                        has_reflection_mbz := true
                        break

                // Declare variables for positioning
                candle_label_y_position = float(na)
                candle_label_yloc = yloc.price

                // Calculate zone height for offset calculations
                zone_height = current_consolidated_mbz.consolidated_zone_top - current_consolidated_mbz.consolidated_zone_bottom

                // Calculate proper positioning
                if show_extended_boxes and has_reflection_mbz
                    // For reflection MBZs with extensions, use reflection spacing multiplier
                    spacing_offset = zone_height * reflection_label_offset_multiplier

                    if current_consolidated_mbz.is_bullish
                        // Bullish reflection: extension goes down, push label further down
                        candle_label_y_position := current_consolidated_mbz.consolidated_zone_bottom - spacing_offset
                    else
                        // Bearish reflection: extension goes up, push label further up
                        candle_label_y_position := current_consolidated_mbz.consolidated_zone_top + spacing_offset

                    candle_label_yloc := yloc.price
                else
                    // Standard positioning using yloc.belowbar/abovebar
                    candle_label_y_position := current_consolidated_mbz.is_bullish ? first_mbz_in_group.low_price : first_mbz_in_group.high_price
                    candle_label_yloc := current_consolidated_mbz.is_bullish ? yloc.belowbar : yloc.abovebar

                // Apply general vertical offset (applies to all labels)
                if general_label_offset_multiplier > 0
                    general_offset = zone_height * general_label_offset_multiplier
                    if current_consolidated_mbz.is_bullish
                        // Bullish: push label further down
                        candle_label_y_position := candle_label_y_position - general_offset
                    else
                        // Bearish: push label further up
                        candle_label_y_position := candle_label_y_position + general_offset
                    // When using general offset, always use yloc.price for precise positioning
                    candle_label_yloc := yloc.price

                consolidated_tooltip_text = build_consolidated_tooltip(current_consolidated_mbz)

                new_consolidated_label = label.new(
                     x=current_consolidated_mbz.bar_index,
                     y=candle_label_y_position,
                     text=current_consolidated_mbz.consolidated_candle_label,
                     style=label.style_none,
                     textcolor=consolidated_label_color,
                     size=consolidated_label_size,
                     yloc=candle_label_yloc,
                     tooltip=consolidated_tooltip_text
                 )

                array.push(mbz_labels, new_consolidated_label)

            // Create consolidated extension box
            should_highlight_consolidated_zone = show_extended_boxes and should_highlight_consolidated_mbz(current_consolidated_mbz)
            if should_highlight_consolidated_zone
                [consolidated_highlight_color, consolidated_extension_color] = get_consolidated_mbz_colors(current_consolidated_mbz)

                // Highlight box (consolidated zone)
                consolidated_highlight_box = box.new(
                     left=current_consolidated_mbz.formation_time,
                     right=current_consolidated_mbz.formation_time + bar_duration_ms,
                     top=current_consolidated_mbz.consolidated_zone_top,
                     bottom=current_consolidated_mbz.consolidated_zone_bottom,
                     xloc=xloc.bar_time,
                     bgcolor=consolidated_highlight_color,
                     border_color=na
                 )
                array.push(mbz_body_highlights, consolidated_highlight_box)

                extension_right_time = switch extension_mode
                    EXTENSION_FIXED => current_consolidated_mbz.formation_time + (extended_box_length * bar_duration_ms)
                    EXTENSION_TO_CURRENT => math.max(time, current_consolidated_mbz.formation_time + (extended_box_length * bar_duration_ms))
                    EXTENSION_BEYOND_CURRENT => time + (extended_box_length * bar_duration_ms)
                    => current_consolidated_mbz.formation_time + (extended_box_length * bar_duration_ms)

                // Get cached source count for performance
                mbz_source_count = array.size(current_consolidated_mbz.mbz_group)

                // Get border properties for multi-source highlighting
                [border_width_to_use, border_color_to_use] = get_border_properties_for_mbz(current_consolidated_mbz, mbz_source_count)

                consolidated_extension_box = box.new(
                     left=current_consolidated_mbz.formation_time,
                     right=extension_right_time,
                     top=current_consolidated_mbz.consolidated_zone_top,
                     bottom=current_consolidated_mbz.consolidated_zone_bottom,
                     xloc=xloc.bar_time,
                     bgcolor=consolidated_extension_color,
                     border_color=border_color_to_use,
                     border_width=border_width_to_use,
                     text=current_consolidated_mbz.consolidated_extension_label,
                     text_halign=get_extension_label_halign(),
                     text_valign=get_extension_label_valign(),
                     text_color=get_consolidated_extension_text_color(current_consolidated_mbz, extended_box_text_color),
                     text_size=get_extended_box_text_size()
                 )
                array.push(mbz_extended_boxes, consolidated_extension_box)

                // Add breach level line within extension box
                if enable_breached_lines and enable_breach_detection
                    breached_level_price = get_breached_level_price(
                         current_consolidated_mbz.consolidated_zone_top,
                         current_consolidated_mbz.consolidated_zone_bottom,
                         current_consolidated_mbz.is_bullish
                     )
                    if not na(breached_level_price)
                        breached_line_color_final = get_breached_line_color()
                        breached_line = line.new(
                             x1=current_consolidated_mbz.formation_time,
                             y1=breached_level_price,
                             x2=extension_right_time,
                             y2=breached_level_price,
                             xloc=xloc.bar_time,
                             color=breached_line_color_final,
                             style=get_breached_line_style(),
                             width=breached_line_width
                         )
                        array.push(mbz_lines, breached_line)

                // Add invalidation level line within extension box
                if enable_invalidation_lines
                    invalidation_level_price = get_invalidation_level_price(first_mbz_in_group)
                    if not na(invalidation_level_price)
                        invalidation_line_color_final = get_invalidation_line_color()
                        invalidation_line = line.new(
                             x1=current_consolidated_mbz.formation_time,
                             y1=invalidation_level_price,
                             x2=extension_right_time,
                             y2=invalidation_level_price,
                             xloc=xloc.bar_time,
                             color=invalidation_line_color_final,
                             style=get_invalidation_line_style(),
                             width=invalidation_line_width
                         )
                        array.push(mbz_lines, invalidation_line)

            // Source gap creation - use cached geometry (independent of active_gaps retention)
            if show_source_gap and array.size(source_gap_boxes) < max_source_gap_boxes_effective
                // Create gap box for EACH MBZ in the group
                for current_mbz_index = 0 to array.size(current_consolidated_mbz.mbz_group) - 1
                    current_mbz_in_group = array.get(current_consolidated_mbz.mbz_group, current_mbz_index)

                    // Skip if we've already created this gap box anywhere in this pass
                    if not array.includes(gap_boxes_already_created, current_mbz_in_group.source_gap_id) and not array.includes(created_gap_ids_overall, current_mbz_in_group.source_gap_id)
                        individual_mbz_label = MBZ_BASE_TEXT + (current_mbz_in_group.is_bullish ? MBZ_BULLISH_SUFFIX : MBZ_BEARISH_SUFFIX)

                        // Build label text from cached type and direction
                        source_gap_label_text = ""
                        breakaway_prefix = (label_breakaway_fvgs and current_mbz_in_group.is_breakaway_mbz) ? LABEL_PREFIX_BREAKAWAY : ""
                        if current_mbz_in_group.source_gap_type == GAP_TYPE_IMPLIED
                            source_gap_label_text := breakaway_prefix + (current_mbz_in_group.is_bullish ? GAP_LABEL_IMPLIED_BULLISH + individual_mbz_label : GAP_LABEL_IMPLIED_BEARISH + individual_mbz_label)
                        else if current_mbz_in_group.source_gap_type == GAP_TYPE_VOLUME
                            source_gap_label_text := breakaway_prefix + (current_mbz_in_group.is_bullish ? GAP_LABEL_VOLUME_BULLISH + individual_mbz_label : GAP_LABEL_VOLUME_BEARISH + individual_mbz_label)
                        else if current_mbz_in_group.source_gap_type == GAP_TYPE_TRUE
                            source_gap_label_text := breakaway_prefix + (current_mbz_in_group.is_bullish ? GAP_LABEL_TRUE_BULLISH + individual_mbz_label : GAP_LABEL_TRUE_BEARISH + individual_mbz_label)
                        else if current_mbz_in_group.source_gap_type == GAP_TYPE_RDRB
                            source_gap_label_text := breakaway_prefix + (current_mbz_in_group.is_bullish ? GAP_LABEL_RDRB_BULLISH + individual_mbz_label : GAP_LABEL_RDRB_BEARISH + individual_mbz_label)
                        else
                            source_gap_label_text := breakaway_prefix + (current_mbz_in_group.is_bullish ? GAP_LABEL_FVG_BULLISH + individual_mbz_label : GAP_LABEL_FVG_BEARISH + individual_mbz_label)

                        // Create and configure gap box from cached geometry
                        individual_gap_box = create_box(
                             current_mbz_in_group.source_gap_bar_index,
                             current_mbz_in_group.source_gap_top,
                             current_mbz_in_group.source_gap_bottom,
                             gap_color,
                             source_gap_label_text
                         )
                        box.set_right(individual_gap_box, current_mbz_in_group.bar_index - 1)  // Extend to mitigation candle
                        array.push(source_gap_boxes, individual_gap_box)

                        // Mark this gap ID as processed
                        array.push(gap_boxes_already_created, current_mbz_in_group.source_gap_id)
                        array.push(created_gap_ids_overall, current_mbz_in_group.source_gap_id)

        // Projections using consolidated zones
        if show_mbz_projections and array.size(consolidated_mbzs) > 0
            projection_levels_list = get_projection_levels()
            projected_mbz_count = 0

            for consolidated_mbz_index = 0 to array.size(consolidated_mbzs) - 1
                if projected_mbz_count >= project_last_n_mbzs
                    break

                current_consolidated_mbz = array.get(consolidated_mbzs, consolidated_mbz_index)

                if not should_project_consolidated_mbz(current_consolidated_mbz)
                    continue

                consolidated_zone_close_level = current_consolidated_mbz.consolidated_zone_bottom
                consolidated_zone_open_level = current_consolidated_mbz.consolidated_zone_top
                projection_start_time = current_consolidated_mbz.formation_time
                projection_end_time = current_consolidated_mbz.formation_time + (projection_extend_bars * bar_duration_ms)

                for level_index = 0 to array.size(projection_levels_list) - 1
                    current_level_value = array.get(projection_levels_list, level_index)
                    zone_range = (consolidated_zone_open_level - consolidated_zone_close_level)
                    // Direction-aware projection mapping (parity with SIF v9.21):
                    // 0.0 => close (zone bottom), 1.0 => open (zone top),
                    // 0..1 => inside zone from close toward open,
                    // >1.0 (Stops): Bullish below close; Bearish above open
                    // <0.0 (Targets): Bullish above open; Bearish below close
                    projection_target_price = if current_level_value == 0.0
                        consolidated_zone_close_level
                    else if current_level_value == 1.0
                        consolidated_zone_open_level
                    else if current_level_value > 0.0 and current_level_value < 1.0
                        consolidated_zone_close_level + (zone_range * current_level_value)
                    else if current_level_value > 1.0
                        level_extension = current_level_value - 1.0
                        current_consolidated_mbz.is_bullish
                          ? (consolidated_zone_close_level - (zone_range * level_extension))
                          : (consolidated_zone_open_level + (zone_range * level_extension))
                    else
                        absolute_level_value = math.abs(current_level_value)
                        current_consolidated_mbz.is_bullish
                          ? (consolidated_zone_open_level + (zone_range * absolute_level_value))
                          : (consolidated_zone_close_level - (zone_range * absolute_level_value))

                    [level_text_color, level_text_size] = get_level_style(current_level_value)

                    projection_line = line.new(x1=projection_start_time, y1=projection_target_price, x2=projection_end_time, y2=projection_target_price,
                                  xloc=xloc.bar_time, color=level_text_color,
                                  style=get_projection_line_style(), width=projection_line_width)
                    array.push(mbz_projection_lines, projection_line)

                    level_label_text = format_level_label(current_level_value)
                    label_offset_ms = PROJECTION_LABEL_OFFSET_BARS * bar_duration_ms
                    label_x_position = projection_label_side == LABEL_POSITION_LEFT ? (projection_start_time - label_offset_ms) : (projection_end_time + label_offset_ms)
                    if label_x_position < 0
                        label_x_position := 0
                    projection_level_label = label.new(x=label_x_position, y=projection_target_price, text=level_label_text, style=label.style_none,
                                         textcolor=level_text_color, size=level_text_size,
                                         yloc=yloc.price,
                                         textalign=projection_label_side == LABEL_POSITION_LEFT ? text.align_right : text.align_left)
                    array.push(mbz_projection_labels, projection_level_label)
                projected_mbz_count += 1

    // Cache consolidated groups for reuse in stars block (avoid re-grouping)
    array.clear(last_consolidated_mbzs)
    if array.size(consolidated_mbzs) > 0
        for cache_i = 0 to array.size(consolidated_mbzs) - 1
            array.push(last_consolidated_mbzs, array.get(consolidated_mbzs, cache_i))

// ═══════════════════════════════════════════════════════════════════════════════
// MAIN DETECTION LOGIC - ENHANCED WITH VOLUME IMBALANCE SUPPORT // ═══════════════════════════════════════════════════════════════════════════════

// Reset multi-source alert flags each bar (per-bar evaluation)
multi_source_mbz_bullish_formed := false
multi_source_mbz_bearish_formed := false
strong_mbz_bullish_formed := false
strong_mbz_bearish_formed := false

// Reset new alert flags each bar (per-bar evaluation)
nested_mbz_bullish_formed := false
nested_mbz_bearish_formed := false
deeper_wick_mbz_bullish_formed := false
deeper_wick_mbz_bearish_formed := false
// Reset baseline MBZ formation flags each bar (used by alertcondition/grouped alerts)
mbz_bullish_formed := false
mbz_bearish_formed := false

// Cache breakaway trend range calculations once per bar (performance optimization)
// Only calculated when FVGs are enabled (breakaway is an FVG property)
var float breakaway_upper = na
var float breakaway_lower = na
bool filter_allows_breakaway = fvg_type_filter != FVG_FILTER_STANDARD_ONLY
bool filter_allows_standard = fvg_type_filter != FVG_FILTER_BREAKAWAY_ONLY
if enable_fair_value_gaps and barstate.isconfirmed
    breakaway_upper := ta.highest(high, BREAKAWAY_LENGTH)
    breakaway_lower := ta.lowest(low, BREAKAWAY_LENGTH)

// PERFORMANCE OPTIMIZATION: Skip historical processing for instant loading
if ENABLE_HISTORICAL_BACKFILL and not initialized and barstate.islastconfirmedhistory
    // Historical backfill processing would go here (currently disabled)
    initialized := true
else if not initialized
    // Skip historical processing - start fresh for instant loading
    initialized := true

// Track new regular FVGs with correct anchoring (3-candle structure: anchor from C1)
if enable_fair_value_gaps and barstate.isconfirmed and is_bullish_fvg()
    is_breakaway = low > breakaway_upper[2]
    should_create = (is_breakaway and filter_allows_breakaway) or (not is_breakaway and filter_allows_standard)
    if should_create
        gap_data = GapData.new(bar_index - 2, low, high[2], true, false, bar_index, next_gap_id, GAP_TYPE_FVG, is_breakaway)
        array.push(active_gaps, gap_data)
        next_gap_id += 1

if enable_fair_value_gaps and barstate.isconfirmed and is_bearish_fvg()
    is_breakaway = high < breakaway_lower[2]
    should_create = (is_breakaway and filter_allows_breakaway) or (not is_breakaway and filter_allows_standard)
    if should_create
        gap_data = GapData.new(bar_index - 2, low[2], high, false, false, bar_index, next_gap_id, GAP_TYPE_FVG, is_breakaway)
        array.push(active_gaps, gap_data)
        next_gap_id += 1

// Track new Implied FVGs with correct anchoring (3-candle structure: anchor from C1)
if enable_implied and barstate.isconfirmed
    [is_valid_ifvg, ifvg_bottom, ifvg_top, is_ifvg_bullish] = detect_implied_fvg()
    if is_valid_ifvg
        ifvg_data = GapData.new(bar_index - 2, ifvg_top, ifvg_bottom, is_ifvg_bullish, false, bar_index, next_gap_id, GAP_TYPE_IMPLIED, false)
        array.push(active_gaps, ifvg_data)
        next_gap_id += 1

// Track Volume Imbalances with correct anchoring (2-candle structure: anchor from C1)
if enable_volume_imbalance and barstate.isconfirmed
    // Check for bullish VI
    if is_bullish_vi()
        [vi_top, vi_bottom] = get_vi_coordinates(true)

        // Keep targeted VI suppression for institutional gap hierarchy
        if not is_vi_suppressed_by_gaps(vi_top, vi_bottom, true)
            vi_data = GapData.new(bar_index - 1, vi_top, vi_bottom, true, false, bar_index, next_gap_id, GAP_TYPE_VOLUME, false)
            array.push(active_gaps, vi_data)
            next_gap_id += 1

    // Check for bearish VI
    if is_bearish_vi()
        [vi_top, vi_bottom] = get_vi_coordinates(false)

        // Keep targeted VI suppression for institutional gap hierarchy
        if not is_vi_suppressed_by_gaps(vi_top, vi_bottom, false)
            vi_data = GapData.new(bar_index - 1, vi_top, vi_bottom, false, false, bar_index, next_gap_id, GAP_TYPE_VOLUME, false)
            array.push(active_gaps, vi_data)
            next_gap_id += 1

// Track True Gaps with correct anchoring (3-candle structure: anchor from C1)
if enable_true_gaps and barstate.isconfirmed
    [is_valid_tg, tg_bottom, tg_top, is_tg_bullish] = detect_true_gap()
    if is_valid_tg
        // Apply suppression logic to prevent overlap with other gap types
        if not is_true_gap_suppressed_by_gaps(tg_top, tg_bottom, is_tg_bullish)
            tg_data = GapData.new(bar_index - 2, tg_top, tg_bottom, is_tg_bullish, false, bar_index, next_gap_id, GAP_TYPE_TRUE, false)
            array.push(active_gaps, tg_data)
            next_gap_id += 1

// Track RDRB gaps with correct anchoring (3-candle structure: anchor from C1)
if enable_rdrb and barstate.isconfirmed
    [is_valid_rdrb, rdrb_bottom, rdrb_top, is_rdrb_bullish] = detect_rdrb_gap()
    if is_valid_rdrb
        rdrb_data = GapData.new(bar_index - 2, rdrb_top, rdrb_bottom, is_rdrb_bullish, false, bar_index, next_gap_id, GAP_TYPE_RDRB, false)
        array.push(active_gaps, rdrb_data)
        next_gap_id += 1

// Clean up old gaps
while array.size(active_gaps) > max_active_gaps_effective
    array.shift(active_gaps)

// Clean up old records and visual elements
while array.size(all_mbz_records) > max_mbz_records_effective
    array.shift(all_mbz_records)

while array.size(mbz_body_highlights) > max_body_highlights_effective
    box.delete(array.shift(mbz_body_highlights))

while array.size(mbz_wick_highlights) > max_wick_highlights_effective
    box.delete(array.shift(mbz_wick_highlights))

while array.size(mbz_extended_boxes) > max_extended_boxes_effective
    box.delete(array.shift(mbz_extended_boxes))

while array.size(mbz_projection_lines) > MAX_PROJECTION_LINES
    line.delete(array.shift(mbz_projection_lines))

while array.size(mbz_projection_labels) > MAX_PROJECTION_LABELS
    label.delete(array.shift(mbz_projection_labels))

// OPTIMIZED v4.11: Skip processing when no records exist
if array.size(all_mbz_records) > 0
    for i = array.size(all_mbz_records) - 1 to 0
        mbz_record = array.get(all_mbz_records, i)

        if not mbz_record.is_invalidated
            // Update confirmation status first
            updated_mbz = check_mbz_confirmation(mbz_record)
            // Check for invalidation using enhanced gap detection
            should_invalidate = should_mbz_be_invalidated_enhanced(updated_mbz, open, close)
            if should_invalidate
                updated_mbz.is_invalidated := true
                updated_mbz.cached_data_valid := false  // Invalidate cache
                needs_visual_update := true
                // if barstate.islast
                //     [zone_top, zone_bottom] = get_mbz_subtype_zone(updated_mbz)
                //     gap_invalidation = updated_mbz.is_bullish ? (open < zone_bottom) : (open > zone_top)
                //     invalidation_type = gap_invalidation ? "GAP" : "CLOSE"
                //     log.info("MBZ " + str.tostring(updated_mbz.bar_index) + " invalidated by " + invalidation_type +
                //              " - Open:" + str.tostring(open) + " Close:" + str.tostring(close) +
                //              " Zone:" + str.tostring(zone_top) + "-" + str.tostring(zone_bottom))
            array.set(all_mbz_records, i, updated_mbz)

// Process gaps for MBZ detection with unified gap source support
if array.size(active_gaps) > 0 and barstate.isconfirmed
    for i = array.size(active_gaps) - 1 to 0
        gap = array.get(active_gaps, i)

        if not gap.is_closed_through
            // Timing validation - consistent 1+ bar gap required for ALL gap types
            bars_since_gap_creation = bar_index - gap.creation_bar
            if bars_since_gap_creation < MIN_BARS_SINCE_GAP_CREATION
                continue

            prev_index = bar_index - 1
            if prev_index <= gap.creation_bar
                continue

            // Check gap closure
            if gap.is_bullish
                if open <= gap.bottom or close <= gap.bottom
                    gap.is_closed_through := true
            else
                if open >= gap.top or close >= gap.top
                    gap.is_closed_through := true

            // Check for MBZ formation if gap still active
            if not gap.is_closed_through
                // Current and previous candle data
                current_body_top = math.max(open, close)
                current_body_bottom = math.min(open, close)
                is_current_bullish = close > open
                is_current_bearish = close < open

                prev_body_top = math.max(open[1], close[1])
                prev_body_bottom = math.min(open[1], close[1])
                is_prev_bullish = close[1] > open[1]
                is_prev_bearish = close[1] < open[1]

                // Check if previous candle tapped gap
                prev_tapped_gap = false
                if gap.is_bullish and is_prev_bearish
                    if low[1] <= gap.top and high[1] >= gap.bottom
                        prev_tapped_gap := true
                else if not gap.is_bullish and is_prev_bullish
                    if high[1] >= gap.bottom and low[1] <= gap.top
                        prev_tapped_gap := true

                // Check for MBZ formation with enhanced 50% detection
                if prev_tapped_gap
                    prev_50_percent = (prev_body_top + prev_body_bottom) / 2
                    mbz_formed = false
                    is_exactly_50_percent = false

                    if gap.is_bullish and is_prev_bearish and is_current_bullish
                        // Check exactly 50% first
                        if close == prev_50_percent
                            is_exactly_50_percent := true
                            mbz_formed := true  // Detect at 50% and above
                        else if close >= prev_50_percent
                            mbz_formed := true  // Detect at 50% and above
                    else if not gap.is_bullish and is_prev_bullish and is_current_bearish
                        // Check exactly 50% first
                        if close == prev_50_percent
                            is_exactly_50_percent := true
                            mbz_formed := true  // Detect at 50% and above
                        else if close <= prev_50_percent
                            mbz_formed := true  // Detect at 50% and above

                    if mbz_formed
                        // Advanced MBZ subtype detection with Volume Imbalance support
                        [mbz_subtype, has_dom_wick] = detect_mbz_subtype(open, close, high, low, gap.gap_type)

                        // Check if MBZ wick penetrated deeper (gap-side and pattern-side)
                        [gap_deeper, pattern_deeper] = check_deeper_wick_penetration(high, low, open, close, gap.is_bullish, mbz_subtype, high[1], low[1], gap.gap_id)

                        temporary_mbz_record = MBZRecord.new(
                             bar_index, time, high, low, open, close,
                             gap.is_bullish, false, 0.0,
                             has_dom_wick, is_exactly_50_percent, mbz_subtype,
                             "", "", 0.0, 0.0, false,
                             label(na),
                             gap.gap_id, gap.bar_index, gap.top, gap.bottom, gap.gap_type,
                             gap_deeper, pattern_deeper,
                             false, 0.0, int(na),
                             gap.is_breakaway_gap
                         )

                        // Detect SUPER MBZ strength
                        [is_super, overlap_pct, overlapped_bar] = detect_mbz_strength(temporary_mbz_record)

                        mbz_record = MBZRecord.new(
                             bar_index, time, high, low, open, close,
                             gap.is_bullish, false, 0.0,
                             has_dom_wick, is_exactly_50_percent, mbz_subtype,
                             "", "", 0.0, 0.0, false,
                             label(na),
                             gap.gap_id, gap.bar_index, gap.top, gap.bottom, gap.gap_type,
                             gap_deeper, pattern_deeper,
                             is_super, overlap_pct, overlapped_bar,
                             gap.is_breakaway_gap
                         )

                        // Cache data immediately for performance (with corrected zones)
                        mbz_record := cache_mbz_data(mbz_record)
                        array.push(all_mbz_records, mbz_record)
                        needs_visual_update := true

                        // Baseline MBZ formation flags for alerts (merged from duplicate scan)
                        if gap.is_bullish
                            mbz_bullish_formed := true
                        else
                            mbz_bearish_formed := true

                        // Multi-source MBZ alert detection: set flags when >=2 MBZs form on same bar and direction
                        same_bar_same_direction_count = 0
                        for record_index = 0 to array.size(all_mbz_records) - 1
                            existing_mbz_record = array.get(all_mbz_records, record_index)
                            if existing_mbz_record.bar_index == mbz_record.bar_index and existing_mbz_record.is_bullish == mbz_record.is_bullish
                                same_bar_same_direction_count += 1

                        if same_bar_same_direction_count >= MIN_MULTI_SOURCE_ALERT_COUNT
                            same_bar_mbzs = array.new<MBZRecord>()
                            for record_index = 0 to array.size(all_mbz_records) - 1
                                grouped_mbz = array.get(all_mbz_records, record_index)
                                if grouped_mbz.bar_index == mbz_record.bar_index and grouped_mbz.is_bullish == mbz_record.is_bullish
                                    array.push(same_bar_mbzs, grouped_mbz)

                            stats_for_alerts = get_source_type_stats(same_bar_mbzs)
                            is_strong_multi_source = is_multi_source_strong(stats_for_alerts)

                            if is_strong_multi_source
                                if mbz_record.is_bullish
                                    strong_mbz_bullish_formed := true
                                    multi_source_mbz_bullish_formed := true
                                else
                                    strong_mbz_bearish_formed := true
                                    multi_source_mbz_bearish_formed := true
                            else
                                if mbz_record.is_bullish
                                    multi_source_mbz_bullish_formed := true
                                else
                                    multi_source_mbz_bearish_formed := true

                        // Nested MBZ detection: Check for overlapping MBZs in same direction
                        for overlap_check = 0 to array.size(all_mbz_records) - 1
                            if overlap_check != array.size(all_mbz_records) - 1  // Skip the newly added record itself
                                overlap_mbz = array.get(all_mbz_records, overlap_check)
                                if overlap_mbz.is_bullish == mbz_record.is_bullish
                                    mbz_top = math.max(mbz_record.mbz_open, mbz_record.mbz_close)
                                    mbz_bottom = math.min(mbz_record.mbz_open, mbz_record.mbz_close)
                                    overlap_top = math.max(overlap_mbz.mbz_open, overlap_mbz.mbz_close)
                                    overlap_bottom = math.min(overlap_mbz.mbz_open, overlap_mbz.mbz_close)

                                    // Check for overlap (nested zones)
                                    if mbz_bottom <= overlap_top and mbz_top >= overlap_bottom
                                        if mbz_record.is_bullish
                                            nested_mbz_bullish_formed := true
                                        else
                                            nested_mbz_bearish_formed := true

                        // Deeper Wick MBZ detection: Check if MBZ has deeper wick properties
                        if mbz_record.wicked_into_source_gap or mbz_record.reflection_pattern_deeper
                            if mbz_record.is_bullish
                                deeper_wick_mbz_bullish_formed := true
                            else
                                deeper_wick_mbz_bearish_formed := true

// ═══════════════════════════════════════════════════════════════════════════════
// VISUAL MANAGEMENT - CONSOLIDATED SYSTEM // ═══════════════════════════════════════════════════════════════════════════════

// PERFORMANCE OPTIMIZED: Smart visual update system - only when truly necessary
// Only update on explicit need, last/last-confirmed bars (avoid per-bar historical rebuilds)
should_update_visuals = needs_full_update or needs_visual_update or barstate.islastconfirmedhistory or (barstate.islast and bar_index != last_update_bar)

if should_update_visuals
    manage_consolidated_mbz_display()

    last_update_bar := bar_index
    needs_full_update := false
    needs_visual_update := false


// Wick dominance stars - Reuse consolidated groups; update only on visual updates
if enable_wick_dominance_markers and should_update_visuals
    for existing_star_element in star_labels
        label.delete(existing_star_element)
    array.clear(star_labels)

    // Use last_consolidated_mbzs built during visual render to avoid re-grouping
    if array.size(last_consolidated_mbzs) > 0
        for consolidated_index = 0 to array.size(last_consolidated_mbzs) - 1
            current_consolidated_mbz_for_star = array.get(last_consolidated_mbzs, consolidated_index)

            // Check each MBZ in the group for dominant wicks
            for mbz_in_group_index = 0 to array.size(current_consolidated_mbz_for_star.mbz_group) - 1
                individual_mbz_for_star = array.get(current_consolidated_mbz_for_star.mbz_group, mbz_in_group_index)

                mbz_body_top_price = math.max(individual_mbz_for_star.mbz_open, individual_mbz_for_star.mbz_close)
                mbz_body_bottom_price = math.min(individual_mbz_for_star.mbz_open, individual_mbz_for_star.mbz_close)
                mbz_body_size_range = mbz_body_top_price - mbz_body_bottom_price
                mbz_upper_wick_size = individual_mbz_for_star.high_price - mbz_body_top_price
                mbz_lower_wick_size = mbz_body_bottom_price - individual_mbz_for_star.low_price

                [wick_dominance_tier, has_significant_wick_dominance] = classify_wick_dominance(mbz_body_size_range, mbz_upper_wick_size, mbz_lower_wick_size)

                if has_significant_wick_dominance
                    wick_tier_star_color = switch wick_dominance_tier
                        WICK_TIER_STANDARD => standard_star_color
                        WICK_TIER_RELAXED => relaxed_star_color
                        WICK_TIER_RISKY => risky_star_color
                        => standard_star_color

                    wick_strength_description = switch wick_dominance_tier
                        WICK_TIER_STANDARD => "Standard (≥100%)"
                        WICK_TIER_RELAXED => "Relaxed (85-99%)"
                        WICK_TIER_RISKY => "Risky (80-84%)"
                        => WICK_TIER_STANDARD_DISPLAY

                    is_mbz_candle_bullish = individual_mbz_for_star.mbz_close > individual_mbz_for_star.mbz_open
                    star_y_position = is_mbz_candle_bullish ? individual_mbz_for_star.low_price : individual_mbz_for_star.high_price
                    star_y_location = is_mbz_candle_bullish ? yloc.abovebar : yloc.belowbar

                    star_label_size = current_consolidated_mbz_for_star.is_consolidated_invalidated ? get_invalidated_mbz_size() : get_wick_star_size()
                    star_label_color = current_consolidated_mbz_for_star.is_consolidated_invalidated ? mbz_invalidated_color : wick_tier_star_color

                    wick_dominance_star_label = label.new(
                         x=individual_mbz_for_star.bar_index,
                         y=star_y_position,
                         text="★",
                         style=label.style_none,
                         textcolor=star_label_color,
                         size=star_label_size,
                         yloc=star_y_location,
                         tooltip="Dominant Wick MBZ (" + wick_strength_description + ")"
                     )

                    array.push(star_labels, wick_dominance_star_label)

// ═══════════════════════════════════════════════════════════════════════════════
// ENHANCED ALERTS - flags set in main detection (duplicate scan removed)

// Individual alertconditions
// - Always available by Pine design; attach alerts per condition if desired.
// - Minimal UX: title = condition name, message = timeframe only.
alertcondition(mbz_bullish_formed, title=MBZ_PLUS, message='{{interval}}')
alertcondition(mbz_bearish_formed, title=MBZ_MINUS, message='{{interval}}')
alertcondition(multi_source_mbz_bullish_formed, title=ALERT_TITLE_MULTI_SOURCE_MBZ_PLUS, message='{{interval}}')
alertcondition(multi_source_mbz_bearish_formed, title=ALERT_TITLE_MULTI_SOURCE_MBZ_MINUS, message='{{interval}}')
alertcondition(strong_mbz_bullish_formed, title=ALERT_TITLE_STRONG_MBZ_PLUS, message='{{interval}}')
alertcondition(strong_mbz_bearish_formed, title=ALERT_TITLE_STRONG_MBZ_MINUS, message='{{interval}}')
alertcondition(nested_mbz_bullish_formed, title=ALERT_TITLE_NESTED_MBZ_PLUS, message='{{interval}}')
alertcondition(nested_mbz_bearish_formed, title=ALERT_TITLE_NESTED_MBZ_MINUS, message='{{interval}}')
alertcondition(deeper_wick_mbz_bullish_formed, title=ALERT_TITLE_DEEPER_WICK_MBZ_PLUS, message='{{interval}}')
alertcondition(deeper_wick_mbz_bearish_formed, title=ALERT_TITLE_DEEPER_WICK_MBZ_MINUS, message='{{interval}}')

// Grouped alert system logic
// - Builds a single, clean message per bar if any enabled conditions occur.
// - Uses specials-priority lead and +N counting (see header docs) for clarity.
if alert_mode == ALERT_MODE_GROUPED or alert_mode == ALERT_MODE_BOTH
    // Reset grouped alert state
    mbz_grouped_alert_active := false
    array.clear(mbz_alert_parts)

    // Check each enabled condition
    if enable_mbz_plus_formation and mbz_bullish_formed
        array.push(mbz_alert_parts, ALERT_MSG_MBZ_PLUS_FORMED)
        mbz_grouped_alert_active := true
    if enable_mbz_minus_formation and mbz_bearish_formed
        array.push(mbz_alert_parts, ALERT_MSG_MBZ_MINUS_FORMED)
        mbz_grouped_alert_active := true
    strong_plus_active = enable_strong_mbz_plus and strong_mbz_bullish_formed
    strong_minus_active = enable_strong_mbz_minus and strong_mbz_bearish_formed

    if strong_plus_active
        array.push(mbz_alert_parts, ALERT_MSG_STRONG_MBZ_PLUS)
        mbz_grouped_alert_active := true
    if strong_minus_active
        array.push(mbz_alert_parts, ALERT_MSG_STRONG_MBZ_MINUS)
        mbz_grouped_alert_active := true
    if enable_multi_source_mbz_plus and multi_source_mbz_bullish_formed and not strong_plus_active
        array.push(mbz_alert_parts, ALERT_MSG_MULTI_SOURCE_MBZ_PLUS)
        mbz_grouped_alert_active := true
    if enable_multi_source_mbz_minus and multi_source_mbz_bearish_formed and not strong_minus_active
        array.push(mbz_alert_parts, ALERT_MSG_MULTI_SOURCE_MBZ_MINUS)
        mbz_grouped_alert_active := true
    if enable_nested_mbz_plus_alert and nested_mbz_bullish_formed
        array.push(mbz_alert_parts, ALERT_MSG_NESTED_MBZ_PLUS)
        mbz_grouped_alert_active := true
    if enable_nested_mbz_minus_alert and nested_mbz_bearish_formed
        array.push(mbz_alert_parts, ALERT_MSG_NESTED_MBZ_MINUS)
        mbz_grouped_alert_active := true
    if enable_deeper_wick_mbz_plus_alert and deeper_wick_mbz_bullish_formed
        array.push(mbz_alert_parts, ALERT_MSG_DEEPER_WICK_MBZ_PLUS)
        mbz_grouped_alert_active := true
    if enable_deeper_wick_mbz_minus_alert and deeper_wick_mbz_bearish_formed
        array.push(mbz_alert_parts, ALERT_MSG_DEEPER_WICK_MBZ_MINUS)
        mbz_grouped_alert_active := true

    // Fire grouped alert if any condition met
    if mbz_grouped_alert_active
        // Select a lead by priority: Strong > Deeper Wick > Multi-Source > Nested > Baseline MBZ
        lead_text = ""
        if array.includes(mbz_alert_parts, ALERT_MSG_STRONG_MBZ_PLUS)
            lead_text := ALERT_MSG_STRONG_MBZ_PLUS
        else if array.includes(mbz_alert_parts, ALERT_MSG_STRONG_MBZ_MINUS)
            lead_text := ALERT_MSG_STRONG_MBZ_MINUS
        else if array.includes(mbz_alert_parts, ALERT_MSG_DEEPER_WICK_MBZ_PLUS)
            lead_text := ALERT_MSG_DEEPER_WICK_MBZ_PLUS
        else if array.includes(mbz_alert_parts, ALERT_MSG_DEEPER_WICK_MBZ_MINUS)
            lead_text := ALERT_MSG_DEEPER_WICK_MBZ_MINUS
        // Then Multi-Source
        else if array.includes(mbz_alert_parts, ALERT_MSG_MULTI_SOURCE_MBZ_PLUS)
            lead_text := ALERT_MSG_MULTI_SOURCE_MBZ_PLUS
        else if array.includes(mbz_alert_parts, ALERT_MSG_MULTI_SOURCE_MBZ_MINUS)
            lead_text := ALERT_MSG_MULTI_SOURCE_MBZ_MINUS
        // Then Nested
        else if array.includes(mbz_alert_parts, ALERT_MSG_NESTED_MBZ_PLUS)
            lead_text := ALERT_MSG_NESTED_MBZ_PLUS
        else if array.includes(mbz_alert_parts, ALERT_MSG_NESTED_MBZ_MINUS)
            lead_text := ALERT_MSG_NESTED_MBZ_MINUS
        // Fallback to baseline MBZ
        else if array.includes(mbz_alert_parts, ALERT_MSG_MBZ_PLUS_FORMED)
            lead_text := ALERT_MSG_MBZ_PLUS_FORMED
        else if array.includes(mbz_alert_parts, ALERT_MSG_MBZ_MINUS_FORMED)
            lead_text := ALERT_MSG_MBZ_MINUS_FORMED

        // Count specials only (ignore baseline MBZ)
        has_strong_special = array.includes(mbz_alert_parts, ALERT_MSG_STRONG_MBZ_PLUS) or array.includes(mbz_alert_parts, ALERT_MSG_STRONG_MBZ_MINUS)
        has_deeper_wick_special = array.includes(mbz_alert_parts, ALERT_MSG_DEEPER_WICK_MBZ_PLUS) or array.includes(mbz_alert_parts, ALERT_MSG_DEEPER_WICK_MBZ_MINUS)
        has_multi_source_special = array.includes(mbz_alert_parts, ALERT_MSG_MULTI_SOURCE_MBZ_PLUS) or array.includes(mbz_alert_parts, ALERT_MSG_MULTI_SOURCE_MBZ_MINUS)
        has_nested_special = array.includes(mbz_alert_parts, ALERT_MSG_NESTED_MBZ_PLUS) or array.includes(mbz_alert_parts, ALERT_MSG_NESTED_MBZ_MINUS)
        specials_count = (has_strong_special ? 1 : 0) + (has_deeper_wick_special ? 1 : 0) + (has_multi_source_special ? 1 : 0) + (has_nested_special ? 1 : 0)

        // Determine if lead is a special
        lead_is_special = (lead_text == ALERT_MSG_STRONG_MBZ_PLUS) or (lead_text == ALERT_MSG_STRONG_MBZ_MINUS) or (lead_text == ALERT_MSG_DEEPER_WICK_MBZ_PLUS) or (lead_text == ALERT_MSG_DEEPER_WICK_MBZ_MINUS) or (lead_text == ALERT_MSG_MULTI_SOURCE_MBZ_PLUS) or (lead_text == ALERT_MSG_MULTI_SOURCE_MBZ_MINUS) or (lead_text == ALERT_MSG_NESTED_MBZ_PLUS) or (lead_text == ALERT_MSG_NESTED_MBZ_MINUS)

        extra = lead_is_special ? math.max(0, specials_count - 1) : specials_count
        plus_n = extra > 0 ? (" +" + str.tostring(extra)) : ""
        tf = str.tostring(timeframe.period)
        // Message: "<lead> +N • timeframe" (no prefix/price/commas/dashes)
        alert(ALERT_PREFIX_GROUPED + lead_text + plus_n + " • " + tf)

// MBZ Core° [Pro+] Optimised (now Core)
