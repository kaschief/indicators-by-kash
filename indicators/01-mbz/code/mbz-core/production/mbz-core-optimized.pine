// Alert title constants
ALERT_TITLE_MULTI_SOURCE_MBZ_PLUS = "Multi-Source MBZ⁺"
ALERT_TITLE_MULTI_SOURCE_MBZ_MINUS = "Multi-Source MBZ⁻"
ALERT_TITLE_STRONG_MBZ_PLUS = "Strong MBZ⁺"
ALERT_TITLE_STRONG_MBZ_MINUS = "Strong MBZ⁻"
ALERT_TITLE_NESTED_MBZ_PLUS = "Nested MBZ⁺"
ALERT_TITLE_NESTED_MBZ_MINUS = "Nested MBZ⁻"
ALERT_TITLE_DEEPER_WICK_MBZ_PLUS = "Deeper Wick MBZ⁺"
ALERT_TITLE_DEEPER_WICK_MBZ_MINUS = "Deeper Wick MBZ⁻"

