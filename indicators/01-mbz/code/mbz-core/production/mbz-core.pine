    table.cell(color_table, 2, 6, str.format("R:{0} G:{1} B:{2}", int(color.r(extended_box_bearish_color)), int(color.g(extended_box_bearish_color)), int(color.b(extended_box_bearish_color))), text_size=size.small, text_color=color.white)
