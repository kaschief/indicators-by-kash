    table.cell(color_table, 1, 11, "434", text_size=size.small, text_color=color.yellow)
    table.cell(color_table, 2, 11, str.format("R:{0} G:{1} B:{2}", int(color.r(breakaway_bearish_border_color)), int(color.g(breakaway_bearish_border_color)), int(color.b(breakaway_bearish_border_color))), text_size=size.small, text_color=color.white)
