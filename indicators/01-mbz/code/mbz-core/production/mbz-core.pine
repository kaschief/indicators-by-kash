const color DEFAULT_EXTENDED_BOX_BEARISH_COLOR = color.new(color.rgb(249, 121, 246), 94)
const color DEFAULT_EXTENDED_BOX_TEXT_COLOR = color.new(color.rgb(99, 99, 99), 0)
const color DEFAULT_BREAKAWAY_BULLISH_COLOR = color.new(color.rgb(91, 156, 246), 60)
const color DEFAULT_BREAKAWAY_BEARISH_COLOR = color.new(color.rgb(247, 11, 241), 80)
