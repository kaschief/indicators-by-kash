    table.cell(color_table, 2, 4, str.format("R:{0} G:{1} B:{2}", int(color.r(mbz_bearish_color)), int(color.g(mbz_bearish_color)), int(color.b(mbz_bearish_color))), text_size=size.small, text_color=color.white)
    table.cell(color_table, 3, 4, str.tostring(int(color.t(mbz_bearish_color))), text_size=size.small, text_color=color.white)

