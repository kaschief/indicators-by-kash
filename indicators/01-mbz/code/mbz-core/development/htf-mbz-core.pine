                   tooltip="Include reference candle wick in zone boundary:\n• Bullish: Lower boundary extends to reference candle low\n• Bearish: Upper boundary extends to reference candle high\n• Creates larger zones that are harder to invalidate")

// ─── 📋 Reference ───
GROUP_REF        = "📋 Reference"
