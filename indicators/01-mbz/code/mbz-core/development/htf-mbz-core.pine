//@version=6

// ═══════════════════════════════════════════════════════════════════════════════
// HTF MBZ CORE - Development
// ═══════════════════════════════════════════════════════════════════════════════
// Multi-timeframe MBZ detection with automatic timeframe pairing:
//   1m  chart → 15m HTF
//   5m  chart → 1H  HTF
//   15m chart → 4H  HTF
//   1H  chart → D   HTF
// ═══════════════════════════════════════════════════════════════════════════════

indicator("htf mbz core • development", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

// MBZ Zone Colors (from MBZ-Core production)
const color MBZ_BULLISH_COLOR = color.rgb(77, 208, 225)   // Cyan/teal
const color MBZ_BEARISH_COLOR = color.rgb(249, 121, 246) // Pink/magenta
const int   MBZ_FILL_TRANSPARENCY = 97

// Drawing budget
const int DRAW_LIMIT = 500
const int DRAW_BUFFER = 20  // Reserve for test zones, warnings, etc.

// Gap type constants (from MBZ-Core)
const string GAP_TYPE_FVG     = "fvg"
const string GAP_TYPE_IMPLIED = "implied"

// Status display constants (from MBZ-Core)
const string STATUS_DISPLAY_ALL = "all"
const string STATUS_DISPLAY_FVG = "fvg"
const string STATUS_DISPLAY_IMP = "imp"
const string STATUS_DISPLAY_REF_WICK = "⁺ʷ"

// MBZ subtype constants (from MBZ-Core)
const string SUBTYPE_STANDARD   = "standard"
const string SUBTYPE_INCLUSION  = "inclusion"
const string SUBTYPE_REFLECTION = "reflection"

// MBZ label constants (from MBZ-Core)
const string MBZ_BASE_TEXT     = "MBZ"
const string MBZ_BULLISH_SUFFIX = "⁺"
const string MBZ_BEARISH_SUFFIX = "⁻"

// Wick dominance threshold (from MBZ-Core: wick must be >= 80% of body)
const float WICK_DOMINANCE_THRESHOLD = 0.80

// Implied FVG detection parameters (from MBZ-Core)
const float  IMPLIED_DISPLACEMENT_MULTIPLIER = 1.25
const int    IMPLIED_DISPLACEMENT_LOOKBACK   = 4

// ═══════════════════════════════════════════════════════════════════════════════
// TIMEFRAME CONFIGURATION
// ═══════════════════════════════════════════════════════════════════════════════
// Centralized pairing definition - strict 1:1 LTF→HTF mapping
// Returns: [is_valid, htf_string, htf_label, htf_ms, ltf_label]
//
// SUPPORTED PAIRINGS:
//   LTF    →  HTF     Label   HTF_MS       Candles/HTF
//   1m     →  15m     "15m"   900000       15
//   5m     →  1H      "1H"    3600000      12
//   15m    →  4H      "4H"    14400000     16
//   1H     →  D       "D"     86400000     24
//
// To add a new pairing: add one case to the switch below
// ═══════════════════════════════════════════════════════════════════════════════

get_tf_pairing(string chart_tf) =>
    switch chart_tf
        "1"  => [true, "15",  "15m", 900000,   "1m"]     // 1m  → 15m
        "5"  => [true, "60",  "1H",  3600000,  "5m"]     // 5m  → 1H
        "15" => [true, "240", "4H",  14400000, "15m"]    // 15m → 4H
        "60" => [true, "D",   "D",   86400000, "1h"]     // 1H  → D
        =>      [false, "",   "",    0,        ""]       // Unsupported

string CHART_TF = timeframe.period
[IS_VALID, HTF_STRING, HTF_LABEL, HTF_MS, LTF_LABEL] = get_tf_pairing(CHART_TF)

