const string DIR_BULLISH = "MBZ⁺ Only"
const string DIR_BEARISH = "MBZ⁻ Only"

// Gap source options
const string GAP_DROPDOWN_ALL     = "All"
const string GAP_DROPDOWN_FVG     = "Fair Value Gap (FVG)"
const string GAP_DROPDOWN_IMPLIED = "Implied FVG"

// Gap display options
const string GAP_DISPLAY_OFF     = "Off"
const string GAP_DISPLAY_MBZ     = "Gaps that led to an MBZ"
const string GAP_DISPLAY_ALL     = "All gaps"

// Gap color (matches MBZ-Core exactly)
const color GAP_COLOR = color.new(color.rgb(187, 217, 251), 90)

// ─── 🔍 Detection ───
GROUP_DETECTION  = "🔍 Detection"
i_max_candles    = input.int(200, "HTF Candles", minval=5, maxval=200, group=GROUP_DETECTION,
                   tooltip="Max 200. Recommended by pairing:\n• 1m→15m: 50 (~12 hours)\n• 5m→1H: 75 (~3 days)\n• 15m→4H: 50 (~8 days)\n• 1H→D: 20 (~4 weeks)")
i_gap_type       = input.string(GAP_DROPDOWN_ALL, "Gap Source", options=[GAP_DROPDOWN_ALL, GAP_DROPDOWN_FVG, GAP_DROPDOWN_IMPLIED], group=GROUP_DETECTION,
                   tooltip="All: Detect both gap types\nFVG: Standard 3-candle gap\nImplied FVG: Bodies separate, wicks overlap")
i_direction      = input.string(DIR_BOTH, "Direction Filter", options=[DIR_BOTH, DIR_BULLISH, DIR_BEARISH], group=GROUP_DETECTION,
                   tooltip="Filter MBZ display by direction")

// ─── 📊 HTF Candle Overlay ───
GROUP_CANDLES    = "📊 HTF Candle Overlay"
i_show_candles   = input.bool(false, "Show HTF Candles", group=GROUP_CANDLES)
i_bull_body      = input.color(color.new(color.rgb(165, 214, 167), 74), "Bullish Body", group=GROUP_CANDLES, inline="bull")
i_bull_wick      = input.color(color.new(color.rgb(165, 214, 167), 85), "Wick", group=GROUP_CANDLES, inline="bull")
i_bear_body      = input.color(color.new(color.rgb(244, 143, 177), 74), "Bearish Body", group=GROUP_CANDLES, inline="bear")
i_bear_wick      = input.color(color.new(color.rgb(252, 203, 205), 80), "Wick", group=GROUP_CANDLES, inline="bear")

// ─── 🎯 HTF Gap Display ───
GROUP_FVG        = "🎯 HTF Gap Display"
i_gap_display    = input.string(GAP_DISPLAY_MBZ, "Show Gaps", options=[GAP_DISPLAY_OFF, GAP_DISPLAY_MBZ, GAP_DISPLAY_ALL], group=GROUP_FVG,
                   tooltip="Off: No gaps shown\nMBZ Gaps: Only gaps that formed an MBZ\nAll: All detected gaps")

