//@version=6
indicator('RDRB Detector - Valid & Invalidated', overlay=true, max_boxes_count=150)

// ═══════════════════════════════════════════════════════════════════════════════
// RDRB DETECTION SETTINGS
// ═══════════════════════════════════════════════════════════════════════════════

show_bullish_rdrb = input.bool(true, 'Show Bullish RDRB', group='Detection')
show_bearish_rdrb = input.bool(true, 'Show Bearish RDRB', group='Detection')
show_invalidated = input.bool(true, 'Show Invalidated RDRB', group='Detection')
debug_logging = input.bool(false, 'Enable Debug Logging', group='Detection')
max_boxes = input.int(75, 'Max RDRB Boxes', minval=20, maxval=150, group='Detection')

// ═══════════════════════════════════════════════════════════════════════════════
// VISUAL SETTINGS
// ═══════════════════════════════════════════════════════════════════════════════

valid_bullish_color = input.color(color.new(color.green, 70), 'Valid Bullish Color', group='Valid RDRB')
valid_bearish_color = input.color(color.new(color.red, 70), 'Valid Bearish Color', group='Valid RDRB')
invalidated_bullish_color = input.color(color.new(color.orange, 85), 'Invalidated Bullish Color', group='Invalidated RDRB')
invalidated_bearish_color = input.color(color.new(color.purple, 85), 'Invalidated Bearish Color', group='Invalidated RDRB')
border_width = input.int(2, 'Border Width', minval=1, maxval=3, group='Visuals')
extend_right = input.int(25, 'Extend Right (bars)', minval=5, maxval=100, group='Visuals')

// ═══════════════════════════════════════════════════════════════════════════════
// RDRB TRACKING TYPE
// ═══════════════════════════════════════════════════════════════════════════════

type RDRBRecord
    int formation_bar
    float zone_top
    float zone_bottom
    bool is_bullish
    bool is_invalidated
    int invalidation_bar
    box display_box

// ═══════════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

get_body_top(candle_index) =>
    math.max(open[candle_index], close[candle_index])

get_body_bottom(candle_index) =>
    math.min(open[candle_index], close[candle_index])

// ═══════════════════════════════════════════════════════════════════════════════
// RDRB DETECTION LOGIC
// ═══════════════════════════════════════════════════════════════════════════════

detect_valid_rdrb() =>
    is_bullish_rdrb = false
    is_bearish_rdrb = false
    zone_top = 0.0
    zone_bottom = 0.0

    // ── Bullish RDRB formation (lenient): C3 must take C2 high; C3 body may overlap zone
    if show_bullish_rdrb
        c1_body_top = get_body_top(2)
        c1_upper_wick_exists = high[2] > c1_body_top
        c2_body_top = get_body_top(1)
        c2_body_bottom = get_body_bottom(1)
        // C2 body must be fully inside C1's upper wick
        c2_body_within_c1_wick = (c2_body_bottom >= c1_body_top) and (c2_body_top <= high[2])
        // Redeliver up: C3 takes out C2 high (no need to close above C1 high)
        c3_redelivers_higher = high > high[1]

        if c1_upper_wick_exists and c2_body_within_c1_wick and c3_redelivers_higher
            // Remaining zone rule: zone = C2 body minus C3 body overlap, limited to C1's upper wick, must remain a single contiguous segment
            c3_body_top = math.max(open, close)
            c3_body_bottom = math.min(open, close)

            // Overlap of C3 body with C2 body
            inter_bottom = math.max(c2_body_bottom, c3_body_bottom)
            inter_top = math.min(c2_body_top, c3_body_top)
            has_overlap = inter_bottom < inter_top

            // Anchor checks: overlap must be anchored to exactly one C2 edge; interior-only overlap is invalid; full cover is invalid
            eps = syminfo.mintick
            anchored_to_top = has_overlap and inter_top >= c2_body_top - eps
            anchored_to_bottom = has_overlap and inter_bottom <= c2_body_bottom + eps

            // Compute remaining single contiguous zone
            rem_bottom = c2_body_bottom
            rem_top = c2_body_top
            valid_remaining = true

            if has_overlap
                if anchored_to_top and not anchored_to_bottom
                    // Remaining is bottom segment
                    rem_bottom := c2_body_bottom
                    rem_top := inter_bottom
                else if anchored_to_bottom and not anchored_to_top
                    // Remaining is top segment
                    rem_bottom := inter_top
                    rem_top := c2_body_top
                else
                    // Either interior-only overlap (splits into two) or full cover (both anchors) => INVALID formation
                    valid_remaining := false

            // Intersect remaining with C1 upper wick range (strict)
            wick_low = c1_body_top
            wick_high = high[2]
            rem_bottom := math.max(rem_bottom, wick_low)
            rem_top := math.min(rem_top, wick_high)

            // Ensure remaining zone has positive width
            if valid_remaining and rem_top > rem_bottom + eps
                is_bullish_rdrb := true
                zone_top := rem_top
                zone_bottom := rem_bottom

    // ── Bearish RDRB formation (lenient): C3 must take C2 low; C3 body may overlap zone
    if show_bearish_rdrb
        c1_body_bottom = get_body_bottom(2)
        c1_lower_wick_exists = low[2] < c1_body_bottom
        c2_body_top = get_body_top(1)
        c2_body_bottom = get_body_bottom(1)
        // C2 body must be fully inside C1's lower wick
        c2_body_within_c1_wick = (c2_body_top <= c1_body_bottom) and (c2_body_bottom >= low[2])
        // Redeliver down: C3 takes out C2 low (no need to close below C1 low)
        c3_redelivers_lower = low < low[1]

        if c1_lower_wick_exists and c2_body_within_c1_wick and c3_redelivers_lower
            // Remaining zone rule: zone = C2 body minus C3 body overlap, limited to C1's lower wick, must remain a single contiguous segment
            c3_body_top = math.max(open, close)
            c3_body_bottom = math.min(open, close)

            // Overlap of C3 body with C2 body
            inter_bottom = math.max(c2_body_bottom, c3_body_bottom)
            inter_top = math.min(c2_body_top, c3_body_top)
            has_overlap = inter_bottom < inter_top

            // Anchor checks
            eps = syminfo.mintick
            anchored_to_top = has_overlap and inter_top >= c2_body_top - eps
            anchored_to_bottom = has_overlap and inter_bottom <= c2_body_bottom + eps

            // Compute remaining single contiguous zone
            rem_bottom = c2_body_bottom
            rem_top = c2_body_top
            valid_remaining = true

            if has_overlap
                if anchored_to_top and not anchored_to_bottom
                    // Remaining is bottom segment
                    rem_bottom := c2_body_bottom
                    rem_top := inter_bottom
                else if anchored_to_bottom and not anchored_to_top
                    // Remaining is top segment
                    rem_bottom := inter_top
                    rem_top := c2_body_top
                else
                    // Interior split or full cover => INVALID formation
                    valid_remaining := false

            // Intersect remaining with C1 lower wick range (strict)
            wick_low = low[2]
            wick_high = c1_body_bottom
            rem_bottom := math.max(rem_bottom, wick_low)
            rem_top := math.min(rem_top, wick_high)

            if valid_remaining and rem_top > rem_bottom + eps
                is_bearish_rdrb := true
                zone_top := rem_top
                zone_bottom := rem_bottom

    [is_bullish_rdrb, is_bearish_rdrb, zone_top, zone_bottom]

check_rdrb_invalidation(rdrb_record) =>
    // Check if candle body crosses through the RDRB zone (like SIF/MBZ)
    candle_body_top = math.max(open, close)
    candle_body_bottom = math.min(open, close)

    // Body crosses through zone if ranges overlap
    body_crosses_zone = candle_body_bottom <= rdrb_record.zone_top and candle_body_top >= rdrb_record.zone_bottom
    body_crosses_zone

// ═══════════════════════════════════════════════════════════════════════════════
// MAIN LOGIC
// ═══════════════════════════════════════════════════════════════════════════════

var array<RDRBRecord> rdrb_records = array.new<RDRBRecord>()

if barstate.isconfirmed
    [bullish_detected, bearish_detected, zone_top, zone_bottom] = detect_valid_rdrb()

    if bullish_detected or bearish_detected
        valid_color = bullish_detected ? valid_bullish_color : valid_bearish_color
        valid_border = bullish_detected ? color.green : color.red
        label_text = bullish_detected ? 'RDRB↑' : 'RDRB↓'

        new_box = box.new(bar_index - 2, zone_top, bar_index + extend_right, zone_bottom, bgcolor=valid_color, border_color=valid_border, border_width=border_width, text=label_text, text_color=valid_border, text_size=size.small)

        new_record = RDRBRecord.new(bar_index - 2, zone_top, zone_bottom, bullish_detected, false, na, new_box)
        array.push(rdrb_records, new_record)

        if debug_logging
            dbg_line1 = (bullish_detected ? "Bullish" : "Bearish") + " RDRB formed"
            dbg_line2 = "C1 idx: " + str.tostring(bar_index - 2)
            dbg_line3 = "Zone: [" + str.tostring(zone_bottom) + ", " + str.tostring(zone_top) + "]"
            dbg_txt = dbg_line1 + "\n" + dbg_line2 + "\n" + dbg_line3
            label.new(bar_index, zone_top, dbg_txt, yloc=yloc.price, color=color.new(color.white, 100), textcolor=color.gray, style=label.style_label_down, size=size.tiny)

    // Check existing RDRB records for invalidation
    if array.size(rdrb_records) > 0
        for i = 0 to array.size(rdrb_records) - 1
            rdrb_record = array.get(rdrb_records, i)

            if not rdrb_record.is_invalidated
                // Only check for invalidation AFTER the formation is complete
                // Formation completes at formation_bar + 2, so check from formation_bar + 3 onwards
                if bar_index > (rdrb_record.formation_bar + 2)
                    if check_rdrb_invalidation(rdrb_record)
                        rdrb_record.is_invalidated := true
                        rdrb_record.invalidation_bar := bar_index

                        if show_invalidated and not na(rdrb_record.display_box)
                            box.delete(rdrb_record.display_box)
                            invalidated_color = rdrb_record.is_bullish ? invalidated_bullish_color : invalidated_bearish_color
                            invalidated_border = rdrb_record.is_bullish ? color.orange : color.purple
                            invalidated_text = rdrb_record.is_bullish ? 'RDRB↑ [X]' : 'RDRB↓ [X]'

                            rdrb_record.display_box := box.new(rdrb_record.formation_bar, rdrb_record.zone_top, bar_index, rdrb_record.zone_bottom, bgcolor=invalidated_color, border_color=invalidated_border, border_width=1, text=invalidated_text, text_color=invalidated_border, text_size=size.tiny)
                            if debug_logging
                                dbg_line1 = (rdrb_record.is_bullish ? "Bullish" : "Bearish") + " RDRB invalidated"
                                dbg_line2 = "Formed at: " + str.tostring(rdrb_record.formation_bar)
                                dbg_line3 = "Invalidated at: " + str.tostring(bar_index)
                                dbg_txt = dbg_line1 + "\n" + dbg_line2 + "\n" + dbg_line3
                                label.new(bar_index, rdrb_record.zone_top, dbg_txt, yloc=yloc.price, color=color.new(color.white, 100), textcolor=invalidated_border, style=label.style_label_down, size=size.tiny)
                        else if not show_invalidated
                            box.delete(rdrb_record.display_box)
                            rdrb_record.display_box := na

            array.set(rdrb_records, i, rdrb_record)

while array.size(rdrb_records) > max_boxes
    old_record = array.shift(rdrb_records)
    if not na(old_record.display_box)
        box.delete(old_record.display_box)

// ═══════════════════════════════════════════════════════════════════════════════
// INFO TABLE
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.islast
    valid_count = 0
    invalidated_count = 0

    if array.size(rdrb_records) > 0
        for i = 0 to array.size(rdrb_records) - 1
            record = array.get(rdrb_records, i)
            if record.is_invalidated
                invalidated_count += 1
            else
                valid_count += 1

    info_table = table.new(position.top_right, columns=2, rows=5, bgcolor=color.new(color.white, 90), border_width=1)
    table.cell(info_table, column=0, row=0, text='RDRB Detector', text_color=color.black, text_size=size.small)
    table.cell(info_table, column=1, row=0, text='Complete', text_color=color.black, text_size=size.small)
    table.cell(info_table, column=0, row=1, text='Valid:', text_color=color.green, text_size=size.tiny)
    table.cell(info_table, column=1, row=1, text=str.tostring(valid_count), text_color=color.green, text_size=size.tiny)
    table.cell(info_table, column=0, row=2, text='Invalidated:', text_color=color.orange, text_size=size.tiny)
    table.cell(info_table, column=1, row=2, text=str.tostring(invalidated_count), text_color=color.orange, text_size=size.tiny)
    table.cell(info_table, column=0, row=3, text='Total:', text_color=color.black, text_size=size.tiny)
    table.cell(info_table, column=1, row=3, text=str.tostring(array.size(rdrb_records)), text_color=color.black, text_size=size.tiny)
    table.cell(info_table, column=0, row=4, text='Pattern:', text_color=color.black, text_size=size.tiny)
    table.cell(info_table, column=1, row=4, text='3-Candle', text_color=color.black, text_size=size.tiny)
