// ═══════════════════════════════════════════════════════════════════════════════
// TYPE DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════════════

type GapData
    int bar_index
    float top
    float bottom
    bool is_bullish
    string gap_type

// ═══════════════════════════════════════════════════════════════════════════════
// GLOBAL VARIABLES
// ═══════════════════════════════════════════════════════════════════════════════

var array<GapData> active_gaps = array.new<GapData>()
var array<box> gap_boxes = array.new_box()
// Tracks whether each gap has been mitigated; aligned by index with `gap_boxes`
var array<bool> mitigation_status = array.new_bool()
// Aligned labels for each gap box (na when labels are disabled)
var array<label> gap_labels = array.new_label()
// Anchor-candle labels (with gap rationale acronyms)
var array<label> anchor_labels = array.new_label()
// Ultra-compact info table
var table info_tbl = na
var string info_tbl_pos_cache = ""
var bool info_tbl_lenient_cache = false
var bool info_tbl_suppress_cache = false
// Directional suppression state: 1 = last shown Bullish CSD, -1 = last shown Bearish CSD, 0 = none
var int last_shown_csd_dir = 0
// Track bars that already have CSD labels to prevent cross-bar contamination
var array<int> csd_labeled_bars = array.new<int>()

// ═══════════════════════════════════════════════════════════════════════════════
// UTILITY FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// Body helper functions
bodyTop(o, c) => math.max(o, c)
bodyBot(o, c) => math.min(o, c)

// Text size conversion (general labels)
get_text_size() =>
    label_size_choice == SIZE_TINY ? size.tiny :
     label_size_choice == SIZE_SMALL ? size.small :
     label_size_choice == SIZE_NORMAL ? size.normal :
     label_size_choice == SIZE_LARGE ? size.large : size.huge

// (distal rule handled via line order in combined label; no explicit price offset needed)

// Anchor label size conversion (separate control for anchor/candle labels)
get_anchor_text_size() =>
    anchor_label_size_choice == SIZE_TINY ? size.tiny :
     anchor_label_size_choice == SIZE_SMALL ? size.small :
     anchor_label_size_choice == SIZE_NORMAL ? size.normal :
     anchor_label_size_choice == SIZE_LARGE ? size.large : size.huge

// Info table helpers
get_info_size() => info_text_size_choice == INFO_SIZE_TINY ? size.tiny : info_text_size_choice == INFO_SIZE_SMALL ? size.small : size.normal
pos_from_str(p) =>
    p == POS_TL ? position.top_left :
     p == POS_TC ? position.top_center :
     p == POS_TR ? position.top_right :
     p == POS_ML ? position.middle_left :
     p == POS_MC ? position.middle_center :
     p == POS_MR ? position.middle_right :
     p == POS_BL ? position.bottom_left :
     p == POS_BC ? position.bottom_center : position.bottom_right

// Check if a bar already has a CSD label
bar_has_csd_label(target_bar) =>
    has_label = false
    if array.size(csd_labeled_bars) > 0
        for i = 0 to array.size(csd_labeled_bars) - 1
            if array.get(csd_labeled_bars, i) == target_bar
                has_label := true
                break
    has_label

// Add bar to CSD labeled bars tracking
track_csd_label(target_bar) =>
    array.push(csd_labeled_bars, target_bar)
    // Keep only recent 100 bars to manage memory
    if array.size(csd_labeled_bars) > 100
        array.shift(csd_labeled_bars)

// ═══════════════════════════════════════════════════════════════════════════════
// SOURCE GAP DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

// Fair Value Gap Detection
is_bullish_fvg() => low > high[2]
is_bearish_fvg() => high < low[2]

// Volume Imbalance Detection
is_bullish_vi() =>
    bodies_separated = math.min(open, close) > math.max(open[1], close[1])
    wicks_still_connect = low <= high[1]
    bodies_separated and wicks_still_connect

is_bearish_vi() =>
    bodies_separated = math.max(open, close) < math.min(open[1], close[1])
    wicks_still_connect = high >= low[1]
    bodies_separated and wicks_still_connect

get_vi_coordinates(is_bullish_gap) =>
    if is_bullish_gap
        gap_bottom = math.max(open[1], close[1])
        gap_top = math.min(open, close)
        [gap_top, gap_bottom]
    else
        gap_top = math.min(open[1], close[1])
        gap_bottom = math.max(open, close)
        [gap_top, gap_bottom]

// True Gap Detection
is_bullish_true_gap() => high[1] < low
is_bearish_true_gap() => low[1] > high

get_true_gap_coordinates(is_bullish_gap) =>
    if is_bullish_gap
        [low, high[1]]
    else
        [low[1], high]

// Implied FVG Detection with Displacement Validation
is_displacement_candle() =>
    c2_body_size = math.abs(close[1] - open[1])
    total_body_size = 0.0
    for i = 2 to (1 + lookback_candles)
        total_body_size += math.abs(close[i] - open[i])
    average_body_size = total_body_size / lookback_candles

    if average_body_size > 0
        c2_body_size >= (displacement_multiplier * average_body_size)
    else
        false

detect_implied_fvg() =>
    has_bull_fvg = is_bullish_fvg()
    has_bear_fvg = is_bearish_fvg()

    if not is_displacement_candle()
        [false, float(na), float(na), bool(na)]
    else
        result_found = false
        result_bottom = float(na)
        result_top = float(na)
        result_bullish = bool(na)

// Bullish Implied FVG Detection
        if not has_bull_fvg and not result_found
            c1_top = bodyTop(open[2], close[2])
            c3_bot = bodyBot(open, close)
            bull_wicks_present = (high[2] > c1_top) and (c3_bot > low)

            if bull_wicks_present
                overlap_lo = math.max(c1_top, low)
                overlap_hi = math.min(high[2], c3_bot)
                has_bull_overlap = overlap_hi > overlap_lo

                if has_bull_overlap and c1_top < c3_bot
                    result_found := true
                    result_bottom := overlap_lo
                    result_top := overlap_hi
                    result_bullish := true

// Bearish Implied FVG Detection
        if not has_bear_fvg and not result_found
            c1_bot = bodyBot(open[2], close[2])
            c3_top = bodyTop(open, close)
            bear_wicks_present = (low[2] < c1_bot) and (c3_top < high)

            if bear_wicks_present
                overlap_lo = math.max(low[2], c3_top)
                overlap_hi = math.min(c1_bot, high)
                has_bear_overlap = overlap_hi > overlap_lo

                if has_bear_overlap and c1_bot > c3_top
                    result_found := true
                    result_bottom := overlap_lo
                    result_top := overlap_hi
                    result_bullish := false

        [result_found, result_bottom, result_top, result_bullish]

// RDRB Detection (3-candle): returns [found, bottom, top, is_bullish]
detect_rdrb_gap() =>
    pattern_found = false
    zone_bottom = float(na)
    zone_top = float(na)
    is_rdrb_bullish = bool(na)

    min_tick = syminfo.mintick

    // Predeclare locals to avoid undeclared identifier errors
    c2_body_top = float(na)
    c2_body_bottom = float(na)
    c2_within_c1_wick = false
    c3_body_top = float(na)
    c3_body_bottom = float(na)
    remaining_zone_bottom = float(na)
    remaining_zone_top = float(na)
    intersection_bottom = float(na)
    intersection_top = float(na)
    anchored_top = false
    anchored_bottom = false
    valid_remaining = true

    // Bullish RDRB
    c1_body_top = bodyTop(open[2], close[2])
    c1_upper_wick_exists = high[2] > c1_body_top
    c2_body_top := bodyTop(open[1], close[1])
    c2_body_bottom := bodyBot(open[1], close[1])
    c2_within_c1_wick := (c2_body_bottom >= c1_body_top) and (c2_body_top <= high[2])
    c3_takes_c2_high = high > high[1]

    if c1_upper_wick_exists and c2_within_c1_wick and c3_takes_c2_high and not pattern_found
        c3_body_top := bodyTop(open, close)
        c3_body_bottom := bodyBot(open, close)
        remaining_zone_bottom := math.max(c2_body_bottom, c1_body_top)
        remaining_zone_top := math.min(c2_body_top, high[2])
        intersection_bottom := math.max(remaining_zone_bottom, c3_body_bottom)
        intersection_top := math.min(remaining_zone_top, c3_body_top)
        has_overlap = intersection_bottom < intersection_top
        anchored_top := has_overlap and intersection_top >= remaining_zone_top - min_tick
        anchored_bottom := has_overlap and intersection_bottom <= remaining_zone_bottom + min_tick
        valid_remaining := true
        if has_overlap
            if anchored_top and not anchored_bottom
                remaining_zone_top := intersection_bottom
            else if anchored_bottom and not anchored_top
                remaining_zone_bottom := intersection_top
            else
                valid_remaining := false
        if valid_remaining and remaining_zone_top > remaining_zone_bottom + min_tick
            pattern_found := true
            zone_bottom := remaining_zone_bottom
            zone_top := remaining_zone_top
            is_rdrb_bullish := true

    // Bearish RDRB
    if not pattern_found
        c1_body_bottom = bodyBot(open[2], close[2])
        c1_lower_wick_exists = low[2] < c1_body_bottom
        c2_body_top := bodyTop(open[1], close[1])
        c2_body_bottom := bodyBot(open[1], close[1])
        c2_within_c1_wick := (c2_body_top <= c1_body_bottom) and (c2_body_bottom >= low[2])
        c3_takes_c2_low = low < low[1]
        if c1_lower_wick_exists and c2_within_c1_wick and c3_takes_c2_low
            c3_body_top := bodyTop(open, close)
            c3_body_bottom := bodyBot(open, close)
            remaining_zone_bottom := math.max(c2_body_bottom, low[2])
            remaining_zone_top := math.min(c2_body_top, c1_body_bottom)
            intersection_bottom := math.max(remaining_zone_bottom, c3_body_bottom)
            intersection_top := math.min(remaining_zone_top, c3_body_top)
            has_overlap = intersection_bottom < intersection_top
            anchored_top := has_overlap and intersection_top >= remaining_zone_top - min_tick
            anchored_bottom := has_overlap and intersection_bottom <= remaining_zone_bottom + min_tick
            valid_remaining := true
            if has_overlap
                if anchored_top and not anchored_bottom
                    remaining_zone_top := intersection_bottom
                else if anchored_bottom and not anchored_top
                    remaining_zone_bottom := intersection_top
                else
                    valid_remaining := false
            if valid_remaining and remaining_zone_top > remaining_zone_bottom + min_tick
                pattern_found := true
                zone_bottom := remaining_zone_bottom
                zone_top := remaining_zone_top
                is_rdrb_bullish := false

    [pattern_found, zone_bottom, zone_top, is_rdrb_bullish]

// ═══════════════════════════════════════════════════════════════════════════════
// SOURCE GAP QUERY HELPERS
// ═══════════════════════════════════════════════════════════════════════════════

// Returns true if any recorded gap's formation window overlaps [win_start, win_end]
// Filtered by desired gap polarity: set `want_bullish` to true to only count bullish gaps,
// or false to only count bearish gaps (used for CSD opposite-direction validation).
has_gap_in_window(win_start, win_end, want_bullish) =>
    found = false
    if array.size(active_gaps) > 0
        for gi = 0 to array.size(active_gaps) - 1
            gd = array.get(active_gaps, gi)
            is_three_bar_gap = (gd.gap_type == SOURCE_GAP_LABEL_FVG) or (gd.gap_type == SOURCE_GAP_LABEL_IMPLIED) or (gd.gap_type == SOURCE_GAP_LABEL_RDRB)
            // Origin candle is the last formation candle: C3 for 3-bar, C2 for 2-bar
            origin_idx = gd.bar_index + (is_three_bar_gap ? THREE_BAR_FORMATION_OFFSET : TWO_BAR_FORMATION_OFFSET)
            within = (origin_idx >= win_start) and (origin_idx <= win_end)
            if within and (gd.is_bullish == want_bullish)
                found := true
    found

// Returns a comma-separated string of unique gap type acronyms within [win_start, win_end]
// Returns comma-separated acronyms with sign (e.g., "FVG-", "VI+") within [win_start, win_end]
// filtered by desired polarity. `want_bullish=true` collects only bullish gaps ("+")
// and `want_bullish=false` collects only bearish gaps ("-"). Dedupe by type+sign.
get_gap_acronyms_in_window(win_start, win_end, want_bullish) =>
    fvg_pos = false
    fvg_neg = false
    implied_pos = false
    implied_neg = false
    vi_pos = false
    vi_neg = false
    tg_pos = false
    tg_neg = false
    rdrb_pos = false
    rdrb_neg = false
    if array.size(active_gaps) > 0
        for gi = 0 to array.size(active_gaps) - 1
            gd = array.get(active_gaps, gi)
            is_three_bar_gap = (gd.gap_type == SOURCE_GAP_LABEL_FVG) or (gd.gap_type == SOURCE_GAP_LABEL_IMPLIED) or (gd.gap_type == SOURCE_GAP_LABEL_RDRB)
            origin_idx = gd.bar_index + (is_three_bar_gap ? THREE_BAR_FORMATION_OFFSET : TWO_BAR_FORMATION_OFFSET)
            within = (origin_idx >= win_start) and (origin_idx <= win_end)
            if within and (gd.is_bullish == want_bullish)
                is_bull = gd.is_bullish
                if gd.gap_type == SOURCE_GAP_LABEL_FVG
                    fvg_pos := fvg_pos or is_bull
                    fvg_neg := fvg_neg or not is_bull
                if gd.gap_type == SOURCE_GAP_LABEL_IMPLIED
                    implied_pos := implied_pos or is_bull
                    implied_neg := implied_neg or not is_bull
                if gd.gap_type == SOURCE_GAP_LABEL_VOL
                    vi_pos := vi_pos or is_bull
                    vi_neg := vi_neg or not is_bull
                if gd.gap_type == SOURCE_GAP_LABEL_GAP
                    tg_pos := tg_pos or is_bull
                    tg_neg := tg_neg or not is_bull
                if gd.gap_type == SOURCE_GAP_LABEL_RDRB
                    rdrb_pos := rdrb_pos or is_bull
                    rdrb_neg := rdrb_neg or not is_bull
    txt = ""
    // Order: FVG, Implied FVG, Vol, Gap; include sign
    if fvg_pos
        txt := txt == "" ? SOURCE_GAP_LABEL_FVG + "+" : txt + ", " + SOURCE_GAP_LABEL_FVG + "+"
    if fvg_neg
        txt := txt == "" ? SOURCE_GAP_LABEL_FVG + "-" : txt + ", " + SOURCE_GAP_LABEL_FVG + "-"
    if implied_pos
        txt := txt == "" ? SOURCE_GAP_LABEL_IMPLIED + "+" : txt + ", " + SOURCE_GAP_LABEL_IMPLIED + "+"
    if implied_neg
        txt := txt == "" ? SOURCE_GAP_LABEL_IMPLIED + "-" : txt + ", " + SOURCE_GAP_LABEL_IMPLIED + "-"
    if vi_pos
        txt := txt == "" ? SOURCE_GAP_LABEL_VOL + "+" : txt + ", " + SOURCE_GAP_LABEL_VOL + "+"
    if vi_neg
        txt := txt == "" ? SOURCE_GAP_LABEL_VOL + "-" : txt + ", " + SOURCE_GAP_LABEL_VOL + "-"
    if tg_pos
        txt := txt == "" ? SOURCE_GAP_LABEL_GAP + "+" : txt + ", " + SOURCE_GAP_LABEL_GAP + "+"
    if tg_neg
        txt := txt == "" ? SOURCE_GAP_LABEL_GAP + "-" : txt + ", " + SOURCE_GAP_LABEL_GAP + "-"
    if rdrb_pos
        txt := txt == "" ? SOURCE_GAP_LABEL_RDRB + "+" : txt + ", " + SOURCE_GAP_LABEL_RDRB + "+"
    if rdrb_neg
        txt := txt == "" ? SOURCE_GAP_LABEL_RDRB + "-" : txt + ", " + SOURCE_GAP_LABEL_RDRB + "-"
    txt

// Returns MBZ/SIF-style compact summary for gaps within [win_start, win_end]
// Format rules:
// - Single type: "FVG x2" (omit x1)
// - Two types (small total count): "(Gap x Vol)"; include xN only when >1 (e.g., "(FVG x2 x Vol)")
// - Many types or total count > 3: "(<total>)"
get_gap_summary_in_window(win_start, win_end, want_bullish) =>
    // Count each source type inside window for desired polarity
    count_fvg = 0
    count_imp = 0
    count_vi = 0
    count_tg = 0
    count_rdrb = 0
    if array.size(active_gaps) > 0
        for gi = 0 to array.size(active_gaps) - 1
            gd = array.get(active_gaps, gi)
            is_three_bar_gap = (gd.gap_type == SOURCE_GAP_LABEL_FVG) or (gd.gap_type == SOURCE_GAP_LABEL_IMPLIED) or (gd.gap_type == SOURCE_GAP_LABEL_RDRB)
            origin_idx = gd.bar_index + (is_three_bar_gap ? THREE_BAR_FORMATION_OFFSET : TWO_BAR_FORMATION_OFFSET)
            within = (origin_idx >= win_start) and (origin_idx <= win_end)
            if within and (gd.is_bullish == want_bullish)
                if gd.gap_type == SOURCE_GAP_LABEL_FVG
                    count_fvg += 1
                if gd.gap_type == SOURCE_GAP_LABEL_IMPLIED
                    count_imp += 1
                if gd.gap_type == SOURCE_GAP_LABEL_VOL
                    count_vi += 1
                if gd.gap_type == SOURCE_GAP_LABEL_GAP
                    count_tg += 1
                if gd.gap_type == SOURCE_GAP_LABEL_RDRB
                    count_rdrb += 1
    total = count_fvg + count_imp + count_vi + count_tg + count_rdrb
    if total == 0
        ""
    else
        // Special rule: single plain FVG is implied → suppress summary
        if count_fvg == 1 and count_imp == 0 and count_vi == 0 and count_tg == 0 and count_rdrb == 0
            ""
        else
            // Grouping rule: if total ≥ 3 → show only total in parentheses
            if total >= SUMMARY_GROUP_TOTAL_THRESHOLD
                SUMMARY_OPEN + str.tostring(total) + SUMMARY_CLOSE
            else
                // Build parts in fixed order, appending multiplier with × when >1
                parts = array.new_string()
                if count_fvg > 0
                    array.push(parts, count_fvg == 1 ? SOURCE_GAP_LABEL_FVG : (SOURCE_GAP_LABEL_FVG + MULTIPLIER_SYMBOL + str.tostring(count_fvg)))
                if count_imp > 0
                    array.push(parts, count_imp == 1 ? SOURCE_GAP_LABEL_IMPLIED : (SOURCE_GAP_LABEL_IMPLIED + MULTIPLIER_SYMBOL + str.tostring(count_imp)))
                if count_vi > 0
                    array.push(parts, count_vi == 1 ? SOURCE_GAP_LABEL_VOL : (SOURCE_GAP_LABEL_VOL + MULTIPLIER_SYMBOL + str.tostring(count_vi)))
                if count_tg > 0
                    array.push(parts, count_tg == 1 ? SOURCE_GAP_LABEL_GAP : (SOURCE_GAP_LABEL_GAP + MULTIPLIER_SYMBOL + str.tostring(count_tg)))
                if count_rdrb > 0
                    array.push(parts, count_rdrb == 1 ? SOURCE_GAP_LABEL_RDRB : (SOURCE_GAP_LABEL_RDRB + MULTIPLIER_SYMBOL + str.tostring(count_rdrb)))
                // Join with comma, wrap in parentheses (MBZ/SIF style)
                summary = SUMMARY_OPEN
                for i = 0 to array.size(parts) - 1
                    if i > 0
                        summary += SUMMARY_SEPARATOR
                    summary += array.get(parts, i)
                summary + SUMMARY_CLOSE

// Builds a detailed tooltip string listing gap composition within [win_start, win_end]
// Example (lowercase when rendered):
// gaps in lookback (opposite): 3\n- fvg: 2\n- implied: 1\n- vol: 0\n- gap: 0
get_gap_tooltip_in_window(win_start, win_end, want_bullish) =>
    // Count per type in window for desired polarity
    count_fvg = 0
    count_imp = 0
    count_vi = 0
    count_tg = 0
    count_rdrb = 0
    if array.size(active_gaps) > 0
        for gi = 0 to array.size(active_gaps) - 1
            gd = array.get(active_gaps, gi)
            is_three_bar_gap = (gd.gap_type == SOURCE_GAP_LABEL_FVG) or (gd.gap_type == SOURCE_GAP_LABEL_IMPLIED) or (gd.gap_type == SOURCE_GAP_LABEL_RDRB)
            origin_idx = gd.bar_index + (is_three_bar_gap ? THREE_BAR_FORMATION_OFFSET : TWO_BAR_FORMATION_OFFSET)
            within = (origin_idx >= win_start) and (origin_idx <= win_end)
            if within and (gd.is_bullish == want_bullish)
                if gd.gap_type == SOURCE_GAP_LABEL_FVG
                    count_fvg += 1
                if gd.gap_type == SOURCE_GAP_LABEL_IMPLIED
                    count_imp += 1
                if gd.gap_type == SOURCE_GAP_LABEL_VOL
                    count_vi += 1
                if gd.gap_type == SOURCE_GAP_LABEL_GAP
                    count_tg += 1
                if gd.gap_type == SOURCE_GAP_LABEL_RDRB
                    count_rdrb += 1
    total = count_fvg + count_imp + count_vi + count_tg + count_rdrb
    // Build compact, one-line summary: "<total> | fvg×2, imp"
    parts = array.new_string()
    if count_fvg > 0
        array.push(parts, count_fvg == 1 ? SOURCE_GAP_NAME_FVG_LC : (SOURCE_GAP_NAME_FVG_LC + MULTIPLIER_SYMBOL + str.tostring(count_fvg)))
    if count_imp > 0
        array.push(parts, count_imp == 1 ? SOURCE_GAP_NAME_IMP_LC : (SOURCE_GAP_NAME_IMP_LC + MULTIPLIER_SYMBOL + str.tostring(count_imp)))
    if count_vi > 0
        array.push(parts, count_vi == 1 ? SOURCE_GAP_NAME_VOL_LC : (SOURCE_GAP_NAME_VOL_LC + MULTIPLIER_SYMBOL + str.tostring(count_vi)))
    if count_tg > 0
        array.push(parts, count_tg == 1 ? SOURCE_GAP_NAME_GAP_LC : (SOURCE_GAP_NAME_GAP_LC + MULTIPLIER_SYMBOL + str.tostring(count_tg)))
    if count_rdrb > 0
        array.push(parts, count_rdrb == 1 ? SOURCE_GAP_NAME_RDRB_LC : (SOURCE_GAP_NAME_RDRB_LC + MULTIPLIER_SYMBOL + str.tostring(count_rdrb)))
    types_line = ""
    if array.size(parts) > 0
        for i = 0 to array.size(parts) - 1
            if i > 0
                types_line += SUMMARY_SEPARATOR
            types_line += array.get(parts, i)
    // Essentials only: total plus non-zero types with multipliers
    types_line != "" ? (str.tostring(total) + " | " + types_line) : str.tostring(total)

// ═══════════════════════════════════════════════════════════════════════════════
// SOURCE GAP CREATION
// ═══════════════════════════════════════════════════════════════════════════════

create_gap(gap_top, gap_bottom, is_bullish_gap, gap_type_str, anchor_bar) =>
    if array.size(active_gaps) >= max_gaps
        // Remove oldest gap
        if array.size(active_gaps) > 0
            array.shift(active_gaps)
        if array.size(gap_boxes) > 0
            box.delete(array.shift(gap_boxes))
        if array.size(mitigation_status) > 0
            array.shift(mitigation_status)
        if array.size(gap_labels) > 0
            old_lbl = array.shift(gap_labels)
            if not na(old_lbl)
                label.delete(old_lbl)

    // Create gap data
    gap_data = GapData.new(anchor_bar, gap_top, gap_bottom, is_bullish_gap, gap_type_str)
    array.push(active_gaps, gap_data)

    // Create visual box
    // Respect 'show_source_gaps' by hiding box fill when off
    gap_bg = show_source_gaps ? gap_color : na
    gap_box = box.new(left=anchor_bar, top=gap_top, right=bar_index + BOX_EXTEND_LOOKAHEAD, bottom=gap_bottom, border_color=na, bgcolor=gap_bg)
    array.push(gap_boxes, gap_box)
    // New gaps are unmitigated by default
    array.push(mitigation_status, false)

    // Add label when source gaps are visible (display-only window; keep array aligned even if we skip)
    if show_source_gaps and (labels_window_bars == 0 or (bar_index - anchor_bar) <= labels_window_bars)
        label_text = gap_type_str + (is_bullish_gap ? "+" : "-")
        // Center using actual box coordinates to ensure perfect alignment
        bx_left = box.get_left(gap_box)
        bx_right = box.get_right(gap_box)
        bx_top = box.get_top(gap_box)
        bx_bottom = box.get_bottom(gap_box)
        center_x = int(math.round((bx_left + bx_right) / 2))
        center_y = (bx_top + bx_bottom) / 2
        // No background for source gap labels (transparent)
        lbl = label.new(center_x, center_y, label_text, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_center, color=na, textcolor=source_label_text_color, size=get_text_size())
        array.push(gap_labels, lbl)
    else
        array.push(gap_labels, na)

    // Prune gap labels: enforce window and max count without breaking alignment
    // First, remove labels outside window
    if labels_window_bars > 0
        for gi = 0 to array.size(gap_labels) - 1
            lbl_i = array.get(gap_labels, gi)
            if not na(lbl_i)
                gd_i = array.get(active_gaps, gi)
                if (bar_index - gd_i.bar_index) > labels_window_bars
                    label.delete(lbl_i)
                    array.set(gap_labels, gi, na)
    // If source gaps are hidden, delete any existing source gap labels
    if not show_source_gaps
        for gi = 0 to array.size(gap_labels) - 1
            lbl_i = array.get(gap_labels, gi)
            if not na(lbl_i)
                label.delete(lbl_i)
                array.set(gap_labels, gi, na)
    // Then, enforce unified cap by deleting oldest existing labels (cap == max_gaps)
    // Count current active labels
    current_labels = 0
    for gi = 0 to array.size(gap_labels) - 1
        if not na(array.get(gap_labels, gi))
            current_labels += 1
    // Delete from oldest until within cap
    if current_labels > max_gaps
        for gi = 0 to array.size(gap_labels) - 1
            if not na(array.get(gap_labels, gi))
                label.delete(array.get(gap_labels, gi))
                array.set(gap_labels, gi, na)
                current_labels -= 1
            if current_labels <= max_gaps
                break

// ═══════════════════════════════════════════════════════════════════════════════
// MAIN DETECTION AND VISUALIZATION LOGIC
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.isconfirmed
    // Reset alert variables each bar
    csd_bullish_formed := false
    csd_bearish_formed := false

    // Fair Value Gap Detection
    if enable_fvg
        if is_bullish_fvg()
            gap_top = low
            gap_bottom = high[2]
            create_gap(gap_top, gap_bottom, true, SOURCE_GAP_LABEL_FVG, bar_index - THREE_BAR_FORMATION_OFFSET)

        if is_bearish_fvg()
            gap_top = low[2]
            gap_bottom = high
            create_gap(gap_top, gap_bottom, false, SOURCE_GAP_LABEL_FVG, bar_index - THREE_BAR_FORMATION_OFFSET)

    // Implied Fair Value Gap Detection
    if enable_implied_fvg
        [is_valid_implied, implied_bottom, implied_top, is_implied_bullish] = detect_implied_fvg()
        if is_valid_implied
            create_gap(implied_top, implied_bottom, is_implied_bullish, SOURCE_GAP_LABEL_IMPLIED, bar_index - THREE_BAR_FORMATION_OFFSET)

    // Volume Imbalance Detection
    if enable_vol
        if is_bullish_vi()
            [vi_top, vi_bottom] = get_vi_coordinates(true)
            create_gap(vi_top, vi_bottom, true, SOURCE_GAP_LABEL_VOL, bar_index - TWO_BAR_FORMATION_OFFSET)

        if is_bearish_vi()
            [vi_top, vi_bottom] = get_vi_coordinates(false)
            create_gap(vi_top, vi_bottom, false, SOURCE_GAP_LABEL_VOL, bar_index - TWO_BAR_FORMATION_OFFSET)

    // True Gap Detection
    if enable_true_gap
        if is_bullish_true_gap()
            [tg_top, tg_bottom] = get_true_gap_coordinates(true)
            create_gap(tg_top, tg_bottom, true, SOURCE_GAP_LABEL_GAP, bar_index - TWO_BAR_FORMATION_OFFSET)

        if is_bearish_true_gap()
            [tg_top, tg_bottom] = get_true_gap_coordinates(false)
            create_gap(tg_top, tg_bottom, false, SOURCE_GAP_LABEL_GAP, bar_index - TWO_BAR_FORMATION_OFFSET)

    // RDRB Detection
    if enable_rdrb
        [is_valid_rdrb, rdrb_bottom, rdrb_top, is_rdrb_bullish] = detect_rdrb_gap()
        if is_valid_rdrb
            create_gap(rdrb_top, rdrb_bottom, is_rdrb_bullish, SOURCE_GAP_LABEL_RDRB, bar_index - THREE_BAR_FORMATION_OFFSET)

    // ═══════════════════════════════════════════════════════════════════════════
    // CSD DETECTION AND VALIDATION (Cross-Bar Contamination Protected)
    // ═══════════════════════════════════════════════════════════════════════════

    // Reset all CSD alert variables each bar
    csd_bullish_formed := false
    csd_bearish_formed := false
    csd_bullish_lenient_formed := false
    csd_bearish_lenient_formed := false

    // Standard CSD Detection (immediate candle)
    prev_bear = close[1] < open[1]
    prev_bull = close[1] > open[1]
    curr_bull = close > open
    curr_bear = close < open

    is_bull_csd_standard = curr_bull and prev_bear and (close > open[1])
    is_bear_csd_standard = curr_bear and prev_bull and (close < open[1])

    // Lenient CSD Detection (Nth candle, only if standard failed)
    is_bull_csd_lenient = false
    is_bear_csd_lenient = false

    if enable_lenient_csd and not is_bull_csd_standard and not is_bear_csd_standard
        anchor_bear_n = close[csd_leniency_level] < open[csd_leniency_level]
        anchor_bull_n = close[csd_leniency_level] > open[csd_leniency_level]
        is_bull_csd_lenient := curr_bull and anchor_bear_n and (close > open[csd_leniency_level])
        is_bear_csd_lenient := curr_bear and anchor_bull_n and (close < open[csd_leniency_level])

    // Process Standard CSD (Priority 1)
    if is_bull_csd_standard or is_bear_csd_standard
        anchor_index = bar_index - 1

        // Check if this anchor bar already has a CSD label
        if not bar_has_csd_label(anchor_index)
            win_end = anchor_index
            win_start = anchor_index - csd_gap_lookback + 1
            want_bullish_gap = is_bear_csd_standard
            gap_ok = has_gap_in_window(win_start, win_end, want_bullish_gap)
            valid_csd = csd_require_gap ? gap_ok : true

            if valid_csd
                if is_bull_csd_standard
                    csd_bullish_formed := true
                else
                    csd_bearish_formed := true

                this_dir = is_bull_csd_standard ? 1 : -1
                suppress_this_csd = csd_suppress_repeats and (last_shown_csd_dir == this_dir)

                if not suppress_this_csd
                    gap_summary = get_gap_summary_in_window(win_start, win_end, want_bullish_gap)
                    if show_anchor_labels and max_anchor_labels != 0 and (labels_window_bars == 0 or (bar_index - anchor_index) <= labels_window_bars)
                        anchor_yloc = is_bull_csd_standard ? yloc.belowbar : yloc.abovebar
                        anchor_style = is_bull_csd_standard ? label.style_label_up : label.style_label_down
                        anchor_id_text = is_bull_csd_standard ? SYMBOL_BULL : SYMBOL_BEAR
                        combined_text = ""
                        if is_bull_csd_standard
                            combined_text := anchor_id_text
                            if csd_require_gap and gap_summary != ""
                                combined_text := combined_text + "\n" + str.lower(gap_summary)
                        else
                            if csd_require_gap and gap_summary != ""
                                combined_text := str.lower(gap_summary) + "\n" + anchor_id_text
                            else
                                combined_text := anchor_id_text
                        tooltip_text = csd_require_gap ? str.lower(get_gap_tooltip_in_window(win_start, win_end, want_bullish_gap)) : ""
                        combined_lbl = label.new(anchor_index, na, combined_text, xloc=xloc.bar_index, yloc=anchor_yloc, style=anchor_style, color=na, textcolor=anchor_label_text_color, size=get_anchor_text_size(), tooltip=tooltip_text)
                        array.push(anchor_labels, combined_lbl)

                        // Track this bar as having a CSD label
                        track_csd_label(anchor_index)

                        // Prune by cap (FIFO)
                        while max_anchor_labels > 0 and array.size(anchor_labels) > max_anchor_labels
                            to_del = array.shift(anchor_labels)
                            if not na(to_del)
                                label.delete(to_del)
                    last_shown_csd_dir := this_dir

    // Process Lenient CSD (Priority 2 - only if standard didn't trigger AND target bar is free)
    else if is_bull_csd_lenient or is_bear_csd_lenient
        anchor_index = bar_index - csd_leniency_level

        // Check if this anchor bar already has a CSD label
        if not bar_has_csd_label(anchor_index)
            win_end = anchor_index
            win_start = anchor_index - csd_gap_lookback + 1
            want_bullish_gap = is_bear_csd_lenient
            gap_ok = has_gap_in_window(win_start, win_end, want_bullish_gap)
            valid_csd = csd_require_gap ? gap_ok : true

            if valid_csd
                if is_bull_csd_lenient
                    csd_bullish_lenient_formed := true
                else
                    csd_bearish_lenient_formed := true

                this_dir = is_bull_csd_lenient ? 1 : -1
                suppress_this_csd = csd_suppress_repeats and (last_shown_csd_dir == this_dir)

                if not suppress_this_csd
                    gap_summary = get_gap_summary_in_window(win_start, win_end, want_bullish_gap)
                    if show_anchor_labels and max_anchor_labels != 0 and (labels_window_bars == 0 or (bar_index - anchor_index) <= labels_window_bars)
                        anchor_yloc = is_bull_csd_lenient ? yloc.belowbar : yloc.abovebar
                        anchor_style = is_bull_csd_lenient ? label.style_label_up : label.style_label_down
                        anchor_id_text = is_bull_csd_lenient ? (SYMBOL_BULL + LENIENT_SUFFIX) : (SYMBOL_BEAR + LENIENT_SUFFIX)
                        combined_text = ""
                        if is_bull_csd_lenient
                            combined_text := anchor_id_text
                            if csd_require_gap and gap_summary != ""
                                combined_text := combined_text + "\n" + str.lower(gap_summary)
                        else
                            if csd_require_gap and gap_summary != ""
                                combined_text := str.lower(gap_summary) + "\n" + anchor_id_text
                            else
                                combined_text := anchor_id_text
                        tooltip_text = csd_require_gap ? str.lower(get_gap_tooltip_in_window(win_start, win_end, want_bullish_gap)) : ""
                        combined_lbl = label.new(anchor_index, na, combined_text, xloc=xloc.bar_index, yloc=anchor_yloc, style=anchor_style, color=na, textcolor=anchor_label_text_color, size=get_anchor_text_size(), tooltip=tooltip_text)
                        array.push(anchor_labels, combined_lbl)

                        // Track this bar as having a CSD label
                        track_csd_label(anchor_index)

                        // Prune by cap (FIFO)
                        while max_anchor_labels > 0 and array.size(anchor_labels) > max_anchor_labels
                            to_del = array.shift(anchor_labels)
                            if not na(to_del)
                                label.delete(to_del)
                    last_shown_csd_dir := this_dir

    // Prune anchor labels by window (shared for both standard and lenient)
    if labels_window_bars > 0 and array.size(anchor_labels) > 0
        for ai = 0 to array.size(anchor_labels) - 1
            lbl = array.get(anchor_labels, ai)
            if not na(lbl)
                ax = int(label.get_x(lbl))
                if (bar_index - ax) > labels_window_bars
                    label.delete(lbl)
                    array.set(anchor_labels, ai, na)

        // Note: when gap requirement is OFF, Anchor ID labels remain; Anchor Gap labels simply won't be added.

    // Grouped alert system logic
    if alert_mode == ALERT_MODE_GROUPED or alert_mode == ALERT_MODE_BOTH
        // Build grouped message if any enabled alerts fired
        if (enable_csd_plus_formation and csd_bullish_formed) or (enable_csd_minus_formation and csd_bearish_formed) or (enable_csd_plus_lenient_formation and csd_bullish_lenient_formed) or (enable_csd_minus_lenient_formation and csd_bearish_lenient_formed)
            array.clear(csd_alert_parts)

            // Check each enabled alert type
            if enable_csd_plus_formation and csd_bullish_formed
                array.push(csd_alert_parts, CSD_PLUS)
            if enable_csd_minus_formation and csd_bearish_formed
                array.push(csd_alert_parts, CSD_MINUS)
            if enable_csd_plus_lenient_formation and csd_bullish_lenient_formed
                array.push(csd_alert_parts, CSD_PLUS_LENIENT)
            if enable_csd_minus_lenient_formation and csd_bearish_lenient_formed
                array.push(csd_alert_parts, CSD_MINUS_LENIENT)

            // Build and send grouped message
            lead_text = array.get(csd_alert_parts, 0)
            extra = array.size(csd_alert_parts) - 1
            plus_n = extra > 0 ? (" +" + str.tostring(extra)) : ""
            tf = str.tostring(timeframe.period)
            alert_msg = lead_text + plus_n + " • " + tf
            // Message: "<lead> +N • timeframe" (no prefix/price/commas/dashes)
            alert(alert_msg)

// Candle coloration removed for cleaner UI (no barcolor applied)

// ═══════════════════════════════════════════════════════════════════════════════
// ULTRA-COMPACT LOOKBACK INFO TABLE
// ═══════════════════════════════════════════════════════════════════════════════

// Create/move table when needed and update content every bar
if info_show_table
    // Recreate if position changed or any settings toggled
    if not na(info_tbl) and (info_tbl_pos_cache != info_table_pos or info_tbl_lenient_cache != enable_lenient_csd or info_tbl_suppress_cache != csd_suppress_repeats)
        table.delete(info_tbl)
        info_tbl := na
    base_rows = 1  // Always show LB (lookback)
    lenient_row = enable_lenient_csd ? 1 : 0  // Add row for LL (leniency level)
    suppress_row = csd_suppress_repeats ? 1 : 0  // Add row for suppress (only when ON)
    rows_needed = base_rows + lenient_row + suppress_row

    if na(info_tbl)
        info_tbl := table.new(pos_from_str(info_table_pos), 1, rows_needed, frame_color=na, border_width=0)
        info_tbl_pos_cache := info_table_pos
        info_tbl_lenient_cache := enable_lenient_csd
        info_tbl_suppress_cache := csd_suppress_repeats

    // Update cells with current lookback and conditionally leniency and suppress
    current_row = 0
    table.cell(info_tbl, 0, current_row, INFO_LOOKBACK_PREFIX + str.tostring(csd_gap_lookback), text_color=info_text_color, bgcolor=info_bg_color, text_size=get_info_size())
    current_row += 1

    if enable_lenient_csd
        table.cell(info_tbl, 0, current_row, INFO_LENIENCY_PREFIX + str.tostring(csd_leniency_level), text_color=info_text_color, bgcolor=info_bg_color, text_size=get_info_size())
        current_row += 1

    if csd_suppress_repeats
        table.cell(info_tbl, 0, current_row, INFO_SUPPRESSED_TEXT, text_color=info_text_color, bgcolor=info_bg_color, text_size=get_info_size())
else
    if not na(info_tbl)
        table.delete(info_tbl)
        info_tbl := na
        info_tbl_pos_cache := ""
        info_tbl_lenient_cache := false
        info_tbl_suppress_cache := false

// ═══════════════════════════════════════════════════════════════════════════════
// SOURCE GAP MITIGATION LOGIC (mark when current candle enters the gap)
// ═══════════════════════════════════════════════════════════════════════════════

// A gap is mitigated the first time the candle (wick or body) enters it
if array.size(gap_boxes) > 0 and array.size(mitigation_status) > 0 and array.size(active_gaps) > 0
    for i = 0 to array.size(gap_boxes) - 1
        if i < array.size(gap_boxes) and i < array.size(mitigation_status) and i < array.size(active_gaps)
            already_mitigated = array.get(mitigation_status, i)
            if not already_mitigated
                gd = array.get(active_gaps, i)
                gap_top_i = gd.top
                gap_bottom_i = gd.bottom
                gap_type_i = gd.gap_type
                // Do not allow mitigation on candles that form the gap
                is_three_bar_gap = (gap_type_i == SOURCE_GAP_LABEL_FVG) or (gap_type_i == SOURCE_GAP_LABEL_IMPLIED) or (gap_type_i == SOURCE_GAP_LABEL_RDRB)
                formation_end = gd.bar_index + (is_three_bar_gap ? THREE_BAR_FORMATION_OFFSET : TWO_BAR_FORMATION_OFFSET)
                if bar_index > formation_end
                    // Price enters the gap if the current bar's high/low overlaps the gap range
                    price_enters = (low <= gap_top_i) and (high >= gap_bottom_i)
                    if price_enters
                        // Mark mitigated and freeze the rectangle to this bar
                        array.set(mitigation_status, i, true)
                        gb = array.get(gap_boxes, i)
                        box.set_right(gb, bar_index)
                        // Re-center label on frozen box
                        if array.size(gap_labels) > i
                            lbl_i = array.get(gap_labels, i)
                            if not na(lbl_i)
                                cx = int(math.round((box.get_left(gb) + box.get_right(gb)) / 2))
                                cy = (box.get_top(gb) + box.get_bottom(gb)) / 2
                                label.set_x(lbl_i, cx)
                                label.set_y(lbl_i, cy)

// ═══════════════════════════════════════════════════════════════════════════════
// BOX EXTENSION LOGIC (extend only unmitigated rectangles to current bar)
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.isrealtime and array.size(gap_boxes) > 0 and array.size(mitigation_status) > 0
    for i = 0 to array.size(gap_boxes) - 1
        if i < array.size(gap_boxes) and i < array.size(mitigation_status)
            is_mitigated = array.get(mitigation_status, i)
            // Only extend box if gap is not mitigated
            if not is_mitigated
                gap_box = array.get(gap_boxes, i)
                box.set_right(gap_box, bar_index + BOX_EXTEND_LOOKAHEAD)
                // Keep label centered as box extends
                if i < array.size(gap_labels)
                    lbl_i = array.get(gap_labels, i)
                    if not na(lbl_i)
                        cx = int(math.round((box.get_left(gap_box) + box.get_right(gap_box)) / 2))
                        cy = (box.get_top(gap_box) + box.get_bottom(gap_box)) / 2
                        label.set_x(lbl_i, cx)
                        label.set_y(lbl_i, cy)

// ═══════════════════════════════════════════════════════════════════════════════
// INDIVIDUAL ALERT CONDITIONS
// ═══════════════════════════════════════════════════════════════════════════════

// Individual alert conditions (always available by Pine design)
alertcondition(csd_bullish_formed, title=CSD_PLUS, message='{{interval}}')
alertcondition(csd_bearish_formed, title=CSD_MINUS, message='{{interval}}')
alertcondition(csd_bullish_lenient_formed, title=CSD_PLUS_LENIENT, message='{{interval}}')
alertcondition(csd_bearish_lenient_formed, title=CSD_MINUS_LENIENT, message='{{interval}}')

// CSD Hunter° [Pro+] [v2.4-rdrb-source]
