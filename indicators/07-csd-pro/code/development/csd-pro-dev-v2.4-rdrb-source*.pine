enable_implied_fvg = input.bool(true,SOURCE_GAP_LONG_LABEL_IMPLIED, inline="src_t1", tooltip=TOOLTIP_TOGGLE_IMPLIED, group=GROUP_SOURCE)
enable_vol = input.bool(true,SOURCE_GAP_LONG_LABEL_VOL, inline="src_t2", tooltip=TOOLTIP_TOGGLE_VOL, group=GROUP_SOURCE)
enable_true_gap = input.bool(true,SOURCE_GAP_LONG_LABEL_GAP, inline="src_t2", tooltip=TOOLTIP_TOGGLE_GAP, group=GROUP_SOURCE)
enable_rdrb = input.bool(true,SOURCE_GAP_LONG_LABEL_RDRB, inline="src_t3", tooltip=TOOLTIP_TOGGLE_RDRB, group=GROUP_SOURCE)

// Visual settings (show toggle on its own row for clarity)
