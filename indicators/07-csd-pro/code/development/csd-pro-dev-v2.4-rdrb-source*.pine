indicator('CSD Hunter° [Pro+] [v2.4-rdrb-source]', shorttitle='CSD Hunter° [Pro+] (rdrb)', overlay=true, max_boxes_count=INDICATOR_MAX_BOXES, max_labels_count=INDICATOR_MAX_LABELS)

