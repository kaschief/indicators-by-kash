TOOLTIP_TOGGLE_IMPLIED = "Detect Implied FVGs"
TOOLTIP_TOGGLE_VOL = "Detect Volume Imbalances"
TOOLTIP_TOGGLE_GAP = "Detect True Gaps"
TOOLTIP_TOGGLE_RDRB = "Detect Rebalanced Redistributed Gaps (RDRB)"

// Source type toggles (two rows for compact layout)
