// Visibility (applies to both source and anchor labels)
TOOLTIP_LABEL_WINDOW = "How many recent bars to show labels on. Set 0 for unlimited (may impact performance). Higher numbers show labels further back in history. Detection/validation is unaffected."
labels_window_bars = input.int(DEFAULT_LABEL_WINDOW_BARS, "No. of Bars for Label Retention", minval=0, maxval=MAX_LABEL_WINDOW_BARS, tooltip=TOOLTIP_LABEL_WINDOW, group=GROUP_ANCHOR)

// Gap type toggles (enable multiple types concurrently)
