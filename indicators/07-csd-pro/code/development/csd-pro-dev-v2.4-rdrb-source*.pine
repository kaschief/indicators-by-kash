show_source_gaps = input.bool(false, "Enable Gaps", inline="srcv_row3", tooltip=TOOLTIP_SOURCE_SHOW, group=GROUP_SOURCE)


// ═══════════════════════════════════════════════════════════════════════════════
// IMPLIED FVG SOURCE SETTINGS
// ═══════════════════════════════════════════════════════════════════════════════
displacement_multiplier = input.float(DEFAULT_DISPLACEMENT_MULTIPLIER, INPUT_LABEL_DISPLACEMENT_MULTIPLIER, minval=DEFAULT_DISPLACEMENT_MIN, maxval=DEFAULT_DISPLACEMENT_MAX, step=DEFAULT_STEP_SIZE, group=GROUP_IMPLIED_SOURCE, inline='implied', tooltip='C2 body size multiplier vs recent average for Implied FVG validation (1.0-5.0, step 0.1). Default: 1.25')
lookback_candles = input.int(DEFAULT_LOOKBACK_CANDLES, INPUT_LABEL_LOOKBACK_CANDLES, minval=MIN_LOOKBACK_CANDLES, maxval=MAX_LOOKBACK_CANDLES, group=GROUP_IMPLIED_SOURCE, inline='implied', tooltip='IMPLIED FVG DETECTION SETTINGS:\n\nDisplacement Multiplier (1.0-5.0, step 0.1): C2 body size multiplier vs recent average for Implied FVG validation. 1.25 recommended for CSD but 2.5 also acceptable. Higher values require larger displacement candles (more restrictive), lower values are more permissive.\n\nLookback Candles (3-5): Bars to average for displacement comparison. Higher values create more stable average, lower values are more sensitive to recent price action. Default: 4')

// CSD settings (moved up above Info Table; most important)
// CSD controls on separate rows to avoid mixed control clutter
TOOLTIP_CSD_REQUIRE = "Require an opposite-direction source gap within the lookback window for CSD to be valid."
TOOLTIP_CSD_LOOKBACK = "Bars to scan (including the Anchor Candle) for a validating opposite-direction source gap (1-20 bars). Default: 4"
csd_require_gap = input.bool(true, "Require Gap", tooltip=TOOLTIP_CSD_REQUIRE, group=GROUP_CSD)
csd_gap_lookback = input.int(CSD_LOOKBACK_DEFAULT, "Lookback (bars)", minval=CSD_LOOKBACK_MIN, maxval=CSD_LOOKBACK_MAX, tooltip=TOOLTIP_CSD_LOOKBACK, group=GROUP_CSD)
// Experimental: suppress repeated CSDs in the same direction until the opposite direction appears
TOOLTIP_CSD_SUPPRESS = "When enabled, show only the first CSD of a direction until an opposite-direction CSD occurs (suppresses choppy repeats)."
csd_suppress_repeats = input.bool(false, "Suppress Repeated Direction (experimental)", tooltip=TOOLTIP_CSD_SUPPRESS, group=GROUP_CSD)
// Lenient CSD mode
enable_lenient_csd = input.bool(false, "Enable Lenient CSD", tooltip="Check Nth candle back (configurable below) for CSD formation if immediate candle fails to form standard CSD", group=GROUP_CSD)
csd_leniency_level = input.int(CSD_LENIENCY_DEFAULT, "Leniency Level", minval=CSD_LENIENCY_MIN, maxval=CSD_LENIENCY_MAX, tooltip="Number of candles back to check for lenient CSD formation (2-5 candles). Default: 2", group=GROUP_CSD)

// Alert Settings (dual alert system)
alert_mode = input.string(ALERT_MODE_GROUPED, "Alert Mode", options=[ALERT_MODE_INDIVIDUAL, ALERT_MODE_BOTH, ALERT_MODE_GROUPED], group=GROUP_ALERT_SETTINGS, tooltip="Individual: Create alerts per condition (select a specific condition)\\nBoth: Use both individual and grouped methods; may produce duplicate notifications\\nGrouped: Create ONE alert with 'Any alert() function call' (uses checkboxes below)")
enable_csd_plus_formation = input.bool(true, CSD_PLUS, group=GROUP_ALERT_SETTINGS, inline="core1", tooltip=ALERT_TOOLTIP_PREFIX + CSD_PLUS + ALERT_TOOLTIP_SUFFIX)
enable_csd_minus_formation = input.bool(true, CSD_MINUS, group=GROUP_ALERT_SETTINGS, inline="core1", tooltip=ALERT_TOOLTIP_PREFIX + CSD_MINUS + ALERT_TOOLTIP_SUFFIX)
enable_csd_plus_lenient_formation = input.bool(true, CSD_PLUS_LENIENT, group=GROUP_ALERT_SETTINGS, inline="core2", tooltip=ALERT_TOOLTIP_PREFIX + CSD_PLUS_LENIENT + ALERT_TOOLTIP_SUFFIX)
enable_csd_minus_lenient_formation = input.bool(true, CSD_MINUS_LENIENT, group=GROUP_ALERT_SETTINGS, inline="core2", tooltip=ALERT_TOOLTIP_PREFIX + CSD_MINUS_LENIENT + ALERT_TOOLTIP_SUFFIX)

// Compact info table (shows current CSD lookback and leniency) — less used, so placed last
