gap_color = input.color(DEFAULT_SOURCE_GAP_COLOR, "Color", inline="srcv_row2", tooltip="Color for source gap rectangles", group=GROUP_SOURCE)
source_label_text_color = input.color(DEFAULT_SOURCE_LABEL_TEXT_COLOR, "Text", inline="srcv_row2", group=GROUP_SOURCE)
