// Appearance
showInternalLines = input.bool(true, LABEL_INTERNAL_LINES, group=GROUP_APPEARANCE, inline="1")
internalLinesColor = input.color(DEFAULT_INTERNAL_LINES_COLOR, "", group=GROUP_APPEARANCE, inline="1")
