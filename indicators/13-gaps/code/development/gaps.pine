const color DEFAULT_RTH_PROJECTION_COLOR = color.rgb(156, 156, 156)
const color DEFAULT_BPR_BULLISH_UNFILLED_COLOR = color.new(color.rgb(165, 214, 167), 70)
const color DEFAULT_BPR_BULLISH_FILLED_COLOR = color.new(color.rgb(200, 230, 201), 90)
const color DEFAULT_BPR_BEARISH_UNFILLED_COLOR = color.new(color.rgb(250, 161, 164), 70)
const color DEFAULT_BPR_BEARISH_FILLED_COLOR = color.new(color.rgb(252, 203, 205), 90)
const color DEFAULT_BPR_BULLISH_BOUNDARY_COLOR = color.rgb(129, 199, 132)
const color DEFAULT_BPR_BEARISH_BOUNDARY_COLOR = color.rgb(247, 82, 95)
const color DEFAULT_FVG_BULLISH_UNFILLED_COLOR = color.new(color.rgb(38, 198, 218), 90)
const color DEFAULT_FVG_BULLISH_FILLED_COLOR = color.new(color.rgb(0, 188, 212), 97)
const color DEFAULT_FVG_BEARISH_UNFILLED_COLOR = color.new(color.rgb(245, 124, 0), 87)
const color DEFAULT_FVG_BEARISH_FILLED_COLOR = color.new(color.rgb(255, 138, 101), 97)
const color DEFAULT_FVG_BULLISH_BOUNDARY_COLOR = color.rgb(128, 222, 234)
const color DEFAULT_FVG_BEARISH_BOUNDARY_COLOR = color.rgb(255, 204, 128)
