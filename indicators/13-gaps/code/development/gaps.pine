//@version=6
indicator("gaps •", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

const string TIMEZONE = "America/New_York"
const string RTH_SESSION = "0930-1615:1234567"

const string LABEL_NWOG_NDOG = "NWOG / NDOG"

const string GROUP_GENERAL = "General"
const string GROUP_RTH = "RTH Gaps"
const string GROUP_NWOG = "NWOG Gaps"
const string GROUP_NDOG = "NDOG Gaps"
const string GROUP_APPEARANCE = "Appearance"
const string GROUP_COLOR_TABLE = "Color Reference"

const string LABEL_UNFILLED = "Unfilled"
const string LABEL_FILLED = "Filled"
const string LABEL_HIDE_FILLED = "Hide Filled"
const string LABEL_INTERNAL_LINES = "Internal Lines"
const string LABEL_BORDER_LABEL = "Border + Label"
const string LABEL_UPCOMING_RTH = "Upcoming RTH"
const string LABEL_DISPLAY_MODE = "Display Mode"

const float CE_LEVEL = 0.50
const float Q1_LEVEL = 0.25
const float Q3_LEVEL = 0.75
const int RIGHT_EDGE_CUSHION = 3
const int DRAFT_OFFSET_RTH = 10
const int DRAFT_WIDTH = 10
const int FLOAT_OFFSET_RTH = 10
const int FLOAT_OFFSET_NDOG = 26
const int FLOAT_OFFSET_NWOG = 38
const int FLOAT_WIDTH = 10
const int MAX_STORED_GAPS = 80
const int MAX_BAR_TIMES = 50000
const int MILLISECONDS_PER_DAY = 86400000

const color DEFAULT_RTH_UNFILLED_COLOR = color.new(color.rgb(76, 175, 80), 85)
const color DEFAULT_RTH_FILLED_COLOR = color.new(color.rgb(99, 99, 99), 95)
const color DEFAULT_RTH_PREVIEW_COLOR = color.new(color.rgb(255, 152, 0), 85)
const color DEFAULT_RTH_BORDER_COLOR = color.rgb(128, 128, 128)
const color UPCOMING_RTH_COLOR = color.rgb(255, 193, 7)

const color DEFAULT_NWOG_UNFILLED_COLOR = color.new(color.rgb(41, 98, 255), 70)
const color DEFAULT_NWOG_FILLED_COLOR = color.new(color.rgb(99, 99, 99), 90)
const color DEFAULT_NWOG_BORDER_COLOR = color.rgb(91, 156, 246)

const color DEFAULT_NDOG_UNFILLED_COLOR = color.new(color.rgb(240, 98, 146), 75)
const color DEFAULT_NDOG_FILLED_COLOR = color.new(color.rgb(99, 99, 99), 90)
const color DEFAULT_NDOG_BORDER_COLOR = color.rgb(240, 98, 146)

const color DEFAULT_INTERNAL_LINES_COLOR = color.new(color.rgb(184, 184, 184), 40)

const color LABEL_BG_TRANSPARENT = color.new(color.rgb(255, 255, 255), 100)

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════════════

enum GapType
    rth  = "RTH"
    nwog = "NWOG"
    ndog = "NDOG"

enum EntryDir
    none
    fromBelow
    fromAbove

enum DisplayMode
    historical         = "Historical"
    historicalFloating = "Historical + Floating"
    floatingOnly       = "Floating Only"

enum QuickFilter
    all      = "All Gaps"
    rthOnly  = "RTH"
    nwogOnly = "NWOG"
    ndogOnly = "NDOG"
    rthNwog  = "RTH + NWOG"
    rthNdog  = "RTH + NDOG"
    nwogNdog = "NWOG + NDOG"

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

quickFilter = input.enum(QuickFilter.all, "Quick Filter", group=GROUP_GENERAL, tooltip="Override the individual RTH / NWOG / NDOG toggles to quickly show a preset set, forcing the chosen types on even if their toggle is off.\n\n• RTH + NWOG + NDOG: respect the individual toggles\n• Any other preset: force that set on and the rest off")
displayMode = input.enum(DisplayMode.historicalFloating, LABEL_DISPLAY_MODE, group=GROUP_GENERAL, tooltip="Historical shows normal gap boxes only. Historical + Floating also floats the most recent unfilled gap per type. Floating Only hides non-floating historical boxes while lifecycle tracking continues.")
useFloating = displayMode != DisplayMode.historical
floatingOnly = displayMode == DisplayMode.floatingOnly

// Preset membership per type; QuickFilter.all defers to the individual toggles below.
[filterRTH, filterNWOG, filterNDOG] = switch quickFilter
    QuickFilter.rthOnly  => [true, false, false]
    QuickFilter.nwogOnly => [false, true, false]
    QuickFilter.ndogOnly => [false, false, true]
    QuickFilter.rthNwog  => [true, true, false]
    QuickFilter.rthNdog  => [true, false, true]
    QuickFilter.nwogNdog => [false, true, true]
    => [true, true, true]

showRTHInput = input.bool(true, "RTH Gaps", group=GROUP_RTH, inline="rth")
rthLimit = input.int(20, "", minval=1, maxval=50, group=GROUP_RTH, inline="rth")
rthUnfilledColor = input.color(DEFAULT_RTH_UNFILLED_COLOR, LABEL_UNFILLED, group=GROUP_RTH, inline="rth_color")
rthFilledColor = input.color(DEFAULT_RTH_FILLED_COLOR, LABEL_FILLED, group=GROUP_RTH, inline="rth_color")
showRTHDraft = input.bool(true, LABEL_UPCOMING_RTH, group=GROUP_RTH, inline="rth_preview")
rthPreviewColor = input.color(DEFAULT_RTH_PREVIEW_COLOR, "", group=GROUP_RTH, inline="rth_preview")
rthBorderColor = input.color(DEFAULT_RTH_BORDER_COLOR, LABEL_BORDER_LABEL, group=GROUP_RTH, inline="rth_border")
hideFilledRTH = input.bool(false, LABEL_HIDE_FILLED, group=GROUP_RTH, inline="rth_border")
preserveTodayFilledRTH = input.bool(true, "Preserve Today", group=GROUP_RTH, inline="rth_today", tooltip="Keep the current trading day RTH gap visible in its anchored historical position even after it fills. This is a display exception, not a floating rule: in Floating Only it stays anchored while a still-open RTH continues to float.")
nearestRTHCount = input.int(0, "Float Nearest Unfilled", minval=0, maxval=10, group=GROUP_RTH, inline="rth_nearest", tooltip="Floats the N unfilled RTH gaps closest to price (either direction), in addition to the most-recent RTH float. 0 = off. Requires a floating Display Mode.")
rthFloatDistinctColors = input.bool(true, "Distinct Float Colors", group=GROUP_RTH, inline="rth_distinct", tooltip="Give each floating RTH gap its own border and label color, cycled from a fixed palette, so nested floats in the column can be told apart. Off = every RTH float uses the RTH border color.")

showNWOGInput = input.bool(true, "NWOG Gaps", group=GROUP_NWOG, inline="nwog")
nwogLimit = input.int(10, "", minval=1, maxval=50, group=GROUP_NWOG, inline="nwog")
nwogUnfilledColor = input.color(DEFAULT_NWOG_UNFILLED_COLOR, LABEL_UNFILLED, group=GROUP_NWOG, inline="nwog_color")
nwogFilledColor = input.color(DEFAULT_NWOG_FILLED_COLOR, LABEL_FILLED, group=GROUP_NWOG, inline="nwog_color")
nwogBorderColor = input.color(DEFAULT_NWOG_BORDER_COLOR, LABEL_BORDER_LABEL, group=GROUP_NWOG, inline="nwog_border")
hideFilledNWOG = input.bool(false, LABEL_HIDE_FILLED, group=GROUP_NWOG, inline="nwog_border")

showNDOGInput = input.bool(true, "NDOG Gaps", group=GROUP_NDOG, inline="ndog")
ndogLimit = input.int(10, "", minval=1, maxval=50, group=GROUP_NDOG, inline="ndog")
ndogUnfilledColor = input.color(DEFAULT_NDOG_UNFILLED_COLOR, LABEL_UNFILLED, group=GROUP_NDOG, inline="ndog_color")
ndogFilledColor = input.color(DEFAULT_NDOG_FILLED_COLOR, LABEL_FILLED, group=GROUP_NDOG, inline="ndog_color")
ndogBorderColor = input.color(DEFAULT_NDOG_BORDER_COLOR, LABEL_BORDER_LABEL, group=GROUP_NDOG, inline="ndog_border")
hideFilledNDOG = input.bool(false, LABEL_HIDE_FILLED, group=GROUP_NDOG, inline="ndog_border")

showLabels = input.bool(true, "Date Label", group=GROUP_APPEARANCE, inline="appearance")
showInternalLines = input.bool(true, LABEL_INTERNAL_LINES, group=GROUP_APPEARANCE, inline="internals")
internalLinesColor = input.color(DEFAULT_INTERNAL_LINES_COLOR, "", group=GROUP_APPEARANCE, inline="internals")

showColorTable = input.bool(false, "Show Color Reference Table", group=GROUP_COLOR_TABLE)

// Effective per-type visibility: QuickFilter.all respects the toggle, any other preset forces it.
showRTH = quickFilter == QuickFilter.all ? showRTHInput : filterRTH
showNWOG = quickFilter == QuickFilter.all ? showNWOGInput : filterNWOG
showNDOG = quickFilter == QuickFilter.all ? showNDOGInput : filterNDOG

// ═══════════════════════════════════════════════════════════════════════════════
// RUNTIME CONTEXT
// ═══════════════════════════════════════════════════════════════════════════════

barMs = timeframe.in_seconds(timeframe.period) * 1000
isValidTimeframe = timeframe.in_seconds(timeframe.period) >= timeframe.in_seconds("1") and timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds("15")
inRTH = isValidTimeframe and not na(time(timeframe.period, RTH_SESSION, TIMEZONE))
rthStart = inRTH and not inRTH[1]
rthEnd = not inRTH and inRTH[1]
barHour = hour(time, TIMEZONE)
prevBarHour = nz(hour(time[1], TIMEZONE))
isSessionOpen = isValidTimeframe and barHour == 18 and prevBarHour != 18
isSunday = dayofweek(time, TIMEZONE) == dayofweek.sunday

// ═══════════════════════════════════════════════════════════════════════════════
// MODEL
// ═══════════════════════════════════════════════════════════════════════════════

type GapRecord
    GapType gapType
    float top
    float bottom
    int creationBar
    int creationTime
    int leftTime
    int nextSessionTime
    int nextSessionBar
    int fillTime
    int fillBar
    bool filled
    EntryDir entryDirection
    float penetrationLevel
    bool sharesGeometry
    box topUnfilledBox
    box filledBox
    box bottomUnfilledBox
    line ceLine
    line q1Line
    line q3Line
    line topBorderLine
    line bottomBorderLine
    label dateLabel

type DraftGap
    float top
    float bottom
    int creationTime
    box bodyBox
    line topBorderLine
    line bottomBorderLine
    label dateLabel

type FloatingGap
    box topUnfilledBox
    box filledBox
    box bottomUnfilledBox
    line ceLine
    line q1Line
    line q3Line
    line topBorderLine
    line bottomBorderLine
    label dateLabel

var array<GapRecord> gaps = array.new<GapRecord>()
var float rthClosePrice = na
var DraftGap rthDraft = na
var FloatingGap floatingRTH = na
var FloatingGap floatingNWOG = na
var FloatingGap floatingNDOG = na
var array<FloatingGap> nearestRTHFloats = array.new<FloatingGap>()
var array<int> chartBarTimes = array.new<int>()
var int chartBarTimesOffset = 0

// Map of bar_index -> bar time, capped so very long / low-timeframe histories stay under
// Pine's 100k array limit. chartBarTimesOffset tracks how many leading bars were dropped.
if barstate.isnew
    array.push(chartBarTimes, time)
    if array.size(chartBarTimes) > MAX_BAR_TIMES
        array.shift(chartBarTimes)
        chartBarTimesOffset += 1

// ═══════════════════════════════════════════════════════════════════════════════
// TEXT HELPERS
// ═══════════════════════════════════════════════════════════════════════════════

getMonthName(int monthNum) =>
    switch monthNum
        1 => "Jan"
        2 => "Feb"
        3 => "Mar"
        4 => "Apr"
        5 => "May"
        6 => "Jun"
        7 => "Jul"
        8 => "Aug"
        9 => "Sep"
        10 => "Oct"
        11 => "Nov"
        => "Dec"

formatGapDate(int timestamp) =>
    getMonthName(month(timestamp, TIMEZONE)) + " " + str.tostring(dayofmonth(timestamp, TIMEZONE)) + ", " + str.tostring(year(timestamp, TIMEZONE))

getNextRthDate(int timestamp) =>
    timestampDow = dayofweek(timestamp, TIMEZONE)
    daysToAdd = timestampDow == dayofweek.friday ? 3 : 1
    timestamp + daysToAdd * MILLISECONDS_PER_DAY

// Sunday opens create a coincident NWOG and NDOG at identical prices. The pair is flagged once
// at creation (sharesGeometry), so display-time checks are O(1) instead of scanning every gap.
// NWOG owns the shared visual when NWOG display is enabled.
isSharedNdogGeometry(GapRecord gap) =>
    gap.gapType == GapType.ndog and gap.sharesGeometry and showNWOG

getGapLabelPrefix(GapRecord gap) =>
    gap.gapType == GapType.nwog and gap.sharesGeometry and showNDOG ? LABEL_NWOG_NDOG : str.tostring(gap.gapType)

getFillPercent(GapRecord gap) =>
    gapRange = gap.top - gap.bottom
    if gapRange <= 0 or na(gap.penetrationLevel)
        0
    else
        rawPercent = gap.entryDirection == EntryDir.fromBelow ? (gap.penetrationLevel - gap.bottom) / gapRange * 100 : (gap.top - gap.penetrationLevel) / gapRange * 100
        int(math.round(math.max(0, math.min(100, rawPercent))))

getGapLabel(GapRecord gap) =>
    prefix = getGapLabelPrefix(gap)
    fillSuffix = gap.filled ? " ✓" : not na(gap.penetrationLevel) ? " " + str.tostring(getFillPercent(gap), "#") + "%" : ""
    prefix + fillSuffix + "\n" + formatGapDate(gap.creationTime)

getDraftLabel(DraftGap draft) =>
    LABEL_UPCOMING_RTH + "\n" + formatGapDate(getNextRthDate(draft.creationTime))

// ═══════════════════════════════════════════════════════════════════════════════
// COLOR DISPATCH
// ═══════════════════════════════════════════════════════════════════════════════

getUnfilledColor(GapType gapType) =>
    switch gapType
        GapType.nwog => nwogUnfilledColor
        GapType.ndog => ndogUnfilledColor
        => rthUnfilledColor

getFilledColor(GapType gapType) =>
    switch gapType
        GapType.nwog => nwogFilledColor
        GapType.ndog => ndogFilledColor
        => rthFilledColor

getBorderColor(GapType gapType) =>
    switch gapType
        GapType.nwog => nwogBorderColor
        GapType.ndog => ndogBorderColor
        => rthBorderColor

floatPaletteColor(int slot) =>
    switch slot % 5
        0 => color.rgb(76, 175, 80)
        1 => color.rgb(156, 39, 176)
        2 => color.rgb(0, 150, 136)
        3 => color.rgb(121, 85, 72)
        => color.rgb(183, 28, 28)

getFloatOffset(GapType gapType) =>
    switch gapType
        GapType.nwog => FLOAT_OFFSET_NWOG
        GapType.ndog => FLOAT_OFFSET_NDOG
        => FLOAT_OFFSET_RTH

// ═══════════════════════════════════════════════════════════════════════════════
// BOX GEOMETRY
// ═══════════════════════════════════════════════════════════════════════════════

// Returns [topBoxTop, topBoxBottom, fillBoxTop, fillBoxBottom, botBoxTop, botBoxBottom]
getBoxGeometry(EntryDir entryDir, float penLevel, float top, float bottom) =>
    if entryDir == EntryDir.fromBelow and not na(penLevel)
        [top, penLevel, penLevel, bottom, bottom, bottom]
    else if entryDir == EntryDir.fromAbove and not na(penLevel)
        [top, top, top, penLevel, penLevel, bottom]
    else
        [top, bottom, bottom, bottom, bottom, bottom]

// ═══════════════════════════════════════════════════════════════════════════════
// DRAWING LIFECYCLE
// ═══════════════════════════════════════════════════════════════════════════════

createGapRecord(GapType gapType, float topPrice, float bottomPrice, int eventTime) =>
    GapRecord.new(
         gapType=gapType,
         top=topPrice,
         bottom=bottomPrice,
         creationBar=bar_index,
         creationTime=eventTime,
         leftTime=eventTime,
         nextSessionTime=na,
         nextSessionBar=na,
         fillTime=na,
         fillBar=na,
         filled=false,
         entryDirection=EntryDir.none,
         penetrationLevel=na,
         sharesGeometry=false)

// Drawing objects are allocated lazily, only when a gap is actually rendered historically.
// This bounds live boxes/lines/labels to the displayed set instead of every stored gap,
// keeping the script well under the 500-object pool caps under normal limits.
ensureGapDrawings(GapRecord gap) =>
    if na(gap.topUnfilledBox)
        gapRange = gap.top - gap.bottom
        midPrice = gap.bottom + gapRange * CE_LEVEL
        q1Price = gap.bottom + gapRange * Q1_LEVEL
        q3Price = gap.bottom + gapRange * Q3_LEVEL
        unfilledClr = getUnfilledColor(gap.gapType)
        borderClr = getBorderColor(gap.gapType)
        gap.topUnfilledBox := box.new(gap.leftTime, gap.top, gap.leftTime, gap.bottom, xloc=xloc.bar_time, bgcolor=unfilledClr, border_color=na)
        gap.filledBox := box.new(gap.leftTime, gap.bottom, gap.leftTime, gap.bottom, xloc=xloc.bar_time, bgcolor=na, border_color=na)
        gap.bottomUnfilledBox := box.new(gap.leftTime, gap.bottom, gap.leftTime, gap.bottom, xloc=xloc.bar_time, bgcolor=na, border_color=na)
        gap.ceLine := line.new(gap.leftTime, midPrice, gap.leftTime, midPrice, xloc=xloc.bar_time, color=internalLinesColor, style=line.style_dotted)
        gap.q1Line := line.new(gap.leftTime, q1Price, gap.leftTime, q1Price, xloc=xloc.bar_time, color=internalLinesColor, style=line.style_dotted)
        gap.q3Line := line.new(gap.leftTime, q3Price, gap.leftTime, q3Price, xloc=xloc.bar_time, color=internalLinesColor, style=line.style_dotted)
        gap.topBorderLine := line.new(gap.leftTime, gap.top, gap.leftTime, gap.top, xloc=xloc.bar_time, color=borderClr, style=line.style_solid)
        gap.bottomBorderLine := line.new(gap.leftTime, gap.bottom, gap.leftTime, gap.bottom, xloc=xloc.bar_time, color=borderClr, style=line.style_solid)
        gap.dateLabel := label.new(gap.leftTime, gap.bottom, "", xloc=xloc.bar_time, yloc=yloc.price, color=LABEL_BG_TRANSPARENT, textcolor=borderClr, style=label.style_label_up, size=size.tiny, textalign=text.align_center)

createRthDraft(float closePrice) =>
    draftTop = math.max(closePrice, close)
    draftBottom = math.min(closePrice, close)
    leftBar = bar_index + DRAFT_OFFSET_RTH
    rightBar = leftBar + DRAFT_WIDTH
    bodyBox = box.new(leftBar, draftTop, rightBar, draftBottom, xloc=xloc.bar_index, bgcolor=rthPreviewColor, border_color=na)
    topBorder = line.new(leftBar, draftTop, rightBar, draftTop, xloc=xloc.bar_index, color=UPCOMING_RTH_COLOR, style=line.style_solid)
    bottomBorder = line.new(leftBar, draftBottom, rightBar, draftBottom, xloc=xloc.bar_index, color=UPCOMING_RTH_COLOR, style=line.style_solid)
    draftLabel = label.new(math.round((leftBar + rightBar) / 2), draftBottom, "", xloc=xloc.bar_index, yloc=yloc.price, color=LABEL_BG_TRANSPARENT, textcolor=rthBorderColor, style=label.style_label_up, size=size.tiny, textalign=text.align_center)

    DraftGap.new(
         top=draftTop,
         bottom=draftBottom,
         creationTime=time,
         bodyBox=bodyBox,
         topBorderLine=topBorder,
         bottomBorderLine=bottomBorder,
         dateLabel=draftLabel)

createFloatingGap(GapRecord gap) =>
    leftBar = bar_index + getFloatOffset(gap.gapType)
    rightBar = leftBar + FLOAT_WIDTH
    gapRange = gap.top - gap.bottom
    midPrice = gap.bottom + gapRange * CE_LEVEL
    q1Price = gap.bottom + gapRange * Q1_LEVEL
    q3Price = gap.bottom + gapRange * Q3_LEVEL
    unfilledClr = getUnfilledColor(gap.gapType)
    borderClr = getBorderColor(gap.gapType)

    topBox = box.new(leftBar, gap.top, rightBar, gap.bottom, xloc=xloc.bar_index, bgcolor=unfilledClr, border_color=na)
    filledBox = box.new(leftBar, gap.bottom, rightBar, gap.bottom, xloc=xloc.bar_index, bgcolor=na, border_color=na)
    bottomBox = box.new(leftBar, gap.bottom, rightBar, gap.bottom, xloc=xloc.bar_index, bgcolor=na, border_color=na)
    ceLine = line.new(leftBar, midPrice, rightBar, midPrice, xloc=xloc.bar_index, color=internalLinesColor, style=line.style_dotted)
    q1Line = line.new(leftBar, q1Price, rightBar, q1Price, xloc=xloc.bar_index, color=internalLinesColor, style=line.style_dotted)
    q3Line = line.new(leftBar, q3Price, rightBar, q3Price, xloc=xloc.bar_index, color=internalLinesColor, style=line.style_dotted)
    topBorder = line.new(leftBar, gap.top, rightBar, gap.top, xloc=xloc.bar_index, color=borderClr, style=line.style_solid)
    bottomBorder = line.new(leftBar, gap.bottom, rightBar, gap.bottom, xloc=xloc.bar_index, color=borderClr, style=line.style_solid)
    floatingLabel = label.new(math.round((leftBar + rightBar) / 2), gap.bottom, "", xloc=xloc.bar_index, yloc=yloc.price, color=LABEL_BG_TRANSPARENT, textcolor=borderClr, style=label.style_label_up, size=size.tiny, textalign=text.align_center)

    FloatingGap.new(
         topUnfilledBox=topBox,
         filledBox=filledBox,
         bottomUnfilledBox=bottomBox,
         ceLine=ceLine,
         q1Line=q1Line,
         q3Line=q3Line,
         topBorderLine=topBorder,
         bottomBorderLine=bottomBorder,
         dateLabel=floatingLabel)

// Frees a gap's drawing objects back to the pool and resets handles so they can be lazily
// recreated if the gap becomes visible again. Safe to call on a gap with no live drawings.
releaseGapDrawings(GapRecord gap) =>
    if not na(gap.topUnfilledBox)
        box.delete(gap.topUnfilledBox)
        gap.topUnfilledBox := na
    if not na(gap.filledBox)
        box.delete(gap.filledBox)
        gap.filledBox := na
    if not na(gap.bottomUnfilledBox)
        box.delete(gap.bottomUnfilledBox)
        gap.bottomUnfilledBox := na
    if not na(gap.ceLine)
        line.delete(gap.ceLine)
        gap.ceLine := na
    if not na(gap.q1Line)
        line.delete(gap.q1Line)
        gap.q1Line := na
    if not na(gap.q3Line)
        line.delete(gap.q3Line)
        gap.q3Line := na
    if not na(gap.topBorderLine)
        line.delete(gap.topBorderLine)
        gap.topBorderLine := na
    if not na(gap.bottomBorderLine)
        line.delete(gap.bottomBorderLine)
        gap.bottomBorderLine := na
    if not na(gap.dateLabel)
        label.delete(gap.dateLabel)
        gap.dateLabel := na

deleteDraftDrawings(DraftGap draft) =>
    box.delete(draft.bodyBox)
    line.delete(draft.topBorderLine)
    line.delete(draft.bottomBorderLine)
    label.delete(draft.dateLabel)

hideDraftDrawings(DraftGap draft) =>
    box.set_bgcolor(draft.bodyBox, na)
    line.set_color(draft.topBorderLine, na)
    line.set_color(draft.bottomBorderLine, na)
    label.set_text(draft.dateLabel, "")

updateRthDraft(DraftGap draft, float closePrice) =>
    draft.top := math.max(closePrice, close)
    draft.bottom := math.min(closePrice, close)
    leftBar = bar_index + DRAFT_OFFSET_RTH
    rightBar = leftBar + DRAFT_WIDTH
    centerBar = math.round((leftBar + rightBar) / 2)

    box.set_left(draft.bodyBox, leftBar)
    box.set_right(draft.bodyBox, rightBar)
    box.set_top(draft.bodyBox, draft.top)
    box.set_bottom(draft.bodyBox, draft.bottom)
    box.set_bgcolor(draft.bodyBox, rthPreviewColor)

    line.set_x1(draft.topBorderLine, leftBar)
    line.set_x2(draft.topBorderLine, rightBar)
    line.set_y1(draft.topBorderLine, draft.top)
    line.set_y2(draft.topBorderLine, draft.top)
    line.set_color(draft.topBorderLine, UPCOMING_RTH_COLOR)

    line.set_x1(draft.bottomBorderLine, leftBar)
    line.set_x2(draft.bottomBorderLine, rightBar)
    line.set_y1(draft.bottomBorderLine, draft.bottom)
    line.set_y2(draft.bottomBorderLine, draft.bottom)
    line.set_color(draft.bottomBorderLine, UPCOMING_RTH_COLOR)

    label.set_x(draft.dateLabel, centerBar)
    label.set_y(draft.dateLabel, draft.bottom)
    label.set_text(draft.dateLabel, showLabels ? getDraftLabel(draft) : "")
    label.set_textcolor(draft.dateLabel, rthBorderColor)

hideFloatingDrawings(FloatingGap floating) =>
    box.set_bgcolor(floating.topUnfilledBox, na)
    box.set_bgcolor(floating.filledBox, na)
    box.set_bgcolor(floating.bottomUnfilledBox, na)
    line.set_color(floating.ceLine, na)
    line.set_color(floating.q1Line, na)
    line.set_color(floating.q3Line, na)
    line.set_color(floating.topBorderLine, na)
    line.set_color(floating.bottomBorderLine, na)
    label.set_text(floating.dateLabel, "")

updateFloating(FloatingGap floating, GapRecord gap, color borderOverride = na) =>
    leftBar = bar_index + getFloatOffset(gap.gapType)
    rightBar = leftBar + FLOAT_WIDTH
    centerBar = math.round((leftBar + rightBar) / 2)
    gapRange = gap.top - gap.bottom
    midPrice = gap.bottom + gapRange * CE_LEVEL
    q1Price = gap.bottom + gapRange * Q1_LEVEL
    q3Price = gap.bottom + gapRange * Q3_LEVEL
    [tTop, tBot, fTop, fBot, bTop, bBot] = getBoxGeometry(gap.entryDirection, gap.penetrationLevel, gap.top, gap.bottom)
    unfilledClr = getUnfilledColor(gap.gapType)
    filledClr = getFilledColor(gap.gapType)
    borderClr = na(borderOverride) ? getBorderColor(gap.gapType) : borderOverride

    box.set_left(floating.topUnfilledBox, leftBar)
    box.set_right(floating.topUnfilledBox, rightBar)
    box.set_top(floating.topUnfilledBox, tTop)
    box.set_bottom(floating.topUnfilledBox, tBot)
    box.set_bgcolor(floating.topUnfilledBox, tTop != tBot ? unfilledClr : na)

    box.set_left(floating.filledBox, leftBar)
    box.set_right(floating.filledBox, rightBar)
    box.set_top(floating.filledBox, fTop)
    box.set_bottom(floating.filledBox, fBot)
    box.set_bgcolor(floating.filledBox, fTop != fBot ? filledClr : na)

    box.set_left(floating.bottomUnfilledBox, leftBar)
    box.set_right(floating.bottomUnfilledBox, rightBar)
    box.set_top(floating.bottomUnfilledBox, bTop)
    box.set_bottom(floating.bottomUnfilledBox, bBot)
    box.set_bgcolor(floating.bottomUnfilledBox, bTop != bBot ? unfilledClr : na)

    line.set_x1(floating.ceLine, leftBar)
    line.set_x2(floating.ceLine, rightBar)
    line.set_y1(floating.ceLine, midPrice)
    line.set_y2(floating.ceLine, midPrice)
    line.set_color(floating.ceLine, showInternalLines ? internalLinesColor : na)
    line.set_x1(floating.q1Line, leftBar)
    line.set_x2(floating.q1Line, rightBar)
    line.set_y1(floating.q1Line, q1Price)
    line.set_y2(floating.q1Line, q1Price)
    line.set_color(floating.q1Line, showInternalLines ? internalLinesColor : na)
    line.set_x1(floating.q3Line, leftBar)
    line.set_x2(floating.q3Line, rightBar)
    line.set_y1(floating.q3Line, q3Price)
    line.set_y2(floating.q3Line, q3Price)
    line.set_color(floating.q3Line, showInternalLines ? internalLinesColor : na)

    line.set_x1(floating.topBorderLine, leftBar)
    line.set_x2(floating.topBorderLine, rightBar)
    line.set_y1(floating.topBorderLine, gap.top)
    line.set_y2(floating.topBorderLine, gap.top)
    line.set_color(floating.topBorderLine, borderClr)
    line.set_x1(floating.bottomBorderLine, leftBar)
    line.set_x2(floating.bottomBorderLine, rightBar)
    line.set_y1(floating.bottomBorderLine, gap.bottom)
    line.set_y2(floating.bottomBorderLine, gap.bottom)
    line.set_color(floating.bottomBorderLine, borderClr)

    label.set_x(floating.dateLabel, centerBar)
    label.set_y(floating.dateLabel, gap.bottom)
    label.set_text(floating.dateLabel, showLabels ? getGapLabel(gap) : "")
    label.set_textcolor(floating.dateLabel, getBorderColor(gap.gapType))

applyGapColors(GapRecord gap) =>
    [tTop, tBot, fTop, fBot, bTop, bBot] = getBoxGeometry(gap.entryDirection, gap.penetrationLevel, gap.top, gap.bottom)
    unfilledClr = getUnfilledColor(gap.gapType)
    filledClr = getFilledColor(gap.gapType)
    borderClr = getBorderColor(gap.gapType)

    box.set_top(gap.topUnfilledBox, tTop)
    box.set_bottom(gap.topUnfilledBox, tBot)
    box.set_bgcolor(gap.topUnfilledBox, tTop != tBot ? unfilledClr : na)
    box.set_top(gap.filledBox, fTop)
    box.set_bottom(gap.filledBox, fBot)
    box.set_bgcolor(gap.filledBox, fTop != fBot ? filledClr : na)
    box.set_top(gap.bottomUnfilledBox, bTop)
    box.set_bottom(gap.bottomUnfilledBox, bBot)
    box.set_bgcolor(gap.bottomUnfilledBox, bTop != bBot ? unfilledClr : na)

    if not na(gap.ceLine)
        line.set_color(gap.ceLine, showInternalLines ? internalLinesColor : na)
    if not na(gap.q1Line)
        line.set_color(gap.q1Line, showInternalLines ? internalLinesColor : na)
    if not na(gap.q3Line)
        line.set_color(gap.q3Line, showInternalLines ? internalLinesColor : na)
    line.set_color(gap.topBorderLine, borderClr)
    line.set_color(gap.bottomBorderLine, borderClr)

// Confirmed labels are centered by bar count, then converted to an actual bar timestamp.
// This avoids weekend/holiday timestamp gaps without using old bar_index drawing anchors.
resolveRightBar(GapRecord gap) =>
    liveRightBar = bar_index + RIGHT_EDGE_CUSHION
    if not gap.filled
        liveRightBar
    else if not na(gap.nextSessionBar) and not na(gap.fillBar)
        math.max(gap.fillBar, gap.nextSessionBar)
    else if not na(gap.nextSessionBar)
        gap.nextSessionBar
    else
        liveRightBar

getBarTimeByIndex(int targetBar) =>
    lastStoredBar = array.size(chartBarTimes) - 1
    if lastStoredBar < 0
        time
    else
        relativeBar = targetBar - chartBarTimesOffset
        safeBar = math.max(0, math.min(relativeBar, lastStoredBar))
        array.get(chartBarTimes, safeBar)

resolveLabelTime(GapRecord gap) =>
    rightBar = resolveRightBar(gap)
    safeRightBar = rightBar > gap.creationBar ? rightBar : gap.creationBar + 1
    centeredBar = math.round((gap.creationBar + safeRightBar) / 2)
    getBarTimeByIndex(math.min(centeredBar, bar_index))

setGapRightEdge(GapRecord gap, int rightTime) =>
    box.set_left(gap.topUnfilledBox, gap.leftTime)
    box.set_right(gap.topUnfilledBox, rightTime)
    box.set_left(gap.filledBox, gap.leftTime)
    box.set_right(gap.filledBox, rightTime)
    box.set_left(gap.bottomUnfilledBox, gap.leftTime)
    box.set_right(gap.bottomUnfilledBox, rightTime)

    line.set_x1(gap.topBorderLine, gap.leftTime)
    line.set_x2(gap.topBorderLine, rightTime)
    line.set_x1(gap.bottomBorderLine, gap.leftTime)
    line.set_x2(gap.bottomBorderLine, rightTime)
    if not na(gap.ceLine)
        line.set_x1(gap.ceLine, gap.leftTime)
        line.set_x2(gap.ceLine, rightTime)
    if not na(gap.q1Line)
        line.set_x1(gap.q1Line, gap.leftTime)
        line.set_x2(gap.q1Line, rightTime)
    if not na(gap.q3Line)
        line.set_x1(gap.q3Line, gap.leftTime)
        line.set_x2(gap.q3Line, rightTime)

    if not na(gap.dateLabel)
        label.set_x(gap.dateLabel, resolveLabelTime(gap))
        label.set_y(gap.dateLabel, gap.bottom)
        label.set_text(gap.dateLabel, showLabels ? getGapLabel(gap) : "")
        label.set_textcolor(gap.dateLabel, getBorderColor(gap.gapType))

// ═══════════════════════════════════════════════════════════════════════════════
// LIFECYCLE
// ═══════════════════════════════════════════════════════════════════════════════

resolveRightEdge(GapRecord gap) =>
    liveRightTime = time + RIGHT_EDGE_CUSHION * barMs
    if not gap.filled
        liveRightTime
    else if not na(gap.nextSessionTime) and not na(gap.fillTime)
        math.max(gap.fillTime, gap.nextSessionTime)
    else if not na(gap.nextSessionTime)
        gap.nextSessionTime
    else
        liveRightTime

updateGapFill(GapRecord gap) =>
    if gap.entryDirection == EntryDir.none
        if high >= gap.bottom and low <= gap.bottom
            gap.entryDirection := EntryDir.fromBelow
        else if low <= gap.top and high >= gap.top
            gap.entryDirection := EntryDir.fromAbove

    if not gap.filled
        if gap.entryDirection == EntryDir.fromBelow
            if high >= gap.bottom and high <= gap.top
                gap.penetrationLevel := na(gap.penetrationLevel) ? high : math.max(gap.penetrationLevel, high)
            if high >= gap.top
                gap.penetrationLevel := gap.top
                gap.fillTime := time
                gap.fillBar := bar_index
                gap.filled := true
        else if gap.entryDirection == EntryDir.fromAbove
            if low <= gap.top and low >= gap.bottom
                gap.penetrationLevel := na(gap.penetrationLevel) ? low : math.min(gap.penetrationLevel, low)
            if low <= gap.bottom
                gap.penetrationLevel := gap.bottom
                gap.fillTime := time
                gap.fillBar := bar_index
                gap.filled := true

markNextSessionForOpenGaps(GapType gapType, int sessionTime) =>
    if array.size(gaps) > 0
        for i = 0 to array.size(gaps) - 1
            gap = array.get(gaps, i)
            if gap.gapType == gapType and gap.creationTime < sessionTime and na(gap.nextSessionTime)
                gap.nextSessionTime := sessionTime
                gap.nextSessionBar := bar_index

countStoredGaps(GapType gapType) =>
    count = 0
    if array.size(gaps) > 0
        for i = 0 to array.size(gaps) - 1
            gap = array.get(gaps, i)
            if gap.gapType == gapType
                count += 1
    count

trimStoredGaps(GapType gapType) =>
    if countStoredGaps(gapType) > MAX_STORED_GAPS
        for i = 0 to array.size(gaps) - 1
            gap = array.get(gaps, i)
            if gap.gapType == gapType
                releaseGapDrawings(gap)
                array.remove(gaps, i)
                break

isTodayRTHGap(GapRecord gap) =>
    gap.gapType == GapType.rth and dayofmonth(gap.creationTime, TIMEZONE) == dayofmonth(time, TIMEZONE) and month(gap.creationTime, TIMEZONE) == month(time, TIMEZONE) and year(gap.creationTime, TIMEZONE) == year(time, TIMEZONE)

shouldPreserveTodayFilledRTH(GapRecord gap) =>
    preserveTodayFilledRTH and gap.filled and isTodayRTHGap(gap)

shouldDisplayGap(GapRecord gap) =>
    switch gap.gapType
        GapType.rth => showRTH and (not gap.filled or not hideFilledRTH or shouldPreserveTodayFilledRTH(gap))
        GapType.nwog => showNWOG and not (hideFilledNWOG and gap.filled)
        GapType.ndog => showNDOG and not (hideFilledNDOG and gap.filled)
        => false

getDisplayLimit(GapType gapType) =>
    switch gapType
        GapType.nwog => nwogLimit
        GapType.ndog => ndogLimit
        => rthLimit

shouldFloatGap(GapRecord gap, int mostRecentUnfilledBar) =>
    useFloating and not gap.filled and gap.creationBar == mostRecentUnfilledBar

// ═══════════════════════════════════════════════════════════════════════════════
// DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

if rthEnd
    rthClosePrice := close[1]
    if not na(rthDraft)
        deleteDraftDrawings(rthDraft)
    rthDraft := showRTH and showRTHDraft ? createRthDraft(rthClosePrice) : na

if not inRTH and not na(rthDraft) and not na(rthClosePrice)
    if showRTH and showRTHDraft
        updateRthDraft(rthDraft, rthClosePrice)
    else
        hideDraftDrawings(rthDraft)

if rthStart
    markNextSessionForOpenGaps(GapType.rth, time)
    if not na(rthClosePrice) and open != rthClosePrice
        gapTop = math.max(rthClosePrice, open)
        gapBottom = math.min(rthClosePrice, open)
        array.push(gaps, createGapRecord(GapType.rth, gapTop, gapBottom, time))
        trimStoredGaps(GapType.rth)
    if not na(rthDraft)
        deleteDraftDrawings(rthDraft)
        rthDraft := na

// NDOG + NWOG detection at 18:00 session open
// Mark next session for open gaps BEFORE creating new ones (same pattern as RTH)
if isSessionOpen
    markNextSessionForOpenGaps(GapType.ndog, time)
    if isSunday
        markNextSessionForOpenGaps(GapType.nwog, time)

    // close[1] is the last bar before the 17:00-18:00 break (session close)
    priorClose = close[1]
    if not na(priorClose) and open != priorClose
        gapTop = math.max(priorClose, open)
        gapBottom = math.min(priorClose, open)

        // Sunday opens create a coincident NWOG + NDOG at identical prices; flag both as shared.
        if isSunday
            nwogGap = createGapRecord(GapType.nwog, gapTop, gapBottom, time)
            nwogGap.sharesGeometry := true
            array.push(gaps, nwogGap)
            trimStoredGaps(GapType.nwog)

        // NDOG on every session open
        ndogGap = createGapRecord(GapType.ndog, gapTop, gapBottom, time)
        ndogGap.sharesGeometry := isSunday
        array.push(gaps, ndogGap)
        trimStoredGaps(GapType.ndog)

// ═══════════════════════════════════════════════════════════════════════════════
// STATE PASS
// ═══════════════════════════════════════════════════════════════════════════════

if array.size(gaps) > 0
    for i = 0 to array.size(gaps) - 1
        gap = array.get(gaps, i)
        if not gap.filled
            updateGapFill(gap)

// ═══════════════════════════════════════════════════════════════════════════════
// RENDER PASS
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.islast
    floatingRTHRendered = false
    floatingNWOGRendered = false
    floatingNDOGRendered = false
    nearestRTHRendered = 0

    // Floating selection tracks only still-open gaps per type. Filled gaps never float;
    // preserved filled-today RTH is a separate anchored-display exception, handled in the render branch.
    mostRecentUnfilledRTH = -1
    mostRecentUnfilledNWOG = -1
    mostRecentUnfilledNDOG = -1

    if array.size(gaps) > 0
        for i = 0 to array.size(gaps) - 1
            gap = array.get(gaps, i)
            if not gap.filled and gap.gapType == GapType.rth and gap.creationBar > mostRecentUnfilledRTH
                mostRecentUnfilledRTH := gap.creationBar
            else if not gap.filled and gap.gapType == GapType.nwog and gap.creationBar > mostRecentUnfilledNWOG
                mostRecentUnfilledNWOG := gap.creationBar
            else if not gap.filled and gap.gapType == GapType.ndog and not isSharedNdogGeometry(gap) and gap.creationBar > mostRecentUnfilledNDOG
                mostRecentUnfilledNDOG := gap.creationBar

        // Nearest-to-price RTH selection: rank still-open RTH gaps by absolute distance to price
        // (0 when price sits inside the gap), then keep the N closest. Direction-agnostic by design —
        // the trader should not have to reason about above vs below. Gated to floating Display Modes,
        // since this is a float; the most-recent unfilled RTH is excluded so it is never drawn twice.
        nearestRTHBars = array.new<int>()
        if useFloating and showRTH and nearestRTHCount > 0
            candidateIdx = array.new<int>()
            candidateDist = array.new<float>()
            for i = 0 to array.size(gaps) - 1
                gap = array.get(gaps, i)
                if gap.gapType == GapType.rth and not gap.filled and gap.creationBar != mostRecentUnfilledRTH
                    float dist = close <= gap.top and close >= gap.bottom ? 0.0 : math.min(math.abs(close - gap.top), math.abs(close - gap.bottom))
                    array.push(candidateIdx, i)
                    array.push(candidateDist, dist)
            int picks = math.min(nearestRTHCount, array.size(candidateIdx))
            if picks > 0
                for n = 1 to picks
                    float minDist = 1e18
                    int minPos = -1
                    for j = 0 to array.size(candidateDist) - 1
                        if array.get(candidateDist, j) < minDist
                            minDist := array.get(candidateDist, j)
                            minPos := j
                    if minPos >= 0
                        array.push(nearestRTHBars, array.get(gaps, array.get(candidateIdx, minPos)).creationBar)
                        array.set(candidateDist, minPos, 1e18)

        displayedRTH = 0
        displayedNWOG = 0
        displayedNDOG = 0
        for i = array.size(gaps) - 1 to 0
            gap = array.get(gaps, i)
            if isSharedNdogGeometry(gap)
                releaseGapDrawings(gap)
                continue

            canDisplay = shouldDisplayGap(gap)
            mostRecentBar = gap.gapType == GapType.rth ? mostRecentUnfilledRTH : gap.gapType == GapType.nwog ? mostRecentUnfilledNWOG : mostRecentUnfilledNDOG
            isNearestRTHFloat = gap.gapType == GapType.rth and array.includes(nearestRTHBars, gap.creationBar)
            useFloatingLayout = canDisplay and (shouldFloatGap(gap, mostRecentBar) or isNearestRTHFloat)
            typeLimit = getDisplayLimit(gap.gapType)
            typeCount = gap.gapType == GapType.rth ? displayedRTH : gap.gapType == GapType.nwog ? displayedNWOG : displayedNDOG
            withinHistoricalLimit = typeCount < typeLimit

            // Nearest floats bypass the historical limit — they are pinned by proximity to price, not recency.
            if canDisplay and (floatingOnly or withinHistoricalLimit or isNearestRTHFloat)
                if not floatingOnly and withinHistoricalLimit
                    if gap.gapType == GapType.rth
                        displayedRTH += 1
                    else if gap.gapType == GapType.nwog
                        displayedNWOG += 1
                    else if gap.gapType == GapType.ndog
                        displayedNDOG += 1

                if useFloatingLayout
                    releaseGapDrawings(gap)
                    if isNearestRTHFloat
                        if array.size(nearestRTHFloats) <= nearestRTHRendered
                            array.push(nearestRTHFloats, createFloatingGap(gap))
                        updateFloating(array.get(nearestRTHFloats, nearestRTHRendered), gap, rthFloatDistinctColors ? floatPaletteColor(nearestRTHRendered + 1) : na)
                        nearestRTHRendered += 1
                    else if gap.gapType == GapType.rth
                        if na(floatingRTH)
                            floatingRTH := createFloatingGap(gap)
                        updateFloating(floatingRTH, gap, rthFloatDistinctColors ? floatPaletteColor(0) : na)
                        floatingRTHRendered := true
                    else if gap.gapType == GapType.nwog
                        if na(floatingNWOG)
                            floatingNWOG := createFloatingGap(gap)
                        updateFloating(floatingNWOG, gap)
                        floatingNWOGRendered := true
                    else if gap.gapType == GapType.ndog
                        if na(floatingNDOG)
                            floatingNDOG := createFloatingGap(gap)
                        updateFloating(floatingNDOG, gap)
                        floatingNDOGRendered := true
                else if floatingOnly and not shouldPreserveTodayFilledRTH(gap)
                    releaseGapDrawings(gap)
                else
                    ensureGapDrawings(gap)
                    applyGapColors(gap)
                    rightTime = resolveRightEdge(gap)
                    safeRightTime = rightTime > gap.leftTime ? rightTime : gap.leftTime + barMs
                    setGapRightEdge(gap, safeRightTime)
            else
                releaseGapDrawings(gap)

    if not floatingRTHRendered and not na(floatingRTH)
        hideFloatingDrawings(floatingRTH)
    if not floatingNWOGRendered and not na(floatingNWOG)
        hideFloatingDrawings(floatingNWOG)
    if not floatingNDOGRendered and not na(floatingNDOG)
        hideFloatingDrawings(floatingNDOG)

    // Hide any nearest-float pool slots not claimed this bar (count dropped or feature toggled off).
    if array.size(nearestRTHFloats) > nearestRTHRendered
        for i = nearestRTHRendered to array.size(nearestRTHFloats) - 1
            hideFloatingDrawings(array.get(nearestRTHFloats, i))

// ═══════════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE
// ═══════════════════════════════════════════════════════════════════════════════

addColorRow(table tbl, int row, string name, color clr) =>
    table.cell(tbl, 0, row, name, text_size=size.small, text_color=color.black)
    table.cell(tbl, 1, row, str.format("R:{0} G:{1} B:{2}", int(color.r(clr)), int(color.g(clr)), int(color.b(clr))), text_size=size.small, text_color=color.black)
    table.cell(tbl, 2, row, str.tostring(int(color.t(clr))), text_size=size.small, text_color=color.black)

if showColorTable and barstate.islast
    var table colorTable = table.new(position.top_right, 3, 12, bgcolor=color.white, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

    table.cell(colorTable, 0, 0, "Setting", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 1, 0, "RGB", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(colorTable, 2, 0, "Trans", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)

    int row = 1
    addColorRow(colorTable, row, "RTH Unfilled", rthUnfilledColor)
    row += 1
    addColorRow(colorTable, row, "RTH Filled", rthFilledColor)
    row += 1
    addColorRow(colorTable, row, "Upcoming RTH", rthPreviewColor)
    row += 1
    addColorRow(colorTable, row, "RTH Border", rthBorderColor)
    row += 1
    addColorRow(colorTable, row, "NWOG Unfilled", nwogUnfilledColor)
    row += 1
    addColorRow(colorTable, row, "NWOG Filled", nwogFilledColor)
    row += 1
    addColorRow(colorTable, row, "NWOG Border", nwogBorderColor)
    row += 1
    addColorRow(colorTable, row, "NDOG Unfilled", ndogUnfilledColor)
    row += 1
    addColorRow(colorTable, row, "NDOG Filled", ndogFilledColor)
    row += 1
    addColorRow(colorTable, row, "NDOG Border", ndogBorderColor)
    row += 1
    addColorRow(colorTable, row, "Internal Lines", internalLinesColor)
