// Color Reference Table
showColorTable = input.bool(false, "Show Color Reference Table", group="📊 Color Reference", tooltip="Display a table showing all color values used in the indicator")

isValidRTHTimeframe = timeframe.in_seconds(timeframe.period) >= timeframe.in_seconds("1") and timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds("15")
isValidNWOGTimeframe = timeframe.in_seconds(timeframe.period) >= timeframe.in_seconds("1") and timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds("240")

// ═══════════════════════════════════════════════════════════════════════════════
// RESOLVED SETTINGS - Final values based on Quick Filter
// ═══════════════════════════════════════════════════════════════════════════════

// Fresh filter flag (full "scan for unfilled" behavior implemented in display logic)
isFreshFilter = quickFilter == FILTER_FRESH or quickFilter == FILTER_FRESH_FVG

// Visibility: which gap types are shown
displayNWOG = quickFilter == FILTER_ALL ? showNWOG : (quickFilter == FILTER_FRESH or quickFilter == FILTER_FRESH_FVG or quickFilter == FILTER_NWOG or quickFilter == FILTER_NWOG_NDOG)
displayNDOG = quickFilter == FILTER_ALL ? showNDOG : (quickFilter == FILTER_FRESH or quickFilter == FILTER_FRESH_FVG or quickFilter == FILTER_NDOG or quickFilter == FILTER_NWOG_NDOG)
displayRTH = quickFilter == FILTER_ALL ? showRTH : (quickFilter == FILTER_FRESH or quickFilter == FILTER_FRESH_FVG or quickFilter == FILTER_RTH)
displayBPR = quickFilter == FILTER_ALL ? showBPR : quickFilter == FILTER_BPR
displayFVG = quickFilter == FILTER_ALL ? showFVG : (quickFilter == FILTER_FVG or quickFilter == FILTER_FRESH_FVG)

// Hide filled behavior (Fresh mode always hides filled)
nwogHideFilled = isFreshFilter or hideFilledNWOG
ndogHideFilled = isFreshFilter or hideFilledNDOG
rthHideFilled = isFreshFilter or hideFilledRTH

// ═══════════════════════════════════════════════════════════════════════════════
// PERFORMANCE: Cache 1-minute intrabar data ONCE per bar
// ═══════════════════════════════════════════════════════════════════════════════
// Previously called 5 separate times - now cached for 5x performance improvement
[cached_1m_times, cached_1m_opens, cached_1m_closes] = request.security_lower_tf(syminfo.tickerid, "1", [time, open, close])

rthSession = "0930-1615:1234567"
inRTH = isValidRTHTimeframe and not na(time(timeframe.period, rthSession, TIMEZONE))
rthStart = inRTH and not inRTH[1]
rthEnd = not inRTH and inRTH[1]

type GapData
    box topUnfilledBox
    box filledBox
    box bottomUnfilledBox
    line ceLine
    line q1Line
    line q3Line
    line topBoundaryLine
    line bottomBoundaryLine
    label dateLabel
    array<line> projectionLines
    array<label> projectionLabels
    bool isBullish
    float top
    float bottom
    float penetrationLevel
    string entryDirection
    bool filled
    bool passedNextSession
    bool isPreview
    string gapType
    int creationBar
    int creationTime
    int leftTime

type SessionDividers
    array<int> dividerTimes

var float rthClosePrice = na
var int previewStartTime = na
var array<GapData> gapsArray = array.new<GapData>()
var SessionDividers ndogDividers = SessionDividers.new(array.new<int>())
var SessionDividers nwogDividers = SessionDividers.new(array.new<int>())
var array<line> dividerLines = array.new<line>()
var GapData previewGap = na

var float fridayClosePrice = na
var float sundayOpenPrice = na

var float prevDayClosePrice = na
var float newDayOpenPrice = na
var int lastNDOGDay = na

// Alert tracking (reset each bar)
var string rthFilledAlertMsg = na

// ═══════════════════════════════════════════════════════════════════════════════
// FLOATING BOX DRAWINGS - Use bar_index for consistent scaling
// ═══════════════════════════════════════════════════════════════════════════════
// These are separate overlay drawings that use xloc.bar_index to avoid
// the scaling issues with xloc.bar_time for future positions

type FloatingBox
    box mainBox
    box filledBox
    line topLine
    line bottomLine
    line ceLine
    line q1Line
    line q3Line
    label dateLabel

var FloatingBox floatingRTH = FloatingBox.new()
var FloatingBox floatingNDOG = FloatingBox.new()
var FloatingBox floatingNWOG = FloatingBox.new()
var FloatingBox floatingPreview = FloatingBox.new()

// Helper to delete all floating box drawings
deleteFloatingBox(FloatingBox fb) =>
    if not na(fb.mainBox)
        box.delete(fb.mainBox)
        fb.mainBox := na
    if not na(fb.filledBox)
        box.delete(fb.filledBox)
        fb.filledBox := na
    if not na(fb.topLine)
        line.delete(fb.topLine)
        fb.topLine := na
    if not na(fb.bottomLine)
        line.delete(fb.bottomLine)
        fb.bottomLine := na
    if not na(fb.ceLine)
        line.delete(fb.ceLine)
        fb.ceLine := na
    if not na(fb.q1Line)
        line.delete(fb.q1Line)
        fb.q1Line := na
    if not na(fb.q3Line)
        line.delete(fb.q3Line)
        fb.q3Line := na
    if not na(fb.dateLabel)
        label.delete(fb.dateLabel)
        fb.dateLabel := na

// Helper to create/update floating box at bar_index position (with fill visualization)
drawFloatingBox(FloatingBox fb, float topPrice, float bottomPrice, float penetrationLevel, string entryDirection, int leftBar, int rightBar, color unfilledColor, color filledColor, color borderColor, color internalColor, string labelText, color labelColor, bool showInternals) =>
    deleteFloatingBox(fb)

    gapRange = topPrice - bottomPrice
    gapMid = bottomPrice + gapRange * CE_LEVEL
    gapQ1 = bottomPrice + gapRange * Q1_LEVEL
    gapQ3 = bottomPrice + gapRange * Q3_LEVEL
    centerBar = math.round((leftBar + rightBar) / 2)

    // Draw with penetration visualization if applicable
    if not na(penetrationLevel)
        if entryDirection == ENTRY_FROM_BELOW
            // Filled from bottom up to penetration level
            fb.mainBox := box.new(leftBar, topPrice, rightBar, penetrationLevel, xloc=xloc.bar_index, bgcolor=unfilledColor, border_color=na)
            fb.filledBox := box.new(leftBar, penetrationLevel, rightBar, bottomPrice, xloc=xloc.bar_index, bgcolor=filledColor, border_color=na)
        else if entryDirection == ENTRY_FROM_ABOVE
            // Filled from top down to penetration level
            fb.mainBox := box.new(leftBar, topPrice, rightBar, penetrationLevel, xloc=xloc.bar_index, bgcolor=filledColor, border_color=na)
            fb.filledBox := box.new(leftBar, penetrationLevel, rightBar, bottomPrice, xloc=xloc.bar_index, bgcolor=unfilledColor, border_color=na)
        else
            fb.mainBox := box.new(leftBar, topPrice, rightBar, bottomPrice, xloc=xloc.bar_index, bgcolor=unfilledColor, border_color=na)
    else
        fb.mainBox := box.new(leftBar, topPrice, rightBar, bottomPrice, xloc=xloc.bar_index, bgcolor=unfilledColor, border_color=na)

    fb.topLine := line.new(leftBar, topPrice, rightBar, topPrice, xloc=xloc.bar_index, color=borderColor, style=line.style_solid, width=1)
    fb.bottomLine := line.new(leftBar, bottomPrice, rightBar, bottomPrice, xloc=xloc.bar_index, color=borderColor, style=line.style_solid, width=1)

    if showInternals
        fb.ceLine := line.new(leftBar, gapMid, rightBar, gapMid, xloc=xloc.bar_index, color=internalColor, style=line.style_dotted, width=1)
        fb.q3Line := line.new(leftBar, gapQ1, rightBar, gapQ1, xloc=xloc.bar_index, color=internalColor, style=line.style_dotted, width=1)

    fb.dateLabel := label.new(centerBar, bottomPrice, labelText, xloc=xloc.bar_index, color=color.new(color.rgb(255, 255, 255), 100), textcolor=labelColor, style=label.style_label_up, size=size.tiny, textalign=text.align_center)

// Get month abbreviation from month number (must be defined before createGap)
getMonthName(int monthNum) =>
    switch monthNum
        1 => "Jan"
        2 => "Feb"
        3 => "Mar"
        4 => "Apr"
        5 => "May"
        6 => "Jun"
        7 => "Jul"
        8 => "Aug"
        9 => "Sep"
        10 => "Oct"
        11 => "Nov"
        => "Dec"

// Helper to calculate time offset from bar offset
barOffsetToTime(int barOffset) =>
    time + (barOffset * barMs)

// Helper for consistent date formatting
formatGapDate(int timestamp) =>
    getMonthName(month(timestamp, TIMEZONE)) + " " + str.tostring(dayofmonth(timestamp, TIMEZONE)) + ", " + str.tostring(year(timestamp, TIMEZONE))

// Single helper for label text with fill percentage (used by RTH, NWOG, NDOG)
getGapLabelWithFill(GapData gap, string prefix) =>
    dateStr = formatGapDate(gap.creationTime)
    gapRange = gap.top - gap.bottom
    string result = na
    if not na(gap.penetrationLevel) and gapRange > 0
        fillPercent = gap.entryDirection == ENTRY_FROM_BELOW ?
             (gap.penetrationLevel - gap.bottom) / gapRange * 100 :
             (gap.top - gap.penetrationLevel) / gapRange * 100
        if fillPercent >= 100
            result := prefix + " " + FILL_COMPLETE + "\n" + dateStr
        else
            result := prefix + " " + str.tostring(fillPercent, "#") + "%\n" + dateStr
    else
        result := prefix + "\n" + dateStr
    result

createGap(float topPrice, float bottomPrice, string gapType, bool isPreview = false, int customLeftTime = na, bool isBullish = false) =>
    gapRange = topPrice - bottomPrice
    gapMid = bottomPrice + gapRange * CE_LEVEL
    gapQ1 = bottomPrice + gapRange * Q1_LEVEL
    gapQ3 = bottomPrice + gapRange * Q3_LEVEL

    unfilled = gapType == GAP_TYPE_NWOG ? nwogUnfilledColor : gapType == GAP_TYPE_NDOG ? ndogUnfilledColor : gapType == GAP_TYPE_BPR_BULLISH ? bprBullishUnfilledColor : gapType == GAP_TYPE_BPR_BEARISH ? bprBearishUnfilledColor : gapType == GAP_TYPE_FVG_BULLISH ? fvgBullishUnfilledColor : gapType == GAP_TYPE_FVG_BEARISH ? fvgBearishUnfilledColor : rthUnfilledColor
    filled = gapType == GAP_TYPE_NWOG ? nwogFilledColor : gapType == GAP_TYPE_NDOG ? ndogFilledColor : gapType == GAP_TYPE_BPR_BULLISH ? bprBullishFilledColor : gapType == GAP_TYPE_BPR_BEARISH ? bprBearishFilledColor : gapType == GAP_TYPE_FVG_BULLISH ? fvgBullishFilledColor : gapType == GAP_TYPE_FVG_BEARISH ? fvgBearishFilledColor : rthFilledColor
    boxColor = isPreview ? previewColor : unfilled

    // Preview (forming RTH) always floats to the right edge
    leftTime = not na(customLeftTime) ? customLeftTime : (isPreview ? barOffsetToTime(COMPACT_OFFSET_RTH) : time)
    rightTime = isPreview ? leftTime + (COMPACT_WIDTH * barMs) : time

    topUnfilledBox = box.new(leftTime, topPrice, rightTime, bottomPrice, xloc=xloc.bar_time, bgcolor=boxColor, border_color=na)
    filledBox = box.new(leftTime, bottomPrice, rightTime, bottomPrice, xloc=xloc.bar_time, bgcolor=filled, border_color=na)
    bottomUnfilledBox = box.new(leftTime, bottomPrice, rightTime, bottomPrice, xloc=xloc.bar_time, bgcolor=na, border_color=na)

    // All internal lines are now dotted and uniform
    // FVGs only get CE line (50%), no quarter lines
    isGapFVG = gapType == GAP_TYPE_FVG_BULLISH or gapType == GAP_TYPE_FVG_BEARISH
    ceLine = (showInternalLines and not isPreview) ? line.new(leftTime, gapMid, rightTime, gapMid, xloc=xloc.bar_time, color=internalLinesColor, style=line.style_dotted, width=1) : na
    q1Line = (showInternalLines and not isPreview and not isGapFVG) ? line.new(leftTime, gapQ1, rightTime, gapQ1, xloc=xloc.bar_time, color=internalLinesColor, style=line.style_dotted, width=1) : na
    q3Line = (showInternalLines and not isPreview and not isGapFVG) ? line.new(leftTime, gapQ3, rightTime, gapQ3, xloc=xloc.bar_time, color=internalLinesColor, style=line.style_dotted, width=1) : na

    // Outer boundary lines (top and bottom edges)
    boundaryColor = gapType == GAP_TYPE_NWOG ? nwogBoundaryColor : gapType == GAP_TYPE_NDOG ? ndogBoundaryColor : gapType == GAP_TYPE_RTH ? rthBoundaryColor : gapType == GAP_TYPE_BPR_BULLISH ? bprBullishBoundaryColor : gapType == GAP_TYPE_BPR_BEARISH ? bprBearishBoundaryColor : gapType == GAP_TYPE_FVG_BULLISH ? fvgBullishBoundaryColor : gapType == GAP_TYPE_FVG_BEARISH ? fvgBearishBoundaryColor : na
    topBoundaryLine = not isPreview ? line.new(leftTime, topPrice, rightTime, topPrice, xloc=xloc.bar_time, color=boundaryColor, style=line.style_solid, width=1) : na
    bottomBoundaryLine = not isPreview ? line.new(leftTime, bottomPrice, rightTime, bottomPrice, xloc=xloc.bar_time, color=boundaryColor, style=line.style_solid, width=1) : na

    // Create labels for gaps
    label dateLabel = na
    showDateLabel = (gapType == GAP_TYPE_NWOG and showNWOGDateLabel) or (gapType == GAP_TYPE_NDOG and showNDOGDateLabel) or (gapType == GAP_TYPE_RTH and showRTHDateLabel)
    isFVGType = gapType == GAP_TYPE_FVG_BULLISH or gapType == GAP_TYPE_FVG_BEARISH

    if showDateLabel or isFVGType
        centerTime = math.round((leftTime + rightTime) / 2)

        if isFVGType
            // FVG label: simple "FVG+" or "FVG-" centered in the gap
            fvgLabelText = gapType == GAP_TYPE_FVG_BULLISH ? GAP_TYPE_FVG_BULLISH : GAP_TYPE_FVG_BEARISH
            dateLabel := label.new(centerTime, gapMid, fvgLabelText, xloc=xloc.bar_time, color=color.new(color.rgb(255, 255, 255), 100), textcolor=fvgLabelColor, style=label.style_label_center, size=size.tiny, textalign=text.align_center)
        else if isPreview
            // Preview label shows "Upcoming RTH" with NEXT trading day date
            // Friday (dayofweek=6) → Monday (+3 days), else tomorrow (+1 day)
            dateLabelColor = gapType == GAP_TYPE_NWOG ? nwogBoundaryColor : gapType == GAP_TYPE_NDOG ? ndogBoundaryColor : rthBoundaryColor
            todayDow = dayofweek(time, TIMEZONE)
            daysToAdd = todayDow == dayofweek.friday ? 3 : 1
            nextTradingDay = time + (daysToAdd * MILLISECONDS_PER_DAY)
            dateStr = "Upcoming RTH\n" + formatGapDate(nextTradingDay)
            dateLabel := label.new(centerTime, bottomPrice, dateStr, xloc=xloc.bar_time, color=color.new(color.rgb(255, 255, 255), 100), textcolor=dateLabelColor, style=label.style_label_up, size=size.tiny, textalign=text.align_center)
        else
            dateLabelColor = gapType == GAP_TYPE_NWOG ? nwogBoundaryColor : gapType == GAP_TYPE_NDOG ? ndogBoundaryColor : rthBoundaryColor
            gapPrefix = gapType == GAP_TYPE_NWOG ? GAP_TYPE_NWOG : gapType == GAP_TYPE_NDOG ? GAP_TYPE_NDOG : GAP_TYPE_RTH
            dateStr = gapPrefix + "\n" + formatGapDate(time)
            dateLabel := label.new(centerTime, bottomPrice, dateStr, xloc=xloc.bar_time, color=color.new(color.rgb(255, 255, 255), 100), textcolor=dateLabelColor, style=label.style_label_up, size=size.tiny, textalign=text.align_center)

    // Determine initial entry direction and fill state based on gap direction and current price
    // This is critical for gaps created from historical data where price may have already passed through
    //
    // For NWOG/NDOG gaps, isBullish tells us the original gap direction:
    // - isBullish = true: Sunday opened HIGHER than Friday closed → gap is BELOW the open price → entry FROM_ABOVE (price drops into gap)
    // - isBullish = false: Sunday opened LOWER than Friday closed → gap is ABOVE the open price → entry FROM_BELOW (price rises into gap)
    initialDirection = isBullish ? ENTRY_FROM_ABOVE : ENTRY_FROM_BELOW
    initialFilled = false
    float initialPenetration = na

    // Check current bar for fill status
    if initialDirection == ENTRY_FROM_ABOVE
        // Bullish gap (below price at creation) - fills when price drops down through it
        if low <= bottomPrice
            // Current bar crossed through the entire gap (from top to bottom)
            initialFilled := true
            initialPenetration := bottomPrice
        else if low <= topPrice and low > bottomPrice
            // Current bar penetrated but didn't fully fill
            initialPenetration := low
        // Also check: if price is now BELOW the gap, it must have crossed through at some point
        if not initialFilled and close < bottomPrice
            initialFilled := true
            initialPenetration := bottomPrice
    else
        // Bearish gap (above price at creation) - fills when price rises up through it
        if high >= topPrice
            // Current bar crossed through the entire gap (from bottom to top)
            initialFilled := true
            initialPenetration := topPrice
        else if high >= bottomPrice and high < topPrice
            // Current bar penetrated but didn't fully fill
            initialPenetration := high
        // Also check: if price is now ABOVE the gap, it must have crossed through at some point
        if not initialFilled and close > topPrice
            initialFilled := true
            initialPenetration := topPrice

    GapData.new(
         topUnfilledBox=topUnfilledBox,
         filledBox=filledBox,
         bottomUnfilledBox=bottomUnfilledBox,
         ceLine=ceLine,
         q1Line=q1Line,
         q3Line=q3Line,
         topBoundaryLine=topBoundaryLine,
         bottomBoundaryLine=bottomBoundaryLine,
         dateLabel=dateLabel,
         projectionLines=array.new<line>(),
         projectionLabels=array.new<label>(),
         isBullish=isBullish,
         top=topPrice,
         bottom=bottomPrice,
         penetrationLevel=initialPenetration,
         entryDirection=initialDirection,
         filled=initialFilled,
         passedNextSession=false,
         isPreview=isPreview,
         gapType=gapType,
         creationBar=bar_index,
         creationTime=time,
         leftTime=leftTime
     )

draw_gap_projections(GapData gap, int rightEdgeTime) =>
    // Determine if projections should be drawn based on gap type and toggle
    shouldDraw = false
    projColor = color(na)

    if gap.gapType == GAP_TYPE_NWOG and not gap.filled and showNWOGProjections
        shouldDraw := true
        projColor := nwogProjectionColor
    else if gap.gapType == GAP_TYPE_NDOG and not gap.filled and showNDOGProjections
        shouldDraw := true
        projColor := ndogProjectionColor
    else if gap.gapType == GAP_TYPE_RTH and not gap.filled and showRTHProjections
        shouldDraw := true
        projColor := rthProjectionColor

    if shouldDraw
        gapSize = gap.top - gap.bottom

        // Projection multipliers: 1, 2, 2.5, 4, 4.5
        multipliers = array.from(1.0, 2.0, 2.5, 4.0, 4.5)

        // For bullish gaps (gapped up), projections go ABOVE the gap top
        // For bearish gaps (gapped down), projections go BELOW the gap bottom

        for i = 0 to array.size(multipliers) - 1
            mult = array.get(multipliers, i)

            // Calculate projection price based on gap direction
            projPrice = gap.isBullish ? gap.top + (gapSize * mult) : gap.bottom - (gapSize * mult)

            // Draw projection line using xloc.bar_time to avoid historical buffer issues
            projLine = line.new(gap.creationTime, projPrice, rightEdgeTime, projPrice, xloc=xloc.bar_time, color=projColor, width=1, style=line.style_dotted)
            array.push(gap.projectionLines, projLine)

            // Create label text
            labelText = "-" + str.tostring(mult)
            projLabel = label.new(rightEdgeTime, projPrice, labelText, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(chart.bg_color, 0), textcolor=projColor, size=size.tiny)
            array.push(gap.projectionLabels, projLabel)

// Helper: Determine if gap should use compact offset positioning
// RTH: floats if most recent unfilled and no preview showing (Fresh mode ignores preview check)
// NWOG: floats if most recent unfilled
// NDOG: floats if most recent unfilled AND doesn't overlap with NWOG (avoids duplicate floating)
// Once filled, gaps return to historical position
shouldUseCompactPosition(GapData gap, bool hasPreview, int mostRecentRTHBar, int mostRecentNWOGBar, int mostRecentNDOGBar, bool ndogOverlapsNWOG) =>
    if not floatingMode or gap.filled
        false
    else if gap.gapType == GAP_TYPE_RTH
        not hasPreview and gap.creationBar == mostRecentRTHBar
    else if gap.gapType == GAP_TYPE_NWOG
        gap.creationBar == mostRecentNWOGBar
    else if gap.gapType == GAP_TYPE_NDOG
        // Don't float NDOG if it overlaps with NWOG (NWOG takes precedence with combined label)
        gap.creationBar == mostRecentNDOGBar and not ndogOverlapsNWOG
    else
        false

// Helper: Update all drawing positions for a gap (using time values)
// Centralizes position-setting logic for boxes, lines, and labels
updateGapDrawingPositions(GapData gap, int leftTime, int rightTime) =>
    box.set_left(gap.topUnfilledBox, leftTime)
    box.set_right(gap.topUnfilledBox, rightTime)
    box.set_left(gap.filledBox, leftTime)
    box.set_right(gap.filledBox, rightTime)
    box.set_left(gap.bottomUnfilledBox, leftTime)
    box.set_right(gap.bottomUnfilledBox, rightTime)
    if not na(gap.ceLine)
        line.set_x1(gap.ceLine, leftTime)
        line.set_x2(gap.ceLine, rightTime)
    if not na(gap.q1Line)
        line.set_x1(gap.q1Line, leftTime)
        line.set_x2(gap.q1Line, rightTime)
    if not na(gap.q3Line)
        line.set_x1(gap.q3Line, leftTime)
        line.set_x2(gap.q3Line, rightTime)
    if not na(gap.topBoundaryLine)
        line.set_x1(gap.topBoundaryLine, leftTime)
        line.set_x2(gap.topBoundaryLine, rightTime)
    if not na(gap.bottomBoundaryLine)
        line.set_x1(gap.bottomBoundaryLine, leftTime)
        line.set_x2(gap.bottomBoundaryLine, rightTime)
    if not na(gap.dateLabel)
        label.set_x(gap.dateLabel, math.round((leftTime + rightTime) / 2))
        // FVG labels need Y position updated to stay vertically centered
        if gap.gapType == GAP_TYPE_FVG_BULLISH or gap.gapType == GAP_TYPE_FVG_BEARISH
            gapMidY = gap.bottom + (gap.top - gap.bottom) * CE_LEVEL
            label.set_y(gap.dateLabel, gapMidY)

deleteGap(GapData gap) =>
    box.delete(gap.topUnfilledBox)
    box.delete(gap.filledBox)
    box.delete(gap.bottomUnfilledBox)
    if not na(gap.ceLine)
        line.delete(gap.ceLine)
    if not na(gap.q1Line)
        line.delete(gap.q1Line)
    if not na(gap.q3Line)
        line.delete(gap.q3Line)
    if not na(gap.topBoundaryLine)
        line.delete(gap.topBoundaryLine)
    if not na(gap.bottomBoundaryLine)
        line.delete(gap.bottomBoundaryLine)
    if not na(gap.dateLabel)
        label.delete(gap.dateLabel)
    // Delete projection lines and labels
    if not na(gap.projectionLines)
        for projLine in gap.projectionLines
            line.delete(projLine)
    if not na(gap.projectionLabels)
        for projLabel in gap.projectionLabels
            label.delete(projLabel)

// Helper functions for gap type categorization
isBPR(string gapType) => gapType == GAP_TYPE_BPR_BULLISH or gapType == GAP_TYPE_BPR_BEARISH
isFVG(string gapType) => gapType == GAP_TYPE_FVG_BULLISH or gapType == GAP_TYPE_FVG_BEARISH

// Clear projection lines and labels from a gap
clearProjections(GapData gap) =>
    if not na(gap.projectionLines)
        for projLine in gap.projectionLines
            line.delete(projLine)
        array.clear(gap.projectionLines)
    if not na(gap.projectionLabels)
        for projLabel in gap.projectionLabels
            label.delete(projLabel)
        array.clear(gap.projectionLabels)

// Single source of truth for gap label text (used in createGap and restoreGapDrawings)
getGapLabelText(GapData gap) =>
    if gap.gapType == GAP_TYPE_FVG_BULLISH
        GAP_TYPE_FVG_BULLISH
    else if gap.gapType == GAP_TYPE_FVG_BEARISH
        GAP_TYPE_FVG_BEARISH
    else if gap.gapType == GAP_TYPE_BPR_BULLISH
        GAP_TYPE_BPR_BULLISH
    else if gap.gapType == GAP_TYPE_BPR_BEARISH
        GAP_TYPE_BPR_BEARISH
    else if gap.gapType == GAP_TYPE_RTH
        getGapLabelWithFill(gap, GAP_TYPE_RTH)
    else
        // NWOG or NDOG
        getGapLabelWithFill(gap, gap.gapType)

// Hide gap drawings without deleting the gap from array (for filter toggling)
hideGapDrawings(GapData gap) =>
    if not na(gap.topUnfilledBox)
        box.set_top(gap.topUnfilledBox, 0)
        box.set_bottom(gap.topUnfilledBox, 0)
    if not na(gap.filledBox)
        box.set_top(gap.filledBox, 0)
        box.set_bottom(gap.filledBox, 0)
    if not na(gap.bottomUnfilledBox)
        box.set_top(gap.bottomUnfilledBox, 0)
        box.set_bottom(gap.bottomUnfilledBox, 0)
    if not na(gap.ceLine)
        line.set_y1(gap.ceLine, 0)
        line.set_y2(gap.ceLine, 0)
    if not na(gap.q1Line)
        line.set_y1(gap.q1Line, 0)
        line.set_y2(gap.q1Line, 0)
    if not na(gap.q3Line)
        line.set_y1(gap.q3Line, 0)
        line.set_y2(gap.q3Line, 0)
    if not na(gap.topBoundaryLine)
        line.set_y1(gap.topBoundaryLine, 0)
        line.set_y2(gap.topBoundaryLine, 0)
    if not na(gap.bottomBoundaryLine)
        line.set_y1(gap.bottomBoundaryLine, 0)
        line.set_y2(gap.bottomBoundaryLine, 0)
    if not na(gap.dateLabel)
        label.set_text(gap.dateLabel, "")
    clearProjections(gap)

// Restore gap drawings with actual values (reverse of hideGapDrawings)
// CRITICAL: Must respect penetrationLevel to preserve fill visualization
restoreGapDrawings(GapData gap) =>
    gapRange = gap.top - gap.bottom
    gapMid = gap.bottom + gapRange * CE_LEVEL
    gapQ1 = gap.bottom + gapRange * Q1_LEVEL
    gapQ3 = gap.bottom + gapRange * Q3_LEVEL

    // Restore all 3 boxes based on penetration state (mirror the visual update logic)
    if not na(gap.penetrationLevel)
        if gap.entryDirection == ENTRY_FROM_BELOW
            // Filled from bottom up to penetration level
            if not na(gap.filledBox)
                box.set_top(gap.filledBox, gap.penetrationLevel)
                box.set_bottom(gap.filledBox, gap.bottom)
            if not na(gap.topUnfilledBox)
                box.set_top(gap.topUnfilledBox, gap.top)
                box.set_bottom(gap.topUnfilledBox, gap.penetrationLevel)
            if not na(gap.bottomUnfilledBox)
                box.set_top(gap.bottomUnfilledBox, gap.bottom)
                box.set_bottom(gap.bottomUnfilledBox, gap.bottom)
        else if gap.entryDirection == ENTRY_FROM_ABOVE
            // Filled from top down to penetration level
            if not na(gap.filledBox)
                box.set_top(gap.filledBox, gap.top)
                box.set_bottom(gap.filledBox, gap.penetrationLevel)
            if not na(gap.bottomUnfilledBox)
                box.set_top(gap.bottomUnfilledBox, gap.penetrationLevel)
                box.set_bottom(gap.bottomUnfilledBox, gap.bottom)
            if not na(gap.topUnfilledBox)
                box.set_top(gap.topUnfilledBox, gap.top)
                box.set_bottom(gap.topUnfilledBox, gap.top)
        else
            // Entry direction unknown but has penetration - show full as unfilled
            if not na(gap.topUnfilledBox)
                box.set_top(gap.topUnfilledBox, gap.top)
                box.set_bottom(gap.topUnfilledBox, gap.bottom)
            if not na(gap.filledBox)
                box.set_top(gap.filledBox, gap.bottom)
                box.set_bottom(gap.filledBox, gap.bottom)
            if not na(gap.bottomUnfilledBox)
                box.set_top(gap.bottomUnfilledBox, gap.bottom)
                box.set_bottom(gap.bottomUnfilledBox, gap.bottom)
    else
        // No penetration - show full gap as unfilled
        if not na(gap.topUnfilledBox)
            box.set_top(gap.topUnfilledBox, gap.top)
            box.set_bottom(gap.topUnfilledBox, gap.bottom)
        if not na(gap.filledBox)
            box.set_top(gap.filledBox, gap.bottom)
            box.set_bottom(gap.filledBox, gap.bottom)
        if not na(gap.bottomUnfilledBox)
            box.set_top(gap.bottomUnfilledBox, gap.bottom)
            box.set_bottom(gap.bottomUnfilledBox, gap.bottom)

    if not na(gap.ceLine)
        line.set_y1(gap.ceLine, gapMid)
        line.set_y2(gap.ceLine, gapMid)
    if not na(gap.q1Line)
        line.set_y1(gap.q1Line, gapQ1)
        line.set_y2(gap.q1Line, gapQ1)
    if not na(gap.q3Line)
        line.set_y1(gap.q3Line, gapQ3)
        line.set_y2(gap.q3Line, gapQ3)
    if not na(gap.topBoundaryLine)
        line.set_y1(gap.topBoundaryLine, gap.top)
        line.set_y2(gap.topBoundaryLine, gap.top)
    if not na(gap.bottomBoundaryLine)
        line.set_y1(gap.bottomBoundaryLine, gap.bottom)
        line.set_y2(gap.bottomBoundaryLine, gap.bottom)
    if not na(gap.dateLabel)
        label.set_text(gap.dateLabel, getGapLabelText(gap))

// Stop extending gap drawings at current time (mitigation point)
stopExtendingAt(GapData gap, int stopTime) =>
    box.set_right(gap.topUnfilledBox, stopTime)
    box.set_right(gap.filledBox, stopTime)
    box.set_right(gap.bottomUnfilledBox, stopTime)
    if not na(gap.ceLine)
        line.set_x2(gap.ceLine, stopTime)
    if not na(gap.q1Line)
        line.set_x2(gap.q1Line, stopTime)
    if not na(gap.q3Line)
        line.set_x2(gap.q3Line, stopTime)
    if not na(gap.topBoundaryLine)
        line.set_x2(gap.topBoundaryLine, stopTime)
    if not na(gap.bottomBoundaryLine)
        line.set_x2(gap.bottomBoundaryLine, stopTime)

countGapsByType(string gapType) =>
    count = 0
    if array.size(gapsArray) > 0
        for i = 0 to array.size(gapsArray) - 1
            gap = array.get(gapsArray, i)
            if gap.gapType == gapType
                count += 1
    count

countFVG() =>
    count = 0
    if array.size(gapsArray) > 0
        for i = 0 to array.size(gapsArray) - 1
            gap = array.get(gapsArray, i)
            if isFVG(gap.gapType)
                count += 1
    count

removeOldestGap(string gapType) =>
    if array.size(gapsArray) > 0
        for i = 0 to array.size(gapsArray) - 1
            gap = array.get(gapsArray, i)
            if gap.gapType == gapType
                deleteGap(gap)
                array.remove(gapsArray, i)
                break

// Remove oldest FVG (simple FIFO)
removeOldestFVG() =>
    if array.size(gapsArray) > 0
        for i = 0 to array.size(gapsArray) - 1
            gap = array.get(gapsArray, i)
            if isFVG(gap.gapType)
                deleteGap(gap)
                array.remove(gapsArray, i)
                break

removeOldestBPR() =>
    if array.size(gapsArray) > 0
        for i = 0 to array.size(gapsArray) - 1
            gap = array.get(gapsArray, i)
            if isBPR(gap.gapType)
                deleteGap(gap)
                array.remove(gapsArray, i)
                break

// Try to merge a new gap with an existing overlapping gap of the same type
// Returns true if merged, false if no overlapping gap found
tryMergeGap(float newTop, float newBottom, string targetType) =>
    merged = false
    if array.size(gapsArray) > 0
        for i = array.size(gapsArray) - 1 to 0
            gap = array.get(gapsArray, i)
            if gap.gapType == targetType and not gap.filled
                // Check if ranges overlap or are adjacent
                rangesOverlap = not (newBottom > gap.top or gap.bottom > newTop)
                if rangesOverlap
                    // Expand the existing gap to encompass both ranges
                    expandedTop = math.max(gap.top, newTop)
                    expandedBottom = math.min(gap.bottom, newBottom)
                    gap.top := expandedTop
                    gap.bottom := expandedBottom
                    // Update visual elements
                    box.set_top(gap.topUnfilledBox, expandedTop)
                    box.set_bottom(gap.bottomUnfilledBox, expandedBottom)
                    if not na(gap.topBoundaryLine)
                        line.set_y1(gap.topBoundaryLine, expandedTop)
                        line.set_y2(gap.topBoundaryLine, expandedTop)
                    if not na(gap.bottomBoundaryLine)
                        line.set_y1(gap.bottomBoundaryLine, expandedBottom)
                        line.set_y2(gap.bottomBoundaryLine, expandedBottom)
                    // Recalculate internal lines
                    gapRange = expandedTop - expandedBottom
                    if not na(gap.ceLine)
                        newMid = expandedBottom + gapRange * CE_LEVEL
                        line.set_y1(gap.ceLine, newMid)
                        line.set_y2(gap.ceLine, newMid)
                    if not na(gap.q1Line)
                        newQ1 = expandedBottom + gapRange * Q1_LEVEL
                        line.set_y1(gap.q1Line, newQ1)
                        line.set_y2(gap.q1Line, newQ1)
                    if not na(gap.q3Line)
                        newQ3 = expandedBottom + gapRange * Q3_LEVEL
                        line.set_y1(gap.q3Line, newQ3)
                        line.set_y2(gap.q3Line, newQ3)
                    merged := true
                    break
    merged

if rthEnd and displayRTH
    rthClosePrice := close[1]
    previewStartTime := time

    // Create forming RTH gap (always floats to right edge)
    previewTop = math.max(rthClosePrice, close)
    previewBottom = math.min(rthClosePrice, close)
    previewGap := createGap(previewTop, previewBottom, GAP_TYPE_RTH, true)

    // Hide original drawings if floatingMode - we use bar_index floating boxes
    if floatingMode
        hideGapDrawings(previewGap)

// Update preview during overnight session
if not inRTH and not na(previewGap) and not na(rthClosePrice) and displayRTH
    newTop = math.max(rthClosePrice, close)
    newBottom = math.min(rthClosePrice, close)

    // Update preview data
    previewGap.top := newTop
    previewGap.bottom := newBottom

    if floatingMode
        // Hide original preview drawings - we use bar_index floating boxes instead
        hideGapDrawings(previewGap)
    else
        // Non-floating: use time-based positioning
        previewLeft = time + (COMPACT_OFFSET_RTH * barMs)
        previewRight = previewLeft + (COMPACT_WIDTH * barMs)

        box.set_top(previewGap.topUnfilledBox, newTop)
        box.set_bottom(previewGap.topUnfilledBox, newBottom)
        box.set_left(previewGap.topUnfilledBox, previewLeft)
        box.set_right(previewGap.topUnfilledBox, previewRight)

        previewRange = newTop - newBottom
        if previewRange > 0
            newMid = newBottom + previewRange * CE_LEVEL

            if not na(previewGap.ceLine)
                line.set_y1(previewGap.ceLine, newMid)
                line.set_y2(previewGap.ceLine, newMid)
                line.set_x1(previewGap.ceLine, previewLeft)
                line.set_x2(previewGap.ceLine, previewRight)

        // Update preview label position
        if not na(previewGap.dateLabel)
            previewCenter = math.round((previewLeft + previewRight) / 2)
            label.set_x(previewGap.dateLabel, previewCenter)
            label.set_y(previewGap.dateLabel, newBottom)

if rthStart and displayRTH and array.size(gapsArray) > 0
    for i = 0 to array.size(gapsArray) - 1
        gap = array.get(gapsArray, i)
        if gap.gapType == GAP_TYPE_RTH
            gap.passedNextSession := true

if displayNWOG and isValidNWOGTimeframe and array.size(gapsArray) > 0
    // Use cached 1-minute data (performance optimization)
    arrayTimes = cached_1m_times
    arrayOpens = cached_1m_opens
    arrayCloses = cached_1m_closes

    if not na(arrayTimes) and array.size(arrayTimes) > 0
        // Calculate lookback limit: only process recent weeks
        lookbackLimit = time - (nwogLimit * 3 * MILLISECONDS_PER_WEEK)

        for i = 0 to array.size(arrayTimes) - 1
            barTime = array.get(arrayTimes, i)

            // Skip bars that are too old for performance
            if barTime < lookbackLimit
                continue

            barDay = dayofweek(barTime, TIMEZONE)
            barHour = hour(barTime, TIMEZONE)
            barMinute = minute(barTime, TIMEZONE)

            if barDay == 1 and barHour == SESSION_OPEN_HOUR and barMinute == ZERO_MINUTE
                for j = 0 to array.size(gapsArray) - 1
                    gap = array.get(gapsArray, j)
                    // Only mark NWOG gaps that were created at least 6 days before this session
                    // (6 days = 518400000 ms, ensures it's the NEXT Sunday not the same one)
                    if gap.gapType == GAP_TYPE_NWOG and (barTime - gap.creationTime) >= 518400000
                        gap.passedNextSession := true

// Create RTH gap when RTH opens (preview stays until gap is created)
if rthStart and not na(rthClosePrice) and displayRTH
    rthOpenPrice = open

    if rthOpenPrice != rthClosePrice
        gapTop = math.max(rthClosePrice, rthOpenPrice)
        gapBottom = math.min(rthClosePrice, rthOpenPrice)
        rthIsBullish = rthOpenPrice > rthClosePrice  // Bullish if gapped up

        rthGap = createGap(gapTop, gapBottom, GAP_TYPE_RTH, false, na, rthIsBullish)
        array.push(gapsArray, rthGap)

        if countGapsByType(GAP_TYPE_RTH) > rthLimit
            removeOldestGap(GAP_TYPE_RTH)

        // Delete preview only after RTH gap is created (Option C)
        if not na(previewGap)
            deleteGap(previewGap)
            previewGap := na
            previewStartTime := na
    else
        // No gap formed (open == close), still delete preview
        if not na(previewGap)
            deleteGap(previewGap)
            previewGap := na
            previewStartTime := na

if array.size(gapsArray) > 0
    mostRecentUnfilledNWOGBar = -1
    mostRecentUnfilledNDOGBar = -1
    mostRecentUnfilledRTHBar = -1  // Track most recent UNFILLED RTH for floating mode

    // Track geometry of most recent unfilled NWOG/NDOG for overlap detection
    float mostRecentNWOGTop = na
    float mostRecentNWOGBottom = na
    float mostRecentNDOGTop = na
    float mostRecentNDOGBottom = na

    for i = 0 to array.size(gapsArray) - 1
        gap = array.get(gapsArray, i)
        if gap.gapType == GAP_TYPE_NWOG and not gap.filled and gap.creationBar > mostRecentUnfilledNWOGBar
            mostRecentUnfilledNWOGBar := gap.creationBar
            mostRecentNWOGTop := gap.top
            mostRecentNWOGBottom := gap.bottom
        if gap.gapType == GAP_TYPE_NDOG and not gap.filled and gap.creationBar > mostRecentUnfilledNDOGBar
            mostRecentUnfilledNDOGBar := gap.creationBar
            mostRecentNDOGTop := gap.top
            mostRecentNDOGBottom := gap.bottom
        if gap.gapType == GAP_TYPE_RTH and not gap.filled and gap.creationBar > mostRecentUnfilledRTHBar
            mostRecentUnfilledRTHBar := gap.creationBar

    // Check if preview is currently showing (if so, preview handles floating, not formed gaps)
    hasPreview = not na(previewGap)

    // Detect if most recent NDOG shares geometry with most recent NWOG (Sunday open creates both)
    ndogOverlapsNWOG = not na(mostRecentNWOGTop) and not na(mostRecentNDOGTop) and mostRecentNWOGTop == mostRecentNDOGTop and mostRecentNWOGBottom == mostRecentNDOGBottom

    // ═══════════════════════════════════════════════════════════════════════════════
    // FLOATING CANDIDATES - Find most recent unfilled gaps for floating mode
    // ═══════════════════════════════════════════════════════════════════════════════
    // Fresh mode & NWOG+NDOG filter: find distinct NDOG (different geometry from NWOG)
    // This ensures floating shows separate gaps, not overlapping ones

    int freshNWOGBar = mostRecentUnfilledNWOGBar
    int freshRTHBar = mostRecentUnfilledRTHBar
    int freshNDOGBar = mostRecentUnfilledNDOGBar

    // Scan for distinct NDOG when needed (Fresh mode OR floating mode with overlap)
    needsDistinctNDOG = isFreshFilter or (floatingMode and ndogOverlapsNWOG)
    if needsDistinctNDOG and ndogOverlapsNWOG
        // Find most recent unfilled NDOG that is DISTINCT from NWOG
        // If most recent NDOG overlaps with NWOG, scan backwards for a distinct one
        freshNDOGBar := -1
        for i = array.size(gapsArray) - 1 to 0
            gap = array.get(gapsArray, i)
            if gap.gapType == GAP_TYPE_NDOG and not gap.filled
                // Check if this NDOG has different geometry from the most recent unfilled NWOG
                isDistinct = na(mostRecentNWOGTop) or gap.top != mostRecentNWOGTop or gap.bottom != mostRecentNWOGBottom
                if isDistinct
                    freshNDOGBar := gap.creationBar
                    break

    // Combine NWOG/NDOG labels when they share the same geometry (Sunday open = both NWOG and NDOG)
    for i = 0 to array.size(gapsArray) - 1
        nwogGap = array.get(gapsArray, i)
        if nwogGap.gapType == GAP_TYPE_NWOG
            for j = 0 to array.size(gapsArray) - 1
                ndogGap = array.get(gapsArray, j)
                if ndogGap.gapType == GAP_TYPE_NDOG and ndogGap.top == nwogGap.top and ndogGap.bottom == nwogGap.bottom
                    // Same geometry - combine labels
                    if not na(nwogGap.dateLabel)
                        label.set_text(nwogGap.dateLabel, getGapLabelWithFill(nwogGap, GAP_TYPE_NWOG_NDOG))
                    if not na(ndogGap.dateLabel)
                        label.set_text(ndogGap.dateLabel, "")  // Hide NDOG label

    // Fresh mode: restore labels for fresh candidates (may have been hidden by hideGapDrawings on previous bars)
    if isFreshFilter
        // Restore distinct NDOG label
        if freshNDOGBar != -1
            for i = 0 to array.size(gapsArray) - 1
                gap = array.get(gapsArray, i)
                if gap.gapType == GAP_TYPE_NDOG and gap.creationBar == freshNDOGBar and not na(gap.dateLabel)
                    label.set_text(gap.dateLabel, getGapLabelWithFill(gap, GAP_TYPE_NDOG))
                    break

        // Restore RTH label
        if freshRTHBar != -1
            for i = 0 to array.size(gapsArray) - 1
                gap = array.get(gapsArray, i)
                if gap.gapType == GAP_TYPE_RTH and gap.creationBar == freshRTHBar and not na(gap.dateLabel)
                    label.set_text(gap.dateLabel, getGapLabelWithFill(gap, GAP_TYPE_RTH))
                    break

    for i = array.size(gapsArray) - 1 to 0
        gap = array.get(gapsArray, i)

        // Hide and skip gaps not enabled for display
        if gap.gapType == GAP_TYPE_RTH and not displayRTH
            hideGapDrawings(gap)
            continue
        if gap.gapType == GAP_TYPE_NWOG and not displayNWOG
            hideGapDrawings(gap)
            continue
        if gap.gapType == GAP_TYPE_NDOG and not displayNDOG
            hideGapDrawings(gap)
            continue
        if isBPR(gap.gapType) and not displayBPR
            hideGapDrawings(gap)
            continue
        if isFVG(gap.gapType) and not displayFVG
            hideGapDrawings(gap)
            continue

        // Restore drawings for gaps that pass the filter (may have been hidden by previous filter)
        restoreGapDrawings(gap)

        // Fresh filter: only show the designated unfilled candidate for each type
        if isFreshFilter
            if gap.gapType == GAP_TYPE_NWOG and gap.creationBar != freshNWOGBar
                hideGapDrawings(gap)
                continue
            if gap.gapType == GAP_TYPE_NDOG and gap.creationBar != freshNDOGBar
                hideGapDrawings(gap)
                continue
            if gap.gapType == GAP_TYPE_RTH
                // Allow today's filled RTH if showTodayFilledRTH is enabled
                isTodayGap = dayofmonth(gap.creationTime, TIMEZONE) == dayofmonth(time, TIMEZONE) and month(gap.creationTime, TIMEZONE) == month(time, TIMEZONE)
                keepFilledToday = showTodayFilledRTH and gap.filled and isTodayGap
                if gap.creationBar != freshRTHBar and not keepFilledToday
                    hideGapDrawings(gap)
                    continue
        else
            // Non-Fresh mode: skip NDOG when it shares geometry with any NWOG (NWOG takes precedence)
            if gap.gapType == GAP_TYPE_NDOG and displayNWOG
                ndogSharesGeometry = false
                for j = 0 to array.size(gapsArray) - 1
                    nwogGap = array.get(gapsArray, j)
                    if nwogGap.gapType == GAP_TYPE_NWOG and nwogGap.top == gap.top and nwogGap.bottom == gap.bottom
                        ndogSharesGeometry := true
                        break
                if ndogSharesGeometry
                    hideGapDrawings(gap)
                    continue

        // Skip filled gaps that passed next session UNLESS "Extend" is ON
        skipGap = false
        if gap.filled and gap.passedNextSession
            if gap.gapType == GAP_TYPE_RTH
                skipGap := true
            else if gap.gapType == GAP_TYPE_NWOG and not extendNWOGToPresent
                skipGap := true
            else if gap.gapType == GAP_TYPE_NDOG and not extendNDOGToPresent
                skipGap := true
            else if isBPR(gap.gapType)
                skipGap := true
            else if isFVG(gap.gapType)
                skipGap := true

        if skipGap
            continue

        if gap.entryDirection == ENTRY_NONE
            if high >= gap.bottom and low <= gap.bottom
                gap.entryDirection := ENTRY_FROM_BELOW
            else if low <= gap.top and high >= gap.top
                gap.entryDirection := ENTRY_FROM_ABOVE

        if not gap.filled
            // FVGs use body (like SIF), other gaps use wicks
            isFVGType = isFVG(gap.gapType)
            priceHigh = isFVGType ? math.max(open, close) : high
            priceLow = isFVGType ? math.min(open, close) : low

            if gap.entryDirection == ENTRY_FROM_BELOW
                if priceHigh >= gap.bottom and priceHigh <= gap.top
                    gap.penetrationLevel := na(gap.penetrationLevel) ? priceHigh : math.max(gap.penetrationLevel, priceHigh)
                if priceHigh >= gap.top
                    gap.penetrationLevel := gap.top
                    gap.filled := true
                    if gap.gapType == GAP_TYPE_RTH
                        isToday = dayofmonth(gap.creationTime, TIMEZONE) == dayofmonth(time, TIMEZONE) and month(gap.creationTime, TIMEZONE) == month(time, TIMEZONE)
                        if isToday
                            rthFilledAlertMsg := "Today's RTH Gap filled"
                        else
                            gapMonth = getMonthName(month(gap.creationTime, TIMEZONE))
                            gapDay = str.tostring(dayofmonth(gap.creationTime, TIMEZONE))
                            rthFilledAlertMsg := "RTH Gap filled: " + gapMonth + " " + gapDay
                    clearProjections(gap)
                    if isBPR(gap.gapType) or isFVGType
                        stopExtendingAt(gap, time)

            else if gap.entryDirection == ENTRY_FROM_ABOVE
                if priceLow <= gap.top and priceLow >= gap.bottom
                    gap.penetrationLevel := na(gap.penetrationLevel) ? priceLow : math.min(gap.penetrationLevel, priceLow)
                if priceLow <= gap.bottom
                    gap.penetrationLevel := gap.bottom
                    gap.filled := true
                    if gap.gapType == GAP_TYPE_RTH
                        isToday = dayofmonth(gap.creationTime, TIMEZONE) == dayofmonth(time, TIMEZONE) and month(gap.creationTime, TIMEZONE) == month(time, TIMEZONE)
                        if isToday
                            rthFilledAlertMsg := "Today's RTH Gap filled"
                        else
                            gapMonth = getMonthName(month(gap.creationTime, TIMEZONE))
                            gapDay = str.tostring(dayofmonth(gap.creationTime, TIMEZONE))
                            rthFilledAlertMsg := "RTH Gap filled: " + gapMonth + " " + gapDay
                    clearProjections(gap)
                    if isBPR(gap.gapType) or isFVGType
                        stopExtendingAt(gap, time)

            if not gap.filled and not na(gap.penetrationLevel)
                if gap.entryDirection == ENTRY_FROM_BELOW
                    if gap.penetrationLevel >= gap.top
                        gap.filled := true
                        if gap.gapType == GAP_TYPE_RTH
                            isToday = dayofmonth(gap.creationTime, TIMEZONE) == dayofmonth(time, TIMEZONE) and month(gap.creationTime, TIMEZONE) == month(time, TIMEZONE)
                            if isToday
                                rthFilledAlertMsg := "Today's RTH Gap filled"
                            else
                                gapMonth = getMonthName(month(gap.creationTime, TIMEZONE))
                                gapDay = str.tostring(dayofmonth(gap.creationTime, TIMEZONE))
                                rthFilledAlertMsg := "RTH Gap filled: " + gapMonth + " " + gapDay
                        clearProjections(gap)
                        if isBPR(gap.gapType)
                            stopExtendingAt(gap, time)
                else if gap.entryDirection == ENTRY_FROM_ABOVE
                    if gap.penetrationLevel <= gap.bottom
                        gap.filled := true
                        if gap.gapType == GAP_TYPE_RTH
                            isToday = dayofmonth(gap.creationTime, TIMEZONE) == dayofmonth(time, TIMEZONE) and month(gap.creationTime, TIMEZONE) == month(time, TIMEZONE)
                            if isToday
                                rthFilledAlertMsg := "Today's RTH Gap filled"
                            else
                                gapMonth = getMonthName(month(gap.creationTime, TIMEZONE))
                                gapDay = str.tostring(dayofmonth(gap.creationTime, TIMEZONE))
                                rthFilledAlertMsg := "RTH Gap filled: " + gapMonth + " " + gapDay
                        clearProjections(gap)
                        if isBPR(gap.gapType)
                            stopExtendingAt(gap, time)

        if gap.filled
            // Check if we should keep today's filled RTH in Fresh mode (use date check, not freshRTHBar)
            isTodayRTH = gap.gapType == GAP_TYPE_RTH and dayofmonth(gap.creationTime, TIMEZONE) == dayofmonth(time, TIMEZONE) and month(gap.creationTime, TIMEZONE) == month(time, TIMEZONE)
            keepTodayFilledRTH = isFreshFilter and showTodayFilledRTH and isTodayRTH

            shouldDeleteRTH = gap.gapType == GAP_TYPE_RTH and rthHideFilled and not keepTodayFilledRTH
            if (gap.gapType == GAP_TYPE_NWOG and nwogHideFilled) or (gap.gapType == GAP_TYPE_NDOG and ndogHideFilled) or (isBPR(gap.gapType) and hideFilledBPR) or (isFVG(gap.gapType) and hideFilledFVG) or shouldDeleteRTH
                // If deleting the fresh RTH gap, find and restore the next unfilled one
                if isFreshFilter and gap.gapType == GAP_TYPE_RTH and gap.creationBar == freshRTHBar
                    for j = array.size(gapsArray) - 1 to 0
                        prevGap = array.get(gapsArray, j)
                        if prevGap.gapType == GAP_TYPE_RTH and not prevGap.filled and prevGap.creationBar != gap.creationBar
                            freshRTHBar := prevGap.creationBar
                            restoreGapDrawings(prevGap)
                            break
                deleteGap(gap)
                array.remove(gapsArray, i)
                continue

            // Today's filled RTH gets thicker border for visibility (filled gaps are more faded)
            if keepTodayFilledRTH
                if not na(gap.topBoundaryLine)
                    line.set_width(gap.topBoundaryLine, 2)
                if not na(gap.bottomBoundaryLine)
                    line.set_width(gap.bottomBoundaryLine, 2)

        gapUnfilledColor = gap.gapType == GAP_TYPE_NWOG ? nwogUnfilledColor : gap.gapType == GAP_TYPE_NDOG ? ndogUnfilledColor : gap.gapType == GAP_TYPE_BPR_BULLISH ? bprBullishUnfilledColor : gap.gapType == GAP_TYPE_BPR_BEARISH ? bprBearishUnfilledColor : gap.gapType == GAP_TYPE_FVG_BULLISH ? fvgBullishUnfilledColor : gap.gapType == GAP_TYPE_FVG_BEARISH ? fvgBearishUnfilledColor : rthUnfilledColor
        gapFilledColor = gap.gapType == GAP_TYPE_NWOG ? nwogFilledColor : gap.gapType == GAP_TYPE_NDOG ? ndogFilledColor : gap.gapType == GAP_TYPE_BPR_BULLISH ? bprBullishFilledColor : gap.gapType == GAP_TYPE_BPR_BEARISH ? bprBearishFilledColor : gap.gapType == GAP_TYPE_FVG_BULLISH ? fvgBullishFilledColor : gap.gapType == GAP_TYPE_FVG_BEARISH ? fvgBearishFilledColor : rthFilledColor

        // Turn FVGs/GAPs grey when 100% filled (invalidated)
        if gap.filled and isFVG(gap.gapType)
            invalidatedColor = color.new(labelColor, 85)
            gapFilledColor := invalidatedColor
            gapUnfilledColor := invalidatedColor
            // Also grey out boundary lines
            if not na(gap.topBoundaryLine)
                line.set_color(gap.topBoundaryLine, labelColor)
            if not na(gap.bottomBoundaryLine)
                line.set_color(gap.bottomBoundaryLine, labelColor)
            // Grey out CE line (FVGs only have CE line, no q1/q3)
            if not na(gap.ceLine)
                line.set_color(gap.ceLine, color.new(labelColor, 40))
            // Grey out label
            if not na(gap.dateLabel)
                label.set_textcolor(gap.dateLabel, color.new(labelColor, 40))

        if not na(gap.penetrationLevel)
            if gap.entryDirection == ENTRY_FROM_BELOW
                box.set_top(gap.filledBox, gap.penetrationLevel)
                box.set_bottom(gap.filledBox, gap.bottom)
                box.set_bgcolor(gap.filledBox, gapFilledColor)
                box.set_top(gap.topUnfilledBox, gap.top)
                box.set_bottom(gap.topUnfilledBox, gap.penetrationLevel)
                box.set_bgcolor(gap.topUnfilledBox, gapUnfilledColor)
                box.set_top(gap.bottomUnfilledBox, gap.bottom)
                box.set_bottom(gap.bottomUnfilledBox, gap.bottom)

            else if gap.entryDirection == ENTRY_FROM_ABOVE
                box.set_top(gap.filledBox, gap.top)
                box.set_bottom(gap.filledBox, gap.penetrationLevel)
                box.set_bgcolor(gap.filledBox, gapFilledColor)
                box.set_top(gap.bottomUnfilledBox, gap.penetrationLevel)
                box.set_bottom(gap.bottomUnfilledBox, gap.bottom)
                box.set_bgcolor(gap.bottomUnfilledBox, gapUnfilledColor)
                box.set_top(gap.topUnfilledBox, gap.top)
                box.set_bottom(gap.topUnfilledBox, gap.top)
        else
            box.set_top(gap.topUnfilledBox, gap.top)
            box.set_bottom(gap.topUnfilledBox, gap.bottom)
            box.set_bgcolor(gap.topUnfilledBox, gapUnfilledColor)
            box.set_top(gap.filledBox, gap.bottom)
            box.set_bottom(gap.filledBox, gap.bottom)
            box.set_top(gap.bottomUnfilledBox, gap.bottom)
            box.set_bottom(gap.bottomUnfilledBox, gap.bottom)

        // Update RTH label with fill percentage
        if gap.gapType == GAP_TYPE_RTH and not na(gap.dateLabel)
            label.set_text(gap.dateLabel, getGapLabelWithFill(gap, GAP_TYPE_RTH))

        // Extension and positioning logic
        // RTH: extends if current session or unfilled historical
        // NWOG/NDOG: respects Extend toggle, or extends if unfilled/current session
        // BPR: respects Extend toggle, or extends if unfilled
        shouldExtend = false
        if gap.gapType == GAP_TYPE_RTH
            shouldExtend := not gap.passedNextSession or (gap.passedNextSession and not gap.filled)
        else if gap.gapType == GAP_TYPE_NWOG
            shouldExtend := extendNWOGToPresent or not gap.filled or not gap.passedNextSession
        else if gap.gapType == GAP_TYPE_NDOG
            shouldExtend := extendNDOGToPresent or not gap.filled or not gap.passedNextSession
        else if isBPR(gap.gapType)
            shouldExtend := not gap.filled
        else if isFVG(gap.gapType)
            shouldExtend := not gap.filled

        if shouldExtend
            // Floating mode: most recent unfilled of each type uses compact position
            // Each gap type has its own offset to avoid overlap when multiple float
            floatRTHBar = freshRTHBar
            floatNWOGBar = freshNWOGBar
            floatNDOGBar = freshNDOGBar
            // Skip overlap check when distinct NDOG was scanned
            floatNdogOverlap = needsDistinctNDOG ? false : ndogOverlapsNWOG
            // Fresh mode: always float (ignore hasPreview check for RTH)
            floatHasPreview = isFreshFilter ? false : hasPreview
            useCompact = shouldUseCompactPosition(gap, floatHasPreview, floatRTHBar, floatNWOGBar, floatNDOGBar, floatNdogOverlap)

            if useCompact
                // Floating mode: use bar_index positioning (hide original, draw floating overlay)
                hideGapDrawings(gap)
            else
                // Non-floating: restore and use time-based positioning
                restoreGapDrawings(gap)
                leftEdgeTime = gap.leftTime
                rightEdgeTime = time + (RIGHT_EDGE_CUSHION * barMs)
                updateGapDrawingPositions(gap, leftEdgeTime, rightEdgeTime)


            // Extend projection lines and update labels (use time-based coordinates)
            if not na(gap.projectionLines) and array.size(gap.projectionLines) > 0
                projRightTime = time + (barMs * RIGHT_EDGE_CUSHION)
                for projLine in gap.projectionLines
                    line.set_x2(projLine, projRightTime)
                if not na(gap.projectionLabels) and array.size(gap.projectionLabels) > 0
                    for projLabel in gap.projectionLabels
                        label.set_x(projLabel, projRightTime)

if displayNWOG and isValidNWOGTimeframe
    // Use cached 1-minute data (performance optimization)
    arrayTimes = cached_1m_times
    arrayOpens = cached_1m_opens
    arrayCloses = cached_1m_closes

    if not na(arrayTimes) and array.size(arrayTimes) > 0
        // Calculate lookback limit: only process recent weeks (3x buffer for safety)
        lookbackLimit = time - (nwogLimit * 3 * MILLISECONDS_PER_WEEK)

        for i = 0 to array.size(arrayTimes) - 1
            barTime = array.get(arrayTimes, i)

            // Skip bars that are too old for performance
            if barTime < lookbackLimit
                continue

            barDay = dayofweek(barTime, TIMEZONE)
            barHour = hour(barTime, TIMEZONE)
            barMinute = minute(barTime, TIMEZONE)

            if barDay == 6 and barHour == CLOSE_HOUR and barMinute == CLOSE_MINUTE
                fridayClosePrice := array.get(arrayCloses, i)

            if barDay == 1 and barHour == SESSION_OPEN_HOUR and barMinute == ZERO_MINUTE and not na(fridayClosePrice)
                sundayOpenPrice := array.get(arrayOpens, i)

                if sundayOpenPrice != fridayClosePrice
                    nwogTop = math.max(fridayClosePrice, sundayOpenPrice)
                    nwogBottom = math.min(fridayClosePrice, sundayOpenPrice)
                    nwogIsBullish = sundayOpenPrice > fridayClosePrice  // Bullish if gapped up

                    nwogGap = createGap(nwogTop, nwogBottom, GAP_TYPE_NWOG, false, na, nwogIsBullish)
                    array.push(gapsArray, nwogGap)

                    if countGapsByType(GAP_TYPE_NWOG) > nwogLimit
                        removeOldestGap(GAP_TYPE_NWOG)

                fridayClosePrice := na

// Manage projections: ensure only the most recent unfilled gap of each type has projections
if array.size(gapsArray) > 0
    // Find most recent unfilled creation bar for each projectable gap type
    int mostRecentNWOGBar = -1
    int mostRecentNDOGBar = -1
    int mostRecentRTHBar = -1

    for gap in gapsArray
        if not gap.filled
            if gap.gapType == GAP_TYPE_NWOG and gap.creationBar > mostRecentNWOGBar
                mostRecentNWOGBar := gap.creationBar
            else if gap.gapType == GAP_TYPE_NDOG and gap.creationBar > mostRecentNDOGBar
                mostRecentNDOGBar := gap.creationBar
            else if gap.gapType == GAP_TYPE_RTH and gap.creationBar > mostRecentRTHBar
                mostRecentRTHBar := gap.creationBar

    // Apply/remove projections based on most recent status
    rightEdgeTime = time + (barMs * RIGHT_EDGE_CUSHION)

    for gap in gapsArray
        showProj = (gap.gapType == GAP_TYPE_NWOG and showNWOGProjections and displayNWOG) or (gap.gapType == GAP_TYPE_NDOG and showNDOGProjections and displayNDOG) or (gap.gapType == GAP_TYPE_RTH and showRTHProjections and displayRTH)
        if not showProj
            continue

        mostRecentBar = gap.gapType == GAP_TYPE_NWOG ? mostRecentNWOGBar : gap.gapType == GAP_TYPE_NDOG ? mostRecentNDOGBar : mostRecentRTHBar
        isMostRecentUnfilled = not gap.filled and gap.creationBar == mostRecentBar
        hasProjections = not na(gap.projectionLines) and array.size(gap.projectionLines) > 0

        if isMostRecentUnfilled and not hasProjections
            draw_gap_projections(gap, rightEdgeTime)
        else if not isMostRecentUnfilled and hasProjections
            clearProjections(gap)

// ═══════════════════════════════════════════════════════════════════════════════
// FLOATING BOX RENDERING - Draw floating gaps using bar_index for consistent scaling
// ═══════════════════════════════════════════════════════════════════════════════
// Clear all floating boxes first
deleteFloatingBox(floatingRTH)
deleteFloatingBox(floatingNDOG)
deleteFloatingBox(floatingNWOG)
deleteFloatingBox(floatingPreview)

if floatingMode and array.size(gapsArray) > 0
    // Find most recent unfilled gaps to float
    GapData floatRTHGap = na
    GapData floatNDOGGap = na
    GapData floatNWOGGap = na

    for gap in gapsArray
        if not gap.filled
            if gap.gapType == GAP_TYPE_RTH and displayRTH
                if na(floatRTHGap) or gap.creationBar > floatRTHGap.creationBar
                    floatRTHGap := gap
            else if gap.gapType == GAP_TYPE_NDOG and displayNDOG
                if na(floatNDOGGap) or gap.creationBar > floatNDOGGap.creationBar
                    floatNDOGGap := gap
            else if gap.gapType == GAP_TYPE_NWOG and displayNWOG
                if na(floatNWOGGap) or gap.creationBar > floatNWOGGap.creationBar
                    floatNWOGGap := gap

    // Check if ANY NDOG shares geometry with the floating NWOG (for combined label)
    // This must check ALL NDOGs, not just unfilled, because the overlapping NDOG might be filled
    nwogHasOverlappingNdog = false
    if not na(floatNWOGGap) and displayNDOG
        for gap in gapsArray
            if gap.gapType == GAP_TYPE_NDOG and gap.top == floatNWOGGap.top and gap.bottom == floatNWOGGap.bottom
                nwogHasOverlappingNdog := true
                break

    // Check if the selected unfilled NDOG overlaps with NWOG (to decide if we need a distinct one)
    selectedNdogOverlapsNwog = not na(floatNDOGGap) and not na(floatNWOGGap) and floatNDOGGap.top == floatNWOGGap.top and floatNDOGGap.bottom == floatNWOGGap.bottom

    // If selected NDOG overlaps NWOG, find a distinct NDOG to float separately
    if selectedNdogOverlapsNwog and displayNDOG
        // Find most recent unfilled NDOG with different geometry from NWOG
        GapData distinctNDOG = na
        for gap in gapsArray
            if gap.gapType == GAP_TYPE_NDOG and not gap.filled
                isDistinct = gap.top != floatNWOGGap.top or gap.bottom != floatNWOGGap.bottom
                if isDistinct and (na(distinctNDOG) or gap.creationBar > distinctNDOG.creationBar)
                    distinctNDOG := gap
        if not na(distinctNDOG)
            floatNDOGGap := distinctNDOG

    // Check if preview RTH should block regular RTH floating
    previewBlocksRTH = not na(previewGap) and not isFreshFilter

    // Draw floating RTH (if no preview blocking it)
    if not na(floatRTHGap) and not previewBlocksRTH
        leftBar = bar_index + COMPACT_OFFSET_RTH
        rightBar = leftBar + COMPACT_WIDTH
        labelStr = getGapLabelWithFill(floatRTHGap, GAP_TYPE_RTH)
        drawFloatingBox(floatingRTH, floatRTHGap.top, floatRTHGap.bottom, floatRTHGap.penetrationLevel, floatRTHGap.entryDirection, leftBar, rightBar, rthUnfilledColor, rthFilledColor, rthBoundaryColor, internalLinesColor, labelStr, rthBoundaryColor, showInternalLines)

    // Draw floating NDOG
    if not na(floatNDOGGap)
        // Skip if NDOG overlaps NWOG (they share same geometry)
        skipNDOG = not na(floatNWOGGap) and floatNDOGGap.top == floatNWOGGap.top and floatNDOGGap.bottom == floatNWOGGap.bottom
        if not skipNDOG
            leftBar = bar_index + COMPACT_OFFSET_NDOG
            rightBar = leftBar + COMPACT_WIDTH
            labelStr = getGapLabelWithFill(floatNDOGGap, GAP_TYPE_NDOG)
            drawFloatingBox(floatingNDOG, floatNDOGGap.top, floatNDOGGap.bottom, floatNDOGGap.penetrationLevel, floatNDOGGap.entryDirection, leftBar, rightBar, ndogUnfilledColor, ndogFilledColor, ndogBoundaryColor, internalLinesColor, labelStr, ndogBoundaryColor, showInternalLines)

    // Draw floating NWOG (with combined label if NDOG overlaps)
    if not na(floatNWOGGap)
        leftBar = bar_index + COMPACT_OFFSET_NWOG
        rightBar = leftBar + COMPACT_WIDTH
        nwogPrefix = nwogHasOverlappingNdog and displayNDOG ? GAP_TYPE_NWOG_NDOG : GAP_TYPE_NWOG
        labelStr = getGapLabelWithFill(floatNWOGGap, nwogPrefix)
        drawFloatingBox(floatingNWOG, floatNWOGGap.top, floatNWOGGap.bottom, floatNWOGGap.penetrationLevel, floatNWOGGap.entryDirection, leftBar, rightBar, nwogUnfilledColor, nwogFilledColor, nwogBoundaryColor, internalLinesColor, labelStr, nwogBoundaryColor, showInternalLines)

    // Draw floating preview RTH
    if not na(previewGap)
        leftBar = bar_index + COMPACT_OFFSET_RTH
        rightBar = leftBar + COMPACT_WIDTH
        todayDow = dayofweek(time, TIMEZONE)
        daysToAdd = todayDow == dayofweek.friday ? 3 : 1
        nextTradingDay = time + (daysToAdd * MILLISECONDS_PER_DAY)
        labelStr = "Upcoming RTH\n" + formatGapDate(nextTradingDay)
        drawFloatingBox(floatingPreview, previewGap.top, previewGap.bottom, na, ENTRY_NONE, leftBar, rightBar, previewColor, previewColor, rthBoundaryColor, internalLinesColor, labelStr, rthBoundaryColor, false)

// Divider detection (independent of gap display toggles)
if (showNDOGDividers or showNWOGDividers) and isValidNWOGTimeframe
    // Use cached 1-minute data (performance optimization)
    arrayTimes = cached_1m_times
    arrayOpens = cached_1m_opens
    arrayCloses = cached_1m_closes

    if not na(arrayTimes) and array.size(arrayTimes) > 0
        // Calculate lookback limit based on which dividers are enabled
        maxGapsToShow = showNWOGDividers ? nwogLimit : ndogLimit
        lookbackPeriod = showNWOGDividers ? MILLISECONDS_PER_WEEK : MILLISECONDS_PER_DAY
        lookbackLimit = time - (maxGapsToShow * 3 * lookbackPeriod)

        for i = 0 to array.size(arrayTimes) - 1
            barTime = array.get(arrayTimes, i)

            // Skip bars that are too old for performance
            if barTime < lookbackLimit
                continue

            barDay = dayofweek(barTime, TIMEZONE)
            barHour = hour(barTime, TIMEZONE)
            barMinute = minute(barTime, TIMEZONE)

            // Detect 18:00 session open Monday-Friday and Sunday
            if ((barDay >= 2 and barDay <= 6) or barDay == 1) and barHour == SESSION_OPEN_HOUR and barMinute == ZERO_MINUTE
                // Store divider time for NDOG (all 18:00 openings)
                if showNDOGDividers
                    array.push(ndogDividers.dividerTimes, barTime)

                // Store divider time for NWOG (Sunday 18:00 only)
                if showNWOGDividers and barDay == 1
                    array.push(nwogDividers.dividerTimes, barTime)

if displayNDOG and isValidNWOGTimeframe
    // Use cached 1-minute data (performance optimization)
    arrayTimes = cached_1m_times
    arrayOpens = cached_1m_opens
    arrayCloses = cached_1m_closes

    if not na(arrayTimes) and array.size(arrayTimes) > 0
        // Calculate lookback limit: only process recent days (3x buffer for safety)
        lookbackLimit = time - (ndogLimit * 3 * MILLISECONDS_PER_DAY)

        for i = 0 to array.size(arrayTimes) - 1
            barTime = array.get(arrayTimes, i)

            // Skip bars that are too old for performance
            if barTime < lookbackLimit
                continue

            barDay = dayofweek(barTime, TIMEZONE)
            barHour = hour(barTime, TIMEZONE)
            barMinute = minute(barTime, TIMEZONE)

            // Capture close price Monday-Friday (16:59)
            if barDay >= 2 and barDay <= 6 and barHour == CLOSE_HOUR and barMinute == CLOSE_MINUTE
                prevDayClosePrice := array.get(arrayCloses, i)

            // Detect 18:00 session open Monday-Friday and Sunday
            // Note: Friday→Sunday creates both NDOG and NWOG (not mutually exclusive)
            if ((barDay >= 2 and barDay <= 6) or barDay == 1) and barHour == SESSION_OPEN_HOUR and barMinute == ZERO_MINUTE
                if not na(prevDayClosePrice)
                    newDayOpenPrice := array.get(arrayOpens, i)

                    if newDayOpenPrice != prevDayClosePrice
                        ndogTop = math.max(prevDayClosePrice, newDayOpenPrice)
                        ndogBottom = math.min(prevDayClosePrice, newDayOpenPrice)
                        ndogIsBullish = newDayOpenPrice > prevDayClosePrice  // Bullish if gapped up

                        ndogGap = createGap(ndogTop, ndogBottom, GAP_TYPE_NDOG, false, na, ndogIsBullish)
                        array.push(gapsArray, ndogGap)

                        if countGapsByType(GAP_TYPE_NDOG) > ndogLimit
                            removeOldestGap(GAP_TYPE_NDOG)

                    prevDayClosePrice := na
if displayNDOG and isValidNWOGTimeframe and array.size(gapsArray) > 0
    // Use cached 1-minute data (performance optimization)
    arrayTimes = cached_1m_times
    arrayOpens = cached_1m_opens
    arrayCloses = cached_1m_closes

    if not na(arrayTimes) and array.size(arrayTimes) > 0
        // Calculate lookback limit: only process recent days
        lookbackLimit = time - (ndogLimit * 3 * MILLISECONDS_PER_DAY)

        for i = 0 to array.size(arrayTimes) - 1
            barTime = array.get(arrayTimes, i)

            // Skip bars that are too old for performance
            if barTime < lookbackLimit
                continue

            barDay = dayofweek(barTime, TIMEZONE)
            barHour = hour(barTime, TIMEZONE)
            barMinute = minute(barTime, TIMEZONE)

            // Mark NDOG gaps as passed when reaching next 18:00 session (Mon-Fri + Sunday)
            if ((barDay >= 2 and barDay <= 6) or barDay == 1) and barHour == SESSION_OPEN_HOUR and barMinute == ZERO_MINUTE
                for j = 0 to array.size(gapsArray) - 1
                    gap = array.get(gapsArray, j)
                    // Only mark gaps created at least 20 hours before this session
                    // 20 hours = 72000000 ms (handles daily ~24h and Friday→Sunday ~50h gaps)
                    if gap.gapType == GAP_TYPE_NDOG and (barTime - gap.creationTime) >= 72000000
                        gap.passedNextSession := true

// BPR Detection
if displayBPR
    fvgBearish = low[2] - high > 0
    fvgBullish = low - high[2] > 0

    var float bullBprTopDetected = na
    var float bullBprBottomDetected = na
    var int bullBprLeftTimeDetected = na
    var float bearBprTopDetected = na
    var float bearBprBottomDetected = na
    var int bearBprLeftTimeDetected = na

    // Detect bullish BPR (bearish FVG → bullish FVG)
    bullBprBarsSince = ta.barssince(fvgBearish)
    if fvgBullish and bullBprBarsSince <= bprLookbackBars
        sumOfPoints = high[bullBprBarsSince] + low[bullBprBarsSince + 2] + high[2] + low
        rangeDiff = math.max(low[bullBprBarsSince + 2], low) - math.min(high[bullBprBarsSince], high[2])
        if sumOfPoints > rangeDiff
            bullBprTopDetected := math.min(low[bullBprBarsSince + 2], low)
            bullBprBottomDetected := math.max(high[bullBprBarsSince], high[2])
            bullBprLeftTimeDetected := time[bullBprBarsSince + 1]

    // Detect bearish BPR (bullish FVG → bearish FVG)
    bearBprBarsSince = ta.barssince(fvgBullish)
    if fvgBearish and bearBprBarsSince <= bprLookbackBars
        sumOfPoints = high[bearBprBarsSince] + low[bearBprBarsSince + 2] + high[2] + low
        rangeDiff = math.max(low[bearBprBarsSince + 2], low) - math.min(high[bearBprBarsSince], high[2])
        if sumOfPoints > rangeDiff
            bearBprTopDetected := math.min(low[bearBprBarsSince], low[2])
            bearBprBottomDetected := math.max(high[bearBprBarsSince + 2], high)
            bearBprLeftTimeDetected := time[bearBprBarsSince + 1]

    // Create bullish BPR (merge with existing if overlapping)
    if not na(bullBprTopDetected[1]) and bullBprTopDetected[1] > bullBprBottomDetected[1]
        if not tryMergeGap(bullBprTopDetected[1], bullBprBottomDetected[1], GAP_TYPE_BPR_BULLISH)
            array.push(gapsArray, createGap(bullBprTopDetected[1], bullBprBottomDetected[1], GAP_TYPE_BPR_BULLISH, false, bullBprLeftTimeDetected[1]))
            if countGapsByType(GAP_TYPE_BPR_BULLISH) + countGapsByType(GAP_TYPE_BPR_BEARISH) > bprLimit
                removeOldestBPR()
        bullBprTopDetected := na
        bullBprBottomDetected := na
        bullBprLeftTimeDetected := na

    // Create bearish BPR (merge with existing if overlapping)
    if not na(bearBprTopDetected[1]) and bearBprTopDetected[1] > bearBprBottomDetected[1]
        if not tryMergeGap(bearBprTopDetected[1], bearBprBottomDetected[1], GAP_TYPE_BPR_BEARISH)
            array.push(gapsArray, createGap(bearBprTopDetected[1], bearBprBottomDetected[1], GAP_TYPE_BPR_BEARISH, false, bearBprLeftTimeDetected[1]))
            if countGapsByType(GAP_TYPE_BPR_BULLISH) + countGapsByType(GAP_TYPE_BPR_BEARISH) > bprLimit
                removeOldestBPR()
        bearBprTopDetected := na
        bearBprBottomDetected := na
        bearBprLeftTimeDetected := na

// FVG Detection (3-candle pattern, expands to include True Gap and VI when present)
if displayFVG and barstate.isconfirmed
    isBullishFVG = low > high[2]
    isBearishFVG = high < low[2]

    // Bullish FVG (expand to include True Gap and VI if present)
    if isBullishFVG
        fvgTop = low
        fvgBottom = high[2]
        // True Gap expansion: check for bullish True Gaps contiguous with FVG boundaries
        if includeTrueGap
            // Check True Gap on exit side: between [0] and [1] (expands top)
            isBullishTG_0_1 = low > high[1]
            if isBullishTG_0_1
                fvgTop := math.max(fvgTop, low)  // Already at low, but keeps pattern consistent
            // Check True Gap within formation: between [1] and [2] (expands bottom)
            isBullishTG_1_2 = low[1] > high[2]
            if isBullishTG_1_2
                fvgBottom := math.min(fvgBottom, high[2])  // Already at high[2], but include high[1] boundary
            // The original True Gap expansion logic
            if low > high[1]
                fvgBottom := math.min(fvgBottom, high[1])
        // VI expansion: check for bullish VIs contiguous with FVG boundaries
        if includeVI
            // Check VI on exit side: between [0] and [1] (expands top)
            isBullishVI_0_1 = math.min(open, close) > math.max(open[1], close[1]) and low <= high[1]
            if isBullishVI_0_1
                fvgTop := math.max(fvgTop, math.min(open, close))
            // Check VI within formation: between [1] and [2] (expands bottom)
            isBullishVI_1_2 = math.min(open[1], close[1]) > math.max(open[2], close[2]) and low[1] <= high[2]
            if isBullishVI_1_2
                fvgBottom := math.min(fvgBottom, math.max(open[2], close[2]))
            // Check VI outside formation: between [2] and [3] (expands bottom further)
            isBullishVI_2_3 = math.min(open[2], close[2]) > math.max(open[3], close[3]) and low[2] <= high[3]
            if isBullishVI_2_3
                fvgBottom := math.min(fvgBottom, math.max(open[3], close[3]))
        array.push(gapsArray, createGap(fvgTop, fvgBottom, GAP_TYPE_FVG_BULLISH, false, time[2], true))
        if countFVG() > fvgLimit
            removeOldestFVG()

    // Bearish FVG (expand to include True Gap and VI if present)
    else if isBearishFVG
        fvgTop = low[2]
        fvgBottom = high
        // True Gap expansion: check for bearish True Gaps contiguous with FVG boundaries
        if includeTrueGap
            // Check True Gap within formation: between [1] and [2] (expands top)
            isBearishTG_1_2 = high[1] < low[2]
            if isBearishTG_1_2
                fvgTop := math.max(fvgTop, low[1])
            // Check True Gap on exit side: between [0] and [1] (expands bottom)
            isBearishTG_0_1 = high < low[1]
            if isBearishTG_0_1
                fvgBottom := math.min(fvgBottom, high)  // Already at high, but keeps pattern consistent
        // VI expansion: check for bearish VIs contiguous with FVG boundaries
        if includeVI
            // Check VI outside formation: between [2] and [3] (expands top further)
            isBearishVI_2_3 = math.max(open[2], close[2]) < math.min(open[3], close[3]) and high[2] >= low[3]
            if isBearishVI_2_3
                fvgTop := math.max(fvgTop, math.min(open[3], close[3]))
            // Check VI within formation: between [1] and [2] (expands top)
            isBearishVI_1_2 = math.max(open[1], close[1]) < math.min(open[2], close[2]) and high[1] >= low[2]
            if isBearishVI_1_2
                fvgTop := math.max(fvgTop, math.min(open[2], close[2]))
            // Check VI on exit side: between [0] and [1] (expands bottom)
            isBearishVI_0_1 = math.max(open, close) < math.min(open[1], close[1]) and high >= low[1]
            if isBearishVI_0_1
                fvgBottom := math.min(fvgBottom, math.max(open, close))
        array.push(gapsArray, createGap(fvgTop, fvgBottom, GAP_TYPE_FVG_BEARISH, false, time[2], false))
        if countFVG() > fvgLimit
            removeOldestFVG()

// Clear old divider lines
if array.size(dividerLines) > 0
    for i = 0 to array.size(dividerLines) - 1
        line.delete(array.get(dividerLines, i))
    array.clear(dividerLines)

// Draw NDOG dividers (18:00 daily)
// Requires BOTH "Show NDOG" and "NDOG Dividers" to be enabled
if displayNDOG and showNDOGDividers and array.size(ndogDividers.dividerTimes) > 0
    // Only show dividers for the number of NDOGs being displayed
    count = math.min(ndogLimit, array.size(ndogDividers.dividerTimes))

    for i = 0 to count - 1
        idx = array.size(ndogDividers.dividerTimes) - 1 - i
        dividerTime = array.get(ndogDividers.dividerTimes, idx)
        dividerLine = line.new(dividerTime, high, dividerTime, low, xloc=xloc.bar_time, color=ndogDividerColor, width=1, style=line.style_dashed, extend=extend.both)
        array.push(dividerLines, dividerLine)

// Draw NWOG dividers (Sunday 18:00 weekly)
// Requires BOTH "Show NWOG" and "NWOG Dividers" to be enabled
if displayNWOG and showNWOGDividers and array.size(nwogDividers.dividerTimes) > 0
    // Only show dividers for the number of NWOGs being displayed
    count = math.min(nwogLimit, array.size(nwogDividers.dividerTimes))

    for i = 0 to count - 1
        idx = array.size(nwogDividers.dividerTimes) - 1 - i
        dividerTime = array.get(nwogDividers.dividerTimes, idx)
        dividerLine = line.new(dividerTime, high, dividerTime, low, xloc=xloc.bar_time, color=nwogDividerColor, width=1, style=line.style_dashed, extend=extend.both)
        array.push(dividerLines, dividerLine)

plotcandle(displayRTH and muteETHCandles and not inRTH ? open : na, high, low, close, color=ethCandleColor, bordercolor=ethCandleColor, wickcolor=ethCandleColor, editable=false, display=display.pane, force_overlay=true)

// ═══════════════════════════════════════════════════════════════════════════════
// COLOR REFERENCE TABLE - Dynamic display based on active settings
// ═══════════════════════════════════════════════════════════════════════════════

addColorRow(table tbl, int row, string name, color clr) =>
    table.cell(tbl, 0, row, name, text_size=size.small, text_color=color.rgb(0, 0, 0))
    table.cell(tbl, 1, row, str.format("R:{0} G:{1} B:{2}", int(color.r(clr)), int(color.g(clr)), int(color.b(clr))), text_size=size.small, text_color=color.rgb(0, 0, 0))
    table.cell(tbl, 2, row, str.tostring(int(color.t(clr))), text_size=size.small, text_color=color.rgb(0, 0, 0))

if showColorTable and barstate.islast
    // Calculate row count based on active features
    rowCount = 1  // Header
    if displayNWOG
        rowCount += 4  // Unfilled, Filled, Divider, Boundary
        if showNWOGProjections
            rowCount += 1
    if displayNDOG
        rowCount += 4  // Unfilled, Filled, Divider, Boundary
        if showNDOGProjections
            rowCount += 1
    if displayRTH
        rowCount += 5  // Unfilled, Filled, Preview, ETH Candle, Boundary
        if showRTHProjections
            rowCount += 1
    if displayBPR
        rowCount += 6  // Bullish Unfilled/Filled/Boundary, Bearish Unfilled/Filled/Boundary
    rowCount += 1  // Labels always shown

    var table colorTable = table.new(position.top_right, 3, 30, bgcolor=color.rgb(255, 255, 255), border_width=1, border_color=color.rgb(128, 128, 128), frame_width=1, frame_color=color.rgb(128, 128, 128))

    // Header
    table.cell(colorTable, 0, 0, "Setting", bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
    table.cell(colorTable, 1, 0, "RGB", bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)
    table.cell(colorTable, 2, 0, "Trans", bgcolor=color.new(color.rgb(128, 128, 128), 50), text_color=color.rgb(255, 255, 255), text_size=size.small)

    int currentRow = 1

    if displayNWOG
        addColorRow(colorTable, currentRow, "NWOG Unfilled", nwogUnfilledColor)
        currentRow += 1
        addColorRow(colorTable, currentRow, "NWOG Filled", nwogFilledColor)
        currentRow += 1
        if showNWOGDividers
            addColorRow(colorTable, currentRow, "NWOG Divider", nwogDividerColor)
            currentRow += 1
        addColorRow(colorTable, currentRow, "NWOG Boundary", nwogBoundaryColor)
        currentRow += 1
        if showNWOGProjections
            addColorRow(colorTable, currentRow, "NWOG Projection", nwogProjectionColor)
            currentRow += 1

    // NDOG Colors (only if enabled)
    if displayNDOG
        addColorRow(colorTable, currentRow, "NDOG Unfilled", ndogUnfilledColor)
        currentRow += 1
        addColorRow(colorTable, currentRow, "NDOG Filled", ndogFilledColor)
        currentRow += 1
        if showNDOGDividers
            addColorRow(colorTable, currentRow, "NDOG Divider", ndogDividerColor)
            currentRow += 1
        addColorRow(colorTable, currentRow, "NDOG Boundary", ndogBoundaryColor)
        currentRow += 1
        if showNDOGProjections
            addColorRow(colorTable, currentRow, "NDOG Projection", ndogProjectionColor)
            currentRow += 1

    // RTH Colors (only if enabled)
    if displayRTH
        addColorRow(colorTable, currentRow, "RTH Unfilled", rthUnfilledColor)
        currentRow += 1
        addColorRow(colorTable, currentRow, "RTH Filled", rthFilledColor)
        currentRow += 1
        addColorRow(colorTable, currentRow, "Upcoming RTH", previewColor)
        currentRow += 1
        addColorRow(colorTable, currentRow, "RTH Mute ETH", ethCandleColor)
        currentRow += 1
        addColorRow(colorTable, currentRow, "RTH Boundary", rthBoundaryColor)
        currentRow += 1
        if showRTHProjections
            addColorRow(colorTable, currentRow, "RTH Projection", rthProjectionColor)
            currentRow += 1

    // BPR Colors (only if enabled)
    if displayBPR
        addColorRow(colorTable, currentRow, "BPR+ Unfilled", bprBullishUnfilledColor)
        currentRow += 1
        addColorRow(colorTable, currentRow, "BPR+ Filled", bprBullishFilledColor)
        currentRow += 1
        addColorRow(colorTable, currentRow, "BPR+ Boundary", bprBullishBoundaryColor)
        currentRow += 1
        addColorRow(colorTable, currentRow, "BPR- Unfilled", bprBearishUnfilledColor)
        currentRow += 1
        addColorRow(colorTable, currentRow, "BPR- Filled", bprBearishFilledColor)
        currentRow += 1
        addColorRow(colorTable, currentRow, "BPR- Boundary", bprBearishBoundaryColor)
        currentRow += 1

    // FVG Colors (only if enabled)
    if displayFVG
        addColorRow(colorTable, currentRow, "FVG+ Unfilled", fvgBullishUnfilledColor)
        currentRow += 1
        addColorRow(colorTable, currentRow, "FVG+ Filled", fvgBullishFilledColor)
        currentRow += 1
        addColorRow(colorTable, currentRow, "FVG+ Boundary", fvgBullishBoundaryColor)
        currentRow += 1
        addColorRow(colorTable, currentRow, "FVG- Unfilled", fvgBearishUnfilledColor)
        currentRow += 1
        addColorRow(colorTable, currentRow, "FVG- Filled", fvgBearishFilledColor)
        currentRow += 1
        addColorRow(colorTable, currentRow, "FVG- Boundary", fvgBearishBoundaryColor)
        currentRow += 1
        addColorRow(colorTable, currentRow, "FVG Label", fvgLabelColor)
        currentRow += 1

    // Appearance Colors
    addColorRow(colorTable, currentRow, "Labels", labelColor)

// ═══════════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════════
if not na(rthFilledAlertMsg)
    alert(rthFilledAlertMsg, alert.freq_once_per_bar)
    rthFilledAlertMsg := na
